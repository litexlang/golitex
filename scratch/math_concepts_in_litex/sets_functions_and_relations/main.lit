# Scratch tracer: preimage is a set-valued construction, not only a relation.

template<S, T set, f fn(x S) T>:
    have fn set_preimage(B power_set(T)) power_set(S) = {x S: f(x) $in B}

have fn shift(x R) R = x + 1
have nonnegative_reals power_set(R) = {y R: y >= 0}
have shift_nonnegative_inputs power_set(R) = \set_preimage<R, R, shift>(nonnegative_reals)

shift(0) = 1
1 $in nonnegative_reals
shift_nonnegative_inputs = \set_preimage<R, R, shift>(nonnegative_reals)
\set_preimage<R, R, shift>(nonnegative_reals) = {x R: shift(x) $in nonnegative_reals}
by thm set_builder_member(0, {x R: shift(x) $in nonnegative_reals})
0 $in {x R: shift(x) $in nonnegative_reals}
0 $in shift_nonnegative_inputs

shift(-2) = -1
by contra:
    ? not -1 $in nonnegative_reals
    -1 $in nonnegative_reals
    nonnegative_reals = {y R: y >= 0}
    -1 $in {y R: y >= 0}
    -1 >= 0
    impossible -1 < 0
by contra:
    ? not -2 $in shift_nonnegative_inputs
    -2 $in shift_nonnegative_inputs
    shift_nonnegative_inputs = \set_preimage<R, R, shift>(nonnegative_reals)
    \set_preimage<R, R, shift>(nonnegative_reals) = {x R: shift(x) $in nonnegative_reals}
    -2 $in {x R: shift(x) $in nonnegative_reals}
    shift(-2) $in nonnegative_reals
    -1 $in nonnegative_reals
    impossible not -1 $in nonnegative_reals

# Preimages preserve intersections. The proof is the familiar mathematical
# one: prove both inclusions, then invoke extensionality.
thm set_preimage_intersection:
    ? forall S, T set, f fn(x S) T, U, V power_set(T):
        \set_preimage<S, T, f>(intersect(U, V)) = intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V))
    claim:
        ? \set_preimage<S, T, f>(intersect(U, V)) $subset intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V))
        claim:
            ? forall x \set_preimage<S, T, f>(intersect(U, V)):
                x $in intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V))
            \set_preimage<S, T, f>(intersect(U, V)) = {z S: f(z) $in intersect(U, V)}
            x $in {z S: f(z) $in intersect(U, V)}
            f(x) $in intersect(U, V)
            f(x) $in U
            f(x) $in V
            by thm set_builder_member(x, {z S: f(z) $in U})
            by thm set_builder_member(x, {z S: f(z) $in V})
            \set_preimage<S, T, f>(U) = {z S: f(z) $in U}
            \set_preimage<S, T, f>(V) = {z S: f(z) $in V}
            x $in \set_preimage<S, T, f>(U)
            x $in \set_preimage<S, T, f>(V)
        by def:
            ? \set_preimage<S, T, f>(intersect(U, V)) $subset intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V))
    claim:
        ? intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V)) $subset \set_preimage<S, T, f>(intersect(U, V))
        claim:
            ? forall x intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V)):
                x $in \set_preimage<S, T, f>(intersect(U, V))
            x $in \set_preimage<S, T, f>(U)
            x $in \set_preimage<S, T, f>(V)
            \set_preimage<S, T, f>(U) = {z S: f(z) $in U}
            \set_preimage<S, T, f>(V) = {z S: f(z) $in V}
            x $in {z S: f(z) $in U}
            x $in {z S: f(z) $in V}
            f(x) $in U
            f(x) $in V
            f(x) $in intersect(U, V)
            by thm set_builder_member(x, {z S: f(z) $in intersect(U, V)})
            \set_preimage<S, T, f>(intersect(U, V)) = {z S: f(z) $in intersect(U, V)}
        by def:
            ? intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V)) $subset \set_preimage<S, T, f>(intersect(U, V))
    by extension:
        ? \set_preimage<S, T, f>(intersect(U, V)) = intersect(\set_preimage<S, T, f>(U), \set_preimage<S, T, f>(V))

# Inverse laws are kept as small reusable propositions. A two-sided inverse
# immediately exposes both halves of bijectivity.
prop is_left_inverse(S, T set, f fn(x S) T, g fn(y T) S):
    forall x S:
        g(f(x)) = x

prop is_right_inverse(S, T set, f fn(x S) T, g fn(y T) S):
    forall y T:
        f(g(y)) = y

prop is_two_sided_inverse(S, T set, f fn(x S) T, g fn(y T) S):
    $is_left_inverse(S, T, f, g)
    $is_right_inverse(S, T, f, g)

thm two_sided_inverse_gives_bijection:
    ? forall S, T set, f fn(x S) T, g fn(y T) S:
        $is_two_sided_inverse(S, T, f, g)
        =>:
            $bijective(S, T, f)
    by def:
        ? $is_two_sided_inverse(S, T, f, g)
    claim:
        ? $injective(S, T, f)
        claim:
            ? forall x1, x2 S:
                f(x1) = f(x2)
                =>:
                    x1 = x2
            g(f(x1)) = g(f(x2))
            g(f(x1)) = x1
            g(f(x2)) = x2
        by def:
            ? $injective(S, T, f)
    claim:
        ? $surjective(S, T, f)
        claim:
            ? forall y T:
                exist x S st {y = f(x)}
            witness exist x S st {y = f(x)} from g(y)
        by def:
            ? $surjective(S, T, f)
    by def:
        ? $bijective(S, T, f)

have fn unshift(y R) R = y - 1

thm shift_and_unshift_are_two_sided_inverses:
    ? forall:
        $is_two_sided_inverse(R, R, shift, unshift)
    claim:
        ? forall x R:
            unshift(shift(x)) = x
        shift(x) = x + 1
        unshift(shift(x)) = shift(x) - 1 = (x + 1) - 1 = x
    claim:
        ? forall y R:
            shift(unshift(y)) = y
        unshift(y) = y - 1
        shift(unshift(y)) = unshift(y) + 1 = (y - 1) + 1 = y
    by def:
        ? $is_left_inverse(R, R, shift, unshift)
    by def:
        ? $is_right_inverse(R, R, shift, unshift)
    by def:
        ? $is_two_sided_inverse(R, R, shift, unshift)

by thm shift_and_unshift_are_two_sided_inverses()
by thm two_sided_inverse_gives_bijection(R, R, shift, unshift)
$bijective(R, R, shift)

# A relation example keeps witnesses visible: two integers have the same
# parity exactly when their difference is twice an integer.
prop same_parity(a, b Z):
    exist k Z st {a - b = 2 * k}

thm same_parity_is_reflexive:
    ? forall a Z:
        $same_parity(a, a)
    witness $same_parity(a, a) from 0:
        a - a = 2 * 0

thm same_parity_is_symmetric:
    ? forall a, b Z:
        $same_parity(a, b)
        =>:
            $same_parity(b, a)
    obtain k from $same_parity(a, b)
    a - b = 2 * k
    b - a = -(a - b)
    -(a - b) = -(2 * k)
    -(2 * k) = 2 * (-k)
    b - a = 2 * (-k)
    witness $same_parity(b, a) from -k:
        b - a = 2 * (-k)

thm same_parity_is_transitive:
    ? forall a, b, c Z:
        $same_parity(a, b)
        $same_parity(b, c)
        =>:
            $same_parity(a, c)
    obtain k from $same_parity(a, b)
    obtain m from $same_parity(b, c)
    a - b = 2 * k
    b - c = 2 * m
    a - c = (a - b) + (b - c) = 2 * k + 2 * m = 2 * (k + m)
    witness $same_parity(a, c) from k + m:
        a - c = 2 * (k + m)

witness $same_parity(7, 3) from 2:
    7 - 3 = 2 * 2
by thm same_parity_is_symmetric(7, 3)
$same_parity(3, 7)
