thm binary_gaussian_span_is_ideal:
    ? forall ax, ay, bx, b_y Z:
        $gaussian_ideal(binary_gaussian_span(ax, ay, bx, b_y))
    by thm binary_gaussian_span_contains_zero(ax, ay, bx, b_y)
    claim:
        ? forall a, b cart(Z, Z):
            a $in binary_gaussian_span(ax, ay, bx, b_y)
            b $in binary_gaussian_span(ax, ay, bx, b_y)
            =>:
                gaussian_add(a[1], a[2], b[1], b[2]) $in binary_gaussian_span(ax, ay, bx, b_y)
        by thm binary_gaussian_span_is_closed_under_addition(ax, ay, bx, b_y, a, b)
    claim:
        ? forall a, q cart(Z, Z):
            a $in binary_gaussian_span(ax, ay, bx, b_y)
            =>:
                gaussian_mul(a[1], a[2], q[1], q[2]) $in binary_gaussian_span(ax, ay, bx, b_y)
        by thm binary_gaussian_span_is_closed_under_gaussian_multiplication(ax, ay, bx, b_y, a, q)
    by def $gaussian_ideal(binary_gaussian_span(ax, ay, bx, b_y))
