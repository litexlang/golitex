thm binary_gaussian_span_is_closed_under_addition:
    ? forall ax, ay, bx, b_y Z, a, b cart(Z, Z):
        a $in binary_gaussian_span(ax, ay, bx, b_y)
        b $in binary_gaussian_span(ax, ay, bx, b_y)
        =>:
            gaussian_add(a[1], a[2], b[1], b[2]) $in binary_gaussian_span(ax, ay, bx, b_y)
    obtain ux, uy, vx, vy from exist ux0, uy0, vx0, vy0 Z st {a[1] = ax * ux0 - ay * uy0 + bx * vx0 - b_y * vy0, a[2] = ax * uy0 + ay * ux0 + bx * vy0 + b_y * vx0}
    obtain sx, sy, tx, ty from exist sx0, sy0, tx0, ty0 Z st {b[1] = ax * sx0 - ay * sy0 + bx * tx0 - b_y * ty0, b[2] = ax * sy0 + ay * sx0 + bx * ty0 + b_y * tx0}
    gaussian_add(a[1], a[2], b[1], b[2]) = (a[1] + b[1], a[2] + b[2])
    witness exist px, py, qx, qy Z st {gaussian_add(a[1], a[2], b[1], b[2])[1] = ax * px - ay * py + bx * qx - b_y * qy, gaussian_add(a[1], a[2], b[1], b[2])[2] = ax * py + ay * px + bx * qy + b_y * qx} from ux + sx, uy + sy, vx + tx, vy + ty:
        gaussian_add(a[1], a[2], b[1], b[2])[1] = (a[1] + b[1], a[2] + b[2])[1] = a[1] + b[1] = ax * (ux + sx) - ay * (uy + sy) + bx * (vx + tx) - b_y * (vy + ty)
        gaussian_add(a[1], a[2], b[1], b[2])[2] = (a[1] + b[1], a[2] + b[2])[2] = a[2] + b[2] = ax * (uy + sy) + ay * (ux + sx) + bx * (vy + ty) + b_y * (vx + tx)
    by def $is_binary_gaussian_linear_combination(ax, ay, bx, b_y, gaussian_add(a[1], a[2], b[1], b[2])[1], gaussian_add(a[1], a[2], b[1], b[2])[2])
    gaussian_add(a[1], a[2], b[1], b[2]) $in binary_gaussian_span(ax, ay, bx, b_y)
