# Ten textbook-style calculus examples: definite Riemann integrals (`integ`),
# linearity, quadrature exactness, Newton-Leibniz, interval splitting,
# integration by parts, substitution, custom propositions, L^2 orthogonality,
# and comparison bounds.
# Check: target/release/litex -strict -lang en -f examples/calculus/textbook_riemann_integrals.lit

# ==============================================================================
# 1. Polynomial definite integral, signed reversal, and zero-width interval
#    \int_0^2 (4x^3 - 3x^2 + 2x - 1) dx = 10, \int_2^0 ... = -10, \int_2^2 ... = 0
# ==============================================================================
have fn cubic_poly(x R) R = 4 * x^3 - 3 * x^2 + 2 * x - 1

$is_riemann_integrable(cubic_poly, 0, 2)
integral(cubic_poly, 0, 2) = 10

$is_riemann_integrable(cubic_poly, 2, 0)
integral(cubic_poly, 2, 0) = -10

$is_riemann_integrable(cubic_poly, 2, 2)
integral(cubic_poly, 2, 2) = 0


# ==============================================================================
# 2. Exactness of Simpson's 1/3 rule for all cubic polynomials on [0, 2]
#    \int_0^2 p(x) dx = (1/3) * (p(0) + 4*p(1) + p(2))
# ==============================================================================
forall a, b, c, d R:
    $is_riemann_integrable(fn(x R) R {a * x^3 + b * x^2 + c * x + d}, 0, 2)
    integral(fn(x R) R {a * x^3 + b * x^2 + c * x + d}, 0, 2) = (1 / 3) * (d + 4 * (a + b + c + d) + (8 * a + 4 * b + 2 * c + d))


# ==============================================================================
# 3. Linearity of `integ` and automatic integrability closure
#    (products, `abs`, Gaussian exp(-x^2), and nowhere-zero continuous quotients)
# ==============================================================================
forall f, g fn(x R) R, a, b R, c R*:
    $is_riemann_integrable(f, a, b)
    $is_riemann_integrable(g, a, b)
    =>:
        $is_riemann_integrable(fn(x R) R {2 * f(x) - g(x) / c + 5}, a, b)
        integral(fn(x R) R {2 * f(x) - g(x) / c + 5}, a, b) = 2 * integral(f, a, b) - integral(g, a, b) / c + 5 * (b - a)
        $is_riemann_integrable(fn(x R) R {f(x) * g(x) + abs(f(x) - g(x))}, a, b)

$is_riemann_integrable(fn(x R) R {exp(-x^2)}, 0, 1)
$is_riemann_integrable(fn(x R) R {cos(x) / (1 + x^2)}, 0, 1)


# ==============================================================================
# 4. Fundamental Theorem of Calculus (Newton-Leibniz) with automatic `deriv`
#    \int_0^1 (2x / (1 + x^2)) dx = [ln(1 + x^2)]_0^1 = ln(2)
# ==============================================================================
have fn rational_slope(x R) R = 2 * x / (1 + x^2)
have fn log_quad(x R) R = ln(1 + x^2)

$is_riemann_integrable(rational_slope, 0, 1)

forall x R:
    $cont_at(log_quad, x)
    $has_deriv_at(log_quad, x, 2 * x / (1 + x^2))
    rational_slope(x) = 2 * x / (1 + x^2)
    $has_deriv_at(log_quad, x, rational_slope(x))

release thm riemann_integral_newton_leibniz(rational_slope, log_quad, 0, 1)

log_quad(1) = ln(1 + 1^2) = ln(2)
log_quad(0) = ln(1 + 0^2) = ln(1) = 0
integral(rational_slope, 0, 1) = log_quad(1) - log_quad(0) = ln(2) - 0 = ln(2)


# ==============================================================================
# 5. Piecewise / absolute-value splitting across a corner
#    \int_{-1}^2 |x| dx = \int_{-1}^0 (-x) dx + \int_0^2 x dx = 1/2 + 2 = 5/2
# ==============================================================================
have fn abs_fn(x R) R = abs(x)
have fn neg_id(x R) R = -x
have fn pos_id(x R) R = x

$has_riemann_integral(neg_id, -1, 0, 1 / 2)
$has_riemann_integral(pos_id, 0, 2, 2)

forall x '[-1, 0]:
    x <= 0
    abs(x) = -x
    abs_fn(x) = abs(x) = -x = neg_id(x)
    neg_id(x) = abs_fn(x)

forall x '[0, 2]:
    0 <= x
    abs(x) = x
    abs_fn(x) = abs(x) = x = pos_id(x)
    pos_id(x) = abs_fn(x)

release thm riemann_integral_extensional(neg_id, abs_fn, -1, 0, 1 / 2)
release thm riemann_integral_extensional(pos_id, abs_fn, 0, 2, 2)
release thm riemann_integral_split(abs_fn, -1, 0, 2, 1 / 2, 2)

integral(abs_fn, -1, 2) = 5 / 2


# ==============================================================================
# 6. Integration by parts (`integ_parts`) on a trigonometric moment
#    \int_0^{pi/2} x * cos(x) dx = [x * sin(x)]_0^{pi/2} - \int_0^{pi/2} sin(x) dx = pi/2 - 1
# ==============================================================================
have fn unit_const(x R) R = 1
have fn sin_fn(x R) R = sin(x)
have fn cos_fn(x R) R = cos(x)
have fn neg_cos_fn(x R) R = -cos(x)
have fn x_cos(x R) R = x * cos(x)

forall x R:
    unit_const(x) = 1
    $has_deriv_at(pos_id, x, unit_const(x))
    cos_fn(x) = cos(x)
    $has_deriv_at(sin_fn, x, cos_fn(x))
    $cont_at(sin_fn, x)
    sin_fn(x) = sin(x)
    $has_deriv_at(neg_cos_fn, x, sin_fn(x))
    $cont_at(neg_cos_fn, x)
    x_cos(x) = pos_id(x) * cos_fn(x)
    sin_fn(x) = unit_const(x) * sin_fn(x)

$is_riemann_integrable(sin_fn, 0, pi / 2)
release thm riemann_integral_newton_leibniz(sin_fn, neg_cos_fn, 0, pi / 2)
neg_cos_fn(pi / 2) = -cos(pi / 2) = -0 = 0
neg_cos_fn(0) = -cos(0) = -1
neg_cos_fn(pi / 2) - neg_cos_fn(0) = 0 - (-1) = 1
$has_riemann_integral(sin_fn, 0, pi / 2, 1)

release thm integ_parts(pos_id, unit_const, sin_fn, cos_fn, x_cos, sin_fn, 0, pi / 2, 1)

pos_id(pi / 2) = pi / 2
pos_id(0) = 0
sin_fn(pi / 2) = sin(pi / 2) = 1
sin_fn(0) = sin(0) = 0
pos_id(pi / 2) * sin_fn(pi / 2) = (pi / 2) * 1 = pi / 2
pos_id(0) * sin_fn(0) = 0 * 0 = 0
integral(x_cos, 0, pi / 2) = pos_id(pi / 2) * sin_fn(pi / 2) - pos_id(0) * sin_fn(0) - 1 = pi / 2 - 0 - 1 = pi / 2 - 1


# ==============================================================================
# 7. Change of variables / u-substitution (`riemann_integral_substitution`)
#    \int_0^1 2x exp(x^2) dx = exp(1) - 1 and odd cancellation \int_{-1}^1 2x exp(x^2) dx = 0
# ==============================================================================
have fn exp_fn(x R) R = exp(x)
have fn sq_fn(x R) R = x^2
have fn twice_fn(x R) R = 2 * x
have fn gaussian_slope(x R) R = 2 * x * exp(x^2)

forall x R:
    twice_fn(x) = 2 * x
    $has_deriv_at(sq_fn, x, twice_fn(x))
    exp_fn(x) = exp(x)
    $has_deriv_at(exp_fn, x, exp_fn(x))
    $cont_at(exp_fn, x)
    sq_fn(x) = x^2
    exp_fn(sq_fn(x)) = exp(x^2)
    gaussian_slope(x) = 2 * x * exp(x^2) = exp(x^2) * (2 * x) = exp_fn(sq_fn(x)) * twice_fn(x)
    gaussian_slope(x) = exp_fn(sq_fn(x)) * twice_fn(x)

$is_riemann_integrable(exp_fn, 0, 1)
release thm riemann_integral_newton_leibniz(exp_fn, exp_fn, 0, 1)

sq_fn(0) = 0
sq_fn(1) = 1
exp_fn(0) = exp(0) = 1
exp_fn(1) = exp(1)
release thm riemann_integral_substitution(exp_fn, sq_fn, twice_fn, gaussian_slope, R, 0, 1, exp_fn(1) - exp_fn(0))
integral(gaussian_slope, 0, 1) = exp_fn(1) - exp_fn(0) = exp(1) - 1

sq_fn(-1) = 1
release thm riemann_integral_zero(exp_fn, 1)
release thm riemann_integral_substitution(exp_fn, sq_fn, twice_fn, gaussian_slope, R, -1, 1, 0)
integral(gaussian_slope, -1, 1) = 0


# ==============================================================================
# 8. Custom `prop`: Integral average value & Archimedes' parabolic average
#    (1 / (L - 0)) \int_0^L x^2 dx = L^2 / 3 for every L > 0
# ==============================================================================
prop has_integral_average(f fn(x R) R, a, b, avg R):
    $is_riemann_integrable(f, a, b)
    b - a != 0
    integral(f, a, b) / (b - a) = avg

thm parabola_average_value:
    ? forall L R+:
        =>:
            $has_integral_average(sq_fn, 0, L, L^2 / 3)
    $is_riemann_integrable(sq_fn, 0, L)
    L - 0 = L
    L != 0
    L - 0 != 0
    integral(sq_fn, 0, L) = L^3 / 3
    integral(sq_fn, 0, L) / (L - 0) = (L^3 / 3) / L = L^2 / 3
    by def $has_integral_average(sq_fn, 0, L, L^2 / 3)

2 - 0 != 0
integral(cubic_poly, 0, 2) / (2 - 0) = 10 / 2 = 5
by def $has_integral_average(cubic_poly, 0, 2, 5)


# ==============================================================================
# 9. Custom `prop`: L^2 orthogonality of Legendre polynomials P_1 and P_2 on [-1, 1]
#    P_1(x) = x, P_2(x) = (3/2)x^2 - 1/2  =>  \int_{-1}^1 P_1(x) P_2(x) dx = 0
# ==============================================================================
prop are_l2_orthogonal_on(f, g fn(x R) R, a, b R):
    $is_riemann_integrable(fn(x R) R {f(x) * g(x)}, a, b)
    integral(fn(x R) R {f(x) * g(x)}, a, b) = 0

have fn leg_p1(x R) R = x
have fn leg_p2(x R) R = (3 / 2) * x^2 - 1 / 2
have fn prod_p1_p2(x R) R = (3 / 2) * x^3 - (1 / 2) * x

$has_riemann_integral(prod_p1_p2, -1, 1, 0)
$is_riemann_integrable(leg_p1, -1, 1)
$is_riemann_integrable(leg_p2, -1, 1)
$is_riemann_integrable(fn(x R) R {leg_p1(x) * leg_p2(x)}, -1, 1)

forall t '[-1, 1]:
    leg_p1(t) = t
    leg_p2(t) = (3 / 2) * t^2 - 1 / 2
    prod_p1_p2(t) = (3 / 2) * t^3 - (1 / 2) * t
    fn(x R) R {leg_p1(x) * leg_p2(x)}(t) = leg_p1(t) * leg_p2(t) = t * ((3 / 2) * t^2 - 1 / 2) = (3 / 2) * t^3 - (1 / 2) * t
    prod_p1_p2(t) = fn(x R) R {leg_p1(x) * leg_p2(x)}(t)

release thm riemann_integral_extensional(prod_p1_p2, fn(x R) R {leg_p1(x) * leg_p2(x)}, -1, 1, 0)
integral(fn(x R) R {leg_p1(x) * leg_p2(x)}, -1, 1) = 0
by def $are_l2_orthogonal_on(leg_p1, leg_p2, -1, 1)


# ==============================================================================
# 10. Integral comparison / squeeze bounds on \int_0^1 (1 / (1 + x^2)) dx
#     1 - x^2 <= 1 / (1 + x^2) <= 1 on [0, 1]  =>  2/3 <= \int_0^1 dx/(1+x^2) <= 1
# ==============================================================================
have fn lower_quad(x R) R = 1 - x^2
have fn cauchy_kernel(x R) R = 1 / (1 + x^2)

$has_riemann_integral(lower_quad, 0, 1, 2 / 3)
$has_riemann_integral(unit_const, 0, 1, 1)
$is_riemann_integrable(cauchy_kernel, 0, 1)
release thm riemann_integral_selected(cauchy_kernel, 0, 1)

forall x '[0, 1]:
    0 <= x^2
    0 <= x^4
    1 - x^4 <= 1
    0 < 1 + x^2
    (1 - x^2) * (1 + x^2) = 1 - x^4 <= 1
    1 - x^2 <= 1 / (1 + x^2)
    lower_quad(x) = 1 - x^2
    cauchy_kernel(x) = 1 / (1 + x^2)
    lower_quad(x) <= cauchy_kernel(x)
    1 <= 1 + x^2
    1 / (1 + x^2) <= 1
    unit_const(x) = 1
    cauchy_kernel(x) <= unit_const(x)

release thm riemann_integral_compare(lower_quad, cauchy_kernel, 0, 1, 2 / 3, integral(cauchy_kernel, 0, 1))
release thm riemann_integral_compare(cauchy_kernel, unit_const, 0, 1, integral(cauchy_kernel, 0, 1), 1)

2 / 3 <= integral(cauchy_kernel, 0, 1)
integral(cauchy_kernel, 0, 1) <= 1
