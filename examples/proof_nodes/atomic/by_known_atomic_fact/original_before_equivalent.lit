# Reusing a predicate first checks the submitted argument, then visible equal objects.
# Both queries used to scan and clone the complete predicate bucket first.
prop marked(t R):
    t = t
have x R
let y = x
by def $marked(y)
by def $marked(x)
$marked(x)

prop pair_marked(a, b R):
    a = a
have u R
let v = u
by def $pair_marked(y,v)
$pair_marked(x,u)

# Negative controls for invalid domains and scope exit are executable Rust regressions.
# Check: target/release/litex -strict -lang en -f examples/proof_nodes/atomic/by_known_atomic_fact/original_before_equivalent.lit
