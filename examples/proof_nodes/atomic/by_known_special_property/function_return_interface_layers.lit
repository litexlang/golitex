# Before: the same verified calls retained their final carrier, but reading
# discarded the resolved second interface when the return space was an alias.
# Both calls below now retain t <- 1 and x <- 2, followed by the final R carrier.
# The C conclusion additionally records the native R-subset-C return guarantee.
# Acceptance: target/release/litex -strict -lang en -f examples/proof_nodes/atomic/by_known_special_property/function_return_interface_layers.lit
have property_reader_range set = fn(x R) R
have fn property_reader_aliased_builder(t R) property_reader_range = fn(x R) R {t + x}

property_reader_aliased_builder(1)(2) $in C
property_reader_aliased_builder(1)(2) $in R
