# Tracer: a stored standard carrier supplies its intrinsic supersets.
# Before (rejected):
# forall x Z:
#     x < 2
#     =>:
#         not x >= 2
# Former behavior: restricted order premises could not cite x in R from x in Z.
# Now: the stored source membership is cited; no child proof search is opened.
forall x Z:
    x < 2
    =>:
        not x >= 2

forall x Z:
    x < 2 or x >= 2

have integer_input Z
integer_input $in R

