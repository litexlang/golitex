# Tracer: negative factor reverses strict order
# Before: legacy same-placement law passed; current rejected.
# forall a,b,c R:
#     c<0
#     b<a
#     =>:
#         c*a<c*b
# Now: isolated baseline plus own rule overlay; actual chosen premise proofs retained.
forall a,b,c R:
    c<0
    b<a
    =>:
        c*a<c*b

forall a,b,c R:
    0>c
    a<b
    =>:
        a*c>c*b

# Boundary: missing/wrong signs or argument order, weak premises for strict goals, and strict zero comparisons reject.
