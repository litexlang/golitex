# Focused gate: target/release/litex -strict -f examples/proof_nodes/atomic/by_builtin_rule/ln_strict_order_reflection.lit
# Formerly rejected in truth search:
# forall a,b R+:
#     ln(a)<ln(b)
#     =>:
#         a<b

# Current; exp R / ln R+ remain checked domains.
forall a,b R+:
    ln(a)<ln(b)
    =>:
        a<b
