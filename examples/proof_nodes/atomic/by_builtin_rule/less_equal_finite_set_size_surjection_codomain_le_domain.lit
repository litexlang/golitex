# Node: atomic.ByBuiltinRule.LessEqual.FiniteSetSizeSurjectionCodomainLeDomain
# Run: litex -f examples/proof_nodes/atomic/by_builtin_rule/less_equal_finite_set_size_surjection_codomain_le_domain.lit
#
# Premise: known `$surjective(A, B, f)` and `$is_finite_set(A)`.

have A set = {1, 2}
have B set = {1}
have fn f(x A) B = 1
exist x A st {x = 1}
by def $surjective(A, B, f)
$is_finite_set(A)
finite_set_size(B) <= finite_set_size(A)
