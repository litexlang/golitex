# Before: this exact input was rejected at proof search.
# forall I nonempty_set,X set,A fn(idx I)power_set(X):
#     $is_finite_set(I)
#     forall k I:
#         $is_finite_set(A(k))
#     =>:
#         $is_finite_set(index_union(I,X,A))

# Now (verified in strict mode): same premises and conclusion.
forall I nonempty_set,X set,A fn(idx I)power_set(X):
    $is_finite_set(I)
    forall k I:
        $is_finite_set(A(k))
    =>:
        $is_finite_set(index_union(I,X,A))

