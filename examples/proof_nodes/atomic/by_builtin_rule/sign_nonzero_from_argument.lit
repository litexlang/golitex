# Rule: SignNonzeroFromArgument
# Before (rejected):
# forall x R:
#     x!=0
#     =>:
#         sign(x)!=0
# Former verifier behavior: rejected in the search_proof phase.
# Now (verified directly):
forall x R:
    x!=0
    =>:
        sign(x)!=0

# Boundary: Requires the checked x!=0 premise; unguarded sign(x)!=0 rejects.
# Gate: target/release/litex -strict -f examples/proof_nodes/atomic/by_builtin_rule/sign_nonzero_from_argument.lit
# Regression: tests/unit/execute/legacy_six_simple_bt/tests.rs
