forall a,b R:
    0<=a
    b<=pi
    a<b
    =>:
        cos(b)<cos(a)

forall a,b R:
    -pi/2<a
    b<pi/2
    a<b
    cos(a)!=0
    cos(b)!=0
    =>:
        tan(a)<tan(b)

forall a,b R:
