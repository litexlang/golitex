# Focused gate: target/release/litex -strict -f examples/proof_nodes/atomic/by_builtin_rule/exp_ln_order_author_routes.lit
# Complete unchanged targets: explicit strict-to-weak bridge, ln(1)=0 endpoint,
# inner exp order publication, and existing inverse equalities. No search reset.

# exp-stronger-weak-full-author-forward
claim:
    ? forall a,b R:
        a<b
        =>:
            exp(a)<=exp(b)
    a<=b
    exp(a)<=exp(b)

forall a,b R:
    a<b
    =>:
        exp(a)<=exp(b)

# exp-stronger-weak-full-author-reflect
claim:
    ? forall a,b R:
        exp(a)<exp(b)
        =>:
            a<=b
    exp(a)<=exp(b)
    a<=b

forall a,b R:
    exp(a)<exp(b)
    =>:
        a<=b

