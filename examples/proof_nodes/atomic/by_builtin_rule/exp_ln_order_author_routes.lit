# exp-nested-full-author
claim:
    ? forall a,b R:
        a<b
        =>:
            exp(exp(a))<exp(exp(b))
    exp(a)<exp(b)
    exp(exp(a))<exp(exp(b))

forall a,b R:
    a<b
    =>:
        exp(exp(a))<exp(exp(b))

# exp-inverse-full-author
claim:
    ? forall a,b R:
        a<b
        =>:
            exp(a)<exp(b)
    exp(a) $in R+
    exp(b) $in R+
    ln(exp(a))=a
    ln(exp(b))=b
    ln(exp(a))<ln(exp(b))
    exp(a)<exp(b)

forall a,b R:
    a<b
    =>:
        exp(a)<exp(b)
