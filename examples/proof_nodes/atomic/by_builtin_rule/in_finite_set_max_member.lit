# Rule: FiniteSetMaxMember
# Run: target/release/litex -strict -f examples/proof_nodes/atomic/by_builtin_rule/in_finite_set_max_member.lit
# Formerly rejected after WD:
# claim:
#     ? forall S finite_set:
#         S $subset R
#         $is_nonempty_set(S)
#         =>:
#             finite_set_max(S) $in S
# Empty/infinite/non-real input remains rejected by WD (Rust controls).
claim:
    ? forall S finite_set:
        S $subset R
        $is_nonempty_set(S)
        =>:
            finite_set_max(S) $in S
