# Node: atomic.ByBuiltinRule.SubsetFact.SubsetCartComponentwise
# Rule struct: SubsetCartComponentwiseBuiltinRuleProof
# Run: litex -f examples/proof_nodes/atomic/by_builtin_rule/subset_cart_componentwise.lit

forall A set, B set, C set, D set:
    A $subset C
    B $subset D
    =>:
        cart(A, B) $subset cart(C, D)
