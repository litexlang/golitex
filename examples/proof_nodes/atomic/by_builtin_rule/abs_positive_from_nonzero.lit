# Focused gate: target/release/litex -lang en -strict -f examples/proof_nodes/atomic/by_builtin_rule/abs_positive_from_nonzero.lit
# Formerly rejected in truth search:
# forall x R:
#     x != 0
#     =>:
#         abs(x) > 0

forall x R:
    x != 0
    =>:
        abs(x) > 0

# A difference supplies its nonzero bridge explicitly.
forall x,y R:
    x-y != 0
    =>:
        0 < abs(x-y)

# Boundary: x=0 and non-real arguments are rejected by executable Rust controls.
