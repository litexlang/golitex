# Node: atomic.ByBuiltinRule.SubsetFact.SubsetSetMinusCommonRightMonotone
# Rule struct: SubsetSetMinusCommonRightMonotoneBuiltinRuleProof
# Run: litex -f examples/proof_nodes/atomic/by_builtin_rule/subset_set_minus_common_right_monotone.lit

forall A set, B set, C set:
    A $subset B
    =>:
        set_minus(A, C) $subset set_minus(B, C)
