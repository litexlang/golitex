# Rule: SignWeakMonotone
# Before (rejected):
# forall a,b R:
#     a<=b
#     =>:
#         sign(a)<=sign(b)
# Former behavior: strict run success=false, phase search_proof.
# Now (verified directly):
forall a,b R:
    a<=b
    =>:
        sign(a)<=sign(b)

forall a,b R:
    b>=a
    =>:
        sign(b)>=sign(a)

# Boundary: Requires checked argument order; neither strict preservation nor weak-order reflection is implied.
# Gate: target/release/litex -strict -f examples/proof_nodes/atomic/by_builtin_rule/sign_weak_monotone.lit
# Regression: tests/unit/execute/legacy_six_simple_bt/tests.rs
