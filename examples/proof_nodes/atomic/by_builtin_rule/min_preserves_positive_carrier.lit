# Tracer: MinPreservesPositiveCarrier.
# Before (typed value rejected without a sign case proof):
# have a,b R+
# have delta R+ = min(a,b)
# Former behavior: positive membership was a search_proof miss.
# Now: the minimum consumes both checked positive-real memberships.
# Boundary: an arbitrary real, zero or negative operand cannot supply this refinement.
# A nested minimum may use a checked typed intermediate; no search ceiling is widened.
# Evidence: target/release/litex -lang en -strict -f examples/proof_nodes/atomic/by_builtin_rule/min_preserves_positive_carrier.lit

have a,b,c R+
have first_radius R+ = min(a,b)
have common_radius R+ = min(first_radius,c)

forall lower_radius,upper_radius R+:
    min(lower_radius,upper_radius) $in R+

# A positive displayed pair, with its ordinary finite-set domains.
forall left_radius,right_radius R+:
    left_radius!=right_radius
    $is_finite_set({left_radius,right_radius})
    $is_nonempty_set({left_radius,right_radius})
    {left_radius,right_radius} $subset R
    =>:
        finite_set_min({left_radius,right_radius}) $in R+
