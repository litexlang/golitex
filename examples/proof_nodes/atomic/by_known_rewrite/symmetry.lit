# Node: atomic.ByKnownRewrite.Symmetry
# Run: litex -f examples/proof_nodes/atomic/by_known_rewrite/symmetry.lit
#
# Registers symmetric swap for `same`, then proves the swap forall
# (parameter types must be `set` for `register symmetric`).

prop same(x set, y set):
    x = y

register symmetric:
    ? forall x, y set:
        $same(x, y)
        =>:
            $same(y, x)

forall x, y set:
    $same(x, y)
    =>:
        $same(y, x)
