# Node: atomic.ByKnownRewrite.Reflexivity
# Run: litex -f examples/proof_nodes/atomic/by_known_rewrite/reflexivity.lit
#
# Registers `same` as reflexive, then proves `$same(a, a)`.
# (Goal may also succeed via ByDefinition from `x = y`; registration is the
# wired path under test here.)

prop same(x set, y set):
    x = y

register reflexive:
    ? forall x set:
        $same(x, x)

have a set
$same(a, a)
