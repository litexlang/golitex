# Before: arithmetic matching could only cite already-known operand equalities.
# Now: the bounded arithmetic strategy checks projection/calculation operands.
# Gate: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_strategy/arithmetic_congruence.lit
(1, 2)[1] + (3, 4)[1] = 1 + 3
(1, 2)[2] * (3, 4)[2] = 2 * 4
