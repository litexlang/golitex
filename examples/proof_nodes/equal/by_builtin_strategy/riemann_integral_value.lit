# The original automatic route stopped at proof search for these statements.
# have fn square(x R) R=x^2
# $is_riemann_integrable(square,0,1)
# $has_riemann_integral(square,0,1,1/3)
# Integral well-definedness verifies integrability through the shared verifier.
# All functions must cover the sorted closed interval, including its endpoints.
# Check with target/release/litex -strict -lang en -f examples/proof_nodes/equal/by_builtin_strategy/riemann_integral_value.lit

have fn p(x R) R=3*x^2+2*x+1
integral(p,0,1)=3
3=integral(p,0,1)

integral(p,1,0)=-3
integral(p,2,2)=0

forall a,b,c R:
    integral(fn(x R) R {a*x^2+b*x+c},0,1)=a/3+b/2+c

forall n N,a,b R:
    integral(fn(x R) R {x^n},a,b)=(b^(n+1)-a^(n+1))/(n+1)

forall c R*:
    integral(fn(x R) R {x/c},0,1)=1/(2*c)

forall f,g fn(x R) R,a,b,I,J R:
    $integrable(f,a,b)
    $integrable(g,a,b)
    integral(f,a,b)=I
    integral(g,a,b)=J
    =>:
        integral(fn(x R) R {3*f(x)-g(x)/2+7},a,b)=3*I-J/2+7*(b-a)

forall f,g fn(x R) R,a,b R:
    $integrable(f,a,b)
    $integrable(g,a,b)
    =>:
        integral(fn(x R) R {3*f(x)-g(x)/2+7},a,b)=3*integral(f,a,b)-integral(g,a,b)/2+7*(b-a)
        $integrable(fn(x R) R {f(x)*g(x)+abs(f(x))^2},a,b)

$integrable(fn(x R) R {sin(x^2)+exp(x)*cos(x)},0,1)
$integrable(fn(x R) R {1/(x^2+1)},0,1)

forall f fn(x R) R:
    forall x '[0,1]:
        $cont_at(f,x)
    =>:
        $integrable(f,0,1)

forall f fn(x R) R,g fn(x R) R*:
    $integrable(f,0,1)
    forall x '[0,1]:
        $cont_at(g,x)
    =>:
        $integrable(fn(x R) R {f(x)/g(x)},0,1)

prop zero_integral(f fn(x R) R,a,b R):
    $integrable(f,a,b)
    integral(f,a,b)=0

have fn odd_power(x R) R=x^3
$integrable(odd_power,-1,1)
by def $zero_integral(odd_power,-1,1)

# Value calculation covers powers and linear combinations with established leaves.
# Automatic substitution and integration by parts require additional proof routes.
# Incorrect integral values and insufficient interval coverage are rejected.
