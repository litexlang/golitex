# Before: tuple matching only cited coordinate equalities already known.
# Now: the bounded tuple strategy proves each coordinate equality.
# Gate: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_strategy/tuple_component_calculation.lit
# Boundary: unequal lengths and an incorrect coordinate must still fail.
(1 + 3, 2 + 4) = (4, 6)
((1 + 3, 2 + 4), 1 + 1) = ((4, 6), 2)
