claim:
    ? forall a,b,z R+,n Z:
        n!=0
        a^n=z
        z=b^n
        =>:
            a=b
    a^n=b^n
    a=b
forall a,b,z R+,n Z:
    n!=0
    a^n=z
    z=b^n
    =>:
        a=b
