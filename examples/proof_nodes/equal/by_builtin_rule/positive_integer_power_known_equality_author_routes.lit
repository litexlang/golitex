claim:
    ? forall a,b R,n Z:
        0<a
        0<b
        n!=0
        a^n=b^n
        =>:
            a=b
    a $in R+
    b $in R+
    a=b
forall a,b R,n Z:
    0<a
    0<b
    n!=0
    a^n=b^n
    =>:
