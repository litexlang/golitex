# Before: union(set_minus(A,B),set_minus(B,A)) (write the expansion explicitly).
# Now: native objects preserve domains and expose named builtin relationships.
# Public spelling: set_diff (symmetric difference); set_minus is ordinary subtraction.
# Negative/domain controls: tests/unit/execute/native_latex_operations/tests.rs
# Check: target/release/litex -lang en -strict -f examples/proof_nodes/equal/by_builtin_rule/symmetric_difference.lit

forall A,B set:
    set_diff(A,B)=union(set_minus(A,B),set_minus(B,A))

forall A,B set:
    set_diff(A,B)=set_diff(B,A)

forall A,B set:
    set_diff(set_diff(A,B),B)=A

forall A,B set:
    set_diff(A,B)=set_minus(union(A,B),intersect(A,B))

forall A set:
    set_diff(A,A)={}

forall A set:
    set_diff(A,{})=A

forall A set:
    set_diff({},A)=A

forall A,B,D set:
    set_diff(set_diff(A,B),D)=set_diff(A,set_diff(B,D))

forall A,B,D set:
    intersect(A,set_diff(B,D))=set_diff(intersect(A,B),intersect(A,D))

1 $in set_diff({1,2},{2,3})

3 $in set_diff({1,2},{2,3})

not 2 $in set_diff({1,2},{2,3})

not 4 $in set_diff({1,2},{2,3})

set_diff({1,2},{2,3}) = {1,3}
