# Common cross-Obj relations with explicit checked author routes.
# Task: final Obj relations audit, 2026-10-05.
# Run: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_rule/common_obj_relation_author_routes.lit
# Every sketch is independent. Guarded/restricted domains remain explicit.

# A05-materialized-members
sketch:
    claim:
        ? forall a,b R:
            a!=b
            =>:
                finite_set_max({a,b})=max(a,b)
        finite_set_max({a,b}) $in {a,b}
        a $in {a,b}
        b $in {a,b}
        a<=finite_set_max({a,b})
        b<=finite_set_max({a,b})
        by cases:
            ? finite_set_max({a,b})=max(a,b)
            case finite_set_max({a,b})=a:
                b<=a
                max(a,b)=a
            case finite_set_max({a,b})=b:
                a<=b
                max(a,b)=b


# A06-explicit-finite-union
sketch:
    claim:
        ? forall S,T finite_set:
            $is_nonempty_set(S)
            $is_nonempty_set(T)
            S $subset R
            T $subset R
            =>:
                finite_set_max(union(S,T))=max(finite_set_max(S),finite_set_max(T))
        $is_finite_set(union(S,T))
        union(S,T) $subset R
        $is_nonempty_set(union(S,T))
        finite_set_max(S) $in S
        finite_set_max(T) $in T
        finite_set_max(S) $in union(S,T)
        finite_set_max(T) $in union(S,T)
        finite_set_max(S)<=finite_set_max(union(S,T))
        finite_set_max(T)<=finite_set_max(union(S,T))
        finite_set_max(union(S,T)) $in union(S,T)
        by cases:
            ? finite_set_max(union(S,T))=max(finite_set_max(S),finite_set_max(T))
            case finite_set_max(S)<=finite_set_max(T):
                max(finite_set_max(S),finite_set_max(T))=finite_set_max(T)
                by cases:
                    ? finite_set_max(union(S,T))<=finite_set_max(T)
                    case finite_set_max(union(S,T)) $in S:
                        finite_set_max(union(S,T))<=finite_set_max(S)<=finite_set_max(T)
                    case finite_set_max(union(S,T)) $in T:
                        finite_set_max(union(S,T))<=finite_set_max(T)
                finite_set_max(union(S,T))=finite_set_max(T)
            case finite_set_max(T)<finite_set_max(S):
                finite_set_max(T)<=finite_set_max(S)
                max(finite_set_max(S),finite_set_max(T))=finite_set_max(S)
                by cases:
                    ? finite_set_max(union(S,T))<=finite_set_max(S)
                    case finite_set_max(union(S,T)) $in S:
                        finite_set_max(union(S,T))<=finite_set_max(S)
                    case finite_set_max(union(S,T)) $in T:
                        finite_set_max(union(S,T))<=finite_set_max(T)<=finite_set_max(S)
                finite_set_max(union(S,T))=finite_set_max(S)


# A07-canonical-form
sketch:
    forall S,T finite_set:
        finite_set_size(union(S,T))=finite_set_size(S)+finite_set_size(T)-finite_set_size(intersect(S,T))


# A08-canonical-difference
sketch:
    claim:
        ? forall S,T finite_set:
            T $subset S
            =>:
                finite_set_size(set_minus(S,T))=finite_set_size(S)-finite_set_size(T)
        by extension intersect(S,T)=T
        finite_set_size(set_minus(S,T))=finite_set_size(S)-finite_set_size(intersect(S,T))


# C02-rectangular-form
sketch:
    claim:
        ? forall z C:
            C_abs(z)^2=re(z)^2+img(z)^2
        z=re(z)+i*img(z)
        C_abs(z)^2=C_abs(re(z)+i*img(z))^2
        C_abs(re(z)+i*img(z))^2=re(z)^2+img(z)^2


# C03-principal-root
sketch:
    claim:
        ? forall x R:
            C_abs(x)=abs(x)
        x=x+i*0
        C_abs(x)^2=C_abs(x+i*0)^2=x^2+0^2=x^2
        0<=C_abs(x)
        sqrt(C_abs(x)^2)=C_abs(x)
        sqrt(x^2)=abs(x)
        C_abs(x)=sqrt(C_abs(x)^2)=sqrt(x^2)=abs(x)


# D01-division-window
sketch:
    claim:
        ? forall x R,n Z:
            n<=x
            x<n+1
            =>:
                floor(x)=n
        floor(x)<=x
        floor(n)=n
        floor(n)<=floor(x)
        n<=floor(x)
        floor(x)<n+1
        floor(x)<=n
        floor(x)=n
    claim:
        ? forall a Z,d N+:
            quot(a,d)=floor(a/d)
        0<d
        a=d*quot(a,d)+a%d
        0<=a%d
        a%d<d
        d*quot(a,d)<=d*quot(a,d)+a%d=a
        quot(a,d)=(d*quot(a,d))/d<=a/d
        a=d*quot(a,d)+a%d<d*quot(a,d)+d=d*(quot(a,d)+1)
        a/d<(d*(quot(a,d)+1))/d=quot(a,d)+1
        floor(a/d)=quot(a,d)


# D03-equality-chain
sketch:
    claim:
        ? forall a Z,d N+:
            quot(a,d)=(a-a%d)/d
        a=d*quot(a,d)+a%d
        (a-a%d)/d=(d*quot(a,d)+a%d-a%d)/d=quot(a,d)


# D04-materialized-instance
sketch:
    claim:
        ? forall x R,n Z:
            n<=x
            x<n+1
            =>:
                floor(x)=n
        floor(x)<=x
        floor(n)=n
        floor(n)<=floor(x)
        n<=floor(x)
        floor(x)<n+1
        floor(x)<=n
        floor(x)=n
    claim:
        ? forall a Z,d N+:
            quot(a,d)=floor(a/d)
        0<d
        a=d*quot(a,d)+a%d
        0<=a%d
        a%d<d
        d*quot(a,d)<=d*quot(a,d)+a%d=a
        quot(a,d)=(d*quot(a,d))/d<=a/d
        a=d*quot(a,d)+a%d<d*quot(a,d)+d=d*(quot(a,d)+1)
        a/d<(d*(quot(a,d)+1))/d=quot(a,d)+1
        floor(a/d)=quot(a,d)
    claim:
        ? forall a Z,d N+:
            a%d=a-d*floor(a/d)
        quot(a,d)=floor(a/d)
        a=d*quot(a,d)+a%d
        a%d=a-d*quot(a,d)=a-d*floor(a/d)


# D08-natural-domain
sketch:
    claim:
        ? forall a,b N:
            a!=0
            gcd(a,b)=1
            =>:
                $coprime(a,b)
        by def $coprime(a,b)


