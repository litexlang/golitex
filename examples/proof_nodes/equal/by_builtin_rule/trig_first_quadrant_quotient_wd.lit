forall x R:
    0<x
    x<pi/2
    =>:
        tan(x)=sin(x)/cos(x)

forall x R:
    x>0
    pi/2>x
    =>:
        cot(x)=cos(x)/sin(x)
        tan(x)*cot(x)=1

