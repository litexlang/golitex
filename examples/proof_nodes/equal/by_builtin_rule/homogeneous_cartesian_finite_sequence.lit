# Run: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_rule/homogeneous_cartesian_finite_sequence.lit

forall S set:
    cart_n(S,3)=cart(S,S,S)
    cart(S,S,S)=cart_n(S,3)
    cart_n(S,1)=cart(S)
    cart_n(S,0)=cart()
have carrier set = R
have dimension N = 3
cart(carrier,R,carrier)=cart_n(R,dimension)
