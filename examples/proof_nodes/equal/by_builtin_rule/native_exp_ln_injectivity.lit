claim:
    ? forall a,b R:
        exp(a)=exp(b)
        =>:
            a=b
    ln(exp(a))=a
    ln(exp(b))=b
    ln(exp(a))=ln(exp(b))
    a=ln(exp(a))=ln(exp(b))=b
forall a,b R:
    exp(a)=exp(b)
    =>:
        a=b
claim:
    ? forall a,b R+:
        ln(a)=ln(b)
        =>:
            a=b
    exp(ln(a))=a
    exp(ln(b))=b
    exp(ln(a))=exp(ln(b))
    a=exp(ln(a))=exp(ln(b))=b
forall a,b R+:
    ln(a)=ln(b)
    =>:
        a=b
