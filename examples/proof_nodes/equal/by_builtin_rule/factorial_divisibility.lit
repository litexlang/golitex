# Before: the exact mathematical target failed proof search.
# forall m,n N:
#     m<=n
#     factorial(m) $in N+
#     factorial(n) $in Z
#     =>:
#         factorial(n)%factorial(m)=0

# Now (verified in strict mode): same mathematical target and premises.
forall m,n N:
    m<=n
    factorial(m) $in N+
    factorial(n) $in Z
    =>:
        factorial(n)%factorial(m)=0

