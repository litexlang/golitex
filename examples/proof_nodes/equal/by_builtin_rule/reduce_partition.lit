# ReducePartition: adjacent closed integer intervals preserve the left fold.
# Gate: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_rule/reduce_partition.lit
# Previously rejected, exact legacy-positive source:
# have op fn(a,b R)R
# have f fn(k Z)R
# reduce(1,4,f,op,0) = reduce(3,4,f,op,reduce(1,2,f,op,0))
have op fn(a,b R)R
have f fn(k Z)R
reduce(1,4,f,op,0) = reduce(3,4,f,op,reduce(1,2,f,op,0))
forall a,b,c Z, s R, g fn(k Z)R, operation fn(x,y R)R:
    a <= b
    b < c
    =>:
        reduce(a,c,g,operation,s) = reduce(b+1,c,g,operation,reduce(a,b,g,operation,s))
# Boundary: overlap, gap, changed seed/function/operation fail in Rust regressions.
