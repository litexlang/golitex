# Node: equal — empty finite-sequence literal `[]`
# Run: litex -f examples/proof_nodes/equal/by_builtin_rule/empty_finite_seq_literal.lit
#
# When: compare / inhabit length-zero finite sequences.
# After: `[]` is well-defined and equals `finite_seq(R, 0)`'s empty value.

[] = []
have no_terms finite_seq(R, 0) = []
[] $in finite_seq(R, 0)
[1, 2, 3] $in finite_seq(N+, 3)
