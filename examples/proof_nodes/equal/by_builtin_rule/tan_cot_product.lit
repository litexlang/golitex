# Tracer: TanCotProduct with real inputs and the original partial-operation guards.
# Before: legacy accepted; current equality search rejected this exact source.
# forall x R:
#     sin(x)!=0
#     cos(x)!=0
#     =>:
#         tan(x)*cot(x)=1
# Now: fixed identity leaf after complete parent WD; no premise search or fuel reset.
forall x R:
    sin(x)!=0
    cos(x)!=0
    =>:
        tan(x)*cot(x)=1

forall x R:
    sin(x)!=0
    cos(x)!=0
    =>:
        1=cot(x)*tan(x)

