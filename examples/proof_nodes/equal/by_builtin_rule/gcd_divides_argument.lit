# Node: equal.ByBuiltinRule.GcdDividesArgument
# Run: litex -f examples/proof_nodes/equal/by_builtin_rule/gcd_divides_argument.lit

have a Z
have b Z
# Narrow trust: gcd WD currently needs a nonzero witness and N+ / nonzero carrier.
trust a != 0
trust gcd(a, b) $in N+
trust gcd(a, b) != 0
a % gcd(a, b) = 0
