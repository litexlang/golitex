# Composite-divisor same-target authors. No trust or additional hypotheses.
# Exact former current failed shortcut (cold legacy passed):
# forall a,b,c,d R:
#     b!=0
#     d!=0
#     a/(b*d)=c
#     =>:
#         a=c*(b*d)

# author-early-nz-R
claim:
    ? forall a,b,c,d R:
        b!=0
        d!=0
        a/(b*d)=c
        =>:
            a=c*(b*d)
    b*d!=0
    a=(a/(b*d))*(b*d)=c*(b*d)

forall a,b,c,d R:
    b!=0
    d!=0
    a/(b*d)=c
    =>:
        a=c*(b*d)

