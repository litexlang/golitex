# orientation-R-s1-g1-p1
claim:
    ? forall a,b,c,d R:
        b!=0
        d!=0
        c=a/(b*d)
        =>:
            (b*d)*c=a
    b*d!=0
    a=(a/(b*d))*(b*d)=c*(b*d)
    c*(b*d)=(b*d)*c
    (b*d)*c=a

forall a,b,c,d R:
    b!=0
    d!=0
    c=a/(b*d)
    =>:
        (b*d)*c=a

