# named-divisor-R
claim:
    ? forall a,b,c,d R:
        b!=0
        d!=0
        a/(b*d)=c
        =>:
            a=c*(b*d)
    b*d!=0
    let m=b*d
    m!=0
    a/m=a/(b*d)=c
    a=(a/m)*m=c*m=c*(b*d)

