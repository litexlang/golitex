# forall x R:
#     cos(pi/2-x)=sin(x)
forall x R:
    cos(pi/2-x)=sin(x)
forall x R:
    sin(x)=cos(pi*(1/2)+(-x))
forall x R:
    cos(pi/2-(x+1))=sin(x+1)
