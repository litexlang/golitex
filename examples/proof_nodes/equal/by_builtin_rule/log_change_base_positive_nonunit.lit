# Former strict-session failure (same source; no trust):
# forall a,b,x R+:
#     a!=1
#     b!=1
#     =>:
#         log(a,x)=log(b,x)/log(b,a)

forall a,b,x R+:
    a!=1
    b!=1
    =>:
        log(a,x)=log(b,x)/log(b,a)

forall a,b,x R+:
    a<1
    b<1
    =>:
        log(a,x)=log(b,x)/log(b,a)
