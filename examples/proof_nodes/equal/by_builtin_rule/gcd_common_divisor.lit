forall a,b Z,d N+:
    a!=0
    a%d=0
    b%d=0
    =>:
        gcd(a,b)%d=0

forall a,b Z,d N+:
    b!=0
    a%d=0
    b%d=0
    =>:
        0=gcd(a,b)%d
