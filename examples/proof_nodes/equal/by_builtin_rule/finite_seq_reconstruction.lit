# Tracer: reconstruct a finite sequence from every ordered coordinate.
# Before (release baseline: search_proof failure):
# claim:
#     ? forall x finite_seq(R, 2):
#         x = (x(1), x(2))
# Now: the same bodyless claim uses stored complete-domain membership.
# Boundary: wrong length, order, receiver, or partial domain must reject.
# Evidence: target/release/litex -strict -lang en -f examples/proof_nodes/equal/by_builtin_rule/finite_seq_reconstruction.lit
# Rust: equality_search::finite_seq_reconstruction tests.
forall x finite_seq(R, 2):
    x = (x(1), x(2))

forall S set, x finite_seq(S, 3):
    (x(1), x(2), x(3)) = x

forall x finite_seq(R, 1):
    x = tuple(x(1))

forall x finite_seq(R, 0):
    x = tuple()
