# Nested modulus reduction requires an integer multiplier, in addition to WD.
# Previously accepted false equality (left is 1, right is 3); now rejected:
# (3 % ((1/2)*4)) % 4 = 3 % 4
# Reverse product is the same remaining rejection boundary:
# (3 % (4*(1/2))) % 4 = 3 % 4
# Gate: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_rule/nested_mod_integer_multiple.lit
forall a Z,k,m N+:
    (a%(k*m))%m=a%m
forall a Z,k,m N+:
    (a%(m*k))%m=a%m
forall a,k Z,m N+:
    k*m $in N+
    =>:
        (a%(k*m))%m=a%m
(3%((1/2)*4))%4=1
3%4=3
# Nonzero signed moduli remain legal; a negative integer multiplier is valid.
(3%((-2)*4))%4=3%4
