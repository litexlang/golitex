# Before: this exact input was rejected at proof search.
# forall A,B finite_set,f fn(x union(A,B))R:
#     intersect(A,B)={}
#     =>:
#         finite_set_sum(union(A,B),f)=finite_set_sum(A,fn(x A)R {f(x)})+finite_set_sum(B,fn(x B)R {f(x)})

# Now (verified in strict mode): same premises and conclusion.
forall A,B finite_set,f fn(x union(A,B))R:
    intersect(A,B)={}
    =>:
        finite_set_sum(union(A,B),f)=finite_set_sum(A,fn(x A)R {f(x)})+finite_set_sum(B,fn(x B)R {f(x)})

