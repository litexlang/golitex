abs(-3) = 3
abs(3) = 3
min(1, 2) = 1
max(1, 2) = 2
min(2, 1) = 1
max(-1, -3) = -1
2^3 = 8
(-2)^3 = -8
floor(2.5) = 2
ceil(2.5) = 3
