# Formerly rejected:
# C_abs(3 + 4 * i) = 5
# C_abs(4 * i + 3) = 5
# C_abs(3 - 4 * i) = 5
# C_abs(-4 * i + 3) = 5
# Exact coordinates and the nonnegative principal root of a^2+b^2.
# Run: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_rule/numeric_complex_modulus.lit
C_abs(3 + 4 * i) = 5
C_abs(4 * i + 3) = 5
C_abs(3 - 4 * i) = 5
C_abs(-4 * i + 3) = 5
C_abs(i * 4 + 3) = 5
C_abs(-(3 + 4 * i)) = 5
C_abs(-3) = 3
C_abs(-i) = 1
C_abs(0) = 0
C_abs(0.3 + 0.4 * i) = 0.5
C_abs(1 / 3 + 4 / 9 * i) = 5 / 9
C_abs(1 + i) = sqrt(2)
C_abs((1 + i) * (1 - i)) = 2
forall z C:
    C_abs(z) >= 0
eval C_abs(3 - 4 * i)
eval C_abs(1 + i)
# Negative roots reject; arbitrary unknown coordinates need additional evidence.
