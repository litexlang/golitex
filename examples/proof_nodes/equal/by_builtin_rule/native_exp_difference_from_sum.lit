claim:
    ? forall x R:
        exp(x)!=0
    0<exp(x)
    exp(x)!=0
forall x R:
    exp(x)!=0
claim:
    ? forall a,b R:
        exp(a-b)=exp(a)/exp(b)
    exp(b)!=0
    (a-b)+b=a
    exp((a-b)+b)=exp(a-b)*exp(b)
    exp(a)=exp((a-b)+b)
    exp(a)=exp(a-b)*exp(b)
    exp(a-b)=(exp(a-b)*exp(b))/exp(b)=exp(a)/exp(b)
forall a,b R:
    exp(a-b)=exp(a)/exp(b)
