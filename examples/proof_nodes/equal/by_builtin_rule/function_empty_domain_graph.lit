$is_nonempty_set(fn(k {}) {})

have empty_fn fn(k {}) {}

fn_range(empty_fn)={}

$is_nonempty_set(finite_seq({},0))

have empty_seq finite_seq({},0)

fn_range(empty_seq)={}

