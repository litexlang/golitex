# Previously rejected, exact legacy-positive source:
# forall S finite_set,a S,f fn(x S)R:
#     finite_set_product(S,f) = finite_set_product(set_minus(S,{a}),fn(x set_minus(S,{a}))R {f(x)})*f(a)
forall S finite_set,a S,f fn(x S)R:
    finite_set_product(S,f) = finite_set_product(set_minus(S,{a}),fn(x set_minus(S,{a}))R {f(x)})*f(a)
