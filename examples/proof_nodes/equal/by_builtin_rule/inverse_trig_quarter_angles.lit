# Tracer: quarter-angle inverse values through principal right inverses.
# Before (direct assertions rejected by proof search):
# arctan(1)=pi/4
# arctan(-1)=-pi/4
# arccot(1)=pi/4
# arccot(-1)=3*pi/4
# Now: forward value, principal range and explicit equality chain.

sketch:
    (-pi)/2 $in R
    pi/2 $in R
    pi/4 $in R
    cos(pi/4)!=0
    tan(pi/4)=1
    (-pi)/2<pi/4
    pi/4<pi/2
    arctan(1)=arctan(tan(pi/4))=pi/4

sketch:
    (-pi)/2 $in R
    pi/2 $in R
    (-pi)/4 $in R
    cos(-pi/4)!=0
    tan(-pi/4)=-1
    (-pi)/2<(-pi)/4
    (-pi)/4<pi/2
    arctan(-1)=arctan(tan(-pi/4))=(-pi)/4

sketch:
    0 $in R
    pi $in R
    pi/4 $in R
    sin(pi/4)!=0
    cot(pi/4)=1
    0<pi/4
    pi/4<pi
    arccot(1)=arccot(cot(pi/4))=pi/4

sketch:
    0 $in R
    pi $in R
    3*pi/4 $in R
    sin(3*pi/4)!=0
    cot(3*pi/4)=-1
    0<3*pi/4
    3*pi/4<pi
    arccot(-1)=arccot(cot(3*pi/4))=3*pi/4

# Boundary: arccot(-1)=-pi/4 and right inverses outside principal ranges reject.
# Evidence: target/release/litex -strict -f examples/proof_nodes/equal/by_builtin_rule/inverse_trig_quarter_angles.lit
# Regression: cargo test --release rational_pi_order_and_inverse_principal_values -- --nocapture
