# quotient-alias-R-author
claim:
    ? forall a,b,c,z R:
        b!=0
        a/b=z
        z=c
        =>:
            a=c*b
    a/b=c
    a=(a/b)*b=c*b

forall a,b,c,z R:
    b!=0
    a/b=z
    z=c
    =>:
        a=c*b

# product-alias-C-author
claim:
    ? forall a,b,c,z C:
        b!=0
        a=z
        z=b*c
        =>:
            a/b=c
    a=b*c
    a/b=(b*c)/b=c

forall a,b,c,z C:
    b!=0
    a=z
    z=b*c
    =>:
        a/b=c

# left-cancel-R-author
claim:
    ? forall a,b,c R:
        a!=0
        a*b=a*c
        =>:
            b=c
    b=(a*b)/a=(a*c)/a=c

forall a,b,c R:
    a!=0
    a*b=a*c
    =>:
        b=c

# mul-right-cancel-C-author
claim:
    ? forall a,b,c C:
        a!=0
        b*a=c*a
        =>:
            b=c
    b=(b*a)/a=(c*a)/a=c

forall a,b,c C:
    a!=0
    b*a=c*a
    =>:
        b=c

# cross-multiply-R-author
claim:
    ? forall a,b,c,d R:
        b!=0
        d!=0
        a/b=c/d
        =>:
            a*d=b*c
    a*d=(a/b)*(b*d)=(c/d)*(b*d)=b*c

forall a,b,c,d R:
    b!=0
    d!=0
    a/b=c/d
    =>:
        a*d=b*c
