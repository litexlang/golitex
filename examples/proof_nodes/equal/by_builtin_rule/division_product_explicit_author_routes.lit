# Explicit multiplication/division proofs using current arithmetic identities.
# Audit baseline e9f4f30a: the original cold short goals below miss equality search.
# Each active claim keeps the original premises and conclusion, then checks reuse.
# Old short forward input:
# forall a,b,c R:
#     b!=0
#     a/b=c
#     =>:
#         a=c*b
# Old short reverse input:
# forall a,b,c R:
#     b!=0
#     a=b*c
#     =>:
#         a/b=c
# Composite divisor a/(b*d)=c -> a=c*(b*d) remains a migration candidate.

# div-to-product-R-c_b-author
claim:
    ? forall a,b,c R:
        b!=0
        a/b=c
        =>:
            a=c*b
    a=(a/b)*b=c*b

forall a,b,c R:
    b!=0
    a/b=c
    =>:
        a=c*b

# product-to-div-R-b_c-author
claim:
    ? forall a,b,c R:
        b!=0
        a=b*c
        =>:
            a/b=c
    a/b=(b*c)/b=c

forall a,b,c R:
    b!=0
    a=b*c
    =>:
        a/b=c

