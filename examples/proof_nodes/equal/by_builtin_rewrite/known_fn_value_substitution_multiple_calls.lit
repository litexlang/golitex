# Repeated calls and two equation sides share one substitution pass.
# Run: target/release/litex -lang en -strict -f examples/proof_nodes/equal/by_builtin_rewrite/known_fn_value_substitution_multiple_calls.lit
# Explicit middle term: (x+1)+(x+1)=2*(x-1)+4.
have fn left(x R) R = x + 1
have fn right(x R) R = x - 1

thm doubled_values:
    ? forall x R:
        left(x) + left(x) = 2 * right(x) + 4
    left(x) = x + 1
    x - 1 = right(x)
