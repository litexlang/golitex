# Tracer: exact equality candidates are indexed by the opposite constructor.
# Before storage: every equality and membership shared one property vector.
# Now storage: anonymous functions, tuples, cart, builders, lists and ranges
# have separate buckets; proof behavior and original source FactIds stay fixed.
# Boundary: an alias chain alone supplies no anonymous body. Rust tests run
# that negative, failed-statement rollback, local scope and both orientations.
# Gate: target/release/litex -lang en -strict -f examples/proof_nodes/equal/by_object_definition/by_fn_application/classified_exact_properties.lit

have fn step(x R) R = x + 1
forall x R:
    2 * step(x) = 2 + 2 * x

let alias = step
alias = fn(x R) R {x + 1}
alias(2) = 3

forall f fn(t R: t > 0) R, x R:
    fn(t R: t > 0) R {t} = f
    x > 0
    =>:
        2 * f(x) = 2 * x

let pair = (1, 2)
pair(2) = 2
let Coordinates = cart(R, R)
forall point Coordinates:
    point(1) $in R
    point(2) $in R

let positive = {x R: x > 0}
forall x positive:
    x > 0

let listed = {1, 2}
let half_open = range(1, 3)
let closed = closed_range(1, 2)
eval finite_set_sum(listed, fn(x R) R {x})
eval finite_set_sum(half_open, fn(x R) R {x})
eval finite_set_sum(closed, fn(x R) R {x})

have a R = 1 / 2
a + a = 1
