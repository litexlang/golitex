# Template set-valued beta using the parent's checked call domain.
# Before: the following defining equality was rejected after both sides passed WD.
# \inverse_part<S, T, f>(B) = {x S: f(x) $in B}
# Now: checked template arguments, complete call domain/guards and the residual
# equality are retained as evidence, without rechecking a synthetic lambda.
# Boundary: changing free functions or omitting guards still rejects.
# Run: target/release/litex -strict -lang en -f examples/proof_nodes/equal/by_object_definition/by_template/set_valued_application.lit

template<S, T set, f fn(x S) T>:
    have fn inverse_part(B power_set(T)) power_set(S) = {x S: f(x) $in B}
claim:
    ? forall S, T set, f fn(x S) T, B power_set(T):
        \inverse_part<S, T, f>(B) = {x S: f(x) $in B}
    \inverse_part<S, T, f>(B) $in power_set(S)

template<I, S, T set, f fn(x S) T, family fn(j I) power_set(T)>:
    have fn family_preimages(j I) power_set(S) = {x S: f(x) $in family(j)}
claim:
    ? forall I, S, T set, f fn(x S) T, family fn(j I) power_set(T), j I:
        \family_preimages<I, S, T, f, family>(j) = {x S: f(x) $in family(j)}

template<c R>:
    have fn reciprocal_shift(x R: x != c) R = 1 / (x - c)
\reciprocal_shift<2>(3) = 1
