# Tracer: a checked one-step function body keeps symbolic arguments intact.
# Before:
# have fn inner(x R) R = x+1
# have fn outer(x R) R = x*x
# have x R
# outer(inner(x)) = inner(x)*inner(x)
# Former result: search_proof failed after eager argument normalization.
# Now: the exact outer beta step verifies, with both call and body-domain WD.
have fn inner(x R) R = x+1
have fn outer(x R) R = x*x
have x R
outer(inner(x)) = inner(x)*inner(x)

# The geo caller needs the same step with tuple-valued arguments.
have fn vec(a,b cart(R,R)) cart(R,R) = (b(1)-a(1),b(2)-a(2))
have fn dot(u,v cart(R,R)) R = u(1)*v(1)+u(2)*v(2)
have a,b cart(R,R)
dot(vec(a,b),vec(a,b)) = vec(a,b)(1)*vec(a,b)(1)+vec(a,b)(2)*vec(a,b)(2)
# Boundary: wrong values, invalid nested arguments and missing body guards reject.
# Evidence: target/release/litex -strict -f examples/proof_nodes/equal/by_object_definition/nested_call_one_step.lit
# Rust: tests/unit/execute/function_body_evaluation/tests.rs
