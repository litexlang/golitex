# Former Direct lookup: alpha_paths; current Direct lookup: not found.
# The executable Rust boundary checks that miss without changing stored facts.
# Now: directly submitted binders and nested function arguments still compare.
fn(x R) R = fn(y R) R
have f fn(p fn(x R) R, q fn(y R) R) R
f(fn(x R) R, fn(y R) R) = f(fn(u R) R, fn(v R) R)

# Exact stored paths remain available without alpha discovery.
have n R
let m = n
let k = m
k = n

# Explicit theorem selection compares only this theorem's returned endpoints.
thm alpha_identity:
    ? fn(x R) R {x} = fn(y R) R {y}
by thm alpha_identity => fn(u R) R {u} = fn(v R) R {v}
