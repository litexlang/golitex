# Node: equal.ByTheyAreTheSame.SameFreeParamShape.FnSet
# Run: target/release/litex -f examples/proof_nodes/equal/by_they_are_the_same/by_fn_set_alpha_equal.lit

# Two separately parsed R -> R share no ObjIR (binder ids differ) but are
# alpha-equal as FnSets.
R -> R = R -> R

# Known $in cites the forall binder's FnSet; goal set is a fresh parse — arg
# equality uses TheyAreTheSame FnSet alpha evidence.
forall f R -> R:
    f $in R -> R
