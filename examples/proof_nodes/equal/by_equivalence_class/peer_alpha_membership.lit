# Tracer: known membership transported through a named alpha-equivalent FnSet.
#
# Before (baseline rejected the last line):
# let g = fn(x R) R
# have fn f(t R) R = t
# f $in g
# Former behavior: search_proof failed because known-only equality disabled
# the builtin alpha route and class search only followed stored exact-IR edges.
#
# Now: ByKnownAtomicFact compares its parameters using the equality pipeline;
# ByEquivalenceClass connects a stored path to a TheyAreTheSame alpha proof.
let g = fn(x R) R
have fn f(t R) R = t
f $in g
# Boundary: f $in fn(t R) N must still fail; free identifiers cannot be renamed.
# Evidence: target/release/litex -strict -f examples/proof_nodes/equal/by_equivalence_class/peer_alpha_membership.lit
# Require exit 0, JSON success=true, session_error=null, and successful statements.
