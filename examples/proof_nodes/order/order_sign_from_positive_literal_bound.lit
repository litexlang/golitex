# Builtin: LessFact.OrderSignFromPositiveLiteralBound
# When: known `a >= k` / `a > k` with resolved k > 0 (or left-bound form).
# Proves: `0 < a` at verify time (no eager infer).
# Run: litex -f examples/proof_nodes/order/order_sign_from_positive_literal_bound.lit

forall a R:
    a >= 1
    =>:
        0 < a
