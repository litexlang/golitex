forall a, c R:
    0 <= a
    0 < c
    =>:
        0 <= a / c

forall a, c R:
    a <= 0
    0 < c
    =>:
        a / c <= 0

forall a, c R:
    a <= 0
    c < 0
    =>:
        0 <= a / c

forall a, c R:
    0 <= a
    c < 0
    =>:
        a / c <= 0
