# Tracer: have fn by exist! — exec, release, template.
# Run: LITEX_NEW_PIPELINE=1 target/release/litex -f examples/tmp_have_fn_by_exist.lit

abstract_prop F(x, y)
have A set
have B set

trust:
    forall x A:
        exist! y B st {$F(x, y)}

have fn f by exist!:
    ? forall x A:
        exist! y B st {$F(x, y)}

forall x A:
    $F(x, f(x))

forall x A, y B:
    $F(x, y)
    =>:
        y = f(x)

release obj def f

forall x A:
    $F(x, f(x))

template<_S set>:
    have fn choose_t by exist!:
        ? forall x A:
            exist! y B st {$F(x, y)}
