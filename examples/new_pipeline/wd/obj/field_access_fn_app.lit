# Obj WD: FnObj FieldAccess head — domain from declared field FnSet type
# Run: litex -f examples/new_pipeline/wd/obj/field_access_fn_app.lit
#
# Before Wave4: FieldAccess-headed FnObj fell through to children-only (no domain).
# Struct requires ≥2 fields.

struct Bundle:
    f fn(x R) R
    tag R

forall p &Bundle:
    p.f(0) = p.f(0)
