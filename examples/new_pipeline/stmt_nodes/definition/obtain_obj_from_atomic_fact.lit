# Stmt: Definition.ObtainObjFromAtomicFact → exec_obtain_obj_from_atomic_fact_stmt
# Run: litex -f examples/new_pipeline/stmt_nodes/definition/obtain_obj_from_atomic_fact.lit
#
# `$P(args)` must verify; concrete prop has exactly one positive exist/exist!
# clause; obtain projects that clause and eliminates.

prop has_copy(a R):
    exist x R st {x = a}

$has_copy(2)
obtain copy from $has_copy(2)
copy = 2
copy $in R
