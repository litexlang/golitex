# Stmt: Definition.HaveByPreimageStmt → exec_have_by_fn_preimage_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/stmt_nodes/definition/have_by_fn_preimage.lit
#
# Surface: `have by fn_preimage: names from … $in fn_range(…)`
# (renamed from default-pipeline `have by preimage`).
# Membership is trusted here so this tracer focuses on the stmt arm
# (application ∈ fn_range builtin is separate).

have fn shift(x R) R = x + 1

trust shift(2) $in fn_range(shift)

have by fn_preimage: source from shift(2) $in fn_range(shift)

source $in R
shift(2) = shift(source)
