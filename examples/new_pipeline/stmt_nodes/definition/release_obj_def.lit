# Stmt: ReleaseObjDefStmt → exec_release_obj_def_stmt
# Run: litex -f examples/new_pipeline/stmt_nodes/definition/release_obj_def.lit

let x = 1
release obj def x
x = 1

have a R = 2
release obj def a
a $in R
a = 2

trust have b R:
    b > 0
release obj def b
b $in R
b > 0

have c R:
    c > 10
release obj def c
c $in R
c > 10

have fn f(t R) R = t
release obj def f
f(1) = 1
