# Nested struct: direct bind auto-opens only the outer layer.
# Inner `&Coordinates` field needs an explicit `release struct def`.
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/stmt_nodes/definition/release_struct_def.lit

struct Coordinates:
    x R
    y R
    <=>:
        x = 0

struct TaggedPoint:
    point &Coordinates
    tag N

trust have p &TaggedPoint
release struct def p.point
p.point.x = 0
