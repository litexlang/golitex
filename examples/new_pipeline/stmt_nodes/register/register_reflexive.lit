# Stmt: Register.RegisterReflexivePropStmt → exec_register_reflexive_prop_stmt
# Run: litex -f examples/new_pipeline/stmt_nodes/register/register_reflexive.lit
# No indented proof body: one shaped `? forall …` only.

prop same(x set, y set):
    x = y

register reflexive:
    ? forall x set:
        $same(x, x)

have a set
$same(a, a)
