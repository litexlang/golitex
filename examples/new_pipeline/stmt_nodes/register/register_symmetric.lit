# Stmt: Register.RegisterSymmetricPropStmt → exec_register_symmetric_prop_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/stmt_nodes/register/register_symmetric.lit
# No indented proof body: one shaped `? forall …` only.

prop same(x set, y set):
    x = y

register symmetric:
    ? forall x, y set:
        $same(x, y)
        =>:
            $same(y, x)

have a set, b set
trust $same(a, b)
$same(b, a)
