# Stmt: Witness.WitnessAtomicFact → exec_witness_stmt / exec_witness_atomic_fact
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/stmt_nodes/witness/witness_atomic_fact.lit
#
# Concrete prop with sole ordinary `exist` clause. No indented proof body;
# ambient obligations must already hold (`2 = 2` is builtin).

prop has_copy(a R):
    exist x R st {x = a}

witness $has_copy(2) from 2
$has_copy(2)
