# Stmt: ReleaseAndExpand.ReleaseAxiomOfChoiceStmt → exec_release_axiom_of_choice_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/stmt_nodes/release_and_expand/release_axiom_of_choice.lit

have F set
trust:
    forall A F:
        $is_nonempty_set(A)
release axiom_of_choice: set F:
    forall A F:
        $is_nonempty_set(A)
