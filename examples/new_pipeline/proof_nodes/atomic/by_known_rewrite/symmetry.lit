# Node: atomic.ByKnownRewrite.Symmetry
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/proof_nodes/atomic/by_known_rewrite/symmetry.lit
#
# Registers symmetric swap for `same`, then proves the swap forall
# (parameter types must be `set` for `by symmetric_prop`).

prop same(x set, y set):
    x = y

by symmetric_prop:
    ? forall x, y set:
        $same(x, y)
        =>:
            $same(y, x)

forall x, y set:
    $same(x, y)
    =>:
        $same(y, x)
