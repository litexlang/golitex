# Node: atomic.ByBuiltinRule.UnionSubsetFromComponentwise
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/proof_nodes/atomic/by_builtin_rule/subset_union_from_componentwise.lit

have A set
have B set
have C set
have D set
trust A $subset C
trust B $subset D
union(A, B) $subset union(C, D)
