# Node: atomic.ByBuiltinRewrite.ClosedNumericEqualSubstitution (arithmetic ops)
# Same closed-numeric abs / min / max store-rewrite surface as equal/; goal is atomic equality.
# Run: litex -f examples/new_pipeline/proof_nodes/atomic/by_builtin_rewrite/closed_numeric_equal_substitution_arithmetic_ops.lit

have a R = abs(-3)
a = 3

have b R = min(1, 2)
b + 1 = 2

have c R = max(floor(2.5), sign(-1))
c = 2
