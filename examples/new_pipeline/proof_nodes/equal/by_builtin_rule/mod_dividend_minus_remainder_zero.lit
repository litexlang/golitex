# Node: equal.ByBuiltinRule.ModDividendMinusRemainderZero
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/proof_nodes/equal/by_builtin_rule/mod_dividend_minus_remainder_zero.lit

have a Z
have b N+
# Narrow trust: mod WD currently needs an explicit nonzero divisor witness.
trust b != 0
(a - (a % b)) % b = 0
