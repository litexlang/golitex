# Node: equal.ByBuiltinRule.LcmGcdProductAbs
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline/proof_nodes/equal/by_builtin_rule/lcm_gcd_product_abs.lit

have a Z
have b Z
# Narrow trust: lcm / gcd / abs product WD currently needs nonzero and carriers.
trust a != 0
trust b != 0
trust lcm(a, b) $in N
trust gcd(a, b) $in N+
lcm(a, b) * gcd(a, b) = abs(a * b)
