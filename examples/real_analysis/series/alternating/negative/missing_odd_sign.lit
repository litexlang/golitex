release obj def series::partial_sum

release obj def series::partial_sums

thm missing_odd_sign_must_fail:
    ? forall a,u seq(R):
        $is_seq_nonincreasing(u)
        $has_seq_limit(u,0)
        forall k N+:
            a(2*k)=-u(2*k)
        =>:
            $series::is_convergent_series(a)
    release thm series::alternating_series_test(a,u)
