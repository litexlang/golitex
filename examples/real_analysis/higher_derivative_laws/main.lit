# Unary real finite-order derivatives, proved before selection.
# Supplied profiles are checked with existing first-derivative BTs.

have fn law_cubic(x R) R=x^3

have fn law_cubic_first(x R) R=3*x^2

have fn law_cubic_second(x R) R=6*x

have fn law_cubic_third(x R) R=6

by for:
    ? forall j closed_range(0,3):
        j=0 or j=1 or j=2 or j=3
    j=0 or j=1 or j=2 or j=3

have fn law_unary_profiles(j closed_range(0,3)) fn(x R) R by cases:
    case j=0: law_cubic
    case j=1: law_cubic_first
    case j=2: law_cubic_second
    case j=3: law_cubic_third

by for:
    ? forall j closed_range(1,3):
        j=1 or j=2 or j=3
    j=1 or j=2 or j=3

have fn law_real_identity(x R) R=x

have fn law_real_square(x R) R=x^2

thm law_cubic_first_derivative:
    ? forall x R:
        $has_derivative_at(law_cubic,x,3*x^2)
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_identity(law_real_identity,x)
    release thm fn_derivative_at_power(law_real_identity,law_cubic,x,1,3)
    law_real_identity(x)=x
    max(3,1)=3
    max(3,1)-1=2
    law_real_identity(x)^(max(3,1)-1)=law_real_identity(x)^2=x^2
    3*law_real_identity(x)^(max(3,1)-1)=3*x^2
    (3*law_real_identity(x)^(max(3,1)-1))*1=3*x^2
    $has_derivative_at(law_cubic,x,3*x^2)

thm law_cubic_second_derivative:
    ? forall x R:
        $has_derivative_at(law_cubic_first,x,6*x)
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_identity(law_real_identity,x)
    release thm fn_derivative_at_power(law_real_identity,law_real_square,x,1,2)
    law_real_identity(x)=x
    max(2,1)-1=1
    law_real_identity(x)^(max(2,1)-1)=law_real_identity(x)^1=x
    2*law_real_identity(x)^(max(2,1)-1)=2*x
    (2*law_real_identity(x)^(max(2,1)-1))*1=2*x
    $has_derivative_at(law_real_square,x,2*x)
    release thm fn_derivative_at_scale(law_real_square,law_cubic_first,x,2*x,3)
    3*(2*x)=6*x
    $has_derivative_at(law_cubic_first,x,6*x)

thm law_cubic_third_derivative:
    ? forall x R:
        $has_derivative_at(law_cubic_second,x,6)
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_identity(law_real_identity,x)
    release thm fn_derivative_at_scale(law_real_identity,law_cubic_second,x,1,6)
    6*1=6
    $has_derivative_at(law_cubic_second,x,6)

claim:
    ? forall j closed_range(1,3),x R:
        j $in closed_range(0,3)
        j-1 $in closed_range(0,3)
        =>:
            $has_derivative_at(law_unary_profiles(j-1),x,law_unary_profiles(j)(x))
    j=1 or j=2 or j=3
    by cases:
        ? $has_derivative_at(law_unary_profiles(j-1),x,law_unary_profiles(j)(x))
        case j=1:
            j-1=0
            law_unary_profiles(j-1)=law_unary_profiles(0)=law_cubic
            law_unary_profiles(j)=law_unary_profiles(1)=law_cubic_first
            law_unary_profiles(j)(x)=law_cubic_first(x)=3*x^2
            release thm law_cubic_first_derivative(x)
            $has_derivative_at(law_cubic,x,3*x^2)
        case j=2:
            j-1=1
            law_unary_profiles(j-1)=law_unary_profiles(1)=law_cubic_first
            law_unary_profiles(j)=law_unary_profiles(2)=law_cubic_second
            law_unary_profiles(j)(x)=law_cubic_second(x)=6*x
            release thm law_cubic_second_derivative(x)
            $has_derivative_at(law_cubic_first,x,6*x)
        case j=3:
            j-1=2
            law_unary_profiles(j-1)=law_unary_profiles(2)=law_cubic_second
            law_unary_profiles(j)=law_unary_profiles(3)=law_cubic_third
            law_unary_profiles(j)(x)=law_cubic_third(x)=6
            release thm law_cubic_third_derivative(x)
            $has_derivative_at(law_cubic_second,x,6)


claim:
    ? forall center R:
        $Calc::unary_higher_order::has_nth_derivative_at(R,3,law_cubic,center,6)
    release thm Calc::unary_higher_order::nth_derivative_from_global_profiles(3,law_unary_profiles,center)
    law_unary_profiles(0)=law_cubic
    law_unary_profiles(3)=law_cubic_third
    law_unary_profiles(3)(center)=law_cubic_third(center)=6
    $Calc::unary_higher_order::has_nth_derivative_at(R,3,law_cubic,center,6)

have fn law_sine(x R) R=sin(x)

have fn law_cosine(x R) R=cos(x)

have fn law_negative_sine(x R) R=-sin(x)

have fn law_negative_cosine(x R) R=-cos(x)

claim:
    ? forall x R:
        $has_derivative_at(law_sine,x,law_cosine(x))
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_sin(law_sine,x)
    law_cosine(x)=cos(x)

claim:
    ? forall x R:
        $has_derivative_at(law_cosine,x,law_negative_sine(x))
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_cos(law_cosine,x)
    law_negative_sine(x)=-sin(x)

claim:
    ? forall x R:
        $has_derivative_at(law_negative_sine,x,law_negative_cosine(x))
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_sin(law_sine,x)
    release thm fn_derivative_at_neg(law_sine,law_negative_sine,x,cos(x))
    law_negative_cosine(x)=-cos(x)

have fn law_sine_profiles(j closed_range(0,3)) fn(x R) R by cases:
    case j=0: law_sine
    case j=1: law_cosine
    case j=2: law_negative_sine
    case j=3: law_negative_cosine

claim:
    ? forall j closed_range(1,3),x R:
        j $in closed_range(0,3)
        j-1 $in closed_range(0,3)
        =>:
            $has_derivative_at(law_sine_profiles(j-1),x,law_sine_profiles(j)(x))
    j=1 or j=2 or j=3
    by cases:
        ? $has_derivative_at(law_sine_profiles(j-1),x,law_sine_profiles(j)(x))
        case j=1:
            j-1=0
            law_sine_profiles(j-1)=law_sine
            law_sine_profiles(j)=law_cosine
            $has_derivative_at(law_sine,x,law_cosine(x))
        case j=2:
            j-1=1
            law_sine_profiles(j-1)=law_cosine
            law_sine_profiles(j)=law_negative_sine
            $has_derivative_at(law_cosine,x,law_negative_sine(x))
        case j=3:
            j-1=2
            law_sine_profiles(j-1)=law_negative_sine
            law_sine_profiles(j)=law_negative_cosine
            $has_derivative_at(law_negative_sine,x,law_negative_cosine(x))

release thm Calc::unary_higher_order::nth_derivative_from_global_profiles(3,law_sine_profiles,0)

law_sine_profiles(0)=law_sine

law_sine_profiles(3)=law_negative_cosine

law_sine_profiles(3)(0)=law_negative_cosine(0)=-cos(0)=-1

$Calc::unary_higher_order::has_nth_derivative_at(R,3,law_sine,0,-1)

have fn law_sum(x R) R=law_cubic(x)+law_sine(x)

release thm Higher::main::nth_derivative_add(R,3,law_cubic,law_sine,law_sum,0,6,-1)

6+(-1)=5

$Calc::unary_higher_order::has_nth_derivative_at(R,3,law_sum,0,5)

release thm Calc::unary_higher_order::nth_derivative_candidate_exists(R,3,law_sum,0,5)

release thm Calc::unary_higher_order::nth_derivative_value(R,3,law_sum,0,5)

\Calc::unary_higher_order::nth_derivative<R,3>(law_sum,0)=5

have fn law_difference(x R) R=law_cubic(x)-law_sine(x)

release thm Higher::main::nth_derivative_subtract(R,3,law_cubic,law_sine,law_difference,0,6,-1)

6-(-1)=7

$Calc::unary_higher_order::has_nth_derivative_at(R,3,law_difference,0,7)

have fn law_scaled(x R) R=4*law_sum(x)

release thm Higher::main::nth_derivative_scale(R,3,law_sum,law_scaled,0,4,5)

4*5=20

$Calc::unary_higher_order::has_nth_derivative_at(R,3,law_scaled,0,20)

release thm Calc::unary_higher_order::nth_derivative_zero(R,law_cubic,0)

release thm Calc::unary_higher_order::nth_derivative_zero(R,law_sine,0)

law_cubic(0)=0

law_sine(0)=sin(0)=0

release thm Higher::main::nth_derivative_add(R,0,law_cubic,law_sine,law_sum,0,0,0)

$Calc::unary_higher_order::has_nth_derivative_at(R,0,law_sum,0,0)
