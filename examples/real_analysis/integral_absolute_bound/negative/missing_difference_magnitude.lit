thm difference_missing_magnitude_candidate_must_fail:
    ? forall a,b R,D power_set(R),f,g,d,h fn(x D) R,I,J,K R:
        a<=b
        '[min(a,b),max(a,b)] $subset D
        $has_riemann_integral(f,a,b,I)
        $has_riemann_integral(g,a,b,J)
        forall x '[min(a,b),max(a,b)]:
            d(x)=f(x)-g(x)
            h(x)=abs(d(x))
        =>:
            abs(I-J)<=K
    release thm integrals::riemann_integral_difference_bound(a,b,D,f,g,d,h,I,J,K)
