{
  "setup": [
    "have fn boundary_positive_constant(x R+) R=7"
  ],
  "cases": [
    {
      "id": "c_zero_absolute_not_c_one",
      "source": "$Reg::main::is_unary_c_k_on_open(R,1,main::regularity_absolute)",
      "expected_category": "proof_search"
    },
    {
      "id": "isolated_domain_not_open",
      "source": "release thm Reg::main::unary_c_zero_from_continuity({0},main::regularity_singleton)",
      "expected_category": "proof_search"
    },
    {
      "id": "continuous_absolute_not_differentiable",
      "source": "$has_derivative_at(main::regularity_absolute,0,0)",
      "expected_category": "proof_search"
    },
    {
      "id": "c_three_does_not_choose_c_four",
      "source": "$Reg::main::is_unary_c_k_on_open(R,4,main::regularity_cubic)",
      "expected_category": "proof_search"
    },
    {
      "id": "lower_order_cannot_increase",
      "source": "release thm Reg::main::unary_c_k_lower_order(R,3,4,main::regularity_cubic)",
      "expected_category": "proof_search"
    },
    {
      "id": "constant_formula_required",
      "source": "release thm Reg::main::unary_constant_smooth(main::regularity_cubic,0)",
      "expected_category": "proof_search"
    },
    {
      "id": "complete_domain_not_covariant",
      "source": "release thm Reg::main::unary_constant_smooth(boundary_positive_constant,7)",
      "expected_category": "proof_search"
    },
    {
      "id": "unary_is_not_vector_one",
      "source": "release thm Reg::main::scalar_c_zero_from_continuity(1,cart_n(R,1),main::regularity_unary_constant)",
      "expected_category": "proof_search"
    },
    {
      "id": "scalar_is_not_unary",
      "source": "release thm Reg::main::unary_c_zero_from_continuity(R,main::regularity_scalar_constant)",
      "expected_category": "proof_search"
    },
    {
      "id": "selected_wrong_value",
      "source": "\\Calc::unary_higher_order::nth_derivative<R,3>(main::regularity_cubic,0)=7",
      "expected_category": "proof_search"
    }
  ]
}
