# Ordered derivative functions retain the witness's actual intermediate domains.
# The path 1,1,2 of x1^2*x2^3 at (2,2) gives values 32,16,24.

release obj def main::polynomial

release obj def main::first

release obj def main::second

release obj def main::third

release obj def main::profiles

have point cart_n(R,2)=(2,2)

point(1)=2

point(2)=2

have full_path finite_seq(closed_range(1,2),3)=(1,1,2)

full_path(1)=1

full_path(2)=1

full_path(3)=2

have fn first_path(j closed_range(1,1)) closed_range(1,2)=1

have second_path finite_seq(closed_range(1,2),2)=(1,1)

by for:
    ? forall j closed_range(0,3):
        j=0 or j=1 or j=2 or j=3
    j=0 or j=1 or j=2 or j=3

by for:
    ? forall j closed_range(1,3):
        j=1 or j=2 or j=3
    j=1 or j=2 or j=3

claim:
    ? forall j closed_range(1,3),x cart_n(R,2):
        $has_partial_derivative_at(main::profiles(j-1),x,2,full_path(j),main::profiles(j)(x))
    j=1 or j=2 or j=3
    by cases:
        ? $has_partial_derivative_at(main::profiles(j-1),x,2,full_path(j),main::profiles(j)(x))
        case j=1:
            j-1=0
            main::profiles(j-1)=main::profiles(0)=main::polynomial
            main::profiles(j)=main::profiles(1)=main::first
            full_path(j)=full_path(1)=1
            main::profiles(j)(x)=main::first(x)=2*x(1)*x(2)^3
            $has_partial_derivative_at(main::polynomial,x,2,1,2*x(1)*x(2)^3)
        case j=2:
            j-1=1
            main::profiles(j-1)=main::profiles(1)=main::first
            main::profiles(j)=main::profiles(2)=main::second
            full_path(j)=full_path(2)=1
            main::profiles(j)(x)=main::second(x)=2*x(2)^3
            $has_partial_derivative_at(main::first,x,2,1,2*x(2)^3)
        case j=3:
            j-1=2
            main::profiles(j-1)=main::profiles(2)=main::second
            main::profiles(j)=main::profiles(3)=main::third
            full_path(j)=full_path(3)=2
            main::profiles(j)(x)=main::third(x)=6*x(2)^2
            $has_partial_derivative_at(main::second,x,2,2,6*x(2)^2)


release thm Calc::higher_order::ordered_partial_from_global_profiles(2,3,main::profiles,point,full_path)

main::profiles(0)=main::polynomial

main::profiles(3)=main::third

main::profiles(3)(point)=main::third(point)=24

$Calc::higher_order::has_ordered_partial_at(2,cart_n(R,2),3,main::polynomial,point,full_path,24)

obtain proof_chain from $Calc::higher_order::has_ordered_partial_at(2,cart_n(R,2),3,main::polynomial,point,full_path,24)

release thm Calc::higher_order::ordered_partial_chain_region_in_domain(2,cart_n(R,2),3,main::polynomial,full_path,proof_chain,1)

release thm Calc::higher_order::ordered_partial_chain_region_in_domain(2,cart_n(R,2),3,main::polynomial,full_path,proof_chain,2)

let first_domain=proof_chain.regions(1)

let second_domain=proof_chain.regions(2)

release thm Calc::locality::finite_nested_regions_member(cart_n(R,2),3,proof_chain.regions,point,1)

release thm Calc::locality::finite_nested_regions_member(cart_n(R,2),3,proof_chain.regions,point,2)

claim:
    ? forall q closed_range(1,1):
        q $in closed_range(1,3)
        =>:
            first_path(q)=full_path(q)
    q=1
    first_path(q)=first_path(1)=1=full_path(1)=full_path(q)

by for:
    ? forall q closed_range(1,2):
        q=1 or q=2
    q=1 or q=2

claim:
    ? forall q closed_range(1,2):
        q $in closed_range(1,3)
        =>:
            second_path(q)=full_path(q)
    q=1 or q=2
    by cases:
        ? second_path(q)=full_path(q)
        case q=1:
            second_path(q)=second_path(1)=1=full_path(1)=full_path(q)
        case q=2:
            second_path(q)=second_path(2)=1=full_path(2)=full_path(q)

release thm Calc::higher_order::ordered_partial_chain_exists_on(2,cart_n(R,2),3,1,main::polynomial,full_path,first_path,proof_chain,first_domain)

have first_map fn(x first_domain) R=\Calc::higher_order::ordered_partial_function<2,cart_n(R,2),first_domain,1>(main::polynomial,first_path)

claim:
    ? forall x first_domain:
        first_map(x)=main::first(x)
    x $in cart_n(R,2)
    x $in proof_chain.regions(1)
    release thm Calc::higher_order::ordered_partial_prefix_candidate(2,cart_n(R,2),3,1,main::polynomial,x,full_path,first_path,proof_chain)
    release thm Calc::higher_order::ordered_partial_one_to_native(2,cart_n(R,2),main::polynomial,x,first_path,proof_chain.values(1,x))
    first_path(1)=1
    $has_partial_derivative_at(main::polynomial,x,2,1,2*x(1)*x(2)^3)
    release thm partial_at_unique(main::polynomial,x,2,1,proof_chain.values(1,x),2*x(1)*x(2)^3)
    release thm Calc::higher_order::ordered_partial_function_value(2,cart_n(R,2),1,main::polynomial,first_domain,first_path,x,proof_chain.values(1,x))
    first_map(x)=proof_chain.values(1,x)=2*x(1)*x(2)^3=main::first(x)

first_map(point)=main::first(point)=32

proof_chain.regions(1+1)=proof_chain.regions(2)

proof_chain.values(1+1,point)=proof_chain.values(2,point)

full_path(1+1)=full_path(2)=1

release thm Calc::higher_order::ordered_partial_function_successor(2,cart_n(R,2),3,1,main::polynomial,full_path,first_path,proof_chain,first_domain,point)

full_path(2)=1

$has_partial_derivative_at(first_map,point,2,1,proof_chain.values(2,point))

$has_partial_derivative_at(main::first,point,2,1,16)

claim:
    ? forall x intersect(first_domain,cart_n(R,2)):
        first_map(x)=main::first(x)
    x $in first_domain

release thm Calc::locality::real_partials_intersection_unique(2,first_domain,cart_n(R,2),point,1,first_map,main::first,proof_chain.values(2,point),16)

proof_chain.values(2,point)=16

$has_partial_derivative_at(first_map,point,2,1,16)

release thm Calc::higher_order::ordered_partial_chain_exists_on(2,cart_n(R,2),3,2,main::polynomial,full_path,second_path,proof_chain,second_domain)

have second_map fn(x second_domain) R=\Calc::higher_order::ordered_partial_function<2,cart_n(R,2),second_domain,2>(main::polynomial,second_path)

release thm Calc::higher_order::ordered_partial_prefix_candidate(2,cart_n(R,2),3,2,main::polynomial,point,full_path,second_path,proof_chain)

release thm Calc::higher_order::ordered_partial_function_value(2,cart_n(R,2),2,main::polynomial,second_domain,second_path,point,16)

second_map(point)=16

proof_chain.regions(2+1)=proof_chain.regions(3)

proof_chain.values(2+1,point)=proof_chain.values(3,point)

full_path(2+1)=full_path(3)=2

release thm Calc::higher_order::ordered_partial_function_successor(2,cart_n(R,2),3,2,main::polynomial,full_path,second_path,proof_chain,second_domain,point)

full_path(3)=2

proof_chain.values(3,point)=24

$has_partial_derivative_at(second_map,point,2,2,24)
