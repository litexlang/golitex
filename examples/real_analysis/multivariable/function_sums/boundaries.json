{
  "setup": [
    "have fn unary_terms(j closed_range(1,2)) fn(x R) R=fn(x R) R {0}",
    "have fn isolated_vector_terms(j closed_range(1,1)) fn(x {main::point}) R=fn(x {main::point}) R {0}"
  ],
  "cases": [
    {
      "id": "wrong_partial",
      "source": "$has_partial_derivative_at(\\MultiSums::main::scalar_function_prefix_sum<2,cart_n(R,2),2>(main::terms,2),main::point,2,1,3)",
      "expected_category": "proof_search"
    },
    {
      "id": "axis_outside_dimension",
      "source": "release thm MultiSums::main::scalar_function_prefix_partial(2,cart_n(R,2),2,main::terms,main::values,main::point,3,2)",
      "expected_category": "proof_search"
    },
    {
      "id": "prefix_outside_family",
      "source": "\\MultiSums::main::scalar_function_prefix_sum<2,cart_n(R,2),2>(main::terms,3)=\\MultiSums::main::scalar_function_prefix_sum<2,cart_n(R,2),2>(main::terms,3)",
      "expected_category": "well_defined"
    },
    {
      "id": "unary_family_is_not_vector_family",
      "source": "\\MultiSums::main::scalar_function_prefix_sum<2,cart_n(R,2),2>(unary_terms,2)=\\MultiSums::main::scalar_function_prefix_sum<2,cart_n(R,2),2>(unary_terms,2)",
      "expected_category": "well_defined"
    },
    {
      "id": "wrong_numeric_prefix",
      "source": "\\Sums::main::finite_real_prefix_sum<2>(main::values,2)=0",
      "expected_category": "proof_search"
    },
    {
      "id": "interior_theorem_needs_interior",
      "source": "release thm MultiSums::main::scalar_function_prefix_continuous_interior(2,{main::point},1,isolated_vector_terms,main::point,0)",
      "expected_category": "proof_search"
    }
  ]
}
