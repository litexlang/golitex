# Check: target/release/litex -lang en -strict -f examples/real_analysis/riemann_integral_domains.lit
# Full interval coverage belongs to the actual function domain.
have fn local_square(x '[0,1]) R=x^2
release thm riemann_integral_power(local_square,0,1,2)
integral(local_square,0,1)=1/3
have fn guarded(x R:x>=0,x<=1) R=x^2
claim:
    ? '[0,1] $subset {x R:x>=0,x<=1}
    forall x '[0,1]:
        x>=0
        x $in {t R:t>=0,t<=1}
    by def '[0,1] $subset {x R:x>=0,x<=1}
release thm riemann_integral_extensional(local_square,guarded,0,1,1/3)
integral(guarded,0,1)=1/3
