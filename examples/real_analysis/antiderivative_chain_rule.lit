# Check: target/release/litex -lang en -strict -f examples/real_analysis/antiderivative_chain_rule.lit
# Before: antiderivative_compose was an unknown theorem.
# release thm antiderivative_compose(sub_sin,sub_cos,sub_square,sub_twice,sub_primitive,sub_integrand,R,R)
# Now: the explicit chain rule consumes the outer relation and derivative/image/equality proofs.
# Explicit nonempty open regions only; no antiderivative object.
have fn sub_identity(x R) R=x

have fn sub_sin(x R) R=sin(x)

have fn sub_cos(x R) R=cos(x)

have fn sub_square(x R) R=x^2

have fn sub_twice(x R) R=2*x

have fn sub_primitive(x R) R=sin(x^2)

have fn sub_integrand(x R) R=2*x*cos(x^2)

claim:
    ? forall x R:
        $has_derivative_at(sub_square,x,sub_twice(x))
        $has_derivative_at(sub_sin,x,sub_cos(x))
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_identity(sub_identity,x)
    release thm fn_derivative_at_multiply(sub_identity,sub_identity,sub_square,x,1,1)
    sub_identity(x)=x
    sub_twice(x)=2*x
    1*sub_identity(x)+sub_identity(x)*1=sub_twice(x)
    $has_derivative_at(sub_square,x,sub_twice(x))
    release thm fn_derivative_at_sin(sub_sin,x)
    sub_cos(x)=cos(x)
    $has_derivative_at(sub_sin,x,sub_cos(x))

release thm antiderivative_from_definition(sub_sin,sub_cos,R)

claim:
    ? forall x R:
        sub_primitive(x)=sub_sin(sub_square(x))
        sub_integrand(x)=sub_cos(sub_square(x))*sub_twice(x)
    sub_square(x)=x^2
    sub_twice(x)=2*x
    sub_sin(sub_square(x))=sin(x^2)
    sub_cos(sub_square(x))=cos(x^2)
    sub_integrand(x)=2*x*cos(x^2)
    sub_cos(sub_square(x))*sub_twice(x)=cos(x^2)*(2*x)
    cos(x^2)*(2*x)=2*x*cos(x^2)

release thm antiderivative_compose(sub_sin,sub_cos,sub_square,sub_twice,sub_primitive,sub_integrand,R,R)

release thm antiderivative_to_definition(sub_primitive,sub_integrand,R)

$has_derivative_at(sub_primitive,1,sub_integrand(1))

derivative(sub_primitive,1)=sub_integrand(1)

release thm antiderivative_compose(sub_sin,sub_cos,sub_square,sub_twice,sub_primitive,sub_integrand,'(0,1),R)
