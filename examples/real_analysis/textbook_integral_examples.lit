# Ten textbook-style examples of finite real Riemann integration.
# Examples 9 and 10 reuse functions established in Examples 8 and 7 respectively.
# Example 6 establishes integrability. Examples 7-10 use explicit calculus theorems.
# Check with target/release/litex -strict -lang en -f examples/real_analysis/textbook_integral_examples.lit

# 1. Polynomial area
have fn polynomial(x R) R=3*x^2+2*x+1

$is_riemann_integrable(polynomial,0,1)

integral(polynomial,0,1)=3


# 2. General power rule
forall n N,a,b R:
    $has_riemann_integral(fn(x R) R {x^n},a,b,(b^(n+1)-a^(n+1))/(n+1))


# 3. Polynomial with parameters
forall a,b,c R:
    $has_riemann_integral(fn(x R) R {a*x^2+b*x+c},0,1,a/3+b/2+c)


# 4. Zero integral as a proposition
prop zero_integral(f fn(x R) R,a,b R):
    $is_riemann_integrable(f,a,b)
    integral(f,a,b)=0

have fn odd_cubic(x R) R=x^3

$is_riemann_integrable(odd_cubic,-1,1)

by def $zero_integral(odd_cubic,-1,1)


# 5. Linearity
forall f,g fn(x R) R,a,b R:
    $is_riemann_integrable(f,a,b)
    $is_riemann_integrable(g,a,b)
    =>:
        $is_riemann_integrable(fn(x R) R {3*f(x)-2*g(x)+1},a,b)
        integral(fn(x R) R {3*f(x)-2*g(x)+1},a,b)=3*integral(f,a,b)-2*integral(g,a,b)+(b-a)


# 6. Integrability of a composite
forall f fn(x R) R:
    forall x R:
        $cont_at(f,x)
    =>:
        $is_riemann_integrable(fn(x R) R {exp(sin(f(x)))/(1+x^2)},0,1)


# 7. Exponential integral by Newton–Leibniz
have fn exponential(x R) R=exp(x)

forall x R:
    exponential(x)=exp(x)
    $has_deriv_at(exponential,x,exponential(x))

$is_riemann_integrable(exponential,0,1)

release thm riemann_integral_newton_leibniz(exponential,exponential,0,1)

exponential(0)=1

exponential(1)=exp(1)

exponential(1)-exponential(0)=exp(1)-1

integral(exponential,0,1)=exp(1)-1


# 8. Cosine integral by Newton–Leibniz
have fn sine(x R) R=sin(x)

have fn cosine(x R) R=cos(x)

forall x R:
    cosine(x)=cos(x)
    $has_deriv_at(sine,x,cosine(x))

$is_riemann_integrable(cosine,0,pi/2)

release thm riemann_integral_newton_leibniz(cosine,sine,0,pi/2)

sine(0)=0

sine(pi/2)=1

sine(pi/2)-sine(0)=1

integral(cosine,0,pi/2)=1


# 9. Substitution with u=x^2
have fn square(x R) R=x^2

have fn twice(x R) R=2*x

have fn substituted_cosine(x R) R=cosine(square(x))*twice(x)

forall x R:
    twice(x)=2*x
    $has_deriv_at(square,x,twice(x))

$is_riemann_integrable(cosine,0,4)

release thm riemann_integral_newton_leibniz(cosine,sine,0,4)

square(0)=0

square(2)=4

sine(4)=sin(4)

sine(4)-sine(0)=sin(4)

release thm riemann_integral_substitution(cosine,square,twice,substituted_cosine,R,0,2,sine(4)-sine(0))

integral(substituted_cosine,0,2)=sin(4)


# 10. Integration by parts
have fn identity(x R) R=x

have fn one(x R) R=1

have fn weighted_exponential(x R) R=x*exp(x)

forall x R:
    one(x)=1
    $has_deriv_at(identity,x,one(x))
    weighted_exponential(x)=identity(x)*exponential(x)
    exponential(x)=one(x)*exponential(x)

release thm riemann_integral_by_parts(identity,one,exponential,exponential,weighted_exponential,exponential,0,1,exponential(1)-exponential(0))

identity(1)=1

identity(0)=0

identity(1)*exponential(1)-identity(0)*exponential(0)-(exponential(1)-exponential(0))=1

integral(weighted_exponential,0,1)=1

