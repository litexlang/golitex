# Finite upper/lower limits of the alternating real sequence.
# Prove both defining clauses before selection; no trust or axiom.
# Run: target/release/litex -strict -lang en -f examples/wd/sequence_limsup_liminf.lit

have fn alternating(k N+) R=(-1)^k

prop alternating_unit(k N+):
    alternating(k)=1 or alternating(k)=-1

claim:
    ? forall n N+:
        $alternating_unit(n)
    by induc n from 1:
        ? $alternating_unit(n)
        ? from n=1:
            alternating(1)=(-1)^1=-1
            by def $alternating_unit(1)
        ? induc:
            alternating(n+1)=(-1)^(n+1)=(-1)^n*(-1)=alternating(n)*(-1)
            by cases:
                ? $alternating_unit(n+1)
                case alternating(n)=1:
                    alternating(n+1)=1*(-1)=-1
                    by def $alternating_unit(n+1)
                case alternating(n)=-1:
                    alternating(n+1)=(-1)*(-1)=1
                    by def $alternating_unit(n+1)

claim:
    ? forall n N+:
        alternating(n)<=1
    $alternating_unit(n)
    alternating(n)=1 or alternating(n)=-1
    by cases:
        ? alternating(n)<=1
        case alternating(n)=1:
            alternating(n)<=1
        case alternating(n)=-1:
            alternating(n)=-1<=1

claim:
    ? forall n N+:
        -1<=alternating(n)
    $alternating_unit(n)
    alternating(n)=1 or alternating(n)=-1
    by cases:
        ? -1<=alternating(n)
        case alternating(n)=1:
            -1<=1=alternating(n)
        case alternating(n)=-1:
            -1<=alternating(n)

claim:
    ? forall epsilon R+:
        exist n0 N+ st {{n N+:n>=n0} $subset preimage_set(alternating,{v R:v<1+epsilon})}
    witness exist n0 N+ st {{n N+:n>=n0} $subset preimage_set(alternating,{v R:v<1+epsilon})} from 1:
        claim:
            ? forall k {n N+:n>=1}:
                k $in preimage_set(alternating,{v R:v<1+epsilon})
            alternating(k)<=1<1+epsilon
            alternating(k) $in {v R:v<1+epsilon}
        by def {n N+:n>=1} $subset preimage_set(alternating,{v R:v<1+epsilon})

claim:
    ? forall epsilon R+,n0 N+:
        exist n N+ st {n>=n0 and 1-epsilon<alternating(n)}
    2*n0 $in N+
    2*n0>=n0
    (-1)^(2*n0)=((-1)^2)^n0=1^n0=1
    alternating(2*n0)=(-1)^(2*n0)=1
    0<epsilon
    1-epsilon=(1-epsilon)+0<(1-epsilon)+epsilon=1
    witness exist n N+ st {n>=n0 and 1-epsilon<alternating(n)} from 2*n0

by def $has_seq_limsup(alternating,1)

limsup(alternating)=1

claim:
    ? forall epsilon R+:
        exist n0 N+ st {{n N+:n>=n0} $subset preimage_set(alternating,{v R:-1-epsilon<v})}
    witness exist n0 N+ st {{n N+:n>=n0} $subset preimage_set(alternating,{v R:-1-epsilon<v})} from 1:
        claim:
            ? forall k {n N+:n>=1}:
                k $in preimage_set(alternating,{v R:-1-epsilon<v})
            0<epsilon
            -1-epsilon=(-1-epsilon)+0<(-1-epsilon)+epsilon=-1
            -1-epsilon<-1<=alternating(k)
            alternating(k) $in {v R:-1-epsilon<v}
        by def {n N+:n>=1} $subset preimage_set(alternating,{v R:-1-epsilon<v})

claim:
    ? forall epsilon R+,n0 N+:
        exist n N+ st {n>=n0 and alternating(n)<-1+epsilon}
    2*n0+1 $in N+
    2*n0>=n0
    2*n0<2*n0+1
    n0<=2*n0<2*n0+1
    2*n0+1>=n0
    (-1)^(2*n0+1)=-1
    alternating(2*n0+1)=(-1)^(2*n0+1)=-1
    -1<-1+epsilon
    witness exist n N+ st {n>=n0 and alternating(n)<-1+epsilon} from 2*n0+1

by def $has_seq_liminf(alternating,-1)

liminf(alternating)=-1

limsup(alternating)-liminf(alternating)=2

# Nonconvergence, failure of additivity, and shift invariance.
claim:
    ? forall L R:
        not $has_seq_limit(alternating,L)
    by contra:
        ? not $has_seq_limit(alternating,L)
        $has_seq_limit(alternating,L)
        release thm seq_limsup_from_limit(alternating,L)
        release thm seq_liminf_from_limit(alternating,L)
        release thm seq_limsup_unique(alternating,L,1)
        release thm seq_liminf_unique(alternating,L,-1)
        1=L=-1
        impossible 1=-1

have fn opposite(k N+) R=-alternating(k)

forall n N+:
    opposite(n)=-alternating(n)

release thm seq_limsup_neg(alternating,opposite,1)

release thm seq_liminf_neg(alternating,opposite,-1)

limsup(opposite)=1

have fn cancel(k N+) R=alternating(k)+opposite(k)

claim:
    ? forall n N+:
        cancel(n)=0
    opposite(n)=-alternating(n)
    cancel(n)=alternating(n)+opposite(n)=alternating(n)+(-alternating(n))=0

release thm seq_limsup_constant(cancel,0)

limsup(cancel)=0

limsup(alternating)+limsup(opposite)=2

limsup(cancel)!=limsup(alternating)+limsup(opposite)

have fn shifted(k N+) R=alternating(k+1)

forall n N+:
    shifted(n)=alternating(n+1)

release thm seq_limsup_shift(alternating,shifted,1,1)

release thm seq_liminf_shift(alternating,shifted,-1,1)

limsup(shifted)=1

liminf(shifted)=-1
