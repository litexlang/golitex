  "accepted_source": {
    "file": "examples/wd/fixed_function_signature_scopes.lit",
    "code": "# Tracer: function parameter domains and return sets use the enclosing scope.\n#\n# Before (accepted by the former parser and WD):\n# let dependent = fn(S power_set(R)) fn(x S) R\n# Former behavior: the return object could capture the outer function's S.\n#\n# Now: a fixed nested return carrier remains valid.\nlet fixed = fn(S power_set(R)) fn(x R) R\nfixed = fixed\n\n# Disjoint signatures may reuse a spelling, with different binding identities.\nlet independent = fn(x R) fn(x R) R\nindependent = independent\n\n# Domain conditions and bodies still use the signature's own parameters.\nhave fn guarded(x R: x > 0) R = x + 1\nguarded(2) = 3\nfn(x R: x > 0) R {x + 1}(2) = 3\nlet compared = fn(x R, y Z: y > x) R\ncompared = compared\n\n# An enclosing quantifier's carrier is fixed for the inner function.\nforall A nonempty_set:\n    fn(x A) A {x} = fn(y A) A {y}\n\n# Preserve a precise output property separately from the fixed return set.\nhave fn singleton_identity(x R) R = x\nforall a R:\n    singleton_identity(a) $in {a}\n\n# Boundary: fn(S power_set(R), x S) R and dependent return sets reject at parse.\n# WD independently rejects such objects when constructed without the parser.\n# Evidence: target/release/litex -strict -f examples/wd/fixed_function_signature_scopes.lit\n# Require exit 0, JSON success:true, and session_error:null (current CLI has no -runner).\n# Tests: cargo test --release function_signature_scope_tests -- --nocapture\n",
    "command": "target/release/litex -strict -f examples/wd/fixed_function_signature_scopes.lit",
    "exit_code": 0,
    "success": true,
    "session_error": null
  },
