# Obj WD: index_union / index_intersect — full family `$in fn(k I) power_set(X)`
# Run: litex -f examples/wd/obj/index_union.lit
#
# Before Wave4: registration half only (any InFunctionSet).
# Now: family must inhabit `fn(k I) power_set(X)`.

let family = fn(k {1, 2}) power_set(N) {{1}}
let u = index_union({1, 2}, N, family)
let v = index_intersect({1, 2}, N, family)
u = u
v = v
