# Before: empty named families slipped past WD; empty indices are now disallowed.
# have fn empty_family(k {}) power_set(N) = {}
# index_union({}, N, empty_family) = {}
# Now: both named and anonymous families use a nonempty index.
# Run: target/release/litex -f examples/wd/obj/indexed_nonempty_index.lit
have fn family(k {1}) power_set(N) = {1}
index_union({1}, N, family) = index_union({1}, N, family)
index_intersect({1}, N, family) = index_intersect({1}, N, family)
index_cart({1}, power_set(N), family) = index_cart({1}, power_set(N), family)
$is_set(index_union({1}, N, fn(k {1}) power_set(N) {{1}}))
# Boundary: the same operators with {} indices must fail WD.
