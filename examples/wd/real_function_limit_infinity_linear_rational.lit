# The standard linear rational example at both infinite input ends.
# Explicit shifted reciprocal control, then named scale/add rules.
# The actual domain excludes only the pole x=1.

have fn shifted_reciprocal(x R:x!=1) R=1/(x-1)

claim:
    ? forall M R:
        exist x {t R:t!=1} st {M<x}
    M<=abs(M)
    0<=abs(M)
    0<abs(M)+2
    0+2<=abs(M)+2
    1<2<=abs(M)+2
    1<abs(M)+2
    M<abs(M)+2
    witness exist x {t R:t!=1} st {M<x} from abs(M)+2

claim:
    ? forall M R:
        exist x {t R:t!=1} st {x<M}
    -M<=abs(-M)
    abs(-M)=abs(M)
    -M<=abs(M)
    abs(M)*(-1)<=(-M)*(-1)
    abs(M)*(-1)=-abs(M)
    (-M)*(-1)=M
    -abs(M)<=M
    0<=abs(M)
    -abs(M)<=0
    -abs(M)-2<-abs(M)<=0
    -abs(M)-2<0
    -abs(M)-2<0<1
    -abs(M)-2<M
    witness exist x {t R:t!=1} st {x<M} from -abs(M)-2

claim:
    ? forall epsilon R+:
        exist T R st {{x {t R:t!=1}:T<x} $subset preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})}
    0<1/epsilon
    witness exist T R st {{x {t R:t!=1}:T<x} $subset preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})} from 1+1/epsilon:
        claim:
            ? forall x {s {t R:t!=1}:1+1/epsilon<s}:
                x $in preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})
            x $in {t R:t!=1}
            x $in R
            x!=1
            x-1!=0
            1+1/epsilon<x
            (1+1/epsilon)-1<x-1
            (1+1/epsilon)-1=1/epsilon
            0<1/epsilon<x-1
            (1/epsilon)*epsilon<(x-1)*epsilon
            (1/epsilon)*epsilon=1
            1<(x-1)*epsilon
            1/(x-1)<((x-1)*epsilon)/(x-1)
            ((x-1)*epsilon)/(x-1)=epsilon
            0<1/(x-1)<epsilon
            shifted_reciprocal(x)-0=1/(x-1)
            abs(1/(x-1))=1/(x-1)
            abs(shifted_reciprocal(x)-0)=abs(1/(x-1))=1/(x-1)<epsilon
            shifted_reciprocal(x) $in {v R:abs(v-0)<epsilon}
        by def {x {t R:t!=1}:1+1/epsilon<x} $subset preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})

claim:
    ? forall epsilon R+:
        exist T R st {{x {t R:t!=1}:x<T} $subset preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})}
    0<1/epsilon
    -(1/epsilon)<0
    witness exist T R st {{x {t R:t!=1}:x<T} $subset preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})} from 1-1/epsilon:
        claim:
            ? forall x {s {t R:t!=1}:s<1-1/epsilon}:
                x $in preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})
            x $in {t R:t!=1}
            x $in R
            x!=1
            x-1!=0
            x<1-1/epsilon
            x-1<(1-1/epsilon)-1
            (1-1/epsilon)-1=-(1/epsilon)
            x-1<-(1/epsilon)<0
            0<1-x
            (-(1/epsilon))*(-1)<(x-1)*(-1)
            (-(1/epsilon))*(-1)=1/epsilon
            (x-1)*(-1)=1-x
            1/epsilon<1-x
            (1/epsilon)*epsilon<(1-x)*epsilon
            (1/epsilon)*epsilon=1
            1<(1-x)*epsilon
            1/(1-x)<((1-x)*epsilon)/(1-x)
            ((1-x)*epsilon)/(1-x)=epsilon
            0<1/(1-x)<epsilon
            -(1/(1-x))<0
            1/(x-1)=-(1/(1-x))
            1/(x-1)<0
            shifted_reciprocal(x)-0=1/(x-1)
            abs(1/(x-1))=-(1/(x-1))=1/(1-x)
            abs(shifted_reciprocal(x)-0)=abs(1/(x-1))=1/(1-x)<epsilon
            shifted_reciprocal(x) $in {v R:abs(v-0)<epsilon}
        by def {x {t R:t!=1}:x<1-1/epsilon} $subset preimage_set(shifted_reciprocal,{v R:abs(v-0)<epsilon})

by def $has_limit_pos_inf(shifted_reciprocal,0)

by def $has_limit_neg_inf(shifted_reciprocal,0)

have fn shifted_two(x R:x!=1) R=2

have fn shifted_three(x R:x!=1) R=3*shifted_reciprocal(x)

have fn linear_rational(x R:x!=1) R=(2*x+1)/(x-1)

forall x {t R:t!=1}:
    shifted_three(x)=3*shifted_reciprocal(x)

claim:
    ? forall x {t R:t!=1}:
        linear_rational(x)=shifted_two(x)+shifted_three(x)
    x $in R
    x!=1
    x-1!=0
    shifted_two(x)=2
    shifted_reciprocal(x)=1/(x-1)
    shifted_three(x)=3*shifted_reciprocal(x)=3*(1/(x-1))=3/(x-1)
    shifted_two(x)+shifted_three(x)=2+3/(x-1)=(2*x+1)/(x-1)=linear_rational(x)

release thm fn_limit_pos_inf_constant(shifted_two,2)

release thm fn_limit_pos_inf_scale(shifted_reciprocal,shifted_three,0,3)

$has_limit_pos_inf(shifted_three,0)

release thm fn_limit_pos_inf_add(shifted_two,shifted_three,linear_rational,2,0)

lim_pos_inf(linear_rational)=2

release thm fn_limit_neg_inf_constant(shifted_two,2)

release thm fn_limit_neg_inf_scale(shifted_reciprocal,shifted_three,0,3)

$has_limit_neg_inf(shifted_three,0)

release thm fn_limit_neg_inf_add(shifted_two,shifted_three,linear_rational,2,0)

lim_neg_inf(linear_rational)=2
