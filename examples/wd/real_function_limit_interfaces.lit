# Real subset domains, proved existence, nested value use and equality transport.
# Run: target/release/litex -strict -lang en -f examples/wd/real_function_limit_interfaces.lit

forall D power_set(R), af fn(x D) R, p,L R:
    $has_limit_at(af,p,L)
    =>:
        lim(af,p)=L
        lim(af,p) $in R

forall af fn(x R) R, p R:
    exist L R st {$has_limit_at(af,p,L)}
    =>:
        lim(af,p) $in R

have fn after_limit(y R) R=y+1

claim:
    ? forall af fn(x R) R, p,L R:
        $has_limit_at(af,p,L)
        =>:
            after_limit(lim(af,p))=L+1
    lim(af,p)=L
    after_limit(lim(af,p))=lim(af,p)+1=L+1

forall af,ag fn(x R) R, p,q,L R:
    af=ag
    p=q
    $has_limit_at(af,p,L)
    =>:
        lim(af,p)=lim(ag,q)
