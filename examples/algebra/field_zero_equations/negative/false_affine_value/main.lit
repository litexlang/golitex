have fn real_inv(x R: x != 0) R = 1 / x

have fn real_add(x, y R) R = x + y

have fn real_neg(x R) R = -x

have fn real_mul(x, y R) R = x * y

forall x, y, z R:
    real_add(real_add(x, y), z) = real_add(x, real_add(y, z))
    real_mul(real_mul(x, y), z) = real_mul(x, real_mul(y, z))
    real_mul(x, real_add(y, z)) = real_add(real_mul(x, y), real_mul(x, z))

forall x, y R:
    real_add(x, y) = real_add(y, x)
    real_mul(x, y) = real_mul(y, x)

forall x R:
    real_add(0, x) = x
    real_add(x, real_neg(x)) = 0
    real_mul(1, x) = x

forall x R:
    x != 0
    =>:
        real_mul(x, real_inv(x)) = 1

release thm struct_member((0, 1, real_add, real_neg, real_mul, real_inv), &Algebra::field::Field<R>)

have real_field &Algebra::field::Field<R> = (0, 1, real_add, real_neg, real_mul, real_inv)

real_field.zero=0

real_field.one=1

real_field.add=real_add

real_field.mul=real_mul

3!=real_field.zero

3!=7

release thm Algebra::field::field_zero_linear_no_solution(R,real_field,3,2)

release thm Algebra::field::field_zero_linear_two_solutions(R,real_field)

release thm Algebra::field::field_zero_affine_all_solutions(R,real_field,3,2)

release thm Algebra::field::field_zero_affine_no_solution(R,real_field,3,7,2)

release thm Algebra::field::field_zero_affine_two_solutions(R,real_field,3)

real_field.zero!=real_field.one

real_field.mul(real_field.zero,0)=real_field.zero

real_field.mul(real_field.zero,1)=real_field.zero

real_field.add(real_field.mul(real_field.zero,0),3)=3

real_field.add(real_field.mul(real_field.zero,1),3)=3

real_field.add(real_field.mul(real_field.zero,2),3)=7
