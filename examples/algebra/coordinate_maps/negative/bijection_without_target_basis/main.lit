thm bijection_without_target_basis:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,n N,u finite_seq(V,n),w finite_seq(W,n):
        $Algebra::basis::is_basis(K,field,V,source,n,u)
        =>:
            $bijective(V,W,\Algebra::coordinate_maps::linear_map_from_basis<K,field,V,source,W,target,n,u,w>)
    by thm Algebra::coordinate_maps::basis_maps_are_bijective(K,field,V,source,W,target,n,u,w) => $bijective(V,W,\Algebra::coordinate_maps::linear_map_from_basis<K,field,V,source,W,target,n,u,w>)
