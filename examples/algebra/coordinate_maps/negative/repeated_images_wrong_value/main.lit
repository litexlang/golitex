claim:
    ? forall j closed_range(1,2):
        context::swap(model::standard_basis(j))=swap_images(j)
    swap_images(j)=\Algebra::finite_span::map_vectors<R × R,R × R,2>(context::swap,model::standard_basis)(j)=context::swap(model::standard_basis(j))

