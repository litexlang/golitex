thm map_wrong_image_length:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,n N,u finite_seq(V,n),w finite_seq(W,n+1):
        $Algebra::basis::is_basis(K,field,V,source,n,u)
        =>:
            \Algebra::coordinate_maps::linear_map_from_basis<K,field,V,source,W,target,n,u,w> $in fn(x V) W
