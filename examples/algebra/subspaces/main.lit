# Inherited subspaces: axis dimension1, full dimension2, zero dimension0 and projection kernel/image.

release obj def model::real_inv

release obj def model::real_add

release obj def model::real_neg

release obj def model::real_mul

release obj def model::plane_add

release obj def model::plane_smul

release obj def model::e1

release obj def model::e2

release obj def model::real_field

release obj def model::real_plane

release obj def model::standard_basis

release struct def model::real_field

release struct def model::real_plane

release thm model::standard_plane_basis()

by thm Algebra::basis::basis_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,2,model::standard_basis) => $Algebra::basis::is_finite_dimensional(R,model::real_field,R × R,model::real_plane)

by thm Algebra::dimension::finite_dimension_of_basis(R,model::real_field,R × R,model::real_plane,2,model::standard_basis) => \Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)=2

have axis power_set(R × R)={p R × R: p(2)=0}

claim:
    ? $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,axis)
    model::real_plane.zero=(0,0)
    model::real_plane.zero(2)=0
    claim:
        ? forall u,v R × R:
            u $in axis
            v $in axis
            =>:
                model::real_plane.add(u,v) $in axis
        model::real_plane.add(u,v)=model::plane_add(u,v)=(u(1)+v(1),u(2)+v(2))
        model::real_plane.add(u,v)(2)=u(2)+v(2)=0
    claim:
        ? forall a R,v R × R:
            v $in axis
            =>:
                model::real_plane.smul(a,v) $in axis
        model::real_plane.smul(a,v)=model::plane_smul(a,v)=(a*v(1),a*v(2))
        model::real_plane.smul(a,v)(2)=a*v(2)=0
    by def $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,axis)

by thm Algebra::subspace::subspace_is_nonempty(R,model::real_field,R × R,model::real_plane,axis) => $is_nonempty_set(axis)

by thm Algebra::subspace::restricted_space_is_vector_space(R,model::real_field,R × R,model::real_plane,axis) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis> $in &Algebra::vector_space::VectorSpace<R,model::real_field,axis>

have axis_space &Algebra::vector_space::VectorSpace<R,model::real_field,axis> = \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>

by thm Algebra::subspace::finite_dimensional_subspace_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,axis) => $Algebra::basis::is_finite_dimensional(R,model::real_field,axis,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>)

by thm Algebra::subspace::subspace_dimension_le_ambient(R,model::real_field,R × R,model::real_plane,axis) => \Algebra::dimension::finite_dimension<R,model::real_field,axis>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>)<=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

model::e1 $in axis

have axis_basis finite_seq(axis,1)=(model::e1,)

claim:
    ? $Algebra::basis::is_linearly_independent(R,model::real_field,R × R,model::real_plane,1,axis_basis)
    claim:
        ? forall c finite_seq(R,1):
            $Algebra::finite_span::has_linear_combination_value(R,model::real_field,R × R,model::real_plane,1,c,axis_basis,model::real_plane.zero)
            =>:
                $Algebra::basis::has_only_zero_coefficients(R,model::real_field,1,c)
        obtain sums from $Algebra::finite_span::has_linear_combination_value(R,model::real_field,R × R,model::real_plane,1,c,axis_basis,model::real_plane.zero)
        sums(0)=model::real_plane.zero
        axis_basis(1)=model::e1
        c(1) $in R
        have term R × R=model::real_plane.smul(c(1),axis_basis(1))
        model::real_plane.add(model::real_plane.zero,term)=term
        sums(1)=model::real_plane.add(sums(0),model::real_plane.smul(c(1),axis_basis(1)))=model::real_plane.add(model::real_plane.zero,term)=term
        model::e1(1)=1
        model::e1(2)=0
        axis_basis(1) $in R × R
        term=model::real_plane.smul(c(1),axis_basis(1))=model::plane_smul(c(1),axis_basis(1))=model::plane_smul(c(1),model::e1)=(c(1)*model::e1(1),c(1)*model::e1(2))=(c(1)*1,c(1)*0)=(c(1),0)
        sums(1)=model::real_plane.zero=(0,0)
        sums(1)(1)=0
        term(1)=c(1)
        c(1)=0=model::real_field.zero
        claim:
            ? forall j N+:
                j<=1
                =>:
                    c(j)=model::real_field.zero
            j=1
            c(j)=c(1)=model::real_field.zero
        by def $Algebra::basis::has_only_zero_coefficients(R,model::real_field,1,c)
    by def $Algebra::basis::is_linearly_independent(R,model::real_field,R × R,model::real_plane,1,axis_basis)

by thm Algebra::subspace::ambient_independent_is_subspace_independent(R,model::real_field,R × R,model::real_plane,axis,1,axis_basis) => $Algebra::basis::is_linearly_independent(R,model::real_field,axis,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>,1,axis_basis)

claim:
    ? \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,1,axis_basis> = axis
    claim:
        ? forall j N+:
            j<=1
            =>:
                axis_basis(j) $in axis
        j=1
    by thm Algebra::span_reduction::span_subset_subspace(R,model::real_field,R × R,model::real_plane,1,axis_basis,axis) => \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,1,axis_basis> $subset axis
    claim:
        ? forall p axis:
            p $in \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,1,axis_basis>
        have c finite_seq(R,1)=(p(1),)
        claim:
            ? forall idx N+:
                idx<=1
                idx!=1
                =>:
                    c(idx)=model::real_field.zero
            by contra:
                ? c(idx)=model::real_field.zero
                idx=1
                impossible idx!=1
        by thm Algebra::finite_span::single_coefficient_linear_combination(R,model::real_field,R × R,model::real_plane,1,c,axis_basis,1) => \Algebra::finite_span::linear_combination<R,model::real_field,R × R,model::real_plane,1>(c,axis_basis)=model::real_plane.smul(c(1),axis_basis(1))
        c(1)=p(1)
        axis_basis(1)=model::e1
        c(1) $in R
        p(1) $in R
        axis_basis(1) $in R × R
        model::e1(1)=1
        model::e1(2)=0
        model::real_plane.smul(c(1),axis_basis(1))=model::plane_smul(c(1),axis_basis(1))=model::plane_smul(p(1),model::e1)=(p(1)*model::e1(1),p(1)*model::e1(2))=(p(1)*1,p(1)*0)=(p(1),0)=(p(1),p(2))=p
        release thm Algebra::finite_span::linear_combination_has_value(R,model::real_field,R × R,model::real_plane,1,c,axis_basis)
        witness $Algebra::finite_span::is_linear_combination(R,model::real_field,R × R,model::real_plane,1,p,axis_basis) from c
    by extension \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,1,axis_basis> = axis

by thm Algebra::subspace::subspace_span_equals_ambient(R,model::real_field,R × R,model::real_plane,axis,1,axis_basis) => \Algebra::finite_span::span<R,model::real_field,axis,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>,1,axis_basis> = \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,1,axis_basis>

by def $Algebra::finite_span::spans(R,model::real_field,axis,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>,1,axis_basis)

by def $Algebra::basis::is_basis(R,model::real_field,axis,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>,1,axis_basis)

by thm Algebra::dimension::finite_dimension_of_basis(R,model::real_field,axis,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>,1,axis_basis) => \Algebra::dimension::finite_dimension<R,model::real_field,axis>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>)=1

\Algebra::dimension::finite_dimension<R,model::real_field,axis>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>)=1<2=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

by thm Algebra::subspace::ambient_is_subspace(R,model::real_field,R × R,model::real_plane) => $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,R × R)

by thm Algebra::subspace::restricted_space_is_vector_space(R,model::real_field,R × R,model::real_plane,R × R) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R> $in &Algebra::vector_space::VectorSpace<R,model::real_field,R × R>

have whole_space &Algebra::vector_space::VectorSpace<R,model::real_field,R × R> = \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>

by thm Algebra::subspace::finite_dimensional_subspace_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,R × R) => $Algebra::basis::is_finite_dimensional(R,model::real_field,R × R,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>)

by thm Algebra::subspace::ambient_independent_is_subspace_independent(R,model::real_field,R × R,model::real_plane,R × R,2,model::standard_basis) => $Algebra::basis::is_linearly_independent(R,model::real_field,R × R,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>,2,model::standard_basis)

by thm Algebra::subspace::subspace_span_equals_ambient(R,model::real_field,R × R,model::real_plane,R × R,2,model::standard_basis) => \Algebra::finite_span::span<R,model::real_field,R × R,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>,2,model::standard_basis> = \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,2,model::standard_basis>

$Algebra::finite_span::spans(R,model::real_field,R × R,model::real_plane,2,model::standard_basis)

\Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,2,model::standard_basis> = R × R

by def $Algebra::finite_span::spans(R,model::real_field,R × R,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>,2,model::standard_basis)

by def $Algebra::basis::is_basis(R,model::real_field,R × R,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>,2,model::standard_basis)

by thm Algebra::dimension::finite_dimension_of_basis(R,model::real_field,R × R,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>,2,model::standard_basis) => \Algebra::dimension::finite_dimension<R,model::real_field,R × R>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,R × R>)=2

have zero_carrier power_set(R × R)={model::real_plane.zero}

by thm Algebra::subspace::zero_is_subspace(R,model::real_field,R × R,model::real_plane) => $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,{model::real_plane.zero})

by thm Algebra::subspace::subspace_is_nonempty(R,model::real_field,R × R,model::real_plane,zero_carrier) => $is_nonempty_set(zero_carrier)

by thm Algebra::subspace::restricted_space_is_vector_space(R,model::real_field,R × R,model::real_plane,zero_carrier) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier> $in &Algebra::vector_space::VectorSpace<R,model::real_field,zero_carrier>

have zero_space &Algebra::vector_space::VectorSpace<R,model::real_field,zero_carrier> = \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>

by thm Algebra::subspace::finite_dimensional_subspace_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,zero_carrier) => $Algebra::basis::is_finite_dimensional(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>)

have zero_basis finite_seq(zero_carrier,0)=tuple()

by thm Algebra::dependence::empty_list_is_independent(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,zero_basis) => $Algebra::basis::is_linearly_independent(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis)

by thm Algebra::finite_span::span_zero_member(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>.zero $in \Algebra::finite_span::span<R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis>

claim:
    ? \Algebra::finite_span::span<R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis> = zero_carrier
    \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>.zero=model::real_plane.zero
    \Algebra::finite_span::span<R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis> = {p zero_carrier: $Algebra::finite_span::is_linear_combination(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,p,zero_basis)}
    claim:
        ? forall p zero_carrier:
            p $in \Algebra::finite_span::span<R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis>
        p $in {model::real_plane.zero}
        p=model::real_plane.zero=\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>.zero
    by extension \Algebra::finite_span::span<R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis> = zero_carrier

by def $Algebra::finite_span::spans(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis)

by def $Algebra::basis::is_basis(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis)

by thm Algebra::dimension::finite_dimension_of_basis(R,model::real_field,zero_carrier,\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>,0,zero_basis) => \Algebra::dimension::finite_dimension<R,model::real_field,zero_carrier>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,zero_carrier>)=0

have fn projection(p R × R) R × R=(p(1),0)

claim:
    ? $Algebra::vector_space::is_linear_map(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,projection)
    claim:
        ? forall u,v R × R:
            projection(model::real_plane.add(u,v))=model::real_plane.add(projection(u),projection(v))
        model::real_plane.add(u,v)=model::plane_add(u,v)=(u(1)+v(1),u(2)+v(2))
        model::real_plane.add(u,v)(1)=u(1)+v(1)
        projection(model::real_plane.add(u,v))=(u(1)+v(1),0)
        projection(u)=(u(1),0)
        projection(v)=(v(1),0)
        projection(u)(1)=u(1)
        projection(u)(2)=0
        projection(v)(1)=v(1)
        projection(v)(2)=0
        model::real_plane.add(projection(u),projection(v))=model::plane_add(projection(u),projection(v))=(projection(u)(1)+projection(v)(1),projection(u)(2)+projection(v)(2))=(u(1)+v(1),0)
    claim:
        ? forall a R,v R × R:
            projection(model::real_plane.smul(a,v))=model::real_plane.smul(a,projection(v))
        model::real_plane.smul(a,v)=model::plane_smul(a,v)=(a*v(1),a*v(2))
        model::real_plane.smul(a,v)(1)=a*v(1)
        projection(model::real_plane.smul(a,v))=(a*v(1),0)
        projection(v)=(v(1),0)
        projection(v)(1)=v(1)
        projection(v)(2)=0
        projection(v)(1) $in R
        projection(v)(2) $in R
        v(1) $in R
        a*projection(v)(1)=a*v(1)
        a*projection(v)(2)=a*0=0
        model::real_plane.smul(a,projection(v))=model::plane_smul(a,projection(v))=(a*projection(v)(1),a*projection(v)(2))=(a*v(1),a*0)=(a*v(1),0)
    by def $Algebra::vector_space::is_linear_map(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,projection)

claim:
    ? projection(model::e1)=model::e1
    model::e1(1)=1
    projection(model::e1)=(model::e1(1),0)=(1,0)=model::e1

claim:
    ? projection(model::e2)=model::real_plane.zero
    model::e2(1)=0
    projection(model::e2)=(model::e2(1),0)=(0,0)=model::real_plane.zero

model::e2 $in preimage(projection,model::real_plane.zero)

projection(model::e1) $in fn_range(projection)

by thm Algebra::vector_space::kernel_is_subspace(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,projection) => $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero))

by thm Algebra::subspace::subspace_is_nonempty(R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)) => $is_nonempty_set(preimage(projection,model::real_plane.zero))

by thm Algebra::subspace::restricted_space_is_vector_space(R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)> $in &Algebra::vector_space::VectorSpace<R,model::real_field,preimage(projection,model::real_plane.zero)>

by thm Algebra::subspace::finite_dimensional_subspace_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)) => $Algebra::basis::is_finite_dimensional(R,model::real_field,preimage(projection,model::real_plane.zero),\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)>)

by thm Algebra::subspace::subspace_dimension_le_ambient(R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)) => \Algebra::dimension::finite_dimension<R,model::real_field,preimage(projection,model::real_plane.zero)>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,preimage(projection,model::real_plane.zero)>)<=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

fn_range(projection) $subset R × R

fn_range(projection) $in power_set(R × R)

by thm Algebra::vector_space::range_is_subspace(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,projection) => $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,fn_range(projection))

by thm Algebra::subspace::subspace_is_nonempty(R,model::real_field,R × R,model::real_plane,fn_range(projection)) => $is_nonempty_set(fn_range(projection))

by thm Algebra::subspace::restricted_space_is_vector_space(R,model::real_field,R × R,model::real_plane,fn_range(projection)) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,fn_range(projection)> $in &Algebra::vector_space::VectorSpace<R,model::real_field,fn_range(projection)>

by thm Algebra::subspace::finite_dimensional_subspace_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,fn_range(projection)) => $Algebra::basis::is_finite_dimensional(R,model::real_field,fn_range(projection),\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,fn_range(projection)>)

by thm Algebra::subspace::subspace_dimension_le_ambient(R,model::real_field,R × R,model::real_plane,fn_range(projection)) => \Algebra::dimension::finite_dimension<R,model::real_field,fn_range(projection)>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,fn_range(projection)>)<=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

\Algebra::dimension::finite_dimension<R,model::real_field,axis>(axis_space)=\Algebra::dimension::finite_dimension<R,model::real_field,axis>(\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,axis>)

\Algebra::dimension::finite_dimension<R,model::real_field,axis>(axis_space)=1

thm projection_axis_facts:
    ? forall:
        $Algebra::vector_space::is_linear_map(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,projection)
        $Algebra::basis::is_linearly_independent(R,model::real_field,R × R,model::real_plane,1,axis_basis)
        \Algebra::finite_span::span<R,model::real_field,R × R,model::real_plane,1,axis_basis> = axis
        projection(model::e1)=model::e1
        projection(model::e2)=model::real_plane.zero
