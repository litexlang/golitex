# Arbitrary-field interfaces and both construction carriers.

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,m N,vectors finite_seq(V,m),x V:
        $Algebra::basis::is_linearly_independent(K,field,V,space,m,vectors)
        not x $in \Algebra::finite_span::span<K,field,V,space,m,vectors>
        =>:
            $Algebra::basis::is_linearly_independent(K,field,V,space,m+1,\Algebra::basis_extension::append_vector<V,m,vectors,x>)
    by thm Algebra::basis_extension::append_outside_span_is_independent(K,field,V,space,m,vectors,x) => $Algebra::basis::is_linearly_independent(K,field,V,space,m+1,\Algebra::basis_extension::append_vector<V,m,vectors,x>)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,n N,vectors finite_seq(V,n):
        $Algebra::basis::has_basis_length(K,field,V,space,n)
        $Algebra::basis::is_linearly_independent(K,field,V,space,n,vectors)
        =>:
            $Algebra::finite_span::spans(K,field,V,space,n,vectors)
    by thm Algebra::basis_extension::independent_list_with_basis_length_spans(K,field,V,space,n,vectors) => $Algebra::finite_span::spans(K,field,V,space,n,vectors)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,n N,vectors finite_seq(V,n):
        $Algebra::basis::has_basis_length(K,field,V,space,n)
        $Algebra::finite_span::spans(K,field,V,space,n,vectors)
        =>:
            $Algebra::basis::is_linearly_independent(K,field,V,space,n,vectors)
    by thm Algebra::basis_extension::spanning_list_with_basis_length_is_independent(K,field,V,space,n,vectors) => $Algebra::basis::is_linearly_independent(K,field,V,space,n,vectors)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,m N,vectors finite_seq(V,m):
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::basis::is_linearly_independent(K,field,V,space,m,vectors)
        =>:
            exist r N,extended finite_seq(V,r) st {$Algebra::basis::is_basis(K,field,V,space,r,extended),$Algebra::basis::is_prefix_of_length(V,r,m,extended,vectors)}
    release thm Algebra::basis_extension::independent_list_extends_to_basis(K,field,V,space,m,vectors)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>:
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        =>:
            $Algebra::basis::has_basis_length(K,field,V,space,\Algebra::dimension::finite_dimension<K,field,V>(space))
    by thm Algebra::dimension::finite_dimension_has_basis_length(K,field,V,space) => $Algebra::basis::has_basis_length(K,field,V,space,\Algebra::dimension::finite_dimension<K,field,V>(space))

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,n N,vectors finite_seq(V,n):
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::basis::is_basis(K,field,V,space,n,vectors)
        =>:
            \Algebra::dimension::finite_dimension<K,field,V>(space)=n
    by thm Algebra::dimension::finite_dimension_of_basis(K,field,V,space,n,vectors) => \Algebra::dimension::finite_dimension<K,field,V>(space)=n

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,m N,vectors finite_seq(V,m):
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::basis::is_linearly_independent(K,field,V,space,m,vectors)
        =>:
            m<=\Algebra::dimension::finite_dimension<K,field,V>(space)
    by thm Algebra::dimension::independent_length_le_dimension(K,field,V,space,m,vectors) => m<=\Algebra::dimension::finite_dimension<K,field,V>(space)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,n N,vectors finite_seq(V,n):
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::finite_span::spans(K,field,V,space,n,vectors)
        =>:
            \Algebra::dimension::finite_dimension<K,field,V>(space)<=n
    by thm Algebra::dimension::dimension_le_spanning_length(K,field,V,space,n,vectors) => \Algebra::dimension::finite_dimension<K,field,V>(space)<=n

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,n N,vectors finite_seq(V,n):
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::basis::is_linearly_independent(K,field,V,space,n,vectors)
        n=\Algebra::dimension::finite_dimension<K,field,V>(space)
        =>:
            $Algebra::basis::is_basis(K,field,V,space,n,vectors)
    by thm Algebra::dimension::independent_dimension_list_is_basis(K,field,V,space,n,vectors) => $Algebra::basis::is_basis(K,field,V,space,n,vectors)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,n N,vectors finite_seq(V,n):
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::finite_span::spans(K,field,V,space,n,vectors)
        n=\Algebra::dimension::finite_dimension<K,field,V>(space)
        =>:
            $Algebra::basis::is_basis(K,field,V,space,n,vectors)
    by thm Algebra::dimension::spanning_dimension_list_is_basis(K,field,V,space,n,vectors) => $Algebra::basis::is_basis(K,field,V,space,n,vectors)

forall V nonempty_set,m N,vectors finite_seq(V,m),x V:
    \Algebra::basis_extension::append_vector<V,m,vectors,x> $in finite_seq(V,m+1)

forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>:
    $Algebra::basis::is_finite_dimensional(K,field,V,space)
    =>:
        \Algebra::dimension::finite_dimension<K,field,V>(space) $in N
