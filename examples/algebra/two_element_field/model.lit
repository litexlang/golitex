have fn two_add(x,y {0,1}) {0,1} by cases:
    case x=y: 0
    case x!=y: 1

have fn two_mul(x,y {0,1}) {0,1} by cases:
    case x*y=1: 1
    case x*y!=1: 0

have fn two_neg(x {0,1}) {0,1} = x

have fn two_inv(x {0,1}: x!=0) {0,1} = x

two_add(0,0)=0

two_add(0,1)=1

two_add(1,0)=1

two_add(1,1)=0

two_mul(0,0)=0

two_mul(0,1)=0

two_mul(1,0)=0

two_mul(1,1)=1

two_neg(0)=0

two_neg(1)=1

two_inv(1)=1

claim:
    ? forall x,y,z {0,1}:
        two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
    by cases:
        ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
        case x=0:
            by cases:
                ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                case y=0:
                    by cases:
                        ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=0:
                            two_add(x,y)=two_add(0,0)=0
                            two_add(y,z)=two_add(0,0)=0
                            two_add(two_add(x,y),z)=two_add(0,0)=0
                            two_add(x,two_add(y,z))=two_add(0,0)=0
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=1:
                            two_add(x,y)=two_add(0,0)=0
                            two_add(y,z)=two_add(0,1)=1
                            two_add(two_add(x,y),z)=two_add(0,1)=1
                            two_add(x,two_add(y,z))=two_add(0,1)=1
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                case y=1:
                    by cases:
                        ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=0:
                            two_add(x,y)=two_add(0,1)=1
                            two_add(y,z)=two_add(1,0)=1
                            two_add(two_add(x,y),z)=two_add(1,0)=1
                            two_add(x,two_add(y,z))=two_add(0,1)=1
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=1:
                            two_add(x,y)=two_add(0,1)=1
                            two_add(y,z)=two_add(1,1)=0
                            two_add(two_add(x,y),z)=two_add(1,1)=0
                            two_add(x,two_add(y,z))=two_add(0,0)=0
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
        case x=1:
            by cases:
                ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                case y=0:
                    by cases:
                        ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=0:
                            two_add(x,y)=two_add(1,0)=1
                            two_add(y,z)=two_add(0,0)=0
                            two_add(two_add(x,y),z)=two_add(1,0)=1
                            two_add(x,two_add(y,z))=two_add(1,0)=1
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=1:
                            two_add(x,y)=two_add(1,0)=1
                            two_add(y,z)=two_add(0,1)=1
                            two_add(two_add(x,y),z)=two_add(1,1)=0
                            two_add(x,two_add(y,z))=two_add(1,1)=0
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                case y=1:
                    by cases:
                        ? two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=0:
                            two_add(x,y)=two_add(1,1)=0
                            two_add(y,z)=two_add(1,0)=1
                            two_add(two_add(x,y),z)=two_add(0,0)=0
                            two_add(x,two_add(y,z))=two_add(1,1)=0
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))
                        case z=1:
                            two_add(x,y)=two_add(1,1)=0
                            two_add(y,z)=two_add(1,1)=0
                            two_add(two_add(x,y),z)=two_add(0,1)=1
                            two_add(x,two_add(y,z))=two_add(1,0)=1
                            two_add(two_add(x,y),z)=two_add(x,two_add(y,z))

claim:
    ? forall x,y,z {0,1}:
        two_mul(two_mul(x,y),z)=two_mul(x,two_mul(y,z))
