# Imported finite combinations, span closure and coefficient/map operations.
# Before: the lecture owned linear_combination and span_is_subspace.
# release thm span_is_subspace(R,real_field,R,scalars,2,(1,2))
# Now: this independent consumer computes 2*1+3*4=14 and uses std/algebra.
# Boundary: wrong lengths, values, trace evidence, indices and nonlinearity reject.
# Run: LITEX_STD_PATH="$PWD/std" target/release/litex -lang en -strict -f examples/algebra/finite_span/main.lit

have fn real_inv(x R: x != 0) R = 1 / x

have fn real_add(x, y R) R = x + y

have fn real_neg(x R) R = -x

have fn real_mul(x, y R) R = x * y

forall x, y, z R:
    real_add(real_add(x, y), z) = real_add(x, real_add(y, z))
    real_mul(real_mul(x, y), z) = real_mul(x, real_mul(y, z))
    real_mul(x, real_add(y, z)) = real_add(real_mul(x, y), real_mul(x, z))

forall x, y R:
    real_add(x, y) = real_add(y, x)
    real_mul(x, y) = real_mul(y, x)

forall x R:
    real_add(0, x) = x
    real_add(x, real_neg(x)) = 0
    real_mul(1, x) = x

forall x R:
    x != 0
    =>:
        real_mul(x, real_inv(x)) = 1

release thm struct_member((0, 1, real_add, real_neg, real_mul, real_inv), &Algebra::field::Field<R>)

have real_field &Algebra::field::Field<R> = (0, 1, real_add, real_neg, real_mul, real_inv)

claim:
    ? forall x R:
        real_add(0,x)=x
        exist y R st {real_add(x,y)=0}
    real_add(0,x)=x
    real_add(x,-x)=0
    witness exist y R st {real_add(x,y)=0} from -x

claim:
    ? forall a,b,x R:
        real_mul(real_field.mul(a,b),x)=real_mul(a,real_mul(b,x))
        real_mul(real_field.add(a,b),x)=real_add(real_mul(a,x),real_mul(b,x))
    real_field.mul=real_mul
    real_field.add=real_add
    real_field.mul(a,b)=real_mul(a,b)=a*b
    real_field.add(a,b)=real_add(a,b)=a+b
    real_mul(real_field.mul(a,b),x)=real_mul(a*b,x)=(a*b)*x=a*(b*x)=real_mul(a,real_mul(b,x))
    real_mul(real_field.add(a,b),x)=real_mul(a+b,x)=(a+b)*x=a*x+b*x=real_add(real_mul(a,x),real_mul(b,x))

forall a,x,y R:
    real_mul(a,real_add(x,y))=real_add(real_mul(a,x),real_mul(a,y))

claim:
    ? forall x R:
        real_mul(real_field.one,x)=x
    real_field.one=1
    real_mul(real_field.one,x)=real_mul(1,x)=1*x=x

real_add $in fn(x,y R) R

real_mul $in fn(a R,x R) R

forall x,y,z R:
    real_add(real_add(x,y),z)=real_add(x,real_add(y,z))

forall x,y R:
    real_add(x,y)=real_add(y,x)

release thm struct_member((0,real_add,real_mul),&Algebra::vector_space::VectorSpace<R,real_field,R>)

have scalars &Algebra::vector_space::VectorSpace<R,real_field,R> = (0,real_add,real_mul)

have coefficients finite_seq(R,2)=(2,3)

have vectors finite_seq(R,2)=(1,4)

claim:
    ? forall k closed_range(0,2):
        k=0 or k=1 or k=2
    by for:
        ? forall k2 closed_range(0,2):
            k2=0 or k2=1 or k2=2
        k2=0 or k2=1 or k2=2

have fn sums(k closed_range(0,2)) R by cases:
    case k=0: 0
    case k=1: 2
    case k=2: 14

claim:
    ? $Algebra::finite_span::is_partial_sum(R,real_field,R,scalars,2,coefficients,vectors,sums)
    scalars.zero=0
    scalars.add=real_add
    scalars.smul=real_mul
    sums(0)=0=scalars.zero
    sums(1)=2
    sums(2)=14
    coefficients(1)=2
    coefficients(2)=3
    vectors(1)=1
    vectors(2)=4
    claim:
        ? forall k N+:
            k<=2
            =>:
                sums(k)=scalars.add(sums(k-1),scalars.smul(coefficients(k),vectors(k)))
        k $in closed_range(1,2)
        expand: k $in closed_range(1,2)
        k=1 or k=2
        by cases:
            ? sums(k)=scalars.add(sums(k-1),scalars.smul(coefficients(k),vectors(k)))
            case k=1:
                k-1=0
                sums(k-1)=sums(0)=0
                coefficients(k)=2
                vectors(k)=1
                scalars.smul(coefficients(k),vectors(k))=real_mul(2,1)=2
                scalars.add(sums(k-1),scalars.smul(coefficients(k),vectors(k)))=real_add(0,2)=2=sums(k)
            case k=2:
                k-1=1
                sums(k-1)=sums(1)=2
                coefficients(k)=3
                vectors(k)=4
                scalars.smul(coefficients(k),vectors(k))=real_mul(3,4)=12
                scalars.add(sums(k-1),scalars.smul(coefficients(k),vectors(k)))=real_add(2,12)=14=sums(k)
    by def $Algebra::finite_span::is_partial_sum(R,real_field,R,scalars,2,coefficients,vectors,sums)

by thm Algebra::finite_span::partial_sum_determines_combination(R,real_field,R,scalars,2,coefficients,vectors,sums) => \Algebra::finite_span::linear_combination<R,real_field,R,scalars,2>(coefficients,vectors)=sums(2)

\Algebra::finite_span::linear_combination<R,real_field,R,scalars,2>(coefficients,vectors)=sums(2)=14

release thm Algebra::finite_span::span_is_subspace(R,real_field,R,scalars,2,(1,2))

release thm Algebra::finite_span::span_zero_member(R,real_field,R,scalars,2,vectors)

release thm Algebra::finite_span::zero_coefficients_carrier(R,real_field,2)

release thm Algebra::finite_span::linear_combination_zero_coefficients(R,real_field,R,scalars,2,vectors)

release thm Algebra::finite_span::linear_combination_add_coefficients(R,real_field,R,scalars,2,coefficients,coefficients,vectors)

release thm Algebra::finite_span::linear_combination_smul_coefficients(R,real_field,R,scalars,2,5,coefficients,vectors)

release thm Algebra::finite_span::neg_coefficients_entry(R,real_field,2,coefficients,\Algebra::finite_span::neg_coefficients<R,real_field,2>(coefficients),1)

release thm Algebra::vector_space::identity_linear(R,real_field,R,scalars)

release thm Algebra::finite_span::linear_map_preserves_combination(R,real_field,R,scalars,R,scalars,\Algebra::vector_space::identity<R>,2,coefficients,vectors)
