# Must reject only the final statement; see ../README.md.
release obj def context::real_inv
release obj def context::real_add
release obj def context::real_neg
release obj def context::real_mul
release obj def context::real_field
release obj def context::scalars
release obj def context::constant_zero
release obj def context::shift
release obj def context::square
release obj def context::bad_smul
release struct def context::real_field
release struct def context::scalars

by thm context::zero_is_linear => $Algebra::vector_space::is_linear_map(R,context::real_field,R,context::scalars,R,context::scalars,context::constant_zero)

by thm Algebra::vector_space::zero_kernel_is_injective(R,context::real_field,R,context::scalars,R,context::scalars,context::constant_zero) => $injective(R,R,context::constant_zero)
