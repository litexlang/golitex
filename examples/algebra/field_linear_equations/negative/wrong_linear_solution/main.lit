have fn real_inv(x R: x != 0) R = 1 / x

have fn real_add(x, y R) R = x + y

have fn real_neg(x R) R = -x

have fn real_mul(x, y R) R = x * y

forall x, y, z R:
    real_add(real_add(x, y), z) = real_add(x, real_add(y, z))
    real_mul(real_mul(x, y), z) = real_mul(x, real_mul(y, z))
    real_mul(x, real_add(y, z)) = real_add(real_mul(x, y), real_mul(x, z))

forall x, y R:
    real_add(x, y) = real_add(y, x)
    real_mul(x, y) = real_mul(y, x)

forall x R:
    real_add(0, x) = x
    real_add(x, real_neg(x)) = 0
    real_mul(1, x) = x

forall x R:
    x != 0
    =>:
        real_mul(x, real_inv(x)) = 1

release thm struct_member((0, 1, real_add, real_neg, real_mul, real_inv), &Algebra::field::Field<R>)

have real_field &Algebra::field::Field<R> = (0, 1, real_add, real_neg, real_mul, real_inv)

real_field.zero=0

real_field.one=1

real_field.add=real_add

real_field.neg=real_neg

real_field.mul=real_mul

real_field.inv=real_inv

2!=real_field.zero

release thm Algebra::field::field_linear_equation_unique(R,real_field,2,6)

real_field.mul(2,3)=real_mul(2,3)=6

release thm Algebra::field::field_linear_equation_solution(R,real_field,2,6,3)

real_field.inv(2)=real_inv(2)=1/2

real_field.mul(real_field.inv(2),6)=real_field.mul(1/2,6)=real_mul(1/2,6)=3

release thm Algebra::field::field_affine_equation_unique(R,real_field,2,3,7)

claim:
    ? real_field.add(real_field.mul(2,2),3)=7
    real_field.mul(2,2)=real_mul(2,2)=4
    real_field.add(real_field.mul(2,2),3)=real_field.add(4,3)=real_add(4,3)=7

release thm Algebra::field::field_affine_equation_solution(R,real_field,2,3,7,2)

claim:
    ? real_field.mul(real_field.inv(2),real_field.add(7,real_field.neg(3)))=2
    real_field.inv(2)=real_inv(2)=1/2
    real_field.neg(3)=real_neg(3)=-3
    real_field.add(7,real_field.neg(3))=real_field.add(7,-3)=real_add(7,-3)=4
    real_field.mul(real_field.inv(2),real_field.add(7,real_field.neg(3)))=real_field.mul(1/2,4)=real_mul(1/2,4)=2

real_field.mul(0,1)=real_field.mul(0,2)

1!=2

real_field.add(real_field.mul(0,1),3)=real_field.add(real_field.mul(0,2),3)

real_field.mul(0,1)=0

real_field.mul(0,2)=0

real_field.add(real_field.mul(0,1),3)=3

real_field.add(real_field.mul(0,2),3)=3

release thm Algebra::field::field_linear_equation_solution(R,real_field,2,6,4)
