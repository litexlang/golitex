# Imported mathematical contracts, including inverse for arbitrary sets.

claim:
    ? forall V,W nonempty_set,T fn(v V) W:
        fn_range(T) $in power_set(W)
    by thm Algebra::linear_dimension::function_range_carrier(V,W,T) => fn_range(T) $in power_set(W)

claim:
    ? forall V,W nonempty_set,T fn(v V) W:
        $is_nonempty_set(fn_range(T))
    by thm Algebra::linear_dimension::function_range_is_nonempty(V,W,T) => $is_nonempty_set(fn_range(T))

forall V,W nonempty_set,T fn(v V) W,y W:
    preimage(T,y) $in power_set(V)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $is_nonempty_set(preimage(T,target.zero))
    by thm Algebra::linear_dimension::linear_kernel_is_nonempty(K,field,V,source,W,target,T) => $is_nonempty_set(preimage(T,target.zero))

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::vector_space::is_subspace(K,field,V,source,preimage(T,target.zero))
    by thm Algebra::vector_space::kernel_is_subspace(K,field,V,source,W,target,T) => $Algebra::vector_space::is_subspace(K,field,V,source,preimage(T,target.zero))

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::vector_space::is_subspace(K,field,W,target,fn_range(T))
    by thm Algebra::vector_space::range_is_subspace(K,field,V,source,W,target,T) => $Algebra::vector_space::is_subspace(K,field,W,target,fn_range(T))

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)> $in &Algebra::vector_space::VectorSpace<K,field,preimage(T,target.zero)>
    by thm Algebra::linear_dimension::linear_kernel_space_carrier(K,field,V,source,W,target,T) => \Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)> $in &Algebra::vector_space::VectorSpace<K,field,preimage(T,target.zero)>

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)> $in &Algebra::vector_space::VectorSpace<K,field,fn_range(T)>
    by thm Algebra::linear_dimension::linear_image_space_carrier(K,field,V,source,W,target,T) => \Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)> $in &Algebra::vector_space::VectorSpace<K,field,fn_range(T)>

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
    by thm Algebra::linear_dimension::finite_source_has_finite_image(K,field,V,source,W,target,T) => $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
    by thm Algebra::linear_dimension::finite_source_has_finite_kernel(K,field,V,source,W,target,T) => $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in N
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in R
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in C
    release thm Algebra::linear_dimension::finite_source_rank_carrier(K,field,V,source,W,target,T)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T) $in N
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T) $in R
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T) $in C
    release thm Algebra::linear_dimension::finite_source_nullity_carrier(K,field,V,source,W,target,T)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
    by thm Algebra::linear_dimension::finite_target_has_finite_image(K,field,V,source,W,target,T) => $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,U power_set(V):
        $Algebra::vector_space::is_subspace(K,field,V,space,U)
        =>:
            $is_nonempty_set(U)
    by thm Algebra::subspace::subspace_is_nonempty(K,field,V,space,U) => $is_nonempty_set(U)

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,U power_set(V):
        $Algebra::vector_space::is_subspace(K,field,V,space,U)
        =>:
            \Algebra::subspace::restricted_space<K,field,V,space,U> $in &Algebra::vector_space::VectorSpace<K,field,U>
    by thm Algebra::subspace::restricted_space_is_vector_space(K,field,V,space,U) => \Algebra::subspace::restricted_space<K,field,V,space,U> $in &Algebra::vector_space::VectorSpace<K,field,U>

thm consume_empty_span_is_zero:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,vectors finite_seq(V,0):
        \Algebra::finite_span::span<K,field,V,space,0,vectors> ={space.zero}
    by thm Algebra::linear_criteria::empty_span_is_zero(K,field,V,space,vectors) => \Algebra::finite_span::span<K,field,V,space,0,vectors> ={space.zero}

thm consume_zero_dimension_is_zero_space:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>:
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        \Algebra::dimension::finite_dimension<K,field,V>(space)=0
        =>:
            V={space.zero}
    by thm Algebra::linear_criteria::zero_dimension_is_zero_space(K,field,V,space) => V={space.zero}

thm consume_zero_space_has_zero_dimension:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>:
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        V={space.zero}
        =>:
            \Algebra::dimension::finite_dimension<K,field,V>(space)=0
    by thm Algebra::linear_criteria::zero_space_has_zero_dimension(K,field,V,space) => \Algebra::dimension::finite_dimension<K,field,V>(space)=0

thm consume_equal_dimension_subspace_is_ambient:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,U power_set(V):
        $Algebra::vector_space::is_subspace(K,field,V,space,U)
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::basis::is_finite_dimensional(K,field,U,\Algebra::subspace::restricted_space<K,field,V,space,U>)
        \Algebra::dimension::finite_dimension<K,field,U>(\Algebra::subspace::restricted_space<K,field,V,space,U>)=\Algebra::dimension::finite_dimension<K,field,V>(space)
        =>:
            U=V
    by thm Algebra::linear_criteria::equal_dimension_subspace_is_ambient(K,field,V,space,U) => U=V

thm consume_whole_subspace_dimension_equals_ambient:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,U power_set(V):
        $Algebra::vector_space::is_subspace(K,field,V,space,U)
        $Algebra::basis::is_finite_dimensional(K,field,V,space)
        $Algebra::basis::is_finite_dimensional(K,field,U,\Algebra::subspace::restricted_space<K,field,V,space,U>)
        U=V
        =>:
            \Algebra::dimension::finite_dimension<K,field,U>(\Algebra::subspace::restricted_space<K,field,V,space,U>)=\Algebra::dimension::finite_dimension<K,field,V>(space)
    by thm Algebra::linear_criteria::whole_subspace_dimension_equals_ambient(K,field,V,space,U) => \Algebra::dimension::finite_dimension<K,field,U>(\Algebra::subspace::restricted_space<K,field,V,space,U>)=\Algebra::dimension::finite_dimension<K,field,V>(space)

thm consume_inverse_bijection_right_identity:
    ? forall V,W set,T fn(v V) W,y W:
        $bijective(V,W,T)
        =>:
            T(\Algebra::linear_criteria::inverse_bijection<V,W,T>(y))=y
    by thm Algebra::linear_criteria::inverse_bijection_right_identity(V,W,T,y) => T(\Algebra::linear_criteria::inverse_bijection<V,W,T>(y))=y

thm consume_inverse_bijection_left_identity:
    ? forall V,W set,T fn(v V) W,x V:
        $bijective(V,W,T)
        =>:
            \Algebra::linear_criteria::inverse_bijection<V,W,T>(T(x))=x
    by thm Algebra::linear_criteria::inverse_bijection_left_identity(V,W,T,x) => \Algebra::linear_criteria::inverse_bijection<V,W,T>(T(x))=x

thm consume_inverse_bijection_is_bijective:
    ? forall V,W set,T fn(v V) W:
        $bijective(V,W,T)
        =>:
            $bijective(W,V,\Algebra::linear_criteria::inverse_bijection<V,W,T>)
    by thm Algebra::linear_criteria::inverse_bijection_is_bijective(V,W,T) => $bijective(W,V,\Algebra::linear_criteria::inverse_bijection<V,W,T>)

thm consume_inverse_bijection_is_linear:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $bijective(V,W,T)
        =>:
            $Algebra::vector_space::is_linear_map(K,field,W,target,V,source,\Algebra::linear_criteria::inverse_bijection<V,W,T>)
    by thm Algebra::linear_criteria::inverse_bijection_is_linear(K,field,V,source,W,target,T) => $Algebra::vector_space::is_linear_map(K,field,W,target,V,source,\Algebra::linear_criteria::inverse_bijection<V,W,T>)

thm consume_zero_nullity_is_injective:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
        \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)=0
        =>:
            $injective(V,W,T)
    by thm Algebra::linear_criteria::zero_nullity_is_injective(K,field,V,source,W,target,T) => $injective(V,W,T)

thm consume_injective_has_zero_nullity:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
        $injective(V,W,T)
        =>:
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)=0
    by thm Algebra::linear_criteria::injective_has_zero_nullity(K,field,V,source,W,target,T) => \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)=0

thm consume_full_source_rank_is_injective:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,V>(source)
        =>:
            $injective(V,W,T)
    by thm Algebra::linear_criteria::full_source_rank_is_injective(K,field,V,source,W,target,T) => $injective(V,W,T)

thm consume_injective_has_full_source_rank:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $injective(V,W,T)
        =>:
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,V>(source)
    by thm Algebra::linear_criteria::injective_has_full_source_rank(K,field,V,source,W,target,T) => \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,V>(source)

thm consume_surjective_has_full_range:
    ? forall V,W set,T fn(v V) W:
        $surjective(V,W,T)
        =>:
            fn_range(T)=W
    by thm Algebra::linear_criteria::surjective_has_full_range(V,W,T) => fn_range(T)=W

thm consume_full_range_is_surjective:
    ? forall V,W set,T fn(v V) W:
        fn_range(T)=W
        =>:
            $surjective(V,W,T)
    by thm Algebra::linear_criteria::full_range_is_surjective(V,W,T) => $surjective(V,W,T)

thm consume_surjective_has_full_target_rank:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $surjective(V,W,T)
        =>:
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,W>(target)
    by thm Algebra::linear_criteria::surjective_has_full_target_rank(K,field,V,source,W,target,T) => \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,W>(target)

thm consume_full_target_rank_is_surjective:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,W>(target)
        =>:
            $surjective(V,W,T)
    by thm Algebra::linear_criteria::full_target_rank_is_surjective(K,field,V,source,W,target,T) => $surjective(V,W,T)

thm consume_injective_dimension_bound:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $injective(V,W,T)
        =>:
            \Algebra::dimension::finite_dimension<K,field,V>(source)<=\Algebra::dimension::finite_dimension<K,field,W>(target)
    by thm Algebra::linear_criteria::injective_dimension_bound(K,field,V,source,W,target,T) => \Algebra::dimension::finite_dimension<K,field,V>(source)<=\Algebra::dimension::finite_dimension<K,field,W>(target)

thm consume_surjective_dimension_bound:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $surjective(V,W,T)
        =>:
            \Algebra::dimension::finite_dimension<K,field,W>(target)<=\Algebra::dimension::finite_dimension<K,field,V>(source)
    by thm Algebra::linear_criteria::surjective_dimension_bound(K,field,V,source,W,target,T) => \Algebra::dimension::finite_dimension<K,field,W>(target)<=\Algebra::dimension::finite_dimension<K,field,V>(source)

thm consume_equal_dimension_injective_is_bijective:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        \Algebra::dimension::finite_dimension<K,field,V>(source)=\Algebra::dimension::finite_dimension<K,field,W>(target)
        $injective(V,W,T)
        =>:
            $bijective(V,W,T)
    by thm Algebra::linear_criteria::equal_dimension_injective_is_bijective(K,field,V,source,W,target,T) => $bijective(V,W,T)

thm consume_equal_dimension_surjective_is_bijective:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        \Algebra::dimension::finite_dimension<K,field,V>(source)=\Algebra::dimension::finite_dimension<K,field,W>(target)
        $surjective(V,W,T)
        =>:
            $bijective(V,W,T)
    by thm Algebra::linear_criteria::equal_dimension_surjective_is_bijective(K,field,V,source,W,target,T) => $bijective(V,W,T)

thm consume_bijective_preserves_dimension:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $bijective(V,W,T)
        =>:
            \Algebra::dimension::finite_dimension<K,field,V>(source)=\Algebra::dimension::finite_dimension<K,field,W>(target)
    by thm Algebra::linear_criteria::bijective_preserves_dimension(K,field,V,source,W,target,T) => \Algebra::dimension::finite_dimension<K,field,V>(source)=\Algebra::dimension::finite_dimension<K,field,W>(target)

forall V,W set,T fn(v V) W:
    $bijective(V,W,T)
    =>:
        \Algebra::linear_criteria::inverse_bijection<V,W,T> $in fn(y W) V
