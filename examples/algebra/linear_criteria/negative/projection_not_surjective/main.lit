claim:
    ? fn_range(context::projection)=context::axis
    claim:
        ? forall y fn_range(context::projection):
            y $in context::axis
        have by fn_preimage: x from y $in fn_range(context::projection)
        y $in R × R
        y=context::projection(x)=(x(1),0)
        y(2)=0
    claim:
        ? forall y context::axis:
            y $in fn_range(context::projection)
        y $in R × R
        y(2)=0
        context::projection(y)=(y(1),0)=(y(1),y(2))=y
        context::projection(y) $in fn_range(context::projection)
    by extension fn_range(context::projection)=context::axis

claim:
    ? forall j closed_range(1,1):
        context::axis_basis(j) $in fn_range(context::projection)
    j=1
    context::axis_basis(j)=context::axis_basis(1)=model::e1
    context::projection(model::e1) $in fn_range(context::projection)

release thm fn_set_member(context::axis_basis,finite_seq(fn_range(context::projection),1))

