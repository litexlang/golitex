# A real-plane coordinate exchange: bijectivity, inverse and dimension criteria.

release obj def model::real_inv

release obj def model::real_add

release obj def model::real_neg

release obj def model::real_mul

release obj def model::plane_add

release obj def model::plane_smul

release obj def model::e1

release obj def model::e2

release obj def model::real_field

release obj def model::real_plane

release obj def model::standard_basis

release struct def model::real_field

release struct def model::real_plane

release thm model::standard_plane_basis()

by thm Algebra::basis::basis_is_finite_dimensional(R,model::real_field,R × R,model::real_plane,2,model::standard_basis) => $Algebra::basis::is_finite_dimensional(R,model::real_field,R × R,model::real_plane)

by thm Algebra::dimension::finite_dimension_of_basis(R,model::real_field,R × R,model::real_plane,2,model::standard_basis) => \Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)=2

have fn swap(v R × R) R × R=(v(2),v(1))

claim:
    ? forall u,v R × R:
        swap(model::real_plane.add(u,v))=model::real_plane.add(swap(u),swap(v))
    model::real_plane.add=model::plane_add
    swap(u)(1)=(u(2),u(1))(1)=u(2)
    swap(u)(2)=(u(2),u(1))(2)=u(1)
    swap(v)(1)=(v(2),v(1))(1)=v(2)
    swap(v)(2)=(v(2),v(1))(2)=v(1)
    swap(model::real_plane.add(u,v))=(model::plane_add(u,v)(2),model::plane_add(u,v)(1))=(u(2)+v(2),u(1)+v(1))
    model::real_plane.add(swap(u),swap(v))=model::plane_add(swap(u),swap(v))=(swap(u)(1)+swap(v)(1),swap(u)(2)+swap(v)(2))=(u(2)+v(2),u(1)+v(1))

claim:
    ? forall a R,v R × R:
        swap(model::real_plane.smul(a,v))=model::real_plane.smul(a,swap(v))
    model::real_plane.smul=model::plane_smul
    swap(v)(1)=(v(2),v(1))(1)=v(2)
    swap(v)(2)=(v(2),v(1))(2)=v(1)
    swap(model::real_plane.smul(a,v))=(model::plane_smul(a,v)(2),model::plane_smul(a,v)(1))=(a*v(2),a*v(1))
    model::real_plane.smul(a,swap(v))=model::plane_smul(a,swap(v))=(a*swap(v)(1),a*swap(v)(2))=(a*v(2),a*v(1))

by def $Algebra::vector_space::is_linear_map(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap)

claim:
    ? forall u,v R × R:
        swap(u)=swap(v)
        =>:
            u=v
    swap(u)=(u(2),u(1))
    swap(v)=(v(2),v(1))
    (u(2),u(1))=(v(2),v(1))
    u(1)=swap(u)(2)=swap(v)(2)=v(1)
    u(2)=swap(u)(1)=swap(v)(1)=v(2)
    u=(u(1),u(2))=(v(1),v(2))=v

by def $injective(R × R,R × R,swap)

by thm Algebra::linear_criteria::equal_dimension_injective_is_bijective(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $bijective(R × R,R × R,swap)

by thm Algebra::linear_criteria::inverse_bijection_is_linear(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $Algebra::vector_space::is_linear_map(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,\Algebra::linear_criteria::inverse_bijection<R × R,R × R,swap>)

by thm Algebra::linear_criteria::inverse_bijection_is_bijective(R × R,R × R,swap) => $bijective(R × R,R × R,\Algebra::linear_criteria::inverse_bijection<R × R,R × R,swap>)

by thm Algebra::linear_criteria::inverse_bijection_right_identity(R × R,R × R,swap,(3,4)) => swap(\Algebra::linear_criteria::inverse_bijection<R × R,R × R,swap>((3,4)))=(3,4)

swap((4,3))=(3,4)

\Algebra::linear_criteria::inverse_bijection<R × R,R × R,swap>((3,4))=(4,3)

by thm Algebra::linear_criteria::inverse_bijection_left_identity(R × R,R × R,swap,(4,3)) => \Algebra::linear_criteria::inverse_bijection<R × R,R × R,swap>(swap((4,3)))=(4,3)

by thm Algebra::linear_criteria::bijective_preserves_dimension(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

by thm Algebra::linear_dimension::function_range_carrier(R × R,R × R,swap) => fn_range(swap) $in power_set(R × R)

by thm Algebra::linear_dimension::function_range_is_nonempty(R × R,R × R,swap) => $is_nonempty_set(fn_range(swap))

by thm Algebra::vector_space::range_is_subspace(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,fn_range(swap))

by thm Algebra::linear_dimension::linear_image_space_carrier(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,fn_range(swap)> $in &Algebra::vector_space::VectorSpace<R,model::real_field,fn_range(swap)>

by thm Algebra::linear_dimension::finite_source_has_finite_image(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $Algebra::basis::is_finite_dimensional(R,model::real_field,fn_range(swap),\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,fn_range(swap)>)

by thm Algebra::vector_space::kernel_is_subspace(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $Algebra::vector_space::is_subspace(R,model::real_field,R × R,model::real_plane,preimage(swap,model::real_plane.zero))

by thm Algebra::linear_dimension::linear_kernel_is_nonempty(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $is_nonempty_set(preimage(swap,model::real_plane.zero))

by thm Algebra::linear_dimension::linear_kernel_space_carrier(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,preimage(swap,model::real_plane.zero)> $in &Algebra::vector_space::VectorSpace<R,model::real_field,preimage(swap,model::real_plane.zero)>

by thm Algebra::linear_dimension::finite_source_has_finite_kernel(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $Algebra::basis::is_finite_dimensional(R,model::real_field,preimage(swap,model::real_plane.zero),\Algebra::subspace::restricted_space<R,model::real_field,R × R,model::real_plane,preimage(swap,model::real_plane.zero)>)

by thm Algebra::linear_criteria::injective_has_zero_nullity(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::linear_dimension::linear_map_nullity<R,model::real_field,R × R,model::real_plane,R × R,model::real_plane>(swap)=0

by thm Algebra::linear_criteria::injective_has_full_source_rank(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::linear_dimension::linear_map_rank<R,model::real_field,R × R,model::real_plane,R × R,model::real_plane>(swap)=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

\Algebra::linear_dimension::linear_map_rank<R,model::real_field,R × R,model::real_plane,R × R,model::real_plane>(swap)=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)=2

by thm Algebra::linear_criteria::full_source_rank_is_injective(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $injective(R × R,R × R,swap)

by thm Algebra::linear_criteria::zero_nullity_is_injective(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $injective(R × R,R × R,swap)

by thm Algebra::linear_criteria::surjective_has_full_target_rank(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::linear_dimension::linear_map_rank<R,model::real_field,R × R,model::real_plane,R × R,model::real_plane>(swap)=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

by thm Algebra::linear_criteria::full_target_rank_is_surjective(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $surjective(R × R,R × R,swap)

by thm Algebra::linear_criteria::equal_dimension_surjective_is_bijective(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => $bijective(R × R,R × R,swap)

by thm Algebra::linear_criteria::injective_dimension_bound(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)<=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

by thm Algebra::linear_criteria::surjective_dimension_bound(R,model::real_field,R × R,model::real_plane,R × R,model::real_plane,swap) => \Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)<=\Algebra::dimension::finite_dimension<R,model::real_field,R × R>(model::real_plane)

\Algebra::linear_criteria::inverse_bijection<R × R,R × R,swap>((3,4))=(3,4)
