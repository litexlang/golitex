thm equal_dimension_without_equal_sets:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,U,W power_set(V):
        $Algebra::vector_space::is_subspace(K,field,V,space,U)
        $Algebra::vector_space::is_subspace(K,field,V,space,W)
        $Algebra::basis::is_finite_dimensional(K,field,U,\Algebra::subspace::restricted_space<K,field,V,space,U>)
        $Algebra::basis::is_finite_dimensional(K,field,W,\Algebra::subspace::restricted_space<K,field,V,space,W>)
        =>:
            \Algebra::dimension::finite_dimension<K,field,U>(\Algebra::subspace::restricted_space<K,field,V,space,U>)=\Algebra::dimension::finite_dimension<K,field,W>(\Algebra::subspace::restricted_space<K,field,V,space,W>)
    by thm Algebra::direct_sum::equal_subspaces_have_equal_dimension(K,field,V,space,U,W) => \Algebra::dimension::finite_dimension<K,field,U>(\Algebra::subspace::restricted_space<K,field,V,space,U>)=\Algebra::dimension::finite_dimension<K,field,W>(\Algebra::subspace::restricted_space<K,field,V,space,W>)
