# Imported contracts for every new named theorem and source value.

claim:
    ? forall m,n N,j closed_range(1,m+n):
        j>m
        =>:
            j-m $in closed_range(1,n)
    j $in Z
    j-m $in Z
    j-m>0
    j-m>=1
    j<=m+n
    j-m<=(m+n)-m=n
    j-m $in closed_range(1,n)

claim:
    ? forall m,n N,j closed_range(1,n):
        m+j $in closed_range(1,m+n)
    1<=j<=n
    m+j $in Z
    1<=m+j<=m+n
    m+j $in closed_range(1,m+n)

thm consume_concatenate_lists_carrier:
    ? forall S nonempty_set,m,n N,left finite_seq(S,m),right finite_seq(S,n):
        \Algebra::finite_decomposition::concatenate_lists<S,m,n,left,right> $in finite_seq(S,m+n)
    by thm Algebra::finite_decomposition::concatenate_lists_carrier(S,m,n,left,right) => \Algebra::finite_decomposition::concatenate_lists<S,m,n,left,right> $in finite_seq(S,m+n)

thm consume_prefix_has_concatenation_decomposition:
    ? forall S nonempty_set,m,n N,full finite_seq(S,m+n),prefix finite_seq(S,m):
        $Algebra::basis::is_prefix_of_length(S,m+n,m,full,prefix)
        =>:
            exist tail finite_seq(S,n) st {full=\Algebra::finite_decomposition::concatenate_lists<S,m,n,prefix,tail>}
    release thm Algebra::finite_decomposition::prefix_has_concatenation_decomposition(S,m,n,full,prefix)

thm consume_list_splits_at_length:
    ? forall S nonempty_set,m,n N,full finite_seq(S,m+n):
        exist left finite_seq(S,m),right finite_seq(S,n) st {full=\Algebra::finite_decomposition::concatenate_lists<S,m,n,left,right>}
    release thm Algebra::finite_decomposition::list_splits_at_length(S,m,n,full)

thm consume_concatenated_linear_combination:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,m,n N,left_coefficients finite_seq(K,m),right_coefficients finite_seq(K,n),left finite_seq(V,m),right finite_seq(V,n):
        \Algebra::finite_span::linear_combination<K,field,V,space,m+n>(\Algebra::finite_decomposition::concatenate_lists<K,m,n,left_coefficients,right_coefficients>,\Algebra::finite_decomposition::concatenate_lists<V,m,n,left,right>)=space.add(\Algebra::finite_span::linear_combination<K,field,V,space,m>(left_coefficients,left),\Algebra::finite_span::linear_combination<K,field,V,space,n>(right_coefficients,right))
    by thm Algebra::finite_decomposition::concatenated_linear_combination(K,field,V,space,m,n,left_coefficients,right_coefficients,left,right) => \Algebra::finite_span::linear_combination<K,field,V,space,m+n>(\Algebra::finite_decomposition::concatenate_lists<K,m,n,left_coefficients,right_coefficients>,\Algebra::finite_decomposition::concatenate_lists<V,m,n,left,right>)=space.add(\Algebra::finite_span::linear_combination<K,field,V,space,m>(left_coefficients,left),\Algebra::finite_span::linear_combination<K,field,V,space,n>(right_coefficients,right))

thm consume_function_range_carrier:
    ? forall V,W nonempty_set,T fn(v V) W:
        fn_range(T) $in power_set(W)
    by thm Algebra::linear_dimension::function_range_carrier(V,W,T) => fn_range(T) $in power_set(W)

thm consume_function_range_is_nonempty:
    ? forall V,W nonempty_set,T fn(v V) W:
        $is_nonempty_set(fn_range(T))
    by thm Algebra::linear_dimension::function_range_is_nonempty(V,W,T) => $is_nonempty_set(fn_range(T))

forall V,W nonempty_set,T fn(v V) W,y W:
    preimage(T,y) $in power_set(V)

thm consume_linear_kernel_is_nonempty:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $is_nonempty_set(preimage(T,target.zero))
    by thm Algebra::linear_dimension::linear_kernel_is_nonempty(K,field,V,source,W,target,T) => $is_nonempty_set(preimage(T,target.zero))

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::vector_space::is_subspace(K,field,V,source,preimage(T,target.zero))
    by thm Algebra::vector_space::kernel_is_subspace(K,field,V,source,W,target,T) => $Algebra::vector_space::is_subspace(K,field,V,source,preimage(T,target.zero))

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::vector_space::is_subspace(K,field,W,target,fn_range(T))
    by thm Algebra::vector_space::range_is_subspace(K,field,V,source,W,target,T) => $Algebra::vector_space::is_subspace(K,field,W,target,fn_range(T))

thm consume_linear_kernel_space_carrier:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)> $in &Algebra::vector_space::VectorSpace<K,field,preimage(T,target.zero)>
    by thm Algebra::linear_dimension::linear_kernel_space_carrier(K,field,V,source,W,target,T) => \Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)> $in &Algebra::vector_space::VectorSpace<K,field,preimage(T,target.zero)>

thm consume_linear_image_space_carrier:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)> $in &Algebra::vector_space::VectorSpace<K,field,fn_range(T)>
    by thm Algebra::linear_dimension::linear_image_space_carrier(K,field,V,source,W,target,T) => \Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)> $in &Algebra::vector_space::VectorSpace<K,field,fn_range(T)>

thm consume_mapped_list_in_range:
    ? forall V,W nonempty_set,T fn(v V) W,n N,vectors finite_seq(V,n):
        \Algebra::finite_span::map_vectors<V,W,n>(T,vectors) $in finite_seq(fn_range(T),n)
    by thm Algebra::linear_dimension::mapped_list_in_range(V,W,T,n,vectors) => \Algebra::finite_span::map_vectors<V,W,n>(T,vectors) $in finite_seq(fn_range(T),n)

thm consume_spanning_list_maps_onto_image:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W,n N,vectors finite_seq(V,n):
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::finite_span::spans(K,field,V,source,n,vectors)
        =>:
            $Algebra::finite_span::spans(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>,n,\Algebra::finite_span::map_vectors<V,W,n>(T,vectors))
    by thm Algebra::linear_dimension::spanning_list_maps_onto_image(K,field,V,source,W,target,T,n,vectors) => $Algebra::finite_span::spans(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>,n,\Algebra::finite_span::map_vectors<V,W,n>(T,vectors))

thm consume_finite_source_has_finite_image:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
    by thm Algebra::linear_dimension::finite_source_has_finite_image(K,field,V,source,W,target,T) => $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)

thm consume_finite_source_has_finite_kernel:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
    by thm Algebra::linear_dimension::finite_source_has_finite_kernel(K,field,V,source,W,target,T) => $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)

thm consume_kernel_prefix_tail_spans_image:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W,m,n N,prefix finite_seq(V,m),tail finite_seq(V,n):
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::finite_span::spans(K,field,V,source,m+n,\Algebra::finite_decomposition::concatenate_lists<V,m,n,prefix,tail>)
        forall j N+:
            j<=m
            =>:
                T(prefix(j))=target.zero
        =>:
            $Algebra::finite_span::spans(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>,n,\Algebra::finite_span::map_vectors<V,W,n>(T,tail))
    release thm Algebra::linear_dimension::kernel_prefix_tail_spans_image(K,field,V,source,W,target,T,m,n,prefix,tail)

thm consume_kernel_in_prefix_span_makes_tail_image_independent:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W,m,n N,prefix finite_seq(V,m),tail finite_seq(V,n):
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::basis::is_linearly_independent(K,field,V,source,m+n,\Algebra::finite_decomposition::concatenate_lists<V,m,n,prefix,tail>)
        preimage(T,target.zero) $subset \Algebra::finite_span::span<K,field,V,source,m,prefix>
        =>:
            $Algebra::basis::is_linearly_independent(K,field,W,target,n,\Algebra::finite_span::map_vectors<V,W,n>(T,tail))
    by thm Algebra::linear_dimension::kernel_in_prefix_span_makes_tail_image_independent(K,field,V,source,W,target,T,m,n,prefix,tail) => $Algebra::basis::is_linearly_independent(K,field,W,target,n,\Algebra::finite_span::map_vectors<V,W,n>(T,tail))

thm consume_finite_source_rank_carrier:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in N
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in R
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in C
    release thm Algebra::linear_dimension::finite_source_rank_carrier(K,field,V,source,W,target,T)

thm consume_finite_source_nullity_carrier:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T) $in N
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T) $in R
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T) $in C
    release thm Algebra::linear_dimension::finite_source_nullity_carrier(K,field,V,source,W,target,T)

thm consume_rank_nullity:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)+\Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,V>(source)
    by thm Algebra::linear_dimension::rank_nullity(K,field,V,source,W,target,T) => \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)+\Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,V>(source)

thm consume_finite_target_has_finite_image:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,W,target)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        =>:
            $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
    by thm Algebra::linear_dimension::finite_target_has_finite_image(K,field,V,source,W,target,T) => $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)

thm consume_rank_le_source_dimension:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
        =>:
            \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)<=\Algebra::dimension::finite_dimension<K,field,V>(source)
    by thm Algebra::linear_dimension::rank_le_source_dimension(K,field,V,source,W,target,T) => \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)<=\Algebra::dimension::finite_dimension<K,field,V>(source)

thm consume_nullity_le_source_dimension:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
        $Algebra::basis::is_finite_dimensional(K,field,V,source)
        $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
        $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
        =>:
            \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)<=\Algebra::dimension::finite_dimension<K,field,V>(source)
    by thm Algebra::linear_dimension::nullity_le_source_dimension(K,field,V,source,W,target,T) => \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)<=\Algebra::dimension::finite_dimension<K,field,V>(source)

forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
    $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
    $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
    =>:
        \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)+0=\Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)

forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
    $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
    $Algebra::basis::is_finite_dimensional(K,field,fn_range(T),\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)
    =>:
        \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,fn_range(T)>(\Algebra::subspace::restricted_space<K,field,W,target,fn_range(T)>)

forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
    $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
    $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
    =>:
        \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)+0=\Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)

forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
    $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
    $Algebra::basis::is_finite_dimensional(K,field,preimage(T,target.zero),\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)
    =>:
        \Algebra::linear_dimension::linear_map_nullity<K,field,V,source,W,target>(T)=\Algebra::dimension::finite_dimension<K,field,preimage(T,target.zero)>(\Algebra::subspace::restricted_space<K,field,V,source,preimage(T,target.zero)>)

forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,field,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,field,W>,T fn(v V) W:
    $Algebra::vector_space::is_linear_map(K,field,V,source,W,target,T)
    $Algebra::basis::is_finite_dimensional(K,field,W,target)
    =>:
        \Algebra::linear_dimension::linear_map_rank<K,field,V,source,W,target>(T) $in N
