# Expected rejection at the missing mathematical premise.

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,m,n N:
        $Algebra::basis::has_basis_length(K,field,V,space,n)
        =>:
            m=n
    release thm Algebra::basis_comparison::basis_length_unique(K,field,V,space,m,n)
