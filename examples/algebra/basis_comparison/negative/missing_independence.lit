# Expected rejection at the missing mathematical premise.

claim:
    ? forall K nonempty_set,field &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,field,V>,m N,independent finite_seq(V,m),n N,generators finite_seq(V,n):
        forall j N+:
            j<=m
            =>:
                independent(j) $in \Algebra::finite_span::span<K,field,V,space,n,generators>
        =>:
            m<=n
    release thm Algebra::basis_comparison::independent_list_in_span_length_bound(K,field,V,space,m,independent,n,generators)
