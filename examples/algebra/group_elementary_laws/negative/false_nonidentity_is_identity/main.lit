release thm model::two_field_is_field

release thm model::two_field_zero

release thm model::two_field_one

release thm model::two_field_one_plus_one_zero

release struct def model::two_field

{0,1}!={}

model::two_field.add $in fn(x,y {0,1}) {0,1}

model::two_field.neg $in fn(x {0,1}) {0,1}

model::two_field.zero $in {0,1}

forall x,y,z {0,1}:
    model::two_field.add(model::two_field.add(x,y),z)=model::two_field.add(x,model::two_field.add(y,z))

claim:
    ? forall x {0,1}:
        model::two_field.add(model::two_field.zero,x)=x
        model::two_field.add(x,model::two_field.zero)=x
        model::two_field.add(model::two_field.neg(x),x)=model::two_field.zero
        model::two_field.add(x,model::two_field.neg(x))=model::two_field.zero
    release thm Algebra::field::add_right_zero({0,1},model::two_field,x)
    release thm Algebra::field::add_left_inverse({0,1},model::two_field,x)

release thm struct_member((model::two_field.add,model::two_field.zero,model::two_field.neg),&Algebra::group::Group<{0,1}>)

have two_group &Algebra::group::Group<{0,1}> = (model::two_field.add,model::two_field.zero,model::two_field.neg)

two_group.one = model::two_field.zero = 0

two_group.mul = model::two_field.add

1!=two_group.one

two_group.mul(1,1)=model::two_field.add(1,1)=model::two_field.zero=two_group.one

release thm Algebra::group::square_identity_implies_self_inverse({0,1},two_group,1)

two_group.inv(1)=1

release thm Algebra::group::self_inverse_implies_square_identity({0,1},two_group,1)

two_group.mul(0,0)=0

release thm Algebra::group::idempotent_is_identity({0,1},two_group,0)

1=two_group.one
