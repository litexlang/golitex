# Node: tokenize.line_continuation
# Status: acceptance
# Run: litex -f examples/tokenize/line_continuation.lit
#
# Trailing \\ joins the next physical line. Indent on the continued line is
# ordinary whitespace. A `#` comment after \\ is allowed. Mid-line \\ is not
# continuation. Distinct from \template.

1 + 1 \\
  = 2

have a R = 1
have b R = 1
have c R = 1

a = b \\  # note on this break
   = c
