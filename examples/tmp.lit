# Native complex scalar smoke test.

i $in C
1 $in C
1.1 $in C
i * i = -1
i ^ 2 = -1
i ^ 4 = 1
i ^ (-1) = -i
re(i) = 0
img(i) = 1
C_abs(i) = 1

forall r R:
    r $in C
    re(r) = r
    img(r) = 0
    C_abs(r) = abs(r)

forall a, b R:
    re(a + b * i) = a
    img(a + b * i) = b

forall z, w C:
    re(z + w) = re(z) + re(w)
    img(z + w) = img(z) + img(w)
    re(z - w) = re(z) - re(w)
    img(z - w) = img(z) - img(w)
    re(z * w) = re(z) * re(w) - img(z) * img(w)
    img(z * w) = re(z) * img(w) + img(z) * re(w)

forall z, w C:
    z = w
    =>:
        re(z) = re(w)
        img(z) = img(w)

forall z C:
    z = re(z) + img(z) * i
    C_abs(z) = sqrt(re(z) ^ 2 + img(z) ^ 2)
    C_abs(z) >= 0

forall z, w C:
    re(z) = re(w)
    img(z) = img(w)
    =>:
        z = w

forall z, w C:
    re(z + i) = re(w + i)
    img(z + i) = img(w + i)
    =>:
        z + i = w + i

forall z C:
    z = 0
    =>:
        C_abs(z) = 0

forall z C:
    C_abs(z) = 0
    =>:
        z = 0

forall z, w C:
    z + w $in C
    z - w $in C
    z * w $in C
    w != 0
    =>:
        z / w $in C

forall z C, n N:
    z ^ n $in C

forall z C, k Z:
    z != 0
    =>:
        z ^ k $in C

forall z C, m, n N:
    z ^ (m + n) = z ^ m * z ^ n
    (z ^ m) ^ n = z ^ (m * n)

forall z C, m, n Z:
    z != 0
    =>:
        z ^ (m + n) = z ^ m * z ^ n

forall z, w C, n N:
    (z * w) ^ n = z ^ n * w ^ n

sum(1, 2, fn(k Z) C {k + i}) $in C
product(1, 2, fn(k Z) C {k + i}) $in C
finite_set_sum({1, 2}, fn(k Z) C {k + i}) $in C
finite_set_product({1, 2}, fn(k Z) C {k + i}) $in C

finite_set_sum({}, fn(k Z) C {k + i}) = 0
finite_set_product({}, fn(k Z) C {k + i}) = 1

have S finite_set
finite_set_sum(S, fn(k S) C {i}) $in C
finite_set_product(S, fn(k S) C {i}) $in C

# Narrow codomains remain narrow.
sum(1, 2, fn(k Z) Z {k}) $in Z
sum(1, 2, fn(k Z) Q {k / 2}) $in Q
sum(1, 2, fn(k Z) R {k / 2}) $in R
sum(1, 2, fn(k N) N {k}) $in N
product(1, 2, fn(k Z) Z {k}) $in Z
product(1, 2, fn(k Z) Q {k / 2}) $in Q
product(1, 2, fn(k Z) R {k / 2}) $in R
product(1, 2, fn(k N) N {k}) $in N
finite_set_sum({1, 2}, fn(k Z) Z {k}) $in Z
finite_set_sum({1, 2}, fn(k Z) Q {k / 2}) $in Q
finite_set_sum({1, 2}, fn(k Z) R {k / 2}) $in R
finite_set_sum({1, 2}, fn(k N) N {k}) $in N
finite_set_product({1, 2}, fn(k Z) Z {k}) $in Z
finite_set_product({1, 2}, fn(k Z) Q {k / 2}) $in Q
finite_set_product({1, 2}, fn(k Z) R {k / 2}) $in R
finite_set_product({1, 2}, fn(k N) N {k}) $in N

# One-step membership through a power-set carrier is checked on demand.
forall B set, A power_set(B), x A:
    x $in B

# finite_set_max/min bounds remain available through a named equality.
have finite_max_left R = 1
have finite_max_right R = 2
have finite_max_value R = finite_set_max({finite_max_left, finite_max_right})
finite_max_value >= finite_max_left
finite_max_value >= finite_max_right

have finite_min_value R = finite_set_min({finite_max_left, finite_max_right})
finite_min_value <= finite_max_left
finite_min_value <= finite_max_right

# Nested prop projection regression. Structure membership gives the outer law
# package; verification should be able to use a universal law from the inner
# package without a trusted wrapper.
prop tmp_inner_norm_laws(A nonempty_set, norm fn(x A) R):
    forall x A:
        norm(x) >= 0

prop tmp_outer_norm_laws(A nonempty_set, norm fn(x A) R):
    $tmp_inner_norm_laws(A, norm)

struct TmpNormed<A nonempty_set>:
    norm fn(x A) R
    marker A
    <=>:
        $tmp_outer_norm_laws(A, norm)

forall A nonempty_set, space &TmpNormed<A>, x A:
    space.norm(x) >= 0

prop tmp_inner_map_laws(A, B nonempty_set, add_A fn(x, y A) A, add_B fn(x, y B) B, f fn(x A) B):
    forall x, y A:
        f(add_A(x, y)) = add_B(f(x), f(y))

prop tmp_outer_map_laws(A, B nonempty_set, add_A fn(x, y A) A, add_B fn(x, y B) B, f fn(x A) B):
    $tmp_inner_map_laws(A, B, add_A, add_B, f)

forall A, B nonempty_set, add_A fn(x, y A) A, add_B fn(x, y B) B, f fn(x A) B, x, y A:
    $tmp_outer_map_laws(A, B, add_A, add_B, f)
    =>:
        f(add_A(x, y)) = add_B(f(x), f(y))

# A conclusion in a grouped universal law is reusable over only the parameters
# it mentions when every omitted domain is independently known nonempty.
abstract_prop tmp_grouped_relation(a, x)

prop tmp_grouped_laws(seed R):
    forall a, b, x, y R:
        $tmp_grouped_relation(a, x)
        $tmp_grouped_relation(b, y)

trust $tmp_grouped_laws(0)
$tmp_grouped_relation(1, 2)

# A known implication can be packaged as its classical disjunction.
abstract_prop tmp_implication_left(x)
abstract_prop tmp_implication_right(x)

trust forall x R:
    $tmp_implication_left(x)
    =>:
        $tmp_implication_right(x)

forall x R:
    not $tmp_implication_left(x) or $tmp_implication_right(x)

# Instantiated template-selected set builders preserve definitional membership
# in both directions and support explicit equivalence folding.
abstract_prop tmp_selected_marked(x)

template<T set>:
    have tmp_selected_set power_set(T) = {x T: $tmp_selected_marked(x)}

prop tmp_eventually_in(T set, F power_set(T), x T):
    x $in F

prop tmp_selected_equivalence(x R):
    not $tmp_selected_marked(x) or $tmp_eventually_in(R, \tmp_selected_set<R>, x)
    not $tmp_eventually_in(R, \tmp_selected_set<R>, x) or $tmp_selected_marked(x)

by def $tmp_selected_equivalence(1)

# A template-selected function may use local existence elimination and an
# explicit witness in its checked proof. Materializing the template must retain
# those proof statements after substituting the template argument.
axiom tmp_self_exists:
    ? forall Carrier nonempty_set, x Carrier:
        exist y Carrier st {y = x}

template<Carrier nonempty_set>:
    have fn tmp_selected_self_with_local_proof by exist!:
        ? forall x Carrier:
            exist! y Carrier st {y = x}
        by thm tmp_self_exists(Carrier, x)
        obtain y from exist candidate Carrier st {candidate = x}
        witness exist candidate Carrier st {candidate = x} from y
        forall y1, y2 Carrier:
            y1 = x
            y2 = x
            =>:
                y1 = y2

forall Carrier nonempty_set, x Carrier:
    \tmp_selected_self_with_local_proof<Carrier>(x) = x

# A template-selected function may also use a local case-defined function in
# its proof. Materialization substitutes the template arguments through the
# local function's domain, cases, and values.
template<Carrier nonempty_set, marker Carrier>:
    have fn tmp_selected_marker_with_local_case by exist!:
        ? forall x Carrier:
            exist! y Carrier st {y = marker}
        have fn local_marker(input Carrier) Carrier by cases:
            case input = marker: marker
            case input != marker: marker
        witness exist y Carrier st {y = marker} from marker
        forall y1, y2 Carrier:
            y1 = marker
            y2 = marker
            =>:
                y1 = y2

forall Carrier nonempty_set, marker, x Carrier:
    \tmp_selected_marker_with_local_case<Carrier, marker>(x) = marker

# A singleton-supported function is selected inside a template from a local
# piecewise function. This is the kernel pattern used by Chapter 10's direct
# sum inclusion.
prop tmp_supports_single(I set, V nonempty_set, zero V, value fn(coordinate I) V, support finite_set):
    forall coordinate I:
        value(coordinate) != zero
        =>:
            coordinate $in support

prop tmp_has_finite_support(I set, V nonempty_set, zero V, value fn(coordinate I) V):
    exist support finite_set st {$tmp_supports_single(I, V, zero, value, support)}

prop tmp_is_single_value(I set, V nonempty_set, zero V, pivot I, v V, value fn(coordinate I) V):
    forall coordinate I:
        coordinate = pivot
        =>:
            value(coordinate) = v
    forall coordinate I:
        coordinate != pivot
        =>:
            value(coordinate) = zero

template<I set, V nonempty_set, zero V>:
    have tmp_finitely_supported power_set(fn(coordinate I) V) = {value fn(coordinate I) V: $tmp_has_finite_support(I, V, zero, value)}

template<I set, V nonempty_set, zero V>:
    have fn tmp_single by exist!:
        ? forall pivot I, v V:
            exist! value \tmp_finitely_supported<I, V, zero> st {$tmp_is_single_value(I, V, zero, pivot, v, value)}
        have fn candidate(coordinate I) V by cases:
            case coordinate = pivot: v
            case coordinate != pivot: zero
        claim:
            ? $tmp_has_finite_support(I, V, zero, candidate)
            claim:
                ? $tmp_supports_single(I, V, zero, candidate, {pivot})
                claim:
                    ? forall coordinate I:
                        candidate(coordinate) != zero
                        =>:
                            coordinate $in {pivot}
                    by cases:
                        ? coordinate $in {pivot}
                        case coordinate = pivot:
                            coordinate $in {pivot}
                        case coordinate != pivot:
                            candidate(coordinate) = zero
                            impossible candidate(coordinate) = zero
                by def $tmp_supports_single(I, V, zero, candidate, {pivot})
            witness exist support finite_set st {$tmp_supports_single(I, V, zero, candidate, support)} from {pivot}
        candidate $in \tmp_finitely_supported<I, V, zero>
        witness exist value \tmp_finitely_supported<I, V, zero> st {$tmp_is_single_value(I, V, zero, pivot, v, value)} from candidate:
            forall coordinate I:
                coordinate = pivot
                =>:
                    candidate(coordinate) = v
            forall coordinate I:
                coordinate != pivot
                =>:
                    candidate(coordinate) = zero
            by def $tmp_is_single_value(I, V, zero, pivot, v, candidate)
        claim:
            ? forall value1, value2 \tmp_finitely_supported<I, V, zero>:
                $tmp_is_single_value(I, V, zero, pivot, v, value1)
                $tmp_is_single_value(I, V, zero, pivot, v, value2)
                =>:
                    value1 = value2
            claim:
                ? forall coordinate I:
                    value1(coordinate) = value2(coordinate)
                by cases:
                    ? value1(coordinate) = value2(coordinate)
                    case coordinate = pivot:
                        value1(coordinate) = v = value2(coordinate)
                    case coordinate != pivot:
                        value1(coordinate) = zero = value2(coordinate)
            $fn_eq(value1, value2)
            value1 = value2

forall I set, V nonempty_set, zero, v V, pivot, coordinate I:
    coordinate = pivot
    =>:
        $tmp_is_single_value(I, V, zero, pivot, v, \tmp_single<I, V, zero>(pivot, v))
        \tmp_single<I, V, zero>(pivot, v)(coordinate) = v

# Template-instantiated recursive functions must expose their computation
# equations at the public template application.
template<T nonempty_set, combine fn(left, right T) T, identity T>:
    have fn tmp_recursive_fold(values fn(index N) T, count N) T by induc count from 0:
        case count = 0: identity
        case count > 0: combine(tmp_recursive_fold(values, count - 1), values(count - 1))

forall T nonempty_set, combine fn(left, right T) T, identity T, values fn(index N) T:
    \tmp_recursive_fold<T, combine, identity>(values, 0) = identity

forall T nonempty_set, combine fn(left, right T) T, identity T, values fn(index N) T, count N:
    \tmp_recursive_fold<T, combine, identity>(values, count + 1) = combine(\tmp_recursive_fold<T, combine, identity>(values, (count + 1) - 1), values((count + 1) - 1)) = combine(\tmp_recursive_fold<T, combine, identity>(values, count), values(count))

# Template-instantiated case functions expose the selected branch equation
# through the public template application.
template<T nonempty_set, marker, fallback T>:
    have fn tmp_choose_marker(value T) T by cases:
        case value = marker: marker
        case value != marker: fallback

forall T nonempty_set, marker, fallback, value T:
    value = marker
    =>:
        \tmp_choose_marker<T, marker, fallback>(value) = marker

forall T nonempty_set, marker, fallback, value T:
    value != marker
    =>:
        \tmp_choose_marker<T, marker, fallback>(value) = fallback

template<T nonempty_set, combine fn(left, right T) T, marker T>:
    have fn tmp_combine_with_marker(value T) T = combine(value, marker)

forall T nonempty_set, combine fn(left, right T) T, marker, value T:
    \tmp_combine_with_marker<T, combine, marker>(value) = combine(value, marker)
