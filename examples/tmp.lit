# Probe: empty finite_set_reduce with explicit unordered-fold laws (non-numeric carrier shape).
# Gate: target/release/litex -lang en -strict -f examples/tmp.lit

thm empty_fold_with_laws:
    ? forall E nonempty_set, add fn(x, y E) E, zero E, term fn(selected N) E:
        forall x, y E:
            add(x, y) = add(y, x)
        forall x, y, z E:
            add(add(x, y), z) = add(x, add(y, z))
        =>:
            finite_set_reduce({}, term, add, zero) = zero
    finite_set_reduce({}, term, add, zero) = zero
