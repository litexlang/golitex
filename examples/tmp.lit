# Nested release: outer auto-open does not open inner struct laws.
# Run: LITEX_NEW_PIPELINE=1 cargo run --bin litex -- -f examples/tmp.lit

struct Coordinates:
    x R
    y R
    <=>:
        x = 0

struct TaggedPoint:
    point &Coordinates
    tag N

trust have p &TaggedPoint
release struct def p.point
p.point.x = 0
