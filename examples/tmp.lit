# Smoke: order wave (power/sqrt/log + div/mod/bridge/trans/card).
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/tmp.lit

have a R
have n N+
0 <= a^2
trust a != 0
0 < a^2
trust 0 < a
0 <= a^n
0 < a^n

have x R
have y R
trust 0 <= x
0 <= sqrt(x)
trust 0 < x
0 < sqrt(x)
trust 0 <= y
trust x <= y
sqrt(x) <= sqrt(y)

1 <= n
n >= 1

have z Z
0 <= z % n
z % n < n

have p R
have q R
have r R
trust p <= q
trust q < r
p < r
0 <= q - p
trust 0 < r - q
q < r

have c R
trust 0 < c
trust p <= q
p / c <= q / c
trust 0 < p
trust 1 < c
p / c < p

0 <= finite_set_size({1, 2})
1 <= finite_set_size({1, 2})
finite_set_size({1, 2}) >= 0
finite_set_size({1, 2}) >= 1
{1} $subset {1, 2}
finite_set_size({1}) <= finite_set_size({1, 2})

trust 1 < 2
trust 0 < x
trust 0 < y
trust x <= y
log(2, x) <= log(2, y)
