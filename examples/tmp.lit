prop is_one(x R):
    x = 1

$is_one(1)

abstract_prop marked(x)

trust forall x set:
    $marked(x)

$marked(1)

abstract_prop marked2(x, y)

trust forall x R:
    $marked2(x, x + 1)

$marked2(1, 2)


"""
import Mathlib

universe uLitex

namespace tmp

-- Litex's primitive notion of a set.
abbrev LitexSet := Type uLitex

-- Every generated proposition has this codomain.
abbrev LitexFact := Prop

def is_one (x : ℝ) : LitexFact := x = (1 : ℝ)

-- Litex stored fact f3
theorem global_fact_3 : is_one (1 : ℝ) := by
  simp [is_one]

opaque marked {α_x_1 : Sort uLitex} : α_x_1 → LitexFact

-- Litex trust boundary: f8
axiom global_fact_8 : ∀ (x : LitexSet), marked x

-- Litex stored fact f9
theorem global_fact_9 : marked (1 : ℝ) := by
  exact global_fact_8 (1 : ℝ)

opaque marked2 {α_x_1 α_y_2 : Sort uLitex} : α_x_1 → α_y_2 → LitexFact

-- Litex trust boundary: f12
axiom global_fact_12 : ∀ (x : ℝ), marked2 x (x + (1 : ℝ))

-- Litex stored fact f13
theorem global_fact_13 : marked2 (1 : ℝ) (2 : ℝ) := by
  exact global_fact_12 ((2 : ℝ) - (1 : ℝ))

end tmp
"""
