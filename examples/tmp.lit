# new_pipeline: thm / release thm / by thm / by def
# LITEX_NEW_PIPELINE=1 litex -f examples/tmp.lit

thm one_is_one:
    ? 1 = 1

release thm one_is_one
by thm one_is_one => 1 = 1

thm add_zero_right:
    ? forall x R:
        x + 0 = x
    x + 0 = x

release thm add_zero_right(2)
by thm add_zero_right(2) => 2 + 0 = 2

prop same_obj(x R, y R):
    x = y

by def $same_obj(1, 1)
