prop is_upper_bound(E set, M R):
    E $subset R
    forall x E:
        x <= M

struct BisectionState<E set>:
    lower R
    upper R
    <=>:
        not $is_upper_bound(E, lower)
        $is_upper_bound(E, upper)
        lower <= upper

struct BisectionProcess<E set>:
    initial &BisectionState<E>
    states fn(n N) &BisectionState<E>

thm bisection_state_fields_are_available:
    ? forall E set, state &BisectionState<E>:
        not $is_upper_bound(E, state.lower)
        $is_upper_bound(E, state.upper)
        state.lower <= state.upper

thm nested_bisection_state_fields_are_available:
    ? forall E set, process &BisectionProcess<E>:
        process.initial.lower <= process.initial.upper

thm function_returned_state_uses_an_explicit_view:
    ? forall E set, process &BisectionProcess<E>, n N:
        &BisectionState<E>{process.states(n)}.lower <= &BisectionState<E>{process.states(n)}.upper

# LADR nested-structure migration probe. These declarations deliberately use
# the same four public shapes without importing the textbook module, so this
# scratch file can run in isolated mode.
struct ProbeScalarSystem<s nonempty_set>:
    zero s
    one s
    add fn(x, y s) s
    mul fn(x, y s) s

struct ProbeVectorSpace<s nonempty_set, V nonempty_set>:
    scalars &ProbeScalarSystem<s>
    zero V
    add fn(x, y V) V
    smul fn(a s, x V) V

struct ProbeInnerProductScalarGeometry<s nonempty_set>:
    scalars &ProbeScalarSystem<s>
    conjugate fn(x s) s
    absolute_value fn(x s) R
    real_part fn(x s) R
    real_embed fn(x R) s

struct ProbeInnerProductSpace<s nonempty_set, V nonempty_set>:
    scalar_geometry &ProbeInnerProductScalarGeometry<s>
    vector_space &ProbeVectorSpace<s, V>
    inner fn(u, v V) s
    <=>:
        scalar_geometry.scalars = vector_space.scalars

struct ProbeFiniteVectorSpaceFamily<s nonempty_set, U nonempty_set, m N_pos>:
    scalars &ProbeScalarSystem<s>
    carriers finite_seq(power_set(U), m)
    zeros finite_seq(U, m)
    adds finite_seq(fn(x, y U) U, m)
    smuls finite_seq(fn(a s, x U) U, m)

prop probe_is_linear_map(s nonempty_set, V, W nonempty_set, Vspace &ProbeVectorSpace<s, V>, Wspace &ProbeVectorSpace<s, W>, T fn(v V) W):
    Vspace.scalars = Wspace.scalars
    forall u, v V:
        T(Vspace.add(u, v)) = Wspace.add(T(u), T(v))
    forall a s, v V:
        T(Vspace.smul(a, v)) = Wspace.smul(a, T(v))

template<s nonempty_set, U nonempty_set, m N_pos, family &ProbeFiniteVectorSpaceFamily<s, U, m>>:
    have fn probe_family_scalar_product(a, b s) s = family.scalars.mul(a, b)

# This concrete three-layer chain tests the parser/runtime surface without
# asking the theorem searcher to solve a generic equality of structure values.
struct ProbeScalars:
    one R
    mul fn(x, y R) R

struct ProbeGeometry:
    scalars &ProbeScalars
    marker N

struct ProbeSpace:
    scalar_geometry &ProbeGeometry
    marker N

have fn probe_mul(x, y R) R = x * y
have probe_scalars &ProbeScalars = (1, probe_mul)
have probe_geometry &ProbeGeometry = (probe_scalars, 0)
have probe_space &ProbeSpace = (probe_geometry, 0)

probe_space.scalar_geometry.scalars.mul(2, 3) $in R

# Set-valued definitions retain their concrete source shape; this named bridge
# is the cross-file pattern used by reduced residue representatives in Section
# VIII of Number Theory for Beginners.
prop tmp_reduced_remainder(m N_pos, a Z):
    0 <= a < m

have fn tmp_reduced_remainders(m N_pos) power_set(Z) = {a Z: $tmp_reduced_remainder(m, a)}

thm tmp_reduced_remainder_is_member:
    ? forall m N_pos, a Z:
        $tmp_reduced_remainder(m, a)
        =>:
            a $in tmp_reduced_remainders(m)
    a $in tmp_reduced_remainders(m)

# MIL C02 structure probe: a ring stores its additive parent, so a caller can
# reuse additive constructions through one object instead of a loose operation list.
struct C02ExampleAdditiveGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
            add(neg(x), x) = zero
        forall x, y s:
            add(x, y) = add(y, x)

struct C02ExampleRing<s nonempty_set>:
    additive &C02ExampleAdditiveGroup<s>
    mul fn(x, y s) s
    one s
    <=>:
        forall x, y, z s:
            mul(mul(x, y), z) = mul(x, mul(y, z))
            mul(x, additive.add(y, z)) = additive.add(mul(x, y), mul(x, z))
            mul(additive.add(x, y), z) = additive.add(mul(x, z), mul(y, z))
        forall x s:
            mul(one, x) = x
            mul(x, one) = x

template<s nonempty_set, group &C02ExampleAdditiveGroup<s>>:
    have fn c02_example_sub(x, y s) s = group.add(x, group.neg(y))

thm c02_example_self_sub:
    ? forall s nonempty_set, group &C02ExampleAdditiveGroup<s>, a s:
        \c02_example_sub<s, group>(a, a) = group.zero
    \c02_example_sub<s, group>(a, a) = group.add(a, group.neg(a))
    group.add(a, group.neg(a)) = group.add(group.neg(a), a) = group.zero
    \c02_example_sub<s, group>(a, a) = group.zero

thm c02_example_ring_identity:
    ? forall s nonempty_set, ring &C02ExampleRing<s>, a s:
        ring.mul(ring.one, a) = a

# Regression: absolute value preserves nonzeroness.
# The builtin uses x != 0 to prove abs(x) != 0.
thm abs_nonzero_from_argument_nonzero:
    ? forall x R:
        x != 0
        =>:
            abs(x) != 0
    abs(x) != 0
