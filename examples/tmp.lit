forall s, t, u set:
    s $subset t
    =>:
        intersect(s, u) $subset intersect(t, u)

have fn tmp_reduce_identity_z(x Z) Z = x
have fn tmp_reduce_sub_z(x, y Z) Z = x - y
have fn tmp_reduce_add_z(x, y Z) Z = x + y
have fn tmp_reduce_mul_z(x, y Z) Z = x * y

reduce(1, 3, tmp_reduce_identity_z, tmp_reduce_sub_z, 0) = -6
reduce(3, 2, tmp_reduce_identity_z, tmp_reduce_sub_z, 10) = 10
finite_set_reduce({3, 1, 2}, tmp_reduce_identity_z, tmp_reduce_add_z, 0) = 6

reduce(1, 3, tmp_reduce_identity_z, tmp_reduce_add_z, 0) = sum(1, 3, tmp_reduce_identity_z)
reduce(1, 3, tmp_reduce_identity_z, tmp_reduce_mul_z, 1) = product(1, 3, tmp_reduce_identity_z)
finite_set_reduce({1, 2, 3}, tmp_reduce_identity_z, tmp_reduce_add_z, 0) = finite_set_sum({1, 2, 3}, tmp_reduce_identity_z)

forall a, b Z, f fn(x Z) Z, op fn(x, y Z) Z, seed Z:
    a <= b
    =>:
        reduce(a, b, f, op, seed) = reduce(0, b - a, fn(k Z) Z {f(a + k)}, op, seed)
        reduce(a, b, f, op, seed) = reduce(a + 1, b, f, op, op(seed, f(a)))
        reduce(a, b, f, op, seed) = op(reduce(a, b - 1, f, op, seed), f(b))

forall a, b Z, f fn(x Z) Z, op fn(x, y Z) Z, seed Z:
    b < a
    =>:
        reduce(a, b, f, op, seed) = reduce(0, b - a, fn(k Z) Z {f(a + k)}, op, seed)
