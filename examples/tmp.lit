# Preview: obtain from `$P` and from `thm` (new_pipeline).
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/tmp.lit

prop has_copy(a R):
    exist x R st {x = a}

$has_copy(2)
obtain copy from $has_copy(2)
copy = 2

thm self_exists:
    ? forall a R:
        exist x R st {x = a}

obtain theorem_copy from thm self_exists(3)
theorem_copy = 3
