# Infer migration smoke (batches 3/4/5)
have k N
k >= 0

have a R+
0 < a

have x {1, 2}
x = 1 or x = 2

have A set
have B set
have y set
trust y $in union(A, B)
y $in A or y $in B

have u set
trust u $in cart(R, Z)
$is_tuple(u)
tuple_dim(u) = 2
u[1] $in R
u[2] $in Z

have p R
trust p < 0
(-1) * p >= 0

have c R
have d R
trust c - d = 0
c = d
