# Wave 5 + 6 smoke: quot/lcm/gcd/factorial + abs/sign/ordered min/max.

have a Z
have b Z
have n N
have p N+
have x R+
have y R
have z R
have u R
have v R
have s R
have t R

quot(a, 1) = a
quot(p, p) = 1
lcm(a, b) = lcm(b, a)
lcm(a, a) = abs(a)

trust a != 0
gcd(a, b) = gcd(b, a)
gcd(a, a) = abs(a)
gcd(a, 0) = abs(a)
gcd(0, a) = abs(a)

trust n! $in N
(n + 1)! = (n + 1) * n!

abs(x) = x
sign(x) = 1

trust y <= 0
abs(y) = 0 - y

trust z < 0
sign(z) = 0 - 1

trust u <= v
max(u, v) = v
min(u, v) = u

trust t <= s
max(s, t) = s
min(s, t) = t
