# Rename smoke: family_union / family_intersect / index_cart
have fn family(k {1, 2, 3}) power_set(N) = {1, 2, 3}
family(1) = {1, 2, 3}
family(2) = {1, 2, 3}
family(3) = {1, 2, 3}
1 $in {1, 2, 3}
1 $in family(1)
1 $in family(2)
1 $in family(3)

index_union({1, 2, 3}, N, family) = family_union(fn_range(family))
$is_nonempty_set({1, 2, 3})
index_intersect({1, 2, 3}, N, family) = family_intersect(fn_range(family))

have fn g(alpha {1}) R = alpha
let c = index_cart({1}, R, g)
