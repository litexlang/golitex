prop contains_natural_tail_from(a N, S power_set(N)):
    forall n N:
        n >= a
        =>:
            n $in S

prop eventually_on_N(S power_set(N)):
    exist a N st {$contains_natural_tail_from(a, S)}

thm eventually_on_N_keeps_captured_set:
    ? forall S power_set(N):
        $eventually_on_N(S)
        =>:
            $eventually_on_N(S)
    $eventually_on_N(S)
