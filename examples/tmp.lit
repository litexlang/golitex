have Builder power_set(R) = {x R: x > 0}
have Alias power_set(R) = Builder
have a R = 1
# force membership via set_builder_member style
1 > 0
a $in Builder
a $in Alias
# now from Alias membership get R - already have
# what about from a typed as Alias after equality?
have b Alias = a
b $in Alias
b $in R
