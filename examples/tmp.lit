# Combined cases for remaining OR builtins (equality-plus-strict, residues,
# successor tail, square-sum nonzero, classical implication, integer discrete).

# --- OR: EqualityPlusStrictCoversWeak ---
have a, b R
trust a <= b
a = b or a < b

# --- OR: CompleteResidues ---
have n Z
n % 2 = 0 or n % 2 = 1

# --- OR: IntegerSuccessorTail ---
have x Z
trust x >= 1
x = 1 or x = 2 or x = 3 or x > 3

# --- OR: SquareSumComponentNonzero ---
have u, v R
trust u^2 + v^2 != 0
u != 0 or v != 0

# --- OR: ClassicalImplication ---
have c, d R
c != 0 or c * d = 0

# --- OR: IntegerDiscreteSplit ---
have y, m Z
y <= m or y >= m + 1
