# Wave3: exist-shaped builtins + prime/coprime by computation
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/tmp.lit

# --- exist: RationalIntegerRatio (green; PositiveDenominator skipped: body WD) ---
1 / 2 $in Q
exist a Z, b Z* st {1 / 2 = a / b}

# --- exist: IntegerMultipleFromZeroRemainder ---
6 % 3 = 0
exist k Z st {6 = 3 * k}

# --- exist: ArchimedeanReciprocal ---
0.5 $in R+
exist n N+ st {1 / n < 0.5}

# --- exist: RealDensityMidpoint ---
0 < 1
exist r R st {0 < r < 1}

# --- atomic: prime / coprime computation ---
$prime(17)
not $prime(1)
$coprime(14, 25)
not $coprime(14, 21)
