# Preview: `A -> B` FnSet sugar (phase 1).
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/tmp.lit
#
# Do not compare two separately parsed arrows for equality: each allocates a
# fresh `__param_<id>`, and FnSet EqualIR does not alpha-identify binders yet.

let S = R -> R
S = S

let T = R -> R -> Z
T = T

let U = R × R -> R
U = U

let V = R -> (R -> Z)
V = V
