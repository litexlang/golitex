# new_pipeline parse gallery (LITEX_NEW_PIPELINE=1)
# Goal: token → AST. Exec may stop early; smoke with -e one form at a time.

let a = 2
let sum = 1 + 2

1 = 1
1 != 2
1 < 2 < 3
1 $in N
{1, 2} $subset N
$is_set(N)
$p(1, 2)

forall x R:
    x = x

# inline aside is stripped at tokenize time
"我们有" 1 = 1
forall a R: "note"
    a = a

exist y R st {y = 0}

claim:
    ? 1 = 1
    1 = 1

try:
    1 = 1

prop Q(x R):
    x = x

thm T:
    ? forall z R:
        z = z
