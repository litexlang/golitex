prop is_upper_bound(E set, M R):
    E $subset R
    forall x E:
        x <= M

struct BisectionState<E set>:
    lower R
    upper R
    <=>:
        not $is_upper_bound(E, lower)
        $is_upper_bound(E, upper)
        lower <= upper

struct BisectionProcess<E set>:
    initial &BisectionState<E>
    states fn(n N) &BisectionState<E>

thm bisection_state_fields_are_available:
    ? forall E set, state &BisectionState<E>:
        not $is_upper_bound(E, state.lower)
        $is_upper_bound(E, state.upper)
        state.lower <= state.upper

thm nested_bisection_state_fields_are_available:
    ? forall E set, process &BisectionProcess<E>:
        process.initial.lower <= process.initial.upper

thm function_returned_state_uses_an_explicit_view:
    ? forall E set, process &BisectionProcess<E>, n N:
        &BisectionState<E>{process.states(n)}.lower <= &BisectionState<E>{process.states(n)}.upper

# LADR nested-structure migration probe. These declarations deliberately use
# the same four public shapes without importing the textbook module, so this
# scratch file can run in isolated mode.
struct ScalarSystem<s nonempty_set>:
    zero s
    one s
    add fn(x, y s) s
    mul fn(x, y s) s

struct VectorSpace<s nonempty_set, V nonempty_set>:
    scalars &ScalarSystem<s>
    zero V
    add fn(x, y V) V
    smul fn(a s, x V) V

struct InnerProductScalarGeometry<s nonempty_set>:
    scalars &ScalarSystem<s>
    conjugate fn(x s) s
    absolute_value fn(x s) R
    real_part fn(x s) R
    real_embed fn(x R) s

struct InnerProductSpace<s nonempty_set, V nonempty_set>:
    scalar_geometry &InnerProductScalarGeometry<s>
    vector_space &VectorSpace<s, V>
    inner fn(u, v V) s
    <=>:
        scalar_geometry.scalars = vector_space.scalars

struct FiniteVectorSpaceFamily<s nonempty_set, U nonempty_set, m N_pos>:
    scalars &ScalarSystem<s>
    carriers finite_seq(power_set(U), m)
    zeros finite_seq(U, m)
    adds finite_seq(fn(x, y U) U, m)
    smuls finite_seq(fn(a s, x U) U, m)

prop is_linear_map(s nonempty_set, V, W nonempty_set, Vspace &VectorSpace<s, V>, Wspace &VectorSpace<s, W>, T fn(v V) W):
    Vspace.scalars = Wspace.scalars
    forall u, v V:
        T(Vspace.add(u, v)) = Wspace.add(T(u), T(v))
    forall a s, v V:
        T(Vspace.smul(a, v)) = Wspace.smul(a, T(v))

thm inner_space_three_level_scalar_access:
    ? forall s nonempty_set, V nonempty_set, inner_space &InnerProductSpace<s, V>, a, b s:
        inner_space.scalar_geometry.scalars.mul(a, b) = inner_space.vector_space.scalars.mul(a, b)

thm inner_space_final_field_calls_are_typed:
    ? forall s nonempty_set, V nonempty_set, inner_space &InnerProductSpace<s, V>, a s:
        inner_space.vector_space.smul(a, inner_space.vector_space.zero) $in V
        inner_space.inner(inner_space.vector_space.zero, inner_space.vector_space.zero) $in s

thm linear_map_projects_scalar_compatibility:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &VectorSpace<s, V>, Wspace &VectorSpace<s, W>, T fn(v V) W:
        $is_linear_map(s, V, W, Vspace, Wspace, T)
        =>:
            Vspace.scalars = Wspace.scalars

thm incompatible_scalar_spaces_cannot_form_a_linear_map:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &VectorSpace<s, V>, Wspace &VectorSpace<s, W>, T fn(v V) W:
        Vspace.scalars != Wspace.scalars
        =>:
            not $is_linear_map(s, V, W, Vspace, Wspace, T)

thm finite_vector_space_family_owns_callable_scalars:
    ? forall s nonempty_set, U nonempty_set, m N_pos, family &FiniteVectorSpaceFamily<s, U, m>, k N_pos, a s, x U:
        k <= m
        =>:
            family.scalars.mul(a, family.scalars.one) $in s
            family.smuls(k)(a, x) $in U
