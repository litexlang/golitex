# Closed-numeric arithmetic operators (abs / min / max / floor / ceil / sign / pow).
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/tmp.lit

abs(-3) = 3
abs(3) = 3
min(1, 2) = 1
max(1, 2) = 2
min(2, 1) = 1
max(-1, -3) = -1
2^3 = 8
(-2)^3 = -8
floor(2.5) = 2
ceil(2.5) = 3
sign(-4) = -1
sign(0) = 0
sign(5) = 1
abs(min(-2, 3)) = 2
max(abs(-1), 0) = 1

# Closed-numeric store / rewrite with abs / min
have a R = abs(-3)
a = 3
have b R = min(1, 2)
b + 1 = 2
have c R = max(floor(2.5), sign(-1))
c = 2
