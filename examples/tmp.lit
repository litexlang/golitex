have fn s(x R: x > 0) R = x

s(1) = s(1)

forall x R:
    x > 0
    =>:
        s(x) = s(x)

forall x R:
    x = -1
    x > 0
    =>:
        s(-1) = s(-1)

forall x, y Z:
    x + 3 <= 2
    y + 2 * x >= 3
    =>:
        (y + 2 * x) - 2 * x >= 3 - 2 * x
        9 - 2 * (x + 3) >= 9 - 2 * 2

forall r, q Q:
    q + 3 >= r
    q + r <= 3
    =>:
        ((q + r + r) - q) / 2 <= ((3 + (q + 3)) - q) / 2
