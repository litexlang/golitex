prop probe_seq_formula(a fn(n Z: n >= 0) Z, n Z):
    n >= 0
    a(n) = 2^n + (-1)^n

prop probe_seq_formula_pair(a fn(n Z: n >= 0) Z, n Z):
    n >= 0
    $probe_seq_formula(a, n)
    $probe_seq_formula(a, n + 1)

claim:
    ? forall a fn(n Z: n >= 0) Z, n Z:
        a(0) = 2
        a(1) = 1
        forall k Z:
            k >= 0
            =>:
                a(k + 2) = a(k + 1) + 2 * a(k)
        n >= 0
        =>:
            $probe_seq_formula_pair(a, n)
    by induc n from 0:
        ? $probe_seq_formula_pair(a, n)
        0 >= 0
        a(0) = 2 = 2^0 + (-1)^0
        0 + 1 >= 0
        2^1 = 2
        (-1)^1 = -1
        2^1 + (-1)^1 = 2 + (-1) = 1
        2^(0 + 1) + (-1)^(0 + 1) = 2^1 + (-1)^1 = 1
        a(0 + 1) = a(1) = 1 = 2^(0 + 1) + (-1)^(0 + 1)
        $probe_seq_formula(a, 0)
        $probe_seq_formula(a, 0 + 1)
        $probe_seq_formula_pair(a, 0)

        claim:
            ? forall m Z:
                m >= 0
                $probe_seq_formula_pair(a, m)
                =>:
                    $probe_seq_formula_pair(a, m + 1)
            m >= 0
            $probe_seq_formula_pair(a, m)
            $probe_seq_formula(a, m)
            a(m) = 2^m + (-1)^m
            $probe_seq_formula(a, m + 1)
            a(m + 1) = 2^(m + 1) + (-1)^(m + 1)
            m + 1 >= 0
            (m + 1) + 1 = m + 2
            a((m + 1) + 1) = a(m + 2) = a(m + 1) + 2 * a(m)
            a(m + 1) + 2 * a(m) = 2^(m + 1) + (-1)^(m + 1) + 2 * (2^m + (-1)^m)
            2^(m + 1) = 2^m * 2^1 = 2 * 2^m
            (-1)^(m + 1) = (-1)^m * (-1)^1 = -1 * (-1)^m
            2^(m + 2) = 2^m * 2^2 = 4 * 2^m
            (-1)^(m + 2) = (-1)^m * (-1)^2 = (-1)^m
            2^(m + 1) + (-1)^(m + 1) + 2 * (2^m + (-1)^m) = 4 * 2^m + (-1)^m
            2^(m + 2) + (-1)^(m + 2) = 4 * 2^m + (-1)^m
            2^(m + 1) + (-1)^(m + 1) + 2 * (2^m + (-1)^m) = 4 * 2^m + (-1)^m = 2^(m + 2) + (-1)^(m + 2)
            a((m + 1) + 1) = 2^(m + 2) + (-1)^(m + 2) = 2^((m + 1) + 1) + (-1)^((m + 1) + 1)
            $probe_seq_formula(a, (m + 1) + 1)
            $probe_seq_formula_pair(a, m + 1)
