struct Group<s nonempty_set>:
    mul fn(x, y s) s
    one s
    inv fn(x s) s
    <=>:
        forall x, y, z s:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x s:
            mul(x, one) = x
            mul(one, x) = x
            mul(inv(x), x) = one

forall s nonempty_set, G &Group<s>, candidate_identity s:
    forall a s:
        G.mul(candidate_identity, a) = a
        G.mul(a, candidate_identity) = a
    =>:
        candidate_identity = G.mul(G.one, candidate_identity) = G.one
