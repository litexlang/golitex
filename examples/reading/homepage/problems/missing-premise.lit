# 不能通过：所有人都会死，但还没说苏格拉底是人。
# people 是讨论对象的集合；其中的对象不一定都是人。
# 最后的结论缺少 is_human(socrates) 这个前提。
# 这里是前提不足，不能因此断言结论为假。
abstract_prop is_human(person)
abstract_prop is_mortal(person)

forall people nonempty_set, socrates people:
    forall person people:
        $is_human(person)
        =>:
            $is_mortal(person)
    =>:
        $is_mortal(socrates)
