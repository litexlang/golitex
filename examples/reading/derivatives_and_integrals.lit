# Compare a derivative calculated from a function body with a cited value.
have fn square(x R) R = x * x
$diff_at(square, 3)
deriv(square, 3) = 6

$has_deriv_at(square, 4, 8)
deriv(square, 4) = 8

# The power rule and the inner affine derivative give the factor 15.
have fn affine_power(x R) R = (3*x + 1)^5
forall a R:
    $diff_at(affine_power, a)
    deriv(affine_power, a) = 15 * (3*a + 1)^4

# Integrate a polynomial, then compare reversed and coincident endpoints.
have fn p(x R) R = 3*x^2 + 2*x + 1
$is_riemann_integrable(p, 0, 1)
integ(p, 0, 1) = 3

$has_riemann_integral(p, 1, 0, -3)
integ(p, 1, 0) = -3

$has_riemann_integral(p, 2, 2, 0)
integ(p, 2, 2) = 0

# Contributions from the two halves of the interval cancel.
have fn odd_power(x R) R = x^3
$is_riemann_integrable(odd_power, -1, 1)
integ(odd_power, -1, 1) = 0
