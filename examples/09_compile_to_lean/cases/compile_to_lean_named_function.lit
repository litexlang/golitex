# Named functions consume the exact ordered parameter/domain evidence retained
# by Litex. The identity checks the proof-independent baseline.
have fn id(x R) R = x
id(1) = 1

# A compound body becomes a verifier-owned obj_N DAG. Its In-C evidence is
# passed into Litex.add, then the checked definition is replayed at 1.
have fn inc(x R) R = x + 1
inc(1) = 1 + 1

# A partial body receives x != 0 from the same dependent requirements
# telescope and passes it directly to Litex.div.
have fn reciprocal(x R: x != 0) R = 1 / x
forall a R:
    a != 0
    =>:
        reciprocal(a) = 1 / a

# Boundary: an unavailable defining-equality FactId cannot be reconstructed by
# target-side unfolding or proposition search; malformed body/domain WD edges
# are rejected before Lean emission.
