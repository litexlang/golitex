# Set-builder conditions are retained in source order.  The WD proof for the
# second condition reuses the first local fact (`x != 0`) under the builder's
# own binder scope; neither local fact leaks to the surrounding environment.
have PositiveReciprocals set = {x R: x != 0, 1 / x > 0}

# Later conditions may reuse the same locally checked quotient.
have BoundedPositiveReciprocals set = {x R: x != 0, 1 / x > 0, 1 / x < 2}

# A compound anonymous body remains a proof-free Object expression.  Its
# arithmetic closure is replayed by the generated `closed` theorem after the
# function parameter membership premise has entered scope.
fn(x R) R {x + 1} = fn(y R) R {y + 1}

# Function-domain facts are also available to the compound body WD replay.
fn(x R: x != 0) R {1 / x} = fn(y R: y != 0) R {1 / y}

# Direct application consumes the checked anonymous-function membership.
forall a R:
    fn(x R) R {x + 1}(a) = fn(x R) R {x + 1}(a)
