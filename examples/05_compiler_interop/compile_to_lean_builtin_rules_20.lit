# Tracer: twenty registered arithmetic/order builtin rules for Litex-to-Lean
#
# Before (compiled through a hand-written arithmetic evidence variant):
# forall a, b R:
#     a < b
#     =>:
#         a <= b
# Former behavior: the verifier selected `LessEqualFromStrictOrder`, runtime
# lowered a dedicated arithmetic enum variant, and the emitter selected a
# per-rule proof recipe.
#
# Earlier label-only boundary retained for context:
# forall a, b R:
#     0 <= a
#     0 <= b
#     =>:
#         0 <= a * b
# The original verifier returned only the diagnostic label
# "0 <= a * b from 0 <= a and 0 <= b", so no checked Lean backend ran.
#
# Now (verified and compiled):
# Every active theorem below returns a path-derived registered RuleId,
# occurrence-local bindings, parameter proofs, and ordered premise proofs. The
# generic emitter applies the paired checked Mathlib wrapper; no per-rule
# verifier, evidence, IR, or emitter branch was added for this migration.
#
# Boundary: a rule such as `a < b`, `b < c` => `a < c` has a middle parameter
# absent from the conclusion, so it remains outside the range-restricted local
# catalog. Recursive arithmetic strategies retain their dedicated evidence.
# Evidence: target/release/litex -compact -isolated -runner -f examples/05_compiler_interop/compile_to_lean_builtin_rules_20.lit
# Focused compiler gate: cargo test --release compile_to_lean_builtin_rules_20 -- --nocapture
# Implementation: src/verify/local_builtin_catalog/order/ and
# src/compile_to_lean/local_builtin_adapters/order/

forall a, b R:
    a < b
    =>:
        a <= b

forall a, b R:
    a > b
    =>:
        a >= b

forall u, v R:
    v <= u
    =>:
        0 <= u - v

forall u, v R:
    v < u
    =>:
        0 < u - v

forall a, b R:
    0 <= a
    0 <= b
    =>:
        0 <= a + b

forall a, b R:
    0 < a
    0 < b
    =>:
        0 < a + b

forall a, b R:
    0 < a
    0 <= b
    =>:
        0 < a + b

forall a, b R:
    0 <= a
    0 < b
    =>:
        0 < a + b

forall a, b R:
    0 <= a
    0 <= b
    =>:
        0 <= a * b

forall a, b R:
    0 < a
    0 < b
    =>:
        0 < a * b

forall a, b R:
    0 <= a
    0 < b
    =>:
        0 <= a / b

forall a, b R:
    0 < a
    0 < b
    =>:
        0 < a / b

forall u, a, b R:
    a <= b
    =>:
        u + a <= u + b

forall a, b, c, d R:
    a <= b
    c <= d
    =>:
        a + c <= b + d

forall u, a, b R:
    a < b
    =>:
        u + a < u + b

forall a, b, c, d R:
    a < b
    c < d
    =>:
        a + c < b + d

forall a, b, c, d R:
    a < b
    c <= d
    =>:
        a + c < b + d

forall a, b, c, d R:
    a <= b
    c < d
    =>:
        a + c < b + d

forall a, b, c R:
    a <= b
    0 <= c
    =>:
        a - c <= b

forall a, b R:
    0 <= b
    =>:
        a <= a + b
