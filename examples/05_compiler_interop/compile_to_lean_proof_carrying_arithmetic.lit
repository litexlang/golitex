# Tracer: proof-carrying complex arithmetic follows the Litex WD DAG.
#
# Before (Litex verified, but the Lean ABI admitted unchecked operands):
# forall a, b, c C:
#     (a + b) + c = (a + b) + c
# Former target shape: `Litex.add (Litex.add a b) c` could be constructed
# without the verifier's `a $in C`, `b $in C`, or inner-sum membership facts.
#
# Now (verified and compiled by the focused Rust/Mathlib gates):
forall a, b, c C:
    (a + b) + c = (a + b) + c

forall a, b, c C:
    ((a - b) * c) + a = ((a - b) * c) + a
#
# Before division migration (Litex verified, but Lean construction was total):
# forall a, b C:
#     b != 0
#     =>:
#         a / b = a / b
# Former target shape: `Litex.div a b` discarded the verifier's `a $in C`,
# `b $in C`, and `b != 0` facts.
#
# Now (verified and compiled with three exact division obligations):
forall a, b C:
    b != 0
    =>:
        a / b = a / b

forall a, b C:
    b != 0
    =>:
        (a / b) + a = (a / b) + a

forall a, b R:
    b != 0
    =>:
        a / b $in R
# Current target shape: every `Litex.add/sub/mul` consumes the exact two
# complex-membership `WellDefinedFactId`s. `Litex.div` additionally consumes
# the exact denominator-nonzero fact. Inner result-membership helpers are
# emitted before outer objects that cite them.
#
# Boundary: malformed compiler IR that deletes, duplicates, misindexes, or
# retargets any division proof slot is rejected before Lean emission; Lean also
# rejects a direct unchecked `Litex.div a b` application.
# Source gate:
# target/release/litex -compact -isolated -runner -f examples/05_compiler_interop/compile_to_lean_proof_carrying_arithmetic.lit
# Focused compiler gate:
# cargo test --release proof_carrying_arithmetic_replays_well_defined_fact_ids -- --nocapture
# Real Lean gate:
# LITEX_LEAN_PROJECT=/absolute/path/to/mathlib LITEX_LAKE=/absolute/path/to/lake cargo test --release proof_carrying_arithmetic_compiles_with_mathlib -- --ignored --nocapture
