# Tracer: replay known equality symmetry and transitivity by exact FactId.
#
# Before (Litex verified, To-Lean did not compile):
# forall a, b set:
#     a = b
#     =>:
#         b = a
# Former behavior: the verifier returned only `same known equality class`, so
# To-Lean could not identify the stored equality proof behind that class.
#
# Now (verified and compiled by the focused Rust/Mathlib gates):
forall a, b set:
    a = b
    =>:
        b = a

forall a, b, c set:
    a = b
    b = c
    =>:
        a = c
# Current behavior: the compiler freezes the direct equality FactIds and emits
# `Eq.symm` for the first theorem and `Eq.trans` for the second.
#
# Boundary: a missing, changed, disconnected, or child-scope-inaccessible
# equality FactId is rejected; the emitter never rebuilds a path by text.
# Source gate:
# target/release/litex -compact -isolated -runner -f examples/05_compiler_interop/compile_to_lean_known_equality_path.lit
# Focused compiler gates:
# cargo test --release known_equality_path_replays_symmetry_and_transitivity_by_fact_id -- --nocapture
# cargo test --release unavailable_known_equality_fact_id_is_rejected -- --nocapture
# Real Lean gate:
# LITEX_LEAN_PROJECT=/absolute/path/to/mathlib LITEX_LAKE=/absolute/path/to/lake cargo test --release known_equality_path_compiles_with_mathlib -- --ignored --nocapture
