# Tracer: generated Lean imports shared builtin theorems instead of repeating them.
#
# Before (the generated file repeated the semantic core and theorem bodies):
#   import Mathlib
#
#   namespace Litex
#   axiom Object : Type
#   ...
#   theorem BuiltinRules.notEqualSymmetry ... := by
#     exact Ne.symm h
#
# Now (the three facts below remain ordinary verified Litex source):
forall a, b set:
    a != b
    =>:
        b != a

1 $in N
1 $in C
# Current To-Lean behavior: the generated file imports `Litex.BuiltinRules`,
# checks `Litex.abiVersion`, and calls `notEqualSymmetry`, `numeralInN`, and
# `numeralInC`. It does not repeat the semantic core or theorem bodies.
#
# Boundary: a verifier builtin without a checked shared-theorem adapter remains
# rejected by strict To-Lean; neither an inline tactic script nor an axiom is
# generated as a fallback. The real Lean gate also confirms that a generated
# ABI-version-2 assertion is rejected by the current ABI-version-1 library.
# Source gate:
# target/release/litex -compact -isolated -runner -f examples/05_compiler_interop/compile_to_lean_shared_builtin_rules.lit
# Focused compiler gate:
# cargo test --release shared_builtin_rule_tracer_imports_theorems -- --nocapture
# Real Lean gate:
# LITEX_LEAN_PROJECT=/absolute/path/to/mathlib LITEX_LAKE=/absolute/path/to/lake cargo test --release shared_builtin_rule_tracer_compiles_with_mathlib -- --ignored --nocapture
