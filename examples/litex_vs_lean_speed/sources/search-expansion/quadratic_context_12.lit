claim:
    ? forall x,y,z0,z1,z2,z3,z4,z5,z6,z7,z8,z9,z10,z11 R:
        z0 >= 0
        z1 >= 0
        z2 >= 0
        z3 >= 0
        z4 >= 0
        z5 >= 0
        z6 >= 0
        z7 >= 0
        z8 >= 0
        z9 >= 0
        z10 >= 0
        z11 >= 0
        =>:
            2*x*y <= x^2+y^2
    x^2+y^2-2*x*y=(x-y)^2 >= 0
