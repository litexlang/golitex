# Stmt: Definition.ObtainObjFromThm → exec_obtain_obj_from_thm_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_stmt_nodes/definition/obtain_obj_from_thm.lit
#
# Domains checked in a local env; sole exist conclusion eliminated in parent;
# release conclusions are not stored in parent.
# (new_pipeline `thm` proof bodies are fact-only; equality existentials close
# without an indented `witness` step.)

thm self_exists:
    ? forall a R:
        exist x R st {x = a}

obtain theorem_copy from thm self_exists(3)
theorem_copy = 3
theorem_copy $in R
