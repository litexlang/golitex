# Stmt: Definition.HaveByReplacementAxiomStmt → exec_have_by_replacement_axiom_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_stmt_nodes/definition/have_by_replacement_axiom.lit
#
# Named image from the Axiom of Replacement (not an anonymous Obj: prop names
# do not belong in ordinary parenthesized obj arguments).
# Needs: binary prop + known uniqueness forall over the source set.
# Tagged args match `by axiom_of_choice: set F` / `by zorn_lemma: …`.

abstract_prop image_rel(x, y)

trust:
    forall x {1, 2}, y, y2 set:
        $image_rel(x, y)
        $image_rel(x, y2)
        =>:
            y = y2

have Img set by replacement_axiom: prop image_rel, set {1, 2}

release obj def Img
