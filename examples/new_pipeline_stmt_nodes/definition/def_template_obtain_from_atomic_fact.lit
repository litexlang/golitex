# Stmt: Definition.DefTemplateStmt body ObtainObjFromAtomicFact
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_stmt_nodes/definition/def_template_obtain_from_atomic_fact.lit
#
# Prove `$P` in the ambient env first; the template body only performs obtain.

prop has_copy(a R):
    exist x R st {x = a}

$has_copy(2)
template<_S set>:
    obtain tw from $has_copy(2)
