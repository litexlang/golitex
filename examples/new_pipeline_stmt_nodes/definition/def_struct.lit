# Stmt: Definition.DefStructStmt → exec_def_struct_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_stmt_nodes/definition/def_struct.lit
# Scope: definition WD + store only (no `&Struct` / release struct def / membership).

struct Point:
    x R
    y R
    <=>:
        x = x

struct Scalar:
    value R

struct Pair<A set>:
    left A
    right A
