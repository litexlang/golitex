# Stmt: By.BySymmetricPropStmt → exec_by_symmetric_prop_stmt
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_stmt_nodes/by/by_symmetric_prop.lit

prop same(x set, y set):
    x = y

by symmetric_prop:
    ? forall x, y set:
        $same(x, y)
        =>:
            $same(y, x)

have a set, b set
trust $same(a, b)
$same(b, a)
