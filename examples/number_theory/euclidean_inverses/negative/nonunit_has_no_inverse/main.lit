release thm nt::gcd_add_multiple(84, 30, -2)

gcd(84 - 2 * 30, 30) = gcd(84, 30) = 6

release thm nt::gcd_euclidean_step(84, 30)

84 % 30 = 24

release thm nt::gcd_euclidean_step(30, 24)

30 % 24 = 6

release thm nt::gcd_euclidean_step(24, 6)

gcd(6, 0) = 6

release thm nt::gcd_add_multiple(-84, -30, -2)

gcd(-84 + (-2) * (-30), -30) = 6

release thm nt::gcd_add_multiple(0, 7, 3)

gcd(0 + 3 * 7, 7) = 7

by def $nt::is_congruent_mod(-84, 6, 30)

release thm nt::congruence_gcd_invariant(-84, 6, 30)

gcd(-84, 30) = gcd(6, 30) = 6

84 * (-3) + 30 * 9 = 18

release thm nt::linear_equation_necessary_divisibility(84, 30, 18, -3, 9)

84 * (-1) + 30 * 3 = 6

release thm nt::linear_equation_from_bezout(84, 30, -1, 3, 18, 6)

exist x, y Z st {84 * x + 30 * y = 18}

by contra:
    ? not $dvd(5, 6)
    5 % 6 = 0
    5 % 6 = 5
    impossible 0 = 5

5 * 5 + 12 * (-2) = 1

release thm nt::modular_inverse_from_bezout(5, 5, -2, 12)

$nt::is_modular_inverse(5, 5, 12)

by def $nt::is_congruent_mod(5 * 7, 5 * 19, 12)

release thm nt::modular_inverse_cancels(5, 7, 19, 5, 12)

$nt::is_congruent_mod(7, 19, 12)

release thm nt::modular_linear_equation_solution(5, 7, 5, 12)

$nt::is_congruent_mod(5 * (5 * 7), 7, 12)

35 % 12 = 11

by def $nt::is_congruent_mod(5 * 11, 7, 12)

release thm nt::modular_linear_equation_unique(5, 7, 5, 11, 12)

$nt::is_congruent_mod(11, 35, 12)

claim:
    ? $nt::is_modular_inverse(5, 17, 12)
    by def $nt::is_congruent_mod(5 * 17, 1, 12)
    by def $nt::is_modular_inverse(5, 17, 12)

release thm nt::modular_inverse_unique(5, 5, 17, 12)

$nt::is_congruent_mod(5, 17, 12)

(-5) * (-5) + 12 * (-2) = 1

release thm nt::modular_inverse_from_bezout(-5, -5, -2, 12)

release thm nt::modular_linear_equation_solution(-5, -7, -5, 12)

claim:
    ? $nt::is_modular_inverse(0, 0, 1)
    by def $nt::is_congruent_mod(0 * 0, 1, 1)
    by def $nt::is_modular_inverse(0, 0, 1)

release thm nt::modular_linear_equation_solution(0, -9, 0, 1)

by def $nt::is_congruent_mod(0 * 123, -9, 1)

release thm nt::modular_linear_equation_unique(0, -9, 0, 123, 1)

claim:
    ? $nt::is_modular_inverse(0, 19, 1)
    by def $nt::is_congruent_mod(0 * 19, 1, 1)
    by def $nt::is_modular_inverse(0, 19, 1)

release thm nt::modular_inverse_unique(0, 0, 19, 1)

by contra:
    ? not $nt::is_modular_inverse(2, 1, 6)
    $nt::is_congruent_mod(2 * 1, 1, 6)
    $dvd(2 * 1 - 1, 6)
    (2 * 1 - 1) % 6 = 0
    (2 * 1 - 1) % 6 = 1
    impossible 0 = 1

by def $nt::is_congruent_mod(2 * 1, 2 * 4, 6)

by contra:
    ? not $nt::is_congruent_mod(1, 4, 6)
    $dvd(1 - 4, 6)
    (1 - 4) % 6 = 0
    (1 - 4) % 6 = 3
    impossible 0 = 3

claim:
    ? forall u Z:
        not $nt::is_modular_inverse(2, u, 6)
    by contra:
        ? not $nt::is_modular_inverse(2, u, 6)
        $nt::is_congruent_mod(2 * u, 1, 6)
        $dvd(2 * u - 1, 6)
        release thm nt::divisibility_transitive(2 * u - 1, 6, 2)
        $dvd(2 * u, 2)
        release thm nt::divisibility_linear_combination(2 * u, 2 * u - 1, 1, -1, 2)
        (2 * u) * 1 + (2 * u - 1) * (-1) = 2 * u - (2 * u - 1) = 1
        $dvd(1, 2)
        1 % 2 = 0
        1 % 2 = 1
        impossible 0 = 1

exist u Z st {$nt::is_modular_inverse(2, u, 6)}
