# Expected normal rejection; no false extremal candidate or WD evidence may be invented.
thm upper_bound_only:
    ? forall a seq(R),L R:
        forall epsilon R+:
            exist n0 N+ st {{n N+:n>=n0} $subset preimage_set(a,{v R:v<L+epsilon})}
        =>:
            $has_seq_limsup(a,L)
    by def $has_seq_limsup(a,L)
