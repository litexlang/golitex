have points set = {0, 1}

0 $in points

1 $in points

release thm top:::discrete_topology_laws(points)

have fine &top:::TopologicalSpace<points> = (points, power_set(points))

fine.carrier = points

fine.opens = power_set(points)

power_set(fine.carrier) = power_set(points) = fine.opens

release thm top:::discrete_is_Hausdorff(points, fine)

$top:::is_Hausdorff(points, fine)

release thm top:::Hausdorff_implies_T1(points, fine)

release thm top:::T1_implies_T0(points, fine)

$top:::is_T0(points, fine)

release thm top:::Hausdorff_implies_closed_singletons(points, fine, 0)

$top:::is_closed(points, fine, {0})

claim:
    ? forall x fine.carrier:
        $top:::is_closed(points, fine, {x})
    release thm top:::T1_implies_closed_singletons(points, fine, x)

release thm top:::closed_singletons_imply_T1(points, fine)

release thm top:::two_point_subset_of_Hausdorff_is_closed(points, fine, 0, 1)

release thm top:::two_point_subset_of_Hausdorff_is_closed(points, fine, 0, 0)

release thm top:::finite_subsets_are_compact(points, fine, points)

$top:::is_compact_subset(points, fine, points)

by def $top:::is_compact_space(points, fine)

release thm top:::empty_is_compact(points, fine)

release thm top:::singleton_is_compact(points, fine, 0)

release thm top:::singleton_is_compact(points, fine, 1)

release thm top:::union_of_compact_subsets_is_compact(points, fine, {0}, {1})

have target_points set = {7}

7 $in target_points

release thm top:::discrete_topology_laws(target_points)

have target_space &top:::TopologicalSpace<target_points> = (target_points, power_set(target_points))

target_space.carrier = target_points

target_space.opens = power_set(target_points)

have fn collapse(x points) target_points = 7

collapse(0) = 7

collapse(1) = 7

release thm fn_set_member(collapse, fn(x fine.carrier) target_space.carrier)

release thm top:::maps_from_discrete_are_continuous(points, target_points, fine, target_space, collapse)

release thm top:::continuous_image_of_compact_is_compact(points, target_points, fine, target_space, collapse, {0})

$top:::is_compact_subset(target_points, target_space, fn_range(\top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>))

release thm fn_set_member(\top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>, fn(x {0}) target_space.carrier)

by extension:
    ? fn_range(\top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>) = {7}
    claim:
        ? forall y fn_range(\top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>):
            y $in {7}
        have by fn_preimage: x from y $in fn_range(\top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>)
        y = \top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>(x) = collapse(x) = 7
    claim:
        ? forall y {7}:
            y $in fn_range(\top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>)
        y = 7
        \top:::restricted_map<fine.carrier, target_space.carrier, collapse, {0}>(0) = collapse(0) = 7

$top:::is_compact_subset(target_points, target_space, {7})

claim:
    ? forall y target_space.carrier:
        exist x fine.carrier st {y = collapse(x)}
    y $in {7}
    y = 7
    witness exist x fine.carrier st {y = collapse(x)} from 0

by def $surjective(fine.carrier, target_space.carrier, collapse)

release thm top:::continuous_surjection_preserves_compactness(points, target_points, fine, target_space, collapse)

$top:::is_compact_space(target_points, target_space)

release thm top:::identity_is_homeomorphism(points, fine)

release thm top:::homeomorphism_preserves_Hausdorff(points, points, fine, fine, \top:::identity_map<fine.carrier>, \top:::identity_map<fine.carrier>)

release thm top:::homeomorphism_preserves_compactness(points, points, fine, fine, \top:::identity_map<fine.carrier>, \top:::identity_map<fine.carrier>)

release thm top:::indiscrete_topology_laws(R)

have coarse_real &top:::TopologicalSpace<R> = (R, union({{}}, {R}))

coarse_real.carrier = R

coarse_real.opens = union({{}}, {R})

claim:
    ? forall U coarse_real.opens:
        U = {} or U = coarse_real.carrier
    U $in union({{}}, {R})
    U $in {{}} or U $in {R}
    by cases:
        ? U = {} or U = coarse_real.carrier
        case U $in {{}}:
            U = {}
        case U $in {R}:
            U = R

by def $top:::has_only_trivial_opens(R, coarse_real)

release thm top:::trivial_open_space_is_compact(R, coarse_real)

$top:::is_compact_space(R, coarse_real)

not $is_finite_set(R)

by def $top:::is_T0(R, coarse_real)
