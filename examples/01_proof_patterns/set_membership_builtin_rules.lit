# Binary set membership rules checked directly by the verifier.

forall A, B set, x A:
    x $in union(A, B)

forall A, B set, x union(A, B):
    x $in A or x $in B

forall A, B set, x intersect(A, B):
    x $in A
    x $in B

forall A, B set, x set_minus(A, B):
    x $in A
    not x $in B

# Elementary subset and non-membership consequences are builtin rules too.

forall A, B set, x set:
    not x $in A
    =>:
        not x $in intersect(A, B)

# One literal set-builder layer may package a known conjunction. Each
# conjunct must already be available; the strategy does not invent bounds.

forall x R:
    0 <= x
    x <= 1
    =>:
        x $in {y R: 0 <= y and y <= 1}

# Membership lifts on demand through one directly known containing set.

forall B set, A power_set(B), x A:
    x $in B

forall A, B set, x A:
    B $superset A
    =>:
        x $in B

forall A, B set:
    intersect(A, B) $subset A
    intersect(A, B) $subset B
    A $subset union(A, B)
    B $subset union(A, B)
    set_minus(A, B) $subset A
    set_diff(A, B) = union(set_minus(A, B), set_minus(B, A))

# A subset is recovered by removing its relative complement from the container.

forall A, B set:
    B $subset A
    =>:
        B = set_minus(A, set_minus(A, B))
        set_minus(A, set_minus(A, B)) = B

# Together with finite set difference, this proves that every finite subset is finite.

forall A finite_set, B set:
    B $subset A
    =>:
        B = set_minus(A, set_minus(A, B))
        $is_finite_set(set_minus(A, set_minus(A, B)))
        $is_finite_set(B)

# Removing a finite set from an infinite set leaves an infinite set.

forall X set, s finite_set:
    not $is_finite_set(X)
    =>:
        not $is_finite_set(set_minus(X, s))

# Finite deletion cardinality is a builtin equality rule.

forall A, B finite_set:
    $is_finite_set(intersect(A, B))
    finite_set_size(set_minus(A, B)) = finite_set_size(A) - finite_set_size(intersect(A, B))

# The following cardinality identities and bounds are builtin rules.

forall A, B finite_set:
    B $subset A
    =>:
        finite_set_size(set_minus(A, B)) = finite_set_size(A) - finite_set_size(B)

forall A, B finite_set:
    $is_finite_set(intersect(A, B))
    $is_finite_set(set_minus(A, B))
    $is_finite_set(set_minus(B, A))
    $is_finite_set(union(A, B))
    $is_finite_set(set_diff(A, B))
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B))
    finite_set_size(A) = finite_set_size(intersect(A, B)) + finite_set_size(set_minus(A, B))
    finite_set_size(set_diff(A, B)) = finite_set_size(set_minus(A, B)) + finite_set_size(set_minus(B, A))
    intersect(A, B) $subset A
    finite_set_size(intersect(A, B)) <= finite_set_size(A)
    finite_set_size(union(A, B)) <= finite_set_size(A) + finite_set_size(B)
    finite_set_size(set_diff(A, B)) <= finite_set_size(A) + finite_set_size(B)
