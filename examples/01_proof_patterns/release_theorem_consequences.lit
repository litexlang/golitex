# Tracer: release every instantiated conclusion of a named theorem.
#
# Before (did not parse):
# release thm release_two_results(1)
# Former behavior: `release` was not a statement keyword.
#
# Now (verified): the active call below parses to the existing proofless
# ByThmStmt and stores both instantiated conclusions.

prop release_left(x R):
    x = 1

prop release_right(x R):
    x + 1 = 2

thm release_two_results:
    ? forall x R:
        x = 1
        =>:
            $release_left(x)
            $release_right(x)
    by def $release_left(x)
    x + 1 = 2
    by def $release_right(x)

release thm release_two_results(1)
$release_left(1)
$release_right(1)

# Boundary: `release thm ... => fact` and indented proof/goal bodies remain
# rejected; use `by thm ... => fact` to select one atomic consequence.
# Evidence: direct isolated-runner coverage plus the focused parser and runtime
# regressions for `release thm`.
