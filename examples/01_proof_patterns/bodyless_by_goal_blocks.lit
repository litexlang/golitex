# Tracer: bodyless `by ...:` goal blocks and inline theorem selection
#
# Boundary: selected theorem calls are not bodyless goal blocks:
# thm bodyless_zero_sides:
#     ? forall x R:
#         x + 0 = x
#         0 + x = x
#     x + 0 = x
#     0 + x = x
# by thm bodyless_zero_sides(2) => 2 + 0 = 0 + 2
#
# The theorem call uses its required inline selection; the remaining routes run
# zero user proof statements after their goal and perform final verification.

thm bodyless_zero_sides:
    ? forall x R:
        x + 0 = x
        0 + x = x

    x + 0 = x
    0 + x = x

by thm bodyless_zero_sides(2) => 2 + 0 = 0 + 2

by def:
    ? {1} $subset {1}

by extension:
    ? {1} = {1}

by enumerate finite_set:
    ? forall x {1, 2} => x $in {1, 2}

by for:
    ? forall n range(0, 3) => n < 3

by cases:
    ? 1 = 1
    case 1 = 1

by induc n from 0:
    ? n = n

by strong_induc m from 0:
    ? m = m

prop bodyless_same(x set, y set):
    x = y

by reflexive_prop:
    ? forall x set:
        $bodyless_same(x, x)

by symmetric_prop:
    ? forall x, y set:
        $bodyless_same(x, y)
        =>:
            $bodyless_same(y, x)

by transitive_prop:
    ? forall x, y, z set:
        $bodyless_same(x, y)
        $bodyless_same(y, z)
        =>:
            $bodyless_same(x, z)


# Boundary: `by contra` is the one goal-block route that still requires an
# explicit final `impossible` statement.
by contra:
    ? 1 = 1
    impossible 1 != 1

# An empty proof is not an admission: an unclosed target still fails. Executable
# negative regressions cover that rule and the missing-`impossible` rejection in
# `proof_control_and_choice.rs`.
