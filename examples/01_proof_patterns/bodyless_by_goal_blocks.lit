# Tracer: bodyless `by ...:` goal blocks
#
# Before (did not work for the selected-theorem route):
# thm bodyless_zero_sides:
#     ? forall x R:
#         x + 0 = x
#         0 + x = x
#     x + 0 = x
#     0 + x = x
# by thm bodyless_zero_sides(2):
#     ? 2 + 0 = 0 + 2
# Former behavior: `by thm does not accept an indented body`.
#
# Now (verified): each route below runs zero user proof statements after its
# goal and still performs the route's ordinary final verification.

thm bodyless_zero_sides:
    ? forall x R:
        x + 0 = x
        0 + x = x

    x + 0 = x
    0 + x = x

by thm bodyless_zero_sides(2):
    ? 2 + 0 = 0 + 2

by def:
    ? {1} $subset {1}

by extension:
    ? {1} = {1}

by enumerate finite_set:
    ? forall x {1, 2} => x $in {1, 2}

by for:
    ? forall n range(0, 3) => n < 3

by cases:
    ? 1 = 1
    case 1 = 1

by induc n from 0:
    ? n = n

by strong_induc m from 0:
    ? m = m

by induc P:
    ? P = P
    ? from P = {}
    ? induc x, S

prop bodyless_same(x set, y set):
    x = y

by reflexive_prop:
    ? forall x set:
        $bodyless_same(x, x)

by symmetric_prop:
    ? forall x, y set:
        $bodyless_same(x, y)
        =>:
            $bodyless_same(y, x)

by transitive_prop:
    ? forall x, y, z set:
        $bodyless_same(x, y)
        $bodyless_same(y, z)
        =>:
            $bodyless_same(x, z)

by antisymmetric_prop:
    ? forall x, y set:
        $bodyless_same(x, y)
        $bodyless_same(y, x)
        =>:
            x = y

# Boundary: `by contra` is the one goal-block route that still requires an
# explicit final `impossible` statement.
by contra:
    ? 1 = 1
    impossible 1 != 1

# An empty proof is not an admission: an unclosed target still fails. Executable
# negative regressions cover that rule and the missing-`impossible` rejection in
# `proof_control_and_choice.rs`.
