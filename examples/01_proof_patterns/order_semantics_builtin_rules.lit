# Direct order semantics provided by the verifier, with no imported theory package.

forall a, b, c R:
    a <= b
    b < c
    =>:
        a < c

# Negative and nonpositive real terms remain negative or nonpositive under addition.
forall a, b R:
    a < 0
    b <= 0
    =>:
        a + b < 0

forall a, b R:
    a <= 0
    b <= 0
    =>:
        a + b <= 0

forall a, b, c Z:
    a <= b
    b <= c
    =>:
        a <= c

forall a, b R:
    a <= finite_set_max(union({a}, { b}))
    b <= finite_set_max(union({a}, { b}))
    finite_set_min(union({a}, { b})) <= a
    finite_set_min(union({a}, { b})) <= b

forall a, b, c R:
    a <= c
    b <= c
    =>:
        finite_set_max(union({a}, { b})) <= c

forall a, b, c R:
    c <= a
    c <= b
    =>:
        c <= finite_set_min(union({a}, { b}))

# Known equality aliases preserve the extremum bounds.
# Example: `selected_max = finite_set_max({n1, n2})` bounds both members.
have n1 R = 1
have n2 R = 2
have selected_max R = finite_set_max({n1, n2})

# Structural sign reasoning removes a quotient, then proves the numerator and
# denominator signs independently.
forall a, b R:
    a > b
    =>:
        (a - b) / 2 $in R+

# A positive radius places the center in its symmetric open interval.
forall center R, radius R+:
    center $in '(center - radius, center + radius)
selected_max >= n1
selected_max >= n2

have selected_min R = finite_set_min({n1, n2})
selected_min <= n1
selected_min <= n2

forall a, b Z:
    a < b
    =>:
        a + 1 <= b
        a <= b - 1

forall x, n Z:
    x <= n or x >= n + 1

forall x, n Z:
    n <= x
    x < n + 1
    =>:
        x = n
