# This teaching example constructs gcd from the largest positive common divisor.
# Ordinary user code should call the native `gcd(a, b)` object directly.
import std basics

thm positive_divisor_le_abs:
    ? forall d N+, a Z:
        $basics::divides(d, a)
        a != 0
        =>:
            d <= abs(a)
    obtain k from exist k Z st {a = d * k}
    by contra:
        ? k != 0
        k = 0
        a = d * k = d * 0 = 0
        impossible a != 0
    abs(k) > 0
    abs(k) $in N+
    d * 1 <= d * abs(k)
    abs(d) = d
    abs(a) = abs(d * k) = abs(d) * abs(k) = d * abs(k)
    d = d * 1 <= d * abs(k) = abs(a)

thm common_divisor_set_is_finite_and_nonempty:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $is_finite_set({d N+: $basics::divides(d, a), $basics::divides(d, b)})
            $is_nonempty_set({d N+: $basics::divides(d, a), $basics::divides(d, b)})
    have c power_set(N) = {d N+: $basics::divides(d, a), $basics::divides(d, b)}
    claim:
        ? $is_finite_set(c)
        by cases:
            ? $is_finite_set(c)
            case a != 0:
                claim:
                    ? forall d c:
                        d $in closed_range(1, abs(a))
                    d $in c
                    d $in N+
                    d >= 1
                    $basics::divides(d, a)
                    by thm positive_divisor_le_abs(d, a)
                    d $in closed_range(1, abs(a))
                by def:
                    ? c $subset closed_range(1, abs(a))
                by thm basics::subset_of_finite_set_is_finite(c, closed_range(1, abs(a)))
            case b != 0:
                claim:
                    ? forall d c:
                        d $in closed_range(1, abs(b))
                    d $in c
                    d $in N+
                    d >= 1
                    $basics::divides(d, b)
                    by thm positive_divisor_le_abs(d, b)
                    d $in closed_range(1, abs(b))
                by def:
                    ? c $subset closed_range(1, abs(b))
                by thm basics::subset_of_finite_set_is_finite(c, closed_range(1, abs(b)))
    witness $is_nonempty_set(c) from 1:
        1 $in N+
        witness exist k Z st {a = 1 * k} from a:
            a = 1 * a
        by def:
            ? $basics::divides(1, a)
        witness exist k Z st {b = 1 * k} from b:
            b = 1 * b
        by def:
            ? $basics::divides(1, b)
        by thm set_builder_member(1, {d N+: $basics::divides(d, a), $basics::divides(d, b)})
        1 $in c
    $is_finite_set({d N+: $basics::divides(d, a), $basics::divides(d, b)})
    $is_nonempty_set({d N+: $basics::divides(d, a), $basics::divides(d, b)})

have fn gcd_from_finite_divisors(a, b Z: a != 0 or b != 0) N = finite_set_max({d N+: $basics::divides(d, a), $basics::divides(d, b)})

thm gcd_from_finite_divisors_eq_native:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd_from_finite_divisors(a, b) = gcd(a, b)
    by thm common_divisor_set_is_finite_and_nonempty(a, b)
    gcd_from_finite_divisors(a, b) = finite_set_max({d N+: $basics::divides(d, a), $basics::divides(d, b)})
    finite_set_max({d N+: $basics::divides(d, a), $basics::divides(d, b)}) $in {d N+: $basics::divides(d, a), $basics::divides(d, b)}
    gcd_from_finite_divisors(a, b) $in {d N+: $basics::divides(d, a), $basics::divides(d, b)}
    $basics::divides(gcd_from_finite_divisors(a, b), a)
    $basics::divides(gcd_from_finite_divisors(a, b), b)
    obtain ka from exist k Z st {a = gcd_from_finite_divisors(a, b) * k}
    obtain kb from exist k Z st {b = gcd_from_finite_divisors(a, b) * k}
    a % gcd_from_finite_divisors(a, b) = (gcd_from_finite_divisors(a, b) * ka) % gcd_from_finite_divisors(a, b) = 0
    b % gcd_from_finite_divisors(a, b) = (gcd_from_finite_divisors(a, b) * kb) % gcd_from_finite_divisors(a, b) = 0
    gcd_from_finite_divisors(a, b) <= gcd(a, b)
    gcd(a, b) $in N+
    a % gcd(a, b) = 0
    b % gcd(a, b) = 0
    by def:
        ? $basics::divides(gcd(a, b), a)
    by def:
        ? $basics::divides(gcd(a, b), b)
    by thm set_builder_member(gcd(a, b), {d N+: $basics::divides(d, a), $basics::divides(d, b)})
    gcd(a, b) <= finite_set_max({d N+: $basics::divides(d, a), $basics::divides(d, b)})
    gcd(a, b) <= gcd_from_finite_divisors(a, b)
    gcd_from_finite_divisors(a, b) = gcd(a, b)
