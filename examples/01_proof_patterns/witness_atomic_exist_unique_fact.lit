# Boundary tracer: named atomic-fact witnesses intentionally stop at ordinary
# positive `exist`. The formerly accepted named `exist!` form is preserved as
# comments:
#
# witness $unique_value(2) from 2:
#     2 = 2
#     claim:
#         ? forall u, v R:
#             u = 2
#             v = 2
#             =>:
#                 u = v
#         u = 2
#         2 = v
#         u = v
#
# Use the explicit unique-existence statement and fold the checked result into
# the named predicate with `by def`.

prop unique_value(a R):
    exist! x R st {x = a}

witness exist! x R st {x = 2} from 2:
    2 = 2
    claim:
        ? forall u, v R:
            u = 2
            v = 2
            =>:
                u = v
        u = 2
        2 = v
        u = v

by def:
    ? $unique_value(2)

$unique_value(2)
exist! x R st {x = 2}

# Boundary: `witness $unique_value(2) from 2` is rejected even if its proof body
# contains a complete uniqueness proof. Explicit `witness exist!` remains the
# supported route.
# Evidence: target/release/litex -compact -isolated -runner -f examples/01_proof_patterns/witness_atomic_exist_unique_fact.lit
