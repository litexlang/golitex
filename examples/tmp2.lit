abstract_prop p(a, b, c)

forall a, a2, b, b2, c, c2 set:
    b = b2
    a = a2
    $p(a, b, c)
    c = c2
    =>:
        $p(a2, b2, c2)


"""
import Mathlib

namespace tmp2

noncomputable section

universe u

abbrev LitexFact := Prop

class LitexObject (α : Type u) : Prop where
  valid : True

instance : LitexObject ℕ := ⟨True.intro⟩
instance : LitexObject ℤ := ⟨True.intro⟩
instance : LitexObject ℚ := ⟨True.intro⟩
instance : LitexObject ℝ := ⟨True.intro⟩
instance : LitexObject ℂ := ⟨True.intro⟩
instance {α : Type u} [LitexObject α] : LitexObject (Set α) := ⟨True.intro⟩

def litexIsSet {α : Type u} [LitexObject α] (_ : α) : Prop := True
def litexIsNonemptySet {α : Type u} (set : Set α) : Prop := set.Nonempty
def litexIsFiniteSet {α : Type u} (set : Set α) : Prop := set.Finite

end

opaque p {litex_arg_carrier_1 : Type u} [LitexObject litex_arg_carrier_1] {litex_arg_carrier_2 : Type u} [LitexObject litex_arg_carrier_2] {litex_arg_carrier_3 : Type u} [LitexObject litex_arg_carrier_3] : litex_arg_carrier_1 → litex_arg_carrier_2 → litex_arg_carrier_3 → LitexFact

-- Litex stored fact f34
theorem global_fact_34 : ∀ {litex_carrier_1 : Type u} [LitexObject litex_carrier_1], ∀ (a : Set litex_carrier_1), ∀ (a2 : Set litex_carrier_1), ∀ (b : Set litex_carrier_1), ∀ (b2 : Set litex_carrier_1), ∀ (c : Set litex_carrier_1), ∀ (c2 : Set litex_carrier_1), b = b2 → a = a2 → p a b c → c = c2 → p a2 b2 c2 := by
  intro _ _ a a2 b b2 c c2 proof_fact_1_1 proof_fact_1_2 proof_fact_1_3 proof_fact_1_4
  have proof_fact_1_5 : p a b c := proof_fact_1_3
  have proof_fact_1_6 : a = a2 := proof_fact_1_2
  have proof_fact_1_7 : b = b2 := proof_fact_1_1
  have proof_fact_1_8 : c = c2 := proof_fact_1_4
  have proof_fact_1_9 : p a2 b2 c2 := by
    simpa only [proof_fact_1_6, proof_fact_1_7, proof_fact_1_8] using proof_fact_1_5
  exact proof_fact_1_9

end tmp2
