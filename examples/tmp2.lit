abstract_prop p(a, b, c)

forall a, a2, b, b2, c, c2 set:
    b = b2
    a = a2
    $p(a, b, c)
    c = c2
    =>:
        $p(a2, b2, c2)


"""
import Mathlib

universe uLitex

namespace tmp2

-- Litex's primitive notion of a set.
abbrev LitexSet := Type uLitex

-- Every generated proposition has this codomain.
abbrev LitexFact := Prop

opaque p {α_a_1 α_b_2 α_c_3 : Sort uLitex} : α_a_1 → α_b_2 → α_c_3 → LitexFact

-- Litex stored fact f34
theorem global_fact_34 : ∀ (a a2 b b2 c c2 : LitexSet), b = b2 → a = a2 → p a b c → c = c2 → p a2 b2 c2 := by
  intro a a2 b b2 c c2 proof_fact_1_1 proof_fact_1_2 proof_fact_1_3 proof_fact_1_4
  have proof_fact_1_5 : p a b c := proof_fact_1_3
  have proof_fact_1_6 : a = a2 := proof_fact_1_2
  have proof_fact_1_7 : b = b2 := proof_fact_1_1
  have proof_fact_1_8 : c = c2 := proof_fact_1_4
  have proof_fact_1_9 : p a2 b2 c2 := by
    simpa only [proof_fact_1_6, proof_fact_1_7, proof_fact_1_8] using proof_fact_1_5
  exact proof_fact_1_9

end tmp2
"""
