# Obj WD: top-level ReplacementImage (ZF Replacement surface).
# Syntax: replacement_image(P, A) — P is a prop name, A is the source set.
# Forming the object requires a known uniqueness forall of P over A.
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_wd/obj/replacement_image.lit

abstract_prop image_rel(x, y)

trust:
    forall x {1, 2}, y, y2 set:
        $image_rel(x, y)
        $image_rel(x, y2)
        =>:
            y = y2

let img = replacement_image(image_rel, {1, 2})
