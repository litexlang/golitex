thm collision_bound_missing_equal_images:
    ? forall X, Y finite_set, f fn(x X) Y, point, duplicate X:
        $surjective(X, Y, f)
        point != duplicate
        =>:
            finite_set_size(Y) < finite_set_size(X)
    release thm comb:::surjection_collision_strict_size(X,Y,f,point,duplicate)
