# Actual Bernoulli equality and nonconstant Dirac zero-variance cases.

release thm prob::main::uniform_probability_laws({0,1})

\prob::main::uniform_probability_space<{0,1}> = ({0,1},\prob::main::uniform_event_probability<{0,1}>)

have fair &prob::main::FiniteProbabilitySpace<{0,1}> = \prob::main::uniform_probability_space<{0,1}>

release struct def fair

fair = ({0,1},\prob::main::uniform_event_probability<{0,1}>)

fair.carrier = {0,1}

fair.prob = \prob::main::uniform_event_probability<{0,1}>

fair.carrier $subset R

0 $in fair.carrier

1 $in fair.carrier

fair.prob({0}) = \prob::main::uniform_event_probability<{0,1}>({0}) = 1/2

fair.prob({1}) = \prob::main::uniform_event_probability<{0,1}>({1}) = 1/2

have fn bit(k fair.carrier) R = k

have fn weighted(k fair.carrier) R = bit(k)*fair.prob({k})

weighted(0) = bit(0)*fair.prob({0}) = 0*(1/2) = 0

weighted(1) = bit(1)*fair.prob({1}) = 1*(1/2) = 1/2

release thm finite_set_sum_substitution(finite_set_sum(fair.carrier,fn(k fair.carrier) R {bit(k)*fair.prob({k})}),finite_set_sum(fair.carrier,weighted))

finite_set_sum(fair.carrier,weighted) = finite_set_sum({0,1},weighted) = weighted(0)+weighted(1) = 1/2

release thm prob::main::finite_expectation_formula({0,1},fair,bit)

\prob::main::finite_expectation<{0,1},fair>(bit) = finite_set_sum(fair.carrier,fn(k fair.carrier) R {bit(k)*fair.prob({k})}) = finite_set_sum(fair.carrier,weighted) = 1/2

bit(0) = 0

bit(1) = 1

by enumerate finite_set:
    ? forall k {0,1}:
        bit(k)^2 = bit(k)
    bit(k) = k
    k^2 = k
    bit(k)^2 = k^2 = k = bit(k)

have fn bit_square(k fair.carrier) R = bit(k)^2

claim:
    ? forall k fair.carrier:
        bit_square(k) = bit(k)
    k $in {0,1}
    bit_square(k) = bit(k)^2 = bit(k)

release thm prob::main::finite_expectation_extensional({0,1},fair,bit_square,bit)

release thm prob::main::finite_expectation_extensional({0,1},fair,bit_square,fn(k fair.carrier) R {bit(k)^2})

\prob::main::finite_expectation<{0,1},fair>(fn(k fair.carrier) R {bit(k)^2}) = \prob::main::finite_expectation<{0,1},fair>(bit) = 1/2

release thm prob::main::finite_variance_second_moment({0,1},fair,bit)

thm variance_from_moments:
    ? forall mean,second,result,a,b R:
        result = second-mean^2
        second = a
        mean = b
        =>:
            result = a-b^2
    result = second-mean^2 = a-mean^2 = a-b^2

release thm variance_from_moments(\prob::main::finite_expectation<{0,1},fair>(bit),\prob::main::finite_expectation<{0,1},fair>(fn(k fair.carrier) R {bit(k)^2}),\prob::main::finite_variance<{0,1},fair>(bit),1/2,1/2)

\prob::main::finite_variance<{0,1},fair>(bit) = 1/2-(1/2)^2 = 1/4

have fn affine(k fair.carrier) R = 2*bit(k)+1

have fn one(k fair.carrier) R = 1

claim:
    ? forall k fair.carrier:
        affine(k) = 2*bit(k)+1*one(k)
    one(k) = 1
    affine(k) = 2*bit(k)+1 = 2*bit(k)+1*one(k)

release thm prob::main::finite_covariance_self({0,1},fair,bit)

release thm prob::main::finite_covariance_of_constant_left({0,1},fair,one,bit,1)

release thm prob::main::finite_covariance_symmetric({0,1},fair,bit,one)

release thm prob::main::finite_covariance_of_linear_combination_right({0,1},fair,bit,bit,one,affine,2,1)

\prob::main::finite_covariance<{0,1},fair>(bit,affine) = 2*\prob::main::finite_covariance<{0,1},fair>(bit,bit)+1*\prob::main::finite_covariance<{0,1},fair>(bit,one) = 2*(1/4)+1*0 = 1/2

release thm prob::main::finite_variance_of_affine({0,1},fair,bit,affine,2,1)

\prob::main::finite_variance<{0,1},fair>(affine) = 2^2*\prob::main::finite_variance<{0,1},fair>(bit) = 4*(1/4) = 1

release thm prob::main::finite_covariance_square_bound({0,1},fair,bit,affine)

\prob::main::finite_covariance<{0,1},fair>(bit,affine)^2 = (1/2)^2 = 1/4

\prob::main::finite_variance<{0,1},fair>(bit)*\prob::main::finite_variance<{0,1},fair>(affine) = (1/4)*1 = 1/4

release thm prob::main::finite_variance_parallelogram({0,1},fair,bit,affine)

release thm prob::main::finite_variance_add_bound({0,1},fair,bit,bit)

release thm prob::main::finite_variance_subtract_bound({0,1},fair,bit,affine)

release thm prob::main::finite_variance_add({0,1},fair,bit,bit)

\prob::main::finite_variance<{0,1},fair>(fn(k fair.carrier) R {bit(k)+bit(k)}) = \prob::main::finite_variance<{0,1},fair>(bit)+2*\prob::main::finite_covariance<{0,1},fair>(bit,bit)+\prob::main::finite_variance<{0,1},fair>(bit) = 1/4+2*(1/4)+1/4 = 1

release thm prob::main::dirac_probability_laws({0,1},1)

\prob::main::dirac_probability_space<{0,1},1> = ({0,1},\prob::main::dirac_event_probability<{0,1},1>)

have mass &prob::main::FiniteProbabilitySpace<{0,1}> = \prob::main::dirac_probability_space<{0,1},1>

release struct def mass

mass = ({0,1},\prob::main::dirac_event_probability<{0,1},1>)

mass.carrier = {0,1}

mass.prob = \prob::main::dirac_event_probability<{0,1},1>

mass.carrier $subset R

0 $in mass.carrier

1 $in mass.carrier

release thm prob::main::dirac_event_excludes({0,1},1,{0})

release thm prob::main::dirac_event_contains({0,1},1,{1})

mass.prob({0}) = 0

mass.prob({1}) = 1

have fn observed(k mass.carrier) R = k

have fn mass_weighted(k mass.carrier) R = observed(k)*mass.prob({k})

mass_weighted(0) = observed(0)*mass.prob({0}) = 0*0 = 0

mass_weighted(1) = observed(1)*mass.prob({1}) = 1*1 = 1

release thm finite_set_sum_substitution(finite_set_sum(mass.carrier,fn(k mass.carrier) R {observed(k)*mass.prob({k})}),finite_set_sum(mass.carrier,mass_weighted))

finite_set_sum(mass.carrier,mass_weighted) = finite_set_sum({0,1},mass_weighted) = mass_weighted(0)+mass_weighted(1) = 1

release thm prob::main::finite_expectation_formula({0,1},mass,observed)

\prob::main::finite_expectation<{0,1},mass>(observed) = finite_set_sum(mass.carrier,fn(k mass.carrier) R {observed(k)*mass.prob({k})}) = finite_set_sum(mass.carrier,mass_weighted) = 1

observed(0) = 0

observed(1) = 1

by enumerate finite_set:
    ? forall k {0,1}:
        observed(k)^2 = observed(k)
    observed(k) = k
    k^2 = k
    observed(k)^2 = k^2 = k = observed(k)

have fn observed_square(k mass.carrier) R = observed(k)^2

claim:
    ? forall k mass.carrier:
        observed_square(k) = observed(k)
    k $in {0,1}
    observed_square(k) = observed(k)^2 = observed(k)

release thm prob::main::finite_expectation_extensional({0,1},mass,observed_square,observed)

release thm prob::main::finite_expectation_extensional({0,1},mass,observed_square,fn(k mass.carrier) R {observed(k)^2})

\prob::main::finite_expectation<{0,1},mass>(fn(k mass.carrier) R {observed(k)^2}) = \prob::main::finite_expectation<{0,1},mass>(observed) = 1

release thm prob::main::finite_variance_second_moment({0,1},mass,observed)

release thm variance_from_moments(\prob::main::finite_expectation<{0,1},mass>(observed),\prob::main::finite_expectation<{0,1},mass>(fn(k mass.carrier) R {observed(k)^2}),\prob::main::finite_variance<{0,1},mass>(observed),1,1)

\prob::main::finite_variance<{0,1},mass>(observed) = 1-1^2 = 0

observed(0) = 0

observed(1) = 1

observed(0) != observed(1)

have fn perturbed(k mass.carrier) R = 100-99*k

release thm prob::main::finite_covariance_zero_variance_left({0,1},mass,observed,perturbed)

release thm prob::main::finite_covariance_zero_variance_right({0,1},mass,perturbed,observed)

release thm prob::main::finite_covariance_square_bound({0,1},mass,observed,perturbed)
