thm zero_covariance_is_required:
    ? forall Omega set,space &prob::main::FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \prob::main::finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = \prob::main::finite_variance<Omega,space>(X)+\prob::main::finite_variance<Omega,space>(Y)
    release thm prob::main::finite_variance_add_uncorrelated(Omega,space,X,Y)
