# Tracer: actual uniform probabilities on six outcomes.
# Before: no std/probability event interface was available.
# Now: P(even)=1/2, P(>3)=1/2, P(even intersect >3)=1/3.
# Boundary: bundled uniform-space construction and its conditional2/3
# consumer remain unfinished; this file does not stand in for that model.
# Generic event/conditional/Bayes signatures are checked in contracts/.
# Evidence: target/release/litex -lang en -strict -f examples/probability/finite_events/main.lit

{2,4,6} $subset {1,2,3,4,5,6}

{2,4,6} $in power_set({1,2,3,4,5,6})

{4,5,6} $subset {1,2,3,4,5,6}

{4,5,6} $in power_set({1,2,3,4,5,6})

intersect({2,4,6},{4,5,6}) $in power_set({1,2,3,4,5,6})

\prob::main::uniform_event_probability<{1,2,3,4,5,6}>({2,4,6}) = 1/2

by extension:
    ? intersect({2,4,6},{4,5,6}) = {4,6}
    by enumerate finite_set:
        ? forall x {2,4,6}:
            x $in {4,5,6}
            =>:
                x $in {4,6}
        x $in {4,6}
    claim:
        ? forall x intersect({2,4,6},{4,5,6}):
            x $in {4,6}
        x $in {2,4,6}
        x $in {4,5,6}
    {4,6} $subset {2,4,6}
    {4,6} $subset {4,5,6}
    claim:
        ? forall x {4,6}:
            x $in intersect({2,4,6},{4,5,6})
        x $in {2,4,6}
        x $in {4,5,6}

finite_set_size(intersect({2,4,6},{4,5,6})) = finite_set_size({4,6}) = 2

\prob::main::uniform_event_probability<{1,2,3,4,5,6}>(intersect({2,4,6},{4,5,6})) = finite_set_size(intersect({2,4,6},{4,5,6})) / finite_set_size({1,2,3,4,5,6})

finite_set_size({1,2,3,4,5,6}) = 6

\prob::main::uniform_event_probability<{1,2,3,4,5,6}>(intersect({2,4,6},{4,5,6})) = finite_set_size(intersect({2,4,6},{4,5,6})) / finite_set_size({1,2,3,4,5,6}) = 2 / 6 = 1/3

\prob::main::uniform_event_probability<{1,2,3,4,5,6}>({4,5,6}) = 1/2

release thm prob::main::uniform_event_normalization({1,2,3,4,5,6})

release thm prob::main::uniform_event_normalization({0})

\prob::main::uniform_event_probability<N>({0}) = 0
