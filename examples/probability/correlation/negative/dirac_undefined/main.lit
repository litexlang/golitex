release thm prob::main::uniform_probability_laws({0,1})

\prob::main::uniform_probability_space<{0,1}> = ({0,1},\prob::main::uniform_event_probability<{0,1}>)

have fair &prob::main::FiniteProbabilitySpace<{0,1}> = \prob::main::uniform_probability_space<{0,1}>

release struct def fair

fair = ({0,1},\prob::main::uniform_event_probability<{0,1}>)

fair.carrier = {0,1}

fair.prob = \prob::main::uniform_event_probability<{0,1}>

fair.carrier $subset R

0 $in fair.carrier

1 $in fair.carrier

fair.prob({0}) = \prob::main::uniform_event_probability<{0,1}>({0}) = 1/2

fair.prob({1}) = \prob::main::uniform_event_probability<{0,1}>({1}) = 1/2

have fn bit(k fair.carrier) R = k

have fn weighted(k fair.carrier) R = bit(k)*fair.prob({k})

weighted(0) = bit(0)*fair.prob({0}) = 0*(1/2) = 0

weighted(1) = bit(1)*fair.prob({1}) = 1*(1/2) = 1/2

release thm finite_set_sum_substitution(finite_set_sum(fair.carrier,fn(k fair.carrier) R {bit(k)*fair.prob({k})}),finite_set_sum(fair.carrier,weighted))

finite_set_sum(fair.carrier,weighted) = finite_set_sum({0,1},weighted) = weighted(0)+weighted(1) = 1/2

release thm prob::main::finite_expectation_formula({0,1},fair,bit)

\prob::main::finite_expectation<{0,1},fair>(bit) = finite_set_sum(fair.carrier,fn(k fair.carrier) R {bit(k)*fair.prob({k})}) = finite_set_sum(fair.carrier,weighted) = 1/2

bit(0) = 0

bit(1) = 1

by enumerate finite_set:
    ? forall k {0,1}:
        bit(k)^2 = bit(k)
    bit(k) = k
    k^2 = k
    bit(k)^2 = k^2 = k = bit(k)

have fn bit_square(k fair.carrier) R = bit(k)^2

claim:
    ? forall k fair.carrier:
        bit_square(k) = bit(k)
    k $in {0,1}
    bit_square(k) = bit(k)^2 = bit(k)

release thm prob::main::finite_expectation_extensional({0,1},fair,bit_square,bit)

release thm prob::main::finite_expectation_extensional({0,1},fair,bit_square,fn(k fair.carrier) R {bit(k)^2})

\prob::main::finite_expectation<{0,1},fair>(fn(k fair.carrier) R {bit(k)^2}) = \prob::main::finite_expectation<{0,1},fair>(bit) = 1/2

release thm prob::main::finite_variance_second_moment({0,1},fair,bit)

thm variance_from_moments:
    ? forall mean,second,result,a,b R:
        result = second-mean^2
        second = a
        mean = b
        =>:
            result = a-b^2
    result = second-mean^2 = a-mean^2 = a-b^2

release thm variance_from_moments(\prob::main::finite_expectation<{0,1},fair>(bit),\prob::main::finite_expectation<{0,1},fair>(fn(k fair.carrier) R {bit(k)^2}),\prob::main::finite_variance<{0,1},fair>(bit),1/2,1/2)

\prob::main::finite_variance<{0,1},fair>(bit) = 1/2-(1/2)^2 = 1/4

have fn signed(k fair.carrier) R = -bit(k)

claim:
    ? forall k fair.carrier:
        signed(k) = (-1)*bit(k)+0
    signed(k) = -bit(k) = (-1)*bit(k)+0

claim:
    ? forall k fair.carrier:
        signed(k) = (-1)*bit(k)+0*bit(k)
    signed(k) = -bit(k) = (-1)*bit(k)+0*bit(k)

release thm prob::main::finite_expectation_of_linear_combination({0,1},fair,bit,bit,signed,-1,0)

\prob::main::finite_expectation<{0,1},fair>(signed) = (-1)*(1/2)+0*(1/2) = -1/2

release thm prob::main::finite_variance_of_affine({0,1},fair,bit,signed,-1,0)

\prob::main::finite_variance<{0,1},fair>(signed) = (-1)^2*(1/4) = 1/4

signed(1) = -bit(1) = -1 < 0

\prob::main::finite_variance<{0,1},fair>(bit) = 1/4 > 0

\prob::main::finite_variance<{0,1},fair>(signed) = 1/4 > 0

release thm prob::main::finite_correlation_self({0,1},fair,bit)

\prob::main::finite_correlation<{0,1},fair>(bit,bit) = 1

release thm prob::main::finite_covariance_self({0,1},fair,bit)

\prob::main::finite_covariance<{0,1},fair>(bit,bit) = \prob::main::finite_variance<{0,1},fair>(bit) = 1/4

release thm prob::main::finite_covariance_of_linear_combination_right({0,1},fair,bit,bit,bit,signed,-1,0)

\prob::main::finite_covariance<{0,1},fair>(bit,signed) = (-1)*\prob::main::finite_covariance<{0,1},fair>(bit,bit)+0*\prob::main::finite_covariance<{0,1},fair>(bit,bit) = (-1)*(1/4)+0*(1/4) = -1/4

\prob::main::finite_variance<{0,1},fair>(bit)*\prob::main::finite_variance<{0,1},fair>(signed) = (1/4)*(1/4) = 1/16

sqrt(\prob::main::finite_variance<{0,1},fair>(bit)*\prob::main::finite_variance<{0,1},fair>(signed)) = sqrt(1/16) = 1/4

release thm prob::main::finite_correlation_formula({0,1},fair,bit,signed)

\prob::main::finite_correlation<{0,1},fair>(bit,signed) = \prob::main::finite_covariance<{0,1},fair>(bit,signed)/sqrt(\prob::main::finite_variance<{0,1},fair>(bit)*\prob::main::finite_variance<{0,1},fair>(signed)) = (-1/4)/(1/4) = -1

release thm prob::main::finite_correlation_symmetric({0,1},fair,bit,signed)

\prob::main::finite_correlation<{0,1},fair>(signed,bit) = \prob::main::finite_correlation<{0,1},fair>(bit,signed) = -1

release thm prob::main::finite_correlation_abs_bound({0,1},fair,bit,signed)

abs(\prob::main::finite_correlation<{0,1},fair>(bit,signed)) = abs(-1) = 1

release thm prob::main::finite_correlation_bounds({0,1},fair,bit,signed)

have fn constant(k fair.carrier) R = 5

forall k fair.carrier:
    constant(k) = 5

release thm prob::main::finite_variance_of_constant({0,1},fair,constant,5)

\prob::main::finite_variance<{0,1},fair>(constant) = 0

release thm prob::main::uniform_probability_laws({0,1,2})

\prob::main::uniform_probability_space<{0,1,2}> = ({0,1,2},\prob::main::uniform_event_probability<{0,1,2}>)

have thirds &prob::main::FiniteProbabilitySpace<{0,1,2}> = \prob::main::uniform_probability_space<{0,1,2}>

release struct def thirds

thirds = ({0,1,2},\prob::main::uniform_event_probability<{0,1,2}>)

thirds.carrier = {0,1,2}

thirds.prob = \prob::main::uniform_event_probability<{0,1,2}>

thirds.carrier $subset R

0 $in thirds.carrier

claim:
    ? thirds.prob({0}) = 1/3
    finite_set_size({0,1,2}) = 3
    finite_set_size({0}) = 1
    thirds.prob({0}) = \prob::main::uniform_event_probability<{0,1,2}>({0}) = finite_set_size({0})/finite_set_size({0,1,2}) = 1/3

1 $in thirds.carrier

claim:
    ? thirds.prob({1}) = 1/3
    finite_set_size({0,1,2}) = 3
    finite_set_size({1}) = 1
    thirds.prob({1}) = \prob::main::uniform_event_probability<{0,1,2}>({1}) = finite_set_size({1})/finite_set_size({0,1,2}) = 1/3

2 $in thirds.carrier

claim:
    ? thirds.prob({2}) = 1/3
    finite_set_size({0,1,2}) = 3
    finite_set_size({2}) = 1
    thirds.prob({2}) = \prob::main::uniform_event_probability<{0,1,2}>({2}) = finite_set_size({2})/finite_set_size({0,1,2}) = 1/3

have fn u(k thirds.carrier) R = k-1

have fn v(k thirds.carrier) R = (k-1)^2

u(0) = -1

v(0) = 1

u(1) = 0

v(1) = 0

u(2) = 1

v(2) = 1

have fn weight_u(k thirds.carrier) R = u(k)*thirds.prob({k})

weight_u(0) = u(0)*thirds.prob({0}) = (-1)*(1/3) = -1/3

weight_u(1) = u(1)*thirds.prob({1}) = (0)*(1/3) = 0/3

weight_u(2) = u(2)*thirds.prob({2}) = (1)*(1/3) = 1/3

finite_set_sum(thirds.carrier,weight_u) = finite_set_sum({0,1,2},weight_u) = weight_u(0)+weight_u(1)+weight_u(2) = 0

release thm finite_set_sum_substitution(finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {u(k)*thirds.prob({k})}),finite_set_sum(thirds.carrier,weight_u))

release thm prob::main::finite_expectation_formula({0,1,2},thirds,u)

\prob::main::finite_expectation<{0,1,2},thirds>(u) = finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {u(k)*thirds.prob({k})}) = finite_set_sum(thirds.carrier,weight_u) = 0

have fn weight_v(k thirds.carrier) R = v(k)*thirds.prob({k})

weight_v(0) = v(0)*thirds.prob({0}) = (1)*(1/3) = 1/3

weight_v(1) = v(1)*thirds.prob({1}) = (0)*(1/3) = 0/3

weight_v(2) = v(2)*thirds.prob({2}) = (1)*(1/3) = 1/3

finite_set_sum(thirds.carrier,weight_v) = finite_set_sum({0,1,2},weight_v) = weight_v(0)+weight_v(1)+weight_v(2) = 2/3

release thm finite_set_sum_substitution(finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {v(k)*thirds.prob({k})}),finite_set_sum(thirds.carrier,weight_v))

release thm prob::main::finite_expectation_formula({0,1,2},thirds,v)

\prob::main::finite_expectation<{0,1,2},thirds>(v) = finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {v(k)*thirds.prob({k})}) = finite_set_sum(thirds.carrier,weight_v) = 2/3

have fn term_u_square(k thirds.carrier) R = u(k)^2

have fn weight_u_square(k thirds.carrier) R = term_u_square(k)*thirds.prob({k})

claim:
    ? weight_u_square(0) = 1/3
    term_u_square(0) = u(0)^2 = (-1)^2 = 1
    weight_u_square(0) = term_u_square(0)*thirds.prob({0}) = (1)*(1/3) = 1/3

claim:
    ? weight_u_square(1) = 0/3
    term_u_square(1) = u(1)^2 = (0)^2 = 0
    weight_u_square(1) = term_u_square(1)*thirds.prob({1}) = (0)*(1/3) = 0/3

claim:
    ? weight_u_square(2) = 1/3
    term_u_square(2) = u(2)^2 = (1)^2 = 1
    weight_u_square(2) = term_u_square(2)*thirds.prob({2}) = (1)*(1/3) = 1/3

finite_set_sum(thirds.carrier,weight_u_square) = finite_set_sum({0,1,2},weight_u_square) = weight_u_square(0)+weight_u_square(1)+weight_u_square(2) = 2/3

release thm finite_set_sum_substitution(finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {term_u_square(k)*thirds.prob({k})}),finite_set_sum(thirds.carrier,weight_u_square))

release thm prob::main::finite_expectation_formula({0,1,2},thirds,term_u_square)

\prob::main::finite_expectation<{0,1,2},thirds>(term_u_square) = finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {term_u_square(k)*thirds.prob({k})}) = finite_set_sum(thirds.carrier,weight_u_square) = 2/3

have fn term_v_square(k thirds.carrier) R = v(k)^2

have fn weight_v_square(k thirds.carrier) R = term_v_square(k)*thirds.prob({k})

claim:
    ? weight_v_square(0) = 1/3
    term_v_square(0) = v(0)^2 = (1)^2 = 1
    weight_v_square(0) = term_v_square(0)*thirds.prob({0}) = (1)*(1/3) = 1/3

claim:
    ? weight_v_square(1) = 0/3
    term_v_square(1) = v(1)^2 = (0)^2 = 0
    weight_v_square(1) = term_v_square(1)*thirds.prob({1}) = (0)*(1/3) = 0/3

claim:
    ? weight_v_square(2) = 1/3
    term_v_square(2) = v(2)^2 = (1)^2 = 1
    weight_v_square(2) = term_v_square(2)*thirds.prob({2}) = (1)*(1/3) = 1/3

finite_set_sum(thirds.carrier,weight_v_square) = finite_set_sum({0,1,2},weight_v_square) = weight_v_square(0)+weight_v_square(1)+weight_v_square(2) = 2/3

release thm finite_set_sum_substitution(finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {term_v_square(k)*thirds.prob({k})}),finite_set_sum(thirds.carrier,weight_v_square))

release thm prob::main::finite_expectation_formula({0,1,2},thirds,term_v_square)

\prob::main::finite_expectation<{0,1,2},thirds>(term_v_square) = finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {term_v_square(k)*thirds.prob({k})}) = finite_set_sum(thirds.carrier,weight_v_square) = 2/3

have fn term_uv(k thirds.carrier) R = u(k)*v(k)

have fn weight_uv(k thirds.carrier) R = term_uv(k)*thirds.prob({k})

claim:
    ? weight_uv(0) = -1/3
    term_uv(0) = u(0)*v(0) = (-1)*(1) = -1
    weight_uv(0) = term_uv(0)*thirds.prob({0}) = (-1)*(1/3) = -1/3

claim:
    ? weight_uv(1) = 0/3
    term_uv(1) = u(1)*v(1) = (0)*(0) = 0
    weight_uv(1) = term_uv(1)*thirds.prob({1}) = (0)*(1/3) = 0/3

claim:
    ? weight_uv(2) = 1/3
    term_uv(2) = u(2)*v(2) = (1)*(1) = 1
    weight_uv(2) = term_uv(2)*thirds.prob({2}) = (1)*(1/3) = 1/3

finite_set_sum(thirds.carrier,weight_uv) = finite_set_sum({0,1,2},weight_uv) = weight_uv(0)+weight_uv(1)+weight_uv(2) = 0

release thm finite_set_sum_substitution(finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {term_uv(k)*thirds.prob({k})}),finite_set_sum(thirds.carrier,weight_uv))

release thm prob::main::finite_expectation_formula({0,1,2},thirds,term_uv)

\prob::main::finite_expectation<{0,1,2},thirds>(term_uv) = finite_set_sum(thirds.carrier,fn(k thirds.carrier) R {term_uv(k)*thirds.prob({k})}) = finite_set_sum(thirds.carrier,weight_uv) = 0

release thm prob::main::finite_expectation_extensional({0,1,2},thirds,term_u_square,fn(k thirds.carrier) R {u(k)^2})

\prob::main::finite_expectation<{0,1,2},thirds>(fn(k thirds.carrier) R {u(k)^2}) = \prob::main::finite_expectation<{0,1,2},thirds>(term_u_square) = 2/3

release thm prob::main::finite_expectation_extensional({0,1,2},thirds,term_v_square,fn(k thirds.carrier) R {v(k)^2})

\prob::main::finite_expectation<{0,1,2},thirds>(fn(k thirds.carrier) R {v(k)^2}) = \prob::main::finite_expectation<{0,1,2},thirds>(term_v_square) = 2/3

release thm prob::main::finite_expectation_extensional({0,1,2},thirds,term_uv,fn(k thirds.carrier) R {u(k)*v(k)})

\prob::main::finite_expectation<{0,1,2},thirds>(fn(k thirds.carrier) R {u(k)*v(k)}) = \prob::main::finite_expectation<{0,1,2},thirds>(term_uv) = 0

release thm prob::main::finite_variance_second_moment({0,1,2},thirds,u)

release thm variance_from_moments(\prob::main::finite_expectation<{0,1,2},thirds>(u),\prob::main::finite_expectation<{0,1,2},thirds>(fn(k thirds.carrier) R {u(k)^2}),\prob::main::finite_variance<{0,1,2},thirds>(u),2/3,0)

\prob::main::finite_variance<{0,1,2},thirds>(u) = 2/3-(0)^2 = 2/3 > 0

release thm prob::main::finite_variance_second_moment({0,1,2},thirds,v)

release thm variance_from_moments(\prob::main::finite_expectation<{0,1,2},thirds>(v),\prob::main::finite_expectation<{0,1,2},thirds>(fn(k thirds.carrier) R {v(k)^2}),\prob::main::finite_variance<{0,1,2},thirds>(v),2/3,2/3)

\prob::main::finite_variance<{0,1,2},thirds>(v) = 2/3-(2/3)^2 = 2/9 > 0

release thm prob::main::finite_covariance_product_moment({0,1,2},thirds,u,v)

claim:
    ? \prob::main::finite_covariance<{0,1,2},thirds>(u,v) = 0
    \prob::main::finite_expectation<{0,1,2},thirds>(u)*\prob::main::finite_expectation<{0,1,2},thirds>(v) = 0*\prob::main::finite_expectation<{0,1,2},thirds>(v) = 0
    thm difference_of_zeros:
        ? forall p,q,r R:
            p = 0
            q = 0
            r = p-q
            =>:
                r = 0
        r = p-q = 0-q = 0-0 = 0
    release thm difference_of_zeros(\prob::main::finite_expectation<{0,1,2},thirds>(fn(k thirds.carrier) R {u(k)*v(k)}),\prob::main::finite_expectation<{0,1,2},thirds>(u)*\prob::main::finite_expectation<{0,1,2},thirds>(v),\prob::main::finite_covariance<{0,1,2},thirds>(u,v))

release thm prob::main::finite_correlation_zero_from_covariance({0,1,2},thirds,u,v)

\prob::main::finite_correlation<{0,1,2},thirds>(u,v) = 0

release thm prob::main::finite_covariance_zero_from_correlation({0,1,2},thirds,u,v)

release thm prob::main::finite_correlation_bounds({0,1,2},thirds,u,v)

release thm prob::main::dirac_probability_laws({0,1},1)

\prob::main::dirac_probability_space<{0,1},1> = ({0,1},\prob::main::dirac_event_probability<{0,1},1>)

have mass &prob::main::FiniteProbabilitySpace<{0,1}> = \prob::main::dirac_probability_space<{0,1},1>

release struct def mass

mass = ({0,1},\prob::main::dirac_event_probability<{0,1},1>)

mass.carrier = {0,1}

mass.prob = \prob::main::dirac_event_probability<{0,1},1>

mass.carrier $subset R

0 $in mass.carrier

1 $in mass.carrier

release thm prob::main::dirac_event_excludes({0,1},1,{0})

release thm prob::main::dirac_event_contains({0,1},1,{1})

mass.prob({0}) = 0

mass.prob({1}) = 1

have fn observed(k mass.carrier) R = k

have fn mass_weighted(k mass.carrier) R = observed(k)*mass.prob({k})

mass_weighted(0) = observed(0)*mass.prob({0}) = 0*0 = 0

mass_weighted(1) = observed(1)*mass.prob({1}) = 1*1 = 1

release thm finite_set_sum_substitution(finite_set_sum(mass.carrier,fn(k mass.carrier) R {observed(k)*mass.prob({k})}),finite_set_sum(mass.carrier,mass_weighted))

finite_set_sum(mass.carrier,mass_weighted) = finite_set_sum({0,1},mass_weighted) = mass_weighted(0)+mass_weighted(1) = 1

release thm prob::main::finite_expectation_formula({0,1},mass,observed)

\prob::main::finite_expectation<{0,1},mass>(observed) = finite_set_sum(mass.carrier,fn(k mass.carrier) R {observed(k)*mass.prob({k})}) = finite_set_sum(mass.carrier,mass_weighted) = 1

observed(0) = 0

observed(1) = 1

by enumerate finite_set:
    ? forall k {0,1}:
        observed(k)^2 = observed(k)
    observed(k) = k
    k^2 = k
    observed(k)^2 = k^2 = k = observed(k)

have fn observed_square(k mass.carrier) R = observed(k)^2

claim:
    ? forall k mass.carrier:
        observed_square(k) = observed(k)
    k $in {0,1}
    observed_square(k) = observed(k)^2 = observed(k)

release thm prob::main::finite_expectation_extensional({0,1},mass,observed_square,observed)

release thm prob::main::finite_expectation_extensional({0,1},mass,observed_square,fn(k mass.carrier) R {observed(k)^2})

\prob::main::finite_expectation<{0,1},mass>(fn(k mass.carrier) R {observed(k)^2}) = \prob::main::finite_expectation<{0,1},mass>(observed) = 1

release thm prob::main::finite_variance_second_moment({0,1},mass,observed)

release thm variance_from_moments(\prob::main::finite_expectation<{0,1},mass>(observed),\prob::main::finite_expectation<{0,1},mass>(fn(k mass.carrier) R {observed(k)^2}),\prob::main::finite_variance<{0,1},mass>(observed),1,1)

\prob::main::finite_variance<{0,1},mass>(observed) = 1-1^2 = 0

have undefined_dirac R = \prob::main::finite_correlation<{0,1},mass>(observed,observed)
