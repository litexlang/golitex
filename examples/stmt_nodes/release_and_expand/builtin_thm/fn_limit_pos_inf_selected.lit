# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_pos_inf_selected.lit

thm fn_limit_pos_inf_selected_example:
    ? forall fa fn(x R) R,A R:
        exist L R st {$has_limit_pos_inf(fa,L)}
        =>:
            $has_limit_pos_inf(fa,lim_pos_inf(fa))
    release thm fn_limit_pos_inf_selected(fa)
