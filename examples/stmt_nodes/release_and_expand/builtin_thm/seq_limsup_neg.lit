# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_neg.lit

thm seq_limsup_neg_example:
    ? forall a,b seq(R),L R:
        $has_seq_limsup(a,L)
        forall n N+:
            b(n)=-a(n)
        =>:
            $has_seq_liminf(b,-L)
    release thm seq_limsup_neg(a,b,L)
