# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_left_accumulation.lit

thm fn_limit_left_accumulation_example:
    ? forall fa fn(x R) R,x0,L R,r R+:
        $has_limit_left(fa,x0,L)
        =>:
            exist x R st {0<x0-x and x0-x<r}
    release thm fn_limit_left_accumulation(fa,x0,L)
