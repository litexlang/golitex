# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_add_constant.lit

thm seq_limsup_add_constant_example:
    ? forall a,b seq(R),L,c R:
        $has_seq_limsup(a,L)
        forall n N+:
            b(n)=a(n)+c
        =>:
            $has_seq_limsup(b,L+c)
    release thm seq_limsup_add_constant(a,b,L,c)
