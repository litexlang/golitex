# Explicit relative continuity law; all complete domains and point values are checked.
have fn identity(x R) R=x
have fn cont_one(x R) R=1
have fn cont_quotient(x R) R=x
release thm fn_continuous_at_identity(identity,0)
release thm fn_continuous_at_constant(cont_one,0,1)
release thm fn_continuous_at_divide(identity,cont_one,cont_quotient,0)
