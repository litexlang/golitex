# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_left_from_epsilon.lit

thm fn_limit_left_from_epsilon_example:
    ? forall fa fn(x R) R,x0,L R:
        forall r R+:
            exist x R st {0<x0-x and x0-x<r}
        forall epsilon R+:
            exist delta R+ st {{x R:0<x0-x and x0-x<delta} $subset preimage_set(fa,{v R:abs(v-L)<epsilon})}
        =>:
            $has_limit_left(fa,x0,L)
    release thm fn_limit_left_from_epsilon(fa,x0,L)
