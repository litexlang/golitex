# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_left_abs.lit

thm fn_limit_left_abs_example:
    ? forall fa,ha fn(x R) R,x0,A R:
        $has_limit_left(fa,x0,A)
        forall x R:
            ha(x)=abs(fa(x))
        =>:
            $has_limit_left(ha,x0,abs(A))
    release thm fn_limit_left_abs(fa,ha,x0,A)
