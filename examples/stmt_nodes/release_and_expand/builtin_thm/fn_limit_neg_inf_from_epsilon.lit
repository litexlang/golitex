# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_neg_inf_from_epsilon.lit

thm fn_limit_neg_inf_from_epsilon_example:
    ? forall fa fn(x R) R,L R:
        forall r R:
            exist x R st {x<r}
        forall epsilon R+:
            exist delta R st {{x R:x<delta} $subset preimage_set(fa,{v R:abs(v-L)<epsilon})}
        =>:
            $has_limit_neg_inf(fa,L)
    release thm fn_limit_neg_inf_from_epsilon(fa,L)
