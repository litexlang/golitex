# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_neg_inf_compare.lit

thm fn_limit_neg_inf_compare_example:
    ? forall fa,ga fn(x R) R,A,B R,r R:
        $has_limit_neg_inf(fa,A)
        $has_limit_neg_inf(ga,B)
        forall x {t R:t<r}:
            fa(x)<=ga(x)
        =>:
            A<=B
    release thm fn_limit_neg_inf_compare(fa,ga,A,B,r)
