# Explicit finite-point function-limit theorem; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_control.lit

thm fn_limit_at_control_example:
    ? forall fa fn(x R) R,x0,L R,epsilon R+:
        $has_limit_at(fa,x0,L)
        =>:
            exist delta R+ st {{x R:0<abs(x-x0) and abs(x-x0)<delta} $subset preimage_set(fa,{v R:abs(v-L)<epsilon})}
    release thm fn_limit_at_control(fa,x0,L,epsilon)
