# Explicit analysis theorem with checked premises.
have fn seq_negative(k N+) R=-k

claim:
    ? forall m,n N+:
        m<n
        =>:
            seq_negative(n)<seq_negative(m)
    seq_negative(n)=-n<-m=seq_negative(m)

by def $is_seq_strictly_decreasing(seq_negative)

release thm sequence_strict_decreasing_nonincreasing(seq_negative)
