# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_from_epsilon.lit

thm seq_limsup_from_epsilon_example:
    ? forall a seq(R),L R:
        forall epsilon R+:
            exist n0 N+ st {{n N+:n>=n0} $subset preimage_set(a,{v R:v<L+epsilon})}
        forall epsilon R+,n0 N+:
            exist n N+ st {n>=n0 and L-epsilon<a(n)}
        =>:
            $has_seq_limsup(a,L)
    release thm seq_limsup_from_epsilon(a,L)
