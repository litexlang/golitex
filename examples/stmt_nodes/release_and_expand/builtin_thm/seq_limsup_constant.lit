# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_constant.lit

thm seq_limsup_constant_example:
    ? forall a seq(R),L R:
        forall n N+:
            a(n)=L
        =>:
            $has_seq_limsup(a,L)
    release thm seq_limsup_constant(a,L)
