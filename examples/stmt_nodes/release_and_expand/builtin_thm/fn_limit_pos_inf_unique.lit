# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_pos_inf_unique.lit

thm fn_limit_pos_inf_unique_example:
    ? forall fa fn(x R) R,A,B R:
        $has_limit_pos_inf(fa,A)
        $has_limit_pos_inf(fa,B)
        =>:
            A=B
    release thm fn_limit_pos_inf_unique(fa,A,B)
