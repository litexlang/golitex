# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_from_limit.lit

thm seq_limsup_from_limit_example:
    ? forall a seq(R),L R:
        $has_seq_limit(a,L)
        =>:
            $has_seq_limsup(a,L)
    release thm seq_limsup_from_limit(a,L)
