# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_right_power.lit

thm fn_limit_right_power_example:
    ? forall fa,ha fn(x R) R,x0,A R,m N:
        $has_limit_right(fa,x0,A)
        forall x R:
            ha(x)=fa(x)^m
        =>:
            $has_limit_right(ha,x0,A^m)
    release thm fn_limit_right_power(fa,ha,x0,A,m)
