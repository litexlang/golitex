# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_from_sides.lit

thm fn_limit_from_sides_example:
    ? forall fa fn(x R) R,x0,L R:
        $has_limit_left(fa,x0,L)
        $has_limit_right(fa,x0,L)
        =>:
            $has_limit_at(fa,x0,L)
    by thm fn_limit_from_sides(fa,x0,L) => $has_limit_at(fa,x0,L)
