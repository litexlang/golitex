# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_left_identity.lit

thm fn_limit_left_identity_example:
    ? forall fa fn(x R) R,x0 R:
        forall x R:
            fa(x)=x
        =>:
            $has_limit_left(fa,x0,x0)
    release thm fn_limit_left_real_accumulation(x0)
    by thm fn_limit_left_identity(fa,x0) => $has_limit_left(fa,x0,x0)
