# Explicit Riemann/Darboux theorem: riemann_integral_extensional.
# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/riemann_integral_extensional.lit
# The theorem checks its actual domain and all premises before publishing results.
have fn square(x R) R=x^2
release thm riemann_integral_power(square,0,1,2)
have fn local_square(x '[0,1]) R=x^2
release thm riemann_integral_extensional(square,local_square,0,1,1/3)
integral(local_square,0,1)=1/3
