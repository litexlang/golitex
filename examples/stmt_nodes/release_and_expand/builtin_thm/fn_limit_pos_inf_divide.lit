# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_pos_inf_divide.lit

thm fn_limit_pos_inf_divide_example:
    ? forall fa,ga,ha fn(x R) R,A,B R:
        $has_limit_pos_inf(fa,A)
        $has_limit_pos_inf(ga,B)
        B!=0
        forall x R:
            ga(x)!=0
        forall x R:
            ha(x)=fa(x)/ga(x)
        =>:
            $has_limit_pos_inf(ha,A/B)
    release thm fn_limit_pos_inf_divide(fa,ga,ha,A,B)
