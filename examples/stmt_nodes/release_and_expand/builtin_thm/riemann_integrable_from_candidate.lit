# Explicit Riemann/Darboux theorem: riemann_integrable_from_candidate.
# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/riemann_integrable_from_candidate.lit
# The theorem checks its actual domain and all premises before publishing results.
have fn square(x R) R=x^2
release thm riemann_integral_power(square,0,1,2)
release thm riemann_integrable_from_candidate(square,0,1,1/3)
