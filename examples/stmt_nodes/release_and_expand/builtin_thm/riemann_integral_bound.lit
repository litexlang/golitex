# Explicit Riemann/Darboux theorem: riemann_integral_bound.
# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/riemann_integral_bound.lit
# The theorem checks its actual domain and all premises before publishing results.
have fn one(x R) R=1
release thm riemann_integral_constant(one,0,1,1)
claim:
    ? forall x R:
        abs(one(x))<=1
    one(x)=1
    abs(one(x))=1
release thm riemann_integral_bound(one,0,1,1,1)
