# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_sides_mismatch.lit

thm fn_limit_sides_mismatch_example:
    ? forall fa fn(x R) R,x0,A,B,L R:
        $has_limit_left(fa,x0,A)
        $has_limit_right(fa,x0,B)
        A!=B
        =>:
            not $has_limit_at(fa,x0,L)
    release thm fn_limit_sides_mismatch(fa,x0,A,B)
