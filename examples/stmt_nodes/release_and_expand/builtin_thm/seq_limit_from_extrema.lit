# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limit_from_extrema.lit

thm seq_limit_from_extrema_example:
    ? forall a seq(R),L R:
        $has_seq_limsup(a,L)
        $has_seq_liminf(a,L)
        =>:
            $has_seq_limit(a,L)
    release thm seq_limit_from_extrema(a,L)
