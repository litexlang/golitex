# Explicit Riemann/Darboux theorem: riemann_integral_scale.
# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/riemann_integral_scale.lit
# The theorem checks its actual domain and all premises before publishing results.
have fn square(x R) R=x^2
release thm riemann_integral_power(square,0,1,2)
have fn scaled(x R) R=3*x^2
release thm riemann_integral_scale(square,scaled,0,1,3,1/3)
integral(scaled,0,1)=1
