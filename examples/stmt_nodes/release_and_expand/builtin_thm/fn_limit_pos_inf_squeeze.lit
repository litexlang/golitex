# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_pos_inf_squeeze.lit

thm fn_limit_pos_inf_squeeze_example:
    ? forall fa,ga,ha fn(x R) R,L R,r R:
        $has_limit_pos_inf(fa,L)
        $has_limit_pos_inf(ha,L)
        forall x {t R:r<t}:
            fa(x)<=ga(x)<=ha(x)
        =>:
            $has_limit_pos_inf(ga,L)
    release thm fn_limit_pos_inf_squeeze(fa,ga,ha,L,r)
