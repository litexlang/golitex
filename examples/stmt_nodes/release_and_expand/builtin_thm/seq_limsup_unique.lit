# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_unique.lit

thm seq_limsup_unique_example:
    ? forall a seq(R),A,B R:
        $has_seq_limsup(a,A)
        $has_seq_limsup(a,B)
        =>:
            A=B
    release thm seq_limsup_unique(a,A,B)
