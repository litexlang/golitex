# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_selected.lit

thm seq_limsup_selected_example:
    ? forall a seq(R):
        exist L R st {$has_seq_limsup(a,L)}
        =>:
            $has_seq_limsup(a,limsup(a))
    release thm seq_limsup_selected(a)
