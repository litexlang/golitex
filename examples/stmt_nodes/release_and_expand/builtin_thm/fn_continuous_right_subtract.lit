# Explicit relative continuity law; all complete domains and point values are checked.
have fn identity(x R) R=x
have fn cont_one(x R) R=1
have fn cont_difference(x R) R=x-1
release thm fn_continuous_right_identity(identity,0)
release thm fn_continuous_right_constant(cont_one,0,1)
release thm fn_continuous_right_subtract(identity,cont_one,cont_difference,0)
