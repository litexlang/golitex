# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_limsup_exists.lit

thm seq_limsup_exists_example:
    ? forall a seq(R),L R:
        $has_seq_limsup(a,L)
        =>:
            exist u R st {$has_seq_limsup(a,u)}
    release thm seq_limsup_exists(a,L)
