# Explicit finite-point function-limit theorem; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_exists.lit

thm fn_limit_at_exists_example:
    ? forall fa fn(x R) R,x0,A R:
        $has_limit_at(fa,x0,A)
        =>:
            exist L R st {$has_limit_at(fa,x0,L)}
    release thm fn_limit_at_exists(fa,x0,A)
