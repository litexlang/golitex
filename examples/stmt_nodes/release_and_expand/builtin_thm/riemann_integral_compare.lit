# Explicit Riemann/Darboux theorem: riemann_integral_compare.
# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/riemann_integral_compare.lit
# The theorem checks its actual domain and all premises before publishing results.
have fn square(x R) R=x^2
release thm riemann_integral_power(square,0,1,2)
have fn one(x R) R=1
release thm riemann_integral_constant(one,0,1,1)
have fn total(x R) R=x^2+1
release thm riemann_integral_add(square,one,total,0,1,1/3,1)
release thm riemann_integral_compare(square,total,0,1,1/3,4/3)
