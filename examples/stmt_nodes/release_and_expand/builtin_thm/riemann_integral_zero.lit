# Explicit Riemann/Darboux theorem: riemann_integral_zero.
# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/riemann_integral_zero.lit
# The theorem checks its actual domain and all premises before publishing results.
have fn square(x R) R=x^2
release thm riemann_integral_zero(square,3)
integral(square,3,3)=0
