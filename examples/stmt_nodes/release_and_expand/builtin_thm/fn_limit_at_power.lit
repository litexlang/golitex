# Explicit finite-point function-limit theorem; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_power.lit

thm fn_limit_at_power_example:
    ? forall fa,ha fn(x R) R,x0,A R,m N:
        $has_limit_at(fa,x0,A)
        forall x R:
            ha(x)=fa(x)^m
        =>:
            $has_limit_at(ha,x0,A^m)
    release thm fn_limit_at_power(fa,ha,x0,A,m)
