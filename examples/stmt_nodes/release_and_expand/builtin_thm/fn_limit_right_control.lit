# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_right_control.lit

thm fn_limit_right_control_example:
    ? forall fa fn(x R) R,x0,L R,epsilon R+:
        $has_limit_right(fa,x0,L)
        =>:
            exist delta R+ st {{x R:0<x-x0 and x-x0<delta} $subset preimage_set(fa,{v R:abs(v-L)<epsilon})}
    release thm fn_limit_right_control(fa,x0,L,epsilon)
