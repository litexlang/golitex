# Explicit finite-point function-limit theorem; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_accumulation.lit

thm fn_limit_at_accumulation_example:
    ? forall fa fn(x R) R,x0,L R,r R+:
        $has_limit_at(fa,x0,L)
        =>:
            exist x R st {0<abs(x-x0) and abs(x-x0)<r}
    release thm fn_limit_at_accumulation(fa,x0,L)
