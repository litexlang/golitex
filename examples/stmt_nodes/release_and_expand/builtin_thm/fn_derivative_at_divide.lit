# Classical point derivative: checked full domain, interior and law premises.
have fn d_id(x R) R=x
have fn d_one(x R) R=1
release thm fn_derivative_at_real_interior(0)
release thm fn_derivative_at_identity(d_id,0)
release thm fn_derivative_at_constant(d_one,0,1)
have fn d_divide(x R) R=x/1
d_one(0)!=0
release thm fn_derivative_at_divide(d_id,d_one,d_divide,0,1,0)
