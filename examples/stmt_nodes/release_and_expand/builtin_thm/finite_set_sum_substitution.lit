# Now: native builtin contract; verify premises before storing conclusions.
# Run: target/release/litex -f examples/stmt_nodes/release_and_expand/builtin_thm/finite_set_sum_substitution.lit
thm substitution:
    ? forall f fn(t {1, 2}) R, g fn(u {1, 2}) {1, 2}:
        $bijective({1, 2}, {1, 2}, g)
        =>:
            finite_set_sum({1, 2}, f) = finite_set_sum({1, 2}, fn(y {1, 2}) R {f(g(y))})
    release thm finite_set_sum_substitution(finite_set_sum({1, 2}, f), finite_set_sum({1, 2}, fn(y {1, 2}) R {f(g(y))}))
# Boundary: wrong arity, wrong argument shape or an unproved premise must fail.
