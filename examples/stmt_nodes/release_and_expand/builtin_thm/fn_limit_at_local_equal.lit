# Explicit finite-point function-limit theorem; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_local_equal.lit

thm fn_limit_at_local_equal_example:
    ? forall fa,ga fn(x R) R,x0,L R,r R+:
        $has_limit_at(fa,x0,L)
        forall x {t R:0<abs(t-x0) and abs(t-x0)<r}:
            fa(x)=ga(x)
        =>:
            $has_limit_at(ga,x0,L)
    release thm fn_limit_at_real_accumulation(x0)
    release thm fn_limit_at_local_equal(fa,ga,x0,L,r)
