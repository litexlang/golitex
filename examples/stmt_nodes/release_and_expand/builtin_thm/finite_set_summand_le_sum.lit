# Now: native builtin contract; verify premises before storing conclusions.
# Run: target/release/litex -f examples/stmt_nodes/release_and_expand/builtin_thm/finite_set_summand_le_sum.lit
thm summand_bound:
    ? forall h fn(y {1, 2}) R:
        forall z {1, 2}:
            0 <= h(z)
        =>:
            h(1) <= finite_set_sum({1, 2}, h)
    release thm finite_set_summand_le_sum(h(1), finite_set_sum({1, 2}, h))
