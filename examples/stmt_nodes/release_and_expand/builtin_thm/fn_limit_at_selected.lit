# Explicit finite-point function-limit theorem; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_selected.lit

thm fn_limit_at_selected_example:
    ? forall fa fn(x R) R,x0,A R:
        exist L R st {$has_limit_at(fa,x0,L)}
        =>:
            $has_limit_at(fa,x0,lim(fa,x0))
    release thm fn_limit_at_selected(fa,x0)
