# Tracer: proved named callbacks in finite-sum reindexing.
# Before: the contract only inspected anonymous callback syntax.
# release thm sum_over_bijective_finite_set_enumerations(sum(1,2,left_fn),sum(1,2,right_fn))
# Former result: composition shape could not be recovered from a named callback.
# Now: callback defining equalities are checked as explicit theorem premises.
# Boundary: an unproved second bijection must still reject.
# Gate: target/release/litex -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/named_enumeration_callbacks.lit
# Enumeration invariance with explicit callback values.
# The callback premises retain the original two compositions f(e1(k)), f(e2(k)).
# Selection cites the original builtin result through these defining equalities.
thm named_enumeration:
    ? forall f fn(t {1, 2}) R, e1, e2 fn(u closed_range(1, 2)) {1, 2}, left_fn, right_fn fn(k closed_range(1, 2)) R:
        $bijective(closed_range(1, 2), {1, 2}, e1)
        $bijective(closed_range(1, 2), {1, 2}, e2)
        left_fn = fn(k closed_range(1, 2)) R{f(e1(k))}
        right_fn = fn(k closed_range(1, 2)) R{f(e2(k))}
        =>:
            sum(1, 2, left_fn) = sum(1, 2, right_fn)
    by thm sum_over_bijective_finite_set_enumerations(sum(1, 2, left_fn), sum(1, 2, right_fn)) => sum(1, 2, left_fn) = sum(1, 2, right_fn)
