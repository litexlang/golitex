# Explicit squeeze rule on a punctured neighborhood.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_at_squeeze.lit

thm fn_limit_at_squeeze_example:
    ? forall fa,ga,ha fn(x R) R,x0,L R,r R+:
        $has_limit_at(fa,x0,L)
        $has_limit_at(ha,x0,L)
        forall x {t R:0<abs(t-x0) and abs(t-x0)<r}:
            fa(x)<=ga(x)<=ha(x)
        =>:
            $has_limit_at(ga,x0,L)
    release thm fn_limit_at_squeeze(fa,ga,ha,x0,L,r)
