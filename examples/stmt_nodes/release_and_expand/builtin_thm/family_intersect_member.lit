# Before: no explicit nonempty-family intersection membership contract.
# release thm family_intersect_member(x, family_intersect({S}))
# Run: target/release/litex -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/family_intersect_member.lit
# Now: every factor must be a set, and every factor must contain the element.
thm singleton_member:
    ? forall S set, x S:
        x $in family_intersect({S})
    by enumerate finite_set:
        ? forall B {S}:
            $is_set(B)
    by enumerate finite_set:
        ? forall B {S}:
            $is_set(B)
            =>:
                x $in B
    release thm family_intersect_member(x, family_intersect({S}))
# Boundary: empty families and an unproved factor membership are rejected.
