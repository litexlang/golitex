thm enumeration:
    ? forall f fn(t {1, 2}) R, e1, e2 fn(u closed_range(1, 2)) {1, 2}:
        $bijective(closed_range(1, 2), {1, 2}, e1)
        $bijective(closed_range(1, 2), {1, 2}, e2)
        =>:
            sum(1, 2, fn(k closed_range(1, 2)) R {f(e1(k))}) = sum(1, 2, fn(k closed_range(1, 2)) R {f(e2(k))})
    release thm sum_over_bijective_finite_set_enumerations(sum(1, 2, fn(k closed_range(1, 2)) R {f(e1(k))}), sum(1, 2, fn(k closed_range(1, 2)) R {f(e2(k))}))
