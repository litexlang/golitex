# One-sided real function limit: checked premises precede selected-value use.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_right_accumulation.lit

thm fn_limit_right_accumulation_example:
    ? forall fa fn(x R) R,x0,L R,r R+:
        $has_limit_right(fa,x0,L)
        =>:
            exist x R st {0<x-x0 and x-x0<r}
    release thm fn_limit_right_accumulation(fa,x0,L)
