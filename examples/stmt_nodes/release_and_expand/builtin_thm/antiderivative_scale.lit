# Check: target/release/litex -lang en -strict -f examples/stmt_nodes/release_and_expand/builtin_thm/antiderivative_scale.lit
# Explicit theorem contract: antiderivative_scale
have fn square(x R) R=x^2

have fn twice(x R) R=2*x

have fn identity(x R) R=x

claim:
    ? forall x R:
        $has_derivative_at(square,x,twice(x))
    release thm fn_derivative_at_real_interior(x)
    release thm fn_derivative_at_identity(identity,x)
    release thm fn_derivative_at_multiply(identity,identity,square,x,1,1)
    identity(x)=x
    twice(x)=2*x
    1*identity(x)+identity(x)*1=twice(x)
    $has_derivative_at(square,x,twice(x))

release thm antiderivative_from_definition(square,twice,R)

have fn shifted(x R) R=x^2+3

release thm antiderivative_shift(square,twice,shifted,R,3)

release thm antiderivative_restrict(square,twice,R,'(-1,1))

release thm antiderivative_restrict(shifted,twice,R,'(-1,1))

release thm antiderivative_difference_constant(square,shifted,twice,-1,1,0)

release thm antiderivative_to_definition(shifted,twice,R)

have fn scaled(x R) R=2*x^2

have fn four_times(x R) R=4*x

release thm antiderivative_scale(square,twice,scaled,four_times,R,2)
