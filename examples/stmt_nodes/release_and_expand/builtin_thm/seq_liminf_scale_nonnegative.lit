# Finite real sequence extremal limit; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/seq_liminf_scale_nonnegative.lit

thm seq_liminf_scale_nonnegative_example:
    ? forall a,b seq(R),L,c R:
        $has_seq_liminf(a,L)
        0<=c
        forall n N+:
            b(n)=c*a(n)
        =>:
            $has_seq_liminf(b,c*L)
    release thm seq_liminf_scale_nonnegative(a,b,L,c)
