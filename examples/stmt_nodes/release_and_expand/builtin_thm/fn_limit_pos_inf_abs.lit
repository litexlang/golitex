# Finite real function limit at infinity; all premises are checked.
# Run: target/release/litex -strict -lang en -f examples/stmt_nodes/release_and_expand/builtin_thm/fn_limit_pos_inf_abs.lit

thm fn_limit_pos_inf_abs_example:
    ? forall fa,ha fn(x R) R,A R:
        $has_limit_pos_inf(fa,A)
        forall x R:
            ha(x)=abs(fa(x))
        =>:
            $has_limit_pos_inf(ha,abs(A))
    release thm fn_limit_pos_inf_abs(fa,ha,A)
