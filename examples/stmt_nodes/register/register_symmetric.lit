# Stmt: Register.RegisterSymmetricPropStmt → exec_register_symmetric_prop_stmt
# Run: litex -f examples/stmt_nodes/register/register_symmetric.lit
# No indented proof body: one shaped `? forall …` only.

prop same(x set, y set):
    x = y

register symmetric:
    ? forall x, y set:
        $same(x, y)
        =>:
            $same(y, x)

forall a, b set:
    $same(a, b)
    =>:
        $same(b, a)
