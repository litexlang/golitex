# Tracer: mathematical dependency nodes, without proof-command bubbles.
# Before: the following source verified, but -graph was an unsupported option.
# by thm only_natural(1) => 1 >= 0
# Former graph command: rejected with launch exit 2.
# Now: the theorem is one node; each resulting fact is connected to it.
# Run: target/release/litex -graph -strict -f examples/stmt_nodes/graph/math_dependencies.lit
# Boundary: failed facts are not published, and local assumptions remain scoped.

prop above_zero(x R):
    x > 0

thm only_natural:
    ? forall n N:
        n >= 0

$above_zero(1)
by thm only_natural(1) => 1 >= 0
by thm only_natural(2) => 2 >= 0

have x R = 2
x > 0
