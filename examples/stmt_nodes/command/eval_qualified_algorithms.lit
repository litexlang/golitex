# Tracer: exact evaluation retains a chapter algorithm's qualified identity.
# Before (failed when this file was exported as a module chapter):
# algo eval_flag(x R) N by cases:
#     case x = 0: 0
#     case x != 0: 1
# eval eval_flag(0)
# The old evaluator accepted only a Plain identifier; the qualified chapter
# call failed before resolving its stored algorithm.
# Now: the existing dispatcher's checks below also succeed inside an exported
# or imported chapter, retaining the export/module identity and checked equations.
# Boundary: out-of-domain calls still fail source WD and publish no result.
# Gates: cargo test --release --test reading_qualified_eval;
# litex -strict -f examples/stmt_nodes/command/eval_qualified_algorithms.lit.
# Module/import gates copy this exact file into isolated test-owned projects.

# Stmt: EvalStmt
# AST: Stmt::Command::EvalStmt
# Run all scenarios and boundaries: python3 examples/test_statements/run.py --leaf EvalStmt

# case: closed-numeric-evaluation
eval (1 + 2)^2
eval 1 / 2
eval |-3|
eval 3!
eval sqrt(4)

# case: named-value-evaluation
have eval_a R = 10
eval eval_a + 1
eval_a + 1 = 11

# case: algorithm-evaluation
algo eval_flag(x R) N by cases:
    case x = 0: 0
    case x != 0: 1
eval eval_flag(0)
eval eval_flag(2) + 1
eval_flag(2) + 1 = 2

# case: recursive-algorithm-evaluation
algo recursive_eval(n N) N by induc n from 0:
    case n = 0: 0
    case n >= 1: recursive_eval(n - 1)
eval recursive_eval(2)
recursive_eval(2) = 0

# case: checked-natural-domain
algo eval_identity(x N) N by cases:
    case x = x: x
eval eval_identity(0)
eval eval_identity(2) + 1
