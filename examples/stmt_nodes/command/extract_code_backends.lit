# Tracer: select verified executable code from a mathematical file
#
# Before (whole-file extraction):
# have a R = 1
# a + 1 = 2
# Former behavior: `-extractpython -f` and `-extractc -f` sent every statement
# in the file to the extractor, so proofs and executable definitions could not
# be selected independently.
#
# Now (two selected blocks with an ordinary proof between them):
# [-extract]
have a R = 1
# [end of -extract]

a + 1 = 2

# [-extract]
algo step(x R) R by cases:
    case x = 0: 1
    case x != 0: x + 1
# [end of -extract]

# Current behavior:
# litex -extractpython -f examples/stmt_nodes/command/extract_code_backends.lit
# litex -extractc -f examples/stmt_nodes/command/extract_code_backends.lit
# concatenate the two selected blocks and emit Python or C99. The proof between
# them remains part of ordinary full-file verification but is not extracted.
#
# Boundary: file extraction without a complete marker pair is rejected. Inline
# and repository extraction retain their existing whole-input behavior.
# Evidence: litex -extractpython -f examples/stmt_nodes/command/extract_code_backends.lit
