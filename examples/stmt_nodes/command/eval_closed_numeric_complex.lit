# Stmt: Command.EvalStmt — complex closed-numeric display eval
# Run: litex -f examples/stmt_nodes/command/eval_closed_numeric_complex.lit
#
# Nested closed trees (arithmetic + integer ops + foldable sqrt/log) and rewrite.
# Companion equality tracer:
#   examples/proof_nodes/equal/by_builtin_rule/calculation_closed_decimal_complex_nested.lit
# Boundary: `eval sqrt(2)` still soft-fails (see command/eval.lit comments / unit tests).

eval gcd(54, (-24)) + 3! * sqrt(4)
eval ((-7) % 3)^log(2, 4) + sqrt(0.36)
eval ceil(sqrt(0.36) + 1.1) * 3!
eval min(max(2^3, 3!), gcd(54, 24))

have a N = 3!
have b R = sqrt(4)
have c R = log(2, 8)
eval a + b * c
eval abs(a - b^c) + gcd(a, 4)
