# Stmt: Command.EvalStmt → exec_eval_stmt
# Run: litex -f examples/stmt_nodes/command/eval.lit
#
# Pipeline: known_closed_numeric_equal rewrite → recursive evaluate
#   (closed-numeric simplify; Identifier FnObj → stored algo).
# Publishes source=result; checked recursive algo coverage is in eval_store_result.lit.
# Boundary: `eval sqrt(-1)` / `eval N` / unbound symbols soft-fail.
# Now also: integer closed ops and foldable `sqrt` / `log`.

eval (1 + 2)^2
eval 1 / 2
eval abs(-3)
eval 3!
eval sqrt(4)
eval sqrt(0.36)
eval log(2, 8)

have a R = 10
eval a + 1

algo nonzero_flag(x R) R by cases:
    case x = 0: 0
    case x != 0: 1

eval nonzero_flag(0)
eval nonzero_flag(1)
eval nonzero_flag(0) + 1
