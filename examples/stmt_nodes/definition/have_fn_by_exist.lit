# Stmt: Definition.HaveFnByForallExistUniqueStmt → exec_have_fn_by_forall_exist_unique_stmt
# Run: litex -f examples/stmt_nodes/definition/have_fn_by_exist.lit
# Also see examples/tmp_have_fn_by_exist.lit for release + template def-check boundaries.

prop F(x, y R):
    y = x
have A set = R
have B set = R

claim:
    ? forall x A:
        exist! y B st {$F(x, y)}
    witness exist! y B st {$F(x, y)} from x:
        by def $F(x, x)

have fn f by exist!:
    ? forall x A:
        exist! y B st {$F(x, y)}

forall x A:
    $F(x, f(x))
