# Stmt: Definition.DefStrategyStmt → exec_def_strategy_stmt
# Then: non-equality atomic via known_strategy (ByKnownStrategy).
# Run: litex -f examples/stmt_nodes/definition/def_strategy.lit

prop is_one(x R):
    x = 1

strategy use_is_one:
    ? forall x R:
        x = 1
        =>:
            $is_one(x)
    $is_one(x)

have a R = 1
$is_one(a)
