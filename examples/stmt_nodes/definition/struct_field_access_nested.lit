# FieldAccess: `x.y` and `x.y.z` as one node with fields: Vec
# Run: litex -f examples/claim_obtain_scope.lit

struct Coordinates:
    x R
    y R

struct TaggedPoint:
    point &Coordinates
    tag N

forall p &TaggedPoint:
    p.point = p.point
    p.tag = p.tag
    p.point.x = p.point.x
    p.point.y = p.point.y
