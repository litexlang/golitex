# Tracer: template headers and instances use angle brackets.
# The parser now rejects the former spellings:
# template<a R>:
#     have A set = R
# have x A[0] = 2
# template[S set]:
#     have fn identity(x S) S = x
# Negative regressions: tests/template_syntax.rs.
# Evidence: target/release/litex -strict -lang en -f examples/stmt_nodes/definition/template_syntax.lit

template<a R>:
    have A set = R

template<S set>:
    have fn identity(x S) S = x

\identity<R>(2) = 2
\identity<R>(2) < 3

let real_identity = \identity<R>
real_identity(3) = 3

template<S set>:
    have carrier_copy set = S

\carrier_copy<R> = R
\carrier_copy<\carrier_copy<R>> = \carrier_copy<R>
\carrier_copy<\carrier_copy<R>> = R
\carrier_copy<'[0, 1)> = '[0, 1)
0 $in '[0, 1]

template<S set, z S>:
    have fn const_on(x S) S = z

\const_on<R, 2>(0) = 2

template<a R: a != 0,>:
    have inverse R = 1 / a

\inverse<2> = 1 / 2

1 < 2 > 1 < 3

have x \A<0> = 2
x = 2
