# Stmt: Definition.LetObjStmt callable value with an explicit carrier
# Gate: target/release/litex -strict -f examples/stmt_nodes/definition/let_callable_alias.lit
# A let abbreviation records equality. A typed binding supplies the callable interface.
have fn f(x R) R = x + 1
let g = f
have callable fn(x R) R = g
callable(1) = f(1) = 2
fn_range(callable) = fn_range(f)
