# Stmt: Definition — single leading underscore is a valid user name
# Run: litex -f examples/stmt_nodes/definition/leading_underscore_name.lit
#
# When: `have _x ...` (one leading underscore).
# After: name is accepted and usable in later facts.
# Boundary: `__x` remains rejected (reserved); covered by parser/unit tests.

have _x R = 1
_x = 1
