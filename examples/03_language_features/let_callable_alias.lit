# Tracer: a callable `let` alias is a transparent executed definition.
#
# Before (WD passed, direct proof did not work):
# have fn f(x R) R = x + 1
# let g = f
# g(1) = 2
# Former behavior: callable-shape lookup made `g(1)` well-defined, but equality
# verification still returned unknown unless `g(1) = f(1)` was written first.
#
# Now (verified):
have fn f(x R) R = x + 1
let g = f
g(1) = 2
fn_range(g) = fn_range(f)
# Current behavior: `let` records the exact defining equality FactId. Object
# resolution replaces `g` by `f` once, including in function-head position,
# and the atomic Result records a TransparentDefinitionReduction before
# replaying the checked definition of `f`.
#
# Boundary: an ordinary `have a = b` is not a transparent definition, and
# transparency does not bypass arity or domain checks; `g(1, 2)` remains
# rejected by executable Rust regressions.
# Evidence:
# target/release/litex -compact -isolated -runner -f examples/03_language_features/let_callable_alias.lit
# tests/unit/kernel_contracts/lit_file_runner_tests/runtime_regression_tests/callable_aliases.rs
