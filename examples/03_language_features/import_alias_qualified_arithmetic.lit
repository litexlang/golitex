# Tracer: canonical qualified values inside imported composite expressions
#
# Before (did not work):
# import "../_internal/fixtures/geometry_foundation" as gf
# gf::main::a + gf::main::a = gf::main2::b
# gf::main::pair[1] = 3
# Former behavior: arithmetic needed a Display workaround, while tuple projection then failed at
# `1 <= tuple_dim(gf::main::pair)` because lookup reparsed a rendered composite key.
#
# Now (verified):
import "../_internal/fixtures/geometry_foundation" as gf

gf::main::a + gf::main::a = gf::main2::b
gf::main::pair[1] = 3
gf::main2::pair[1] = 8
cart_dim(gf::main::ProductSet) = 2
# Current behavior: local and qualified references share one canonical symbol key, and structured
# module routing makes direct arithmetic plus composite tuple/cart-dimension lookup available;
# equal surface names from different exports remain distinct.
#
# Boundary: gf::main::missing remains undefined and is rejected by the focused Rust regression.
