# Tracer: trust statements commit atomically
#
# Before (failed and leaked a prefix fact):
# trust:
#     777 = 778
#     1 / 0 = 0
# Former behavior: the statement reported that `1 / 0 = 0` was not
# well-defined, but `777 = 778` remained known in the parent environment.
#
# Now (verified):
trust:
    777 = 778
    888 = 889

777 = 778
888 = 889

trust have denominator R:
    denominator != 0
    1 / denominator = 1 / denominator

2 / denominator = 2 / denominator
# Current behavior: every binding, assumed fact, and inferred consequence from
# one trust statement is committed together. Later facts inside the statement
# may use earlier facts from the same temporary environment.
#
# Boundary: an ill-defined fact still rejects the statement and stops the
# current source run. A persistent REPL may continue with its unchanged parent
# environment, and an earlier, separately successful statement remains committed.
# The executable failure and rollback checks live in
