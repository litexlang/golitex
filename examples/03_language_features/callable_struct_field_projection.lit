# Tracer: a function result declared with a struct carrier exposes callable fields.
#
# Before (the explicit struct selection was required):
# have fn projected_entry(f fn(k N+) N, idx N+) N = &CallableBox{boxed(f)}.entries(idx)
# Former behavior: `boxed(f).entries(idx)` was rejected after the function call.
#
# Now (verified):
# `boxed(f).entries(idx)` uses the direct `&CallableBox` return carrier.
#
# Boundary: `boxed(f).tag(idx)` remains invalid because `tag` has scalar carrier `N`.
# Evidence: target/release/litex -compact -isolated -runner -f examples/03_language_features/callable_struct_field_projection.lit

struct CallableBox:
    entries fn(k N+) N
    tag N

have fn identity_entry(k N+) N = k
have fn boxed(f fn(k N+) N) &CallableBox = (f, 0)

have fn projected_entry(f fn(k N+) N, idx N+) N = boxed(f).entries(idx)

projected_entry(identity_entry, 1) $in N

# Remaining boundary: a scalar field is not callable.
# have fn invalid_scalar_call(f fn(k N+) N, idx N+) N = boxed(f).tag(idx)
