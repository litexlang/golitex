# Tracer: declaration-owned field paths are automatic, while struct facts are
# released one layer at a time.
#
# Before (implicit release; intentionally removed):
# make_outer(1).inner.value >= 0
# Former behavior: merely storing struct membership eagerly released tuple
# facts, projections, field carriers, and struct laws, so the line above could
# verify without an explicit request to open either struct layer.
#
# Now (verified below):
# release struct def make_outer(1).inner
# make_outer(1).inner.value >= 0
# Current behavior: the field path is well-defined from declaration-owned
# carriers, while the law becomes available only after the exact Inner object
# passes its membership check and that one layer is opened.
#
# Boundary: opening `make_outer(1)` does not open its `inner` field; raw tuple
# membership does not create a named-field view. Executable Rust regressions
# cover both rejected cases.
#
# Evidence: the release runner accepts every active statement in this file;
# the exact command is kept in the task validation ledger because publishable
# examples do not carry repository run instructions. Rust regressions execute
# the rejected boundary cases.

struct Inner:
    value R
    tag R
    <=>:
        value >= 0

struct Outer:
    inner &Inner
    marker R

have fn make_outer(x N) &Outer = ((x, 0), 0)

# Field-path WD needs no prior opening and releases no facts by itself.
make_outer(1).inner.value = make_outer(1).inner.value

release struct def make_outer(1).inner
$is_tuple(make_outer(1).inner)
tuple_dim(make_outer(1).inner) = 2
make_outer(1).inner $in cart(R, R)
make_outer(1).inner.value = make_outer(1).inner[1]
make_outer(1).inner.value >= 0

# Repeating the same opening is idempotent.
release struct def make_outer(1).inner

# A direct pure-symbol binding opens one layer automatically.
forall direct &Inner:
    $is_tuple(direct)
    tuple_dim(direct) = 2
    direct.value = direct[1]
    direct.value >= 0

# One-field structs remain named identity views rather than one-tuples.
struct ScalarView:
    value R

have fn scalar_view(x R) &ScalarView = x
release struct def scalar_view(1)
scalar_view(1).value = scalar_view(1)
