# Tracer: Unicode mathematical input aliases share the existing Litex semantics.
#
# Before (did not work):
# ∀ x ℝ:
#     x ≠ 0
#     →:
#         x ∈ ℂ
# 1 ∉ {0} ∩ {0, 1} ∪ ∅
# {0} ⊂ {0, 1}
# {0} × {1} = cart({0}, {1})
# Former behavior: these Unicode mathematical forms were not recognized as
# their corresponding Litex facts and objects.
#
# Compatibility case previously missing from the acceptance contract:
# witness ∃! n ℝ st {n = 0} from 0: ...
# Former limitation: `∃!` composed into the right tokens, but had no persistent
# end-to-end example documenting that it is the Unicode spelling of `exist!`.
#
# Now (verified): the active examples below use every supported Unicode alias.

∀ x ℝ:
    x ≠ 0
    →:
        x ∈ ℂ
        x ≤ x ∧ x ≥ x

∀ x ℝ:
    →:
        x = x
    ↔:
        x = x

witness ∃ n ℕ st {n = 0} from 0

witness ∃! n ℝ st {n = 0} from 0:
    0 = 0
    claim:
        ? ∀ u, v ℝ:
            u = 0
            v = 0
            →:
                u = v
        u = 0
        0 = v
        u = v

0 = 0 ∨ 0 = 1
¬ 0 = 1
π ∈ ℝ
1 ∈ ℕ
1 ∈ ℤ
1 ∈ ℚ
1 ∈ ℝ
1 ∈ ℂ
∅ ⊆ ℕ
ℤ ⊇ ℕ

claim:
    ? {0} ⊊ {0, 1}
    by def {0} ⊊ {0, 1}

claim:
    ? {0, 1} ⊋ {0}
    by def {0, 1} ⊋ {0}

1 ∉ ∅
{0} ∩ {0, 1} ∪ ∅ = union(intersect({0}, {0, 1}), {})

claim:
    ? {0} ⊂ {0, 1}
    by def {0} ⊂ {0, 1}

{0} ∪ {1} = union({0}, {1})
{0} ∩ {1} = intersect({0}, {1})
{0} × {1} = cart({0}, {1})
{0} × {1} × {2} = cart({0}, {1}, {2})

# Current behavior: Unicode input reaches the same AST, verifier, and
# canonical ASCII diagnostics as the corresponding existing spellings.
#
# Boundary: `×` always means Cartesian product. `2 × 3 = 6` remains rejected;
# numeric multiplication is still written `2 * 3 = 6`. The executable boundary
# is `unicode_cart_does_not_mean_numeric_multiplication`. `witness ∃!` still
# requires an explicit uniqueness proof; omitting it remains rejected by
# `witness_exist_unique_rejects_missing_uniqueness_proof`.
# Evidence: target/release/litex -compact -isolated -runner -f examples/03_language_features/unicode_math_aliases.lit
