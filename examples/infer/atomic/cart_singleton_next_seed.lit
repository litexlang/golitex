# Now: coordinate membership is verified as a new seed; singleton equality follows.
claim:
    ? forall a cart({1}, {2}):
        a = (1, 2)
    a(1) $in {1}
    a(2) $in {2}
    release thm tuple_equal_from_coordinates(a, (1, 2))
