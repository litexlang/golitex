# Template set-builder carrier projection.
# Before: coordinate WD failed with "no matching function signature":
# template<S set>:
#     have pairs set = {p cart(N, S): p(1) >= 0}
# forall S set, p \pairs<S>:
#     p(2) $in S
# Now: the checked template RHS supplies the existing builder projection.
# Boundary: wrong coordinates/carriers and invalid template arguments reject.
# Evidence: cargo test --lib --release template_builder_
# Run: target/release/litex -strict -lang en -f examples/infer/atomic/template_set_builder_carrier.lit

template<S set>:
    have pairs set = {p cart(N, S): p(1) >= 0}
forall S set, p \pairs<S>:
    p(1) >= 0
    p(2) $in S

template<S set>:
    have streams set = {p cart(N, fn(index N+) S): p(1) >= 0}
# Before: this claim depended on a second infer pass during goal formation.
# claim:
#     ? forall S set, p \streams<S>, index N+:
#         p(2)(index) $in S
#     have stream fn(k N+) S = p(2)
#     stream(index) $in S
#     p(2)(index) = stream(index)
# The literal carrier lemma retains the original value goal and uses the
# same checked coordinate alias. The template projection is then an explicit seed.
thm cart_stream_value:
    ? forall S set, p cart(N, fn(index N+) S), input N+:
        p(2)(input) $in S
    have stream fn(k N+) S = p(2)
    stream(input) $in S
    p(2)(input) = stream(input)

forall S set, p \streams<S>, input N+:
    p $in cart(N, fn(index N+) S)
    p(2)(input) $in S
