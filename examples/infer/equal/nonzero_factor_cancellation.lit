forall a, b, k R:
    k != 0
    a * k = b * k
    =>:
        a = b

forall a, b C, k C*:
    k * a = b * k
    =>:
        a = b

forall a, b, x, y C:
    x + y != 0
    a * (x + y) = b * (x + y)
    =>:
        a = b

forall a, b, x, y Z:
    x != 0
    y != 0
    (a * x) * y = (b * x) * y
    =>:
        a = b
