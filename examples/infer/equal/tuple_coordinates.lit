# Tracer: storing a tuple equality publishes its coordinate equalities.
#
# Before (the shorter input failed):
# have tilted cart_n(C,2) = (3/5,4/5)
# tilted(1)^2 + tilted(2)^2 = 1
# Former result: search_proof: Could not prove the goal.
#
# Former workaround:
# have zero cart_n(C,2) = (1,0)
# have tilted cart_n(C,2) = (3/5,4/5)
# zero(1) = 1
# zero(2) = 0
# tilted(1) = 3/5
# tilted(2) = 4/5
# tilted(1)^2 + tilted(2)^2 = 1
# Former limitation: omitting the coordinate assertions made the last equality
# fail in search_proof: Could not prove the goal.
#
# Now: the declarations alone publish the coordinate values used below.
have zero cart_n(C,2) = (1,0)
have tilted cart_n(C,2) = (3/5,4/5)
zero(1) + zero(2) = 1
tilted(1)^2 + tilted(2)^2 = 1

# Reverse orientation and arbitrary components use the same one-layer rule.
forall p cart(C,C):
    (3/5,4/5) = p
    =>:
        p(1)^2 + p(2)^2 = 1

let singleton = (7,)
singleton(1) + 1 = 8
let empty = tuple()
empty $in cart()

# An explicit coordinate equality starts the next one-layer inference step.
let nested = ((1,2),3)
nested(1) = (1,2)
nested(1)(1) + nested(1)(2) = 3

# Boundary: only the direct literal tuple is projected, one layer per seed.
# No function-body unfolding or transitive alias traversal is added.
# Wrong coordinate values and indices 0 and 3 on a pair remain rejected.
# Evidence: cargo test --release --lib tuple_coordinate_inference -- --nocapture
# Gate: target/release/litex -lang en -strict -f examples/infer/equal/tuple_coordinates.lit
