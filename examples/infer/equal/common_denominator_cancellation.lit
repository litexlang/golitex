forall a, b C, k C*:
    a/k=b/k
    =>:
        a=b

forall a, b, x, y R:
    x+y!=0
    a/(x+y)=b/(x+y)
    =>:
        a=b

forall b C, k C*:
    0/k=b/k
    =>:
        b=0
