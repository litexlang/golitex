# Stmt: ReleaseZornLemmaStmt
# AST: Stmt::ReleaseAndExpand::ReleaseZornLemmaStmt
# Run all scenarios and boundaries: python3 examples/test_statements/run.py --leaf ReleaseZornLemmaStmt

# case: conditional-poset-interface
have S set
abstract_prop leq(x, y)
prop upper_bound(c power_set(S), u S):
    forall x c:
        $leq(x, u)
prop maximal(m S):
    forall x S:
        $leq(m, x)
        =>:
            x = m

claim:
    ? forall:
        $is_nonempty_set(S)
        forall x S:
            $leq(x, x)
        forall x, y, z S:
            $leq(x, y)
            $leq(y, z)
            =>:
                $leq(x, z)
        forall x, y S:
            $leq(x, y)
            $leq(y, x)
            =>:
                x = y
        forall c power_set(S):
            forall x, y c:
                $leq(x, y) or $leq(y, x)
            =>:
                exist u S st {$upper_bound(c, u)}
        =>:
            exist m S st {$maximal(m)}
    release zorn_lemma: set S, prop leq, prop upper_bound, prop maximal:
        $is_nonempty_set(S)
        forall x S:
            $leq(x, x)
        forall x, y, z S:
            $leq(x, y)
            $leq(y, z)
            =>:
                $leq(x, z)
        forall x, y S:
            $leq(x, y)
            $leq(y, x)
            =>:
                x = y
        forall c power_set(S):
            forall x, y c:
                $leq(x, y) or $leq(y, x)
            =>:
                exist u S st {$upper_bound(c, u)}

# case: renamed-poset-interface
have ZornCarrier set
abstract_prop zorn_order(x, y)
prop zorn_bound(c power_set(ZornCarrier), u ZornCarrier):
    forall x c:
        $zorn_order(x, u)
prop zorn_max(m ZornCarrier):
    forall x ZornCarrier:
        $zorn_order(m, x)
        =>:
            x = m

claim:
    ? forall:
        $is_nonempty_set(ZornCarrier)
        forall x ZornCarrier:
            $zorn_order(x, x)
        forall x, y, z ZornCarrier:
            $zorn_order(x, y)
            $zorn_order(y, z)
            =>:
                $zorn_order(x, z)
        forall x, y ZornCarrier:
            $zorn_order(x, y)
            $zorn_order(y, x)
            =>:
                x = y
        forall c power_set(ZornCarrier):
            forall x, y c:
                $zorn_order(x, y) or $zorn_order(y, x)
            =>:
                exist u ZornCarrier st {$zorn_bound(c, u)}
        =>:
            exist m ZornCarrier st {$zorn_max(m)}
    release zorn_lemma: set ZornCarrier, prop zorn_order, prop zorn_bound, prop zorn_max:
        $is_nonempty_set(ZornCarrier)
        forall x ZornCarrier:
            $zorn_order(x, x)
        forall x, y, z ZornCarrier:
            $zorn_order(x, y)
            $zorn_order(y, z)
            =>:
                $zorn_order(x, z)
        forall x, y ZornCarrier:
            $zorn_order(x, y)
            $zorn_order(y, x)
            =>:
                x = y
        forall c power_set(ZornCarrier):
            forall x, y c:
                $zorn_order(x, y) or $zorn_order(y, x)
            =>:
                exist u ZornCarrier st {$zorn_bound(c, u)}
