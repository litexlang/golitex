# Stmt: ByFnExtensionStmt
# AST: Stmt::By::ByFnExtensionStmt
# Run all scenarios and boundaries: python3 examples/test_statements/run.py --leaf ByFnExtensionStmt

# case: unary-alpha-renaming
have fn ext_f(x R) R = x
have fn ext_g(y R) R = y
by fn_extension ext_f = ext_g

# case: binary-alpha-renaming
have fn ext_add(x, y R) R = x + y
have fn ext_add_again(a, b R) R = a + b
by fn_extension:
    ? ext_add = ext_add_again

# case: natural-function-equality
have fn ext_nat(n N) N = n + 1
have fn ext_nat_again(m N) N = m + 1
by fn_extension ext_nat = ext_nat_again

# case: nested-extension-step
have fn nested_ext_f(x R) R = x
have fn nested_ext_g(x R) R = x
by fn_extension:
    ? nested_ext_f = nested_ext_g
    by extension {1} = {1}
