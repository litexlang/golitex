# Stmt: SketchStmt
# AST: Stmt::ProofBlock::SketchStmt
# Run all scenarios and boundaries: python3 examples/test_statements/run.py --leaf SketchStmt

# case: arithmetic-sketch
sketch:
    1 + 1 = 2

# case: local-declarations
sketch:
    let sketch_a = 2
    sketch_a + 1 = 3

# case: nested-proof
sketch:
    claim:
        ? 2 = 2
    2 = 2
