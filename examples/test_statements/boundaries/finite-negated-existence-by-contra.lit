# K005: checked enumeration and explicit negative-existence contradiction.
# Run: python3 examples/test_statements/run.py --leaf ByContraStmt
by enumerate finite_set:
    ? forall x {0}:
        x != 1
by contra:
    ? not exist x {0} st {x = 1}
    obtain a from exist x {0} st {x = 1}
    a != 1
    impossible a = 1
not exist x {0} st {x = 1}
