# Stmt: ExpandRangeStmt
# AST: Stmt::ReleaseAndExpand::ExpandRangeStmt
# Run all scenarios and boundaries: python3 examples/test_statements/run.py --leaf ExpandRangeStmt

# case: half-open-range
claim:
    ? forall x range(1, 3):
        x = 1 or x = 2
    expand: x $in range(1, 3)

# case: closed-range
claim:
    ? forall x closed_range(1, 2):
        x = 1 or x = 2
    expand: x $in closed_range(1, 2)

# case: ellipsis-singleton-range
claim:
    ? forall x 2...2:
        x = 2
    expand: x $in 2...2
