# Stmt: ByForStmt
# AST: Stmt::By::ByForStmt
# Run all scenarios and boundaries: python3 examples/test_statements/run.py --leaf ByForStmt

# case: half-open-finite-range
by for:
    ? forall n range(0, 3):
        n < 3

# case: closed-range
by for:
    ? forall n closed_range(1, 3):
        n >= 1

# case: multiple-ranges
by for:
    ? forall x range(0, 2), y range(2, 4):
        x < y

# case: constant-proof-body
by for:
    ? forall n range(0, 2):
        n = n
    1 = 1

# case: conditional-binder-body
by for:
    ? forall n {0, 1, 2}:
        n > 0
        =>:
            n != 0
    n = n
