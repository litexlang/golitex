# Node: equal.ByBuiltinRule.ByFnSetAlphaEqual
# Run: LITEX_NEW_PIPELINE=1 target/release/litex -f examples/new_pipeline_proof_nodes/equal/by_builtin_rule/by_fn_set_alpha_equal.lit

# Two separately parsed R -> R share no ObjIR (binder ids differ) but are
# alpha-equal as FnSets.
R -> R = R -> R

# Known $in cites the forall binder's FnSet; goal set is a fresh parse — arg
# equality uses ByFnSetAlphaEqual.
forall f R -> R:
    f $in R -> R
