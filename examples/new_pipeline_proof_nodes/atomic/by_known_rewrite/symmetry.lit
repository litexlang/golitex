# Node: atomic.ByKnownRewrite.Symmetry
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_proof_nodes/atomic/by_known_rewrite/symmetry.lit
#
# Registers symmetric swap for `same`, defines equal witnesses, proves the swap.

prop same(x R, y R):
    x = y

by symmetric_prop:
    ? forall x, y R:
        $same(x, y)
        =>:
            $same(y, x)

have a R = 1
have b R = a
$same(a, b)
$same(b, a)
