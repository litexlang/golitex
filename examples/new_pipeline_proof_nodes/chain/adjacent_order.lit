# Node: chain (adjacent order)
# Run: LITEX_NEW_PIPELINE=1 litex -f examples/new_pipeline_proof_nodes/chain/adjacent_order.lit

1 < 2
2 < 3
1 < 2 < 3

# A chain conclusion in a forall is indexed by its ordered chain shape, then
# matched against the whole target chain during known-forall verification.
trust:
    forall x, y, z R:
        =>:
            x < y < z
have a R, b R, c R
a < b < c
