# Before: public symbols below A required their full exported path.
A::chap3::z = 1

# Now: [allow bare export] recursively indexes A's loaded public export tree.
z = 1

have answer R = 1

# Boundary: a file before A in [export] still cannot see z, and a local symbol
# named z would conflict while A's bare symbols are active. Explicit A::... use
# always bypasses the bare index.
