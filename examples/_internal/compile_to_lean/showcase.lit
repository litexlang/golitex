# Current strict Litex-to-Lean universal-object showcase.

# Standard-domain and set parameters are both Litex.Object values. Their
# declarations retain separate membership and sethood propositions.
forall a R, b set:
    a = a
    b = b

# Nonempty-set and finite-set parameters remain Litex.Object values. Their
# predicates are derived in Lean from IsSet and the extension given by In.
forall s nonempty_set, t finite_set:
    s = s
    t = t

# One object can retain memberships in both C and R. The R proof justifies the
# application; it does not retype the object.
forall a C, f fn(x R) R:
    a = 1
    =>:
        1 $in R
        a $in R
        f(a) = f(a)

# A trusted source theorem is cited later by its exact FactId.
abstract_prop marked(x)

trust forall x R:
    x = 1
    =>:
        $marked(x)

forall a R:
    a = 1
    a != 0
    =>:
        $marked(a)

# Concrete proposition and explicit-value object definitions retain exact
# parameter/clause and type/equality facts. Only this explicit trust is an
# additional target axiom; its later citation is a theorem reuse.
abstract_prop highlighted(x)

prop is_zero(x R):
    x = 0

have named_zero R = 0
by def $is_zero(named_zero)

trust $highlighted(named_zero)
$highlighted(named_zero)

# Ordinary builtin certificates call real theorems from the shared Lean
# library, not repeated theorem bodies or invented axioms.
forall a, b set:
    a != b
    =>:
        b != a

1 $in N
1 $in C

# Known equality certificates retain their exact direct FactId path. Lean
# replays a reversed edge with Eq.symm and connected edges with Eq.trans.
forall a, b set:
    a = b
    =>:
        b = a

forall a, b, c set:
    a = b
    b = c
    =>:
        a = c

# Source application groups remain exact target list-application layers.
forall f fn(x, y, z R) R:
    f(1, 2, 3) = f(1, 2, 3)

forall g fn(x R) fn(y R) R:
    g(1)(2) = g(1)(2)

# Nested forall application, universal arithmetic, and normalization replay.
forall h fn(x R) R:
    forall y R:
        h(y) = h(y - 1)
    =>:
        h(2) = h(1)

# Arithmetic constructors consume the exact complex-membership WD facts;
# nested result membership is named before the outer constructor cites it.
forall u, v, w C:
    (u + v) + w = (u + v) + w

forall u, v, w C:
    ((u - v) * w) + u = ((u - v) * w) + u
