# Isolated bundled-structure fixture. The scalar operations belong to the
# vector-space value rather than appearing as a separate VectorSpace index.
struct ScalarSystem<s nonempty_set>:
    zero s
    one s
    add fn(x, y s) s
    mul fn(x, y s) s

struct VectorSpace<s nonempty_set, v nonempty_set>:
    scalars &ScalarSystem<s>
    zero v
    add fn(x, y v) v
    smul fn(a s, x v) v
    <=>:
        forall a, b s, x v:
            smul(scalars.mul(a, b), x) = smul(a, smul(b, x))
