# Alpha-renaming checks under explicit predicate assumptions.
abstract_prop alpha_assumption(f)
abstract_prop alpha_conclusion(f)

forall:
    $alpha_assumption(fn(k R) R {k})
    =>:
        $alpha_assumption(fn(i1 R) R {i1})

thm alpha_theorem:
    ? forall a R:
        $alpha_assumption(fn(k R) R {k+a})
        $alpha_conclusion(fn(k R) R {k+a})
        =>:
            $alpha_conclusion(fn(j R) R {j+a})

claim:
    ? forall a R:
        $alpha_assumption(fn(k R) R {k+a})
        $alpha_conclusion(fn(k R) R {k+a})
        =>:
            $alpha_conclusion(fn(j R) R {j+a})

claim:
    ? forall:
        $alpha_assumption(fn(i1 R) R {i1+1})
        $alpha_conclusion(fn(k R) R {k+1})
        =>:
            $alpha_conclusion(fn(j R) R {j+1})
    by thm alpha_theorem(1) => $alpha_conclusion(fn(i1 R) R {i1+1})
