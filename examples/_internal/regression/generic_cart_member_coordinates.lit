# Fixed n=3 tuple/cart migration uses current declarations and explicit proof bridges.
# The two symbolic-dimension tuple construction blocks below remain unresolved.
# No trust; see plan/迁移的plan/experience/problem_notes/example_authoring_round36_2026-10-04.md.
have n N+ = 3
have c set = cart(R,R,R)
proj(c,1) = proj(cart(R,R,R),1) = R
proj(c,2) = proj(cart(R,R,R),2) = R
proj(c,3) = proj(cart(R,R,R),3) = R
closed_range(1,n) = closed_range(1,3)
by for:
    ? forall j closed_range(1,3):
        proj(c,j) = R
forall j closed_range(1,n):
    proj(c,j) = R
forall p c:
    tuple_dim(p) = n
claim:
    ? forall p c, j closed_range(1,n):
        p[j] $in proj(c,j)
    proj(c,j) = R
    p[j] $in R
    p[j] $in proj(c,j)
forall p c:
    p[1] $in proj(c,1)
    proj(c,1) = R
    p[1] $in R
    p[2] $in proj(c,2)
    proj(c,2) = R
    p[2] $in R
    p[3] $in proj(c,3)
    proj(c,3) = R
    p[3] $in R
have q cart(R,R,R) = (0,0,0)
have r cart(R,R,R) = (0,0,0)
tuple_dim(q) = n
by for:
    ? forall j closed_range(1,3):
        q[j] = 0
        r[j] = 0
        q[j] = r[j]
forall j closed_range(1,n):
    q[j] = 0
    0 $in R
    proj(c,j) = R
    q[j] $in proj(c,j)
closed_range(1,cart_dim(c)) = closed_range(1,n)
claim:
    ? forall j closed_range(1,cart_dim(c)):
        q[j] $in proj(c,j)
    proj(c,j) = R
    q[j] $in R
    q[j] $in proj(c,j)
release thm cart_member_from_coordinates(q,c)
q $in c
forall j closed_range(1,n):
    q[j] = 0
    r[j] = 0
    q[j] = r[j]
release thm tuple_equal_from_coordinates(q,r)
q = r
have fn raw_choice_tuple_encode(p c) fn(j closed_range(1,n)) R = fn(k closed_range(1,n)) R {p[k]}
have fn X(i1 closed_range(1, n)) power_set(R) = R
prop has_X_values(f fn(i1 closed_range(1, n)) R):
    forall j closed_range(1, n):
        f(j) $in X(j)
prop has_values_in_family(m N+, V set, Y fn(i1 closed_range(1, m)) power_set(V), g fn(i1 closed_range(1, m)) V):
    forall i1 closed_range(1, m):
        g(i1) $in Y(i1)
have P set = {f fn(i1 closed_range(1, n)) R: $has_X_values(f)}

claim:
    ? forall p c:
        raw_choice_tuple_encode(p) $in P
    raw_choice_tuple_encode(p) = fn(k closed_range(1,n)) R {p[k]}
    have h fn(j closed_range(1,n)) R = raw_choice_tuple_encode(p)
    h = raw_choice_tuple_encode(p) = fn(k closed_range(1,n)) R {p[k]}
    claim:
        ? forall i1 closed_range(1, n):
            h(i1) $in X(i1)
        h(i1) = p[i1]
        p[i1] $in R
        R = R = X(i1)
        p[i1] $in X(i1)
    forall i1 closed_range(1,n):
        raw_choice_tuple_encode(p)(i1) = p[i1]
    $has_X_values(h)
    release thm set_builder_member(h, {f fn(i1 closed_range(1, n)) R: $has_X_values(f)})
    h $in {f fn(i1 closed_range(1, n)) R: $has_X_values(f)}
    raw_choice_tuple_encode(p) $in P

have fn choice_tuple_encode(p c) P = raw_choice_tuple_encode(p)


# Symbolic dimensions remain available for a tuple defined inside a forall proof.
claim:
    ? forall m N+:
        2 <= m
        =>:
            m = m
    1 <= m
    # TODO: removed have-indexed stmt; use have fn
    # have tuple symbolic_tuple for i1 <= m, symbolic_tuple[i1] = 0
    tuple_dim(symbolic_tuple) = m

claim:
    ? forall m N+, V set, Y fn(i1 closed_range(1, m)) power_set(V), S set:
        2 <= m
        S = {g fn(i1 closed_range(1, m)) V: $has_values_in_family(m, V, Y, g)}
        =>:
            S = S
    1 <= m
    claim:
        ? forall g S:
            g = g
        g $in {h fn(i1 closed_range(1, m)) V: $has_values_in_family(m, V, Y, h)}
        # TODO: removed have-indexed stmt; use have fn
        # have tuple tuple_from_member for i1 <= m, tuple_from_member[i1] = g(i1)
        tuple_dim(tuple_from_member) = m
