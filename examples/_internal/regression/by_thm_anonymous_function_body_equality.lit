thm apply_equal_argument:
    ? forall X,Y set,F fn(x X)Y,a,b X:
        a = b
        =>:
            F(a) = F(b)
abstract_prop is_probe_integrable(f)
thm direct_anonymous_function_body_equality:
    ? forall g fn(x R) R:
        fn(x R) R {-1 * 1 * g(x)} = fn(x R) R {-1 * g(x)}
    by fn_extension:
        ? fn(x R) R {-1 * 1 * g(x)} = fn(x R) R {-1 * g(x)}
        forall y R:
            fn(x R) R {-1 * 1 * g(x)}(y) = -1 * 1 * g(y)
            -1 * 1 * g(y) = -1 * g(y)
            fn(x R) R {-1 * g(x)}(y) = -1 * g(y)
            fn(x R) R {-1 * 1 * g(x)}(y) = fn(x R) R {-1 * g(x)}(y)

claim:
    ? forall probe_integral fn(f fn(x R) R) R,f,g fn(x R) R:
        probe_integral(fn(x R) R {-1*g(x)}) = -1*probe_integral(g)
        probe_integral(fn(x R) R {f(x)+-1*g(x)}) = probe_integral(f)+probe_integral(fn(x R) R {-1*g(x)})
        $is_probe_integrable(f)
        $is_probe_integrable(g)
        =>:
            probe_integral(fn(x R) R {f(x)-g(x)}) = probe_integral(f)-probe_integral(g)
    by fn_extension:
        ? fn(x R)R{f(x)-g(x)} = fn(x R)R{f(x)+-1*g(x)}
        forall z R:
            fn(x R)R{f(x)-g(x)}(z) = f(z)-g(z)
            f(z)-g(z) = f(z)+-1*g(z)
            fn(x R)R{f(x)+-1*g(x)}(z) = f(z)+-1*g(z)
            fn(x R)R{f(x)-g(x)}(z) = fn(x R)R{f(x)+-1*g(x)}(z)
    release thm apply_equal_argument(fn(x R)R,R,probe_integral,fn(x R)R{f(x)-g(x)},fn(x R)R{f(x)+-1*g(x)})
    probe_integral(f)+probe_integral(fn(x R)R{-1*g(x)}) = probe_integral(f)+-1*probe_integral(g)
    probe_integral(f)+-1*probe_integral(g) = probe_integral(f)-probe_integral(g)
    probe_integral(fn(x R)R{f(x)-g(x)}) = probe_integral(fn(x R)R{f(x)+-1*g(x)}) = probe_integral(f)+probe_integral(fn(x R)R{-1*g(x)}) = probe_integral(f)+-1*probe_integral(g) = probe_integral(f)-probe_integral(g)
