thm apply_equal_argument:
    ? forall X,Y set,F fn(x X)Y,a,b X:
        a = b
        =>:
            F(a) = F(b)
# Migration blocker B11: see plan/迁移的plan/和example有关.md.
# The first equality uses checked fn_extension. Opaque integral assumptions remain unproved.
# A strict isolated counterpart lives in proof_nodes/equal/by_builtin_rule/anonymous_function_beta_extension.lit.
# A theorem instantiated with an anonymous function may introduce a beta-expanded
# body.  The stored fact must still match the handwritten rationally equal body.
abstract_prop is_probe_integrable(f)
trust have probe_integral fn(f fn(x R) R) R

thm direct_anonymous_function_body_equality:
    ? forall g fn(x R) R:
        fn(x R) R {-1 * 1 * g(x)} = fn(x R) R {-1 * g(x)}
    by fn_extension:
        ? fn(x R) R {-1 * 1 * g(x)} = fn(x R) R {-1 * g(x)}
        forall y R:
            fn(x R) R {-1 * 1 * g(x)}(y) = -1 * 1 * g(y)
            -1 * 1 * g(y) = -1 * g(y)
            fn(x R) R {-1 * g(x)}(y) = -1 * g(y)
            fn(x R) R {-1 * 1 * g(x)}(y) = fn(x R) R {-1 * g(x)}(y)

thm probe_scalar_multiplication:
    ? forall f fn(x R) R, c R:
        $is_probe_integrable(f)
        =>:
            $is_probe_integrable(fn(x R) R {c * f(x)})
            probe_integral(fn(x R) R {c * f(x)}) = c * probe_integral(f)
    trust:
        $is_probe_integrable(fn(x R) R {c * f(x)})
        probe_integral(fn(x R) R {c * f(x)}) = c * probe_integral(f)

thm probe_addition:
    ? forall f, g fn(x R) R:
        $is_probe_integrable(f)
        $is_probe_integrable(g)
        =>:
            $is_probe_integrable(fn(x R) R {f(x) + g(x)})
            probe_integral(fn(x R) R {f(x) + g(x)}) = probe_integral(f) + probe_integral(g)
    trust:
        $is_probe_integrable(fn(x R) R {f(x) + g(x)})
        probe_integral(fn(x R) R {f(x) + g(x)}) = probe_integral(f) + probe_integral(g)

thm probe_subtraction:
    ? forall f, g fn(x R) R:
        $is_probe_integrable(f)
        $is_probe_integrable(g)
        =>:
            probe_integral(fn(x R) R {f(x) - g(x)}) = probe_integral(f) - probe_integral(g)
    have h fn(x R)R = fn(y R)R{-1*g(y)}
    release thm probe_scalar_multiplication(g,-1)
    release thm apply_equal_argument(fn(x R)R,R,probe_integral,h,fn(x R)R{-1*g(x)})
    release thm probe_addition(f,h)
    by fn_extension:
        ? fn(x R)R{f(x)-g(x)} = fn(x R)R{f(x)+h(x)}
        forall z R:
            h(z) = -1*g(z)
            fn(x R)R{f(x)-g(x)}(z) = f(z)-g(z)
            f(z)-g(z) = f(z)+-1*g(z)
            f(z)+-1*g(z) = f(z)+h(z)
            f(z)-g(z) = f(z)+h(z)
            fn(x R)R{f(x)+h(x)}(z) = f(z)+h(z)
            fn(x R)R{f(x)-g(x)}(z) = fn(x R)R{f(x)+h(x)}(z)
    release thm apply_equal_argument(fn(x R)R,R,probe_integral,fn(x R)R{f(x)-g(x)},fn(x R)R{f(x)+h(x)})
    probe_integral(f)+probe_integral(h) = probe_integral(f)+-1*probe_integral(g)
    probe_integral(f)+-1*probe_integral(g) = probe_integral(f)-probe_integral(g)
    probe_integral(fn(x R)R{f(x)-g(x)}) = probe_integral(fn(x R)R{f(x)+h(x)}) = probe_integral(f)+probe_integral(h) = probe_integral(f)+-1*probe_integral(g) = probe_integral(f)-probe_integral(g)
