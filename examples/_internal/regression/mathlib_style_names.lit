# This example uses Lean/Mathlib-style theorem names while keeping trivial
# builtin arithmetic facts local to the source.

thm add_comm:
    ? forall a, b R:
        a + b = b + a

thm zero_add:
    ? forall a R:
        0 + a = a

thm left_distrib:
    ? forall a, b, c R:
        a * (b + c) = a * b + a * c

by thm add_comm(2, 3)
2 + 3 = 3 + 2

by thm zero_add(5)
0 + 5 = 5

by thm left_distrib(2, 3, 4)
2 * (3 + 4) = 2 * 3 + 2 * 4
