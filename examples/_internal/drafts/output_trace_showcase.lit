# Output demo for claims, proof commands, and predicate registration.

# Claim forall: parameters, stored assumptions, proof steps, and conclusions.
claim:
    ? forall x {y R: y > 0}:
        x = 1
        =>:
            x = 1
    x = x

# Ordinary claim: proof steps and the final goal verification.
claim:
    ? 1 = 1
    1 = 1

# By cases: coverage, each case assumption, conclusions, and impossible checks.
by cases:
    ? 1 = 1
    ? 2 = 2
    case 1 = 1
    case 1 != 1:
        impossible 1 = 1

# By contra: reversed assumption, proof steps, and impossible checks.
by contra:
    ? 1 = 1
    impossible 1 != 1

# By thm: theorem arguments, parameter/domain checks, and stored then facts.
thm tmp_one_eq_one:
    ? forall:
        1 = 1

release thm tmp_one_eq_one()

# By enumerate finite_set: each finite assignment is checked separately.
by enumerate finite_set:
    ? forall a {1, 2}:
        a < 3

# By for: each integer assignment is checked separately.
by for:
    ? forall n range(0, 3):
        n < 3

# By expand: membership expands into equality cases.
claim:
    ? forall x range(1, 3):
        x = 1 or x = 2
    expand: x $in range(1, 3)

# Expand closed_range / a...b: equivalent closed-range case expansion.
claim:
    ? forall y closed_range(1, 2):
        y = 1 or y = 2
    expand: y $in 1...2

# By extension: checks both subset directions before storing set equality.
by extension:
    ? {1} = {1}

# By induc: structured base and induction-step proof trace.
abstract_prop tmp_induc_p(a)
thm tmp_induction_trace:
    ? forall n Z:
        n >= 0
        $tmp_induc_p(0)
        forall m Z:
            m >= 0
            $tmp_induc_p(m)
            =>:
                $tmp_induc_p(m + 1)
        =>:
            $tmp_induc_p(n)
    by induc n from 0:
        ? $tmp_induc_p(n)
        ? from n = 0:
            $tmp_induc_p(0)
        ? induc:
            $tmp_induc_p(n + 1)

# Predicate registration: reflexivity, transitivity, and symmetry.
prop tmp_same_obj(x set, y set):
    x = y

register reflexive:
    ? forall x set:
        $tmp_same_obj(x, x)

register transitive:
    ? forall x, y, z set:
        $tmp_same_obj(x, y)
        $tmp_same_obj(y, z)
        =>:
            $tmp_same_obj(x, z)

register symmetric:
    ? forall x, y set:
        $tmp_same_obj(x, y)
        =>:
            $tmp_same_obj(y, x)


# A nonempty index and nonempty factors give a nonempty indexed product.
thm tmp_choice_trace:
    ? forall tmp_index nonempty_set,tmp_factors nonempty_set,tmp_family fn(tmp_coordinate tmp_index) tmp_factors:
        forall X tmp_factors:
            $is_nonempty_set(X)
        =>:
            $is_nonempty_set(index_cart(tmp_index,tmp_factors,tmp_family))
    release thm index_cart_nonempty_by_choice_from_family(index_cart(tmp_index,tmp_factors,tmp_family))
