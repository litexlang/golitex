# Exact special values and integer functions calculate natively.
exp(0) = 1
ln(1) = 0
sign(-9) = -1
sign(0) = 0
sign(2.5) = 1
factorial(10) = 3628800

# The analytic functions expose their natural domains and identities.
forall x R:
    exp(x) $in R+
    exp(x) > 0
    exp(x) = e^x
    ln(exp(x)) = x

forall x R:
    x > 0
    =>:
        ln(x) $in R
        exp(ln(x)) = x
        ln(x) = log(e, x)

forall a, b R:
    exp(a + b) = exp(a) * exp(b)
    exp(a - b) = exp(a) / exp(b)

# Tracer: native exp/ln order preservation.
#
# Before (did not work):
# forall a, b R:
#     a < b
#     =>:
#         exp(a) < exp(b)
# Former behavior: the final strict-order goal was unknown.
#
# Now (verified):
forall a, b R:
    a < b
    =>:
        exp(a) < exp(b)

forall a, b R:
    a <= b
    =>:
        exp(a) <= exp(b)

forall a, b R+:
    a < b
    =>:
        ln(a) < ln(b)

forall a, b R+:
    a >= b
    =>:
        ln(a) >= ln(b)

forall a, b R:
    exp(a) < exp(b)
    =>:
        a < b

forall a, b R:
    exp(a) = exp(b)
    =>:
        a = b

forall a, b R+:
    ln(a) <= ln(b)
    =>:
        a <= b

forall a, b R+:
    ln(a) = ln(b)
    =>:
        a = b
# Current behavior: native exp and ln preserve and reflect strict/weak order and equality.
# Boundary: a weak argument order does not prove a strict result order.
# Evidence: target/release/litex -compact -isolated -f examples/02_builtin_math/native_exp_sign_factorial.lit
# Implementation: src/verify/verify_builtin_rules/native_exp_sign_factorial.rs

forall a, b R:
    a > 0
    b > 0
    =>:
        ln(a * b) = ln(a) + ln(b)

forall x R:
    x > 1
    =>:
        ln(x) > 0

forall x R:
    x > 0
    x < 1
    =>:
        ln(x) < 0

# sign and factorial expose their characteristic algebra.
forall x R:
    sign(x) $in Z
    -1 <= sign(x)
    sign(x) <= 1
    sign(x) * abs(x) = x

forall x R:
    x > 0
    =>:
        sign(x) = 1

forall x R:
    x = 0
    =>:
        sign(x) = 0

forall x R:
    x < 0
    =>:
        sign(x) = -1

forall a, b R:
    a <= b
    =>:
        sign(a) <= sign(b)

forall a, b R:
    sign(-a) = -sign(a)
    sign(a * b) = sign(a) * sign(b)

forall x R:
    sign(x) = 0
    =>:
        x = 0

forall x R:
    x != 0
    =>:
        sign(x) != 0

forall x R:
    sign(x) != 0
    =>:
        x != 0

forall n N:
    factorial(n) $in N+
    factorial(n) >= 1
    factorial(n + 1) = (n + 1) * factorial(n)

forall n N:
    n >= 1
    =>:
        factorial(n) = n * factorial(n - 1)

forall m, n N:
    m <= n
    =>:
        factorial(m) <= factorial(n)
        factorial(n) % factorial(m) = 0

forall m, n N+:
    m < n
    =>:
        factorial(m) < factorial(n)

# Native objects remain usable inside first-class function literals.
have fn apply_real_map(f fn(t R) R, x R) R = f(x)
by thm fn_set_member(fn(y R) R {exp(y)}, fn(t R) R)
fn(y R) R {exp(y)}(0) = 1
apply_real_map(fn(y R) R {exp(y)}, 0) = 1

eval exp(0)
eval ln(1)
eval sign(-4.25)
eval factorial(8)
