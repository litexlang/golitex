# Real power laws checked directly by the verifier, with no imported theory package.

forall a R+, b, c R:
    a^(b+c) = a^b * a^c
    (a^b)^c = a^(b*c)

# A positivity hypothesis makes the same rule available in an nth-root calculation.
forall x R, n N+:
    x > 0
    =>:
        (x^(1 / n))^n = x^((1 / n) * n) = x^1 = x

# A positive-natural base remains nonzero after an integer power, so its
# reciprocal is well-defined even inside a predicate definition.
prop has_reciprocal_square_value(u fn(n N+) R):
    forall n N+:
        u(n) = 1 / n^2

prop reciprocal_is_defined_on_positive_closed_interval(a, b R+):
    forall x '[a, b]:
        1 / x $in R
