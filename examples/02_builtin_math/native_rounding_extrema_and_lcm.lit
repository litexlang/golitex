# Native integer rounding computes exact decimal inputs.
floor(3.75) = 3
floor(-3.75) = -4
ceil(3.25) = 4
ceil(-3.25) = -3

# Binary extrema and lcm also normalize concrete inputs.
min(7, -2) = -2
max(7, -2) = 7
lcm(12, -18) = 36
lcm(0, 0) = 0

# Native functions remain first-class objects.
have fn apply_integer_map(f fn(t R) Z, x R) Z = f(x)
by thm fn_set_member(fn(y R) Z {floor(y)}, fn(t R) Z)
apply_integer_map(fn(y R) Z {floor(y)}, 3.75) = (fn(y R) Z {floor(y)})(3.75) = floor(3.75) = 3

# Symbolic objects expose their characteristic contracts.
forall x R:
    floor(x) $in Z
    ceil(x) $in Z
    floor(x) <= x
    x < floor(x) + 1
    ceil(x) - 1 < x
    x <= ceil(x)

forall n Z:
    floor(n) = n
    ceil(n) = n

forall a, b R:
    min(a, b) <= a
    min(a, b) <= b
    a <= max(a, b)
    b <= max(a, b)

forall a, b R:
    a <= b
    =>:
        min(a, b) = a
        max(a, b) = b

# Tracer: native rounding and extrema order connections.
#
# Before (did not work):
# forall a, b R:
#     a <= b
#     =>:
#         floor(a) <= floor(b)
# Former behavior: the rounded order goal was unknown.
#
# Now (verified):
forall a, b R:
    a <= b
    =>:
        floor(a) <= floor(b)
        ceil(a) <= ceil(b)

forall a, b, c, d R:
    a <= c
    b <= d
    =>:
        min(a, b) <= min(c, d)
        max(a, b) <= max(c, d)

forall a, b, c R:
    min(a, b) = min(b, a)
    max(a, b) = max(b, a)
    min(min(a, b), c) = min(a, min(b, c))
    max(max(a, b), c) = max(a, max(b, c))
    min(a, max(a, b)) = a
    max(a, min(a, b)) = a

forall x R, n Z:
    floor(-x) = -ceil(x)
    ceil(-x) = -floor(x)
    floor(x + n) = floor(x) + n
    ceil(x + n) = ceil(x) + n
# Current behavior: rounding preserves weak order and extrema expose lattice laws.
# Boundary: strict input order does not imply strict floor or ceiling order.

forall a, b Z:
    lcm(a, b) $in N

forall a, b Z:
    a != 0 or b != 0
    =>:
        lcm(a, b) * gcd(a, b) = abs(a * b)

forall a, b Z:
    lcm(a, b) = lcm(b, a)

forall a Z:
    lcm(a, 0) = 0
    lcm(0, a) = 0

forall a, b Z:
    a != 0
    b != 0
    =>:
        lcm(a, b) % abs(a) = 0
        lcm(a, b) % abs(b) = 0

forall a, b Z*, m N+:
    m % abs(a) = 0
    m % abs(b) = 0
    =>:
        lcm(a, b) <= m

eval floor(-8.125)
eval ceil(8.125)
eval min(4, -9)
eval max(4, -9)
eval lcm(21, 6)
