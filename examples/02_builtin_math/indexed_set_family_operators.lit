# Tracer: first-class indexed union and indexed intersection.
#
# Before (did not work):
# index_union({1}, N, family) $in power_set(N)
# Former behavior: `WellDefinedError: function 'index_union' not defined`.

have fn family(k {1, 2, 3}) power_set(N) = {1, 2, 3}

# Expose the three checked fibers used by the membership rules.
family(1) = {1, 2, 3}
family(2) = {1, 2, 3}
family(3) = {1, 2, 3}
1 $in {1, 2, 3}
3 $in {1, 2, 3}
1 $in family(1)
1 $in family(2)
1 $in family(3)
3 $in family(3)

# Now: one fiber witness introduces indexed-union membership.
3 $in index_union({1, 2, 3}, N, family)
exist k {1, 2, 3} st {3 $in family(k)}

# Now: ambient membership plus membership in every fiber introduces
# indexed-intersection membership.
1 $in index_intersect({1, 2, 3}, N, family)
forall k {1, 2, 3}:
    1 $in family(k)

# Both constructions retain their explicit ambient carrier.
index_union({1, 2, 3}, N, family) $in power_set(N)
index_intersect({1, 2, 3}, N, family) $in power_set(N)

# They agree with the older range encodings where those encodings have the
# corresponding semantics. The intersection bridge requires a nonempty index.
index_union({1, 2, 3}, N, family) = family_union(fn_range(family))
$is_nonempty_set({1, 2, 3})
index_intersect({1, 2, 3}, N, family) = family_intersect(fn_range(family))

# Before (the domain-union equalities were well-defined but not recognized):
# index_union(union({1}, {2}), N, domain_union_family) = union(index_union({1}, N, fn(left_index {1}) power_set(N) {domain_union_family(left_index)}), index_union({2}, N, fn(right_index {2}) power_set(N) {domain_union_family(right_index)}))
# index_intersect(union({1}, {2}), N, domain_union_family) = intersect(index_intersect({1}, N, fn(left_index {1}) power_set(N) {domain_union_family(left_index)}), index_intersect({2}, N, fn(right_index {2}) power_set(N) {domain_union_family(right_index)}))
# Former behavior: both equalities ended in `UnknownError` after well-definedness.

have fn domain_union_family(domain_index union({1}, {2})) power_set(N) = {1}

# Now: splitting a union index domain splits the indexed union/intersection.
# Each branch is the literal anonymous restriction of the original family.
index_union(union({1}, {2}), N, domain_union_family) = union(index_union({1}, N, fn(left_index {1}) power_set(N) {domain_union_family(left_index)}), index_union({2}, N, fn(right_index {2}) power_set(N) {domain_union_family(right_index)}))
index_intersect(union({1}, {2}), N, domain_union_family) = intersect(index_intersect({1}, N, fn(left_index {1}) power_set(N) {domain_union_family(left_index)}), index_intersect({2}, N, fn(right_index {2}) power_set(N) {domain_union_family(right_index)}))

# Boundary: the domain of the family may be empty. The ambient argument makes
# the empty indexed intersection equal to N rather than to an implicit universe.
have fn empty_family(k {}) power_set(N) = {}
1 $in index_intersect({}, N, empty_family)
index_union({}, N, empty_family) = {}
index_intersect({}, N, empty_family) = N

# The algebra rules remain ordinary one-step builtins. They match the exact
# displayed family transformation and consume only an explicit direct premise
# when the mathematics needs one.
have fn algebra_A(k {1, 2}) power_set(N) = {1}
have fn algebra_B(k {1, 2}) power_set(N) = {2}

algebra_A(1) $subset index_union({1, 2}, N, algebra_A)
index_intersect({1, 2}, N, algebra_A) $subset algebra_A(2)

# Before (the algebraic family transformation was well-defined but unknown):
# set_minus(N, index_union({1, 2}, N, algebra_A)) = index_intersect({1, 2}, N, fn(k {1, 2}) power_set(N) {set_minus(N, algebra_A(k))})
# Former behavior: verification ended in `UnknownError` after well-definedness.

# Now (verified): indexed De Morgan and the corrected external set-difference
# law are exact leaf builtins.
set_minus(N, index_union({1, 2}, N, algebra_A)) = index_intersect({1, 2}, N, fn(k {1, 2}) power_set(N) {set_minus(N, algebra_A(k))})
set_minus(R, index_intersect({1, 2}, N, algebra_A)) = union(set_minus(R, N), index_union({1, 2}, R, fn(k {1, 2}) power_set(R) {set_minus(R, algebra_A(k))}))

# Pointwise union commutes with indexed union. Pointwise intersection under an
# indexed union is intentionally only an inclusion (covered by negative Rust
# regression when strengthened to equality).
index_union({1, 2}, N, fn(k {1, 2}) power_set(N) {union(algebra_A(k), algebra_B(k))}) = union(index_union({1, 2}, N, algebra_A), index_union({1, 2}, N, algebra_B))
index_union({1, 2}, N, fn(k {1, 2}) power_set(N) {intersect(algebra_A(k), algebra_B(k))}) $subset intersect(index_union({1, 2}, N, algebra_A), index_union({1, 2}, N, algebra_B))

# Common adapters use the same exact leaf-matcher discipline.
have fn algebra_value(k {1, 2}) N = 1
index_union({1, 2}, N, fn(k {1, 2}) power_set(N) {{algebra_value(k)}}) = fn_range(algebra_value)
power_set(index_intersect({1, 2}, N, algebra_A)) = index_intersect({1, 2}, power_set(N), fn(k {1, 2}) power_set(power_set(N)) {power_set(algebra_A(k))})
cart(Z, set_minus(N, {1})) = set_minus(cart(Z, N), cart(Z, {1}))

# Boundary: a family returning N instead of power_set(N), a family with a
# different exact index domain, a non-restriction branch body, a changed fixed
# Cartesian coordinate, or a false equality strengthening is rejected by the
# executable Rust regression.
#
