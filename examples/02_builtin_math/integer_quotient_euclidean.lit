# Before migration, this example used a standard-library selection function
# with the interface below:
# forall a Z, d N+:
#     quot(a, d) $in Z
#     a = d * quot(a, d) + a % d
# quot(-7, 3) = -3
# -7 = 3 * quot(-7, 3) + -7 % 3

# Active interface: quot is a kernel object, so no std import is needed.
# Boundary: the dividend must be in Z and the divisor must be in N+.
# Evidence: target/release/litex -isolated -f examples/02_builtin_math/integer_quotient_euclidean.lit

forall a Z, d N+:
    quot(a, d) $in Z
    a = d * quot(a, d) + a % d

# A bounded decomposition has the Euclidean remainder.
forall a Z, m N+, q Z, r N:
    r < m
    a = m * q + r
    =>:
        a % m = r

# Negative dividends use non-negative Euclidean remainders.
quot(-7, 3) = -3
-7 % 3 = 2
-7 = 3 * quot(-7, 3) + -7 % 3
