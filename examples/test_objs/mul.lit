# AST: Obj::ArithmeticOperator::Mul
# Run: target/release/litex -f examples/test_objs/mul.lit
# Cases are checked directly in file context.

# P01: 2 * 3 = 6
2 * 3 = 6

# P02: 0 * 999 = 0
0 * 999 = 0

# P03: (-2) * (-3) = 6
(-2) * (-3) = 6

# P04: 2 * (3 + 4) = 14
2 * (3 + 4) = 14

# P05: i * i = -1
i * i = -1

# P06: x * y = y * x
forall x, y C:
    x * y = y * x

# P07: x * (y + z) = x * y + x * z
forall x, y, z R:
    x * (y + z) = x * y + x * z
