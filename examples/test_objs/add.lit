# AST: Obj::ArithmeticOperator::Add
# Run: target/release/litex -f examples/test_objs/add.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: 1 + 2 = 3
sketch:
    1 + 2 = 3

# P02: (-2) + 2 = 0
sketch:
    (-2) + 2 = 0

# P03: 1 / 2 + 1 / 3 = 5 / 6
sketch:
    1 / 2 + 1 / 3 = 5 / 6

# P04: 1 + 2 * 3 = 7
sketch:
    1 + 2 * 3 = 7

# P05: (1 + i) + (2 - i) = 3
sketch:
    (1 + i) + (2 - i) = 3

# P06: x + y = y + x
sketch:
    forall x, y C:
        x + y = y + x

# P07: (x + 2) + 3 = x + 5
sketch:
    forall x R:
        (x + 2) + 3 = x + 5
