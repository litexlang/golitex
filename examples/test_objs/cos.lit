# AST: Obj::TrigOperator::Cos
# Run: target/release/litex -f examples/test_objs/cos.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: cos(0) = 1
sketch:
    cos(0) = 1

# P02: cos(pi) = -1
sketch:
    cos(pi) = -1

# P03: cos(pi / 2) = 0
sketch:
    cos(pi / 2) = 0

# P05: cos(x) $in R
sketch:
    forall x R:
        cos(x) $in R

# P06: recovered unchanged regression
sketch:
    forall x R:
        cos(-x) = cos(x)
