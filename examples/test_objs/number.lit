# AST: Obj::Literal::Number
# Run: target/release/litex -f examples/test_objs/number.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: 0 $in N
sketch:
    0 $in N

# P02: 42 $in N+
sketch:
    42 $in N+

# P03: 2.400 = 2.4
sketch:
    2.400 = 2.4

# P04: 0.1 + 0.2 = 0.3
sketch:
    0.1 + 0.2 = 0.3

# P05: 12345678901234567890 + 1 = 12345678901234567891
sketch:
    12345678901234567890 + 1 = 12345678901234567891

# P06: (-2.5) $in Q
sketch:
    (-2.5) $in Q

# P07: 0.0001 = 1 / 10000
sketch:
    0.0001 = 1 / 10000

# P101: decimal integer and zero normalization
sketch:
    2.000 = 2
    0.000 = 0
    (-0.000) = 0
    2.000 $in Z

# P102: canonical decimals preserve order
sketch:
    2.400 <= 2.4
    2.400 >= 2.4
    2.400 - 2.4 = 0
