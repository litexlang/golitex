# AST: Obj::TrigOperator::Tan
# Run: target/release/litex -f examples/test_objs/tan.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: tan(0) = 0
sketch:
    tan(0) = 0

# P05: tan(arctan(2)) = 2
sketch:
    tan(arctan(2)) = 2

# P02: exact numeric/periodic/modulus repair; original source retained in the dated journal
sketch:
    tan(pi) = 0

# P03: exact numeric/periodic/modulus repair; original source retained in the dated journal
sketch:
    tan(pi / 4) = 1

# P04: exact numeric/periodic/modulus repair; original source retained in the dated journal
sketch:
    tan(-pi / 4) = -1

# P91: exact numeric/periodic/modulus boundary
sketch:
    have k Z
    tan(pi + 2 * k * pi)=0

# P92: exact numeric/periodic/modulus boundary
sketch:
    have k, j Z
    tan((k+j+1)*pi)=0

# P93: exact numeric/periodic/modulus boundary
sketch:
    have k Z
    tan(pi / 3 + k * pi)=sqrt(3)

# P200: Quotient definition with its nonzero denominator
sketch:
    forall x R:
        cos(x)!=0
        =>:
            tan(x)=sin(x)/cos(x)
