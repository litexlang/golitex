# AST: Obj::ArithmeticOperator::Floor
# Run: target/release/litex -f examples/test_objs/floor.lit
# Cases are checked directly in file context.

# P01: floor(0) = 0
floor(0) = 0

# P02: floor(3) = 3
floor(3) = 3

# P03: floor(3.7) = 3
floor(3.7) = 3

# P04: floor(-3.7) = -4
floor(-3.7) = -4

# P05: floor(1 / 2) = 0
floor(1 / 2) = 0

# P06: floor(x) = x
forall x Z:
    floor(x) = x

# P121: closed exact elementary calculation
floor(-7/3)=-3

# P122: closed exact elementary calculation
floor(7/3)=2

# P123: closed exact elementary calculation
floor(-6/3)=-2

# P200: Real defining bounds
forall x R:
    floor(x)<=x
    x<floor(x)+1
