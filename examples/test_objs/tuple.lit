# Tuple values and ordinary calls; each sketch has its own local names.
# Gate: target/release/litex -strict -f examples/test_objs/tuple.lit
# P03 formerly checked tuple_dim and is retired without a replacement feature.
sketch:
    let pair = (1,2)
    pair(1) = 1
sketch:
    let pair = (1,2)
    pair(2) = 2
sketch:
    have outer cart(cart(R,R),R) = ((1,2),3)
    outer(1) = (1,2)
    have inner cart(R,R) = outer(1)
    inner = outer(1) = (1,2)
    inner(2) = 2
sketch:
    (1+1,3) = (2,3)
sketch:
    let left = (1,2)
    let right = (2,1)
    by contra:
        ? (1,2) != (2,1)
        1 = left(1) = right(1) = 2
        impossible 1 = 2
