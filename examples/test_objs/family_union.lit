    1 $in family_union({{1}, {2}})


# P05: explicit checked proof; restored from family_union-P05
sketch:
    let U = family_union({{}, {1, 2}})
    by extension:
        ? U = {1, 2}
        {1, 2} $in {{}, {1, 2}}
        claim:
            ? forall x U:
                x $in {1, 2}
            x $in family_union({{}, {1, 2}})
            obtain A from exist A {{}, {1, 2}} st {x $in A}
            A = {} or A = {1, 2}
            by cases:
                ? x $in {1, 2}
                case A = {}:
                    x $in {}
                    impossible x $in {}
                case A = {1, 2}:
                    x $in {1, 2}
        forall x {1, 2}:
            x $in family_union({{}, {1, 2}})
            x $in U
