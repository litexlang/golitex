# AST: Obj::SetOperator::FamilyUnion
# Run: target/release/litex -f examples/test_objs/family_union.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: family_union({}) = {}
sketch:
    family_union({}) = {}

# P02: family_union({{1}}) = {1}
sketch:
    by extension:
        ? family_union({{1}}) = {1}
        {1} $in {{1}}
        claim:
            ? forall x family_union({{1}}):
                x $in {1}
            obtain A from exist A {{1}} st {x $in A}
            A = {1}
            x $in {1}
        forall x {1}:
            x $in family_union({{1}})

# P03: explicit checked proof; restored from family_union-P03
sketch:
    by contra:
        ? {1} != {2}
        1 $in {1}
        1 $in {2}
        impossible 1 $in {2}
    by extension:
        ? family_union({{1}, {2}}) = {1, 2}
        claim:
            ? forall x family_union({{1}, {2}}):
                x $in {1, 2}
            obtain A from exist A {{1}, {2}} st {x $in A}
            A = {1} or A = {2}
            by cases:
                ? x $in {1, 2}
                case A = {1}:
                    x $in {1}
                    x = 1
                case A = {2}:
                    x $in {2}
                    x = 2
        claim:
            ? forall x {1, 2}:
                x $in family_union({{1}, {2}})
            x = 1 or x = 2
            by cases:
                ? x $in family_union({{1}, {2}})
                case x = 1:
                    {1} $in {{1}, {2}}
                    x $in {1}
                case x = 2:
                    {2} $in {{1}, {2}}
                    x $in {2}


