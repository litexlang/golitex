# AST: Obj::TrigOperator::Arctan
# Run: target/release/litex -f examples/test_objs/arctan.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: arctan(0) = 0
sketch:
    arctan(0) = 0

# P02: arctan(1)=arctan(tan(pi/4))=pi/4
sketch:
    (-pi)/2 $in R
    pi/2 $in R
    pi/4 $in R
    cos(pi/4)!=0
    tan(pi/4)=1
    (-pi)/2<pi/4
    pi/4<pi/2
    arctan(1)=arctan(tan(pi/4))=pi/4

# P03: arctan(-1)=arctan(tan(-pi/4))=(-pi)/4
sketch:
    (-pi)/2 $in R
    pi/2 $in R
    (-pi)/4 $in R
    cos(-pi/4)!=0
    tan(-pi/4)=-1
    (-pi)/2<(-pi)/4
    (-pi)/4<pi/2
    arctan(-1)=arctan(tan(-pi/4))=(-pi)/4

# P04: tan(arctan(3)) = 3
sketch:
    tan(arctan(3)) = 3
