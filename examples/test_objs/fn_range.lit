# P01: fn_range(fn(x R) R {1}) = {1}
fn_range(fn(x R) R {1}) = {1}

# P02: fn_range(fn(x R) R {x}) = R
by extension:
    ? fn_range(fn(x R) R {x}) = R
    claim:
        ? forall y R:
            y $in fn_range(fn(x R) R {x})
        fn(x R) R{x}(y) = y
        fn(x R) R{x}(y) $in fn_range(fn(x R) R{x})

# P03: fn_range(f) = {1}
sketch:
    have fn f(x R) R = 1
    fn_range(f) = {1}

# P04: $is_set(I)
sketch:
    let f = fn(x N) N {x}
    let I = fn_range(f)
    $is_set(I)
