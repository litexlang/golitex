# P06: gcd(a, b) = gcd(b, a)
sketch:
    forall a, b Z:
        a != 0
        =>:
            gcd(a, b) = gcd(b, a)

# P121: closed exact elementary calculation
sketch:
    gcd((1/3)*6,8)=2

