# AST: Obj::IntegerOperator::Gcd
# Run: target/release/litex -f examples/test_objs/gcd.lit
# Cases are checked directly in file context.

# P01: gcd(54, 24) = 6
gcd(54, 24) = 6

# P02: gcd(54, -24) = 6
gcd(54, -24) = 6

# P03: gcd(7, 7) = 7
gcd(7, 7) = 7

# P04: gcd(0, -7) = 7
gcd(0, -7) = 7

# P05: gcd(7, 13) = 1
gcd(7, 13) = 1

# P06: gcd(a, b) = gcd(b, a)
forall a, b Z:
    a != 0
    =>:
        gcd(a, b) = gcd(b, a)

# P121: closed exact elementary calculation
gcd((1/3)*6,8)=2

# P122: closed exact elementary calculation
gcd((1/3)*(-6),8)=2

# P200: Euclidean step on integer inputs
forall a Z,b N+:
    gcd(a,b)=gcd(b,a%b)
