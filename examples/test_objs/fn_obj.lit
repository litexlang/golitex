# AST: Obj::FnObj
# Run: target/release/litex -f examples/test_objs/fn_obj.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: f(2) = 3
sketch:
    have fn f(x R) R = x + 1
    f(2) = 3

# P02: f(4, 1) = 3
sketch:
    have fn f(x, y R) R = x - y
    f(4, 1) = 3

# P03: fn(x R) R {x + 1}(2) = 3
sketch:
    fn(x R) R {x + 1}(2) = 3

# P04: fn(x R: x != 0) R {1 / x}(2) = 1 / 2
sketch:
    fn(x R: x != 0) R {1 / x}(2) = 1 / 2

# P05: have fn f(x R) R = x + 1; f(f(1)) = 3
sketch:
    have fn f(x R) R = x + 1
    f(1) = 2
    f(f(1)) = f(2) = 3

# P06: have fn f(x R) fn(y R) R = fn(y R) R {x + y}; f(2)(3) = 5
sketch:
    have fn f(x R) fn(y R) R = fn(y R) R {x + y}
    f(2) = fn(y R) R {2 + y}
    f(2)(3) = fn(y R) R {2 + y}(3) = 2 + 3 = 5

# P07: b.f(1) $in R
sketch:
    struct Bundle:
        f fn(x R) R
        tag N
    forall b &Bundle:
        b.f(1) $in R

# P08: \identity<R>(2) = 2
sketch:
    template<S set>:
        have fn identity(x S) S = x
    \identity<R>(2) = 2

# P09: f(f(1)) = f(2) = 3
sketch:
    have fn f(x R) R = x + 1
    f(1) = 2
    f(f(1)) = f(2) = 3

# Same original coordinate goals, now owned by ordinary FnObj.
# P10: select the first coordinate.
sketch:
    let pair = (1,2)
    pair(1) = 1
# P11: select the second coordinate.
sketch:
    let pair = (1,2)
    pair(2) = 2
# P12: select the third coordinate of the triple.
sketch:
    let triple = (1,2,3)
    triple(3) = 3
# P13: select a nested tuple coordinate through the checked inner value.
sketch:
    have outer cart(cart(R,R),R) = ((1,2),3)
    outer(1) = (1,2)
    have inner cart(R,R) = outer(1)
    inner = outer(1) = (1,2)
    inner(2) = 2
# P14: call the original named tuple value.
sketch:
    let t = (1,2)
    t(1) = 1
# P15: evaluate the original coordinate expression.
sketch:
    let pair = (2+3,4*2)
    pair(2) = 4*2 = 8

# P16: direct tuple literal call.
sketch:
    (1,2)(1)=1
# P17: literal coordinate carrier.
sketch:
    (1,2)(2) $in Z
# P18: literal nested tuple continuation.
sketch:
    ((1,2),3)(1)(2)=2
# P19: singleton tuple call.
sketch:
    tuple(7)(1)=7
# P20: literal coordinate evaluation.
sketch:
    eval (1,2)(2)
# P21: grouped already-applied function retains call layers.
sketch:
    have fn f(x R) fn(y R) R=fn(y R) R {x+y}
    (f(2))(3)=5
