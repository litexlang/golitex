# AST: Obj::SetOperator::Union
# Run: target/release/litex -f examples/test_objs/union.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: union({1}, {2}) = {1, 2}
sketch:
    by extension union({1}, {2}) = {1, 2}

# P02: union({}, {1}) = {1}
sketch:
    union({}, {1}) = {1}

# P03: union({1}, {1}) = {1}
sketch:
    union({1}, {1}) = {1}

# P04: 2 $in union({1}, {2})
sketch:
    2 $in union({1}, {2})

# P05: not 3 $in union({1}, {2})
sketch:
    not 3 $in union({1}, {2})

# P06: union(A, B) = union(B, A)
sketch:
    forall A, B set:
        union(A, B) = union(B, A)
