# AST: Obj::IteratedOperator::Sum
# Run: target/release/litex -f examples/test_objs/sum.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: sum(1, 1, fn(x Z) Z {x}) = 1
sketch:
    sum(1, 1, fn(x Z) Z {x}) = 1

# P02: sum(-2, -2, fn(x Z) Z {x}) = -2
sketch:
    sum(-2, -2, fn(x Z) Z {x}) = -2

# P03: sum(1, 3, fn(x Z) Z {x}) = 6
sketch:
    sum(1, 3, fn(x Z) Z {x}) = 6

# P04: sum(1, 3, fn(x Z) Z {2}) = 6
sketch:
    sum(1, 3, fn(x Z) Z {2}) = 6

# P05: sum(1, 3, fn(x Z) Z {x}) = sum(1, 2, fn(x Z) Z {x}) + 3
sketch:
    sum(1, 3, fn(x Z) Z {x}) = sum(1, 2, fn(x Z) Z {x}) + 3

# P06: sum(0, 0, fn(x Z) Z {0}) = 0
sketch:
    sum(0, 0, fn(x Z) Z {0}) = 0

# P101: negative endpoints and exact fractions
sketch:
    sum(-2,2,fn(k Z) Z {k*k}) = 10
    sum(1,3,fn(k Z) Q {1/3}) = 1

# P102: nested product and outer arithmetic
sketch:
    sum(1,3,fn(k N+) N+ {product(1,k,fn(j N+) N+ {j})}) = 9
    sum(1,3,fn(k Z) Z {k}) + product(1,3,fn(k Z) Z {k}) = 12

# P103: named function expansion
sketch:
    have fn square(k Z) Z = k*k
    sum(1,3,square) = 14
    eval sum(1,3,square)

# P104: binder substitution retains outer free value
sketch:
    sum(1,3,fn(x Z) Z {sum(1,2,fn(y Z) Z {x+y})}) = 21

# P105: every index satisfies the callable predicate
sketch:
    sum(1,3,fn(k Z:k!=0) Z {1}) = 3

# P106: algorithm terms use proved case equations
sketch:
    algo flag(x R) R by cases:
        case x = 0: 0
        case x != 0: 1
    flag(0) = 0
    flag(1) = 1
    flag(2) = 1
    flag(3) = 1
    sum(0,0,flag) = 0
    sum(0,1,flag) = sum(0,0,flag) + flag(1)
    sum(0,1,flag) = 1
    sum(0,2,flag) = sum(0,1,flag) + flag(2)
    sum(0,2,flag) = 2
    sum(0,3,flag) = sum(0,2,flag) + flag(3)
    sum(0,3,flag) = 3

# P107: symbolic constant, addition, subtraction and scalar
sketch:
    have n N+
    have c R
    have f,g fn(k Z) R
    claim:
        ? sum(1,n,fn(k Z) R {c}) = n*c
        let constant_terms = fn(k Z) R {c}
        by induc m from 1:
            ? sum(1,m,constant_terms) = m*c
            ? from m = 1:
                sum(1,m,constant_terms) = sum(1,1,constant_terms) = constant_terms(1) = c = m*c
            ? induc:
                m >= 1
                constant_terms(m+1) = c
                sum(1,m+1,constant_terms) = sum(1,m,constant_terms) + constant_terms(m+1) = m*c+c = (m+1)*c
        n $in Z
        n >= 1
        sum(1, n, fn(k Z) R {c}) = sum(1,n,constant_terms) = n*c
    claim:
        ? sum(1,n,fn(k Z) R {f(k)+g(k)}) = sum(1,n,f)+sum(1,n,g)
        let h = fn(k Z) R{f(k)+g(k)}
        by induc m from 1:
            ? sum(1,m,h) = sum(1,m,f)+sum(1,m,g)
            ? from m = 1:
                h(1) = f(1)+g(1)
                sum(1,1,f) = f(1)
                sum(1,1,g) = g(1)
                sum(1,1,h) = h(1) = f(1)+g(1) = sum(1,1,f)+sum(1,1,g)
            ? induc:
                m >= 1
                h(m+1) = f(m+1)+g(m+1)
                sum(1,m+1,f) = sum(1,m,f)+f(m+1)
                sum(1,m+1,g) = sum(1,m,g)+g(m+1)
                sum(1,m+1,h) = sum(1,m,h) + h(m+1) = (sum(1,m,f)+sum(1,m,g)) + (f(m+1)+g(m+1)) = (sum(1,m,f)+f(m+1)) + (sum(1,m,g)+g(m+1)) = sum(1,m+1,f) + (sum(1,m,g)+g(m+1)) = sum(1,m+1,f)+sum(1,m+1,g)
        n $in Z
        n >= 1
        sum(1,n,h) = sum(1,n,f)+sum(1,n,g)
        sum(1,n,fn(k Z) R{f(k)+g(k)}) = sum(1,n,h) = sum(1,n,f)+sum(1,n,g)
    claim:
        ? sum(1,n,fn(k Z) R {f(k)-g(k)}) = sum(1,n,f)-sum(1,n,g)
        let h = fn(k Z) R{f(k)-g(k)}
        by induc m from 1:
            ? sum(1,m,h) = sum(1,m,f)-sum(1,m,g)
            ? from m = 1:
                h(1) = f(1)-g(1)
                sum(1,1,f) = f(1)
                sum(1,1,g) = g(1)
                sum(1,1,h) = h(1) = f(1)-g(1) = sum(1,1,f)-sum(1,1,g)
            ? induc:
                m >= 1
                h(m+1) = f(m+1)-g(m+1)
                sum(1,m+1,f) = sum(1,m,f)+f(m+1)
                sum(1,m+1,g) = sum(1,m,g)+g(m+1)
                sum(1,m+1,h) = sum(1,m,h)+h(m+1) = (sum(1,m,f)-sum(1,m,g))+(f(m+1)-g(m+1)) = (sum(1,m,f)+f(m+1))-(sum(1,m,g)+g(m+1)) = sum(1,m+1,f)-(sum(1,m,g)+g(m+1)) = sum(1,m+1,f)-sum(1,m+1,g)
        n $in Z
        n >= 1
        sum(1,n,h) = sum(1,n,f)-sum(1,n,g)
        sum(1,n,fn(k Z) R{f(k)-g(k)}) = sum(1,n,h) = sum(1,n,f)-sum(1,n,g)
    claim:
        ? sum(1,n,fn(k Z) R {c*f(k)}) = c*sum(1,n,f)
        let h = fn(k Z) R{c*f(k)}
        by induc m from 1:
            ? sum(1,m,h) = c*sum(1,m,f)
            ? from m = 1:
                h(1) = c*f(1)
                sum(1,1,f) = f(1)
                sum(1,1,h) = h(1) = c*f(1) = c*sum(1,1,f)
            ? induc:
                m >= 1
                h(m+1) = c*f(m+1)
                sum(1,m+1,f) = sum(1,m,f)+f(m+1)
                sum(1,m+1,h) = sum(1,m,h)+h(m+1) = c*sum(1,m,f)+c*f(m+1) = c*(sum(1,m,f)+f(m+1)) = c*sum(1,m+1,f)
        n $in Z
        n >= 1
        sum(1,n,h) = c*sum(1,n,f)
        sum(1,n,fn(k Z) R{c*f(k)}) = sum(1,n,h) = c*sum(1,n,f)

# P108: symbolic adjacent partition and pointwise congruence
sketch:
    have n N+
    have f fn(k Z) R
    sum(1,n+1,f) = sum(1,n,f)+sum(n+1,n+1,f)
    let doubled = fn(k Z) Z{k+k}
    let scaled = fn(j Z) Z{2*j}
    by fn_extension:
        ? doubled = scaled
        forall t Z:
            doubled(t) = t+t = 2*t = scaled(t)
    sum(1,n,doubled) = sum(1,n,scaled)

# P109: integer shift with legal source and target ranges
sketch:
    have f fn(k Z) R
    forall a,b,t Z:
        a <= b
        a+t <= b+t
        =>:
            sum(a,b,fn(k Z) R {f(k+t)}) = sum(a+t,b+t,f)

# P110: known numeric endpoint
sketch:
    have end Z = 3
    sum(1,end,fn(k Z) Z {k}) = 6
