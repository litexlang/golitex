# AST: Obj::ArithmeticOperator::Neg
# Run: target/release/litex -f examples/test_objs/neg.lit
# Cases are checked directly in file context.

# P01: -0 = 0
-0 = 0

# P02: -(-3) = 3
-(-3) = 3

# P03: -(1 + 2) = -3
-(1 + 2) = -3

# P04: -(1 / 2) = -1 / 2
-(1 / 2) = -1 / 2

# P05: -(-x) = x
forall x C:
    -(-x) = x

# P06: -(x + y) = -x - y
forall x, y R:
    -(x + y) = -x - y
