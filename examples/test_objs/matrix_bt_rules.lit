# Explicit matrix theorem contracts, including all finite dimension premises.
# These rules were formerly unavailable; wrong arities and false candidates reject.
# Run: target/release/litex -strict -lang en -f examples/test_objs/matrix_bt_rules.lit

have fn A(r closed_range(1,2),c closed_range(1,2)) R=r+c
have fn B(r closed_range(1,2),c closed_range(1,2)) R=r-c
det(A,2)=-1
det(A,2)!=0

release thm matrix_add_commutative(A,B,2,2)
release thm matrix_add_associative(A,B,A,2,2)
release thm matrix_add_zero(A,2,2)
release thm matrix_sub_self(A,2,2)
release thm matrix_scale_one(A,2,2)
release thm matrix_scale_zero(A,2,2)
release thm matrix_scale_distributive(i,A,B,2,2)
release thm matrix_mul_associative(A,B,A,2,2,2,2)
release thm matrix_mul_distributive_left(A,B,A,2,2,2)
release thm matrix_mul_distributive_right(A,B,A,2,2,2)
release thm matrix_mul_identity(A,2,2)
release thm matrix_mul_zero(A,2,2,3)
release thm matrix_apply_compose(A,B,(1,2),2,2,2)
release thm matrix_transpose_mul(A,B,2,2,2)
release thm matrix_adjoint_mul(A,B,2,2,2)
release thm matrix_trace_linearity(A,B,i,2)
release thm matrix_trace_cyclic(A,B,2,2)
release thm matrix_power_zero(A,2)
release thm matrix_power_successor(A,2,2)
release thm matrix_power_add(A,2,2,3)
release thm matrix_det_identity(3)
release thm matrix_det_transpose(A,2)
release thm matrix_det_adjoint(A,2)
release thm matrix_det_mul(A,B,2)
release thm matrix_det_laplace_row(A,2,1)
release thm matrix_det_laplace_column(A,2,2)
release thm matrix_det_upper_triangular(zero_matrix(2,2),2)
release thm matrix_det_lower_triangular(zero_matrix(2,2),2)
release thm matrix_adjugate_identity(A,2)
release thm matrix_mul_identity(identity_matrix(2),2,2)
release thm matrix_invertible_from_candidate(identity_matrix(2),identity_matrix(2),2)
release thm matrix_inverse_from_candidate(identity_matrix(2),identity_matrix(2),2)
release thm matrix_inverse_laws(A,2)
release thm matrix_rank_bounds(A,2,2)
release thm matrix_rank_zero(2,3)
release thm matrix_rank_identity(3)
release thm matrix_rank_from_factorization(identity_matrix(2),identity_matrix(2),identity_matrix(2),identity_matrix(2),identity_matrix(2),2,2,2)
release thm matrix_rank_transpose(A,2,2)
release thm matrix_rank_adjoint(A,2,2)
release thm matrix_rank_product(A,B,2,2,2)
release thm matrix_rank_invertible(A,2)
release thm inner_product_conjugate_symmetry((1,i),(i,2),2)
release thm inner_product_linear_right((1,i),(2,i),(3,4),i,2,2)
release thm inner_product_positive((1,i),2)
release thm inner_product_cauchy_schwarz((1,i),(i,2),2)
release thm euclidean_norm_square((1,i),2)
release thm euclidean_norm_zero((0,0),2)
release thm euclidean_norm_scale(i,(1,2),2)
release thm euclidean_norm_triangle((1,i),(i,2),2)
release thm frobenius_norm_square(A,2,2)
release thm frobenius_norm_zero(zero_matrix(2,2),2,2)
release thm frobenius_norm_scale(i,A,2,2)
release thm frobenius_norm_triangle(A,B,2,2)
release thm matrix_apply_identity((1,2),2)
release thm matrix_inner_product_adjoint(A,(1,2),(i,2),2,2)
release thm matrix_rank_factorization_exists(A,2,2)
