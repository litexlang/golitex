# P01: log(2, 8) = 3
sketch:
    log(2, 8) = 3

# P02: log(10, 100) = 2
sketch:
    log(10, 100) = 2

# P03: log(2, 1) = 0
sketch:
    log(2, 1) = 0

# P04: log(2, 2) = 1
sketch:
    log(2, 2) = 1

# P05: log(1/2,8)=log(1/2,(1/2)^(-3))=-3
sketch:
    0 $in R
    1/2 $in R
    1/2>0
    1/2!=1
    (1/2)^(-3)=8
    log(1/2,8)=log(1/2,(1/2)^(-3))=-3

# P06: log(e,e)=1
sketch:
    0 $in R
    e $in R
    e>1
    e!=1
    e>0
    log(e,e)=1

# P121: closed exact elementary calculation
sketch:
    log(4,2)=1/2

# P122: closed exact elementary calculation
sketch:
    log(8,4)=2/3

