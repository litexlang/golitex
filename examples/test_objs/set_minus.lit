# AST: Obj::SetOperator::SetMinus
# Run: target/release/litex -f examples/test_objs/set_minus.lit
# Cases are checked directly in file context.

# P01: set_minus({1, 2}, {2}) = {1}
by extension:
    ? set_minus({1, 2}, {2}) = {1}
    claim:
        ? forall x set_minus({1, 2}, {2}):
            x $in {1}
        x $in {1, 2}
        not x $in {2}
        x = 1 or x = 2
        by cases:
            ? x $in {1}
            case x = 1:
                x $in {1}
            case x = 2:
                not 2 $in {2}
                impossible not 2 $in {2}
    forall x {1}:
        x $in set_minus({1, 2}, {2})

# P02: set_minus({1}, {}) = {1}
set_minus({1}, {}) = {1}

# P03: set_minus({}, {1}) = {}
set_minus({}, {1}) = {}

# P04: set_minus({1}, {1}) = {}
set_minus({1}, {1}) = {}

# P05: 1 $in set_minus({1, 2}, {2})
1 $in set_minus({1, 2}, {2})

# P06: not 2 $in set_minus({1, 2}, {2})
by contra:
    ? not 2 $in set_minus({1, 2}, {2})
    not 2 $in {2}
    impossible not 2 $in {2}
