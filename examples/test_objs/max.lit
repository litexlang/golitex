sketch:
    max(2, 3) = 3

# P02: max(3, 2) = 3
sketch:
    max(3, 2) = 3

# P03: max(2, 2) = 2
sketch:
    max(2, 2) = 2

# P04: max(-3, -2) = -2
sketch:
    max(-3, -2) = -2

# P06: max(x, y) = max(y, x)
sketch:
    forall x, y R:
        max(x, y) = max(y, x)

