# P90: Nearest valid-domain control
sketch:
    let s = finite_set_product({1}, fn(x {1}) Z {x})

# P101: known enumeration and exact fractions
sketch:
    have S finite_set = {1,2,3}
    have fn square(k Z) Z = k*k
    finite_set_product(S,square) = 36
    finite_set_product({1/2,1/3},fn(k Q) Q {k}) = 1/6

# P102: empty and integer range enumeration
sketch:
    finite_set_product({},fn(k Z) Z {k}) = 1
    finite_set_product(range(1,4),fn(k Z) Z {k}) = 6

# P103: symbolic constant and multiplication
sketch:
    have S finite_set
    have c R*
    have f,g fn(k S) R
    finite_set_product(S,fn(k S) R* {c}) = c^finite_set_size(S)
    finite_set_product(S,fn(k S) R {f(k)*g(k)}) = finite_set_product(S,f)*finite_set_product(S,g)

# P104: symbolic range bridge
sketch:
    have n N+
    have f fn(k Z) R
    finite_set_product(closed_range(1,n),f) = product(1,n,f)

# P105: disjoint union
sketch:
    have A,B finite_set
    have f fn(k union(A,B)) R
    forall:
        intersect(A,B) = {}
        =>:
            finite_set_product(union(A,B),f) = finite_set_product(A,f)*finite_set_product(B,f)
