# Tracer: real absolute-value input bars; existing Abs object and proof routes.
# Before (did not work):
# |-3| = 3
# Former behavior: parse_error: expected object, got `|` at line 1 in <eval>.
# Now: bars lower to exactly the same object as abs(...).
# Boundary: |i|, |{1, 2}|, |1 / 0|, unpaired/empty bars and implicit multiplication
# remain rejected. Adjacent bars nest absolute values; they do not denote a norm.
# Evidence: target/release/litex -lang en -strict -f examples/test_objs/absolute_value_bars.lit
# Regression: tests/unit/parse/absolute_value_bars.rs

|-3| = 3
abs(-3) = 3
|0| = 0
|2.5| = 2.5

|-3| + |2| = 5
2 * |-3| = 6
|1 - 4|^2 = 9
-|-3|^2 = -9
|2|^|-3| = 8
|2|! = 2

||-3|| = 3
|1 + |-3|| = 4
abs(|-3|) = |abs(-3)|

sketch:
    have fn magnitude(x R) R = |x|
    magnitude(-3) = 3

forall x, y R:
    |x| = abs(x)
    |-x| = |x|
    |x| >= 0
    |x + y| <= |x| + |y|

forall x R:
    |x| $in R

eval |-7|
