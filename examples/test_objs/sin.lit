# AST: Obj::TrigOperator::Sin
# Run: target/release/litex -f examples/test_objs/sin.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: sin(0) = 0
sketch:
    sin(0) = 0

# P02: sin(pi) = 0
sketch:
    sin(pi) = 0

# P03: sin(pi / 2) = 1
sketch:
    sin(pi / 2) = 1

# P05: sin(x) $in R
sketch:
    forall x R:
        sin(x) $in R

# P06: recovered unchanged regression
sketch:
    forall x R:
        sin(-x) = -sin(x)

# P04: exact numeric/periodic/modulus repair; original source retained in the dated journal
sketch:
    sin(-pi / 2) = -1

# P91: exact numeric/periodic/modulus boundary
sketch:
    have k Z
    sin(pi / 6 + 2 * k * pi) = 1 / 2

# P92: exact numeric/periodic/modulus boundary
sketch:
    have k, j Z
    sin((k-j)*pi)=0
