# AST: Obj::SetFormer::Range
# Run: target/release/litex -f examples/test_objs/range.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: range(1, 3) = {1, 2}
sketch:
    range(1, 3) = {1, 2}

# P02: range(2, 2) = {}
sketch:
    claim:
        ? forall x range(2, 2):
            x $in {}
        by contra:
            ? x $in {}
            x >= 2
            x >= 1
            impossible x < 2
    claim:
        ? forall x {}:
            x $in range(2, 2)
        by contra:
            ? x $in range(2, 2)
            impossible x $in {}
    by extension range(2, 2) = {}

# P03: range(3, 1) = {}
sketch:
    claim:
        ? forall x range(3, 1):
            x $in {}
        by contra:
            ? x $in {}
            x >= 3
            x >= 1
            impossible x < 1
    claim:
        ? forall x {}:
            x $in range(3, 1)
        by contra:
            ? x $in range(3, 1)
            impossible x $in {}
    by extension range(3, 1) = {}

# P05: 1 $in range(1, 3)
sketch:
    1 $in range(1, 3)

# P07: finite_set_size(range(0, 3)) = 3
sketch:
    finite_set_size(range(0, 3)) = 3

# P04: explicit checked proof; restored from range-P04
sketch:
    claim:
        ? forall x range(-2, 1):
            x $in {-2, -1, 0}
        expand: x $in range(-2, 1)
        by cases:
            ? x $in {-2, -1, 0}
            case x = -2:
                x $in {-2, -1, 0}
            case x = -1:
                x $in {-2, -1, 0}
            case x = 0:
                x $in {-2, -1, 0}
    by enumerate finite_set:
        ? forall x {-2, -1, 0}:
            x $in range(-2, 1)
    by extension range(-2, 1) = {-2, -1, 0}


# P06: explicit checked proof; restored from range-P06
sketch:
    by contra:
        ? not 3 $in range(1, 3)
        3 < 3
        impossible 3 < 3
