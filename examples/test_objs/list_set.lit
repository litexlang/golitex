# AST: Obj::SetFormer::ListSet
# Run: target/release/litex -f examples/test_objs/list_set.lit
# Direct cases share file context; sketches isolate local declarations.

# P01: finite_set_size({}) = 0
finite_set_size({}) = 0

# P02: 1 $in {1, 2}
1 $in {1, 2}

# P03: not 3 $in {1, 2}
not 3 $in {1, 2}

# P04: {1, 2} = {2, 1}
by extension {1, 2} = {2, 1}

# P05: finite_set_size({1, 2}) = 2
finite_set_size({1, 2}) = 2

# P06: {1} $in {{1}, {2}}
by contra:
    ? {1} != {2}
    1 $in {1}
    1 $in {2}
    impossible 1 $in {2}
{1} $in {{1}, {2}}

# P07: (1, 2) $in {(1, 2), (2, 1)}
sketch:
    let left = (1,2)
    let right = (2,1)
    by contra:
        ? (1, 2) != (2, 1)
        1 = left(1) = right(1) = 2
        impossible 1 = 2
    (1, 2) $in {(1, 2), (2, 1)}

# P08: $is_finite_set({})
$is_finite_set({})
