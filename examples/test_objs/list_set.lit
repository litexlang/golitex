# AST: Obj::SetFormer::ListSet
# Run: target/release/litex -f examples/test_objs/list_set.lit
# Cases use discarded sketch scopes; no cross-case facts.

# P01: finite_set_size({}) = 0
sketch:
    finite_set_size({}) = 0

# P02: 1 $in {1, 2}
sketch:
    1 $in {1, 2}

# P03: not 3 $in {1, 2}
sketch:
    not 3 $in {1, 2}

# P04: {1, 2} = {2, 1}
sketch:
    by extension {1, 2} = {2, 1}

# P05: finite_set_size({1, 2}) = 2
sketch:
    finite_set_size({1, 2}) = 2

# P06: {1} $in {{1}, {2}}
sketch:
    by contra:
        ? {1} != {2}
        1 $in {1}
        1 $in {2}
        impossible 1 $in {2}
    {1} $in {{1}, {2}}

# P07: (1, 2) $in {(1, 2), (2, 1)}
sketch:
    let left = (1,2)
    let right = (2,1)
    by contra:
        ? (1, 2) != (2, 1)
        1 = left(1) = right(1) = 2
        impossible 1 = 2
    (1, 2) $in {(1, 2), (2, 1)}

# P08: $is_finite_set({})
sketch:
    $is_finite_set({})
