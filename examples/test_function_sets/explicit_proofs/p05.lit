# P05: Specialized function-space equation before membership and binding
# Explicit proof contract; strict release checked, no trust.

template<A, B nonempty_set>:
    have maps set = fn(x A) B
$is_set(\maps<R, Z>)
\maps<R, Z> = fn(x R) Z
fn(x R) Z {0} $in \maps<R, Z>
have f \maps<R, Z> = fn(x R) Z {0}
f(2) = 0
