# P02: Template tuple equation and typed struct field bridge
# Explicit proof contract; strict release checked, no trust.

struct Box:
    op fn(x R) R
    tag N
have fn step(x R) R = x + 1
template<a R>:
    have box &Box = (step, 0)
\box<2> = (step, 0)
have selected &Box = \box<2>
selected.op = step
selected.op $in fn(x R) R
selected.op(3) = step(3) = 4
