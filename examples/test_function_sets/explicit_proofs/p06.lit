# P06: Returned tuple equation and typed struct field bridge
# Explicit proof contract; strict release checked, no trust.

struct Box:
    op fn(x R) R
    tag N
have fn step(x R) R = x + 1
have fn make(a R) &Box = (step, 0)
make(2) = (step, 0)
have selected &Box = make(2)
selected.op = step
selected.op(3) = step(3) = 4
selected.op(3) $in R
