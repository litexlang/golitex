# N23: False typed struct field call chain
# Explicit proof contract; strict release checked, no trust.

struct Box:
    op fn(x R) R
    tag N
have fn step(x R) R = x + 1
template<a R>:
    have box &Box = (step, 0)
\box<2> = (step, 0)
have selected &Box = \box<2>
selected = (step,0)
selected.op = step
selected.op(3) = step(3) = 5
