# T03: Template selects a function-space carrier
# Supported explicit proof; original direct source in capability_probes/t03.lit.

template<A, B nonempty_set>:
    have maps set = fn(x A) B
$is_set(\maps<R, Z>)
\maps<R, Z> = fn(x R) Z
fn(x R) Z {0} $in \maps<R, Z>
have f \maps<R, Z> = fn(x R) Z {0}
f(2) = 0
