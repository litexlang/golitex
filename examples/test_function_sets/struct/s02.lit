# S02: Concrete function field evaluates after typed construction
# Supported explicit proof; original direct source in capability_probes/s02.lit.

struct Box:
    op fn(x R) R
    tag N
fn(x R) R {x + 1} $in fn(t R) R
have box &Box = (fn(x R) R {x + 1}, 0)
box.op = fn(x R) R {x + 1}
box.op(2) = fn(x R) R {x + 1}(2) = 3
