# S08: A function returns a struct with a callable field
# Direct capability observation; --capabilities does not certify this claim.

struct Box:
    op fn(x R) R
    tag N
claim:
    ? forall a R:
        (fn(x R) R {x + a}, 0) $in &Box
    fn(x R) R {x + a} $in fn(t R) R
have fn make(a R) &Box = (fn(x R) R {x + a}, 0)
make(2).op(3) = 5
