thm binary_gaussian_span_contains_right_generator:
    ? forall ax, ay, bx, b_y Z:
        (bx, b_y) $in binary_gaussian_span(ax, ay, bx, b_y)
    witness exist ux, uy, vx, vy Z st {bx = ax * ux - ay * uy + bx * vx - b_y * vy, b_y = ax * uy + ay * ux + bx * vy + b_y * vx} from 0, 0, 1, 0:
        bx = ax * 0 - ay * 0 + bx * 1 - b_y * 0
        b_y = ax * 0 + ay * 0 + bx * 0 + b_y * 1
    by def $is_binary_gaussian_linear_combination(ax, ay, bx, b_y, bx, b_y)
    (bx, b_y) $in binary_gaussian_span(ax, ay, bx, b_y)
