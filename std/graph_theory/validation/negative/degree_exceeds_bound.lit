have bound_vertices finite_set={1,2,3}

1 $in bound_vertices

release thm graph::complete_graph_construction(bound_vertices)

have bound_graph &graph::FiniteSimpleGraph<bound_vertices> = (bound_vertices,\graph::complete_graph_arcs<bound_vertices>)

release thm graph::graph_degree_upper_bound(bound_vertices,bound_graph,1)

\graph::graph_degree<bound_vertices,bound_graph>(1)=3
