    release thm count::finite_map_preimage_is_finite(G.arcs,V,\graph_arc_source<V,G>,S)

thm graph_arc_source_fiber_degree:
    ? forall V finite_set,G &FiniteSimpleGraph<V>,v V:
        finite_set_size(preimage_set(\graph_arc_source<V,G>,{v}))=\graph_degree<V,G>(v)
    release thm graph_neighbors_are_finite(V,G,v)
    \graph_neighbors<V,G>(v)={w V:(v,w) $in G.arcs}
    have neighbors finite_set=\graph_neighbors<V,G>(v)
    neighbors={w V:(v,w) $in G.arcs}
    have fiber finite_set=preimage_set(\graph_arc_source<V,G>,{v})
    claim:
        ? forall w neighbors:
            (v,w) $in fiber
        w $in {t V:(v,t) $in G.arcs}
        w $in V
        (v,w) $in G.arcs
        \graph_arc_source<V,G>((v,w))=fn(pair cart(V,V)) V {pair(1)}((v,w))=v
        \graph_arc_source<V,G>((v,w)) $in {v}
        (v,w) $in preimage_set(\graph_arc_source<V,G>,{v})
        (v,w) $in fiber
    have fn pack(w neighbors) fiber=(v,w)
    claim:
        ? forall x,y neighbors:
            pack(x)=pack(y)
            =>:
                x=y
        pack(x)=(v,x)
        pack(y)=(v,y)
        (v,x)=pack(x)=pack(y)=(v,y)
        x=(v,x)(2)=(v,y)(2)=y
    by def $injective(neighbors,fiber,pack)
    claim:
        ? forall arc fiber:
            exist w neighbors st {arc=pack(w)}
        arc $in preimage_set(\graph_arc_source<V,G>,{v})
        arc $in G.arcs
        arc $in cart(V,V)
        have pair cart(V,V)=arc
        pair $in G.arcs
        \graph_arc_source<V,G>(arc) $in {v}
        \graph_arc_source<V,G>(arc)=v
        \graph_arc_source<V,G>(arc)=fn(t cart(V,V)) V {t(1)}(arc)=fn(t cart(V,V)) V {t(1)}(pair)=pair(1)
        pair(1)=v
        pair=(pair(1),pair(2))=(v,pair(2))
        (v,pair(2)) $in G.arcs
        pair(2) $in {w V:(v,w) $in G.arcs}
        pair(2) $in neighbors
        pack(pair(2))=(v,pair(2))=pair=arc
        witness exist w neighbors st {arc=pack(w)} from pair(2)
    by def $surjective(neighbors,fiber,pack)
    release thm count::injection_size_le(neighbors,fiber,pack)
    release thm count::surjection_size_ge(neighbors,fiber,pack)
    finite_set_size(fiber)=finite_set_size(neighbors)
    finite_set_size(preimage_set(\graph_arc_source<V,G>,{v}))=finite_set_size(fiber)=finite_set_size(neighbors)=finite_set_size(\graph_neighbors<V,G>(v))=\graph_degree<V,G>(v)

thm graph_degree_sum_equals_arc_count:
    ? forall V finite_set,G &FiniteSimpleGraph<V>:
        finite_set_sum(V,fn(v V) N {\graph_degree<V,G>(v)})=finite_set_size(G.arcs)
    release thm count::finite_fiber_sum(G.arcs,V,\graph_arc_source<V,G>)
    claim:
        ? forall v V:
            \graph_degree<V,G>(v)=finite_set_size(preimage_set(\graph_arc_source<V,G>,{v}))
        release thm graph_arc_source_fiber_degree(V,G,v)
        \graph_degree<V,G>(v)=finite_set_size(preimage_set(\graph_arc_source<V,G>,{v}))
    release thm finite_set_sum_substitution(finite_set_sum(V,fn(v V) N {\graph_degree<V,G>(v)}),finite_set_sum(V,fn(v V) N {finite_set_size(preimage_set(\graph_arc_source<V,G>,{v}))}))
    finite_set_sum(V,fn(v V) N {\graph_degree<V,G>(v)})=finite_set_sum(V,fn(v V) N {finite_set_size(preimage_set(\graph_arc_source<V,G>,{v}))})=finite_set_size(G.arcs)

claim:
    ? forall V finite_set,pair cart(V,V):
        union({pair(1)},{pair(2)}) $in power_set(V)
    pair(1) $in V
    pair(2) $in V
    {pair(1)} $subset V
    {pair(2)} $subset V
    union({pair(1)},{pair(2)}) $subset V
    union({pair(1)},{pair(2)}) $in power_set(V)

template<V finite_set,G &FiniteSimpleGraph<V>>:
    have fn graph_arc_to_vertex_set(arc G.arcs) power_set(V)=fn(pair cart(V,V)) power_set(V) {union({pair(1)},{pair(2)})}(arc)

template<V finite_set,G &FiniteSimpleGraph<V>>:
    have graph_edges power_set(power_set(V))=fn_range(\graph_arc_to_vertex_set<V,G>)

thm graph_edges_are_finite:
    ? forall V finite_set,G &FiniteSimpleGraph<V>:
        $is_finite_set(\graph_edges<V,G>)
    \graph_edges<V,G> = fn_range(\graph_arc_to_vertex_set<V,G>)
    $is_finite_set(power_set(V))
    fn_range(\graph_arc_to_vertex_set<V,G>) $subset power_set(V)
    $is_finite_set(fn_range(\graph_arc_to_vertex_set<V,G>))
    $is_finite_set(\graph_edges<V,G>)

claim:
    ? forall V finite_set,G &FiniteSimpleGraph<V>:
        $is_finite_set(\graph_edges<V,G>)
    release thm graph_edges_are_finite(V,G)

claim:
