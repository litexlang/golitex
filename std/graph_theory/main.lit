    G.arcs $subset cart(V,V)
    arc $in cart(V,V)

template<V finite_set,G &FiniteSimpleGraph<V>>:
    have fn graph_arc_source(arc G.arcs) V=fn(pair cart(V,V)) V {pair(1)}(arc)

claim:
