# Small shared source-level mathematical interfaces.
#
# Finite-subset closure and finite-set indexing are reserved bare kernel
# theorems; clients do not import or qualify them through this module.
#
# Finite-set extrema are kernel builtins.  This module deliberately does not
# wrap or restate their membership, order, or literal-computation rules.

# ---------------------------------------------------------------------------
# Named real constants
# ---------------------------------------------------------------------------
# Native e and pi are positive real constants supplied by the kernel.

# ---------------------------------------------------------------------------
# Rational normalization
# ---------------------------------------------------------------------------
# A reduced fraction has no positive common divisor other than 1.
prop is_reduced_fraction(a Z, b N+):
    forall k N+:
        a % k = 0
        b % k = 0
        =>:
            k = 1

# ---------------------------------------------------------------------------
# gcd related
# ---------------------------------------------------------------------------

# Shared standard-library candidates for The Mechanics of Litex Proof.
#
# Public API:
#   prime_by_trial_division, divides
#   gcd_positive, gcd_divides_left, gcd_divides_right
#   common_divisor_le_gcd
#   gcd_euclidean_base, gcd_euclidean_step, bezout_identity
#   rational_has_reduced_fraction
#   gcd_of_prime_is_one_or_prime
#
# These are general number-theory interfaces that can later move together into
# std/basics. Textbook-specific consequences stay in Chapter 7.

prop prime_by_trial_division(p N+):
    2 <= p
    forall d range(2, p):
        p % d != 0

thm prime_implies_prime_by_trial_division:
    ? forall p N+:
        $prime(p)
        =>:
            $prime_by_trial_division(p)
    by def $prime_by_trial_division(p)
    by def $prime(p)

thm prime_by_trial_division_implies_prime:
    ? forall p N+:
        $prime_by_trial_division(p)
        =>:
            $prime(p)
    by def $prime_by_trial_division(p)
    by def $prime(p)

# The Euclidean quotient is an ordinary source-defined selection. The kernel
# verifies only the narrow unique-existence fact used by this declaration.
have fn integer_quotient by exist!:
    ? forall a Z, d N+:
        exist! q Z st {a = d * q + a % d}

prop divides(a Z, b Z):
    exist k Z st {b = a * k}

# Named source interfaces for the native exp, ln, sign, lcm, and factorial
# objects. Their primitive mathematical steps are checked kernel rules; these
# declarations make the connections discoverable and reusable through
# `std/basics`.
thm exp_injective:
    ? forall a, b R:
        exp(a) = exp(b)
        =>:
            a = b

thm exp_reflects_strict_order:
    ? forall a, b R:
        exp(a) < exp(b)
        =>:
            a < b

thm exp_reflects_weak_order:
    ? forall a, b R:
        exp(a) <= exp(b)
        =>:
            a <= b

thm ln_injective:
    ? forall a, b R+:
        ln(a) = ln(b)
        =>:
            a = b

thm ln_reflects_strict_order:
    ? forall a, b R+:
        ln(a) < ln(b)
        =>:
            a < b

thm ln_reflects_weak_order:
    ? forall a, b R+:
        ln(a) <= ln(b)
        =>:
            a <= b

thm sign_zero_implies_zero:
    ? forall x R:
        sign(x) = 0
        =>:
            x = 0

thm sign_nonzero_iff_argument_nonzero_forward:
    ? forall x R:
        x != 0
        =>:
            sign(x) != 0

thm sign_nonzero_iff_argument_nonzero_reverse:
    ? forall x R:
        sign(x) != 0
        =>:
            x != 0

thm lcm_is_multiple_of_left:
    ? forall a, b N+:
        $divides(a, lcm(a, b))
    abs(a) = a
    lcm(a, b) % abs(a) = 0
    lcm(a, b) % a = 0
    witness exist k Z st {lcm(a, b) = a * k} from integer_quotient(lcm(a, b), a):
        lcm(a, b) = a * integer_quotient(lcm(a, b), a) + lcm(a, b) % a = a * integer_quotient(lcm(a, b), a)

thm lcm_is_multiple_of_right:
    ? forall a, b N+:
        $divides(b, lcm(a, b))
    abs(b) = b
    lcm(a, b) % abs(b) = 0
    lcm(a, b) % b = 0
    witness exist k Z st {lcm(a, b) = b * k} from integer_quotient(lcm(a, b), b):
        lcm(a, b) = b * integer_quotient(lcm(a, b), b) + lcm(a, b) % b = b * integer_quotient(lcm(a, b), b)

thm lcm_le_common_positive_multiple:
    ? forall a, b, m N+:
        $divides(a, m)
        $divides(b, m)
        =>:
            lcm(a, b) <= m
    obtain ka from exist k Z st {m = a * k}
    obtain kb from exist k Z st {m = b * k}
    abs(a) = a
    abs(b) = b
    m % abs(a) = m % a = (a * ka) % a = 0
    m % abs(b) = m % b = (b * kb) % b = 0

thm earlier_factorial_divides_later:
    ? forall m, n N:
        m <= n
        =>:
            $divides(factorial(m), factorial(n))
    factorial(m) $in N+
    factorial(n) % factorial(m) = 0
    witness exist k Z st {factorial(n) = factorial(m) * k} from integer_quotient(factorial(n), factorial(m)):
        factorial(n) = factorial(m) * integer_quotient(factorial(n), factorial(m)) + factorial(n) % factorial(m) = factorial(m) * integer_quotient(factorial(n), factorial(m))

# A positive divisor of a nonzero integer is at most its absolute value.
# This is proof machinery for the Euclidean and prime-related theorems below.
thm _positive_divisor_le_abs:
    ? forall d N+, a Z:
        $divides(d, a)
        a != 0
        =>:
            d <= abs(a)
    obtain k from exist k Z st {a = d * k}
    by contra:
        ? k != 0
        k = 0
        a = d * k = d * 0 = 0
        impossible a != 0
    abs(k) > 0
    abs(k) $in N+
    d * 1 <= d * abs(k)
    abs(d) = d
    abs(a) = abs(d * k) = abs(d) * abs(k) = d * abs(k)
    d = d * 1 <= d * abs(k) = abs(a)

thm gcd_comm:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd(a, b) = gcd(b, a)
    claim:
        ? b != 0 or a != 0
        by cases:
            ? b != 0 or a != 0
            case a != 0:
                b != 0 or a != 0
            case b != 0:
                b != 0 or a != 0
    gcd(a, b) $in N+
    a % gcd(a, b) = 0
    b % gcd(a, b) = 0
    gcd(a, b) <= gcd(b, a)
    gcd(b, a) $in N+
    b % gcd(b, a) = 0
    a % gcd(b, a) = 0
    gcd(b, a) <= gcd(a, b)

thm gcd_positive:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd(a, b) $in N+

thm gcd_divides_left:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), a)
    gcd(a, b) $in N+
    a % gcd(a, b) = 0
    witness exist k Z st {a = gcd(a, b) * k} from integer_quotient(a, gcd(a, b)):
        a = gcd(a, b) * integer_quotient(a, gcd(a, b)) + a % gcd(a, b) = gcd(a, b) * integer_quotient(a, gcd(a, b))

thm gcd_divides_right:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), b)
    gcd(a, b) $in N+
    b % gcd(a, b) = 0
    witness exist k Z st {b = gcd(a, b) * k} from integer_quotient(b, gcd(a, b)):
        b = gcd(a, b) * integer_quotient(b, gcd(a, b)) + b % gcd(a, b) = gcd(a, b) * integer_quotient(b, gcd(a, b))

thm common_divisor_le_gcd:
    ? forall a, b Z, d N+:
        a != 0 or b != 0
        $divides(d, a)
        $divides(d, b)
        =>:
            d <= gcd(a, b)
    obtain ka from exist k Z st {a = d * k}
    obtain kb from exist k Z st {b = d * k}
    a % d = (d * ka) % d = 0
    b % d = (d * kb) % d = 0

thm gcd_euclidean_base:
    ? forall a Z:
        a != 0
        =>:
            gcd(a, 0) = abs(a)
    by thm gcd_positive(a, 0)
    by thm gcd_divides_left(a, 0)
    by thm _positive_divisor_le_abs(gcd(a, 0), a)
    gcd(a, 0) <= abs(a)
    abs(a) > 0
    abs(a) $in N+
    by cases:
        ? $divides(abs(a), a)
        case a >= 0:
            abs(a) = a
            a = a * 1
            abs(a) * 1 = a * 1
            a = abs(a) * 1
            witness exist k Z st {a = abs(a) * k} from 1
        case a < 0:
            abs(a) = -a
            a = abs(a) * (-1)
            witness exist k Z st {a = abs(a) * k} from -1
    witness exist k Z st {0 = abs(a) * k} from 0:
        0 = abs(a) * 0
    $divides(abs(a), 0)
    by thm common_divisor_le_gcd(a, 0, abs(a))
    abs(a) <= gcd(a, 0)

thm gcd_euclidean_step:
    ? forall a, b Z:
        b != 0
        =>:
            gcd(a, b) = gcd(b, a % abs(b))

    claim:
        ? forall d N+, z Z:
            $divides(d, z)
            =>:
                $divides(d, abs(z))
        obtain k from exist k Z st {z = d * k}
        by cases:
            ? $divides(d, abs(z))
            case z >= 0:
                abs(z) = z = d * k
                witness exist t Z st {abs(z) = d * t} from k
            case z < 0:
                abs(z) = -z = -(d * k) = d * (-k)
                witness exist t Z st {abs(z) = d * t} from -k

    by thm gcd_positive(b, a % abs(b))
    by thm gcd_divides_left(b, a % abs(b))
    by thm gcd_divides_right(b, a % abs(b))
    $divides(gcd(b, a % abs(b)), abs(b))
    obtain x from exist k Z st {abs(b) = gcd(b, a % abs(b)) * k}
    obtain y from exist k Z st {a % abs(b) = gcd(b, a % abs(b)) * k}
    witness exist q Z st {a = abs(b) * q + a % abs(b)} from integer_quotient(a, abs(b)):
        a = abs(b) * integer_quotient(a, abs(b)) + a % abs(b)
    obtain q from exist q Z st {a = abs(b) * q + a % abs(b)}
    witness exist t Z st {a = gcd(b, a % abs(b)) * t} from x * q + y:
        a = abs(b) * q + a % abs(b) = (gcd(b, a % abs(b)) * x) * q + gcd(b, a % abs(b)) * y = gcd(b, a % abs(b)) * (x * q + y)
    $divides(gcd(b, a % abs(b)), a)
    by thm common_divisor_le_gcd(a, b, gcd(b, a % abs(b)))
    gcd(b, a % abs(b)) <= gcd(a, b)

    by thm gcd_positive(a, b)
    by thm gcd_divides_left(a, b)
    by thm gcd_divides_right(a, b)
    $divides(gcd(a, b), abs(b))
    obtain u from exist k Z st {a = gcd(a, b) * k}
    obtain v from exist k Z st {abs(b) = gcd(a, b) * k}
    witness exist r Z st {a = abs(b) * r + a % abs(b)} from integer_quotient(a, abs(b)):
        a = abs(b) * integer_quotient(a, abs(b)) + a % abs(b)
    obtain r from exist r Z st {a = abs(b) * r + a % abs(b)}
    witness exist t Z st {a % abs(b) = gcd(a, b) * t} from u - v * r:
        a % abs(b) = a - abs(b) * r = gcd(a, b) * u - (gcd(a, b) * v) * r = gcd(a, b) * (u - v * r)
    $divides(gcd(a, b), a % abs(b))
    by thm common_divisor_le_gcd(b, a % abs(b), gcd(a, b))
    gcd(a, b) <= gcd(b, a % abs(b))

# The Euclidean remainder has strictly smaller absolute value than a nonzero divisor.
# This must be available before the recursive Bezout coefficient definition.
thm _euclidean_remainder_abs_lt_abs:
    ? forall u, v Z:
        v != 0
        =>:
            abs(u % abs(v)) < abs(v)
    abs(v) > 0
    abs(v) $in N+
    u % abs(v) >= 0
    abs(u % abs(v)) = u % abs(v)
    u % abs(v) < abs(v)

thm bezout_identity:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            exist x Z, y Z st {gcd(a, b) = x * a + y * b}

    have fn euclid_bezout_pair(u, v Z) cart(Z, Z) by induc abs(v) from 0:
        case v = 0:
            case u >= 0: (1, 0)
            case u < 0: (-1, 0)
        case v != 0:
            case v >= 0: (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])
            case v < 0: (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])

    have fn euclid_bezout_l(u, v Z) Z = euclid_bezout_pair(u, v)[1]
    have fn euclid_bezout_r(u, v Z) Z = euclid_bezout_pair(u, v)[2]

    prop euclid_bezout_identity_at_measure(m Z):
        forall u, v Z:
            u != 0 or v != 0
            abs(v) = m
            =>:
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)

    claim:
        ? forall u, v Z:
            u != 0 or v != 0
            abs(v) = 0
            =>:
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
        v = 0
        by cases:
            ? u != 0
            case u != 0:
                do_nothing
            case v != 0:
                impossible v = 0
        by thm gcd_euclidean_base(u)
        by cases:
            ? euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
            case u >= 0:
                euclid_bezout_pair(u, v) = (1, 0)
                euclid_bezout_l(u, v) = 1
                euclid_bezout_r(u, v) = 0
                abs(u) = u
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = 1 * u + 0 * v = u = abs(u) = gcd(u, v)
            case u < 0:
                euclid_bezout_pair(u, v) = (-1, 0)
                euclid_bezout_l(u, v) = -1
                euclid_bezout_r(u, v) = 0
                abs(u) = -u
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = -1 * u + 0 * v = -u = abs(u) = gcd(u, v)
    $euclid_bezout_identity_at_measure(0)

    claim:
        ? forall m Z:
            m >= 0
            forall y Z:
                y >= 0
                y <= m
                =>:
                    $euclid_bezout_identity_at_measure(y)
            =>:
                $euclid_bezout_identity_at_measure(m + 1)
        claim:
            ? forall u, v Z:
                u != 0 or v != 0
                abs(v) = m + 1
                =>:
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
            m + 1 > 0
            by contra:
                ? v != 0
                v = 0
                abs(v) = 0 = m + 1
                impossible m + 1 > 0
            have r Z = u % abs(v)
            abs(v) > 0
            abs(v) $in N+
            r = u % abs(v)
            u % abs(v) >= 0
            r = u % abs(v) >= 0
            abs(r) >= 0
            abs(r) = r
            r $in Z
            abs(r) $in Z
            u % abs(v) < abs(v)
            r = u % abs(v) < abs(v)
            abs(r) < abs(v)
            abs(v) = m + 1
            abs(r) < m + 1
            abs(r) + 1 <= m + 1
            abs(r) <= m or abs(r) >= m + 1
            by cases:
                ? abs(r) <= m
                case abs(r) <= m:
                    abs(r) <= m
                case abs(r) >= m + 1:
                    impossible abs(r) < m + 1
            v != 0 or r != 0
            abs(r) = abs(r)
            $euclid_bezout_identity_at_measure(abs(r))
            by thm gcd_euclidean_step(u, v)
            by cases:
                ? euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
                case v >= 0:
                    abs(v) = v
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r)
                    euclid_bezout_l(v, r) = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_r(v, r) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_l(v, r)
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_r(v, r)
                    gcd(v, r) = gcd(v, u % abs(v))
                    euclid_bezout_pair(u, v) = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])
                    euclid_bezout_l(u, v) = euclid_bezout_pair(u, v)[1] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[1] = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_pair(u, v)[2] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[2] = euclid_bezout_pair(v, u % abs(v))[1] - integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[1]
                    euclid_bezout_pair(v, u % abs(v))[1] = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_r(v, u % abs(v))
                    integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[1] - integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_l(v, u % abs(v)) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_l(v, u % abs(v)) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)
                    u = abs(v) * integer_quotient(u, abs(v)) + u % abs(v)
                    u - v * integer_quotient(u, abs(v)) = u - abs(v) * integer_quotient(u, abs(v)) = u % abs(v)
                    u - v * integer_quotient(u, abs(v)) = r
                    gcd(u, v) = gcd(v, u % abs(v)) = gcd(v, r)
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)) * v
                    euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) - integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u - v * integer_quotient(u, abs(v)))
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u - v * integer_quotient(u, abs(v))) = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r) = gcd(u, v)
                case v < 0:
                    abs(v) = -v
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r)
                    euclid_bezout_l(v, r) = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_r(v, r) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_l(v, r)
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_r(v, r)
                    gcd(v, r) = gcd(v, u % abs(v))
                    euclid_bezout_pair(u, v) = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])
                    euclid_bezout_l(u, v) = euclid_bezout_pair(u, v)[1] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[1] = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_pair(u, v)[2] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[2] = euclid_bezout_pair(v, u % abs(v))[1] + integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[1]
                    euclid_bezout_pair(v, u % abs(v))[1] = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_r(v, u % abs(v))
                    integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[1] + integer_quotient(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_l(v, u % abs(v)) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_l(v, u % abs(v)) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)
                    u = abs(v) * integer_quotient(u, abs(v)) + u % abs(v)
                    u + v * integer_quotient(u, abs(v)) = u - abs(v) * integer_quotient(u, abs(v)) = u % abs(v)
                    u + v * integer_quotient(u, abs(v)) = r
                    gcd(u, v) = gcd(v, u % abs(v)) = gcd(v, r)
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)) * v
                    euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) + integer_quotient(u, abs(v)) * euclid_bezout_r(v, r)) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u + v * integer_quotient(u, abs(v)))
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u + v * integer_quotient(u, abs(v))) = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r) = gcd(u, v)

    by strong_induc m from 0:
        ? $euclid_bezout_identity_at_measure(m)
        ? from m = 0:
            $euclid_bezout_identity_at_measure(0)
        ? strong_induc:
            $euclid_bezout_identity_at_measure(m + 1)

    abs(b) >= 0
    $euclid_bezout_identity_at_measure(abs(b))
    euclid_bezout_l(a, b) * a + euclid_bezout_r(a, b) * b = gcd(a, b)
    witness exist x Z, y Z st {gcd(a, b) = x * a + y * b} from euclid_bezout_l(a, b), euclid_bezout_r(a, b):
        gcd(a, b) = euclid_bezout_l(a, b) * a + euclid_bezout_r(a, b) * b

# Weil, Exercise II.8: every rational number has a reduced fraction.
# A negative rational needs an integer numerator, so the denominator is chosen
# positive and the reducedness condition is `gcd(p, d) = 1`.
thm rational_has_reduced_fraction:
    ? forall q Q:
        exist p Z, d N+ st {q = p / d, gcd(p, d) = 1}
    obtain a, b from exist a Z, b Z* st {q = a / b}
    have g N+ = gcd(a, b)
    g = gcd(a, b)
    by thm gcd_divides_left(a, b)
    $divides(g, a)
    obtain p from exist p Z st {a = g * p}
    by thm gcd_divides_right(a, b)
    $divides(g, b)
    obtain d from exist d Z st {b = g * d}
    by thm bezout_identity(a, b)
    obtain x, y from exist x Z, y Z st {gcd(a, b) = x * a + y * b}
    gcd(a, b) = g
    g = x * a + y * b
    by contra:
        ? d != 0
        d = 0
        b = g * d = g * 0 = 0
        impossible b != 0
    d >= 0 or d < 0
    by cases:
        ? d > 0 or d < 0
        case d >= 0:
            d = 0 or d > 0
            by cases:
                ? d > 0 or d < 0
                case d = 0:
                    impossible d != 0
                case d > 0:
                    d > 0 or d < 0
        case d < 0:
            d > 0 or d < 0
    by cases:
        ? exist p0 Z, d0 N+ st {q = p0 / d0, gcd(p0, d0) = 1}
        case d > 0:
            d $in N+
            claim:
                ? gcd(p, d) = 1
                have h N+ = gcd(p, d)
                h = gcd(p, d)
                by thm gcd_divides_left(p, d)
                $divides(h, p)
                obtain r from exist r Z st {p = h * r}
                by thm gcd_divides_right(p, d)
                $divides(h, d)
                obtain s from exist s Z st {d = h * s}
                g = x * a + y * b = x * (g * p) + y * (g * d) = g * (x * p + y * d)
                g / g = (g * (x * p + y * d)) / g = x * p + y * d
                g / g = 1
                1 = x * p + y * d = x * (h * r) + y * (h * s) = h * (x * r + y * s)
                have t Z = x * r + y * s
                1 = h * t
                t > 0 or t <= 0
                by cases:
                    ? h = 1
                    case t > 0:
                        t >= 1
                        h * 1 <= h * t
                        h = h * 1 <= h * t
                        h * t = 1
                        h <= 1
                        h >= 1
                        h = 1
                    case t <= 0:
                        h >= 0
                        h * t <= 0
                        1 = h * t <= 0
                        impossible 1 <= 0
                h = gcd(p, d)
                gcd(p, d) = 1
            witness exist p0 Z, d0 N+ st {q = p0 / d0, gcd(p0, d0) = 1} from p, d:
                q = a / b = (g * p) / (g * d) = p / d
                gcd(p, d) = 1
        case d < 0:
            have p0 Z = -p
            have d0 Z = -d
            p0 = -p
            d0 = -d
            -p0 = -(-p) = p
            -d0 = -(-d) = d
            p = -p0
            d = -d0
            -d > 0
            d0 = -d > 0
            d0 $in N+
            claim:
                ? gcd(p0, d0) = 1
                have h N+ = gcd(p0, d0)
                h = gcd(p0, d0)
                by thm gcd_divides_left(p0, d0)
                $divides(h, p0)
                obtain r from exist r Z st {p0 = h * r}
                by thm gcd_divides_right(p0, d0)
                $divides(h, d0)
                obtain s from exist s Z st {d0 = h * s}
                x * (g * p) = x * (g * (-p0))
                x * (g * (-p0)) = (-x) * (g * p0)
                x * (g * p) = (-x) * (g * p0)
                y * (g * d) = y * (g * (-d0))
                y * (g * (-d0)) = (-y) * (g * d0)
                y * (g * d) = (-y) * (g * d0)
                x * (g * p) + y * (g * d) = (-x) * (g * p0) + (-y) * (g * d0)
                g = x * a + y * b = x * (g * p) + y * (g * d)
                x * (g * p) + y * (g * d) = (-x) * (g * p0) + (-y) * (g * d0) = g * ((-x) * p0 + (-y) * d0)
                g = g * ((-x) * p0 + (-y) * d0)
                g / g = (g * ((-x) * p0 + (-y) * d0)) / g = (-x) * p0 + (-y) * d0
                g / g = 1
                1 = (-x) * p0 + (-y) * d0 = (-x) * (h * r) + (-y) * (h * s) = h * ((-x) * r + (-y) * s)
                have t Z = (-x) * r + (-y) * s
                1 = h * t
                t > 0 or t <= 0
                by cases:
                    ? h = 1
                    case t > 0:
                        t >= 1
                        h * 1 <= h * t
                        h = h * 1 <= h * t
                        h * t = 1
                        h <= 1
                        h >= 1
                        h = 1
                    case t <= 0:
                        h >= 0
                        h * t <= 0
                        1 = h * t <= 0
                        impossible 1 <= 0
                h = gcd(p0, d0)
                gcd(p0, d0) = 1
            witness exist p1 Z, d1 N+ st {q = p1 / d1, gcd(p1, d1) = 1} from p0, d0:
                q = a / b = (g * p) / (g * d) = p / d
                p / d = (-p) / (-d)
                (-p) / (-d) = p0 / d0
                q = p0 / d0
                gcd(p0, d0) = 1

thm gcd_of_prime_is_one_or_prime:
    ? forall a Z, p N+:
        $prime(p)
        =>:
            gcd(a, p) = 1 or gcd(a, p) = p
    by thm gcd_positive(a, p)
    by thm gcd_divides_right(a, p)
    obtain k from exist k Z st {p = gcd(a, p) * k}
    p = gcd(a, p) * k + 0
    p % gcd(a, p) = 0
    by thm _positive_divisor_le_abs(gcd(a, p), p)
    abs(p) = p
    gcd(a, p) <= p
    gcd(a, p) = p or gcd(a, p) < p
    by cases:
        ? gcd(a, p) = 1 or gcd(a, p) = p
        case gcd(a, p) = p:
            gcd(a, p) = 1 or gcd(a, p) = p
        case gcd(a, p) < p:
            gcd(a, p) = 1 or gcd(a, p) > 1
            by cases:
                ? gcd(a, p) = 1 or gcd(a, p) = p
                case gcd(a, p) = 1:
                    gcd(a, p) = 1 or gcd(a, p) = p
                case gcd(a, p) > 1:
                    gcd(a, p) >= 2
                    gcd(a, p) $in range(2, p)
                    $prime(p)
                    p % gcd(a, p) != 0
                    impossible p % gcd(a, p) = 0
