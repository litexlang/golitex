# Imported positive square-root Newton iteration, error bounds and limits.

release obj def num::newton_sqrt_step

release obj def num::newton_sqrt_iterate

num::newton_sqrt_step(2,1)=3/2

num::newton_sqrt_iterate(2,1,0)=1

1-1=0

num::newton_sqrt_iterate(2,1,1)=num::newton_sqrt_step(2,num::newton_sqrt_iterate(2,1,1-1))=num::newton_sqrt_step(2,num::newton_sqrt_iterate(2,1,0))=num::newton_sqrt_step(2,1)=3/2

num::newton_sqrt_iterate(2,1,2)=num::newton_sqrt_step(2,num::newton_sqrt_iterate(2,1,2-1))=num::newton_sqrt_step(2,num::newton_sqrt_iterate(2,1,1))=num::newton_sqrt_step(2,3/2)=(3/2+2/(3/2))/2=17/12

num::newton_sqrt_step(4,1)=5/2

num::newton_sqrt_step(4,2)=2

num::newton_sqrt_iterate(4,2,0)=2

num::newton_sqrt_iterate(4,2,1)=num::newton_sqrt_step(4,num::newton_sqrt_iterate(4,2,1-1))=num::newton_sqrt_step(4,num::newton_sqrt_iterate(4,2,0))=num::newton_sqrt_step(4,2)=2

num::newton_sqrt_iterate(4,2,2)=num::newton_sqrt_step(4,num::newton_sqrt_iterate(4,2,2-1))=num::newton_sqrt_step(4,num::newton_sqrt_iterate(4,2,1))=num::newton_sqrt_step(4,2)=2

release thm num::newton_sqrt_residual_identity(2,1)

release thm num::newton_sqrt_root_error_identity(2,1)

release thm num::newton_sqrt_step_is_above_root(2,1)

release thm num::newton_sqrt_step_decreases_above_root(4,3)

release thm num::newton_sqrt_error_halves(4,3)

release thm num::newton_sqrt_error_is_quadratic(4,3)

release thm num::newton_sqrt_iterates_are_above_root(2,1,2)

release thm num::newton_sqrt_iterates_decrease(4,1,1)

release thm num::newton_sqrt_iterate_error_bound(2,1,2)

release thm num::newton_sqrt_iterate_error_bound(4,2,1)

release thm fn_set_member(\num::newton_sqrt_sequence<2,1>,fn(k N+) R)

\num::newton_sqrt_sequence<2,1>(1)=num::newton_sqrt_iterate(2,1,1)=3/2

release thm num::newton_sqrt_sequence_converges(2,1)

release thm num::newton_sqrt_sequence_converges(4,2)

release thm num::newton_sqrt_sequence_converges(9,1/2)

lim(\num::newton_sqrt_sequence<2,1>)=sqrt(2)

thm generic_newton_convergence:
    ? forall a,start R+:
        $has_seq_limit(\num::newton_sqrt_sequence<a,start>,sqrt(a))
    release thm num::newton_sqrt_sequence_converges(a,start)

thm generic_newton_error_bound:
    ? forall a,start R+,n N:
        n>=1
        =>:
            num::newton_sqrt_iterate(a,start,n)-sqrt(a)<=(num::newton_sqrt_iterate(a,start,1)-sqrt(a))/2^(n-1)
    release thm num::newton_sqrt_iterate_error_bound(a,start,n)

thm generic_quadratic_bound:
    ? forall a,x R+:
        sqrt(a)<=x
        =>:
            num::newton_sqrt_step(a,x)-sqrt(a)<=(x-sqrt(a))^2/(2*sqrt(a))
    release thm num::newton_sqrt_error_is_quadratic(a,x)

release thm num::newton_sqrt_fixes_root(2)

sqrt(9)=3

lim(\num::newton_sqrt_sequence<9,1/2>)=sqrt(9)=3
