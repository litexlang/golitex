# Finite maps and counting using native cardinality and mapping predicates.

thm injection_size_le:
    ? forall X, Y finite_set, f fn(x X) Y:
        $injective(X, Y, f)
        =>:
            finite_set_size(X) <= finite_set_size(Y)
    $is_finite_set(fn_range(f))
    fn_range(f) $subset Y
    finite_set_size(fn_range(f)) = finite_set_size(X)
    finite_set_size(fn_range(f)) <= finite_set_size(Y)

thm surjection_size_ge:
    ? forall X, Y finite_set, f fn(x X) Y:
        $surjective(X, Y, f)
        =>:
            finite_set_size(Y) <= finite_set_size(X)

thm pigeonhole_collision:
    ? forall X, Y finite_set, f fn(x X) Y:
        finite_set_size(Y) < finite_set_size(X)
        =>:
            exist x, y X st {x != y, f(x) = f(y)}
    by contra:
        ? exist x, y X st {x != y, f(x) = f(y)}
        claim:
            ? forall x, y X:
                f(x) = f(y)
                =>:
                    x = y
            by contra:
                ? x = y
                witness exist left, right X st {left != right, f(left) = f(right)} from x, y
                impossible exist left, right X st {left != right, f(left) = f(right)}
        by def $injective(X, Y, f)
        release thm injection_size_le(X, Y, f)
        impossible finite_set_size(Y) < finite_set_size(X)

thm cardinality_gap_omits_value:
    ? forall X, Y finite_set, f fn(x X) Y:
        finite_set_size(X) < finite_set_size(Y)
        =>:
            exist y Y st {not y $in fn_range(f)}
    by contra:
        ? exist y Y st {not y $in fn_range(f)}
        claim:
            ? forall y Y:
                y $in fn_range(f)
            by contra:
                ? y $in fn_range(f)
                witness exist omitted Y st {not omitted $in fn_range(f)} from y
                impossible exist omitted Y st {not omitted $in fn_range(f)}
        claim:
            ? forall y Y:
                exist x X st {y = f(x)}
            have by fn_preimage: preimage_point from y $in fn_range(f)
            witness exist x X st {y = f(x)} from preimage_point
        by def $surjective(X, Y, f)
        release thm surjection_size_ge(X, Y, f)
        impossible finite_set_size(X) < finite_set_size(Y)

thm equal_size_injection_is_bijective:
    ? forall X, Y finite_set, f fn(x X) Y:
        $injective(X, Y, f)
        finite_set_size(X) = finite_set_size(Y)
        =>:
            $bijective(X, Y, f)
    $is_finite_set(fn_range(f))
    fn_range(f) $subset Y
    finite_set_size(fn_range(f)) = finite_set_size(X) = finite_set_size(Y)
    fn_range(f) = Y
    claim:
        ? forall y Y:
            exist x X st {y = f(x)}
        y $in fn_range(f)
        have by fn_preimage: preimage_point from y $in fn_range(f)
        witness exist x X st {y = f(x)} from preimage_point
    by def $surjective(X, Y, f)
    by def $bijective(X, Y, f)

thm remove_one_size:
    ? forall X finite_set, point X:
        finite_set_size(set_minus(X, {point})) = finite_set_size(X) - 1
    {point} $subset X
    intersect(X, {point}) = {point}
    finite_set_size(set_minus(X, {point})) = finite_set_size(X) - finite_set_size(intersect(X, {point})) = finite_set_size(X) - finite_set_size({point}) = finite_set_size(X) - 1

thm surjection_collision_strict_size:
    ? forall X, Y finite_set, f fn(x X) Y, point, duplicate X:
        $surjective(X, Y, f)
        point != duplicate
        f(point) = f(duplicate)
        =>:
            finite_set_size(Y) < finite_set_size(X)
    have remaining finite_set = set_minus(X, {point})
    remaining $subset X
    have fn reduced_map(x remaining) Y = f(x)
    claim:
        ? forall y Y:
            exist x remaining st {y = reduced_map(x)}
        obtain original from exist x X st {y = f(x)}
        by cases:
            ? exist x remaining st {y = reduced_map(x)}
            case original = point:
                duplicate != point
                duplicate $in remaining
                reduced_map(duplicate) = f(duplicate) = f(point) = f(original) = y
                witness exist x remaining st {y = reduced_map(x)} from duplicate
            case original != point:
                original $in remaining
                reduced_map(original) = f(original) = y
                witness exist x remaining st {y = reduced_map(x)} from original
    by def $surjective(remaining, Y, reduced_map)
    release thm surjection_size_ge(remaining, Y, reduced_map)
    release thm remove_one_size(X, point)
    finite_set_size(remaining) = finite_set_size(X) - 1
    finite_set_size(Y) <= finite_set_size(X) - 1
    finite_set_size(X) - 1 < finite_set_size(X)
    finite_set_size(Y) <= finite_set_size(X) - 1 < finite_set_size(X)

thm equal_size_surjection_is_bijective:
    ? forall X, Y finite_set, f fn(x X) Y:
        $surjective(X, Y, f)
        finite_set_size(X) = finite_set_size(Y)
        =>:
            $bijective(X, Y, f)
    claim:
        ? forall point, duplicate X:
            f(point) = f(duplicate)
            =>:
                point = duplicate
        by contra:
            ? point = duplicate
            release thm surjection_collision_strict_size(X, Y, f, point, duplicate)
            impossible finite_set_size(X) = finite_set_size(Y)
    by def $injective(X, Y, f)
    by def $bijective(X, Y, f)

thm mutual_finite_injections_are_bijective:
    ? forall X, Y finite_set, f fn(x X) Y, g fn(y Y) X:
        $injective(X, Y, f)
        $injective(Y, X, g)
        =>:
            finite_set_size(X) = finite_set_size(Y)
            $bijective(X, Y, f)
            $bijective(Y, X, g)
    release thm injection_size_le(X, Y, f)
    release thm injection_size_le(Y, X, g)
    finite_set_size(X) = finite_set_size(Y)
    release thm equal_size_injection_is_bijective(X, Y, f)
    release thm equal_size_injection_is_bijective(Y, X, g)

thm disjoint_partition_size:
    ? forall X, A, B finite_set:
        union(A, B) = X
        intersect(A, B) = {}
        =>:
            finite_set_size(X) = finite_set_size(A) + finite_set_size(B)
    finite_set_size(intersect(A, B)) = finite_set_size({}) = 0
    finite_set_size(X) = finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B)) = finite_set_size(A) + finite_set_size(B)


thm union_size:
    ? forall A, B finite_set:
        finite_set_size(union(A,B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A,B))

thm subset_difference_size:
    ? forall A, B finite_set:
        B $subset A
        =>:
            finite_set_size(set_minus(A,B)) = finite_set_size(A) - finite_set_size(B)
    by extension intersect(A,B) = B
    finite_set_size(set_minus(A,B)) = finite_set_size(A) - finite_set_size(intersect(A,B)) = finite_set_size(A) - finite_set_size(B)

thm union_bound:
    ? forall A, B finite_set:
        finite_set_size(union(A,B)) <= finite_set_size(A) + finite_set_size(B)

thm subset_equal_cardinality:
    ? forall A, B finite_set:
        B $subset A
        finite_set_size(B) = finite_set_size(A)
        =>:
            B = A

thm cartesian_product_size:
    ? forall A, B finite_set:
        finite_set_size(cart(A,B)) = finite_set_size(A) * finite_set_size(B)

thm power_set_size:
    ? forall A finite_set:
        finite_set_size(power_set(A)) = 2^finite_set_size(A)

thm union_additivity_implies_disjoint:
    ? forall A, B finite_set:
        finite_set_size(union(A,B)) = finite_set_size(A) + finite_set_size(B)
        =>:
            intersect(A,B) = {}
    finite_set_size(union(A,B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A,B))
    finite_set_size(intersect(A,B)) = (finite_set_size(A) + finite_set_size(B)) - (finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A,B))) = (finite_set_size(A) + finite_set_size(B)) - finite_set_size(union(A,B)) = 0

forall A, B finite_set:
    $is_finite_set(set_minus(A,B))
    $is_finite_set(set_minus(B,A))
    $is_finite_set(union(set_minus(A,B),set_minus(B,A)))

forall A, B, D finite_set:
    $is_finite_set(union(A,B))
    $is_finite_set(union(union(A,B),D))
    $is_finite_set(intersect(A,B))
    $is_finite_set(intersect(intersect(A,B),D))

thm three_set_union_bound:
    ? forall A, B, D finite_set:
        finite_set_size(union(union(A,B),D)) <= finite_set_size(A) + finite_set_size(B) + finite_set_size(D)
    release thm union_bound(A,B)
    release thm union_bound(union(A,B),D)
    finite_set_size(union(A,B)) + finite_set_size(D) <= finite_set_size(A) + finite_set_size(B) + finite_set_size(D)

thm symmetric_difference_size:
    ? forall A, B finite_set:
        finite_set_size(union(set_minus(A,B),set_minus(B,A))) = finite_set_size(A) + finite_set_size(B) - 2*finite_set_size(intersect(A,B))
    by extension:
        ? intersect(set_minus(A,B),set_minus(B,A)) = {}
        claim:
            ? forall x intersect(set_minus(A,B),set_minus(B,A)):
                x $in {}
            by contra:
                ? x $in {}
                x $in set_minus(A,B)
                x $in set_minus(B,A)
                impossible x $in B
    intersect(B,A) = intersect(A,B)
    finite_set_size(intersect(B,A)) = finite_set_size(intersect(A,B))
    finite_set_size(set_minus(A,B)) = finite_set_size(A) - finite_set_size(intersect(A,B))
    finite_set_size(set_minus(B,A)) = finite_set_size(B) - finite_set_size(intersect(B,A)) = finite_set_size(B) - finite_set_size(intersect(A,B))
    finite_set_size(intersect(set_minus(A,B),set_minus(B,A))) = finite_set_size({}) = 0
    finite_set_size(union(set_minus(A,B),set_minus(B,A))) = finite_set_size(set_minus(A,B)) + finite_set_size(set_minus(B,A)) - finite_set_size(intersect(set_minus(A,B),set_minus(B,A))) = (finite_set_size(A) - finite_set_size(intersect(A,B))) + (finite_set_size(B) - finite_set_size(intersect(A,B))) - 0 = finite_set_size(A) + finite_set_size(B) - 2*finite_set_size(intersect(A,B))

thm three_set_inclusion_exclusion:
    ? forall A, B, D finite_set:
        finite_set_size(union(union(A,B),D)) = finite_set_size(A) + finite_set_size(B) + finite_set_size(D) - finite_set_size(intersect(A,B)) - finite_set_size(intersect(A,D)) - finite_set_size(intersect(B,D)) + finite_set_size(intersect(intersect(A,B),D))
    by extension:
        ? intersect(union(A,B),D) = union(intersect(A,D),intersect(B,D))
        claim:
            ? forall x intersect(union(A,B),D):
                x $in union(intersect(A,D),intersect(B,D))
            x $in union(A,B)
            x $in D
            x $in A or x $in B
            by cases:
                ? x $in union(intersect(A,D),intersect(B,D))
                case x $in A:
                    x $in intersect(A,D)
                case x $in B:
                    x $in intersect(B,D)
        claim:
            ? forall x union(intersect(A,D),intersect(B,D)):
                x $in intersect(union(A,B),D)
            x $in intersect(A,D) or x $in intersect(B,D)
            by cases:
                ? x $in intersect(union(A,B),D)
                case x $in intersect(A,D):
                    x $in A
                    x $in D
                    x $in union(A,B)
                case x $in intersect(B,D):
                    x $in B
                    x $in D
                    x $in union(A,B)
    by extension:
        ? intersect(intersect(A,D),intersect(B,D)) = intersect(intersect(A,B),D)
        claim:
            ? forall x intersect(intersect(A,D),intersect(B,D)):
                x $in intersect(intersect(A,B),D)
            x $in intersect(A,D)
            x $in intersect(B,D)
            x $in A
            x $in B
            x $in D
            x $in intersect(A,B)
        claim:
            ? forall x intersect(intersect(A,B),D):
                x $in intersect(intersect(A,D),intersect(B,D))
            x $in intersect(A,B)
            x $in D
            x $in A
            x $in B
            x $in intersect(A,D)
            x $in intersect(B,D)
    $is_finite_set(union(A,B))
    $is_finite_set(intersect(union(A,B),D))
    $is_finite_set(intersect(A,D))
    $is_finite_set(intersect(B,D))
    $is_finite_set(union(intersect(A,D),intersect(B,D)))
    $is_finite_set(intersect(intersect(A,D),intersect(B,D)))
    finite_set_size(intersect(intersect(A,D),intersect(B,D))) = finite_set_size(intersect(intersect(A,B),D))
    finite_set_size(union(A,B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A,B))
    finite_set_size(intersect(union(A,B),D)) = finite_set_size(union(intersect(A,D),intersect(B,D)))
    finite_set_size(union(intersect(A,D),intersect(B,D))) = finite_set_size(intersect(A,D)) + finite_set_size(intersect(B,D)) - finite_set_size(intersect(intersect(A,D),intersect(B,D))) = finite_set_size(intersect(A,D)) + finite_set_size(intersect(B,D)) - finite_set_size(intersect(intersect(A,B),D))
    finite_set_size(intersect(union(A,B),D)) = finite_set_size(intersect(A,D)) + finite_set_size(intersect(B,D)) - finite_set_size(intersect(intersect(A,B),D))
    finite_set_size(union(union(A,B),D)) = finite_set_size(union(A,B)) + finite_set_size(D) - finite_set_size(intersect(union(A,B),D)) = (finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A,B))) + finite_set_size(D) - (finite_set_size(intersect(A,D)) + finite_set_size(intersect(B,D)) - finite_set_size(intersect(intersect(A,B),D))) = finite_set_size(A) + finite_set_size(B) + finite_set_size(D) - finite_set_size(intersect(A,B)) - finite_set_size(intersect(A,D)) - finite_set_size(intersect(B,D)) + finite_set_size(intersect(intersect(A,B),D))


thm symmetric_difference_is_finite:
    ? forall X, Y finite_set:
        $is_finite_set(union(set_minus(X,Y),set_minus(Y,X)))
    $is_finite_set(set_minus(X,Y))
    $is_finite_set(set_minus(Y,X))

thm three_set_union_intersection_are_finite:
    ? forall X, Y, Zeta finite_set:
        $is_finite_set(union(union(X,Y),Zeta))
        $is_finite_set(intersect(intersect(X,Y),Zeta))
    $is_finite_set(union(X,Y))
    $is_finite_set(intersect(X,Y))


have fn binomial_coefficient(n,k N) N by induc n from 0:
    case k = 0: 1
    case k >= 1:
        case n = 0: 0
        case n >= 1: binomial_coefficient(n-1,k-1) + binomial_coefficient(n-1,k)

thm binomial_beyond_row_zero:
    ? forall n, k N:
        k > n
        =>:
            binomial_coefficient(n,k) = 0
    prop row_zero(row N):
        forall col N:
            col > row
            =>:
                binomial_coefficient(row,col) = 0
    by induc row from 0:
        ? $row_zero(row)
        ? from row = 0:
            claim:
                ? forall col N:
                    col > 0
                    =>:
                        binomial_coefficient(0,col) = 0
                col >= 1
            by def $row_zero(0)
        ? induc:
            row $in N
            row+1 >= 1
            claim:
                ? forall col N:
                    col > row+1
                    =>:
                        binomial_coefficient(row+1,col) = 0
                col >= 1
                col-1 > (row+1)-1 = row
                col-1 $in N
                binomial_coefficient(row,col-1) = 0
                col > row+1 > row
                binomial_coefficient(row,col) = 0
                binomial_coefficient(row+1,col) = binomial_coefficient(row,col-1) + binomial_coefficient(row,col) = 0+0 = 0
            by def $row_zero(row+1)
    $row_zero(n)

thm binomial_diagonal:
    ? forall n N:
        binomial_coefficient(n,n) = 1
    by induc n from 0:
        ? binomial_coefficient(n,n) = 1
        ? from n = 0:
            binomial_coefficient(0,0) = 1
        ? induc:
            n $in N
            n+1 >= 1
            (n+1)-1 = n
            release thm binomial_beyond_row_zero(n,n+1)
            binomial_coefficient(n+1,n+1) = binomial_coefficient(n,n) + binomial_coefficient(n,n+1) = 1+0 = 1

thm binomial_choose_one:
    ? forall n N:
        binomial_coefficient(n,1) = n
    by induc n from 0:
        ? binomial_coefficient(n,1) = n
        ? from n = 0:
            binomial_coefficient(0,1) = 0
        ? induc:
            n $in N
            n+1 >= 1
            (n+1)-1 = n
            binomial_coefficient(n,0) = 1
            binomial_coefficient(n+1,1) = binomial_coefficient(n,0) + binomial_coefficient(n,1) = 1+n = n+1

thm binomial_choose_two:
    ? forall n N:
        binomial_coefficient(n,2) = n*(n-1)/2
    by induc n from 0:
        ? binomial_coefficient(n,2) = n*(n-1)/2
        ? from n = 0:
            binomial_coefficient(0,2) = 0 = 0*(0-1)/2
        ? induc:
            n $in N
            n+1 >= 1
            (n+1)-1 = n
            release thm binomial_choose_one(n)
            binomial_coefficient(n+1,2) = binomial_coefficient(n,1) + binomial_coefficient(n,2) = n + n*(n-1)/2 = (n+1)*((n+1)-1)/2

thm binomial_symmetry:
    ? forall n, k N:
        k <= n
        =>:
            binomial_coefficient(n,k) = binomial_coefficient(n,n-k)
    prop symmetric_row(row N):
        forall col N:
            col <= row
            =>:
                binomial_coefficient(row,col) = binomial_coefficient(row,row-col)
    by induc row from 0:
        ? $symmetric_row(row)
        ? from row = 0:
            claim:
                ? forall col N:
                    col <= 0
                    =>:
                        binomial_coefficient(0,col) = binomial_coefficient(0,0-col)
                col = 0
                0-col = 0
            by def $symmetric_row(0)
        ? induc:
            row $in N
            row+1 >= 1
            (row+1)-1 = row
            claim:
                ? forall col N:
                    col <= row+1
                    =>:
                        binomial_coefficient(row+1,col) = binomial_coefficient(row+1,row+1-col)
                by cases:
                    ? binomial_coefficient(row+1,col) = binomial_coefficient(row+1,row+1-col)
                    case col = 0:
                        row+1-col = row+1
                        release thm binomial_diagonal(row+1)
                        binomial_coefficient(row+1,col) = 1 = binomial_coefficient(row+1,row+1) = binomial_coefficient(row+1,row+1-col)
                    case col >= 1:
                        by cases:
                            ? binomial_coefficient(row+1,col) = binomial_coefficient(row+1,row+1-col)
                            case col = row+1:
                                release thm binomial_diagonal(row+1)
                                row+1-col = 0
                                binomial_coefficient(row+1,col) = 1 = binomial_coefficient(row+1,0) = binomial_coefficient(row+1,row+1-col)
                            case col < row+1:
                                col <= row
                                col-1 $in N
                                col-1 <= row
                                row+1-col > 0
                                row+1-col >= 1
                                row-(col-1) = row+1-col
                                (row+1-col)-1 = row-col
                                binomial_coefficient(row,col-1) = binomial_coefficient(row,row-(col-1)) = binomial_coefficient(row,row+1-col)
                                binomial_coefficient(row,col) = binomial_coefficient(row,row-col) = binomial_coefficient(row,(row+1-col)-1)
                                binomial_coefficient(row+1,col) = binomial_coefficient(row,col-1) + binomial_coefficient(row,col) = binomial_coefficient(row,row+1-col) + binomial_coefficient(row,(row+1-col)-1) = binomial_coefficient(row,(row+1-col)-1) + binomial_coefficient(row,row+1-col) = binomial_coefficient(row+1,row+1-col)
            by def $symmetric_row(row+1)
    $symmetric_row(n)

thm binomial_penultimate:
    ? forall n N+:
        binomial_coefficient(n,n-1) = n
    release thm binomial_symmetry(n,n-1)
    release thm binomial_choose_one(n)
    n-(n-1) = 1
    binomial_coefficient(n,n-1) = binomial_coefficient(n,n-(n-1)) = binomial_coefficient(n,1) = n

thm binomial_positive:
    ? forall n, k N:
        k <= n
        =>:
            binomial_coefficient(n,k) > 0
    prop positive_row(row N):
        forall col N:
            col <= row
            =>:
                binomial_coefficient(row,col) > 0
    by induc row from 0:
        ? $positive_row(row)
        ? from row = 0:
            claim:
                ? forall col N:
                    col <= 0
                    =>:
                        binomial_coefficient(0,col) > 0
                col = 0
                binomial_coefficient(0,col) = 1 > 0
            by def $positive_row(0)
        ? induc:
            row $in N
            row+1 >= 1
            (row+1)-1 = row
            claim:
                ? forall col N:
                    col <= row+1
                    =>:
                        binomial_coefficient(row+1,col) > 0
                by cases:
                    ? binomial_coefficient(row+1,col) > 0
                    case col = 0:
                        binomial_coefficient(row+1,col) = 1 > 0
                    case col >= 1:
                        col-1 $in N
                        col-1 <= (row+1)-1 = row
                        binomial_coefficient(row,col-1) > 0
                        binomial_coefficient(row,col) $in N
                        binomial_coefficient(row,col) >= 0
                        binomial_coefficient(row+1,col) = binomial_coefficient(row,col-1) + binomial_coefficient(row,col)
                        binomial_coefficient(row,col-1) + binomial_coefficient(row,col) > 0
            by def $positive_row(row+1)
    $positive_row(n)

thm binomial_row_monotone:
    ? forall n, k N:
        binomial_coefficient(n,k) <= binomial_coefficient(n+1,k)
    n+1 >= 1
    (n+1)-1 = n
    by cases:
        ? binomial_coefficient(n,k) <= binomial_coefficient(n+1,k)
        case k = 0:
            binomial_coefficient(n,k) = binomial_coefficient(n,0) = 1 = binomial_coefficient(n+1,0) = binomial_coefficient(n+1,k)
        case k >= 1:
            k-1 $in N
            binomial_coefficient(n,k-1) $in N
            binomial_coefficient(n+1,k) = binomial_coefficient(n,k-1) + binomial_coefficient(n,k)
            binomial_coefficient(n,k) <= binomial_coefficient(n,k-1) + binomial_coefficient(n,k)

thm binomial_row_strict:
    ? forall n, k N:
        k > 0
        k <= n+1
        =>:
            binomial_coefficient(n,k) < binomial_coefficient(n+1,k)
    k >= 1
    n+1 >= 1
    (n+1)-1 = n
    k-1 $in N
    release thm binomial_positive(n,k-1)
    binomial_coefficient(n+1,k) = binomial_coefficient(n,k-1) + binomial_coefficient(n,k)
    binomial_coefficient(n,k) < binomial_coefficient(n,k-1) + binomial_coefficient(n,k)


claim:
    ? forall k Z:
        0<=k
        =>:
            k $in N
    k>=0
    k $in N

claim:
    ? forall k Z:
        1<=k
        =>:
            k $in N+
            k-1 $in N
    k>=1
    k>0
    k $in N+
    k-1 $in Z
    k-1>=0
    k-1 $in N

claim:
    ? forall n,k N:
        k<=n
        =>:
            n-k $in N
    n-k $in Z
    n-k>=0
    n-k $in N

thm natural_sum_reindex_by_successor:
    ? forall n N,a fn(k N) C,shifted fn(k N+) C:
        forall k N:
            shifted(k+1)=a(k)
        =>:
            sum(1,n+1,shifted)=sum(0,n,a)
    by induc m from 0:
        ? sum(1,m+1,shifted)=sum(0,m,a)
        ? from m=0:
            0+1=1
            shifted(0+1)=a(0)
            shifted(1)=shifted(0+1)=a(0)
            sum(1,0+1,shifted)=sum(1,1,shifted)=shifted(1)=a(0)=sum(0,0,a)
        ? induc:
            0<=m
            m+1>=1
            1<=m+1
            have next N+=m+1
            next+1=(m+1)+1
            (next+1)-1=next
            shifted(next+1)=a(next)=a(m+1)
            sum(1,(m+1)+1,shifted)=sum(1,m+1,shifted)+sum((m+1)+1,(m+1)+1,shifted)
            have endpoint N+=(m+1)+1
            sum(endpoint,endpoint,shifted)=shifted(endpoint)
            sum((m+1)+1,(m+1)+1,shifted)=sum(endpoint,endpoint,shifted)=shifted(endpoint)=shifted((m+1)+1)
            sum(1,(m+1)+1,shifted)=sum(1,m+1,shifted)+shifted((m+1)+1)
            shifted((m+1)+1)=shifted(next+1)=a(m+1)
            sum(0,m+1,a)=sum(0,m,a)+sum(m+1,m+1,a)
            sum(next,next,a)=a(next)
            sum(m+1,m+1,a)=sum(next,next,a)=a(next)=a(m+1)
            sum(0,m+1,a)=sum(0,m,a)+a(m+1)
            sum(1,(m+1)+1,shifted)=sum(1,m+1,shifted)+a(m+1)=sum(0,m,a)+a(m+1)=sum(0,m+1,a)
    sum(1,n+1,shifted)=sum(0,n,a)

thm binomial_factorial_product:
    ? forall n,k N:
        k<=n
        =>:
            binomial_coefficient(n,k)*factorial(k)*factorial(n-k)=factorial(n)
    prop factorial_row(row N):
        forall col N:
            col<=row
            =>:
                binomial_coefficient(row,col)*factorial(col)*factorial(row-col)=factorial(row)
    by induc row from 0:
        ? $factorial_row(row)
        ? from row=0:
            claim:
                ? forall col N:
                    col<=0
                    =>:
                        binomial_coefficient(0,col)*factorial(col)*factorial(0-col)=factorial(0)
                col=0
                0-col=0
                binomial_coefficient(0,col)=binomial_coefficient(0,0)=1
                factorial(col)=factorial(0)=1
                factorial(0-col)=factorial(0)=1
                binomial_coefficient(0,col)*factorial(col)*factorial(0-col)=1*1*1=1=factorial(0)
            by def $factorial_row(0)
        ? induc:
            row+1>=1
            (row+1)-1=row
            factorial(row+1)=(row+1)*factorial(row)
            claim:
                ? forall col N:
                    col<=row+1
                    =>:
                        binomial_coefficient(row+1,col)*factorial(col)*factorial(row+1-col)=factorial(row+1)
                by cases:
                    ? binomial_coefficient(row+1,col)*factorial(col)*factorial(row+1-col)=factorial(row+1)
                    case col=0:
                        binomial_coefficient(row+1,col)=1
                        factorial(col)=1
                        row+1-col=row+1
                        binomial_coefficient(row+1,col)*factorial(col)*factorial(row+1-col)=1*1*factorial(row+1)=factorial(row+1)
                    case col>=1:
                        by cases:
                            ? binomial_coefficient(row+1,col)*factorial(col)*factorial(row+1-col)=factorial(row+1)
                            case col=row+1:
                                release thm binomial_diagonal(row+1)
                                binomial_coefficient(row+1,col)=binomial_coefficient(row+1,row+1)=1
                                row+1-col=0
                                factorial(row+1-col)=factorial(0)=1
                                binomial_coefficient(row+1,col)*factorial(col)*factorial(row+1-col)=1*factorial(row+1)*1=factorial(row+1)
                            case col<row+1:
                                col<=row
                                col-1 $in N
                                col-1<=row
                                row-col $in N
                                row+1-col $in N
                                row-(col-1)=row+1-col
                                (row-col)+1=row+1-col
                                (col-1)+1=col
                                factorial(col)=factorial((col-1)+1)=((col-1)+1)*factorial(col-1)=col*factorial(col-1)
                                factorial(row+1-col)=factorial((row-col)+1)=((row-col)+1)*factorial(row-col)=(row+1-col)*factorial(row-col)
                                binomial_coefficient(row,col-1)*factorial(col-1)*factorial(row-(col-1))=factorial(row)
                                binomial_coefficient(row,col)*factorial(col)*factorial(row-col)=factorial(row)
                                binomial_coefficient(row+1,col)=binomial_coefficient(row,col-1)+binomial_coefficient(row,col)
                                factorial(row+1-col)=factorial(row-(col-1))
                                binomial_coefficient(row,col-1)*factorial(col)*factorial(row+1-col)=binomial_coefficient(row,col-1)*factorial(col)*factorial(row-(col-1))=binomial_coefficient(row,col-1)*(col*factorial(col-1))*factorial(row-(col-1))=col*(binomial_coefficient(row,col-1)*factorial(col-1)*factorial(row-(col-1)))=col*factorial(row)
                                binomial_coefficient(row,col)*factorial(col)*factorial(row+1-col)=binomial_coefficient(row,col)*factorial(col)*((row+1-col)*factorial(row-col))=(row+1-col)*(binomial_coefficient(row,col)*factorial(col)*factorial(row-col))=(row+1-col)*factorial(row)
                                binomial_coefficient(row+1,col)*factorial(col)*factorial(row+1-col)=(binomial_coefficient(row,col-1)+binomial_coefficient(row,col))*factorial(col)*factorial(row+1-col)=binomial_coefficient(row,col-1)*factorial(col)*factorial(row+1-col)+binomial_coefficient(row,col)*factorial(col)*factorial(row+1-col)=col*factorial(row)+(row+1-col)*factorial(row)=(row+1)*factorial(row)=factorial(row+1)
            by def $factorial_row(row+1)
    $factorial_row(n)

thm binomial_factorial_formula:
    ? forall n,k N:
        k<=n
        =>:
            binomial_coefficient(n,k)=factorial(n)/(factorial(k)*factorial(n-k))
    release thm binomial_factorial_product(n,k)
    0<factorial(k)
    0<factorial(n-k)
    0<factorial(k)*factorial(n-k)
    binomial_coefficient(n,k)=(binomial_coefficient(n,k)*factorial(k)*factorial(n-k))/(factorial(k)*factorial(n-k))=factorial(n)/(factorial(k)*factorial(n-k))

template<n N,x,y C>:
    have fn binomial_terms(k N) C by cases:
        case k<=n:binomial_coefficient(n,k)*x^k*y^(n-k)
        case k>n:0

thm binomial_terms_zero:
    ? forall n N,x,y C:
        \binomial_terms<n,x,y>(0)=y^n
    0<=n
    binomial_coefficient(n,0)=1
    x^0=1
    n-0=n
    y^(n-0)=y^n
    \binomial_terms<n,x,y>(0)=binomial_coefficient(n,0)*x^0*y^(n-0)=1*1*y^n=y^n

thm binomial_terms_diagonal:
    ? forall n N,x,y C:
        \binomial_terms<n,x,y>(n)=x^n
    release thm binomial_diagonal(n)
    n-n=0
    y^(n-n)=y^0=1
    \binomial_terms<n,x,y>(n)=binomial_coefficient(n,n)*x^n*y^(n-n)=1*x^n*1=x^n

thm binomial_terms_successor:
    ? forall n N,k N+,x,y C:
        \binomial_terms<n+1,x,y>(k)=x*\binomial_terms<n,x,y>(k-1)+y*\binomial_terms<n,x,y>(k)
    k-1 $in N
    n+1>=1
    (n+1)-1=n
    by cases:
        ? \binomial_terms<n+1,x,y>(k)=x*\binomial_terms<n,x,y>(k-1)+y*\binomial_terms<n,x,y>(k)
        case k>n+1:
            k>n
            k-1>n
            \binomial_terms<n+1,x,y>(k)=0
            \binomial_terms<n,x,y>(k-1)=0
            \binomial_terms<n,x,y>(k)=0
            x*\binomial_terms<n,x,y>(k-1)+y*\binomial_terms<n,x,y>(k)=x*0+y*0=0
        case k<=n+1:
            by cases:
                ? \binomial_terms<n+1,x,y>(k)=x*\binomial_terms<n,x,y>(k-1)+y*\binomial_terms<n,x,y>(k)
                case k=n+1:
                    k-1=n
                    release thm binomial_terms_diagonal(n+1,x,y)
                    release thm binomial_terms_diagonal(n,x,y)
                    k>n
                    \binomial_terms<n,x,y>(k)=0
                    \binomial_terms<n,x,y>(k-1)=\binomial_terms<n,x,y>(n)=x^n
                    x^(n+1)=x^n*x
                    x*\binomial_terms<n,x,y>(k-1)+y*\binomial_terms<n,x,y>(k)=x*x^n+y*0=x^n*x=x^(n+1)=\binomial_terms<n+1,x,y>(n+1)=\binomial_terms<n+1,x,y>(k)
                case k<n+1:
                    k<=n
                    k-1<=n
                    n-k $in N
                    n-(k-1)=n+1-k
                    (n-k)+1=n+1-k
                    (k-1)+1=k
                    x^k=x^((k-1)+1)=x^(k-1)*x
                    y^(n+1-k)=y^((n-k)+1)=y^(n-k)*y
                    \binomial_terms<n,x,y>(k-1)=binomial_coefficient(n,k-1)*x^(k-1)*y^(n-(k-1))
                    \binomial_terms<n,x,y>(k)=binomial_coefficient(n,k)*x^k*y^(n-k)
                    y^(n-(k-1))=y^(n+1-k)
                    x*\binomial_terms<n,x,y>(k-1)=x*(binomial_coefficient(n,k-1)*x^(k-1)*y^(n-(k-1)))=binomial_coefficient(n,k-1)*(x^(k-1)*x)*y^(n-(k-1))=binomial_coefficient(n,k-1)*x^k*y^(n-(k-1))=binomial_coefficient(n,k-1)*x^k*y^(n+1-k)
                    y*\binomial_terms<n,x,y>(k)=y*(binomial_coefficient(n,k)*x^k*y^(n-k))=binomial_coefficient(n,k)*x^k*(y^(n-k)*y)=binomial_coefficient(n,k)*x^k*y^(n+1-k)
                    binomial_coefficient(n+1,k)=binomial_coefficient(n,k-1)+binomial_coefficient(n,k)
                    \binomial_terms<n+1,x,y>(k)=binomial_coefficient(n+1,k)*x^k*y^((n+1)-k)=(binomial_coefficient(n,k-1)+binomial_coefficient(n,k))*x^k*y^(n+1-k)=binomial_coefficient(n,k-1)*x^k*y^(n+1-k)+binomial_coefficient(n,k)*x^k*y^(n+1-k)=x*\binomial_terms<n,x,y>(k-1)+y*\binomial_terms<n,x,y>(k)

thm weighted_sum_successor:
    ? forall m N,x,y C,a,b fn(k N) C:
        forall k N+:
            b(k)=x*a(k-1)+y*a(k)
        =>:
            sum(1,m+1,b)=x*sum(0,m,a)+y*sum(1,m+1,a)
    by induc m from 0:
        ? sum(1,m+1,b)=x*sum(0,m,a)+y*sum(1,m+1,a)
        ? from m=0:
            0+1=1
            1-1=0
            b(1)=x*a(1-1)+y*a(1)
            a(1-1)=a(0)
            b(1)=x*a(0)+y*a(1)
            sum(0,0,a)=a(0)
            sum(1,1,a)=a(1)
            sum(1,0+1,a)=sum(1,1,a)=a(1)
            sum(1,0+1,b)=sum(1,1,b)=b(1)=x*a(0)+y*a(1)=x*sum(0,0,a)+y*sum(1,0+1,a)
        ? induc:
            0<=m
            1<=m+1
            have previous N+=m+1
            have endpoint N+=(m+1)+1
            endpoint-1=previous
            b(endpoint)=x*a(endpoint-1)+y*a(endpoint)
            a(endpoint-1)=a(previous)=a(m+1)
            b((m+1)+1)=b(endpoint)=x*a(endpoint-1)+y*a(endpoint)=x*a(m+1)+y*a((m+1)+1)
            sum(endpoint,endpoint,b)=b(endpoint)
            sum((m+1)+1,(m+1)+1,b)=sum(endpoint,endpoint,b)=b(endpoint)=b((m+1)+1)
            sum(1,(m+1)+1,b)=sum(1,m+1,b)+sum((m+1)+1,(m+1)+1,b)=sum(1,m+1,b)+b((m+1)+1)
            sum(previous,previous,a)=a(previous)
            sum(m+1,m+1,a)=sum(previous,previous,a)=a(previous)=a(m+1)
            sum(0,m+1,a)=sum(0,m,a)+sum(m+1,m+1,a)=sum(0,m,a)+a(m+1)
            sum(endpoint,endpoint,a)=a(endpoint)
            sum((m+1)+1,(m+1)+1,a)=sum(endpoint,endpoint,a)=a(endpoint)=a((m+1)+1)
            sum(1,(m+1)+1,a)=sum(1,m+1,a)+sum((m+1)+1,(m+1)+1,a)=sum(1,m+1,a)+a((m+1)+1)
            sum(1,(m+1)+1,b)=sum(1,m+1,b)+b((m+1)+1)=(x*sum(0,m,a)+y*sum(1,m+1,a))+(x*a(m+1)+y*a((m+1)+1))=x*(sum(0,m,a)+a(m+1))+y*(sum(1,m+1,a)+a((m+1)+1))=x*sum(0,m+1,a)+y*sum(1,(m+1)+1,a)
    sum(1,m+1,b)=x*sum(0,m,a)+y*sum(1,m+1,a)

thm natural_sum_extensional:
    ? forall n N,a,b fn(k N) C:
        forall k N:
            k<=n
            =>:
                a(k)=b(k)
        =>:
            sum(0,n,a)=sum(0,n,b)
    prop same_prefix(m N):
        forall :
            m<=n
            =>:
                sum(0,m,a)=sum(0,m,b)
    by induc m from 0:
        ? $same_prefix(m)
        ? from m=0:
            claim:
                ? forall :
                    0<=n
                    =>:
                        sum(0,0,a)=sum(0,0,b)
                a(0)=b(0)
                sum(0,0,a)=a(0)=b(0)=sum(0,0,b)
            by def $same_prefix(0)
        ? induc:
            claim:
                ? forall :
                    m+1<=n
                    =>:
                        sum(0,m+1,a)=sum(0,m+1,b)
                m<=m+1<=n
                sum(0,m,a)=sum(0,m,b)
                have next N+=m+1
                a(next)=b(next)
                sum(next,next,a)=a(next)
                sum(next,next,b)=b(next)
                sum(m+1,m+1,a)=sum(next,next,a)=a(next)=a(m+1)
                sum(m+1,m+1,b)=sum(next,next,b)=b(next)=b(m+1)
                sum(0,m+1,a)=sum(0,m,a)+sum(m+1,m+1,a)=sum(0,m,a)+a(m+1)
                sum(0,m+1,b)=sum(0,m,b)+sum(m+1,m+1,b)=sum(0,m,b)+b(m+1)
                a(m+1)=a(next)=b(next)=b(m+1)
                sum(0,m+1,a)=sum(0,m,a)+a(m+1)=sum(0,m,b)+b(m+1)=sum(0,m+1,b)
            by def $same_prefix(m+1)
    $same_prefix(n)

thm binomial_theorem:
    ? forall n N,x,y C,terms fn(k N) C:
        forall k N:
            k<=n
            =>:
                terms(k)=binomial_coefficient(n,k)*x^k*y^(n-k)
        =>:
            sum(0,n,terms)=(x+y)^n
    prop row_sum(row N):
        forall values fn(k N) C:
            forall k N:
                values(k)=\binomial_terms<row,x,y>(k)
            =>:
                sum(0,row,values)=(x+y)^row
    by induc row from 0:
        ? $row_sum(row)
        ? from row=0:
            claim:
                ? forall values fn(k N) C:
                    forall k N:
                        values(k)=\binomial_terms<0,x,y>(k)
                    =>:
                        sum(0,0,values)=(x+y)^0
                release thm binomial_terms_zero(0,x,y)
                values(0)=\binomial_terms<0,x,y>(0)=y^0=1
                (x+y)^0=1
                sum(0,0,values)=values(0)=1=(x+y)^0
            by def $row_sum(0)
        ? induc:
            claim:
                ? forall values fn(k N) C:
                    forall k N:
                        values(k)=\binomial_terms<row+1,x,y>(k)
                    =>:
                        sum(0,row+1,values)=(x+y)^(row+1)
                have fn previous(k N) C=\binomial_terms<row,x,y>(k)
                claim:
                    ? forall k N:
                        previous(k)=\binomial_terms<row,x,y>(k)
                    previous(k)=\binomial_terms<row,x,y>(k)
                sum(0,row,previous)=(x+y)^row
                claim:
                    ? forall k N+:
                        values(k)=x*previous(k-1)+y*previous(k)
                    k-1 $in N
                    release thm binomial_terms_successor(row,k,x,y)
                    previous(k-1)=\binomial_terms<row,x,y>(k-1)
                    previous(k)=\binomial_terms<row,x,y>(k)
                    x*previous(k-1)=x*\binomial_terms<row,x,y>(k-1)
                    y*previous(k)=y*\binomial_terms<row,x,y>(k)
                    values(k)=\binomial_terms<row+1,x,y>(k)=x*\binomial_terms<row,x,y>(k-1)+y*\binomial_terms<row,x,y>(k)=x*previous(k-1)+y*previous(k)
                release thm weighted_sum_successor(row,x,y,previous,values)
                have next N+=row+1
                row+1>row
                \binomial_terms<row,x,y>(row+1)=0
                previous(row+1)=\binomial_terms<row,x,y>(row+1)=0
                sum(next,next,previous)=previous(next)
                sum(row+1,row+1,previous)=sum(next,next,previous)=previous(next)=previous(row+1)=0
                sum(0,row+1,previous)=sum(0,row,previous)+sum(row+1,row+1,previous)=sum(0,row,previous)+0=sum(0,row,previous)
                sum(0,0,previous)=previous(0)
                0<=row
                1<=row+1
                sum(0,row+1,previous)=sum(0,0,previous)+sum(1,row+1,previous)=previous(0)+sum(1,row+1,previous)
                sum(1,row+1,previous)=sum(0,row+1,previous)-previous(0)=sum(0,row,previous)-previous(0)
                release thm binomial_terms_zero(row,x,y)
                release thm binomial_terms_zero(row+1,x,y)
                previous(0)=\binomial_terms<row,x,y>(0)=y^row
                values(0)=\binomial_terms<row+1,x,y>(0)=y^(row+1)
                y^(row+1)=y^row*y
                values(0)=y^(row+1)=y^row*y=previous(0)*y=y*previous(0)
                sum(0,0,values)=values(0)
                sum(0,row+1,values)=sum(0,0,values)+sum(1,row+1,values)=values(0)+sum(1,row+1,values)
                sum(1,row+1,values)=x*sum(0,row,previous)+y*sum(1,row+1,previous)
                y*sum(1,row+1,previous)=y*(sum(0,row,previous)-previous(0))
                sum(0,row+1,values)=values(0)+sum(1,row+1,values)=y*previous(0)+(x*sum(0,row,previous)+y*sum(1,row+1,previous))=(y*previous(0)+x*sum(0,row,previous))+y*sum(1,row+1,previous)=(y*previous(0)+x*sum(0,row,previous))+y*(sum(0,row,previous)-previous(0))=y*previous(0)+(x*sum(0,row,previous)+y*(sum(0,row,previous)-previous(0)))=(x+y)*sum(0,row,previous)
                (x+y)^(row+1)=(x+y)^row*(x+y)
                sum(0,row+1,values)=(x+y)*sum(0,row,previous)=(x+y)*(x+y)^row=(x+y)^row*(x+y)=(x+y)^(row+1)
            by def $row_sum(row+1)
    $row_sum(n)
    have fn actual(k N) C=\binomial_terms<n,x,y>(k)
    claim:
        ? forall k N:
            actual(k)=\binomial_terms<n,x,y>(k)
        actual(k)=\binomial_terms<n,x,y>(k)
    sum(0,n,actual)=(x+y)^n
    claim:
        ? forall k N:
            k<=n
            =>:
                terms(k)=actual(k)
        \binomial_terms<n,x,y>(k)=binomial_coefficient(n,k)*x^k*y^(n-k)
        actual(k)=\binomial_terms<n,x,y>(k)=binomial_coefficient(n,k)*x^k*y^(n-k)=terms(k)
    release thm natural_sum_extensional(n,terms,actual)
    sum(0,n,terms)=sum(0,n,actual)=(x+y)^n

thm finite_map_preimage_is_finite:
    ? forall X finite_set,Y set,f fn(x X) Y,S set:
        $is_finite_set(preimage_set(f,S))
    preimage_set(f,S) $subset X
    $is_finite_set(X)
    $is_finite_set(preimage_set(f,S))

claim:
    ? forall X finite_set,Y set,f fn(x X) Y,S set:
        $is_finite_set(preimage_set(f,S))
    release thm finite_map_preimage_is_finite(X,Y,f,S)

thm map_preimage_of_empty:
    ? forall X,Y set,f fn(x X) Y:
        preimage_set(f,{})={}
    by extension:
        ? preimage_set(f,{})={}
        claim:
            ? forall x preimage_set(f,{}):
                x $in {}
            by contra:
                ? x $in {}
                f(x) $in {}
                impossible f(x) $in {}

thm map_preimage_of_codomain:
    ? forall X,Y set,f fn(x X) Y:
        preimage_set(f,Y)=X
    by extension:
        ? preimage_set(f,Y)=X
        claim:
            ? forall x preimage_set(f,Y):
                x $in X
            x $in X
        claim:
            ? forall x X:
                x $in preimage_set(f,Y)
            f(x) $in Y
            x $in preimage_set(f,Y)

thm map_preimage_of_union:
    ? forall X,Y set,f fn(x X) Y,U,V set:
        preimage_set(f,union(U,V))=union(preimage_set(f,U),preimage_set(f,V))
    by extension:
        ? preimage_set(f,union(U,V))=union(preimage_set(f,U),preimage_set(f,V))
        claim:
            ? forall x preimage_set(f,union(U,V)):
                x $in union(preimage_set(f,U),preimage_set(f,V))
            x $in X
            f(x) $in union(U,V)
            f(x) $in U or f(x) $in V
            by cases:
                ? x $in union(preimage_set(f,U),preimage_set(f,V))
                case f(x) $in U:
                    x $in preimage_set(f,U)
                    x $in union(preimage_set(f,U),preimage_set(f,V))
                case f(x) $in V:
                    x $in preimage_set(f,V)
                    x $in union(preimage_set(f,U),preimage_set(f,V))
        claim:
            ? forall x union(preimage_set(f,U),preimage_set(f,V)):
                x $in preimage_set(f,union(U,V))
            x $in preimage_set(f,U) or x $in preimage_set(f,V)
            by cases:
                ? x $in preimage_set(f,union(U,V))
                case x $in preimage_set(f,U):
                    x $in X
                    f(x) $in U
                    f(x) $in union(U,V)
                    x $in preimage_set(f,union(U,V))
                case x $in preimage_set(f,V):
                    x $in X
                    f(x) $in V
                    f(x) $in union(U,V)
                    x $in preimage_set(f,union(U,V))

thm disjoint_sets_have_disjoint_preimages:
    ? forall X,Y set,f fn(x X) Y,U,V set:
        intersect(U,V)={}
        =>:
            intersect(preimage_set(f,U),preimage_set(f,V))={}
    by extension:
        ? intersect(preimage_set(f,U),preimage_set(f,V))={}
        claim:
            ? forall x intersect(preimage_set(f,U),preimage_set(f,V)):
                x $in {}
            by contra:
                ? x $in {}
                x $in preimage_set(f,U)
                x $in preimage_set(f,V)
                f(x) $in U
                f(x) $in V
                f(x) $in intersect(U,V)
                f(x) $in {}
                impossible f(x) $in {}

thm disjoint_preimage_union_size:
    ? forall X finite_set,Y set,f fn(x X) Y,U,V set:
        intersect(U,V)={}
        =>:
            finite_set_size(preimage_set(f,union(U,V)))=finite_set_size(preimage_set(f,U))+finite_set_size(preimage_set(f,V))
    release thm map_preimage_of_union(X,Y,f,U,V)
    release thm disjoint_sets_have_disjoint_preimages(X,Y,f,U,V)
    release thm union_size(preimage_set(f,U),preimage_set(f,V))
    finite_set_size(intersect(preimage_set(f,U),preimage_set(f,V)))=finite_set_size({})=0
    finite_set_size(preimage_set(f,union(U,V)))=finite_set_size(union(preimage_set(f,U),preimage_set(f,V)))=finite_set_size(preimage_set(f,U))+finite_set_size(preimage_set(f,V))-finite_set_size(intersect(preimage_set(f,U),preimage_set(f,V)))=finite_set_size(preimage_set(f,U))+finite_set_size(preimage_set(f,V))

thm binomial_row_sum:
    ? forall n N:
        sum(0,n,fn(k N) C {binomial_coefficient(n,k)})=2^n
    claim:
        ? forall k N:
            k<=n
            =>:
                fn(j N) C {binomial_coefficient(n,j)}(k)=binomial_coefficient(n,k)*1^k*1^(n-k)
        1^k=1
        1^(n-k)=1
        fn(j N) C {binomial_coefficient(n,j)}(k)=binomial_coefficient(n,k)=binomial_coefficient(n,k)*1*1=binomial_coefficient(n,k)*1^k*1^(n-k)
    release thm binomial_theorem(n,1,1,fn(k N) C {binomial_coefficient(n,k)})
    1+1=2
    (1+1)^n=2^n
    sum(0,n,fn(k N) C {binomial_coefficient(n,k)})=(1+1)^n=2^n

thm binomial_alternating_row_sum:
    ? forall n N+:
        sum(0,n,fn(k N) C {(-1)^k*binomial_coefficient(n,k)})=0
    claim:
        ? forall k N:
            k<=n
            =>:
                fn(j N) C {(-1)^j*binomial_coefficient(n,j)}(k)=binomial_coefficient(n,k)*(-1)^k*1^(n-k)
        1^(n-k)=1
        fn(j N) C {(-1)^j*binomial_coefficient(n,j)}(k)=(-1)^k*binomial_coefficient(n,k)=binomial_coefficient(n,k)*(-1)^k=binomial_coefficient(n,k)*(-1)^k*1^(n-k)
    release thm binomial_theorem(n,-1,1,fn(k N) C {(-1)^k*binomial_coefficient(n,k)})
    -1+1=0
    (-1+1)^n=0^n=0
    sum(0,n,fn(k N) C {(-1)^k*binomial_coefficient(n,k)})=(-1+1)^n=0

thm binomial_expansion:
    ? forall n N,x,y C:
        sum(0,n,fn(k N) C {\binomial_terms<n,x,y>(k)})=(x+y)^n
    claim:
        ? forall k N:
            k<=n
            =>:
                fn(j N) C {\binomial_terms<n,x,y>(j)}(k)=binomial_coefficient(n,k)*x^k*y^(n-k)
        \binomial_terms<n,x,y>(k)=binomial_coefficient(n,k)*x^k*y^(n-k)
        fn(j N) C {\binomial_terms<n,x,y>(j)}(k)=\binomial_terms<n,x,y>(k)=binomial_coefficient(n,k)*x^k*y^(n-k)
    release thm binomial_theorem(n,x,y,fn(k N) C {\binomial_terms<n,x,y>(k)})

thm preimage_fiber_sum:
    ? forall X,Y finite_set,f fn(x X) Y,S power_set(Y):
        finite_set_sum(S,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})=finite_set_size(preimage_set(f,S))
    have fn count(y Y) N=finite_set_size(preimage_set(f,{y}))
    prop counted_subsets(n N):
        forall A power_set(Y):
            finite_set_size(A)=n
            =>:
                finite_set_sum(A,count)=finite_set_size(preimage_set(f,A))
    by induc n from 0:
        ? $counted_subsets(n)
        ? from n=0:
            claim:
                ? forall A power_set(Y):
                    finite_set_size(A)=0
                    =>:
                        finite_set_sum(A,count)=finite_set_size(preimage_set(f,A))
                A={}
                release thm map_preimage_of_empty(X,Y,f)
                preimage_set(f,A)=preimage_set(f,{})={}
                finite_set_sum(A,count)=finite_set_sum({},count)=0=finite_set_size({})=finite_set_size(preimage_set(f,A))
            by def $counted_subsets(0)
        ? induc:
            claim:
                ? forall A power_set(Y):
                    finite_set_size(A)=n+1
                    =>:
                        finite_set_sum(A,count)=finite_set_size(preimage_set(f,A))
                by contra:
                    ? $is_nonempty_set(A)
                    A={}
                    finite_set_size(A)=finite_set_size({})=0<n+1
                    impossible finite_set_size(A)=n+1
                A $subset Y
                $is_finite_set(A)
                have point A
                point $in Y
                {point} $subset A
                have rest finite_set=set_minus(A,{point})
                rest $subset A
                A $subset Y
                rest $subset Y
                rest $in power_set(Y)
                release thm remove_one_size(A,point)
                finite_set_size(rest)=finite_set_size(set_minus(A,{point}))=finite_set_size(A)-1=(n+1)-1=n
                finite_set_sum(rest,count)=finite_set_size(preimage_set(f,rest))
                by contra:
                    ? not point $in rest
                    point $in rest
                    point $in set_minus(A,{point})
                    not point $in {point}
                    impossible point $in {point}
                by extension:
                    ? intersect(rest,{point})={}
                    claim:
                        ? forall y intersect(rest,{point}):
                            y $in {}
                        by contra:
                            ? y $in {}
                            y $in rest
                            y $in {point}
                            y=point
                            point $in rest
                            impossible point $in rest
                union(rest,{point})=union({point},rest)=union({point},set_minus(A,{point}))=union({point},A)=A
                union(rest,{point})=A
                preimage_set(f,union(rest,{point}))=preimage_set(f,A)
                release thm disjoint_preimage_union_size(X,Y,f,rest,{point})
                finite_set_size(preimage_set(f,A))=finite_set_size(preimage_set(f,union(rest,{point})))=finite_set_size(preimage_set(f,rest))+finite_set_size(preimage_set(f,{point}))
                finite_set_sum({point},count)=count(point)=finite_set_size(preimage_set(f,{point}))
                finite_set_sum(union(rest,{point}),count)=finite_set_sum(rest,count)+finite_set_sum({point},count)
                finite_set_sum(A,count)=finite_set_sum(union(rest,{point}),count)=finite_set_sum(rest,count)+finite_set_sum({point},count)=finite_set_size(preimage_set(f,rest))+finite_set_size(preimage_set(f,{point}))=finite_set_size(preimage_set(f,A))
            by def $counted_subsets(n+1)
    $is_finite_set(S)
    $counted_subsets(finite_set_size(S))
    finite_set_sum(S,count)=finite_set_size(preimage_set(f,S))
    claim:
        ? forall y S:
            finite_set_size(preimage_set(f,{y}))=count(y)
        y $in Y
        count(y)=finite_set_size(preimage_set(f,{y}))
    release thm finite_set_sum_substitution(finite_set_sum(S,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}),finite_set_sum(S,count))
    finite_set_sum(S,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})=finite_set_sum(S,count)=finite_set_size(preimage_set(f,S))

thm finite_fiber_sum:
    ? forall X,Y finite_set,f fn(x X) Y:
        finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})=finite_set_size(X)
    Y $in power_set(Y)
    release thm preimage_fiber_sum(X,Y,f,Y)
    release thm map_preimage_of_codomain(X,Y,f)
    finite_set_size(preimage_set(f,Y))=finite_set_size(X)
    finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})=finite_set_size(preimage_set(f,Y))=finite_set_size(X)

thm uniform_fiber_count:
    ? forall X,Y finite_set,f fn(x X) Y,r N:
        forall y Y:
            finite_set_size(preimage_set(f,{y}))=r
        =>:
            finite_set_size(X)=r*finite_set_size(Y)
    release thm finite_fiber_sum(X,Y,f)
    release thm finite_set_sum_substitution(finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}),finite_set_sum(Y,fn(y Y) N {r}))
    finite_set_sum(Y,fn(y Y) N {r})=finite_set_size(Y)*r=r*finite_set_size(Y)
    finite_set_size(X)=finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})=finite_set_sum(Y,fn(y Y) N {r})=r*finite_set_size(Y)

thm bounded_fibers_size_le:
    ? forall X,Y finite_set,f fn(x X) Y,r N:
        forall y Y:
            finite_set_size(preimage_set(f,{y}))<=r
        =>:
            finite_set_size(X)<=r*finite_set_size(Y)
    release thm finite_fiber_sum(X,Y,f)
    finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}) $in N
    finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}) $in R
    finite_set_sum(Y,fn(y Y) N {r}) $in N
    finite_set_sum(Y,fn(y Y) N {r}) $in R
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}),finite_set_sum(Y,fn(y Y) N {r}))
    finite_set_sum(Y,fn(y Y) N {r})=finite_set_size(Y)*r=r*finite_set_size(Y)
    finite_set_size(X)=finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})<=finite_set_sum(Y,fn(y Y) N {r})=r*finite_set_size(Y)

thm lower_bounded_fibers_size_ge:
    ? forall X,Y finite_set,f fn(x X) Y,r N:
        forall y Y:
            r<=finite_set_size(preimage_set(f,{y}))
        =>:
            r*finite_set_size(Y)<=finite_set_size(X)
    release thm finite_fiber_sum(X,Y,f)
    finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}) $in N
    finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}) $in R
    finite_set_sum(Y,fn(y Y) N {r}) $in N
    finite_set_sum(Y,fn(y Y) N {r}) $in R
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(Y,fn(y Y) N {r}),finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))}))
    finite_set_sum(Y,fn(y Y) N {r})=finite_set_size(Y)*r=r*finite_set_size(Y)
    r*finite_set_size(Y)=finite_set_sum(Y,fn(y Y) N {r})<=finite_set_sum(Y,fn(y Y) N {finite_set_size(preimage_set(f,{y}))})=finite_set_size(X)

thm generalized_pigeonhole_fiber:
    ? forall X,Y finite_set,f fn(x X) Y,r N:
        r*finite_set_size(Y)<finite_set_size(X)
        =>:
            exist y Y st {r<finite_set_size(preimage_set(f,{y}))}
    by contra:
        ? exist y Y st {r<finite_set_size(preimage_set(f,{y}))}
        claim:
            ? forall y Y:
                finite_set_size(preimage_set(f,{y}))<=r
            by contra:
                ? finite_set_size(preimage_set(f,{y}))<=r
                r<finite_set_size(preimage_set(f,{y}))
                witness exist value Y st {r<finite_set_size(preimage_set(f,{value}))} from y
                impossible exist value Y st {r<finite_set_size(preimage_set(f,{value}))}
        release thm bounded_fibers_size_le(X,Y,f,r)
        impossible r*finite_set_size(Y)<finite_set_size(X)

thm omitted_value_has_empty_fiber:
    ? forall X,Y set,f fn(x X) Y,y Y:
        not y $in fn_range(f)
        =>:
            preimage_set(f,{y})={}
    by extension:
        ? preimage_set(f,{y})={}
        claim:
            ? forall x preimage_set(f,{y}):
                x $in {}
            by contra:
                ? x $in {}
                x $in X
                f(x) $in {y}
                f(x)=y
                f(x) $in fn_range(f)
                y $in fn_range(f)
                impossible y $in fn_range(f)

thm distinct_fibers_are_disjoint:
    ? forall X,Y set,f fn(x X) Y,y,z Y:
        y!=z
        =>:
            intersect(preimage_set(f,{y}),preimage_set(f,{z}))={}
    by extension:
        ? intersect({y},{z})={}
        claim:
            ? forall value intersect({y},{z}):
                value $in {}
            by contra:
                ? value $in {}
                value $in {y}
                value $in {z}
                value=y
                value=z
                y=z
                impossible y=z
    release thm disjoint_sets_have_disjoint_preimages(X,Y,f,{y},{z})

thm surjective_map_has_positive_fiber:
    ? forall X,Y finite_set,f fn(x X) Y,y Y:
        $surjective(X,Y,f)
        =>:
            0<finite_set_size(preimage_set(f,{y}))
    release thm finite_map_preimage_is_finite(X,Y,f,{y})
    finite_set_size(preimage_set(f,{y})) $in N
    obtain x from exist x X st {y=f(x)}
    f(x)=y
    f(x) $in {y}
    x $in preimage_set(f,{y})
    by contra:
        ? 0<finite_set_size(preimage_set(f,{y}))
        finite_set_size(preimage_set(f,{y}))<=0
        0<=finite_set_size(preimage_set(f,{y}))
        finite_set_size(preimage_set(f,{y}))=0
        preimage_set(f,{y})={}
        x $in {}
        impossible x $in {}

thm positive_fibers_imply_surjective:
    ? forall X,Y finite_set,f fn(x X) Y:
        forall y Y:
            0<finite_set_size(preimage_set(f,{y}))
        =>:
            $surjective(X,Y,f)
    claim:
        ? forall y Y:
            exist x X st {y=f(x)}
        by contra:
            ? $is_nonempty_set(preimage_set(f,{y}))
            preimage_set(f,{y})={}
            finite_set_size(preimage_set(f,{y}))=finite_set_size({})=0
            impossible 0<finite_set_size(preimage_set(f,{y}))
        have x preimage_set(f,{y})
        x $in X
        f(x) $in {y}
        f(x)=y
        witness exist point X st {y=f(point)} from x
    by def $surjective(X,Y,f)

thm injective_map_has_small_fiber:
    ? forall X,Y finite_set,f fn(x X) Y,y Y:
        $injective(X,Y,f)
        =>:
            finite_set_size(preimage_set(f,{y}))<=1
    by cases:
        ? finite_set_size(preimage_set(f,{y}))<=1
        case $is_nonempty_set(preimage_set(f,{y})):
            have point preimage_set(f,{y})
            point $in X
            f(point) $in {y}
            f(point)=y
            by extension:
                ? preimage_set(f,{y})={point}
                claim:
                    ? forall x preimage_set(f,{y}):
                        x $in {point}
                    x $in X
                    f(x) $in {y}
                    f(x)=y=f(point)
                    x=point
                    x $in {point}
                claim:
                    ? forall x {point}:
                        x $in preimage_set(f,{y})
                    x=point
                    x $in preimage_set(f,{y})
            finite_set_size(preimage_set(f,{y}))=finite_set_size({point})=1
        case not $is_nonempty_set(preimage_set(f,{y})):
            preimage_set(f,{y})={}
            finite_set_size(preimage_set(f,{y}))=finite_set_size({})=0<=1

thm small_fibers_imply_injective:
    ? forall X,Y finite_set,f fn(x X) Y:
        forall y Y:
            finite_set_size(preimage_set(f,{y}))<=1
        =>:
            $injective(X,Y,f)
    claim:
        ? forall x,z X:
            f(x)=f(z)
            =>:
                x=z
        have y Y=f(x)
        f(x)=y
        f(z)=f(x)=y
        x $in preimage_set(f,{y})
        z $in preimage_set(f,{y})
        by contra:
            ? x=z
            x!=z
            {x,z} $subset preimage_set(f,{y})
            finite_set_size({x,z})<=finite_set_size(preimage_set(f,{y}))<=1
            finite_set_size({x,z})=2
            2<=1
            impossible 2<=1
    by def $injective(X,Y,f)
