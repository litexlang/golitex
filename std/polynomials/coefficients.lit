# Coefficient laws for the existing real and complex polynomial functions.
# Restriction to the positive real axis is explicit in each source proof.

claim:
    ? forall n N,k closed_range(0,n):
        k+1 $in closed_range(1,n+1)
    k+1 $in Z
    1<=k+1<=n+1
    k+1 $in closed_range(1,n+1)

thm complex_polynomial_coefficients_unique:
    ? forall n,m N,left finite_seq(C,n+1),right finite_seq(C,m+1),j N+:
        j<=n+1
        j<=m+1
        \poly::complex_polynomial_from_coefficients<n>(left)=\poly::complex_polynomial_from_coefficients<m>(right)
        =>:
            left(j)=right(j)
    have left_polynomial fn(x C) C=\poly::complex_polynomial_from_coefficients<n>(left)
    have right_polynomial fn(x C) C=\poly::complex_polynomial_from_coefficients<m>(right)
    left_polynomial=\poly::complex_polynomial_from_coefficients<n>(left)=\poly::complex_polynomial_from_coefficients<m>(right)=right_polynomial
    have fn restriction(x R+) C=left_polynomial(x)
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {left(k+1)*x^k})
        x $in C
        release thm poly::complex_polynomial_value_at(n,left,x)
        release thm poly::complex_polynomial_value_spec(n,left,x)
        restriction(x)=left_polynomial(x)=\poly::complex_polynomial_from_coefficients<n>(left)(x)=\poly::complex_polynomial_value<n>(left,x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {left(k+1)*x^k})
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {right(k+1)*x^k})
        x $in C
        release thm poly::complex_polynomial_value_at(m,right,x)
        release thm poly::complex_polynomial_value_spec(m,right,x)
        left_polynomial(x)=right_polynomial(x)
        left_polynomial(x)=\poly::complex_polynomial_from_coefficients<n>(left)(x)
        right_polynomial(x)=\poly::complex_polynomial_from_coefficients<m>(right)(x)
        \poly::complex_polynomial_from_coefficients<n>(left)(x)=left_polynomial(x)=right_polynomial(x)=\poly::complex_polynomial_from_coefficients<m>(right)(x)
        restriction(x)=left_polynomial(x)=\poly::complex_polynomial_from_coefficients<n>(left)(x)=\poly::complex_polynomial_from_coefficients<m>(right)(x)=\poly::complex_polynomial_value<m>(right,x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {right(k+1)*x^k})
    release thm padding::complex_power_representations_common_coefficients(n,m,left,right,restriction,j)

thm real_polynomial_coefficients_unique:
    ? forall n,m N,left finite_seq(R,n+1),right finite_seq(R,m+1),j N+:
        j<=n+1
        j<=m+1
        \poly::real_polynomial_from_coefficients<n>(left)=\poly::real_polynomial_from_coefficients<m>(right)
        =>:
            left(j)=right(j)
    have left_polynomial fn(x R) R=\poly::real_polynomial_from_coefficients<n>(left)
    have right_polynomial fn(x R) R=\poly::real_polynomial_from_coefficients<m>(right)
    left_polynomial=\poly::real_polynomial_from_coefficients<n>(left)=\poly::real_polynomial_from_coefficients<m>(right)=right_polynomial
    have fn complex_left(idx closed_range(1,n+1)) C=left(idx)
    have fn complex_right(idx closed_range(1,m+1)) C=right(idx)
    complex_left $in finite_seq(C,n+1)
    complex_right $in finite_seq(C,m+1)
    have fn restriction(x R+) C=left_polynomial(x)
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {complex_left(k+1)*x^k})
        x $in R
        x $in C
        release thm poly::real_polynomial_value_at(n,left,x)
        release thm poly::real_polynomial_value_spec(n,left,x)
        claim:
            ? forall k closed_range(0,n):
                left(k+1)*x^k=complex_left(k+1)*x^k
            k+1 $in closed_range(1,n+1)
            complex_left(k+1)=left(k+1)
            left(k+1)*x^k=complex_left(k+1)*x^k
        release thm finite_set_sum_substitution(finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) R {left(k+1)*x^k}),finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {complex_left(k+1)*x^k}))
        restriction(x)=left_polynomial(x)=\poly::real_polynomial_from_coefficients<n>(left)(x)=\poly::real_polynomial_value<n>(left,x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) R {left(k+1)*x^k})=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {complex_left(k+1)*x^k})
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {complex_right(k+1)*x^k})
        x $in R
        x $in C
        release thm poly::real_polynomial_value_at(m,right,x)
        release thm poly::real_polynomial_value_spec(m,right,x)
        left_polynomial(x)=right_polynomial(x)
        left_polynomial(x)=\poly::real_polynomial_from_coefficients<n>(left)(x)
        right_polynomial(x)=\poly::real_polynomial_from_coefficients<m>(right)(x)
        claim:
            ? forall k closed_range(0,m):
                right(k+1)*x^k=complex_right(k+1)*x^k
            k+1 $in closed_range(1,m+1)
            complex_right(k+1)=right(k+1)
            right(k+1)*x^k=complex_right(k+1)*x^k
        release thm finite_set_sum_substitution(finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) R {right(k+1)*x^k}),finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {complex_right(k+1)*x^k}))
        restriction(x)=left_polynomial(x)=right_polynomial(x)=\poly::real_polynomial_from_coefficients<m>(right)(x)=\poly::real_polynomial_value<m>(right,x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) R {right(k+1)*x^k})=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {complex_right(k+1)*x^k})
    release thm padding::complex_power_representations_common_coefficients(n,m,complex_left,complex_right,restriction,j)
    j $in closed_range(1,n+1)
    j $in closed_range(1,m+1)
    complex_left(j)=left(j)
    complex_right(j)=right(j)
    left(j)=complex_left(j)=complex_right(j)=right(j)

thm complex_polynomial_excess_coefficients_zero:
    ? forall n,m N,left finite_seq(C,n+1),right finite_seq(C,m+1),j N+:
        n<m
        j>n+1
        j<=m+1
        \poly::complex_polynomial_from_coefficients<n>(left)=\poly::complex_polynomial_from_coefficients<m>(right)
        =>:
            right(j)=0
    have left_polynomial fn(x C) C=\poly::complex_polynomial_from_coefficients<n>(left)
    have right_polynomial fn(x C) C=\poly::complex_polynomial_from_coefficients<m>(right)
    left_polynomial=\poly::complex_polynomial_from_coefficients<n>(left)=\poly::complex_polynomial_from_coefficients<m>(right)=right_polynomial
    have fn restriction(x R+) C=left_polynomial(x)
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {left(k+1)*x^k})
        x $in C
        release thm poly::complex_polynomial_value_at(n,left,x)
        release thm poly::complex_polynomial_value_spec(n,left,x)
        restriction(x)=left_polynomial(x)=\poly::complex_polynomial_from_coefficients<n>(left)(x)=\poly::complex_polynomial_value<n>(left,x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {left(k+1)*x^k})
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {right(k+1)*x^k})
        x $in C
        release thm poly::complex_polynomial_value_at(m,right,x)
        release thm poly::complex_polynomial_value_spec(m,right,x)
        left_polynomial(x)=right_polynomial(x)
        left_polynomial(x)=\poly::complex_polynomial_from_coefficients<n>(left)(x)
        right_polynomial(x)=\poly::complex_polynomial_from_coefficients<m>(right)(x)
        \poly::complex_polynomial_from_coefficients<n>(left)(x)=left_polynomial(x)=right_polynomial(x)=\poly::complex_polynomial_from_coefficients<m>(right)(x)
        restriction(x)=left_polynomial(x)=\poly::complex_polynomial_from_coefficients<n>(left)(x)=\poly::complex_polynomial_from_coefficients<m>(right)(x)=\poly::complex_polynomial_value<m>(right,x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {right(k+1)*x^k})
    release thm padding::complex_power_representation_excess_coefficients_zero(n,m,left,right,restriction,j)

thm real_polynomial_excess_coefficients_zero:
    ? forall n,m N,left finite_seq(R,n+1),right finite_seq(R,m+1),j N+:
        n<m
        j>n+1
        j<=m+1
        \poly::real_polynomial_from_coefficients<n>(left)=\poly::real_polynomial_from_coefficients<m>(right)
        =>:
            right(j)=0
    have left_polynomial fn(x R) R=\poly::real_polynomial_from_coefficients<n>(left)
    have right_polynomial fn(x R) R=\poly::real_polynomial_from_coefficients<m>(right)
    left_polynomial=\poly::real_polynomial_from_coefficients<n>(left)=\poly::real_polynomial_from_coefficients<m>(right)=right_polynomial
    have fn complex_left(idx closed_range(1,n+1)) C=left(idx)
    have fn complex_right(idx closed_range(1,m+1)) C=right(idx)
    complex_left $in finite_seq(C,n+1)
    complex_right $in finite_seq(C,m+1)
    have fn restriction(x R+) C=left_polynomial(x)
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {complex_left(k+1)*x^k})
        x $in R
        x $in C
        release thm poly::real_polynomial_value_at(n,left,x)
        release thm poly::real_polynomial_value_spec(n,left,x)
        claim:
            ? forall k closed_range(0,n):
                left(k+1)*x^k=complex_left(k+1)*x^k
            k+1 $in closed_range(1,n+1)
            complex_left(k+1)=left(k+1)
            left(k+1)*x^k=complex_left(k+1)*x^k
        release thm finite_set_sum_substitution(finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) R {left(k+1)*x^k}),finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {complex_left(k+1)*x^k}))
        restriction(x)=left_polynomial(x)=\poly::real_polynomial_from_coefficients<n>(left)(x)=\poly::real_polynomial_value<n>(left,x)=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) R {left(k+1)*x^k})=finite_set_sum(closed_range(0,n),fn(k closed_range(0,n)) C {complex_left(k+1)*x^k})
    claim:
        ? forall x R+:
            restriction(x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {complex_right(k+1)*x^k})
        x $in R
        x $in C
        release thm poly::real_polynomial_value_at(m,right,x)
        release thm poly::real_polynomial_value_spec(m,right,x)
        left_polynomial(x)=right_polynomial(x)
        left_polynomial(x)=\poly::real_polynomial_from_coefficients<n>(left)(x)
        right_polynomial(x)=\poly::real_polynomial_from_coefficients<m>(right)(x)
        claim:
            ? forall k closed_range(0,m):
                right(k+1)*x^k=complex_right(k+1)*x^k
            k+1 $in closed_range(1,m+1)
            complex_right(k+1)=right(k+1)
            right(k+1)*x^k=complex_right(k+1)*x^k
        release thm finite_set_sum_substitution(finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) R {right(k+1)*x^k}),finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {complex_right(k+1)*x^k}))
        restriction(x)=left_polynomial(x)=right_polynomial(x)=\poly::real_polynomial_from_coefficients<m>(right)(x)=\poly::real_polynomial_value<m>(right,x)=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) R {right(k+1)*x^k})=finite_set_sum(closed_range(0,m),fn(k closed_range(0,m)) C {complex_right(k+1)*x^k})
    release thm padding::complex_power_representation_excess_coefficients_zero(n,m,complex_left,complex_right,restriction,j)
    j $in closed_range(1,m+1)
    complex_right(j)=right(j)
    right(j)=complex_right(j)=0

thm complex_polynomial_coefficient_vector_unique:
    ? forall n N,left,right finite_seq(C,n+1):
        \poly::complex_polynomial_from_coefficients<n>(left)=\poly::complex_polynomial_from_coefficients<n>(right)
        =>:
            left=right
    claim:
        ? forall j closed_range(1,n+1):
            left(j)=right(j)
        j $in N+
        j<=n+1
        release thm complex_polynomial_coefficients_unique(n,n,left,right,j)
    by fn_extension left=right

thm real_polynomial_coefficient_vector_unique:
    ? forall n N,left,right finite_seq(R,n+1):
        \poly::real_polynomial_from_coefficients<n>(left)=\poly::real_polynomial_from_coefficients<n>(right)
        =>:
            left=right
    claim:
        ? forall j closed_range(1,n+1):
            left(j)=right(j)
        j $in N+
        j<=n+1
        release thm real_polynomial_coefficients_unique(n,n,left,right,j)
    by fn_extension left=right

thm complex_polynomial_leading_bounds_unique:
    ? forall n,m N,left finite_seq(C,n+1),right finite_seq(C,m+1):
        left(n+1)!=0
        right(m+1)!=0
        \poly::complex_polynomial_from_coefficients<n>(left)=\poly::complex_polynomial_from_coefficients<m>(right)
        =>:
            n=m
    by contra:
        ? n=m
        n!=m
        by cases:
            ? 1=0
            case n<m:
                m+1 $in N+
                m+1>n+1
                release thm complex_polynomial_excess_coefficients_zero(n,m,left,right,m+1)
                right(m+1)=0
                by contra:
                    ? 1=0
                    impossible right(m+1)!=0
            case n>=m:
                claim:
                    ? n>m
                    by contra:
                        ? n>m
                        n<=m
                        n=m
                        impossible n!=m
                n+1 $in N+
                n+1>m+1
                release thm complex_polynomial_excess_coefficients_zero(m,n,right,left,n+1)
                left(n+1)=0
                by contra:
                    ? 1=0
                    impossible left(n+1)!=0
        impossible 1=0

thm real_polynomial_leading_bounds_unique:
    ? forall n,m N,left finite_seq(R,n+1),right finite_seq(R,m+1):
        left(n+1)!=0
        right(m+1)!=0
        \poly::real_polynomial_from_coefficients<n>(left)=\poly::real_polynomial_from_coefficients<m>(right)
        =>:
            n=m
    by contra:
        ? n=m
        n!=m
        by cases:
            ? 1=0
            case n<m:
                m+1 $in N+
                m+1>n+1
                release thm real_polynomial_excess_coefficients_zero(n,m,left,right,m+1)
                right(m+1)=0
                by contra:
                    ? 1=0
                    impossible right(m+1)!=0
            case n>=m:
                claim:
                    ? n>m
                    by contra:
                        ? n>m
                        n<=m
                        n=m
                        impossible n!=m
                n+1 $in N+
                n+1>m+1
                release thm real_polynomial_excess_coefficients_zero(m,n,right,left,n+1)
                left(n+1)=0
                by contra:
                    ? 1=0
                    impossible left(n+1)!=0
        impossible 1=0
