# Independent actual linear-map space consumers.

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,T \space::linear_map_carrier<K,F,V,source,W,target>:
        T $in fn(v V) W
    release thm space::linear_map_function_carrier(K,F,V,source,W,target,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>:
        $is_nonempty_set(\space::linear_map_carrier<K,F,V,source,W,target>)
    release thm space::linear_map_carrier_is_nonempty(K,F,V,source,W,target)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,X set,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>:
        \space::vector_function_space<K,F,X,W,target> $in &Algebra::vector_space::VectorSpace<K,F,fn(x X) W>
    release thm space::vector_function_space_carrier(K,F,X,W,target)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,S,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,S)
        $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,T)
        =>:
            $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,\space::pointwise_map_add<K,F,V,W,target>(S,T))
    release thm space::pointwise_add_of_linear_maps_is_linear(K,F,V,source,W,target,S,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,a K,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,T)
        =>:
            $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,\space::pointwise_map_smul<K,F,V,W,target>(a,T))
    release thm space::pointwise_smul_of_linear_map_is_linear(K,F,V,source,W,target,a,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,T \space::linear_map_carrier<K,F,V,source,W,target>:
        T $in fn(v V) W
        $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,T)
    release thm space::linear_map_carrier_specification(K,F,V,source,W,target,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,T fn(v V) W:
        $Algebra::vector_space::is_linear_map(K,F,V,source,W,target,T)
        =>:
            T $in \space::linear_map_carrier<K,F,V,source,W,target>
    release thm space::linear_map_belongs_to_carrier(K,F,V,source,W,target,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,S,T \space::linear_map_carrier<K,F,V,source,W,target>:
        \space::linear_map_add<K,F,V,source,W,target>(S,T) $in fn(v V) W
    release thm space::linear_map_add_function_carrier(K,F,V,source,W,target,S,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,a K,T \space::linear_map_carrier<K,F,V,source,W,target>:
        \space::linear_map_smul<K,F,V,source,W,target>(a,T) $in fn(v V) W
    release thm space::linear_map_smul_function_carrier(K,F,V,source,W,target,a,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,S,T,result fn(v V) W,v V:
        S $in \space::linear_map_carrier<K,F,V,source,W,target>
        T $in \space::linear_map_carrier<K,F,V,source,W,target>
        result=\space::linear_map_add<K,F,V,source,W,target>(S,T)
        =>:
            result(v)=target.add(S(v),T(v))
    release thm space::linear_map_add_pointwise(K,F,V,source,W,target,S,T,result,v)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>:
        $Algebra::vector_space::is_subspace(K,F,fn(v V) W,\space::vector_function_space<K,F,V,W,target>,\space::linear_map_carrier<K,F,V,source,W,target>)
    release thm space::linear_maps_form_subspace(K,F,V,source,W,target)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>:
        \Algebra::vector_space::zero_map<V,W,target.zero> =\space::vector_function_space<K,F,V,W,target>.zero
    release thm space::zero_map_equals_vector_function_space_zero(K,F,V,W,target)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>:
        \space::linear_map_space<K,F,V,source,W,target> $in &Algebra::vector_space::VectorSpace<K,F,\space::linear_map_carrier<K,F,V,source,W,target>>
    release thm space::linear_map_space_carrier(K,F,V,source,W,target)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,S,T fn(v V) W:
        S $in \space::linear_map_carrier<K,F,V,source,W,target>
        T $in \space::linear_map_carrier<K,F,V,source,W,target>
        =>:
            \space::linear_map_space<K,F,V,source,W,target>.add(S,T)=\space::linear_map_add<K,F,V,source,W,target>(S,T)
    release thm space::linear_map_space_add(K,F,V,source,W,target,S,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,a K,T fn(v V) W:
        T $in \space::linear_map_carrier<K,F,V,source,W,target>
        =>:
            \space::linear_map_space<K,F,V,source,W,target>.smul(a,T)=\space::linear_map_smul<K,F,V,source,W,target>(a,T)
    release thm space::linear_map_space_smul(K,F,V,source,W,target,a,T)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>:
        \space::linear_map_space<K,F,V,source,W,target>.zero=\Algebra::vector_space::zero_map<V,W,target.zero>
    release thm space::linear_map_space_zero(K,F,V,source,W,target)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,a K,T,result fn(v V) W,x V:
        T $in \space::linear_map_carrier<K,F,V,source,W,target>
        result=\space::linear_map_smul<K,F,V,source,W,target>(a,T)
        =>:
            result(x)=target.smul(a,T(x))
    release thm space::linear_map_smul_pointwise(K,F,V,source,W,target,a,T,result,x)

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,source &Algebra::vector_space::VectorSpace<K,F,V>,W nonempty_set,target &Algebra::vector_space::VectorSpace<K,F,W>,S,T,result fn(v V) W,x V:
