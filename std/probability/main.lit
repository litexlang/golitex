struct FiniteProbabilitySpace<Ambient set>:
    carrier power_set(Ambient)
    prob fn(E power_set(carrier)) R
    <=>:
        $is_finite_set(carrier)
        $is_nonempty_set(carrier)
        prob({}) = 0
        prob(carrier) = 1
        forall E power_set(carrier):
            prob(E) >= 0
        forall E, F power_set(carrier):
            intersect(E, F) = {}
            =>:
                prob(union(E, F)) = prob(E) + prob(F)

forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
    space.prob(A) $in R
    space.prob(A) $in C
    space.prob(intersect(A,B)) $in R
    space.prob(intersect(A,B)) $in C
    space.prob(set_minus(A,B)) $in R
    space.prob(set_minus(A,B)) $in C
    space.prob(union(A,B)) $in R
    space.prob(union(A,B)) $in C

thm event_partition:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        space.prob(A) = space.prob(intersect(A,B)) + space.prob(set_minus(A,B))
    by extension:
        ? intersect(intersect(A,B),set_minus(A,B)) = {}
        claim:
            ? forall x intersect(intersect(A,B),set_minus(A,B)):
                x $in {}
            by contra:
                ? x $in {}
                x $in intersect(A,B)
                x $in set_minus(A,B)
                x $in B
                impossible x $in B
    by extension:
        ? union(intersect(A,B),set_minus(A,B)) = A
        claim:
            ? forall x union(intersect(A,B),set_minus(A,B)):
                x $in A
            x $in intersect(A,B) or x $in set_minus(A,B)
            by cases:
                ? x $in A
                case x $in intersect(A,B):
                    x $in A
                case x $in set_minus(A,B):
                    x $in A
        claim:
            ? forall x A:
                x $in union(intersect(A,B),set_minus(A,B))
            by cases:
                ? x $in union(intersect(A,B),set_minus(A,B))
                case x $in B:
                    x $in intersect(A,B)
                case not x $in B:
                    x $in set_minus(A,B)
    intersect(A,B) $in power_set(space.carrier)
    set_minus(A,B) $in power_set(space.carrier)
    space.prob(union(intersect(A,B),set_minus(A,B))) = space.prob(intersect(A,B)) + space.prob(set_minus(A,B))

thm event_complement:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A power_set(space.carrier):
        space.prob(set_minus(space.carrier,A)) = 1 - space.prob(A)
    space.carrier $in power_set(space.carrier)
    by thm event_partition(Ambient,space,space.carrier,A) => space.prob(space.carrier) = space.prob(intersect(space.carrier,A)) + space.prob(set_minus(space.carrier,A))
    by extension intersect(space.carrier,A) = A
    space.prob(set_minus(space.carrier,A)) = space.prob(space.carrier) - space.prob(intersect(space.carrier,A)) = 1 - space.prob(A)

thm event_difference:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        B $subset A
        =>:
            space.prob(set_minus(A,B)) = space.prob(A) - space.prob(B)
    by thm event_partition(Ambient,space,A,B) => space.prob(A) = space.prob(intersect(A,B)) + space.prob(set_minus(A,B))
    by extension intersect(A,B) = B
    space.prob(set_minus(A,B)) = space.prob(A) - space.prob(intersect(A,B)) = space.prob(A) - space.prob(B)

thm event_monotone:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        A $subset B
        =>:
            space.prob(A) <= space.prob(B)
    release thm event_difference(Omega, space, B, A)
    set_minus(B,A) $in power_set(space.carrier)
    space.prob(set_minus(B, A)) >= 0
    space.prob(B) - space.prob(A) >= 0
    space.prob(A) <= space.prob(B)

thm event_bounds:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A power_set(space.carrier):
        0 <= space.prob(A)
        space.prob(A) <= 1
    A $subset space.carrier
    release thm event_monotone(Omega, space, A, space.carrier)
    space.prob(space.carrier) = 1

thm event_inclusion_exclusion:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        space.prob(union(A,B)) = space.prob(A) + space.prob(B) - space.prob(intersect(A,B))
    union(A,B) $in power_set(space.carrier)
    by thm event_partition(Ambient,space,union(A,B),B) => space.prob(union(A,B)) = space.prob(intersect(union(A,B),B)) + space.prob(set_minus(union(A,B),B))
    by extension intersect(union(A,B),B) = B
    by extension:
        ? set_minus(union(A,B),B) = set_minus(A,B)
        claim:
            ? forall x set_minus(union(A,B),B):
                x $in set_minus(A,B)
            x $in union(A,B)
            not x $in B
            x $in A or x $in B
            by cases:
                ? x $in set_minus(A,B)
                case x $in A:
                    x $in set_minus(A,B)
                case x $in B:
                    impossible x $in B
        claim:
            ? forall x set_minus(A,B):
                x $in set_minus(union(A,B),B)
            x $in A
            not x $in B
            x $in union(A,B)
    space.prob(intersect(union(A,B),B)) = space.prob(B)
    space.prob(set_minus(union(A,B),B)) = space.prob(set_minus(A,B))
    by thm event_partition(Ambient,space,A,B) => space.prob(A) = space.prob(intersect(A,B)) + space.prob(set_minus(A,B))
    space.prob(set_minus(A,B)) = space.prob(A) - space.prob(intersect(A,B))
    space.prob(union(A,B)) = space.prob(B) + space.prob(set_minus(A,B))
    space.prob(B) + space.prob(set_minus(A,B)) = space.prob(B) + (space.prob(A) - space.prob(intersect(A,B)))
    space.prob(B) + (space.prob(A) - space.prob(intersect(A,B))) = space.prob(A) + space.prob(B) - space.prob(intersect(A,B))

thm null_event_subsets:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        A $subset B
        space.prob(B) = 0
        =>:
            space.prob(A) = 0
    release thm event_monotone(Omega, space, A, B)
    space.prob(A) <= 0
    space.prob(A) >= 0

template<Ambient set, space &FiniteProbabilitySpace<Ambient>>:
    have fn conditional_event_probability(A, B power_set(space.carrier): space.prob(B) > 0) R = space.prob(intersect(A, B)) / space.prob(B)

thm conditional_event_bounds:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        space.prob(B) > 0
        =>:
            0 <= \conditional_event_probability<Omega, space>(A, B)
            \conditional_event_probability<Omega, space>(A, B) <= 1
    intersect(A, B) $subset B
    intersect(A,B) $in power_set(space.carrier)
    release thm event_monotone(Omega, space, intersect(A, B), B)
    space.prob(intersect(A, B)) >= 0
    0 <= space.prob(intersect(A, B)) / space.prob(B)
    space.prob(intersect(A, B)) / space.prob(B) <= space.prob(B) / space.prob(B) = 1
    \conditional_event_probability<Omega, space>(A, B) = space.prob(intersect(A, B)) / space.prob(B)

thm conditional_event_product:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Ambient,space>(A,B) * space.prob(B) = space.prob(intersect(A,B))
    \conditional_event_probability<Ambient,space>(A,B) = space.prob(intersect(A,B)) / space.prob(B)
    \conditional_event_probability<Ambient,space>(A,B) * space.prob(B) = (space.prob(intersect(A,B)) / space.prob(B)) * space.prob(B)
    (space.prob(intersect(A,B)) / space.prob(B)) * space.prob(B) = space.prob(intersect(A,B))

thm conditional_event_self:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, B power_set(space.carrier):
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Omega, space>(B, B) = 1
    intersect(B, B) = B
    \conditional_event_probability<Omega, space>(B, B) = space.prob(intersect(B, B)) / space.prob(B) = space.prob(B) / space.prob(B) = 1

thm conditional_event_empty:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, B power_set(space.carrier):
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Ambient,space>({},B) = 0
    {} $in power_set(space.carrier)
    intersect({},B) $in power_set(space.carrier)
    \conditional_event_probability<Ambient,space>({},B) = space.prob(intersect({},B)) / space.prob(B)
    intersect({},B) = {}
    space.prob(intersect({},B)) = space.prob({}) = 0
    space.prob(intersect({},B)) / space.prob(B) = 0 / space.prob(B) = 0

thm conditional_event_whole:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, B power_set(space.carrier):
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Omega, space>(space.carrier, B) = 1
    intersect(space.carrier, B) = B
    \conditional_event_probability<Omega, space>(space.carrier, B) = space.prob(B) / space.prob(B) = 1

thm conditional_event_complement:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Ambient,space>(set_minus(space.carrier,A),B) = 1 - \conditional_event_probability<Ambient,space>(A,B)
    set_minus(space.carrier,A) $in power_set(space.carrier)
    set_minus(B,A) $in power_set(space.carrier)
    by thm event_partition(Ambient,space,B,A) => space.prob(B) = space.prob(intersect(B,A)) + space.prob(set_minus(B,A))
    intersect(B,A) = intersect(A,B)
    space.prob(intersect(B,A)) = space.prob(intersect(A,B))
    space.prob(set_minus(B,A)) = space.prob(B) - space.prob(intersect(B,A))
    space.prob(B) - space.prob(intersect(B,A)) = space.prob(B) - space.prob(intersect(A,B))
    by extension:
        ? intersect(set_minus(space.carrier,A),B) = set_minus(B,A)
        claim:
            ? forall x intersect(set_minus(space.carrier,A),B):
                x $in set_minus(B,A)
            x $in set_minus(space.carrier,A)
            x $in B
            not x $in A
        claim:
            ? forall x set_minus(B,A):
                x $in intersect(set_minus(space.carrier,A),B)
            x $in B
            not x $in A
            B $subset space.carrier
            x $in space.carrier
            x $in set_minus(space.carrier,A)
    \conditional_event_probability<Ambient,space>(set_minus(space.carrier,A),B) = space.prob(intersect(set_minus(space.carrier,A),B)) / space.prob(B)
    space.prob(intersect(set_minus(space.carrier,A),B)) = space.prob(set_minus(B,A))
    space.prob(set_minus(B,A)) / space.prob(B) = (space.prob(B) - space.prob(intersect(A,B))) / space.prob(B) = 1 - space.prob(intersect(A,B)) / space.prob(B)
    \conditional_event_probability<Ambient,space>(A,B) = space.prob(intersect(A,B)) / space.prob(B)
    \conditional_event_probability<Ambient,space>(set_minus(space.carrier,A),B) = space.prob(set_minus(B,A)) / space.prob(B)
    \conditional_event_probability<Ambient,space>(set_minus(space.carrier,A),B) = 1 - space.prob(intersect(A,B)) / space.prob(B)
    1 - space.prob(intersect(A,B)) / space.prob(B) = 1 - \conditional_event_probability<Ambient,space>(A,B)

forall X finite_set:
    $is_nonempty_set(X)
    =>:
        finite_set_size(X) >= 1
        finite_set_size(X) != 0

template<Omega finite_set: $is_nonempty_set(Omega)>:
    have fn uniform_event_probability(E power_set(Omega)) R = finite_set_size(E) / finite_set_size(Omega)

thm bayes_event_rule:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        space.prob(A) > 0
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Omega, space>(A, B) = \conditional_event_probability<Omega, space>(B, A) * space.prob(A) / space.prob(B)
    intersect(A, B) = intersect(B, A)
    space.prob(intersect(A,B)) = space.prob(intersect(B,A))
    release thm conditional_event_product(Omega, space, B, A)
    \conditional_event_probability<Omega, space>(A, B) = space.prob(intersect(A, B)) / space.prob(B) = space.prob(intersect(B, A)) / space.prob(B) = \conditional_event_probability<Omega, space>(B, A) * space.prob(A) / space.prob(B)

prop independent_events(Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier)):
    space.prob(intersect(A, B)) = space.prob(A) * space.prob(B)

thm independent_events_symmetric:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        $independent_events(Omega, space, A, B)
        =>:
            $independent_events(Omega, space, B, A)
    intersect(B, A) = intersect(A, B)
    space.prob(intersect(B,A)) = space.prob(intersect(A,B))
    space.prob(intersect(B, A)) = space.prob(A) * space.prob(B) = space.prob(B) * space.prob(A)

thm independence_implies_conditional:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        $independent_events(Omega, space, A, B)
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Omega, space>(A, B) = space.prob(A)

thm conditional_implies_independence:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        space.prob(B) > 0
        \conditional_event_probability<Omega, space>(A, B) = space.prob(A)
        =>:
            $independent_events(Omega, space, A, B)
    release thm conditional_event_product(Omega, space, A, B)
    space.prob(intersect(A, B)) = \conditional_event_probability<Omega, space>(A, B) * space.prob(B) = space.prob(A) * space.prob(B)

thm event_operations_are_events:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        intersect(A,B) $in power_set(space.carrier)
        set_minus(A,B) $in power_set(space.carrier)
        union(A,B) $in power_set(space.carrier)

thm event_probability_types:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A, B power_set(space.carrier):
        space.prob(A) $in R
        space.prob(A) $in C
        space.prob(intersect(A,B)) $in R
        space.prob(intersect(A,B)) $in C
        space.prob(set_minus(A,B)) $in R
        space.prob(set_minus(A,B)) $in C
        space.prob(union(A,B)) $in R
        space.prob(union(A,B)) $in C

thm uniform_event_normalization:
    ? forall Omega finite_set:
        $is_nonempty_set(Omega)
        =>:
            \uniform_event_probability<Omega>({}) = 0
            \uniform_event_probability<Omega>(Omega) = 1
    finite_set_size(Omega) >= 1
    \uniform_event_probability<Omega>({}) = finite_set_size({}) / finite_set_size(Omega) = 0
    \uniform_event_probability<Omega>(Omega) = finite_set_size(Omega) / finite_set_size(Omega) = 1

thm uniform_event_nonnegative:
    ? forall Omega finite_set, E power_set(Omega):
        $is_nonempty_set(Omega)
        =>:
            \uniform_event_probability<Omega>(E) >= 0
    $is_finite_set(E)
    \uniform_event_probability<Omega>(E) = finite_set_size(E) / finite_set_size(Omega)
    finite_set_size(E) >= 0
    finite_set_size(Omega) >= 1
    finite_set_size(E) / finite_set_size(Omega) >= 0

thm uniform_disjoint_additivity:
    ? forall Omega finite_set, E, F power_set(Omega):
        $is_nonempty_set(Omega)
        intersect(E,F) = {}
        =>:
            \uniform_event_probability<Omega>(union(E,F)) = \uniform_event_probability<Omega>(E) + \uniform_event_probability<Omega>(F)
    finite_set_size(Omega) >= 1
    $is_finite_set(E)
    $is_finite_set(F)
    finite_set_size(intersect(E,F)) = finite_set_size({}) = 0
    finite_set_size(union(E,F)) = finite_set_size(E) + finite_set_size(F) - finite_set_size(intersect(E,F)) = finite_set_size(E) + finite_set_size(F)
    \uniform_event_probability<Omega>(E) = finite_set_size(E) / finite_set_size(Omega)
    \uniform_event_probability<Omega>(F) = finite_set_size(F) / finite_set_size(Omega)
    \uniform_event_probability<Omega>(union(E,F)) = finite_set_size(union(E,F)) / finite_set_size(Omega) = (finite_set_size(E) + finite_set_size(F)) / finite_set_size(Omega) = finite_set_size(E) / finite_set_size(Omega) + finite_set_size(F) / finite_set_size(Omega) = \uniform_event_probability<Omega>(E) + \uniform_event_probability<Omega>(F)

thm event_union_bound:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        space.prob(union(A, B)) <= space.prob(A) + space.prob(B)
    release thm event_inclusion_exclusion(Omega, space, A, B)
    space.prob(intersect(A, B)) >= 0
    space.prob(A) + space.prob(B) - space.prob(intersect(A, B)) <= space.prob(A) + space.prob(B)

thm independence_complement:
    ? forall Ambient set, space &FiniteProbabilitySpace<Ambient>, A,B power_set(space.carrier):
        $independent_events(Ambient,space,A,B)
        =>:
            $independent_events(Ambient,space,set_minus(space.carrier,A),B)
    set_minus(space.carrier,A) $in power_set(space.carrier)
    by thm event_partition(Ambient,space,B,A) => space.prob(B) = space.prob(intersect(B,A)) + space.prob(set_minus(B,A))
    by thm event_complement(Ambient,space,A) => space.prob(set_minus(space.carrier,A)) = 1 - space.prob(A)
    by extension:
        ? intersect(set_minus(space.carrier,A),B) = set_minus(B,A)
        claim:
            ? forall x intersect(set_minus(space.carrier,A),B):
                x $in set_minus(B,A)
            x $in set_minus(space.carrier,A)
            x $in B
            not x $in A
        claim:
            ? forall x set_minus(B,A):
                x $in intersect(set_minus(space.carrier,A),B)
            x $in B
            not x $in A
            B $subset space.carrier
            x $in space.carrier
            x $in set_minus(space.carrier,A)
    space.prob(intersect(set_minus(space.carrier,A),B)) = space.prob(set_minus(B,A))
    space.prob(set_minus(B,A)) = space.prob(B) - space.prob(intersect(B,A))
    intersect(B,A) = intersect(A,B)
    space.prob(intersect(B,A)) = space.prob(intersect(A,B))
    space.prob(intersect(A,B)) = space.prob(A) * space.prob(B)
    space.prob(B) - space.prob(intersect(B,A)) = space.prob(B) - space.prob(intersect(A,B)) = space.prob(B) - space.prob(A) * space.prob(B)
    space.prob(B) - space.prob(A) * space.prob(B) = (1 - space.prob(A)) * space.prob(B)
    (1 - space.prob(A)) * space.prob(B) = space.prob(set_minus(space.carrier,A)) * space.prob(B)
    by def $independent_events(Ambient,space,set_minus(space.carrier,A),B)

thm uniform_probability_laws:
    ? forall Omega finite_set:
        $is_nonempty_set(Omega)
        =>:
            (Omega, \uniform_event_probability<Omega>) $in &FiniteProbabilitySpace<Omega>
    release thm uniform_event_normalization(Omega)
    claim:
        ? forall E power_set(Omega):
            \uniform_event_probability<Omega>(E) >= 0
        release thm uniform_event_nonnegative(Omega,E)
    claim:
        ? forall E,F power_set(Omega):
            intersect(E,F) = {}
            =>:
                \uniform_event_probability<Omega>(union(E,F)) = \uniform_event_probability<Omega>(E) + \uniform_event_probability<Omega>(F)
        release thm uniform_disjoint_additivity(Omega,E,F)
    Omega $in power_set(Omega)
    \uniform_event_probability<Omega> $in fn(E power_set(Omega)) R
    release thm struct_member((Omega,\uniform_event_probability<Omega>), &FiniteProbabilitySpace<Omega>)

template<Omega finite_set: $is_nonempty_set(Omega)>:
    have uniform_probability_space &FiniteProbabilitySpace<Omega> = (Omega, \uniform_event_probability<Omega>)

template<Omega finite_set, point Omega>:
    have fn dirac_event_probability(E power_set(Omega)) R = finite_set_size(intersect(E, {point}))

thm dirac_event_contains:
    ? forall Omega finite_set, point Omega, E power_set(Omega):
        point $in E
        =>:
            \dirac_event_probability<Omega,point>(E) = 1
    by extension intersect(E,{point}) = {point}
    \dirac_event_probability<Omega,point>(E) = finite_set_size(intersect(E,{point})) = finite_set_size({point}) = 1

thm dirac_event_excludes:
    ? forall Omega finite_set, point Omega, E power_set(Omega):
        not point $in E
        =>:
            \dirac_event_probability<Omega,point>(E) = 0
    by extension:
        ? intersect(E,{point}) = {}
        claim:
            ? forall x intersect(E,{point}):
                x $in {}
            by contra:
                ? x $in {}
                x $in E
                x $in {point}
                x = point
                point $in E
                impossible point $in E
    \dirac_event_probability<Omega,point>(E) = finite_set_size(intersect(E,{point})) = finite_set_size({}) = 0

thm dirac_probability_laws:
    ? forall Omega finite_set, point Omega:
        (Omega,\dirac_event_probability<Omega,point>) $in &FiniteProbabilitySpace<Omega>
    witness $is_nonempty_set(Omega) from point
    release thm dirac_event_excludes(Omega,point,{})
    release thm dirac_event_contains(Omega,point,Omega)
    claim:
        ? forall E power_set(Omega):
            \dirac_event_probability<Omega,point>(E) >= 0
        \dirac_event_probability<Omega,point>(E) = finite_set_size(intersect(E,{point}))
        $is_finite_set(intersect(E,{point}))
        finite_set_size(intersect(E,{point})) >= 0
    claim:
        ? forall E,F power_set(Omega):
            intersect(E,F) = {}
            =>:
                \dirac_event_probability<Omega,point>(union(E,F)) = \dirac_event_probability<Omega,point>(E) + \dirac_event_probability<Omega,point>(F)
        by cases:
            ? \dirac_event_probability<Omega,point>(union(E,F)) = \dirac_event_probability<Omega,point>(E) + \dirac_event_probability<Omega,point>(F)
            case point $in E:
                by contra:
                    ? not point $in F
                    point $in intersect(E,F)
                    point $in {}
                    impossible point $in {}
                point $in union(E,F)
                release thm dirac_event_contains(Omega,point,E)
                release thm dirac_event_excludes(Omega,point,F)
                release thm dirac_event_contains(Omega,point,union(E,F))
            case not point $in E:
                by cases:
                    ? \dirac_event_probability<Omega,point>(union(E,F)) = \dirac_event_probability<Omega,point>(E) + \dirac_event_probability<Omega,point>(F)
                    case point $in F:
                        point $in union(E,F)
                        release thm dirac_event_excludes(Omega,point,E)
                        release thm dirac_event_contains(Omega,point,F)
                        release thm dirac_event_contains(Omega,point,union(E,F))
                    case not point $in F:
                        not point $in union(E,F)
                        release thm dirac_event_excludes(Omega,point,E)
                        release thm dirac_event_excludes(Omega,point,F)
                        release thm dirac_event_excludes(Omega,point,union(E,F))
    Omega $in power_set(Omega)
    \dirac_event_probability<Omega,point> $in fn(E power_set(Omega)) R
    release thm struct_member((Omega,\dirac_event_probability<Omega,point>),&FiniteProbabilitySpace<Omega>)

template<Omega finite_set,point Omega>:
    have dirac_probability_space &FiniteProbabilitySpace<Omega> = (Omega,\dirac_event_probability<Omega,point>)

thm null_event_independent:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A,B power_set(space.carrier):
        space.prob(A) = 0
        =>:
            $independent_events(Omega,space,A,B)
    intersect(A,B) $subset A
    release thm null_event_subsets(Omega,space,intersect(A,B),A)
    space.prob(intersect(A,B)) = 0 = space.prob(A)*space.prob(B)
    by def $independent_events(Omega,space,A,B)

thm independence_complement_right:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A,B power_set(space.carrier):
        $independent_events(Omega,space,A,B)
        =>:
            $independent_events(Omega,space,A,set_minus(space.carrier,B))
    release thm independent_events_symmetric(Omega,space,A,B)
    release thm independence_complement(Omega,space,B,A)
    release thm independent_events_symmetric(Omega,space,set_minus(space.carrier,B),A)

thm independence_complements:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A,B power_set(space.carrier):
        $independent_events(Omega,space,A,B)
        =>:
            $independent_events(Omega,space,set_minus(space.carrier,A),set_minus(space.carrier,B))
    release thm independence_complement(Omega,space,A,B)
    release thm independence_complement_right(Omega,space,set_minus(space.carrier,A),B)

thm conditional_event_monotone:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A,B,E power_set(space.carrier):
        A $subset B
        space.prob(E) > 0
        =>:
            \conditional_event_probability<Omega,space>(A,E) <= \conditional_event_probability<Omega,space>(B,E)
    intersect(A,E) $subset intersect(B,E)
    release thm event_monotone(Omega,space,intersect(A,E),intersect(B,E))
    \conditional_event_probability<Omega,space>(A,E) = space.prob(intersect(A,E))/space.prob(E)
    \conditional_event_probability<Omega,space>(B,E) = space.prob(intersect(B,E))/space.prob(E)
    space.prob(intersect(A,E))/space.prob(E) <= space.prob(intersect(B,E))/space.prob(E)

thm total_probability_two_events:
    ? forall Omega set, space &FiniteProbabilitySpace<Omega>, A, B power_set(space.carrier):
        space.prob(B) > 0
        space.prob(set_minus(space.carrier, B)) > 0
        =>:
            space.prob(A) = \conditional_event_probability<Omega, space>(A, B) * space.prob(B) + \conditional_event_probability<Omega, space>(A, set_minus(space.carrier, B)) * space.prob(set_minus(space.carrier, B))
    release thm event_partition(Omega, space, A, B)
    by extension:
        ? intersect(A,set_minus(space.carrier,B)) = set_minus(A,B)
        claim:
            ? forall x intersect(A,set_minus(space.carrier,B)):
                x $in set_minus(A,B)
            x $in A
            x $in set_minus(space.carrier,B)
            not x $in B
            x $in set_minus(A,B)
        claim:
            ? forall x set_minus(A,B):
                x $in intersect(A,set_minus(space.carrier,B))
            x $in A
            not x $in B
            x $in space.carrier
            x $in set_minus(space.carrier,B)
            x $in intersect(A,set_minus(space.carrier,B))
    release thm conditional_event_product(Omega, space, A, B)
    release thm conditional_event_product(Omega, space, A, set_minus(space.carrier, B))
    space.prob(A) = space.prob(intersect(A, B)) + space.prob(intersect(A, set_minus(space.carrier, B))) = \conditional_event_probability<Omega, space>(A, B) * space.prob(B) + \conditional_event_probability<Omega, space>(A, set_minus(space.carrier, B)) * space.prob(set_minus(space.carrier, B))

thm event_frechet_bounds:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A,B power_set(space.carrier):
        space.prob(A)+space.prob(B)-1 <= space.prob(intersect(A,B))
        space.prob(intersect(A,B)) <= space.prob(A)
        space.prob(intersect(A,B)) <= space.prob(B)
    release thm event_inclusion_exclusion(Omega,space,A,B)
    release thm event_bounds(Omega,space,union(A,B))
    space.prob(A)+space.prob(B)-space.prob(intersect(A,B)) <= 1
    space.prob(A)+space.prob(B) = (space.prob(A)+space.prob(B)-space.prob(intersect(A,B)))+space.prob(intersect(A,B)) = space.prob(union(A,B))+space.prob(intersect(A,B))
    space.prob(A)+space.prob(B)-1 = space.prob(union(A,B))+space.prob(intersect(A,B))-1
    space.prob(union(A,B))+space.prob(intersect(A,B))-1 <= 1+space.prob(intersect(A,B))-1 = space.prob(intersect(A,B))
    intersect(A,B) $subset A
    intersect(A,B) $subset B
    release thm event_monotone(Omega,space,intersect(A,B),A)
    release thm event_monotone(Omega,space,intersect(A,B),B)

thm whole_event_independent:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A power_set(space.carrier):
        $independent_events(Omega,space,A,space.carrier)
        $independent_events(Omega,space,space.carrier,A)
    intersect(A,space.carrier) = A
    space.prob(intersect(A,space.carrier)) = space.prob(A) = space.prob(A)*space.prob(space.carrier)
    by def $independent_events(Omega,space,A,space.carrier)
    release thm independent_events_symmetric(Omega,space,A,space.carrier)

thm conditional_disjoint_events:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,A,B power_set(space.carrier):
        intersect(A,B) = {}
        space.prob(B) > 0
        =>:
            \conditional_event_probability<Omega,space>(A,B) = 0
    \conditional_event_probability<Omega,space>(A,B) = space.prob(intersect(A,B))/space.prob(B) = space.prob({})/space.prob(B) = 0

template<Ambient set,space &FiniteProbabilitySpace<Ambient>>:
    have fn finite_expectation(X fn(outcome space.carrier) R) R = finite_set_sum(space.carrier,fn(outcome space.carrier) R {X(outcome)*space.prob({outcome})})

thm finite_expectation_formula:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})})

thm finite_expectation_extensional:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        forall k space.carrier:
            X(k) = Y(k)
        =>:
            \finite_expectation<Omega,space>(X) = \finite_expectation<Omega,space>(Y)
    claim:
        ? forall k space.carrier:
            X(k)*space.prob({k}) = Y(k)*space.prob({k})
        X(k) = Y(k)
        X(k)*space.prob({k}) = Y(k)*space.prob({k})
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}),finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})}))
    finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) = finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})})
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) = finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})}) = \finite_expectation<Omega,space>(Y)

thm finite_expectation_nonnegative:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        forall k space.carrier:
            X(k) >= 0
        =>:
            \finite_expectation<Omega,space>(X) >= 0
    claim:
        ? forall k space.carrier:
            0 <= X(k)*space.prob({k})
        X(k) >= 0
        space.prob({k}) >= 0
        0 <= X(k)*space.prob({k})
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(space.carrier,fn(k space.carrier) R {0}),finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}))
    finite_set_sum(space.carrier,fn(k space.carrier) R {0}) = finite_set_size(space.carrier)*0 = 0
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})})
    0 <= finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})})
    \finite_expectation<Omega,space>(X) >= 0

thm finite_expectation_monotone:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        forall k space.carrier:
            X(k) <= Y(k)
        =>:
            \finite_expectation<Omega,space>(X) <= \finite_expectation<Omega,space>(Y)
    claim:
        ? forall k space.carrier:
            X(k)*space.prob({k}) <= Y(k)*space.prob({k})
        X(k) <= Y(k)
        space.prob({k}) >= 0
        X(k)*space.prob({k}) <= Y(k)*space.prob({k})
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}),finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})}))
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})})
    \finite_expectation<Omega,space>(Y) = finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})})
    finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) <= finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})})
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) <= finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})}) = \finite_expectation<Omega,space>(Y)

thm finite_expectation_vanishes:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        forall k space.carrier:
            X(k) = 0
        =>:
            \finite_expectation<Omega,space>(X) = 0
    claim:
        ? forall k space.carrier:
            X(k)*space.prob({k}) = 0
        X(k) = 0
        X(k)*space.prob({k}) = 0*space.prob({k}) = 0
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}),finite_set_sum(space.carrier,fn(k space.carrier) R {0}))
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) = finite_set_sum(space.carrier,fn(k space.carrier) R {0}) = finite_set_size(space.carrier)*0 = 0

thm finite_expectation_zero:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {0}) = 0
    release thm finite_expectation_vanishes(Omega,space,fn(k space.carrier) R {0})

thm event_probability_from_singletons:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,E power_set(space.carrier):
        finite_set_sum(E,fn(k space.carrier) R {space.prob({k})}) = space.prob(E)
    have fn weight(k space.carrier) R = space.prob({k})
    prop singletons_at_size(n N):
        forall A power_set(space.carrier):
            finite_set_size(A) = n
            =>:
                finite_set_sum(A,weight) = space.prob(A)
    by induc n from 0:
        ? $singletons_at_size(n)
        ? from n = 0:
            claim:
                ? forall A power_set(space.carrier):
                    finite_set_size(A) = 0
                    =>:
                        finite_set_sum(A,weight) = space.prob(A)
                A = {}
                finite_set_sum(A,weight) = finite_set_sum({},weight) = 0 = space.prob({}) = space.prob(A)
            by def $singletons_at_size(0)
        ? induc:
            n $in N
            claim:
                ? forall A power_set(space.carrier):
                    finite_set_size(A) = n+1
                    =>:
                        finite_set_sum(A,weight) = space.prob(A)
                by contra:
                    ? $is_nonempty_set(A)
                    A = {}
                    finite_set_size(A) = finite_set_size({}) = 0
                    finite_set_size(A) = 0 < n+1
                    impossible finite_set_size(A) = n+1
                $is_finite_set(A)
                have a A
                have rest finite_set = set_minus(A,{a})
                rest $subset A
                A $subset space.carrier
                rest $subset space.carrier
                rest $in power_set(space.carrier)
                a $in space.carrier
                {a} $in power_set(space.carrier)
                {a} $subset A
                intersect(A,{a}) = {a}
                finite_set_size(rest) = finite_set_size(set_minus(A,{a})) = finite_set_size(A)-finite_set_size(intersect(A,{a})) = (n+1)-finite_set_size({a}) = n
                finite_set_sum(rest,weight) = space.prob(rest)
                by extension:
                    ? intersect(rest,{a}) = {}
                    claim:
                        ? forall x intersect(rest,{a}):
                            x $in {}
                        by contra:
                            ? x $in {}
                            x $in rest
                            x $in {a}
                            x $in set_minus(A,{a})
                            not x $in {a}
                            impossible x $in {a}
                union(rest,{a}) = union({a},rest) = union({a},set_minus(A,{a})) = union({a},A) = A
                space.prob(union(rest,{a})) = space.prob(rest)+space.prob({a})
                finite_set_sum(union(rest,{a}),weight) = finite_set_sum(rest,weight)+finite_set_sum({a},weight)
                finite_set_sum({a},weight) = weight(a) = space.prob({a})
                finite_set_sum(A,weight) = finite_set_sum(union(rest,{a}),weight) = finite_set_sum(rest,weight)+finite_set_sum({a},weight) = space.prob(rest)+space.prob({a}) = space.prob(union(rest,{a})) = space.prob(A)
            by def $singletons_at_size(n+1)
    $is_finite_set(E)
    finite_set_size(E) $in N
    $singletons_at_size(finite_set_size(E))
    finite_set_sum(E,weight) = space.prob(E)
    release thm finite_set_sum_substitution(finite_set_sum(E,fn(k space.carrier) R {space.prob({k})}),finite_set_sum(E,weight))
    finite_set_sum(E,fn(k space.carrier) R {space.prob({k})}) = finite_set_sum(E,weight) = space.prob(E)

thm finite_expectation_of_constant:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,c R:
        forall k space.carrier:
            X(k) = c
        =>:
            \finite_expectation<Omega,space>(X) = c
    claim:
        ? forall k space.carrier:
            X(k)*space.prob({k}) = c*space.prob({k})
        X(k) = c
        X(k)*space.prob({k}) = c*space.prob({k})
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}),finite_set_sum(space.carrier,fn(k space.carrier) R {c*space.prob({k})}))
    have fn weight(k space.carrier) C = space.prob({k})
    thm complex_finite_sum_scale:
        ? forall T finite_set,a C,F fn(k T) C:
            finite_set_sum(T,fn(k T) C {a*F(k)}) = a*finite_set_sum(T,F)
    release thm complex_finite_sum_scale(space.carrier,c,weight)
    claim:
        ? forall k space.carrier:
            c*space.prob({k}) = c*weight(k)
        space.prob({k}) $in C
        weight(k) = space.prob({k})
        c*space.prob({k}) = c*weight(k)
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,fn(k space.carrier) R {c*space.prob({k})}),finite_set_sum(space.carrier,fn(k space.carrier) C {c*weight(k)}))
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,weight),finite_set_sum(space.carrier,fn(k space.carrier) R {space.prob({k})}))
    finite_set_sum(space.carrier,fn(k space.carrier) R {c*space.prob({k})}) = finite_set_sum(space.carrier,fn(k space.carrier) C {c*weight(k)}) = c*finite_set_sum(space.carrier,weight) = c*finite_set_sum(space.carrier,fn(k space.carrier) R {space.prob({k})})
    release thm event_probability_from_singletons(Omega,space,space.carrier)
    finite_set_sum(space.carrier,fn(k space.carrier) R {space.prob({k})}) = space.prob(space.carrier) = 1
    finite_set_sum(space.carrier,fn(k space.carrier) R {space.prob({k})}) = 1
    c $in C
    finite_set_sum(space.carrier,fn(k space.carrier) R {space.prob({k})}) $in C
    finite_set_sum(space.carrier,weight) = finite_set_sum(space.carrier,fn(k space.carrier) R {space.prob({k})}) = 1
    finite_set_sum(space.carrier,weight) = 1
    c*finite_set_sum(space.carrier,weight) = c*1 = c
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) = finite_set_sum(space.carrier,fn(k space.carrier) R {c*space.prob({k})}) = finite_set_sum(space.carrier,fn(k space.carrier) C {c*weight(k)}) = c*finite_set_sum(space.carrier,weight) = c

thm finite_expectation_constant:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,c R:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {c}) = c
    release thm finite_expectation_of_constant(Omega,space,fn(k space.carrier) R {c},c)

thm finite_expectation_bounds:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,a,b R:
        forall k space.carrier:
            a <= X(k)
            X(k) <= b
        =>:
            a <= \finite_expectation<Omega,space>(X)
            \finite_expectation<Omega,space>(X) <= b
    have fn lower(k space.carrier) R = a
    have fn upper(k space.carrier) R = b
    claim:
        ? forall k space.carrier:
            lower(k) <= X(k)
        a <= X(k)
        lower(k) = a
        lower(k) <= X(k)
    claim:
        ? forall k space.carrier:
            X(k) <= upper(k)
        X(k) <= b
        upper(k) = b
        X(k) <= upper(k)
    release thm finite_expectation_of_constant(Omega,space,lower,a)
    release thm finite_expectation_of_constant(Omega,space,upper,b)
    release thm finite_expectation_monotone(Omega,space,lower,X)
    release thm finite_expectation_monotone(Omega,space,X,upper)
    a = \finite_expectation<Omega,space>(lower) <= \finite_expectation<Omega,space>(X)
    \finite_expectation<Omega,space>(X) <= \finite_expectation<Omega,space>(upper) = b

thm finite_expectation_of_linear_combination:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y,H fn(k space.carrier) R,a,b R:
        forall k space.carrier:
            H(k) = a*X(k)+b*Y(k)
        =>:
            \finite_expectation<Omega,space>(H) = a*\finite_expectation<Omega,space>(X)+b*\finite_expectation<Omega,space>(Y)
    have fn wx(k space.carrier) C = X(k)*space.prob({k})
    have fn wy(k space.carrier) C = Y(k)*space.prob({k})
    have fn wz(k space.carrier) C = H(k)*space.prob({k})
    have fn ax(k space.carrier) C = a*wx(k)
    have fn ay(k space.carrier) C = b*wy(k)
    thm complex_sum_add:
        ? forall T finite_set,F,G fn(k T) C:
            finite_set_sum(T,fn(k T) C {F(k)+G(k)}) = finite_set_sum(T,F)+finite_set_sum(T,G)
    thm complex_sum_scale:
        ? forall T finite_set,F fn(k T) C,c C:
            finite_set_sum(T,fn(k T) C {c*F(k)}) = c*finite_set_sum(T,F)
    claim:
        ? forall k space.carrier:
            wz(k) = a*wx(k)+b*wy(k)
        H(k) = a*X(k)+b*Y(k)
        space.prob({k}) $in C
        wz(k) = H(k)*space.prob({k}) = (a*X(k)+b*Y(k))*space.prob({k})
        (a*X(k)+b*Y(k))*space.prob({k}) = a*(X(k)*space.prob({k}))+b*(Y(k)*space.prob({k}))
        wx(k) = X(k)*space.prob({k})
        wy(k) = Y(k)*space.prob({k})
        a*(X(k)*space.prob({k}))+b*(Y(k)*space.prob({k})) = a*wx(k)+b*wy(k)
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,wz),finite_set_sum(space.carrier,fn(k space.carrier) C {a*wx(k)+b*wy(k)}))
    release thm complex_sum_add(space.carrier,ax,ay)
    release thm complex_sum_scale(space.carrier,wx,a)
    release thm complex_sum_scale(space.carrier,wy,b)
    claim:
        ? forall k space.carrier:
            a*wx(k)+b*wy(k) = ax(k)+ay(k)
        ax(k) = a*wx(k)
        ay(k) = b*wy(k)
        a*wx(k)+b*wy(k) = ax(k)+ay(k)
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,fn(k space.carrier) C {a*wx(k)+b*wy(k)}),finite_set_sum(space.carrier,fn(k space.carrier) C {ax(k)+ay(k)}))
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,ax),finite_set_sum(space.carrier,fn(k space.carrier) C {a*wx(k)}))
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,ay),finite_set_sum(space.carrier,fn(k space.carrier) C {b*wy(k)}))
    finite_set_sum(space.carrier,ax) = finite_set_sum(space.carrier,fn(k space.carrier) C {a*wx(k)}) = a*finite_set_sum(space.carrier,wx)
    finite_set_sum(space.carrier,ay) = finite_set_sum(space.carrier,fn(k space.carrier) C {b*wy(k)}) = b*finite_set_sum(space.carrier,wy)
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,wx),finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}))
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,wy),finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})}))
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,wz),finite_set_sum(space.carrier,fn(k space.carrier) R {H(k)*space.prob({k})}))
    finite_set_sum(space.carrier,wx) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) = \finite_expectation<Omega,space>(X)
    finite_set_sum(space.carrier,wy) = finite_set_sum(space.carrier,fn(k space.carrier) R {Y(k)*space.prob({k})}) = \finite_expectation<Omega,space>(Y)
    finite_set_sum(space.carrier,wx) = \finite_expectation<Omega,space>(X)
    finite_set_sum(space.carrier,wy) = \finite_expectation<Omega,space>(Y)
    finite_set_sum(space.carrier,fn(k space.carrier) C {a*wx(k)+b*wy(k)}) = finite_set_sum(space.carrier,fn(k space.carrier) C {ax(k)+ay(k)}) = finite_set_sum(space.carrier,ax)+finite_set_sum(space.carrier,ay) = a*finite_set_sum(space.carrier,wx)+b*finite_set_sum(space.carrier,wy)
    \finite_expectation<Omega,space>(H) = finite_set_sum(space.carrier,fn(k space.carrier) R {H(k)*space.prob({k})}) = finite_set_sum(space.carrier,wz) = finite_set_sum(space.carrier,fn(k space.carrier) C {a*wx(k)+b*wy(k)}) = a*finite_set_sum(space.carrier,wx)+b*finite_set_sum(space.carrier,wy) = a*\finite_expectation<Omega,space>(X)+b*\finite_expectation<Omega,space>(Y)

thm finite_expectation_linear:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R,a,b R:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {a*X(k)+b*Y(k)}) = a*\finite_expectation<Omega,space>(X)+b*\finite_expectation<Omega,space>(Y)
    release thm finite_expectation_of_linear_combination(Omega,space,X,Y,fn(k space.carrier) R {a*X(k)+b*Y(k)},a,b)

thm finite_expectation_add:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = \finite_expectation<Omega,space>(X)+\finite_expectation<Omega,space>(Y)
    release thm finite_expectation_of_linear_combination(Omega,space,X,Y,fn(k space.carrier) R {X(k)+Y(k)},1,1)
    \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = 1*\finite_expectation<Omega,space>(X)+1*\finite_expectation<Omega,space>(Y) = \finite_expectation<Omega,space>(X)+\finite_expectation<Omega,space>(Y)

thm finite_expectation_scale:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,c R:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {c*X(k)}) = c*\finite_expectation<Omega,space>(X)
    release thm finite_expectation_of_linear_combination(Omega,space,X,X,fn(k space.carrier) R {c*X(k)},c,0)
    \finite_expectation<Omega,space>(fn(k space.carrier) R {c*X(k)}) = c*\finite_expectation<Omega,space>(X)+0*\finite_expectation<Omega,space>(X) = c*\finite_expectation<Omega,space>(X)

thm finite_expectation_subtract:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}) = \finite_expectation<Omega,space>(X)-\finite_expectation<Omega,space>(Y)
    release thm finite_expectation_of_linear_combination(Omega,space,X,Y,fn(k space.carrier) R {X(k)-Y(k)},1,-1)
    \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}) = 1*\finite_expectation<Omega,space>(X)+(-1)*\finite_expectation<Omega,space>(Y) = \finite_expectation<Omega,space>(X)-\finite_expectation<Omega,space>(Y)

thm finite_expectation_affine:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,a,c R:
        \finite_expectation<Omega,space>(fn(k space.carrier) R {a*X(k)+c}) = a*\finite_expectation<Omega,space>(X)+c
    have fn constant(k space.carrier) R = c
    release thm finite_expectation_of_constant(Omega,space,constant,c)
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {a*X(t)+c})(k) = a*X(k)+1*constant(k)
        constant(k) = c
        (fn(t space.carrier) R {a*X(t)+c})(k) = a*X(k)+c
        a*X(k)+c = a*X(k)+1*constant(k)
    release thm finite_expectation_of_linear_combination(Omega,space,X,constant,fn(k space.carrier) R {a*X(k)+c},a,1)
    \finite_expectation<Omega,space>(fn(k space.carrier) R {a*X(k)+c}) = a*\finite_expectation<Omega,space>(X)+1*\finite_expectation<Omega,space>(constant) = a*\finite_expectation<Omega,space>(X)+\finite_expectation<Omega,space>(constant) = a*\finite_expectation<Omega,space>(X)+c

template<Ambient set,space &FiniteProbabilitySpace<Ambient>>:
    have fn finite_variance(X fn(k space.carrier) R) R = \finite_expectation<Ambient,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Ambient,space>(X))^2})

thm finite_variance_nonnegative:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        \finite_variance<Omega,space>(X) >= 0
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k) >= 0
        (X(k)-\finite_expectation<Omega,space>(X)) $in R
        (X(k)-\finite_expectation<Omega,space>(X))^2 >= 0
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k) = (X(k)-\finite_expectation<Omega,space>(X))^2
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k) >= 0
    release thm finite_expectation_nonnegative(Omega,space,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})
    0 <= \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2}) = \finite_variance<Omega,space>(X)

thm finite_variance_of_constant:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,c R:
        forall k space.carrier:
            X(k) = c
        =>:
            \finite_variance<Omega,space>(X) = 0
    release thm finite_expectation_of_constant(Omega,space,X,c)
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k) = 0
        X(k) = c
        \finite_expectation<Omega,space>(X) = c
        X(k)-\finite_expectation<Omega,space>(X) = c-c = 0
        (X(k)-\finite_expectation<Omega,space>(X))^2 = 0^2 = 0
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k) = (X(k)-\finite_expectation<Omega,space>(X))^2 = 0
    release thm finite_expectation_vanishes(Omega,space,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})
    \finite_variance<Omega,space>(X) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2}) = 0

thm finite_variance_constant:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,c R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {c}) = 0
    release thm finite_variance_of_constant(Omega,space,fn(k space.carrier) R {c},c)

thm finite_variance_second_moment:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        \finite_variance<Omega,space>(X) = \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2})-\finite_expectation<Omega,space>(X)^2
    have fn square(k space.carrier) R = X(k)^2
    have fn polynomial(k space.carrier) R = X(k)^2-2*\finite_expectation<Omega,space>(X)*X(k)
    have fn constant(k space.carrier) R = \finite_expectation<Omega,space>(X)^2
    have fn centered(k space.carrier) R = (X(k)-\finite_expectation<Omega,space>(X))^2
    claim:
        ? forall k space.carrier:
            polynomial(k) = 1*square(k)+(-2*\finite_expectation<Omega,space>(X))*X(k)
        square(k) = X(k)^2
        polynomial(k) = X(k)^2-2*\finite_expectation<Omega,space>(X)*X(k)
        X(k)^2-2*\finite_expectation<Omega,space>(X)*X(k) = 1*square(k)+(-2*\finite_expectation<Omega,space>(X))*X(k)
    release thm finite_expectation_of_linear_combination(Omega,space,square,X,polynomial,1,-2*\finite_expectation<Omega,space>(X))
    claim:
        ? forall k space.carrier:
            centered(k) = 1*polynomial(k)+1*constant(k)
        polynomial(k) = X(k)^2-2*\finite_expectation<Omega,space>(X)*X(k)
        constant(k) = \finite_expectation<Omega,space>(X)^2
        centered(k) = (X(k)-\finite_expectation<Omega,space>(X))^2
        (X(k)-\finite_expectation<Omega,space>(X))^2 = X(k)^2-2*\finite_expectation<Omega,space>(X)*X(k)+\finite_expectation<Omega,space>(X)^2
        X(k)^2-2*\finite_expectation<Omega,space>(X)*X(k)+\finite_expectation<Omega,space>(X)^2 = 1*polynomial(k)+1*constant(k)
    release thm finite_expectation_of_linear_combination(Omega,space,polynomial,constant,centered,1,1)
    release thm finite_expectation_of_constant(Omega,space,constant,\finite_expectation<Omega,space>(X)^2)
    \finite_expectation<Omega,space>(polynomial) = 1*\finite_expectation<Omega,space>(square)+(-2*\finite_expectation<Omega,space>(X))*\finite_expectation<Omega,space>(X) = \finite_expectation<Omega,space>(square)-2*\finite_expectation<Omega,space>(X)^2
    \finite_expectation<Omega,space>(centered) = 1*\finite_expectation<Omega,space>(polynomial)+1*\finite_expectation<Omega,space>(constant) = \finite_expectation<Omega,space>(polynomial)+\finite_expectation<Omega,space>(constant) = (\finite_expectation<Omega,space>(square)-2*\finite_expectation<Omega,space>(X)^2)+\finite_expectation<Omega,space>(X)^2 = \finite_expectation<Omega,space>(square)-\finite_expectation<Omega,space>(X)^2
    release thm finite_expectation_extensional(Omega,space,centered,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})
    release thm finite_expectation_extensional(Omega,space,square,fn(k space.carrier) R {X(k)^2})
    \finite_expectation<Omega,space>(square) = \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2})
    \finite_expectation<Omega,space>(square) $in C
    \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2}) $in C
    \finite_expectation<Omega,space>(X)^2 $in C
    thm subtract_equal_values:
        ? forall u,v,w C:
            u = v
            =>:
                u-w = v-w
    release thm subtract_equal_values(\finite_expectation<Omega,space>(square),\finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2}),\finite_expectation<Omega,space>(X)^2)
    \finite_variance<Omega,space>(X) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2}) = \finite_expectation<Omega,space>(centered) = \finite_expectation<Omega,space>(square)-\finite_expectation<Omega,space>(X)^2 = \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2})-\finite_expectation<Omega,space>(X)^2

thm finite_expectation_square_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        \finite_expectation<Omega,space>(X)^2 <= \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2})
    release thm finite_variance_nonnegative(Omega,space,X)
    release thm finite_variance_second_moment(Omega,space,X)
    thm nonnegative_difference_bound:
        ? forall u,v,w R:
            w = u-v
            w >= 0
            =>:
                v <= u
        u-v >= 0
        v <= u
    release thm nonnegative_difference_bound(\finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)^2}),\finite_expectation<Omega,space>(X)^2,\finite_variance<Omega,space>(X))

thm finite_variance_formula:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        \finite_variance<Omega,space>(X) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})

thm finite_variance_of_affine:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R,a,c R:
        forall k space.carrier:
            Y(k) = a*X(k)+c
        =>:
            \finite_variance<Omega,space>(Y) = a^2*\finite_variance<Omega,space>(X)
    have fn constant(k space.carrier) R = c
    claim:
        ? forall k space.carrier:
            Y(k) = a*X(k)+1*constant(k)
        Y(k) = a*X(k)+c
        constant(k) = c
        a*X(k)+c = a*X(k)+1*constant(k)
    release thm finite_expectation_of_constant(Omega,space,constant,c)
    release thm finite_expectation_of_linear_combination(Omega,space,X,constant,Y,a,1)
    \finite_expectation<Omega,space>(Y) = a*\finite_expectation<Omega,space>(X)+1*\finite_expectation<Omega,space>(constant) = a*\finite_expectation<Omega,space>(X)+\finite_expectation<Omega,space>(constant) = a*\finite_expectation<Omega,space>(X)+c
    have fn cx(k space.carrier) R = (X(k)-\finite_expectation<Omega,space>(X))^2
    have fn cy(k space.carrier) R = (Y(k)-\finite_expectation<Omega,space>(Y))^2
    claim:
        ? forall k space.carrier:
            cy(k) = a^2*cx(k)+0*cx(k)
        Y(k) = a*X(k)+c
        \finite_expectation<Omega,space>(Y) = a*\finite_expectation<Omega,space>(X)+c
        Y(k)-\finite_expectation<Omega,space>(Y) = (a*X(k)+c)-(a*\finite_expectation<Omega,space>(X)+c) = a*(X(k)-\finite_expectation<Omega,space>(X))
        cx(k) = (X(k)-\finite_expectation<Omega,space>(X))^2
        cy(k) = (Y(k)-\finite_expectation<Omega,space>(Y))^2 = (a*(X(k)-\finite_expectation<Omega,space>(X)))^2 = a^2*(X(k)-\finite_expectation<Omega,space>(X))^2 = a^2*cx(k) = a^2*cx(k)+0*cx(k)
    release thm finite_expectation_of_linear_combination(Omega,space,cx,cx,cy,a^2,0)
    \finite_expectation<Omega,space>(cy) = a^2*\finite_expectation<Omega,space>(cx)+0*\finite_expectation<Omega,space>(cx) = a^2*\finite_expectation<Omega,space>(cx)
    release thm finite_expectation_extensional(Omega,space,cx,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})
    release thm finite_expectation_extensional(Omega,space,cy,fn(k space.carrier) R {(Y(k)-\finite_expectation<Omega,space>(Y))^2})
    \finite_variance<Omega,space>(X) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2}) = \finite_expectation<Omega,space>(cx)
    \finite_variance<Omega,space>(Y) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(Y(k)-\finite_expectation<Omega,space>(Y))^2}) = \finite_expectation<Omega,space>(cy)
    thm scaled_equal_values:
        ? forall v,w,p,q,t R:
            v = p
            w = q
            q = t*p
            =>:
                w = t*v
        w = q = t*p = t*v
    release thm scaled_equal_values(\finite_variance<Omega,space>(X),\finite_variance<Omega,space>(Y),\finite_expectation<Omega,space>(cx),\finite_expectation<Omega,space>(cy),a^2)

thm finite_variance_affine:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,a,c R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {a*X(k)+c}) = a^2*\finite_variance<Omega,space>(X)
    release thm finite_variance_of_affine(Omega,space,X,fn(k space.carrier) R {a*X(k)+c},a,c)

thm finite_variance_scale:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,a R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {a*X(k)}) = a^2*\finite_variance<Omega,space>(X)
    release thm finite_variance_of_affine(Omega,space,X,fn(k space.carrier) R {a*X(k)},a,0)

thm finite_variance_translate:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,c R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+c}) = \finite_variance<Omega,space>(X)
    release thm finite_variance_of_affine(Omega,space,X,fn(k space.carrier) R {X(k)+c},1,c)
    \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+c}) = 1^2*\finite_variance<Omega,space>(X) = \finite_variance<Omega,space>(X)

template<Ambient set,space &FiniteProbabilitySpace<Ambient>>:
    have fn finite_covariance(X,Y fn(k space.carrier) R) R = \finite_expectation<Ambient,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Ambient,space>(X))*(Y(k)-\finite_expectation<Ambient,space>(Y))})

thm finite_covariance_formula:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_covariance<Omega,space>(X,Y) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))})

thm finite_covariance_symmetric:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_covariance<Omega,space>(X,Y) = \finite_covariance<Omega,space>(Y,X)
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(Y(t)-\finite_expectation<Omega,space>(Y))})(k) = (fn(t space.carrier) R {(Y(t)-\finite_expectation<Omega,space>(Y))*(X(t)-\finite_expectation<Omega,space>(X))})(k)
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(Y(t)-\finite_expectation<Omega,space>(Y))})(k) = (X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))
        (X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y)) = (Y(k)-\finite_expectation<Omega,space>(Y))*(X(k)-\finite_expectation<Omega,space>(X))
        (fn(t space.carrier) R {(Y(t)-\finite_expectation<Omega,space>(Y))*(X(t)-\finite_expectation<Omega,space>(X))})(k) = (Y(k)-\finite_expectation<Omega,space>(Y))*(X(k)-\finite_expectation<Omega,space>(X))
    release thm finite_expectation_extensional(Omega,space,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))},fn(k space.carrier) R {(Y(k)-\finite_expectation<Omega,space>(Y))*(X(k)-\finite_expectation<Omega,space>(X))})
    \finite_covariance<Omega,space>(X,Y) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))}) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(Y(k)-\finite_expectation<Omega,space>(Y))*(X(k)-\finite_expectation<Omega,space>(X))}) = \finite_covariance<Omega,space>(Y,X)

thm finite_covariance_self:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R:
        \finite_covariance<Omega,space>(X,X) = \finite_variance<Omega,space>(X)
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(X(t)-\finite_expectation<Omega,space>(X))})(k) = (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k)
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(X(t)-\finite_expectation<Omega,space>(X))})(k) = (X(k)-\finite_expectation<Omega,space>(X))*(X(k)-\finite_expectation<Omega,space>(X)) = (X(k)-\finite_expectation<Omega,space>(X))^2
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))^2})(k) = (X(k)-\finite_expectation<Omega,space>(X))^2
    release thm finite_expectation_extensional(Omega,space,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(X(k)-\finite_expectation<Omega,space>(X))},fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})
    \finite_covariance<Omega,space>(X,X) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(X(k)-\finite_expectation<Omega,space>(X))}) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2}) = \finite_variance<Omega,space>(X)

thm finite_covariance_of_constant_left:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R,c R:
        forall k space.carrier:
            X(k) = c
        =>:
            \finite_covariance<Omega,space>(X,Y) = 0
    release thm finite_expectation_of_constant(Omega,space,X,c)
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(Y(t)-\finite_expectation<Omega,space>(Y))})(k) = 0
        X(k) = c
        \finite_expectation<Omega,space>(X) = c
        X(k)-\finite_expectation<Omega,space>(X) = c-c = 0
        (X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y)) = 0*(Y(k)-\finite_expectation<Omega,space>(Y)) = 0
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(Y(t)-\finite_expectation<Omega,space>(Y))})(k) = (X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y)) = 0
    release thm finite_expectation_vanishes(Omega,space,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))})
    \finite_covariance<Omega,space>(X,Y) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))}) = 0

thm finite_covariance_constant_left:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,Y fn(k space.carrier) R,c R:
        \finite_covariance<Omega,space>(fn(k space.carrier) R {c},Y) = 0
    release thm finite_covariance_of_constant_left(Omega,space,fn(k space.carrier) R {c},Y,c)

thm finite_covariance_constant_right:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,c R:
        \finite_covariance<Omega,space>(X,fn(k space.carrier) R {c}) = 0
    release thm finite_covariance_symmetric(Omega,space,X,fn(k space.carrier) R {c})
    release thm finite_covariance_constant_left(Omega,space,X,c)
    \finite_covariance<Omega,space>(X,fn(k space.carrier) R {c}) = \finite_covariance<Omega,space>(fn(k space.carrier) R {c},X) = 0

thm finite_covariance_product_moment:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_covariance<Omega,space>(X,Y) = \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)*Y(k)})-\finite_expectation<Omega,space>(X)*\finite_expectation<Omega,space>(Y)
    have ex R = \finite_expectation<Omega,space>(X)
    have ey R = \finite_expectation<Omega,space>(Y)
    have fn paired(k space.carrier) R = X(k)*Y(k)
    have fn linear(k space.carrier) R = (-ey)*X(k)+(-ex)*Y(k)
    have fn polynomial(k space.carrier) R = paired(k)+linear(k)
    have fn constant(k space.carrier) R = ex*ey
    have fn centered(k space.carrier) R = (X(k)-ex)*(Y(k)-ey)
    claim:
        ? forall k space.carrier:
            linear(k) = (-ey)*X(k)+(-ex)*Y(k)
            polynomial(k) = 1*paired(k)+1*linear(k)
            centered(k) = 1*polynomial(k)+1*constant(k)
        paired(k) = X(k)*Y(k)
        linear(k) = (-ey)*X(k)+(-ex)*Y(k)
        polynomial(k) = paired(k)+linear(k) = 1*paired(k)+1*linear(k)
        centered(k) = (X(k)-ex)*(Y(k)-ey)
        (X(k)-ex)*(Y(k)-ey) = X(k)*Y(k)+((-ey)*X(k)+(-ex)*Y(k))+ex*ey
        X(k)*Y(k)+((-ey)*X(k)+(-ex)*Y(k))+ex*ey = polynomial(k)+constant(k) = 1*polynomial(k)+1*constant(k)
    release thm finite_expectation_of_linear_combination(Omega,space,X,Y,linear,-ey,-ex)
    release thm finite_expectation_of_linear_combination(Omega,space,paired,linear,polynomial,1,1)
    release thm finite_expectation_of_linear_combination(Omega,space,polynomial,constant,centered,1,1)
    release thm finite_expectation_of_constant(Omega,space,constant,ex*ey)
    \finite_expectation<Omega,space>(linear) = (-ey)*\finite_expectation<Omega,space>(X)+(-ex)*\finite_expectation<Omega,space>(Y) = (-ey)*ex+(-ex)*ey = -2*ex*ey
    \finite_expectation<Omega,space>(polynomial) = 1*\finite_expectation<Omega,space>(paired)+1*\finite_expectation<Omega,space>(linear) = \finite_expectation<Omega,space>(paired)+\finite_expectation<Omega,space>(linear) = \finite_expectation<Omega,space>(paired)+(-2*ex*ey) = \finite_expectation<Omega,space>(paired)-2*ex*ey
    \finite_expectation<Omega,space>(centered) = 1*\finite_expectation<Omega,space>(polynomial)+1*\finite_expectation<Omega,space>(constant) = \finite_expectation<Omega,space>(polynomial)+\finite_expectation<Omega,space>(constant) = (\finite_expectation<Omega,space>(paired)-2*ex*ey)+ex*ey = \finite_expectation<Omega,space>(paired)-ex*ey
    claim:
        ? forall k space.carrier:
            centered(k) = (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(Y(t)-\finite_expectation<Omega,space>(Y))})(k)
        centered(k) = (X(k)-ex)*(Y(k)-ey) = (X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))
        (fn(t space.carrier) R {(X(t)-\finite_expectation<Omega,space>(X))*(Y(t)-\finite_expectation<Omega,space>(Y))})(k) = (X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))
    release thm finite_expectation_extensional(Omega,space,centered,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))})
    release thm finite_expectation_extensional(Omega,space,paired,fn(k space.carrier) R {X(k)*Y(k)})
    \finite_covariance<Omega,space>(X,Y) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(Y(k)-\finite_expectation<Omega,space>(Y))}) = \finite_expectation<Omega,space>(centered) = \finite_expectation<Omega,space>(paired)-ex*ey
    \finite_expectation<Omega,space>(paired) = \finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)*Y(k)})
    ex*ey = \finite_expectation<Omega,space>(X)*\finite_expectation<Omega,space>(Y)
    thm subtract_equal_values:
        ? forall v,w,s,t R:
            v = w
            s = t
            =>:
                v-s = w-t
        v-s = w-s = w-t
    release thm subtract_equal_values(\finite_expectation<Omega,space>(paired),\finite_expectation<Omega,space>(fn(k space.carrier) R {X(k)*Y(k)}),ex*ey,\finite_expectation<Omega,space>(X)*\finite_expectation<Omega,space>(Y))

thm finite_covariance_of_linear_combination_left:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y,W,H fn(k space.carrier) R,a,b R:
        forall k space.carrier:
            H(k) = a*X(k)+b*Y(k)
        =>:
            \finite_covariance<Omega,space>(H,W) = a*\finite_covariance<Omega,space>(X,W)+b*\finite_covariance<Omega,space>(Y,W)
    release thm finite_expectation_of_linear_combination(Omega,space,X,Y,H,a,b)
    have fn cx(k space.carrier) R = (X(k)-\finite_expectation<Omega,space>(X))*(W(k)-\finite_expectation<Omega,space>(W))
    have fn cy(k space.carrier) R = (Y(k)-\finite_expectation<Omega,space>(Y))*(W(k)-\finite_expectation<Omega,space>(W))
    have fn ch(k space.carrier) R = (H(k)-\finite_expectation<Omega,space>(H))*(W(k)-\finite_expectation<Omega,space>(W))
    claim:
        ? forall k space.carrier:
            ch(k) = a*cx(k)+b*cy(k)
        H(k) = a*X(k)+b*Y(k)
        \finite_expectation<Omega,space>(H) = a*\finite_expectation<Omega,space>(X)+b*\finite_expectation<Omega,space>(Y)
        H(k)-\finite_expectation<Omega,space>(H) = (a*X(k)+b*Y(k))-(a*\finite_expectation<Omega,space>(X)+b*\finite_expectation<Omega,space>(Y)) = a*(X(k)-\finite_expectation<Omega,space>(X))+b*(Y(k)-\finite_expectation<Omega,space>(Y))
        cx(k) = (X(k)-\finite_expectation<Omega,space>(X))*(W(k)-\finite_expectation<Omega,space>(W))
        cy(k) = (Y(k)-\finite_expectation<Omega,space>(Y))*(W(k)-\finite_expectation<Omega,space>(W))
        ch(k) = (H(k)-\finite_expectation<Omega,space>(H))*(W(k)-\finite_expectation<Omega,space>(W))
        (H(k)-\finite_expectation<Omega,space>(H))*(W(k)-\finite_expectation<Omega,space>(W)) = (a*(X(k)-\finite_expectation<Omega,space>(X))+b*(Y(k)-\finite_expectation<Omega,space>(Y)))*(W(k)-\finite_expectation<Omega,space>(W))
        (a*(X(k)-\finite_expectation<Omega,space>(X))+b*(Y(k)-\finite_expectation<Omega,space>(Y)))*(W(k)-\finite_expectation<Omega,space>(W)) = a*cx(k)+b*cy(k)
    release thm finite_expectation_of_linear_combination(Omega,space,cx,cy,ch,a,b)
    release thm finite_expectation_extensional(Omega,space,cx,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(W(k)-\finite_expectation<Omega,space>(W))})
    release thm finite_expectation_extensional(Omega,space,cy,fn(k space.carrier) R {(Y(k)-\finite_expectation<Omega,space>(Y))*(W(k)-\finite_expectation<Omega,space>(W))})
    release thm finite_expectation_extensional(Omega,space,ch,fn(k space.carrier) R {(H(k)-\finite_expectation<Omega,space>(H))*(W(k)-\finite_expectation<Omega,space>(W))})
    \finite_covariance<Omega,space>(X,W) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))*(W(k)-\finite_expectation<Omega,space>(W))}) = \finite_expectation<Omega,space>(cx)
    \finite_covariance<Omega,space>(Y,W) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(Y(k)-\finite_expectation<Omega,space>(Y))*(W(k)-\finite_expectation<Omega,space>(W))}) = \finite_expectation<Omega,space>(cy)
    \finite_covariance<Omega,space>(H,W) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(H(k)-\finite_expectation<Omega,space>(H))*(W(k)-\finite_expectation<Omega,space>(W))}) = \finite_expectation<Omega,space>(ch) = a*\finite_expectation<Omega,space>(cx)+b*\finite_expectation<Omega,space>(cy)
    a*\finite_expectation<Omega,space>(cx)+b*\finite_expectation<Omega,space>(cy) = a*\finite_covariance<Omega,space>(X,W)+b*\finite_covariance<Omega,space>(Y,W)

thm finite_covariance_linear_combination_left:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y,W fn(k space.carrier) R,a,b R:
        \finite_covariance<Omega,space>(fn(k space.carrier) R {a*X(k)+b*Y(k)},W) = a*\finite_covariance<Omega,space>(X,W)+b*\finite_covariance<Omega,space>(Y,W)
    release thm finite_covariance_of_linear_combination_left(Omega,space,X,Y,W,fn(k space.carrier) R {a*X(k)+b*Y(k)},a,b)

thm finite_covariance_of_linear_combination_right:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y,W,H fn(k space.carrier) R,a,b R:
        forall k space.carrier:
            H(k) = a*Y(k)+b*W(k)
        =>:
            \finite_covariance<Omega,space>(X,H) = a*\finite_covariance<Omega,space>(X,Y)+b*\finite_covariance<Omega,space>(X,W)
    release thm finite_covariance_of_linear_combination_left(Omega,space,Y,W,X,H,a,b)
    release thm finite_covariance_symmetric(Omega,space,X,H)
    release thm finite_covariance_symmetric(Omega,space,X,Y)
    release thm finite_covariance_symmetric(Omega,space,X,W)
    \finite_covariance<Omega,space>(X,H) = \finite_covariance<Omega,space>(H,X) = a*\finite_covariance<Omega,space>(Y,X)+b*\finite_covariance<Omega,space>(W,X) = a*\finite_covariance<Omega,space>(X,Y)+b*\finite_covariance<Omega,space>(X,W)

thm finite_covariance_linear_combination_right:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y,W fn(k space.carrier) R,a,b R:
        \finite_covariance<Omega,space>(X,fn(k space.carrier) R {a*Y(k)+b*W(k)}) = a*\finite_covariance<Omega,space>(X,Y)+b*\finite_covariance<Omega,space>(X,W)
    release thm finite_covariance_of_linear_combination_right(Omega,space,X,Y,W,fn(k space.carrier) R {a*Y(k)+b*W(k)},a,b)

thm finite_variance_of_linear_combination:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y,H fn(k space.carrier) R,a,b R:
        forall k space.carrier:
            H(k) = a*X(k)+b*Y(k)
        =>:
            \finite_variance<Omega,space>(H) = a^2*\finite_variance<Omega,space>(X)+2*a*b*\finite_covariance<Omega,space>(X,Y)+b^2*\finite_variance<Omega,space>(Y)
    release thm finite_covariance_of_linear_combination_left(Omega,space,X,Y,H,H,a,b)
    release thm finite_covariance_of_linear_combination_right(Omega,space,X,X,Y,H,a,b)
    release thm finite_covariance_of_linear_combination_right(Omega,space,Y,X,Y,H,a,b)
    release thm finite_covariance_symmetric(Omega,space,X,Y)
    release thm finite_covariance_self(Omega,space,X)
    release thm finite_covariance_self(Omega,space,Y)
    release thm finite_covariance_self(Omega,space,H)
    \finite_covariance<Omega,space>(X,H) = a*\finite_covariance<Omega,space>(X,X)+b*\finite_covariance<Omega,space>(X,Y) = a*\finite_variance<Omega,space>(X)+b*\finite_covariance<Omega,space>(X,Y)
    \finite_covariance<Omega,space>(Y,H) = a*\finite_covariance<Omega,space>(Y,X)+b*\finite_covariance<Omega,space>(Y,Y) = a*\finite_covariance<Omega,space>(X,Y)+b*\finite_variance<Omega,space>(Y)
    \finite_variance<Omega,space>(H) = \finite_covariance<Omega,space>(H,H) = a*\finite_covariance<Omega,space>(X,H)+b*\finite_covariance<Omega,space>(Y,H)
    a*\finite_covariance<Omega,space>(X,H)+b*\finite_covariance<Omega,space>(Y,H) = a*(a*\finite_variance<Omega,space>(X)+b*\finite_covariance<Omega,space>(X,Y))+b*(a*\finite_covariance<Omega,space>(X,Y)+b*\finite_variance<Omega,space>(Y))
    a*(a*\finite_variance<Omega,space>(X)+b*\finite_covariance<Omega,space>(X,Y))+b*(a*\finite_covariance<Omega,space>(X,Y)+b*\finite_variance<Omega,space>(Y)) = a^2*\finite_variance<Omega,space>(X)+2*a*b*\finite_covariance<Omega,space>(X,Y)+b^2*\finite_variance<Omega,space>(Y)

thm finite_variance_linear_combination:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R,a,b R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {a*X(k)+b*Y(k)}) = a^2*\finite_variance<Omega,space>(X)+2*a*b*\finite_covariance<Omega,space>(X,Y)+b^2*\finite_variance<Omega,space>(Y)
    release thm finite_variance_of_linear_combination(Omega,space,X,Y,fn(k space.carrier) R {a*X(k)+b*Y(k)},a,b)

thm finite_variance_add:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = \finite_variance<Omega,space>(X)+2*\finite_covariance<Omega,space>(X,Y)+\finite_variance<Omega,space>(Y)
    release thm finite_variance_of_linear_combination(Omega,space,X,Y,fn(k space.carrier) R {X(k)+Y(k)},1,1)
    \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = 1^2*\finite_variance<Omega,space>(X)+2*1*1*\finite_covariance<Omega,space>(X,Y)+1^2*\finite_variance<Omega,space>(Y) = \finite_variance<Omega,space>(X)+2*\finite_covariance<Omega,space>(X,Y)+\finite_variance<Omega,space>(Y)

thm finite_variance_subtract:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}) = \finite_variance<Omega,space>(X)-2*\finite_covariance<Omega,space>(X,Y)+\finite_variance<Omega,space>(Y)
    release thm finite_variance_of_linear_combination(Omega,space,X,Y,fn(k space.carrier) R {X(k)-Y(k)},1,-1)
    \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}) = 1^2*\finite_variance<Omega,space>(X)+2*1*(-1)*\finite_covariance<Omega,space>(X,Y)+(-1)^2*\finite_variance<Omega,space>(Y) = \finite_variance<Omega,space>(X)-2*\finite_covariance<Omega,space>(X,Y)+\finite_variance<Omega,space>(Y)

thm finite_variance_add_uncorrelated:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_covariance<Omega,space>(X,Y) = 0
        =>:
            \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = \finite_variance<Omega,space>(X)+\finite_variance<Omega,space>(Y)
    release thm finite_variance_add(Omega,space,X,Y)
    \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) = \finite_variance<Omega,space>(X)+2*\finite_covariance<Omega,space>(X,Y)+\finite_variance<Omega,space>(Y) = \finite_variance<Omega,space>(X)+2*0+\finite_variance<Omega,space>(Y) = \finite_variance<Omega,space>(X)+\finite_variance<Omega,space>(Y)

thm finite_covariance_affine:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R,a,b,c,d R:
        \finite_covariance<Omega,space>(fn(k space.carrier) R {a*X(k)+b},fn(k space.carrier) R {c*Y(k)+d}) = a*c*\finite_covariance<Omega,space>(X,Y)
    have fn one(k space.carrier) R = 1
    claim:
        ? forall k space.carrier:
            (fn(t space.carrier) R {a*X(t)+b})(k) = a*X(k)+b*one(k)
            (fn(t space.carrier) R {c*Y(t)+d})(k) = c*Y(k)+d*one(k)
        one(k) = 1
        (fn(t space.carrier) R {a*X(t)+b})(k) = a*X(k)+b = a*X(k)+b*one(k)
        (fn(t space.carrier) R {c*Y(t)+d})(k) = c*Y(k)+d = c*Y(k)+d*one(k)
    release thm finite_covariance_of_constant_left(Omega,space,one,fn(k space.carrier) R {c*Y(k)+d},1)
    release thm finite_covariance_of_constant_left(Omega,space,one,X,1)
    release thm finite_covariance_symmetric(Omega,space,X,one)
    release thm finite_covariance_of_linear_combination_right(Omega,space,X,Y,one,fn(k space.carrier) R {c*Y(k)+d},c,d)
    release thm finite_covariance_of_linear_combination_left(Omega,space,X,one,fn(k space.carrier) R {c*Y(k)+d},fn(k space.carrier) R {a*X(k)+b},a,b)
    \finite_covariance<Omega,space>(X,one) = \finite_covariance<Omega,space>(one,X) = 0
    \finite_covariance<Omega,space>(X,fn(k space.carrier) R {c*Y(k)+d}) = c*\finite_covariance<Omega,space>(X,Y)+d*\finite_covariance<Omega,space>(X,one) = c*\finite_covariance<Omega,space>(X,Y)+d*0 = c*\finite_covariance<Omega,space>(X,Y)
    thm linear_equal_values:
        ? forall x,y,u,v,p,q R:
            x = u
            y = v
            =>:
                p*x+q*y = p*u+q*v
        p*x+q*y = p*u+q*y = p*u+q*v
    release thm linear_equal_values(\finite_covariance<Omega,space>(X,fn(k space.carrier) R {c*Y(k)+d}),\finite_covariance<Omega,space>(one,fn(k space.carrier) R {c*Y(k)+d}),c*\finite_covariance<Omega,space>(X,Y),0,a,b)
    \finite_covariance<Omega,space>(fn(k space.carrier) R {a*X(k)+b},fn(k space.carrier) R {c*Y(k)+d}) = a*\finite_covariance<Omega,space>(X,fn(k space.carrier) R {c*Y(k)+d})+b*\finite_covariance<Omega,space>(one,fn(k space.carrier) R {c*Y(k)+d}) = a*(c*\finite_covariance<Omega,space>(X,Y))+b*0 = a*c*\finite_covariance<Omega,space>(X,Y)

thm finite_covariance_square_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_covariance<Omega,space>(X,Y)^2 <= \finite_variance<Omega,space>(X)*\finite_variance<Omega,space>(Y)
    thm quadratic_bound_local:
        ? forall a,b,c R:
            a >= 0
            forall t R:
                a*t^2+2*c*t+b >= 0
            =>:
                c^2 <= a*b
        by cases:
            ? c^2 <= a*b
            case a=0:
                claim:
                    ? c=0
                    by contra:
                        ? c=0
                        2*c != 0
                        have u R = -(b+1)/(2*c)
                        a*u^2+2*c*u+b >= 0
                        2*c*u = 2*c*(-(b+1)/(2*c)) = -(b+1)
                        a*u^2+2*c*u+b = 0*u^2+2*c*u+b = 2*c*u+b = -(b+1)+b = -1
                        0 <= a*u^2+2*c*u+b = -1
                        impossible 0<=-1
                c^2 = 0^2 = 0 = a*b
            case a!=0:
                by contra:
                    ? a>0
                    a<=0
                    a=0
                    impossible a!=0
                have u R = -c/a
                a*u^2+2*c*u+b >= 0
                0 <= a*(a*u^2+2*c*u+b)
                a*u = a*(-c/a) = -c
                a*(a*u^2+2*c*u+b) = (a*u)^2+2*c*(a*u)+a*b = (-c)^2+2*c*(-c)+a*b = a*b-c^2
                0 <= a*b-c^2
                c^2 <= a*b
    release thm finite_variance_nonnegative(Omega,space,X)
    claim:
        ? forall t R:
            \finite_variance<Omega,space>(X)*t^2+2*\finite_covariance<Omega,space>(X,Y)*t+\finite_variance<Omega,space>(Y) >= 0
        release thm finite_variance_linear_combination(Omega,space,X,Y,t,1)
        release thm finite_variance_nonnegative(Omega,space,fn(k space.carrier) R {t*X(k)+1*Y(k)})
        0 <= \finite_variance<Omega,space>(fn(k space.carrier) R {t*X(k)+1*Y(k)}) = t^2*\finite_variance<Omega,space>(X)+2*t*1*\finite_covariance<Omega,space>(X,Y)+1^2*\finite_variance<Omega,space>(Y) = \finite_variance<Omega,space>(X)*t^2+2*\finite_covariance<Omega,space>(X,Y)*t+\finite_variance<Omega,space>(Y)
    release thm quadratic_bound_local(\finite_variance<Omega,space>(X),\finite_variance<Omega,space>(Y),\finite_covariance<Omega,space>(X,Y))

thm finite_covariance_zero_variance_left:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(X) = 0
        =>:
            \finite_covariance<Omega,space>(X,Y) = 0
    release thm finite_covariance_square_bound(Omega,space,X,Y)
    0 <= \finite_covariance<Omega,space>(X,Y)^2 <= \finite_variance<Omega,space>(X)*\finite_variance<Omega,space>(Y) = 0*\finite_variance<Omega,space>(Y) = 0
    \finite_covariance<Omega,space>(X,Y)^2 = 0

thm finite_covariance_zero_variance_right:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(Y) = 0
        =>:
            \finite_covariance<Omega,space>(X,Y) = 0
    release thm finite_covariance_zero_variance_left(Omega,space,Y,X)
    release thm finite_covariance_symmetric(Omega,space,X,Y)
    \finite_covariance<Omega,space>(X,Y) = \finite_covariance<Omega,space>(Y,X) = 0

thm finite_variance_parallelogram:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)})+\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}) = 2*\finite_variance<Omega,space>(X)+2*\finite_variance<Omega,space>(Y)
    release thm finite_variance_add(Omega,space,X,Y)
    release thm finite_variance_subtract(Omega,space,X,Y)
    thm complementary_values_sum:
        ? forall p,q,a,b,c R:
            p = a+2*c+b
            q = a-2*c+b
            =>:
                p+q = 2*a+2*b
        p+q = (a+2*c+b)+q = (a+2*c+b)+(a-2*c+b) = 2*a+2*b
    release thm complementary_values_sum(\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}),\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}),\finite_variance<Omega,space>(X),\finite_variance<Omega,space>(Y),\finite_covariance<Omega,space>(X,Y))

thm finite_variance_add_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}) <= 2*\finite_variance<Omega,space>(X)+2*\finite_variance<Omega,space>(Y)
    release thm finite_variance_parallelogram(Omega,space,X,Y)
    release thm finite_variance_nonnegative(Omega,space,fn(k space.carrier) R {X(k)-Y(k)})
    thm nonnegative_complement_bound:
        ? forall u,v,w R:
            u+v = w
            v >= 0
            =>:
                u <= w
        u = u+0 <= u+v = w
    release thm nonnegative_complement_bound(\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}),\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}),2*\finite_variance<Omega,space>(X)+2*\finite_variance<Omega,space>(Y))

thm finite_variance_subtract_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X,Y fn(k space.carrier) R:
        \finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}) <= 2*\finite_variance<Omega,space>(X)+2*\finite_variance<Omega,space>(Y)
    release thm finite_variance_parallelogram(Omega,space,X,Y)
    release thm finite_variance_nonnegative(Omega,space,fn(k space.carrier) R {X(k)+Y(k)})
    thm nonnegative_complement_bound:
        ? forall u,v,w R:
            v+u = w
            v >= 0
            =>:
                u <= w
        u = u+0 <= u+v = v+u = w
    release thm nonnegative_complement_bound(\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)-Y(k)}),\finite_variance<Omega,space>(fn(k space.carrier) R {X(k)+Y(k)}),2*\finite_variance<Omega,space>(X)+2*\finite_variance<Omega,space>(Y))

thm finite_markov_event_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,A power_set(space.carrier),a R+:
        forall k space.carrier:
            X(k) >= 0
        forall k A:
            X(k) >= a
        =>:
            space.prob(A) <= \finite_expectation<Omega,space>(X)/a
    A $subset space.carrier
    have rest finite_set = set_minus(space.carrier,A)
    rest $subset space.carrier
    claim:
        ? forall k A:
            k $in space.carrier
        k $in space.carrier
    claim:
        ? forall k rest:
            k $in space.carrier
        k $in space.carrier
    have fn weight(k space.carrier) R = X(k)*space.prob({k})
    have fn event_weight(k A) R = weight(k)
    have fn rest_weight(k rest) R = weight(k)
    claim:
        ? forall k space.carrier:
            weight(k) >= 0
        X(k) >= 0
        space.prob({k}) >= 0
        weight(k) = X(k)*space.prob({k}) >= 0
    claim:
        ? forall k rest:
            0 <= rest_weight(k)
        k $in space.carrier
        weight(k) >= 0
        rest_weight(k) = weight(k) >= 0
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(rest,fn(k rest) R {0}),finite_set_sum(rest,rest_weight))
    finite_set_sum(rest,fn(k rest) R {0}) = finite_set_size(rest)*0 = 0
    finite_set_sum(rest,rest_weight) >= 0
    by extension:
        ? intersect(A,rest) = {}
        claim:
            ? forall k intersect(A,rest):
                k $in {}
            by contra:
                ? k $in {}
                k $in A
                k $in rest
                k $in set_minus(space.carrier,A)
                not k $in A
                impossible k $in A
    union(A,rest) = union(A,set_minus(space.carrier,A)) = union(A,space.carrier) = space.carrier
    finite_set_sum(union(A,rest),weight) = finite_set_sum(A,fn(k A) R {weight(k)})+finite_set_sum(rest,fn(k rest) R {weight(k)})
    release thm finite_set_sum_substitution(finite_set_sum(A,fn(k A) R {weight(k)}),finite_set_sum(A,event_weight))
    release thm finite_set_sum_substitution(finite_set_sum(rest,fn(k rest) R {weight(k)}),finite_set_sum(rest,rest_weight))
    thm add_equal_values:
        ? forall u,v,p,q C:
            u = p
            v = q
            =>:
                u+v = p+q
        u+v = p+v = p+q
    release thm add_equal_values(finite_set_sum(A,fn(k A) R {weight(k)}),finite_set_sum(rest,fn(k rest) R {weight(k)}),finite_set_sum(A,event_weight),finite_set_sum(rest,rest_weight))
    finite_set_sum(union(A,rest),weight) = finite_set_sum(A,event_weight)+finite_set_sum(rest,rest_weight)
    release thm finite_set_sum_substitution(finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}),finite_set_sum(space.carrier,weight))
    \finite_expectation<Omega,space>(X) = finite_set_sum(space.carrier,fn(k space.carrier) R {X(k)*space.prob({k})}) = finite_set_sum(space.carrier,weight)
    finite_set_sum(A,event_weight)+finite_set_sum(rest,rest_weight) = finite_set_sum(union(A,rest),weight) = finite_set_sum(space.carrier,weight) = \finite_expectation<Omega,space>(X)
    thm nonnegative_complement_bound:
        ? forall u,v,w R:
            u+v = w
            v >= 0
            =>:
                u <= w
        u = u+0 <= u+v = w
    release thm nonnegative_complement_bound(finite_set_sum(A,event_weight),finite_set_sum(rest,rest_weight),\finite_expectation<Omega,space>(X))
    have fn atom(k space.carrier) R = space.prob({k})
    have fn event_atom(k A) R = atom(k)
    have fn lower(k A) R = a*event_atom(k)
    claim:
        ? forall k A:
            lower(k) <= event_weight(k)
        k $in space.carrier
        X(k) >= a
        space.prob({k}) >= 0
        event_atom(k) = atom(k) = space.prob({k})
        lower(k) = a*event_atom(k) = a*space.prob({k})
        event_weight(k) = weight(k) = X(k)*space.prob({k})
        lower(k) = a*space.prob({k}) <= X(k)*space.prob({k}) = event_weight(k)
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(A,lower),finite_set_sum(A,event_weight))
    have fn complex_atom(k A) C = event_atom(k)
    thm complex_finite_sum_scale:
        ? forall T finite_set,c C,F fn(k T) C:
            finite_set_sum(T,fn(k T) C {c*F(k)}) = c*finite_set_sum(T,F)
    release thm complex_finite_sum_scale(A,a,complex_atom)
    claim:
        ? forall k A:
            lower(k) = a*complex_atom(k)
        complex_atom(k) = event_atom(k)
        lower(k) = a*event_atom(k) = a*complex_atom(k)
    release thm finite_set_sum_substitution(finite_set_sum(A,lower),finite_set_sum(A,fn(k A) C {a*complex_atom(k)}))
    finite_set_sum(A,lower) = finite_set_sum(A,fn(k A) C {a*complex_atom(k)}) = a*finite_set_sum(A,complex_atom)
    release thm finite_set_sum_substitution(finite_set_sum(A,complex_atom),finite_set_sum(A,atom))
    release thm finite_set_sum_substitution(finite_set_sum(A,atom),finite_set_sum(A,fn(k space.carrier) R {space.prob({k})}))
    release thm event_probability_from_singletons(Omega,space,A)
    finite_set_sum(A,complex_atom) = finite_set_sum(A,atom) = finite_set_sum(A,fn(k space.carrier) R {space.prob({k})}) = space.prob(A)
    thm scale_equal_values:
        ? forall u,v,c C:
            u = v
            =>:
                c*u = c*v
    release thm scale_equal_values(finite_set_sum(A,complex_atom),space.prob(A),a)
    finite_set_sum(A,lower) = a*finite_set_sum(A,complex_atom) = a*space.prob(A)
    a*space.prob(A) = finite_set_sum(A,lower) <= finite_set_sum(A,event_weight) <= \finite_expectation<Omega,space>(X)
    thm positive_quotient_bound:
        ? forall p,bound_value R,t R+:
            t*p <= bound_value
            =>:
                p <= bound_value/t
        p = (t*p)/t <= bound_value/t
    release thm positive_quotient_bound(space.prob(A),\finite_expectation<Omega,space>(X),a)

thm finite_chebyshev_event_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,A power_set(space.carrier),a R+:
        forall k A:
            abs(X(k)-\finite_expectation<Omega,space>(X)) >= a
        =>:
            space.prob(A) <= \finite_variance<Omega,space>(X)/a^2
    have fn squared(k space.carrier) R = (X(k)-\finite_expectation<Omega,space>(X))^2
    claim:
        ? forall k space.carrier:
            squared(k) >= 0
        (X(k)-\finite_expectation<Omega,space>(X)) $in R
        squared(k) = (X(k)-\finite_expectation<Omega,space>(X))^2 >= 0
    claim:
        ? forall k A:
            squared(k) >= a^2
        k $in space.carrier
        (X(k)-\finite_expectation<Omega,space>(X)) $in R
        abs(X(k)-\finite_expectation<Omega,space>(X)) >= a > 0
        abs(X(k)-\finite_expectation<Omega,space>(X))^2 >= a^2
        (X(k)-\finite_expectation<Omega,space>(X))^2 = abs(X(k)-\finite_expectation<Omega,space>(X))^2
        squared(k) = (X(k)-\finite_expectation<Omega,space>(X))^2 = abs(X(k)-\finite_expectation<Omega,space>(X))^2 >= a^2
    a^2 $in R+
    release thm finite_markov_event_bound(Omega,space,squared,A,a^2)
    release thm finite_variance_formula(Omega,space,X)
    release thm finite_expectation_extensional(Omega,space,squared,fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2})
    \finite_expectation<Omega,space>(squared) = \finite_expectation<Omega,space>(fn(k space.carrier) R {(X(k)-\finite_expectation<Omega,space>(X))^2}) = \finite_variance<Omega,space>(X)
    thm divided_equal_upper:
        ? forall p,u,v R,t R+:
            p <= u/t
            u = v
            =>:
                p <= v/t
        p <= u/t = v/t
    release thm divided_equal_upper(space.prob(A),\finite_expectation<Omega,space>(squared),\finite_variance<Omega,space>(X),a^2)

template<Omega set,space &FiniteProbabilitySpace<Omega>>:
    have fn finite_upper_tail_event(X fn(k space.carrier) R,a R) power_set(space.carrier) = {k space.carrier:X(k)>=a}

template<Omega set,space &FiniteProbabilitySpace<Omega>>:
    have fn finite_deviation_tail_event(X fn(k space.carrier) R,a R) power_set(space.carrier) = {k space.carrier:abs(X(k)-\finite_expectation<Omega,space>(X))>=a}

thm finite_markov_tail_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,a R+:
        forall k space.carrier:
            X(k) >= 0
        =>:
            space.prob(\finite_upper_tail_event<Omega,space>(X,a)) <= \finite_expectation<Omega,space>(X)/a
    have A power_set(space.carrier) = {k space.carrier:X(k)>=a}
    claim:
        ? forall k A:
            X(k) >= a
        k $in {j space.carrier:X(j)>=a}
        X(k) >= a
    \finite_upper_tail_event<Omega,space>(X,a) = {k space.carrier:X(k)>=a} = A
    release thm finite_markov_event_bound(Omega,space,X,A,a)
    space.prob(\finite_upper_tail_event<Omega,space>(X,a)) = space.prob(A) <= \finite_expectation<Omega,space>(X)/a

thm finite_chebyshev_tail_bound:
    ? forall Omega set,space &FiniteProbabilitySpace<Omega>,X fn(k space.carrier) R,a R+:
        space.prob(\finite_deviation_tail_event<Omega,space>(X,a)) <= \finite_variance<Omega,space>(X)/a^2
    have A power_set(space.carrier) = {k space.carrier:abs(X(k)-\finite_expectation<Omega,space>(X))>=a}
    claim:
        ? forall k A:
            abs(X(k)-\finite_expectation<Omega,space>(X)) >= a
        k $in {j space.carrier:abs(X(j)-\finite_expectation<Omega,space>(X))>=a}
        abs(X(k)-\finite_expectation<Omega,space>(X)) >= a
    \finite_deviation_tail_event<Omega,space>(X,a) = {k space.carrier:abs(X(k)-\finite_expectation<Omega,space>(X))>=a} = A
    release thm finite_chebyshev_event_bound(Omega,space,X,A,a)
    space.prob(\finite_deviation_tail_event<Omega,space>(X,a)) = space.prob(A) <= \finite_variance<Omega,space>(X)/a^2
