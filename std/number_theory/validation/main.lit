# Generic theorem consumers and concrete signed/unit-modulus examples.

claim:
    ? forall a Z,m N+:
        exist u,v Z st {gcd(a,m)=a*u+m*v}
    release thm nt::bezout_positive_modulus(a,m)

claim:
    ? forall a,b Z:
        a!=0 or b!=0
        =>:
            exist u,v Z st {gcd(a,b)=a*u+b*v}
    release thm nt::bezout_identity(a,b)

claim:
    ? forall a Z,m N+:
        gcd(a,m)=1
        =>:
            exist u Z st {$nt::is_modular_inverse(a,u,m)}
    release thm nt::coprime_modular_inverse_exists(a,m)

claim:
    ? forall a,b,c Z:
        a!=0 or b!=0
        $dvd(c,gcd(a,b))
        =>:
            exist x,y Z st {a*x+b*y=c}
    release thm nt::linear_equation_from_gcd(a,b,c)

claim:
    ? forall a Z,m,n N+:
        gcd(m,n)=1
        $dvd(a,m)
        $dvd(a,n)
        =>:
            exist k Z st {a=k*m*n}
    release thm nt::coprime_common_multiple(a,m,n)

claim:
    ? forall a,b Z,m,n N+:
        gcd(m,n)=1
        =>:
            exist x Z st {$nt::is_congruent_mod(x,a,m),$nt::is_congruent_mod(x,b,n)}
    release thm nt::chinese_remainder_exists(a,b,m,n)

claim:
    ? forall a,b,x,y Z,m,n N+:
        gcd(m,n)=1
        $nt::is_congruent_mod(x,a,m)
        $nt::is_congruent_mod(x,b,n)
        $nt::is_congruent_mod(y,a,m)
        $nt::is_congruent_mod(y,b,n)
        =>:
            exist k Z st {x-y=k*m*n}
    release thm nt::chinese_remainder_unique(a,b,x,y,m,n)

claim:
    ? forall a,b Z,m,n N+:
        gcd(m,n)=1
        =>:
            exist r N st {r<m*n,$nt::is_congruent_mod(r,a,m),$nt::is_congruent_mod(r,b,n)}
    release thm nt::chinese_remainder_bounded_exists(a,b,m,n)

claim:
    ? forall a,b Z,m,n N+,x,y N:
        gcd(m,n)=1
        x<m*n
        y<m*n
        $nt::is_congruent_mod(x,a,m)
        $nt::is_congruent_mod(x,b,n)
        $nt::is_congruent_mod(y,a,m)
        $nt::is_congruent_mod(y,b,n)
        =>:
            x=y
    release thm nt::chinese_remainder_bounded_unique(a,b,m,n,x,y)

claim:
    ? forall a,b Z,m,n N+:
        gcd(m,n)=1
        =>:
            exist! r N st {r<m*n,$nt::is_congruent_mod(r,a,m),$nt::is_congruent_mod(r,b,n)}
    release thm nt::chinese_remainder_unique_residue(a,b,m,n)

release obj def nt::chinese_remainder_residue

claim:
    ? forall a,b Z,m,n N+,r N:
        gcd(m,n)=1
        r<m*n
        $nt::is_congruent_mod(r,a,m)
        $nt::is_congruent_mod(r,b,n)
        =>:
            nt::chinese_remainder_residue(a,b,m,n)=r
    release thm nt::chinese_remainder_residue_of_solution(a,b,m,n,r)

claim:
    ? forall a,u Z,m N+:
        $nt::is_modular_inverse(a,u,m)
        =>:
            gcd(a,m)=1
    release thm nt::modular_inverse_implies_coprime(a,u,m)

release thm nt::bezout_positive_modulus(-84,30)

release thm nt::bezout_identity(-84,-30)

release thm nt::bezout_identity(0,-7)

release thm nt::bezout_identity(7,0)

release thm nt::bezout_identity(-7,0)

gcd(5,12)=1

release thm nt::coprime_modular_inverse_exists(5,12)

obtain inverse_five from exist u Z st {$nt::is_modular_inverse(5,u,12)}

$nt::is_congruent_mod(5*inverse_five,1,12)

release thm nt::modular_inverse_implies_coprime(5,inverse_five,12)

release thm nt::coprime_modular_inverse_exists(0,1)

by def $nt::is_modular_inverse(0,0,1)

release thm nt::modular_inverse_implies_coprime(0,0,1)

$dvd(18,gcd(84,30))

release thm nt::linear_equation_from_gcd(84,30,18)

obtain left_eighteen,right_eighteen from exist x,y Z st {84*x+30*y=18}

84*left_eighteen+30*right_eighteen=18

release thm nt::linear_equation_from_gcd(-7,0,21)

gcd(3,5)=1

release thm nt::chinese_remainder_exists(2,3,3,5)

by def $nt::is_congruent_mod(8,2,3)

by def $nt::is_congruent_mod(8,3,5)

release thm nt::chinese_remainder_residue_of_solution(2,3,3,5,8)

nt::chinese_remainder_residue(2,3,3,5)=8

0<=nt::chinese_remainder_residue(2,3,3,5)<3*5

$nt::is_congruent_mod(nt::chinese_remainder_residue(2,3,3,5),2,3)

$nt::is_congruent_mod(nt::chinese_remainder_residue(2,3,3,5),3,5)

by def $nt::is_congruent_mod(2,-1,3)

by def $nt::is_congruent_mod(2,2,5)

release thm nt::chinese_remainder_residue_of_solution(-1,2,3,5,2)

nt::chinese_remainder_residue(-1,2,3,5)=2

gcd(1,5)=1

by def $nt::is_congruent_mod(2,111,1)

by def $nt::is_congruent_mod(2,-8,5)

release thm nt::chinese_remainder_residue_of_solution(111,-8,1,5,2)

nt::chinese_remainder_residue(111,-8,1,5)=2

gcd(1,1)=1

by def $nt::is_congruent_mod(0,42,1)

by def $nt::is_congruent_mod(0,-7,1)

release thm nt::chinese_remainder_residue_of_solution(42,-7,1,1,0)

nt::chinese_remainder_residue(42,-7,1,1)=0

by def $nt::is_congruent_mod(23,2,3)

by def $nt::is_congruent_mod(23,3,5)

release thm nt::chinese_remainder_unique(2,3,8,23,3,5)

exist k Z st {8-23=k*3*5}
