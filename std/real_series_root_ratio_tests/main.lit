    length>=0
    start+length>=start
    n>=start+length>=start
    n>=start
    n $in {j Z:j>=start}

thm nonnegative_real_tail_extremal_limits_ignore_finite_prefix:
    ? forall start Z,a fn(n {j Z:j>=start}) R,length N:
        forall n {j Z:j>=start}:
            a(n)>=0
        =>:
            \limits::real_tail_limsup<start+length>(\limits::real_tail_restriction<start,a,start+length>)=\limits::real_tail_limsup<start>(a)
            \limits::real_tail_liminf<start+length>(\limits::real_tail_restriction<start,a,start+length>)=\limits::real_tail_liminf<start>(a)
    start+length $in Z
    start+length>=start
    start+length>=start+length
    start+length $in {j Z:j>=start and j>=start+length}
    start+length $in {j Z:j>=start+length and j>=start}
    claim:
        ? forall n {j Z:j>=start+length}:
            \limits::real_tail_restriction<start,a,start+length>(n)>=0
            a(n)<=\limits::real_tail_restriction<start,a,start+length>(n)
            \limits::real_tail_restriction<start,a,start+length>(n)<=a(n)
        n $in {j Z:j>=start}
        a(n)>=0
        \limits::real_tail_restriction<start,a,start+length>(n)=a(n)
        \limits::real_tail_restriction<start,a,start+length>(n)>=0
        a(n)<=\limits::real_tail_restriction<start,a,start+length>(n)
        \limits::real_tail_restriction<start,a,start+length>(n)<=a(n)
    release thm nonnegative_real_tail_eventual_comparison_bounds_limsup(start,start+length,a,\limits::real_tail_restriction<start,a,start+length>,start+length)
    release thm nonnegative_real_tail_eventual_comparison_bounds_limsup(start+length,start,\limits::real_tail_restriction<start,a,start+length>,a,start+length)
    release thm nonnegative_real_tail_eventual_comparison_bounds_liminf(start,start+length,a,\limits::real_tail_restriction<start,a,start+length>,start+length)
    release thm nonnegative_real_tail_eventual_comparison_bounds_liminf(start+length,start,\limits::real_tail_restriction<start,a,start+length>,a,start+length)
    release thm xreal::extended_real_order_antisymmetric(\limits::real_tail_limsup<start+length>(\limits::real_tail_restriction<start,a,start+length>),\limits::real_tail_limsup<start>(a))
    release thm xreal::extended_real_order_antisymmetric(\limits::real_tail_liminf<start+length>(\limits::real_tail_restriction<start,a,start+length>),\limits::real_tail_liminf<start>(a))

prop is_strictly_positive_real_tail(start Z,c fn(n {j Z:j>=start}) R):
    forall n {j Z:j>=start}:
        c(n)>0

claim:
    ? forall start Z,n {j Z:j>=start},offset N:
        n+offset $in {j Z:j>=start}
    release thm sext::real_tail_natural_offset_member(start,n,offset)

