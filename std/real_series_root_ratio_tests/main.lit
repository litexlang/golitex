claim:
    ? forall start N+,n {j Z:j>=start}:
        n $in N+
        n $in R+
        n $in R*
        n $in R
        n!=0
    n $in Z
    n>=start>=1
    n>0
    n!=0
    n $in N+
    n $in R+
    n $in R
    n $in R*

claim:
    ? forall start N+,a fn(n {j Z:j>=start}) R,n {j Z:j>=start}:
        1/n $in R+
        abs(a(n)) $in R
        abs(a(n))>=0
    n $in R*
    n $in Z
    n>=start
    start>=1
    n>=1
    n>0
    1/n>0
    1/n $in R+
    a(n) $in R
    abs(a(n))>=0

claim:
    ? forall start N+,a fn(n {j Z:j>=start}) R,n {j Z:j>=start}:
        a(n)!=0
        =>:
            abs(a(n))>0
            abs(a(n)) $in R+
    a(n) $in R
    by cases:
        ? abs(a(n))>0 and abs(a(n)) $in R+
        case a(n)>=0:
            a(n)>0
            abs(a(n))=a(n)>0
            abs(a(n)) $in R+
        case a(n)<0:
            -a(n)>0
            abs(a(n))=-a(n)>0
            abs(a(n)) $in R+

template<start N+,a fn(n {j Z:j>=start}) R>:
    have fn positive_start_real_tail_root_magnitudes(n {j Z:j>=start}) R by cases:
        case a(n)=0: 0
        case a(n)!=0: abs(a(n))^(1/n)

claim:
    ? forall start N+,n {j Z:j>=start}:
        n $in N
        n>=1
        n>=0
        n>0
    n $in Z
    n>=start
    start>=1
    n>=1
    n>=0
    n>0
    n $in N

thm positive_start_real_tail_root_power:
    ? forall start N+,a fn(n {j Z:j>=start}) R,n {j Z:j>=start}:
        \positive_start_real_tail_root_magnitudes<start,a>(n)>=0
        \positive_start_real_tail_root_magnitudes<start,a>(n)^n=abs(a(n))
    n $in N+
    by cases:
        ? \positive_start_real_tail_root_magnitudes<start,a>(n)>=0 and \positive_start_real_tail_root_magnitudes<start,a>(n)^n=abs(a(n))
        case a(n)=0:
            \positive_start_real_tail_root_magnitudes<start,a>(n)=0
            abs(a(n))=0
            \positive_start_real_tail_root_magnitudes<start,a>(n)>=0
            \positive_start_real_tail_root_magnitudes<start,a>(n)^n=0^n=0=abs(a(n))
        case a(n)!=0:
            abs(a(n)) $in R+
            abs(a(n))>=0
            release thm series::nonnegative_root_power(abs(a(n)),n)
            \positive_start_real_tail_root_magnitudes<start,a>(n)=abs(a(n))^(1/n)
            \positive_start_real_tail_root_magnitudes<start,a>(n)>=0
            \positive_start_real_tail_root_magnitudes<start,a>(n)^n=(abs(a(n))^(1/n))^n=abs(a(n))

thm positive_start_real_tail_root_bound_gives_magnitude_bound:
    ? forall start N+,a fn(n {j Z:j>=start}) R,q R+,n {j Z:j>=start}:
        \positive_start_real_tail_root_magnitudes<start,a>(n)<=q
        =>:
            abs(a(n))<=q^n
    n $in Z
    n>=start>=1
    n $in N+
    n $in N
    release thm positive_start_real_tail_root_power(start,a,n)
    q>=0
    release thm power::nonnegative_real_natural_power_preserves_order(\positive_start_real_tail_root_magnitudes<start,a>(n),q,n)
    abs(a(n))=\positive_start_real_tail_root_magnitudes<start,a>(n)^n<=q^n

claim:
    ? forall start N+,k N+:
        start+k-1 $in {j Z:j>=start}
        start+k-1 $in N+
        start+k-1 $in N
    release thm rs::real_tail_positive_index(start,k)
    start+k-1 $in Z
    start>=1
    k>=1
    start+k-1>=start
    start+k-1>=1
    start+k-1 $in N+
    start+k-1 $in N

thm positive_start_real_root_reindex_uses_original_degree:
    ? forall start N+,a fn(n {j Z:j>=start}) R,k N+:
        \rs::real_tail_reindex<start,\positive_start_real_tail_root_magnitudes<start,a>>(k)=\positive_start_real_tail_root_magnitudes<start,a>(start+k-1)
        \rs::real_tail_reindex<start,\positive_start_real_tail_root_magnitudes<start,a>>(k)>=0
        \rs::real_tail_reindex<start,\positive_start_real_tail_root_magnitudes<start,a>>(k)^(start+k-1)=abs(a(start+k-1))
    release thm rs::real_tail_positive_index(start,k)
    start+k-1 $in {j Z:j>=start}
    start+k-1>=start>=1
    release thm rs::real_tail_reindex_at(start,\positive_start_real_tail_root_magnitudes<start,a>,k)
    \rs::real_tail_reindex<start,\positive_start_real_tail_root_magnitudes<start,a>>(k)=\positive_start_real_tail_root_magnitudes<start,a>(start+k-1)
    release thm positive_start_real_tail_root_power(start,a,start+k-1)

thm native_absolute_series_is_real_tail_absolute_convergence:
    ? forall start Z,a fn(n {j Z:j>=start}) R:
        $series::is_absolutely_convergent_series(\rs::real_tail_reindex<start,a>)
        =>:
            $ts::is_absolutely_convergent_real_tail_series(start,a)
            $ts::is_convergent_real_tail_series(start,a)
    $series::is_convergent_series(series::absolute_terms(\rs::real_tail_reindex<start,a>))
    release thm ts::real_tail_series_absolute_reindex(start,a)
    $series::is_convergent_series(\rs::real_tail_reindex<start,\limits::real_tail_absolute_values<start,a>>)
    release thm ts::native_convergent_series_is_real_tail_convergent(start,\limits::real_tail_absolute_values<start,a>)
    by def $ts::is_absolutely_convergent_real_tail_series(start,a)
    release thm ts::absolutely_convergent_real_tail_series_converges(start,a)

thm real_tail_absolute_restriction_commutes:
    ? forall start Z,a fn(n {j Z:j>=start}) R,cutoff {j Z:j>=start}:
        \limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,cutoff> = \limits::real_tail_absolute_values<cutoff,\limits::real_tail_restriction<start,a,cutoff>>
    release thm fn_set_member(\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,cutoff>,fn(n {j Z:j>=cutoff}) R)
    release thm fn_set_member(\limits::real_tail_absolute_values<cutoff,\limits::real_tail_restriction<start,a,cutoff>>,fn(n {j Z:j>=cutoff}) R)
    claim:
        ? forall n {j Z:j>=cutoff}:
            \limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,cutoff>(n)=\limits::real_tail_absolute_values<cutoff,\limits::real_tail_restriction<start,a,cutoff>>(n)
        n $in Z
        n>=cutoff>=start
        n $in {j Z:j>=start}
        \limits::real_tail_restriction<start,a,cutoff>(n)=a(n)
        \limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,cutoff>(n)=\limits::real_tail_absolute_values<start,a>(n)=abs(a(n))=abs(\limits::real_tail_restriction<start,a,cutoff>(n))=\limits::real_tail_absolute_values<cutoff,\limits::real_tail_restriction<start,a,cutoff>>(n)
    by fn_extension \limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,cutoff> = \limits::real_tail_absolute_values<cutoff,\limits::real_tail_restriction<start,a,cutoff>>

claim:
    ? forall start Z,k N:
        start+k $in {j Z:j>=start}
    k $in Z
    k>=0
    start+k $in Z
    start+k>=start+0=start
    start+k $in {j Z:j>=start}

thm real_tail_absolute_convergence_restores_finite_prefix:
    ? forall start Z,a fn(n {j Z:j>=start}) R,k N:
        $ts::is_absolutely_convergent_real_tail_series(start+k,\limits::real_tail_restriction<start,a,start+k>)
        =>:
            $ts::is_absolutely_convergent_real_tail_series(start,a)
            $ts::is_convergent_real_tail_series(start,a)
    $ts::is_convergent_real_tail_series(start+k,\limits::real_tail_absolute_values<start+k,\limits::real_tail_restriction<start,a,start+k>>)
    release thm real_tail_absolute_restriction_commutes(start,a,start+k)
    $ts::is_convergent_real_tail_series(start+k,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+k>)
    release thm ts::convergent_real_tail_restriction_gives_convergent_series(start,\limits::real_tail_absolute_values<start,a>,k)
    by def $ts::is_absolutely_convergent_real_tail_series(start,a)
    release thm ts::absolutely_convergent_real_tail_series_converges(start,a)

thm positive_start_root_eventual_bound_gives_absolute_convergence:
    ? forall start N+,a fn(n {j Z:j>=start}) R,q R+,cutoff {j Z:j>=start}:
        q<1
        forall n {j Z:j>=start}:
            n>=cutoff
            =>:
                \positive_start_real_tail_root_magnitudes<start,a>(n)<=q
        =>:
            $ts::is_absolutely_convergent_real_tail_series(start,a)
            $ts::is_convergent_real_tail_series(start,a)
    start $in Z
    start $in R
    start>=1
    start-1>=0
    start-1 $in R
    have coefficient R=q^(start-1)
    cutoff $in Z
    cutoff>=start>=1
    cutoff+1 $in N+
    claim:
        ? forall k N+:
            k>cutoff+1
            =>:
                abs(\rs::real_tail_reindex<start,a>(k))<=coefficient*q^k
        k $in R
        release thm rs::real_tail_positive_index(start,k)
        start+k-1 $in {j Z:j>=start}
        start+k-1 $in R
        (start+k-1)-k=start-1>=0
        release thm nn::real_difference_lower_bound_gives_additive_bound(start+k-1,k,0)
        start+k-1>=k+0=k
        start+k-1>=k
        k>cutoff+1
        cutoff+1>cutoff
        k>cutoff
        k>=cutoff
        start+k-1>=k>=cutoff
        start+k-1>=cutoff
        \positive_start_real_tail_root_magnitudes<start,a>(start+k-1)<=q
        release thm positive_start_real_tail_root_bound_gives_magnitude_bound(start,a,q,start+k-1)
        release thm rs::real_tail_reindex_at(start,a,k)
        release thm power::positive_real_power_addition(q,start-1,k)
        (start-1)+k=start+k-1
        abs(\rs::real_tail_reindex<start,a>(k))=abs(a(start+k-1))<=q^(start+k-1)=q^((start-1)+k)=q^(start-1)*q^k=coefficient*q^k
    q>=0
    release thm series::series_geometric_domination(\rs::real_tail_reindex<start,a>,q,coefficient,cutoff+1)
    release thm native_absolute_series_is_real_tail_absolute_convergence(start,a)

thm nonnegative_real_tail_has_nonnegative_extremal_limits:
    ? forall start Z,a fn(n {j Z:j>=start}) R:
        forall n {j Z:j>=start}:
            a(n)>=0
        =>:
            $xreal::extended_real_le(0,\limits::real_tail_liminf<start>(a))
            $xreal::extended_real_le(0,\limits::real_tail_limsup<start>(a))
    release thm rs::real_tail_constant_limit(start,0)
    release thm limits::real_tail_limit_equals_extremal_limits(start,\rs::real_tail_constant<start,0>,0)
    claim:
        ? forall n {j Z:j>=start}:
            \rs::real_tail_constant<start,0>(n)<=a(n)
        \rs::real_tail_constant<start,0>(n)=0<=a(n)
    release thm limits::real_tail_liminf_pointwise_comparison(start,\rs::real_tail_constant<start,0>,a)
    release thm limits::real_tail_limsup_pointwise_comparison(start,\rs::real_tail_constant<start,0>,a)
    \limits::real_tail_liminf<start>(\rs::real_tail_constant<start,0>)=0
    \limits::real_tail_limsup<start>(\rs::real_tail_constant<start,0>)=0
    $xreal::extended_real_le(0,\limits::real_tail_liminf<start>(a))
    $xreal::extended_real_le(0,\limits::real_tail_limsup<start>(a))

thm positive_start_real_series_root_limsup_below_one_converges:
    ? forall start N+,a fn(n {j Z:j>=start}) R:
        $xreal::extended_real_lt(\limits::real_tail_limsup<start>(\positive_start_real_tail_root_magnitudes<start,a>),1)
        =>:
            $ts::is_absolutely_convergent_real_tail_series(start,a)
            $ts::is_convergent_real_tail_series(start,a)
    claim:
        ? forall n {j Z:j>=start}:
            \positive_start_real_tail_root_magnitudes<start,a>(n)>=0
        release thm positive_start_real_tail_root_power(start,a,n)
    release thm nonnegative_real_tail_has_nonnegative_extremal_limits(start,\positive_start_real_tail_root_magnitudes<start,a>)
    have alpha xreal::ExtendedReal=\limits::real_tail_limsup<start>(\positive_start_real_tail_root_magnitudes<start,a>)
    $xreal::extended_real_le(0,alpha)
    $xreal::extended_real_lt(alpha,1)
    $xreal::extended_real_le(alpha,1)
    release thm limits::extended_real_between_reals_is_real(alpha,0,1)
    alpha $in R
    release thm xreal::extended_real_order_on_reals(0,alpha)
    release thm limits::extended_strict_order_on_reals(alpha,1)
    0<=alpha
    alpha<1
    alpha+1>=0+1=1>0
    (alpha+1)/2>0
    (alpha+1)/2 $in R+
    have q R+=(alpha+1)/2
    alpha+1<1+1=2
    (alpha+1)/2<2/2=1
    q<1
    alpha+alpha<alpha+1
    2*alpha=alpha+alpha<alpha+1
    alpha=2*alpha/2<(alpha+1)/2=q
    alpha<q
    release thm limits::real_strict_order_is_extended_order(alpha,q)
    $xreal::extended_real_lt(\limits::real_tail_limsup<start>(\positive_start_real_tail_root_magnitudes<start,a>),q)
    release thm limits::real_tail_limsup_eventually_below(start,\positive_start_real_tail_root_magnitudes<start,a>,q)
    obtain cutoff from exist c {j Z:j>=start} st {$limits::is_real_tail_below_after(start,\positive_start_real_tail_root_magnitudes<start,a>,q,c)}
    claim:
        ? forall n {j Z:j>=start}:
            n>=cutoff
            =>:
                \positive_start_real_tail_root_magnitudes<start,a>(n)<=q
        $xreal::extended_real_lt(\positive_start_real_tail_root_magnitudes<start,a>(n),q)
        release thm limits::extended_strict_order_on_reals(\positive_start_real_tail_root_magnitudes<start,a>(n),q)
        \positive_start_real_tail_root_magnitudes<start,a>(n)<=q
    release thm positive_start_root_eventual_bound_gives_absolute_convergence(start,a,q,cutoff)

thm positive_start_real_series_root_limsup_above_one_diverges:
    ? forall start N+,a fn(n {j Z:j>=start}) R:
        $xreal::extended_real_lt(1,\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,a>))
        =>:
            not $ts::is_convergent_real_tail_series(start,a)
            not $ts::is_absolutely_convergent_real_tail_series(start,a)
    by contra:
        ? not $ts::is_convergent_real_tail_series(start,a)
        release thm ts::convergent_real_tail_series_terms_tend_to_zero(start,a)
        $rs::is_eventually_real_tail_close(start,a,0,1/2)
        obtain cutoff from exist c Z st {$rs::is_real_tail_close_after(start,a,0,1/2,c)}
        cutoff>=start
        cutoff $in {j Z:j>=start}
        release thm limits::real_tail_limsup_arbitrarily_late_above(start,\main::positive_start_real_tail_root_magnitudes<start,a>,1,cutoff)
        obtain hit from exist n {j Z:j>=start} st {n>=cutoff and $xreal::extended_real_lt(1,\main::positive_start_real_tail_root_magnitudes<start,a>(n))}
        hit $in Z
        hit>=start
        hit>=cutoff
        $approx::is_epsilon_close(a(hit),0,1/2)
        abs(a(hit)-0)<=1/2
        abs(a(hit))=abs(a(hit)-0)<=1/2
        hit $in N+
        release thm main::positive_start_real_tail_root_power(start,a,hit)
        release thm limits::extended_strict_order_on_reals(1,\main::positive_start_real_tail_root_magnitudes<start,a>(hit))
        1<\main::positive_start_real_tail_root_magnitudes<start,a>(hit)
        release thm power::nonnegative_real_positive_natural_power_preserves_strict_order(1,\main::positive_start_real_tail_root_magnitudes<start,a>(hit),hit)
        1=1^hit<\main::positive_start_real_tail_root_magnitudes<start,a>(hit)^hit=abs(a(hit))
        1<abs(a(hit))
        abs(a(hit))<=1
        impossible 1<abs(a(hit))
    by contra:
        ? not $ts::is_absolutely_convergent_real_tail_series(start,a)
        release thm ts::absolutely_convergent_real_tail_series_converges(start,a)
        impossible $ts::is_convergent_real_tail_series(start,a)

claim:
    ? forall start Z,length {k N:start+k>=1}:
        start+length $in N+
        start+length $in {j Z:j>=start}
    length $in N
    length $in Z
    length>=0
    start+length $in Z
    start+length>=1
    start+length $in N+
    start+length>=start+0=start
    start+length $in {j Z:j>=start}

thm real_tail_series_root_limsup_below_one_converges:
    ? forall start Z,a fn(n {j Z:j>=start}) R,length {k N:start+k>=1}:
        $xreal::extended_real_lt(\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>),1)
        =>:
            $ts::is_absolutely_convergent_real_tail_series(start,a)
            $ts::is_convergent_real_tail_series(start,a)
    start+length $in N+
    release thm main::positive_start_real_series_root_limsup_below_one_converges(start+length,\limits::real_tail_restriction<start,a,start+length>)
    length $in N
    release thm main::real_tail_absolute_convergence_restores_finite_prefix(start,a,length)

thm real_tail_series_root_limsup_above_one_diverges:
    ? forall start Z,a fn(n {j Z:j>=start}) R,length {k N:start+k>=1}:
        $xreal::extended_real_lt(1,\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>))
        =>:
            not $ts::is_convergent_real_tail_series(start,a)
            not $ts::is_absolutely_convergent_real_tail_series(start,a)
    start+length $in N+
    release thm positive_start_real_series_root_limsup_above_one_diverges(start+length,\limits::real_tail_restriction<start,a,start+length>)
    by contra:
        ? not $ts::is_convergent_real_tail_series(start,a)
        length $in N
        release thm ts::convergent_real_tail_series_remains_convergent_after_finite_prefix(start,a,length)
        impossible $ts::is_convergent_real_tail_series(start+length,\limits::real_tail_restriction<start,a,start+length>)
    by contra:
        ? not $ts::is_absolutely_convergent_real_tail_series(start,a)
        release thm ts::absolutely_convergent_real_tail_series_converges(start,a)
        impossible $ts::is_convergent_real_tail_series(start,a)

thm integer_tail_has_positive_cutoff_length:
    ? forall start Z:
        exist length {k N:start+k>=1} st {start+length $in N+}
    by cases:
        ? exist length {k N:start+k>=1} st {start+length $in N+}
        case start>=1:
            start+0>=1
            0 $in {k N:start+k>=1}
            start+0 $in Z
            start+0>=1
            start+0 $in N+
            witness exist length {k N:start+k>=1} st {start+length $in N+} from 0
        case start<1:
            1-start $in Z
            1-start>0
            1-start>=0
            1-start $in N
            start+(1-start)=1
            start+(1-start)>=1
            1-start $in {k N:start+k>=1}
            start+(1-start) $in N+
            witness exist length {k N:start+k>=1} st {start+length $in N+} from 1-start

thm real_tail_limit_restricts_after_finite_prefix:
    ? forall start Z,a fn(n {j Z:j>=start}) R,L R,length N:
        $rs::has_real_tail_limit(start,a,L)
        =>:
            $rs::has_real_tail_limit(start+length,\limits::real_tail_restriction<start,a,start+length>,L)
    claim:
        ? forall epsilon R+:
            $rs::is_eventually_real_tail_close(start+length,\limits::real_tail_restriction<start,a,start+length>,L,epsilon)
        $rs::is_eventually_real_tail_close(start,a,L,epsilon)
        obtain old from exist c Z st {$rs::is_real_tail_close_after(start,a,L,epsilon,c)}
        old>=start
        length>=0
        have cutoff Z=old+length
        cutoff>=old
        cutoff>=start+length
        claim:
            ? forall n Z:
                n>=start+length
                n>=cutoff
                =>:
                    $approx::is_epsilon_close(\limits::real_tail_restriction<start,a,start+length>(n),L,epsilon)
            start+length>=start
            n>=start+length>=start
            n>=start
            n>=cutoff>=old
            n>=old
            n $in {j Z:j>=start+length}
            n $in {j Z:j>=start}
            $approx::is_epsilon_close(a(n),L,epsilon)
            \limits::real_tail_restriction<start,a,start+length>(n)=a(n)
            $approx::is_epsilon_close(\limits::real_tail_restriction<start,a,start+length>(n),L,epsilon)
        by def $rs::is_real_tail_close_after(start+length,\limits::real_tail_restriction<start,a,start+length>,L,epsilon,cutoff)
        witness $rs::is_eventually_real_tail_close(start+length,\limits::real_tail_restriction<start,a,start+length>,L,epsilon) from cutoff
    by def $rs::has_real_tail_limit(start+length,\limits::real_tail_restriction<start,a,start+length>,L)

thm real_tail_limit_restores_finite_prefix:
    ? forall start Z,a fn(n {j Z:j>=start}) R,L R,length N:
        $rs::has_real_tail_limit(start+length,\limits::real_tail_restriction<start,a,start+length>,L)
        =>:
            $rs::has_real_tail_limit(start,a,L)
    claim:
        ? forall epsilon R+:
            $rs::is_eventually_real_tail_close(start,a,L,epsilon)
        $rs::is_eventually_real_tail_close(start+length,\limits::real_tail_restriction<start,a,start+length>,L,epsilon)
        obtain cutoff from exist c Z st {$rs::is_real_tail_close_after(start+length,\limits::real_tail_restriction<start,a,start+length>,L,epsilon,c)}
        cutoff>=start+length
        length>=0
        start+length>=start
        cutoff>=start
        claim:
            ? forall n Z:
                n>=start
                n>=cutoff
                =>:
                    $approx::is_epsilon_close(a(n),L,epsilon)
            n>=cutoff>=start+length
            n>=start+length
            n $in {j Z:j>=start+length}
            n $in {j Z:j>=start}
            $approx::is_epsilon_close(\limits::real_tail_restriction<start,a,start+length>(n),L,epsilon)
            \limits::real_tail_restriction<start,a,start+length>(n)=a(n)
            $approx::is_epsilon_close(a(n),L,epsilon)
        by def $rs::is_real_tail_close_after(start,a,L,epsilon,cutoff)
        witness $rs::is_eventually_real_tail_close(start,a,L,epsilon) from cutoff
    by def $rs::has_real_tail_limit(start,a,L)

thm nonnegative_extended_strict_pair_has_positive_real_between:
    ? forall lower,upper xreal::ExtendedReal:
        $xreal::extended_real_le(0,lower)
        $xreal::extended_real_lt(lower,upper)
        =>:
            exist q R+ st {$xreal::extended_real_lt(lower,q) and $xreal::extended_real_lt(q,upper)}
    $xreal::extended_real_le(lower,upper)
    lower!=upper
    release thm xreal::real_negative_infinity_is_not_real
    release thm xreal::real_positive_infinity_is_not_real
    by contra:
        ? 0!=xreal::real_negative_infinity
        xreal::real_negative_infinity=0
        xreal::real_negative_infinity $in R
        impossible xreal::real_negative_infinity $in R
    by contra:
        ? lower!=xreal::real_positive_infinity
        $xreal::extended_real_le(xreal::real_positive_infinity,upper)
        release thm xreal::positive_infinity_le_only_itself(upper)
        upper=xreal::real_positive_infinity=lower
        impossible lower!=upper
    release thm xreal::nontrivial_extended_real_order_is_finite(0,lower)
    lower $in R
    release thm xreal::extended_real_order_on_reals(0,lower)
    lower>=0
    release thm xreal::extended_real_has_three_cases(upper)
    by cases:
        ? exist q R+ st {$xreal::extended_real_lt(lower,q) and $xreal::extended_real_lt(q,upper)}
        case upper $in R:
            release thm limits::extended_strict_order_on_reals(lower,upper)
            lower<upper
            upper>lower>=0
            upper>0
            lower+upper>=0+upper=upper>0
            (lower+upper)/2>0
            have finite_q R+=(lower+upper)/2
            lower+lower<lower+upper
            2*lower=lower+lower
            2*lower<lower+upper
            lower=2*lower/2<(lower+upper)/2=finite_q
            lower<finite_q
            lower+upper<upper+upper=2*upper
            upper+upper=2*upper
            lower+upper<2*upper
            finite_q=(lower+upper)/2<(2*upper)/2=upper
            finite_q<upper
            release thm limits::real_strict_order_is_extended_order(lower,finite_q)
            release thm limits::real_strict_order_is_extended_order(finite_q,upper)
            witness exist r R+ st {$xreal::extended_real_lt(lower,r) and $xreal::extended_real_lt(r,upper)} from finite_q
        case upper=xreal::real_positive_infinity:
            lower+1>0
            have infinite_q R+=lower+1
            lower<infinite_q
            release thm limits::real_strict_order_is_extended_order(lower,infinite_q)
            release thm xreal::extended_real_le_positive_infinity(infinite_q)
            by contra:
                ? infinite_q!=xreal::real_positive_infinity
                xreal::real_positive_infinity=infinite_q
                xreal::real_positive_infinity $in R
                impossible xreal::real_positive_infinity $in R
            by def $xreal::extended_real_lt(infinite_q,upper)
            witness exist r R+ st {$xreal::extended_real_lt(lower,r) and $xreal::extended_real_lt(r,upper)} from infinite_q
        case upper=xreal::real_negative_infinity:
            by contra:
                ? exist q R+ st {$xreal::extended_real_lt(lower,q) and $xreal::extended_real_lt(q,upper)}
                $xreal::extended_real_le(lower,xreal::real_negative_infinity)
                release thm xreal::only_negative_infinity_le_negative_infinity(lower)
                lower=xreal::real_negative_infinity
                xreal::real_negative_infinity $in R
                impossible xreal::real_negative_infinity $in R

thm extended_real_not_le_gives_reverse_strict_order:
    ? forall x,y xreal::ExtendedReal:
        not $xreal::extended_real_le(x,y)
        =>:
            $xreal::extended_real_lt(y,x)
    release thm xreal::extended_real_order_total(x,y)
    claim:
        ? $xreal::extended_real_le(y,x)
        by cases:
            ? $xreal::extended_real_le(y,x)
            case $xreal::extended_real_le(x,y):
                by contra:
                    ? $xreal::extended_real_le(y,x)
                    impossible $xreal::extended_real_le(x,y)
            case $xreal::extended_real_le(y,x):
                $xreal::extended_real_le(y,x)
    by contra:
        ? y!=x
        y=x
        release thm xreal::extended_real_order_reflexive(x)
        $xreal::extended_real_le(x,y)
        impossible $xreal::extended_real_le(x,y)
    by def $xreal::extended_real_lt(y,x)

claim:
    ? forall start,substart Z,cutoff {j Z:j>=start and j>=substart},n {j Z:j>=cutoff}:
        n $in {j Z:j>=start}
        n $in {j Z:j>=substart}
    n $in Z
    n>=cutoff
    cutoff>=start
    cutoff>=substart
    n>=start
    n>=substart
    n $in {j Z:j>=start}
    n $in {j Z:j>=substart}

thm nonnegative_real_tail_eventual_comparison_bounds_limsup:
    ? forall start,substart Z,a fn(n {j Z:j>=start}) R,b fn(n {j Z:j>=substart}) R,cutoff {j Z:j>=start and j>=substart}:
        forall n {j Z:j>=start}:
            a(n)>=0
        forall n {j Z:j>=substart}:
            b(n)>=0
        forall n {j Z:j>=cutoff}:
            a(n)<=b(n)
        =>:
            $xreal::extended_real_le(\limits::real_tail_limsup<start>(a),\limits::real_tail_limsup<substart>(b))
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(start,a)
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(substart,b)
    have upper_a xreal::ExtendedReal=\limits::real_tail_limsup<start>(a)
    have upper_b xreal::ExtendedReal=\limits::real_tail_limsup<substart>(b)
    by contra:
        ? $xreal::extended_real_le(upper_a,upper_b)
        release thm extended_real_not_le_gives_reverse_strict_order(upper_a,upper_b)
        $xreal::extended_real_le(0,upper_b)
        release thm nonnegative_extended_strict_pair_has_positive_real_between(upper_b,upper_a)
        obtain q from exist r R+ st {$xreal::extended_real_lt(upper_b,r) and $xreal::extended_real_lt(r,upper_a)}
        release thm limits::real_tail_limsup_eventually_below(substart,b,q)
        obtain old from exist c {j Z:j>=substart} st {$limits::is_real_tail_below_after(substart,b,q,c)}
        old $in Z
        old>=substart
        cutoff $in Z
        cutoff>=start
        cutoff>=substart
        old $in R
        cutoff $in R
        substart $in R
        have later Z=old+cutoff-substart
        later-old=(old+cutoff-substart)-old=cutoff-substart>=0
        release thm nn::real_difference_lower_bound_gives_additive_bound(later,old,0)
        later>=old+0=old
        later>=old
        later-cutoff=(old+cutoff-substart)-cutoff=old-substart>=0
        release thm nn::real_difference_lower_bound_gives_additive_bound(later,cutoff,0)
        later>=cutoff+0=cutoff
        later>=cutoff>=start
        later>=start
        later $in {j Z:j>=start}
        release thm limits::real_tail_limsup_arbitrarily_late_above(start,a,q,later)
        obtain hit from exist n {j Z:j>=start} st {n>=later and $xreal::extended_real_lt(q,a(n))}
        hit $in Z
        hit>=later>=cutoff
        hit>=cutoff
        hit>=later>=old
        hit>=old
        hit>=substart
        hit $in {j Z:j>=cutoff}
        hit $in {j Z:j>=substart}
        a(hit)<=b(hit)
        release thm xreal::real_order_is_extended_real_order(a(hit),b(hit))
        $xreal::extended_real_lt(b(hit),q)
        release thm limits::extended_real_lt_le_transitive(q,a(hit),b(hit))
        release thm xreal::extended_real_strict_order_asymmetric(q,b(hit))
        impossible $xreal::extended_real_lt(b(hit),q)

thm nonnegative_real_tail_eventual_comparison_bounds_liminf:
    ? forall start,substart Z,a fn(n {j Z:j>=start}) R,b fn(n {j Z:j>=substart}) R,cutoff {j Z:j>=start and j>=substart}:
        forall n {j Z:j>=start}:
            a(n)>=0
        forall n {j Z:j>=substart}:
            b(n)>=0
        forall n {j Z:j>=cutoff}:
            a(n)<=b(n)
        =>:
            $xreal::extended_real_le(\limits::real_tail_liminf<start>(a),\limits::real_tail_liminf<substart>(b))
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(start,a)
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(substart,b)
    have lower_a xreal::ExtendedReal=\limits::real_tail_liminf<start>(a)
    have lower_b xreal::ExtendedReal=\limits::real_tail_liminf<substart>(b)
    by contra:
        ? $xreal::extended_real_le(lower_a,lower_b)
        release thm extended_real_not_le_gives_reverse_strict_order(lower_a,lower_b)
        $xreal::extended_real_le(0,lower_b)
        release thm nonnegative_extended_strict_pair_has_positive_real_between(lower_b,lower_a)
        obtain q from exist r R+ st {$xreal::extended_real_lt(lower_b,r) and $xreal::extended_real_lt(r,lower_a)}
        release thm limits::real_tail_liminf_eventually_above(start,a,q)
        obtain old from exist c {j Z:j>=start} st {$limits::is_real_tail_above_after(start,a,q,c)}
        old $in Z
        old>=start
        cutoff $in Z
        cutoff>=start
        cutoff>=substart
        old $in R
        cutoff $in R
        start $in R
        have later Z=old+cutoff-start
        later-old=(old+cutoff-start)-old=cutoff-start>=0
        release thm nn::real_difference_lower_bound_gives_additive_bound(later,old,0)
        later>=old+0=old
        later>=old
        later-cutoff=(old+cutoff-start)-cutoff=old-start>=0
        release thm nn::real_difference_lower_bound_gives_additive_bound(later,cutoff,0)
        later>=cutoff+0=cutoff
        later>=cutoff>=substart
        later>=substart
        later $in {j Z:j>=substart}
        release thm limits::real_tail_liminf_arbitrarily_late_below(substart,b,q,later)
        obtain hit from exist n {j Z:j>=substart} st {n>=later and $xreal::extended_real_lt(b(n),q)}
        hit $in Z
        hit>=later>=cutoff
        hit>=cutoff
        hit>=later>=old
        hit>=old
        hit>=start
        hit $in {j Z:j>=cutoff}
        hit $in {j Z:j>=start}
        a(hit)<=b(hit)
        release thm xreal::real_order_is_extended_real_order(a(hit),b(hit))
        $xreal::extended_real_lt(q,a(hit))
        release thm limits::extended_real_lt_le_transitive(q,a(hit),b(hit))
        release thm xreal::extended_real_strict_order_asymmetric(q,b(hit))
        impossible $xreal::extended_real_lt(b(hit),q)

claim:
    ? forall start Z,length N,n {j Z:j>=start+length}:
        n $in {j Z:j>=start}
    n $in Z
