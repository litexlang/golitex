    $is_strictly_positive_real_tail(start,c)
    c(n)>0
    c(n+1)>0
    c(n) $in R+
    c(n+1) $in R+
    c(n)!=0
    c(n) $in R*
    c(n+1)/c(n)>0
    c(n+1)/c(n) $in R+

template<start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}>:
    have fn positive_real_tail_successive_ratios(n {j Z:j>=start}) R+=c(n+1)/c(n)

thm positive_real_tail_successive_ratio_value:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},n {j Z:j>=start}:
        \positive_real_tail_successive_ratios<start,c>(n)=c(n+1)/c(n)
        \positive_real_tail_successive_ratios<start,c>(n)>0
        \positive_real_tail_successive_ratios<start,c>(n)*c(n)=c(n+1)
    $is_strictly_positive_real_tail(start,c)
    c(n)>0
    c(n)!=0
    c(n) $in R*
    \positive_real_tail_successive_ratios<start,c>(n)=c(n+1)/c(n)
    \positive_real_tail_successive_ratios<start,c>(n) $in R+
    \positive_real_tail_successive_ratios<start,c>(n)>0
    \positive_real_tail_successive_ratios<start,c>(n)*c(n)=(c(n+1)/c(n))*c(n)=c(n+1)

thm nonnegative_real_positive_natural_power_reflects_order:
    ? forall x,y R,n N+:
        x>=0
        y>=0
        x^n<=y^n
        =>:
            x<=y
    by contra:
        ? x<=y
        y<x
        release thm power::nonnegative_real_positive_natural_power_preserves_strict_order(y,x,n)
        x^n>y^n
        impossible x^n>y^n

thm positive_real_tail_ratio_upper_bound_gives_offset_bound:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},q R+,cutoff {j Z:j>=start},offset N:
        forall n {j Z:j>=start}:
            n>=cutoff
            =>:
                \positive_real_tail_successive_ratios<start,c>(n)<=q
        =>:
            c(cutoff+offset)<=c(cutoff)*q^offset
    $is_strictly_positive_real_tail(start,c)
    q>0
    q>=0
    by induc offset from 0:
        ? c(cutoff+offset)<=c(cutoff)*q^offset
        ? from offset=0:
            cutoff+0=cutoff
            c(cutoff+0)=c(cutoff)=c(cutoff)*1=c(cutoff)*q^0
        ? induc:
            cutoff+offset $in {j Z:j>=start}
            offset>=0
            cutoff+offset>=cutoff
            c(cutoff+offset)>0
            c(cutoff+offset)>=0
            \positive_real_tail_successive_ratios<start,c>(cutoff+offset)<=q
            release thm positive_real_tail_successive_ratio_value(start,c,cutoff+offset)
            \positive_real_tail_successive_ratios<start,c>(cutoff+offset)*c(cutoff+offset)<=q*c(cutoff+offset)
            q*c(cutoff+offset)<=q*(c(cutoff)*q^offset)
            q^(offset+1)=q^offset*q
            q*(c(cutoff)*q^offset)=c(cutoff)*(q^offset*q)=c(cutoff)*q^(offset+1)
            cutoff+(offset+1)=(cutoff+offset)+1
            c(cutoff+(offset+1))=c((cutoff+offset)+1)=\positive_real_tail_successive_ratios<start,c>(cutoff+offset)*c(cutoff+offset)<=q*c(cutoff+offset)<=q*(c(cutoff)*q^offset)=c(cutoff)*q^(offset+1)

thm positive_real_tail_ratio_lower_bound_gives_offset_bound:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},q R+,cutoff {j Z:j>=start},offset N:
        forall n {j Z:j>=start}:
            n>=cutoff
            =>:
                \positive_real_tail_successive_ratios<start,c>(n)>=q
        =>:
            c(cutoff+offset)>=c(cutoff)*q^offset
    $is_strictly_positive_real_tail(start,c)
    q>0
    q>=0
    by induc offset from 0:
        ? c(cutoff+offset)>=c(cutoff)*q^offset
        ? from offset=0:
            cutoff+0=cutoff
            c(cutoff+0)=c(cutoff)=c(cutoff)*1=c(cutoff)*q^0
        ? induc:
            cutoff+offset $in {j Z:j>=start}
            offset>=0
            cutoff+offset>=cutoff
            c(cutoff+offset)>0
            c(cutoff+offset)>=0
            \positive_real_tail_successive_ratios<start,c>(cutoff+offset)>=q
            release thm positive_real_tail_successive_ratio_value(start,c,cutoff+offset)
            \positive_real_tail_successive_ratios<start,c>(cutoff+offset)*c(cutoff+offset)>=q*c(cutoff+offset)
            q*c(cutoff+offset)>=q*(c(cutoff)*q^offset)
            q^(offset+1)=q^offset*q
            q*(c(cutoff)*q^offset)=c(cutoff)*(q^offset*q)=c(cutoff)*q^(offset+1)
            cutoff+(offset+1)=(cutoff+offset)+1
            c(cutoff+(offset+1))=c((cutoff+offset)+1)=\positive_real_tail_successive_ratios<start,c>(cutoff+offset)*c(cutoff+offset)>=q*c(cutoff+offset)>=q*(c(cutoff)*q^offset)=c(cutoff)*q^(offset+1)

thm positive_real_tail_ratio_upper_bound_gives_geometric_envelope:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},q R+,cutoff,n {j Z:j>=start}:
        forall k {j Z:j>=start}:
            k>=cutoff
            =>:
                \positive_real_tail_successive_ratios<start,c>(k)<=q
        n>=cutoff
        =>:
            c(n)<=(c(cutoff)*q^(-cutoff))*q^n
    n $in Z
    cutoff $in Z
    n-cutoff $in Z
    n-cutoff>=0
    n-cutoff $in N
    n $in R
    cutoff $in R
    release thm positive_real_tail_ratio_upper_bound_gives_offset_bound(start,c,q,cutoff,n-cutoff)
    cutoff+(n-cutoff)=n
    c(n)=c(cutoff+(n-cutoff))<=c(cutoff)*q^(n-cutoff)
    release thm power::positive_real_power_addition(q,-cutoff,n)
    n-cutoff=(-cutoff)+n
    c(cutoff)*q^(n-cutoff)=c(cutoff)*q^((-cutoff)+n)=c(cutoff)*(q^(-cutoff)*q^n)=(c(cutoff)*q^(-cutoff))*q^n
    c(n)<=(c(cutoff)*q^(-cutoff))*q^n

thm positive_real_tail_ratio_lower_bound_gives_geometric_envelope:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},q R+,cutoff,n {j Z:j>=start}:
        forall k {j Z:j>=start}:
            k>=cutoff
            =>:
                \positive_real_tail_successive_ratios<start,c>(k)>=q
        n>=cutoff
        =>:
            c(n)>=(c(cutoff)*q^(-cutoff))*q^n
    n $in Z
    cutoff $in Z
    n-cutoff $in Z
    n-cutoff>=0
    n-cutoff $in N
    n $in R
    cutoff $in R
    release thm positive_real_tail_ratio_lower_bound_gives_offset_bound(start,c,q,cutoff,n-cutoff)
    cutoff+(n-cutoff)=n
    c(n)=c(cutoff+(n-cutoff))>=c(cutoff)*q^(n-cutoff)
    release thm power::positive_real_power_addition(q,-cutoff,n)
    n-cutoff=(-cutoff)+n
    c(cutoff)*q^(n-cutoff)=c(cutoff)*q^((-cutoff)+n)=c(cutoff)*(q^(-cutoff)*q^n)=(c(cutoff)*q^(-cutoff))*q^n
    c(n)>=(c(cutoff)*q^(-cutoff))*q^n

claim:
    ? forall A R+:
        \standard::positive_base_nth_root_tail<A> $in fn(n {j Z:j>=1}) R
    release thm fn_set_member(\standard::positive_base_nth_root_tail<A>,fn(n {j Z:j>=1}) R+)
    release thm fn_set_member(\standard::positive_base_nth_root_tail<A>,fn(n {j Z:j>=1}) R)

claim:
    ? forall start N+,n {j Z:j>=start}:
        n $in {j Z:j>=1}
    n $in Z
    n>=start
    start>=1
    n>=1
    n $in {j Z:j>=1}

thm positive_start_geometric_magnitude_upper_bound_gives_root_bound:
    ? forall start N+,a fn(n {j Z:j>=start}) R,A,q R+,n {j Z:j>=start}:
        abs(a(n))<=A*q^n
        =>:
            \main::positive_start_real_tail_root_magnitudes<start,a>(n)<=\standard::positive_base_nth_root_tail<A>(n)*q
    n $in N+
    n $in R
    n $in {j Z:j>=1}
    \standard::positive_base_nth_root_tail<A>(n) $in R+
    q>0
    \standard::positive_base_nth_root_tail<A>(n)*q>0
    have upper R+=\standard::positive_base_nth_root_tail<A>(n)*q
    upper>=0
    A>=0
    release thm standard::positive_base_nth_root_tail_power(A,n)
    release thm power::positive_real_product_power(\standard::positive_base_nth_root_tail<A>(n),q,n)
    upper^n=(\standard::positive_base_nth_root_tail<A>(n)*q)^n=(\standard::positive_base_nth_root_tail<A>(n))^n*q^n=A*q^n
    release thm main::positive_start_real_tail_root_power(start,a,n)
    \main::positive_start_real_tail_root_magnitudes<start,a>(n)^n=abs(a(n))<=A*q^n=upper^n
    \main::positive_start_real_tail_root_magnitudes<start,a>(n)^n<=upper^n
    release thm nonnegative_real_positive_natural_power_reflects_order(\main::positive_start_real_tail_root_magnitudes<start,a>(n),upper,n)
    \main::positive_start_real_tail_root_magnitudes<start,a>(n)<=upper
    upper=\standard::positive_base_nth_root_tail<A>(n)*q
    \main::positive_start_real_tail_root_magnitudes<start,a>(n)<=\standard::positive_base_nth_root_tail<A>(n)*q

thm positive_start_geometric_magnitude_lower_bound_gives_root_bound:
    ? forall start N+,a fn(n {j Z:j>=start}) R,A,q R+,n {j Z:j>=start}:
        abs(a(n))>=A*q^n
        =>:
            \main::positive_start_real_tail_root_magnitudes<start,a>(n)>=\standard::positive_base_nth_root_tail<A>(n)*q
    n $in N+
    n $in R
    n $in {j Z:j>=1}
    \standard::positive_base_nth_root_tail<A>(n) $in R+
    q>0
    \standard::positive_base_nth_root_tail<A>(n)*q>0
    have lower R+=\standard::positive_base_nth_root_tail<A>(n)*q
    lower>=0
    A>=0
    release thm standard::positive_base_nth_root_tail_power(A,n)
    release thm power::positive_real_product_power(\standard::positive_base_nth_root_tail<A>(n),q,n)
    lower^n=(\standard::positive_base_nth_root_tail<A>(n)*q)^n=(\standard::positive_base_nth_root_tail<A>(n))^n*q^n=A*q^n
    release thm main::positive_start_real_tail_root_power(start,a,n)
    lower^n=A*q^n<=abs(a(n))=\main::positive_start_real_tail_root_magnitudes<start,a>(n)^n
    lower^n<=\main::positive_start_real_tail_root_magnitudes<start,a>(n)^n
    release thm nonnegative_real_positive_natural_power_reflects_order(lower,\main::positive_start_real_tail_root_magnitudes<start,a>(n),n)
    lower<=\main::positive_start_real_tail_root_magnitudes<start,a>(n)
    lower=\standard::positive_base_nth_root_tail<A>(n)*q
    \main::positive_start_real_tail_root_magnitudes<start,a>(n)>=\standard::positive_base_nth_root_tail<A>(n)*q

claim:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}:
        \positive_real_tail_successive_ratios<start,c> $in fn(n {j Z:j>=start}) R
    release thm fn_set_member(\positive_real_tail_successive_ratios<start,c>,fn(n {j Z:j>=start}) R+)
    release thm fn_set_member(\positive_real_tail_successive_ratios<start,c>,fn(n {j Z:j>=start}) R)

thm positive_start_ratio_upper_bound_bounds_root_limsup:
    ? forall start N+,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},q R+,cutoff {j Z:j>=start}:
        forall n {j Z:j>=start}:
            n>=cutoff
            =>:
                \positive_real_tail_successive_ratios<start,c>(n)<=q
        =>:
            $xreal::extended_real_le(\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,c>),q)
    $is_strictly_positive_real_tail(start,c)
    start>=1
    cutoff $in Z
    cutoff $in R
    cutoff>=start>=1
    cutoff>=1
    cutoff $in {j Z:j>=start and j>=1}
    c(cutoff)>0
    c(cutoff) $in R+
    release thm power::positive_real_power_is_positive(q,-cutoff)
    c(cutoff)*q^(-cutoff)>0
    have A R+=c(cutoff)*q^(-cutoff)
    have reference fn(n {j Z:j>=1}) R=\rs::real_tail_scaled<1,\standard::positive_base_nth_root_tail<A>,q>
    release thm standard::positive_base_nth_root_tail_limit(A)
    release thm rs::real_tail_scaled_limit(1,\standard::positive_base_nth_root_tail<A>,1,q)
    1*q=q
    $rs::has_real_tail_limit(1,reference,q)
    release thm limits::real_tail_limit_equals_extremal_limits(1,reference,q)
    claim:
        ? forall n {j Z:j>=1}:
            reference(n)>=0
        n $in Z
        n>=1
        n>0
        n!=0
        n $in R*
        1/n>0
        1/n $in R+
        release thm power::positive_real_power_is_positive(A,1/n)
        \standard::positive_base_nth_root_tail<A>(n)=A^(1/n)
        \standard::positive_base_nth_root_tail<A>(n)>0
        q>0
        reference(n)=\rs::real_tail_scaled<1,\standard::positive_base_nth_root_tail<A>,q>(n)=q*\standard::positive_base_nth_root_tail<A>(n)>0
        reference(n)>=0
    claim:
        ? forall n {j Z:j>=start}:
            \main::positive_start_real_tail_root_magnitudes<start,c>(n)>=0
        release thm main::positive_start_real_tail_root_power(start,c,n)
    claim:
        ? forall n {j Z:j>=cutoff}:
            \main::positive_start_real_tail_root_magnitudes<start,c>(n)<=reference(n)
        n $in {j Z:j>=start}
        n $in {j Z:j>=1}
        n>=cutoff
        c(n)>0
        abs(c(n))=c(n)
        release thm positive_real_tail_ratio_upper_bound_gives_geometric_envelope(start,c,q,cutoff,n)
        c(n)<=(c(cutoff)*q^(-cutoff))*q^n=A*q^n
        abs(c(n))<=A*q^n
        release thm positive_start_geometric_magnitude_upper_bound_gives_root_bound(start,c,A,q,n)
        reference(n)=\rs::real_tail_scaled<1,\standard::positive_base_nth_root_tail<A>,q>(n)=q*\standard::positive_base_nth_root_tail<A>(n)=q*\standard::positive_base_nth_root_tail<A>(n)=\standard::positive_base_nth_root_tail<A>(n)*q
        \main::positive_start_real_tail_root_magnitudes<start,c>(n)<=\standard::positive_base_nth_root_tail<A>(n)*q=reference(n)
        \main::positive_start_real_tail_root_magnitudes<start,c>(n)<=reference(n)
    release thm nonnegative_real_tail_eventual_comparison_bounds_limsup(start,1,\main::positive_start_real_tail_root_magnitudes<start,c>,reference,cutoff)
    \limits::real_tail_limsup<1>(reference)=q
    $xreal::extended_real_le(\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,c>),q)

thm positive_start_ratio_lower_bound_bounds_root_liminf:
    ? forall start N+,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},q R+,cutoff {j Z:j>=start}:
        forall n {j Z:j>=start}:
            n>=cutoff
            =>:
                \positive_real_tail_successive_ratios<start,c>(n)>=q
        =>:
            $xreal::extended_real_le(q,\limits::real_tail_liminf<start>(\main::positive_start_real_tail_root_magnitudes<start,c>))
    $is_strictly_positive_real_tail(start,c)
    start>=1
    cutoff $in Z
    cutoff $in R
    cutoff>=start>=1
    cutoff>=1
    cutoff $in {j Z:j>=1 and j>=start}
    c(cutoff)>0
    c(cutoff) $in R+
    release thm power::positive_real_power_is_positive(q,-cutoff)
    c(cutoff)*q^(-cutoff)>0
    have A R+=c(cutoff)*q^(-cutoff)
    have reference fn(n {j Z:j>=1}) R=\rs::real_tail_scaled<1,\standard::positive_base_nth_root_tail<A>,q>
    release thm standard::positive_base_nth_root_tail_limit(A)
    release thm rs::real_tail_scaled_limit(1,\standard::positive_base_nth_root_tail<A>,1,q)
    1*q=q
    $rs::has_real_tail_limit(1,reference,q)
    release thm limits::real_tail_limit_equals_extremal_limits(1,reference,q)
    claim:
        ? forall n {j Z:j>=1}:
            reference(n)>=0
        n $in Z
        n>=1
        n>0
        n!=0
        n $in R*
        1/n>0
        1/n $in R+
        release thm power::positive_real_power_is_positive(A,1/n)
        \standard::positive_base_nth_root_tail<A>(n)=A^(1/n)
        \standard::positive_base_nth_root_tail<A>(n)>0
        q>0
        reference(n)=\rs::real_tail_scaled<1,\standard::positive_base_nth_root_tail<A>,q>(n)=q*\standard::positive_base_nth_root_tail<A>(n)>0
        reference(n)>=0
    claim:
        ? forall n {j Z:j>=start}:
            \main::positive_start_real_tail_root_magnitudes<start,c>(n)>=0
        release thm main::positive_start_real_tail_root_power(start,c,n)
    claim:
        ? forall n {j Z:j>=cutoff}:
            reference(n)<=\main::positive_start_real_tail_root_magnitudes<start,c>(n)
        n $in {j Z:j>=start}
        n $in {j Z:j>=1}
        n>=cutoff
        c(n)>0
        abs(c(n))=c(n)
        release thm positive_real_tail_ratio_lower_bound_gives_geometric_envelope(start,c,q,cutoff,n)
        c(n)>=(c(cutoff)*q^(-cutoff))*q^n=A*q^n
        abs(c(n))>=A*q^n
        release thm positive_start_geometric_magnitude_lower_bound_gives_root_bound(start,c,A,q,n)
        reference(n)=\rs::real_tail_scaled<1,\standard::positive_base_nth_root_tail<A>,q>(n)=q*\standard::positive_base_nth_root_tail<A>(n)=q*\standard::positive_base_nth_root_tail<A>(n)=\standard::positive_base_nth_root_tail<A>(n)*q
        reference(n)=\standard::positive_base_nth_root_tail<A>(n)*q<=\main::positive_start_real_tail_root_magnitudes<start,c>(n)
        reference(n)<=\main::positive_start_real_tail_root_magnitudes<start,c>(n)
    release thm nonnegative_real_tail_eventual_comparison_bounds_liminf(1,start,reference,\main::positive_start_real_tail_root_magnitudes<start,c>,cutoff)
    \limits::real_tail_liminf<1>(reference)=q
    $xreal::extended_real_le(q,\limits::real_tail_liminf<start>(\main::positive_start_real_tail_root_magnitudes<start,c>))

thm positive_start_ratio_limsup_bounds_root_limsup:
    ? forall start N+,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}:
        $xreal::extended_real_le(\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,c>),\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,c>))
    claim:
        ? forall n {j Z:j>=start}:
            \positive_real_tail_successive_ratios<start,c>(n)>=0
        release thm positive_real_tail_successive_ratio_value(start,c,n)
        \positive_real_tail_successive_ratios<start,c>(n)>0
        \positive_real_tail_successive_ratios<start,c>(n)>=0
    claim:
        ? forall n {j Z:j>=start}:
            \main::positive_start_real_tail_root_magnitudes<start,c>(n)>=0
        release thm main::positive_start_real_tail_root_power(start,c,n)
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(start,\positive_real_tail_successive_ratios<start,c>)
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(start,\main::positive_start_real_tail_root_magnitudes<start,c>)
    have ratio_sup xreal::ExtendedReal=\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,c>)
    have root_sup xreal::ExtendedReal=\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,c>)
    by contra:
        ? $xreal::extended_real_le(root_sup,ratio_sup)
        release thm extended_real_not_le_gives_reverse_strict_order(root_sup,ratio_sup)
        $xreal::extended_real_le(0,ratio_sup)
        release thm nonnegative_extended_strict_pair_has_positive_real_between(ratio_sup,root_sup)
        obtain q from exist r R+ st {$xreal::extended_real_lt(ratio_sup,r) and $xreal::extended_real_lt(r,root_sup)}
        release thm limits::real_tail_limsup_eventually_below(start,\positive_real_tail_successive_ratios<start,c>,q)
        obtain cutoff from exist k {j Z:j>=start} st {$limits::is_real_tail_below_after(start,\positive_real_tail_successive_ratios<start,c>,q,k)}
        claim:
            ? forall n {j Z:j>=start}:
                n>=cutoff
                =>:
                    \positive_real_tail_successive_ratios<start,c>(n)<=q
            $xreal::extended_real_lt(\positive_real_tail_successive_ratios<start,c>(n),q)
            release thm limits::extended_strict_order_on_reals(\positive_real_tail_successive_ratios<start,c>(n),q)
            \positive_real_tail_successive_ratios<start,c>(n)<=q
        release thm positive_start_ratio_upper_bound_bounds_root_limsup(start,c,q,cutoff)
        $xreal::extended_real_le(root_sup,q)
        $xreal::extended_real_lt(q,root_sup)
        $xreal::extended_real_le(q,root_sup)
        q!=root_sup
        release thm xreal::extended_real_order_antisymmetric(q,root_sup)
        impossible q!=root_sup

thm positive_start_ratio_liminf_bounds_root_liminf:
    ? forall start N+,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}:
        $xreal::extended_real_le(\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,c>),\limits::real_tail_liminf<start>(\main::positive_start_real_tail_root_magnitudes<start,c>))
    claim:
        ? forall n {j Z:j>=start}:
            \positive_real_tail_successive_ratios<start,c>(n)>=0
        release thm positive_real_tail_successive_ratio_value(start,c,n)
        \positive_real_tail_successive_ratios<start,c>(n)>0
        \positive_real_tail_successive_ratios<start,c>(n)>=0
    claim:
        ? forall n {j Z:j>=start}:
            \main::positive_start_real_tail_root_magnitudes<start,c>(n)>=0
        release thm main::positive_start_real_tail_root_power(start,c,n)
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(start,\positive_real_tail_successive_ratios<start,c>)
    release thm main::nonnegative_real_tail_has_nonnegative_extremal_limits(start,\main::positive_start_real_tail_root_magnitudes<start,c>)
    have ratio_inf xreal::ExtendedReal=\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,c>)
    have root_inf xreal::ExtendedReal=\limits::real_tail_liminf<start>(\main::positive_start_real_tail_root_magnitudes<start,c>)
    by contra:
        ? $xreal::extended_real_le(ratio_inf,root_inf)
        release thm extended_real_not_le_gives_reverse_strict_order(ratio_inf,root_inf)
        $xreal::extended_real_le(0,root_inf)
        release thm nonnegative_extended_strict_pair_has_positive_real_between(root_inf,ratio_inf)
        obtain q from exist r R+ st {$xreal::extended_real_lt(root_inf,r) and $xreal::extended_real_lt(r,ratio_inf)}
        release thm limits::real_tail_liminf_eventually_above(start,\positive_real_tail_successive_ratios<start,c>,q)
        obtain cutoff from exist k {j Z:j>=start} st {$limits::is_real_tail_above_after(start,\positive_real_tail_successive_ratios<start,c>,q,k)}
        claim:
            ? forall n {j Z:j>=start}:
                n>=cutoff
                =>:
                    \positive_real_tail_successive_ratios<start,c>(n)>=q
            $xreal::extended_real_lt(q,\positive_real_tail_successive_ratios<start,c>(n))
            release thm limits::extended_strict_order_on_reals(q,\positive_real_tail_successive_ratios<start,c>(n))
            \positive_real_tail_successive_ratios<start,c>(n)>=q
        release thm positive_start_ratio_lower_bound_bounds_root_liminf(start,c,q,cutoff)
        $xreal::extended_real_le(q,root_inf)
        $xreal::extended_real_lt(root_inf,q)
        $xreal::extended_real_le(root_inf,q)
        root_inf!=q
        release thm xreal::extended_real_order_antisymmetric(root_inf,q)
        impossible root_inf!=q

thm positive_start_real_tail_ratio_root_extrema_chain:
    ? forall start N+,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}:
        $xreal::extended_real_le(\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,c>),\limits::real_tail_liminf<start>(\main::positive_start_real_tail_root_magnitudes<start,c>))
        $xreal::extended_real_le(\limits::real_tail_liminf<start>(\main::positive_start_real_tail_root_magnitudes<start,c>),\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,c>))
        $xreal::extended_real_le(\limits::real_tail_limsup<start>(\main::positive_start_real_tail_root_magnitudes<start,c>),\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,c>))
    release thm positive_start_ratio_liminf_bounds_root_liminf(start,c)
    release thm limits::real_tail_liminf_le_limsup(start,\main::positive_start_real_tail_root_magnitudes<start,c>)
    release thm positive_start_ratio_limsup_bounds_root_limsup(start,c)

claim:
    ? forall start Z,cutoff {j Z:j>=start},n {j Z:j>=cutoff}:
        n $in {j Z:j>=start}
    n $in Z
    n>=cutoff
    cutoff>=start
    n>=cutoff>=start
    n>=start
    n $in {j Z:j>=start}

claim:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},cutoff {j Z:j>=start}:
        $is_strictly_positive_real_tail(cutoff,\limits::real_tail_restriction<start,c,cutoff>)
    $is_strictly_positive_real_tail(start,c)
    claim:
        ? forall n {j Z:j>=cutoff}:
            \limits::real_tail_restriction<start,c,cutoff>(n)>0
        n $in {j Z:j>=start}
        c(n)>0
        \limits::real_tail_restriction<start,c,cutoff>(n)=c(n)>0
    by def $is_strictly_positive_real_tail(cutoff,\limits::real_tail_restriction<start,c,cutoff>)

claim:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},cutoff {j Z:j>=start}:
        \limits::real_tail_restriction<start,c,cutoff> $in {f fn(n {j Z:j>=cutoff}) R:$is_strictly_positive_real_tail(cutoff,f)}
    release thm fn_set_member(\limits::real_tail_restriction<start,c,cutoff>,fn(n {j Z:j>=cutoff}) R)
    \limits::real_tail_restriction<start,c,cutoff> $in fn(n {j Z:j>=cutoff}) R
    $is_strictly_positive_real_tail(cutoff,\limits::real_tail_restriction<start,c,cutoff>)
    \limits::real_tail_restriction<start,c,cutoff> $in {f fn(n {j Z:j>=cutoff}) R:$is_strictly_positive_real_tail(cutoff,f)}

thm positive_real_tail_ratios_commute_with_restriction:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},cutoff {j Z:j>=start}:
        \positive_real_tail_successive_ratios<cutoff,\limits::real_tail_restriction<start,c,cutoff>> = \limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,cutoff>
    $is_strictly_positive_real_tail(start,c)
    $is_strictly_positive_real_tail(cutoff,\limits::real_tail_restriction<start,c,cutoff>)
    release thm fn_set_member(\positive_real_tail_successive_ratios<cutoff,\limits::real_tail_restriction<start,c,cutoff>>,fn(n {j Z:j>=cutoff}) R)
    release thm fn_set_member(\limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,cutoff>,fn(n {j Z:j>=cutoff}) R)
    claim:
        ? forall n {j Z:j>=cutoff}:
            \positive_real_tail_successive_ratios<cutoff,\limits::real_tail_restriction<start,c,cutoff>>(n)=\limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,cutoff>(n)
        n $in {j Z:j>=start}
        n+1 $in {j Z:j>=cutoff}
        n+1 $in {j Z:j>=start}
        c(n)>0
        c(n)!=0
        \limits::real_tail_restriction<start,c,cutoff>(n)=c(n)>0
        \limits::real_tail_restriction<start,c,cutoff>(n)!=0
        \limits::real_tail_restriction<start,c,cutoff>(n+1)=c(n+1)
        release thm positive_real_tail_successive_ratio_value(cutoff,\limits::real_tail_restriction<start,c,cutoff>,n)
        release thm positive_real_tail_successive_ratio_value(start,c,n)
        \positive_real_tail_successive_ratios<cutoff,\limits::real_tail_restriction<start,c,cutoff>>(n)=\limits::real_tail_restriction<start,c,cutoff>(n+1)/\limits::real_tail_restriction<start,c,cutoff>(n)=c(n+1)/c(n)=\positive_real_tail_successive_ratios<start,c>(n)=\limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,cutoff>(n)
    by fn_extension \positive_real_tail_successive_ratios<cutoff,\limits::real_tail_restriction<start,c,cutoff>> = \limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,cutoff>

thm real_tail_ratio_root_extrema_chain_after_positive_cutoff:
    ? forall start Z,c {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)},length {k N:start+k>=1}:
        $xreal::extended_real_le(\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,c>),\limits::real_tail_liminf<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,c,start+length>>))
        $xreal::extended_real_le(\limits::real_tail_liminf<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,c,start+length>>),\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,c,start+length>>))
        $xreal::extended_real_le(\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,c,start+length>>),\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,c>))
    start+length $in N+
    start+length $in {j Z:j>=start}
    $is_strictly_positive_real_tail(start+length,\limits::real_tail_restriction<start,c,start+length>)
    release thm positive_start_real_tail_ratio_root_extrema_chain(start+length,\limits::real_tail_restriction<start,c,start+length>)
    release thm positive_real_tail_ratios_commute_with_restriction(start,c,start+length)
    claim:
        ? forall n {j Z:j>=start}:
            \positive_real_tail_successive_ratios<start,c>(n)>=0
        release thm positive_real_tail_successive_ratio_value(start,c,n)
        \positive_real_tail_successive_ratios<start,c>(n)>0
        \positive_real_tail_successive_ratios<start,c>(n)>=0
    length $in N
    release thm nonnegative_real_tail_extremal_limits_ignore_finite_prefix(start,\positive_real_tail_successive_ratios<start,c>,length)
    \limits::real_tail_liminf<start+length>(\positive_real_tail_successive_ratios<start+length,\limits::real_tail_restriction<start,c,start+length>>)=\limits::real_tail_liminf<start+length>(\limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,start+length>)=\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,c>)
    \limits::real_tail_limsup<start+length>(\positive_real_tail_successive_ratios<start+length,\limits::real_tail_restriction<start,c,start+length>>)=\limits::real_tail_limsup<start+length>(\limits::real_tail_restriction<start,\positive_real_tail_successive_ratios<start,c>,start+length>)=\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,c>)
    $xreal::extended_real_le(\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,c>),\limits::real_tail_liminf<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,c,start+length>>))
    $xreal::extended_real_le(\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,c,start+length>>),\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,c>))

prop is_nonvanishing_real_tail(start Z,a fn(n {j Z:j>=start}) R):
    forall n {j Z:j>=start}:
        a(n)!=0

thm nonzero_real_absolute_value_is_positive:
    ? forall x R*:
        abs(x)>0
        abs(x) $in R+
    x $in R
    x!=0
    by cases:
        ? abs(x)>0
        case x>=0:
            x>0
            abs(x)=x
            abs(x)>0
        case x<0:
            -x>0
            abs(x)=-x
            abs(x)>0
    abs(x) $in R+

thm nonvanishing_real_tail_absolute_values_are_strictly_positive:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}:
        $is_strictly_positive_real_tail(start,\limits::real_tail_absolute_values<start,a>)
    claim:
        ? forall n {j Z:j>=start}:
            \limits::real_tail_absolute_values<start,a>(n)>0
        $is_nonvanishing_real_tail(start,a)
        a(n)!=0
        a(n) $in R*
        release thm nonzero_real_absolute_value_is_positive(a(n))
        \limits::real_tail_absolute_values<start,a>(n)=abs(a(n))
        \limits::real_tail_absolute_values<start,a>(n)>0
    by def $is_strictly_positive_real_tail(start,\limits::real_tail_absolute_values<start,a>)

claim:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}:
        \limits::real_tail_absolute_values<start,a> $in {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}
    release thm fn_set_member(\limits::real_tail_absolute_values<start,a>,fn(n {j Z:j>=start}) R)
    release thm nonvanishing_real_tail_absolute_values_are_strictly_positive(start,a)
    \limits::real_tail_absolute_values<start,a> $in {f fn(n {j Z:j>=start}) R:$is_strictly_positive_real_tail(start,f)}

template<start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}>:
    have fn real_tail_absolute_successive_ratios(n {j Z:j>=start}) R+=\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>(n)

claim:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)},n {j Z:j>=start}:
        abs(a(n))>0
        abs(a(n))!=0
        abs(a(n)) $in R+
        abs(a(n)) $in R*
        abs(a(n+1))>0
        abs(a(n+1))!=0
        abs(a(n+1)) $in R+
    $is_nonvanishing_real_tail(start,a)
    n+1 $in {j Z:j>=start}
    a(n)!=0
    a(n) $in R*
    a(n+1)!=0
    a(n+1) $in R*
    release thm nonzero_real_absolute_value_is_positive(a(n))
    release thm nonzero_real_absolute_value_is_positive(a(n+1))
    abs(a(n))>0
    abs(a(n))!=0
    abs(a(n)) $in R+
    abs(a(n)) $in R*
    abs(a(n+1))>0
    abs(a(n+1))!=0
    abs(a(n+1)) $in R+

thm real_tail_absolute_successive_ratio_value:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)},n {j Z:j>=start}:
        \real_tail_absolute_successive_ratios<start,a>(n)=abs(a(n+1))/abs(a(n))
        \real_tail_absolute_successive_ratios<start,a>(n)>0
    n+1 $in {j Z:j>=start}
    \limits::real_tail_absolute_values<start,a>(n)=abs(a(n))
    \limits::real_tail_absolute_values<start,a>(n+1)=abs(a(n+1))
    abs(a(n))>0
    abs(a(n))!=0
    abs(a(n)) $in R*
    \limits::real_tail_absolute_values<start,a>(n)>0
    \limits::real_tail_absolute_values<start,a>(n)!=0
    \limits::real_tail_absolute_values<start,a>(n) $in R*
    release thm positive_real_tail_successive_ratio_value(start,\limits::real_tail_absolute_values<start,a>,n)
    \real_tail_absolute_successive_ratios<start,a>(n)=\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>(n)=abs(a(n+1))/abs(a(n))
    \real_tail_absolute_successive_ratios<start,a>(n)>0

claim:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}:
        \real_tail_absolute_successive_ratios<start,a> $in fn(n {j Z:j>=start}) R
    release thm fn_set_member(\real_tail_absolute_successive_ratios<start,a>,fn(n {j Z:j>=start}) R)

thm absolute_successive_ratios_are_positive_absolute_data_ratios:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}:
        \real_tail_absolute_successive_ratios<start,a> = \positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>
    release thm fn_set_member(\real_tail_absolute_successive_ratios<start,a>,fn(n {j Z:j>=start}) R)
    release thm fn_set_member(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>,fn(n {j Z:j>=start}) R)
    claim:
        ? forall n {j Z:j>=start}:
            \real_tail_absolute_successive_ratios<start,a>(n)=\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>(n)
        \real_tail_absolute_successive_ratios<start,a>(n)=\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>(n)
    by fn_extension \real_tail_absolute_successive_ratios<start,a> = \positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>

thm positive_start_roots_commute_with_absolute_values:
    ? forall start N+,a fn(n {j Z:j>=start}) R:
        \main::positive_start_real_tail_root_magnitudes<start,\limits::real_tail_absolute_values<start,a>> = \main::positive_start_real_tail_root_magnitudes<start,a>
    release thm fn_set_member(\main::positive_start_real_tail_root_magnitudes<start,\limits::real_tail_absolute_values<start,a>>,fn(n {j Z:j>=start}) R)
    release thm fn_set_member(\main::positive_start_real_tail_root_magnitudes<start,a>,fn(n {j Z:j>=start}) R)
    claim:
        ? forall n {j Z:j>=start}:
            \main::positive_start_real_tail_root_magnitudes<start,\limits::real_tail_absolute_values<start,a>>(n)=\main::positive_start_real_tail_root_magnitudes<start,a>(n)
        n $in N+
        \limits::real_tail_absolute_values<start,a>(n)=abs(a(n))
        abs(abs(a(n)))=abs(a(n))
        release thm main::positive_start_real_tail_root_power(start,\limits::real_tail_absolute_values<start,a>,n)
        release thm main::positive_start_real_tail_root_power(start,a,n)
        release thm power::nonnegative_real_root_unique(abs(a(n)),\main::positive_start_real_tail_root_magnitudes<start,\limits::real_tail_absolute_values<start,a>>(n),n)
        release thm power::nonnegative_real_root_unique(abs(a(n)),\main::positive_start_real_tail_root_magnitudes<start,a>(n),n)
        \main::positive_start_real_tail_root_magnitudes<start,\limits::real_tail_absolute_values<start,a>>(n)=abs(a(n))^(1/n)=\main::positive_start_real_tail_root_magnitudes<start,a>(n)
    by fn_extension \main::positive_start_real_tail_root_magnitudes<start,\limits::real_tail_absolute_values<start,a>> = \main::positive_start_real_tail_root_magnitudes<start,a>

thm real_tail_restricted_roots_commute_with_absolute_values:
    ? forall start Z,a fn(n {j Z:j>=start}) R,length {k N:start+k>=1}:
        \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>> = \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>
    start+length $in N+
    start+length $in {j Z:j>=start}
    release thm fn_set_member(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>,fn(n {j Z:j>=start+length}) R)
    release thm fn_set_member(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>,fn(n {j Z:j>=start+length}) R)
    claim:
        ? forall n {j Z:j>=start+length}:
            \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>(n)=\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>(n)
        n $in N+
        n>=start+length>=start
        n $in {j Z:j>=start}
        \limits::real_tail_restriction<start,a,start+length>(n)=a(n)
        \limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>(n)=\limits::real_tail_absolute_values<start,a>(n)=abs(a(n))
        abs(abs(a(n)))=abs(a(n))
        release thm main::positive_start_real_tail_root_power(start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>,n)
        release thm main::positive_start_real_tail_root_power(start+length,\limits::real_tail_restriction<start,a,start+length>,n)
        \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>(n)^n=abs(a(n))
        \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>(n)^n=abs(a(n))
        release thm power::nonnegative_real_root_unique(abs(a(n)),\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>(n),n)
        release thm power::nonnegative_real_root_unique(abs(a(n)),\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>(n),n)
        \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>(n)=abs(a(n))^(1/n)=\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>(n)
    by fn_extension \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>> = \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>

thm real_tail_series_absolute_ratio_limsup_below_one_converges:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}:
        $xreal::extended_real_lt(\limits::real_tail_limsup<start>(\real_tail_absolute_successive_ratios<start,a>),1)
        =>:
            $ts::is_absolutely_convergent_real_tail_series(start,a)
            $ts::is_convergent_real_tail_series(start,a)
    release thm integer_tail_has_positive_cutoff_length(start)
    obtain length from exist k {j N:start+j>=1} st {start+k $in N+}
    length $in N
    start+length>=1
    length $in {k N:start+k>=1}
    release thm absolute_successive_ratios_are_positive_absolute_data_ratios(start,a)
    \real_tail_absolute_successive_ratios<start,a> = \positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>
    \limits::real_tail_limsup<start>(\real_tail_absolute_successive_ratios<start,a>) = \limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>)
    release thm real_tail_ratio_root_extrema_chain_after_positive_cutoff(start,\limits::real_tail_absolute_values<start,a>,length)
    $xreal::extended_real_lt(\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>),1)
    release thm limits::extended_real_le_lt_transitive(\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>),\limits::real_tail_limsup<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>),1)
    release thm real_tail_series_root_limsup_below_one_converges(start,\limits::real_tail_absolute_values<start,a>,length)
    $ts::is_convergent_real_tail_series(start,\limits::real_tail_absolute_values<start,a>)
    by def $ts::is_absolutely_convergent_real_tail_series(start,a)
    release thm ts::absolutely_convergent_real_tail_series_converges(start,a)

thm real_tail_series_absolute_ratio_liminf_above_one_diverges:
    ? forall start Z,a {f fn(n {j Z:j>=start}) R:$is_nonvanishing_real_tail(start,f)}:
        $xreal::extended_real_lt(1,\limits::real_tail_liminf<start>(\real_tail_absolute_successive_ratios<start,a>))
        =>:
            not $ts::is_convergent_real_tail_series(start,a)
            not $ts::is_absolutely_convergent_real_tail_series(start,a)
    release thm integer_tail_has_positive_cutoff_length(start)
    obtain length from exist k {j N:start+j>=1} st {start+k $in N+}
    length $in N
    start+length>=1
    length $in {k N:start+k>=1}
    release thm absolute_successive_ratios_are_positive_absolute_data_ratios(start,a)
    \real_tail_absolute_successive_ratios<start,a> = \positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>
    \limits::real_tail_liminf<start>(\real_tail_absolute_successive_ratios<start,a>) = \limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>)
    release thm real_tail_ratio_root_extrema_chain_after_positive_cutoff(start,\limits::real_tail_absolute_values<start,a>,length)
    $xreal::extended_real_lt(1,\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>))
    release thm xreal::extended_real_order_transitive(\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>),\limits::real_tail_liminf<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>),\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>))
    release thm limits::extended_real_lt_le_transitive(1,\limits::real_tail_liminf<start>(\positive_real_tail_successive_ratios<start,\limits::real_tail_absolute_values<start,a>>),\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>))
    release thm real_tail_restricted_roots_commute_with_absolute_values(start,a,length)
    \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>> = \main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>
    \limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,\limits::real_tail_absolute_values<start,a>,start+length>>) = \limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>)
    $xreal::extended_real_lt(1,\limits::real_tail_limsup<start+length>(\main::positive_start_real_tail_root_magnitudes<start+length,\limits::real_tail_restriction<start,a,start+length>>))
    release thm real_tail_series_root_limsup_above_one_diverges(start,a,length)

have fn positive_integer_value_tail(n {j Z:j>=1}) R+=n

claim:
    ? positive_integer_value_tail $in {f fn(n {j Z:j>=1}) R:$is_strictly_positive_real_tail(1,f)}
    release thm fn_set_member(positive_integer_value_tail,fn(n {j Z:j>=1}) R)
    claim:
        ? forall n {j Z:j>=1}:
            positive_integer_value_tail(n)>0
        n>=1
        positive_integer_value_tail(n)=n>0
    by def $is_strictly_positive_real_tail(1,positive_integer_value_tail)
    positive_integer_value_tail $in {f fn(n {j Z:j>=1}) R:$is_strictly_positive_real_tail(1,f)}

release obj def rs::positive_real_reciprocal_tail

thm positive_integer_successive_ratios_are_one_plus_reciprocal:
    ? \positive_real_tail_successive_ratios<1,positive_integer_value_tail> = \rs::real_tail_sum<1,\rs::real_tail_constant<1,1>,rs::positive_real_reciprocal_tail>
    release thm fn_set_member(\positive_real_tail_successive_ratios<1,positive_integer_value_tail>,fn(n {j Z:j>=1}) R)
    release thm fn_set_member(\rs::real_tail_sum<1,\rs::real_tail_constant<1,1>,rs::positive_real_reciprocal_tail>,fn(n {j Z:j>=1}) R)
    claim:
        ? forall n {j Z:j>=1}:
            \positive_real_tail_successive_ratios<1,positive_integer_value_tail>(n)=\rs::real_tail_sum<1,\rs::real_tail_constant<1,1>,rs::positive_real_reciprocal_tail>(n)
        n $in R+
        n!=0
        n $in R*
        n+1 $in {j Z:j>=1}
        positive_integer_value_tail(n)=n
        positive_integer_value_tail(n+1)=n+1
        release thm positive_real_tail_successive_ratio_value(1,positive_integer_value_tail,n)
        \rs::real_tail_constant<1,1>(n)=1
        rs::positive_real_reciprocal_tail(n)=1/n
        \positive_real_tail_successive_ratios<1,positive_integer_value_tail>(n)=(n+1)/n=1+1/n=\rs::real_tail_constant<1,1>(n)+rs::positive_real_reciprocal_tail(n)=\rs::real_tail_sum<1,\rs::real_tail_constant<1,1>,rs::positive_real_reciprocal_tail>(n)
    by fn_extension \positive_real_tail_successive_ratios<1,positive_integer_value_tail> = \rs::real_tail_sum<1,\rs::real_tail_constant<1,1>,rs::positive_real_reciprocal_tail>

thm positive_integer_successive_ratios_tend_to_one:
    ? $rs::has_real_tail_limit(1,\positive_real_tail_successive_ratios<1,positive_integer_value_tail>,1)
    release thm rs::real_tail_constant_limit(1,1)
    release thm rs::positive_real_reciprocal_tail_limit
    release thm rs::real_tail_sum_limit(1,\rs::real_tail_constant<1,1>,rs::positive_real_reciprocal_tail,1,0)
    release thm positive_integer_successive_ratios_are_one_plus_reciprocal
    1+0=1
    $rs::has_real_tail_limit(1,\positive_real_tail_successive_ratios<1,positive_integer_value_tail>,1)

thm positive_integer_root_magnitudes_tend_to_one:
    ? $rs::has_real_tail_limit(1,\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>,1)
    release thm positive_integer_successive_ratios_tend_to_one
    release thm limits::real_tail_limit_equals_extremal_limits(1,\positive_real_tail_successive_ratios<1,positive_integer_value_tail>,1)
    release thm positive_start_real_tail_ratio_root_extrema_chain(1,positive_integer_value_tail)
    \limits::real_tail_liminf<1>(\positive_real_tail_successive_ratios<1,positive_integer_value_tail>)=1
    \limits::real_tail_limsup<1>(\positive_real_tail_successive_ratios<1,positive_integer_value_tail>)=1
    have root_inf xreal::ExtendedReal=\limits::real_tail_liminf<1>(\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>)
    have root_sup xreal::ExtendedReal=\limits::real_tail_limsup<1>(\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>)
    $xreal::extended_real_le(1,root_inf)
    $xreal::extended_real_le(root_inf,root_sup)
    $xreal::extended_real_le(root_sup,1)
    release thm xreal::extended_real_order_transitive(1,root_inf,root_sup)
    release thm xreal::extended_real_order_antisymmetric(1,root_sup)
    root_sup=1
    $xreal::extended_real_le(root_inf,1)
    release thm xreal::extended_real_order_antisymmetric(1,root_inf)
    root_inf=1
    \limits::real_tail_limsup<1>(\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>)=1
    \limits::real_tail_liminf<1>(\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>)=1
    release thm limits::equal_finite_real_tail_extremal_limits_give_limit(1,\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>,1)

claim:
    ? forall n {j Z:j>=1}:
        n $in R+
        n!=0
        n $in R*
        1/n $in R+
    n>=1
    n>0
    n $in R+
    n!=0
    n $in R*
    1/n>0
    1/n $in R+

claim:
    ? forall n {j Z:j>=1}:
        n^(1/n) $in R+
    n $in N+
    n $in R
    n $in R+
    n>=0
    n!=0
    n $in R*
    1/n $in R
    release thm power::nonnegative_real_root_is_real(n,n)
    release thm power::positive_real_power_is_positive(n,1/n)
    n^(1/n) $in R+

have fn positive_index_nth_root_tail(n {j Z:j>=1}) R+=n^(1/n)

claim:
    ? positive_index_nth_root_tail $in fn(n {j Z:j>=1}) R
    release thm fn_set_member(positive_index_nth_root_tail,fn(n {j Z:j>=1}) R)

thm positive_index_nth_roots_are_integer_root_magnitudes:
    ? positive_index_nth_root_tail = \main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>
    release thm fn_set_member(positive_index_nth_root_tail,fn(n {j Z:j>=1}) R)
    release thm fn_set_member(\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>,fn(n {j Z:j>=1}) R)
    claim:
        ? forall n {j Z:j>=1}:
            positive_index_nth_root_tail(n)=\main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>(n)
        n $in N+
        n>0
        n $in R+
        n!=0
        n $in R*
        positive_integer_value_tail(n)=n
        abs(positive_integer_value_tail(n))=n
        positive_integer_value_tail(n)!=0
        \main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>(n)=abs(positive_integer_value_tail(n))^(1/n)=n^(1/n)=positive_index_nth_root_tail(n)
    by fn_extension positive_index_nth_root_tail = \main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>

thm positive_index_nth_root_tail_tends_to_one:
    ? $rs::has_real_tail_limit(1,positive_index_nth_root_tail,1)
    release thm positive_integer_root_magnitudes_tend_to_one
    release thm positive_index_nth_roots_are_integer_root_magnitudes
    positive_index_nth_root_tail = \main::positive_start_real_tail_root_magnitudes<1,positive_integer_value_tail>
    $rs::has_real_tail_limit(1,positive_index_nth_root_tail,1)
