        c(n) $in R+
        c(n) $in R*
        c(n+1)>0
        c(n+1)!=0
        c(n+1) $in R+
        c(n+1) $in R*
    $is_strictly_positive_real_tail(start,c)
    n+1 $in {j Z:j>=start}
    c(n)>0
    c(n)!=0
    c(n) $in R+
    c(n) $in R*
    c(n+1)>0
    c(n+1)!=0
    c(n+1) $in R+
    c(n+1) $in R*

