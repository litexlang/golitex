# Integer, zero-ring and real-field consumers of the unital-ring library.

have fn integer_add(x,y Z) Z = x+y

have fn integer_neg(x Z) Z = -x

have fn integer_mul(x,y Z) Z = x*y

forall x,y,z Z:
    integer_add(integer_add(x,y),z)=integer_add(x,integer_add(y,z))
    integer_mul(integer_mul(x,y),z)=integer_mul(x,integer_mul(y,z))
    integer_mul(x,integer_add(y,z))=integer_add(integer_mul(x,y),integer_mul(x,z))
    integer_mul(integer_add(x,y),z)=integer_add(integer_mul(x,z),integer_mul(y,z))

forall x,y Z:
    integer_add(x,y)=integer_add(y,x)

forall x Z:
    integer_add(0,x)=x
    integer_add(x,integer_neg(x))=0
    integer_mul(1,x)=x
    integer_mul(x,1)=x

have integers &ring::Ring<Z> = (0,1,integer_add,integer_neg,integer_mul)

release struct def integers

release thm ring::mul_zero(Z,integers,3)

release thm ring::neg_mul_neg(Z,integers,3,4)

release thm ring::whole_ring_is_ideal(Z,integers)

release thm ring::zero_singleton_is_ideal(Z,integers)

release thm ring::ideal_intersection(Z,integers,Z,{integers.zero})

release thm ring::ideal_containing_one_is_whole(Z,integers,Z)

have fn identity(x Z) Z = x

by def $ring::is_ring_homomorphism(Z,integers,Z,integers,identity)

release thm ring::ring_homomorphism_zero(Z,integers,Z,integers,identity)

release thm ring::ring_homomorphism_neg(Z,integers,Z,integers,identity,3)

release thm ring::ring_homomorphism_composition(Z,integers,Z,integers,Z,integers,identity,identity)

release thm ring::ring_kernel_is_ideal(Z,integers,Z,integers,identity)

release thm ring::ring_homomorphism_ideal_preimage(Z,integers,Z,integers,identity,{integers.zero})

claim:
    ? forall x,y Z:
        identity(x)=identity(y)
        =>:
            x=y
    identity(x)=x
    identity(y)=y

by def $injective(Z,Z,identity)

release thm ring::injective_ring_homomorphism_kernel(Z,integers,Z,integers,identity)

release thm ring::trivial_ring_kernel_implies_injective(Z,integers,Z,integers,identity)

have fn zero_add(x,y {0}) {0} = 0

have fn zero_neg(x {0}) {0} = 0

have fn zero_mul(x,y {0}) {0} = 0

forall x,y,z {0}:
    zero_add(zero_add(x,y),z)=zero_add(x,zero_add(y,z))
    zero_mul(zero_mul(x,y),z)=zero_mul(x,zero_mul(y,z))
    zero_mul(x,zero_add(y,z))=zero_add(zero_mul(x,y),zero_mul(x,z))
    zero_mul(zero_add(x,y),z)=zero_add(zero_mul(x,z),zero_mul(y,z))

forall x,y {0}:
    zero_add(x,y)=zero_add(y,x)

forall x {0}:
    zero_add(0,x)=x
    zero_add(x,zero_neg(x))=0
    zero_mul(0,x)=x
    zero_mul(x,0)=x

0 $in {0}

zero_add $in fn(x,y {0}) {0}

zero_neg $in fn(x {0}) {0}

zero_mul $in fn(x,y {0}) {0}

have trivial &ring::Ring<{0}> = (0,0,zero_add,zero_neg,zero_mul)

release struct def trivial

release thm ring::zero_one_equal_implies_trivial({0},trivial,0)

have fn to_zero(x Z) {0} = 0

by def $ring::is_ring_homomorphism(Z,integers,{0},trivial,to_zero)

release thm ring::ring_kernel_is_ideal(Z,integers,{0},trivial,to_zero)

have fn real_add(x,y R) R = x+y

have fn real_neg(x R) R = -x

have fn real_mul(x,y R) R = x*y

have fn real_inv(x R:x!=0) R = 1/x

forall x,y,z R:
    real_add(real_add(x,y),z)=real_add(x,real_add(y,z))
    real_mul(real_mul(x,y),z)=real_mul(x,real_mul(y,z))
    real_mul(x,real_add(y,z))=real_add(real_mul(x,y),real_mul(x,z))

forall x,y R:
    real_add(x,y)=real_add(y,x)
    real_mul(x,y)=real_mul(y,x)

forall x R:
    real_add(0,x)=x
    real_add(x,real_neg(x))=0
    real_mul(1,x)=x

forall x R:
    x!=0
    =>:
        real_mul(x,real_inv(x))=1

have real_field &fld::Field<R> = (0,1,real_add,real_neg,real_mul,real_inv)

release struct def real_field

release thm ring::field_has_ring_structure(R,real_field)

\ring::field_ring<R,real_field> = (real_field.zero,real_field.one,real_field.add,real_field.neg,real_field.mul)

have real_ring &ring::Ring<R> = \ring::field_ring<R,real_field>

release struct def real_ring

release thm ring::mul_zero(R,real_ring,3)

thm generic_kernel_caller:
    ? forall K nonempty_set,S &ring::Ring<K>,L nonempty_set,T &ring::Ring<L>,f fn(x K) L:
        $ring::is_ring_homomorphism(K,S,L,T,f)
        =>:
            $ring::is_two_sided_ideal(K,S,\ring::ring_kernel<K,L,T,f>)
    release thm ring::ring_kernel_is_ideal(K,S,L,T,f)

thm generic_injective_caller:
    ? forall K nonempty_set,S &ring::Ring<K>,L nonempty_set,T &ring::Ring<L>,f fn(x K) L:
        $ring::is_ring_homomorphism(K,S,L,T,f)
        \ring::ring_kernel<K,L,T,f> = {S.zero}
        =>:
            $injective(K,L,f)
    release thm ring::trivial_ring_kernel_implies_injective(K,S,L,T,f)
