# LADR 1.28 and 1.32: selected inverses over actual imported spaces.

release obj def Algebra::field::real_add

release obj def Algebra::field::real_mul

release obj def Algebra::field::real_neg

release obj def Algebra::field::real_field

release obj def Algebra::field::complex_mul

release obj def Algebra::field::complex_neg

release obj def Algebra::field::complex_field

release struct def Algebra::field::real_field

release struct def Algebra::field::complex_field

release thm Algebra::finite_span::coordinate_space_carrier(R,Algebra::field::real_field,2)

have plane &Algebra::vector_space::VectorSpace<R,Algebra::field::real_field,finite_seq(R,2)> = \Algebra::finite_span::coordinate_space<R,Algebra::field::real_field,2>

\Algebra::finite_span::coordinate_space<R,Algebra::field::real_field,2> = (\Algebra::finite_span::zero_coefficients<R,Algebra::field::real_field,2>,\Algebra::finite_span::add_coefficients<R,Algebra::field::real_field,2>,\Algebra::finite_span::smul_coefficients<R,Algebra::field::real_field,2>)

plane = (\Algebra::finite_span::zero_coefficients<R,Algebra::field::real_field,2>,\Algebra::finite_span::add_coefficients<R,Algebra::field::real_field,2>,\Algebra::finite_span::smul_coefficients<R,Algebra::field::real_field,2>)

plane.smul = \Algebra::finite_span::smul_coefficients<R,Algebra::field::real_field,2>

Algebra::field::real_field.one=1

Algebra::field::real_field.neg(Algebra::field::real_field.one)=Algebra::field::real_neg(1)=-1

have u finite_seq(R,2)=fn(k closed_range(1,2)) R {k}

release thm Algebra::vector_space::minus_one_times_vector(R,Algebra::field::real_field,finite_seq(R,2),plane,u)

have inverse finite_seq(R,2)=\Algebra::vector_space::vector_neg<R,Algebra::field::real_field,finite_seq(R,2),plane>(u)

inverse=plane.smul(Algebra::field::real_field.neg(Algebra::field::real_field.one),u)=plane.smul(-1,u)=\Algebra::finite_span::smul_coefficients<R,Algebra::field::real_field,2>(-1,u)

release thm Algebra::finite_span::smul_coefficients_entry(R,Algebra::field::real_field,2,-1,u,inverse,2)

u(2)=2

inverse(2)=Algebra::field::real_field.mul(-1,u(2))=Algebra::field::real_mul(-1,2)=-2

release thm Algebra::finite_span::coordinate_space_carrier(C,Algebra::field::complex_field,2)

have complex_plane &Algebra::vector_space::VectorSpace<C,Algebra::field::complex_field,finite_seq(C,2)> = \Algebra::finite_span::coordinate_space<C,Algebra::field::complex_field,2>

\Algebra::finite_span::coordinate_space<C,Algebra::field::complex_field,2> = (\Algebra::finite_span::zero_coefficients<C,Algebra::field::complex_field,2>,\Algebra::finite_span::add_coefficients<C,Algebra::field::complex_field,2>,\Algebra::finite_span::smul_coefficients<C,Algebra::field::complex_field,2>)

complex_plane = (\Algebra::finite_span::zero_coefficients<C,Algebra::field::complex_field,2>,\Algebra::finite_span::add_coefficients<C,Algebra::field::complex_field,2>,\Algebra::finite_span::smul_coefficients<C,Algebra::field::complex_field,2>)

complex_plane.smul = \Algebra::finite_span::smul_coefficients<C,Algebra::field::complex_field,2>

Algebra::field::complex_field.one=1

Algebra::field::complex_field.neg(Algebra::field::complex_field.one)=Algebra::field::complex_neg(1)=-1

have z finite_seq(C,2)=fn(k closed_range(1,2)) C {k+i}

release thm Algebra::vector_space::minus_one_times_vector(C,Algebra::field::complex_field,finite_seq(C,2),complex_plane,z)

have inverse_z finite_seq(C,2)=\Algebra::vector_space::vector_neg<C,Algebra::field::complex_field,finite_seq(C,2),complex_plane>(z)

inverse_z=complex_plane.smul(Algebra::field::complex_field.neg(Algebra::field::complex_field.one),z)=complex_plane.smul(-1,z)=\Algebra::finite_span::smul_coefficients<C,Algebra::field::complex_field,2>(-1,z)

release thm Algebra::finite_span::smul_coefficients_entry(C,Algebra::field::complex_field,2,-1,z,inverse_z,2)

z(2)=2+i

inverse_z(2)=Algebra::field::complex_field.mul(-1,z(2))=Algebra::field::complex_mul(-1,2+i)=-2-i

release thm Algebra::finite_span::coordinate_space_carrier(R,Algebra::field::real_field,0)

have empty_space &Algebra::vector_space::VectorSpace<R,Algebra::field::real_field,finite_seq(R,0)> = \Algebra::finite_span::coordinate_space<R,Algebra::field::real_field,0>

have empty_vector finite_seq(R,0)=fn(k closed_range(1,0)) R {0}

have negative_empty finite_seq(R,0)=\Algebra::vector_space::vector_neg<R,Algebra::field::real_field,finite_seq(R,0),empty_space>(empty_vector)

by fn_extension negative_empty=empty_vector

claim:
    ? forall K nonempty_set,F &Algebra::field::Field<K>,V nonempty_set,space &Algebra::vector_space::VectorSpace<K,F,V>,x V:
        \Algebra::vector_space::vector_difference<K,F,V,space>(x,x)=space.zero
    release thm Algebra::vector_space::vector_neg_spec(K,F,V,space,x)
    \Algebra::vector_space::vector_difference<K,F,V,space>(x,x)=space.add(x,\Algebra::vector_space::vector_neg<K,F,V,space>(x))=space.zero
