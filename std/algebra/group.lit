# Groups, subgroups and homomorphism kernels.
# Multiplication need not be commutative; the trivial group is allowed.

struct Group<A nonempty_set>:
    mul fn(x, y A) A
    one A
    inv fn(x A) A
    <=>:
        forall x, y, z A:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x A:
            mul(one, x) = x
            mul(x, one) = x
            mul(inv(x), x) = one
            mul(x, inv(x)) = one

prop is_abelian(A nonempty_set, G &Group<A>):
    forall x, y A:
        G.mul(x, y) = G.mul(y, x)

thm identity_unique:
    ? forall A nonempty_set, G &Group<A>, identity_candidate A:
        forall x A:
            G.mul(identity_candidate, x) = x
        =>:
            identity_candidate = G.one
    identity_candidate = G.mul(identity_candidate, G.one) = G.one

thm inverse_unique:
    ? forall A nonempty_set, G &Group<A>, a, b A:
        G.mul(b, a) = G.one
        =>:
            b = G.inv(a)
    G.mul(a, G.inv(a)) = G.one
    b = G.mul(b, G.one) = G.mul(b, G.mul(a, G.inv(a))) = G.mul(G.mul(b, a), G.inv(a)) = G.mul(G.one, G.inv(a)) = G.inv(a)

thm left_cancel:
    ? forall A nonempty_set, G &Group<A>, a, b, c A:
        G.mul(a, b) = G.mul(a, c)
        =>:
            b = c
    G.mul(G.inv(a), a) = G.one
    b = G.mul(G.one, b) = G.mul(G.mul(G.inv(a), a), b) = G.mul(G.inv(a), G.mul(a, b)) = G.mul(G.inv(a), G.mul(a, c)) = G.mul(G.mul(G.inv(a), a), c) = G.mul(G.one, c) = c

thm right_cancel:
    ? forall A nonempty_set, G &Group<A>, a, b, c A:
        G.mul(b, a) = G.mul(c, a)
        =>:
            b = c
    G.mul(a, G.inv(a)) = G.one
    b = G.mul(b, G.one) = G.mul(b, G.mul(a, G.inv(a))) = G.mul(G.mul(b, a), G.inv(a)) = G.mul(G.mul(c, a), G.inv(a)) = G.mul(c, G.mul(a, G.inv(a))) = G.mul(c, G.one) = c

thm left_equation_unique:
    ? forall A nonempty_set, G &Group<A>, a, b A:
        exist! x A st {G.mul(a, x) = b}
    G.mul(a, G.inv(a)) = G.one
    G.mul(a, G.mul(G.inv(a), b)) = G.mul(G.mul(a, G.inv(a)), b) = G.mul(G.one, b) = b
    claim:
        ? forall x, y A:
            G.mul(a, x) = b
            G.mul(a, y) = b
            =>:
                x = y
        by thm left_cancel(A, G, a, x, y) => x = y
    witness exist! x A st {G.mul(a, x) = b} from G.mul(G.inv(a), b)

prop is_subgroup(A nonempty_set, G &Group<A>, S power_set(A)):
    G.one $in S
    forall x, y S:
        G.mul(x, y) $in S
    forall x S:
        G.inv(x) $in S

thm subgroup_intersection:
    ? forall A nonempty_set, G &Group<A>, S, T power_set(A):
        $is_subgroup(A, G, S)
        $is_subgroup(A, G, T)
        =>:
            $is_subgroup(A, G, intersect(S, T))
    claim:
        ? forall x, y intersect(S, T):
            G.mul(x, y) $in intersect(S, T)
        G.mul(x, y) $in S
        G.mul(x, y) $in T
    claim:
        ? forall x intersect(S, T):
            G.inv(x) $in intersect(S, T)
        G.inv(x) $in S
        G.inv(x) $in T
    by def $is_subgroup(A, G, intersect(S, T))

prop is_homomorphism(A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B):
    forall x, y A:
        f(G.mul(x, y)) = H.mul(f(x), f(y))

thm homomorphism_identity:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        =>:
            f(G.one) = H.one
    G.mul(G.one, G.one) = G.one
    H.mul(f(G.one), f(G.one)) = f(G.mul(G.one, G.one)) = f(G.one) = H.mul(f(G.one), H.one)
    by thm left_cancel(B, H, f(G.one), f(G.one), H.one) => f(G.one) = H.one

thm homomorphism_inverse:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B, x A:
        $is_homomorphism(A, G, B, H, f)
        =>:
            f(G.inv(x)) = H.inv(f(x))
    by thm homomorphism_identity(A, G, B, H, f) => f(G.one) = H.one
    G.mul(G.inv(x), x) = G.one
    H.mul(f(G.inv(x)), f(x)) = f(G.mul(G.inv(x), x)) = f(G.one) = H.one
    by thm inverse_unique(B, H, f(x), f(G.inv(x))) => f(G.inv(x)) = H.inv(f(x))

template<A nonempty_set, B nonempty_set, H &Group<B>, f fn(x A) B>:
    have kernel power_set(A) = {x A: f(x) = H.one}

prop is_normal_subgroup(A nonempty_set, G &Group<A>, S power_set(A)):
    $is_subgroup(A, G, S)
    forall a A, s S:
        G.mul(G.mul(a, s), G.inv(a)) $in S

thm abelian_subgroups_are_normal:
    ? forall A nonempty_set, G &Group<A>, S power_set(A):
        $is_abelian(A, G)
        $is_subgroup(A, G, S)
        =>:
            $is_normal_subgroup(A, G, S)
    claim:
        ? forall a A, s S:
            G.mul(G.mul(a, s), G.inv(a)) $in S
        G.mul(a, G.inv(a)) = G.one
        G.mul(a, s) = G.mul(s, a)
        G.mul(G.mul(a, s), G.inv(a)) = G.mul(G.mul(s, a), G.inv(a)) = G.mul(s, G.mul(a, G.inv(a))) = G.mul(s, G.one) = s
    by def $is_normal_subgroup(A, G, S)

thm kernel_is_normal:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        =>:
            $is_normal_subgroup(A, G, \kernel<A, B, H, f>)
    \kernel<A, B, H, f> = {x A: f(x) = H.one}
    \kernel<A, B, H, f> $subset A
    by thm homomorphism_identity(A, G, B, H, f) => f(G.one) = H.one
    release thm set_builder_member(G.one, {x A: f(x) = H.one})
    claim:
        ? forall x, y \kernel<A, B, H, f>:
            G.mul(x, y) $in \kernel<A, B, H, f>
        f(G.mul(x, y)) = H.mul(f(x), f(y)) = H.mul(H.one, H.one) = H.one
        release thm set_builder_member(G.mul(x, y), {z A: f(z) = H.one})
    claim:
        ? forall x \kernel<A, B, H, f>:
            G.inv(x) $in \kernel<A, B, H, f>
        by thm inverse_unique(B, H, H.one, H.one) => H.one = H.inv(H.one)
        by thm homomorphism_inverse(A, G, B, H, f, x) => f(G.inv(x)) = H.inv(f(x))
        f(G.inv(x)) = H.inv(f(x)) = H.inv(H.one) = H.one
        release thm set_builder_member(G.inv(x), {z A: f(z) = H.one})
    by def $is_subgroup(A, G, \kernel<A, B, H, f>)
    claim:
        ? forall a A, s \kernel<A, B, H, f>:
            G.mul(G.mul(a, s), G.inv(a)) $in \kernel<A, B, H, f>
        f(G.mul(a, s)) = H.mul(f(a), f(s)) = H.mul(f(a), H.one) = f(a)
        by thm homomorphism_inverse(A, G, B, H, f, a) => f(G.inv(a)) = H.inv(f(a))
        f(G.mul(G.mul(a, s), G.inv(a))) = H.mul(f(G.mul(a, s)), f(G.inv(a))) = H.mul(f(a), f(G.inv(a))) = H.mul(f(a), H.inv(f(a))) = H.one
        release thm set_builder_member(G.mul(G.mul(a, s), G.inv(a)), {z A: f(z) = H.one})
    by def $is_normal_subgroup(A, G, \kernel<A, B, H, f>)

prop has_trivial_kernel(A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B):
    forall x A:
        f(x) = H.one
        =>:
            x = G.one

thm trivial_kernel_implies_injective:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        $has_trivial_kernel(A, G, B, H, f)
        =>:
            $injective(A, B, f)
    claim:
        ? forall x, y A:
            f(x) = f(y)
            =>:
                x = y
        by thm homomorphism_inverse(A, G, B, H, f, y) => f(G.inv(y)) = H.inv(f(y))
        f(G.mul(G.inv(y), x)) = H.mul(f(G.inv(y)), f(x)) = H.mul(H.inv(f(y)), f(x)) = H.mul(H.inv(f(y)), f(y)) = H.one
        G.mul(G.inv(y), x) = G.one
        G.mul(G.inv(y), y) = G.one
        by thm left_cancel(A, G, G.inv(y), x, y) => x = y
    by def $injective(A, B, f)

thm injective_implies_trivial_kernel:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        $injective(A, B, f)
        =>:
            $has_trivial_kernel(A, G, B, H, f)
    by thm homomorphism_identity(A, G, B, H, f) => f(G.one) = H.one
    by def $has_trivial_kernel(A, G, B, H, f)

thm subgroup_whole:
    ? forall A nonempty_set,G &Group<A>:
        $is_subgroup(A,G,A)
    by def $is_subgroup(A,G,A)

thm subgroup_identity:
    ? forall A nonempty_set,G &Group<A>:
        $is_subgroup(A,G,{G.one})
    release thm inverse_unique(A,G,G.one,G.one)
    claim:
        ? forall x,y {G.one}:
            G.mul(x,y) $in {G.one}
        x = G.one
        y = G.one
        G.mul(x,y) = G.mul(G.one,G.one) = G.one
    claim:
        ? forall x {G.one}:
            G.inv(x) $in {G.one}
        x = G.one
        G.inv(x) = G.inv(G.one) = G.one
    by def $is_subgroup(A,G,{G.one})

thm normal_subgroup_intersection:
    ? forall A nonempty_set,G &Group<A>,S,T power_set(A):
        $is_normal_subgroup(A,G,S)
        $is_normal_subgroup(A,G,T)
        =>:
            $is_normal_subgroup(A,G,intersect(S,T))
    release thm subgroup_intersection(A,G,S,T)
    claim:
        ? forall a A,s intersect(S,T):
            G.mul(G.mul(a,s),G.inv(a)) $in intersect(S,T)
        G.mul(G.mul(a,s),G.inv(a)) $in S
        G.mul(G.mul(a,s),G.inv(a)) $in T
    by def $is_normal_subgroup(A,G,intersect(S,T))

thm homomorphism_range_is_subgroup:
    ? forall A nonempty_set,G &Group<A>,B nonempty_set,H &Group<B>,f fn(x A) B:
        $is_homomorphism(A,G,B,H,f)
        =>:
            $is_subgroup(B,H,fn_range(f))
    release thm homomorphism_identity(A,G,B,H,f)
    f(G.one) $in fn_range(f)
    H.one = f(G.one)
    claim:
        ? forall u,v fn_range(f):
            H.mul(u,v) $in fn_range(f)
        have by fn_preimage: x from u $in fn_range(f)
        have by fn_preimage: y from v $in fn_range(f)
        H.mul(u,v) = H.mul(f(x),f(y)) = f(G.mul(x,y))
        f(G.mul(x,y)) $in fn_range(f)
    claim:
        ? forall u fn_range(f):
            H.inv(u) $in fn_range(f)
        have by fn_preimage: x from u $in fn_range(f)
        release thm homomorphism_inverse(A,G,B,H,f,x)
        H.inv(u) = H.inv(f(x)) = f(G.inv(x))
        f(G.inv(x)) $in fn_range(f)
    by def $is_subgroup(B,H,fn_range(f))

thm homomorphism_preimage_is_subgroup:
    ? forall A nonempty_set,G &Group<A>,B nonempty_set,H &Group<B>,f fn(x A) B,S power_set(B):
        $is_homomorphism(A,G,B,H,f)
        $is_subgroup(B,H,S)
        =>:
            $is_subgroup(A,G,preimage_set(f,S))
    release thm homomorphism_identity(A,G,B,H,f)
    f(G.one) = H.one
    G.one $in preimage_set(f,S)
    claim:
        ? forall x,y preimage_set(f,S):
            G.mul(x,y) $in preimage_set(f,S)
        x $in A
        y $in A
        f(x) $in S
        f(y) $in S
        f(G.mul(x,y)) = H.mul(f(x),f(y))
        H.mul(f(x),f(y)) $in S
        G.mul(x,y) $in preimage_set(f,S)
    claim:
        ? forall x preimage_set(f,S):
            G.inv(x) $in preimage_set(f,S)
        x $in A
        f(x) $in S
        release thm homomorphism_inverse(A,G,B,H,f,x)
        f(G.inv(x)) = H.inv(f(x))
        H.inv(f(x)) $in S
        G.inv(x) $in preimage_set(f,S)
    by def $is_subgroup(A,G,preimage_set(f,S))

thm homomorphism_preimage_is_normal:
    ? forall A nonempty_set,G &Group<A>,B nonempty_set,H &Group<B>,f fn(x A) B,S power_set(B):
        $is_homomorphism(A,G,B,H,f)
        $is_normal_subgroup(B,H,S)
        =>:
            $is_normal_subgroup(A,G,preimage_set(f,S))
    release thm homomorphism_preimage_is_subgroup(A,G,B,H,f,S)
    claim:
        ? forall a A,s preimage_set(f,S):
            G.mul(G.mul(a,s),G.inv(a)) $in preimage_set(f,S)
        s $in A
        f(s) $in S
        release thm homomorphism_inverse(A,G,B,H,f,a)
        f(G.mul(a,s)) = H.mul(f(a),f(s))
        f(G.mul(G.mul(a,s),G.inv(a))) = H.mul(f(G.mul(a,s)),f(G.inv(a))) = H.mul(H.mul(f(a),f(s)),H.inv(f(a)))
        H.mul(H.mul(f(a),f(s)),H.inv(f(a))) $in S
        G.mul(G.mul(a,s),G.inv(a)) $in preimage_set(f,S)
    by def $is_normal_subgroup(A,G,preimage_set(f,S))

thm homomorphism_identity_map:
    ? forall A nonempty_set,G &Group<A>:
        $is_homomorphism(A,G,A,G,fn(x A) A {x})
    by def $is_homomorphism(A,G,A,G,fn(x A) A {x})

thm homomorphism_composition:
    ? forall A nonempty_set,G &Group<A>,B nonempty_set,H &Group<B>,D nonempty_set,K &Group<D>,f fn(x A) B,g fn(y B) D:
        $is_homomorphism(A,G,B,H,f)
        $is_homomorphism(B,H,D,K,g)
        =>:
            $is_homomorphism(A,G,D,K,compose(g,f))
    claim:
        ? forall x,y A:
            compose(g,f)(G.mul(x,y)) = K.mul(compose(g,f)(x),compose(g,f)(y))
        f(G.mul(x,y)) = H.mul(f(x),f(y))
        compose(g,f)(x) = g(f(x))
        compose(g,f)(y) = g(f(y))
        compose(g,f)(G.mul(x,y)) = g(f(G.mul(x,y))) = g(H.mul(f(x),f(y))) = K.mul(g(f(x)),g(f(y))) = K.mul(compose(g,f)(x),compose(g,f)(y))
    by def $is_homomorphism(A,G,D,K,compose(g,f))

thm normal_subgroup_whole:
    ? forall A nonempty_set,G &Group<A>:
        $is_normal_subgroup(A,G,A)
    release thm subgroup_whole(A,G)
    by def $is_normal_subgroup(A,G,A)

thm normal_subgroup_identity:
    ? forall A nonempty_set,G &Group<A>:
        $is_normal_subgroup(A,G,{G.one})
    release thm subgroup_identity(A,G)
    claim:
        ? forall a A,s {G.one}:
            G.mul(G.mul(a,s),G.inv(a)) $in {G.one}
        s = G.one
        G.mul(a,s) = G.mul(a,G.one) = a
        G.mul(G.mul(a,s),G.inv(a)) = G.mul(a,G.inv(a)) = G.one
    by def $is_normal_subgroup(A,G,{G.one})

thm homomorphism_subgroup_image:
    ? forall A nonempty_set,G &Group<A>,B nonempty_set,H &Group<B>,f fn(x A) B,S power_set(A):
        $is_homomorphism(A,G,B,H,f)
        $is_subgroup(A,G,S)
        =>:
            $is_subgroup(B,H,fn_range(fn(t S) B {f(t)}))
    release thm homomorphism_identity(A,G,B,H,f)
    fn(t S) B {f(t)}(G.one) = f(G.one) = H.one
    fn(t S) B {f(t)}(G.one) $in fn_range(fn(t S) B {f(t)})
    claim:
        ? forall u,v fn_range(fn(t S) B {f(t)}):
            H.mul(u,v) $in fn_range(fn(t S) B {f(t)})
        have by fn_preimage: s1 from u $in fn_range(fn(t S) B {f(t)})
        have by fn_preimage: s2 from v $in fn_range(fn(t S) B {f(t)})
        G.mul(s1,s2) $in S
        u = fn(t S) B {f(t)}(s1) = f(s1)
        v = fn(t S) B {f(t)}(s2) = f(s2)
        fn(t S) B {f(t)}(G.mul(s1,s2)) = f(G.mul(s1,s2)) = H.mul(f(s1),f(s2)) = H.mul(u,v)
        fn(t S) B {f(t)}(G.mul(s1,s2)) $in fn_range(fn(t S) B {f(t)})
    claim:
        ? forall u fn_range(fn(t S) B {f(t)}):
            H.inv(u) $in fn_range(fn(t S) B {f(t)})
        have by fn_preimage: s from u $in fn_range(fn(t S) B {f(t)})
        G.inv(s) $in S
        release thm homomorphism_inverse(A,G,B,H,f,s)
        u = fn(t S) B {f(t)}(s) = f(s)
        fn(t S) B {f(t)}(G.inv(s)) = f(G.inv(s)) = H.inv(f(s)) = H.inv(u)
        fn(t S) B {f(t)}(G.inv(s)) $in fn_range(fn(t S) B {f(t)})
    by def $is_subgroup(B,H,fn_range(fn(t S) B {f(t)}))

thm surjective_homomorphism_normal_image:
    ? forall A nonempty_set,G &Group<A>,B nonempty_set,H &Group<B>,f fn(x A) B,S power_set(A):
        $is_homomorphism(A,G,B,H,f)
        $is_normal_subgroup(A,G,S)
        $surjective(A,B,f)
        =>:
            $is_normal_subgroup(B,H,fn_range(fn(t S) B {f(t)}))
    release thm homomorphism_subgroup_image(A,G,B,H,f,S)
    claim:
        ? forall b B,u fn_range(fn(t S) B {f(t)}):
            H.mul(H.mul(b,u),H.inv(b)) $in fn_range(fn(t S) B {f(t)})
        obtain a from exist a A st {b=f(a)}
        have by fn_preimage: s from u $in fn_range(fn(t S) B {f(t)})
        u = fn(t S) B {f(t)}(s) = f(s)
        G.mul(G.mul(a,s),G.inv(a)) $in S
        release thm homomorphism_inverse(A,G,B,H,f,a)
        H.mul(b,u) = H.mul(f(a),f(s)) = f(G.mul(a,s))
        H.inv(b) = H.inv(f(a)) = f(G.inv(a))
        H.mul(H.mul(b,u),H.inv(b)) = H.mul(f(G.mul(a,s)),f(G.inv(a))) = f(G.mul(G.mul(a,s),G.inv(a))) = fn(t S) B {f(t)}(G.mul(G.mul(a,s),G.inv(a)))
        fn(t S) B {f(t)}(G.mul(G.mul(a,s),G.inv(a))) $in fn_range(fn(t S) B {f(t)})
    by def $is_normal_subgroup(B,H,fn_range(fn(t S) B {f(t)}))

thm kernel_of_composition:
    ? forall A nonempty_set,B nonempty_set,D nonempty_set,K &Group<D>,f fn(x A) B,g fn(y B) D:
        \kernel<A,D,K,compose(g,f)> = preimage_set(f,\kernel<B,D,K,g>)
    \kernel<A,D,K,compose(g,f)> = {x A:compose(g,f)(x)=K.one}
    \kernel<B,D,K,g> = {y B:g(y)=K.one}
    by extension:
        ? \kernel<A,D,K,compose(g,f)> = preimage_set(f,\kernel<B,D,K,g>)
        claim:
            ? forall x \kernel<A,D,K,compose(g,f)>:
                x $in preimage_set(f,\kernel<B,D,K,g>)
            x $in A
            compose(g,f)(x) = K.one
            g(f(x)) = compose(g,f)(x) = K.one
            release thm set_builder_member(f(x),{y B:g(y)=K.one})
            f(x) $in \kernel<B,D,K,g>
            x $in preimage_set(f,\kernel<B,D,K,g>)
        claim:
            ? forall x preimage_set(f,\kernel<B,D,K,g>):
                x $in \kernel<A,D,K,compose(g,f)>
            x $in A
            f(x) $in \kernel<B,D,K,g>
            g(f(x)) = K.one
            compose(g,f)(x) = g(f(x)) = K.one
            release thm set_builder_member(x,{y A:compose(g,f)(y)=K.one})

thm inverse_identity:
    ? forall A nonempty_set,G &Group<A>:
        G.inv(G.one) = G.one
    release thm inverse_unique(A,G,G.one,G.one)

thm inverse_involution:
    ? forall A nonempty_set,G &Group<A>,a A:
        G.inv(G.inv(a)) = a
    release thm inverse_unique(A,G,G.inv(a),a)

thm right_inverse_unique:
    ? forall A nonempty_set,G &Group<A>,a,b A:
        G.mul(a,b) = G.one
        =>:
            b = G.inv(a)
    G.mul(a,b) = G.one = G.mul(a,G.inv(a))
    release thm left_cancel(A,G,a,b,G.inv(a))

thm inverse_product:
    ? forall A nonempty_set,G &Group<A>,a,b A:
        G.inv(G.mul(a,b)) = G.mul(G.inv(b),G.inv(a))
    G.mul(G.inv(a),a) = G.one
    G.mul(G.inv(a),G.mul(a,b)) = G.mul(G.mul(G.inv(a),a),b) = G.mul(G.one,b) = b
    G.mul(G.mul(G.inv(b),G.inv(a)),G.mul(a,b)) = G.mul(G.inv(b),G.mul(G.inv(a),G.mul(a,b))) = G.mul(G.inv(b),b) = G.one
    release thm inverse_unique(A,G,G.mul(a,b),G.mul(G.inv(b),G.inv(a)))

thm right_equation_unique:
    ? forall A nonempty_set,G &Group<A>,a,b A:
        exist! x A st {G.mul(x,a)=b}
    G.mul(G.inv(a),a) = G.one
    G.mul(G.mul(b,G.inv(a)),a) = G.mul(b,G.mul(G.inv(a),a)) = G.mul(b,G.one) = b
    claim:
        ? forall x,y A:
            G.mul(x,a) = b
            G.mul(y,a) = b
            =>:
                x = y
        release thm right_cancel(A,G,a,x,y)
    witness exist! x A st {G.mul(x,a)=b} from G.mul(b,G.inv(a))

thm commuting_inverses:
    ? forall A nonempty_set,G &Group<A>,a,b A:
        G.mul(a,b) = G.mul(b,a)
        =>:
            G.mul(G.inv(a),G.inv(b)) = G.mul(G.inv(b),G.inv(a))
    release thm inverse_product(A,G,a,b)
    release thm inverse_product(A,G,b,a)
    G.mul(G.inv(a),G.inv(b)) = G.inv(G.mul(b,a)) = G.inv(G.mul(a,b)) = G.mul(G.inv(b),G.inv(a))
