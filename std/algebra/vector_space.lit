# Vector spaces and linear maps over a supplied field.
# Derived source theorems; no additional assumptions or native rules.

struct VectorSpace<K nonempty_set, field &field::Field<K>, V nonempty_set>:
    zero V
    add fn(x, y V) V
    smul fn(a K, x V) V
    <=>:
        forall x, y, z V:
            add(add(x, y), z) = add(x, add(y, z))
        forall x, y V:
            add(x, y) = add(y, x)
        forall x V:
            add(zero, x) = x
            exist y V st {add(x, y) = zero}
        forall a, b K, x V:
            smul(field.mul(a, b), x) = smul(a, smul(b, x))
            smul(field.add(a, b), x) = add(smul(a, x), smul(b, x))
        forall a K, x, y V:
            smul(a, add(x, y)) = add(smul(a, x), smul(a, y))
        forall x V:
            smul(field.one, x) = x

thm additive_identity_unique:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, identity_candidate V:
        forall x V:
            space.add(identity_candidate, x) = x
        =>:
            identity_candidate = space.zero
    space.add(identity_candidate, space.zero) = space.zero
    space.add(identity_candidate, space.zero) = space.add(space.zero, identity_candidate) = identity_candidate

thm additive_inverse_exists_unique:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, x V:
        exist! y V st {space.add(x, y) = space.zero}
    obtain y from exist y V st {space.add(x, y) = space.zero}
    forall y1, y2 V:
        space.add(x, y1) = space.zero
        space.add(x, y2) = space.zero
        =>:
            space.add(y2, x) = space.add(x, y2) = space.zero
            y1 = space.add(space.zero, y1) = space.add(space.add(y2, x), y1) = space.add(y2, space.add(x, y1)) = space.add(y2, space.zero) = space.add(space.zero, y2) = y2
            y1 = y2
    witness exist! y2 V st {space.add(x, y2) = space.zero} from y

prop is_subspace(K nonempty_set, field &field::Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, U power_set(V)):
    space.zero $in U
    forall u, v V:
        u $in U
        v $in U
        =>:
            space.add(u, v) $in U
    forall a K, v V:
        v $in U
        =>:
            space.smul(a, v) $in U

thm zero_scalar_times_vector:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, x V:
        space.smul(field.zero, x) = space.zero
    have p V = space.smul(field.zero, x)
    field.add(field.zero, field.zero) = field.zero
    space.smul(field.add(field.zero, field.zero), x) = space.add(space.smul(field.zero, x), space.smul(field.zero, x))
    space.smul(field.add(field.zero, field.zero), x) = space.smul(field.zero, x) = p
    space.add(p, p) = p
    obtain inverse_p from exist inverse_p V st {space.add(p, inverse_p) = space.zero}
    p = space.add(space.zero, p) = space.add(p, space.zero) = space.add(p, space.add(p, inverse_p)) = space.add(space.add(p, p), inverse_p) = space.add(p, inverse_p) = space.zero

thm scalar_times_zero:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, a K:
        space.smul(a, space.zero) = space.zero
    have z V = space.smul(a, space.zero)
    space.add(space.zero, space.zero) = space.zero
    space.add(z, z) = space.smul(a, space.add(space.zero, space.zero)) = space.smul(a, space.zero) = z
    obtain inverse_z from exist inverse_z V st {space.add(z, inverse_z) = space.zero}
    z = space.add(space.zero, z) = space.add(z, space.zero) = space.add(z, space.add(z, inverse_z)) = space.add(space.add(z, z), inverse_z) = space.add(z, inverse_z) = space.zero

prop is_linear_map(K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>, T fn(x V) W):
    forall u, v V:
        T(source.add(u, v)) = target.add(T(u), T(v))
    forall a K, v V:
        T(source.smul(a, v)) = target.smul(a, T(v))

thm linear_map_zero:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>, T fn(x V) W:
        $is_linear_map(K, field, V, source, W, target, T)
        =>:
            T(source.zero) = target.zero
    have z W = T(source.zero)
    source.add(source.zero, source.zero) = source.zero
    target.add(z, z) = T(source.add(source.zero, source.zero)) = T(source.zero) = z
    obtain inverse_z from exist inverse_z W st {target.add(z, inverse_z) = target.zero}
    z = target.add(target.zero, z) = target.add(z, target.zero) = target.add(z, target.add(z, inverse_z)) = target.add(target.add(z, z), inverse_z) = target.add(z, inverse_z) = target.zero

template<V nonempty_set>:
    have fn identity(v V) V = v

thm identity_linear:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, space &VectorSpace<K, field, V>:
        $is_linear_map(K, field, V, space, V, space, \identity<V>)
    by def $is_linear_map(K, field, V, space, V, space, \identity<V>)

template<V nonempty_set, W nonempty_set, zero W>:
    have fn zero_map(v V) W = zero

thm zero_map_linear:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>:
        $is_linear_map(K, field, V, source, W, target, \zero_map<V, W, target.zero>)
    claim:
        ? forall a K, v V:
            \zero_map<V, W, target.zero>(source.smul(a, v)) = target.smul(a, \zero_map<V, W, target.zero>(v))
        by thm scalar_times_zero(K, field, W, target, a) => target.smul(a, target.zero) = target.zero
    claim:
        ? forall u, v V:
            \zero_map<V, W, target.zero>(source.add(u, v)) = target.add(\zero_map<V, W, target.zero>(u), \zero_map<V, W, target.zero>(v))
        \zero_map<V, W, target.zero>(u) = target.zero
        \zero_map<V, W, target.zero>(v) = target.zero
        target.add(\zero_map<V, W, target.zero>(u), \zero_map<V, W, target.zero>(v)) = target.add(target.zero, target.zero) = target.zero
    by def $is_linear_map(K, field, V, source, W, target, \zero_map<V, W, target.zero>)

template<U nonempty_set, V nonempty_set, W nonempty_set>:
    have fn map_compose(S fn(v V) W, T fn(u U) V) fn(u U) W = fn(u U) W {S(T(u))}

thm composition_linear:
    ? forall K nonempty_set, field &field::Field<K>, U nonempty_set, first &VectorSpace<K, field, U>, V nonempty_set, middle &VectorSpace<K, field, V>, W nonempty_set, last &VectorSpace<K, field, W>, T fn(u U) V, S fn(v V) W:
        $is_linear_map(K, field, U, first, V, middle, T)
        $is_linear_map(K, field, V, middle, W, last, S)
        =>:
            $is_linear_map(K, field, U, first, W, last, \map_compose<U, V, W>(S, T))
    claim:
        ? forall u, v U:
            \map_compose<U, V, W>(S, T)(first.add(u, v)) = last.add(\map_compose<U, V, W>(S, T)(u), \map_compose<U, V, W>(S, T)(v))
        \map_compose<U, V, W>(S, T)(u) = S(T(u))
        \map_compose<U, V, W>(S, T)(v) = S(T(v))
        T(first.add(u, v)) = middle.add(T(u), T(v))
        \map_compose<U, V, W>(S, T)(first.add(u, v)) = S(T(first.add(u, v))) = S(middle.add(T(u), T(v))) = last.add(S(T(u)), S(T(v))) = last.add(\map_compose<U, V, W>(S, T)(u), \map_compose<U, V, W>(S, T)(v))
    claim:
        ? forall a K, v U:
            \map_compose<U, V, W>(S, T)(first.smul(a, v)) = last.smul(a, \map_compose<U, V, W>(S, T)(v))
        \map_compose<U, V, W>(S, T)(v) = S(T(v))
        T(first.smul(a, v)) = middle.smul(a, T(v))
        \map_compose<U, V, W>(S, T)(first.smul(a, v)) = S(T(first.smul(a, v))) = S(middle.smul(a, T(v))) = last.smul(a, S(T(v))) = last.smul(a, \map_compose<U, V, W>(S, T)(v))
    by def $is_linear_map(K, field, U, first, W, last, \map_compose<U, V, W>(S, T))

thm kernel_is_subspace:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>, T fn(x V) W:
        $is_linear_map(K, field, V, source, W, target, T)
        =>:
            $is_subspace(K, field, V, source, preimage(T, target.zero))
    by thm linear_map_zero(K, field, V, source, W, target, T) => T(source.zero) = target.zero
    claim:
        ? forall u, v V:
            u $in preimage(T, target.zero)
            v $in preimage(T, target.zero)
            =>:
                source.add(u, v) $in preimage(T, target.zero)
        T(source.add(u, v)) = target.add(T(u), T(v)) = target.add(target.zero, target.zero) = target.zero
    claim:
        ? forall a K, v V:
            v $in preimage(T, target.zero)
            =>:
                source.smul(a, v) $in preimage(T, target.zero)
        by thm scalar_times_zero(K, field, W, target, a) => target.smul(a, target.zero) = target.zero
        T(source.smul(a, v)) = target.smul(a, T(v)) = target.smul(a, target.zero) = target.zero
    by def $is_subspace(K, field, V, source, preimage(T, target.zero))

claim:
    ? forall V nonempty_set, W nonempty_set, T fn(x V) W:
        fn_range(T) $in power_set(W)
    fn_range(T) $subset W

thm range_is_subspace:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>, T fn(x V) W:
        $is_linear_map(K, field, V, source, W, target, T)
        =>:
            $is_subspace(K, field, W, target, fn_range(T))
    by thm linear_map_zero(K, field, V, source, W, target, T) => T(source.zero) = target.zero
    T(source.zero) $in fn_range(T)
    claim:
        ? forall u, v W:
            u $in fn_range(T)
            v $in fn_range(T)
            =>:
                target.add(u, v) $in fn_range(T)
        have by fn_preimage: x from u $in fn_range(T)
        have by fn_preimage: y from v $in fn_range(T)
        T(source.add(x, y)) = target.add(T(x), T(y)) = target.add(u, v)
        T(source.add(x, y)) $in fn_range(T)
    claim:
        ? forall a K, v W:
            v $in fn_range(T)
            =>:
                target.smul(a, v) $in fn_range(T)
        have by fn_preimage: x from v $in fn_range(T)
        T(source.smul(a, x)) = target.smul(a, T(x)) = target.smul(a, v)
        T(source.smul(a, x)) $in fn_range(T)
    by def $is_subspace(K, field, W, target, fn_range(T))

thm injective_has_zero_kernel:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>, T fn(x V) W:
        $is_linear_map(K, field, V, source, W, target, T)
        $injective(V, W, T)
        =>:
            preimage(T, target.zero) = {source.zero}
    by thm linear_map_zero(K, field, V, source, W, target, T) => T(source.zero) = target.zero
    claim:
        ? forall x preimage(T, target.zero):
            x $in {source.zero}
        T(x) = target.zero = T(source.zero)
        x = source.zero
    forall x {source.zero}:
        x $in preimage(T, target.zero)
    by extension preimage(T, target.zero) = {source.zero}

thm zero_kernel_is_injective:
    ? forall K nonempty_set, field &field::Field<K>, V nonempty_set, source &VectorSpace<K, field, V>, W nonempty_set, target &VectorSpace<K, field, W>, T fn(x V) W:
        $is_linear_map(K, field, V, source, W, target, T)
        preimage(T, target.zero) = {source.zero}
        =>:
            $injective(V, W, T)
    by thm linear_map_zero(K, field, V, source, W, target, T) => T(source.zero) = target.zero
    claim:
        ? forall u, v V:
            T(u) = T(v)
            =>:
                u = v
        obtain inverse_v from exist inverse_v V st {source.add(v, inverse_v) = source.zero}
        T(source.add(v, inverse_v)) = T(source.zero) = target.zero
        target.add(T(v), T(inverse_v)) = T(source.add(v, inverse_v)) = target.zero
        T(source.add(u, inverse_v)) = target.add(T(u), T(inverse_v)) = target.add(T(v), T(inverse_v)) = target.zero
        source.add(u, inverse_v) $in preimage(T, target.zero)
        source.add(u, inverse_v) $in {source.zero}
        source.add(u, inverse_v) = source.zero
        source.add(inverse_v, v) = source.add(v, inverse_v) = source.zero
        u = source.add(source.zero, u) = source.add(u, source.zero) = source.add(u, source.add(inverse_v, v)) = source.add(source.add(u, inverse_v), v) = source.add(source.zero, v) = v
    by def $injective(V, W, T)

# Scalar-valued functions with pointwise operations over a supplied field.

template<K nonempty_set,F &field::Field<K>,X set>:
    have fn function_zero(x X) K = F.zero

template<K nonempty_set,F &field::Field<K>,X set>:
    have fn function_add(f,g fn(x X) K) fn(x X) K = fn(x X) K {F.add(f(x),g(x))}

template<K nonempty_set,F &field::Field<K>,X set>:
    have fn function_smul(a K,f fn(x X) K) fn(x X) K = fn(x X) K {F.mul(a,f(x))}

claim:
    ? forall K nonempty_set,F &field::Field<K>,X set:
        (\function_zero<K,F,X>,\function_add<K,F,X>,\function_smul<K,F,X>) $in &VectorSpace<K,F,fn(x X) K>
    claim:
        ? forall f,g,h fn(x X) K:
            \function_add<K,F,X>(\function_add<K,F,X>(f,g),h)=\function_add<K,F,X>(f,\function_add<K,F,X>(g,h))
        claim:
            ? forall p X:
                \function_add<K,F,X>(\function_add<K,F,X>(f,g),h)(p)=\function_add<K,F,X>(f,\function_add<K,F,X>(g,h))(p)
            \function_add<K,F,X>(f,g)(p)=F.add(f(p),g(p))
            \function_add<K,F,X>(g,h)(p)=F.add(g(p),h(p))
            \function_add<K,F,X>(\function_add<K,F,X>(f,g),h)(p)=F.add(F.add(f(p),g(p)),h(p))=F.add(f(p),F.add(g(p),h(p)))=\function_add<K,F,X>(f,\function_add<K,F,X>(g,h))(p)
        by fn_extension \function_add<K,F,X>(\function_add<K,F,X>(f,g),h)=\function_add<K,F,X>(f,\function_add<K,F,X>(g,h))
    claim:
        ? forall f,g fn(x X) K:
            \function_add<K,F,X>(f,g)=\function_add<K,F,X>(g,f)
        claim:
            ? forall p X:
                \function_add<K,F,X>(f,g)(p)=\function_add<K,F,X>(g,f)(p)
            \function_add<K,F,X>(f,g)(p)=F.add(f(p),g(p))=F.add(g(p),f(p))=\function_add<K,F,X>(g,f)(p)
        by fn_extension \function_add<K,F,X>(f,g)=\function_add<K,F,X>(g,f)
    claim:
        ? forall f fn(x X) K:
            \function_add<K,F,X>(\function_zero<K,F,X>,f)=f
            exist g fn(x X) K st {\function_add<K,F,X>(f,g)=\function_zero<K,F,X>}
        claim:
            ? forall p X:
                \function_add<K,F,X>(\function_zero<K,F,X>,f)(p)=f(p)
            \function_zero<K,F,X>(p)=F.zero
            \function_add<K,F,X>(\function_zero<K,F,X>,f)(p)=F.add(F.zero,f(p))=f(p)
        by fn_extension \function_add<K,F,X>(\function_zero<K,F,X>,f)=f
        have fn inverse(p X) K = F.neg(f(p))
        claim:
            ? forall p X:
                \function_add<K,F,X>(f,inverse)(p)=\function_zero<K,F,X>(p)
            inverse(p)=F.neg(f(p))
            \function_add<K,F,X>(f,inverse)(p)=F.add(f(p),F.neg(f(p)))=F.zero=\function_zero<K,F,X>(p)
        by fn_extension \function_add<K,F,X>(f,inverse)=\function_zero<K,F,X>
        witness exist g fn(x X) K st {\function_add<K,F,X>(f,g)=\function_zero<K,F,X>} from inverse
    claim:
        ? forall a,b K,f fn(x X) K:
            \function_smul<K,F,X>(F.mul(a,b),f)=\function_smul<K,F,X>(a,\function_smul<K,F,X>(b,f))
            \function_smul<K,F,X>(F.add(a,b),f)=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(b,f))
        claim:
            ? forall p X:
                \function_smul<K,F,X>(F.mul(a,b),f)(p)=\function_smul<K,F,X>(a,\function_smul<K,F,X>(b,f))(p)
            \function_smul<K,F,X>(b,f)(p)=F.mul(b,f(p))
            \function_smul<K,F,X>(F.mul(a,b),f)(p)=F.mul(F.mul(a,b),f(p))=F.mul(a,F.mul(b,f(p)))=\function_smul<K,F,X>(a,\function_smul<K,F,X>(b,f))(p)
        by fn_extension \function_smul<K,F,X>(F.mul(a,b),f)=\function_smul<K,F,X>(a,\function_smul<K,F,X>(b,f))
        claim:
            ? forall p X:
                \function_smul<K,F,X>(F.add(a,b),f)(p)=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(b,f))(p)
            by thm field::add_mul(K,F,a,b,f(p)) => F.mul(F.add(a,b),f(p))=F.add(F.mul(a,f(p)),F.mul(b,f(p)))
            \function_smul<K,F,X>(a,f)(p)=F.mul(a,f(p))
            \function_smul<K,F,X>(b,f)(p)=F.mul(b,f(p))
            \function_smul<K,F,X>(F.add(a,b),f)(p)=F.mul(F.add(a,b),f(p))=F.add(F.mul(a,f(p)),F.mul(b,f(p)))=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(b,f))(p)
        by fn_extension \function_smul<K,F,X>(F.add(a,b),f)=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(b,f))
    claim:
        ? forall a K,f,g fn(x X) K:
            \function_smul<K,F,X>(a,\function_add<K,F,X>(f,g))=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(a,g))
        claim:
            ? forall p X:
                \function_smul<K,F,X>(a,\function_add<K,F,X>(f,g))(p)=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(a,g))(p)
            \function_add<K,F,X>(f,g)(p)=F.add(f(p),g(p))
            \function_smul<K,F,X>(a,f)(p)=F.mul(a,f(p))
            \function_smul<K,F,X>(a,g)(p)=F.mul(a,g(p))
            \function_smul<K,F,X>(a,\function_add<K,F,X>(f,g))(p)=F.mul(a,F.add(f(p),g(p)))=F.add(F.mul(a,f(p)),F.mul(a,g(p)))=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(a,g))(p)
        by fn_extension \function_smul<K,F,X>(a,\function_add<K,F,X>(f,g))=\function_add<K,F,X>(\function_smul<K,F,X>(a,f),\function_smul<K,F,X>(a,g))
    claim:
        ? forall f fn(x X) K:
            \function_smul<K,F,X>(F.one,f)=f
        claim:
            ? forall p X:
                \function_smul<K,F,X>(F.one,f)(p)=f(p)
            \function_smul<K,F,X>(F.one,f)(p)=F.mul(F.one,f(p))=f(p)
        by fn_extension \function_smul<K,F,X>(F.one,f)=f
    release thm struct_member((\function_zero<K,F,X>,\function_add<K,F,X>,\function_smul<K,F,X>),&VectorSpace<K,F,fn(x X) K>)

template<K nonempty_set,F &field::Field<K>,X set>:
    have function_space &VectorSpace<K,F,fn(x X) K> = (\function_zero<K,F,X>,\function_add<K,F,X>,\function_smul<K,F,X>)

thm function_space_carrier:
    ? forall K nonempty_set,F &field::Field<K>,X set:
        \function_space<K,F,X> $in &VectorSpace<K,F,fn(x X) K>

# Selected additive inverses and subtraction (LADR 1.28 and 1.32).

claim:
    ? forall K nonempty_set,F &field::Field<K>,V nonempty_set,space &VectorSpace<K,F,V>,x V:
        exist! y V st {space.add(x,y)=space.zero}
    release thm additive_inverse_exists_unique(K,F,V,space,x)

template<K nonempty_set,F &field::Field<K>,V nonempty_set,space &VectorSpace<K,F,V>>:
    have fn vector_neg by exist!:
        ? forall x V:
            exist! y V st {space.add(x,y)=space.zero}

thm vector_neg_spec:
    ? forall K nonempty_set,F &field::Field<K>,V nonempty_set,space &VectorSpace<K,F,V>,x V:
        space.add(x,\vector_neg<K,F,V,space>(x))=space.zero

thm vector_neg_characterization:
    ? forall K nonempty_set,F &field::Field<K>,V nonempty_set,space &VectorSpace<K,F,V>,x,y V:
        space.add(x,y)=space.zero
        =>:
            y=\vector_neg<K,F,V,space>(x)

template<K nonempty_set,F &field::Field<K>,V nonempty_set,space &VectorSpace<K,F,V>>:
    have fn vector_difference(u,v V) V=space.add(u,\vector_neg<K,F,V,space>(v))

thm minus_one_times_vector:
    ? forall K nonempty_set,F &field::Field<K>,V nonempty_set,space &VectorSpace<K,F,V>,x V:
        space.smul(F.neg(F.one),x)=\vector_neg<K,F,V,space>(x)
    have inverse V=space.smul(F.neg(F.one),x)
    release thm zero_scalar_times_vector(K,F,V,space,x)
    F.add(F.one,F.neg(F.one))=F.zero
    space.smul(F.one,x)=x
    space.smul(F.add(F.one,F.neg(F.one)),x)=space.add(space.smul(F.one,x),inverse)
    space.smul(F.add(F.one,F.neg(F.one)),x)=space.smul(F.zero,x)=space.zero
    space.add(space.smul(F.one,x),inverse)=space.add(x,inverse)
    space.add(x,inverse)=space.zero
    release thm vector_neg_characterization(K,F,V,space,x,inverse)

# The supplied field is a vector space over itself.

claim:
    ? forall K nonempty_set,F &field::Field<K>:
        (F.zero,F.add,F.mul) $in &VectorSpace<K,F,K>
    F.zero $in K
    F.add $in fn(x,y K) K
    F.mul $in fn(a,x K) K
    claim:
        ? forall x,y,z K:
            F.add(F.add(x,y),z)=F.add(x,F.add(y,z))
        F.add(F.add(x,y),z)=F.add(x,F.add(y,z))
    claim:
        ? forall x,y K:
            F.add(x,y)=F.add(y,x)
        F.add(x,y)=F.add(y,x)
    claim:
        ? forall x K:
            F.add(F.zero,x)=x
            exist y K st {F.add(x,y)=F.zero}
        F.add(F.zero,x)=x
        F.add(x,F.neg(x))=F.zero
        witness exist y K st {F.add(x,y)=F.zero} from F.neg(x)
    claim:
        ? forall a,b,x K:
            F.mul(F.mul(a,b),x)=F.mul(a,F.mul(b,x))
            F.mul(F.add(a,b),x)=F.add(F.mul(a,x),F.mul(b,x))
        F.mul(F.mul(a,b),x)=F.mul(a,F.mul(b,x))
        release thm field::add_mul(K,F,a,b,x)
    claim:
        ? forall a K,x,y K:
            F.mul(a,F.add(x,y))=F.add(F.mul(a,x),F.mul(a,y))
        F.mul(a,F.add(x,y))=F.add(F.mul(a,x),F.mul(a,y))
    claim:
        ? forall x K:
            F.mul(F.one,x)=x
        F.mul(F.one,x)=x
    release thm struct_member((F.zero,F.add,F.mul),&VectorSpace<K,F,K>)

template<K nonempty_set,F &field::Field<K>>:
    have scalar_space &VectorSpace<K,F,K> =(F.zero,F.add,F.mul)

thm scalar_space_carrier:
    ? forall K nonempty_set,F &field::Field<K>:
        \scalar_space<K,F> $in &VectorSpace<K,F,K>

# First-class evaluation of ordinary unary functions.

template<X,Y set,point X>:
    have fn function_evaluation(f fn(x X) Y) Y=f(point)

thm function_evaluation_carrier:
    ? forall X,Y set,point X:
        \function_evaluation<X,Y,point> $in fn(f fn(x X) Y) Y

thm function_evaluation_spec:
    ? forall X,Y set,point X,f fn(x X) Y:
        \function_evaluation<X,Y,point>(f)=f(point)

thm function_evaluation_is_linear:
    ? forall K nonempty_set,F &field::Field<K>,X set,point X:
        $is_linear_map(K,F,fn(t X) K,\function_space<K,F,X>,K,\scalar_space<K,F>,\function_evaluation<X,K,point>)
    release thm function_space_carrier(K,F,X)
    release thm scalar_space_carrier(K,F)
    have source_space &VectorSpace<K,F,fn(t X) K> =\function_space<K,F,X>
    have target_space &VectorSpace<K,F,K> =\scalar_space<K,F>
    \function_space<K,F,X> =(\function_zero<K,F,X>,\function_add<K,F,X>,\function_smul<K,F,X>)
    source_space=(\function_zero<K,F,X>,\function_add<K,F,X>,\function_smul<K,F,X>)
    source_space.add=\function_add<K,F,X>
    source_space.smul=\function_smul<K,F,X>
    \scalar_space<K,F> =(F.zero,F.add,F.mul)
    target_space=(F.zero,F.add,F.mul)
    target_space.add=F.add
    target_space.smul=F.mul
    claim:
        ? forall f,g fn(t X) K:
            \function_evaluation<X,K,point>(source_space.add(f,g))=target_space.add(\function_evaluation<X,K,point>(f),\function_evaluation<X,K,point>(g))
        have sum_function fn(t X) K=source_space.add(f,g)
        sum_function=\function_add<K,F,X>(f,g)
        sum_function(point)=\function_add<K,F,X>(f,g)(point)=F.add(f(point),g(point))
        \function_evaluation<X,K,point>(source_space.add(f,g))=\function_evaluation<X,K,point>(sum_function)=sum_function(point)
        release thm function_evaluation_spec(X,K,point,f)
        release thm function_evaluation_spec(X,K,point,g)
        target_space.add(\function_evaluation<X,K,point>(f),\function_evaluation<X,K,point>(g))=F.add(f(point),g(point))
    claim:
        ? forall a K,f fn(t X) K:
            \function_evaluation<X,K,point>(source_space.smul(a,f))=target_space.smul(a,\function_evaluation<X,K,point>(f))
        have scaled_function fn(t X) K=source_space.smul(a,f)
        scaled_function=\function_smul<K,F,X>(a,f)
        scaled_function(point)=\function_smul<K,F,X>(a,f)(point)=F.mul(a,f(point))
        \function_evaluation<X,K,point>(source_space.smul(a,f))=\function_evaluation<X,K,point>(scaled_function)=scaled_function(point)
        release thm function_evaluation_spec(X,K,point,f)
        target_space.smul(a,\function_evaluation<X,K,point>(f))=F.mul(a,f(point))
    by def $is_linear_map(K,F,fn(t X) K,source_space,K,target_space,\function_evaluation<X,K,point>)
