thm gaussian_bezout_cancels_product:
    ? forall px, py, ax, ay, bx, b_y Z:
        $gaussian_bezout_pair(px, py, ax, ay)
        $gaussian_divides(px, py, gaussian_mul(ax, ay, bx, b_y)[1], gaussian_mul(ax, ay, bx, b_y)[2])
        =>:
            $gaussian_divides(px, py, bx, b_y)
    by def $gaussian_bezout_pair(px, py, ax, ay)
    by def $is_binary_gaussian_linear_combination(px, py, ax, ay, 1, 0)
    obtain ux, uy, vx, vy from exist ux0, uy0, vx0, vy0 Z st {1 = px * ux0 - py * uy0 + ax * vx0 - ay * vy0, 0 = px * uy0 + py * ux0 + ax * vy0 + ay * vx0}
    by def $gaussian_divides(px, py, gaussian_mul(ax, ay, bx, b_y)[1], gaussian_mul(ax, ay, bx, b_y)[2])
    obtain qx, qy from exist qx0, qy0 Z st {gaussian_mul(px, py, qx0, qy0) = (gaussian_mul(ax, ay, bx, b_y)[1], gaussian_mul(ax, ay, bx, b_y)[2])}
    have ubx Z = ux * bx - uy * b_y
    have uby Z = ux * b_y + uy * bx
    have qvx Z = qx * vx - qy * vy
    have qvy Z = qx * vy + qy * vx
    have wx Z = ubx + qvx
    have wy Z = uby + qvy
    witness exist wx0, wy0 Z st {gaussian_mul(px, py, wx0, wy0) = (bx, b_y)} from wx, wy:
        gaussian_mul(px, py, wx, wy)[1] = px * wx - py * wy = bx
        gaussian_mul(px, py, wx, wy)[2] = px * wy + py * wx = b_y
        gaussian_mul(px, py, wx, wy) = (bx, b_y)
    by def $gaussian_divides(px, py, bx, b_y)
