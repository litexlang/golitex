# Property-centered compiler fixture.
#
# This file makes the mathematical interface lifecycle explicit:
#   define a relation -> prove a reusable law -> prove an instance -> compose.

have fn kth_odd(k Z) Z = 2 * k - 1

thm odd_sum_integer:
    ? forall n Z:
        n >= 1
        =>:
            sum(1, n, kth_odd) $in Z
    sum(1, n, kth_odd) $in Z

thm square_integer:
    ? forall n Z:
        n^2 $in Z
    n^2 $in Z

prop is_square_of(value, root Z):
    value = root^2

thm square_of_is_nonnegative:
    ? forall value, root Z:
        $is_square_of(value, root)
        =>:
            value >= 0
    root^2 >= 0

thm sum_first_odds:
    ? forall n Z:
        n >= 1
        =>:
            sum(1, n, kth_odd) = n^2
    by induc n from 1:
        ? sum(1, n, kth_odd) = n^2

        ? from n = 1:
            kth_odd(1) = 2 * 1 - 1 = 1
            sum(1, 1, kth_odd) = kth_odd(1) = 2 * 1 - 1 = 1 = 1^2

        ? induc:
            kth_odd(n + 1) = 2 * (n + 1) - 1
            sum(1, n + 1, kth_odd) = sum(1, n, kth_odd) + kth_odd(n + 1) = n^2 + kth_odd(n + 1) = n^2 + (2 * (n + 1) - 1) = (n + 1)^2

thm sum_first_odds_is_square_of_n:
    ? forall n Z:
        n >= 1
        =>:
            $is_square_of(sum(1, n, kth_odd), n)
    by thm sum_first_odds(n) => sum(1, n, kth_odd) = n^2
    by def $is_square_of(sum(1, n, kth_odd), n)

thm sum_first_odds_nonnegative:
    ? forall n Z:
        n >= 1
        =>:
            sum(1, n, kth_odd) >= 0
    by thm sum_first_odds_is_square_of_n(n) => $is_square_of(sum(1, n, kth_odd), n)
    by thm square_of_is_nonnegative(sum(1, n, kth_odd), n) => sum(1, n, kth_odd) >= 0

thm sum_first_ten_odds:
    ? forall:
        sum(1, 10, kth_odd) = 100
    sum(1, 10, kth_odd) = 10^2 = 100
