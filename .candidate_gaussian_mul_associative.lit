thm gaussian_mul_is_associative:
    ? forall ax, ay, bx, b_y, cx, cy Z:
        gaussian_mul(gaussian_mul(ax, ay, bx, b_y)[1], gaussian_mul(ax, ay, bx, b_y)[2], cx, cy) = gaussian_mul(ax, ay, gaussian_mul(bx, b_y, cx, cy)[1], gaussian_mul(bx, b_y, cx, cy)[2])
    gaussian_mul(ax, ay, bx, b_y) = (ax * bx - ay * b_y, ax * b_y + ay * bx)
    gaussian_mul(bx, b_y, cx, cy) = (bx * cx - b_y * cy, bx * cy + b_y * cx)
    gaussian_mul(gaussian_mul(ax, ay, bx, b_y)[1], gaussian_mul(ax, ay, bx, b_y)[2], cx, cy) = gaussian_mul(ax * bx - ay * b_y, ax * b_y + ay * bx, cx, cy)
    gaussian_mul(ax * bx - ay * b_y, ax * b_y + ay * bx, cx, cy) = ((ax * bx - ay * b_y) * cx - (ax * b_y + ay * bx) * cy, (ax * bx - ay * b_y) * cy + (ax * b_y + ay * bx) * cx)
    gaussian_mul(ax, ay, gaussian_mul(bx, b_y, cx, cy)[1], gaussian_mul(bx, b_y, cx, cy)[2]) = gaussian_mul(ax, ay, bx * cx - b_y * cy, bx * cy + b_y * cx)
    gaussian_mul(ax, ay, bx * cx - b_y * cy, bx * cy + b_y * cx) = (ax * (bx * cx - b_y * cy) - ay * (bx * cy + b_y * cx), ax * (bx * cy + b_y * cx) + ay * (bx * cx - b_y * cy))
    ((ax * bx - ay * b_y) * cx - (ax * b_y + ay * bx) * cy, (ax * bx - ay * b_y) * cy + (ax * b_y + ay * bx) * cx) = (ax * (bx * cx - b_y * cy) - ay * (bx * cy + b_y * cx), ax * (bx * cy + b_y * cx) + ay * (bx * cx - b_y * cy))
    gaussian_mul(gaussian_mul(ax, ay, bx, b_y)[1], gaussian_mul(ax, ay, bx, b_y)[2], cx, cy) = gaussian_mul(ax, ay, gaussian_mul(bx, b_y, cx, cy)[1], gaussian_mul(bx, b_y, cx, cy)[2])
