# Linear Algebra Done Right, fourth edition — Section 7F.
# Consequences of Singular Value Decomposition.


prop has_singular_value_upper_bound(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, n N_pos, values &chap1a::FiniteList<R, n>):
    forall v V:
        \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) <= values.entries(1) * \chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v)

# Result 7.82. In an SVD, orthonormality turns the squared norm of Tv into a
# weighted sum. Replace every weight by s1^2, apply Bessel, and take roots.
axiom singular_value_upper_bound:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, n N_pos, values &chap1a::FiniteList<R, n>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        \chap2c::dimension<s, scalars, V, Vinner.vector_space> = n
        $chap7e::is_singular_value_list(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, n, values)
        =>:
            $has_singular_value_upper_bound(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, n, values)

# Definition 7.86. The norm is the attained maximum on the closed unit ball.
prop is_linear_map_norm_value(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, c R):
    c >= 0
    forall v V:
        \chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v) <= 1
        =>:
            \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) <= c
    exist v V st {\chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v) <= 1, \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) = c}

axiom linear_map_norm_exists_unique:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        =>:
            exist! c R st {$is_linear_map_norm_value(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, c)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>>:
    # Exact unique existence is explicit above; parameterized selection remains.
    trust have linear_map_norm fn(T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>) R

axiom linear_map_norm_spec:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        =>:
            $is_linear_map_norm_value(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>>:
    have fn linear_map_difference(S, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>) \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace> = \chap3a::linear_map_add<s, scalars, V, W, Vspace, Wspace>(S, \chap3a::linear_map_smul<s, scalars, V, W, Vspace, Wspace>(scalars.neg(scalars.one), T))

# Result 7.87. Positivity, definiteness, homogeneity, and the triangle
# inequality are kept as the source's four mathematical clauses.
prop linear_map_norm_properties_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>):
    \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T) >= 0
    forall:
        =>:
            \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T) = 0
        <=>:
            T = \chap3a::zero_linear_map<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>
    forall a s:
        \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(\chap3a::linear_map_smul<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(a, T)) = scalar_geometry.absolute_value(a) * \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T)
    forall S \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>:
        \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(\chap3a::linear_map_add<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(S, T)) <= \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(S) + \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T)

axiom basic_properties_of_norms_of_linear_maps:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        =>:
            $linear_map_norm_properties_statement(s, scalars, scalar_geometry, V, W, Vinner, Winner, T)

prop is_smallest_global_norm_bound(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, c R):
    forall v V:
        \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) <= c * \chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v)
    forall d R:
        d >= 0
        forall v V:
            \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) <= d * \chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v)
        =>:
            c <= d

# Result 7.88. The maximum is the top singular value, is attained on the unit
# sphere, and is the least global norm bound.
prop alternative_linear_map_norm_formulas_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, n N_pos, values &chap1a::FiniteList<R, n>):
    \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T) = values.entries(1)
    forall v V:
        \chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v) = 1
        =>:
            \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) <= \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T)
    exist v V st {\chap6a::norm<s, scalars, scalar_geometry, V>(Vinner, v) = 1, \chap6a::norm<s, scalars, scalar_geometry, W>(Winner, T(v)) = \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T)}
    $is_smallest_global_norm_bound(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T))

axiom alternative_formulas_for_norms_of_linear_maps:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, n N_pos, values &chap1a::FiniteList<R, n>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        \chap2c::dimension<s, scalars, V, Vinner.vector_space> = n
        $chap7e::is_singular_value_list(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, n, values)
        =>:
            $alternative_linear_map_norm_formulas_statement(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, n, values)

# Example 7.90. Concrete coordinate data for the identity and all-ones maps.
sketch:
    have I matrix(R, 2, 2) = [[1, 0], [0, 1]]
    have J matrix(R, 2, 2) = [[1, 1], [1, 1]]
    I(1, 1) = I(2, 2) = 1
    J(1, 1) + J(1, 2) = 2
    sqrt((1 / sqrt(2))^2 + (1 / sqrt(2))^2) = 1
    sqrt(sqrt(2)^2 + sqrt(2)^2) = 2

# Result 7.91. Bound T* by T using the adjoint identity and Cauchy-Schwarz;
# repeat with T* and use (T*)*=T.
axiom norm_of_adjoint:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        $chap2a::is_finite_dimensional(s, scalars, W, Winner.vector_space)
        =>:
            \linear_map_norm<s, scalars, scalar_geometry, W, V, Winner, Vinner>(\chap7a::adjoint<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T)) = \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(T)

prop is_truncated_singular_value_decomposition(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T, Tk \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, m, k N_pos, values &chap1a::FiniteList<R, m>, domain_vectors &chap1a::FiniteList<V, m>, range_vectors &chap1a::FiniteList<W, m>):
    k < m
    forall v V:
        Tk(v) = \chap7e::svd_forward_value<s, scalars, scalar_geometry, V, W, Vinner, Winner, k>(v, \chap5c::finite_list_prefix<R, m>(values, k), \chap5c::finite_list_prefix<V, m>(domain_vectors, k), \chap5c::finite_list_prefix<W, m>(range_vectors, k))

prop is_best_rank_k_approximation(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T, Tk \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, m, k N_pos, values &chap1a::FiniteList<R, m>):
    \chap7e::linear_map_range_dimension<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(Tk) = k
    \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(\linear_map_difference<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(T, Tk)) = values.entries(k + 1)
    forall S \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>:
        \chap7e::linear_map_range_dimension<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(S) <= k
        =>:
            \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(\linear_map_difference<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(T, Tk)) <= \linear_map_norm<s, scalars, scalar_geometry, V, W, Vinner, Winner>(\linear_map_difference<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>(T, S))

# Result 7.92. Truncate after k terms; the tail gives the upper bound and
# dependence among S e1,...,S e_(k+1) gives the matching lower bound.
axiom best_low_rank_approximation:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, Winner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space>, m, k N_pos, values &chap1a::FiniteList<R, m>, domain_vectors &chap1a::FiniteList<V, m>, range_vectors &chap1a::FiniteList<W, m>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        $chap7e::is_singular_value_decomposition(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, m, values, domain_vectors, range_vectors)
        k < m
        =>:
            exist Tk \chap3a::linear_map_space<s, scalars, V, W, Vinner.vector_space, Winner.vector_space> st {$is_truncated_singular_value_decomposition(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, Tk, m, k, values, domain_vectors, range_vectors), $is_best_rank_k_approximation(s, scalars, scalar_geometry, V, W, Vinner, Winner, T, Tk, m, k, values)}

prop is_polar_decomposition(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T, S, P \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space>):
    $chap7d::is_unitary_operator(s, scalars, scalar_geometry, V, Vinner, S)
    $chap7c::is_positive_operator(s, scalars, scalar_geometry, V, Vinner, P)
    $chap7c::is_square_root_of(s, scalars, V, Vinner.vector_space, \chap3a::linear_map_compose<s, scalars, V, V, V, Vinner.vector_space, Vinner.vector_space, Vinner.vector_space>(\chap7a::adjoint<s, scalars, scalar_geometry, V, V, Vinner, Vinner>(T), T), P)
    T = \chap3a::linear_map_compose<s, scalars, V, V, V, Vinner.vector_space, Vinner.vector_space, Vinner.vector_space>(S, P)

# Result 7.93. Extend the SVD lists to bases, send each e_j to f_j, and read
# the positive square-root factor from the same diagonal data.
axiom polar_decomposition:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        =>:
            exist S, P \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space> st {$is_polar_decomposition(s, scalars, scalar_geometry, V, Vinner, T, S, P)}

# Definition 7.95. The open unit ball is a set-valued construction.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set>:
    have fn unit_ball(inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>) power_set(V) = {v V: \chap6a::norm<s, scalars, scalar_geometry, V>(inner_space, v) < 1}

prop has_positive_real_entries(n N_pos, values &chap1a::FiniteList<R, n>):
    forall k N_pos:
        k <= n
        =>:
            values.entries(k) > 0

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, n N_pos>:
    have fn ellipsoid_value(inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, v V, radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n>) R = sum(1, n, fn(k N_pos: k <= n) R {scalar_geometry.absolute_value(inner_space.inner(v, axes.entries(k)))^2 / radii.entries(k)^2})

# Definition 7.96. The callable set retains its positive radii and
# orthonormal principal-axis data for downstream image theorems.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, n N_pos>:
    have fn ellipsoid(inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n>) power_set(V) = {v V: \ellipsoid_value<s, scalars, scalar_geometry, V, n>(inner_space, v, radii, axes) < 1}

prop is_ellipsoid_set(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, E power_set(V)):
    exist n N_pos, radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n> st {$has_positive_real_entries(n, radii), $chap6b::is_orthonormal_basis(s, scalars, scalar_geometry, V, inner_space, n, axes), E = \ellipsoid<s, scalars, scalar_geometry, V, n>(inner_space, radii, axes)}

# Example 7.97. Two radii and the source's rotated orthonormal axes.
sketch:
    have radii finite_seq(R, 2) = [2, 1]
    have f1 finite_seq(R, 2) = [1 / sqrt(2), 1 / sqrt(2)]
    have f2 finite_seq(R, 2) = [-1 / sqrt(2), 1 / sqrt(2)]
    radii(1) = 2
    f1(1) * f2(1) + f1(2) * f2(2) = 0
    f1(1)^2 + f1(2)^2 = 1

# Notation 7.98. Images remain genuine set-valued functions.
prop belongs_to_image_of_set(V, W nonempty_set, T fn(v V) W, Omega power_set(V), w W):
    exist v V st {v $in Omega, w = T(v)}

template<V, W nonempty_set>:
    have fn image_of_set(T fn(v V) W, Omega power_set(V)) power_set(W) = {w W: $belongs_to_image_of_set(V, W, T, Omega, w)}

# Result 7.99. A full SVD of the invertible operator supplies the positive
# radii and orthonormal axes of the image ellipsoid.
axiom invertible_operator_takes_ball_to_ellipsoid:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        $chap3d::is_invertible_linear_map(s, scalars, V, V, Vinner.vector_space, Vinner.vector_space, T)
        =>:
            exist n N_pos, radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n> st {$has_positive_real_entries(n, radii), $chap6b::is_orthonormal_basis(s, scalars, scalar_geometry, V, Vinner, n, axes), \image_of_set<V, V>(T, \unit_ball<s, scalars, scalar_geometry, V>(Vinner)) = \ellipsoid<s, scalars, scalar_geometry, V, n>(Vinner, radii, axes)}

# Result 7.101. Write E=S(B), so T(E)=(TS)(B), and apply Result 7.99.
axiom invertible_operator_takes_ellipsoids_to_ellipsoids:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space>, E power_set(V):
        $chap2a::is_finite_dimensional(s, scalars, V, Vinner.vector_space)
        $chap3d::is_invertible_linear_map(s, scalars, V, V, Vinner.vector_space, Vinner.vector_space, T)
        $is_ellipsoid_set(s, scalars, scalar_geometry, V, Vinner, E)
        =>:
            $is_ellipsoid_set(s, scalars, scalar_geometry, V, Vinner, \image_of_set<V, V>(T, E))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, n N_pos>:
    have fn real_coefficient_list(values &chap1a::FiniteList<R, n>) &chap1a::FiniteList<s, n> = (n, fn(k N_pos: k <= n) s {scalar_geometry.real_embed(values.entries(k))})

prop is_open_unit_coefficient_list(n N_pos, values &chap1a::FiniteList<R, n>):
    forall k N_pos:
        k <= n
        =>:
            0 < values.entries(k)
            values.entries(k) < 1

# Definition 7.102. P(v1,...,vn) is the set of real open-unit combinations
# of the supplied basis list.
prop belongs_to_parallelepiped(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, n N_pos, vectors &chap1a::FiniteList<V, n>, x V):
    exist coefficients &chap1a::FiniteList<R, n> st {$is_open_unit_coefficient_list(n, coefficients), x = \chap2a::linear_combination_value<s, scalars, V, Vinner.vector_space, n>(\real_coefficient_list<s, scalars, scalar_geometry, V, Vinner, n>(coefficients), vectors)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, n N_pos>:
    have fn parallelepiped(vectors &chap1a::FiniteList<V, n>) power_set(V) = {x V: $belongs_to_parallelepiped(s, scalars, scalar_geometry, V, Vinner, n, vectors, x)}

# Example 7.103. Translation point and the two displayed planar edge vectors.
sketch:
    have u finite_seq(R, 2) = [3 / 10, 1 / 2]
    have v1 finite_seq(R, 2) = [1, 0]
    have v2 finite_seq(R, 2) = [1, 1]
    u(1) = 3 / 10
    v1(2) = 0
    v2(1) = v2(2) = 1

# Result 7.104. Linearity sends the translation and every open-unit basis
# combination to the corresponding combination of the image basis.
axiom invertible_operator_takes_parallelepipeds_to_parallelepipeds:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space>, n N_pos, basis &chap1a::FiniteList<V, n>, u V:
        $chap2b::is_basis(s, scalars, V, Vinner.vector_space, n, basis)
        $chap3d::is_invertible_linear_map(s, scalars, V, V, Vinner.vector_space, Vinner.vector_space, T)
        =>:
            \image_of_set<V, V>(T, \chap3e::translate<s, scalars, V, Vinner.vector_space>(\parallelepiped<s, scalars, scalar_geometry, V, Vinner, n>(basis), u)) = \chap3e::translate<s, scalars, V, Vinner.vector_space>(\parallelepiped<s, scalars, scalar_geometry, V, Vinner, n>(\chap7d::linear_map_image_list<V, V, n>(T, basis)), T(u))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, n N_pos>:
    have fn scaled_axis_vectors(radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n>) &chap1a::FiniteList<V, n> = (n, fn(k N_pos: k <= n) V {&chap1b::VectorSpace<s, scalars, V>{Vinner.vector_space}.smul(scalar_geometry.real_embed(radii.entries(k)), axes.entries(k))})

# Definition 7.105. A box is a translate of a parallelepiped whose edges are
# positive multiples of an orthonormal basis.
prop is_box(s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, B power_set(V)):
    exist n N_pos, u V, radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n> st {$has_positive_real_entries(n, radii), $chap6b::is_orthonormal_basis(s, scalars, scalar_geometry, V, Vinner, n, axes), B = \chap3e::translate<s, scalars, V, Vinner.vector_space>(\parallelepiped<s, scalars, scalar_geometry, V, Vinner, n>(\scaled_axis_vectors<s, scalars, scalar_geometry, V, Vinner, n>(radii, axes)), u)}

# Example 7.106. The planar box has two rotated axes, both scaled by sqrt(2).
sketch:
    have radii finite_seq(R, 2) = [sqrt(2), sqrt(2)]
    have e1 finite_seq(R, 2) = [1 / sqrt(2), 1 / sqrt(2)]
    have e2 finite_seq(R, 2) = [-1 / sqrt(2), 1 / sqrt(2)]
    radii(1) = radii(2)
    e1(1) * e2(1) + e1(2) * e2(2) = 0
    e2(1)^2 + e2(2)^2 = 1

template<n N_pos>:
    have fn pointwise_real_product(left, right &chap1a::FiniteList<R, n>) &chap1a::FiniteList<R, n> = (n, fn(k N_pos: k <= n) R {left.entries(k) * right.entries(k)})

# Result 7.107. Apply the full SVD to each scaled domain basis vector; the
# k-th edge acquires exactly the factor s_k.
axiom every_invertible_operator_takes_some_boxes_to_boxes:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vinner.vector_space, Vinner.vector_space>, n N_pos, values, radii &chap1a::FiniteList<R, n>, domain_axes, range_axes &chap1a::FiniteList<V, n>, u V:
        $chap3d::is_invertible_linear_map(s, scalars, V, V, Vinner.vector_space, Vinner.vector_space, T)
        $chap7e::is_singular_value_decomposition(s, scalars, scalar_geometry, V, V, Vinner, Vinner, T, n, values, domain_axes, range_axes)
        $has_positive_real_entries(n, radii)
        =>:
            \image_of_set<V, V>(T, \chap3e::translate<s, scalars, V, Vinner.vector_space>(\parallelepiped<s, scalars, scalar_geometry, V, Vinner, n>(\scaled_axis_vectors<s, scalars, scalar_geometry, V, Vinner, n>(radii, domain_axes)), u)) = \chap3e::translate<s, scalars, V, Vinner.vector_space>(\parallelepiped<s, scalars, scalar_geometry, V, Vinner, n>(\scaled_axis_vectors<s, scalars, scalar_geometry, V, Vinner, n>(\pointwise_real_product<n>(radii, values), range_axes)), T(u))

# Definition 7.108. The represented volume of an orthogonal box is the
# product of its positive edge lengths.
template<n N_pos>:
    have fn finite_real_product(values &chap1a::FiniteList<R, n>, k closed_range(0, n)) R by induc k from 0:
        case k = 0: 1
        case k > 0: finite_real_product(values, k - 1) * values.entries(k)

template<n N_pos>:
    have fn box_volume(radii &chap1a::FiniteList<R, n>) R = \finite_real_product<n>(radii, n)

# Definition 7.109. Axler explicitly treats volume as intuitive analytic
# background. This callable value is therefore a visible selection boundary;
# the following interface fixes its value on every represented box.
template<V nonempty_set, Vinner &chap6a::InnerProductSpace<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V>>:
    trust have volume fn(Omega power_set(V)) R

axiom volume_of_box:
    ? forall V nonempty_set, Vinner &chap6a::InnerProductSpace<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V>, n N_pos, u V, radii &chap1a::FiniteList<R, n>, axes &chap1a::FiniteList<V, n>:
        $has_positive_real_entries(n, radii)
        $chap6b::is_orthonormal_basis(R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V, Vinner, n, axes)
        =>:
            \volume<V, Vinner>(\chap3e::translate<R, chap1a::real_scalars, V, Vinner.vector_space>(\parallelepiped<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V, Vinner, n>(\scaled_axis_vectors<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V, Vinner, n>(radii, axes)), u)) = \box_volume<n>(radii)

# Example 7.110. The diagonal map with stretch factors 2 and 1 doubles every
# aligned rectangular area.
sketch:
    have A matrix(R, 2, 2) = [[2, 0], [0, 1]]
    A(1, 1) * A(2, 2) = 2
    2 * 1 = 2

# Result 7.111. Approximate by boxes aligned with the SVD domain basis. Result
# 7.107 multiplies every edge product, hence the whole volume, by product s_k.
axiom volume_scaling_by_singular_values:
    ? forall V nonempty_set, Vinner &chap6a::InnerProductSpace<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V>, T \chap3a::linear_map_space<R, chap1a::real_scalars, V, V, Vinner.vector_space, Vinner.vector_space>, n N_pos, values &chap1a::FiniteList<R, n>, Omega power_set(V):
        $chap2a::is_finite_dimensional(R, chap1a::real_scalars, V, Vinner.vector_space)
        \chap2c::dimension<R, chap1a::real_scalars, V, Vinner.vector_space> = n
        $chap3d::is_invertible_linear_map(R, chap1a::real_scalars, V, V, Vinner.vector_space, Vinner.vector_space, T)
        $chap7e::is_singular_value_list(R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, V, V, Vinner, Vinner, T, n, values)
        =>:
            \volume<V, Vinner>(\image_of_set<V, V>(T, Omega)) = \box_volume<n>(values) * \volume<V, Vinner>(Omega)
