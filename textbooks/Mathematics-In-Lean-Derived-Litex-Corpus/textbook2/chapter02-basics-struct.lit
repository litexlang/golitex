# Chapter 2 — Basics, independent struct-first presentation
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# 2.1 Calculating

# Representative polynomial calculation. The source presents several `rw`
# and `ring` variants; Litex keeps the mathematical identity once and lets
# exact polynomial normalization check it directly.
forall a, b R:
    (a + b) * (a + b) = a * a + 2 * (a * b) + b * b

# 2.2 Proving Identities in Algebraic Structures

# The source states its results under one `[Ring R]` or `[Group G]` ambient
# structure. This retained Litex interface likewise bundles the operations and
# laws in a struct value. Its `*_laws` predicates are candidate-construction
# relations used by the structure-oriented development itself.

# An additive commutative group has associative addition, a left identity, a
# left inverse, and commutativity. Right-facing laws are derived below.
prop additive_commutative_group_laws(A set, add fn(x, y A) A, zero A, neg fn(x A) A):
    forall x, y, z A:
        add(add(x, y), z) = add(x, add(y, z))
    forall x A:
        add(zero, x) = x
        add(neg(x), x) = zero
    forall x, y A:
        add(x, y) = add(y, x)

# A ring adds associative multiplication, a multiplicative identity, and both
# distributive laws to the additive carrier. Multiplication is not assumed to
# be commutative.
prop ring_laws(A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A):
    $additive_commutative_group_laws(A, add, zero, neg)
    forall x, y, z A:
        mul(mul(x, y), z) = mul(x, mul(y, z))
        mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
        mul(add(x, y), z) = add(mul(x, z), mul(y, z))
    forall x A:
        mul(one, x) = x
        mul(x, one) = x

# A multiplicative group uses only a left identity and left inverse as primitive
# laws. The source's right-facing laws are mathematical consequences.
prop group_laws(A set, mul fn(x, y A) A, one A, inv fn(x A) A):
    forall x, y, z A:
        mul(mul(x, y), z) = mul(x, mul(y, z))
    forall x A:
        mul(one, x) = x
        mul(inv(x), x) = one

# Result (source label: add_zero). Commutativity turns the primitive left zero
# law into the right zero law.
thm add_zero_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(a, zero) = a
    add(a, zero) = add(zero, a) = a

# Result (source label: add_neg_cancel). The same symmetry turns the primitive
# left inverse law into a right inverse law.
thm add_neg_cancel_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(a, neg(a)) = zero
    add(a, neg(a)) = add(neg(a), a) = zero

# A canonical additive commutative group is one operation-bearing object. The
# nonempty carrier records the existence of its zero; downstream theorems pass
# `group` rather than a loose list of addition operations.
struct AdditiveCommutativeGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
            add(neg(x), x) = zero
        forall x, y s:
            add(x, y) = add(y, x)

# A group likewise bundles multiplication, one, inverse, and the primitive
# left-facing group laws used in the source proof.
struct Group<s nonempty_set>:
    mul fn(x, y s) s
    one s
    inv fn(x s) s
    <=>:
        forall x, y, z s:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x s:
            mul(one, x) = x
            mul(inv(x), x) = one

# A ring exposes its five primitive operations directly. Its laws compose the
# additive-group relation rather than storing a nested parent object.
struct Ring<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    mul fn(x, y s) s
    one s
    <=>:
        $additive_commutative_group_laws(s, add, zero, neg)
        forall x, y, z s:
            mul(mul(x, y), z) = mul(x, mul(y, z))
            mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
            mul(add(x, y), z) = add(mul(x, z), mul(y, z))
        forall x s:
            mul(one, x) = x
            mul(x, one) = x

# Subtraction and the ring numeral two are derived constructions, not extra
# primitive fields. They retain the source-facing expressions for later use.
template<s nonempty_set, group &AdditiveCommutativeGroup<s>>:
    have fn additive_sub(x, y s) s = group.add(x, group.neg(y))

template<s nonempty_set, ring &Ring<s>>:
    have ring_two s = ring.add(ring.one, ring.one)

# The bundled object gives the same derived right inverse as the source-facing
# candidate relation above. This is the first canonical-structure use probe.
thm add_neg_cancel:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a s:
        group.add(a, group.neg(a)) = group.zero
    group.add(a, group.neg(a)) = group.add(group.neg(a), a) = group.zero

# Result (source label: add_zero). Commutativity turns the stored left identity
# into a right identity without passing a separate list of operations around.
thm add_zero:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a s:
        group.add(a, group.zero) = a
    group.add(a, group.zero) = group.add(group.zero, a) = a

# Result (source label: add_left_cancel). Apply the stored inverse on the left
# of both equal sums, reassociate, and reduce both sides to their remaining term.
thm add_left_cancel_in_additive_commutative_group:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a, b, c s:
        group.add(a, b) = group.add(a, c)
        =>:
            b = c
    group.add(group.neg(a), group.add(a, b)) = group.add(group.neg(a), group.add(a, c))
    group.add(group.neg(a), a) = group.zero
    group.add(group.zero, b) = b
    group.add(group.zero, c) = c
    group.add(group.neg(a), group.add(a, b)) = group.add(group.add(group.neg(a), a), b) = group.add(group.zero, b) = b
    group.add(group.neg(a), group.add(a, c)) = group.add(group.add(group.neg(a), a), c) = group.add(group.zero, c) = c

# Result (source label: self_sub). The derived subtraction operation is addition
# of the stored inverse, so self-subtraction is the checked inverse law.
thm self_sub:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a s:
        \additive_sub<s, group>(a, a) = group.zero
    \additive_sub<s, group>(a, a) = group.add(a, group.neg(a))
    by thm add_neg_cancel(s, group, a)

# Result (source label: one_add_one_eq_two). `ring_two` is the derived numeral
# one plus one; it is deliberately a construction rather than a Ring field.
thm one_add_one_eq_two:
    ? forall s nonempty_set, ring &Ring<s>:
        ring.add(ring.one, ring.one) = \ring_two<s, ring>

# Result (source label: two_mul). Distributivity expands `ring_two`; the stored
# additive group and multiplicative left identity simplify the two summands.
thm two_mul:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(\ring_two<s, ring>, a) = ring.add(a, a)
    ring.mul(ring.one, a) = a
    ring.add(ring.mul(ring.one, a), ring.mul(ring.one, a)) = ring.add(a, a)
    ring.mul(\ring_two<s, ring>, a) = ring.mul(ring.add(ring.one, ring.one), a) = ring.add(ring.mul(ring.one, a), ring.mul(ring.one, a)) = ring.add(a, a)

# Result (source label: mul_zero). Distributivity duplicates `a * 0`; additive
# cancellation removes the common summand and yields the multiplicative zero law.
thm mul_zero:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(a, ring.zero) = ring.zero
    ring.add(ring.zero, ring.zero) = ring.zero
    ring.mul(a, ring.zero) = ring.mul(a, ring.add(ring.zero, ring.zero)) = ring.add(ring.mul(a, ring.zero), ring.mul(a, ring.zero))
    by thm add_zero_from_laws(s, ring.add, ring.zero, ring.neg, ring.mul(a, ring.zero))
    ring.add(ring.mul(a, ring.zero), ring.mul(a, ring.zero)) = ring.mul(a, ring.zero) = ring.add(ring.mul(a, ring.zero), ring.zero)
    ring.add(ring.neg(ring.mul(a, ring.zero)), ring.add(ring.mul(a, ring.zero), ring.mul(a, ring.zero))) = ring.add(ring.neg(ring.mul(a, ring.zero)), ring.add(ring.mul(a, ring.zero), ring.zero))
    ring.add(ring.neg(ring.mul(a, ring.zero)), ring.mul(a, ring.zero)) = ring.zero
    ring.add(ring.zero, ring.mul(a, ring.zero)) = ring.mul(a, ring.zero)
    ring.add(ring.zero, ring.zero) = ring.zero
    ring.add(ring.neg(ring.mul(a, ring.zero)), ring.add(ring.mul(a, ring.zero), ring.mul(a, ring.zero))) = ring.add(ring.add(ring.neg(ring.mul(a, ring.zero)), ring.mul(a, ring.zero)), ring.mul(a, ring.zero)) = ring.add(ring.zero, ring.mul(a, ring.zero)) = ring.mul(a, ring.zero)
    ring.add(ring.neg(ring.mul(a, ring.zero)), ring.add(ring.mul(a, ring.zero), ring.zero)) = ring.add(ring.add(ring.neg(ring.mul(a, ring.zero)), ring.mul(a, ring.zero)), ring.zero) = ring.add(ring.zero, ring.zero) = ring.zero

# Result (source label: zero_mul). The companion proof uses the other
# distributive law, so it does not assume multiplication is commutative.
thm zero_mul:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(ring.zero, a) = ring.zero
    ring.add(ring.zero, ring.zero) = ring.zero
    ring.mul(ring.zero, a) = ring.mul(ring.add(ring.zero, ring.zero), a) = ring.add(ring.mul(ring.zero, a), ring.mul(ring.zero, a))
    by thm add_zero_from_laws(s, ring.add, ring.zero, ring.neg, ring.mul(ring.zero, a))
    ring.add(ring.mul(ring.zero, a), ring.mul(ring.zero, a)) = ring.mul(ring.zero, a) = ring.add(ring.mul(ring.zero, a), ring.zero)
    ring.add(ring.neg(ring.mul(ring.zero, a)), ring.add(ring.mul(ring.zero, a), ring.mul(ring.zero, a))) = ring.add(ring.neg(ring.mul(ring.zero, a)), ring.add(ring.mul(ring.zero, a), ring.zero))
    ring.add(ring.neg(ring.mul(ring.zero, a)), ring.mul(ring.zero, a)) = ring.zero
    ring.add(ring.zero, ring.mul(ring.zero, a)) = ring.mul(ring.zero, a)
    ring.add(ring.zero, ring.zero) = ring.zero
    ring.add(ring.neg(ring.mul(ring.zero, a)), ring.add(ring.mul(ring.zero, a), ring.mul(ring.zero, a))) = ring.add(ring.add(ring.neg(ring.mul(ring.zero, a)), ring.mul(ring.zero, a)), ring.mul(ring.zero, a)) = ring.add(ring.zero, ring.mul(ring.zero, a)) = ring.mul(ring.zero, a)
    ring.add(ring.neg(ring.mul(ring.zero, a)), ring.add(ring.mul(ring.zero, a), ring.zero)) = ring.add(ring.add(ring.neg(ring.mul(ring.zero, a)), ring.mul(ring.zero, a)), ring.zero) = ring.add(ring.zero, ring.zero) = ring.zero

# Result (source label: neg_add_cancel_left). Reassociate, cancel a on the
# left, and use the identity law.
thm neg_add_cancel_left:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(neg(a), add(a, b)) = b
    add(neg(a), a) = zero
    add(zero, b) = b
    add(add(neg(a), a), b) = add(zero, b)
    add(neg(a), add(a, b)) = add(add(neg(a), a), b) = add(zero, b) = b

# Result (source label: add_neg_cancel_right). The companion calculation uses
# the derived right inverse and right identity.
thm add_neg_cancel_right:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(add(a, b), neg(b)) = a
    by thm add_neg_cancel_from_laws(A, add, zero, neg, b)
    by thm add_zero_from_laws(A, add, zero, neg, a)
    add(add(a, b), neg(b)) = add(a, add(b, neg(b))) = add(a, zero) = a

# Result (source label: add_left_cancel). Apply the same left inverse to both
# sides and simplify.
thm add_left_cancel:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(a, b) = add(a, c)
        =>:
            b = c
    by thm neg_add_cancel_left(A, add, zero, neg, a, b)
    by thm neg_add_cancel_left(A, add, zero, neg, a, c)
    add(neg(a), add(a, b)) = add(neg(a), add(a, c))
    b = add(neg(a), add(a, b)) = add(neg(a), add(a, c)) = c

# Result (source label: add_right_cancel). Commutativity reduces right
# cancellation to the preceding theorem.
thm add_right_cancel:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(a, b) = add(c, b)
        =>:
            a = c
    add(b, a) = add(a, b) = add(c, b) = add(b, c)
    by thm add_left_cancel(A, add, zero, neg, b, a, c)

# Result (source label: mul_zero). Distributivity gives a duplicated summand;
# additive cancellation then removes it, exactly as in the source proof.
thm mul_zero_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(a, zero) = zero
    add(zero, zero) = zero
    mul(a, zero) = mul(a, add(zero, zero)) = add(mul(a, zero), mul(a, zero))
    by thm add_zero_from_laws(A, add, zero, neg, mul(a, zero))
    add(mul(a, zero), mul(a, zero)) = mul(a, zero) = add(mul(a, zero), zero)
    by thm add_left_cancel(A, add, zero, neg, mul(a, zero), mul(a, zero), zero)

# Result (source label: zero_mul). Multiplication is not commutative, so the
# companion proof uses the other distributive law before the same cancellation.
thm zero_mul_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(zero, a) = zero
    add(zero, zero) = zero
    mul(zero, a) = mul(add(zero, zero), a) = add(mul(zero, a), mul(zero, a))
    by thm add_zero_from_laws(A, add, zero, neg, mul(zero, a))
    add(mul(zero, a), mul(zero, a)) = mul(zero, a) = add(mul(zero, a), zero)
    by thm add_left_cancel(A, add, zero, neg, mul(zero, a), mul(zero, a), zero)

# Result (source label: self_sub). Subtraction is addition of the explicit
# inverse, so this is exactly add_neg_cancel.
thm self_add_neg_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(a, neg(a)) = zero
    by thm add_neg_cancel_from_laws(A, add, zero, neg, a)

# Result (source label: one_add_one_eq_two). With operations explicit, the ring
# numeral two is represented by add(one, one), so the identity is definitional.
thm ring_two_reflexive_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            add(one, one) = add(one, one)

# Result (source label: two_mul). Right distributivity expands the explicit
# numeral two and the left identity removes both copies of one.
thm two_mul_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(add(one, one), a) = add(a, a)
    mul(one, a) = a
    add(mul(one, a), mul(one, a)) = add(a, a)
    mul(add(one, one), a) = add(mul(one, a), mul(one, a)) = add(a, a)

# Reassociate four summands and exchange the two middle terms. This is the
# small additive-normalization interface used by the sum-of-squares identity.
thm add_reorder_four:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c, d A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
    add(add(a, b), add(c, d)) = add(a, add(b, add(c, d)))
    add(b, add(c, d)) = add(add(b, c), d)
    add(b, c) = add(c, b)
    add(add(b, c), d) = add(add(c, b), d) = add(c, add(b, d))
    add(a, add(b, add(c, d))) = add(a, add(c, add(b, d)))
    add(a, add(c, add(b, d))) = add(add(a, c), add(b, d))

# In an additive group, a summand whose sum with x is zero is -x.
thm eq_neg_of_add_eq_zero:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, x, y A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(x, y) = zero
        =>:
            y = neg(x)
    by thm add_neg_cancel_from_laws(A, add, zero, neg, x)
    add(x, y) = zero = add(x, neg(x))
    by thm add_left_cancel(A, add, zero, neg, x, y, neg(x))

# Result (source label: neg_eq_of_add_eq_zero). The preceding inverse-
# uniqueness theorem gives the same equality in the opposite orientation.
thm neg_eq_of_add_eq_zero:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, x, y A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(x, y) = zero
        =>:
            neg(x) = y
    by thm eq_neg_of_add_eq_zero(A, add, zero, neg, x, y)

# Result (source label: neg_zero). Zero is its own additive inverse. Apply the
# preceding theorem to zero plus zero, whose value follows from the group laws.
thm neg_zero:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            neg(zero) = zero
    by thm neg_eq_of_add_eq_zero(A, add, zero, neg, zero, zero)

# Negation is involutive.
thm neg_neg:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, x A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            neg(neg(x)) = x
    add(neg(x), x) = zero
    by thm eq_neg_of_add_eq_zero(A, add, zero, neg, neg(x), x)
    x = neg(neg(x))

# Multiplying by an additive inverse gives the additive inverse of the product.
thm mul_neg_right:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, x, y A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(x, neg(y)) = neg(mul(x, y))
    by thm mul_zero_from_laws(A, add, zero, neg, mul, one, x)
    by thm add_neg_cancel_from_laws(A, add, zero, neg, y)
    add(mul(x, y), mul(x, neg(y))) = mul(x, add(y, neg(y))) = mul(x, zero) = zero
    by thm eq_neg_of_add_eq_zero(A, add, zero, neg, mul(x, y), mul(x, neg(y)))

thm neg_mul_left:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, x, y A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(neg(x), y) = neg(mul(x, y))
    by thm zero_mul_from_laws(A, add, zero, neg, mul, one, y)
    by thm add_neg_cancel_from_laws(A, add, zero, neg, x)
    add(mul(x, y), mul(neg(x), y)) = mul(add(x, neg(x)), y) = mul(zero, y) = zero
    by thm eq_neg_of_add_eq_zero(A, add, zero, neg, mul(x, y), mul(neg(x), y))

thm neg_mul_neg:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, x, y A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(neg(x), neg(y)) = mul(x, y)
    by thm neg_mul_left(A, add, zero, neg, mul, one, x, neg(y))
    by thm mul_neg_right(A, add, zero, neg, mul, one, x, y)
    by thm neg_neg(A, add, zero, neg, mul(x, y))
    mul(neg(x), neg(y)) = neg(mul(x, neg(y))) = neg(neg(mul(x, y))) = mul(x, y)

# Four factors in a commutative multiplication can exchange the middle pair.
thm commutative_mul_reorder_four:
    ? forall A set, mul fn(x, y A) A, a, b, c, d A:
        forall x, y, z A:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x, y A:
            mul(x, y) = mul(y, x)
        =>:
            mul(mul(a, b), mul(c, d)) = mul(mul(a, c), mul(b, d))
    mul(mul(a, b), mul(c, d)) = mul(a, mul(b, mul(c, d)))
    mul(b, mul(c, d)) = mul(mul(b, c), d)
    mul(b, c) = mul(c, b)
    mul(mul(b, c), d) = mul(mul(c, b), d) = mul(c, mul(b, d))
    mul(a, mul(b, mul(c, d))) = mul(a, mul(c, mul(b, d)))
    mul(a, mul(c, mul(b, d))) = mul(mul(a, c), mul(b, d))

# Private proof machinery for the three source group results. Multiplying both
# sides on the left by inv(a) proves left cancellation.
thm _group_left_cancel:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a, b, c A:
        $group_laws(A, mul, one, inv)
        mul(a, b) = mul(a, c)
        =>:
            b = c
    mul(inv(a), mul(a, b)) = mul(inv(a), mul(a, c))
    mul(inv(a), a) = one
    mul(one, b) = b
    mul(one, c) = c
    mul(mul(inv(a), a), b) = mul(one, b)
    mul(mul(inv(a), a), c) = mul(one, c)
    mul(inv(a), mul(a, b)) = mul(mul(inv(a), a), b) = mul(one, b) = b
    mul(inv(a), mul(a, c)) = mul(mul(inv(a), a), c) = mul(one, c) = c

# The right identity follows by cancelling inv(a) from the two expressions.
thm _group_mul_one:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        $group_laws(A, mul, one, inv)
        =>:
            mul(a, one) = a
    mul(inv(a), a) = one
    mul(one, one) = one
    mul(mul(inv(a), a), one) = mul(one, one)
    mul(inv(a), mul(a, one)) = mul(mul(inv(a), a), one) = mul(one, one) = one
    mul(inv(a), a) = one
    mul(inv(a), mul(a, one)) = mul(inv(a), a)
    by thm _group_left_cancel(A, mul, one, inv, inv(a), mul(a, one), a)

# Result (source label: mul_inv_cancel). Apply left cancellation after deriving
# the right identity for inv(a).
thm mul_inv_cancel:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        $group_laws(A, mul, one, inv)
        =>:
            mul(a, inv(a)) = one
    mul(inv(a), a) = one
    mul(one, inv(a)) = inv(a)
    mul(mul(inv(a), a), inv(a)) = mul(one, inv(a))
    mul(inv(a), mul(a, inv(a))) = mul(mul(inv(a), a), inv(a)) = mul(one, inv(a)) = inv(a)
    by thm _group_mul_one(A, mul, one, inv, inv(a))
    mul(inv(a), one) = inv(a)
    mul(inv(a), mul(a, inv(a))) = mul(inv(a), one)
    by thm _group_left_cancel(A, mul, one, inv, inv(a), mul(a, inv(a)), one)

# Result (source label: mul_one). The public source theorem cites the checked
# carrier-parametric identity calculation above.
thm mul_one:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        $group_laws(A, mul, one, inv)
        =>:
            mul(a, one) = a
    by thm _group_mul_one(A, mul, one, inv, a)

# Result (source label: mul_inv_rev). The inverse of a product reverses the
# factors. First verify that inv(b)inv(a) is a left inverse of ab, then compare
# it with the chosen inverse using the checked right inverse law.
thm mul_inv_rev:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a, b A:
        $group_laws(A, mul, one, inv)
        =>:
            inv(mul(a, b)) = mul(inv(b), inv(a))
    mul(inv(a), mul(a, b)) = mul(mul(inv(a), a), b)
    mul(inv(b), mul(inv(a), mul(a, b))) = mul(inv(b), mul(mul(inv(a), a), b))
    mul(inv(a), a) = one
    mul(mul(inv(a), a), b) = mul(one, b)
    mul(inv(b), mul(mul(inv(a), a), b)) = mul(inv(b), mul(one, b))
    mul(one, b) = b
    mul(inv(b), mul(one, b)) = mul(inv(b), b)
    mul(inv(b), b) = one
    mul(mul(inv(b), inv(a)), mul(a, b)) = mul(inv(b), mul(inv(a), mul(a, b)))
    mul(mul(inv(b), inv(a)), mul(a, b)) = mul(inv(b), mul(inv(a), mul(a, b))) = mul(inv(b), mul(mul(inv(a), a), b)) = mul(inv(b), mul(one, b)) = mul(inv(b), b) = one
    by thm mul_inv_cancel(A, mul, one, inv, mul(a, b))
    mul(mul(a, b), inv(mul(a, b))) = one
    by thm _group_mul_one(A, mul, one, inv, mul(inv(b), inv(a)))
    mul(inv(b), inv(a)) = mul(mul(inv(b), inv(a)), one)
    mul(mul(inv(b), inv(a)), one) = mul(mul(inv(b), inv(a)), mul(mul(a, b), inv(mul(a, b))))
    mul(mul(inv(b), inv(a)), mul(mul(a, b), inv(mul(a, b)))) = mul(mul(mul(inv(b), inv(a)), mul(a, b)), inv(mul(a, b)))
    mul(mul(inv(b), inv(a)), mul(a, b)) = one
    mul(mul(mul(inv(b), inv(a)), mul(a, b)), inv(mul(a, b))) = mul(one, inv(mul(a, b)))
    mul(one, inv(mul(a, b))) = inv(mul(a, b))
    mul(mul(mul(inv(b), inv(a)), mul(a, b)), inv(mul(a, b))) = mul(one, inv(mul(a, b))) = inv(mul(a, b))

# 2.3 Using Theorems and Lemmas

# Representative mixed inequality chain. Weak and strict comparisons alternate
# through four hypotheses; recording the chain exposes the source proof idea
# without reproducing its several Lean application styles.
claim:
    ? forall a, b, c, d, endpoint R:
        a <= b
        b < c
        c <= d
        d < endpoint
        =>:
            a < endpoint
    a <= b < c <= d < endpoint

# 2.4 More on Order and Divisibility

# The binary minimum is symmetric. The source's repeated tactic variants
# collapse to this single direct real-order fact.
forall a, b R:
    finite_set_min(union({a}, {b})) = finite_set_min(union({b}, {a}))

# Minimum is associative. Each direction shows that one nested minimum is a
# lower bound for both inputs of the other, then antisymmetry gives equality.
claim:
    ? forall a, b, c R:
        finite_set_min(union({finite_set_min(union({a}, {b}))}, {c})) = finite_set_min(union({a}, {finite_set_min(union({b}, {c}))}))
    have ab R = finite_set_min(union({a}, {b}))
    have bc R = finite_set_min(union({b}, {c}))
    have left R = finite_set_min(union({ab}, {c}))
    have right R = finite_set_min(union({a}, {bc}))
    left = finite_set_min(union({ab}, {c})) <= ab
    ab = finite_set_min(union({a}, {b})) <= a
    left <= ab = finite_set_min(union({a}, {b})) <= b
    left = finite_set_min(union({ab}, {c})) <= c
    left <= b
    left <= finite_set_min(union({b}, {c})) = bc
    left <= a
    left <= finite_set_min(union({a}, {bc})) = right
    right = finite_set_min(union({a}, {bc})) <= a
    right = finite_set_min(union({a}, {bc})) <= bc
    bc = finite_set_min(union({b}, {c})) <= b
    right <= bc = finite_set_min(union({b}, {c})) <= c
    right <= b
    right <= c
    right <= finite_set_min(union({a}, {b})) = ab
    right <= finite_set_min(union({ab}, {c})) = left
    left = right
    finite_set_min(union({finite_set_min(union({a}, {b}))}, {c})) = finite_set_min(union({ab}, {c})) = left
    right = finite_set_min(union({a}, {bc})) = finite_set_min(union({a}, {finite_set_min(union({b}, {c}))}))
    finite_set_min(union({finite_set_min(union({a}, {b}))}, {c})) = left = right = finite_set_min(union({a}, {finite_set_min(union({b}, {c}))}))

# Translation preserves minimum. For the forward inequality, translate the two
# defining lower bounds. For the reverse inequality, subtract c, form a lower
# bound of finite_set_min(union({a}, {b})), and add c back.
claim:
    ? forall a, b, c R:
        finite_set_min(union({a}, {b})) + c = finite_set_min(union({a + c}, {b + c}))
    finite_set_min(union({a}, {b})) <= a
    finite_set_min(union({a}, {b})) + c <= a + c
    finite_set_min(union({a}, {b})) <= b
    finite_set_min(union({a}, {b})) + c <= b + c
    finite_set_min(union({a}, {b})) + c <= finite_set_min(union({a + c}, {b + c}))
    finite_set_min(union({a + c}, {b + c})) <= a + c
    finite_set_min(union({a + c}, {b + c})) - c <= a
    finite_set_min(union({a + c}, {b + c})) <= b + c
    finite_set_min(union({a + c}, {b + c})) - c <= b
    finite_set_min(union({a + c}, {b + c})) - c <= finite_set_min(union({a}, {b}))
    (finite_set_min(union({a + c}, {b + c})) - c) + c <= finite_set_min(union({a}, {b})) + c
    finite_set_min(union({a + c}, {b + c})) = (finite_set_min(union({a + c}, {b + c})) - c) + c <= finite_set_min(union({a}, {b})) + c

# Weak reverse triangle inequality. Subtracting |b| from the ordinary triangle
# inequality yields the source result directly.
forall a, b R:
    abs(a) - abs(b) <= abs(a - b)

# Divisibility is defined here with integer witnesses. This keeps the corpus
# self-contained while allowing the visible source inputs to remain natural.
prop divides(a Z, b Z):
    exist k Z st {b = a * k}

# A positive divisor of a nonzero integer is at most its absolute value.
thm _positive_divisor_le_abs:
    ? forall d N+, a Z:
        $divides(d, a)
        a != 0
        =>:
            d <= abs(a)
    obtain k from exist k Z st {a = d * k}
    by contra:
        ? k != 0
        k = 0
        a = d * k = d * 0 = 0
        impossible a != 0
    abs(k) > 0
    abs(k) $in N+
    d * 1 <= d * abs(k)
    abs(d) = d
    abs(a) = abs(d * k) = abs(d) * abs(k) = d * abs(k)
    d = d * 1 <= d * abs(k) = abs(a)

# For a nonzero pair, the positive common divisors form a finite nonempty set.
# This is the well-definedness bridge for the source-local gcd construction.
thm _gcd_divisor_set_is_finite_and_nonempty:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $is_finite_set({d N+: $divides(d, a), $divides(d, b)})
            $is_nonempty_set({d N+: $divides(d, a), $divides(d, b)})
    have CarrierC power_set(N) = {d N+: $divides(d, a), $divides(d, b)}
    claim:
        ? $is_finite_set(CarrierC)
        by cases:
            ? $is_finite_set(CarrierC)
            case a != 0:
                claim:
                    ? forall d CarrierC:
                        d $in closed_range(1, abs(a))
                    d $in CarrierC
                    d $in N+
                    d >= 1
                    $divides(d, a)
                    by thm _positive_divisor_le_abs(d, a)
                    d <= abs(a)
                by def:
                    ? CarrierC $subset closed_range(1, abs(a))
                CarrierC $subset closed_range(1, abs(a))
                CarrierC = set_minus(closed_range(1, abs(a)), set_minus(closed_range(1, abs(a)), CarrierC))
                $is_finite_set(set_minus(closed_range(1, abs(a)), set_minus(closed_range(1, abs(a)), CarrierC)))
                $is_finite_set(CarrierC)
            case b != 0:
                claim:
                    ? forall d CarrierC:
                        d $in closed_range(1, abs(b))
                    d $in CarrierC
                    d $in N+
                    d >= 1
                    $divides(d, b)
                    by thm _positive_divisor_le_abs(d, b)
                    d <= abs(b)
                by def:
                    ? CarrierC $subset closed_range(1, abs(b))
                CarrierC $subset closed_range(1, abs(b))
                CarrierC = set_minus(closed_range(1, abs(b)), set_minus(closed_range(1, abs(b)), CarrierC))
                $is_finite_set(set_minus(closed_range(1, abs(b)), set_minus(closed_range(1, abs(b)), CarrierC)))
                $is_finite_set(CarrierC)
    witness $is_nonempty_set(CarrierC) from 1:
        1 $in N+
        witness exist k Z st {a = 1 * k} from a:
            a = 1 * a
        by def:
            ? $divides(1, a)
        $divides(1, a)
        witness exist k Z st {b = 1 * k} from b:
            b = 1 * b
        by def:
            ? $divides(1, b)
        $divides(1, b)
        by thm set_builder_member(1, {d N+: $divides(d, a), $divides(d, b)})
        1 $in {d N+: $divides(d, a), $divides(d, b)}
        1 $in CarrierC
    $is_finite_set({d N+: $divides(d, a), $divides(d, b)})
    $is_nonempty_set({d N+: $divides(d, a), $divides(d, b)})

# The native gcd object is the greatest positive common divisor and is
# well-defined when the input pair is not all zero.

thm gcd_positive:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd(a, b) $in N+

thm gcd_divides_left:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), a)
    by thm gcd_positive(a, b)
    a % gcd(a, b) = 0
    exist k Z st {a = gcd(a, b) * k}
    by def:
        ? $divides(gcd(a, b), a)

thm gcd_divides_right:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), b)
    by thm gcd_positive(a, b)
    b % gcd(a, b) = 0
    exist k Z st {b = gcd(a, b) * k}
    by def:
        ? $divides(gcd(a, b), b)

thm common_divisor_le_gcd:
    ? forall a, b Z, d N+:
        a != 0 or b != 0
        $divides(d, a)
        $divides(d, b)
        =>:
            d <= gcd(a, b)
    by thm gcd_positive(a, b)
    obtain ka from exist ka Z st {a = d * ka}
    obtain kb from exist kb Z st {b = d * kb}
    d = d * 1 + 0
    0 < d
    d % d = 0
    a % d = (d * ka) % d = ((d % d) * (ka % d)) % d = (0 * (ka % d)) % d = 0 % d = 0
    b % d = (d * kb) % d = ((d % d) * (kb % d)) % d = (0 * (kb % d)) % d = 0 % d = 0

thm gcd_euclidean_base:
    ? forall a Z:
        a != 0
        =>:
            gcd(a, 0) = abs(a)
    by thm gcd_positive(a, 0)
    by thm gcd_divides_left(a, 0)
    by thm _positive_divisor_le_abs(gcd(a, 0), a)
    gcd(a, 0) <= abs(a)
    abs(a) > 0
    abs(a) $in N+
    by cases:
        ? $divides(abs(a), a)
        case a >= 0:
            abs(a) = a
            a = a * 1
            abs(a) * 1 = a * 1
            a = abs(a) * 1
            witness exist k Z st {a = abs(a) * k} from 1
            by def:
                ? $divides(abs(a), a)
        case a < 0:
            abs(a) = -a
            a = abs(a) * (-1)
            witness exist k Z st {a = abs(a) * k} from -1
            by def:
                ? $divides(abs(a), a)
    witness exist k Z st {0 = abs(a) * k} from 0:
        0 = abs(a) * 0
    by def:
        ? $divides(abs(a), 0)
    $divides(abs(a), 0)
    by thm common_divisor_le_gcd(a, 0, abs(a))
    abs(a) <= gcd(a, 0)

# Divisibility transitivity on the source's natural-number carrier.
claim:
    ? forall x, y, z N:
        $divides(x, y)
        $divides(y, z)
        =>:
            $divides(x, z)
    obtain k from exist k Z st {y = x * k}
    obtain l from exist l Z st {z = y * l}
    witness exist m Z st {z = x * m} from k * l:
        z = y * l = (x * k) * l = x * (k * l)
    by def:
        ? $divides(x, z)

# A factor divides any product containing it. Commutativity places x first and
# exposes y*z as the witness.
claim:
    ? forall x, y, z N:
        $divides(x, y * x * z)
    witness exist k Z st {y * x * z = x * k} from y * z:
        y * x * z = x * (y * z)
    by def:
        ? $divides(x, y * x * z)

# Every natural number divides its square, witnessed by the number itself in Z.
claim:
    ? forall x N:
        $divides(x, x^2)
    witness exist k Z st {x^2 = x * k} from x:
        x^2 = x * x
    by def:
        ? $divides(x, x^2)

# Gcd symmetry on the nonzero natural pairs supported by the local construction.
# Unlike the source's total Nat.gcd, this gcd is undefined
# at (0,0), so this is an explicit nonzero adaptation rather than a claim of
# total-source equivalence. Both guard orientations make the two calls visibly
# well-defined. Each gcd divides both inputs, hence each is at most the other.
thm gcd_comm:
    ? forall a, b N:
        a != 0 or b != 0
        b != 0 or a != 0
        =>:
            gcd(a, b) = gcd(b, a)
    by thm gcd_positive(a, b)
    by thm gcd_divides_left(a, b)
    by thm gcd_divides_right(a, b)
    by thm common_divisor_le_gcd(b, a, gcd(a, b))
    gcd(a, b) <= gcd(b, a)
    by thm gcd_positive(b, a)
    by thm gcd_divides_left(b, a)
    by thm gcd_divides_right(b, a)
    by thm common_divisor_le_gcd(a, b, gcd(b, a))
    gcd(b, a) <= gcd(a, b)

# 2.5 Proving Facts about Algebraic Structures

# A partial order is one mathematical object even though it has only one
# primitive relation. Its laws belong to the object rather than every caller.
struct PartialOrder<s set>:
    le_rel power_set(cart(s, s))
    <=>:
        forall x s:
            (x, x) $in le_rel
        forall x, y, z s:
            (x, y) $in le_rel
            (y, z) $in le_rel
            =>:
                (x, z) $in le_rel
        forall x, y s:
            (x, y) $in le_rel
            (y, x) $in le_rel
            =>:
                x = y

# In a generic partial-order object, strict comparison means non-strict
# comparison together with inequality.
prop is_less_than_in_order(A set, order &PartialOrder<A>, x, y A):
    (x, y) $in order.le_rel
    x != y

# The source example `x < y ↔ x ≤ y ∧ x ≠ y` is now definitional: unfolding
# the strict relation gives exactly the two displayed conditions.
trust forall A set, order &PartialOrder<A>, x, y A:
    =>:
        $is_less_than_in_order(A, order, x, y)
    <=>:
        (x, y) $in order.le_rel
        x != y

# A lattice packages a partial order with callable meet and join operations.
# The final two law families are the universal properties: meet is the
# greatest lower bound and join is the least upper bound.
struct Lattice<s nonempty_set>:
    order &PartialOrder<s>
    meet fn(x, y s) s
    join fn(x, y s) s
    <=>:
        forall x, y s:
            (meet(x, y), x) $in order.le_rel
            (meet(x, y), y) $in order.le_rel
            (x, join(x, y)) $in order.le_rel
            (y, join(x, y)) $in order.le_rel
        forall x, y, z s:
            (z, x) $in order.le_rel
            (z, y) $in order.le_rel
            =>:
                (z, meet(x, y)) $in order.le_rel
        forall x, y, z s:
            (x, z) $in order.le_rel
            (y, z) $in order.le_rel
            =>:
                (join(x, y), z) $in order.le_rel

# The stored order relation is transitive. Naming this standard projection lets
# later lattice proofs compose inequalities without reopening the struct laws.
thm lattice_le_trans:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y, z s:
        (x, y) $in lattice.order.le_rel
        (y, z) $in lattice.order.le_rel
        =>:
            (x, z) $in lattice.order.le_rel

# The source's meet-commutativity example follows because each meet is a lower
# bound for the arguments of the other meet; antisymmetry then identifies them.
thm lattice_meet_comm:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.meet(x, y) = lattice.meet(y, x)
    (lattice.meet(x, y), y) $in lattice.order.le_rel
    (lattice.meet(x, y), x) $in lattice.order.le_rel
    (lattice.meet(x, y), lattice.meet(y, x)) $in lattice.order.le_rel
    (lattice.meet(y, x), x) $in lattice.order.le_rel
    (lattice.meet(y, x), y) $in lattice.order.le_rel
    (lattice.meet(y, x), lattice.meet(x, y)) $in lattice.order.le_rel

# The source's meet-associativity example compares the two nested meets as
# greatest lower bounds of x, y, and z. Transitivity supplies the four
# component bounds; the meet universal property and antisymmetry finish.
thm lattice_meet_assoc:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y, z s:
        lattice.meet(lattice.meet(x, y), z) = lattice.meet(x, lattice.meet(y, z))
    (lattice.meet(lattice.meet(x, y), z), lattice.meet(x, y)) $in lattice.order.le_rel
    (lattice.meet(x, y), x) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, lattice.meet(lattice.meet(x, y), z), lattice.meet(x, y), x)
    (lattice.meet(x, y), y) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, lattice.meet(lattice.meet(x, y), z), lattice.meet(x, y), y)
    (lattice.meet(lattice.meet(x, y), z), z) $in lattice.order.le_rel
    (lattice.meet(lattice.meet(x, y), z), lattice.meet(y, z)) $in lattice.order.le_rel
    (lattice.meet(lattice.meet(x, y), z), lattice.meet(x, lattice.meet(y, z))) $in lattice.order.le_rel
    (lattice.meet(x, lattice.meet(y, z)), x) $in lattice.order.le_rel
    (lattice.meet(x, lattice.meet(y, z)), lattice.meet(y, z)) $in lattice.order.le_rel
    (lattice.meet(y, z), y) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, lattice.meet(x, lattice.meet(y, z)), lattice.meet(y, z), y)
    (lattice.meet(y, z), z) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, lattice.meet(x, lattice.meet(y, z)), lattice.meet(y, z), z)
    (lattice.meet(x, lattice.meet(y, z)), lattice.meet(x, y)) $in lattice.order.le_rel
    (lattice.meet(x, lattice.meet(y, z)), lattice.meet(lattice.meet(x, y), z)) $in lattice.order.le_rel

# The join-commutativity example is dual: each join is an upper bound for the
# arguments of the other join, and antisymmetry closes the equality.
thm lattice_join_comm:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.join(x, y) = lattice.join(y, x)
    (y, lattice.join(x, y)) $in lattice.order.le_rel
    (x, lattice.join(x, y)) $in lattice.order.le_rel
    (lattice.join(y, x), lattice.join(x, y)) $in lattice.order.le_rel
    (x, lattice.join(y, x)) $in lattice.order.le_rel
    (y, lattice.join(y, x)) $in lattice.order.le_rel
    (lattice.join(x, y), lattice.join(y, x)) $in lattice.order.le_rel

# The source's join-associativity example is the order-dual argument. Each
# nested join is an upper bound for x, y, and z, so the least-upper-bound law
# gives both comparisons and antisymmetry identifies the joins.
thm lattice_join_assoc:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y, z s:
        lattice.join(lattice.join(x, y), z) = lattice.join(x, lattice.join(y, z))
    (x, lattice.join(x, y)) $in lattice.order.le_rel
    (lattice.join(x, y), lattice.join(lattice.join(x, y), z)) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, x, lattice.join(x, y), lattice.join(lattice.join(x, y), z))
    (y, lattice.join(x, y)) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, y, lattice.join(x, y), lattice.join(lattice.join(x, y), z))
    (z, lattice.join(lattice.join(x, y), z)) $in lattice.order.le_rel
    (lattice.join(y, z), lattice.join(lattice.join(x, y), z)) $in lattice.order.le_rel
    (lattice.join(x, lattice.join(y, z)), lattice.join(lattice.join(x, y), z)) $in lattice.order.le_rel
    (x, lattice.join(x, lattice.join(y, z))) $in lattice.order.le_rel
    (y, lattice.join(y, z)) $in lattice.order.le_rel
    (lattice.join(y, z), lattice.join(x, lattice.join(y, z))) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, y, lattice.join(y, z), lattice.join(x, lattice.join(y, z)))
    (z, lattice.join(y, z)) $in lattice.order.le_rel
    by thm lattice_le_trans(s, lattice, z, lattice.join(y, z), lattice.join(x, lattice.join(y, z)))
    (lattice.join(x, y), lattice.join(x, lattice.join(y, z))) $in lattice.order.le_rel
    (lattice.join(lattice.join(x, y), z), lattice.join(x, lattice.join(y, z))) $in lattice.order.le_rel

# Result (source label: absorb1). The meet is below x. Conversely, x is below
# both x and x join y, so it is below their meet; antisymmetry gives equality.
thm lattice_meet_join_absorb:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.meet(x, lattice.join(x, y)) = x
    (lattice.meet(x, lattice.join(x, y)), x) $in lattice.order.le_rel
    (x, x) $in lattice.order.le_rel
    (x, lattice.join(x, y)) $in lattice.order.le_rel
    (x, lattice.meet(x, lattice.join(x, y))) $in lattice.order.le_rel

# Result (source label: absorb2). This is the order-dual argument: x and
# x meet y are below x, so their join is below x, while x is below the join.
thm lattice_join_meet_absorb:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.join(x, lattice.meet(x, y)) = x
    (x, lattice.join(x, lattice.meet(x, y))) $in lattice.order.le_rel
    (x, x) $in lattice.order.le_rel
    (lattice.meet(x, y), x) $in lattice.order.le_rel
    (lattice.join(x, lattice.meet(x, y)), x) $in lattice.order.le_rel

# A distributive lattice adds no new operations to a lattice. This residual
# property records the source's four standard left and right distribution
# laws while retaining the same callable meet and join.
prop is_distributive_lattice(s nonempty_set, lattice &Lattice<s>):
    forall x, y, z s:
        lattice.meet(x, lattice.join(y, z)) = lattice.join(lattice.meet(x, y), lattice.meet(x, z))
        lattice.meet(lattice.join(x, y), z) = lattice.join(lattice.meet(x, z), lattice.meet(y, z))
        lattice.join(x, lattice.meet(y, z)) = lattice.meet(lattice.join(x, y), lattice.join(x, z))
        lattice.join(lattice.meet(x, y), z) = lattice.meet(lattice.join(x, z), lattice.join(y, z))

# The source next assumes only meet-over-join distributivity and derives the
# dual join-over-meet law. Expand the right side once, commute the inner meets,
# distribute again, reassociate, and absorb the repeated a term.
thm lattice_join_meet_distributive_of_meet_join_distributive:
    ? forall s nonempty_set, lattice &Lattice<s>, a, b, c s:
        forall x, y, z s:
            lattice.meet(x, lattice.join(y, z)) = lattice.join(lattice.meet(x, y), lattice.meet(x, z))
        =>:
            lattice.join(a, lattice.meet(b, c)) = lattice.meet(lattice.join(a, b), lattice.join(a, c))
    lattice.meet(lattice.join(a, b), lattice.join(a, c)) = lattice.join(lattice.meet(lattice.join(a, b), a), lattice.meet(lattice.join(a, b), c))
    by thm lattice_meet_comm(s, lattice, lattice.join(a, b), a)
    by thm lattice_meet_join_absorb(s, lattice, a, b)
    by thm lattice_meet_comm(s, lattice, lattice.join(a, b), c)
    lattice.meet(c, lattice.join(a, b)) = lattice.join(lattice.meet(c, a), lattice.meet(c, b))
    by thm lattice_meet_comm(s, lattice, c, a)
    by thm lattice_meet_comm(s, lattice, c, b)
    lattice.meet(lattice.join(a, b), c) = lattice.meet(c, lattice.join(a, b)) = lattice.join(lattice.meet(c, a), lattice.meet(c, b)) = lattice.join(lattice.meet(a, c), lattice.meet(c, b)) = lattice.join(lattice.meet(a, c), lattice.meet(b, c))
    by thm lattice_join_assoc(s, lattice, a, lattice.meet(a, c), lattice.meet(b, c))
    by thm lattice_join_meet_absorb(s, lattice, a, c)
    lattice.meet(lattice.join(a, b), lattice.join(a, c)) = lattice.join(lattice.meet(lattice.join(a, b), a), lattice.meet(lattice.join(a, b), c)) = lattice.join(a, lattice.meet(lattice.join(a, b), c)) = lattice.join(a, lattice.join(lattice.meet(a, c), lattice.meet(b, c))) = lattice.join(lattice.join(a, lattice.meet(a, c)), lattice.meet(b, c)) = lattice.join(a, lattice.meet(b, c))

# Conversely, join-over-meet distributivity implies meet-over-join
# distributivity by the order-dual calculation with join and meet exchanged.
thm lattice_meet_join_distributive_of_join_meet_distributive:
    ? forall s nonempty_set, lattice &Lattice<s>, a, b, c s:
        forall x, y, z s:
            lattice.join(x, lattice.meet(y, z)) = lattice.meet(lattice.join(x, y), lattice.join(x, z))
        =>:
            lattice.meet(a, lattice.join(b, c)) = lattice.join(lattice.meet(a, b), lattice.meet(a, c))
    lattice.join(lattice.meet(a, b), lattice.meet(a, c)) = lattice.meet(lattice.join(lattice.meet(a, b), a), lattice.join(lattice.meet(a, b), c))
    by thm lattice_join_comm(s, lattice, lattice.meet(a, b), a)
    by thm lattice_join_meet_absorb(s, lattice, a, b)
    by thm lattice_join_comm(s, lattice, lattice.meet(a, b), c)
    lattice.join(c, lattice.meet(a, b)) = lattice.meet(lattice.join(c, a), lattice.join(c, b))
    by thm lattice_join_comm(s, lattice, c, a)
    by thm lattice_join_comm(s, lattice, c, b)
    lattice.join(lattice.meet(a, b), c) = lattice.join(c, lattice.meet(a, b)) = lattice.meet(lattice.join(c, a), lattice.join(c, b)) = lattice.meet(lattice.join(a, c), lattice.join(c, b)) = lattice.meet(lattice.join(a, c), lattice.join(b, c))
    by thm lattice_meet_assoc(s, lattice, a, lattice.join(a, c), lattice.join(b, c))
    by thm lattice_meet_join_absorb(s, lattice, a, c)
    lattice.join(lattice.meet(a, b), lattice.meet(a, c)) = lattice.meet(lattice.join(lattice.meet(a, b), a), lattice.join(lattice.meet(a, b), c)) = lattice.meet(a, lattice.join(lattice.meet(a, b), c)) = lattice.meet(a, lattice.meet(lattice.join(a, c), lattice.join(b, c))) = lattice.meet(lattice.meet(a, lattice.join(a, c)), lattice.join(b, c)) = lattice.meet(a, lattice.join(b, c))

# The source's strict ordered ring combines an existing ring object with an
# existing partial-order object. This residual property adds only the
# compatibility laws; it does not receive or reconstruct loose operations.
prop is_ordered_ring(s nonempty_set, ring &Ring<s>, order &PartialOrder<s>):
    forall a, b, c s:
        (a, b) $in order.le_rel
        =>:
            (ring.add(c, a), ring.add(c, b)) $in order.le_rel
    forall a, b s:
        (ring.zero, a) $in order.le_rel
        (ring.zero, b) $in order.le_rel
        =>:
            (ring.zero, ring.mul(a, b)) $in order.le_rel

# Adding -a to a <= b gives 0 <= b-a.
thm ring_sub_nonnegative_of_le:
    ? forall s nonempty_set, ring &Ring<s>, order &PartialOrder<s>, a, b s:
        $is_ordered_ring(s, ring, order)
        (a, b) $in order.le_rel
        =>:
            (ring.zero, ring.add(b, ring.neg(a))) $in order.le_rel
    (ring.add(ring.neg(a), a), ring.add(ring.neg(a), b)) $in order.le_rel
    ring.add(ring.neg(a), a) = ring.zero
    ring.add(ring.neg(a), b) = ring.add(b, ring.neg(a))

# Conversely, adding a to 0 <= b-a and cancelling a with -a recovers a <= b.
thm ring_le_of_sub_nonnegative:
    ? forall s nonempty_set, ring &Ring<s>, order &PartialOrder<s>, a, b s:
        $is_ordered_ring(s, ring, order)
        (ring.zero, ring.add(b, ring.neg(a))) $in order.le_rel
        =>:
            (a, b) $in order.le_rel
    (ring.add(a, ring.zero), ring.add(a, ring.add(b, ring.neg(a)))) $in order.le_rel
    by thm add_zero_from_laws(s, ring.add, ring.zero, ring.neg, a)
    by thm add_neg_cancel_from_laws(s, ring.add, ring.zero, ring.neg, a)
    by thm add_zero_from_laws(s, ring.add, ring.zero, ring.neg, b)
    ring.add(a, b) = ring.add(b, a)
    ring.add(ring.add(a, b), ring.neg(a)) = ring.add(ring.add(b, a), ring.neg(a))
    ring.add(a, ring.add(b, ring.neg(a))) = ring.add(ring.add(a, b), ring.neg(a)) = ring.add(ring.add(b, a), ring.neg(a)) = ring.add(b, ring.add(a, ring.neg(a))) = ring.add(b, ring.zero) = b

# If a <= b and c is nonnegative, then b-a and c have a nonnegative product.
# Right distributivity rewrites that product as bc-ac, and the preceding
# equivalence gives ac <= bc.
thm ring_mul_le_mul_right_of_nonnegative:
    ? forall s nonempty_set, ring &Ring<s>, order &PartialOrder<s>, a, b, c s:
        $is_ordered_ring(s, ring, order)
        (a, b) $in order.le_rel
        (ring.zero, c) $in order.le_rel
        =>:
            (ring.mul(a, c), ring.mul(b, c)) $in order.le_rel
    by thm ring_sub_nonnegative_of_le(s, ring, order, a, b)
    (ring.zero, ring.mul(ring.add(b, ring.neg(a)), c)) $in order.le_rel
    by def:
        ? $ring_laws(s, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    by thm neg_mul_left(s, ring.add, ring.zero, ring.neg, ring.mul, ring.one, a, c)
    ring.mul(ring.add(b, ring.neg(a)), c) = ring.add(ring.mul(b, c), ring.mul(ring.neg(a), c)) = ring.add(ring.mul(b, c), ring.neg(ring.mul(a, c)))
    (ring.zero, ring.add(ring.mul(b, c), ring.neg(ring.mul(a, c)))) $in order.le_rel
    by thm ring_le_of_sub_nonnegative(s, ring, order, ring.mul(a, c), ring.mul(b, c))

# A candidate real-valued distance satisfies the metric laws below. This raw
# operation relation is only the construction boundary for MetricSpace<X>;
# consumers receive the structure object.
prop metric_space_laws(X set, dist fn(x, y X) R):
    forall x, y X:
        dist(x, y) >= 0
    forall x, y X:
        dist(x, y) = 0
        =>:
            x = y
    forall x, y X:
        x = y
        =>:
            dist(x, y) = 0
    forall x, y X:
        dist(x, y) = dist(y, x)
    forall x, y, z X:
        dist(x, z) <= dist(x, y) + dist(y, z)

# A metric space is the candidate distance itself, viewed through its checked
# laws. The one-field struct avoids both a dummy field and repeated loose
# distance hypotheses.
struct MetricSpace<X set>:
    dist fn(x, y X) R
    <=>:
        $metric_space_laws(X, dist)

# The final source example in this section is the nonnegativity projection
# from the metric-space object.
thm metric_distance_nonnegative:
    ? forall X set, metric &MetricSpace<X>, x, y X:
        metric.dist(x, y) >= 0

thm metric_eq_of_distance_zero:
    ? forall X set, metric &MetricSpace<X>, x, y X:
        metric.dist(x, y) = 0
        =>:
            x = y

thm metric_distance_self_zero:
    ? forall X set, metric &MetricSpace<X>, x X:
        metric.dist(x, x) = 0
