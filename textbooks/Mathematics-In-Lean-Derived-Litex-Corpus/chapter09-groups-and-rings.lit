# Chapter 9 — Groups and Rings
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# The chapter follows the source order. Anonymous tactic variants are folded
# into one mathematical statement, while named constructions remain callable
# objects.

# ---------------------------------------------------------------------------
# 9.1 Groups
# ---------------------------------------------------------------------------

# A monoid carries associative multiplication and a two-sided identity.
prop is_monoid(M set, mul fn(x, y M) M, one M):
    forall x, y, z M:
        mul(mul(x, y), z) = mul(x, mul(y, z))
    forall x M:
        mul(one, x) = x
    forall x M:
        mul(x, one) = x

# Additive commutative monoids are kept separate from additive groups because
# the opening examples do not assume additive inverses.
prop is_additive_commutative_monoid(M set, add fn(x, y M) M, zero M):
    forall x, y, z M:
        add(add(x, y), z) = add(x, add(y, z))
    forall x M:
        add(zero, x) = x
    forall x M:
        add(x, zero) = x
    forall x, y M:
        add(x, y) = add(y, x)

# Ordered finite folds are the common executable interface used below for
# polynomial convolution and evaluation, and by Chapter 10 for matrix sums.
template<M nonempty_set, add fn(x, y M) M, zero M>:
    have fn finite_range_sum(f fn(index N) M, n N) M by induc n from 0:
        case n = 0: zero
        case n > 0: add(finite_range_sum(f, n - 1), f(n - 1))

thm finite_range_sum_zero:
    ? forall M nonempty_set, add fn(x, y M) M, zero M, f fn(index N) M:
        $is_additive_commutative_monoid(M, add, zero)
        =>:
            \finite_range_sum<M, add, zero>(f, 0) = zero

thm finite_range_sum_succ:
    ? forall M nonempty_set, add fn(x, y M) M, zero M, f fn(index N) M, n N:
        $is_additive_commutative_monoid(M, add, zero)
        =>:
            \finite_range_sum<M, add, zero>(f, n + 1) = add(\finite_range_sum<M, add, zero>(f, n), f(n))
    n + 1 > 0
    n + 1 - 1 = n
    \finite_range_sum<M, add, zero>(f, n + 1) = add(\finite_range_sum<M, add, zero>(f, n + 1 - 1), f(n + 1 - 1)) = add(\finite_range_sum<M, add, zero>(f, n), f(n))

thm finite_range_sum_all_zero:
    ? forall M nonempty_set, add fn(x, y M) M, zero M, f fn(index N) M, n N:
        $is_additive_commutative_monoid(M, add, zero)
        forall index range(0, n):
            f(index) = zero
        =>:
            \finite_range_sum<M, add, zero>(f, n) = zero
    prop _finite_range_sum_all_zero_at(count N):
        forall token M:
            token = zero
            forall index range(0, count):
                f(index) = zero
            =>:
                \finite_range_sum<M, add, zero>(f, count) = add(zero, token)
    claim:
        ? forall count N:
            $_finite_range_sum_all_zero_at(count)
        by induc count from 0:
            ? $_finite_range_sum_all_zero_at(count)
            ? from count = 0:
                claim:
                    ? forall token M:
                        token = zero
                        forall index range(0, count):
                            f(index) = zero
                        =>:
                            \finite_range_sum<M, add, zero>(f, count) = add(zero, token)
                    release thm finite_range_sum_zero(M, add, zero, f)
                    \finite_range_sum<M, add, zero>(f, count) = zero = add(zero, zero) = add(zero, token)
                by def:
                    ? $_finite_range_sum_all_zero_at(count)
            ? induc:
                $_finite_range_sum_all_zero_at(count)
                claim:
                    ? forall token M:
                        token = zero
                        forall index range(0, count + 1):
                            f(index) = zero
                        =>:
                            \finite_range_sum<M, add, zero>(f, count + 1) = add(zero, token)
                    claim:
                        ? forall index range(0, count):
                            f(index) = zero
                    $_finite_range_sum_all_zero_at(count)
                    \finite_range_sum<M, add, zero>(f, count) = add(zero, token) = token = zero
                    count < count + 1
                    f(count) = zero
                    release thm finite_range_sum_succ(M, add, zero, f, count)
                    \finite_range_sum<M, add, zero>(f, count + 1) = add(\finite_range_sum<M, add, zero>(f, count), f(count)) = add(zero, zero) = zero = add(zero, token)
                by def:
                    ? $_finite_range_sum_all_zero_at(count + 1)
    $_finite_range_sum_all_zero_at(n)
    zero = zero
    \finite_range_sum<M, add, zero>(f, n) = add(zero, zero) = zero

prop is_monoid_hom(M, T set, mulM fn(x, y M) M, oneM M, mulT fn(x, y T) T, oneT T, f fn(x M) T):
    f(oneM) = oneT
    forall x, y M:
        f(mulM(x, y)) = mulT(f(x), f(y))

prop is_additive_monoid_hom(M, T set, addM fn(x, y M) M, zeroM M, addT fn(x, y T) T, zeroT T, f fn(x M) T):
    f(zeroM) = zeroT
    forall x, y M:
        f(addM(x, y)) = addT(f(x), f(y))

template<A, B, CarrierC set>:
    have fn compose_map(g fn(y B) CarrierC, f fn(x A) B) fn(z A) CarrierC = fn(t A) CarrierC {g(f(t))}

# Opening monoid identities and map laws are facts, not proposition-valued
# declarations. They check directly from the interfaces above.
thm monoid_mul_one:
    ? forall M set, mul fn(x, y M) M, one M, x M:
        $is_monoid(M, mul, one)
        =>:
            mul(x, one) = x

thm additive_commutative_monoid_add_comm:
    ? forall M set, add fn(x, y M) M, zero M, x, y M:
        $is_additive_commutative_monoid(M, add, zero)
        =>:
            add(x, y) = add(y, x)

thm monoid_hom_map_mul:
    ? forall M, T set, mulM fn(x, y M) M, oneM M, mulT fn(x, y T) T, oneT T, f fn(x M) T, x, y M:
        $is_monoid_hom(M, T, mulM, oneM, mulT, oneT, f)
        =>:
            f(mulM(x, y)) = mulT(f(x), f(y))

thm additive_hom_map_zero:
    ? forall M, T set, addM fn(x, y M) M, zeroM M, addT fn(x, y T) T, zeroT T, f fn(x M) T:
        $is_additive_monoid_hom(M, T, addM, zeroM, addT, zeroT, f)
        =>:
            f(zeroM) = zeroT

thm additive_hom_comp:
    ? forall A, B, CarrierC set, addA fn(x, y A) A, zeroA A, addB fn(x, y B) B, zeroB B, addC fn(x, y CarrierC) CarrierC, zeroC CarrierC, f fn(x A) B, g fn(y B) CarrierC:
        $is_additive_monoid_hom(A, B, addA, zeroA, addB, zeroB, f)
        $is_additive_monoid_hom(B, CarrierC, addB, zeroB, addC, zeroC, g)
        =>:
            $is_additive_monoid_hom(A, CarrierC, addA, zeroA, addC, zeroC, fn(x A) CarrierC {g(f(x))})
    (fn(x A) CarrierC {g(f(x))})(zeroA) = g(f(zeroA)) = g(zeroB) = zeroC
    claim:
        ? forall x, y A:
            (fn(q A) CarrierC {g(f(q))})(addA(x, y)) = addC((fn(q A) CarrierC {g(f(q))})(x), (fn(q A) CarrierC {g(f(q))})(y))
        thm function_substitution:
            ? forall U, V set, h fn(q U) V, u, v U:
                u = v
                =>:
                    h(u) = h(v)
        release thm function_substitution(B, CarrierC, g, f(addA(x, y)), addB(f(x), f(y)))
        (fn(q A) CarrierC {g(f(q))})(addA(x, y)) = g(f(addA(x, y))) = g(addB(f(x), f(y))) = addC(g(f(x)), g(f(y))) = addC((fn(q A) CarrierC {g(f(q))})(x), (fn(q A) CarrierC {g(f(q))})(y))
    by def:
        ? $is_additive_monoid_hom(A, CarrierC, addA, zeroA, addC, zeroC, fn(x A) CarrierC {g(f(x))})

# A group homomorphism is a property of a candidate function between two
# operation-bearing Chapter 2 group values.
prop is_group_hom(G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H):
    $is_monoid_hom(G, H, source.mul, source.one, target.mul, target.one, f)

# Bijectivity is still a property of one displayed homomorphism. A genuine
# GroupEquiv would additionally store mutually inverse forward and inverse maps.
prop is_bijective_group_hom(G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H):
    $is_group_hom(G, H, source, target, f)
    $bijective(G, H, f)

thm group_mul_inv_cancel:
    ? forall G nonempty_set, group &chap2::Group<G>, x G:
        group.mul(x, group.inv(x)) = group.one
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, x)

thm group_hom_map_mul:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H, x, y G:
        $is_group_hom(G, H, source, target, f)
        =>:
            f(source.mul(x, y)) = target.mul(f(x), f(y))

# Source normalization example. The proof uses explicit associativity and
# inside-out cancellation chains because nested rewrites are not implicit.
thm group_normalization_identity:
    ? forall G nonempty_set, group &chap2::Group<G>, x, y, z G:
        group.mul(group.mul(group.mul(x, group.mul(y, z)), group.inv(group.mul(x, z))), group.inv(group.mul(group.mul(x, y), group.inv(x)))) = group.one
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    release thm chap2::mul_inv_rev_structure(G, group.mul, group.one, group.inv, x, z)
    group.inv(group.mul(x, z)) = group.mul(group.inv(z), group.inv(x))
    group.mul(group.mul(x, group.mul(y, z)), group.inv(group.mul(x, z))) = group.mul(group.mul(x, group.mul(y, z)), group.mul(group.inv(z), group.inv(x)))
    group.mul(group.mul(x, group.mul(y, z)), group.mul(group.inv(z), group.inv(x))) = group.mul(x, group.mul(group.mul(y, z), group.mul(group.inv(z), group.inv(x))))
    group.mul(z, group.mul(group.inv(z), group.inv(x))) = group.mul(group.mul(z, group.inv(z)), group.inv(x))
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, z)
    group.mul(group.mul(z, group.inv(z)), group.inv(x)) = group.mul(group.one, group.inv(x)) = group.inv(x)
    group.mul(group.mul(y, z), group.mul(group.inv(z), group.inv(x))) = group.mul(y, group.mul(z, group.mul(group.inv(z), group.inv(x)))) = group.mul(y, group.mul(group.mul(z, group.inv(z)), group.inv(x))) = group.mul(y, group.inv(x))
    group.mul(x, group.mul(group.mul(y, z), group.mul(group.inv(z), group.inv(x)))) = group.mul(x, group.mul(y, group.inv(x)))
    group.mul(x, group.mul(y, group.inv(x))) = group.mul(group.mul(x, y), group.inv(x))
    group.mul(group.mul(x, group.mul(y, z)), group.inv(group.mul(x, z))) = group.mul(group.mul(x, y), group.inv(x))
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, group.mul(group.mul(x, y), group.inv(x)))
    group.mul(group.mul(group.mul(x, group.mul(y, z)), group.inv(group.mul(x, z))), group.inv(group.mul(group.mul(x, y), group.inv(x)))) = group.mul(group.mul(group.mul(x, y), group.inv(x)), group.inv(group.mul(group.mul(x, y), group.inv(x)))) = group.one

# A group homomorphism preserves inverses. This is the source map_inv example.
thm group_hom_map_inv:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H, x G:
        $is_group_hom(G, H, source, target, f)
        =>:
            f(source.inv(x)) = target.inv(f(x))
    by def:
        ? $chap2::group_laws(H, target.mul, target.one, target.inv)
    source.mul(source.inv(x), x) = source.one
    target.mul(f(source.inv(x)), f(x)) = f(source.mul(source.inv(x), x)) = f(source.one) = target.one
    release thm chap2::mul_inv_cancel_structure(H, target.mul, target.one, target.inv, f(x))
    target.mul(f(x), target.inv(f(x))) = target.one
    release thm chap2::mul_one_structure(H, target.mul, target.one, target.inv, f(source.inv(x)))
    f(source.inv(x)) = target.mul(f(source.inv(x)), target.one) = target.mul(f(source.inv(x)), target.mul(f(x), target.inv(f(x))))
    target.mul(f(source.inv(x)), target.mul(f(x), target.inv(f(x)))) = target.mul(target.mul(f(source.inv(x)), f(x)), target.inv(f(x)))
    target.mul(target.mul(f(source.inv(x)), f(x)), target.inv(f(x))) = target.mul(target.one, target.inv(f(x))) = target.inv(f(x))

thm bijective_group_hom_is_equivalence:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H:
        $is_group_hom(G, H, source, target, f)
        $bijective(G, H, f)
        =>:
            $is_bijective_group_hom(G, H, source, target, f)
    by def:
        ? $is_bijective_group_hom(G, H, source, target, f)

# ---------------------------------------------------------------------------
# 9.1.3 Subgroups
# ---------------------------------------------------------------------------

prop is_subgroup(G nonempty_set, group &chap2::Group<G>, H power_set(G)):
    group.one $in H
    forall x, y G:
        x $in H
        y $in H
        =>:
            group.mul(x, y) $in H
    forall x G:
        x $in H
        =>:
            group.inv(x) $in H

thm subgroup_mul_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), x, y G:
        $is_subgroup(G, group, H)
        x $in H
        y $in H
        =>:
            group.mul(x, y) $in H

thm subgroup_inv_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), x G:
        $is_subgroup(G, group, H)
        x $in H
        =>:
            group.inv(x) $in H

template<G set>:
    have fn subgroup_intersection(H, K power_set(G)) power_set(G) = {x G: x $in H and x $in K}

template<G set>:
    have subgroup_top power_set(G) = G

template<G set, one G>:
    have subgroup_bottom power_set(G) = {one}

thm subgroup_intersection_closed:
    ? forall G nonempty_set, group &chap2::Group<G>, H, K power_set(G):
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, K)
        =>:
            $is_subgroup(G, group, {x G: x $in H and x $in K})
    group.one $in H
    group.one $in K
    release thm set_builder_member(group.one, {x G: x $in H and x $in K})
    group.one $in {x G: x $in H and x $in K}
    claim:
        ? forall x, y {q G: q $in H and q $in K}:
            group.mul(x, y) $in {q G: q $in H and q $in K}
        x $in H
        x $in K
        y $in H
        y $in K
        group.mul(x, y) $in H
        group.mul(x, y) $in K
        release thm set_builder_member(group.mul(x, y), {q G: q $in H and q $in K})
    claim:
        ? forall x {q G: q $in H and q $in K}:
            group.inv(x) $in {q G: q $in H and q $in K}
        x $in H
        x $in K
        group.inv(x) $in H
        group.inv(x) $in K
        release thm set_builder_member(group.inv(x), {q G: q $in H and q $in K})
    by def:
        ? $is_subgroup(G, group, {x G: x $in H and x $in K})

prop has_subgroup_map_preimage(G, H set, f fn(x G) H, S power_set(G), y H):
    exist x G st {x $in S, f(x) = y}

template<G, H set, f fn(x G) H>:
    have fn subgroup_map(S power_set(G)) power_set(H) = {y H: $has_subgroup_map_preimage(G, H, f, S, y)}

template<G, H set, f fn(x G) H>:
    have fn subgroup_comap(T power_set(H)) power_set(G) = {x G: f(x) $in T}

template<G, H set, oneH H, f fn(x G) H>:
    have group_kernel power_set(G) = {x G: f(x) = oneH}

template<G, H set, f fn(x G) H>:
    have group_range power_set(H) = \subgroup_map<G, H, f>(G)

# The source map/comap/kernel/range examples are subgroup constructions.
# Their carrier formulas are already explicit above; only closure is debt.
thm subgroup_map_closed:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H, S power_set(G):
        $is_group_hom(G, H, source, target, f)
        $is_subgroup(G, source, S)
        =>:
            $is_subgroup(H, target, \subgroup_map<G, H, f>(S))
    \subgroup_map<G, H, f>(S) = {y H: $has_subgroup_map_preimage(G, H, f, S, y)}
    witness $has_subgroup_map_preimage(G, H, f, S, target.one) from source.one
    release thm set_builder_member(target.one, {y H: $has_subgroup_map_preimage(G, H, f, S, y)})
    target.one $in {y H: $has_subgroup_map_preimage(G, H, f, S, y)}
    target.one $in \subgroup_map<G, H, f>(S)
    claim:
        ? forall a, b H:
            a $in \subgroup_map<G, H, f>(S)
            b $in \subgroup_map<G, H, f>(S)
            =>:
                target.mul(a, b) $in \subgroup_map<G, H, f>(S)
        by def:
            ? $has_subgroup_map_preimage(G, H, f, S, a)
        obtain x from $has_subgroup_map_preimage(G, H, f, S, a)
        by def:
            ? $has_subgroup_map_preimage(G, H, f, S, b)
        obtain y from $has_subgroup_map_preimage(G, H, f, S, b)
        witness $has_subgroup_map_preimage(G, H, f, S, target.mul(a, b)) from source.mul(x, y):
            f(source.mul(x, y)) = target.mul(f(x), f(y)) = target.mul(a, b)
        release thm set_builder_member(target.mul(a, b), {q H: $has_subgroup_map_preimage(G, H, f, S, q)})
        target.mul(a, b) $in {q H: $has_subgroup_map_preimage(G, H, f, S, q)}
    claim:
        ? forall a H:
            a $in \subgroup_map<G, H, f>(S)
            =>:
                target.inv(a) $in \subgroup_map<G, H, f>(S)
        by def:
            ? $has_subgroup_map_preimage(G, H, f, S, a)
        obtain x from $has_subgroup_map_preimage(G, H, f, S, a)
        release thm group_hom_map_inv(G, H, source, target, f, x)
        witness $has_subgroup_map_preimage(G, H, f, S, target.inv(a)) from source.inv(x):
            f(source.inv(x)) = target.inv(f(x)) = target.inv(a)
        release thm set_builder_member(target.inv(a), {q H: $has_subgroup_map_preimage(G, H, f, S, q)})
        target.inv(a) $in {q H: $has_subgroup_map_preimage(G, H, f, S, q)}
    by def:
        ? $is_subgroup(H, target, \subgroup_map<G, H, f>(S))

thm subgroup_comap_closed:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H, T power_set(H):
        $is_group_hom(G, H, source, target, f)
        $is_subgroup(H, target, T)
        =>:
            $is_subgroup(G, source, \subgroup_comap<G, H, f>(T))
    \subgroup_comap<G, H, f>(T) = {q G: f(q) $in T}
    f(source.one) = target.one
    target.one $in T
    f(source.one) $in T
    release thm set_builder_member(source.one, {q G: f(q) $in T})
    source.one $in {q G: f(q) $in T}
    source.one $in \subgroup_comap<G, H, f>(T)
    claim:
        ? forall x, y G:
            x $in \subgroup_comap<G, H, f>(T)
            y $in \subgroup_comap<G, H, f>(T)
            =>:
                source.mul(x, y) $in \subgroup_comap<G, H, f>(T)
        f(x) $in T
        f(y) $in T
        f(source.mul(x, y)) = target.mul(f(x), f(y))
        target.mul(f(x), f(y)) $in T
        f(source.mul(x, y)) $in T
        release thm set_builder_member(source.mul(x, y), {q G: f(q) $in T})
        source.mul(x, y) $in {q G: f(q) $in T}
    claim:
        ? forall x G:
            x $in \subgroup_comap<G, H, f>(T)
            =>:
                source.inv(x) $in \subgroup_comap<G, H, f>(T)
        f(x) $in T
        release thm group_hom_map_inv(G, H, source, target, f, x)
        f(source.inv(x)) = target.inv(f(x))
        target.inv(f(x)) $in T
        f(source.inv(x)) $in T
        release thm set_builder_member(source.inv(x), {q G: f(q) $in T})
        source.inv(x) $in {q G: f(q) $in T}
    by def:
        ? $is_subgroup(G, source, \subgroup_comap<G, H, f>(T))

thm group_kernel_closed:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H:
        $is_group_hom(G, H, source, target, f)
        =>:
            $is_subgroup(G, source, \group_kernel<G, H, target.one, f>)
    by def:
        ? $chap2::group_laws(H, target.mul, target.one, target.inv)
    \group_kernel<G, H, target.one, f> = {q G: f(q) = target.one}
    f(source.one) = target.one
    release thm set_builder_member(source.one, {q G: f(q) = target.one})
    source.one $in {q G: f(q) = target.one}
    source.one $in \group_kernel<G, H, target.one, f>
    claim:
        ? forall x, y G:
            x $in \group_kernel<G, H, target.one, f>
            y $in \group_kernel<G, H, target.one, f>
            =>:
                source.mul(x, y) $in \group_kernel<G, H, target.one, f>
        f(source.mul(x, y)) = target.mul(f(x), f(y)) = target.mul(target.one, target.one) = target.one
        release thm set_builder_member(source.mul(x, y), {q G: f(q) = target.one})
        source.mul(x, y) $in {q G: f(q) = target.one}
    claim:
        ? forall x G:
            x $in \group_kernel<G, H, target.one, f>
            =>:
                source.inv(x) $in \group_kernel<G, H, target.one, f>
        release thm group_hom_map_inv(G, H, source, target, f, x)
        f(source.inv(x)) = target.inv(f(x)) = target.inv(target.one)
        target.mul(target.inv(target.one), target.one) = target.one
        release thm chap2::mul_one_structure(H, target.mul, target.one, target.inv, target.inv(target.one))
        target.mul(target.inv(target.one), target.one) = target.inv(target.one)
        target.inv(target.one) = target.one
        f(source.inv(x)) = target.one
        release thm set_builder_member(source.inv(x), {q G: f(q) = target.one})
        source.inv(x) $in {q G: f(q) = target.one}
    by def:
        ? $is_subgroup(G, source, \group_kernel<G, H, target.one, f>)

thm group_range_closed:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H:
        $is_group_hom(G, H, source, target, f)
        =>:
            $is_subgroup(H, target, \group_range<G, H, f>)
    by def:
        ? $is_subgroup(G, source, G)
    release thm subgroup_map_closed(G, H, source, target, f, G)
    \group_range<G, H, f> = \subgroup_map<G, H, f>(G)

# Bézout form gives a local, carrier-independent coprimality condition for
# the finite subgroup orders in the next source lemma.
prop group_order_coprime(m, n N):
    exist u, v Z st {u * m + v * n = 1}

# Lagrange is proved by making the coset partition fully visible: the
# quotient carrier is a finite image of G, a selected representative gives
# G <-> (G/H) x H, and finite Cartesian-product cardinality supplies the
# divisibility witness.

prop left_coset_member(G nonempty_set, group &chap2::Group<G>, H power_set(G), g, x G):
    exist h G st {h $in H, x = group.mul(g, h)}

template<G nonempty_set, group &chap2::Group<G>>:
    have fn left_coset(H power_set(G), g G) power_set(G) = {x G: $left_coset_member(G, group, H, g, x)}

prop is_left_coset_of(G nonempty_set, group &chap2::Group<G>, H power_set(G), CarrierC power_set(G)):
    exist g G st {CarrierC = \left_coset<G, group>(H, g)}

template<G nonempty_set, group &chap2::Group<G>>:
    have fn quotient_group_carrier(H power_set(G)) power_set(power_set(G)) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}

thm object_substitution:
    ? forall A, B set, f fn(x A) B, x, y A:
        x = y
        =>:
            f(x) = f(y)

thm left_coset_center_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        =>:
            g $in \left_coset<G, group>(H, g)
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    \left_coset<G, group>(H, g) = {x G: $left_coset_member(G, group, H, g, x)}
    group.one $in H
    release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, g)
    witness $left_coset_member(G, group, H, g, g) from group.one
    release thm set_builder_member(g, {x G: $left_coset_member(G, group, H, g, x)})
    g $in {x G: $left_coset_member(G, group, H, g, x)}

thm left_coset_eq_of_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g, x G:
        $is_subgroup(G, group, H)
        x $in \left_coset<G, group>(H, g)
        =>:
            \left_coset<G, group>(H, x) = \left_coset<G, group>(H, g)
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    \left_coset<G, group>(H, g) = {q G: $left_coset_member(G, group, H, g, q)}
    \left_coset<G, group>(H, x) = {q G: $left_coset_member(G, group, H, x, q)}
    obtain u from exist h G st {h $in H, x = group.mul(g, h)}
    claim:
        ? forall z \left_coset<G, group>(H, x):
            z $in \left_coset<G, group>(H, g)
        obtain w from exist h G st {h $in H, z = group.mul(x, h)}
        group.mul(u, w) $in H
        z = group.mul(x, w) = group.mul(group.mul(g, u), w) = group.mul(g, group.mul(u, w))
        witness $left_coset_member(G, group, H, g, z) from group.mul(u, w)
        release thm set_builder_member(z, {q G: $left_coset_member(G, group, H, g, q)})
        z $in {q G: $left_coset_member(G, group, H, g, q)}
    by def:
        ? \left_coset<G, group>(H, x) $subset \left_coset<G, group>(H, g)
    \left_coset<G, group>(H, x) $subset \left_coset<G, group>(H, g)
    claim:
        ? forall z \left_coset<G, group>(H, g):
            z $in \left_coset<G, group>(H, x)
        obtain w from $left_coset_member(G, group, H, g, z)
        group.inv(u) $in H
        group.mul(group.inv(u), w) $in H
        release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, u)
        group.mul(u, group.mul(group.inv(u), w)) = group.mul(group.mul(u, group.inv(u)), w)
        release thm object_substitution(G, G, fn(t G) G {group.mul(g, t)}, group.mul(u, group.mul(group.inv(u), w)), group.mul(group.mul(u, group.inv(u)), w))
        group.mul(g, group.mul(u, group.mul(group.inv(u), w))) = group.mul(g, group.mul(group.mul(u, group.inv(u)), w))
        group.mul(u, group.inv(u)) = group.one
        release thm object_substitution(G, G, fn(t G) G {group.mul(t, w)}, group.mul(u, group.inv(u)), group.one)
        group.mul(group.mul(u, group.inv(u)), w) = group.mul(group.one, w)
        release thm object_substitution(G, G, fn(t G) G {group.mul(g, t)}, group.mul(group.mul(u, group.inv(u)), w), group.mul(group.one, w))
        group.mul(g, group.mul(group.mul(u, group.inv(u)), w)) = group.mul(g, group.mul(group.one, w))
        group.mul(group.one, w) = w
        release thm object_substitution(G, G, fn(t G) G {group.mul(g, t)}, group.mul(group.one, w), w)
        group.mul(g, group.mul(group.one, w)) = group.mul(g, w)
        group.mul(x, group.mul(group.inv(u), w)) = group.mul(group.mul(g, u), group.mul(group.inv(u), w)) = group.mul(g, group.mul(u, group.mul(group.inv(u), w))) = group.mul(g, group.mul(group.mul(u, group.inv(u)), w)) = group.mul(g, group.mul(group.one, w)) = group.mul(g, w) = z
        witness $left_coset_member(G, group, H, x, z) from group.mul(group.inv(u), w):
            z = group.mul(x, group.mul(group.inv(u), w))
        release thm set_builder_member(z, {q G: $left_coset_member(G, group, H, x, q)})
        z $in {q G: $left_coset_member(G, group, H, x, q)}
    by def:
        ? \left_coset<G, group>(H, g) $subset \left_coset<G, group>(H, x)
    \left_coset<G, group>(H, g) $subset \left_coset<G, group>(H, x)
    by extension:
        ? \left_coset<G, group>(H, x) = \left_coset<G, group>(H, g)

thm left_coset_space_eq_range:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        \quotient_group_carrier<G, group>(H) = fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})
    claim:
        ? forall CarrierC \quotient_group_carrier<G, group>(H):
            CarrierC $in fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})
        \quotient_group_carrier<G, group>(H) = {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)}
        CarrierC $in {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)}
        by def $is_left_coset_of(G, group, H, CarrierC)
        obtain g from $is_left_coset_of(G, group, H, CarrierC)
        (fn(x G) power_set(G) {\left_coset<G, group>(H, x)})(g) = \left_coset<G, group>(H, g) = CarrierC
        (fn(x G) power_set(G) {\left_coset<G, group>(H, x)})(g) $in fn_range(fn(x G) power_set(G) {\left_coset<G, group>(H, x)})
        CarrierC $in fn_range(fn(x G) power_set(G) {\left_coset<G, group>(H, x)})
    by def:
        ? \quotient_group_carrier<G, group>(H) $subset fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})
    claim:
        ? forall CarrierC fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)}):
            CarrierC $in \quotient_group_carrier<G, group>(H)
        have by preimage g from CarrierC $in fn_range(fn(x G) power_set(G) {\left_coset<G, group>(H, x)})
        CarrierC = (fn(x G) power_set(G) {\left_coset<G, group>(H, x)})(g) = \left_coset<G, group>(H, g)
        \quotient_group_carrier<G, group>(H) = {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)}
        witness $is_left_coset_of(G, group, H, CarrierC) from g:
            CarrierC = \left_coset<G, group>(H, g)
        release thm set_builder_member(CarrierC, {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)})
        CarrierC $in {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)}
    by def:
        ? fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)}) $subset \quotient_group_carrier<G, group>(H)
    by extension:
        ? \quotient_group_carrier<G, group>(H) = fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})

thm left_coset_space_subset_range:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        \quotient_group_carrier<G, group>(H) $subset fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})
    claim:
        ? forall CarrierC \quotient_group_carrier<G, group>(H):
            CarrierC $in fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})
        \quotient_group_carrier<G, group>(H) = {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)}
        CarrierC $in {candidate power_set(G): $is_left_coset_of(G, group, H, candidate)}
        by def $is_left_coset_of(G, group, H, CarrierC)
        obtain g from $is_left_coset_of(G, group, H, CarrierC)
        (fn(x G) power_set(G) {\left_coset<G, group>(H, x)})(g) = \left_coset<G, group>(H, g) = CarrierC
        (fn(x G) power_set(G) {\left_coset<G, group>(H, x)})(g) $in fn_range(fn(x G) power_set(G) {\left_coset<G, group>(H, x)})
        CarrierC $in fn_range(fn(x G) power_set(G) {\left_coset<G, group>(H, x)})
    by def:
        ? \quotient_group_carrier<G, group>(H) $subset fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)})

thm left_coset_space_finite:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_finite_set(G)
        =>:
            $is_finite_set(\quotient_group_carrier<G, group>(H))
    $is_finite_set(fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)}))
    release thm left_coset_space_subset_range(G, group, H)
    release thm subset_of_finite_set_is_finite(\quotient_group_carrier<G, group>(H), fn_range(fn(g G) power_set(G) {\left_coset<G, group>(H, g)}))

thm left_coset_in_coset_space:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        \left_coset<G, group>(H, g) $in \quotient_group_carrier<G, group>(H)
    \quotient_group_carrier<G, group>(H) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
    witness $is_left_coset_of(G, group, H, \left_coset<G, group>(H, g)) from g
    release thm set_builder_member(\left_coset<G, group>(H, g), {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)})

template<G nonempty_set, group &chap2::Group<G>, H power_set(G)>:
    have fn left_coset_projection(g G) \quotient_group_carrier<G, group>(H) = \left_coset<G, group>(H, g)

thm left_coset_projection_surjective:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $surjective(G, \quotient_group_carrier<G, group>(H), \left_coset_projection<G, group, H>)
    claim:
        ? forall q \quotient_group_carrier<G, group>(H):
            exist source_g G st {q = \left_coset_projection<G, group, H>(source_g)}
        \quotient_group_carrier<G, group>(H) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        q $in {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        by def $is_left_coset_of(G, group, H, q)
        obtain preimage_g from $is_left_coset_of(G, group, H, q)
        witness exist source_g G st {q = \left_coset_projection<G, group, H>(source_g)} from preimage_g:
            \left_coset_projection<G, group, H>(preimage_g) = \left_coset<G, group>(H, preimage_g) = q
    by def $surjective(G, \quotient_group_carrier<G, group>(H), \left_coset_projection<G, group, H>)

thm left_coset_projection_has_total_inverse:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $chap4::has_total_inverse(G, \quotient_group_carrier<G, group>(H), group.one, \left_coset_projection<G, group, H>)
    release thm chap4::total_inverse_available(G, \quotient_group_carrier<G, group>(H), group.one, \left_coset_projection<G, group, H>)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G)>:
    have fn left_coset_representative(q \quotient_group_carrier<G, group>(H)) G = \chap4::inverse<G, \quotient_group_carrier<G, group>(H), group.one, \left_coset_projection<G, group, H>>(q)

thm left_coset_representative_spec:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), q \quotient_group_carrier<G, group>(H):
        \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q)) = q
    release thm left_coset_projection_surjective(G, group, H)
    by def $surjective(G, \quotient_group_carrier<G, group>(H), \left_coset_projection<G, group, H>)
    obtain g from exist x G st {q = \left_coset_projection<G, group, H>(x)}
    witness $chap4::has_preimage(G, \quotient_group_carrier<G, group>(H), \left_coset_projection<G, group, H>, q) from g
    release thm chap4::inverse_spec(G, \quotient_group_carrier<G, group>(H), group.one, \left_coset_projection<G, group, H>, q)
    \left_coset_representative<G, group, H>(q) = \chap4::inverse<G, \quotient_group_carrier<G, group>(H), group.one, \left_coset_projection<G, group, H>>(q)
    \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q)) = \left_coset_projection<G, group, H>(\chap4::inverse<G, \quotient_group_carrier<G, group>(H), group.one, \left_coset_projection<G, group, H>>(q)) = q

thm left_coset_coordinate_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        =>:
            group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g) $in H
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    release thm left_coset_representative_spec(G, group, H, \left_coset_projection<G, group, H>(g))
    release thm left_coset_center_mem(G, group, H, g)
    g $in \left_coset<G, group>(H, g)
    \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))) = \left_coset_projection<G, group, H>(g)
    \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))) = \left_coset<G, group>(H, \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)))
    \left_coset_projection<G, group, H>(g) = \left_coset<G, group>(H, g)
    \left_coset<G, group>(H, \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))) = \left_coset<G, group>(H, g)
    g $in \left_coset<G, group>(H, \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)))
    obtain h from $left_coset_member(G, group, H, \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), g)
    group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))) = group.one
    group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g) = group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), h)) = group.mul(group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), h) = group.mul(group.one, h) = h
    group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g) $in H

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn left_coset_coordinate(g G) H = group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn left_coset_forward(g G) cart(\quotient_group_carrier<G, group>(H), H) = (\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g))

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn left_coset_backward(pair cart(\quotient_group_carrier<G, group>(H), H)) G = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])

thm left_coset_backward_forward:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        =>:
            \left_coset_backward<G, group, H>(\left_coset_forward<G, group, H>(g)) = g
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    \left_coset_forward<G, group, H>(g) = (\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g))
    \left_coset_forward<G, group, H>(g)[1] = \left_coset_projection<G, group, H>(g)
    \left_coset_forward<G, group, H>(g)[2] = \left_coset_coordinate<G, group, H>(g)
    \left_coset_backward<G, group, H>(\left_coset_forward<G, group, H>(g)) = group.mul(\left_coset_representative<G, group, H>(\left_coset_forward<G, group, H>(g)[1]), \left_coset_forward<G, group, H>(g)[2]) = group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), \left_coset_coordinate<G, group, H>(g))
    \left_coset_coordinate<G, group, H>(g) = group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g)
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)))
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, g)}, group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)))), group.one)
    \left_coset_backward<G, group, H>(\left_coset_forward<G, group, H>(g)) = group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g)) = group.mul(group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)))), g) = group.mul(group.one, g) = g

thm left_coset_forward_backward:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), pair cart(\quotient_group_carrier<G, group>(H), H):
        $is_subgroup(G, group, H)
        =>:
            \left_coset_forward<G, group, H>(\left_coset_backward<G, group, H>(pair)) = pair
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    have q \quotient_group_carrier<G, group>(H) = pair[1]
    have h H = pair[2]
    have g G = \left_coset_backward<G, group, H>(pair)
    g = \left_coset_backward<G, group, H>(pair) = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2]) = group.mul(\left_coset_representative<G, group, H>(q), h)
    release thm left_coset_center_mem(G, group, H, \left_coset_representative<G, group, H>(q))
    \left_coset_representative<G, group, H>(q) $in \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q))
    witness $left_coset_member(G, group, H, \left_coset_representative<G, group, H>(q), g) from h:
        g = group.mul(\left_coset_representative<G, group, H>(q), h)
    release thm set_builder_member(g, {x G: $left_coset_member(G, group, H, \left_coset_representative<G, group, H>(q), x)})
    \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q)) = {x G: $left_coset_member(G, group, H, \left_coset_representative<G, group, H>(q), x)}
    g $in \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q))
    release thm left_coset_eq_of_mem(G, group, H, \left_coset_representative<G, group, H>(q), g)
    \left_coset<G, group>(H, g) = \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q))
    \left_coset_projection<G, group, H>(g) = \left_coset<G, group>(H, g)
    release thm left_coset_representative_spec(G, group, H, q)
    \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q)) = \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q)) = q
    \left_coset_projection<G, group, H>(g) = q
    group.mul(group.inv(\left_coset_representative<G, group, H>(q)), \left_coset_representative<G, group, H>(q)) = group.one
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, h)}, group.mul(group.inv(\left_coset_representative<G, group, H>(q)), \left_coset_representative<G, group, H>(q)), group.one)
    \left_coset_coordinate<G, group, H>(g) = group.mul(group.inv(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))), g) = group.mul(group.inv(\left_coset_representative<G, group, H>(q)), group.mul(\left_coset_representative<G, group, H>(q), h)) = group.mul(group.mul(group.inv(\left_coset_representative<G, group, H>(q)), \left_coset_representative<G, group, H>(q)), h) = group.mul(group.one, h) = h
    \left_coset_forward<G, group, H>(g) = (\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g)) = (q, h)
    release thm tuple_equal_from_coordinates(pair, (pair[1], pair[2]))
    pair = (pair[1], pair[2]) = (q, h)
    g = \left_coset_backward<G, group, H>(pair)
    \left_coset_forward<G, group, H>(\left_coset_backward<G, group, H>(pair)) = \left_coset_forward<G, group, H>(g) = (q, h) = pair

thm left_coset_forward_bijective:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            $bijective(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>)
    claim:
        ? $chap4::is_left_inverse(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>, \left_coset_backward<G, group, H>)
        claim:
            ? forall g G:
                \left_coset_backward<G, group, H>(\left_coset_forward<G, group, H>(g)) = g
            release thm left_coset_backward_forward(G, group, H, g)
        by def $chap4::is_left_inverse(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>, \left_coset_backward<G, group, H>)
    release thm chap4::injective_of_left_inverse(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>, \left_coset_backward<G, group, H>)
    claim:
        ? $chap4::is_right_inverse(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>, \left_coset_backward<G, group, H>)
        claim:
            ? forall pair cart(\quotient_group_carrier<G, group>(H), H):
                \left_coset_forward<G, group, H>(\left_coset_backward<G, group, H>(pair)) = pair
            release thm left_coset_forward_backward(G, group, H, pair)
        by def $chap4::is_right_inverse(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>, \left_coset_backward<G, group, H>)
    release thm chap4::surjective_of_right_inverse(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>, \left_coset_backward<G, group, H>)
    by def $bijective(G, cart(\quotient_group_carrier<G, group>(H), H), \left_coset_forward<G, group, H>)

thm subgroup_order_divides_group_order:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $chap2::divides(finite_set_size(H), finite_set_size(G))
    release thm left_coset_space_finite(G, group, H)
    release thm left_coset_forward_bijective(G, group, H)
    $is_finite_set(cart(\quotient_group_carrier<G, group>(H), H))
    finite_set_size(G) = finite_set_size(cart(\quotient_group_carrier<G, group>(H), H))
    finite_set_size(cart(\quotient_group_carrier<G, group>(H), H)) = finite_set_size(\quotient_group_carrier<G, group>(H)) * finite_set_size(H)
    finite_set_size(G) = finite_set_size(\quotient_group_carrier<G, group>(H)) * finite_set_size(H) = finite_set_size(H) * finite_set_size(\quotient_group_carrier<G, group>(H))
    witness $chap2::divides(finite_set_size(H), finite_set_size(G)) from finite_set_size(\quotient_group_carrier<G, group>(H)):
        finite_set_size(G) = finite_set_size(H) * finite_set_size(\quotient_group_carrier<G, group>(H))

thm subgroup_eq_bottom_iff_order_one_forward:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        finite_set_size(H) = 1
        =>:
            H = {group.one}
    claim:
        ? forall x H:
            x = group.one
        by cases:
            ? x = group.one
            case x = group.one:
                x = group.one
            case x != group.one:
                group.one $in H
                claim:
                    ? group.one != x
                    by contra:
                        ? group.one != x
                        group.one = x
                        x = group.one
                        impossible x != group.one
                claim:
                    ? forall y {group.one, x}:
                        y $in H
                    by cases:
                        ? y $in H
                        case y = group.one:
                            y = group.one
                            group.one $in H
                            y $in H
                        case y = x:
                            y = x
                            x $in H
                            y $in H
                {group.one, x} $subset H
                finite_set_size({group.one, x}) = 2
                finite_set_size({group.one, x}) <= finite_set_size(H)
                2 <= 1
                impossible 2 <= 1
    by extension:
        ? H = {group.one}
        claim:
            ? forall x H:
                x $in {group.one}
            x = group.one
            x $in {group.one}
        claim:
            ? forall x {group.one}:
                x $in H
            x = group.one
            group.one $in H
            x $in H

# A subgroup visibly inherits the ambient group operations. This lets the
# Lagrange interface count nested finite subgroups without an external group
# library, and the coprime-intersection result reduces to Bezout arithmetic.

thm subgroup_carrier_is_nonempty:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            $is_nonempty_set(H)
    group.one $in H
    witness $is_nonempty_set(H) from group.one

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have subgroup_carrier nonempty_set = H

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn subgroup_mul(x, y \subgroup_carrier<G, group, H>) \subgroup_carrier<G, group, H> = group.mul(x, y)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have subgroup_one \subgroup_carrier<G, group, H> = group.one

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn subgroup_inv(x \subgroup_carrier<G, group, H>) \subgroup_carrier<G, group, H> = group.inv(x)

thm subgroup_group_laws:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            $chap2::group_laws(\subgroup_carrier<G, group, H>, \subgroup_mul<G, group, H>, \subgroup_one<G, group, H>, \subgroup_inv<G, group, H>)
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    claim:
        ? forall x, y, z \subgroup_carrier<G, group, H>:
            \subgroup_mul<G, group, H>(\subgroup_mul<G, group, H>(x, y), z) = \subgroup_mul<G, group, H>(x, \subgroup_mul<G, group, H>(y, z))
        \subgroup_mul<G, group, H>(\subgroup_mul<G, group, H>(x, y), z) = group.mul(group.mul(x, y), z) = group.mul(x, group.mul(y, z)) = \subgroup_mul<G, group, H>(x, \subgroup_mul<G, group, H>(y, z))
    claim:
        ? forall x \subgroup_carrier<G, group, H>:
            \subgroup_mul<G, group, H>(\subgroup_one<G, group, H>, x) = x
        \subgroup_mul<G, group, H>(\subgroup_one<G, group, H>, x) = group.mul(group.one, x) = x
    claim:
        ? forall x \subgroup_carrier<G, group, H>:
            \subgroup_mul<G, group, H>(x, \subgroup_one<G, group, H>) = x
        \subgroup_mul<G, group, H>(x, \subgroup_one<G, group, H>) = group.mul(x, group.one) = x
    claim:
        ? forall x \subgroup_carrier<G, group, H>:
            \subgroup_mul<G, group, H>(x, \subgroup_inv<G, group, H>(x)) = \subgroup_one<G, group, H>
        \subgroup_mul<G, group, H>(x, \subgroup_inv<G, group, H>(x)) = group.mul(x, group.inv(x)) = group.one = \subgroup_one<G, group, H>
    claim:
        ? forall x \subgroup_carrier<G, group, H>:
            \subgroup_mul<G, group, H>(\subgroup_inv<G, group, H>(x), x) = \subgroup_one<G, group, H>
        \subgroup_mul<G, group, H>(\subgroup_inv<G, group, H>(x), x) = group.mul(group.inv(x), x) = group.one = \subgroup_one<G, group, H>
    by def $chap2::group_laws(\subgroup_carrier<G, group, H>, \subgroup_mul<G, group, H>, \subgroup_one<G, group, H>, \subgroup_inv<G, group, H>)

thm subgroup_group_member:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            (\subgroup_mul<G, group, H>, \subgroup_one<G, group, H>, \subgroup_inv<G, group, H>) $in &chap2::Group<\subgroup_carrier<G, group, H>>
    release thm subgroup_group_laws(G, group, H)
    release thm cart_member_from_coordinates((\subgroup_mul<G, group, H>, \subgroup_one<G, group, H>, \subgroup_inv<G, group, H>), cart(fn(x, y \subgroup_carrier<G, group, H>) \subgroup_carrier<G, group, H>, \subgroup_carrier<G, group, H>, fn(x \subgroup_carrier<G, group, H>) \subgroup_carrier<G, group, H>))
    release thm struct_member((\subgroup_mul<G, group, H>, \subgroup_one<G, group, H>, \subgroup_inv<G, group, H>), &chap2::Group<\subgroup_carrier<G, group, H>>)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have subgroup_group &chap2::Group<\subgroup_carrier<G, group, H>> = (\subgroup_mul<G, group, H>, \subgroup_one<G, group, H>, \subgroup_inv<G, group, H>)

thm nested_subgroup_closed:
    ? forall G nonempty_set, group &chap2::Group<G>, A, B power_set(G):
        $is_subgroup(G, group, A)
        $is_subgroup(G, group, B)
        A $subset B
        =>:
            $is_subgroup(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, A)
    A $in power_set(B)
    \subgroup_carrier<G, group, B> = B
    A $in power_set(\subgroup_carrier<G, group, B>)
    \subgroup_group<G, group, B> = (\subgroup_mul<G, group, B>, \subgroup_one<G, group, B>, \subgroup_inv<G, group, B>)
    \subgroup_group<G, group, B>.mul = \subgroup_mul<G, group, B>
    \subgroup_group<G, group, B>.one = \subgroup_one<G, group, B>
    \subgroup_group<G, group, B>.inv = \subgroup_inv<G, group, B>
    \subgroup_one<G, group, B> = group.one
    group.one $in A
    \subgroup_group<G, group, B>.one $in A
    claim:
        ? forall x, y \subgroup_carrier<G, group, B>:
            x $in A
            y $in A
            =>:
                \subgroup_group<G, group, B>.mul(x, y) $in A
        \subgroup_group<G, group, B>.mul(x, y) = \subgroup_mul<G, group, B>(x, y) = group.mul(x, y)
        group.mul(x, y) $in A
    claim:
        ? forall x \subgroup_carrier<G, group, B>:
            x $in A
            =>:
                \subgroup_group<G, group, B>.inv(x) $in A
        \subgroup_group<G, group, B>.inv(x) = \subgroup_inv<G, group, B>(x) = group.inv(x)
        group.inv(x) $in A
    by def $is_subgroup(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, A)

thm subgroup_order_divides_subgroup_order:
    ? forall G nonempty_set, group &chap2::Group<G>, A, B power_set(G):
        $is_subgroup(G, group, A)
        $is_subgroup(G, group, B)
        A $subset B
        $is_finite_set(A)
        $is_finite_set(B)
        =>:
            $chap2::divides(finite_set_size(A), finite_set_size(B))
    release thm nested_subgroup_closed(G, group, A, B)
    release thm subgroup_order_divides_group_order(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, A)
    \subgroup_carrier<G, group, B> = B
    finite_set_size(\subgroup_carrier<G, group, B>) = finite_set_size(B)

thm coprime_subgroups_intersection_bottom:
    ? forall G nonempty_set, group &chap2::Group<G>, H, K power_set(G):
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, K)
        $is_finite_set(H)
        $is_finite_set(K)
        $group_order_coprime(finite_set_size(H), finite_set_size(K))
        =>:
            \subgroup_intersection<G>(H, K) = {group.one}
    claim:
        ? forall x {candidate G: candidate $in H and candidate $in K}:
            x $in H
    by def:
        ? {candidate G: candidate $in H and candidate $in K} $subset H
    release thm subset_of_finite_set_is_finite({candidate G: candidate $in H and candidate $in K}, H)
    have intersection power_set(G) = {candidate G: candidate $in H and candidate $in K}
    claim:
        ? $is_subgroup(G, group, intersection)
        group.one $in H
        group.one $in K
        release thm set_builder_member(group.one, {candidate G: candidate $in H and candidate $in K})
        group.one $in {candidate G: candidate $in H and candidate $in K}
        group.one $in intersection
        claim:
            ? forall x, y G:
                x $in intersection
                y $in intersection
                =>:
                    group.mul(x, y) $in intersection
            x $in {candidate G: candidate $in H and candidate $in K}
            y $in {candidate G: candidate $in H and candidate $in K}
            x $in H
            x $in K
            y $in H
            y $in K
            group.mul(x, y) $in H
            group.mul(x, y) $in K
            release thm set_builder_member(group.mul(x, y), {candidate G: candidate $in H and candidate $in K})
            group.mul(x, y) $in {candidate G: candidate $in H and candidate $in K}
            group.mul(x, y) $in intersection
        claim:
            ? forall x G:
                x $in intersection
                =>:
                    group.inv(x) $in intersection
            x $in {candidate G: candidate $in H and candidate $in K}
            x $in H
            x $in K
            group.inv(x) $in H
            group.inv(x) $in K
            release thm set_builder_member(group.inv(x), {candidate G: candidate $in H and candidate $in K})
            group.inv(x) $in {candidate G: candidate $in H and candidate $in K}
            group.inv(x) $in intersection
        by def $is_subgroup(G, group, intersection)
    claim:
        ? forall x intersection:
            x $in H
        x $in {candidate G: candidate $in H and candidate $in K}
        x $in H
    by def:
        ? intersection $subset H
    release thm subset_of_finite_set_is_finite(intersection, H)
    $is_finite_set(intersection)
    claim:
        ? forall x intersection:
            x $in K
        x $in {candidate G: candidate $in H and candidate $in K}
        x $in K
    by def:
        ? intersection $subset K
    have d N = finite_set_size(intersection)
    release thm subgroup_order_divides_subgroup_order(G, group, intersection, H)
    release thm subgroup_order_divides_subgroup_order(G, group, intersection, K)
    obtain a from $chap2::divides(d, finite_set_size(H))
    obtain b from $chap2::divides(d, finite_set_size(K))
    by def $group_order_coprime(finite_set_size(H), finite_set_size(K))
    obtain u, v from exist u, v Z st {u * finite_set_size(H) + v * finite_set_size(K) = 1}
    witness $chap2::divides(d, 1) from u * a + v * b:
        1 = u * finite_set_size(H) + v * finite_set_size(K) = u * (d * a) + v * (d * b) = d * (u * a + v * b)
    group.one $in intersection
    $is_nonempty_set(intersection)
    finite_set_size(intersection) >= 1
    d >= 1
    have positive_d N+ = d
    release thm chap2::_positive_divisor_le_abs(positive_d, 1)
    positive_d <= abs(1) = 1
    positive_d >= 1
    positive_d = 1
    d = 1
    finite_set_size(intersection) = 1
    release thm subgroup_eq_bottom_iff_order_one_forward(G, group, intersection)
    intersection = {group.one}
    \subgroup_intersection<G>(H, K) = {candidate G: candidate $in H and candidate $in K} = intersection = {group.one}

# Source definition `conjugate` and its action law.  The set-level action is
# defined directly; its preservation of subgroup structure remains implicit in
# the source's `Subgroup G` carrier.
prop conjugate_subgroup_member(G nonempty_set, group &chap2::Group<G>, H power_set(G), g, x G):
    exist h G st {h $in H, x = group.mul(group.mul(g, h), group.inv(g))}

template<G nonempty_set, group &chap2::Group<G>>:
    have fn conjugate_subgroup(g G, H power_set(G)) power_set(G) = {x G: $conjugate_subgroup_member(G, group, H, g, x)}

# ---------------------------------------------------------------------------
# 9.1.4 Permutations, free groups, and presented groups
# ---------------------------------------------------------------------------

prop is_permutation(X set, sigma fn(x X) X):
    forall x1, x2 X:
        sigma(x1) = sigma(x2)
        =>:
            x1 = x2
    forall y X:
        exist x X st {y = sigma(x)}

template<X set>:
    have permutation_carrier power_set(fn(x X) X) = {sigma fn(x X) X: $is_permutation(X, sigma)}

template<X set>:
    have fn permutation_compose(sigma, tau fn(x X) X) fn(y X) X = fn(z X) X {sigma(tau(z))}

template<X set>:
    have permutation_identity fn(x X) X = fn(x X) X {x}

# A signed generator is represented by a pair (generator, sign), where sign
# 0 means the generator and sign 1 means its inverse.  A word cell is either
# empty (the identity letter) or a singleton signed generator.
prop has_word_symbol(S set, cell power_set(cart(S, {0, 1}))):
    exist letter cart(S, {0, 1}) st {cell = {letter}}

prop is_word_cell(S set, cell power_set(cart(S, {0, 1}))):
    not cell != {} or $has_word_symbol(S, cell)

template<S set>:
    have fn word_symbol by exist!:
        ? forall cell power_set(cart(S, {0, 1})):
            $is_word_cell(S, cell)
            cell != {}
            =>:
                exist! letter cart(S, {0, 1}) st {cell = {letter}}
        by def:
            ? $is_word_cell(S, cell)
        claim:
            ? $has_word_symbol(S, cell)
            by cases:
                ? $has_word_symbol(S, cell)
                case cell = {}:
                    impossible cell != {}
                case $has_word_symbol(S, cell):
                    $has_word_symbol(S, cell)
        by def:
            ? $has_word_symbol(S, cell)
        obtain letter from exist letter cart(S, {0, 1}) st {cell = {letter}}
        claim:
            ? forall left, right cart(S, {0, 1}):
                cell = {left}
                cell = {right}
                =>:
                    left = right
            {left} = cell = {right}
            left $in {left}
            left $in {right}
            left = right
        witness exist! selected cart(S, {0, 1}) st {cell = {selected}} from letter

template<S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target>:
    have fn active_cell_value(cell power_set(cart(S, {0, 1})): $is_word_cell(S, cell), cell != {}) Target by cases:
        case \word_symbol<S>(cell)[2] = 0: f(\word_symbol<S>(cell)[1])
        case \word_symbol<S>(cell)[2] = 1: target.inv(f(\word_symbol<S>(cell)[1]))

template<S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target>:
    have fn word_cell_value(cell power_set(cart(S, {0, 1})): $is_word_cell(S, cell)) Target by cases:
        case cell = {}: target.one
        case cell != {}: \active_cell_value<S, Target, target, f>(cell)

# A raw word stores a finite bound together with an infinite cell stream whose
# cells after the bound are empty.  Storing the bound avoids any hidden choice
# of a least support bound; the semantic quotient below identifies redundant
# trailing empty cells.
prop is_raw_word(S set, word cart(N, fn(idx N+) power_set(cart(S, {0, 1})))):
    forall idx N+:
        $is_word_cell(S, word[2](idx))
    forall idx N+:
        idx > word[1]
        =>:
            word[2](idx) = {}

template<S set>:
    have raw_word_carrier power_set(cart(N, fn(idx N+) power_set(cart(S, {0, 1})))) = {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)}

template<S set>:
    have empty_cell_stream fn(idx N+) power_set(cart(S, {0, 1})) = fn(idx N+) power_set(cart(S, {0, 1})) {{}}

template<S set>:
    have empty_raw_word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))) = (0, \empty_cell_stream<S>)

thm empty_raw_word_member:
    ? forall S set:
        \empty_raw_word<S> $in \raw_word_carrier<S>
    claim:
        ? forall idx N+:
            $is_word_cell(S, \empty_raw_word<S>[2](idx))
        \empty_raw_word<S>[2](idx) = \empty_cell_stream<S>(idx) = {}
        by def $is_word_cell(S, \empty_raw_word<S>[2](idx))
    claim:
        ? forall idx N+:
            idx > \empty_raw_word<S>[1]
            =>:
                \empty_raw_word<S>[2](idx) = {}
        \empty_raw_word<S>[2](idx) = \empty_cell_stream<S>(idx) = {}
    by def:
        ? $is_raw_word(S, \empty_raw_word<S>)
    release thm set_builder_member(\empty_raw_word<S>, {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)})
    \empty_raw_word<S> $in {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)}
    \raw_word_carrier<S> = {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)}

template<S set>:
    have fn generator_cell_stream(x S, idx N+) power_set(cart(S, {0, 1})) by cases:
        case idx = 1: {(x, 0)}
        case idx != 1: {}

template<S set>:
    have fn generator_raw_word(x S) cart(N, fn(idx N+) power_set(cart(S, {0, 1}))) = (1, fn(idx N+) power_set(cart(S, {0, 1})) {\generator_cell_stream<S>(x, idx)})

thm generator_raw_word_member:
    ? forall S set, x S:
        \generator_raw_word<S>(x) $in \raw_word_carrier<S>
    claim:
        ? forall idx N+:
            $is_word_cell(S, \generator_raw_word<S>(x)[2](idx))
        by cases:
            ? $is_word_cell(S, \generator_raw_word<S>(x)[2](idx))
            case idx = 1:
                \generator_raw_word<S>(x)[2](idx) = \generator_cell_stream<S>(x, idx) = {(x, 0)}
                witness $has_word_symbol(S, \generator_raw_word<S>(x)[2](idx)) from (x, 0)
                by def $is_word_cell(S, \generator_raw_word<S>(x)[2](idx))
            case idx != 1:
                \generator_raw_word<S>(x)[2](idx) = \generator_cell_stream<S>(x, idx) = {}
                by def $is_word_cell(S, \generator_raw_word<S>(x)[2](idx))
    claim:
        ? forall idx N+:
            idx > \generator_raw_word<S>(x)[1]
            =>:
                \generator_raw_word<S>(x)[2](idx) = {}
        \generator_raw_word<S>(x)[1] = 1
        idx > 1
        idx != 1
        \generator_raw_word<S>(x)[2](idx) = \generator_cell_stream<S>(x, idx) = {}
    by def:
        ? $is_raw_word(S, \generator_raw_word<S>(x))
    release thm set_builder_member(\generator_raw_word<S>(x), {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)})
    \generator_raw_word<S>(x) $in {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)}
    \raw_word_carrier<S> = {word cart(N, fn(idx N+) power_set(cart(S, {0, 1}))): $is_raw_word(S, word)}

# The verifier does not silently coerce an ambient raw word into the proved
# raw-word subtype, so make that evidence-carrying selection explicit.
prop is_generator_word_value(S set, x S, value \raw_word_carrier<S>):
    value = \generator_raw_word<S>(x)

template<S set>:
    have fn generator_word by exist!:
        ? forall x S:
            exist! value \raw_word_carrier<S> st {$is_generator_word_value(S, x, value)}
        release thm generator_raw_word_member(S, x)
        have selected_value \raw_word_carrier<S> = \generator_raw_word<S>(x)
        witness exist! value \raw_word_carrier<S> st {$is_generator_word_value(S, x, value)} from selected_value:
            by def:
                ? $is_generator_word_value(S, x, selected_value)
            claim:
                ? forall value1, value2 \raw_word_carrier<S>:
                    $is_generator_word_value(S, x, value1)
                    $is_generator_word_value(S, x, value2)
                    =>:
                        value1 = value2
                by def:
                    ? $is_generator_word_value(S, x, value1)
                by def:
                    ? $is_generator_word_value(S, x, value2)
                value1 = \generator_raw_word<S>(x) = value2

template<S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, word \raw_word_carrier<S>>:
    have fn raw_word_eval_prefix(n N) Target by induc n from 0:
        case n = 0: target.one
        case n > 0: target.mul(raw_word_eval_prefix(n - 1), \word_cell_value<S, Target, target, f>(word[2](n)))

template<S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target>:
    have fn raw_word_eval(word \raw_word_carrier<S>) Target = \raw_word_eval_prefix<S, Target, target, f, word>(word[1])

thm generator_raw_word_eval:
    ? forall S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, x S:
        \raw_word_eval<S, Target, target, f>(\generator_raw_word<S>(x)) = f(x)
    release thm generator_raw_word_member(S, x)
    by def:
        ? $is_raw_word(S, \generator_raw_word<S>(x))
    \generator_raw_word<S>(x)[1] = 1
    \raw_word_eval<S, Target, target, f>(\generator_raw_word<S>(x)) = \raw_word_eval_prefix<S, Target, target, f, \generator_raw_word<S>(x)>(1)
    \raw_word_eval_prefix<S, Target, target, f, \generator_raw_word<S>(x)>(1) = target.mul(\raw_word_eval_prefix<S, Target, target, f, \generator_raw_word<S>(x)>(0), \word_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1)))
    \raw_word_eval_prefix<S, Target, target, f, \generator_raw_word<S>(x)>(0) = target.one
    \generator_raw_word<S>(x)[2](1) = \generator_cell_stream<S>(x, 1) = {(x, 0)}
    (x, 0) $in {(x, 0)}
    (x, 0) $in \generator_raw_word<S>(x)[2](1)
    witness $is_nonempty_set(\generator_raw_word<S>(x)[2](1)) from (x, 0)
    \generator_raw_word<S>(x)[2](1) != {}
    \generator_raw_word<S>(x)[2](1) = {\word_symbol<S>(\generator_raw_word<S>(x)[2](1))}
    {\word_symbol<S>(\generator_raw_word<S>(x)[2](1))} = \generator_raw_word<S>(x)[2](1) = {(x, 0)}
    \word_symbol<S>(\generator_raw_word<S>(x)[2](1)) $in {\word_symbol<S>(\generator_raw_word<S>(x)[2](1))}
    \word_symbol<S>(\generator_raw_word<S>(x)[2](1)) $in {(x, 0)}
    \word_symbol<S>(\generator_raw_word<S>(x)[2](1)) = (x, 0)
    \word_symbol<S>(\generator_raw_word<S>(x)[2](1))[2] = 0
    \word_symbol<S>(\generator_raw_word<S>(x)[2](1))[1] = x
    \active_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1)) = f(\word_symbol<S>(\generator_raw_word<S>(x)[2](1))[1])
    f(\word_symbol<S>(\generator_raw_word<S>(x)[2](1))[1]) = f(x)
    \active_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1)) = f(x)
    \word_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1)) = \active_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1))
    \word_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1)) = f(x)
    target.mul(target.one, f(x)) = f(x)
    \raw_word_eval<S, Target, target, f>(\generator_raw_word<S>(x)) = \raw_word_eval_prefix<S, Target, target, f, \generator_raw_word<S>(x)>(1) = target.mul(\raw_word_eval_prefix<S, Target, target, f, \generator_raw_word<S>(x)>(0), \word_cell_value<S, Target, target, f>(\generator_raw_word<S>(x)[2](1))) = target.mul(target.one, f(x)) = f(x)

thm generator_word_eval:
    ? forall S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, x S:
        \raw_word_eval<S, Target, target, f>(\generator_word<S>(x)) = f(x)
    $is_generator_word_value(S, x, \generator_word<S>(x))
    by def:
        ? $is_generator_word_value(S, x, \generator_word<S>(x))
    release thm generator_raw_word_member(S, x)
    release thm generator_raw_word_eval(S, Target, target, f, x)
    \generator_word<S>(x) = \generator_raw_word<S>(x)
    \raw_word_eval<S, Target, target, f>(\generator_word<S>(x)) = \raw_word_eval<S, Target, target, f>(\generator_raw_word<S>(x)) = f(x)

# Two raw words represent the same free-group element exactly when every group
# interpretation of the generators gives them the same value.  This is the
# ordinary term-algebra quotient by the group laws, stated extensionally.
prop raw_words_equivalent(S set, left, right \raw_word_carrier<S>):
    forall Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target:
        \raw_word_eval<S, Target, target, f>(left) = \raw_word_eval<S, Target, target, f>(right)

template<S set>:
    have fn free_word_class(word \raw_word_carrier<S>) power_set(\raw_word_carrier<S>) = {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, word, candidate)}

thm raw_word_in_own_class:
    ? forall S set, word \raw_word_carrier<S>:
        word $in \free_word_class<S>(word)
    by def:
        ? $raw_words_equivalent(S, word, word)
    release thm set_builder_member(word, {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, word, candidate)})
    word $in {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, word, candidate)}
    \free_word_class<S>(word) = {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, word, candidate)}

prop is_free_group_element(S set, candidate power_set(\raw_word_carrier<S>)):
    exist word \raw_word_carrier<S> st {candidate = \free_word_class<S>(word)}

template<S set>:
    have free_group_carrier power_set(power_set(\raw_word_carrier<S>)) = {candidate power_set(\raw_word_carrier<S>): $is_free_group_element(S, candidate)}

thm free_word_class_in_carrier:
    ? forall S set, word \raw_word_carrier<S>:
        \free_word_class<S>(word) $in \free_group_carrier<S>
    witness $is_free_group_element(S, \free_word_class<S>(word)) from word
    release thm set_builder_member(\free_word_class<S>(word), {candidate power_set(\raw_word_carrier<S>): $is_free_group_element(S, candidate)})
    \free_word_class<S>(word) $in {candidate power_set(\raw_word_carrier<S>): $is_free_group_element(S, candidate)}
    \free_group_carrier<S> = {candidate power_set(\raw_word_carrier<S>): $is_free_group_element(S, candidate)}

thm free_group_carrier_nonempty:
    ? forall S set:
        $is_nonempty_set(\free_group_carrier<S>)
    release thm empty_raw_word_member(S)
    release thm free_word_class_in_carrier(S, \empty_raw_word<S>)
    witness $is_nonempty_set(\free_group_carrier<S>) from \free_word_class<S>(\empty_raw_word<S>)

template<S set>:
    have free_group nonempty_set = \free_group_carrier<S>

prop is_free_group_of_value(S set, x S, value \free_group<S>):
    value = \free_word_class<S>(\generator_word<S>(x))

template<S set>:
    have fn free_group_of by exist!:
        ? forall x S:
            exist! value \free_group<S> st {$is_free_group_of_value(S, x, value)}
        release thm free_word_class_in_carrier(S, \generator_word<S>(x))
        \free_group<S> = \free_group_carrier<S>
        \free_word_class<S>(\generator_word<S>(x)) $in \free_group<S>
        have selected_value \free_group<S> = \free_word_class<S>(\generator_word<S>(x))
        witness exist! value \free_group<S> st {$is_free_group_of_value(S, x, value)} from selected_value:
            by def:
                ? $is_free_group_of_value(S, x, selected_value)
            claim:
                ? forall value1, value2 \free_group<S>:
                    $is_free_group_of_value(S, x, value1)
                    $is_free_group_of_value(S, x, value2)
                    =>:
                        value1 = value2
                by def:
                    ? $is_free_group_of_value(S, x, value1)
                by def:
                    ? $is_free_group_of_value(S, x, value2)
                value1 = \free_word_class<S>(\generator_word<S>(x)) = value2

prop is_free_group_lift_value(S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, free_word \free_group<S>, value Target):
    exist representative \raw_word_carrier<S> st {free_word = \free_word_class<S>(representative), value = \raw_word_eval<S, Target, target, f>(representative)}

template<S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target>:
    have fn free_group_lift by exist!:
        ? forall free_word \free_group<S>:
            exist! value Target st {$is_free_group_lift_value(S, Target, target, f, free_word, value)}
        \free_group<S> = \free_group_carrier<S>
        free_word $in \free_group_carrier<S>
        \free_group_carrier<S> = {candidate power_set(\raw_word_carrier<S>): $is_free_group_element(S, candidate)}
        free_word $in {candidate power_set(\raw_word_carrier<S>): $is_free_group_element(S, candidate)}
        by def:
            ? $is_free_group_element(S, free_word)
        obtain representative from exist representative \raw_word_carrier<S> st {free_word = \free_word_class<S>(representative)}
        have selected_value Target = \raw_word_eval<S, Target, target, f>(representative)
        witness exist value Target st {$is_free_group_lift_value(S, Target, target, f, free_word, value)} from selected_value:
            witness $is_free_group_lift_value(S, Target, target, f, free_word, selected_value) from representative
        witness $is_free_group_lift_value(S, Target, target, f, free_word, selected_value) from representative
        claim:
            ? forall value1, value2 Target:
                $is_free_group_lift_value(S, Target, target, f, free_word, value1)
                $is_free_group_lift_value(S, Target, target, f, free_word, value2)
                =>:
                    value1 = value2
            by def:
                ? $is_free_group_lift_value(S, Target, target, f, free_word, value1)
            obtain representative1 from exist representative1 \raw_word_carrier<S> st {free_word = \free_word_class<S>(representative1), value1 = \raw_word_eval<S, Target, target, f>(representative1)}
            by def:
                ? $is_free_group_lift_value(S, Target, target, f, free_word, value2)
            obtain representative2 from exist representative2 \raw_word_carrier<S> st {free_word = \free_word_class<S>(representative2), value2 = \raw_word_eval<S, Target, target, f>(representative2)}
            release thm raw_word_in_own_class(S, representative2)
            \free_word_class<S>(representative1) = free_word = \free_word_class<S>(representative2)
            representative2 $in \free_word_class<S>(representative1)
            \free_word_class<S>(representative1) = {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, representative1, candidate)}
            representative2 $in {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, representative1, candidate)}
            by def:
                ? $raw_words_equivalent(S, representative1, representative2)
            \raw_word_eval<S, Target, target, f>(representative1) = \raw_word_eval<S, Target, target, f>(representative2)
            value1 = \raw_word_eval<S, Target, target, f>(representative1) = \raw_word_eval<S, Target, target, f>(representative2) = value2
        witness exist! value Target st {$is_free_group_lift_value(S, Target, target, f, free_word, value)} from selected_value

thm free_group_lift_generator:
    ? forall S set, Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, x S:
        \free_group_lift<S, Target, target, f>(\free_group_of<S>(x)) = f(x)
    $is_free_group_lift_value(S, Target, target, f, \free_group_of<S>(x), \free_group_lift<S, Target, target, f>(\free_group_of<S>(x)))
    by def:
        ? $is_free_group_lift_value(S, Target, target, f, \free_group_of<S>(x), \free_group_lift<S, Target, target, f>(\free_group_of<S>(x)))
    obtain representative from exist representative \raw_word_carrier<S> st {\free_group_of<S>(x) = \free_word_class<S>(representative), \free_group_lift<S, Target, target, f>(\free_group_of<S>(x)) = \raw_word_eval<S, Target, target, f>(representative)}
    $is_free_group_of_value(S, x, \free_group_of<S>(x))
    by def:
        ? $is_free_group_of_value(S, x, \free_group_of<S>(x))
    \free_group_of<S>(x) = \free_word_class<S>(\generator_word<S>(x))
    \free_word_class<S>(representative) = \free_group_of<S>(x) = \free_word_class<S>(\generator_word<S>(x))
    release thm raw_word_in_own_class(S, \generator_word<S>(x))
    \generator_word<S>(x) $in \free_word_class<S>(representative)
    \free_word_class<S>(representative) = {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, representative, candidate)}
    \generator_word<S>(x) $in {candidate \raw_word_carrier<S>: $raw_words_equivalent(S, representative, candidate)}
    by def:
        ? $raw_words_equivalent(S, representative, \generator_word<S>(x))
    \raw_word_eval<S, Target, target, f>(representative) = \raw_word_eval<S, Target, target, f>(\generator_word<S>(x))
    release thm generator_word_eval(S, Target, target, f, x)
    \free_group_lift<S, Target, target, f>(\free_group_of<S>(x)) = \raw_word_eval<S, Target, target, f>(representative) = \raw_word_eval<S, Target, target, f>(\generator_word<S>(x)) = f(x)

# A target interpretation respects the presentation when every specified
# relation evaluates to the identity.
prop respects_group_relations(S set, Target nonempty_set, relations power_set(\free_group<S>), target &chap2::Group<Target>, f fn(x S) Target):
    forall relation relations:
        \free_group_lift<S, Target, target, f>(relation) = target.one

# Two free words represent the same presented-group element precisely when
# every relation-respecting interpretation gives them the same value.  This
# is the semantic quotient by the normal closure of the relations.
prop presented_words_equivalent(S set, relations power_set(\free_group<S>), left, right \free_group<S>):
    forall Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target:
        $respects_group_relations(S, Target, relations, target, f)
        =>:
            \free_group_lift<S, Target, target, f>(left) = \free_group_lift<S, Target, target, f>(right)

template<S set, relations power_set(\free_group<S>)>:
    have fn presented_word_class(word \free_group<S>) power_set(\free_group<S>) = {candidate \free_group<S>: $presented_words_equivalent(S, relations, word, candidate)}

thm free_word_in_own_presented_class:
    ? forall S set, relations power_set(\free_group<S>), word \free_group<S>:
        word $in \presented_word_class<S, relations>(word)
    by def:
        ? $presented_words_equivalent(S, relations, word, word)
    release thm set_builder_member(word, {candidate \free_group<S>: $presented_words_equivalent(S, relations, word, candidate)})
    word $in {candidate \free_group<S>: $presented_words_equivalent(S, relations, word, candidate)}
    \presented_word_class<S, relations>(word) = {candidate \free_group<S>: $presented_words_equivalent(S, relations, word, candidate)}

prop is_presented_group_element(S set, relations power_set(\free_group<S>), candidate power_set(\free_group<S>)):
    exist word \free_group<S> st {candidate = \presented_word_class<S, relations>(word)}

template<S set, relations power_set(\free_group<S>)>:
    have presented_group_carrier power_set(power_set(\free_group<S>)) = {candidate power_set(\free_group<S>): $is_presented_group_element(S, relations, candidate)}

thm presented_word_class_in_carrier:
    ? forall S set, relations power_set(\free_group<S>), word \free_group<S>:
        \presented_word_class<S, relations>(word) $in \presented_group_carrier<S, relations>
    witness $is_presented_group_element(S, relations, \presented_word_class<S, relations>(word)) from word
    release thm set_builder_member(\presented_word_class<S, relations>(word), {candidate power_set(\free_group<S>): $is_presented_group_element(S, relations, candidate)})
    \presented_word_class<S, relations>(word) $in {candidate power_set(\free_group<S>): $is_presented_group_element(S, relations, candidate)}
    \presented_group_carrier<S, relations> = {candidate power_set(\free_group<S>): $is_presented_group_element(S, relations, candidate)}

thm presented_group_carrier_nonempty:
    ? forall S set, relations power_set(\free_group<S>):
        $is_nonempty_set(\presented_group_carrier<S, relations>)
    release thm empty_raw_word_member(S)
    release thm free_word_class_in_carrier(S, \empty_raw_word<S>)
    \free_group<S> = \free_group_carrier<S>
    \free_word_class<S>(\empty_raw_word<S>) $in \free_group<S>
    have representative \free_group<S> = \free_word_class<S>(\empty_raw_word<S>)
    release thm presented_word_class_in_carrier(S, relations, representative)
    witness $is_nonempty_set(\presented_group_carrier<S, relations>) from \presented_word_class<S, relations>(representative)

template<S set, relations power_set(\free_group<S>)>:
    have presented_group nonempty_set = \presented_group_carrier<S, relations>

prop is_presented_group_of_value(S set, relations power_set(\free_group<S>), x S, value \presented_group<S, relations>):
    value = \presented_word_class<S, relations>(\free_group_of<S>(x))

template<S set, relations power_set(\free_group<S>)>:
    have fn presented_group_of by exist!:
        ? forall x S:
            exist! value \presented_group<S, relations> st {$is_presented_group_of_value(S, relations, x, value)}
        release thm presented_word_class_in_carrier(S, relations, \free_group_of<S>(x))
        \presented_group<S, relations> = \presented_group_carrier<S, relations>
        \presented_word_class<S, relations>(\free_group_of<S>(x)) $in \presented_group<S, relations>
        have selected_value \presented_group<S, relations> = \presented_word_class<S, relations>(\free_group_of<S>(x))
        witness exist! value \presented_group<S, relations> st {$is_presented_group_of_value(S, relations, x, value)} from selected_value:
            by def:
                ? $is_presented_group_of_value(S, relations, x, selected_value)
            claim:
                ? forall value1, value2 \presented_group<S, relations>:
                    $is_presented_group_of_value(S, relations, x, value1)
                    $is_presented_group_of_value(S, relations, x, value2)
                    =>:
                        value1 = value2
                by def:
                    ? $is_presented_group_of_value(S, relations, x, value1)
                by def:
                    ? $is_presented_group_of_value(S, relations, x, value2)
                value1 = \presented_word_class<S, relations>(\free_group_of<S>(x)) = value2

prop is_presented_group_lift_value(S set, relations power_set(\free_group<S>), Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, presented_word \presented_group<S, relations>, value Target):
    exist representative \free_group<S> st {presented_word = \presented_word_class<S, relations>(representative), value = \free_group_lift<S, Target, target, f>(representative)}

template<S set, relations power_set(\free_group<S>), Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target: $respects_group_relations(S, Target, relations, target, f)>:
    have fn presented_group_lift by exist!:
        ? forall presented_word \presented_group<S, relations>:
            exist! value Target st {$is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value)}
        \presented_group<S, relations> = \presented_group_carrier<S, relations>
        presented_word $in \presented_group_carrier<S, relations>
        \presented_group_carrier<S, relations> = {candidate power_set(\free_group<S>): $is_presented_group_element(S, relations, candidate)}
        presented_word $in {candidate power_set(\free_group<S>): $is_presented_group_element(S, relations, candidate)}
        by def:
            ? $is_presented_group_element(S, relations, presented_word)
        obtain representative from exist representative \free_group<S> st {presented_word = \presented_word_class<S, relations>(representative)}
        have selected_value Target = \free_group_lift<S, Target, target, f>(representative)
        witness exist value Target st {$is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value)} from selected_value:
            witness $is_presented_group_lift_value(S, relations, Target, target, f, presented_word, selected_value) from representative
        witness $is_presented_group_lift_value(S, relations, Target, target, f, presented_word, selected_value) from representative
        claim:
            ? forall value1, value2 Target:
                $is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value1)
                $is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value2)
                =>:
                    value1 = value2
            by def:
                ? $is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value1)
            obtain representative1 from exist representative1 \free_group<S> st {presented_word = \presented_word_class<S, relations>(representative1), value1 = \free_group_lift<S, Target, target, f>(representative1)}
            by def:
                ? $is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value2)
            obtain representative2 from exist representative2 \free_group<S> st {presented_word = \presented_word_class<S, relations>(representative2), value2 = \free_group_lift<S, Target, target, f>(representative2)}
            release thm free_word_in_own_presented_class(S, relations, representative2)
            \presented_word_class<S, relations>(representative1) = presented_word = \presented_word_class<S, relations>(representative2)
            representative2 $in \presented_word_class<S, relations>(representative1)
            \presented_word_class<S, relations>(representative1) = {candidate \free_group<S>: $presented_words_equivalent(S, relations, representative1, candidate)}
            representative2 $in {candidate \free_group<S>: $presented_words_equivalent(S, relations, representative1, candidate)}
            by def:
                ? $presented_words_equivalent(S, relations, representative1, representative2)
            \free_group_lift<S, Target, target, f>(representative1) = \free_group_lift<S, Target, target, f>(representative2)
            value1 = \free_group_lift<S, Target, target, f>(representative1) = \free_group_lift<S, Target, target, f>(representative2) = value2
        witness exist! value Target st {$is_presented_group_lift_value(S, relations, Target, target, f, presented_word, value)} from selected_value

thm presented_group_lift_generator:
    ? forall S set, relations power_set(\free_group<S>), Target nonempty_set, target &chap2::Group<Target>, f fn(x S) Target, x S:
        $respects_group_relations(S, Target, relations, target, f)
        =>:
            \presented_group_lift<S, relations, Target, target, f>(\presented_group_of<S, relations>(x)) = f(x)
    $is_presented_group_lift_value(S, relations, Target, target, f, \presented_group_of<S, relations>(x), \presented_group_lift<S, relations, Target, target, f>(\presented_group_of<S, relations>(x)))
    by def:
        ? $is_presented_group_lift_value(S, relations, Target, target, f, \presented_group_of<S, relations>(x), \presented_group_lift<S, relations, Target, target, f>(\presented_group_of<S, relations>(x)))
    obtain representative from exist representative \free_group<S> st {\presented_group_of<S, relations>(x) = \presented_word_class<S, relations>(representative), \presented_group_lift<S, relations, Target, target, f>(\presented_group_of<S, relations>(x)) = \free_group_lift<S, Target, target, f>(representative)}
    $is_presented_group_of_value(S, relations, x, \presented_group_of<S, relations>(x))
    by def:
        ? $is_presented_group_of_value(S, relations, x, \presented_group_of<S, relations>(x))
    \presented_group_of<S, relations>(x) = \presented_word_class<S, relations>(\free_group_of<S>(x))
    \presented_word_class<S, relations>(representative) = \presented_group_of<S, relations>(x) = \presented_word_class<S, relations>(\free_group_of<S>(x))
    release thm free_word_in_own_presented_class(S, relations, \free_group_of<S>(x))
    \free_group_of<S>(x) $in \presented_word_class<S, relations>(representative)
    \presented_word_class<S, relations>(representative) = {candidate \free_group<S>: $presented_words_equivalent(S, relations, representative, candidate)}
    \free_group_of<S>(x) $in {candidate \free_group<S>: $presented_words_equivalent(S, relations, representative, candidate)}
    by def:
        ? $presented_words_equivalent(S, relations, representative, \free_group_of<S>(x))
    \free_group_lift<S, Target, target, f>(representative) = \free_group_lift<S, Target, target, f>(\free_group_of<S>(x))
    release thm free_group_lift_generator(S, Target, target, f, x)
    \presented_group_lift<S, relations, Target, target, f>(\presented_group_of<S, relations>(x)) = \free_group_lift<S, Target, target, f>(representative) = \free_group_lift<S, Target, target, f>(\free_group_of<S>(x)) = f(x)

# ---------------------------------------------------------------------------
# 9.1.5 Group actions and orbits
# ---------------------------------------------------------------------------

prop is_group_action(G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X):
    forall x X:
        act(group.one, x) = x
    forall g, h G, x X:
        act(g, act(h, x)) = act(group.mul(g, h), x)

thm group_action_associativity:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, g, h G, x X:
        $is_group_action(G, X, group, act)
        =>:
            act(g, act(h, x)) = act(group.mul(g, h), x)

template<G, X set, act fn(g G, x X) X>:
    have fn toPermHom(g G) fn(x X) X = fn(y X) X {act(g, y)}

template<G nonempty_set, group &chap2::Group<G>>:
    have fn CayleyIsoMorphism(g G) fn(x G) G = fn(y G) G {group.mul(g, y)}

prop orbit_member(G, X set, act fn(g G, x X) X, x, y X):
    exist g G st {y = act(g, x)}

prop sets_equinumerous(A, B set):
    exist f fn(x A) B st {$bijective(A, B, f)}

template<G, X set, act fn(g G, x X) X>:
    have fn orbit(x X) power_set(X) = {y X: $orbit_member(G, X, act, x, y)}

prop stabilizer_member(G nonempty_set, X set, act fn(g G, x X) X, fixed X, candidate G):
    act(candidate, fixed) = fixed

template<G nonempty_set, X set, act fn(g G, x X) X, one G>:
    have fn stabilizer(x X) power_set(G) = {g G: $stabilizer_member(G, X, act, x, g)}

prop is_orbit_of(G, X set, act fn(g G, x X) X, O power_set(X)):
    exist x X st {O = \orbit<G, X, act>(x)}

template<G, X set, act fn(g G, x X) X>:
    have orbit_partition power_set(power_set(X)) = {O power_set(X): $is_orbit_of(G, X, act, O)}

thm group_action_gives_permutation:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, g G:
        $is_group_action(G, X, group, act)
        =>:
            $is_permutation(X, \toPermHom<G, X, act>(g))
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    \toPermHom<G, X, act>(g) = fn(y X) X {act(g, y)}
    \toPermHom<G, X, act>(g) $in fn(y X) X
    have inverse_action fn(y X) X = fn(y X) X {act(group.inv(g), y)}
    claim:
        ? $chap4::is_left_inverse(X, X, \toPermHom<G, X, act>(g), inverse_action)
        claim:
            ? forall x X:
                inverse_action(\toPermHom<G, X, act>(g)(x)) = x
            thm function_substitution:
                ? forall U, V set, h fn(q U) V, a, b U:
                    a = b
                    =>:
                        h(a) = h(b)
            \toPermHom<G, X, act>(g)(x) = act(g, x)
            inverse_action(\toPermHom<G, X, act>(g)(x)) = act(group.inv(g), \toPermHom<G, X, act>(g)(x))
            inverse_action(\toPermHom<G, X, act>(g)(x)) = act(group.inv(g), act(g, x))
            group.mul(group.inv(g), g) = group.one
            release thm function_substitution(G, X, fn(a G) X {act(a, x)}, group.mul(group.inv(g), g), group.one)
            inverse_action(\toPermHom<G, X, act>(g)(x)) = act(group.inv(g), act(g, x)) = act(group.mul(group.inv(g), g), x) = act(group.one, x) = x
        by def:
            ? $chap4::is_left_inverse(X, X, \toPermHom<G, X, act>(g), inverse_action)
    claim:
        ? forall x1, x2 X:
            \toPermHom<G, X, act>(g)(x1) = \toPermHom<G, X, act>(g)(x2)
            =>:
                x1 = x2
        inverse_action(\toPermHom<G, X, act>(g)(x1)) = inverse_action(\toPermHom<G, X, act>(g)(x2))
        inverse_action(\toPermHom<G, X, act>(g)(x1)) = x1
        inverse_action(\toPermHom<G, X, act>(g)(x2)) = x2
    claim:
        ? $chap4::is_right_inverse(X, X, \toPermHom<G, X, act>(g), inverse_action)
        claim:
            ? forall y X:
                \toPermHom<G, X, act>(g)(inverse_action(y)) = y
            thm function_substitution:
                ? forall U, V set, h fn(q U) V, a, b U:
                    a = b
                    =>:
                        h(a) = h(b)
            inverse_action(y) = act(group.inv(g), y)
            \toPermHom<G, X, act>(g)(inverse_action(y)) = act(g, inverse_action(y))
            \toPermHom<G, X, act>(g)(inverse_action(y)) = act(g, act(group.inv(g), y))
            act(g, act(group.inv(g), y)) = act(group.mul(g, group.inv(g)), y)
            release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, g)
            release thm function_substitution(G, X, fn(a G) X {act(a, y)}, group.mul(g, group.inv(g)), group.one)
            \toPermHom<G, X, act>(g)(inverse_action(y)) = act(g, act(group.inv(g), y)) = act(group.mul(g, group.inv(g)), y) = act(group.one, y) = y
        by def:
            ? $chap4::is_right_inverse(X, X, \toPermHom<G, X, act>(g), inverse_action)
    claim:
        ? forall y X:
            exist x X st {y = \toPermHom<G, X, act>(g)(x)}
        witness exist x X st {y = \toPermHom<G, X, act>(g)(x)} from inverse_action(y)
    by def:
        ? $is_permutation(X, \toPermHom<G, X, act>(g))

thm cayley_map_injective:
    ? forall G nonempty_set, group &chap2::Group<G>:
        $injective(G, fn(y G) G, \CayleyIsoMorphism<G, group>)
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    claim:
        ? forall a, b G:
            \CayleyIsoMorphism<G, group>(a) = \CayleyIsoMorphism<G, group>(b)
            =>:
                a = b
        thm function_substitution:
            ? forall U, V set, h fn(q U) V, x, y U:
                x = y
                =>:
                    h(x) = h(y)
        release thm function_substitution(fn(y G) G, G, fn(h fn(y G) G) G {h(group.one)}, \CayleyIsoMorphism<G, group>(a), \CayleyIsoMorphism<G, group>(b))
        \CayleyIsoMorphism<G, group>(a) = fn(y G) G {group.mul(a, y)}
        \CayleyIsoMorphism<G, group>(a)(group.one) = group.mul(a, group.one)
        (fn(h fn(y G) G) G {h(group.one)})(\CayleyIsoMorphism<G, group>(a)) = \CayleyIsoMorphism<G, group>(a)(group.one)
        (fn(h fn(y G) G) G {h(group.one)})(\CayleyIsoMorphism<G, group>(a)) = group.mul(a, group.one)
        \CayleyIsoMorphism<G, group>(b) = fn(y G) G {group.mul(b, y)}
        \CayleyIsoMorphism<G, group>(b)(group.one) = group.mul(b, group.one)
        (fn(h fn(y G) G) G {h(group.one)})(\CayleyIsoMorphism<G, group>(b)) = \CayleyIsoMorphism<G, group>(b)(group.one)
        (fn(h fn(y G) G) G {h(group.one)})(\CayleyIsoMorphism<G, group>(b)) = group.mul(b, group.one)
        release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, a)
        release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, b)
        a = group.mul(a, group.one) = group.mul(b, group.one) = b
    by def:
        ? $injective(G, fn(y G) G, \CayleyIsoMorphism<G, group>)

thm group_action_stabilizer_closed:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $is_group_action(G, X, group, act)
        =>:
            $is_subgroup(G, group, \stabilizer<G, X, act, group.one>(x))
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    \stabilizer<G, X, act, group.one>(x) = {g G: $stabilizer_member(G, X, act, x, g)}
    act(group.one, x) = x
    release thm set_builder_member(group.one, {g G: $stabilizer_member(G, X, act, x, g)})
    group.one $in \stabilizer<G, X, act, group.one>(x)
    claim:
        ? forall a, b G:
            a $in \stabilizer<G, X, act, group.one>(x)
            b $in \stabilizer<G, X, act, group.one>(x)
            =>:
                group.mul(a, b) $in \stabilizer<G, X, act, group.one>(x)
        a $in {g G: $stabilizer_member(G, X, act, x, g)}
        b $in {g G: $stabilizer_member(G, X, act, x, g)}
        act(a, x) = x
        act(b, x) = x
        act(group.mul(a, b), x) = act(a, act(b, x)) = act(a, x) = x
        release thm set_builder_member(group.mul(a, b), {g G: $stabilizer_member(G, X, act, x, g)})
        group.mul(a, b) $in \stabilizer<G, X, act, group.one>(x)
    claim:
        ? forall a G:
            a $in \stabilizer<G, X, act, group.one>(x)
            =>:
                group.inv(a) $in \stabilizer<G, X, act, group.one>(x)
        a $in {g G: $stabilizer_member(G, X, act, x, g)}
        act(a, x) = x
        release thm object_substitution(X, X, fn(y X) X {act(group.inv(a), y)}, act(a, x), x)
        act(group.inv(a), act(a, x)) = act(group.inv(a), x)
        group.mul(group.inv(a), a) = group.one
        act(group.inv(a), act(a, x)) = act(group.mul(group.inv(a), a), x) = act(group.one, x) = x
        act(group.inv(a), x) = x
        release thm set_builder_member(group.inv(a), {g G: $stabilizer_member(G, X, act, x, g)})
        group.inv(a) $in \stabilizer<G, X, act, group.one>(x)
    by def $is_subgroup(G, group, \stabilizer<G, X, act, group.one>(x))

thm group_action_mem_orbit:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X, g G:
        $is_group_action(G, X, group, act)
        =>:
            act(g, x) $in \orbit<G, X, act>(x)
    \orbit<G, X, act>(x) = {y X: $orbit_member(G, X, act, x, y)}
    witness $orbit_member(G, X, act, x, act(g, x)) from g
    release thm set_builder_member(act(g, x), {y X: $orbit_member(G, X, act, x, y)})

template<G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X: $is_group_action(G, X, group, act)>:
    have fn orbit_projection(g G) \orbit<G, X, act>(x) = act(g, x)

thm orbit_projection_surjective:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $is_group_action(G, X, group, act)
        =>:
            $surjective(G, \orbit<G, X, act>(x), \orbit_projection<G, X, group, act, x>)
    claim:
        ? forall y \orbit<G, X, act>(x):
            exist source_g G st {y = \orbit_projection<G, X, group, act, x>(source_g)}
        \orbit<G, X, act>(x) = {candidate X: $orbit_member(G, X, act, x, candidate)}
        y $in {candidate X: $orbit_member(G, X, act, x, candidate)}
        by def $orbit_member(G, X, act, x, y)
        obtain preimage_g from $orbit_member(G, X, act, x, y)
        witness exist source_g G st {y = \orbit_projection<G, X, group, act, x>(source_g)} from preimage_g:
            \orbit_projection<G, X, group, act, x>(preimage_g) = act(preimage_g, x) = y
    by def $surjective(G, \orbit<G, X, act>(x), \orbit_projection<G, X, group, act, x>)

thm orbit_projection_has_total_inverse:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $is_group_action(G, X, group, act)
        =>:
            $chap4::has_total_inverse(G, \orbit<G, X, act>(x), group.one, \orbit_projection<G, X, group, act, x>)
    release thm chap4::total_inverse_available(G, \orbit<G, X, act>(x), group.one, \orbit_projection<G, X, group, act, x>)

template<G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X: $is_group_action(G, X, group, act)>:
    have fn orbit_representative(y \orbit<G, X, act>(x)) G = \chap4::inverse<G, \orbit<G, X, act>(x), group.one, \orbit_projection<G, X, group, act, x>>(y)

thm orbit_representative_spec:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X, y \orbit<G, X, act>(x):
        $is_group_action(G, X, group, act)
        =>:
            \orbit_projection<G, X, group, act, x>(\orbit_representative<G, X, group, act, x>(y)) = y
    release thm orbit_projection_surjective(G, X, group, act, x)
    by def $surjective(G, \orbit<G, X, act>(x), \orbit_projection<G, X, group, act, x>)
    obtain preimage_g from exist source_g G st {y = \orbit_projection<G, X, group, act, x>(source_g)}
    witness $chap4::has_preimage(G, \orbit<G, X, act>(x), \orbit_projection<G, X, group, act, x>, y) from preimage_g
    release thm chap4::inverse_spec(G, \orbit<G, X, act>(x), group.one, \orbit_projection<G, X, group, act, x>, y)
    \orbit_representative<G, X, group, act, x>(y) = \chap4::inverse<G, \orbit<G, X, act>(x), group.one, \orbit_projection<G, X, group, act, x>>(y)
    \orbit_projection<G, X, group, act, x>(\orbit_representative<G, X, group, act, x>(y)) = \orbit_projection<G, X, group, act, x>(\chap4::inverse<G, \orbit<G, X, act>(x), group.one, \orbit_projection<G, X, group, act, x>>(y)) = y

thm orbit_coordinate_mem_stabilizer:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X, g G:
        $is_group_action(G, X, group, act)
        =>:
            group.mul(group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))), g) $in \stabilizer<G, X, act, group.one>(x)
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    release thm orbit_representative_spec(G, X, group, act, x, \orbit_projection<G, X, group, act, x>(g))
    have representative_g G = \orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))
    \orbit_projection<G, X, group, act, x>(representative_g) = \orbit_projection<G, X, group, act, x>(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))) = \orbit_projection<G, X, group, act, x>(g)
    \orbit_projection<G, X, group, act, x>(representative_g) = act(representative_g, x)
    \orbit_projection<G, X, group, act, x>(g) = act(g, x)
    act(representative_g, x) = act(g, x)
    release thm object_substitution(X, X, fn(y X) X {act(group.inv(representative_g), y)}, act(representative_g, x), act(g, x))
    act(group.inv(representative_g), act(representative_g, x)) = act(group.inv(representative_g), act(g, x))
    group.mul(group.inv(representative_g), representative_g) = group.one
    act(group.inv(representative_g), act(representative_g, x)) = act(group.mul(group.inv(representative_g), representative_g), x) = act(group.one, x) = x
    act(group.inv(representative_g), act(g, x)) = act(group.mul(group.inv(representative_g), g), x)
    act(group.mul(group.inv(representative_g), g), x) = x
    \stabilizer<G, X, act, group.one>(x) = {h G: $stabilizer_member(G, X, act, x, h)}
    by def $stabilizer_member(G, X, act, x, group.mul(group.inv(representative_g), g))
    release thm set_builder_member(group.mul(group.inv(representative_g), g), {h G: $stabilizer_member(G, X, act, x, h)})
    group.mul(group.inv(representative_g), g) $in \stabilizer<G, X, act, group.one>(x)

template<G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X: $is_group_action(G, X, group, act)>:
    have fn orbit_coordinate(g G) \stabilizer<G, X, act, group.one>(x) = group.mul(group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))), g)

thm orbit_stabilizer_forward_pair_member:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X, g G:
        $is_group_action(G, X, group, act)
        =>:
            (\orbit_projection<G, X, group, act, x>(g), \orbit_coordinate<G, X, group, act, x>(g)) $in cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x))
    release thm cart_member_from_coordinates((\orbit_projection<G, X, group, act, x>(g), \orbit_coordinate<G, X, group, act, x>(g)), cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)))

template<G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X: $is_group_action(G, X, group, act)>:
    have fn orbit_stabilizer_forward(g G) cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)) = (\orbit_projection<G, X, group, act, x>(g), \orbit_coordinate<G, X, group, act, x>(g))

template<G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X: $is_group_action(G, X, group, act)>:
    have fn orbit_stabilizer_backward(pair cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x))) G = group.mul(\orbit_representative<G, X, group, act, x>(pair[1]), pair[2])

thm orbit_stabilizer_backward_forward:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X, g G:
        $is_group_action(G, X, group, act)
        =>:
            \orbit_stabilizer_backward<G, X, group, act, x>(\orbit_stabilizer_forward<G, X, group, act, x>(g)) = g
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    \orbit_stabilizer_forward<G, X, group, act, x>(g) = (\orbit_projection<G, X, group, act, x>(g), \orbit_coordinate<G, X, group, act, x>(g))
    \orbit_stabilizer_forward<G, X, group, act, x>(g)[1] = \orbit_projection<G, X, group, act, x>(g)
    \orbit_stabilizer_forward<G, X, group, act, x>(g)[2] = \orbit_coordinate<G, X, group, act, x>(g)
    \orbit_stabilizer_backward<G, X, group, act, x>(\orbit_stabilizer_forward<G, X, group, act, x>(g)) = group.mul(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)), \orbit_coordinate<G, X, group, act, x>(g))
    \orbit_coordinate<G, X, group, act, x>(g) = group.mul(group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))), g)
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, \orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)))
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, g)}, group.mul(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)), group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)))), group.one)
    \orbit_stabilizer_backward<G, X, group, act, x>(\orbit_stabilizer_forward<G, X, group, act, x>(g)) = group.mul(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)), group.mul(group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))), g)) = group.mul(group.mul(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)), group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g)))), g) = group.mul(group.one, g) = g

thm orbit_stabilizer_forward_backward:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X, pair cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)):
        $is_group_action(G, X, group, act)
        =>:
            \orbit_stabilizer_forward<G, X, group, act, x>(\orbit_stabilizer_backward<G, X, group, act, x>(pair)) = pair
    by def $chap2::group_laws(G, group.mul, group.one, group.inv)
    have y \orbit<G, X, act>(x) = pair[1]
    have h \stabilizer<G, X, act, group.one>(x) = pair[2]
    have g G = \orbit_stabilizer_backward<G, X, group, act, x>(pair)
    g = \orbit_stabilizer_backward<G, X, group, act, x>(pair) = group.mul(\orbit_representative<G, X, group, act, x>(pair[1]), pair[2]) = group.mul(\orbit_representative<G, X, group, act, x>(y), h)
    h $in {candidate G: $stabilizer_member(G, X, act, x, candidate)}
    act(h, x) = x
    act(g, x) = act(group.mul(\orbit_representative<G, X, group, act, x>(y), h), x) = act(\orbit_representative<G, X, group, act, x>(y), act(h, x)) = act(\orbit_representative<G, X, group, act, x>(y), x)
    release thm orbit_representative_spec(G, X, group, act, x, y)
    act(\orbit_representative<G, X, group, act, x>(y), x) = \orbit_projection<G, X, group, act, x>(\orbit_representative<G, X, group, act, x>(y)) = y
    \orbit_projection<G, X, group, act, x>(g) = act(g, x) = y
    group.mul(group.inv(\orbit_representative<G, X, group, act, x>(y)), \orbit_representative<G, X, group, act, x>(y)) = group.one
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, h)}, group.mul(group.inv(\orbit_representative<G, X, group, act, x>(y)), \orbit_representative<G, X, group, act, x>(y)), group.one)
    \orbit_coordinate<G, X, group, act, x>(g) = group.mul(group.inv(\orbit_representative<G, X, group, act, x>(\orbit_projection<G, X, group, act, x>(g))), g) = group.mul(group.inv(\orbit_representative<G, X, group, act, x>(y)), group.mul(\orbit_representative<G, X, group, act, x>(y), h)) = group.mul(group.mul(group.inv(\orbit_representative<G, X, group, act, x>(y)), \orbit_representative<G, X, group, act, x>(y)), h) = group.mul(group.one, h) = h
    \orbit_stabilizer_forward<G, X, group, act, x>(g) = (\orbit_projection<G, X, group, act, x>(g), \orbit_coordinate<G, X, group, act, x>(g)) = (y, h)
    release thm tuple_equal_from_coordinates(pair, (pair[1], pair[2]))
    pair = (pair[1], pair[2]) = (y, h)
    g = \orbit_stabilizer_backward<G, X, group, act, x>(pair)
    \orbit_stabilizer_forward<G, X, group, act, x>(\orbit_stabilizer_backward<G, X, group, act, x>(pair)) = \orbit_stabilizer_forward<G, X, group, act, x>(g) = (y, h) = pair

thm orbit_stabilizer_forward_bijective:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $is_group_action(G, X, group, act)
        =>:
            $bijective(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>)
    claim:
        ? $chap4::is_left_inverse(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>, \orbit_stabilizer_backward<G, X, group, act, x>)
        claim:
            ? forall g G:
                \orbit_stabilizer_backward<G, X, group, act, x>(\orbit_stabilizer_forward<G, X, group, act, x>(g)) = g
            release thm orbit_stabilizer_backward_forward(G, X, group, act, x, g)
        by def $chap4::is_left_inverse(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>, \orbit_stabilizer_backward<G, X, group, act, x>)
    release thm chap4::injective_of_left_inverse(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>, \orbit_stabilizer_backward<G, X, group, act, x>)
    claim:
        ? $chap4::is_right_inverse(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>, \orbit_stabilizer_backward<G, X, group, act, x>)
        claim:
            ? forall pair cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)):
                \orbit_stabilizer_forward<G, X, group, act, x>(\orbit_stabilizer_backward<G, X, group, act, x>(pair)) = pair
            release thm orbit_stabilizer_forward_backward(G, X, group, act, x, pair)
        by def $chap4::is_right_inverse(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>, \orbit_stabilizer_backward<G, X, group, act, x>)
    release thm chap4::surjective_of_right_inverse(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>, \orbit_stabilizer_backward<G, X, group, act, x>)
    by def $bijective(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)), \orbit_stabilizer_forward<G, X, group, act, x>)

thm orbit_stabilizer_equinumerous:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $is_group_action(G, X, group, act)
        =>:
            $sets_equinumerous(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x)))
    release thm orbit_stabilizer_forward_bijective(G, X, group, act, x)
    witness $sets_equinumerous(G, cart(\orbit<G, X, act>(x), \stabilizer<G, X, act, group.one>(x))) from \orbit_stabilizer_forward<G, X, group, act, x>

thm conjugate_subgroup_by_one:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            \conjugate_subgroup<G, group>(group.one, H) = H
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    \conjugate_subgroup<G, group>(group.one, H) = {q G: $conjugate_subgroup_member(G, group, H, group.one, q)}
    group.mul(group.inv(group.one), group.one) = group.one
    release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, group.inv(group.one))
    group.mul(group.inv(group.one), group.one) = group.inv(group.one)
    group.inv(group.one) = group.one
    claim:
        ? forall x G:
            x $in \conjugate_subgroup<G, group>(group.one, H)
            =>:
                x $in H
        by def:
            ? $conjugate_subgroup_member(G, group, H, group.one, x)
        obtain h from $conjugate_subgroup_member(G, group, H, group.one, x)
        group.mul(group.one, h) = h
        group.mul(group.mul(group.one, h), group.inv(group.one)) = group.mul(h, group.one)
        release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, h)
        group.mul(h, group.one) = h
        x = h
    by def:
        ? \conjugate_subgroup<G, group>(group.one, H) $subset H
    \conjugate_subgroup<G, group>(group.one, H) $subset H
    claim:
        ? forall h G:
            h $in H
            =>:
                h $in \conjugate_subgroup<G, group>(group.one, H)
        witness $conjugate_subgroup_member(G, group, H, group.one, h) from h:
            group.mul(group.one, h) = h
            group.mul(group.mul(group.one, h), group.inv(group.one)) = group.mul(h, group.one)
            release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, h)
            group.mul(h, group.one) = h
            h = group.mul(group.mul(group.one, h), group.inv(group.one))
        release thm set_builder_member(h, {q G: $conjugate_subgroup_member(G, group, H, group.one, q)})
        h $in {q G: $conjugate_subgroup_member(G, group, H, group.one, q)}
    by def:
        ? H $subset \conjugate_subgroup<G, group>(group.one, H)
    H $subset \conjugate_subgroup<G, group>(group.one, H)
    by extension:
        ? \conjugate_subgroup<G, group>(group.one, H) = H

# ---------------------------------------------------------------------------
# 9.1.6 Quotient groups
# ---------------------------------------------------------------------------

prop is_normal_subgroup(G nonempty_set, group &chap2::Group<G>, H power_set(G)):
    $is_subgroup(G, group, H)
    forall g, h G:
        h $in H
        =>:
            group.mul(group.mul(g, h), group.inv(g)) $in H

# Quotient-group projection and operations are callable constructions.
# Representative independence and the group law package remain proof debt.
thm left_coset_in_quotient_group_carrier:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_normal_subgroup(G, group, H)
        =>:
            \left_coset<G, group>(H, g) $in \quotient_group_carrier<G, group>(H)
    \quotient_group_carrier<G, group>(H) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
    witness $is_left_coset_of(G, group, H, \left_coset<G, group>(H, g)) from g
    release thm set_builder_member(\left_coset<G, group>(H, g), {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)})
    \left_coset<G, group>(H, g) $in {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}

claim:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_normal_subgroup(G, group, H)
        =>:
            $is_nonempty_set(\quotient_group_carrier<G, group>(H))
    release thm left_coset_in_quotient_group_carrier(G, group, H, group.one)
    witness $is_nonempty_set(\quotient_group_carrier<G, group>(H)) from \left_coset<G, group>(H, group.one)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_normal_subgroup(G, group, H)>:
    have quotient_group_nonempty nonempty_set = \quotient_group_carrier<G, group>(H)

claim:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_normal_subgroup(G, group, H)
        =>:
            \left_coset<G, group>(H, g) $in \quotient_group_nonempty<G, group, H>
    release thm left_coset_in_quotient_group_carrier(G, group, H, g)
    \left_coset<G, group>(H, g) $in \quotient_group_carrier<G, group>(H)
    \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
    \left_coset<G, group>(H, g) $in \quotient_group_nonempty<G, group, H>

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_normal_subgroup(G, group, H)>:
    have fn quotient_group_mk(g G) \quotient_group_nonempty<G, group, H> = \left_coset<G, group>(H, g)

thm group_inv_inv:
    ? forall G nonempty_set, group &chap2::Group<G>, x G:
        group.inv(group.inv(x)) = x
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, group.inv(x))
    group.mul(group.inv(x), group.inv(group.inv(x))) = group.one
    group.mul(group.inv(x), x) = group.one
    group.mul(group.inv(x), group.inv(group.inv(x))) = group.mul(group.inv(x), x)
    release thm chap2::_group_left_cancel_structure(G, group.mul, group.one, group.inv, group.inv(x), group.inv(group.inv(x)), x)

thm left_coset_mul_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), a, b, x, y G:
        $is_normal_subgroup(G, group, H)
        x $in \left_coset<G, group>(H, a)
        y $in \left_coset<G, group>(H, b)
        =>:
            group.mul(x, y) $in \left_coset<G, group>(H, group.mul(a, b))
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    \left_coset<G, group>(H, group.mul(a, b)) = {q G: $left_coset_member(G, group, H, group.mul(a, b), q)}
    obtain u from exist h G st {h $in H, x = group.mul(a, h)}
    obtain v from exist h G st {h $in H, y = group.mul(b, h)}
    release thm group_inv_inv(G, group, b)
    group.mul(group.mul(group.inv(b), u), group.inv(group.inv(b))) $in H
    group.inv(group.inv(b)) = b
    group.mul(group.mul(group.inv(b), u), group.inv(group.inv(b))) = group.mul(group.mul(group.inv(b), u), b)
    have moved G = group.mul(group.mul(group.inv(b), u), b)
    moved $in H
    group.mul(moved, v) $in H
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, b)
    group.mul(b, group.mul(group.inv(b), u)) = group.mul(group.mul(b, group.inv(b)), u)
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, b)}, group.mul(b, group.mul(group.inv(b), u)), group.mul(group.mul(b, group.inv(b)), u))
    group.mul(b, moved) = group.mul(b, group.mul(group.mul(group.inv(b), u), b)) = group.mul(group.mul(b, group.mul(group.inv(b), u)), b) = group.mul(group.mul(group.mul(b, group.inv(b)), u), b)
    group.mul(b, group.inv(b)) = group.one
    release thm object_substitution(G, G, fn(t G) G {group.mul(group.mul(t, u), b)}, group.mul(b, group.inv(b)), group.one)
    group.mul(group.mul(group.mul(b, group.inv(b)), u), b) = group.mul(group.mul(group.one, u), b)
    group.mul(group.one, u) = u
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, b)}, group.mul(group.one, u), u)
    group.mul(group.mul(group.one, u), b) = group.mul(u, b)
    group.mul(b, moved) = group.mul(u, b)
    group.mul(u, group.mul(b, v)) = group.mul(group.mul(u, b), v)
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, v)}, group.mul(u, b), group.mul(b, moved))
    group.mul(group.mul(u, b), v) = group.mul(group.mul(b, moved), v)
    group.mul(group.mul(b, moved), v) = group.mul(b, group.mul(moved, v))
    group.mul(u, group.mul(b, v)) = group.mul(b, group.mul(moved, v))
    release thm object_substitution(G, G, fn(t G) G {group.mul(a, t)}, group.mul(u, group.mul(b, v)), group.mul(b, group.mul(moved, v)))
    group.mul(a, group.mul(u, group.mul(b, v))) = group.mul(a, group.mul(b, group.mul(moved, v)))
    group.mul(x, y) = group.mul(group.mul(a, u), group.mul(b, v)) = group.mul(a, group.mul(u, group.mul(b, v))) = group.mul(a, group.mul(b, group.mul(moved, v))) = group.mul(group.mul(a, b), group.mul(moved, v))
    witness $left_coset_member(G, group, H, group.mul(a, b), group.mul(x, y)) from group.mul(moved, v)
    release thm set_builder_member(group.mul(x, y), {q G: $left_coset_member(G, group, H, group.mul(a, b), q)})
    group.mul(x, y) $in {q G: $left_coset_member(G, group, H, group.mul(a, b), q)}

prop is_quotient_group_mul_value(G nonempty_set, group &chap2::Group<G>, H power_set(G), q, r, s power_set(G)):
    exist a, b G st {q = \left_coset<G, group>(H, a), r = \left_coset<G, group>(H, b), s = \left_coset<G, group>(H, group.mul(a, b))}

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_normal_subgroup(G, group, H)>:
    have fn quotient_group_mul by exist!:
        ? forall q, r \quotient_group_nonempty<G, group, H>:
            exist! s \quotient_group_nonempty<G, group, H> st {$is_quotient_group_mul_value(G, group, H, q, r, s)}
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        q $in \quotient_group_carrier<G, group>(H)
        \quotient_group_carrier<G, group>(H) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        q $in {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        $is_left_coset_of(G, group, H, q)
        obtain a from $is_left_coset_of(G, group, H, q)
        r $in \quotient_group_carrier<G, group>(H)
        r $in {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        $is_left_coset_of(G, group, H, r)
        obtain b from $is_left_coset_of(G, group, H, r)
        release thm left_coset_in_quotient_group_carrier(G, group, H, group.mul(a, b))
        \left_coset<G, group>(H, group.mul(a, b)) $in \quotient_group_carrier<G, group>(H)
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        \left_coset<G, group>(H, group.mul(a, b)) $in \quotient_group_nonempty<G, group, H>
        have candidate \quotient_group_nonempty<G, group, H> = \left_coset<G, group>(H, group.mul(a, b))
        witness exist s \quotient_group_nonempty<G, group, H> st {$is_quotient_group_mul_value(G, group, H, q, r, s)} from candidate:
            witness $is_quotient_group_mul_value(G, group, H, q, r, candidate) from a, b
        claim:
            ? forall s1, s2 \quotient_group_nonempty<G, group, H>:
                $is_quotient_group_mul_value(G, group, H, q, r, s1)
                $is_quotient_group_mul_value(G, group, H, q, r, s2)
                =>:
                    s1 = s2
            obtain a1, b1 from $is_quotient_group_mul_value(G, group, H, q, r, s1)
            obtain a2, b2 from $is_quotient_group_mul_value(G, group, H, q, r, s2)
            release thm left_coset_center_mem(G, group, H, a2)
            a2 $in \left_coset<G, group>(H, a2)
            \left_coset<G, group>(H, a2) = q = \left_coset<G, group>(H, a1)
            a2 $in \left_coset<G, group>(H, a1)
            release thm left_coset_center_mem(G, group, H, b2)
            b2 $in \left_coset<G, group>(H, b2)
            \left_coset<G, group>(H, b2) = r = \left_coset<G, group>(H, b1)
            b2 $in \left_coset<G, group>(H, b1)
            release thm left_coset_mul_mem(G, group, H, a1, b1, a2, b2)
            group.mul(a2, b2) $in \left_coset<G, group>(H, group.mul(a1, b1))
            release thm left_coset_eq_of_mem(G, group, H, group.mul(a1, b1), group.mul(a2, b2))
            \left_coset<G, group>(H, group.mul(a2, b2)) = \left_coset<G, group>(H, group.mul(a1, b1))
            s2 = \left_coset<G, group>(H, group.mul(a2, b2)) = \left_coset<G, group>(H, group.mul(a1, b1)) = s1

thm left_coset_inv_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), a, x G:
        $is_normal_subgroup(G, group, H)
        x $in \left_coset<G, group>(H, a)
        =>:
            group.inv(x) $in \left_coset<G, group>(H, group.inv(a))
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    \left_coset<G, group>(H, group.inv(a)) = {q G: $left_coset_member(G, group, H, group.inv(a), q)}
    obtain u from exist h G st {h $in H, x = group.mul(a, h)}
    group.inv(u) $in H
    group.mul(group.mul(a, group.inv(u)), group.inv(a)) $in H
    have moved G = group.mul(group.mul(a, group.inv(u)), group.inv(a))
    moved $in H
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, a)
    group.mul(group.inv(a), group.mul(a, group.inv(u))) = group.mul(group.mul(group.inv(a), a), group.inv(u))
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, group.inv(a))}, group.mul(group.inv(a), group.mul(a, group.inv(u))), group.mul(group.mul(group.inv(a), a), group.inv(u)))
    group.mul(group.inv(a), moved) = group.mul(group.inv(a), group.mul(group.mul(a, group.inv(u)), group.inv(a))) = group.mul(group.mul(group.inv(a), group.mul(a, group.inv(u))), group.inv(a)) = group.mul(group.mul(group.mul(group.inv(a), a), group.inv(u)), group.inv(a))
    group.mul(group.inv(a), a) = group.one
    release thm object_substitution(G, G, fn(t G) G {group.mul(group.mul(t, group.inv(u)), group.inv(a))}, group.mul(group.inv(a), a), group.one)
    group.mul(group.mul(group.mul(group.inv(a), a), group.inv(u)), group.inv(a)) = group.mul(group.mul(group.one, group.inv(u)), group.inv(a))
    group.mul(group.one, group.inv(u)) = group.inv(u)
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, group.inv(a))}, group.mul(group.one, group.inv(u)), group.inv(u))
    group.mul(group.mul(group.one, group.inv(u)), group.inv(a)) = group.mul(group.inv(u), group.inv(a))
    group.mul(group.inv(a), moved) = group.mul(group.inv(u), group.inv(a))
    release thm chap2::mul_inv_rev_structure(G, group.mul, group.one, group.inv, a, u)
    group.inv(x) = group.inv(group.mul(a, u)) = group.mul(group.inv(u), group.inv(a)) = group.mul(group.inv(a), moved)
    witness $left_coset_member(G, group, H, group.inv(a), group.inv(x)) from moved
    release thm set_builder_member(group.inv(x), {q G: $left_coset_member(G, group, H, group.inv(a), q)})
    group.inv(x) $in {q G: $left_coset_member(G, group, H, group.inv(a), q)}

prop is_quotient_group_inv_value(G nonempty_set, group &chap2::Group<G>, H power_set(G), q, s power_set(G)):
    exist a G st {q = \left_coset<G, group>(H, a), s = \left_coset<G, group>(H, group.inv(a))}

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_normal_subgroup(G, group, H)>:
    have fn quotient_group_inv by exist!:
        ? forall q \quotient_group_nonempty<G, group, H>:
            exist! s \quotient_group_nonempty<G, group, H> st {$is_quotient_group_inv_value(G, group, H, q, s)}
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        q $in \quotient_group_carrier<G, group>(H)
        \quotient_group_carrier<G, group>(H) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        q $in {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
        $is_left_coset_of(G, group, H, q)
        obtain a from $is_left_coset_of(G, group, H, q)
        release thm left_coset_in_quotient_group_carrier(G, group, H, group.inv(a))
        \left_coset<G, group>(H, group.inv(a)) $in \quotient_group_carrier<G, group>(H)
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        \left_coset<G, group>(H, group.inv(a)) $in \quotient_group_nonempty<G, group, H>
        have candidate \quotient_group_nonempty<G, group, H> = \left_coset<G, group>(H, group.inv(a))
        witness exist s \quotient_group_nonempty<G, group, H> st {$is_quotient_group_inv_value(G, group, H, q, s)} from candidate:
            witness $is_quotient_group_inv_value(G, group, H, q, candidate) from a
        claim:
            ? forall s1, s2 \quotient_group_nonempty<G, group, H>:
                $is_quotient_group_inv_value(G, group, H, q, s1)
                $is_quotient_group_inv_value(G, group, H, q, s2)
                =>:
                    s1 = s2
            obtain a1 from $is_quotient_group_inv_value(G, group, H, q, s1)
            obtain a2 from $is_quotient_group_inv_value(G, group, H, q, s2)
            release thm left_coset_center_mem(G, group, H, a2)
            a2 $in \left_coset<G, group>(H, a2)
            \left_coset<G, group>(H, a2) = q = \left_coset<G, group>(H, a1)
            a2 $in \left_coset<G, group>(H, a1)
            release thm left_coset_inv_mem(G, group, H, a1, a2)
            group.inv(a2) $in \left_coset<G, group>(H, group.inv(a1))
            release thm left_coset_eq_of_mem(G, group, H, group.inv(a1), group.inv(a2))
            \left_coset<G, group>(H, group.inv(a2)) = \left_coset<G, group>(H, group.inv(a1))
            s2 = \left_coset<G, group>(H, group.inv(a2)) = \left_coset<G, group>(H, group.inv(a1)) = s1

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_normal_subgroup(G, group, H)>:
    have quotient_group_one \quotient_group_nonempty<G, group, H> = \quotient_group_mk<G, group, H>(group.one)

thm quotient_group_has_mk_preimage:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), q power_set(G):
        $is_normal_subgroup(G, group, H)
        q $in \quotient_group_nonempty<G, group, H>
        =>:
            exist g G st {q = \quotient_group_mk<G, group, H>(g)}
    \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
    q $in \quotient_group_carrier<G, group>(H)
    \quotient_group_carrier<G, group>(H) = {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
    q $in {CarrierC power_set(G): $is_left_coset_of(G, group, H, CarrierC)}
    $is_left_coset_of(G, group, H, q)
    obtain g from $is_left_coset_of(G, group, H, q)
    \quotient_group_mk<G, group, H>(g) = \left_coset<G, group>(H, g)
    witness exist representative G st {q = \quotient_group_mk<G, group, H>(representative)} from g

thm quotient_group_mul_mk:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), x, y G:
        $is_normal_subgroup(G, group, H)
        =>:
            \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)) = \quotient_group_mk<G, group, H>(group.mul(x, y))
    $is_quotient_group_mul_value(G, group, H, \quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y), \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)))
    obtain x1, y1 from exist a, b G st {\quotient_group_mk<G, group, H>(x) = \left_coset<G, group>(H, a), \quotient_group_mk<G, group, H>(y) = \left_coset<G, group>(H, b), \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)) = \left_coset<G, group>(H, group.mul(a, b))}
    release thm left_coset_center_mem(G, group, H, x)
    x $in \left_coset<G, group>(H, x)
    \left_coset<G, group>(H, x) = \quotient_group_mk<G, group, H>(x) = \left_coset<G, group>(H, x1)
    x $in \left_coset<G, group>(H, x1)
    release thm left_coset_center_mem(G, group, H, y)
    y $in \left_coset<G, group>(H, y)
    \left_coset<G, group>(H, y) = \quotient_group_mk<G, group, H>(y) = \left_coset<G, group>(H, y1)
    y $in \left_coset<G, group>(H, y1)
    release thm left_coset_mul_mem(G, group, H, x1, y1, x, y)
    group.mul(x, y) $in \left_coset<G, group>(H, group.mul(x1, y1))
    release thm left_coset_eq_of_mem(G, group, H, group.mul(x1, y1), group.mul(x, y))
    \left_coset<G, group>(H, group.mul(x, y)) = \left_coset<G, group>(H, group.mul(x1, y1))
    \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)) = \left_coset<G, group>(H, group.mul(x1, y1)) = \left_coset<G, group>(H, group.mul(x, y)) = \quotient_group_mk<G, group, H>(group.mul(x, y))

thm quotient_group_inv_mk:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), x G:
        $is_normal_subgroup(G, group, H)
        =>:
            \quotient_group_inv<G, group, H>(\quotient_group_mk<G, group, H>(x)) = \quotient_group_mk<G, group, H>(group.inv(x))
    $is_quotient_group_inv_value(G, group, H, \quotient_group_mk<G, group, H>(x), \quotient_group_inv<G, group, H>(\quotient_group_mk<G, group, H>(x)))
    obtain x1 from exist a G st {\quotient_group_mk<G, group, H>(x) = \left_coset<G, group>(H, a), \quotient_group_inv<G, group, H>(\quotient_group_mk<G, group, H>(x)) = \left_coset<G, group>(H, group.inv(a))}
    release thm left_coset_center_mem(G, group, H, x)
    x $in \left_coset<G, group>(H, x)
    \left_coset<G, group>(H, x) = \quotient_group_mk<G, group, H>(x) = \left_coset<G, group>(H, x1)
    x $in \left_coset<G, group>(H, x1)
    release thm left_coset_inv_mem(G, group, H, x1, x)
    group.inv(x) $in \left_coset<G, group>(H, group.inv(x1))
    release thm left_coset_eq_of_mem(G, group, H, group.inv(x1), group.inv(x))
    \left_coset<G, group>(H, group.inv(x)) = \left_coset<G, group>(H, group.inv(x1))
    \quotient_group_inv<G, group, H>(\quotient_group_mk<G, group, H>(x)) = \left_coset<G, group>(H, group.inv(x1)) = \left_coset<G, group>(H, group.inv(x)) = \quotient_group_mk<G, group, H>(group.inv(x))

thm quotient_group_mul_of_representatives:
    ? forall G nonempty_set, group &chap2::Group<G>, H, q, r power_set(G), x, y G:
        $is_normal_subgroup(G, group, H)
        q $in \quotient_group_nonempty<G, group, H>
        r $in \quotient_group_nonempty<G, group, H>
        q = \quotient_group_mk<G, group, H>(x)
        r = \quotient_group_mk<G, group, H>(y)
        =>:
            \quotient_group_mul<G, group, H>(q, r) = \quotient_group_mk<G, group, H>(group.mul(x, y))
    release thm object_substitution(\quotient_group_nonempty<G, group, H>, \quotient_group_nonempty<G, group, H>, fn(t \quotient_group_nonempty<G, group, H>) \quotient_group_nonempty<G, group, H> {\quotient_group_mul<G, group, H>(t, r)}, q, \quotient_group_mk<G, group, H>(x))
    \quotient_group_mul<G, group, H>(q, r) = \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), r)
    release thm object_substitution(\quotient_group_nonempty<G, group, H>, \quotient_group_nonempty<G, group, H>, fn(t \quotient_group_nonempty<G, group, H>) \quotient_group_nonempty<G, group, H> {\quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), t)}, r, \quotient_group_mk<G, group, H>(y))
    \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), r) = \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y))
    release thm quotient_group_mul_mk(G, group, H, x, y)
    \quotient_group_mul<G, group, H>(q, r) = \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), r) = \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)) = \quotient_group_mk<G, group, H>(group.mul(x, y))

thm quotient_group_inv_of_representative:
    ? forall G nonempty_set, group &chap2::Group<G>, H, q power_set(G), x G:
        $is_normal_subgroup(G, group, H)
        q $in \quotient_group_nonempty<G, group, H>
        q = \quotient_group_mk<G, group, H>(x)
        =>:
            \quotient_group_inv<G, group, H>(q) = \quotient_group_mk<G, group, H>(group.inv(x))
    release thm object_substitution(\quotient_group_nonempty<G, group, H>, \quotient_group_nonempty<G, group, H>, \quotient_group_inv<G, group, H>, q, \quotient_group_mk<G, group, H>(x))
    \quotient_group_inv<G, group, H>(q) = \quotient_group_inv<G, group, H>(\quotient_group_mk<G, group, H>(x))
    release thm quotient_group_inv_mk(G, group, H, x)
    \quotient_group_inv<G, group, H>(q) = \quotient_group_inv<G, group, H>(\quotient_group_mk<G, group, H>(x)) = \quotient_group_mk<G, group, H>(group.inv(x))

thm quotient_group_tuple_is_group:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_normal_subgroup(G, group, H)
        =>:
            (\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>) $in &chap2::Group<\quotient_group_nonempty<G, group, H>>
    claim:
        ? forall q, r, s \quotient_group_nonempty<G, group, H>:
            \quotient_group_mul<G, group, H>(\quotient_group_mul<G, group, H>(q, r), s) = \quotient_group_mul<G, group, H>(q, \quotient_group_mul<G, group, H>(r, s))
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        q $in \quotient_group_carrier<G, group>(H)
        r $in \quotient_group_carrier<G, group>(H)
        s $in \quotient_group_carrier<G, group>(H)
        release thm quotient_group_has_mk_preimage(G, group, H, q)
        obtain x from exist g G st {q = \quotient_group_mk<G, group, H>(g)}
        release thm quotient_group_has_mk_preimage(G, group, H, r)
        obtain y from exist g G st {r = \quotient_group_mk<G, group, H>(g)}
        release thm quotient_group_has_mk_preimage(G, group, H, s)
        obtain z from exist g G st {s = \quotient_group_mk<G, group, H>(g)}
        release thm quotient_group_mul_of_representatives(G, group, H, q, r, x, y)
        have qr \quotient_group_nonempty<G, group, H> = \quotient_group_mul<G, group, H>(q, r)
        qr = \quotient_group_mk<G, group, H>(group.mul(x, y))
        release thm quotient_group_mul_of_representatives(G, group, H, qr, s, group.mul(x, y), z)
        release thm quotient_group_mul_of_representatives(G, group, H, r, s, y, z)
        have rs \quotient_group_nonempty<G, group, H> = \quotient_group_mul<G, group, H>(r, s)
        rs = \quotient_group_mk<G, group, H>(group.mul(y, z))
        release thm quotient_group_mul_of_representatives(G, group, H, q, rs, x, group.mul(y, z))
        group.mul(group.mul(x, y), z) = group.mul(x, group.mul(y, z))
        \quotient_group_mul<G, group, H>(\quotient_group_mul<G, group, H>(q, r), s) = \quotient_group_mul<G, group, H>(qr, s) = \quotient_group_mk<G, group, H>(group.mul(group.mul(x, y), z)) = \quotient_group_mk<G, group, H>(group.mul(x, group.mul(y, z))) = \quotient_group_mul<G, group, H>(q, rs) = \quotient_group_mul<G, group, H>(q, \quotient_group_mul<G, group, H>(r, s))
    claim:
        ? forall q \quotient_group_nonempty<G, group, H>:
            \quotient_group_mul<G, group, H>(\quotient_group_one<G, group, H>, q) = q
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        q $in \quotient_group_carrier<G, group>(H)
        release thm quotient_group_has_mk_preimage(G, group, H, q)
        obtain x from exist g G st {q = \quotient_group_mk<G, group, H>(g)}
        \quotient_group_one<G, group, H> = \quotient_group_mk<G, group, H>(group.one)
        release thm quotient_group_mul_of_representatives(G, group, H, \quotient_group_one<G, group, H>, q, group.one, x)
        group.mul(group.one, x) = x
        \quotient_group_mul<G, group, H>(\quotient_group_one<G, group, H>, q) = \quotient_group_mk<G, group, H>(group.mul(group.one, x)) = \quotient_group_mk<G, group, H>(x) = q
    claim:
        ? forall q \quotient_group_nonempty<G, group, H>:
            \quotient_group_mul<G, group, H>(\quotient_group_inv<G, group, H>(q), q) = \quotient_group_one<G, group, H>
        \quotient_group_nonempty<G, group, H> = \quotient_group_carrier<G, group>(H)
        q $in \quotient_group_carrier<G, group>(H)
        release thm quotient_group_has_mk_preimage(G, group, H, q)
        obtain x from exist g G st {q = \quotient_group_mk<G, group, H>(g)}
        release thm quotient_group_inv_of_representative(G, group, H, q, x)
        have iq \quotient_group_nonempty<G, group, H> = \quotient_group_inv<G, group, H>(q)
        iq = \quotient_group_mk<G, group, H>(group.inv(x))
        release thm quotient_group_mul_of_representatives(G, group, H, iq, q, group.inv(x), x)
        group.mul(group.inv(x), x) = group.one
        \quotient_group_one<G, group, H> = \quotient_group_mk<G, group, H>(group.one)
        \quotient_group_mul<G, group, H>(\quotient_group_inv<G, group, H>(q), q) = \quotient_group_mul<G, group, H>(iq, q) = \quotient_group_mk<G, group, H>(group.mul(group.inv(x), x)) = \quotient_group_mk<G, group, H>(group.one) = \quotient_group_one<G, group, H>
    by def:
        ? $chap2::group_laws(\quotient_group_nonempty<G, group, H>, \quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>)
    \quotient_group_mul<G, group, H> $in fn(q, r \quotient_group_nonempty<G, group, H>) \quotient_group_nonempty<G, group, H>
    \quotient_group_one<G, group, H> $in \quotient_group_nonempty<G, group, H>
    \quotient_group_inv<G, group, H> $in fn(q \quotient_group_nonempty<G, group, H>) \quotient_group_nonempty<G, group, H>
    release thm cart_member_from_coordinates((\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>), cart(fn(q, r \quotient_group_nonempty<G, group, H>) \quotient_group_nonempty<G, group, H>, \quotient_group_nonempty<G, group, H>, fn(q \quotient_group_nonempty<G, group, H>) \quotient_group_nonempty<G, group, H>))
    release thm struct_member((\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>), &chap2::Group<\quotient_group_nonempty<G, group, H>>)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_normal_subgroup(G, group, H)>:
    have quotient_group &chap2::Group<\quotient_group_nonempty<G, group, H>> = (\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>)

prop kills_subgroup(G, Target nonempty_set, target &chap2::Group<Target>, H power_set(G), f fn(x G) Target):
    forall h H:
        f(h) = target.one

prop is_quotient_group_lift_value(G, Target nonempty_set, source &chap2::Group<G>, H power_set(G), f fn(x G) Target, q power_set(G), y Target):
    exist g G st {q = \left_coset<G, source>(H, g), y = f(g)}

template<G, Target nonempty_set, source &chap2::Group<G>, target &chap2::Group<Target>, H power_set(G), f fn(x G) Target: $is_normal_subgroup(G, source, H), $is_group_hom(G, Target, source, target, f), $kills_subgroup(G, Target, target, H, f)>:
    have fn quotient_group_lift by exist!:
        ? forall q \quotient_group_nonempty<G, source, H>:
            exist! y Target st {$is_quotient_group_lift_value(G, Target, source, H, f, q, y)}
        \quotient_group_nonempty<G, source, H> = \quotient_group_carrier<G, source>(H)
        q $in \quotient_group_carrier<G, source>(H)
        \quotient_group_carrier<G, source>(H) = {CarrierC power_set(G): $is_left_coset_of(G, source, H, CarrierC)}
        q $in {CarrierC power_set(G): $is_left_coset_of(G, source, H, CarrierC)}
        $is_left_coset_of(G, source, H, q)
        obtain g from $is_left_coset_of(G, source, H, q)
        have candidate Target = f(g)
        witness exist y Target st {$is_quotient_group_lift_value(G, Target, source, H, f, q, y)} from candidate:
            witness $is_quotient_group_lift_value(G, Target, source, H, f, q, candidate) from g
        claim:
            ? forall y1, y2 Target:
                $is_quotient_group_lift_value(G, Target, source, H, f, q, y1)
                $is_quotient_group_lift_value(G, Target, source, H, f, q, y2)
                =>:
                    y1 = y2
            obtain g1 from $is_quotient_group_lift_value(G, Target, source, H, f, q, y1)
            obtain g2 from $is_quotient_group_lift_value(G, Target, source, H, f, q, y2)
            release thm left_coset_center_mem(G, source, H, g2)
            g2 $in \left_coset<G, source>(H, g2)
            \left_coset<G, source>(H, g2) = q = \left_coset<G, source>(H, g1)
            g2 $in \left_coset<G, source>(H, g1)
            obtain h from exist token G st {token $in H, g2 = source.mul(g1, token)}
            f(source.mul(g1, h)) = target.mul(f(g1), f(h))
            f(h) = target.one
            release thm chap2::group_mul_one(Target, target, f(g1))
            y2 = f(g2) = f(source.mul(g1, h)) = target.mul(f(g1), f(h)) = target.mul(f(g1), target.one) = f(g1) = y1

# ---------------------------------------------------------------------------
# 9.1.7 Cauchy counting and the first Sylow theorem
# ---------------------------------------------------------------------------

# Finite function-space counting foundations for the Chapter 9 Sylow proof.
# Every declaration in this draft was accepted in the clean persistent
# Chapter 9 session with the original trusted Sylow theorem removed.

thm empty_function_space_singleton:
    ? forall B nonempty_set, b B:
        fn(input {}) B = {fn(input {}) B {b}}
    claim:
        ? forall f fn(input {}) B:
            f = fn(input {}) B {b}
        claim:
            ? forall empty_input {}:
                f(empty_input) = fn(input {}) B {b}(empty_input)
            by contra:
                ? f(empty_input) = fn(input {}) B {b}(empty_input)
                impossible empty_input $in {}
        by def:
            ? $fn_eq(f, fn(input {}) B {b})
    by extension:
        ? fn(input {}) B = {fn(input {}) B {b}}
        claim:
            ? forall f fn(input {}) B:
                f $in {fn(input {}) B {b}}
            f = fn(input {}) B {b}
        claim:
            ? forall f {fn(input {}) B {b}}:
                f $in fn(input {}) B

prop is_new_point_extension_value(A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S), output B):
    input = z
    output = pair[2]

prop is_old_point_extension_value(A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S), output B):
    input != z
    exist old_input S st {old_input = input, output = pair[1](old_input)}

prop is_point_extension_value(A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S), output B):
    $is_new_point_extension_value(A, z, S, B, pair, input, output) or $is_old_point_extension_value(A, z, S, B, pair, input, output)

thm point_extension_value_exists_unique:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S):
        not z $in S
        =>:
            exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)}
    by cases:
        ? exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)}
        case input = z:
            witness exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)} from pair[2]:
                by def:
                    ? $is_new_point_extension_value(A, z, S, B, pair, input, pair[2])
                claim:
                    ? forall left, right B:
                        $is_point_extension_value(A, z, S, B, pair, input, left)
                        $is_point_extension_value(A, z, S, B, pair, input, right)
                        =>:
                            left = right
                    claim:
                        ? left = pair[2]
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, left)
                        by cases:
                            ? left = pair[2]
                            case $is_new_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, left)
                            case $is_old_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, left)
                                impossible input = z
                    claim:
                        ? right = pair[2]
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, right)
                        by cases:
                            ? right = pair[2]
                            case $is_new_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, right)
                            case $is_old_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, right)
                                impossible input = z
                    left = pair[2] = right
        case input != z:
            claim:
                ? input $in S
                input $in {z} or input $in S
                by cases:
                    ? input $in S
                    case input $in {z}:
                        input = z
                        impossible input != z
                    case input $in S:
                        input $in S
            have old_input S = input
            witness exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)} from pair[1](old_input):
                claim:
                    ? $is_old_point_extension_value(A, z, S, B, pair, input, pair[1](old_input))
                    witness exist old_witness S st {old_witness = input, pair[1](old_input) = pair[1](old_witness)} from old_input
                by def:
                    ? $is_point_extension_value(A, z, S, B, pair, input, pair[1](old_input))
                claim:
                    ? forall left, right B:
                        $is_point_extension_value(A, z, S, B, pair, input, left)
                        $is_point_extension_value(A, z, S, B, pair, input, right)
                        =>:
                            left = right
                    claim:
                        ? left = pair[1](old_input)
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, left)
                        by cases:
                            ? left = pair[1](old_input)
                            case $is_new_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, left)
                                impossible input != z
                            case $is_old_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, left)
                                obtain left_input from exist left_input S st {left_input = input, left = pair[1](left_input)}
                                left_input = input = old_input
                                left = pair[1](left_input) = pair[1](old_input)
                    claim:
                        ? right = pair[1](old_input)
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, right)
                        by cases:
                            ? right = pair[1](old_input)
                            case $is_new_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, right)
                                impossible input != z
                            case $is_old_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, right)
                                obtain right_input from exist right_input S st {right_input = input, right = pair[1](right_input)}
                                right_input = input = old_input
                                right = pair[1](right_input) = pair[1](old_input)
                    left = pair[1](old_input) = right

template<A set, z A, S power_set(A), B nonempty_set: not z $in S>:
    have fn point_extension_value_selected by exist!:
        ? forall pair cart(fn(x S) B, B), input union({z}, S):
            exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)}
        release thm point_extension_value_exists_unique(A, z, S, B, pair, input)

template<A set, z A, S power_set(A), B nonempty_set: not z $in S>:
    have fn point_extend(pair cart(fn(x S) B, B)) fn(output union({z}, S)) B = fn(input union({z}, S)) B {\point_extension_value_selected<A, z, S, B>(pair, input)}

thm point_extend_value_relation:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S):
        not z $in S
        =>:
            $is_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
    $is_point_extension_value(A, z, S, B, pair, input, \point_extension_value_selected<A, z, S, B>(pair, input))
    \point_extend<A, z, S, B>(pair) = fn(current union({z}, S)) B {\point_extension_value_selected<A, z, S, B>(pair, current)}
    \point_extend<A, z, S, B>(pair)(input) = \point_extension_value_selected<A, z, S, B>(pair, input)
    \point_extension_value_selected<A, z, S, B>(pair, input) = \point_extend<A, z, S, B>(pair)(input)
    $is_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))

thm point_extend_at_new:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B):
        not z $in S
        =>:
            \point_extend<A, z, S, B>(pair)(z) = pair[2]
    release thm point_extend_value_relation(A, z, S, B, pair, z)
    by def:
        ? $is_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z))
    by cases:
        ? \point_extend<A, z, S, B>(pair)(z) = pair[2]
        case $is_new_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z)):
            by def $is_new_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z))
        case $is_old_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z)):
            by def $is_old_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z))
            impossible z = z

thm point_extend_at_old:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input S:
        not z $in S
        =>:
            \point_extend<A, z, S, B>(pair)(input) = pair[1](input)
    input $in union({z}, S)
    release thm point_extend_value_relation(A, z, S, B, pair, input)
    by def:
        ? $is_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
    by cases:
        ? \point_extend<A, z, S, B>(pair)(input) = pair[1](input)
        case $is_new_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input)):
            by def $is_new_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
            impossible not z $in S
        case $is_old_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input)):
            by def $is_old_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
            obtain old_input from exist old_input S st {old_input = input, \point_extend<A, z, S, B>(pair)(input) = pair[1](old_input)}
            old_input = input
            \point_extend<A, z, S, B>(pair)(input) = pair[1](old_input) = pair[1](input)

thm equal_functions_equal_at:
    ? forall A, B set, f, g fn(x A) B, input A:
        f = g
        =>:
            f(input) = g(input)
    have fn evaluate(h fn(x A) B) B = h(input)
    evaluate(f) = evaluate(g)
    f(input) = evaluate(f) = evaluate(g) = g(input)

thm function_equal_on_equal_inputs:
    ? forall A, B set, f fn(x A) B, left, right A:
        left = right
        =>:
            f(left) = f(right)
    f(left) = f(right)

thm point_extend_injective:
    ? forall A set, z A, S power_set(A), B nonempty_set:
        not z $in S
        =>:
            $injective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)
    claim:
        ? forall left, right cart(fn(x S) B, B):
            \point_extend<A, z, S, B>(left) = \point_extend<A, z, S, B>(right)
            =>:
                left = right
        have left_function fn(x S) B = left[1]
        have right_function fn(x S) B = right[1]
        have left_value B = left[2]
        have right_value B = right[2]
        release thm equal_functions_equal_at(union({z}, S), B, \point_extend<A, z, S, B>(left), \point_extend<A, z, S, B>(right), z)
        release thm point_extend_at_new(A, z, S, B, left)
        release thm point_extend_at_new(A, z, S, B, right)
        left_value = left[2] = \point_extend<A, z, S, B>(left)(z) = \point_extend<A, z, S, B>(right)(z) = right[2] = right_value
        claim:
            ? forall input S:
                left_function(input) = right_function(input)
            release thm equal_functions_equal_at(union({z}, S), B, \point_extend<A, z, S, B>(left), \point_extend<A, z, S, B>(right), input)
            release thm point_extend_at_old(A, z, S, B, left, input)
            release thm point_extend_at_old(A, z, S, B, right, input)
            left_function(input) = left[1](input) = \point_extend<A, z, S, B>(left)(input) = \point_extend<A, z, S, B>(right)(input) = right[1](input) = right_function(input)
        by def:
            ? $fn_eq(left_function, right_function)
        left_function = right_function
        left[1] = left_function = right_function = right[1]
        left[2] = left_value = right_value = right[2]
        tuple_dim(left) = 2
        tuple_dim(right) = 2
        claim:
            ? forall coordinate closed_range(1, 2):
                left[coordinate] = right[coordinate]
            by closed_range as cases: coordinate $in 1...2
            by cases:
                ? left[coordinate] = right[coordinate]
                case coordinate = 1:
                    left[coordinate] = left[1] = right[1] = right[coordinate]
                case coordinate = 2:
                    left[coordinate] = left[2] = right[2] = right[coordinate]
        release thm tuple_equal_from_coordinates(left, right)
    by def:
        ? $injective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)

thm point_extend_surjective:
    ? forall A set, z A, S power_set(A), B nonempty_set:
        not z $in S
        =>:
            $surjective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)
    claim:
        ? forall target fn(output union({z}, S)) B:
            exist source cart(fn(x S) B, B) st {target = \point_extend<A, z, S, B>(source)}
        have fn restricted(input S) B = target(input)
        have source_pair cart(fn(x S) B, B) = (restricted, target(z))
        claim:
            ? forall input union({z}, S):
                target(input) = \point_extend<A, z, S, B>(source_pair)(input)
            by cases:
                ? target(input) = \point_extend<A, z, S, B>(source_pair)(input)
                case input = z:
                    release thm function_equal_on_equal_inputs(union({z}, S), B, target, input, z)
                    release thm point_extend_at_new(A, z, S, B, source_pair)
                    source_pair[2] = target(z)
                    target(input) = target(z) = source_pair[2] = \point_extend<A, z, S, B>(source_pair)(z)
                    release thm function_equal_on_equal_inputs(union({z}, S), B, \point_extend<A, z, S, B>(source_pair), z, input)
                    target(input) = \point_extend<A, z, S, B>(source_pair)(input)
                case input != z:
                    claim:
                        ? input $in S
                        input $in {z} or input $in S
                        by cases:
                            ? input $in S
                            case input $in {z}:
                                input = z
                                impossible input != z
                            case input $in S:
                                input $in S
                    have old_input S = input
                    release thm point_extend_at_old(A, z, S, B, source_pair, old_input)
                    source_pair[1] = restricted
                    source_pair[1](old_input) = restricted(old_input) = target(old_input)
                    release thm function_equal_on_equal_inputs(union({z}, S), B, target, old_input, input)
                    target(input) = target(old_input) = source_pair[1](old_input) = \point_extend<A, z, S, B>(source_pair)(old_input)
                    release thm function_equal_on_equal_inputs(union({z}, S), B, \point_extend<A, z, S, B>(source_pair), old_input, input)
                    target(input) = \point_extend<A, z, S, B>(source_pair)(input)
        by def:
            ? $fn_eq(target, \point_extend<A, z, S, B>(source_pair))
        target = \point_extend<A, z, S, B>(source_pair)
        witness exist source cart(fn(x S) B, B) st {target = \point_extend<A, z, S, B>(source)} from source_pair
    by def:
        ? $surjective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)

thm point_extend_range_eq:
    ? forall A set, z A, S power_set(A), B nonempty_set:
        not z $in S
        =>:
            fn_range(\point_extend<A, z, S, B>) = fn(output union({z}, S)) B
    release thm point_extend_surjective(A, z, S, B)
    by def:
        ? $surjective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)
    by extension:
        ? fn_range(\point_extend<A, z, S, B>) = fn(output union({z}, S)) B
        claim:
            ? forall target fn_range(\point_extend<A, z, S, B>):
                target $in fn(output union({z}, S)) B
            have by preimage source from target $in fn_range(\point_extend<A, z, S, B>)
            \point_extend<A, z, S, B>(source) $in fn(output union({z}, S)) B
            target = \point_extend<A, z, S, B>(source)
            target $in fn(output union({z}, S)) B
        claim:
            ? forall target fn(output union({z}, S)) B:
                target $in fn_range(\point_extend<A, z, S, B>)
            obtain source from exist source cart(fn(x S) B, B) st {target = \point_extend<A, z, S, B>(source)}
            \point_extend<A, z, S, B>(source) $in fn_range(\point_extend<A, z, S, B>)
            target = \point_extend<A, z, S, B>(source)
            target $in fn_range(\point_extend<A, z, S, B>)

prop finite_function_space_count_property(P, B finite_set):
    $is_finite_set(fn(x P) B)
    finite_set_size(fn(x P) B) = finite_set_size(B)^finite_set_size(P)

thm singleton_intersection_empty:
    ? forall A set, z A, S power_set(A):
        not z $in S
        =>:
            intersect({z}, S) = {}
    by extension:
        ? intersect({z}, S) = {}
        claim:
            ? forall input intersect({z}, S):
                input $in {}
            input $in {z}
            input = z
            input $in S
            z $in S
            by contra:
                ? input $in {}
                impossible not z $in S
        claim:
            ? forall empty_input {}:
                empty_input $in intersect({z}, S)
            by contra:
                ? empty_input $in intersect({z}, S)
                impossible empty_input $in {}

thm finite_function_space_count_insert_step:
    ? forall A, B finite_set, default B, z A, S finite_set:
        S $subset A
        not z $in S
        $finite_function_space_count_property(S, B)
        =>:
            $finite_function_space_count_property(union({z}, S), B)
    witness $is_nonempty_set(B) from default
    by def:
        ? $finite_function_space_count_property(S, B)
    $is_finite_set(fn(x S) B)
    finite_set_size(fn(x S) B) = finite_set_size(B)^finite_set_size(S)
    have source_functions finite_set = fn(x S) B
    have source_pairs finite_set = cart(source_functions, B)
    source_functions = fn(x S) B
    source_pairs = cart(source_functions, B) = cart(fn(x S) B, B)
    $is_finite_set(cart(fn(x S) B, B))
    finite_set_size(cart(source_functions, B)) = finite_set_size(source_functions) * finite_set_size(B)
    finite_set_size(source_pairs) = finite_set_size(cart(source_functions, B)) = finite_set_size(source_functions) * finite_set_size(B)
    finite_set_size(source_functions) = finite_set_size(fn(x S) B) = finite_set_size(B)^finite_set_size(S)
    finite_set_size(cart(fn(x S) B, B)) = finite_set_size(source_pairs) = finite_set_size(source_functions) * finite_set_size(B) = finite_set_size(B)^finite_set_size(S) * finite_set_size(B)
    release thm point_extend_injective(A, z, S, B)
    release thm point_extend_range_eq(A, z, S, B)
    $is_finite_set(fn_range(\point_extend<A, z, S, B>))
    finite_set_size(fn_range(\point_extend<A, z, S, B>)) = finite_set_size(cart(fn(x S) B, B))
    fn_range(\point_extend<A, z, S, B>) = fn(output union({z}, S)) B
    $is_finite_set(fn(output union({z}, S)) B)
    finite_set_size(fn(output union({z}, S)) B) = finite_set_size(fn_range(\point_extend<A, z, S, B>))
    release thm singleton_intersection_empty(A, z, S)
    finite_set_size(intersect({z}, S)) = finite_set_size({}) = 0
    finite_set_size({z}) = 1
    finite_set_size(union({z}, S)) = finite_set_size({z}) + finite_set_size(S) - finite_set_size(intersect({z}, S)) = 1 + finite_set_size(S) - 0 = finite_set_size(S) + 1
    finite_set_size(B)^(finite_set_size(S) + 1) = finite_set_size(B)^finite_set_size(S) * finite_set_size(B)
    finite_set_size(fn(output union({z}, S)) B) = finite_set_size(fn_range(\point_extend<A, z, S, B>)) = finite_set_size(cart(fn(x S) B, B)) = finite_set_size(B)^finite_set_size(S) * finite_set_size(B) = finite_set_size(B)^(finite_set_size(S) + 1) = finite_set_size(B)^finite_set_size(union({z}, S))
    by def:
        ? $finite_function_space_count_property(union({z}, S), B)

thm finite_function_space_count_empty:
    ? forall B finite_set, default B:
        $finite_function_space_count_property({}, B)
    witness $is_nonempty_set(B) from default
    release thm empty_function_space_singleton(B, default)
    have empty_functions finite_set = {fn(input {}) B {default}}
    fn(input {}) B = {fn(input {}) B {default}} = empty_functions
    $is_finite_set(fn(input {}) B)
    finite_set_size(empty_functions) = finite_set_size({fn(input {}) B {default}}) = 1
    finite_set_size(fn(input {}) B) = finite_set_size(empty_functions) = 1
    finite_set_size({}) = 0
    finite_set_size(B)^finite_set_size({}) = finite_set_size(B)^0 = 1
    finite_set_size(fn(input {}) B) = finite_set_size(B)^finite_set_size({})
    by def:
        ? $finite_function_space_count_property({}, B)

thm finite_function_space_count:
    ? forall A, B finite_set, default B:
        $finite_function_space_count_property(A, B)
    witness $is_nonempty_set(B) from default
    by induc P in A:
        ? $finite_function_space_count_property(P, B)
        ? from P = {}:
            release thm finite_function_space_count_empty(B, default)
            $finite_function_space_count_property({}, B)
            $finite_function_space_count_property(P, B)
        ? induc z, S:
            release thm finite_function_space_count_insert_step(A, B, default, z, S)


# Arithmetic foundation for orbit sizes in finite p-group actions.
thm prime_divides_nontrivial_factor_of_prime_power:
    ? forall p N+, n N, left, right N+:
        $prime(p)
        left * right = p^n
        left > 1
        =>:
            $chap2::divides(p, left)
    by contra:
        ? $chap2::divides(p, left)
        not $chap2::divides(p, left)
        release thm chap6::prime_factor_exponent_zero_of_not_divides(left, p)
        chap5::prime_factor_exponent(left, p) = 0
        left != 0
        right != 0
        release thm chap5::factorization_mul(left, right, p)
        chap5::prime_factor_exponent(left * right, p) = chap5::prime_factor_exponent(left, p) + chap5::prime_factor_exponent(right, p) = chap5::prime_factor_exponent(right, p)
        release thm chap5::factorization_pow(p, n, p)
        release thm chap5::prime_factorization_self(p)
        chap5::prime_factor_exponent(p^n, p) = n * chap5::prime_factor_exponent(p, p) = n * 1 = n
        release thm chap9::object_substitution(N, N, fn(t N) N {chap5::prime_factor_exponent(t, p)}, left * right, p^n)
        chap5::prime_factor_exponent(left * right, p) = chap5::prime_factor_exponent(p^n, p)
        chap5::prime_factor_exponent(right, p) = chap5::prime_factor_exponent(left * right, p) = chap5::prime_factor_exponent(p^n, p) = n
        release thm chap5::prime_factor_exponent_power_divides(right, p)
        $chap2::divides(p^chap5::prime_factor_exponent(right, p), right)
        p^chap5::prime_factor_exponent(right, p) = p^n
        $chap2::divides(p^n, right)
        obtain quotient from exist quotient Z st {right = p^n * quotient}
        right = p^n * quotient
        p^n > 0
        right > 0
        by cases:
            ? 0 < 0
            case quotient > 0:
                have positive_quotient N+ = quotient
                release thm chap9::object_substitution(Z, Z, fn(t Z) Z {p^n * t}, positive_quotient, quotient)
                p^n * positive_quotient = p^n * quotient = right
                release thm chap9::object_substitution(Z, Z, fn(t Z) Z {left * t}, p^n * positive_quotient, right)
                left * (p^n * positive_quotient) = left * right
                p^n * (left * positive_quotient) = left * (p^n * positive_quotient) = left * right = p^n = p^n * 1
                p^n != 0
                release thm chap5::integer_left_multiplication_cancellation(p^n, left * positive_quotient, 1)
                left * positive_quotient = 1
                positive_quotient >= 1
                left * positive_quotient >= left * 1 = left > 1
                1 < 1
                0 < 0
            case quotient = 0:
                right = p^n * quotient = p^n * 0 = 0
                right > 0
                0 < 0
            case quotient < 0:
                p^n * quotient < 0
                right = p^n * quotient < 0
                right > 0
                0 < 0
        0 < 0
        impossible 0 < 0

thm nontrivial_orbit_size_divisible_by_prime:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n N, x X:
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        $is_finite_set(\chap9::orbit<G, X, act>(x))
        finite_set_size(\chap9::orbit<G, X, act>(x)) > 1
        =>:
            $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(x)))
    \chap9::orbit<G, X, act>(x) $subset X
    release thm subset_of_finite_set_is_finite(\chap9::orbit<G, X, act>(x), X)
    $is_finite_set(\chap9::orbit<G, X, act>(x))
    release thm chap9::group_action_mem_orbit(G, X, group, act, x, group.one)
    act(group.one, x) = x
    x $in \chap9::orbit<G, X, act>(x)
    witness $is_nonempty_set(\chap9::orbit<G, X, act>(x)) from x
    finite_set_size(\chap9::orbit<G, X, act>(x)) >= 1
    have orbit_count N+ = finite_set_size(\chap9::orbit<G, X, act>(x))
    release thm chap9::group_action_stabilizer_closed(G, X, group, act, x)
    $chap9::is_subgroup(G, group, \chap9::stabilizer<G, X, act, group.one>(x))
    \chap9::stabilizer<G, X, act, group.one>(x) $subset G
    release thm subset_of_finite_set_is_finite(\chap9::stabilizer<G, X, act, group.one>(x), G)
    $is_finite_set(\chap9::stabilizer<G, X, act, group.one>(x))
    group.one $in \chap9::stabilizer<G, X, act, group.one>(x)
    witness $is_nonempty_set(\chap9::stabilizer<G, X, act, group.one>(x)) from group.one
    finite_set_size(\chap9::stabilizer<G, X, act, group.one>(x)) >= 1
    have stabilizer_count N+ = finite_set_size(\chap9::stabilizer<G, X, act, group.one>(x))
    release thm chap9::orbit_stabilizer_forward_bijective(G, X, group, act, x)
    $is_finite_set(cart(\chap9::orbit<G, X, act>(x), \chap9::stabilizer<G, X, act, group.one>(x)))
    finite_set_size(G) = finite_set_size(cart(\chap9::orbit<G, X, act>(x), \chap9::stabilizer<G, X, act, group.one>(x)))
    finite_set_size(cart(\chap9::orbit<G, X, act>(x), \chap9::stabilizer<G, X, act, group.one>(x))) = finite_set_size(\chap9::orbit<G, X, act>(x)) * finite_set_size(\chap9::stabilizer<G, X, act, group.one>(x))
    finite_set_size(G) = finite_set_size(\chap9::orbit<G, X, act>(x)) * finite_set_size(\chap9::stabilizer<G, X, act, group.one>(x))
    release thm chap9::object_substitution(N, N, fn(t N) N {t * stabilizer_count}, orbit_count, finite_set_size(\chap9::orbit<G, X, act>(x)))
    orbit_count * stabilizer_count = finite_set_size(\chap9::orbit<G, X, act>(x)) * stabilizer_count
    release thm chap9::object_substitution(N, N, fn(t N) N {finite_set_size(\chap9::orbit<G, X, act>(x)) * t}, stabilizer_count, finite_set_size(\chap9::stabilizer<G, X, act, group.one>(x)))
    finite_set_size(\chap9::orbit<G, X, act>(x)) * stabilizer_count = finite_set_size(\chap9::orbit<G, X, act>(x)) * finite_set_size(\chap9::stabilizer<G, X, act, group.one>(x))
    orbit_count * stabilizer_count = finite_set_size(G) = p^n
    orbit_count > 1
    release thm prime_divides_nontrivial_factor_of_prime_power(p, n, orbit_count, stabilizer_count)
    $chap2::divides(p, orbit_count)
    orbit_count = finite_set_size(\chap9::orbit<G, X, act>(x))
    $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(x)))

# Fixed points and invariant subsets for a finite p-group action.
prop action_fixed_point(G nonempty_set, X set, act fn(g G, x X) X, x X):
    forall g G:
        act(g, x) = x

template<G nonempty_set, X set, act fn(g G, x X) X>:
    have action_fixed_points power_set(X) = {x X: $action_fixed_point(G, X, act, x)}

prop action_invariant_subset(G nonempty_set, X set, act fn(g G, x X) X, S power_set(X)):
    forall g G, x X:
        x $in S
        =>:
            act(g, x) $in S

thm action_point_mem_orbit:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $chap9::is_group_action(G, X, group, act)
        =>:
            x $in \chap9::orbit<G, X, act>(x)
    release thm chap9::group_action_mem_orbit(G, X, group, act, x, group.one)
    act(group.one, x) = x
    x $in \chap9::orbit<G, X, act>(x)

thm action_orbit_invariant:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $chap9::is_group_action(G, X, group, act)
        =>:
            $action_invariant_subset(G, X, act, \chap9::orbit<G, X, act>(x))
    claim:
        ? forall g G, y X:
            y $in \chap9::orbit<G, X, act>(x)
            =>:
                act(g, y) $in \chap9::orbit<G, X, act>(x)
        by def:
            ? $chap9::orbit_member(G, X, act, x, y)
        obtain h from $chap9::orbit_member(G, X, act, x, y)
        y = act(h, x)
        release thm chap9::group_action_associativity(G, X, group, act, g, h, x)
        act(g, y) = act(g, act(h, x)) = act(group.mul(g, h), x)
        release thm chap9::group_action_mem_orbit(G, X, group, act, x, group.mul(g, h))
        act(group.mul(g, h), x) $in \chap9::orbit<G, X, act>(x)
    by def:
        ? $action_invariant_subset(G, X, act, \chap9::orbit<G, X, act>(x))

thm action_invariant_set_minus:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, S, T power_set(X):
        $chap9::is_group_action(G, X, group, act)
        $action_invariant_subset(G, X, act, S)
        $action_invariant_subset(G, X, act, T)
        =>:
            $action_invariant_subset(G, X, act, set_minus(S, T))
    claim:
        ? forall g G, x X:
            x $in set_minus(S, T)
            =>:
                act(g, x) $in set_minus(S, T)
        x $in S
        not x $in T
        act(g, x) $in S
        by cases:
            ? act(g, x) $in set_minus(S, T)
            case act(g, x) $in T:
                act(group.inv(g), act(g, x)) $in T
                release thm chap9::group_action_associativity(G, X, group, act, group.inv(g), g, x)
                by def:
                    ? $chap2::group_laws(G, group.mul, group.one, group.inv)
                group.mul(group.inv(g), g) = group.one
                act(group.inv(g), act(g, x)) = act(group.mul(group.inv(g), g), x) = act(group.one, x) = x
                x $in T
                impossible x $in T
            case not act(g, x) $in T:
                act(g, x) $in set_minus(S, T)
    by def:
        ? $action_invariant_subset(G, X, act, set_minus(S, T))

thm nonfixed_point_orbit_has_size_greater_than_one:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $chap9::is_group_action(G, X, group, act)
        not $action_fixed_point(G, X, act, x)
        $is_finite_set(\chap9::orbit<G, X, act>(x))
        =>:
            finite_set_size(\chap9::orbit<G, X, act>(x)) > 1
    by contra:
        ? finite_set_size(\chap9::orbit<G, X, act>(x)) > 1
        finite_set_size(\chap9::orbit<G, X, act>(x)) <= 1
        claim:
            ? forall g G:
                act(g, x) = x
            by contra:
                ? act(g, x) = x
                release thm action_point_mem_orbit(G, X, group, act, x)
                release thm chap9::group_action_mem_orbit(G, X, group, act, x, g)
                x $in \chap9::orbit<G, X, act>(x)
                act(g, x) $in \chap9::orbit<G, X, act>(x)
                claim:
                    ? {x, act(g, x)} $subset \chap9::orbit<G, X, act>(x)
                    claim:
                        ? forall y {x, act(g, x)}:
                            y $in \chap9::orbit<G, X, act>(x)
                        by cases:
                            ? y $in \chap9::orbit<G, X, act>(x)
                            case y = x:
                                x $in \chap9::orbit<G, X, act>(x)
                            case y = act(g, x):
                                act(g, x) $in \chap9::orbit<G, X, act>(x)
                    by def:
                        ? {x, act(g, x)} $subset \chap9::orbit<G, X, act>(x)
                finite_set_size({x, act(g, x)}) = 2
                finite_set_size({x, act(g, x)}) <= finite_set_size(\chap9::orbit<G, X, act>(x)) <= 1
                impossible 2 <= 1
        by def:
            ? $action_fixed_point(G, X, act, x)
        impossible $action_fixed_point(G, X, act, x)

thm nonfixed_orbit_has_no_fixed_points:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $chap9::is_group_action(G, X, group, act)
        not $action_fixed_point(G, X, act, x)
        =>:
            intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>) = {}
    claim:
        ? forall y X:
            y $in intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)
            =>:
                y $in {}
        y $in \chap9::orbit<G, X, act>(x)
        y $in \action_fixed_points<G, X, act>
        by def:
            ? $chap9::orbit_member(G, X, act, x, y)
        obtain h from $chap9::orbit_member(G, X, act, x, y)
        y = act(h, x)
        $action_fixed_point(G, X, act, y)
        act(group.inv(h), y) = y
        release thm chap9::group_action_associativity(G, X, group, act, group.inv(h), h, x)
        by def:
            ? $chap2::group_laws(G, group.mul, group.one, group.inv)
        group.mul(group.inv(h), h) = group.one
        act(group.inv(h), y) = act(group.inv(h), act(h, x)) = act(group.mul(group.inv(h), h), x) = act(group.one, x) = x
        x = y
        claim:
            ? forall g G:
                act(g, x) = x
            act(g, x) = act(g, y) = y = x
        by def:
            ? $action_fixed_point(G, X, act, x)
        by contra:
            ? y $in {}
            impossible $action_fixed_point(G, X, act, x)
    by def:
        ? intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>) $subset {}
    by def:
        ? {} $subset intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)
    by extension:
        ? intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>) = {}

thm fixed_point_orbit_is_fixed:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, x X:
        $chap9::is_group_action(G, X, group, act)
        $action_fixed_point(G, X, act, x)
        =>:
            \chap9::orbit<G, X, act>(x) $subset \action_fixed_points<G, X, act>
    claim:
        ? forall y X:
            y $in \chap9::orbit<G, X, act>(x)
            =>:
                y $in \action_fixed_points<G, X, act>
        by def:
            ? $chap9::orbit_member(G, X, act, x, y)
        obtain h from $chap9::orbit_member(G, X, act, x, y)
        y = act(h, x) = x
        $action_fixed_point(G, X, act, x)
        $action_fixed_point(G, X, act, y)
        release thm set_builder_member(y, {q X: $action_fixed_point(G, X, act, q)})
        y $in {q X: $action_fixed_point(G, X, act, q)} = \action_fixed_points<G, X, act>
    by def:
        ? \chap9::orbit<G, X, act>(x) $subset \action_fixed_points<G, X, act>

thm orbit_fixed_point_defect_divisible:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n N, x X:
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        $is_finite_set(\chap9::orbit<G, X, act>(x))
        $is_finite_set(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>))
        =>:
            $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(x)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)))
    by cases:
        ? $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(x)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)))
        case $action_fixed_point(G, X, act, x):
            release thm fixed_point_orbit_is_fixed(G, X, group, act, x)
            claim:
                ? intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>) = \chap9::orbit<G, X, act>(x)
                claim:
                    ? forall y X:
                        y $in intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)
                        =>:
                            y $in \chap9::orbit<G, X, act>(x)
                claim:
                    ? forall y X:
                        y $in \chap9::orbit<G, X, act>(x)
                        =>:
                            y $in intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)
                    y $in \action_fixed_points<G, X, act>
                by extension:
                    ? intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>) = \chap9::orbit<G, X, act>(x)
            finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)) = finite_set_size(\chap9::orbit<G, X, act>(x))
            finite_set_size(\chap9::orbit<G, X, act>(x)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)) = 0
            witness $chap2::divides(p, 0) from 0
        case not $action_fixed_point(G, X, act, x):
            release thm nonfixed_orbit_has_no_fixed_points(G, X, group, act, x)
            finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)) = finite_set_size({}) = 0
            release thm nonfixed_point_orbit_has_size_greater_than_one(G, X, group, act, x)
            release thm nontrivial_orbit_size_divisible_by_prime(G, X, group, act, p, n, x)
            obtain quotient from $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(x)))
            witness $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(x)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>))) from quotient:
                finite_set_size(\chap9::orbit<G, X, act>(x)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(x), \action_fixed_points<G, X, act>)) = finite_set_size(\chap9::orbit<G, X, act>(x)) - 0 = finite_set_size(\chap9::orbit<G, X, act>(x)) = p * quotient

thm natural_sum_subtraction_split:
    ? forall whole, left, right, whole_fixed, left_fixed, right_fixed N:
        whole = left + right
        whole_fixed = left_fixed + right_fixed
        =>:
            whole - whole_fixed = (left - left_fixed) + (right - right_fixed)
    whole - whole_fixed = (left + right) - (left_fixed + right_fixed)
    (left + right) - (left_fixed + right_fixed) = (left - left_fixed) + (right - right_fixed)

thm finite_subset_defect_split:
    ? forall X set, S, T, F power_set(X):
        $is_finite_set(S)
        $is_finite_set(T)
        T $subset S
        $is_finite_set(intersect(S, F))
        $is_finite_set(set_minus(S, T))
        $is_finite_set(intersect(set_minus(S, T), F))
        $is_finite_set(intersect(T, F))
        =>:
            finite_set_size(S) - finite_set_size(intersect(S, F)) = (finite_set_size(set_minus(S, T)) - finite_set_size(intersect(set_minus(S, T), F))) + (finite_set_size(T) - finite_set_size(intersect(T, F)))
    intersect(S, T) = T
    finite_set_size(T) <= finite_set_size(S)
    finite_set_size(set_minus(S, T)) = finite_set_size(S) - finite_set_size(intersect(S, T)) = finite_set_size(S) - finite_set_size(T)
    finite_set_size(set_minus(S, T)) + finite_set_size(T) = (finite_set_size(S) - finite_set_size(T)) + finite_set_size(T) = finite_set_size(S)
    finite_set_size(S) = finite_set_size(set_minus(S, T)) + finite_set_size(T)
    claim:
        ? intersect(S, F) = union(intersect(set_minus(S, T), F), intersect(T, F))
        claim:
            ? forall x intersect(S, F):
                x $in union(intersect(set_minus(S, T), F), intersect(T, F))
            by cases:
                ? x $in union(intersect(set_minus(S, T), F), intersect(T, F))
                case x $in T:
                    x $in intersect(T, F)
                case not x $in T:
                    x $in set_minus(S, T)
                    x $in intersect(set_minus(S, T), F)
        claim:
            ? forall x union(intersect(set_minus(S, T), F), intersect(T, F)):
                x $in intersect(S, F)
            by cases:
                ? x $in intersect(S, F)
                case x $in intersect(set_minus(S, T), F):
                    x $in set_minus(S, T)
                    x $in S
                case x $in intersect(T, F):
                    x $in T
                    x $in S
        by extension:
            ? intersect(S, F) = union(intersect(set_minus(S, T), F), intersect(T, F))
    claim:
        ? intersect(intersect(set_minus(S, T), F), intersect(T, F)) = {}
        claim:
            ? forall x intersect(intersect(set_minus(S, T), F), intersect(T, F)):
                x $in {}
            x $in set_minus(S, T)
            not x $in T
            x $in T
            by contra:
                ? x $in {}
                impossible x $in T
        claim:
            ? forall x {}:
                x $in intersect(intersect(set_minus(S, T), F), intersect(T, F))
            by contra:
                ? x $in intersect(intersect(set_minus(S, T), F), intersect(T, F))
                impossible x $in {}
        by extension:
            ? intersect(intersect(set_minus(S, T), F), intersect(T, F)) = {}
    finite_set_size(intersect(S, F)) = finite_set_size(union(intersect(set_minus(S, T), F), intersect(T, F)))
    finite_set_size(union(intersect(set_minus(S, T), F), intersect(T, F))) = finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F)) - finite_set_size(intersect(intersect(set_minus(S, T), F), intersect(T, F)))
    finite_set_size(intersect(intersect(set_minus(S, T), F), intersect(T, F))) = finite_set_size({}) = 0
    release thm chap9::object_substitution(N, Z, fn(t N) Z {finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F)) - t}, finite_set_size(intersect(intersect(set_minus(S, T), F), intersect(T, F))), 0)
    finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F)) - finite_set_size(intersect(intersect(set_minus(S, T), F), intersect(T, F))) = finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F)) - 0
    finite_set_size(union(intersect(set_minus(S, T), F), intersect(T, F))) = finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F)) - finite_set_size(intersect(intersect(set_minus(S, T), F), intersect(T, F))) = finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F)) - 0 = finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F))
    finite_set_size(intersect(S, F)) = finite_set_size(union(intersect(set_minus(S, T), F), intersect(T, F))) = finite_set_size(intersect(set_minus(S, T), F)) + finite_set_size(intersect(T, F))
    release thm natural_sum_subtraction_split(finite_set_size(S), finite_set_size(set_minus(S, T)), finite_set_size(T), finite_set_size(intersect(S, F)), finite_set_size(intersect(set_minus(S, T), F)), finite_set_size(intersect(T, F)))

thm finite_intersection_size_zero_of_base_size_zero:
    ? forall X set, S, F power_set(X):
        $is_finite_set(S)
        $is_finite_set(intersect(S, F))
        finite_set_size(S) = 0
        =>:
            finite_set_size(intersect(S, F)) = 0
    intersect(S, F) $subset S
    finite_set_size(intersect(S, F)) <= finite_set_size(S) = 0
    finite_set_size(intersect(S, F)) >= 0

thm finite_set_nonempty_of_positive_size:
    ? forall X finite_set:
        finite_set_size(X) > 0
        =>:
            $is_nonempty_set(X)
    by contra:
        ? $is_nonempty_set(X)
        X = {}
        finite_set_size(X) = finite_set_size({}) = 0
        impossible finite_set_size(X) > 0

thm finite_set_minus_nonempty_subset_has_smaller_size:
    ? forall X finite_set, S, T power_set(X):
        $is_finite_set(S)
        $is_finite_set(T)
        $is_nonempty_set(T)
        T $subset S
        =>:
            finite_set_size(set_minus(S, T)) < finite_set_size(S)
    claim:
        ? intersect(S, T) = T
        claim:
            ? forall x X:
                x $in intersect(S, T)
                =>:
                    x $in T
        claim:
            ? forall x X:
                x $in T
                =>:
                    x $in intersect(S, T)
            x $in S
        by extension:
            ? intersect(S, T) = T
    $is_finite_set(intersect(S, T))
    $is_finite_set(set_minus(S, T))
    finite_set_size(T) >= 1
    finite_set_size(T) <= finite_set_size(S)
    finite_set_size(S) >= finite_set_size(T) >= 1
    finite_set_size(set_minus(S, T)) = finite_set_size(S) - finite_set_size(intersect(S, T)) = finite_set_size(S) - finite_set_size(T)
    finite_set_size(S) - finite_set_size(T) <= finite_set_size(S) - 1 < finite_set_size(S)
    finite_set_size(set_minus(S, T)) < finite_set_size(S)

thm integer_divisibility_add:
    ? forall divisor, left, right Z:
        $chap2::divides(divisor, left)
        $chap2::divides(divisor, right)
        =>:
            $chap2::divides(divisor, left + right)
    obtain left_quotient from $chap2::divides(divisor, left)
    obtain right_quotient from $chap2::divides(divisor, right)
    witness $chap2::divides(divisor, left + right) from left_quotient + right_quotient:
        left + right = divisor * left_quotient + divisor * right_quotient = divisor * (left_quotient + right_quotient)

thm integer_divisibility_substitution:
    ? forall divisor, left, right Z:
        left = right
        $chap2::divides(divisor, left)
        =>:
            $chap2::divides(divisor, right)
    obtain quotient from $chap2::divides(divisor, left)
    witness $chap2::divides(divisor, right) from quotient:
        right = left = divisor * quotient

thm integer_divisibility_sum_substitution:
    ? forall divisor, left, right, total Z:
        $chap2::divides(divisor, left)
        $chap2::divides(divisor, right)
        total = left + right
        =>:
            $chap2::divides(divisor, total)
    release thm integer_divisibility_add(divisor, left, right)
    release thm integer_divisibility_substitution(divisor, left + right, total)

prop invariant_subset_fixed_point_defect_divisible_at_size(G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, size_bound N):
    forall S power_set(X):
        $is_finite_set(S)
        $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
        finite_set_size(S) = size_bound
        $action_invariant_subset(G, X, act, S)
        =>:
            $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))

thm invariant_subset_fixed_point_defect_divisible_base:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n N:
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        =>:
            $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, 0)
    claim:
        ? forall S power_set(X):
            $is_finite_set(S)
            $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
            finite_set_size(S) = 0
            $action_invariant_subset(G, X, act, S)
            =>:
                $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
        release thm finite_intersection_size_zero_of_base_size_zero(X, S, \action_fixed_points<G, X, act>)
        finite_set_size(intersect(S, \action_fixed_points<G, X, act>)) = 0
        finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)) = 0
        witness $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>))) from 0
    by def:
        ? $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, 0)

thm orbit_subset_of_invariant_subset:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, S power_set(X), x X:
        $chap9::is_group_action(G, X, group, act)
        $action_invariant_subset(G, X, act, S)
        x $in S
        =>:
            \chap9::orbit<G, X, act>(x) $subset S
    claim:
        ? forall y X:
            y $in \chap9::orbit<G, X, act>(x)
            =>:
                y $in S
        \chap9::orbit<G, X, act>(x) = {candidate X: $chap9::orbit_member(G, X, act, x, candidate)}
        y $in {candidate X: $chap9::orbit_member(G, X, act, x, candidate)}
        by def:
            ? $chap9::orbit_member(G, X, act, x, y)
        obtain h from $chap9::orbit_member(G, X, act, x, y)
        act(h, x) $in S
        have selected S = act(h, x)
        selected = act(h, x) = y
        y $in S
    by def:
        ? \chap9::orbit<G, X, act>(x) $subset S

thm finite_intersection_of_subset_from_finite_intersection:
    ? forall X set, S, T, F power_set(X):
        T $subset S
        $is_finite_set(intersect(S, F))
        =>:
            $is_finite_set(intersect(T, F))
    claim:
        ? intersect(T, F) $subset intersect(S, F)
        claim:
            ? forall x X:
                x $in intersect(T, F)
                =>:
                    x $in intersect(S, F)
            x $in T
            x $in S
            x $in F
        by def:
            ? intersect(T, F) $subset intersect(S, F)
    release thm subset_of_finite_set_is_finite(intersect(T, F), intersect(S, F))

thm finite_intersection_from_finite_left:
    ? forall X set, T, F power_set(X):
        $is_finite_set(T)
        =>:
            $is_finite_set(intersect(T, F))
    claim:
        ? intersect(T, F) $subset T
    release thm subset_of_finite_set_is_finite(intersect(T, F), T)

thm finite_subset_defect_divisibility_split:
    ? forall X set, S, T, F power_set(X), p N+:
        $is_finite_set(S)
        $is_finite_set(T)
        T $subset S
        $is_finite_set(intersect(S, F))
        $is_finite_set(set_minus(S, T))
        $is_finite_set(intersect(set_minus(S, T), F))
        $is_finite_set(intersect(T, F))
        $chap2::divides(p, finite_set_size(set_minus(S, T)) - finite_set_size(intersect(set_minus(S, T), F)))
        $chap2::divides(p, finite_set_size(T) - finite_set_size(intersect(T, F)))
        =>:
            $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, F)))
    release thm finite_subset_defect_split(X, S, T, F)
    have left_defect Z = finite_set_size(set_minus(S, T)) - finite_set_size(intersect(set_minus(S, T), F))
    have right_defect Z = finite_set_size(T) - finite_set_size(intersect(T, F))
    have total_defect Z = finite_set_size(S) - finite_set_size(intersect(S, F))
    obtain left_quotient from $chap2::divides(p, finite_set_size(set_minus(S, T)) - finite_set_size(intersect(set_minus(S, T), F)))
    obtain right_quotient from $chap2::divides(p, finite_set_size(T) - finite_set_size(intersect(T, F)))
    witness $chap2::divides(p, left_defect) from left_quotient:
        left_defect = finite_set_size(set_minus(S, T)) - finite_set_size(intersect(set_minus(S, T), F)) = p * left_quotient
    witness $chap2::divides(p, right_defect) from right_quotient:
        right_defect = finite_set_size(T) - finite_set_size(intersect(T, F)) = p * right_quotient
    total_defect = finite_set_size(S) - finite_set_size(intersect(S, F)) = (finite_set_size(set_minus(S, T)) - finite_set_size(intersect(set_minus(S, T), F))) + (finite_set_size(T) - finite_set_size(intersect(T, F))) = left_defect + right_defect
    release thm integer_divisibility_sum_substitution(p, left_defect, right_defect, total_defect)
    obtain total_quotient from $chap2::divides(p, total_defect)
    witness $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, F))) from total_quotient:
        finite_set_size(S) - finite_set_size(intersect(S, F)) = total_defect = p * total_quotient

thm invariant_subset_smaller_defect_from_induction_hypothesis:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, size_bound N, T power_set(X):
        forall smaller_size N:
            smaller_size <= size_bound
            =>:
                $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, smaller_size)
        $is_finite_set(T)
        $is_finite_set(intersect(T, \action_fixed_points<G, X, act>))
        finite_set_size(T) <= size_bound
        $action_invariant_subset(G, X, act, T)
        =>:
            $chap2::divides(p, finite_set_size(T) - finite_set_size(intersect(T, \action_fixed_points<G, X, act>)))
    $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, finite_set_size(T))
    $chap2::divides(p, finite_set_size(T) - finite_set_size(intersect(T, \action_fixed_points<G, X, act>)))

thm orbit_remainder_is_invariant:
    ? forall G nonempty_set, X set, group &chap2::Group<G>, act fn(g G, x X) X, S power_set(X), selected_point X:
        $chap9::is_group_action(G, X, group, act)
        $action_invariant_subset(G, X, act, S)
        =>:
            $action_invariant_subset(G, X, act, set_minus(S, \chap9::orbit<G, X, act>(selected_point)))
    release thm action_orbit_invariant(G, X, group, act, selected_point)
    release thm action_invariant_set_minus(G, X, group, act, S, \chap9::orbit<G, X, act>(selected_point))

thm orbit_remainder_defects_combine:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, S power_set(X), selected_point X:
        $is_finite_set(S)
        $is_finite_set(\chap9::orbit<G, X, act>(selected_point))
        \chap9::orbit<G, X, act>(selected_point) $subset S
        $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
        $is_finite_set(set_minus(S, \chap9::orbit<G, X, act>(selected_point)))
        $is_finite_set(intersect(set_minus(S, \chap9::orbit<G, X, act>(selected_point)), \action_fixed_points<G, X, act>))
        $is_finite_set(intersect(\chap9::orbit<G, X, act>(selected_point), \action_fixed_points<G, X, act>))
        $chap2::divides(p, finite_set_size(set_minus(S, \chap9::orbit<G, X, act>(selected_point))) - finite_set_size(intersect(set_minus(S, \chap9::orbit<G, X, act>(selected_point)), \action_fixed_points<G, X, act>)))
        $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(selected_point)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(selected_point), \action_fixed_points<G, X, act>)))
        =>:
            $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
    release thm finite_subset_defect_divisibility_split(X, S, \chap9::orbit<G, X, act>(selected_point), \action_fixed_points<G, X, act>, p)

thm invariant_subset_fixed_point_defect_divisible_from_selected_point:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n, size_bound N, S power_set(X), selected_point S:
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        forall smaller_size N:
            smaller_size <= size_bound
            =>:
                $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, smaller_size)
        $is_finite_set(S)
        $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
        finite_set_size(S) = size_bound + 1
        $action_invariant_subset(G, X, act, S)
        =>:
            $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
    release thm action_point_mem_orbit(G, X, group, act, selected_point)
    selected_point $in \chap9::orbit<G, X, act>(selected_point)
    witness $is_nonempty_set(\chap9::orbit<G, X, act>(selected_point)) from selected_point
    release thm orbit_subset_of_invariant_subset(G, X, group, act, S, selected_point)
    \chap9::orbit<G, X, act>(selected_point) $subset S
    release thm subset_of_finite_set_is_finite(\chap9::orbit<G, X, act>(selected_point), S)
    $is_finite_set(\chap9::orbit<G, X, act>(selected_point))
    release thm finite_intersection_from_finite_left(X, \chap9::orbit<G, X, act>(selected_point), \action_fixed_points<G, X, act>)
    $is_finite_set(intersect(\chap9::orbit<G, X, act>(selected_point), \action_fixed_points<G, X, act>))
    release thm orbit_remainder_is_invariant(G, X, group, act, S, selected_point)
    $action_invariant_subset(G, X, act, set_minus(S, \chap9::orbit<G, X, act>(selected_point)))
    $is_finite_set(set_minus(S, \chap9::orbit<G, X, act>(selected_point)))
    release thm finite_intersection_from_finite_left(X, set_minus(S, \chap9::orbit<G, X, act>(selected_point)), \action_fixed_points<G, X, act>)
    $is_finite_set(intersect(set_minus(S, \chap9::orbit<G, X, act>(selected_point)), \action_fixed_points<G, X, act>))
    release thm finite_set_minus_nonempty_subset_has_smaller_size(X, S, \chap9::orbit<G, X, act>(selected_point))
    finite_set_size(set_minus(S, \chap9::orbit<G, X, act>(selected_point))) < finite_set_size(S) = size_bound + 1
    finite_set_size(set_minus(S, \chap9::orbit<G, X, act>(selected_point))) <= size_bound
    release thm invariant_subset_smaller_defect_from_induction_hypothesis(G, X, group, act, p, size_bound, set_minus(S, \chap9::orbit<G, X, act>(selected_point)))
    $chap2::divides(p, finite_set_size(set_minus(S, \chap9::orbit<G, X, act>(selected_point))) - finite_set_size(intersect(set_minus(S, \chap9::orbit<G, X, act>(selected_point)), \action_fixed_points<G, X, act>)))
    release thm orbit_fixed_point_defect_divisible(G, X, group, act, p, n, selected_point)
    $chap2::divides(p, finite_set_size(\chap9::orbit<G, X, act>(selected_point)) - finite_set_size(intersect(\chap9::orbit<G, X, act>(selected_point), \action_fixed_points<G, X, act>)))
    release thm orbit_remainder_defects_combine(G, X, group, act, p, S, selected_point)

thm invariant_subset_fixed_point_defect_divisible_choose_point:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n, size_bound N, S power_set(X):
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        forall smaller_size N:
            smaller_size <= size_bound
            =>:
                $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, smaller_size)
        $is_finite_set(S)
        $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
        finite_set_size(S) = size_bound + 1
        $action_invariant_subset(G, X, act, S)
        $is_nonempty_set(S)
        =>:
            $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
    have selected_point S
    release thm invariant_subset_fixed_point_defect_divisible_from_selected_point(G, X, group, act, p, n, size_bound, S, selected_point)

thm invariant_subset_fixed_point_defect_divisible_step:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n, size_bound N:
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        forall smaller_size N:
            smaller_size <= size_bound
            =>:
                $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, smaller_size)
        =>:
            $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, size_bound + 1)
    claim:
        ? forall S power_set(X):
            $is_finite_set(S)
            $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
            finite_set_size(S) = size_bound + 1
            $action_invariant_subset(G, X, act, S)
            =>:
                $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
        finite_set_size(S) = size_bound + 1 > 0
        release thm finite_set_nonempty_of_positive_size(S)
        $is_nonempty_set(S)
        release thm invariant_subset_fixed_point_defect_divisible_choose_point(G, X, group, act, p, n, size_bound, S)
        $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
    by def:
        ? $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, size_bound + 1)

thm finite_p_group_invariant_subset_fixed_point_defect_divisible:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n N, S power_set(X):
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        $is_finite_set(S)
        $is_finite_set(intersect(S, \action_fixed_points<G, X, act>))
        $action_invariant_subset(G, X, act, S)
        =>:
            $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))
    claim:
        ? forall size_bound N:
            $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, size_bound)
        by strong_induc size_bound from 0:
            ? $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, size_bound)
            ? from size_bound = 0:
                release thm invariant_subset_fixed_point_defect_divisible_base(G, X, group, act, p, n)
                $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, 0)
            ? strong_induc:
                forall smaller_size N:
                    smaller_size >= 0
                    smaller_size <= size_bound
                    =>:
                        $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, smaller_size)
                claim:
                    ? forall earlier_size N:
                        earlier_size <= size_bound
                        =>:
                            $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, earlier_size)
                    earlier_size >= 0
                    $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, earlier_size)
                release thm invariant_subset_fixed_point_defect_divisible_step(G, X, group, act, p, n, size_bound)
                $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, size_bound + 1)
    $invariant_subset_fixed_point_defect_divisible_at_size(G, X, group, act, p, finite_set_size(S))
    $chap2::divides(p, finite_set_size(S) - finite_set_size(intersect(S, \action_fixed_points<G, X, act>)))

thm action_fixed_points_are_finite:
    ? forall G nonempty_set, X finite_set, act fn(g G, x X) X:
        $is_finite_set(\action_fixed_points<G, X, act>)
    claim:
        ? \action_fixed_points<G, X, act> $subset X
    release thm subset_of_finite_set_is_finite(\action_fixed_points<G, X, act>, X)

thm whole_action_carrier_is_invariant:
    ? forall G nonempty_set, X set, act fn(g G, x X) X:
        $action_invariant_subset(G, X, act, X)
    claim:
        ? forall g G, y X:
            y $in X
            =>:
                act(g, y) $in X
    by def:
        ? $action_invariant_subset(G, X, act, X)

thm finite_p_group_fixed_point_congruence:
    ? forall G nonempty_set, X finite_set, group &chap2::Group<G>, act fn(g G, x X) X, p N+, n N:
        $is_finite_set(G)
        $chap9::is_group_action(G, X, group, act)
        $prime(p)
        finite_set_size(G) = p^n
        $is_finite_set(\action_fixed_points<G, X, act>)
        =>:
            $chap2::divides(p, finite_set_size(X) - finite_set_size(\action_fixed_points<G, X, act>))
    release thm finite_intersection_from_finite_left(X, X, \action_fixed_points<G, X, act>)
    $is_finite_set(intersect(X, \action_fixed_points<G, X, act>))
    release thm whole_action_carrier_is_invariant(G, X, act)
    release thm finite_p_group_invariant_subset_fixed_point_defect_divisible(G, X, group, act, p, n, X)
    $chap2::divides(p, finite_set_size(X) - finite_set_size(intersect(X, \action_fixed_points<G, X, act>)))
    claim:
        ? intersect(X, \action_fixed_points<G, X, act>) = \action_fixed_points<G, X, act>
        claim:
            ? forall x X:
                x $in intersect(X, \action_fixed_points<G, X, act>)
                =>:
                    x $in \action_fixed_points<G, X, act>
        claim:
            ? forall x X:
                x $in \action_fixed_points<G, X, act>
                =>:
                    x $in intersect(X, \action_fixed_points<G, X, act>)
        by extension:
            ? intersect(X, \action_fixed_points<G, X, act>) = \action_fixed_points<G, X, act>
    finite_set_size(intersect(X, \action_fixed_points<G, X, act>)) = finite_set_size(\action_fixed_points<G, X, act>)
    obtain quotient from $chap2::divides(p, finite_set_size(X) - finite_set_size(intersect(X, \action_fixed_points<G, X, act>)))
    witness $chap2::divides(p, finite_set_size(X) - finite_set_size(\action_fixed_points<G, X, act>)) from quotient:
        finite_set_size(X) - finite_set_size(\action_fixed_points<G, X, act>) = finite_set_size(X) - finite_set_size(intersect(X, \action_fixed_points<G, X, act>)) = p * quotient


# Checked concrete cyclic group of prime order for the Cauchy counting action.

template<p N+>:
    have cyclic_indices nonempty_set = closed_range(0, p - 1)

prop is_cyclic_add_value(p N+, a, b, value Z):
    value = (a + b) % p

template<p N+>:
    have fn cyclic_add by exist!:
        ? forall a, b \cyclic_indices<p>:
            exist! value \cyclic_indices<p> st {$is_cyclic_add_value(p, a, b, value)}
        (a + b) % p >= 0
        abs((a + b) % p) = (a + b) % p
        have remainder N = abs((a + b) % p)
        remainder = (a + b) % p
        (a + b) % p < p
        remainder < p
        remainder <= p - 1
        remainder $in closed_range(0, p - 1) = \cyclic_indices<p>
        witness exist value \cyclic_indices<p> st {$is_cyclic_add_value(p, a, b, value)} from remainder:
            by def:
                ? $is_cyclic_add_value(p, a, b, remainder)
        claim:
            ? forall value1, value2 \cyclic_indices<p>:
                $is_cyclic_add_value(p, a, b, value1)
                $is_cyclic_add_value(p, a, b, value2)
                =>:
                    value1 = value2
            by def $is_cyclic_add_value(p, a, b, value1)
            by def $is_cyclic_add_value(p, a, b, value2)

prop is_cyclic_zero_value(value Z):
    value = 0

template<p N+>:
    have fn cyclic_zero_selector by exist!:
        ? forall dummy {0}:
            exist! value \cyclic_indices<p> st {$is_cyclic_zero_value(value)}
        p >= 1
        0 <= p - 1
        0 $in closed_range(0, p - 1) = \cyclic_indices<p>
        witness exist value \cyclic_indices<p> st {$is_cyclic_zero_value(value)} from 0:
            by def:
                ? $is_cyclic_zero_value(0)
        claim:
            ? forall value1, value2 \cyclic_indices<p>:
                $is_cyclic_zero_value(value1)
                $is_cyclic_zero_value(value2)
                =>:
                    value1 = value2
            by def $is_cyclic_zero_value(value1)
            by def $is_cyclic_zero_value(value2)

template<p N+>:
    have cyclic_zero \cyclic_indices<p> = \cyclic_zero_selector<p>(0)

prop is_cyclic_neg_value(p N+, a, value Z):
    value = (-a) % p

template<p N+>:
    have fn cyclic_neg by exist!:
        ? forall a \cyclic_indices<p>:
            exist! value \cyclic_indices<p> st {$is_cyclic_neg_value(p, a, value)}
        (-a) % p >= 0
        abs((-a) % p) = (-a) % p
        have remainder N = abs((-a) % p)
        remainder = (-a) % p
        (-a) % p < p
        remainder < p
        remainder <= p - 1
        remainder $in closed_range(0, p - 1) = \cyclic_indices<p>
        witness exist value \cyclic_indices<p> st {$is_cyclic_neg_value(p, a, value)} from remainder:
            by def:
                ? $is_cyclic_neg_value(p, a, remainder)
        claim:
            ? forall value1, value2 \cyclic_indices<p>:
                $is_cyclic_neg_value(p, a, value1)
                $is_cyclic_neg_value(p, a, value2)
                =>:
                    value1 = value2
            by def $is_cyclic_neg_value(p, a, value1)
            by def $is_cyclic_neg_value(p, a, value2)

thm cyclic_add_apply:
    ? forall p N+, a, b \cyclic_indices<p>:
        \cyclic_add<p>(a, b) = (a + b) % p
    $is_cyclic_add_value(p, a, b, \cyclic_add<p>(a, b))
    by def:
        ? $is_cyclic_add_value(p, a, b, \cyclic_add<p>(a, b))

thm cyclic_zero_apply:
    ? forall p N+:
        \cyclic_zero<p> = 0
    \cyclic_zero<p> = \cyclic_zero_selector<p>(0)
    $is_cyclic_zero_value(\cyclic_zero_selector<p>(0))
    by def:
        ? $is_cyclic_zero_value(\cyclic_zero_selector<p>(0))

thm cyclic_neg_apply:
    ? forall p N+, a \cyclic_indices<p>:
        \cyclic_neg<p>(a) = (-a) % p
    $is_cyclic_neg_value(p, a, \cyclic_neg<p>(a))
    by def:
        ? $is_cyclic_neg_value(p, a, \cyclic_neg<p>(a))

thm cyclic_index_mod_self:
    ? forall p N+, a \cyclic_indices<p>:
        a % p = a
    \cyclic_indices<p> = closed_range(0, p - 1)
    0 <= a <= p - 1
    abs(a) = a
    have natural_a N = abs(a)
    natural_a = a
    p - 1 < p
    a < p
    a = p * 0 + a
    a % p = a

thm cyclic_prime_group_laws:
    ? forall p N+:
        $chap2::group_laws(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)
    claim:
        ? forall a, b, c \cyclic_indices<p>:
            \cyclic_add<p>(\cyclic_add<p>(a, b), c) = \cyclic_add<p>(a, \cyclic_add<p>(b, c))
        release thm cyclic_index_mod_self(p, a)
        release thm cyclic_index_mod_self(p, b)
        release thm cyclic_index_mod_self(p, c)
        release thm cyclic_add_apply(p, a, b)
        release thm cyclic_add_apply(p, \cyclic_add<p>(a, b), c)
        release thm cyclic_add_apply(p, b, c)
        release thm cyclic_add_apply(p, a, \cyclic_add<p>(b, c))
        \cyclic_add<p>(\cyclic_add<p>(a, b), c) = (\cyclic_add<p>(a, b) + c) % p
        release thm object_substitution(Z, Z, fn(t Z) Z {(t + c) % p}, \cyclic_add<p>(a, b), (a + b) % p)
        (\cyclic_add<p>(a, b) + c) % p = (((a + b) % p) + c) % p
        \cyclic_add<p>(\cyclic_add<p>(a, b), c) = (((a + b) % p) + c) % p = ((((a + b) % p) + (c % p)) % p) = ((a + b) + c) % p
        \cyclic_add<p>(a, \cyclic_add<p>(b, c)) = (a + \cyclic_add<p>(b, c)) % p
        release thm object_substitution(Z, Z, fn(t Z) Z {(a + t) % p}, \cyclic_add<p>(b, c), (b + c) % p)
        (a + \cyclic_add<p>(b, c)) % p = (a + ((b + c) % p)) % p
        \cyclic_add<p>(a, \cyclic_add<p>(b, c)) = (a + ((b + c) % p)) % p = (((a % p) + ((b + c) % p)) % p) = (a + (b + c)) % p
        (a + b) + c = a + (b + c)
        ((a + b) + c) % p = (a + (b + c)) % p
        \cyclic_add<p>(\cyclic_add<p>(a, b), c) = ((a + b) + c) % p = (a + (b + c)) % p = \cyclic_add<p>(a, \cyclic_add<p>(b, c))
    claim:
        ? forall a \cyclic_indices<p>:
            \cyclic_add<p>(\cyclic_zero<p>, a) = a
        release thm cyclic_index_mod_self(p, a)
        release thm cyclic_zero_apply(p)
        release thm cyclic_add_apply(p, \cyclic_zero<p>, a)
        \cyclic_add<p>(\cyclic_zero<p>, a) = (\cyclic_zero<p> + a) % p
        release thm object_substitution(Z, Z, fn(t Z) Z {(t + a) % p}, \cyclic_zero<p>, 0)
        (\cyclic_zero<p> + a) % p = (0 + a) % p
        \cyclic_add<p>(\cyclic_zero<p>, a) = (0 + a) % p = a % p = a
    claim:
        ? forall a \cyclic_indices<p>:
            \cyclic_add<p>(\cyclic_neg<p>(a), a) = \cyclic_zero<p>
        release thm cyclic_index_mod_self(p, a)
        release thm cyclic_neg_apply(p, a)
        release thm cyclic_zero_apply(p)
        release thm cyclic_add_apply(p, \cyclic_neg<p>(a), a)
        \cyclic_add<p>(\cyclic_neg<p>(a), a) = (\cyclic_neg<p>(a) + a) % p
        release thm object_substitution(Z, Z, fn(t Z) Z {(t + a) % p}, \cyclic_neg<p>(a), (-a) % p)
        (\cyclic_neg<p>(a) + a) % p = (((-a) % p) + a) % p
        \cyclic_add<p>(\cyclic_neg<p>(a), a) = (((-a) % p) + a) % p = ((((-a) % p) + (a % p)) % p) = ((-a) + a) % p = 0 % p = 0 = \cyclic_zero<p>
    by def:
        ? $chap2::group_laws(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)

thm cyclic_prime_group_member:
    ? forall p N+:
        (\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>) $in &chap2::Group<\cyclic_indices<p>>
    release thm cyclic_prime_group_laws(p)
    release thm cart_member_from_coordinates((\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>), cart(fn(a, b \cyclic_indices<p>) \cyclic_indices<p>, \cyclic_indices<p>, fn(a \cyclic_indices<p>) \cyclic_indices<p>))
    release thm struct_member((\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>), &chap2::Group<\cyclic_indices<p>>)

template<p N+>:
    have cyclic_prime_group &chap2::Group<\cyclic_indices<p>> = (\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)

thm cyclic_indices_are_finite:
    ? forall p N+:
        $is_finite_set(\cyclic_indices<p>)
    \cyclic_indices<p> = closed_range(0, p - 1)
    $is_finite_set(closed_range(0, p - 1))
    $is_finite_set(\cyclic_indices<p>)

thm cyclic_indices_have_prime_size:
    ? forall p N+:
        $is_finite_set(\cyclic_indices<p>)
        =>:
            finite_set_size(\cyclic_indices<p>) = p
    \cyclic_indices<p> = closed_range(0, p - 1)
    p - 1 >= 0
    abs(p - 1) = p - 1
    have last_index N = abs(p - 1)
    last_index = p - 1
    release thm object_substitution(Z, Z, fn(t Z) Z {t + 1}, last_index, p - 1)
    last_index + 1 = (p - 1) + 1 = p
    finite_set_size(closed_range(0, last_index)) = last_index - 0 + 1 = last_index + 1 = p
    release thm object_substitution(Z, power_set(Z), fn(t Z) power_set(Z) {closed_range(0, t)}, p - 1, last_index)
    closed_range(0, p - 1) = closed_range(0, last_index)
    finite_set_size(\cyclic_indices<p>) = finite_set_size(closed_range(0, p - 1)) = finite_set_size(closed_range(0, last_index)) = p


# Checked Cauchy-theorem infrastructure for the Chapter 9 Sylow proof.
#
# This first slice gives a native ordered product for a tuple indexed by
# 0,...,p-1.  Later slices use it to define the product-one tuple carrier and
# the cyclic rotation action.

prop is_cyclic_tuple_entry_value(p N+, G set, a fn(index \cyclic_indices<p>) G, n N, value G):
    exist index \cyclic_indices<p> st {index = n, value = a(index)}

template<p N+, G set>:
    have fn cyclic_tuple_entry by exist!:
        ? forall a fn(index \cyclic_indices<p>) G, n N:
            n < p
            =>:
                exist! value G st {$is_cyclic_tuple_entry_value(p, G, a, n, value)}
        n <= p - 1
        n $in closed_range(0, p - 1) = \cyclic_indices<p>
        have index \cyclic_indices<p> = n
        witness exist value G st {$is_cyclic_tuple_entry_value(p, G, a, n, value)} from a(index):
            witness $is_cyclic_tuple_entry_value(p, G, a, n, a(index)) from index
        claim:
            ? forall left, right G:
                $is_cyclic_tuple_entry_value(p, G, a, n, left)
                $is_cyclic_tuple_entry_value(p, G, a, n, right)
                =>:
                    left = right
            obtain left_index from exist left_index \cyclic_indices<p> st {left_index = n, left = a(left_index)}
            obtain right_index from exist right_index \cyclic_indices<p> st {right_index = n, right = a(right_index)}
            left_index = n = right_index
            left = a(left_index) = a(right_index) = right

thm cyclic_tuple_entry_apply:
    ? forall p N+, G set, a fn(index \cyclic_indices<p>) G, n N:
        n < p
        =>:
            exist index \cyclic_indices<p> st {index = n, \cyclic_tuple_entry<p, G>(a, n) = a(index)}
    $is_cyclic_tuple_entry_value(p, G, a, n, \cyclic_tuple_entry<p, G>(a, n))
    by def:
        ? $is_cyclic_tuple_entry_value(p, G, a, n, \cyclic_tuple_entry<p, G>(a, n))

template<G nonempty_set, group &chap2::Group<G>, p N+>:
    have fn cyclic_tuple_prefix_product(a fn(index \cyclic_indices<p>) G, n N: n <= p) G by induc n from 0:
        case n = 0: group.one
        case n > 0: group.mul(cyclic_tuple_prefix_product(a, n - 1), \cyclic_tuple_entry<p, G>(a, n - 1))

thm cyclic_tuple_prefix_product_zero:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, a fn(index \cyclic_indices<p>) G:
        \cyclic_tuple_prefix_product<G, group, p>(a, 0) = group.one
    \cyclic_tuple_prefix_product<G, group, p>(a, 0) = group.one

thm cyclic_tuple_prefix_product_succ:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, a fn(index \cyclic_indices<p>) G, n N:
        n < p
        =>:
            \cyclic_tuple_prefix_product<G, group, p>(a, n + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(a, n), \cyclic_tuple_entry<p, G>(a, n))
    n + 1 <= p
    \cyclic_tuple_prefix_product<G, group, p>(a, n + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(a, (n + 1) - 1), \cyclic_tuple_entry<p, G>(a, (n + 1) - 1)) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(a, n), \cyclic_tuple_entry<p, G>(a, n))

template<p N+>:
    have cauchy_prefix_indices set = closed_range(0, p - 2)

prop is_cauchy_new_last_value(p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, index \cyclic_indices<p>, value G):
    index = p - 1
    value = last

prop is_cauchy_old_prefix_value(p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, index \cyclic_indices<p>, value G):
    index != p - 1
    exist prefix_index \cauchy_prefix_indices<p> st {prefix_index = index, value = prefix(prefix_index)}

prop is_cauchy_extension_value(p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, index \cyclic_indices<p>, value G):
    $is_cauchy_new_last_value(p, G, prefix, last, index, value) or $is_cauchy_old_prefix_value(p, G, prefix, last, index, value)

thm cauchy_extension_value_exists_unique:
    ? forall p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, index \cyclic_indices<p>:
        $prime(p)
        =>:
            exist! value G st {$is_cauchy_extension_value(p, G, prefix, last, index, value)}
    p > 1
    by cases:
        ? exist! value G st {$is_cauchy_extension_value(p, G, prefix, last, index, value)}
        case index = p - 1:
            witness exist! value G st {$is_cauchy_extension_value(p, G, prefix, last, index, value)} from last:
                by def:
                    ? $is_cauchy_new_last_value(p, G, prefix, last, index, last)
                claim:
                    ? forall left, right G:
                        $is_cauchy_extension_value(p, G, prefix, last, index, left)
                        $is_cauchy_extension_value(p, G, prefix, last, index, right)
                        =>:
                            left = right
                    claim:
                        ? left = last
                        by def:
                            ? $is_cauchy_extension_value(p, G, prefix, last, index, left)
                        by cases:
                            ? left = last
                            case $is_cauchy_new_last_value(p, G, prefix, last, index, left):
                                by def $is_cauchy_new_last_value(p, G, prefix, last, index, left)
                            case $is_cauchy_old_prefix_value(p, G, prefix, last, index, left):
                                by def $is_cauchy_old_prefix_value(p, G, prefix, last, index, left)
                                impossible index = p - 1
                    claim:
                        ? right = last
                        by def:
                            ? $is_cauchy_extension_value(p, G, prefix, last, index, right)
                        by cases:
                            ? right = last
                            case $is_cauchy_new_last_value(p, G, prefix, last, index, right):
                                by def $is_cauchy_new_last_value(p, G, prefix, last, index, right)
                            case $is_cauchy_old_prefix_value(p, G, prefix, last, index, right):
                                by def $is_cauchy_old_prefix_value(p, G, prefix, last, index, right)
                                impossible index = p - 1
                    left = last = right
        case index != p - 1:
            \cyclic_indices<p> = closed_range(0, p - 1)
            0 <= index <= p - 1
            claim:
                ? index < p - 1
                by contra:
                    ? index < p - 1
                    index >= p - 1
                    index <= p - 1
                    index = p - 1
                    impossible index != p - 1
            index + 1 <= p - 1
            index <= (p - 1) - 1 = p - 2
            index $in closed_range(0, p - 2) = \cauchy_prefix_indices<p>
            have prefix_index \cauchy_prefix_indices<p> = index
            witness exist! value G st {$is_cauchy_extension_value(p, G, prefix, last, index, value)} from prefix(prefix_index):
                claim:
                    ? $is_cauchy_old_prefix_value(p, G, prefix, last, index, prefix(prefix_index))
                    witness exist old_index \cauchy_prefix_indices<p> st {old_index = index, prefix(prefix_index) = prefix(old_index)} from prefix_index
                by def:
                    ? $is_cauchy_extension_value(p, G, prefix, last, index, prefix(prefix_index))
                claim:
                    ? forall left, right G:
                        $is_cauchy_extension_value(p, G, prefix, last, index, left)
                        $is_cauchy_extension_value(p, G, prefix, last, index, right)
                        =>:
                            left = right
                    claim:
                        ? left = prefix(prefix_index)
                        by def:
                            ? $is_cauchy_extension_value(p, G, prefix, last, index, left)
                        by cases:
                            ? left = prefix(prefix_index)
                            case $is_cauchy_new_last_value(p, G, prefix, last, index, left):
                                by def $is_cauchy_new_last_value(p, G, prefix, last, index, left)
                                impossible index != p - 1
                            case $is_cauchy_old_prefix_value(p, G, prefix, last, index, left):
                                by def $is_cauchy_old_prefix_value(p, G, prefix, last, index, left)
                                obtain old_index from exist old_index \cauchy_prefix_indices<p> st {old_index = index, left = prefix(old_index)}
                                old_index = index = prefix_index
                                left = prefix(old_index) = prefix(prefix_index)
                    claim:
                        ? right = prefix(prefix_index)
                        by def:
                            ? $is_cauchy_extension_value(p, G, prefix, last, index, right)
                        by cases:
                            ? right = prefix(prefix_index)
                            case $is_cauchy_new_last_value(p, G, prefix, last, index, right):
                                by def $is_cauchy_new_last_value(p, G, prefix, last, index, right)
                                impossible index != p - 1
                            case $is_cauchy_old_prefix_value(p, G, prefix, last, index, right):
                                by def $is_cauchy_old_prefix_value(p, G, prefix, last, index, right)
                                obtain old_index from exist old_index \cauchy_prefix_indices<p> st {old_index = index, right = prefix(old_index)}
                                old_index = index = prefix_index
                                right = prefix(old_index) = prefix(prefix_index)
                    left = prefix(prefix_index) = right

template<p N+, G set: $prime(p)>:
    have fn cauchy_extension_value_selected by exist!:
        ? forall prefix fn(index \cauchy_prefix_indices<p>) G, last G, index \cyclic_indices<p>:
            exist! value G st {$is_cauchy_extension_value(p, G, prefix, last, index, value)}
        release thm cauchy_extension_value_exists_unique(p, G, prefix, last, index)

template<p N+, G set: $prime(p)>:
    have fn cauchy_extend(prefix fn(prefix_input \cauchy_prefix_indices<p>) G, last G) fn(output_index \cyclic_indices<p>) G = fn(input_index \cyclic_indices<p>) G {\cauchy_extension_value_selected<p, G>(prefix, last, input_index)}

thm cauchy_extend_value_relation:
    ? forall p N+, G set, prefix fn(prefix_index \cauchy_prefix_indices<p>) G, last G, index \cyclic_indices<p>:
        $prime(p)
        =>:
            $is_cauchy_extension_value(p, G, prefix, last, index, \cauchy_extend<p, G>(prefix, last)(index))
    $is_cauchy_extension_value(p, G, prefix, last, index, \cauchy_extension_value_selected<p, G>(prefix, last, index))
    \cauchy_extend<p, G>(prefix, last) = fn(current_index \cyclic_indices<p>) G {\cauchy_extension_value_selected<p, G>(prefix, last, current_index)}
    \cauchy_extend<p, G>(prefix, last)(index) = \cauchy_extension_value_selected<p, G>(prefix, last, index)
    \cauchy_extension_value_selected<p, G>(prefix, last, index) = \cauchy_extend<p, G>(prefix, last)(index)
    $is_cauchy_extension_value(p, G, prefix, last, index, \cauchy_extend<p, G>(prefix, last)(index))

thm cauchy_extend_at_last:
    ? forall p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G:
        $prime(p)
        =>:
            exist last_index \cyclic_indices<p> st {last_index = p - 1, \cauchy_extend<p, G>(prefix, last)(last_index) = last}
    p > 1
    p - 1 >= 0
    p - 1 <= p - 1
    p - 1 $in closed_range(0, p - 1) = \cyclic_indices<p>
    have last_index \cyclic_indices<p> = p - 1
    release thm cauchy_extend_value_relation(p, G, prefix, last, last_index)
    by def:
        ? $is_cauchy_extension_value(p, G, prefix, last, last_index, \cauchy_extend<p, G>(prefix, last)(last_index))
    by cases:
        ? \cauchy_extend<p, G>(prefix, last)(last_index) = last
        case $is_cauchy_new_last_value(p, G, prefix, last, last_index, \cauchy_extend<p, G>(prefix, last)(last_index)):
            by def $is_cauchy_new_last_value(p, G, prefix, last, last_index, \cauchy_extend<p, G>(prefix, last)(last_index))
        case $is_cauchy_old_prefix_value(p, G, prefix, last, last_index, \cauchy_extend<p, G>(prefix, last)(last_index)):
            by def $is_cauchy_old_prefix_value(p, G, prefix, last, last_index, \cauchy_extend<p, G>(prefix, last)(last_index))
            impossible last_index = p - 1
    witness exist chosen_last \cyclic_indices<p> st {chosen_last = p - 1, \cauchy_extend<p, G>(prefix, last)(chosen_last) = last} from last_index

thm cauchy_extend_at_prefix:
    ? forall p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, prefix_index \cauchy_prefix_indices<p>:
        $prime(p)
        =>:
            exist full_index \cyclic_indices<p> st {full_index = prefix_index, \cauchy_extend<p, G>(prefix, last)(full_index) = prefix(prefix_index)}
    p > 1
    \cauchy_prefix_indices<p> = closed_range(0, p - 2)
    0 <= prefix_index <= p - 2
    p - 2 < p - 1
    prefix_index < p - 1
    prefix_index <= p - 1
    prefix_index $in closed_range(0, p - 1) = \cyclic_indices<p>
    have full_index \cyclic_indices<p> = prefix_index
    release thm cauchy_extend_value_relation(p, G, prefix, last, full_index)
    by def:
        ? $is_cauchy_extension_value(p, G, prefix, last, full_index, \cauchy_extend<p, G>(prefix, last)(full_index))
    by cases:
        ? \cauchy_extend<p, G>(prefix, last)(full_index) = prefix(prefix_index)
        case $is_cauchy_new_last_value(p, G, prefix, last, full_index, \cauchy_extend<p, G>(prefix, last)(full_index)):
            by def $is_cauchy_new_last_value(p, G, prefix, last, full_index, \cauchy_extend<p, G>(prefix, last)(full_index))
            impossible full_index != p - 1
        case $is_cauchy_old_prefix_value(p, G, prefix, last, full_index, \cauchy_extend<p, G>(prefix, last)(full_index)):
            by def $is_cauchy_old_prefix_value(p, G, prefix, last, full_index, \cauchy_extend<p, G>(prefix, last)(full_index))
            obtain old_index from exist old_index \cauchy_prefix_indices<p> st {old_index = full_index, \cauchy_extend<p, G>(prefix, last)(full_index) = prefix(old_index)}
            old_index = full_index = prefix_index
            \cauchy_extend<p, G>(prefix, last)(full_index) = prefix(old_index) = prefix(prefix_index)
    witness exist chosen_full_index \cyclic_indices<p> st {chosen_full_index = prefix_index, \cauchy_extend<p, G>(prefix, last)(chosen_full_index) = prefix(prefix_index)} from full_index

thm cauchy_extend_entry_before_last:
    ? forall p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, n N:
        $prime(p)
        n <= p - 2
        n < p
        =>:
            exist prefix_index \cauchy_prefix_indices<p> st {prefix_index = n, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = prefix(prefix_index)}
    p > 1
    n < p
    n $in closed_range(0, p - 2) = \cauchy_prefix_indices<p>
    have prefix_index \cauchy_prefix_indices<p> = n
    release thm cauchy_extend_at_prefix(p, G, prefix, last, prefix_index)
    obtain full_index from exist full_index \cyclic_indices<p> st {full_index = prefix_index, \cauchy_extend<p, G>(prefix, last)(full_index) = prefix(prefix_index)}
    release thm cyclic_tuple_entry_apply(p, G, \cauchy_extend<p, G>(prefix, last), n)
    obtain selected_index from exist selected_index \cyclic_indices<p> st {selected_index = n, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = \cauchy_extend<p, G>(prefix, last)(selected_index)}
    selected_index = n = prefix_index = full_index
    \cauchy_extend<p, G>(prefix, last)(selected_index) = \cauchy_extend<p, G>(prefix, last)(full_index)
    \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = \cauchy_extend<p, G>(prefix, last)(selected_index) = \cauchy_extend<p, G>(prefix, last)(full_index) = prefix(prefix_index)
    witness exist chosen_prefix_index \cauchy_prefix_indices<p> st {chosen_prefix_index = n, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = prefix(chosen_prefix_index)} from prefix_index

thm cauchy_extend_entry_at_last:
    ? forall p N+, G set, prefix fn(index \cauchy_prefix_indices<p>) G, last G, n N:
        $prime(p)
        n = p - 1
        n < p
        =>:
            \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = last
    p > 1
    p - 1 >= 0
    p - 1 < p
    release thm cauchy_extend_at_last(p, G, prefix, last)
    obtain full_last from exist full_last \cyclic_indices<p> st {full_last = p - 1, \cauchy_extend<p, G>(prefix, last)(full_last) = last}
    release thm cyclic_tuple_entry_apply(p, G, \cauchy_extend<p, G>(prefix, last), n)
    obtain selected_last from exist selected_last \cyclic_indices<p> st {selected_last = n, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = \cauchy_extend<p, G>(prefix, last)(selected_last)}
    selected_last = n = p - 1 = full_last
    \cauchy_extend<p, G>(prefix, last)(selected_last) = \cauchy_extend<p, G>(prefix, last)(full_last) = last
    \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last), n) = \cauchy_extend<p, G>(prefix, last)(selected_last) = last

thm cauchy_prefix_product_independent_of_last:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, prefix fn(index \cauchy_prefix_indices<p>) G, left_last, right_last G, n N:
        $prime(p)
        n <= p - 1
        n <= p
        =>:
            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), n) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), n)
    prop same_prefix_product(k N):
        forall:
            k <= p - 1
            k <= p
            =>:
                \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k)
    claim:
        ? forall k N:
            $same_prefix_product(k)
        by induc k from 0:
            ? $same_prefix_product(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 <= p - 1
                        0 <= p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), 0) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), 0)
                    release thm cyclic_tuple_prefix_product_zero(G, group, p, \cauchy_extend<p, G>(prefix, left_last))
                    release thm cyclic_tuple_prefix_product_zero(G, group, p, \cauchy_extend<p, G>(prefix, right_last))
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), 0) = group.one = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), 0)
                by def:
                    ? $same_prefix_product(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 <= p - 1
                        k + 1 <= p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k + 1) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k + 1)
                    k <= (p - 1) - 1 = p - 2
                    p - 1 < p
                    k + 1 <= p - 1 < p
                    k < k + 1 < p
                    k <= p - 1
                    k <= p
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k)
                    release thm cauchy_extend_entry_before_last(p, G, prefix, left_last, k)
                    obtain left_index from exist left_index \cauchy_prefix_indices<p> st {left_index = k, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k) = prefix(left_index)}
                    release thm cauchy_extend_entry_before_last(p, G, prefix, right_last, k)
                    obtain right_index from exist right_index \cauchy_prefix_indices<p> st {right_index = k, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, right_last), k) = prefix(right_index)}
                    left_index = k = right_index
                    prefix(left_index) = prefix(right_index)
                    \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k) = prefix(left_index) = prefix(right_index) = \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, right_last), k)
                    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_extend<p, G>(prefix, left_last), k)
                    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_extend<p, G>(prefix, right_last), k)
                    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k))}, \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k), \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k))
                    release thm object_substitution(G, G, fn(t G) G {group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k), t)}, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, right_last), k))
                    group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k)) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k)) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, right_last), k))
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), k), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, left_last), k)) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, right_last), k)) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), k + 1)
                by def:
                    ? $same_prefix_product(k + 1)
    $same_prefix_product(n)
    n <= p - 1
    n <= p
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, left_last), n) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, right_last), n)

template<G nonempty_set, group &chap2::Group<G>, p N+: $prime(p)>:
    have fn cauchy_prefix_product(prefix fn(index \cauchy_prefix_indices<p>) G) G = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, group.one), p - 1)

template<G nonempty_set, group &chap2::Group<G>, p N+: $prime(p)>:
    have fn cauchy_tuple_from_prefix(prefix fn(index \cauchy_prefix_indices<p>) G) fn(index \cyclic_indices<p>) G = \cauchy_extend<p, G>(prefix, group.inv(\cauchy_prefix_product<G, group, p>(prefix)))

prop cauchy_tuple_product_one(G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G):
    \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one

thm cauchy_tuple_from_prefix_product_one:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, prefix fn(index \cauchy_prefix_indices<p>) G:
        $prime(p)
        =>:
            $cauchy_tuple_product_one(G, group, p, \cauchy_tuple_from_prefix<G, group, p>(prefix))
    p > 1
    p - 1 >= 0
    have last_natural N = p - 1
    last_natural = p - 1
    p - 1 < p
    last_natural = p - 1 < p
    last_natural <= p - 1
    last_natural <= p
    have prefix_product G = \cauchy_prefix_product<G, group, p>(prefix)
    have last_value G = group.inv(prefix_product)
    \cauchy_prefix_product<G, group, p>(prefix) = prefix_product
    group.inv(prefix_product) = last_value
    release thm object_substitution(G, G, group.inv, \cauchy_prefix_product<G, group, p>(prefix), prefix_product)
    group.inv(\cauchy_prefix_product<G, group, p>(prefix)) = group.inv(prefix_product) = last_value
    claim:
        ? forall index \cyclic_indices<p>:
            \cauchy_tuple_from_prefix<G, group, p>(prefix)(index) = \cauchy_extend<p, G>(prefix, last_value)(index)
        release thm object_substitution(G, G, fn(t G) G {\cauchy_extend<p, G>(prefix, t)(index)}, group.inv(\cauchy_prefix_product<G, group, p>(prefix)), last_value)
        \cauchy_tuple_from_prefix<G, group, p>(prefix)(index) = \cauchy_extend<p, G>(prefix, group.inv(\cauchy_prefix_product<G, group, p>(prefix)))(index) = \cauchy_extend<p, G>(prefix, last_value)(index)
    by def:
        ? $fn_eq(\cauchy_tuple_from_prefix<G, group, p>(prefix), \cauchy_extend<p, G>(prefix, last_value))
    \cauchy_tuple_from_prefix<G, group, p>(prefix) = \cauchy_extend<p, G>(prefix, last_value)
    release thm cauchy_prefix_product_independent_of_last(G, group, p, prefix, last_value, group.one, last_natural)
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, last_value), last_natural) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, group.one), last_natural) = \cauchy_prefix_product<G, group, p>(prefix) = prefix_product
    release thm cauchy_extend_entry_at_last(p, G, prefix, last_value, last_natural)
    \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last_value), last_natural) = last_value
    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_extend<p, G>(prefix, last_value), last_natural)
    last_natural + 1 = (p - 1) + 1 = p
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last_value), last_natural))}, \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, last_value), last_natural), prefix_product)
    release thm object_substitution(G, G, fn(t G) G {group.mul(prefix_product, t)}, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last_value), last_natural), last_value)
    last_value = group.inv(prefix_product)
    release thm object_substitution(G, G, fn(t G) G {group.mul(prefix_product, t)}, last_value, group.inv(prefix_product))
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, last_value), p) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, last_value), last_natural + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(prefix, last_value), last_natural), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last_value), last_natural)) = group.mul(prefix_product, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(prefix, last_value), last_natural)) = group.mul(prefix_product, last_value) = group.mul(prefix_product, group.inv(prefix_product))
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, prefix_product)
    group.mul(prefix_product, group.inv(prefix_product)) = group.one
    release thm object_substitution(fn(index \cyclic_indices<p>) G, G, fn(candidate fn(index \cyclic_indices<p>) G) G {\cyclic_tuple_prefix_product<G, group, p>(candidate, p)}, \cauchy_tuple_from_prefix<G, group, p>(prefix), \cauchy_extend<p, G>(prefix, last_value))
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_tuple_from_prefix<G, group, p>(prefix), p) = group.one
    by def:
        ? $cauchy_tuple_product_one(G, group, p, \cauchy_tuple_from_prefix<G, group, p>(prefix))


# Product-one tuples form the finite carrier used in the Cauchy action.

template<G nonempty_set, group &chap2::Group<G>, p N+>:
    have cauchy_product_one_tuples set = {candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, candidate)}

prop is_cauchy_completion_value(G nonempty_set, group &chap2::Group<G>, p N+, prefix fn(index \cauchy_prefix_indices<p>) G, candidate \cauchy_product_one_tuples<G, group, p>):
    $prime(p)
    candidate = \cauchy_tuple_from_prefix<G, group, p>(prefix)

thm cauchy_completion_value_exists_unique:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, prefix fn(index \cauchy_prefix_indices<p>) G:
        $prime(p)
        =>:
            exist! candidate \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_completion_value(G, group, p, prefix, candidate)}
    release thm cauchy_tuple_from_prefix_product_one(G, group, p, prefix)
    release thm set_builder_member(\cauchy_tuple_from_prefix<G, group, p>(prefix), {candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, candidate)})
    \cauchy_tuple_from_prefix<G, group, p>(prefix) $in \cauchy_product_one_tuples<G, group, p>
    have completed \cauchy_product_one_tuples<G, group, p> = \cauchy_tuple_from_prefix<G, group, p>(prefix)
    witness exist! candidate \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_completion_value(G, group, p, prefix, candidate)} from completed:
        by def:
            ? $is_cauchy_completion_value(G, group, p, prefix, completed)
        claim:
            ? forall left, right \cauchy_product_one_tuples<G, group, p>:
                $is_cauchy_completion_value(G, group, p, prefix, left)
                $is_cauchy_completion_value(G, group, p, prefix, right)
                =>:
                    left = right
            by def $is_cauchy_completion_value(G, group, p, prefix, left)
            by def $is_cauchy_completion_value(G, group, p, prefix, right)
            left = \cauchy_tuple_from_prefix<G, group, p>(prefix) = right

template<G nonempty_set, group &chap2::Group<G>, p N+: $prime(p)>:
    have fn cauchy_completion_map by exist!:
        ? forall prefix fn(index \cauchy_prefix_indices<p>) G:
            exist! candidate \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_completion_value(G, group, p, prefix, candidate)}
        release thm cauchy_completion_value_exists_unique(G, group, p, prefix)


thm cauchy_completion_map_relation:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, prefix fn(index \cauchy_prefix_indices<p>) G:
        $prime(p)
        =>:
            \cauchy_completion_map<G, group, p>(prefix) = \cauchy_tuple_from_prefix<G, group, p>(prefix)
    $is_cauchy_completion_value(G, group, p, prefix, \cauchy_completion_map<G, group, p>(prefix))
    by def $is_cauchy_completion_value(G, group, p, prefix, \cauchy_completion_map<G, group, p>(prefix))

thm cauchy_completion_map_injective:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            $injective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)
    claim:
        ? forall left, right fn(index \cauchy_prefix_indices<p>) G:
            \cauchy_completion_map<G, group, p>(left) = \cauchy_completion_map<G, group, p>(right)
            =>:
                left = right
        release thm cauchy_completion_map_relation(G, group, p, left)
        release thm cauchy_completion_map_relation(G, group, p, right)
        \cauchy_tuple_from_prefix<G, group, p>(left) = \cauchy_completion_map<G, group, p>(left) = \cauchy_completion_map<G, group, p>(right) = \cauchy_tuple_from_prefix<G, group, p>(right)
        claim:
            ? forall prefix_index \cauchy_prefix_indices<p>:
                left(prefix_index) = right(prefix_index)
            release thm cauchy_extend_at_prefix(p, G, left, group.inv(\cauchy_prefix_product<G, group, p>(left)), prefix_index)
            obtain left_full from exist left_full \cyclic_indices<p> st {left_full = prefix_index, \cauchy_extend<p, G>(left, group.inv(\cauchy_prefix_product<G, group, p>(left)))(left_full) = left(prefix_index)}
            release thm cauchy_extend_at_prefix(p, G, right, group.inv(\cauchy_prefix_product<G, group, p>(right)), prefix_index)
            obtain right_full from exist right_full \cyclic_indices<p> st {right_full = prefix_index, \cauchy_extend<p, G>(right, group.inv(\cauchy_prefix_product<G, group, p>(right)))(right_full) = right(prefix_index)}
            \cauchy_tuple_from_prefix<G, group, p>(left)(left_full) = \cauchy_extend<p, G>(left, group.inv(\cauchy_prefix_product<G, group, p>(left)))(left_full) = left(prefix_index)
            \cauchy_tuple_from_prefix<G, group, p>(right)(right_full) = \cauchy_extend<p, G>(right, group.inv(\cauchy_prefix_product<G, group, p>(right)))(right_full) = right(prefix_index)
            release thm equal_functions_equal_at(\cyclic_indices<p>, G, \cauchy_tuple_from_prefix<G, group, p>(left), \cauchy_tuple_from_prefix<G, group, p>(right), left_full)
            left_full = prefix_index = right_full
            release thm function_equal_on_equal_inputs(\cyclic_indices<p>, G, \cauchy_tuple_from_prefix<G, group, p>(right), left_full, right_full)
            left(prefix_index) = \cauchy_tuple_from_prefix<G, group, p>(left)(left_full) = \cauchy_tuple_from_prefix<G, group, p>(right)(left_full) = \cauchy_tuple_from_prefix<G, group, p>(right)(right_full) = right(prefix_index)
        by def:
            ? $fn_eq(left, right)
    by def:
        ? $injective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)


prop is_cauchy_restriction_value(p N+, G set, candidate fn(index \cyclic_indices<p>) G, prefix_index \cauchy_prefix_indices<p>, value G):
    exist full_index \cyclic_indices<p> st {full_index = prefix_index, value = candidate(full_index)}

thm cauchy_restriction_value_exists_unique:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G, prefix_index \cauchy_prefix_indices<p>:
        $prime(p)
        =>:
            exist! value G st {$is_cauchy_restriction_value(p, G, candidate, prefix_index, value)}
    p > 1
    \cauchy_prefix_indices<p> = closed_range(0, p - 2)
    0 <= prefix_index <= p - 2
    p - 2 < p - 1
    prefix_index < p - 1
    prefix_index <= p - 1
    prefix_index $in closed_range(0, p - 1) = \cyclic_indices<p>
    have full_index \cyclic_indices<p> = prefix_index
    witness exist! value G st {$is_cauchy_restriction_value(p, G, candidate, prefix_index, value)} from candidate(full_index):
        witness $is_cauchy_restriction_value(p, G, candidate, prefix_index, candidate(full_index)) from full_index
        claim:
            ? forall left, right G:
                $is_cauchy_restriction_value(p, G, candidate, prefix_index, left)
                $is_cauchy_restriction_value(p, G, candidate, prefix_index, right)
                =>:
                    left = right
            obtain left_index from exist left_index \cyclic_indices<p> st {left_index = prefix_index, left = candidate(left_index)}
            obtain right_index from exist right_index \cyclic_indices<p> st {right_index = prefix_index, right = candidate(right_index)}
            left_index = prefix_index = right_index
            left = candidate(left_index) = candidate(right_index) = right

template<p N+, G set: $prime(p)>:
    have fn cauchy_restriction_value_selected by exist!:
        ? forall candidate fn(index \cyclic_indices<p>) G, prefix_index \cauchy_prefix_indices<p>:
            exist! value G st {$is_cauchy_restriction_value(p, G, candidate, prefix_index, value)}
        release thm cauchy_restriction_value_exists_unique(p, G, candidate, prefix_index)

template<p N+, G set: $prime(p)>:
    have fn cauchy_restrict(candidate fn(index \cyclic_indices<p>) G) fn(prefix_index \cauchy_prefix_indices<p>) G = fn(current_index \cauchy_prefix_indices<p>) G {\cauchy_restriction_value_selected<p, G>(candidate, current_index)}

thm cauchy_restrict_at_prefix:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G, prefix_index \cauchy_prefix_indices<p>:
        $prime(p)
        =>:
            exist full_index \cyclic_indices<p> st {full_index = prefix_index, \cauchy_restrict<p, G>(candidate)(prefix_index) = candidate(full_index)}
    $is_cauchy_restriction_value(p, G, candidate, prefix_index, \cauchy_restriction_value_selected<p, G>(candidate, prefix_index))
    \cauchy_restrict<p, G>(candidate) = fn(current_index \cauchy_prefix_indices<p>) G {\cauchy_restriction_value_selected<p, G>(candidate, current_index)}
    \cauchy_restrict<p, G>(candidate)(prefix_index) = \cauchy_restriction_value_selected<p, G>(candidate, prefix_index)
    \cauchy_restriction_value_selected<p, G>(candidate, prefix_index) = \cauchy_restrict<p, G>(candidate)(prefix_index)
    by def:
        ? $is_cauchy_restriction_value(p, G, candidate, prefix_index, \cauchy_restriction_value_selected<p, G>(candidate, prefix_index))
    obtain full_index from exist full_index \cyclic_indices<p> st {full_index = prefix_index, \cauchy_restriction_value_selected<p, G>(candidate, prefix_index) = candidate(full_index)}
    witness exist chosen_full \cyclic_indices<p> st {chosen_full = prefix_index, \cauchy_restrict<p, G>(candidate)(prefix_index) = candidate(chosen_full)} from full_index


thm cauchy_extend_restrict_last:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G, last_index \cyclic_indices<p>:
        $prime(p)
        last_index = p - 1
        =>:
            candidate = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))
    p > 1
    claim:
        ? forall full_index \cyclic_indices<p>:
            candidate(full_index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(full_index)
        \cyclic_indices<p> = closed_range(0, p - 1)
        0 <= full_index <= p - 1
        by cases:
            ? candidate(full_index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(full_index)
            case full_index = p - 1:
                full_index = p - 1 = last_index
                release thm function_equal_on_equal_inputs(\cyclic_indices<p>, G, candidate, full_index, last_index)
                release thm cauchy_extend_at_last(p, G, \cauchy_restrict<p, G>(candidate), candidate(last_index))
                obtain extension_last from exist extension_last \cyclic_indices<p> st {extension_last = p - 1, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(extension_last) = candidate(last_index)}
                extension_last = p - 1 = full_index
                release thm function_equal_on_equal_inputs(\cyclic_indices<p>, G, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), extension_last, full_index)
                candidate(full_index) = candidate(last_index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(extension_last) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(full_index)
            case full_index != p - 1:
                claim:
                    ? full_index < p - 1
                    by contra:
                        ? full_index < p - 1
                        full_index >= p - 1
                        full_index <= p - 1
                        full_index = p - 1
                        impossible full_index != p - 1
                full_index + 1 <= p - 1
                full_index <= (p - 1) - 1 = p - 2
                full_index $in closed_range(0, p - 2) = \cauchy_prefix_indices<p>
                have prefix_index \cauchy_prefix_indices<p> = full_index
                release thm cauchy_restrict_at_prefix(p, G, candidate, prefix_index)
                obtain restricted_full from exist restricted_full \cyclic_indices<p> st {restricted_full = prefix_index, \cauchy_restrict<p, G>(candidate)(prefix_index) = candidate(restricted_full)}
                release thm cauchy_extend_at_prefix(p, G, \cauchy_restrict<p, G>(candidate), candidate(last_index), prefix_index)
                obtain extension_full from exist extension_full \cyclic_indices<p> st {extension_full = prefix_index, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(extension_full) = \cauchy_restrict<p, G>(candidate)(prefix_index)}
                restricted_full = prefix_index = full_index = extension_full
                release thm function_equal_on_equal_inputs(\cyclic_indices<p>, G, candidate, full_index, restricted_full)
                release thm function_equal_on_equal_inputs(\cyclic_indices<p>, G, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), extension_full, full_index)
                candidate(full_index) = candidate(restricted_full) = \cauchy_restrict<p, G>(candidate)(prefix_index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(extension_full) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(full_index)
    by def:
        ? $fn_eq(candidate, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)))


thm cauchy_product_one_tuple_is_completion:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate \cauchy_product_one_tuples<G, group, p>:
        $prime(p)
        =>:
            candidate = \cauchy_completion_map<G, group, p>(\cauchy_restrict<p, G>(candidate))
    p > 1
    p - 1 >= 0
    p - 1 <= p - 1
    p - 1 $in closed_range(0, p - 1) = \cyclic_indices<p>
    have last_index \cyclic_indices<p> = p - 1
    have last_natural N = p - 1
    last_index = p - 1
    last_natural = p - 1
    p - 1 < p
    last_natural = p - 1 < p
    last_natural <= p - 1
    last_natural <= p
    \cauchy_product_one_tuples<G, group, p> = {target fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, target)}
    candidate $in \cauchy_product_one_tuples<G, group, p>
    candidate $in {target fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, target)}
    by def:
        ? $cauchy_tuple_product_one(G, group, p, candidate)
    \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
    release thm cauchy_extend_restrict_last(p, G, candidate, last_index)
    candidate = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))
    release thm object_substitution(fn(index \cyclic_indices<p>) G, G, fn(target fn(index \cyclic_indices<p>) G) G {\cyclic_tuple_prefix_product<G, group, p>(target, p)}, candidate, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)))
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), p) = \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
    release thm cauchy_prefix_product_independent_of_last(G, group, p, \cauchy_restrict<p, G>(candidate), candidate(last_index), group.one, last_natural)
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), group.one), last_natural) = \cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate))
    release thm cauchy_extend_entry_at_last(p, G, \cauchy_restrict<p, G>(candidate), candidate(last_index), last_natural)
    \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural) = candidate(last_index)
    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural)
    last_natural + 1 = (p - 1) + 1 = p
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural))}, \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural), \cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)))
    release thm object_substitution(G, G, fn(t G) G {group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), t)}, \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural), candidate(last_index))
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), p) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural)) = group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), \cyclic_tuple_entry<p, G>(\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)), last_natural)) = group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), candidate(last_index))
    group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), candidate(last_index)) = group.one
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, \cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)))
    group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), group.inv(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)))) = group.one
    group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), candidate(last_index)) = group.mul(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), group.inv(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate))))
    release thm chap2::_group_left_cancel_structure(G, group.mul, group.one, group.inv, \cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)), candidate(last_index), group.inv(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate))))
    candidate(last_index) = group.inv(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate)))
    claim:
        ? forall index \cyclic_indices<p>:
            \cauchy_tuple_from_prefix<G, group, p>(\cauchy_restrict<p, G>(candidate))(index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(index)
        release thm object_substitution(G, G, fn(t G) G {\cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), t)(index)}, group.inv(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate))), candidate(last_index))
        \cauchy_tuple_from_prefix<G, group, p>(\cauchy_restrict<p, G>(candidate))(index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), group.inv(\cauchy_prefix_product<G, group, p>(\cauchy_restrict<p, G>(candidate))))(index) = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index))(index)
    by def:
        ? $fn_eq(\cauchy_tuple_from_prefix<G, group, p>(\cauchy_restrict<p, G>(candidate)), \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)))
    candidate = \cauchy_extend<p, G>(\cauchy_restrict<p, G>(candidate), candidate(last_index)) = \cauchy_tuple_from_prefix<G, group, p>(\cauchy_restrict<p, G>(candidate))
    release thm cauchy_completion_map_relation(G, group, p, \cauchy_restrict<p, G>(candidate))
    candidate = \cauchy_tuple_from_prefix<G, group, p>(\cauchy_restrict<p, G>(candidate)) = \cauchy_completion_map<G, group, p>(\cauchy_restrict<p, G>(candidate))

thm cauchy_completion_map_surjective:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            $surjective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)
    claim:
        ? forall candidate \cauchy_product_one_tuples<G, group, p>:
            exist prefix fn(index \cauchy_prefix_indices<p>) G st {candidate = \cauchy_completion_map<G, group, p>(prefix)}
        release thm cauchy_product_one_tuple_is_completion(G, group, p, candidate)
        witness exist prefix fn(index \cauchy_prefix_indices<p>) G st {candidate = \cauchy_completion_map<G, group, p>(prefix)} from \cauchy_restrict<p, G>(candidate)
    by def:
        ? $surjective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)

thm cauchy_completion_map_bijective:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            $bijective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)
    release thm cauchy_completion_map_injective(G, group, p)
    release thm cauchy_completion_map_surjective(G, group, p)
    by def:
        ? $bijective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)


thm finite_injection_range_cardinality:
    ? forall A, B finite_set, f fn(x A) B:
        $is_finite_set(fn_range(f))
        $injective(A, B, f)
        =>:
            finite_set_size(fn_range(f)) = finite_set_size(A)
    finite_set_size(fn_range(f)) = finite_set_size(A)


thm cauchy_prefix_indices_finite_size:
    ? forall p N+:
        $prime(p)
        =>:
            $is_finite_set(\cauchy_prefix_indices<p>)
            finite_set_size(\cauchy_prefix_indices<p>) = p - 1
    p > 1
    p >= 2
    p - 2 >= 0
    abs(p - 2) = p - 2
    have prefix_last N = abs(p - 2)
    prefix_last = p - 2
    \cauchy_prefix_indices<p> = closed_range(0, p - 2)
    release thm object_substitution(Z, power_set(Z), fn(t Z) power_set(Z) {closed_range(0, t)}, p - 2, prefix_last)
    closed_range(0, p - 2) = closed_range(0, prefix_last)
    $is_finite_set(closed_range(0, prefix_last))
    $is_finite_set(\cauchy_prefix_indices<p>)
    finite_set_size(closed_range(0, prefix_last)) = prefix_last - 0 + 1 = prefix_last + 1
    prefix_last + 1 = (p - 2) + 1 = p - 1
    finite_set_size(\cauchy_prefix_indices<p>) = finite_set_size(closed_range(0, p - 2)) = finite_set_size(closed_range(0, prefix_last)) = p - 1

thm cauchy_completion_map_range_eq:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            fn_range(\cauchy_completion_map<G, group, p>) = \cauchy_product_one_tuples<G, group, p>
    release thm cauchy_completion_map_surjective(G, group, p)
    by def:
        ? $surjective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)
    by extension:
        ? fn_range(\cauchy_completion_map<G, group, p>) = \cauchy_product_one_tuples<G, group, p>
        claim:
            ? forall target fn_range(\cauchy_completion_map<G, group, p>):
                target $in \cauchy_product_one_tuples<G, group, p>
            have by preimage prefix from target $in fn_range(\cauchy_completion_map<G, group, p>)
            \cauchy_completion_map<G, group, p>(prefix) $in \cauchy_product_one_tuples<G, group, p>
            target = \cauchy_completion_map<G, group, p>(prefix)
            target $in \cauchy_product_one_tuples<G, group, p>
        claim:
            ? forall target \cauchy_product_one_tuples<G, group, p>:
                target $in fn_range(\cauchy_completion_map<G, group, p>)
            obtain prefix from exist prefix fn(index \cauchy_prefix_indices<p>) G st {target = \cauchy_completion_map<G, group, p>(prefix)}
            \cauchy_completion_map<G, group, p>(prefix) $in fn_range(\cauchy_completion_map<G, group, p>)
            target = \cauchy_completion_map<G, group, p>(prefix)
            target $in fn_range(\cauchy_completion_map<G, group, p>)

thm cauchy_tuple_from_prefix_injective:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            $injective(fn(index \cauchy_prefix_indices<p>) G, fn(index \cyclic_indices<p>) G, \cauchy_tuple_from_prefix<G, group, p>)
    claim:
        ? forall left, right fn(index \cauchy_prefix_indices<p>) G:
            \cauchy_tuple_from_prefix<G, group, p>(left) = \cauchy_tuple_from_prefix<G, group, p>(right)
            =>:
                left = right
        release thm cauchy_completion_map_relation(G, group, p, left)
        release thm cauchy_completion_map_relation(G, group, p, right)
        \cauchy_completion_map<G, group, p>(left) = \cauchy_tuple_from_prefix<G, group, p>(left) = \cauchy_tuple_from_prefix<G, group, p>(right) = \cauchy_completion_map<G, group, p>(right)
        release thm cauchy_completion_map_injective(G, group, p)
        by def:
            ? $injective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)
    by def:
        ? $injective(fn(index \cauchy_prefix_indices<p>) G, fn(index \cyclic_indices<p>) G, \cauchy_tuple_from_prefix<G, group, p>)

thm cauchy_tuple_from_prefix_range_eq:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            fn_range(\cauchy_tuple_from_prefix<G, group, p>) = \cauchy_product_one_tuples<G, group, p>
    by extension:
        ? fn_range(\cauchy_tuple_from_prefix<G, group, p>) = \cauchy_product_one_tuples<G, group, p>
        claim:
            ? forall target fn_range(\cauchy_tuple_from_prefix<G, group, p>):
                target $in \cauchy_product_one_tuples<G, group, p>
            have by preimage prefix from target $in fn_range(\cauchy_tuple_from_prefix<G, group, p>)
            release thm cauchy_tuple_from_prefix_product_one(G, group, p, prefix)
            release thm set_builder_member(\cauchy_tuple_from_prefix<G, group, p>(prefix), {candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, candidate)})
            \cauchy_tuple_from_prefix<G, group, p>(prefix) $in \cauchy_product_one_tuples<G, group, p>
            target = \cauchy_tuple_from_prefix<G, group, p>(prefix)
            target $in \cauchy_product_one_tuples<G, group, p>
        claim:
            ? forall target \cauchy_product_one_tuples<G, group, p>:
                target $in fn_range(\cauchy_tuple_from_prefix<G, group, p>)
            release thm cauchy_completion_map_surjective(G, group, p)
            by def:
                ? $surjective(fn(index \cauchy_prefix_indices<p>) G, \cauchy_product_one_tuples<G, group, p>, \cauchy_completion_map<G, group, p>)
            obtain prefix from exist prefix fn(index \cauchy_prefix_indices<p>) G st {target = \cauchy_completion_map<G, group, p>(prefix)}
            release thm cauchy_completion_map_relation(G, group, p, prefix)
            target = \cauchy_completion_map<G, group, p>(prefix) = \cauchy_tuple_from_prefix<G, group, p>(prefix)
            \cauchy_tuple_from_prefix<G, group, p>(prefix) $in fn_range(\cauchy_tuple_from_prefix<G, group, p>)
            target $in fn_range(\cauchy_tuple_from_prefix<G, group, p>)

thm cauchy_product_one_tuple_count:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        =>:
            $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
            finite_set_size(\cauchy_product_one_tuples<G, group, p>) = finite_set_size(G)^(p - 1)
    release thm cauchy_prefix_indices_finite_size(p)
    release thm finite_function_space_count(\cauchy_prefix_indices<p>, G, group.one)
    by def:
        ? $finite_function_space_count_property(\cauchy_prefix_indices<p>, G)
    $is_finite_set(fn(index \cauchy_prefix_indices<p>) G)
    finite_set_size(fn(index \cauchy_prefix_indices<p>) G) = finite_set_size(G)^finite_set_size(\cauchy_prefix_indices<p>) = finite_set_size(G)^(p - 1)
    release thm cyclic_indices_are_finite(p)
    release thm finite_function_space_count(\cyclic_indices<p>, G, group.one)
    by def:
        ? $finite_function_space_count_property(\cyclic_indices<p>, G)
    $is_finite_set(fn(index \cyclic_indices<p>) G)
    claim:
        ? \cauchy_product_one_tuples<G, group, p> $subset fn(index \cyclic_indices<p>) G
        claim:
            ? forall candidate \cauchy_product_one_tuples<G, group, p>:
                candidate $in fn(index \cyclic_indices<p>) G
        by def:
            ? \cauchy_product_one_tuples<G, group, p> $subset fn(index \cyclic_indices<p>) G
    release thm subset_of_finite_set_is_finite(\cauchy_product_one_tuples<G, group, p>, fn(index \cyclic_indices<p>) G)
    $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
    release thm cauchy_tuple_from_prefix_injective(G, group, p)
    release thm cauchy_tuple_from_prefix_range_eq(G, group, p)
    have fn completion(prefix fn(index \cauchy_prefix_indices<p>) G) fn(index \cyclic_indices<p>) G = \cauchy_tuple_from_prefix<G, group, p>(prefix)
    claim:
        ? forall left, right fn(index \cauchy_prefix_indices<p>) G:
            completion(left) = completion(right)
            =>:
                left = right
        completion(left) = \cauchy_tuple_from_prefix<G, group, p>(left)
        completion(right) = \cauchy_tuple_from_prefix<G, group, p>(right)
        \cauchy_tuple_from_prefix<G, group, p>(left) = \cauchy_tuple_from_prefix<G, group, p>(right)
        by def:
            ? $injective(fn(index \cauchy_prefix_indices<p>) G, fn(index \cyclic_indices<p>) G, \cauchy_tuple_from_prefix<G, group, p>)
    by def:
        ? $injective(fn(index \cauchy_prefix_indices<p>) G, fn(index \cyclic_indices<p>) G, completion)
    claim:
        ? fn_range(completion) $subset fn(index \cyclic_indices<p>) G
        claim:
            ? forall target fn_range(completion):
                target $in fn(index \cyclic_indices<p>) G
            have by preimage prefix from target $in fn_range(completion)
            completion(prefix) $in fn(index \cyclic_indices<p>) G
            target = completion(prefix)
            target $in fn(index \cyclic_indices<p>) G
        by def:
            ? fn_range(completion) $subset fn(index \cyclic_indices<p>) G
    release thm subset_of_finite_set_is_finite(fn_range(completion), fn(index \cyclic_indices<p>) G)
    $is_finite_set(fn_range(completion))
    release thm finite_injection_range_cardinality(fn(index \cauchy_prefix_indices<p>) G, fn(index \cyclic_indices<p>) G, completion)
    finite_set_size(fn_range(completion)) = finite_set_size(fn(index \cauchy_prefix_indices<p>) G)
    claim:
        ? fn_range(completion) = \cauchy_product_one_tuples<G, group, p>
        by extension:
            ? fn_range(completion) = \cauchy_product_one_tuples<G, group, p>
            claim:
                ? forall target fn_range(completion):
                    target $in \cauchy_product_one_tuples<G, group, p>
                have by preimage prefix from target $in fn_range(completion)
                completion(prefix) = \cauchy_tuple_from_prefix<G, group, p>(prefix)
                release thm cauchy_tuple_from_prefix_product_one(G, group, p, prefix)
                release thm set_builder_member(\cauchy_tuple_from_prefix<G, group, p>(prefix), {candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, candidate)})
                \cauchy_tuple_from_prefix<G, group, p>(prefix) $in \cauchy_product_one_tuples<G, group, p>
                target = completion(prefix) = \cauchy_tuple_from_prefix<G, group, p>(prefix)
                target $in \cauchy_product_one_tuples<G, group, p>
            claim:
                ? forall target \cauchy_product_one_tuples<G, group, p>:
                    target $in fn_range(completion)
                fn_range(\cauchy_tuple_from_prefix<G, group, p>) = \cauchy_product_one_tuples<G, group, p>
                target $in fn_range(\cauchy_tuple_from_prefix<G, group, p>)
                have by preimage prefix from target $in fn_range(\cauchy_tuple_from_prefix<G, group, p>)
                completion(prefix) = \cauchy_tuple_from_prefix<G, group, p>(prefix) = target
                completion(prefix) $in fn_range(completion)
                target $in fn_range(completion)
    finite_set_size(\cauchy_product_one_tuples<G, group, p>) = finite_set_size(fn_range(completion)) = finite_set_size(fn(index \cauchy_prefix_indices<p>) G) = finite_set_size(G)^(p - 1)


# Raw cyclic reindexing on the full tuple function space.

template<p N+, G set>:
    have fn cauchy_raw_rotate(shift \cyclic_indices<p>, candidate fn(index \cyclic_indices<p>) G) fn(output_index \cyclic_indices<p>) G = fn(index \cyclic_indices<p>) G {candidate(\cyclic_add<p>(index, shift))}

thm cauchy_raw_rotate_apply:
    ? forall p N+, G set, shift \cyclic_indices<p>, candidate fn(index \cyclic_indices<p>) G, index \cyclic_indices<p>:
        \cauchy_raw_rotate<p, G>(shift, candidate)(index) = candidate(\cyclic_add<p>(index, shift))
    \cauchy_raw_rotate<p, G>(shift, candidate) = fn(current_index \cyclic_indices<p>) G {candidate(\cyclic_add<p>(current_index, shift))}
    \cauchy_raw_rotate<p, G>(shift, candidate)(index) = candidate(\cyclic_add<p>(index, shift))

thm cauchy_raw_rotate_identity:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G:
        \cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate) = candidate
    claim:
        ? forall index \cyclic_indices<p>:
            \cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate)(index) = candidate(index)
        release thm cauchy_raw_rotate_apply(p, G, \cyclic_zero<p>, candidate, index)
        release thm chap2::mul_one_structure(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>, index)
        \cyclic_add<p>(index, \cyclic_zero<p>) = index
        \cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate)(index) = candidate(\cyclic_add<p>(index, \cyclic_zero<p>)) = candidate(index)
    by def:
        ? $fn_eq(\cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate), candidate)

thm cauchy_raw_rotate_compose:
    ? forall p N+, G set, left, right \cyclic_indices<p>, candidate fn(index \cyclic_indices<p>) G:
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate)
    claim:
        ? forall index \cyclic_indices<p>:
            \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate))(index) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate)(index)
        release thm cauchy_raw_rotate_apply(p, G, left, \cauchy_raw_rotate<p, G>(right, candidate), index)
        release thm cauchy_raw_rotate_apply(p, G, right, candidate, \cyclic_add<p>(index, left))
        release thm cauchy_raw_rotate_apply(p, G, \cyclic_add<p>(left, right), candidate, index)
        release thm cyclic_prime_group_laws(p)
        by def:
            ? $chap2::group_laws(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)
        \cyclic_add<p>(\cyclic_add<p>(index, left), right) = \cyclic_add<p>(index, \cyclic_add<p>(left, right))
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate))(index) = \cauchy_raw_rotate<p, G>(right, candidate)(\cyclic_add<p>(index, left)) = candidate(\cyclic_add<p>(\cyclic_add<p>(index, left), right)) = candidate(\cyclic_add<p>(index, \cyclic_add<p>(left, right))) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate)(index)
    by def:
        ? $fn_eq(\cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)), \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate))

thm cauchy_raw_rotation_is_group_action:
    ? forall p N+, G set:
        $is_group_action(\cyclic_indices<p>, fn(index \cyclic_indices<p>) G, \cyclic_prime_group<p>, \cauchy_raw_rotate<p, G>)
    claim:
        ? forall candidate fn(index \cyclic_indices<p>) G:
            \cauchy_raw_rotate<p, G>(\cyclic_prime_group<p>.one, candidate) = candidate
        \cyclic_prime_group<p>.one = \cyclic_zero<p>
        release thm cauchy_raw_rotate_identity(p, G, candidate)
        \cauchy_raw_rotate<p, G>(\cyclic_prime_group<p>.one, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate) = candidate
    claim:
        ? forall left, right \cyclic_indices<p>, candidate fn(index \cyclic_indices<p>) G:
            \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_prime_group<p>.mul(left, right), candidate)
        \cyclic_prime_group<p>.mul = \cyclic_add<p>
        \cyclic_prime_group<p>.mul(left, right) = \cyclic_add<p>(left, right)
        release thm cauchy_raw_rotate_compose(p, G, left, right, candidate)
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate) = \cauchy_raw_rotate<p, G>(\cyclic_prime_group<p>.mul(left, right), candidate)
    by def:
        ? $is_group_action(\cyclic_indices<p>, fn(index \cyclic_indices<p>) G, \cyclic_prime_group<p>, \cauchy_raw_rotate<p, G>)


# Ordered tail products for the noncommutative cyclic-rotation argument.

template<G nonempty_set, group &chap2::Group<G>, p N+>:
    have fn cauchy_tuple_tail_product(candidate fn(index \cyclic_indices<p>) G, n N: n < p) G by induc n from 0:
        case n = 0: group.one
        case n > 0: group.mul(cauchy_tuple_tail_product(candidate, n - 1), \cyclic_tuple_entry<p, G>(candidate, n))

thm cauchy_tuple_tail_product_zero:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G:
        \cauchy_tuple_tail_product<G, group, p>(candidate, 0) = group.one
    \cauchy_tuple_tail_product<G, group, p>(candidate, 0) = group.one

thm cauchy_tuple_tail_product_succ:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G, n N:
        n < p
        n + 1 < p
        =>:
            \cauchy_tuple_tail_product<G, group, p>(candidate, n + 1) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, n), \cyclic_tuple_entry<p, G>(candidate, n + 1))
    n + 1 > 0
    (n + 1) - 1 = n
    \cauchy_tuple_tail_product<G, group, p>(candidate, n + 1) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, (n + 1) - 1), \cyclic_tuple_entry<p, G>(candidate, n + 1)) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, n), \cyclic_tuple_entry<p, G>(candidate, n + 1))

thm cauchy_prefix_splits_first_and_tail:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G, n N:
        n < p
        =>:
            \cyclic_tuple_prefix_product<G, group, p>(candidate, n + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, n))
    prop split_at(k N):
        forall:
            k < p
            =>:
                \cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k))
    claim:
        ? forall k N:
            $split_at(k)
        by induc k from 0:
            ? $split_at(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 < p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(candidate, 0 + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, 0))
                    release thm cyclic_tuple_prefix_product_zero(G, group, p, candidate)
                    release thm cyclic_tuple_prefix_product_succ(G, group, p, candidate, 0)
                    release thm cauchy_tuple_tail_product_zero(G, group, p, candidate)
                    release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, \cyclic_tuple_entry<p, G>(candidate, 0))
                    \cyclic_tuple_prefix_product<G, group, p>(candidate, 0 + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(candidate, 0), \cyclic_tuple_entry<p, G>(candidate, 0)) = group.mul(group.one, \cyclic_tuple_entry<p, G>(candidate, 0)) = \cyclic_tuple_entry<p, G>(candidate, 0)
                    group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, 0)) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), group.one) = \cyclic_tuple_entry<p, G>(candidate, 0)
                by def:
                    ? $split_at(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 < p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(candidate, (k + 1) + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1))
                    k < k + 1 < p
                    by def:
                        ? $split_at(k)
                    \cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k))
                    release thm cyclic_tuple_prefix_product_succ(G, group, p, candidate, k + 1)
                    release thm cauchy_tuple_tail_product_succ(G, group, p, candidate, k)
                    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(candidate, k + 1))}, \cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1), group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k)))
                    \cyclic_tuple_prefix_product<G, group, p>(candidate, (k + 1) + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1), \cyclic_tuple_entry<p, G>(candidate, k + 1)) = group.mul(group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k)), \cyclic_tuple_entry<p, G>(candidate, k + 1)) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, k), \cyclic_tuple_entry<p, G>(candidate, k + 1))) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1))
                by def:
                    ? $split_at(k + 1)
    $split_at(n)
    n < p
    \cyclic_tuple_prefix_product<G, group, p>(candidate, n + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, n))


# The native residue-one generator and its one-step rotation laws.

prop is_cyclic_one_value(value Z):
    value = 1

thm cyclic_one_value_exists_unique:
    ? forall p N+:
        $prime(p)
        =>:
            exist! value \cyclic_indices<p> st {$is_cyclic_one_value(value)}
    p > 1
    0 <= 1 <= p - 1
    1 $in closed_range(0, p - 1) = \cyclic_indices<p>
    have one_value \cyclic_indices<p> = 1
    witness exist! value \cyclic_indices<p> st {$is_cyclic_one_value(value)} from one_value:
        by def:
            ? $is_cyclic_one_value(one_value)
        claim:
            ? forall left, right \cyclic_indices<p>:
                $is_cyclic_one_value(left)
                $is_cyclic_one_value(right)
                =>:
                    left = right
            by def $is_cyclic_one_value(left)
            by def $is_cyclic_one_value(right)
            left = 1 = right

template<p N+: $prime(p)>:
    have fn cyclic_one_selector by exist!:
        ? forall dummy {0}:
            exist! value \cyclic_indices<p> st {$is_cyclic_one_value(value)}
        release thm cyclic_one_value_exists_unique(p)

template<p N+: $prime(p)>:
    have cyclic_one \cyclic_indices<p> = \cyclic_one_selector<p>(0)

thm cyclic_one_apply:
    ? forall p N+:
        $prime(p)
        =>:
            \cyclic_one<p> = 1
    \cyclic_one<p> = \cyclic_one_selector<p>(0)
    $is_cyclic_one_value(\cyclic_one_selector<p>(0))
    by def:
        ? $is_cyclic_one_value(\cyclic_one_selector<p>(0))

thm cauchy_one_rotate_entry_before_last:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G, n N:
        $prime(p)
        n < p
        n + 1 < p
        =>:
            \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cyclic_tuple_entry<p, G>(candidate, n + 1)
    p > 1
    n + 1 <= p - 1
    n + 1 < p
    n + 1 $in closed_range(0, p - 1) = \cyclic_indices<p>
    have next_index \cyclic_indices<p> = n + 1
    release thm cyclic_tuple_entry_apply(p, G, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n)
    obtain rotated_index from exist rotated_index \cyclic_indices<p> st {rotated_index = n, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_index)}
    release thm cauchy_raw_rotate_apply(p, G, \cyclic_one<p>, candidate, rotated_index)
    release thm cyclic_one_apply(p)
    release thm cyclic_add_apply(p, rotated_index, \cyclic_one<p>)
    rotated_index = n
    \cyclic_one<p> = 1
    \cyclic_add<p>(rotated_index, \cyclic_one<p>) = (rotated_index + \cyclic_one<p>) % p = (n + 1) % p
    release thm cyclic_index_mod_self(p, next_index)
    next_index = n + 1
    next_index % p = next_index
    (n + 1) % p = next_index % p = next_index
    release thm cyclic_tuple_entry_apply(p, G, candidate, n + 1)
    obtain source_index from exist source_index \cyclic_indices<p> st {source_index = n + 1, \cyclic_tuple_entry<p, G>(candidate, n + 1) = candidate(source_index)}
    source_index = n + 1 = next_index = \cyclic_add<p>(rotated_index, \cyclic_one<p>)
    candidate(\cyclic_add<p>(rotated_index, \cyclic_one<p>)) = candidate(source_index)
    \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_index) = candidate(\cyclic_add<p>(rotated_index, \cyclic_one<p>)) = candidate(source_index) = \cyclic_tuple_entry<p, G>(candidate, n + 1)

thm cauchy_one_rotate_entry_last:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G:
        $prime(p)
        =>:
            \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), p - 1) = \cyclic_tuple_entry<p, G>(candidate, 0)
    p > 1
    p - 1 >= 0
    have last_natural N = p - 1
    last_natural = p - 1
    p - 1 < p
    last_natural = p - 1 < p
    release thm cyclic_tuple_entry_apply(p, G, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)
    obtain rotated_last from exist rotated_last \cyclic_indices<p> st {rotated_last = last_natural, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last)}
    release thm cauchy_raw_rotate_apply(p, G, \cyclic_one<p>, candidate, rotated_last)
    release thm cyclic_one_apply(p)
    release thm cyclic_add_apply(p, rotated_last, \cyclic_one<p>)
    rotated_last = last_natural = p - 1
    \cyclic_one<p> = 1
    p % p = (p * 1) % p = 0
    \cyclic_add<p>(rotated_last, \cyclic_one<p>) = (rotated_last + \cyclic_one<p>) % p = ((p - 1) + 1) % p = p % p = 0
    release thm cyclic_tuple_entry_apply(p, G, candidate, 0)
    obtain zero_index from exist zero_index \cyclic_indices<p> st {zero_index = 0, \cyclic_tuple_entry<p, G>(candidate, 0) = candidate(zero_index)}
    zero_index = 0 = \cyclic_add<p>(rotated_last, \cyclic_one<p>)
    candidate(\cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index)
    \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), p - 1) = \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last) = candidate(\cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index) = \cyclic_tuple_entry<p, G>(candidate, 0)

thm cauchy_one_rotate_prefix_is_tail:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G, n N:
        $prime(p)
        n < p
        =>:
            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_tuple_tail_product<G, group, p>(candidate, n)
    prop rotated_prefix_is_tail(k N):
        forall:
            k < p
            =>:
                \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k) = \cauchy_tuple_tail_product<G, group, p>(candidate, k)
    claim:
        ? forall k N:
            $rotated_prefix_is_tail(k)
        by induc k from 0:
            ? $rotated_prefix_is_tail(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 < p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), 0) = \cauchy_tuple_tail_product<G, group, p>(candidate, 0)
                    release thm cyclic_tuple_prefix_product_zero(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate))
                    release thm cauchy_tuple_tail_product_zero(G, group, p, candidate)
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), 0) = group.one = \cauchy_tuple_tail_product<G, group, p>(candidate, 0)
                by def:
                    ? $rotated_prefix_is_tail(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 < p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k + 1) = \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1)
                    k < k + 1 < p
                    by def:
                        ? $rotated_prefix_is_tail(k)
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k) = \cauchy_tuple_tail_product<G, group, p>(candidate, k)
                    release thm cauchy_one_rotate_entry_before_last(p, G, candidate, k)
                    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k)
                    release thm cauchy_tuple_tail_product_succ(G, group, p, candidate, k)
                    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k))}, \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k), \cauchy_tuple_tail_product<G, group, p>(candidate, k))
                    release thm object_substitution(G, G, fn(t G) G {group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, k), t)}, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k), \cyclic_tuple_entry<p, G>(candidate, k + 1))
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k), \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k)) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, k), \cyclic_tuple_entry<p, G>(candidate, k + 1)) = \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1)
                by def:
                    ? $rotated_prefix_is_tail(k + 1)
    $rotated_prefix_is_tail(n)
    n < p
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_tuple_tail_product<G, group, p>(candidate, n)


# A one-step cyclic rotation preserves the ordered product-one condition.

thm cauchy_one_rotate_entry_at_last_natural:
    ? forall p N+, G set, candidate fn(index \cyclic_indices<p>) G, n N:
        $prime(p)
        n = p - 1
        n < p
        =>:
            \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cyclic_tuple_entry<p, G>(candidate, 0)
    release thm cyclic_tuple_entry_apply(p, G, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n)
    obtain rotated_last from exist rotated_last \cyclic_indices<p> st {rotated_last = n, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last)}
    release thm cauchy_raw_rotate_apply(p, G, \cyclic_one<p>, candidate, rotated_last)
    release thm cyclic_one_apply(p)
    release thm cyclic_add_apply(p, rotated_last, \cyclic_one<p>)
    rotated_last = n = p - 1
    \cyclic_one<p> = 1
    p % p = (p * 1) % p = 0
    \cyclic_add<p>(rotated_last, \cyclic_one<p>) = (rotated_last + \cyclic_one<p>) % p = ((p - 1) + 1) % p = p % p = 0
    release thm cyclic_tuple_entry_apply(p, G, candidate, 0)
    obtain zero_index from exist zero_index \cyclic_indices<p> st {zero_index = 0, \cyclic_tuple_entry<p, G>(candidate, 0) = candidate(zero_index)}
    zero_index = 0 = \cyclic_add<p>(rotated_last, \cyclic_one<p>)
    candidate(\cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index)
    \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last) = candidate(\cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index) = \cyclic_tuple_entry<p, G>(candidate, 0)

thm cauchy_one_rotate_preserves_product_one:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G:
        $prime(p)
        $cauchy_tuple_product_one(G, group, p, candidate)
        =>:
            $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate))
    p > 1
    by def:
        ? $cauchy_tuple_product_one(G, group, p, candidate)
    \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
    p - 1 >= 0
    have last_natural N = p - 1
    last_natural = p - 1
    p - 1 < p
    last_natural = p - 1 < p
    have first G = \cyclic_tuple_entry<p, G>(candidate, 0)
    have tail G = \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural)
    first = \cyclic_tuple_entry<p, G>(candidate, 0)
    tail = \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural)
    release thm cauchy_prefix_splits_first_and_tail(G, group, p, candidate, last_natural)
    last_natural + 1 = (p - 1) + 1 = p
    \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = \cyclic_tuple_prefix_product<G, group, p>(candidate, last_natural + 1) = group.mul(\cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural)) = group.mul(first, tail)
    group.mul(first, tail) = group.one
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, first)
    group.mul(first, group.inv(first)) = group.one
    group.mul(first, tail) = group.mul(first, group.inv(first))
    release thm chap2::_group_left_cancel_structure(G, group.mul, group.one, group.inv, first, tail, group.inv(first))
    tail = group.inv(first)
    release thm cauchy_one_rotate_prefix_is_tail(G, group, p, candidate, last_natural)
    release thm cauchy_one_rotate_entry_at_last_natural(p, G, candidate, last_natural)
    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural) = tail
    \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cyclic_tuple_entry<p, G>(candidate, 0) = first
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural))}, \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural), tail)
    release thm object_substitution(G, G, fn(t G) G {group.mul(tail, t)}, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural), first)
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, first)}, tail, group.inv(first))
    group.mul(group.inv(first), first) = group.one
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), p) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural), \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)) = group.mul(tail, \cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)) = group.mul(tail, first) = group.mul(group.inv(first), first) = group.one
    by def:
        ? $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate))


# Every residue rotation is an iteration of the checked one-step rotation.

thm cauchy_natural_rotate_preserves_product_one:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G, shift \cyclic_indices<p>, n N:
        $prime(p)
        $cauchy_tuple_product_one(G, group, p, candidate)
        shift = n
        n < p
        =>:
            $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))
    prop rotation_preserved_at(k N):
        forall current \cyclic_indices<p>:
            current = k
            k < p
            =>:
                $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
    claim:
        ? forall k N:
            $rotation_preserved_at(k)
        by induc k from 0:
            ? $rotation_preserved_at(k)
            ? from k = 0:
                claim:
                    ? forall current \cyclic_indices<p>:
                        current = 0
                        0 < p
                        =>:
                            $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                    release thm cyclic_zero_apply(p)
                    current = 0 = \cyclic_zero<p>
                    release thm cauchy_raw_rotate_identity(p, G, candidate)
                    \cauchy_raw_rotate<p, G>(current, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate) = candidate
                    by def:
                        ? $cauchy_tuple_product_one(G, group, p, candidate)
                    \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
                    release thm object_substitution(fn(index \cyclic_indices<p>) G, G, fn(rotated_candidate fn(index \cyclic_indices<p>) G) G {\cyclic_tuple_prefix_product<G, group, p>(rotated_candidate, p)}, candidate, \cauchy_raw_rotate<p, G>(current, candidate))
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(current, candidate), p) = \cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
                    by def:
                        ? $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                by def:
                    ? $rotation_preserved_at(0)
            ? induc:
                claim:
                    ? forall current \cyclic_indices<p>:
                        current = k + 1
                        k + 1 < p
                        =>:
                            $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                    k < k + 1 < p
                    k <= p - 1
                    k $in closed_range(0, p - 1) = \cyclic_indices<p>
                    have previous \cyclic_indices<p> = k
                    by def:
                        ? $rotation_preserved_at(k)
                    $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(previous, candidate))
                    release thm cauchy_one_rotate_preserves_product_one(G, group, p, \cauchy_raw_rotate<p, G>(previous, candidate))
                    $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)))
                    release thm cyclic_one_apply(p)
                    release thm cyclic_add_apply(p, \cyclic_one<p>, previous)
                    release thm cyclic_index_mod_self(p, current)
                    previous = k
                    current = k + 1
                    \cyclic_one<p> = 1
                    \cyclic_add<p>(\cyclic_one<p>, previous) = (\cyclic_one<p> + previous) % p = (1 + k) % p = (k + 1) % p = current % p = current
                    release thm cauchy_raw_rotate_compose(p, G, \cyclic_one<p>, previous, candidate)
                    \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(\cyclic_one<p>, previous), candidate)
                    \cauchy_raw_rotate<p, G>(\cyclic_add<p>(\cyclic_one<p>, previous), candidate) = \cauchy_raw_rotate<p, G>(current, candidate)
                    \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)) = \cauchy_raw_rotate<p, G>(current, candidate)
                    by def:
                        ? $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)))
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)), p) = group.one
                    release thm object_substitution(fn(index \cyclic_indices<p>) G, G, fn(rotated_candidate fn(index \cyclic_indices<p>) G) G {\cyclic_tuple_prefix_product<G, group, p>(rotated_candidate, p)}, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)), \cauchy_raw_rotate<p, G>(current, candidate))
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(current, candidate), p) = group.one
                    by def:
                        ? $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                by def:
                    ? $rotation_preserved_at(k + 1)
    $rotation_preserved_at(n)
    by def $rotation_preserved_at(n)
    $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))

thm cauchy_raw_rotate_preserves_product_one:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate fn(index \cyclic_indices<p>) G, shift \cyclic_indices<p>:
        $prime(p)
        $cauchy_tuple_product_one(G, group, p, candidate)
        =>:
            $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))
    \cyclic_indices<p> = closed_range(0, p - 1)
    0 <= shift <= p - 1
    abs(shift) = shift
    have natural_shift N = abs(shift)
    natural_shift = shift
    p - 1 < p
    natural_shift = shift <= p - 1 < p
    release thm cauchy_natural_rotate_preserves_product_one(G, group, p, candidate, shift, natural_shift)


# Restrict raw reindexing to the product-one tuple carrier.

prop is_cauchy_rotation_value(G nonempty_set, group &chap2::Group<G>, p N+, shift \cyclic_indices<p>, candidate \cauchy_product_one_tuples<G, group, p>, result \cauchy_product_one_tuples<G, group, p>):
    result = \cauchy_raw_rotate<p, G>(shift, candidate)

thm cauchy_rotation_value_exists_unique:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, shift \cyclic_indices<p>, candidate \cauchy_product_one_tuples<G, group, p>:
        $prime(p)
        =>:
            exist! result \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_rotation_value(G, group, p, shift, candidate, result)}
    \cauchy_product_one_tuples<G, group, p> = {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)}
    candidate $in \cauchy_product_one_tuples<G, group, p>
    release thm set_builder_member(candidate, {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    $cauchy_tuple_product_one(G, group, p, candidate)
    release thm cauchy_raw_rotate_preserves_product_one(G, group, p, candidate, shift)
    $cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))
    release thm set_builder_member(\cauchy_raw_rotate<p, G>(shift, candidate), {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    \cauchy_raw_rotate<p, G>(shift, candidate) $in \cauchy_product_one_tuples<G, group, p>
    have rotated \cauchy_product_one_tuples<G, group, p> = \cauchy_raw_rotate<p, G>(shift, candidate)
    witness exist! result \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_rotation_value(G, group, p, shift, candidate, result)} from rotated:
        by def:
            ? $is_cauchy_rotation_value(G, group, p, shift, candidate, rotated)
        claim:
            ? forall left, right \cauchy_product_one_tuples<G, group, p>:
                $is_cauchy_rotation_value(G, group, p, shift, candidate, left)
                $is_cauchy_rotation_value(G, group, p, shift, candidate, right)
                =>:
                    left = right
            by def $is_cauchy_rotation_value(G, group, p, shift, candidate, left)
            by def $is_cauchy_rotation_value(G, group, p, shift, candidate, right)
            left = \cauchy_raw_rotate<p, G>(shift, candidate) = right

template<G nonempty_set, group &chap2::Group<G>, p N+: $prime(p)>:
    have fn cauchy_rotate by exist!:
        ? forall shift \cyclic_indices<p>, candidate \cauchy_product_one_tuples<G, group, p>:
            exist! result \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_rotation_value(G, group, p, shift, candidate, result)}
        release thm cauchy_rotation_value_exists_unique(G, group, p, shift, candidate)

thm cauchy_rotate_relation:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, shift \cyclic_indices<p>, candidate \cauchy_product_one_tuples<G, group, p>:
        $prime(p)
        =>:
            \cauchy_rotate<G, group, p>(shift, candidate) = \cauchy_raw_rotate<p, G>(shift, candidate)
    $is_cauchy_rotation_value(G, group, p, shift, candidate, \cauchy_rotate<G, group, p>(shift, candidate))
    by def $is_cauchy_rotation_value(G, group, p, shift, candidate, \cauchy_rotate<G, group, p>(shift, candidate))

thm cauchy_rotation_is_group_action:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $prime(p)
        =>:
            $is_group_action(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cyclic_prime_group<p>, \cauchy_rotate<G, group, p>)
    claim:
        ? forall candidate \cauchy_product_one_tuples<G, group, p>:
            \cauchy_rotate<G, group, p>(\cyclic_prime_group<p>.one, candidate) = candidate
        \cyclic_prime_group<p>.one = \cyclic_zero<p>
        release thm cauchy_rotate_relation(G, group, p, \cyclic_prime_group<p>.one, candidate)
        release thm cauchy_raw_rotate_identity(p, G, candidate)
        \cauchy_rotate<G, group, p>(\cyclic_prime_group<p>.one, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_prime_group<p>.one, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_zero<p>, candidate) = candidate
    claim:
        ? forall left, right \cyclic_indices<p>, candidate \cauchy_product_one_tuples<G, group, p>:
            \cauchy_rotate<G, group, p>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_rotate<G, group, p>(\cyclic_prime_group<p>.mul(left, right), candidate)
        release thm cauchy_rotate_relation(G, group, p, right, candidate)
        \cauchy_rotate<G, group, p>(right, candidate) = \cauchy_raw_rotate<p, G>(right, candidate)
        release thm cauchy_rotate_relation(G, group, p, left, \cauchy_rotate<G, group, p>(right, candidate))
        \cauchy_rotate<G, group, p>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_rotate<G, group, p>(right, candidate))
        \cauchy_raw_rotate<p, G>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate))
        release thm cauchy_raw_rotate_compose(p, G, left, right, candidate)
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate)
        \cyclic_prime_group<p>.mul = \cyclic_add<p>
        \cyclic_prime_group<p>.mul(left, right) = \cyclic_add<p>(left, right)
        release thm cauchy_rotate_relation(G, group, p, \cyclic_prime_group<p>.mul(left, right), candidate)
        \cauchy_rotate<G, group, p>(\cyclic_prime_group<p>.mul(left, right), candidate) = \cauchy_raw_rotate<p, G>(\cyclic_prime_group<p>.mul(left, right), candidate) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate)
        \cauchy_rotate<G, group, p>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_add<p>(left, right), candidate) = \cauchy_rotate<G, group, p>(\cyclic_prime_group<p>.mul(left, right), candidate)
    by def:
        ? $is_group_action(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cyclic_prime_group<p>, \cauchy_rotate<G, group, p>)


# Explicit nonnegative group powers and the constant fixed-point pattern.

template<G nonempty_set, group &chap2::Group<G>>:
    have fn cauchy_group_power(x G, n N) G by induc n from 0:
        case n = 0: group.one
        case n > 0: group.mul(cauchy_group_power(x, n - 1), x)

thm cauchy_group_power_zero:
    ? forall G nonempty_set, group &chap2::Group<G>, x G:
        \cauchy_group_power<G, group>(x, 0) = group.one
    \cauchy_group_power<G, group>(x, 0) = group.one

thm cauchy_group_power_succ:
    ? forall G nonempty_set, group &chap2::Group<G>, x G, n N:
        \cauchy_group_power<G, group>(x, n + 1) = group.mul(\cauchy_group_power<G, group>(x, n), x)
    n + 1 > 0
    (n + 1) - 1 = n
    \cauchy_group_power<G, group>(x, n + 1) = group.mul(\cauchy_group_power<G, group>(x, (n + 1) - 1), x) = group.mul(\cauchy_group_power<G, group>(x, n), x)

template<p N+, G set>:
    have fn cauchy_constant_tuple(x G) fn(output_index \cyclic_indices<p>) G = fn(current_index \cyclic_indices<p>) G {x}

thm cauchy_constant_tuple_apply:
    ? forall p N+, G set, x G, index \cyclic_indices<p>:
        \cauchy_constant_tuple<p, G>(x)(index) = x
    \cauchy_constant_tuple<p, G>(x) = fn(current \cyclic_indices<p>) G {x}
    \cauchy_constant_tuple<p, G>(x)(index) = x

thm cauchy_constant_tuple_entry:
    ? forall p N+, G set, x G, n N:
        n < p
        =>:
            \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), n) = x
    release thm cyclic_tuple_entry_apply(p, G, \cauchy_constant_tuple<p, G>(x), n)
    obtain selected_index from exist selected_index \cyclic_indices<p> st {selected_index = n, \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_constant_tuple<p, G>(x)(selected_index)}
    release thm cauchy_constant_tuple_apply(p, G, x, selected_index)
    \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_constant_tuple<p, G>(x)(selected_index) = x

thm cauchy_constant_prefix_is_power:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G, n N:
        n <= p
        =>:
            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_group_power<G, group>(x, n)
    prop constant_prefix_matches(k N):
        forall:
            k <= p
            =>:
                \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k) = \cauchy_group_power<G, group>(x, k)
    claim:
        ? forall k N:
            $constant_prefix_matches(k)
        by induc k from 0:
            ? $constant_prefix_matches(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 <= p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), 0) = \cauchy_group_power<G, group>(x, 0)
                    release thm cyclic_tuple_prefix_product_zero(G, group, p, \cauchy_constant_tuple<p, G>(x))
                    release thm cauchy_group_power_zero(G, group, x)
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), 0) = group.one = \cauchy_group_power<G, group>(x, 0)
                by def:
                    ? $constant_prefix_matches(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 <= p
                        =>:
                            \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k + 1) = \cauchy_group_power<G, group>(x, k + 1)
                    k < k + 1 <= p
                    k <= p
                    by def:
                        ? $constant_prefix_matches(k)
                    release thm cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_constant_tuple<p, G>(x), k)
                    release thm cauchy_constant_tuple_entry(p, G, x, k)
                    release thm cauchy_group_power_succ(G, group, x, k)
                    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k))}, \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k), \cauchy_group_power<G, group>(x, k))
                    release thm object_substitution(G, G, fn(t G) G {group.mul(\cauchy_group_power<G, group>(x, k), t)}, \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k), x)
                    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k + 1) = group.mul(\cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k), \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k)) = group.mul(\cauchy_group_power<G, group>(x, k), \cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k)) = group.mul(\cauchy_group_power<G, group>(x, k), x) = \cauchy_group_power<G, group>(x, k + 1)
                by def:
                    ? $constant_prefix_matches(k + 1)
    $constant_prefix_matches(n)
    n <= p
    \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_group_power<G, group>(x, n)

thm cauchy_constant_tuple_product_one_from_power:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
    release thm cauchy_constant_prefix_is_power(G, group, p, x, p)
    by def:
        ? $cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))

thm cauchy_constant_tuple_power_from_product_one:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
        =>:
            \cauchy_group_power<G, group>(x, p) = group.one
    by def:
        ? $cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
    release thm cauchy_constant_prefix_is_power(G, group, p, x, p)
    \cauchy_group_power<G, group>(x, p) = \cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), p) = group.one

thm cauchy_fixed_tuple_is_constant:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, candidate \cauchy_product_one_tuples<G, group, p>, index \cyclic_indices<p>:
        $prime(p)
        $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, candidate)
        =>:
            candidate(index) = candidate(\cyclic_zero<p>)
    by def:
        ? $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, candidate)
    \cauchy_rotate<G, group, p>(index, candidate) = candidate
    release thm cauchy_rotate_relation(G, group, p, index, candidate)
    \cauchy_raw_rotate<p, G>(index, candidate) = \cauchy_rotate<G, group, p>(index, candidate) = candidate
    release thm equal_functions_equal_at(\cyclic_indices<p>, G, \cauchy_raw_rotate<p, G>(index, candidate), candidate, \cyclic_zero<p>)
    release thm cauchy_raw_rotate_apply(p, G, index, candidate, \cyclic_zero<p>)
    release thm cyclic_prime_group_laws(p)
    by def:
        ? $chap2::group_laws(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)
    \cyclic_add<p>(\cyclic_zero<p>, index) = index
    \cauchy_raw_rotate<p, G>(index, candidate)(\cyclic_zero<p>) = candidate(\cyclic_add<p>(\cyclic_zero<p>, index)) = candidate(index)
    \cauchy_raw_rotate<p, G>(index, candidate)(\cyclic_zero<p>) = candidate(\cyclic_zero<p>)
    candidate(index) = \cauchy_raw_rotate<p, G>(index, candidate)(\cyclic_zero<p>) = candidate(\cyclic_zero<p>)


# Constant product-one tuples, including the distinguished identity tuple.

thm cauchy_group_power_one:
    ? forall G nonempty_set, group &chap2::Group<G>, n N:
        \cauchy_group_power<G, group>(group.one, n) = group.one
    by induc n from 0:
        ? \cauchy_group_power<G, group>(group.one, n) = group.one
        ? from n = 0:
            release thm cauchy_group_power_zero(G, group, group.one)
        ? induc:
            release thm cauchy_group_power_succ(G, group, group.one, n)
            \cauchy_group_power<G, group>(group.one, n + 1) = group.mul(\cauchy_group_power<G, group>(group.one, n), group.one) = group.mul(group.one, group.one) = group.one

prop is_cauchy_constant_product_value(G nonempty_set, group &chap2::Group<G>, p N+, x G, result \cauchy_product_one_tuples<G, group, p>):
    result = \cauchy_constant_tuple<p, G>(x)

thm cauchy_constant_product_value_exists_unique:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $prime(p)
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            exist! result \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_constant_product_value(G, group, p, x, result)}
    release thm cauchy_constant_tuple_product_one_from_power(G, group, p, x)
    release thm set_builder_member(\cauchy_constant_tuple<p, G>(x), {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    \cauchy_constant_tuple<p, G>(x) $in \cauchy_product_one_tuples<G, group, p>
    have constant_result \cauchy_product_one_tuples<G, group, p> = \cauchy_constant_tuple<p, G>(x)
    witness exist! result \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_constant_product_value(G, group, p, x, result)} from constant_result:
        by def:
            ? $is_cauchy_constant_product_value(G, group, p, x, constant_result)
        claim:
            ? forall left, right \cauchy_product_one_tuples<G, group, p>:
                $is_cauchy_constant_product_value(G, group, p, x, left)
                $is_cauchy_constant_product_value(G, group, p, x, right)
                =>:
                    left = right
            by def $is_cauchy_constant_product_value(G, group, p, x, left)
            by def $is_cauchy_constant_product_value(G, group, p, x, right)
            left = \cauchy_constant_tuple<p, G>(x) = right

template<G nonempty_set, group &chap2::Group<G>, p N+, x G: $prime(p), \cauchy_group_power<G, group>(x, p) = group.one>:
    have fn cauchy_constant_product_tuple by exist!:
        ? forall dummy {0}:
            exist! result \cauchy_product_one_tuples<G, group, p> st {$is_cauchy_constant_product_value(G, group, p, x, result)}
        release thm cauchy_constant_product_value_exists_unique(G, group, p, x)

thm cauchy_constant_product_tuple_relation:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $prime(p)
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            \cauchy_constant_product_tuple<G, group, p, x>(0) = \cauchy_constant_tuple<p, G>(x)
    $is_cauchy_constant_product_value(G, group, p, x, \cauchy_constant_product_tuple<G, group, p, x>(0))
    by def $is_cauchy_constant_product_value(G, group, p, x, \cauchy_constant_product_tuple<G, group, p, x>(0))

thm cauchy_raw_rotate_constant:
    ? forall p N+, G set, x G, shift \cyclic_indices<p>:
        \cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x)) = \cauchy_constant_tuple<p, G>(x)
    claim:
        ? forall index \cyclic_indices<p>:
            \cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x))(index) = \cauchy_constant_tuple<p, G>(x)(index)
        release thm cauchy_raw_rotate_apply(p, G, shift, \cauchy_constant_tuple<p, G>(x), index)
        release thm cauchy_constant_tuple_apply(p, G, x, \cyclic_add<p>(index, shift))
        release thm cauchy_constant_tuple_apply(p, G, x, index)
        \cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x))(index) = \cauchy_constant_tuple<p, G>(x)(\cyclic_add<p>(index, shift)) = x = \cauchy_constant_tuple<p, G>(x)(index)
    by def:
        ? $fn_eq(\cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x)), \cauchy_constant_tuple<p, G>(x))

thm cauchy_constant_product_tuple_is_fixed:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $prime(p)
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, \cauchy_constant_product_tuple<G, group, p, x>(0))
    claim:
        ? forall shift \cyclic_indices<p>:
            \cauchy_rotate<G, group, p>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_constant_product_tuple<G, group, p, x>(0)
        release thm cauchy_constant_product_tuple_relation(G, group, p, x)
        release thm cauchy_rotate_relation(G, group, p, shift, \cauchy_constant_product_tuple<G, group, p, x>(0))
        \cauchy_rotate<G, group, p>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_raw_rotate<p, G>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x))
        release thm cauchy_raw_rotate_constant(p, G, x, shift)
        \cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x)) = \cauchy_constant_tuple<p, G>(x) = \cauchy_constant_product_tuple<G, group, p, x>(0)
        \cauchy_rotate<G, group, p>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_constant_product_tuple<G, group, p, x>(0)
    by def:
        ? $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, \cauchy_constant_product_tuple<G, group, p, x>(0))


# The Cauchy tuple action has a nontrivial fixed point when p divides |G|.

thm divisor_divides_positive_power:
    ? forall divisor N+, base N, exponent N+:
        $chap2::divides(divisor, base)
        =>:
            $chap2::divides(divisor, base^exponent)
    obtain quotient from $chap2::divides(divisor, base)
    exponent >= 1
    exponent - 1 >= 0
    have previous_exponent N = exponent - 1
    previous_exponent = exponent - 1
    previous_exponent + 1 = (exponent - 1) + 1 = exponent
    base^exponent = base^(previous_exponent + 1) = base^previous_exponent * base = base^previous_exponent * (divisor * quotient) = divisor * (base^previous_exponent * quotient)
    witness $chap2::divides(divisor, base^exponent) from base^previous_exponent * quotient

thm cauchy_product_one_tuple_count_divisible:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
        =>:
            $chap2::divides(p, finite_set_size(\cauchy_product_one_tuples<G, group, p>))
    p > 1
    p - 1 >= 1
    have positive_exponent N+ = p - 1
    release thm divisor_divides_positive_power(p, finite_set_size(G), positive_exponent)
    release thm cauchy_product_one_tuple_count(G, group, p)
    finite_set_size(\cauchy_product_one_tuples<G, group, p>) = finite_set_size(G)^(p - 1) = finite_set_size(G)^positive_exponent
    $chap2::divides(p, finite_set_size(\cauchy_product_one_tuples<G, group, p>))

thm cauchy_fixed_point_count_divisible:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
        =>:
            $chap2::divides(p, finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>))
    release thm cauchy_product_one_tuple_count(G, group, p)
    release thm cauchy_rotation_is_group_action(G, group, p)
    release thm cyclic_indices_are_finite(p)
    release thm cyclic_indices_have_prime_size(p)
    finite_set_size(\cyclic_indices<p>) = p = p^1
    release thm action_fixed_points_are_finite(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>)
    $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
    release thm finite_p_group_fixed_point_congruence(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cyclic_prime_group<p>, \cauchy_rotate<G, group, p>, p, 1)
    $chap2::divides(p, finite_set_size(\cauchy_product_one_tuples<G, group, p>) - finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>))
    release thm cauchy_product_one_tuple_count_divisible(G, group, p)
    obtain total_quotient from $chap2::divides(p, finite_set_size(\cauchy_product_one_tuples<G, group, p>))
    obtain defect_quotient from $chap2::divides(p, finite_set_size(\cauchy_product_one_tuples<G, group, p>) - finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>))
    claim:
        ? \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> $subset \cauchy_product_one_tuples<G, group, p>
        claim:
            ? forall fixed_candidate \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>:
                fixed_candidate $in \cauchy_product_one_tuples<G, group, p>
        by def:
            ? \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> $subset \cauchy_product_one_tuples<G, group, p>
    finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) <= finite_set_size(\cauchy_product_one_tuples<G, group, p>)
    finite_set_size(\cauchy_product_one_tuples<G, group, p>) - finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) + finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) = finite_set_size(\cauchy_product_one_tuples<G, group, p>)
    finite_set_size(\cauchy_product_one_tuples<G, group, p>) = p * total_quotient
    finite_set_size(\cauchy_product_one_tuples<G, group, p>) - finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) = p * defect_quotient
    finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) = finite_set_size(\cauchy_product_one_tuples<G, group, p>) - (finite_set_size(\cauchy_product_one_tuples<G, group, p>) - finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)) = p * total_quotient - p * defect_quotient = p * (total_quotient - defect_quotient)
    witness $chap2::divides(p, finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)) from total_quotient - defect_quotient

thm cauchy_fixed_point_count_at_least_prime:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
        =>:
            finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) >= p
    release thm cauchy_fixed_point_count_divisible(G, group, p)
    release thm cauchy_group_power_one(G, group, p)
    release thm cauchy_constant_product_tuple_is_fixed(G, group, p, group.one)
    \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> = {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)}
    release thm set_builder_member(\cauchy_constant_product_tuple<G, group, p, group.one>(0), {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)})
    \cauchy_constant_product_tuple<G, group, p, group.one>(0) $in \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>
    witness $is_nonempty_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) from \cauchy_constant_product_tuple<G, group, p, group.one>(0)
    finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) >= 1
    release thm chap2::_positive_divisor_le_abs(p, finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>))
    abs(finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)) = finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
    p <= finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)


# A finite set of size at least two contains an element distinct from any
# chosen member.  This elementary counting interface is kept explicit because
# MIL cannot import it from an external finite-set library.

thm finite_set_intersect_member_singleton:
    ? forall S set, distinguished S:
        intersect(S, {distinguished}) = {distinguished}
    by extension:
        ? intersect(S, {distinguished}) = {distinguished}
        claim:
            ? forall candidate intersect(S, {distinguished}):
                candidate $in {distinguished}
            candidate $in {distinguished}
        claim:
            ? forall candidate {distinguished}:
                candidate $in intersect(S, {distinguished})
            candidate = distinguished
            distinguished $in S
            candidate $in S
            candidate $in {distinguished}

thm finite_set_member_has_distinct_member:
    ? forall S nonempty_set, distinguished S:
        $is_finite_set(S)
        finite_set_size(S) >= 2
        =>:
            exist other S st {other != distinguished}
    release thm finite_set_intersect_member_singleton(S, distinguished)
    $is_finite_set({distinguished})
    $is_finite_set(intersect(S, {distinguished}))
    finite_set_size({distinguished}) = 1
    finite_set_size(intersect(S, {distinguished})) = finite_set_size({distinguished}) = 1
    $is_finite_set(set_minus(S, {distinguished}))
    finite_set_size(set_minus(S, {distinguished})) = finite_set_size(S) - finite_set_size(intersect(S, {distinguished}))
    finite_set_size(set_minus(S, {distinguished})) = finite_set_size(S) - finite_set_size(intersect(S, {distinguished})) = finite_set_size(S) - 1 >= 1
    $is_nonempty_set(set_minus(S, {distinguished}))
    have other set_minus(S, {distinguished})
    witness exist result S st {result != distinguished} from other:
        other $in S
        not other $in {distinguished}
        claim:
            ? other != distinguished
            by contra:
                ? other != distinguished
                other = distinguished
                other $in {distinguished}
                impossible not other $in {distinguished}

thm cauchy_fixed_point_has_nonidentity:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
        =>:
            exist candidate \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> st {candidate != \cauchy_constant_tuple<p, G>(group.one)}
    release thm cauchy_fixed_point_count_at_least_prime(G, group, p)
    p >= 2
    finite_set_size(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>) >= p >= 2
    release thm cauchy_group_power_one(G, group, p)
    release thm cauchy_constant_product_tuple_relation(G, group, p, group.one)
    release thm cauchy_constant_product_tuple_is_fixed(G, group, p, group.one)
    \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> = {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)}
    release thm set_builder_member(\cauchy_constant_product_tuple<G, group, p, group.one>(0), {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)})
    \cauchy_constant_product_tuple<G, group, p, group.one>(0) $in \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>
    have fixed_identity \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> = \cauchy_constant_product_tuple<G, group, p, group.one>(0)
    release thm finite_set_member_has_distinct_member(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>, fixed_identity)
    obtain candidate from exist other \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> st {other != fixed_identity}
    witness exist result \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> st {result != \cauchy_constant_tuple<p, G>(group.one)} from candidate:
        claim:
            ? candidate != \cauchy_constant_tuple<p, G>(group.one)
            by contra:
                ? candidate != \cauchy_constant_tuple<p, G>(group.one)
                candidate = \cauchy_constant_tuple<p, G>(group.one) = \cauchy_constant_product_tuple<G, group, p, group.one>(0) = fixed_identity
                impossible candidate != fixed_identity

thm cauchy_nontrivial_prime_power_element:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
        =>:
            exist x G st {x != group.one, \cauchy_group_power<G, group>(x, p) = group.one}
    release thm cauchy_fixed_point_has_nonidentity(G, group, p)
    obtain candidate from exist fixed_candidate \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> st {fixed_candidate != \cauchy_constant_tuple<p, G>(group.one)}
    \action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>> = {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)}
    candidate $in {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)}
    release thm set_builder_member(candidate, {fixed_candidate \cauchy_product_one_tuples<G, group, p>: $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, fixed_candidate)})
    $action_fixed_point(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>, candidate)
    have x G = candidate(\cyclic_zero<p>)
    claim:
        ? candidate = \cauchy_constant_tuple<p, G>(x)
        claim:
            ? forall index \cyclic_indices<p>:
                candidate(index) = \cauchy_constant_tuple<p, G>(x)(index)
            release thm cauchy_fixed_tuple_is_constant(G, group, p, candidate, index)
            release thm cauchy_constant_tuple_apply(p, G, x, index)
            candidate(index) = candidate(\cyclic_zero<p>) = x = \cauchy_constant_tuple<p, G>(x)(index)
        by def:
            ? $fn_eq(candidate, \cauchy_constant_tuple<p, G>(x))
    \cauchy_product_one_tuples<G, group, p> = {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)}
    candidate $in {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)}
    release thm set_builder_member(candidate, {tuple_candidate fn(index \cyclic_indices<p>) G: $cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    $cauchy_tuple_product_one(G, group, p, candidate)
    $cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
    release thm cauchy_constant_tuple_power_from_product_one(G, group, p, x)
    claim:
        ? x != group.one
        by contra:
            ? x != group.one
            x = group.one
            candidate = \cauchy_constant_tuple<p, G>(x) = \cauchy_constant_tuple<p, G>(group.one)
            impossible candidate != \cauchy_constant_tuple<p, G>(group.one)
    witness exist result G st {result != group.one, \cauchy_group_power<G, group>(result, p) = group.one} from x:
        x != group.one
        \cauchy_group_power<G, group>(x, p) = group.one


# Powers of one element form a homomorphism from the explicit cyclic group.

thm cauchy_group_power_add:
    ? forall G nonempty_set, group &chap2::Group<G>, x G, left, right N:
        \cauchy_group_power<G, group>(x, left + right) = group.mul(\cauchy_group_power<G, group>(x, left), \cauchy_group_power<G, group>(x, right))
    by def:
        ? $chap2::group_laws(G, group.mul, group.one, group.inv)
    by induc right from 0:
        ? \cauchy_group_power<G, group>(x, left + right) = group.mul(\cauchy_group_power<G, group>(x, left), \cauchy_group_power<G, group>(x, right))
        ? from right = 0:
            release thm cauchy_group_power_zero(G, group, x)
            release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, \cauchy_group_power<G, group>(x, left))
            left + 0 = left
            \cauchy_group_power<G, group>(x, left + 0) = \cauchy_group_power<G, group>(x, left) = group.mul(\cauchy_group_power<G, group>(x, left), group.one) = group.mul(\cauchy_group_power<G, group>(x, left), \cauchy_group_power<G, group>(x, 0))
        ? induc:
            left + (right + 1) = (left + right) + 1
            release thm cauchy_group_power_succ(G, group, x, left + right)
            release thm cauchy_group_power_succ(G, group, x, right)
            \cauchy_group_power<G, group>(x, left + (right + 1)) = \cauchy_group_power<G, group>(x, (left + right) + 1) = group.mul(\cauchy_group_power<G, group>(x, left + right), x) = group.mul(group.mul(\cauchy_group_power<G, group>(x, left), \cauchy_group_power<G, group>(x, right)), x)
            group.mul(group.mul(\cauchy_group_power<G, group>(x, left), \cauchy_group_power<G, group>(x, right)), x) = group.mul(\cauchy_group_power<G, group>(x, left), group.mul(\cauchy_group_power<G, group>(x, right), x)) = group.mul(\cauchy_group_power<G, group>(x, left), \cauchy_group_power<G, group>(x, right + 1))

thm cauchy_group_power_period:
    ? forall G nonempty_set, group &chap2::Group<G>, x G, p N+, n N:
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            \cauchy_group_power<G, group>(x, n + p) = \cauchy_group_power<G, group>(x, n)
    release thm cauchy_group_power_add(G, group, x, n, p)
    release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, \cauchy_group_power<G, group>(x, n))
    \cauchy_group_power<G, group>(x, n + p) = group.mul(\cauchy_group_power<G, group>(x, n), \cauchy_group_power<G, group>(x, p)) = group.mul(\cauchy_group_power<G, group>(x, n), group.one) = \cauchy_group_power<G, group>(x, n)

template<G nonempty_set, group &chap2::Group<G>, p N+, x G>:
    have fn cauchy_power_map(index \cyclic_indices<p>) G = \cauchy_group_power<G, group>(x, abs(index))

thm cauchy_power_map_zero:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        \cauchy_power_map<G, group, p, x>(\cyclic_zero<p>) = group.one
    release thm cyclic_zero_apply(p)
    abs(\cyclic_zero<p>) = abs(0) = 0
    release thm cauchy_group_power_zero(G, group, x)
    \cauchy_power_map<G, group, p, x>(\cyclic_zero<p>) = \cauchy_group_power<G, group>(x, abs(\cyclic_zero<p>)) = \cauchy_group_power<G, group>(x, 0) = group.one

thm cauchy_power_map_add:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G, left, right \cyclic_indices<p>:
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            \cauchy_power_map<G, group, p, x>(\cyclic_add<p>(left, right)) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))
    \cyclic_indices<p> = closed_range(0, p - 1)
    0 <= left <= p - 1
    0 <= right <= p - 1
    abs(left) = left
    abs(right) = right
    left + right >= 0
    abs(left + right) = left + right
    have natural_sum N = abs(left + right)
    natural_sum = left + right
    release thm cyclic_add_apply(p, left, right)
    release thm cauchy_group_power_add(G, group, x, abs(left), abs(right))
    left + right < p or left + right >= p
    by cases:
        ? \cauchy_power_map<G, group, p, x>(\cyclic_add<p>(left, right)) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))
        case left + right < p:
            natural_sum = p * 0 + natural_sum
            natural_sum % p = natural_sum
            (left + right) % p = natural_sum % p = natural_sum = left + right
            \cyclic_add<p>(left, right) = (left + right) % p = left + right
            abs(\cyclic_add<p>(left, right)) = left + right
            \cauchy_power_map<G, group, p, x>(\cyclic_add<p>(left, right)) = \cauchy_group_power<G, group>(x, left + right) = \cauchy_group_power<G, group>(x, abs(left) + abs(right)) = group.mul(\cauchy_group_power<G, group>(x, abs(left)), \cauchy_group_power<G, group>(x, abs(right))) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))
        case left + right >= p:
            left + right <= (p - 1) + (p - 1) = 2 * p - 2 < 2 * p
            left + right - p >= 0
            abs(left + right - p) = left + right - p
            have remainder N = abs(left + right - p)
            remainder = left + right - p
            remainder = left + right - p < 2 * p - p = p
            natural_sum = left + right = p * 1 + (left + right - p) = p * 1 + remainder
            natural_sum % p = remainder
            (left + right) % p = natural_sum % p = remainder
            \cyclic_add<p>(left, right) = (left + right) % p = remainder
            abs(\cyclic_add<p>(left, right)) = remainder
            remainder + p = left + right
            release thm cauchy_group_power_period(G, group, x, p, remainder)
            \cauchy_group_power<G, group>(x, remainder) = \cauchy_group_power<G, group>(x, remainder + p) = \cauchy_group_power<G, group>(x, left + right)
            \cauchy_power_map<G, group, p, x>(\cyclic_add<p>(left, right)) = \cauchy_group_power<G, group>(x, remainder) = \cauchy_group_power<G, group>(x, left + right) = \cauchy_group_power<G, group>(x, abs(left) + abs(right)) = group.mul(\cauchy_group_power<G, group>(x, abs(left)), \cauchy_group_power<G, group>(x, abs(right))) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))

thm cauchy_power_map_is_group_hom:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $is_group_hom(\cyclic_indices<p>, G, \cyclic_prime_group<p>, group, \cauchy_power_map<G, group, p, x>)
    release thm cauchy_power_map_zero(G, group, p, x)
    claim:
        ? forall left, right \cyclic_indices<p>:
            \cauchy_power_map<G, group, p, x>(\cyclic_add<p>(left, right)) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))
        release thm cauchy_power_map_add(G, group, p, x, left, right)
    by def:
        ? $is_monoid_hom(\cyclic_indices<p>, G, \cyclic_add<p>, \cyclic_zero<p>, group.mul, group.one, \cauchy_power_map<G, group, p, x>)
    \cyclic_prime_group<p>.mul = \cyclic_add<p>
    \cyclic_prime_group<p>.one = \cyclic_zero<p>
    \cauchy_power_map<G, group, p, x>(\cyclic_prime_group<p>.one) = \cauchy_power_map<G, group, p, x>(\cyclic_zero<p>) = group.one
    claim:
        ? forall left, right \cyclic_indices<p>:
            \cauchy_power_map<G, group, p, x>(\cyclic_prime_group<p>.mul(left, right)) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))
        \cyclic_prime_group<p>.mul(left, right) = \cyclic_add<p>(left, right)
        release thm cauchy_power_map_add(G, group, p, x, left, right)
        \cauchy_power_map<G, group, p, x>(\cyclic_prime_group<p>.mul(left, right)) = \cauchy_power_map<G, group, p, x>(\cyclic_add<p>(left, right)) = group.mul(\cauchy_power_map<G, group, p, x>(left), \cauchy_power_map<G, group, p, x>(right))
    by def:
        ? $is_monoid_hom(\cyclic_indices<p>, G, \cyclic_prime_group<p>.mul, \cyclic_prime_group<p>.one, group.mul, group.one, \cauchy_power_map<G, group, p, x>)
    by def:
        ? $is_group_hom(\cyclic_indices<p>, G, \cyclic_prime_group<p>, group, \cauchy_power_map<G, group, p, x>)


thm positive_prime_divisor_at_least_two_is_prime:
    ? forall p, divisor N+:
        $prime(p)
        $chap2::divides(divisor, p)
        divisor >= 2
        =>:
            divisor = p
    obtain quotient from $chap2::divides(divisor, p)
    p = divisor * quotient
    release thm chap2::_positive_divisor_le_abs(divisor, p)
    abs(p) = p
    divisor <= p
    divisor = p or divisor < p
    by cases:
        ? divisor = p
        case divisor = p:
            divisor = p
        case divisor < p:
            divisor <= p - 1
            divisor $in closed_range(2, p - 1)
            by def $prime(p)
            p % divisor != 0
            p % divisor = (divisor * quotient) % divisor = 0
            impossible p % divisor != 0


# A finite subset with the same cardinality as its ambient finite set is the
# whole set.  This is the finite-set step used to rule out a nontrivial kernel.

thm finite_subset_equal_of_same_size:
    ? forall A, B set:
        $is_finite_set(A)
        $is_finite_set(B)
        A $subset B
        finite_set_size(A) = finite_set_size(B)
        =>:
            A = B
    claim:
        ? intersect(B, A) = A
        by extension:
            ? intersect(B, A) = A
            claim:
                ? forall x intersect(B, A):
                    x $in A
                x $in A
            claim:
                ? forall x A:
                    x $in intersect(B, A)
                x $in B
                x $in A
    $is_finite_set(set_minus(B, A))
    finite_set_size(set_minus(B, A)) = finite_set_size(B) - finite_set_size(intersect(B, A)) = finite_set_size(B) - finite_set_size(A) = 0
    by extension:
        ? A = B
        claim:
            ? forall x A:
                x $in B
            x $in B
        claim:
            ? forall x B:
                x $in A
            by contra:
                ? x $in A
                not x $in A
                x $in set_minus(B, A)
                witness $is_nonempty_set(set_minus(B, A)) from x
                finite_set_size(set_minus(B, A)) >= 1
                impossible finite_set_size(set_minus(B, A)) = 0

thm cauchy_power_kernel_is_trivial:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $prime(p)
        x != group.one
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> = {\cyclic_zero<p>}
    release thm cauchy_power_map_is_group_hom(G, group, p, x)
    release thm group_kernel_closed(\cyclic_indices<p>, G, \cyclic_prime_group<p>, group, \cauchy_power_map<G, group, p, x>)
    claim:
        ? \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> $subset \cyclic_indices<p>
    release thm cyclic_indices_are_finite(p)
    release thm subset_of_finite_set_is_finite(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>, \cyclic_indices<p>)
    release thm subgroup_order_divides_group_order(\cyclic_indices<p>, \cyclic_prime_group<p>, \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>)
    release thm cyclic_indices_have_prime_size(p)
    $chap2::divides(finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>), p)
    \cyclic_prime_group<p>.one = \cyclic_zero<p>
    \cyclic_prime_group<p>.one $in \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>
    witness $is_nonempty_set(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) from \cyclic_prime_group<p>.one
    finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) >= 1
    finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) = 1 or finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) > 1
    by cases:
        ? \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> = {\cyclic_zero<p>}
        case finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) = 1:
            release thm subgroup_eq_bottom_iff_order_one_forward(\cyclic_indices<p>, \cyclic_prime_group<p>, \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>)
            \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> = {\cyclic_prime_group<p>.one} = {\cyclic_zero<p>}
        case finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) > 1:
            finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) >= 2
            release thm positive_prime_divisor_at_least_two_is_prime(p, finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>))
            finite_set_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>) = p = finite_set_size(\cyclic_indices<p>)
            release thm finite_subset_equal_of_same_size(\group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>, \cyclic_indices<p>)
            \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> = \cyclic_indices<p>
            p >= 2
            1 <= p - 1
            1 $in closed_range(0, p - 1) = \cyclic_indices<p>
            have one_index \cyclic_indices<p> = 1
            one_index $in \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>>
            \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> = {candidate \cyclic_indices<p>: \cauchy_power_map<G, group, p, x>(candidate) = group.one}
            one_index $in {candidate \cyclic_indices<p>: \cauchy_power_map<G, group, p, x>(candidate) = group.one}
            release thm set_builder_member(one_index, {candidate \cyclic_indices<p>: \cauchy_power_map<G, group, p, x>(candidate) = group.one})
            \cauchy_power_map<G, group, p, x>(one_index) = group.one
            abs(one_index) = abs(1) = 1
            release thm cauchy_group_power_succ(G, group, x, 0)
            release thm cauchy_group_power_zero(G, group, x)
            \cauchy_group_power<G, group>(x, 1) = group.mul(\cauchy_group_power<G, group>(x, 0), x) = group.mul(group.one, x) = x
            \cauchy_power_map<G, group, p, x>(one_index) = \cauchy_group_power<G, group>(x, abs(one_index)) = \cauchy_group_power<G, group>(x, 1) = x
            x = group.one
            impossible x != group.one

thm group_hom_injective_of_trivial_kernel:
    ? forall G, H nonempty_set, source &chap2::Group<G>, target &chap2::Group<H>, f fn(x G) H:
        $is_group_hom(G, H, source, target, f)
        \group_kernel<G, H, target.one, f> = {source.one}
        =>:
            $injective(G, H, f)
    claim:
        ? forall left, right G:
            f(left) = f(right)
            =>:
                left = right
        release thm group_hom_map_inv(G, H, source, target, f, left)
        release thm group_hom_map_mul(G, H, source, target, f, source.inv(left), right)
        by def:
            ? $chap2::group_laws(H, target.mul, target.one, target.inv)
        target.mul(target.inv(f(left)), f(left)) = target.one
        f(source.mul(source.inv(left), right)) = target.mul(f(source.inv(left)), f(right)) = target.mul(target.inv(f(left)), f(right)) = target.mul(target.inv(f(left)), f(left)) = target.one
        \group_kernel<G, H, target.one, f> = {candidate G: f(candidate) = target.one}
        release thm set_builder_member(source.mul(source.inv(left), right), {candidate G: f(candidate) = target.one})
        source.mul(source.inv(left), right) $in \group_kernel<G, H, target.one, f> = {source.one}
        source.mul(source.inv(left), right) = source.one
        by def:
            ? $chap2::group_laws(G, source.mul, source.one, source.inv)
        release thm group_mul_inv_cancel(G, source, left)
        release thm chap2::mul_one_structure(G, source.mul, source.one, source.inv, left)
        source.mul(left, source.mul(source.inv(left), right)) = source.mul(source.mul(left, source.inv(left)), right) = source.mul(source.one, right) = right
        source.mul(left, source.mul(source.inv(left), right)) = source.mul(left, source.one) = left
        left = right
    by def:
        ? $injective(G, H, f)

thm cauchy_power_map_is_injective:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $prime(p)
        x != group.one
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $injective(\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>)
    release thm cauchy_power_map_is_group_hom(G, group, p, x)
    release thm cauchy_power_kernel_is_trivial(G, group, p, x)
    \cyclic_prime_group<p>.one = \cyclic_zero<p>
    \group_kernel<\cyclic_indices<p>, G, group.one, \cauchy_power_map<G, group, p, x>> = {\cyclic_zero<p>} = {\cyclic_prime_group<p>.one}
    release thm group_hom_injective_of_trivial_kernel(\cyclic_indices<p>, G, \cyclic_prime_group<p>, group, \cauchy_power_map<G, group, p, x>)


# The Chapter 9 group range is the ordinary function range.  Stating this
# bridge explicitly lets finite-image cardinality discharge the order proof.

thm group_range_eq_fn_range:
    ? forall G, H set, f fn(x G) H:
        \group_range<G, H, f> = fn_range(f)
    \group_range<G, H, f> = \subgroup_map<G, H, f>(G) = {y H: $has_subgroup_map_preimage(G, H, f, G, y)}
    by extension:
        ? \group_range<G, H, f> = fn_range(f)
        claim:
            ? forall y \group_range<G, H, f>:
                y $in fn_range(f)
            y $in {target H: $has_subgroup_map_preimage(G, H, f, G, target)}
            release thm set_builder_member(y, {target H: $has_subgroup_map_preimage(G, H, f, G, target)})
            by def:
                ? $has_subgroup_map_preimage(G, H, f, G, y)
            obtain x from $has_subgroup_map_preimage(G, H, f, G, y)
            f(x) = y
            f(x) $in fn_range(f)
            y $in fn_range(f)
        claim:
            ? forall y fn_range(f):
                y $in \group_range<G, H, f>
            have by preimage x from y $in fn_range(f)
            witness $has_subgroup_map_preimage(G, H, f, G, y) from x:
                x $in G
                f(x) = y
            release thm set_builder_member(y, {target H: $has_subgroup_map_preimage(G, H, f, G, target)})
            y $in {target H: $has_subgroup_map_preimage(G, H, f, G, target)} = \group_range<G, H, f>

thm cauchy_power_range_is_prime_subgroup:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, x G:
        $is_finite_set(G)
        $prime(p)
        x != group.one
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $is_subgroup(G, group, \group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>)
            $is_finite_set(\group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>)
            finite_set_size(\group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>) = p
    release thm cauchy_power_map_is_group_hom(G, group, p, x)
    release thm group_range_closed(\cyclic_indices<p>, G, \cyclic_prime_group<p>, group, \cauchy_power_map<G, group, p, x>)
    release thm cauchy_power_map_is_injective(G, group, p, x)
    release thm cyclic_indices_are_finite(p)
    $is_finite_set(fn_range(\cauchy_power_map<G, group, p, x>))
    release thm finite_injection_range_cardinality(\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>)
    release thm cyclic_indices_have_prime_size(p)
    finite_set_size(fn_range(\cauchy_power_map<G, group, p, x>)) = finite_set_size(\cyclic_indices<p>) = p
    release thm group_range_eq_fn_range(\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>)
    \group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>> = fn_range(\cauchy_power_map<G, group, p, x>)
    $is_finite_set(\group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>)
    finite_set_size(\group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>) = finite_set_size(fn_range(\cauchy_power_map<G, group, p, x>)) = p

thm cauchy_prime_subgroup_exists:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
        =>:
            exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p}
    release thm cauchy_nontrivial_prime_power_element(G, group, p)
    obtain x from exist element G st {element != group.one, \cauchy_group_power<G, group>(element, p) = group.one}
    release thm cauchy_power_range_is_prime_subgroup(G, group, p, x)
    have H power_set(G) = \group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>
    witness exist subgroup_candidate power_set(G) st {$is_subgroup(G, group, subgroup_candidate), $is_finite_set(subgroup_candidate), finite_set_size(subgroup_candidate) = p} from H:
        H = \group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        finite_set_size(H) = finite_set_size(\group_range<\cyclic_indices<p>, G, \cauchy_power_map<G, group, p, x>>) = p


# Cauchy's theorem with only the mathematical hypotheses exposed.  The
# finiteness of the tuple carrier and its fixed-point set are consequences,
# not extra assumptions for downstream uses.

thm cauchy_prime_subgroup_exists_auto:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p, finite_set_size(G))
        =>:
            exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p}
    release thm cauchy_product_one_tuple_count(G, group, p)
    $is_finite_set(\cauchy_product_one_tuples<G, group, p>)
    release thm action_fixed_points_are_finite(\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>)
    $is_finite_set(\action_fixed_points<\cyclic_indices<p>, \cauchy_product_one_tuples<G, group, p>, \cauchy_rotate<G, group, p>>)
    release thm cauchy_prime_subgroup_exists(G, group, p)


# The normalizer records both conjugation directions explicitly.  This makes
# its subgroup structure visible without appealing to a hidden group library.

prop normalizes_subgroup(G nonempty_set, group &chap2::Group<G>, H power_set(G), g G):
    forall h G:
        h $in H
        =>:
            group.mul(group.mul(g, h), group.inv(g)) $in H
    forall h G:
        h $in H
        =>:
            group.mul(group.mul(group.inv(g), h), g) $in H

template<G nonempty_set, group &chap2::Group<G>>:
    have fn subgroup_normalizer(H power_set(G)) power_set(G) = {g G: $normalizes_subgroup(G, group, H, g)}

thm subgroup_member_normalizer:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        g $in H
        =>:
            g $in \subgroup_normalizer<G, group>(H)
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(g, h), group.inv(g)) $in H
        group.mul(g, h) $in H
        group.inv(g) $in H
        group.mul(group.mul(g, h), group.inv(g)) $in H
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(group.inv(g), h), g) $in H
        group.inv(g) $in H
        group.mul(group.inv(g), h) $in H
        group.mul(group.mul(group.inv(g), h), g) $in H
    by def:
        ? $normalizes_subgroup(G, group, H, g)
    release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
    g $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)

thm subgroup_subset_normalizer:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            H $subset \subgroup_normalizer<G, group>(H)
    claim:
        ? forall h H:
            h $in \subgroup_normalizer<G, group>(H)
        release thm subgroup_member_normalizer(G, group, H, h)

thm subgroup_normalizer_closed:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
    release thm subgroup_member_normalizer(G, group, H, group.one)
    group.one $in \subgroup_normalizer<G, group>(H)
    claim:
        ? forall a, b G:
            a $in \subgroup_normalizer<G, group>(H)
            b $in \subgroup_normalizer<G, group>(H)
            =>:
                group.mul(a, b) $in \subgroup_normalizer<G, group>(H)
        release thm set_builder_member(a, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        release thm set_builder_member(b, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        by def:
            ? $normalizes_subgroup(G, group, H, a)
        by def:
            ? $normalizes_subgroup(G, group, H, b)
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.mul(a, b), h), group.inv(group.mul(a, b))) $in H
            group.mul(group.mul(b, h), group.inv(b)) $in H
            group.mul(group.mul(a, group.mul(group.mul(b, h), group.inv(b))), group.inv(a)) $in H
            release thm chap2::mul_inv_rev_structure(G, group.mul, group.one, group.inv, a, b)
            group.inv(group.mul(a, b)) = group.mul(group.inv(b), group.inv(a))
            group.mul(group.mul(group.mul(a, b), h), group.inv(group.mul(a, b))) = group.mul(group.mul(group.mul(a, b), h), group.mul(group.inv(b), group.inv(a)))
            group.mul(group.mul(a, b), h) = group.mul(a, group.mul(b, h))
            release thm object_substitution(G, G, fn(t G) G {group.mul(t, group.mul(group.inv(b), group.inv(a)))}, group.mul(group.mul(a, b), h), group.mul(a, group.mul(b, h)))
            group.mul(group.mul(group.mul(a, b), h), group.mul(group.inv(b), group.inv(a))) = group.mul(group.mul(a, group.mul(b, h)), group.mul(group.inv(b), group.inv(a)))
            group.mul(group.mul(a, group.mul(b, h)), group.mul(group.inv(b), group.inv(a))) = group.mul(a, group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a))))
            group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a))) = group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a))
            release thm object_substitution(G, G, fn(t G) G {group.mul(a, t)}, group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a))), group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a)))
            group.mul(a, group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a)))) = group.mul(a, group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a)))
            group.mul(a, group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a))) = group.mul(group.mul(a, group.mul(group.mul(b, h), group.inv(b))), group.inv(a))
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.inv(group.mul(a, b)), h), group.mul(a, b)) $in H
            group.mul(group.mul(group.inv(a), h), a) $in H
            group.mul(group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), a)), b) $in H
            release thm chap2::mul_inv_rev_structure(G, group.mul, group.one, group.inv, a, b)
            group.inv(group.mul(a, b)) = group.mul(group.inv(b), group.inv(a))
            group.mul(group.mul(group.inv(group.mul(a, b)), h), group.mul(a, b)) = group.mul(group.mul(group.mul(group.inv(b), group.inv(a)), h), group.mul(a, b))
            group.mul(group.mul(group.inv(b), group.inv(a)), h) = group.mul(group.inv(b), group.mul(group.inv(a), h))
            release thm object_substitution(G, G, fn(t G) G {group.mul(t, group.mul(a, b))}, group.mul(group.mul(group.inv(b), group.inv(a)), h), group.mul(group.inv(b), group.mul(group.inv(a), h)))
            group.mul(group.mul(group.mul(group.inv(b), group.inv(a)), h), group.mul(a, b)) = group.mul(group.mul(group.inv(b), group.mul(group.inv(a), h)), group.mul(a, b))
            group.mul(group.mul(group.inv(b), group.mul(group.inv(a), h)), group.mul(a, b)) = group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), group.mul(a, b)))
            group.mul(group.mul(group.inv(a), h), group.mul(a, b)) = group.mul(group.mul(group.mul(group.inv(a), h), a), b)
            release thm object_substitution(G, G, fn(t G) G {group.mul(group.inv(b), t)}, group.mul(group.mul(group.inv(a), h), group.mul(a, b)), group.mul(group.mul(group.mul(group.inv(a), h), a), b))
            group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), group.mul(a, b))) = group.mul(group.inv(b), group.mul(group.mul(group.mul(group.inv(a), h), a), b))
            group.mul(group.inv(b), group.mul(group.mul(group.mul(group.inv(a), h), a), b)) = group.mul(group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), a)), b)
        by def:
            ? $normalizes_subgroup(G, group, H, group.mul(a, b))
        release thm set_builder_member(group.mul(a, b), {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        group.mul(a, b) $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)
    claim:
        ? forall g G:
            g $in \subgroup_normalizer<G, group>(H)
            =>:
                group.inv(g) $in \subgroup_normalizer<G, group>(H)
        release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        by def:
            ? $normalizes_subgroup(G, group, H, g)
        release thm group_inv_inv(G, group, g)
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.inv(g), h), group.inv(group.inv(g))) $in H
            group.mul(group.mul(group.inv(g), h), g) $in H
            group.inv(group.inv(g)) = g
            group.mul(group.mul(group.inv(g), h), group.inv(group.inv(g))) = group.mul(group.mul(group.inv(g), h), g)
            group.mul(group.mul(group.inv(g), h), group.inv(group.inv(g))) $in H
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.inv(group.inv(g)), h), group.inv(g)) $in H
            group.mul(group.mul(g, h), group.inv(g)) $in H
            group.inv(group.inv(g)) = g
            group.mul(group.mul(group.inv(group.inv(g)), h), group.inv(g)) = group.mul(group.mul(g, h), group.inv(g))
            group.mul(group.mul(group.inv(group.inv(g)), h), group.inv(g)) $in H
        by def:
            ? $normalizes_subgroup(G, group, H, group.inv(g))
        release thm set_builder_member(group.inv(g), {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        group.inv(g) $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)
    by def:
        ? $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))

thm subgroup_normalizer_finite:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_finite_set(G)
        =>:
            $is_finite_set(\subgroup_normalizer<G, group>(H))
    \subgroup_normalizer<G, group>(H) $subset G
    release thm subset_of_finite_set_is_finite(\subgroup_normalizer<G, group>(H), G)

thm subgroup_normal_in_normalizer:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
    release thm subgroup_normalizer_closed(G, group, H)
    release thm subgroup_subset_normalizer(G, group, H)
    release thm nested_subgroup_closed(G, group, H, \subgroup_normalizer<G, group>(H))
    $is_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
    claim:
        ? forall g, h \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>:
            h $in H
            =>:
                \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(g, h), \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.inv(g)) $in H
        g $in \subgroup_normalizer<G, group>(H)
        release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        by def:
            ? $normalizes_subgroup(G, group, H, g)
        \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul = \subgroup_mul<G, group, \subgroup_normalizer<G, group>(H)>
        \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.inv = \subgroup_inv<G, group, \subgroup_normalizer<G, group>(H)>
        \subgroup_mul<G, group, \subgroup_normalizer<G, group>(H)>(g, h) = group.mul(g, h)
        \subgroup_inv<G, group, \subgroup_normalizer<G, group>(H)>(g) = group.inv(g)
        \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(g, h), \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.inv(g)) = group.mul(group.mul(g, h), group.inv(g))
        group.mul(group.mul(g, h), group.inv(g)) $in H
    by def:
        ? $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)


# In a finite subgroup, one-sided conjugation containment is automatically an
# equality.  The proof exposes the finite injective self-map argument.

prop conjugates_back_into_subgroup(G nonempty_set, group &chap2::Group<G>, H power_set(G), g G):
    forall h G:
        h $in H
        =>:
            group.mul(group.mul(group.inv(g), h), g) $in H

template<G nonempty_set, group &chap2::Group<G>, H power_set(G), g G: $is_subgroup(G, group, H), $conjugates_back_into_subgroup(G, group, H, g)>:
    have fn subgroup_conjugate_back(h H) H = group.mul(group.mul(group.inv(g), h), g)

thm group_right_cancel_explicit:
    ? forall G nonempty_set, group &chap2::Group<G>, a, b, c G:
        group.mul(a, c) = group.mul(b, c)
        =>:
            a = b
    release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, c)
    group.mul(c, group.inv(c)) = group.one
    release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, a)
    release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, b)
    group.mul(group.mul(a, c), group.inv(c)) = group.mul(group.mul(b, c), group.inv(c))
    group.mul(group.mul(a, c), group.inv(c)) = group.mul(a, group.mul(c, group.inv(c))) = group.mul(a, group.one) = a
    group.mul(group.mul(b, c), group.inv(c)) = group.mul(b, group.mul(c, group.inv(c))) = group.mul(b, group.one) = b
    a = b

thm finite_subset_contains_ambient_member:
    ? forall A, B set, x B:
        $is_finite_set(A)
        $is_finite_set(B)
        A $subset B
        finite_set_size(A) = finite_set_size(B)
        =>:
            x $in A
    claim:
        ? intersect(B, A) = A
        by extension:
            ? intersect(B, A) = A
            claim:
                ? forall intersection_x intersect(B, A):
                    intersection_x $in A
                intersection_x $in A
            claim:
                ? forall ambient_x A:
                    ambient_x $in intersect(B, A)
                ambient_x $in B
                ambient_x $in A
    $is_finite_set(set_minus(B, A))
    finite_set_size(set_minus(B, A)) = finite_set_size(B) - finite_set_size(intersect(B, A)) = finite_set_size(B) - finite_set_size(A) = 0
    by contra:
        ? x $in A
        not x $in A
        x $in B
        x $in set_minus(B, A)
        witness $is_nonempty_set(set_minus(B, A)) from x
        finite_set_size(set_minus(B, A)) >= 1
        impossible finite_set_size(set_minus(B, A)) = 0

thm subgroup_conjugate_back_injective:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        $conjugates_back_into_subgroup(G, group, H, g)
        =>:
            $injective(H, H, \subgroup_conjugate_back<G, group, H, g>)
    claim:
        ? forall x, y H:
            \subgroup_conjugate_back<G, group, H, g>(x) = \subgroup_conjugate_back<G, group, H, g>(y)
            =>:
                x = y
        \subgroup_conjugate_back<G, group, H, g>(x) = group.mul(group.mul(group.inv(g), x), g)
        \subgroup_conjugate_back<G, group, H, g>(y) = group.mul(group.mul(group.inv(g), y), g)
        group.mul(group.mul(group.inv(g), x), g) = group.mul(group.mul(group.inv(g), y), g)
        release thm group_right_cancel_explicit(G, group, group.mul(group.inv(g), x), group.mul(group.inv(g), y), g)
        group.mul(group.inv(g), x) = group.mul(group.inv(g), y)
        release thm chap2::_group_left_cancel_structure(G, group.mul, group.one, group.inv, group.inv(g), x, y)
        x = y
    by def:
        ? $injective(H, H, \subgroup_conjugate_back<G, group, H, g>)

thm finite_one_sided_normalizer_promotes:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        $conjugates_back_into_subgroup(G, group, H, g)
        =>:
            $normalizes_subgroup(G, group, H, g)
    release thm subgroup_conjugate_back_injective(G, group, H, g)
    $is_finite_set(fn_range(\subgroup_conjugate_back<G, group, H, g>))
    release thm finite_injection_range_cardinality(H, H, \subgroup_conjugate_back<G, group, H, g>)
    finite_set_size(fn_range(\subgroup_conjugate_back<G, group, H, g>)) = finite_set_size(H)
    fn_range(\subgroup_conjugate_back<G, group, H, g>) $subset H
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(g, h), group.inv(g)) $in H
        release thm finite_subset_contains_ambient_member(fn_range(\subgroup_conjugate_back<G, group, H, g>), H, h)
        h $in fn_range(\subgroup_conjugate_back<G, group, H, g>)
        have by preimage k from h $in fn_range(\subgroup_conjugate_back<G, group, H, g>)
        k $in H
        \subgroup_conjugate_back<G, group, H, g>(k) = h
        \subgroup_conjugate_back<G, group, H, g>(k) = group.mul(group.mul(group.inv(g), k), g)
        h = group.mul(group.mul(group.inv(g), k), g)
        release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, g)
        group.mul(g, group.inv(g)) = group.one
        group.mul(g, h) = group.mul(g, group.mul(group.mul(group.inv(g), k), g))
        group.mul(g, group.mul(group.mul(group.inv(g), k), g)) = group.mul(group.mul(g, group.mul(group.inv(g), k)), g)
        group.mul(g, group.mul(group.inv(g), k)) = group.mul(group.mul(g, group.inv(g)), k)
        group.mul(group.mul(g, group.inv(g)), k) = group.mul(group.one, k) = k
        group.mul(g, group.mul(group.inv(g), k)) = k
        release thm object_substitution(G, G, fn(t G) G {group.mul(t, g)}, group.mul(g, group.mul(group.inv(g), k)), k)
        group.mul(group.mul(g, group.mul(group.inv(g), k)), g) = group.mul(k, g)
        group.mul(g, h) = group.mul(group.mul(g, group.mul(group.inv(g), k)), g) = group.mul(k, g)
        group.mul(group.mul(g, h), group.inv(g)) = group.mul(group.mul(k, g), group.inv(g))
        group.mul(group.mul(k, g), group.inv(g)) = group.mul(k, group.mul(g, group.inv(g)))
        release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, k)
        group.mul(k, group.mul(g, group.inv(g))) = group.mul(k, group.one) = k
        group.mul(group.mul(g, h), group.inv(g)) = k
        group.mul(group.mul(g, h), group.inv(g)) $in H
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(group.inv(g), h), g) $in H
        by def:
            ? $conjugates_back_into_subgroup(G, group, H, g)
    by def:
        ? $normalizes_subgroup(G, group, H, g)


# The subgroup H acts on the left-coset space G/H by left multiplication.
# A selected representative makes the function callable; the proof below
# shows that the result is independent enough to satisfy the action laws.

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn sylow_coset_action(h \subgroup_carrier<G, group, H>, q \quotient_group_carrier<G, group>(H)) \quotient_group_carrier<G, group>(H) = \left_coset_projection<G, group, H>(group.mul(h, \left_coset_representative<G, group, H>(q)))

thm sylow_coset_action_is_group_action:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        =>:
            $is_group_action(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \subgroup_group<G, group, H>, \sylow_coset_action<G, group, H>)
    claim:
        ? forall q \quotient_group_carrier<G, group>(H):
            \sylow_coset_action<G, group, H>(\subgroup_group<G, group, H>.one, q) = q
        \subgroup_group<G, group, H>.one = \subgroup_one<G, group, H> = group.one
        \sylow_coset_action<G, group, H>(\subgroup_group<G, group, H>.one, q) = \left_coset_projection<G, group, H>(group.mul(group.one, \left_coset_representative<G, group, H>(q)))
        group.mul(group.one, \left_coset_representative<G, group, H>(q)) = \left_coset_representative<G, group, H>(q)
        release thm object_substitution(G, \quotient_group_carrier<G, group>(H), \left_coset_projection<G, group, H>, group.mul(group.one, \left_coset_representative<G, group, H>(q)), \left_coset_representative<G, group, H>(q))
        \left_coset_projection<G, group, H>(group.mul(group.one, \left_coset_representative<G, group, H>(q))) = \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q))
        release thm left_coset_representative_spec(G, group, H, q)
        \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q)) = q
    claim:
        ? forall a, b \subgroup_carrier<G, group, H>, q \quotient_group_carrier<G, group>(H):
            \sylow_coset_action<G, group, H>(a, \sylow_coset_action<G, group, H>(b, q)) = \sylow_coset_action<G, group, H>(\subgroup_group<G, group, H>.mul(a, b), q)
        have r \quotient_group_carrier<G, group>(H) = \sylow_coset_action<G, group, H>(b, q)
        \sylow_coset_action<G, group, H>(b, q) = \left_coset_projection<G, group, H>(group.mul(b, \left_coset_representative<G, group, H>(q)))
        r = \sylow_coset_action<G, group, H>(b, q)
        r = \left_coset_projection<G, group, H>(group.mul(b, \left_coset_representative<G, group, H>(q)))
        release thm left_coset_representative_spec(G, group, H, r)
        \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(r)) = r = \left_coset_projection<G, group, H>(group.mul(b, \left_coset_representative<G, group, H>(q)))
        release thm left_coset_center_mem(G, group, H, \left_coset_representative<G, group, H>(r))
        \left_coset_representative<G, group, H>(r) $in \left_coset<G, group>(H, \left_coset_representative<G, group, H>(r))
        \left_coset<G, group>(H, \left_coset_representative<G, group, H>(r)) = \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(r)) = \left_coset_projection<G, group, H>(group.mul(b, \left_coset_representative<G, group, H>(q))) = \left_coset<G, group>(H, group.mul(b, \left_coset_representative<G, group, H>(q)))
        \left_coset_representative<G, group, H>(r) $in \left_coset<G, group>(H, group.mul(b, \left_coset_representative<G, group, H>(q)))
        obtain offset from $left_coset_member(G, group, H, group.mul(b, \left_coset_representative<G, group, H>(q)), \left_coset_representative<G, group, H>(r))
        offset $in H
        \left_coset_representative<G, group, H>(r) = group.mul(group.mul(b, \left_coset_representative<G, group, H>(q)), offset)
        \subgroup_group<G, group, H>.mul(a, b) = \subgroup_mul<G, group, H>(a, b) = group.mul(a, b)
        claim:
            ? group.mul(a, \left_coset_representative<G, group, H>(r)) $in \left_coset<G, group>(H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)))
            \left_coset<G, group>(H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q))) = {x G: $left_coset_member(G, group, H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)), x)}
            witness $left_coset_member(G, group, H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)), group.mul(a, \left_coset_representative<G, group, H>(r))) from offset:
                release thm object_substitution(G, G, fn(t G) G {group.mul(a, t)}, \left_coset_representative<G, group, H>(r), group.mul(group.mul(b, \left_coset_representative<G, group, H>(q)), offset))
                group.mul(a, \left_coset_representative<G, group, H>(r)) = group.mul(a, group.mul(group.mul(b, \left_coset_representative<G, group, H>(q)), offset))
                group.mul(a, group.mul(group.mul(b, \left_coset_representative<G, group, H>(q)), offset)) = group.mul(group.mul(a, group.mul(b, \left_coset_representative<G, group, H>(q))), offset)
                group.mul(a, group.mul(b, \left_coset_representative<G, group, H>(q))) = group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q))
                release thm object_substitution(G, G, fn(t G) G {group.mul(t, offset)}, group.mul(a, group.mul(b, \left_coset_representative<G, group, H>(q))), group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)))
                group.mul(group.mul(a, group.mul(b, \left_coset_representative<G, group, H>(q))), offset) = group.mul(group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)), offset)
                group.mul(a, \left_coset_representative<G, group, H>(r)) = group.mul(group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)), offset)
            release thm set_builder_member(group.mul(a, \left_coset_representative<G, group, H>(r)), {x G: $left_coset_member(G, group, H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)), x)})
        release thm left_coset_eq_of_mem(G, group, H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)), group.mul(a, \left_coset_representative<G, group, H>(r)))
        \left_coset_projection<G, group, H>(group.mul(a, \left_coset_representative<G, group, H>(r))) = \left_coset<G, group>(H, group.mul(a, \left_coset_representative<G, group, H>(r))) = \left_coset<G, group>(H, group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q))) = \left_coset_projection<G, group, H>(group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)))
        \sylow_coset_action<G, group, H>(a, \sylow_coset_action<G, group, H>(b, q)) = \sylow_coset_action<G, group, H>(a, r) = \left_coset_projection<G, group, H>(group.mul(a, \left_coset_representative<G, group, H>(r)))
        \sylow_coset_action<G, group, H>(\subgroup_group<G, group, H>.mul(a, b), q) = \left_coset_projection<G, group, H>(group.mul(group.mul(a, b), \left_coset_representative<G, group, H>(q)))
    by def:
        ? $is_group_action(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \subgroup_group<G, group, H>, \sylow_coset_action<G, group, H>)


# Fixed left cosets for the H-action are exactly the cosets represented by the
# normalizer.  Both directions are proved from the explicit representative.

thm normalizer_coset_is_fixed:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        g $in \subgroup_normalizer<G, group>(H)
        =>:
            $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, \left_coset_projection<G, group, H>(g))
    release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
    by def:
        ? $normalizes_subgroup(G, group, H, g)
    have q \quotient_group_carrier<G, group>(H) = \left_coset_projection<G, group, H>(g)
    release thm left_coset_representative_spec(G, group, H, q)
    release thm left_coset_center_mem(G, group, H, \left_coset_representative<G, group, H>(q))
    \left_coset_representative<G, group, H>(q) $in \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q))
    \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q)) = \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q)) = q = \left_coset_projection<G, group, H>(g) = \left_coset<G, group>(H, g)
    \left_coset_representative<G, group, H>(q) $in \left_coset<G, group>(H, g)
    obtain tail from $left_coset_member(G, group, H, g, \left_coset_representative<G, group, H>(q))
    tail $in H
    \left_coset_representative<G, group, H>(q) = group.mul(g, tail)
    claim:
        ? forall h \subgroup_carrier<G, group, H>:
            \sylow_coset_action<G, group, H>(h, q) = q
        h $in H
        group.mul(group.mul(group.inv(g), h), g) $in H
        have moved G = group.mul(group.mul(group.inv(g), h), g)
        moved $in H
        group.mul(moved, tail) $in H
        claim:
            ? group.mul(h, \left_coset_representative<G, group, H>(q)) $in \left_coset<G, group>(H, g)
            \left_coset<G, group>(H, g) = {x G: $left_coset_member(G, group, H, g, x)}
            witness $left_coset_member(G, group, H, g, group.mul(h, \left_coset_representative<G, group, H>(q))) from group.mul(moved, tail):
                release thm chap2::mul_inv_cancel_structure(G, group.mul, group.one, group.inv, g)
                group.mul(g, moved) = group.mul(g, group.mul(group.mul(group.inv(g), h), g))
                group.mul(g, group.mul(group.mul(group.inv(g), h), g)) = group.mul(group.mul(g, group.mul(group.inv(g), h)), g)
                group.mul(g, group.mul(group.inv(g), h)) = group.mul(group.mul(g, group.inv(g)), h)
                group.mul(group.mul(g, group.inv(g)), h) = group.mul(group.one, h) = h
                group.mul(g, group.mul(group.inv(g), h)) = h
                release thm object_substitution(G, G, fn(t G) G {group.mul(t, g)}, group.mul(g, group.mul(group.inv(g), h)), h)
                group.mul(group.mul(g, group.mul(group.inv(g), h)), g) = group.mul(h, g)
                group.mul(g, moved) = group.mul(h, g)
                group.mul(h, g) = group.mul(g, moved)
                release thm object_substitution(G, G, fn(t G) G {group.mul(t, tail)}, group.mul(h, g), group.mul(g, moved))
                release thm object_substitution(G, G, fn(t G) G {group.mul(h, t)}, \left_coset_representative<G, group, H>(q), group.mul(g, tail))
                group.mul(h, \left_coset_representative<G, group, H>(q)) = group.mul(h, group.mul(g, tail))
                group.mul(h, group.mul(g, tail)) = group.mul(group.mul(h, g), tail)
                group.mul(group.mul(h, g), tail) = group.mul(group.mul(g, moved), tail)
                group.mul(group.mul(g, moved), tail) = group.mul(g, group.mul(moved, tail))
            release thm set_builder_member(group.mul(h, \left_coset_representative<G, group, H>(q)), {x G: $left_coset_member(G, group, H, g, x)})
        release thm left_coset_eq_of_mem(G, group, H, g, group.mul(h, \left_coset_representative<G, group, H>(q)))
        \left_coset_projection<G, group, H>(group.mul(h, \left_coset_representative<G, group, H>(q))) = \left_coset<G, group>(H, group.mul(h, \left_coset_representative<G, group, H>(q))) = \left_coset<G, group>(H, g) = \left_coset_projection<G, group, H>(g) = q
        \sylow_coset_action<G, group, H>(h, q) = \left_coset_projection<G, group, H>(group.mul(h, \left_coset_representative<G, group, H>(q))) = q
    by def:
        ? $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)

thm fixed_coset_representative_in_normalizer:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), q \quotient_group_carrier<G, group>(H):
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)
        =>:
            \left_coset_representative<G, group, H>(q) $in \subgroup_normalizer<G, group>(H)
    have g G = \left_coset_representative<G, group, H>(q)
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(group.inv(g), h), g) $in H
        have refined_h \subgroup_carrier<G, group, H> = h
        by def:
            ? $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)
        \sylow_coset_action<G, group, H>(refined_h, q) = q
        \sylow_coset_action<G, group, H>(refined_h, q) = \left_coset_projection<G, group, H>(group.mul(h, g))
        release thm left_coset_representative_spec(G, group, H, q)
        release thm object_substitution(G, \quotient_group_carrier<G, group>(H), \left_coset_projection<G, group, H>, g, \left_coset_representative<G, group, H>(q))
        \left_coset_projection<G, group, H>(g) = \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q))
        \left_coset_projection<G, group, H>(g) = q
        \left_coset<G, group>(H, group.mul(h, g)) = \left_coset_projection<G, group, H>(group.mul(h, g)) = q = \left_coset_projection<G, group, H>(g) = \left_coset<G, group>(H, g)
        release thm left_coset_center_mem(G, group, H, group.mul(h, g))
        group.mul(h, g) $in \left_coset<G, group>(H, group.mul(h, g)) = \left_coset<G, group>(H, g)
        obtain offset from $left_coset_member(G, group, H, g, group.mul(h, g))
        offset $in H
        group.mul(h, g) = group.mul(g, offset)
        group.mul(group.mul(group.inv(g), h), g) = group.mul(group.inv(g), group.mul(h, g))
        release thm object_substitution(G, G, fn(t G) G {group.mul(group.inv(g), t)}, group.mul(h, g), group.mul(g, offset))
        group.mul(group.inv(g), group.mul(h, g)) = group.mul(group.inv(g), group.mul(g, offset))
        group.mul(group.inv(g), group.mul(g, offset)) = group.mul(group.mul(group.inv(g), g), offset)
        group.mul(group.inv(g), g) = group.one
        release thm object_substitution(G, G, fn(t G) G {group.mul(t, offset)}, group.mul(group.inv(g), g), group.one)
        group.mul(group.mul(group.inv(g), g), offset) = group.mul(group.one, offset) = offset
        group.mul(group.mul(group.inv(g), h), g) = offset
        group.mul(group.mul(group.inv(g), h), g) $in H
    by def:
        ? $conjugates_back_into_subgroup(G, group, H, g)
    release thm finite_one_sided_normalizer_promotes(G, group, H, g)
    $normalizes_subgroup(G, group, H, g)
    release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
    g $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)

thm fixed_coset_center_in_normalizer:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g G:
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, \left_coset_projection<G, group, H>(g))
        =>:
            g $in \subgroup_normalizer<G, group>(H)
    have q \quotient_group_carrier<G, group>(H) = \left_coset_projection<G, group, H>(g)
    release thm fixed_coset_representative_in_normalizer(G, group, H, q)
    \left_coset_representative<G, group, H>(q) $in \subgroup_normalizer<G, group>(H)
    release thm left_coset_representative_spec(G, group, H, q)
    release thm left_coset_center_mem(G, group, H, g)
    g $in \left_coset<G, group>(H, g)
    \left_coset<G, group>(H, g) = \left_coset_projection<G, group, H>(g) = q = \left_coset_projection<G, group, H>(\left_coset_representative<G, group, H>(q)) = \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q))
    g $in \left_coset<G, group>(H, \left_coset_representative<G, group, H>(q))
    obtain tail from $left_coset_member(G, group, H, \left_coset_representative<G, group, H>(q), g)
    tail $in H
    g = group.mul(\left_coset_representative<G, group, H>(q), tail)
    release thm subgroup_subset_normalizer(G, group, H)
    tail $in \subgroup_normalizer<G, group>(H)
    release thm subgroup_normalizer_closed(G, group, H)
    group.mul(\left_coset_representative<G, group, H>(q), tail) $in \subgroup_normalizer<G, group>(H)
    g $in \subgroup_normalizer<G, group>(H)


# Restrict the ordinary coset-coordinate bijection G <-> (G/H) x H to
# N_G(H) <-> (fixed cosets) x H.

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have sylow_fixed_cosets power_set(\quotient_group_carrier<G, group>(H)) = \action_fixed_points<\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>>

thm normalizer_fixed_forward_pair_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g \subgroup_normalizer<G, group>(H):
        $is_subgroup(G, group, H)
        =>:
            (\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g)) $in cart(\sylow_fixed_cosets<G, group, H>, H)
    release thm normalizer_coset_is_fixed(G, group, H, g)
    release thm set_builder_member(\left_coset_projection<G, group, H>(g), {q \quotient_group_carrier<G, group>(H): $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)})
    \left_coset_projection<G, group, H>(g) $in {q \quotient_group_carrier<G, group>(H): $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)} = \action_fixed_points<\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>> = \sylow_fixed_cosets<G, group, H>
    \left_coset_coordinate<G, group, H>(g) $in H
    release thm cart_member_from_coordinates((\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g)), cart(\sylow_fixed_cosets<G, group, H>, H))

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H)>:
    have fn normalizer_fixed_forward(g \subgroup_normalizer<G, group>(H)) cart(\sylow_fixed_cosets<G, group, H>, H) = (\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g))

thm normalizer_fixed_backward_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), pair cart(\quotient_group_carrier<G, group>(H), H):
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        pair[1] $in \sylow_fixed_cosets<G, group, H>
        =>:
            group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2]) $in \subgroup_normalizer<G, group>(H)
    pair[1] $in \sylow_fixed_cosets<G, group, H> = \action_fixed_points<\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>>
    \action_fixed_points<\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>> = {q \quotient_group_carrier<G, group>(H): $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)}
    release thm set_builder_member(pair[1], {q \quotient_group_carrier<G, group>(H): $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, q)})
    $action_fixed_point(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>, pair[1])
    release thm fixed_coset_representative_in_normalizer(G, group, H, pair[1])
    \left_coset_representative<G, group, H>(pair[1]) $in \subgroup_normalizer<G, group>(H)
    pair[2] $in H
    release thm subgroup_subset_normalizer(G, group, H)
    pair[2] $in \subgroup_normalizer<G, group>(H)
    release thm subgroup_normalizer_closed(G, group, H)
    group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2]) $in \subgroup_normalizer<G, group>(H)

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H), $is_finite_set(H)>:
    have fn normalizer_fixed_backward by exist!:
        ? forall pair cart(\sylow_fixed_cosets<G, group, H>, H):
            exist! output \subgroup_normalizer<G, group>(H) st {output = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])}
        pair[1] $in \sylow_fixed_cosets<G, group, H>
        pair[1] $in \quotient_group_carrier<G, group>(H)
        pair[2] $in H
        release thm cart_member_from_coordinates((pair[1], pair[2]), cart(\quotient_group_carrier<G, group>(H), H))
        have broad_pair cart(\quotient_group_carrier<G, group>(H), H) = (pair[1], pair[2])
        broad_pair[1] = pair[1]
        broad_pair[2] = pair[2]
        broad_pair[1] $in \sylow_fixed_cosets<G, group, H>
        release thm normalizer_fixed_backward_mem(G, group, H, broad_pair)
        group.mul(\left_coset_representative<G, group, H>(broad_pair[1]), broad_pair[2]) $in \subgroup_normalizer<G, group>(H)
        release thm object_substitution(\quotient_group_carrier<G, group>(H), G, \left_coset_representative<G, group, H>, broad_pair[1], pair[1])
        \left_coset_representative<G, group, H>(broad_pair[1]) = \left_coset_representative<G, group, H>(pair[1])
        release thm object_substitution(G, G, fn(t G) G {group.mul(t, broad_pair[2])}, \left_coset_representative<G, group, H>(broad_pair[1]), \left_coset_representative<G, group, H>(pair[1]))
        group.mul(\left_coset_representative<G, group, H>(broad_pair[1]), broad_pair[2]) = group.mul(\left_coset_representative<G, group, H>(pair[1]), broad_pair[2])
        release thm object_substitution(G, G, fn(t G) G {group.mul(\left_coset_representative<G, group, H>(pair[1]), t)}, broad_pair[2], pair[2])
        group.mul(\left_coset_representative<G, group, H>(pair[1]), broad_pair[2]) = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])
        group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2]) $in \subgroup_normalizer<G, group>(H)
        have selected_output \subgroup_normalizer<G, group>(H) = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])
        claim:
            ? forall output1, output2 \subgroup_normalizer<G, group>(H):
                output1 = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])
                output2 = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])
                =>:
                    output1 = output2
            output1 = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2]) = output2
        witness exist! output \subgroup_normalizer<G, group>(H) st {output = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2])} from selected_output

thm normalizer_fixed_backward_forward:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), g \subgroup_normalizer<G, group>(H):
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        =>:
            \normalizer_fixed_backward<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)) = g
    \normalizer_fixed_forward<G, group, H>(g) = (\left_coset_projection<G, group, H>(g), \left_coset_coordinate<G, group, H>(g))
    \normalizer_fixed_forward<G, group, H>(g)[1] = \left_coset_projection<G, group, H>(g)
    \normalizer_fixed_forward<G, group, H>(g)[2] = \left_coset_coordinate<G, group, H>(g)
    \normalizer_fixed_backward<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)) = group.mul(\left_coset_representative<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)[1]), \normalizer_fixed_forward<G, group, H>(g)[2])
    release thm object_substitution(\quotient_group_carrier<G, group>(H), G, \left_coset_representative<G, group, H>, \normalizer_fixed_forward<G, group, H>(g)[1], \left_coset_projection<G, group, H>(g))
    \left_coset_representative<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)[1]) = \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g))
    release thm object_substitution(G, G, fn(t G) G {group.mul(t, \normalizer_fixed_forward<G, group, H>(g)[2])}, \left_coset_representative<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)[1]), \left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)))
    group.mul(\left_coset_representative<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)[1]), \normalizer_fixed_forward<G, group, H>(g)[2]) = group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), \normalizer_fixed_forward<G, group, H>(g)[2])
    release thm object_substitution(G, G, fn(t G) G {group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), t)}, \normalizer_fixed_forward<G, group, H>(g)[2], \left_coset_coordinate<G, group, H>(g))
    group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), \normalizer_fixed_forward<G, group, H>(g)[2]) = group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), \left_coset_coordinate<G, group, H>(g))
    group.mul(\left_coset_representative<G, group, H>(\left_coset_projection<G, group, H>(g)), \left_coset_coordinate<G, group, H>(g)) = \left_coset_backward<G, group, H>(\left_coset_forward<G, group, H>(g))
    release thm left_coset_backward_forward(G, group, H, g)
    \left_coset_backward<G, group, H>(\left_coset_forward<G, group, H>(g)) = g

thm normalizer_fixed_forward_bijective:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        $is_finite_set(H)
        =>:
            $bijective(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>)
    claim:
        ? $chap4::is_left_inverse(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>, \normalizer_fixed_backward<G, group, H>)
        claim:
            ? forall g \subgroup_normalizer<G, group>(H):
                \normalizer_fixed_backward<G, group, H>(\normalizer_fixed_forward<G, group, H>(g)) = g
            release thm normalizer_fixed_backward_forward(G, group, H, g)
        by def:
            ? $chap4::is_left_inverse(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>, \normalizer_fixed_backward<G, group, H>)
    release thm chap4::injective_of_left_inverse(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>, \normalizer_fixed_backward<G, group, H>)
    claim:
        ? $chap4::is_right_inverse(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>, \normalizer_fixed_backward<G, group, H>)
        claim:
            ? forall pair cart(\sylow_fixed_cosets<G, group, H>, H):
                \normalizer_fixed_forward<G, group, H>(\normalizer_fixed_backward<G, group, H>(pair)) = pair
            pair[1] $in \quotient_group_carrier<G, group>(H)
            pair[2] $in H
            release thm cart_member_from_coordinates((pair[1], pair[2]), cart(\quotient_group_carrier<G, group>(H), H))
            have broad_pair cart(\quotient_group_carrier<G, group>(H), H) = (pair[1], pair[2])
            \left_coset_backward<G, group, H>(broad_pair) = group.mul(\left_coset_representative<G, group, H>(pair[1]), pair[2]) = \normalizer_fixed_backward<G, group, H>(pair)
            release thm left_coset_forward_backward(G, group, H, broad_pair)
            broad_pair = (pair[1], pair[2]) = pair
            \left_coset_forward<G, group, H>(\left_coset_backward<G, group, H>(broad_pair)) = broad_pair = pair
            \normalizer_fixed_forward<G, group, H>(\normalizer_fixed_backward<G, group, H>(pair)) = (\left_coset_projection<G, group, H>(\normalizer_fixed_backward<G, group, H>(pair)), \left_coset_coordinate<G, group, H>(\normalizer_fixed_backward<G, group, H>(pair))) = \left_coset_forward<G, group, H>(\left_coset_backward<G, group, H>(broad_pair)) = pair
        by def:
            ? $chap4::is_right_inverse(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>, \normalizer_fixed_backward<G, group, H>)
    release thm chap4::surjective_of_right_inverse(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>, \normalizer_fixed_backward<G, group, H>)
    by def:
        ? $bijective(\subgroup_normalizer<G, group>(H), cart(\sylow_fixed_cosets<G, group, H>, H), \normalizer_fixed_forward<G, group, H>)

thm normalizer_cardinality_via_fixed_cosets:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $is_finite_set(\sylow_fixed_cosets<G, group, H>)
            finite_set_size(\subgroup_normalizer<G, group>(H)) = finite_set_size(\sylow_fixed_cosets<G, group, H>) * finite_set_size(H)
    release thm left_coset_space_finite(G, group, H)
    release thm action_fixed_points_are_finite(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>)
    $is_finite_set(\sylow_fixed_cosets<G, group, H>)
    release thm subgroup_normalizer_finite(G, group, H)
    release thm normalizer_fixed_forward_bijective(G, group, H)
    $is_finite_set(cart(\sylow_fixed_cosets<G, group, H>, H))
    finite_set_size(\subgroup_normalizer<G, group>(H)) = finite_set_size(cart(\sylow_fixed_cosets<G, group, H>, H)) = finite_set_size(\sylow_fixed_cosets<G, group, H>) * finite_set_size(H)


# The next p-power in |G| survives after dividing by a subgroup of order p^k.

thm finite_group_coset_cardinality_product:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $is_finite_set(\quotient_group_carrier<G, group>(H))
            finite_set_size(G) = finite_set_size(\quotient_group_carrier<G, group>(H)) * finite_set_size(H)
    release thm left_coset_space_finite(G, group, H)
    release thm left_coset_forward_bijective(G, group, H)
    $is_finite_set(cart(\quotient_group_carrier<G, group>(H), H))
    finite_set_size(G) = finite_set_size(cart(\quotient_group_carrier<G, group>(H), H)) = finite_set_size(\quotient_group_carrier<G, group>(H)) * finite_set_size(H)

thm next_prime_power_divides_coset_count:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), p N+, k N:
        $is_subgroup(G, group, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $is_finite_set(\quotient_group_carrier<G, group>(H))
        $prime(p)
        finite_set_size(H) = p^k
        $chap2::divides(p^(k + 1), finite_set_size(G))
        =>:
            $chap2::divides(p, finite_set_size(\quotient_group_carrier<G, group>(H)))
    release thm finite_group_coset_cardinality_product(G, group, H)
    finite_set_size(G) = finite_set_size(\quotient_group_carrier<G, group>(H)) * finite_set_size(H) = finite_set_size(\quotient_group_carrier<G, group>(H)) * p^k = p^k * finite_set_size(\quotient_group_carrier<G, group>(H))
    obtain quotient from $chap2::divides(p^(k + 1), finite_set_size(G))
    finite_set_size(G) = p^(k + 1) * quotient
    p^(k + 1) > 0
    finite_set_size(G) >= 1
    finite_set_size(G) > 0
    by cases:
        ? $chap2::divides(p, finite_set_size(\quotient_group_carrier<G, group>(H)))
        case quotient > 0:
            have positive_quotient N+ = quotient
            release thm object_substitution(Z, Z, fn(t Z) Z {p^(k + 1) * t}, positive_quotient, quotient)
            p^(k + 1) * positive_quotient = p^(k + 1) * quotient = finite_set_size(G)
            p^(k + 1) = p^k * p
            release thm object_substitution(Z, Z, fn(t Z) Z {t * positive_quotient}, p^(k + 1), p^k * p)
            p^k * (p * positive_quotient) = p^(k + 1) * positive_quotient = finite_set_size(G) = p^k * finite_set_size(\quotient_group_carrier<G, group>(H))
            p^k != 0
            release thm chap5::integer_left_multiplication_cancellation(p^k, p * positive_quotient, finite_set_size(\quotient_group_carrier<G, group>(H)))
            p * positive_quotient = finite_set_size(\quotient_group_carrier<G, group>(H))
            witness $chap2::divides(p, finite_set_size(\quotient_group_carrier<G, group>(H))) from positive_quotient
        case quotient = 0:
            finite_set_size(G) = p^(k + 1) * quotient = 0
            finite_set_size(G) > 0
            impossible finite_set_size(G) > 0
        case quotient < 0:
            p^(k + 1) * quotient < 0
            finite_set_size(G) = p^(k + 1) * quotient < 0
            finite_set_size(G) >= 0
            impossible finite_set_size(G) < 0

thm sylow_fixed_coset_count_divisible:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), p N+, k N:
        $is_subgroup(G, group, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $is_finite_set(\quotient_group_carrier<G, group>(H))
        $is_finite_set(\sylow_fixed_cosets<G, group, H>)
        $prime(p)
        finite_set_size(H) = p^k
        $chap2::divides(p^(k + 1), finite_set_size(G))
        =>:
            $chap2::divides(p, finite_set_size(\sylow_fixed_cosets<G, group, H>))
    release thm finite_group_coset_cardinality_product(G, group, H)
    release thm sylow_coset_action_is_group_action(G, group, H)
    release thm action_fixed_points_are_finite(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \sylow_coset_action<G, group, H>)
    $is_finite_set(\sylow_fixed_cosets<G, group, H>)
    finite_set_size(\subgroup_carrier<G, group, H>) = finite_set_size(H) = p^k
    release thm finite_p_group_fixed_point_congruence(\subgroup_carrier<G, group, H>, \quotient_group_carrier<G, group>(H), \subgroup_group<G, group, H>, \sylow_coset_action<G, group, H>, p, k)
    $chap2::divides(p, finite_set_size(\quotient_group_carrier<G, group>(H)) - finite_set_size(\sylow_fixed_cosets<G, group, H>))
    release thm next_prime_power_divides_coset_count(G, group, H, p, k)
    obtain total_quotient from $chap2::divides(p, finite_set_size(\quotient_group_carrier<G, group>(H)))
    obtain defect_quotient from $chap2::divides(p, finite_set_size(\quotient_group_carrier<G, group>(H)) - finite_set_size(\sylow_fixed_cosets<G, group, H>))
    \sylow_fixed_cosets<G, group, H> $subset \quotient_group_carrier<G, group>(H)
    finite_set_size(\sylow_fixed_cosets<G, group, H>) <= finite_set_size(\quotient_group_carrier<G, group>(H))
    finite_set_size(\quotient_group_carrier<G, group>(H)) - finite_set_size(\sylow_fixed_cosets<G, group, H>) + finite_set_size(\sylow_fixed_cosets<G, group, H>) = finite_set_size(\quotient_group_carrier<G, group>(H))
    finite_set_size(\quotient_group_carrier<G, group>(H)) = p * total_quotient
    finite_set_size(\quotient_group_carrier<G, group>(H)) - finite_set_size(\sylow_fixed_cosets<G, group, H>) = p * defect_quotient
    finite_set_size(\sylow_fixed_cosets<G, group, H>) = finite_set_size(\quotient_group_carrier<G, group>(H)) - (finite_set_size(\quotient_group_carrier<G, group>(H)) - finite_set_size(\sylow_fixed_cosets<G, group, H>)) = p * total_quotient - p * defect_quotient = p * (total_quotient - defect_quotient)
    witness $chap2::divides(p, finite_set_size(\sylow_fixed_cosets<G, group, H>)) from total_quotient - defect_quotient


# The quotient projection is an explicit homomorphism, and the normalizer
# quotient has the same cardinality as the fixed-coset set.

thm quotient_group_mk_is_group_hom:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_normal_subgroup(G, group, H)
        =>:
            $is_group_hom(G, \quotient_group_nonempty<G, group, H>, group, \quotient_group<G, group, H>, \quotient_group_mk<G, group, H>)
    \quotient_group<G, group, H>.one = \quotient_group_one<G, group, H> = \quotient_group_mk<G, group, H>(group.one)
    \quotient_group_mk<G, group, H>(group.one) = \quotient_group<G, group, H>.one
    claim:
        ? forall x, y G:
            \quotient_group_mk<G, group, H>(group.mul(x, y)) = \quotient_group<G, group, H>.mul(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y))
        \quotient_group<G, group, H>.mul = \quotient_group_mul<G, group, H>
        \quotient_group<G, group, H>.mul(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)) = \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y))
        release thm quotient_group_mul_mk(G, group, H, x, y)
        \quotient_group_mul<G, group, H>(\quotient_group_mk<G, group, H>(x), \quotient_group_mk<G, group, H>(y)) = \quotient_group_mk<G, group, H>(group.mul(x, y))
    by def:
        ? $is_monoid_hom(G, \quotient_group_nonempty<G, group, H>, group.mul, group.one, \quotient_group<G, group, H>.mul, \quotient_group<G, group, H>.one, \quotient_group_mk<G, group, H>)
    by def:
        ? $is_group_hom(G, \quotient_group_nonempty<G, group, H>, group, \quotient_group<G, group, H>, \quotient_group_mk<G, group, H>)

thm normalizer_quotient_cardinality_eq_fixed_cosets:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G):
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $is_finite_set(\sylow_fixed_cosets<G, group, H>)
            $is_finite_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
            finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\sylow_fixed_cosets<G, group, H>)
    release thm subgroup_normalizer_closed(G, group, H)
    release thm subgroup_normalizer_finite(G, group, H)
    release thm subgroup_normal_in_normalizer(G, group, H)
    \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)> = \subgroup_normalizer<G, group>(H)
    $is_finite_set(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>)
    release thm finite_group_coset_cardinality_product(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
    $is_finite_set(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H))
    \quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H> = \quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H)
    $is_finite_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
    finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H))
    finite_set_size(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>) = finite_set_size(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H)) * finite_set_size(H) = finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) * finite_set_size(H)
    release thm normalizer_cardinality_via_fixed_cosets(G, group, H)
    finite_set_size(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>) = finite_set_size(\subgroup_normalizer<G, group>(H)) = finite_set_size(\sylow_fixed_cosets<G, group, H>) * finite_set_size(H)
    group.one $in H
    $is_nonempty_set(H)
    finite_set_size(H) >= 1
    finite_set_size(H) != 0
    finite_set_size(H) * finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) * finite_set_size(H) = finite_set_size(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>) = finite_set_size(\sylow_fixed_cosets<G, group, H>) * finite_set_size(H) = finite_set_size(H) * finite_set_size(\sylow_fixed_cosets<G, group, H>)
    release thm chap5::integer_left_multiplication_cancellation(finite_set_size(H), finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>), finite_set_size(\sylow_fixed_cosets<G, group, H>))
    finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\sylow_fixed_cosets<G, group, H>)

thm normalizer_quotient_order_divisible_by_prime:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), p N+, k N:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $prime(p)
        finite_set_size(H) = p^k
        $chap2::divides(p^(k + 1), finite_set_size(G))
        =>:
            $is_finite_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
            $chap2::divides(p, finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>))
    release thm normalizer_quotient_cardinality_eq_fixed_cosets(G, group, H)
    release thm finite_group_coset_cardinality_product(G, group, H)
    release thm sylow_fixed_coset_count_divisible(G, group, H, p, k)
    finite_set_size(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\sylow_fixed_cosets<G, group, H>)

thm normalizer_quotient_has_prime_subgroup:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), p N+, k N:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $prime(p)
        finite_set_size(H) = p^k
        $chap2::divides(p^(k + 1), finite_set_size(G))
        =>:
            exist K power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) st {$is_subgroup(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, \quotient_group<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, K), $is_finite_set(K), finite_set_size(K) = p}
    release thm subgroup_normalizer_closed(G, group, H)
    release thm subgroup_normal_in_normalizer(G, group, H)
    release thm normalizer_quotient_cardinality_eq_fixed_cosets(G, group, H)
    release thm normalizer_quotient_order_divisible_by_prime(G, group, H, p, k)
    release thm cauchy_prime_subgroup_exists_auto(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, \quotient_group<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, p)


# Pull a subgroup of N_G(H)/H back to an ambient subgroup of G.  Membership
# displays both the normalizer condition and the quotient-subgroup condition.

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H), $is_subgroup(G, group, \subgroup_normalizer<G, group>(H)), $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)>:
    have fn normalizer_quotient_projection(x G) \quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H> by cases:
        case x $in \subgroup_normalizer<G, group>(H): \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)
        case not x $in \subgroup_normalizer<G, group>(H): \quotient_group<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>.one

template<G nonempty_set, group &chap2::Group<G>, H power_set(G): $is_subgroup(G, group, H), $is_subgroup(G, group, \subgroup_normalizer<G, group>(H)), $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)>:
    have fn sylow_quotient_preimage(K power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)) power_set(G) = {x G: x $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(x) $in K}

# Atomic native-operation bridges for subgroups of quotient groups.

thm quotient_subgroup_one_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set:
        $is_normal_subgroup(G, group, H)
        K $in power_set(\quotient_group_nonempty<G, group, H>)
        $is_subgroup(\quotient_group_nonempty<G, group, H>, \quotient_group<G, group, H>, K)
        =>:
            \quotient_group_one<G, group, H> $in K
    \quotient_group<G, group, H> = (\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>)
    \quotient_group_one<G, group, H> $in K

thm quotient_subgroup_mul_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set, q, r power_set(G):
        $is_normal_subgroup(G, group, H)
        K $in power_set(\quotient_group_nonempty<G, group, H>)
        $is_subgroup(\quotient_group_nonempty<G, group, H>, \quotient_group<G, group, H>, K)
        q $in K
        r $in K
        =>:
            \quotient_group_mul<G, group, H>(q, r) $in K
    release thm subgroup_mul_mem(\quotient_group_nonempty<G, group, H>, \quotient_group<G, group, H>, K, q, r)
    \quotient_group<G, group, H>.mul(q, r) $in K
    \quotient_group<G, group, H> = (\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>)
    \quotient_group<G, group, H>.mul = \quotient_group_mul<G, group, H>
    \quotient_group_mul<G, group, H>(q, r) $in K

thm quotient_subgroup_inv_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set, q power_set(G):
        $is_normal_subgroup(G, group, H)
        K $in power_set(\quotient_group_nonempty<G, group, H>)
        $is_subgroup(\quotient_group_nonempty<G, group, H>, \quotient_group<G, group, H>, K)
        q $in K
        =>:
            \quotient_group_inv<G, group, H>(q) $in K
    release thm subgroup_inv_mem(\quotient_group_nonempty<G, group, H>, \quotient_group<G, group, H>, K, q)
    \quotient_group<G, group, H>.inv(q) $in K
    \quotient_group<G, group, H> = (\quotient_group_mul<G, group, H>, \quotient_group_one<G, group, H>, \quotient_group_inv<G, group, H>)
    \quotient_group<G, group, H>.inv = \quotient_group_inv<G, group, H>
    \quotient_group_inv<G, group, H>(q) $in K

# Atomic bridges from a quotient of an inherited subgroup to ambient
# coordinates.  B is a genuine subgroup parameter, not a renamed carrier.

thm subgroup_quotient_one_is_ambient:
    ? forall G nonempty_set, group &chap2::Group<G>, B, H power_set(G):
        $is_subgroup(G, group, B)
        $is_normal_subgroup(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H)
        =>:
            \quotient_group_one<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H> = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(group.one)
    \subgroup_group<G, group, B> = (\subgroup_mul<G, group, B>, \subgroup_one<G, group, B>, \subgroup_inv<G, group, B>)
    \subgroup_group<G, group, B>.one = \subgroup_one<G, group, B> = group.one
    \quotient_group_one<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H> = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\subgroup_group<G, group, B>.one)
    release thm object_substitution(\subgroup_carrier<G, group, B>, \quotient_group_nonempty<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>, \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>, \subgroup_group<G, group, B>.one, group.one)
    \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\subgroup_group<G, group, B>.one) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(group.one)

thm subgroup_quotient_mul_is_ambient:
    ? forall G nonempty_set, group &chap2::Group<G>, B, H power_set(G), x, y G:
        $is_subgroup(G, group, B)
        $is_normal_subgroup(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H)
        x $in B
        y $in B
        =>:
            \quotient_group_mul<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(x), \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(y)) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(group.mul(x, y))
    \subgroup_carrier<G, group, B> = B
    \subgroup_group<G, group, B> = (\subgroup_mul<G, group, B>, \subgroup_one<G, group, B>, \subgroup_inv<G, group, B>)
    \subgroup_group<G, group, B>.mul = \subgroup_mul<G, group, B>
    \subgroup_group<G, group, B>.mul(x, y) = \subgroup_mul<G, group, B>(x, y) = group.mul(x, y)
    release thm quotient_group_mul_mk(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H, x, y)
    release thm object_substitution(\subgroup_carrier<G, group, B>, \quotient_group_nonempty<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>, \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>, \subgroup_group<G, group, B>.mul(x, y), group.mul(x, y))
    \quotient_group_mul<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(x), \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(y)) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\subgroup_group<G, group, B>.mul(x, y)) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(group.mul(x, y))

thm subgroup_quotient_inv_is_ambient:
    ? forall G nonempty_set, group &chap2::Group<G>, B, H power_set(G), x G:
        $is_subgroup(G, group, B)
        $is_normal_subgroup(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H)
        x $in B
        =>:
            \quotient_group_inv<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(x)) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(group.inv(x))
    \subgroup_carrier<G, group, B> = B
    \subgroup_group<G, group, B> = (\subgroup_mul<G, group, B>, \subgroup_one<G, group, B>, \subgroup_inv<G, group, B>)
    \subgroup_group<G, group, B>.inv = \subgroup_inv<G, group, B>
    \subgroup_group<G, group, B>.inv(x) = \subgroup_inv<G, group, B>(x) = group.inv(x)
    release thm quotient_group_inv_mk(\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H, x)
    release thm object_substitution(\subgroup_carrier<G, group, B>, \quotient_group_nonempty<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>, \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>, \subgroup_group<G, group, B>.inv(x), group.inv(x))
    \quotient_group_inv<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(x)) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(\subgroup_group<G, group, B>.inv(x)) = \quotient_group_mk<\subgroup_carrier<G, group, B>, \subgroup_group<G, group, B>, H>(group.inv(x))

thm subgroup_group_mul_is_ambient:
    ? forall G nonempty_set, group &chap2::Group<G>, B power_set(G), x, y G:
        $is_subgroup(G, group, B)
        x $in B
        y $in B
        =>:
            \subgroup_group<G, group, B>.mul(x, y) = group.mul(x, y)
    \subgroup_group<G, group, B> = (\subgroup_mul<G, group, B>, \subgroup_one<G, group, B>, \subgroup_inv<G, group, B>)
    \subgroup_group<G, group, B>.mul = \subgroup_mul<G, group, B>
    \subgroup_group<G, group, B>.mul(x, y) = \subgroup_mul<G, group, B>(x, y) = group.mul(x, y)

thm sylow_quotient_preimage_closed:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
        $is_subgroup(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, \quotient_group<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, K)
        =>:
            $is_subgroup(G, group, \sylow_quotient_preimage<G, group, H>(K))
    release thm subgroup_normalizer_closed(G, group, H)
    release thm quotient_subgroup_one_mem(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H, K)
    release thm subgroup_quotient_one_is_ambient(G, group, \subgroup_normalizer<G, group>(H), H)
    group.one $in \subgroup_normalizer<G, group>(H)
    \quotient_group_one<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H> $in K
    \quotient_group_one<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H> = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.one)
    \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.one) $in K
    \normalizer_quotient_projection<G, group, H>(group.one) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.one)
    group.one $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(group.one) $in K
    release thm set_builder_member(group.one, {x G: x $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(x) $in K})
    group.one $in \sylow_quotient_preimage<G, group, H>(K)
    claim:
        ? forall x, y G:
            x $in \sylow_quotient_preimage<G, group, H>(K)
            y $in \sylow_quotient_preimage<G, group, H>(K)
            =>:
                group.mul(x, y) $in \sylow_quotient_preimage<G, group, H>(K)
        release thm set_builder_member(x, {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        release thm set_builder_member(y, {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        x $in \subgroup_normalizer<G, group>(H)
        y $in \subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(x) $in K
        \normalizer_quotient_projection<G, group, H>(y) $in K
        \normalizer_quotient_projection<G, group, H>(x) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)
        \normalizer_quotient_projection<G, group, H>(y) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(y)
        \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) $in K
        \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(y) $in K
        release thm quotient_subgroup_mul_mem(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H, K, \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(y))
        release thm subgroup_quotient_mul_is_ambient(G, group, \subgroup_normalizer<G, group>(H), H, x, y)
        \quotient_group_mul<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(y)) $in K
        \quotient_group_mul<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(y)) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.mul(x, y))
        \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.mul(x, y)) $in K
        group.mul(x, y) $in \subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(group.mul(x, y)) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.mul(x, y))
        \normalizer_quotient_projection<G, group, H>(group.mul(x, y)) $in K
        group.mul(x, y) $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(group.mul(x, y)) $in K
        release thm set_builder_member(group.mul(x, y), {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        group.mul(x, y) $in \sylow_quotient_preimage<G, group, H>(K)
    claim:
        ? forall x G:
            x $in \sylow_quotient_preimage<G, group, H>(K)
            =>:
                group.inv(x) $in \sylow_quotient_preimage<G, group, H>(K)
        release thm set_builder_member(x, {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        x $in \subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(x) $in K
        \normalizer_quotient_projection<G, group, H>(x) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)
        \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) $in K
        release thm quotient_subgroup_inv_mem(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H, K, \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x))
        release thm subgroup_quotient_inv_is_ambient(G, group, \subgroup_normalizer<G, group>(H), H, x)
        \quotient_group_inv<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)) $in K
        \quotient_group_inv<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.inv(x))
        \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.inv(x)) $in K
        group.inv(x) $in \subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(group.inv(x)) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(group.inv(x))
        \normalizer_quotient_projection<G, group, H>(group.inv(x)) $in K
        group.inv(x) $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(group.inv(x)) $in K
        release thm set_builder_member(group.inv(x), {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        group.inv(x) $in \sylow_quotient_preimage<G, group, H>(K)
    by def:
        ? $is_subgroup(G, group, \sylow_quotient_preimage<G, group, H>(K))

thm sylow_quotient_preimage_finite:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
        $is_finite_set(G)
        =>:
            $is_finite_set(\sylow_quotient_preimage<G, group, H>(K))
    \sylow_quotient_preimage<G, group, H>(K) $subset G
    release thm subset_of_finite_set_is_finite(\sylow_quotient_preimage<G, group, H>(K), G)

# The pulled-back subgroup has coordinates K x H, so its order is |K||H|.

thm sylow_preimage_forward_pair_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set, x G:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
        x $in \sylow_quotient_preimage<G, group, H>(K)
        =>:
            (\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), \left_coset_coordinate<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)) $in cart(K, H)
    release thm set_builder_member(x, {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
    x $in \subgroup_normalizer<G, group>(H)
    \normalizer_quotient_projection<G, group, H>(x) $in K
    \normalizer_quotient_projection<G, group, H>(x) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)
    \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) $in K
    release thm left_coset_coordinate_mem(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H, x)
    \left_coset_coordinate<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) $in H
    release thm cart_member_from_coordinates((\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), \left_coset_coordinate<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)), cart(K, H))

thm sylow_preimage_backward_mem:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K, pair set:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
        pair $in cart(K, H)
        =>:
            group.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) $in \sylow_quotient_preimage<G, group, H>(K)
    pair[1] $in K
    pair[2] $in H
    K $subset \quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>
    pair[1] $in \quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>
    \quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H> = \quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H)
    pair[1] $in \quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H)
    release thm cart_member_from_coordinates((pair[1], pair[2]), cart(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), H))
    have broad_pair cart(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), H) = (pair[1], pair[2])
    have x \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)> = \left_coset_backward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair)
    x = \left_coset_backward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair)
    broad_pair[1] = pair[1]
    broad_pair[2] = pair[2]
    \left_coset_backward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair) = \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]), broad_pair[2])
    release thm object_substitution(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, broad_pair[1], pair[1])
    \left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]) = \left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1])
    release thm object_substitution(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, fn(t \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>) \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)> {\subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(t, broad_pair[2])}, \left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]), \left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]))
    \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]), broad_pair[2]) = \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), broad_pair[2])
    release thm object_substitution(H, \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, fn(t H) \subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)> {\subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), t)}, broad_pair[2], pair[2])
    \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), broad_pair[2]) = \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    x = \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    release thm subgroup_group_mul_is_ambient(G, group, \subgroup_normalizer<G, group>(H), \left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    x = group.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    release thm left_coset_forward_backward(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H, broad_pair)
    release thm object_substitution(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, cart(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), H), \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, x, \left_coset_backward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair))
    \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) = \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(\left_coset_backward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair))
    \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(\left_coset_backward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(broad_pair)) = broad_pair
    \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) = broad_pair = (pair[1], pair[2]) = pair
    \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)[1] = \left_coset_projection<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)
    release thm object_substitution(cart(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), H), \quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), fn(t cart(\quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H), H)) \quotient_group_carrier<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H) {t[1]}, \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), broad_pair)
    \left_coset_forward<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)[1] = broad_pair[1] = pair[1]
    \left_coset_projection<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) = pair[1]
    \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) = \left_coset<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>>(H, x) = \left_coset_projection<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) = pair[1]
    pair[1] $in K
    \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x) $in K
    x $in \subgroup_normalizer<G, group>(H)
    \normalizer_quotient_projection<G, group, H>(x) = \quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x)
    \normalizer_quotient_projection<G, group, H>(x) $in K
    x $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(x) $in K
    release thm set_builder_member(x, {candidate G: candidate $in \subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
    x $in \sylow_quotient_preimage<G, group, H>(K)
    group.mul(\left_coset_representative<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) = x

thm sylow_quotient_preimage_cardinality:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), K set:
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
        $is_normal_subgroup(\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>)
        $is_finite_set(G)
