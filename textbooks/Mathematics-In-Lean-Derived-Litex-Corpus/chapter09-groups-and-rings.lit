        =>:
            $is_finite_set(\sylow_quotient_preimage<G, group, H>(K))
            finite_set_size(\sylow_quotient_preimage<G, group, H>(K)) = finite_set_size(K) * finite_set_size(H)
    release thm sylow_quotient_preimage_finite(G, group, H, K)
    claim:
