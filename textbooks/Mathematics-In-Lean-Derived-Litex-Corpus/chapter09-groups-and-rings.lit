template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have quotient_commutative_ring &chap7::CommutativeRing<\quotient_ring_nonempty<A, ring, I>> = (\quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>)

prop ideal_sum_member(A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), x A):
    exist a, b A st {a $in I, b $in J, x = ring.add(a, b)}

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn ideal_sum(I, J power_set(A)) power_set(A) = {x A: $ideal_sum_member(A, ring, I, J, x)}

thm ideal_contains_finite_range_sum:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), f fn(index N) A, n N:
        $is_ideal(A, ring, I)
        forall index range(0, n):
            f(index) $in I
        =>:
            \finite_range_sum<A, ring.add, ring.zero>(f, n) $in I
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    claim:
        ? forall x A:
            ring.add(x, ring.zero) = x
        release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
    by def:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    prop _ideal_contains_finite_range_sum_at(count N):
        forall target power_set(A):
            target = I
            forall index range(0, count):
                f(index) $in target
            =>:
                \finite_range_sum<A, ring.add, ring.zero>(f, count) $in target
    claim:
        ? forall count N:
            $_ideal_contains_finite_range_sum_at(count)
        by induc count from 0:
            ? $_ideal_contains_finite_range_sum_at(count)
            ? from count = 0:
                claim:
                    ? forall target power_set(A):
                        target = I
                        forall index range(0, count):
                            f(index) $in target
                        =>:
                            \finite_range_sum<A, ring.add, ring.zero>(f, count) $in target
                    release thm finite_range_sum_zero(A, ring.add, ring.zero, f)
                    ring.zero $in I
                    ring.zero $in target
                    \finite_range_sum<A, ring.add, ring.zero>(f, count) = ring.zero
                by def:
                    ? $_ideal_contains_finite_range_sum_at(count)
                $_ideal_contains_finite_range_sum_at(count)
            ? induc:
                $_ideal_contains_finite_range_sum_at(count)
                claim:
                    ? forall target power_set(A):
                        target = I
                        forall index range(0, count + 1):
                            f(index) $in target
                        =>:
                            \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) $in target
                    claim:
                        ? forall index range(0, count):
                            f(index) $in I
                        index < count < count + 1
                        f(index) $in target
                    $_ideal_contains_finite_range_sum_at(count)
                    I = I
                    \finite_range_sum<A, ring.add, ring.zero>(f, count) $in I
                    count < count + 1
                    f(count) $in target
                    f(count) $in I
                    ring.add(\finite_range_sum<A, ring.add, ring.zero>(f, count), f(count)) $in I
                    release thm finite_range_sum_succ(A, ring.add, ring.zero, f, count)
                    \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) = ring.add(\finite_range_sum<A, ring.add, ring.zero>(f, count), f(count))
                    \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) $in I
                by def:
                    ? $_ideal_contains_finite_range_sum_at(count + 1)
                $_ideal_contains_finite_range_sum_at(count + 1)
    $_ideal_contains_finite_range_sum_at(n)
    I = I

prop ideal_product_factors(A set, I, J power_set(A), n N, left, right fn(index N) A):
    forall index range(0, n):
        left(index) $in I
    forall index range(0, n):
        right(index) $in J

prop ideal_product_member(A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), x A):
    exist n N, left, right fn(index N) A st {$ideal_product_factors(A, I, J, n, left, right), x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)}

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn ideal_product(I, J power_set(A)) power_set(A) = {x A: $ideal_product_member(A, ring, I, J, x)}

thm ideal_product_subset_factors:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A):
        $is_ideal(A, ring, I)
        $is_ideal(A, ring, J)
        =>:
            \ideal_product<A, ring>(I, J) $subset I
            \ideal_product<A, ring>(I, J) $subset J
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    claim:
        ? forall x \ideal_product<A, ring>(I, J):
            x $in I
        by def:
            ? $ideal_product_member(A, ring, I, J, x)
        obtain n, left, right from $ideal_product_member(A, ring, I, J, x)
        claim:
            ? forall index range(0, n):
                ring.mul(left(index), right(index)) $in I
            left(index) $in I
            right(index) $in J
            ring.mul(right(index), left(index)) $in I
            ring.mul(left(index), right(index)) = ring.mul(right(index), left(index))
        release thm ideal_contains_finite_range_sum(A, ring, I, fn(index N) A {ring.mul(left(index), right(index))}, n)
        x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)
    by def:
        ? \ideal_product<A, ring>(I, J) $subset I
    \ideal_product<A, ring>(I, J) $subset I
    claim:
        ? forall x \ideal_product<A, ring>(I, J):
            x $in J
        by def:
            ? $ideal_product_member(A, ring, I, J, x)
        obtain n, left, right from $ideal_product_member(A, ring, I, J, x)
        claim:
            ? forall index range(0, n):
                ring.mul(left(index), right(index)) $in J
            left(index) $in I
            right(index) $in J
        release thm ideal_contains_finite_range_sum(A, ring, J, fn(index N) A {ring.mul(left(index), right(index))}, n)
        x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)
    by def:
        ? \ideal_product<A, ring>(I, J) $subset J
    \ideal_product<A, ring>(I, J) $subset J

template<A set>:
    have fn ideal_infimum_pair(I, J power_set(A)) power_set(A) = {x A: x $in I and x $in J}

template<A, S set, f fn(x A) S>:
    have fn ideal_comap(J power_set(S)) power_set(A) = {x A: f(x) $in J}

prop has_ideal_map_preimage(A, S set, f fn(x A) S, I power_set(A), y S):
    exist x A st {x $in I, f(x) = y}

template<A, S set, f fn(x A) S>:
    have fn ideal_map(I power_set(A)) power_set(S) = {y S: $has_ideal_map_preimage(A, S, f, I, y)}

template<A, S set, zeroS S, f fn(x A) S>:
    have ring_kernel power_set(A) = {x A: f(x) = zeroS}

template<A, S set, f fn(x A) S>:
    have ring_range power_set(S) = \ideal_map<A, S, f>(A)

thm ring_kernel_is_ideal:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            $is_ideal(A, source, \ring_kernel<A, S, target.zero, f>)
    $chap7::is_commutative_ring(A, source.add, source.zero, source.neg, source.mul, source.one)
    $chap7::is_commutative_ring(S, target.add, target.zero, target.neg, target.mul, target.one)
    $chap2::ring_laws(A, source.add, source.zero, source.neg, source.mul, source.one)
    $chap2::ring_laws(S, target.add, target.zero, target.neg, target.mul, target.one)
    $chap2::additive_commutative_group_laws(A, source.add, source.zero, source.neg)
    $chap2::additive_commutative_group_laws(S, target.add, target.zero, target.neg)
    \ring_kernel<A, S, target.zero, f> = {x A: f(x) = target.zero}
    release thm commutative_ring_hom_map_zero(A, S, source, target, f)
    f(source.zero) = target.zero
    release thm set_builder_member(source.zero, {x A: f(x) = target.zero})
    source.zero $in {x A: f(x) = target.zero}
    source.zero $in \ring_kernel<A, S, target.zero, f>
    claim:
        ? forall x, y A:
            x $in \ring_kernel<A, S, target.zero, f>
            y $in \ring_kernel<A, S, target.zero, f>
            =>:
                source.add(x, y) $in \ring_kernel<A, S, target.zero, f>
        f(x) = target.zero
        f(y) = target.zero
        release thm commutative_ring_hom_map_add(A, S, source, target, f, x, y)
        f(source.add(x, y)) = target.add(f(x), f(y)) = target.add(target.zero, target.zero) = target.zero
        release thm set_builder_member(source.add(x, y), {z A: f(z) = target.zero})
        source.add(x, y) $in {z A: f(z) = target.zero}
    claim:
        ? forall x A:
            x $in \ring_kernel<A, S, target.zero, f>
            =>:
                source.neg(x) $in \ring_kernel<A, S, target.zero, f>
        f(x) = target.zero
        source.add(source.neg(x), x) = source.zero
        release thm commutative_ring_hom_map_add(A, S, source, target, f, source.neg(x), x)
        f(source.add(source.neg(x), x)) = target.add(f(source.neg(x)), f(x))
        f(source.add(source.neg(x), x)) = f(source.zero) = target.zero
        target.add(f(source.neg(x)), f(x)) = target.add(f(source.neg(x)), target.zero)
        release thm chap2::add_zero_from_laws(S, target.add, target.zero, target.neg, f(source.neg(x)))
        target.add(f(source.neg(x)), target.zero) = f(source.neg(x))
        f(source.neg(x)) = target.zero
        release thm set_builder_member(source.neg(x), {z A: f(z) = target.zero})
        source.neg(x) $in {z A: f(z) = target.zero}
    claim:
        ? forall r, x A:
            x $in \ring_kernel<A, S, target.zero, f>
            =>:
                source.mul(r, x) $in \ring_kernel<A, S, target.zero, f>
        f(x) = target.zero
        release thm commutative_ring_hom_map_mul(A, S, source, target, f, r, x)
        f(source.mul(r, x)) = target.mul(f(r), f(x)) = target.mul(f(r), target.zero)
        release thm chap2::mul_zero_from_laws(S, target.add, target.zero, target.neg, target.mul, target.one, f(r))
        target.mul(f(r), target.zero) = target.zero
        f(source.mul(r, x)) = target.zero
        release thm set_builder_member(source.mul(r, x), {z A: f(z) = target.zero})
        source.mul(r, x) $in {z A: f(z) = target.zero}
    by def:
        ? $is_ideal(A, source, \ring_kernel<A, S, target.zero, f>)

thm ring_range_is_nonempty:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            $is_nonempty_set(\ring_range<A, S, f>)
    \ideal_map<A, S, f>(A) = {y S: $has_ideal_map_preimage(A, S, f, A, y)}
    witness $has_ideal_map_preimage(A, S, f, A, f(source.zero)) from source.zero
    release thm set_builder_member(f(source.zero), {y S: $has_ideal_map_preimage(A, S, f, A, y)})
    f(source.zero) $in {y S: $has_ideal_map_preimage(A, S, f, A, y)}
    f(source.zero) $in \ideal_map<A, S, f>(A)
    \ring_range<A, S, f> = \ideal_map<A, S, f>(A)
    f(source.zero) $in \ring_range<A, S, f>
    witness $is_nonempty_set(\ring_range<A, S, f>) from f(source.zero)

template<A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S: $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)>:
    have ring_range_nonempty nonempty_set = \ring_range<A, S, f>

prop is_quotient_ring_first_isomorphism_value(A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S, q power_set(A), y S):
    exist x A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, x), y = f(x)}

template<A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S: $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)>:
    have fn quotient_ring_first_isomorphism by exist!:
        ? forall q \quotient_ring_carrier<A, source>(\ring_kernel<A, S, target.zero, f>):
            exist! y \ring_range_nonempty<A, S, source, target, f> st {$is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y)}
        \ideal_map<A, S, f>(A) = {y S: $has_ideal_map_preimage(A, S, f, A, y)}
        obtain a from exist representative A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, representative)}
        witness $has_ideal_map_preimage(A, S, f, A, f(a)) from a
        release thm set_builder_member(f(a), {y S: $has_ideal_map_preimage(A, S, f, A, y)})
        f(a) $in {y S: $has_ideal_map_preimage(A, S, f, A, y)}
        f(a) $in \ideal_map<A, S, f>(A)
        \ring_range<A, S, f> = \ideal_map<A, S, f>(A)
        f(a) $in \ring_range<A, S, f>
        \ring_range_nonempty<A, S, source, target, f> = \ring_range<A, S, f>
        f(a) $in \ring_range_nonempty<A, S, source, target, f>
        have candidate \ring_range_nonempty<A, S, source, target, f> = f(a)
        witness exist y \ring_range_nonempty<A, S, source, target, f> st {$is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y)} from candidate:
            witness $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, candidate) from a
        claim:
            ? forall y1, y2 \ring_range_nonempty<A, S, source, target, f>:
                $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y1)
                $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y2)
                =>:
                    y1 = y2
            obtain a1 from $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y1)
            obtain a2 from $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y2)
            release thm ring_kernel_is_ideal(A, S, source, target, f)
            release thm ideal_coset_center_mem(A, source, \ring_kernel<A, S, target.zero, f>, a2)
            a2 $in \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a2)
            \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a2) = q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a1)
            a2 $in \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a1)
            obtain k from exist idx A st {idx $in \ring_kernel<A, S, target.zero, f>, a2 = source.add(a1, idx)}
            f(k) = target.zero
            release thm commutative_ring_hom_map_add(A, S, source, target, f, a1, k)
            release thm chap7::commutative_ring_add_zero(S, target, f(a1))
            f(a2) = f(source.add(a1, k)) = target.add(f(a1), f(k)) = target.add(f(a1), target.zero) = f(a1)
            y2 = f(a2) = f(a1) = y1

prop is_commutative_ring_ideal_family(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A)):
    forall idx Index:
        $is_ideal(A, ring, I(idx))

prop ideals_coprime(A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A)):
    $is_ideal(A, ring, I)
    $is_ideal(A, ring, J)
    \ideal_sum<A, ring>(I, J) = A

prop ideals_pairwise_coprime(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A)):
    $is_commutative_ring_ideal_family(Index, A, ring, I)
    forall idx, j Index:
        idx != j
        =>:
            $ideals_coprime(A, ring, I(idx), I(j))

prop belongs_to_every_ideal(Index, A set, I fn(idx Index) power_set(A), x A):
    forall idx Index:
        x $in I(idx)

template<Index, A set, I fn(idx Index) power_set(A)>:
    have ideal_infimum power_set(A) = {x A: $belongs_to_every_ideal(Index, A, I, x)}

prop is_quotient_tuple(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), q fn(idx Index) power_set(A)):
    forall idx Index:
        q(idx) $in \quotient_ring_carrier<A, ring>(I(idx))

template<Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A)>:
    have quotient_product power_set(fn(idx Index) power_set(A)) = {q fn(idx Index) power_set(A): $is_quotient_tuple(Index, A, ring, I, q)}

# The Chinese map, its finite-family bijectivity, and its inverse are
# constructed below from explicit ideal-coset representatives.
thm ideal_infimum_is_ideal:
    ? forall Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A):
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        =>:
            $is_ideal(A, ring, \ideal_infimum<Index, A, I>)
    by def:
        ? $is_commutative_ring_ideal_family(Index, A, ring, I)
    \ideal_infimum<Index, A, I> = {x A: $belongs_to_every_ideal(Index, A, I, x)}
    claim:
        ? $belongs_to_every_ideal(Index, A, I, ring.zero)
        claim:
            ? forall idx Index:
                ring.zero $in I(idx)
            $is_ideal(A, ring, I(idx))
            by def:
                ? $is_ideal(A, ring, I(idx))
        by def:
            ? $belongs_to_every_ideal(Index, A, I, ring.zero)
    release thm set_builder_member(ring.zero, {x A: $belongs_to_every_ideal(Index, A, I, x)})
    ring.zero $in \ideal_infimum<Index, A, I>
    claim:
        ? forall x, y A:
            x $in \ideal_infimum<Index, A, I>
            y $in \ideal_infimum<Index, A, I>
            =>:
                ring.add(x, y) $in \ideal_infimum<Index, A, I>
        x $in {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)}
        y $in {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)}
        by def:
            ? $belongs_to_every_ideal(Index, A, I, x)
        by def:
            ? $belongs_to_every_ideal(Index, A, I, y)
        claim:
            ? $belongs_to_every_ideal(Index, A, I, ring.add(x, y))
            claim:
                ? forall idx Index:
                    ring.add(x, y) $in I(idx)
                x $in I(idx)
                y $in I(idx)
                $is_ideal(A, ring, I(idx))
                by def:
                    ? $is_ideal(A, ring, I(idx))
            by def:
                ? $belongs_to_every_ideal(Index, A, I, ring.add(x, y))
        release thm set_builder_member(ring.add(x, y), {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)})
        ring.add(x, y) $in \ideal_infimum<Index, A, I>
    claim:
        ? forall x A:
            x $in \ideal_infimum<Index, A, I>
            =>:
                ring.neg(x) $in \ideal_infimum<Index, A, I>
        x $in {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)}
        by def:
            ? $belongs_to_every_ideal(Index, A, I, x)
        claim:
            ? $belongs_to_every_ideal(Index, A, I, ring.neg(x))
            claim:
                ? forall idx Index:
                    ring.neg(x) $in I(idx)
                x $in I(idx)
                $is_ideal(A, ring, I(idx))
                by def:
                    ? $is_ideal(A, ring, I(idx))
            by def:
                ? $belongs_to_every_ideal(Index, A, I, ring.neg(x))
        release thm set_builder_member(ring.neg(x), {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)})
        ring.neg(x) $in \ideal_infimum<Index, A, I>
    claim:
        ? forall r, x A:
            x $in \ideal_infimum<Index, A, I>
            =>:
                ring.mul(r, x) $in \ideal_infimum<Index, A, I>
        x $in {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)}
        by def:
            ? $belongs_to_every_ideal(Index, A, I, x)
        claim:
            ? $belongs_to_every_ideal(Index, A, I, ring.mul(r, x))
            claim:
                ? forall idx Index:
                    ring.mul(r, x) $in I(idx)
                x $in I(idx)
                $is_ideal(A, ring, I(idx))
                by def:
                    ? $is_ideal(A, ring, I(idx))
            by def:
                ? $belongs_to_every_ideal(Index, A, I, ring.mul(r, x))
        release thm set_builder_member(ring.mul(r, x), {candidate A: $belongs_to_every_ideal(Index, A, I, candidate)})
        ring.mul(r, x) $in \ideal_infimum<Index, A, I>
    by def:
        ? $is_ideal(A, ring, \ideal_infimum<Index, A, I>)

prop has_chinese_components(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), representative A, value fn(idx Index) power_set(A)):
    forall idx Index:
        value(idx) = \ideal_coset<A, ring>(I(idx), representative)

prop is_chinese_map_value(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), source power_set(A), value fn(idx Index) power_set(A)):
    exist representative A st {source = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative), $has_chinese_components(Index, A, ring, I, representative, value)}

template<Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A): $is_commutative_ring_ideal_family(Index, A, ring, I)>:
    have fn chinese_map by exist!:
        ? forall source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>):
            exist! value \quotient_product<Index, A, ring, I> st {$is_chinese_map_value(Index, A, ring, I, source, value)}
        by def:
            ? $is_commutative_ring_ideal_family(Index, A, ring, I)
        \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) = {CarrierC power_set(A): $is_ideal_coset(A, ring, \ideal_infimum<Index, A, I>, CarrierC)}
        source $in {CarrierC power_set(A): $is_ideal_coset(A, ring, \ideal_infimum<Index, A, I>, CarrierC)}
        by def:
            ? $is_ideal_coset(A, ring, \ideal_infimum<Index, A, I>, source)
        obtain representative from exist center A st {source = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, center)}
        have fn candidate(idx Index) power_set(A) = \ideal_coset<A, ring>(I(idx), representative)
        claim:
            ? $is_quotient_tuple(Index, A, ring, I, candidate)
            claim:
                ? forall idx Index:
                    candidate(idx) $in \quotient_ring_carrier<A, ring>(I(idx))
                $is_ideal(A, ring, I(idx))
                candidate(idx) = \ideal_coset<A, ring>(I(idx), representative)
                release thm ideal_coset_in_quotient_ring_carrier(A, ring, I(idx), representative)
                \ideal_coset<A, ring>(I(idx), representative) $in \quotient_ring_carrier<A, ring>(I(idx))
            by def:
                ? $is_quotient_tuple(Index, A, ring, I, candidate)
        \quotient_product<Index, A, ring, I> = {q fn(idx Index) power_set(A): $is_quotient_tuple(Index, A, ring, I, q)}
        release thm set_builder_member(candidate, {q fn(idx Index) power_set(A): $is_quotient_tuple(Index, A, ring, I, q)})
        candidate $in \quotient_product<Index, A, ring, I>
        claim:
            ? $has_chinese_components(Index, A, ring, I, representative, candidate)
            by def:
                ? $has_chinese_components(Index, A, ring, I, representative, candidate)
        witness exist value \quotient_product<Index, A, ring, I> st {$is_chinese_map_value(Index, A, ring, I, source, value)} from candidate:
            witness $is_chinese_map_value(Index, A, ring, I, source, candidate) from representative
        claim:
            ? forall value1, value2 \quotient_product<Index, A, ring, I>:
                $is_chinese_map_value(Index, A, ring, I, source, value1)
                $is_chinese_map_value(Index, A, ring, I, source, value2)
                =>:
                    value1 = value2
            obtain representative1 from $is_chinese_map_value(Index, A, ring, I, source, value1)
            obtain representative2 from $is_chinese_map_value(Index, A, ring, I, source, value2)
            by def:
                ? $has_chinese_components(Index, A, ring, I, representative1, value1)
            by def:
                ? $has_chinese_components(Index, A, ring, I, representative2, value2)
            release thm ideal_infimum_is_ideal(Index, A, ring, I)
            release thm ideal_coset_center_mem(A, ring, \ideal_infimum<Index, A, I>, representative2)
            representative2 $in \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative2)
            \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative2) = source = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative1)
            representative2 $in \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative1)
            obtain offset from $ideal_coset_member(A, ring, \ideal_infimum<Index, A, I>, representative1, representative2)
            offset $in \ideal_infimum<Index, A, I>
            by def:
                ? $belongs_to_every_ideal(Index, A, I, offset)
            claim:
                ? forall idx Index:
                    value1(idx) = value2(idx)
                offset $in I(idx)
                representative2 = ring.add(representative1, offset)
                \ideal_coset<A, ring>(I(idx), representative1) = {z A: $ideal_coset_member(A, ring, I(idx), representative1, z)}
                witness $ideal_coset_member(A, ring, I(idx), representative1, representative2) from offset
                release thm set_builder_member(representative2, {z A: $ideal_coset_member(A, ring, I(idx), representative1, z)})
                representative2 $in {z A: $ideal_coset_member(A, ring, I(idx), representative1, z)}
                release thm ideal_coset_eq_of_mem(A, ring, I(idx), representative1, representative2)
                value1(idx) = \ideal_coset<A, ring>(I(idx), representative1) = \ideal_coset<A, ring>(I(idx), representative2) = value2(idx)
            by def:
                ? $fn_eq(value1, value2)

thm chinese_map_has_value:
    ? forall Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>):
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        =>:
            $is_chinese_map_value(Index, A, ring, I, source, \chinese_map<Index, A, ring, I>(source))
    $is_chinese_map_value(Index, A, ring, I, source, \chinese_map<Index, A, ring, I>(source))

thm crt_object_substitution:
    ? forall U, V set, h fn(q U) V, x, y U:
        x = y
        =>:
            h(x) = h(y)
    h(x) = h(y)

thm chinese_map_injective:
    ? forall Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A):
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        =>:
            $injective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)
    by def:
        ? $is_commutative_ring_ideal_family(Index, A, ring, I)
    by def:
        ? $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    release thm ideal_infimum_is_ideal(Index, A, ring, I)
    claim:
        ? forall source1, source2 \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>):
            \chinese_map<Index, A, ring, I>(source1) = \chinese_map<Index, A, ring, I>(source2)
            =>:
                source1 = source2
        release thm chinese_map_has_value(Index, A, ring, I, source1)
        release thm chinese_map_has_value(Index, A, ring, I, source2)
        obtain representative1 from $is_chinese_map_value(Index, A, ring, I, source1, \chinese_map<Index, A, ring, I>(source1))
        obtain representative2 from $is_chinese_map_value(Index, A, ring, I, source2, \chinese_map<Index, A, ring, I>(source2))
        by def:
            ? $has_chinese_components(Index, A, ring, I, representative1, \chinese_map<Index, A, ring, I>(source1))
        by def:
            ? $has_chinese_components(Index, A, ring, I, representative2, \chinese_map<Index, A, ring, I>(source2))
        have difference A = ring.add(representative2, ring.neg(representative1))
        claim:
            ? $belongs_to_every_ideal(Index, A, I, difference)
            claim:
                ? forall idx Index:
                    difference $in I(idx)
                release thm crt_object_substitution(fn(q Index) power_set(A), power_set(A), fn(h fn(q Index) power_set(A)) power_set(A) {h(idx)}, \chinese_map<Index, A, ring, I>(source1), \chinese_map<Index, A, ring, I>(source2))
                (fn(h fn(q Index) power_set(A)) power_set(A) {h(idx)})(\chinese_map<Index, A, ring, I>(source1)) = \chinese_map<Index, A, ring, I>(source1)(idx)
                (fn(h fn(q Index) power_set(A)) power_set(A) {h(idx)})(\chinese_map<Index, A, ring, I>(source2)) = \chinese_map<Index, A, ring, I>(source2)(idx)
                \chinese_map<Index, A, ring, I>(source1)(idx) = \chinese_map<Index, A, ring, I>(source2)(idx)
                \chinese_map<Index, A, ring, I>(source1)(idx) = \ideal_coset<A, ring>(I(idx), representative1)
                \chinese_map<Index, A, ring, I>(source2)(idx) = \ideal_coset<A, ring>(I(idx), representative2)
                \ideal_coset<A, ring>(I(idx), representative1) = \ideal_coset<A, ring>(I(idx), representative2)
                $is_ideal(A, ring, I(idx))
                release thm ideal_coset_center_mem(A, ring, I(idx), representative2)
                representative2 $in \ideal_coset<A, ring>(I(idx), representative2)
                representative2 $in \ideal_coset<A, ring>(I(idx), representative1)
                obtain offset from $ideal_coset_member(A, ring, I(idx), representative1, representative2)
                representative2 = ring.add(representative1, offset)
                release thm chap2::add_neg_cancel_from_laws(A, ring.add, ring.zero, ring.neg, representative1)
                ring.add(representative1, ring.neg(representative1)) = ring.zero
                ring.add(offset, ring.neg(representative1)) = ring.add(ring.neg(representative1), offset)
                difference = ring.add(representative2, ring.neg(representative1)) = ring.add(ring.add(representative1, offset), ring.neg(representative1)) = ring.add(representative1, ring.add(offset, ring.neg(representative1))) = ring.add(representative1, ring.add(ring.neg(representative1), offset)) = ring.add(ring.add(representative1, ring.neg(representative1)), offset) = ring.add(ring.zero, offset) = offset
                offset $in I(idx)
            by def:
                ? $belongs_to_every_ideal(Index, A, I, difference)
        \ideal_infimum<Index, A, I> = {x A: $belongs_to_every_ideal(Index, A, I, x)}
        release thm set_builder_member(difference, {x A: $belongs_to_every_ideal(Index, A, I, x)})
        difference $in \ideal_infimum<Index, A, I>
        difference = ring.add(representative2, ring.neg(representative1))
        ring.add(representative2, ring.neg(representative1)) = ring.add(ring.neg(representative1), representative2)
        release thm chap2::add_neg_cancel_from_laws(A, ring.add, ring.zero, ring.neg, representative1)
        ring.add(representative1, ring.neg(representative1)) = ring.zero
        ring.add(representative1, difference) = ring.add(representative1, ring.add(representative2, ring.neg(representative1))) = ring.add(representative1, ring.add(ring.neg(representative1), representative2)) = ring.add(ring.add(representative1, ring.neg(representative1)), representative2) = ring.add(ring.zero, representative2) = representative2
        \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative1) = {x A: $ideal_coset_member(A, ring, \ideal_infimum<Index, A, I>, representative1, x)}
        witness $ideal_coset_member(A, ring, \ideal_infimum<Index, A, I>, representative1, representative2) from difference
        release thm set_builder_member(representative2, {x A: $ideal_coset_member(A, ring, \ideal_infimum<Index, A, I>, representative1, x)})
        representative2 $in {x A: $ideal_coset_member(A, ring, \ideal_infimum<Index, A, I>, representative1, x)}
        release thm ideal_coset_eq_of_mem(A, ring, \ideal_infimum<Index, A, I>, representative1, representative2)
        source2 = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative2) = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative1) = source1
    by def:
        ? $injective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)

thm ideals_coprime_of_one_decomposition:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), left, right A:
        $is_ideal(A, ring, I)
        $is_ideal(A, ring, J)
        left $in I
        right $in J
        ring.one = ring.add(left, right)
        =>:
            $ideals_coprime(A, ring, I, J)
    by def:
        ? $is_ideal(A, ring, I)
    by def:
        ? $is_ideal(A, ring, J)
    by def:
        ? $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    \ideal_sum<A, ring>(I, J) = {x A: $ideal_sum_member(A, ring, I, J, x)}
    claim:
        ? forall x A:
            x $in \ideal_sum<A, ring>(I, J)
        ring.mul(x, left) $in I
        ring.mul(x, right) $in J
        ring.mul(x, ring.one) = x
        ring.mul(x, ring.add(left, right)) = ring.add(ring.mul(x, left), ring.mul(x, right))
        x = ring.mul(x, ring.one) = ring.mul(x, ring.add(left, right)) = ring.add(ring.mul(x, left), ring.mul(x, right))
        witness $ideal_sum_member(A, ring, I, J, x) from ring.mul(x, left), ring.mul(x, right)
        release thm set_builder_member(x, {candidate A: $ideal_sum_member(A, ring, I, J, candidate)})
        x $in {candidate A: $ideal_sum_member(A, ring, I, J, candidate)}
    by def:
        ? A $subset \ideal_sum<A, ring>(I, J)
    \ideal_sum<A, ring>(I, J) $subset A
    by extension:
        ? \ideal_sum<A, ring>(I, J) = A
    by def:
        ? $ideals_coprime(A, ring, I, J)

thm ideals_coprime_one_decomposition:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A):
        $ideals_coprime(A, ring, I, J)
        =>:
            $ideal_sum_member(A, ring, I, J, ring.one)
    by def:
        ? $ideals_coprime(A, ring, I, J)
    ring.one $in A
    ring.one $in \ideal_sum<A, ring>(I, J)
    \ideal_sum<A, ring>(I, J) = {x A: $ideal_sum_member(A, ring, I, J, x)}
    ring.one $in {x A: $ideal_sum_member(A, ring, I, J, x)}
    by def:
        ? $ideal_sum_member(A, ring, I, J, ring.one)

prop belongs_to_every_selected_ideal(Index, A set, I fn(idx Index) power_set(A), S power_set(Index), x A):
    forall idx Index:
        idx $in S
        =>:
            x $in I(idx)

template<Index, A set, I fn(idx Index) power_set(A), S power_set(Index)>:
    have selected_ideal_infimum power_set(A) = {x A: $belongs_to_every_selected_ideal(Index, A, I, S, x)}

thm selected_ideal_infimum_is_ideal:
    ? forall Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), S power_set(Index):
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        =>:
            $is_ideal(A, ring, \selected_ideal_infimum<Index, A, I, S>)
    by def:
        ? $is_commutative_ring_ideal_family(Index, A, ring, I)
    \selected_ideal_infimum<Index, A, I, S> = {x A: $belongs_to_every_selected_ideal(Index, A, I, S, x)}
    claim:
        ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.zero)
        claim:
            ? forall idx Index:
                idx $in S
                =>:
                    ring.zero $in I(idx)
            $is_ideal(A, ring, I(idx))
            by def:
                ? $is_ideal(A, ring, I(idx))
        by def:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.zero)
    release thm set_builder_member(ring.zero, {x A: $belongs_to_every_selected_ideal(Index, A, I, S, x)})
    ring.zero $in \selected_ideal_infimum<Index, A, I, S>
    claim:
        ? forall x, y A:
            x $in \selected_ideal_infimum<Index, A, I, S>
            y $in \selected_ideal_infimum<Index, A, I, S>
            =>:
                ring.add(x, y) $in \selected_ideal_infimum<Index, A, I, S>
        x $in {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)}
        y $in {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)}
        by def:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, x)
        by def:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, y)
        claim:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.add(x, y))
            claim:
                ? forall idx Index:
                    idx $in S
                    =>:
                        ring.add(x, y) $in I(idx)
                x $in I(idx)
                y $in I(idx)
                $is_ideal(A, ring, I(idx))
                by def:
                    ? $is_ideal(A, ring, I(idx))
            by def:
                ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.add(x, y))
        release thm set_builder_member(ring.add(x, y), {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)})
        ring.add(x, y) $in \selected_ideal_infimum<Index, A, I, S>
    claim:
        ? forall x A:
            x $in \selected_ideal_infimum<Index, A, I, S>
            =>:
                ring.neg(x) $in \selected_ideal_infimum<Index, A, I, S>
        x $in {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)}
        by def:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, x)
        claim:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.neg(x))
            claim:
                ? forall idx Index:
                    idx $in S
                    =>:
                        ring.neg(x) $in I(idx)
                x $in I(idx)
                $is_ideal(A, ring, I(idx))
                by def:
                    ? $is_ideal(A, ring, I(idx))
            by def:
                ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.neg(x))
        release thm set_builder_member(ring.neg(x), {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)})
        ring.neg(x) $in \selected_ideal_infimum<Index, A, I, S>
    claim:
        ? forall r, x A:
            x $in \selected_ideal_infimum<Index, A, I, S>
            =>:
                ring.mul(r, x) $in \selected_ideal_infimum<Index, A, I, S>
        x $in {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)}
        by def:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, x)
        claim:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.mul(r, x))
            claim:
                ? forall idx Index:
                    idx $in S
                    =>:
                        ring.mul(r, x) $in I(idx)
                x $in I(idx)
                $is_ideal(A, ring, I(idx))
                by def:
                    ? $is_ideal(A, ring, I(idx))
            by def:
                ? $belongs_to_every_selected_ideal(Index, A, I, S, ring.mul(r, x))
        release thm set_builder_member(ring.mul(r, x), {candidate A: $belongs_to_every_selected_ideal(Index, A, I, S, candidate)})
        ring.mul(r, x) $in \selected_ideal_infimum<Index, A, I, S>
    by def:
        ? $is_ideal(A, ring, \selected_ideal_infimum<Index, A, I, S>)

thm belongs_to_every_selected_ideal_empty:
    ? forall Index, A set, I fn(idx Index) power_set(A), x A:
        $belongs_to_every_selected_ideal(Index, A, I, {}, x)
    claim:
        ? forall idx Index:
            idx $in {}
            =>:
                x $in I(idx)
        by contra:
            ? x $in I(idx)
            impossible idx $in {}
    by def:
        ? $belongs_to_every_selected_ideal(Index, A, I, {}, x)

prop finite_infimum_coprime_property(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), fixed Index, S power_set(Index)):
    fixed $in S or $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, S>)

thm finite_infimum_property_coprime_of_not_member:
    ? forall Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), fixed Index, S power_set(Index):
        $finite_infimum_coprime_property(Index, A, ring, I, fixed, S)
        not fixed $in S
        =>:
            $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, S>)
    by def:
        ? $finite_infimum_coprime_property(Index, A, ring, I, fixed, S)
    by cases:
        ? $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, S>)
        case fixed $in S:
            impossible not fixed $in S
        case $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, S>):
            $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, S>)

thm ideal_coprime_with_finite_infimum:
    ? forall Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), fixed Index, S finite_set:
        S $subset Index
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        $ideals_pairwise_coprime(Index, A, ring, I)
        =>:
            $finite_infimum_coprime_property(Index, A, ring, I, fixed, S)
    by def:
        ? $is_commutative_ring_ideal_family(Index, A, ring, I)
    by def:
        ? $ideals_pairwise_coprime(Index, A, ring, I)
    by def:
        ? $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    by induc P in Index:
        ? $finite_infimum_coprime_property(Index, A, ring, I, fixed, P)
        ? from P = {}:
            $is_ideal(A, ring, I(fixed))
            release thm selected_ideal_infimum_is_ideal(Index, A, ring, I, P)
            ring.zero $in I(fixed)
            release thm belongs_to_every_selected_ideal_empty(Index, A, I, ring.one)
            $belongs_to_every_selected_ideal(Index, A, I, {}, ring.one)
            $belongs_to_every_selected_ideal(Index, A, I, P, ring.one)
            \selected_ideal_infimum<Index, A, I, P> = {x A: $belongs_to_every_selected_ideal(Index, A, I, P, x)}
            release thm set_builder_member(ring.one, {x A: $belongs_to_every_selected_ideal(Index, A, I, P, x)})
            ring.one $in \selected_ideal_infimum<Index, A, I, P>
            ring.one = ring.add(ring.zero, ring.one)
            release thm ideals_coprime_of_one_decomposition(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, P>, ring.zero, ring.one)
            fixed $in P or $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, P>)
            by def:
                ? $finite_infimum_coprime_property(Index, A, ring, I, fixed, P)
        ? induc inserted, Smaller:
            by cases:
                ? $finite_infimum_coprime_property(Index, A, ring, I, fixed, union({inserted}, Smaller))
                case fixed $in union({inserted}, Smaller):
                    fixed $in union({inserted}, Smaller) or $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, union({inserted}, Smaller)>)
                    by def:
                        ? $finite_infimum_coprime_property(Index, A, ring, I, fixed, union({inserted}, Smaller))
                case not fixed $in union({inserted}, Smaller):
                    claim:
                        ? not fixed $in Smaller
                        by contra:
                            ? not fixed $in Smaller
                            fixed $in {inserted} or fixed $in Smaller
                            fixed $in union({inserted}, Smaller)
                            impossible not fixed $in union({inserted}, Smaller)
                    claim:
                        ? fixed != inserted
                        by contra:
                            ? fixed != inserted
                            fixed = inserted
                            inserted $in {inserted}
                            fixed $in {inserted}
                            fixed $in {inserted} or fixed $in Smaller
                            fixed $in union({inserted}, Smaller)
                            impossible not fixed $in union({inserted}, Smaller)
                    release thm finite_infimum_property_coprime_of_not_member(Index, A, ring, I, fixed, Smaller)
                    $ideals_coprime(A, ring, I(fixed), I(inserted))
                    release thm ideals_coprime_one_decomposition(A, ring, I(fixed), I(inserted))
                    obtain left1, right1 from $ideal_sum_member(A, ring, I(fixed), I(inserted), ring.one)
                    release thm ideals_coprime_one_decomposition(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, Smaller>)
                    obtain left2, right2 from $ideal_sum_member(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, Smaller>, ring.one)
                    release thm selected_ideal_infimum_is_ideal(Index, A, ring, I, Smaller)
                    release thm selected_ideal_infimum_is_ideal(Index, A, ring, I, union({inserted}, Smaller))
                    $is_ideal(A, ring, I(fixed))
                    by def:
                        ? $is_ideal(A, ring, I(fixed))
                    by def:
                        ? $is_ideal(A, ring, I(inserted))
                    by def:
                        ? $is_ideal(A, ring, \selected_ideal_infimum<Index, A, I, Smaller>)
                    have combined_left A = ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.mul(right1, left2))
                    have combined_right A = ring.mul(right1, right2)
                    ring.mul(left2, left1) $in I(fixed)
                    ring.mul(left1, left2) = ring.mul(left2, left1)
                    ring.mul(right2, left1) $in I(fixed)
                    ring.mul(left1, right2) = ring.mul(right2, left1)
                    ring.mul(right1, left2) $in I(fixed)
                    ring.add(ring.mul(left1, left2), ring.mul(left1, right2)) $in I(fixed)
                    ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.mul(right1, left2)) $in I(fixed)
                    combined_left = ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.mul(right1, left2))
                    combined_left $in I(fixed)
                    by def:
                        ? $belongs_to_every_selected_ideal(Index, A, I, Smaller, right2)
                    claim:
                        ? $belongs_to_every_selected_ideal(Index, A, I, union({inserted}, Smaller), combined_right)
                        claim:
                            ? forall idx Index:
                                idx $in union({inserted}, Smaller)
                                =>:
                                    combined_right $in I(idx)
                            $is_ideal(A, ring, I(idx))
                            by def:
                                ? $is_ideal(A, ring, I(idx))
                            idx $in {inserted} or idx $in Smaller
                            by cases:
                                ? combined_right $in I(idx)
                                case idx $in {inserted}:
                                    idx = inserted
                                    ring.mul(right2, right1) $in I(inserted)
                                    ring.mul(right1, right2) = ring.mul(right2, right1)
                                    combined_right = ring.mul(right1, right2)
                                case idx $in Smaller:
                                    right2 $in I(idx)
                                    ring.mul(right1, right2) $in I(idx)
                                    combined_right = ring.mul(right1, right2)
                        by def:
                            ? $belongs_to_every_selected_ideal(Index, A, I, union({inserted}, Smaller), combined_right)
                    \selected_ideal_infimum<Index, A, I, union({inserted}, Smaller)> = {x A: $belongs_to_every_selected_ideal(Index, A, I, union({inserted}, Smaller), x)}
                    release thm set_builder_member(combined_right, {x A: $belongs_to_every_selected_ideal(Index, A, I, union({inserted}, Smaller), x)})
                    combined_right $in \selected_ideal_infimum<Index, A, I, union({inserted}, Smaller)>
                    ring.mul(ring.add(left1, right1), ring.add(left2, right2)) = ring.add(ring.mul(left1, ring.add(left2, right2)), ring.mul(right1, ring.add(left2, right2)))
                    ring.mul(left1, ring.add(left2, right2)) = ring.add(ring.mul(left1, left2), ring.mul(left1, right2))
                    ring.mul(right1, ring.add(left2, right2)) = ring.add(ring.mul(right1, left2), ring.mul(right1, right2))
                    ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.add(ring.mul(right1, left2), ring.mul(right1, right2))) = ring.add(ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.mul(right1, left2)), ring.mul(right1, right2))
                    ring.one = ring.mul(ring.one, ring.one) = ring.mul(ring.add(left1, right1), ring.add(left2, right2)) = ring.add(ring.mul(left1, ring.add(left2, right2)), ring.mul(right1, ring.add(left2, right2))) = ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.add(ring.mul(right1, left2), ring.mul(right1, right2))) = ring.add(ring.add(ring.add(ring.mul(left1, left2), ring.mul(left1, right2)), ring.mul(right1, left2)), ring.mul(right1, right2)) = ring.add(combined_left, combined_right)
                    release thm ideals_coprime_of_one_decomposition(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, union({inserted}, Smaller)>, combined_left, combined_right)
                    fixed $in union({inserted}, Smaller) or $ideals_coprime(A, ring, I(fixed), \selected_ideal_infimum<Index, A, I, union({inserted}, Smaller)>)
                    by def:
                        ? $finite_infimum_coprime_property(Index, A, ring, I, fixed, union({inserted}, Smaller))
    $finite_infimum_coprime_property(Index, A, ring, I, fixed, S)

thm crt_glue_representatives:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), old, target A:
        $ideals_coprime(A, ring, I, J)
        =>:
            exist glued A st {\ideal_coset<A, ring>(J, glued) = \ideal_coset<A, ring>(J, old), \ideal_coset<A, ring>(I, glued) = \ideal_coset<A, ring>(I, target)}
    by def:
        ? $ideals_coprime(A, ring, I, J)
    by def:
        ? $is_ideal(A, ring, I)
    by def:
        ? $is_ideal(A, ring, J)
    by def:
        ? $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    release thm ideals_coprime_one_decomposition(A, ring, I, J)
    obtain left, right from $ideal_sum_member(A, ring, I, J, ring.one)
    have old_left A = ring.mul(old, left)
    have old_right A = ring.mul(old, right)
    have target_left A = ring.mul(target, left)
    have target_right A = ring.mul(target, right)
    have candidate A = ring.add(old_left, target_right)
    have offset_j A = ring.mul(ring.add(target, ring.neg(old)), right)
    right $in J
    ring.mul(ring.add(target, ring.neg(old)), right) $in J
    offset_j = ring.mul(ring.add(target, ring.neg(old)), right)
    offset_j $in J
    release thm chap2::neg_mul_left_structure(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, old, right)
    ring.mul(ring.neg(old), right) = ring.neg(ring.mul(old, right)) = ring.neg(old_right)
    offset_j = ring.mul(ring.add(target, ring.neg(old)), right) = ring.add(ring.mul(target, right), ring.mul(ring.neg(old), right)) = ring.add(target_right, ring.neg(old_right))
    old = ring.mul(old, ring.one) = ring.mul(old, ring.add(left, right)) = ring.add(ring.mul(old, left), ring.mul(old, right)) = ring.add(old_left, old_right)
    release thm chap2::add_neg_cancel_from_laws(A, ring.add, ring.zero, ring.neg, old_right)
    ring.add(old_right, ring.neg(old_right)) = ring.zero
    ring.add(ring.add(old_right, target_right), ring.neg(old_right)) = ring.add(old_right, ring.add(target_right, ring.neg(old_right)))
    ring.add(old_right, ring.add(target_right, ring.neg(old_right))) = ring.add(ring.add(old_right, target_right), ring.neg(old_right))
    ring.add(old_right, target_right) = ring.add(target_right, old_right)
    ring.add(ring.add(old_right, target_right), ring.neg(old_right)) = ring.add(ring.add(target_right, old_right), ring.neg(old_right))
    ring.add(ring.add(target_right, old_right), ring.neg(old_right)) = ring.add(target_right, ring.add(old_right, ring.neg(old_right)))
    release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, target_right)
    ring.add(target_right, ring.zero) = target_right
    ring.add(old, offset_j) = ring.add(ring.add(old_left, old_right), ring.add(target_right, ring.neg(old_right))) = ring.add(old_left, ring.add(old_right, ring.add(target_right, ring.neg(old_right)))) = ring.add(old_left, ring.add(ring.add(old_right, target_right), ring.neg(old_right))) = ring.add(old_left, ring.add(ring.add(target_right, old_right), ring.neg(old_right))) = ring.add(old_left, ring.add(target_right, ring.add(old_right, ring.neg(old_right)))) = ring.add(old_left, ring.add(target_right, ring.zero)) = ring.add(old_left, target_right) = candidate
    \ideal_coset<A, ring>(J, old) = {x A: $ideal_coset_member(A, ring, J, old, x)}
    witness $ideal_coset_member(A, ring, J, old, candidate) from offset_j:
        candidate = ring.add(old, offset_j)
    release thm set_builder_member(candidate, {x A: $ideal_coset_member(A, ring, J, old, x)})
    candidate $in \ideal_coset<A, ring>(J, old)
    release thm ideal_coset_eq_of_mem(A, ring, J, old, candidate)
    \ideal_coset<A, ring>(J, candidate) = \ideal_coset<A, ring>(J, old)
    have offset_i A = ring.mul(ring.add(old, ring.neg(target)), left)
    left $in I
    ring.mul(ring.add(old, ring.neg(target)), left) $in I
    offset_i = ring.mul(ring.add(old, ring.neg(target)), left)
    offset_i $in I
    release thm chap2::neg_mul_left_structure(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, target, left)
    ring.mul(ring.neg(target), left) = ring.neg(ring.mul(target, left)) = ring.neg(target_left)
    offset_i = ring.mul(ring.add(old, ring.neg(target)), left) = ring.add(ring.mul(old, left), ring.mul(ring.neg(target), left)) = ring.add(old_left, ring.neg(target_left))
    target = ring.mul(target, ring.one) = ring.mul(target, ring.add(left, right)) = ring.add(ring.mul(target, left), ring.mul(target, right)) = ring.add(target_left, target_right)
    ring.add(ring.neg(target_left), target_left) = ring.zero
    ring.add(ring.add(ring.neg(target_left), target_left), target_right) = ring.add(ring.neg(target_left), ring.add(target_left, target_right))
    ring.add(ring.neg(target_left), ring.add(target_left, target_right)) = ring.add(ring.add(ring.neg(target_left), target_left), target_right)
    ring.add(ring.zero, target_right) = target_right
    ring.add(target, offset_i) = ring.add(ring.add(target_left, target_right), ring.add(old_left, ring.neg(target_left))) = ring.add(ring.add(old_left, ring.neg(target_left)), ring.add(target_left, target_right)) = ring.add(old_left, ring.add(ring.neg(target_left), ring.add(target_left, target_right))) = ring.add(old_left, ring.add(ring.add(ring.neg(target_left), target_left), target_right)) = ring.add(old_left, ring.add(ring.zero, target_right)) = ring.add(old_left, target_right) = candidate
    \ideal_coset<A, ring>(I, target) = {x A: $ideal_coset_member(A, ring, I, target, x)}
    witness $ideal_coset_member(A, ring, I, target, candidate) from offset_i:
        candidate = ring.add(target, offset_i)
    release thm set_builder_member(candidate, {x A: $ideal_coset_member(A, ring, I, target, x)})
    candidate $in \ideal_coset<A, ring>(I, target)
    release thm ideal_coset_eq_of_mem(A, ring, I, target, candidate)
    witness exist glued A st {\ideal_coset<A, ring>(J, glued) = \ideal_coset<A, ring>(J, old), \ideal_coset<A, ring>(I, glued) = \ideal_coset<A, ring>(I, target)} from candidate

thm ideal_coset_eq_of_subideal:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), x, y A:
        $is_ideal(A, ring, I)
        $is_ideal(A, ring, J)
        J $subset I
        \ideal_coset<A, ring>(J, x) = \ideal_coset<A, ring>(J, y)
        =>:
            \ideal_coset<A, ring>(I, x) = \ideal_coset<A, ring>(I, y)
    release thm ideal_coset_center_mem(A, ring, J, y)
    y $in \ideal_coset<A, ring>(J, y)
    \ideal_coset<A, ring>(J, y) = \ideal_coset<A, ring>(J, x)
    y $in \ideal_coset<A, ring>(J, x)
    obtain offset from $ideal_coset_member(A, ring, J, x, y)
    offset $in J
    offset $in I
    \ideal_coset<A, ring>(I, x) = {z A: $ideal_coset_member(A, ring, I, x, z)}
    witness $ideal_coset_member(A, ring, I, x, y) from offset
    release thm set_builder_member(y, {z A: $ideal_coset_member(A, ring, I, x, z)})
    y $in \ideal_coset<A, ring>(I, x)
    release thm ideal_coset_eq_of_mem(A, ring, I, x, y)
    \ideal_coset<A, ring>(I, y) = \ideal_coset<A, ring>(I, x)
    \ideal_coset<A, ring>(I, x) = \ideal_coset<A, ring>(I, y)

thm selected_ideal_infimum_subset_selected:
    ? forall Index, A set, I fn(idx Index) power_set(A), S power_set(Index), idx S:
        \selected_ideal_infimum<Index, A, I, S> $subset I(idx)
    claim:
        ? forall x \selected_ideal_infimum<Index, A, I, S>:
            x $in I(idx)
        \selected_ideal_infimum<Index, A, I, S> = {z A: $belongs_to_every_selected_ideal(Index, A, I, S, z)}
        x $in {z A: $belongs_to_every_selected_ideal(Index, A, I, S, z)}
        by def:
            ? $belongs_to_every_selected_ideal(Index, A, I, S, x)
        x $in I(idx)
    by def:
        ? \selected_ideal_infimum<Index, A, I, S> $subset I(idx)

prop matches_selected_residues(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), S power_set(Index), representative A, q fn(idx Index) power_set(A)):
    forall idx Index:
        idx $in S
        =>:
            q(idx) = \ideal_coset<A, ring>(I(idx), representative)

prop has_partial_crt_representative(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), S power_set(Index), q fn(idx Index) power_set(A)):
    exist representative A st {$matches_selected_residues(Index, A, ring, I, S, representative, q)}

thm matches_selected_residues_empty:
    ? forall Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), representative A, q fn(idx Index) power_set(A):
        $matches_selected_residues(Index, A, ring, I, {}, representative, q)
    claim:
        ? forall idx Index:
            idx $in {}
            =>:
                q(idx) = \ideal_coset<A, ring>(I(idx), representative)
        by contra:
            ? q(idx) = \ideal_coset<A, ring>(I(idx), representative)
            impossible idx $in {}
    by def:
        ? $matches_selected_residues(Index, A, ring, I, {}, representative, q)

thm finite_partial_crt_representative:
    ? forall Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), S finite_set, q fn(idx Index) power_set(A):
        S $subset Index
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        $ideals_pairwise_coprime(Index, A, ring, I)
        $is_quotient_tuple(Index, A, ring, I, q)
        =>:
            $has_partial_crt_representative(Index, A, ring, I, S, q)
    by def:
        ? $is_commutative_ring_ideal_family(Index, A, ring, I)
    by def:
        ? $ideals_pairwise_coprime(Index, A, ring, I)
    by def:
        ? $is_quotient_tuple(Index, A, ring, I, q)
    by induc P in Index:
        ? $has_partial_crt_representative(Index, A, ring, I, P, q)
        ? from P = {}:
            release thm matches_selected_residues_empty(Index, A, ring, I, ring.zero, q)
            witness exist representative A st {$matches_selected_residues(Index, A, ring, I, P, representative, q)} from ring.zero
            by def:
                ? $has_partial_crt_representative(Index, A, ring, I, P, q)
        ? induc inserted, Smaller:
            by def:
                ? $has_partial_crt_representative(Index, A, ring, I, Smaller, q)
            obtain old from exist representative A st {$matches_selected_residues(Index, A, ring, I, Smaller, representative, q)}
            q(inserted) $in \quotient_ring_carrier<A, ring>(I(inserted))
            \quotient_ring_carrier<A, ring>(I(inserted)) = {CarrierC power_set(A): $is_ideal_coset(A, ring, I(inserted), CarrierC)}
            q(inserted) $in {CarrierC power_set(A): $is_ideal_coset(A, ring, I(inserted), CarrierC)}
            by def:
                ? $is_ideal_coset(A, ring, I(inserted), q(inserted))
            obtain target from exist center A st {q(inserted) = \ideal_coset<A, ring>(I(inserted), center)}
            release thm ideal_coprime_with_finite_infimum(Index, A, ring, I, inserted, Smaller)
            release thm finite_infimum_property_coprime_of_not_member(Index, A, ring, I, inserted, Smaller)
            release thm crt_glue_representatives(A, ring, I(inserted), \selected_ideal_infimum<Index, A, I, Smaller>, old, target)
            obtain glued from exist candidate A st {\ideal_coset<A, ring>(\selected_ideal_infimum<Index, A, I, Smaller>, candidate) = \ideal_coset<A, ring>(\selected_ideal_infimum<Index, A, I, Smaller>, old), \ideal_coset<A, ring>(I(inserted), candidate) = \ideal_coset<A, ring>(I(inserted), target)}
            union({inserted}, Smaller) $subset Index
            claim:
                ? $matches_selected_residues(Index, A, ring, I, union({inserted}, Smaller), glued, q)
                claim:
                    ? forall idx Index:
                        idx $in union({inserted}, Smaller)
                        =>:
                            q(idx) = \ideal_coset<A, ring>(I(idx), glued)
                    idx $in {inserted} or idx $in Smaller
                    by cases:
                        ? q(idx) = \ideal_coset<A, ring>(I(idx), glued)
                        case idx $in {inserted}:
                            idx = inserted
                            release thm crt_object_substitution(Index, power_set(A), q, idx, inserted)
                            q(idx) = q(inserted)
                            release thm crt_object_substitution(Index, power_set(A), I, idx, inserted)
                            I(idx) = I(inserted)
                            q(inserted) = \ideal_coset<A, ring>(I(inserted), target)
                            \ideal_coset<A, ring>(I(inserted), glued) = \ideal_coset<A, ring>(I(inserted), target)
                            q(idx) = q(inserted) = \ideal_coset<A, ring>(I(inserted), target) = \ideal_coset<A, ring>(I(inserted), glued) = \ideal_coset<A, ring>(I(idx), glued)
                        case idx $in Smaller:
                            by def:
                                ? $matches_selected_residues(Index, A, ring, I, Smaller, old, q)
                            q(idx) = \ideal_coset<A, ring>(I(idx), old)
                            $is_ideal(A, ring, I(idx))
                            release thm selected_ideal_infimum_is_ideal(Index, A, ring, I, Smaller)
                            release thm selected_ideal_infimum_subset_selected(Index, A, I, Smaller, idx)
                            release thm ideal_coset_eq_of_subideal(A, ring, I(idx), \selected_ideal_infimum<Index, A, I, Smaller>, glued, old)
                            q(idx) = \ideal_coset<A, ring>(I(idx), old) = \ideal_coset<A, ring>(I(idx), glued)
                by def:
                    ? $matches_selected_residues(Index, A, ring, I, union({inserted}, Smaller), glued, q)
            witness exist representative A st {$matches_selected_residues(Index, A, ring, I, union({inserted}, Smaller), representative, q)} from glued
            by def:
                ? $has_partial_crt_representative(Index, A, ring, I, union({inserted}, Smaller), q)
    $has_partial_crt_representative(Index, A, ring, I, S, q)

thm chinese_map_value_unique:
    ? forall Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), value1, value2 \quotient_product<Index, A, ring, I>:
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        $is_chinese_map_value(Index, A, ring, I, source, value1)
        $is_chinese_map_value(Index, A, ring, I, source, value2)
        =>:
            value1 = value2
    obtain representative1 from $is_chinese_map_value(Index, A, ring, I, source, value1)
    obtain representative2 from $is_chinese_map_value(Index, A, ring, I, source, value2)
    by def:
        ? $has_chinese_components(Index, A, ring, I, representative1, value1)
    by def:
        ? $has_chinese_components(Index, A, ring, I, representative2, value2)
    release thm ideal_infimum_is_ideal(Index, A, ring, I)
    release thm ideal_coset_center_mem(A, ring, \ideal_infimum<Index, A, I>, representative2)
    representative2 $in \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative2)
    \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative2) = source = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative1)
    representative2 $in \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative1)
    obtain offset from $ideal_coset_member(A, ring, \ideal_infimum<Index, A, I>, representative1, representative2)
    offset $in \ideal_infimum<Index, A, I>
    by def:
        ? $belongs_to_every_ideal(Index, A, I, offset)
    claim:
        ? forall idx Index:
            value1(idx) = value2(idx)
        offset $in I(idx)
        representative2 = ring.add(representative1, offset)
        \ideal_coset<A, ring>(I(idx), representative1) = {z A: $ideal_coset_member(A, ring, I(idx), representative1, z)}
        witness $ideal_coset_member(A, ring, I(idx), representative1, representative2) from offset
        release thm set_builder_member(representative2, {z A: $ideal_coset_member(A, ring, I(idx), representative1, z)})
        representative2 $in {z A: $ideal_coset_member(A, ring, I(idx), representative1, z)}
        release thm ideal_coset_eq_of_mem(A, ring, I(idx), representative1, representative2)
        value1(idx) = \ideal_coset<A, ring>(I(idx), representative1) = \ideal_coset<A, ring>(I(idx), representative2) = value2(idx)
    by def:
        ? $fn_eq(value1, value2)

thm chinese_map_surjective:
    ? forall Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A):
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        $ideals_pairwise_coprime(Index, A, ring, I)
        =>:
            $surjective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)
    claim:
        ? forall q \quotient_product<Index, A, ring, I>:
            exist source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) st {q = \chinese_map<Index, A, ring, I>(source)}
        \quotient_product<Index, A, ring, I> = {candidate fn(idx Index) power_set(A): $is_quotient_tuple(Index, A, ring, I, candidate)}
        q $in {candidate fn(idx Index) power_set(A): $is_quotient_tuple(Index, A, ring, I, candidate)}
        by def:
            ? $is_quotient_tuple(Index, A, ring, I, q)
        Index $subset Index
        release thm finite_partial_crt_representative(Index, A, ring, I, Index, q)
        by def:
            ? $has_partial_crt_representative(Index, A, ring, I, Index, q)
        obtain representative from exist center A st {$matches_selected_residues(Index, A, ring, I, Index, center, q)}
        release thm ideal_infimum_is_ideal(Index, A, ring, I)
        release thm ideal_coset_in_quotient_ring_carrier(A, ring, \ideal_infimum<Index, A, I>, representative)
        have source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) = \ideal_coset<A, ring>(\ideal_infimum<Index, A, I>, representative)
        claim:
            ? $has_chinese_components(Index, A, ring, I, representative, q)
            by def:
                ? $matches_selected_residues(Index, A, ring, I, Index, representative, q)
            by def:
                ? $has_chinese_components(Index, A, ring, I, representative, q)
        witness $is_chinese_map_value(Index, A, ring, I, source, q) from representative
        release thm chinese_map_has_value(Index, A, ring, I, source)
        release thm chinese_map_value_unique(Index, A, ring, I, source, \chinese_map<Index, A, ring, I>(source), q)
        q = \chinese_map<Index, A, ring, I>(source)
        witness exist candidate_source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) st {q = \chinese_map<Index, A, ring, I>(candidate_source)} from source
    by def:
        ? $surjective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)

thm chinese_map_bijective:
    ? forall Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A):
        $is_commutative_ring_ideal_family(Index, A, ring, I)
        $ideals_pairwise_coprime(Index, A, ring, I)
        =>:
            $bijective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)
    release thm chinese_map_injective(Index, A, ring, I)
    release thm chinese_map_surjective(Index, A, ring, I)
    by def:
        ? $bijective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)

template<Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A): $is_commutative_ring_ideal_family(Index, A, ring, I), $ideals_pairwise_coprime(Index, A, ring, I)>:
    have fn chinese_remainder_inverse by exist!:
        ? forall q \quotient_product<Index, A, ring, I>:
            exist! source \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) st {\chinese_map<Index, A, ring, I>(source) = q}
        release thm chinese_map_surjective(Index, A, ring, I)
        by def:
            ? $surjective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)
        obtain source from exist candidate \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) st {q = \chinese_map<Index, A, ring, I>(candidate)}
        witness exist candidate \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>) st {\chinese_map<Index, A, ring, I>(candidate) = q} from source
        claim:
            ? forall source1, source2 \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>):
                \chinese_map<Index, A, ring, I>(source1) = q
                \chinese_map<Index, A, ring, I>(source2) = q
                =>:
                    source1 = source2
            release thm chinese_map_injective(Index, A, ring, I)
            by def:
                ? $injective(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)
            \chinese_map<Index, A, ring, I>(source1) = q = \chinese_map<Index, A, ring, I>(source2)
            source1 = source2

# ---------------------------------------------------------------------------
# 9.2.3 Algebras and polynomials
# ---------------------------------------------------------------------------

prop is_algebra(A, B set, addA fn(x, y A) A, mulA fn(x, y A) A, addB fn(x, y B) B, smul fn(r A, b B) B):
    forall r, s A, b B:
        smul(addA(r, s), b) = addB(smul(r, b), smul(s, b))
    forall r, s A, b B:
        smul(mulA(r, s), b) = smul(r, smul(s, b))

thm algebra_add_smul:
    ? forall A, B set, addA fn(x, y A) A, mulA fn(x, y A) A, addB fn(x, y B) B, smul fn(r A, b B) B, r, s A, b B:
        $is_algebra(A, B, addA, mulA, addB, smul)
        =>:
            smul(addA(r, s), b) = addB(smul(r, b), smul(s, b))

prop supports_polynomial(A set, zero A, p fn(n N) A, support finite_set):
    support $subset N
    forall n N:
        p(n) != zero
        =>:
            n $in support

prop polynomial_has_finite_support(A set, zero A, p fn(n N) A):
    exist support finite_set st {$supports_polynomial(A, zero, p, support)}

template<A set, zero A>:
    have polynomial_carrier power_set(fn(n N) A) = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, zero, candidate_polynomial)}

template<A set, zero A>:
    have fn polynomial_coeff(p \polynomial_carrier<A, zero>, n N) A = p(n)

# Polynomial constructors and operations remain coefficient functions with
# finite support.
prop is_polynomial_X(A set, zero, one A, p fn(n N) A):
    p(1) = one
    forall n N:
        n != 1
        =>:
            p(n) = zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_X_selected by exist!:
        ? forall marker {0}:
            exist! p \polynomial_carrier<A, ring.zero> st {$is_polynomial_X(A, ring.zero, ring.one, p)}
        have fn candidate(n N) A by cases:
            case n = 1: ring.one
            case n != 1: ring.zero
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        claim:
            ? $polynomial_has_finite_support(A, ring.zero, candidate)
            claim:
                ? $supports_polynomial(A, ring.zero, candidate, {1})
                {1} $subset N
                claim:
                    ? forall n N:
                        candidate(n) != ring.zero
                        =>:
                            n $in {1}
                    by cases:
                        ? n $in {1}
                        case n = 1:
                            n $in {1}
                        case n != 1:
                            candidate(n) = ring.zero
                            impossible candidate(n) = ring.zero
                by def:
                    ? $supports_polynomial(A, ring.zero, candidate, {1})
            witness $polynomial_has_finite_support(A, ring.zero, candidate) from {1}
        release thm set_builder_member(candidate, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        candidate $in \polynomial_carrier<A, ring.zero>
        witness exist p \polynomial_carrier<A, ring.zero> st {$is_polynomial_X(A, ring.zero, ring.one, p)} from candidate:
            candidate(1) = ring.one
            forall n N:
                n != 1
                =>:
                    candidate(n) = ring.zero
            by def:
                ? $is_polynomial_X(A, ring.zero, ring.one, candidate)
        claim:
            ? forall p, q \polynomial_carrier<A, ring.zero>:
                $is_polynomial_X(A, ring.zero, ring.one, p)
                $is_polynomial_X(A, ring.zero, ring.one, q)
                =>:
                    p = q
            claim:
                ? forall n N:
                    p(n) = q(n)
                by cases:
                    ? p(n) = q(n)
                    case n = 1:
                        p(n) = p(1) = ring.one = q(1) = q(n)
                    case n != 1:
                        p(n) = ring.zero = q(n)
            by def:
                ? $fn_eq(p, q)
            $fn_eq(p, q)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have polynomial_X \polynomial_carrier<A, ring.zero> = \polynomial_X_selected<A, ring>(0)

prop is_polynomial_C(A set, zero, a A, p fn(n N) A):
    p(0) = a
    forall n N:
        n != 0
        =>:
            p(n) = zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_C by exist!:
        ? forall a A:
            exist! p \polynomial_carrier<A, ring.zero> st {$is_polynomial_C(A, ring.zero, a, p)}
        have fn candidate(n N) A by cases:
            case n = 0: a
            case n != 0: ring.zero
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        claim:
            ? $polynomial_has_finite_support(A, ring.zero, candidate)
            claim:
                ? $supports_polynomial(A, ring.zero, candidate, {0})
                {0} $subset N
                claim:
                    ? forall n N:
                        candidate(n) != ring.zero
                        =>:
                            n $in {0}
                    by cases:
                        ? n $in {0}
                        case n = 0:
                            n $in {0}
                        case n != 0:
                            candidate(n) = ring.zero
                            impossible candidate(n) = ring.zero
                by def:
                    ? $supports_polynomial(A, ring.zero, candidate, {0})
            witness $polynomial_has_finite_support(A, ring.zero, candidate) from {0}
        release thm set_builder_member(candidate, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        candidate $in \polynomial_carrier<A, ring.zero>
        witness exist p \polynomial_carrier<A, ring.zero> st {$is_polynomial_C(A, ring.zero, a, p)} from candidate:
            candidate(0) = a
            forall n N:
                n != 0
                =>:
                    candidate(n) = ring.zero
            by def:
                ? $is_polynomial_C(A, ring.zero, a, candidate)
        claim:
            ? forall p, q \polynomial_carrier<A, ring.zero>:
                $is_polynomial_C(A, ring.zero, a, p)
                $is_polynomial_C(A, ring.zero, a, q)
                =>:
                    p = q
            claim:
                ? forall n N:
                    p(n) = q(n)
                by cases:
                    ? p(n) = q(n)
                    case n = 0:
                        p(n) = p(0) = a = q(0) = q(n)
                    case n != 0:
                        p(n) = ring.zero = q(n)
            by def:
                ? $fn_eq(p, q)
            $fn_eq(p, q)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_add_coeff(p, q \polynomial_carrier<A, ring.zero>, n N) A = ring.add(p(n), q(n))

thm polynomial_add_coeff_has_finite_support:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)})
    obtain support_p from exist support finite_set st {$supports_polynomial(A, ring.zero, p, support)}
    obtain support_q from exist support finite_set st {$supports_polynomial(A, ring.zero, q, support)}
    claim:
        ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, union(support_p, support_q))
        claim:
            ? forall index union(support_p, support_q):
                index $in N
            index $in support_p or index $in support_q
            by cases:
                ? index $in N
                case index $in support_p:
                    index $in N
                case index $in support_q:
                    index $in N
        union(support_p, support_q) $subset N
        claim:
            ? forall n N:
                \polynomial_add_coeff<A, ring>(p, q, n) != ring.zero
                =>:
                    n $in union(support_p, support_q)
            by contra:
                ? n $in union(support_p, support_q)
                claim:
                    ? p(n) = ring.zero
                    by contra:
                        ? p(n) = ring.zero
                        p(n) != ring.zero
                        n $in support_p
                        n $in union(support_p, support_q)
                        impossible n $in union(support_p, support_q)
                claim:
                    ? q(n) = ring.zero
                    by contra:
                        ? q(n) = ring.zero
                        q(n) != ring.zero
                        n $in support_q
                        n $in union(support_p, support_q)
                        impossible n $in union(support_p, support_q)
                \polynomial_add_coeff<A, ring>(p, q, n) = ring.add(p(n), q(n)) = ring.add(ring.zero, ring.zero) = ring.zero
                impossible \polynomial_add_coeff<A, ring>(p, q, n) != ring.zero
        by def:
            ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, union(support_p, support_q))
    witness $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}) from union(support_p, support_q)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_add by exist!:
        ? forall p, q \polynomial_carrier<A, ring.zero>:
            exist! result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}}
        release thm polynomial_add_coeff_has_finite_support(A, ring, p, q)
        release thm set_builder_member(fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)} $in \polynomial_carrier<A, ring.zero>
        witness exist result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}} from fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}
        claim:
            ? forall result1, result2 \polynomial_carrier<A, ring.zero>:
                result1 = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}
                result2 = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}
                =>:
                    result1 = result2
            result1 = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)} = result2

thm polynomial_add_apply:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>, n N:
        \polynomial_add<A, ring>(p, q)(n) = \polynomial_add_coeff<A, ring>(p, q, n)
    \polynomial_add<A, ring>(p, q) = fn(index N) A {\polynomial_add_coeff<A, ring>(p, q, index)}
    release thm object_substitution(fn(index N) A, A, fn(candidate fn(index N) A) A {candidate(n)}, \polynomial_add<A, ring>(p, q), fn(index N) A {\polynomial_add_coeff<A, ring>(p, q, index)})
    \polynomial_add<A, ring>(p, q)(n) = (fn(index N) A {\polynomial_add_coeff<A, ring>(p, q, index)})(n) = \polynomial_add_coeff<A, ring>(p, q, n)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_mul_term(p, q \polynomial_carrier<A, ring.zero>, n, index N) A by cases:
        case index <= n: ring.mul(p(index), q(n - index))
        case index > n: ring.zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_mul_coeff(p, q \polynomial_carrier<A, ring.zero>, n N) A = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {\polynomial_mul_term<A, ring>(p, q, n, index)}, n + 1)

thm polynomial_mul_coeff_has_finite_support:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)})
    obtain support_p from exist support finite_set st {$supports_polynomial(A, ring.zero, p, support)}
    obtain support_q from exist support finite_set st {$supports_polynomial(A, ring.zero, q, support)}
    claim:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
        $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x A:
                ring.add(x, ring.zero) = x
            release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
        by def:
            ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    have fn support_index_sum(pair cart(support_p, support_q)) N = pair[1] + pair[2]
    have product_support finite_set = fn_range(support_index_sum)
    claim:
        ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, product_support)
        claim:
            ? product_support $subset N
            claim:
                ? forall n product_support:
                    n $in N
                product_support = fn_range(support_index_sum)
                n $in fn_range(support_index_sum)
                obtain pair from exist input cart(support_p, support_q) st {n = support_index_sum(input)}
                support_index_sum(pair) $in N
            by def:
                ? product_support $subset N
        claim:
            ? forall n N:
                \polynomial_mul_coeff<A, ring>(p, q, n) != ring.zero
                =>:
                    n $in product_support
            by contra:
                ? n $in product_support
                claim:
                    ? forall index range(0, n + 1):
                        \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                    by cases:
                        ? \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                        case index <= n:
                            \polynomial_mul_term<A, ring>(p, q, n, index) = ring.mul(p(index), q(n - index))
                            by cases:
                                ? \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                                case p(index) = ring.zero:
                                    release thm chap2::zero_mul_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, q(n - index))
                                    ring.mul(p(index), q(n - index)) = ring.mul(ring.zero, q(n - index)) = ring.zero
                                case p(index) != ring.zero:
                                    claim:
                                        ? q(n - index) = ring.zero
                                        by contra:
                                            ? q(n - index) = ring.zero
                                            q(n - index) != ring.zero
                                            index $in support_p
                                            n - index $in support_q
                                            (index, n - index) $in cart(support_p, support_q)
                                            support_index_sum((index, n - index)) $in fn_range(support_index_sum)
                                            support_index_sum((index, n - index)) = index + (n - index)
                                            index + (n - index) $in fn_range(support_index_sum)
                                            n = index + (n - index)
                                            n $in product_support
                                            impossible n $in product_support
                                    release thm chap2::mul_zero_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, p(index))
                                    ring.mul(p(index), q(n - index)) = ring.mul(p(index), ring.zero) = ring.zero
                        case index > n:
                            \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                release thm finite_range_sum_all_zero(A, ring.add, ring.zero, fn(index N) A {\polynomial_mul_term<A, ring>(p, q, n, index)}, n + 1)
                \polynomial_mul_coeff<A, ring>(p, q, n) = ring.zero
                impossible \polynomial_mul_coeff<A, ring>(p, q, n) != ring.zero
        by def:
            ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, product_support)
    witness $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}) from product_support

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_mul by exist!:
        ? forall p, q \polynomial_carrier<A, ring.zero>:
            exist! result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}}
        release thm polynomial_mul_coeff_has_finite_support(A, ring, p, q)
        release thm set_builder_member(fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)} $in \polynomial_carrier<A, ring.zero>
        witness exist result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}} from fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}
        claim:
            ? forall result1, result2 \polynomial_carrier<A, ring.zero>:
                result1 = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}
                result2 = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}
                =>:
                    result1 = result2
            result1 = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)} = result2

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_pow(p \polynomial_carrier<A, ring.zero>, n N) \polynomial_carrier<A, ring.zero> by induc n from 0:
        case n = 0: \polynomial_C<A, ring>(ring.one)
        case n > 0: \polynomial_mul<A, ring>(polynomial_pow(p, n - 1), p)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_nonzero_support(p \polynomial_carrier<A, ring.zero>) power_set(N) = {n N: p(n) != ring.zero}

thm polynomial_nonzero_support_is_finite:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        $is_finite_set(\polynomial_nonzero_support<A, ring>(p))
    obtain support from exist support finite_set st {$supports_polynomial(A, ring.zero, p, support)}
    claim:
        ? \polynomial_nonzero_support<A, ring>(p) $subset support
        claim:
            ? forall n \polynomial_nonzero_support<A, ring>(p):
                n $in support
            p(n) != ring.zero
        by def:
            ? \polynomial_nonzero_support<A, ring>(p) $subset support
    \polynomial_nonzero_support<A, ring>(p) = set_minus(support, set_minus(support, \polynomial_nonzero_support<A, ring>(p)))
    $is_finite_set(set_minus(support, set_minus(support, \polynomial_nonzero_support<A, ring>(p))))

template<A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>>:
    have polynomial_nonzero_support_finite finite_set = \polynomial_nonzero_support<A, ring>(p)

prop is_polynomial_eval_bound(A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, bound N):
    bound $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
    forall n N:
        n $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
        =>:
            n <= bound

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_eval_bound by exist!:
        ? forall p \polynomial_carrier<A, ring.zero>:
            exist! bound N st {$is_polynomial_eval_bound(A, ring, p, bound)}
        claim:
            ? \polynomial_nonzero_support_finite<A, ring, p> $subset N
            \polynomial_nonzero_support_finite<A, ring, p> = \polynomial_nonzero_support<A, ring>(p)
            claim:
                ? forall n \polynomial_nonzero_support<A, ring>(p):
                    n $in N
            by def:
                ? \polynomial_nonzero_support<A, ring>(p) $subset N
        $is_finite_set(union({0}, \polynomial_nonzero_support_finite<A, ring, p>))
        witness $is_nonempty_set(union({0}, \polynomial_nonzero_support_finite<A, ring, p>)) from 0:
            0 $in {0}
            0 $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
        union({0}, \polynomial_nonzero_support_finite<A, ring, p>) $subset N
        exist bound N st {$is_polynomial_eval_bound(A, ring, p, bound)}
        obtain candidate from exist bound N st {$is_polynomial_eval_bound(A, ring, p, bound)}
        witness exist bound N st {$is_polynomial_eval_bound(A, ring, p, bound)} from candidate
        claim:
            ? forall bound1, bound2 N:
                $is_polynomial_eval_bound(A, ring, p, bound1)
                $is_polynomial_eval_bound(A, ring, p, bound2)
                =>:
                    bound1 = bound2
            bound1 <= bound2
            bound2 <= bound1

thm polynomial_eval_bound_is_natural:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        \polynomial_eval_bound<A, ring>(p) $in N

thm polynomial_eval_bound_member:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        \polynomial_eval_bound<A, ring>(p) $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
    $is_polynomial_eval_bound(A, ring, p, \polynomial_eval_bound<A, ring>(p))

thm polynomial_eval_bound_dominates:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, n N:
        n $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
        =>:
            n <= \polynomial_eval_bound<A, ring>(p)
    $is_polynomial_eval_bound(A, ring, p, \polynomial_eval_bound<A, ring>(p))

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_scalar_pow(x A, n N) A by induc n from 0:
        case n = 0: ring.one
        case n > 0: ring.mul(polynomial_scalar_pow(x, n - 1), x)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_eval(p \polynomial_carrier<A, ring.zero>, x A) A = \finite_range_sum<A, ring.add, ring.zero>(fn(n N) A {ring.mul(p(n), \polynomial_scalar_pow<A, ring>(x, n))}, \polynomial_eval_bound<A, ring>(p) + 1)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_nat_degree(p \polynomial_carrier<A, ring.zero>) N = \polynomial_eval_bound<A, ring>(p)

prop is_polynomial_root(A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, x A):
    \polynomial_eval<A, ring>(p, x) = ring.zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_roots(p \polynomial_carrier<A, ring.zero>) power_set(A) = {x A: $is_polynomial_root(A, ring, p, x)}

# The source's `natDegree_mul` is checked by exposing the finite convolution:
# all terms except the leading-index term vanish, while every nonzero product
# coefficient lies below the sum of the two factor degrees.
thm polynomial_coeff_nonzero_le_degree:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, n N:
        p(n) != ring.zero
        =>:
            n <= \polynomial_nat_degree<A, ring>(p)
    \polynomial_nonzero_support<A, ring>(p) = {index N: p(index) != ring.zero}
    release thm set_builder_member(n, {index N: p(index) != ring.zero})
    n $in \polynomial_nonzero_support<A, ring>(p)
    \polynomial_nonzero_support_finite<A, ring, p> = \polynomial_nonzero_support<A, ring>(p)
    n $in \polynomial_nonzero_support_finite<A, ring, p>
    n $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
    release thm polynomial_eval_bound_dominates(A, ring, p, n)
    \polynomial_nat_degree<A, ring>(p) = \polynomial_eval_bound<A, ring>(p)

thm polynomial_nonzero_has_nonzero_coeff:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        p != \polynomial_C<A, ring>(ring.zero)
        =>:
            exist n N st {p(n) != ring.zero}
    by contra:
        ? exist n N st {p(n) != ring.zero}
        claim:
            ? forall n N:
                p(n) = ring.zero
            by contra:
                ? p(n) = ring.zero
                witness exist index N st {p(index) != ring.zero} from n
                impossible p(n) != ring.zero
        $is_polynomial_C(A, ring.zero, ring.zero, \polynomial_C<A, ring>(ring.zero))
        claim:
            ? forall n N:
                p(n) = \polynomial_C<A, ring>(ring.zero)(n)
            by cases:
                ? p(n) = \polynomial_C<A, ring>(ring.zero)(n)
                case n = 0:
                    p(n) = ring.zero = \polynomial_C<A, ring>(ring.zero)(0) = \polynomial_C<A, ring>(ring.zero)(n)
                case n != 0:
                    p(n) = ring.zero = \polynomial_C<A, ring>(ring.zero)(n)
        by def $fn_eq(p, \polynomial_C<A, ring>(ring.zero))
        p = \polynomial_C<A, ring>(ring.zero)
        impossible p = \polynomial_C<A, ring>(ring.zero)

thm polynomial_degree_coeff_nonzero:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        p != \polynomial_C<A, ring>(ring.zero)
        =>:
            p(\polynomial_nat_degree<A, ring>(p)) != ring.zero
    release thm polynomial_nonzero_has_nonzero_coeff(A, ring, p)
    obtain witness_n from exist n N st {p(n) != ring.zero}
    have degree N = \polynomial_nat_degree<A, ring>(p)
    release thm polynomial_eval_bound_member(A, ring, p)
    \polynomial_nat_degree<A, ring>(p) = \polynomial_eval_bound<A, ring>(p)
    degree $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
    degree $in {0} or degree $in \polynomial_nonzero_support_finite<A, ring, p>
    by cases:
        ? p(degree) != ring.zero
        case degree $in {0}:
            degree = 0
            release thm polynomial_coeff_nonzero_le_degree(A, ring, p, witness_n)
            witness_n <= \polynomial_nat_degree<A, ring>(p) = degree = 0
            witness_n = 0 = degree
            p(degree) = p(witness_n) != ring.zero
        case degree $in \polynomial_nonzero_support_finite<A, ring, p>:
            \polynomial_nonzero_support_finite<A, ring, p> = \polynomial_nonzero_support<A, ring>(p)
            degree $in \polynomial_nonzero_support<A, ring>(p)
            \polynomial_nonzero_support<A, ring>(p) = {index N: p(index) != ring.zero}
            degree $in {index N: p(index) != ring.zero}
            p(degree) != ring.zero
    degree = \polynomial_nat_degree<A, ring>(p)

thm polynomial_mul_apply:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>, n N:
        \polynomial_mul<A, ring>(p, q)(n) = \polynomial_mul_coeff<A, ring>(p, q, n)
    \polynomial_mul<A, ring>(p, q) = fn(index N) A {\polynomial_mul_coeff<A, ring>(p, q, index)}
    release thm object_substitution(fn(index N) A, A, fn(candidate fn(index N) A) A {candidate(n)}, \polynomial_mul<A, ring>(p, q), fn(index N) A {\polynomial_mul_coeff<A, ring>(p, q, index)})
    \polynomial_mul<A, ring>(p, q)(n) = (fn(index N) A {\polynomial_mul_coeff<A, ring>(p, q, index)})(n) = \polynomial_mul_coeff<A, ring>(p, q, n)

thm finite_range_sum_single:
    ? forall M nonempty_set, add fn(x, y M) M, zero M, f fn(index N) M, n, selected N:
        $is_additive_commutative_monoid(M, add, zero)
        selected < n
        forall index range(0, n):
            index != selected
            =>:
                f(index) = zero
        =>:
            \finite_range_sum<M, add, zero>(f, n) = f(selected)
    prop _finite_range_sum_single_at(count N):
        forall selected_index N:
            selected_index < count
            forall index range(0, count):
                index != selected_index
                =>:
                    f(index) = zero
            =>:
                \finite_range_sum<M, add, zero>(f, count) = f(selected_index)
    claim:
        ? forall count N:
            $_finite_range_sum_single_at(count)
        by induc count from 0:
            ? $_finite_range_sum_single_at(count)
            ? from count = 0:
                claim:
                    ? forall selected_index N:
                        selected_index < count
                        forall index range(0, count):
                            index != selected_index
                            =>:
                                f(index) = zero
                        =>:
                            \finite_range_sum<M, add, zero>(f, count) = f(selected_index)
                    by contra:
                        ? \finite_range_sum<M, add, zero>(f, count) = f(selected_index)
                        selected_index >= 0 = count
                        impossible selected_index < count
                by def:
                    ? $_finite_range_sum_single_at(count)
            ? induc:
                $_finite_range_sum_single_at(count)
                claim:
                    ? forall selected_index N:
                        selected_index < count + 1
                        forall index range(0, count + 1):
                            index != selected_index
                            =>:
                                f(index) = zero
                        =>:
                            \finite_range_sum<M, add, zero>(f, count + 1) = f(selected_index)
                    by cases:
                        ? \finite_range_sum<M, add, zero>(f, count + 1) = f(selected_index)
                        case selected_index = count:
                            claim:
                                ? forall index range(0, count):
                                    f(index) = zero
                                index < count = selected_index
                                index != selected_index
                            release thm finite_range_sum_all_zero(M, add, zero, f, count)
                            release thm finite_range_sum_succ(M, add, zero, f, count)
                            \finite_range_sum<M, add, zero>(f, count + 1) = add(\finite_range_sum<M, add, zero>(f, count), f(count)) = add(zero, f(count)) = f(count) = f(selected_index)
                        case selected_index < count:
                            claim:
                                ? forall index range(0, count):
                                    index != selected_index
                                    =>:
                                        f(index) = zero
                                index < count < count + 1
                            $_finite_range_sum_single_at(count)
                            \finite_range_sum<M, add, zero>(f, count) = f(selected_index)
                            count < count + 1
                            count != selected_index
                            f(count) = zero
                            release thm finite_range_sum_succ(M, add, zero, f, count)
                            \finite_range_sum<M, add, zero>(f, count + 1) = add(\finite_range_sum<M, add, zero>(f, count), f(count)) = add(f(selected_index), zero) = f(selected_index)
                by def:
                    ? $_finite_range_sum_single_at(count + 1)
    $_finite_range_sum_single_at(n)

thm polynomial_C_zero_apply:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, n N:
        \polynomial_C<A, ring>(ring.zero)(n) = ring.zero
    $is_polynomial_C(A, ring.zero, ring.zero, \polynomial_C<A, ring>(ring.zero))
    by cases:
        ? \polynomial_C<A, ring>(ring.zero)(n) = ring.zero
        case n = 0:
            \polynomial_C<A, ring>(ring.zero)(n) = \polynomial_C<A, ring>(ring.zero)(0) = ring.zero
        case n != 0:
            \polynomial_C<A, ring>(ring.zero)(n) = ring.zero

thm polynomial_mul_leading_coeff:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        \polynomial_mul<A, ring>(p, q)(\polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)) = ring.mul(p(\polynomial_nat_degree<A, ring>(p)), q(\polynomial_nat_degree<A, ring>(q)))
    have degree_p N = \polynomial_nat_degree<A, ring>(p)
    have degree_q N = \polynomial_nat_degree<A, ring>(q)
    have total_degree N = degree_p + degree_q
    claim:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
        $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x A:
                ring.add(x, ring.zero) = x
            release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
        by def:
            ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    claim:
        ? forall index range(0, total_degree + 1):
            index != degree_p
            =>:
                \polynomial_mul_term<A, ring>(p, q, total_degree, index) = ring.zero
        index < total_degree + 1
        index <= total_degree
        \polynomial_mul_term<A, ring>(p, q, total_degree, index) = ring.mul(p(index), q(total_degree - index))
        by cases:
            ? \polynomial_mul_term<A, ring>(p, q, total_degree, index) = ring.zero
            case index = degree_p:
                impossible index != degree_p
            case index < degree_p:
                claim:
                    ? q(total_degree - index) = ring.zero
                    by contra:
                        ? q(total_degree - index) = ring.zero
                        release thm polynomial_coeff_nonzero_le_degree(A, ring, q, total_degree - index)
                        total_degree - index <= \polynomial_nat_degree<A, ring>(q) = degree_q
                        total_degree = degree_p + degree_q
                        total_degree - index + index = total_degree
                        total_degree = total_degree - index + index <= degree_q + index < degree_q + degree_p = degree_p + degree_q = total_degree
                        impossible total_degree < total_degree
                release thm chap2::mul_zero_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, p(index))
                \polynomial_mul_term<A, ring>(p, q, total_degree, index) = ring.mul(p(index), q(total_degree - index)) = ring.mul(p(index), ring.zero) = ring.zero
            case index > degree_p:
                claim:
                    ? p(index) = ring.zero
                    by contra:
                        ? p(index) = ring.zero
                        release thm polynomial_coeff_nonzero_le_degree(A, ring, p, index)
                        index <= \polynomial_nat_degree<A, ring>(p) = degree_p
                        impossible index > degree_p
                release thm chap2::zero_mul_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, q(total_degree - index))
                \polynomial_mul_term<A, ring>(p, q, total_degree, index) = ring.mul(p(index), q(total_degree - index)) = ring.mul(ring.zero, q(total_degree - index)) = ring.zero
    degree_p <= degree_p + degree_q = total_degree
    total_degree < total_degree + 1
    degree_p < total_degree + 1
    release thm finite_range_sum_single(A, ring.add, ring.zero, fn(index N) A {\polynomial_mul_term<A, ring>(p, q, total_degree, index)}, total_degree + 1, degree_p)
    total_degree - degree_p = degree_q
    \polynomial_mul_term<A, ring>(p, q, total_degree, degree_p) = ring.mul(p(degree_p), q(total_degree - degree_p)) = ring.mul(p(degree_p), q(degree_q))
    \polynomial_mul_coeff<A, ring>(p, q, total_degree) = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {\polynomial_mul_term<A, ring>(p, q, total_degree, index)}, total_degree + 1) = \polynomial_mul_term<A, ring>(p, q, total_degree, degree_p) = ring.mul(p(degree_p), q(degree_q))
    release thm polynomial_mul_apply(A, ring, p, q, total_degree)
    \polynomial_mul<A, ring>(p, q)(total_degree) = \polynomial_mul_coeff<A, ring>(p, q, total_degree) = ring.mul(p(degree_p), q(degree_q))
    total_degree = degree_p + degree_q = \polynomial_nat_degree<A, ring>(p) + degree_q = \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)
    \polynomial_mul<A, ring>(p, q)(\polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)) = \polynomial_mul<A, ring>(p, q)(total_degree) = ring.mul(p(degree_p), q(degree_q)) = ring.mul(p(\polynomial_nat_degree<A, ring>(p)), q(\polynomial_nat_degree<A, ring>(q)))

thm polynomial_mul_coeff_nonzero_le_degree_sum:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>, n N:
        \polynomial_mul<A, ring>(p, q)(n) != ring.zero
        =>:
            n <= \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)
    claim:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
        $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x A:
                ring.add(x, ring.zero) = x
            release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
        by def:
            ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    release thm polynomial_mul_apply(A, ring, p, q, n)
    \polynomial_mul_coeff<A, ring>(p, q, n) != ring.zero
    claim:
        ? exist index range(0, n + 1) st {\polynomial_mul_term<A, ring>(p, q, n, index) != ring.zero}
        by contra:
            ? exist index range(0, n + 1) st {\polynomial_mul_term<A, ring>(p, q, n, index) != ring.zero}
            claim:
                ? forall index range(0, n + 1):
                    \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                by contra:
                    ? \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                    witness exist selected range(0, n + 1) st {\polynomial_mul_term<A, ring>(p, q, n, selected) != ring.zero} from index
                    impossible \polynomial_mul_term<A, ring>(p, q, n, index) != ring.zero
            release thm finite_range_sum_all_zero(A, ring.add, ring.zero, fn(index N) A {\polynomial_mul_term<A, ring>(p, q, n, index)}, n + 1)
            \polynomial_mul_coeff<A, ring>(p, q, n) = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {\polynomial_mul_term<A, ring>(p, q, n, index)}, n + 1) = ring.zero
            impossible \polynomial_mul_coeff<A, ring>(p, q, n) != ring.zero
    obtain selected_index from exist index range(0, n + 1) st {\polynomial_mul_term<A, ring>(p, q, n, index) != ring.zero}
    selected_index < n + 1
    selected_index <= n
    \polynomial_mul_term<A, ring>(p, q, n, selected_index) = ring.mul(p(selected_index), q(n - selected_index))
    ring.mul(p(selected_index), q(n - selected_index)) != ring.zero
    claim:
        ? p(selected_index) != ring.zero
        by contra:
            ? p(selected_index) != ring.zero
            release thm chap2::zero_mul_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, q(n - selected_index))
            ring.mul(p(selected_index), q(n - selected_index)) = ring.mul(ring.zero, q(n - selected_index)) = ring.zero
            impossible ring.mul(p(selected_index), q(n - selected_index)) != ring.zero
    claim:
        ? q(n - selected_index) != ring.zero
        by contra:
            ? q(n - selected_index) != ring.zero
            release thm chap2::mul_zero_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, p(selected_index))
            ring.mul(p(selected_index), q(n - selected_index)) = ring.mul(p(selected_index), ring.zero) = ring.zero
            impossible ring.mul(p(selected_index), q(n - selected_index)) != ring.zero
    release thm polynomial_coeff_nonzero_le_degree(A, ring, p, selected_index)
    release thm polynomial_coeff_nonzero_le_degree(A, ring, q, n - selected_index)
    selected_index <= \polynomial_nat_degree<A, ring>(p)
    n - selected_index <= \polynomial_nat_degree<A, ring>(q)
    n - selected_index + selected_index = n
    n = n - selected_index + selected_index <= \polynomial_nat_degree<A, ring>(q) + \polynomial_nat_degree<A, ring>(p) = \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)

thm polynomial_mul_leading_coeff_nonzero:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $has_no_zero_divisors(A, ring.zero, ring.mul)
        p != \polynomial_C<A, ring>(ring.zero)
        q != \polynomial_C<A, ring>(ring.zero)
        =>:
            \polynomial_mul<A, ring>(p, q)(\polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)) != ring.zero
    release thm polynomial_degree_coeff_nonzero(A, ring, p)
    release thm polynomial_degree_coeff_nonzero(A, ring, q)
    release thm polynomial_mul_leading_coeff(A, ring, p, q)
    by contra:
        ? \polynomial_mul<A, ring>(p, q)(\polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)) != ring.zero
        ring.mul(p(\polynomial_nat_degree<A, ring>(p)), q(\polynomial_nat_degree<A, ring>(q))) = ring.zero
        by def:
            ? $has_no_zero_divisors(A, ring.zero, ring.mul)
        p(\polynomial_nat_degree<A, ring>(p)) = ring.zero or q(\polynomial_nat_degree<A, ring>(q)) = ring.zero
        claim:
            ? p(\polynomial_nat_degree<A, ring>(p)) = ring.zero
            by cases:
                ? p(\polynomial_nat_degree<A, ring>(p)) = ring.zero
                case p(\polynomial_nat_degree<A, ring>(p)) = ring.zero
                case q(\polynomial_nat_degree<A, ring>(q)) = ring.zero:
                    impossible q(\polynomial_nat_degree<A, ring>(q)) != ring.zero
        impossible p(\polynomial_nat_degree<A, ring>(p)) != ring.zero

thm polynomial_mul_nonzero:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $has_no_zero_divisors(A, ring.zero, ring.mul)
        p != \polynomial_C<A, ring>(ring.zero)
        q != \polynomial_C<A, ring>(ring.zero)
        =>:
            \polynomial_mul<A, ring>(p, q) != \polynomial_C<A, ring>(ring.zero)
    have leading_index N = \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)
    release thm polynomial_mul_leading_coeff_nonzero(A, ring, p, q)
    release thm polynomial_C_zero_apply(A, ring, leading_index)
    release thm object_substitution(N, A, fn(index N) A {\polynomial_mul<A, ring>(p, q)(index)}, leading_index, \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q))
    \polynomial_mul<A, ring>(p, q)(leading_index) = \polynomial_mul<A, ring>(p, q)(\polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q))
    \polynomial_mul<A, ring>(p, q)(leading_index) != ring.zero
    by contra:
        ? \polynomial_mul<A, ring>(p, q) != \polynomial_C<A, ring>(ring.zero)
        release thm object_substitution(fn(index N) A, A, fn(candidate fn(index N) A) A {candidate(leading_index)}, \polynomial_mul<A, ring>(p, q), \polynomial_C<A, ring>(ring.zero))
        \polynomial_mul<A, ring>(p, q)(leading_index) = \polynomial_C<A, ring>(ring.zero)(leading_index) = ring.zero
        impossible \polynomial_mul<A, ring>(p, q)(leading_index) != ring.zero

thm polynomial_nat_degree_mul:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $has_no_zero_divisors(A, ring.zero, ring.mul)
        p != \polynomial_C<A, ring>(ring.zero)
        q != \polynomial_C<A, ring>(ring.zero)
        =>:
            \polynomial_nat_degree<A, ring>(\polynomial_mul<A, ring>(p, q)) = \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)
    release thm polynomial_mul_nonzero(A, ring, p, q)
    release thm polynomial_degree_coeff_nonzero(A, ring, \polynomial_mul<A, ring>(p, q))
    release thm polynomial_mul_coeff_nonzero_le_degree_sum(A, ring, p, q, \polynomial_nat_degree<A, ring>(\polynomial_mul<A, ring>(p, q)))
    \polynomial_nat_degree<A, ring>(\polynomial_mul<A, ring>(p, q)) <= \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)
    release thm polynomial_mul_leading_coeff_nonzero(A, ring, p, q)
    release thm polynomial_coeff_nonzero_le_degree(A, ring, \polynomial_mul<A, ring>(p, q), \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q))
    \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q) <= \polynomial_nat_degree<A, ring>(\polynomial_mul<A, ring>(p, q))

thm polynomial_X_sub_C_eval:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, r A:
        \polynomial_eval<A, ring>(\polynomial_add<A, ring>(\polynomial_X<A, ring>, \polynomial_C<A, ring>(ring.neg(r))), r) = ring.zero
    have px \polynomial_carrier<A, ring.zero> = \polynomial_X<A, ring>
    have pc \polynomial_carrier<A, ring.zero> = \polynomial_C<A, ring>(ring.neg(r))
    have p \polynomial_carrier<A, ring.zero> = \polynomial_add<A, ring>(px, pc)
    claim:
        ? forall n N:
            p(n) = ring.add(px(n), pc(n))
        p = \polynomial_add<A, ring>(px, pc)
        release thm object_substitution(fn(index N) A, A, fn(candidate fn(index N) A) A {candidate(n)}, p, \polynomial_add<A, ring>(px, pc))
        release thm polynomial_add_apply(A, ring, px, pc, n)
        p(n) = \polynomial_add<A, ring>(px, pc)(n) = \polynomial_add_coeff<A, ring>(px, pc, n) = ring.add(px(n), pc(n))
    p $in \polynomial_carrier<A, ring.zero>
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    claim:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
        $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x A:
                ring.add(x, ring.zero) = x
            release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
        by def:
            ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    by cases:
        ? \polynomial_eval<A, ring>(p, r) = ring.zero
        case ring.one = ring.zero:
            $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
            $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
            release thm chap2::zero_mul_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, \polynomial_eval<A, ring>(p, r))
            ring.mul(ring.one, \polynomial_eval<A, ring>(p, r)) = \polynomial_eval<A, ring>(p, r)
            ring.mul(ring.one, \polynomial_eval<A, ring>(p, r)) = ring.mul(ring.zero, \polynomial_eval<A, ring>(p, r)) = ring.zero
            \polynomial_eval<A, ring>(p, r) = ring.zero
        case ring.one != ring.zero:
            $is_polynomial_X(A, ring.zero, ring.one, \polynomial_X_selected<A, ring>(0))
            px = \polynomial_X_selected<A, ring>(0)
            $is_polynomial_X(A, ring.zero, ring.one, px)
            $is_polynomial_C(A, ring.zero, ring.neg(r), \polynomial_C<A, ring>(ring.neg(r)))
            pc = \polynomial_C<A, ring>(ring.neg(r))
            $is_polynomial_C(A, ring.zero, ring.neg(r), pc)
            px(0) = ring.zero
            pc(0) = ring.neg(r)
            p(0) = ring.add(px(0), pc(0)) = ring.add(ring.zero, ring.neg(r)) = ring.neg(r)
            px(1) = ring.one
            pc(1) = ring.zero
            release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, ring.one)
            p(1) = ring.add(px(1), pc(1)) = ring.add(ring.one, ring.zero) = ring.one
            1 $in \polynomial_nonzero_support<A, ring>(p)
            claim:
                ? \polynomial_nonzero_support<A, ring>(p) $subset {0, 1}
                claim:
                    ? forall n \polynomial_nonzero_support<A, ring>(p):
                        n $in {0, 1}
                    p(n) != ring.zero
                    by cases:
                        ? n $in {0, 1}
                        case n = 0:
                            n $in {0, 1}
                        case n != 0:
                            by cases:
                                ? n $in {0, 1}
                                case n = 1:
                                    n $in {0, 1}
                                case n != 1:
                                    px(n) = ring.zero
                                    pc(n) = ring.zero
                                    p(n) = ring.add(px(n), pc(n)) = ring.add(ring.zero, ring.zero) = ring.zero
                                    impossible p(n) = ring.zero
                by def:
                    ? \polynomial_nonzero_support<A, ring>(p) $subset {0, 1}
            claim:
                ? union({0}, \polynomial_nonzero_support_finite<A, ring, p>) $subset {0, 1}
                claim:
                    ? forall n union({0}, \polynomial_nonzero_support_finite<A, ring, p>):
                        n $in {0, 1}
                    by cases:
                        ? n $in {0, 1}
                        case n $in {0}:
                            n = 0
                            n $in {0, 1}
                        case n $in \polynomial_nonzero_support_finite<A, ring, p>:
                            n $in \polynomial_nonzero_support<A, ring>(p)
                            n $in {0, 1}
                by def:
                    ? union({0}, \polynomial_nonzero_support_finite<A, ring, p>) $subset {0, 1}
            1 $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
            have bound N = \polynomial_eval_bound<A, ring>(p)
            release thm polynomial_eval_bound_member(A, ring, p)
            bound $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
            bound $in {0, 1}
            release thm polynomial_eval_bound_dominates(A, ring, p, 1)
            bound >= 1
            bound = 0 or bound = 1
            by cases:
                ? bound = 1
                case bound = 0:
                    0 >= 1
                    impossible 0 >= 1
                case bound = 1:
                    bound = 1
            \polynomial_eval_bound<A, ring>(p) = bound = 1
            \polynomial_scalar_pow<A, ring>(r, 0) = ring.one
            \polynomial_scalar_pow<A, ring>(r, 1) = ring.mul(\polynomial_scalar_pow<A, ring>(r, 0), r) = ring.mul(ring.one, r) = r
            have fn term(n N) A = ring.mul(p(n), \polynomial_scalar_pow<A, ring>(r, n))
            term(0) = ring.mul(p(0), \polynomial_scalar_pow<A, ring>(r, 0)) = ring.mul(ring.neg(r), ring.one) = ring.neg(r)
            term(1) = ring.mul(p(1), \polynomial_scalar_pow<A, ring>(r, 1)) = ring.mul(ring.one, r) = r
            release thm finite_range_sum_zero(A, ring.add, ring.zero, term)
            release thm finite_range_sum_succ(A, ring.add, ring.zero, term, 0)
            release thm finite_range_sum_succ(A, ring.add, ring.zero, term, 1)
            \finite_range_sum<A, ring.add, ring.zero>(term, 0) = ring.zero
            \finite_range_sum<A, ring.add, ring.zero>(term, 1) = ring.add(\finite_range_sum<A, ring.add, ring.zero>(term, 0), term(0)) = ring.add(ring.zero, ring.neg(r)) = ring.neg(r)
            \finite_range_sum<A, ring.add, ring.zero>(term, 2) = ring.add(\finite_range_sum<A, ring.add, ring.zero>(term, 1), term(1)) = ring.add(ring.neg(r), r) = ring.zero
            \polynomial_eval<A, ring>(p, r) = \finite_range_sum<A, ring.add, ring.zero>(term, \polynomial_eval_bound<A, ring>(p) + 1) = \finite_range_sum<A, ring.add, ring.zero>(term, 2) = ring.zero
    release thm object_substitution(\polynomial_carrier<A, ring.zero>, A, fn(candidate \polynomial_carrier<A, ring.zero>) A {\polynomial_eval<A, ring>(candidate, r)}, p, \polynomial_add<A, ring>(px, pc))
    \polynomial_eval<A, ring>(\polynomial_add<A, ring>(\polynomial_X<A, ring>, \polynomial_C<A, ring>(ring.neg(r))), r) = \polynomial_eval<A, ring>(\polynomial_add<A, ring>(px, pc), r) = \polynomial_eval<A, ring>(p, r) = ring.zero
