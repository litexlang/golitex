thm quotient_ring_tuple_is_commutative_ring:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A):
        $is_ideal(A, ring, I)
        =>:
            (\quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>) $in &chap7::CommutativeRing<\quotient_ring_nonempty<A, ring, I>>
    let qmk = \quotient_ring_mk<A, ring, I>
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    prop _quotient_ring_add_identity_inverse(q \quotient_ring_nonempty<A, ring, I>):
        \quotient_ring_add<A, ring, I>(\quotient_ring_zero<A, ring, I>, q) = q
        \quotient_ring_add<A, ring, I>(\quotient_ring_neg<A, ring, I>(q), q) = \quotient_ring_zero<A, ring, I>
    prop _quotient_ring_mul_bundle(q, r, s \quotient_ring_nonempty<A, ring, I>):
        \quotient_ring_mul<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, r), s) = \quotient_ring_mul<A, ring, I>(q, \quotient_ring_mul<A, ring, I>(r, s))
