        \quotient_ring_nonempty<A, ring, I> = \quotient_ring_carrier<A, ring>(I)
        \ideal_coset<A, ring>(I, ring.mul(a, b)) $in \quotient_ring_nonempty<A, ring, I>
        have candidate \quotient_ring_nonempty<A, ring, I> = \ideal_coset<A, ring>(I, ring.mul(a, b))
        witness exist s \quotient_ring_nonempty<A, ring, I> st {$is_quotient_ring_mul_value(A, ring, I, q, r, s)} from candidate:
            witness exist a0, b0 A st {q = \ideal_coset<A, ring>(I, a0), r = \ideal_coset<A, ring>(I, b0), candidate = \ideal_coset<A, ring>(I, ring.mul(a0, b0))} from a, b
            by def:
                ? $is_quotient_ring_mul_value(A, ring, I, q, r, candidate)
        claim:
            ? forall s1, s2 \quotient_ring_nonempty<A, ring, I>:
                $is_quotient_ring_mul_value(A, ring, I, q, r, s1)
