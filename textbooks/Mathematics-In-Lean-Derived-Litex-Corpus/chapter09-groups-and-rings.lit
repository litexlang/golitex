            preimage_coordinate_forward(x) = (\quotient_group_mk<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x), \left_coset_coordinate<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>(x))
