    $is_finite_set(cart(K, H))
    finite_set_size(\sylow_quotient_preimage<G, group, H>(K)) = finite_set_size(cart(K, H)) = finite_set_size(K) * finite_set_size(H)

# One Sylow extension step: a subgroup of order p^k grows to one of order
# p^(k+1) through a prime-order subgroup of its normalizer quotient.

thm p_power_subgroup_successor:
    ? forall G nonempty_set, group &chap2::Group<G>, H power_set(G), p N+, k N:
        $is_subgroup(G, group, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $prime(p)
        finite_set_size(H) = p^k
        $chap2::divides(p^(k + 1), finite_set_size(G))
        =>:
            exist P power_set(G) st {$is_subgroup(G, group, P), $is_finite_set(P), finite_set_size(P) = p^(k + 1)}
    release thm subgroup_normalizer_closed(G, group, H)
    release thm subgroup_normal_in_normalizer(G, group, H)
    release thm normalizer_quotient_has_prime_subgroup(G, group, H, p, k)
    obtain K from exist K power_set(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>) st {$is_subgroup(\quotient_group_nonempty<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, \quotient_group<\subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H>, K), $is_finite_set(K), finite_set_size(K) = p}
    release thm sylow_quotient_preimage_closed(G, group, H, K)
    release thm sylow_quotient_preimage_finite(G, group, H, K)
    release thm sylow_quotient_preimage_cardinality(G, group, H, K)
    finite_set_size(\sylow_quotient_preimage<G, group, H>(K)) = finite_set_size(K) * finite_set_size(H) = p * p^k = p^(k + 1)
    have P power_set(G) = \sylow_quotient_preimage<G, group, H>(K)
    finite_set_size(P) = finite_set_size(\sylow_quotient_preimage<G, group, H>(K)) = p^(k + 1)
    witness exist next_subgroup power_set(G) st {$is_subgroup(G, group, next_subgroup), $is_finite_set(next_subgroup), finite_set_size(next_subgroup) = p^(k + 1)} from P

thm prime_power_divisor_predecessor:
    ? forall p N+, k, value N:
        $chap2::divides(p^(k + 1), value)
        =>:
            $chap2::divides(p^k, value)
    obtain quotient from $chap2::divides(p^(k + 1), value)
    p^(k + 1) = p^k * p
    release thm object_substitution(Z, Z, fn(t Z) Z {t * quotient}, p^(k + 1), p^k * p)
    p^(k + 1) * quotient = (p^k * p) * quotient
    (p^k * p) * quotient = p^k * (p * quotient)
    value = p^(k + 1) * quotient = (p^k * p) * quotient = p^k * (p * quotient)
    witness $chap2::divides(p^k, value) from p * quotient

# First Sylow theorem, proved by induction from the explicit successor step.

prop p_power_subgroup_exists_at(G nonempty_set, group &chap2::Group<G>, p N+, exponent N):
    forall token N:
        $is_finite_set(G)
        token = exponent
        $chap2::divides(p^token, finite_set_size(G))
        =>:
            exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^token}

thm p_power_subgroup_exists:
    ? forall G nonempty_set, group &chap2::Group<G>, p N+, n N:
        $is_finite_set(G)
        $prime(p)
        $chap2::divides(p^n, finite_set_size(G))
        =>:
            exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^n}
    claim:
        ? forall exponent N:
            $p_power_subgroup_exists_at(G, group, p, exponent)
        by induc exponent from 0:
            ? $p_power_subgroup_exists_at(G, group, p, exponent)

            ? from exponent = 0:
                claim:
                    ? forall token N:
                        $is_finite_set(G)
                        token = exponent
                        $chap2::divides(p^token, finite_set_size(G))
                        =>:
                            exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^token}
                    token = exponent = 0
                    have bottom power_set(G) = {group.one}
                    claim:
                        ? $is_subgroup(G, group, bottom)
                        group.one $in {group.one}
                        group.one $in bottom
                        claim:
                            ? forall x, y G:
                                x $in bottom
                                y $in bottom
                                =>:
                                    group.mul(x, y) $in bottom
                            x = group.one
                            y = group.one
                            group.mul(x, y) = group.mul(group.one, group.one) = group.one
                            group.one $in bottom
                        claim:
                            ? forall x G:
                                x $in bottom
                                =>:
                                    group.inv(x) $in bottom
                            x = group.one
                            group.mul(group.inv(group.one), group.one) = group.one
                            release thm chap2::mul_one_structure(G, group.mul, group.one, group.inv, group.inv(group.one))
                            group.mul(group.inv(group.one), group.one) = group.inv(group.one)
                            group.inv(group.one) = group.one
                            group.inv(x) = group.inv(group.one) = group.one
                            group.one $in bottom
                        by def:
                            ? $is_subgroup(G, group, bottom)
                    $is_finite_set({group.one})
                    $is_finite_set(bottom)
                    finite_set_size(bottom) = finite_set_size({group.one}) = 1 = p^0 = p^token
                    witness exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^token} from bottom
                by def:
                    ? $p_power_subgroup_exists_at(G, group, p, exponent)

            ? induc:
                $p_power_subgroup_exists_at(G, group, p, exponent)
                claim:
                    ? forall token N:
                        $is_finite_set(G)
                        token = exponent + 1
                        $chap2::divides(p^token, finite_set_size(G))
                        =>:
                            exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^token}
                    token = exponent + 1
                    p^token = p^(exponent + 1)
                    $chap2::divides(p^(exponent + 1), finite_set_size(G))
                    release thm prime_power_divisor_predecessor(p, exponent, finite_set_size(G))
                    $chap2::divides(p^exponent, finite_set_size(G))
                    exponent = exponent
                    obtain H from exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^exponent}
                    release thm p_power_subgroup_successor(G, group, H, p, exponent)
                    obtain P from exist P power_set(G) st {$is_subgroup(G, group, P), $is_finite_set(P), finite_set_size(P) = p^(exponent + 1)}
                    finite_set_size(P) = p^(exponent + 1) = p^token
                    witness exist next_subgroup power_set(G) st {$is_subgroup(G, group, next_subgroup), $is_finite_set(next_subgroup), finite_set_size(next_subgroup) = p^token} from P
                by def:
                    ? $p_power_subgroup_exists_at(G, group, p, exponent + 1)
    $p_power_subgroup_exists_at(G, group, p, n)
    n = n
    exist H power_set(G) st {$is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p^n}
# ---------------------------------------------------------------------------
# 9.2 Rings
# ---------------------------------------------------------------------------

prop is_commutative_ring(A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A):
    $chap2::ring_laws(A, add, zero, neg, mul, one)
    forall x, y A:
        mul(x, y) = mul(y, x)

# The polynomial degree laws below use exactly the source's semiring and
# no-zero-divisors hypotheses; without them the displayed equalities are false.
prop is_semiring(A set, add fn(x, y A) A, zero A, mul fn(x, y A) A, one A):
    $is_additive_commutative_monoid(A, add, zero)
    $is_monoid(A, mul, one)
    forall x, y, z A:
        mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
        mul(add(x, y), z) = add(mul(x, z), mul(y, z))

prop has_no_zero_divisors(A set, zero A, mul fn(x, y A) A):
    forall x, y A:
        mul(x, y) = zero
        =>:
            x = zero or y = zero

# Source example: expand a square in a generic commutative ring. Distribute
# twice, commute the mixed product, and reorder the four additive terms.
thm commutative_ring_square_sum:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, x, y A:
        ring.mul(ring.add(x, y), ring.add(x, y)) = ring.add(ring.add(ring.mul(x, x), ring.mul(y, y)), ring.add(ring.mul(x, y), ring.mul(x, y)))
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    ring.mul(ring.add(x, y), ring.add(x, y)) = ring.add(ring.mul(x, ring.add(x, y)), ring.mul(y, ring.add(x, y)))
    ring.mul(x, ring.add(x, y)) = ring.add(ring.mul(x, x), ring.mul(x, y))
    ring.mul(y, ring.add(x, y)) = ring.add(ring.mul(y, x), ring.mul(y, y))
    ring.mul(y, x) = ring.mul(x, y)
    ring.add(ring.mul(y, x), ring.mul(y, y)) = ring.add(ring.mul(y, y), ring.mul(y, x)) = ring.add(ring.mul(y, y), ring.mul(x, y))
    release thm chap2::add_reorder_four_structure(A, ring.add, ring.zero, ring.neg, ring.mul(x, x), ring.mul(x, y), ring.mul(y, y), ring.mul(x, y))
    ring.mul(ring.add(x, y), ring.add(x, y)) = ring.add(ring.mul(x, ring.add(x, y)), ring.mul(y, ring.add(x, y))) = ring.add(ring.add(ring.mul(x, x), ring.mul(x, y)), ring.add(ring.mul(y, x), ring.mul(y, y))) = ring.add(ring.add(ring.mul(x, x), ring.mul(x, y)), ring.add(ring.mul(y, y), ring.mul(y, x))) = ring.add(ring.add(ring.mul(x, x), ring.mul(x, y)), ring.add(ring.mul(y, y), ring.mul(x, y))) = ring.add(ring.add(ring.mul(x, x), ring.mul(y, y)), ring.add(ring.mul(x, y), ring.mul(x, y)))

thm natural_square_sum:
    ? forall x, y N:
        (x + y)^2 = x^2 + y^2 + 2 * x * y

prop is_unit(A set, mul fn(x, y A) A, one A, x A):
    exist y A st {mul(x, y) = one, mul(y, x) = one}

template<A set, mul fn(x, y A) A, one A>:
    have units power_set(A) = {x A: $is_unit(A, mul, one, x)}

# Units form a genuine group carrier. Multiplication and inverse are selected
# on the refined unit carrier so later maps can use them directly.
claim:
    ? forall A nonempty_set, mul fn(x, y A) A, one A:
        $is_monoid(A, mul, one)
        =>:
            $is_nonempty_set(\units<A, mul, one>)
    \units<A, mul, one> = {x A: $is_unit(A, mul, one, x)}
    witness $is_unit(A, mul, one, one) from one
    release thm set_builder_member(one, {x A: $is_unit(A, mul, one, x)})
    one $in {x A: $is_unit(A, mul, one, x)}
    one $in \units<A, mul, one>
    witness $is_nonempty_set(\units<A, mul, one>) from one

template<A nonempty_set, mul fn(x, y A) A, one A: $is_monoid(A, mul, one)>:
    have units_carrier nonempty_set = \units<A, mul, one>

claim:
    ? forall A nonempty_set, mul fn(x, y A) A, one A:
        $is_monoid(A, mul, one)
        =>:
            \units_carrier<A, mul, one> $subset A
    \units_carrier<A, mul, one> = \units<A, mul, one>
    \units<A, mul, one> $subset A
    \units_carrier<A, mul, one> $subset A

claim:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, x, y \units<A, mul, one>:
        $is_monoid(A, mul, one)
        =>:
            mul(x, y) $in \units_carrier<A, mul, one>
    \units<A, mul, one> = {z A: $is_unit(A, mul, one, z)}
    by def:
        ? $is_unit(A, mul, one, x)
    obtain x_inv from $is_unit(A, mul, one, x)
    by def:
        ? $is_unit(A, mul, one, y)
    obtain y_inv from exist candidate A st {mul(y, candidate) = one, mul(candidate, y) = one}
    witness $is_unit(A, mul, one, mul(x, y)) from mul(y_inv, x_inv):
        mul(y, mul(y_inv, x_inv)) = mul(mul(y, y_inv), x_inv) = mul(one, x_inv) = x_inv
        mul(mul(x, y), mul(y_inv, x_inv)) = mul(x, mul(y, mul(y_inv, x_inv))) = mul(x, x_inv) = one
        mul(x_inv, mul(x, y)) = mul(mul(x_inv, x), y) = mul(one, y) = y
        mul(mul(y_inv, x_inv), mul(x, y)) = mul(y_inv, mul(x_inv, mul(x, y))) = mul(y_inv, y) = one
    release thm set_builder_member(mul(x, y), {z A: $is_unit(A, mul, one, z)})
    mul(x, y) $in \units<A, mul, one>
    \units_carrier<A, mul, one> = \units<A, mul, one>
    mul(x, y) $in \units_carrier<A, mul, one>

template<A nonempty_set, mul fn(x, y A) A, one A: $is_monoid(A, mul, one), \units_carrier<A, mul, one> $subset A>:
    have fn unit_mul(x, y \units_carrier<A, mul, one>) \units_carrier<A, mul, one> = mul(x, y)

thm unit_inverse_exists_unique:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, x \units<A, mul, one>:
        $is_monoid(A, mul, one)
        =>:
            exist! y \units<A, mul, one> st {mul(x, y) = one, mul(y, x) = one}
    \units<A, mul, one> = {z A: $is_unit(A, mul, one, z)}
    by def:
        ? $is_unit(A, mul, one, x)
    obtain y from $is_unit(A, mul, one, x)
    claim:
        ? y $in \units<A, mul, one>
        witness $is_unit(A, mul, one, y) from x
        release thm set_builder_member(y, {z A: $is_unit(A, mul, one, z)})
        y $in {z A: $is_unit(A, mul, one, z)}
        y $in \units<A, mul, one>
    witness exist z \units<A, mul, one> st {mul(x, z) = one, mul(z, x) = one} from y
    claim:
        ? forall y1, y2 \units<A, mul, one>:
            mul(x, y1) = one
            mul(y1, x) = one
            mul(x, y2) = one
            mul(y2, x) = one
            =>:
                y1 = y2
        mul(y1, one) = y1
        mul(y1, one) = mul(y1, mul(x, y2)) = mul(mul(y1, x), y2) = mul(one, y2) = y2
        y1 = y2

prop unit_inverse_pair(A set, mul fn(x, y A) A, one, x, y A):
    mul(x, y) = one
    mul(y, x) = one

template<A nonempty_set, mul fn(x, y A) A, one A: $is_monoid(A, mul, one), \units_carrier<A, mul, one> $subset A, \units_carrier<A, mul, one> = \units<A, mul, one>>:
    have fn unit_inv_selected by exist!:
        ? forall x \units_carrier<A, mul, one>, marker {0}:
            exist! y \units_carrier<A, mul, one> st {$unit_inverse_pair(A, mul, one, x, y)}
        \units<A, mul, one> = {z A: $is_unit(A, mul, one, z)}
        by def:
            ? $is_unit(A, mul, one, x)
        obtain y from $is_unit(A, mul, one, x)
        claim:
            ? y $in \units_carrier<A, mul, one>
            witness $is_unit(A, mul, one, y) from x
            release thm set_builder_member(y, {z A: $is_unit(A, mul, one, z)})
            y $in {z A: $is_unit(A, mul, one, z)}
            y $in \units<A, mul, one>
            y $in \units_carrier<A, mul, one>
        witness exist z \units_carrier<A, mul, one> st {$unit_inverse_pair(A, mul, one, x, z)} from y:
            by def:
                ? $unit_inverse_pair(A, mul, one, x, y)
        claim:
            ? forall y1, y2 \units_carrier<A, mul, one>:
                $unit_inverse_pair(A, mul, one, x, y1)
                $unit_inverse_pair(A, mul, one, x, y2)
                =>:
                    y1 = y2
            by def:
                ? $unit_inverse_pair(A, mul, one, x, y1)
            by def:
                ? $unit_inverse_pair(A, mul, one, x, y2)
            mul(y1, one) = y1
            mul(y1, one) = mul(y1, mul(x, y2)) = mul(mul(y1, x), y2) = mul(one, y2) = y2
            y1 = y2

template<A nonempty_set, mul fn(x, y A) A, one A: $is_monoid(A, mul, one), \units_carrier<A, mul, one> $subset A, \units_carrier<A, mul, one> = \units<A, mul, one>>:
    have fn unit_inv(x \units_carrier<A, mul, one>) \units_carrier<A, mul, one> = \unit_inv_selected<A, mul, one>(x, 0)

thm unit_inv_left:
    ? forall A nonempty_set, mul fn(x, y A) A, one, x A:
        $is_monoid(A, mul, one)
        \units_carrier<A, mul, one> $subset A
        \units_carrier<A, mul, one> = \units<A, mul, one>
        x $in \units_carrier<A, mul, one>
        =>:
            mul(\unit_inv<A, mul, one>(x), x) = one
    \unit_inv<A, mul, one>(x) = \unit_inv_selected<A, mul, one>(x, 0)
    $unit_inverse_pair(A, mul, one, x, \unit_inv_selected<A, mul, one>(x, 0))
    by def:
        ? $unit_inverse_pair(A, mul, one, x, \unit_inv_selected<A, mul, one>(x, 0))
    mul(\unit_inv_selected<A, mul, one>(x, 0), x) = one
    release thm object_substitution(A, A, fn(t A) A {mul(t, x)}, \unit_inv<A, mul, one>(x), \unit_inv_selected<A, mul, one>(x, 0))
    mul(\unit_inv<A, mul, one>(x), x) = mul(\unit_inv_selected<A, mul, one>(x, 0), x) = one

thm unit_inv_right:
    ? forall A nonempty_set, mul fn(x, y A) A, one, x A:
        $is_monoid(A, mul, one)
        \units_carrier<A, mul, one> $subset A
        \units_carrier<A, mul, one> = \units<A, mul, one>
        x $in \units_carrier<A, mul, one>
        =>:
            mul(x, \unit_inv<A, mul, one>(x)) = one
    \unit_inv<A, mul, one>(x) = \unit_inv_selected<A, mul, one>(x, 0)
    $unit_inverse_pair(A, mul, one, x, \unit_inv_selected<A, mul, one>(x, 0))
    by def:
        ? $unit_inverse_pair(A, mul, one, x, \unit_inv_selected<A, mul, one>(x, 0))
    mul(x, \unit_inv_selected<A, mul, one>(x, 0)) = one
    release thm object_substitution(A, A, fn(t A) A {mul(x, t)}, \unit_inv<A, mul, one>(x), \unit_inv_selected<A, mul, one>(x, 0))
    mul(x, \unit_inv<A, mul, one>(x)) = mul(x, \unit_inv_selected<A, mul, one>(x, 0)) = one

claim:
    ? forall A nonempty_set, mul fn(x, y A) A, one A:
        $is_monoid(A, mul, one)
        =>:
            one $in \units_carrier<A, mul, one>
    \units<A, mul, one> = {z A: $is_unit(A, mul, one, z)}
    witness $is_unit(A, mul, one, one) from one
    release thm set_builder_member(one, {z A: $is_unit(A, mul, one, z)})
    one $in {z A: $is_unit(A, mul, one, z)}
    one $in \units<A, mul, one>
    one $in \units_carrier<A, mul, one>

template<A nonempty_set, mul fn(x, y A) A, one A: $is_monoid(A, mul, one)>:
    have unit_one \units_carrier<A, mul, one> = one

claim:
    ? forall A nonempty_set, mul fn(x, y A) A, one A:
        $is_monoid(A, mul, one)
        \units_carrier<A, mul, one> $subset A
        =>:
            (\unit_mul<A, mul, one>, \unit_one<A, mul, one>, \unit_inv<A, mul, one>) $in &chap2::Group<\units_carrier<A, mul, one>>
    claim:
        ? forall x, y, z \units_carrier<A, mul, one>:
            \unit_mul<A, mul, one>(\unit_mul<A, mul, one>(x, y), z) = \unit_mul<A, mul, one>(x, \unit_mul<A, mul, one>(y, z))
        \unit_mul<A, mul, one>(x, y) = mul(x, y)
        \unit_mul<A, mul, one>(y, z) = mul(y, z)
        \unit_mul<A, mul, one>(\unit_mul<A, mul, one>(x, y), z) = mul(\unit_mul<A, mul, one>(x, y), z)
        release thm object_substitution(A, A, fn(t A) A {mul(t, z)}, \unit_mul<A, mul, one>(x, y), mul(x, y))
        mul(\unit_mul<A, mul, one>(x, y), z) = mul(mul(x, y), z)
        \unit_mul<A, mul, one>(x, \unit_mul<A, mul, one>(y, z)) = mul(x, \unit_mul<A, mul, one>(y, z))
        release thm object_substitution(A, A, fn(t A) A {mul(x, t)}, \unit_mul<A, mul, one>(y, z), mul(y, z))
        mul(x, \unit_mul<A, mul, one>(y, z)) = mul(x, mul(y, z))
        mul(mul(x, y), z) = mul(x, mul(y, z))
        \unit_mul<A, mul, one>(\unit_mul<A, mul, one>(x, y), z) = mul(\unit_mul<A, mul, one>(x, y), z) = mul(mul(x, y), z) = mul(x, mul(y, z)) = mul(x, \unit_mul<A, mul, one>(y, z)) = \unit_mul<A, mul, one>(x, \unit_mul<A, mul, one>(y, z))
    claim:
        ? forall x \units_carrier<A, mul, one>:
            \unit_mul<A, mul, one>(\unit_one<A, mul, one>, x) = x
        \unit_mul<A, mul, one>(\unit_one<A, mul, one>, x) = mul(one, x) = x
    claim:
        ? forall x \units_carrier<A, mul, one>:
            \unit_mul<A, mul, one>(\unit_inv<A, mul, one>(x), x) = \unit_one<A, mul, one>
        release thm unit_inv_left(A, mul, one, x)
        \unit_mul<A, mul, one>(\unit_inv<A, mul, one>(x), x) = mul(\unit_inv<A, mul, one>(x), x) = one = \unit_one<A, mul, one>
    by def:
        ? $chap2::group_laws(\units_carrier<A, mul, one>, \unit_mul<A, mul, one>, \unit_one<A, mul, one>, \unit_inv<A, mul, one>)
    \unit_mul<A, mul, one> $in fn(x, y \units_carrier<A, mul, one>) \units_carrier<A, mul, one>
    \unit_one<A, mul, one> $in \units_carrier<A, mul, one>
    \unit_inv<A, mul, one> $in fn(x \units_carrier<A, mul, one>) \units_carrier<A, mul, one>
    release thm cart_member_from_coordinates((\unit_mul<A, mul, one>, \unit_one<A, mul, one>, \unit_inv<A, mul, one>), cart(fn(x, y \units_carrier<A, mul, one>) \units_carrier<A, mul, one>, \units_carrier<A, mul, one>, fn(x \units_carrier<A, mul, one>) \units_carrier<A, mul, one>))
    release thm struct_member((\unit_mul<A, mul, one>, \unit_one<A, mul, one>, \unit_inv<A, mul, one>), &chap2::Group<\units_carrier<A, mul, one>>)

template<A nonempty_set, mul fn(x, y A) A, one A: $is_monoid(A, mul, one)>:
    have units_group &chap2::Group<\units_carrier<A, mul, one>> = (\unit_mul<A, mul, one>, \unit_one<A, mul, one>, \unit_inv<A, mul, one>)

# Source example: Int.units_eq_one_or. Extract a two-sided inverse y; sign
# cases and x * y = 1 force the integer unit x to be 1 or -1.
thm integer_units_forward:
    ? forall x Z:
        $is_unit(Z, fn(a, b Z) Z {a * b}, 1, x)
        =>:
            x = 1 or x = (-1)
    obtain y from $is_unit(Z, fn(a, b Z) Z {a * b}, 1, x)
    fn(a, b Z) Z {a * b}(x, y) = x * y
    x * y = fn(a, b Z) Z {a * b}(x, y) = 1
    by cases:
        ? x = 1 or x = (-1)
        case x > 0:
            by cases:
                ? x = 1 or x = (-1)
                case y > 0:
                    x >= 1
                    y >= 1
                    x * y >= x * 1 = x
                    x <= 1
                    x = 1
                case y = 0:
                    x * y = x * 0 = 0
                    impossible x * y = 1
                case y < 0:
                    x * y < 0 < 1 = x * y
                    impossible x * y < x * y
        case x = 0:
            x * y = 0 * y = 0
            impossible x * y = 1
        case x < 0:
            by cases:
                ? x = 1 or x = (-1)
                case y > 0:
                    x * y < 0 < 1 = x * y
                    impossible x * y < x * y
                case y = 0:
                    x * y = x * 0 = 0
                    impossible x * y = 1
                case y < 0:
                    (-x) > 0
                    (-y) > 0
                    have nx Z = (-x)
                    have ny Z = (-y)
                    nx > 0
                    ny > 0
                    nx >= 1
                    ny >= 1
                    (-x) = nx >= 1
                    (-y) = ny >= 1
                    (-x) * (-y) = x * y = 1
                    (-x) * (-y) >= (-x) * 1 = (-x)
                    (-x) <= 1
                    (-x) = 1
                    x = (-1)

# Converse proof for the source unit classification. In either allowed case,
# choose x itself as the explicit two-sided inverse and unfold is_unit.
thm integer_units_reverse:
    ? forall x Z:
        x = 1 or x = (-1)
        =>:
            $is_unit(Z, fn(a, b Z) Z {a * b}, 1, x)
    by cases:
        ? $is_unit(Z, fn(a, b Z) Z {a * b}, 1, x)
        case x = 1:
            witness $is_unit(Z, fn(a, b Z) Z {a * b}, 1, x) from 1
        case x = (-1):
            witness $is_unit(Z, fn(a, b Z) Z {a * b}, 1, x) from (-1)

prop is_ring_hom(A, S nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<S>, f fn(x A) S):
    f(source.zero) = target.zero
    f(source.one) = target.one
    forall x, y A:
        f(source.add(x, y)) = target.add(f(x), f(y))
    forall x, y A:
        f(source.mul(x, y)) = target.mul(f(x), f(y))

claim:
    ? forall A, S nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<S>, f fn(x A) S, x \units<A, source.mul, source.one>:
        $is_ring_hom(A, S, source, target, f)
        =>:
            f(x) $in \units<S, target.mul, target.one>
    \units<S, target.mul, target.one> = {z S: $is_unit(S, target.mul, target.one, z)}
    by def:
        ? $is_unit(A, source.mul, source.one, x)
    obtain y from $is_unit(A, source.mul, source.one, x)
    witness $is_unit(S, target.mul, target.one, f(x)) from f(y):
        f(source.mul(x, y)) = target.mul(f(x), f(y))
        f(source.mul(x, y)) = f(source.one) = target.one
        target.mul(f(x), f(y)) = target.one
        f(source.mul(y, x)) = target.mul(f(y), f(x))
        f(source.mul(y, x)) = f(source.one) = target.one
        target.mul(f(y), f(x)) = target.one
    release thm set_builder_member(f(x), {z S: $is_unit(S, target.mul, target.one, z)})
    f(x) $in {z S: $is_unit(S, target.mul, target.one, z)}
    f(x) $in \units<S, target.mul, target.one>

template<A, S nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<S>, f fn(x A) S: $is_ring_hom(A, S, source, target, f)>:
    have fn ring_hom_on_units(x \units<A, source.mul, source.one>) \units<S, target.mul, target.one> = f(x)

thm ring_hom_map_add:
    ? forall A, S nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<S>, f fn(x A) S, x, y A:
        $is_ring_hom(A, S, source, target, f)
        =>:
            f(source.add(x, y)) = target.add(f(x), f(y))

thm ring_hom_map_zero:
    ? forall A, S nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<S>, f fn(x A) S:
        $is_ring_hom(A, S, source, target, f)
        =>:
            f(source.zero) = target.zero

thm ring_hom_map_mul:
    ? forall A, S nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<S>, f fn(x A) S, x, y A:
        $is_ring_hom(A, S, source, target, f)
        =>:
            f(source.mul(x, y)) = target.mul(f(x), f(y))

thm commutative_ring_hom_map_zero:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            f(source.zero) = target.zero
    have source_ring &chap2::Ring<A> = (source.add, source.zero, source.neg, source.mul, source.one)
    have target_ring &chap2::Ring<S> = (target.add, target.zero, target.neg, target.mul, target.one)
    $is_ring_hom(A, S, source_ring, target_ring, f)
    release thm ring_hom_map_zero(A, S, source_ring, target_ring, f)
    source_ring.zero = source.zero
    target_ring.zero = target.zero
    f(source.zero) = f(source_ring.zero) = target_ring.zero = target.zero

thm commutative_ring_hom_map_add:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S, x, y A:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            f(source.add(x, y)) = target.add(f(x), f(y))
    have source_ring &chap2::Ring<A> = (source.add, source.zero, source.neg, source.mul, source.one)
    have target_ring &chap2::Ring<S> = (target.add, target.zero, target.neg, target.mul, target.one)
    $is_ring_hom(A, S, source_ring, target_ring, f)
    release thm ring_hom_map_add(A, S, source_ring, target_ring, f, x, y)
    source_ring.add = source.add
    target_ring.add = target.add
    f(source.add(x, y)) = f(source_ring.add(x, y)) = target_ring.add(f(x), f(y)) = target.add(f(x), f(y))

thm commutative_ring_hom_map_mul:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S, x, y A:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            f(source.mul(x, y)) = target.mul(f(x), f(y))
    have source_ring &chap2::Ring<A> = (source.add, source.zero, source.neg, source.mul, source.one)
    have target_ring &chap2::Ring<S> = (target.add, target.zero, target.neg, target.mul, target.one)
    $is_ring_hom(A, S, source_ring, target_ring, f)
    release thm ring_hom_map_mul(A, S, source_ring, target_ring, f, x, y)
    source_ring.mul = source.mul
    target_ring.mul = target.mul
    f(source.mul(x, y)) = f(source_ring.mul(x, y)) = target_ring.mul(f(x), f(y)) = target.mul(f(x), f(y))

prop is_subring(A nonempty_set, ring &chap2::Ring<A>, S power_set(A)):
    ring.zero $in S
    ring.one $in S
    forall x, y A:
        x $in S
        y $in S
        =>:
            ring.add(x, y) $in S
            ring.mul(x, y) $in S
    forall x A:
        x $in S
        =>:
            ring.neg(x) $in S

# ---------------------------------------------------------------------------
# 9.2.2 Ideals, quotient rings, and the Chinese remainder theorem
# ---------------------------------------------------------------------------

prop is_ideal(A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A)):
    ring.zero $in I
    forall x, y A:
        x $in I
        y $in I
        =>:
            ring.add(x, y) $in I
    forall x A:
        x $in I
        =>:
            ring.neg(x) $in I
    forall r, x A:
        x $in I
        =>:
            ring.mul(r, x) $in I

prop ideal_coset_member(A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), r, x A):
    exist idx A st {idx $in I, x = ring.add(r, idx)}

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn ideal_coset(I power_set(A), r A) power_set(A) = {x A: $ideal_coset_member(A, ring, I, r, x)}

prop is_ideal_coset(A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), CarrierC power_set(A)):
    exist r A st {CarrierC = \ideal_coset<A, ring>(I, r)}

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn quotient_ring_carrier(I power_set(A)) power_set(power_set(A)) = {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)}

# Quotient-ring projection and operations are callable. Their representative
# independence and complete commutative-ring law package are checked below.
thm ideal_coset_in_quotient_ring_carrier:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), x A:
        $is_ideal(A, ring, I)
        =>:
            \ideal_coset<A, ring>(I, x) $in \quotient_ring_carrier<A, ring>(I)
    \quotient_ring_carrier<A, ring>(I) = {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)}
    witness $is_ideal_coset(A, ring, I, \ideal_coset<A, ring>(I, x)) from x
    release thm set_builder_member(\ideal_coset<A, ring>(I, x), {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)})
    \ideal_coset<A, ring>(I, x) $in {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)}

claim:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A):
        $is_ideal(A, ring, I)
        =>:
            $is_nonempty_set(\quotient_ring_carrier<A, ring>(I))
    release thm ideal_coset_in_quotient_ring_carrier(A, ring, I, ring.zero)
    witness $is_nonempty_set(\quotient_ring_carrier<A, ring>(I)) from \ideal_coset<A, ring>(I, ring.zero)

template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have quotient_ring_nonempty nonempty_set = \quotient_ring_carrier<A, ring>(I)

claim:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), x A:
        $is_ideal(A, ring, I)
        =>:
            \ideal_coset<A, ring>(I, x) $in \quotient_ring_nonempty<A, ring, I>
    release thm ideal_coset_in_quotient_ring_carrier(A, ring, I, x)
    \ideal_coset<A, ring>(I, x) $in \quotient_ring_carrier<A, ring>(I)
    \quotient_ring_nonempty<A, ring, I> = \quotient_ring_carrier<A, ring>(I)
    \ideal_coset<A, ring>(I, x) $in \quotient_ring_nonempty<A, ring, I>

template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have fn quotient_ring_mk(x A) \quotient_ring_nonempty<A, ring, I> = \ideal_coset<A, ring>(I, x)

thm ideal_coset_center_mem:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), r A:
        $is_ideal(A, ring, I)
        =>:
            r $in \ideal_coset<A, ring>(I, r)
    \ideal_coset<A, ring>(I, r) = {x A: $ideal_coset_member(A, ring, I, r, x)}
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    ring.zero $in I
    release thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, r)
    witness $ideal_coset_member(A, ring, I, r, r) from ring.zero
    release thm set_builder_member(r, {x A: $ideal_coset_member(A, ring, I, r, x)})
    r $in {x A: $ideal_coset_member(A, ring, I, r, x)}

thm ideal_coset_eq_of_mem:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), r, x A:
        $is_ideal(A, ring, I)
        x $in \ideal_coset<A, ring>(I, r)
        =>:
            \ideal_coset<A, ring>(I, x) = \ideal_coset<A, ring>(I, r)
    \ideal_coset<A, ring>(I, r) = {q A: $ideal_coset_member(A, ring, I, r, q)}
    \ideal_coset<A, ring>(I, x) = {q A: $ideal_coset_member(A, ring, I, x, q)}
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    obtain u from exist idx A st {idx $in I, x = ring.add(r, idx)}
    claim:
        ? forall z \ideal_coset<A, ring>(I, x):
            z $in \ideal_coset<A, ring>(I, r)
        obtain w from exist idx A st {idx $in I, z = ring.add(x, idx)}
        ring.add(u, w) $in I
        z = ring.add(x, w) = ring.add(ring.add(r, u), w) = ring.add(r, ring.add(u, w))
        witness $ideal_coset_member(A, ring, I, r, z) from ring.add(u, w)
        release thm set_builder_member(z, {q A: $ideal_coset_member(A, ring, I, r, q)})
        z $in {q A: $ideal_coset_member(A, ring, I, r, q)}
    by def:
        ? \ideal_coset<A, ring>(I, x) $subset \ideal_coset<A, ring>(I, r)
    \ideal_coset<A, ring>(I, x) $subset \ideal_coset<A, ring>(I, r)
    claim:
        ? forall z \ideal_coset<A, ring>(I, r):
            z $in \ideal_coset<A, ring>(I, x)
        obtain w from $ideal_coset_member(A, ring, I, r, z)
        ring.neg(u) $in I
        ring.add(ring.neg(u), w) $in I
        ring.add(u, ring.add(ring.neg(u), w)) = ring.add(ring.add(u, ring.neg(u)), w)
        ring.add(r, ring.add(u, ring.add(ring.neg(u), w))) = ring.add(r, ring.add(ring.add(u, ring.neg(u)), w))
        release thm chap2::add_neg_cancel_from_laws(A, ring.add, ring.zero, ring.neg, u)
        ring.add(u, ring.neg(u)) = ring.zero
        ring.add(ring.add(u, ring.neg(u)), w) = ring.add(ring.zero, w)
        ring.add(r, ring.add(ring.add(u, ring.neg(u)), w)) = ring.add(r, ring.add(ring.zero, w))
        ring.add(ring.zero, w) = w
        ring.add(r, ring.add(ring.zero, w)) = ring.add(r, w)
        ring.add(x, ring.add(ring.neg(u), w)) = ring.add(ring.add(r, u), ring.add(ring.neg(u), w)) = ring.add(r, ring.add(u, ring.add(ring.neg(u), w))) = ring.add(r, ring.add(ring.add(u, ring.neg(u)), w)) = ring.add(r, ring.add(ring.zero, w)) = ring.add(r, w) = z
        witness $ideal_coset_member(A, ring, I, x, z) from ring.add(ring.neg(u), w):
            z = ring.add(x, ring.add(ring.neg(u), w))
        release thm set_builder_member(z, {q A: $ideal_coset_member(A, ring, I, x, q)})
        z $in {q A: $ideal_coset_member(A, ring, I, x, q)}
    by def:
        ? \ideal_coset<A, ring>(I, r) $subset \ideal_coset<A, ring>(I, x)
    \ideal_coset<A, ring>(I, r) $subset \ideal_coset<A, ring>(I, x)
    by extension:
        ? \ideal_coset<A, ring>(I, x) = \ideal_coset<A, ring>(I, r)

thm ideal_coset_add_mem:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), a, b, x, y A:
        $is_ideal(A, ring, I)
        x $in \ideal_coset<A, ring>(I, a)
        y $in \ideal_coset<A, ring>(I, b)
        =>:
            ring.add(x, y) $in \ideal_coset<A, ring>(I, ring.add(a, b))
    \ideal_coset<A, ring>(I, ring.add(a, b)) = {q A: $ideal_coset_member(A, ring, I, ring.add(a, b), q)}
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    obtain u from exist idx A st {idx $in I, x = ring.add(a, idx)}
    obtain v from exist idx A st {idx $in I, y = ring.add(b, idx)}
    ring.add(u, v) $in I
    release thm chap2::add_reorder_four_structure(A, ring.add, ring.zero, ring.neg, a, u, b, v)
    ring.add(x, y) = ring.add(ring.add(a, u), ring.add(b, v)) = ring.add(ring.add(a, b), ring.add(u, v))
    witness $ideal_coset_member(A, ring, I, ring.add(a, b), ring.add(x, y)) from ring.add(u, v)
    release thm set_builder_member(ring.add(x, y), {q A: $ideal_coset_member(A, ring, I, ring.add(a, b), q)})
    ring.add(x, y) $in {q A: $ideal_coset_member(A, ring, I, ring.add(a, b), q)}

thm ideal_coset_neg_mem:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), a, x A:
        $is_ideal(A, ring, I)
        x $in \ideal_coset<A, ring>(I, a)
        =>:
            ring.neg(x) $in \ideal_coset<A, ring>(I, ring.neg(a))
    \ideal_coset<A, ring>(I, ring.neg(a)) = {q A: $ideal_coset_member(A, ring, I, ring.neg(a), q)}
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    obtain u from exist idx A st {idx $in I, x = ring.add(a, idx)}
    ring.neg(u) $in I
    release thm chap2::add_reorder_four_structure(A, ring.add, ring.zero, ring.neg, a, u, ring.neg(a), ring.neg(u))
    release thm chap2::add_neg_cancel_from_laws(A, ring.add, ring.zero, ring.neg, a)
    release thm chap2::add_neg_cancel_from_laws(A, ring.add, ring.zero, ring.neg, u)
    ring.add(ring.add(a, u), ring.add(ring.neg(a), ring.neg(u))) = ring.add(ring.add(a, ring.neg(a)), ring.add(u, ring.neg(u))) = ring.add(ring.zero, ring.zero) = ring.zero
    release thm chap2::eq_neg_of_add_eq_zero_structure(A, ring.add, ring.zero, ring.neg, ring.add(a, u), ring.add(ring.neg(a), ring.neg(u)))
    ring.add(ring.neg(a), ring.neg(u)) = ring.neg(ring.add(a, u))
    ring.neg(x) = ring.neg(ring.add(a, u)) = ring.add(ring.neg(a), ring.neg(u))
    witness $ideal_coset_member(A, ring, I, ring.neg(a), ring.neg(x)) from ring.neg(u)
    release thm set_builder_member(ring.neg(x), {q A: $ideal_coset_member(A, ring, I, ring.neg(a), q)})
    ring.neg(x) $in {q A: $ideal_coset_member(A, ring, I, ring.neg(a), q)}

thm ideal_coset_mul_mem:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), a, b, x, y A:
        $is_ideal(A, ring, I)
        x $in \ideal_coset<A, ring>(I, a)
        y $in \ideal_coset<A, ring>(I, b)
        =>:
            ring.mul(x, y) $in \ideal_coset<A, ring>(I, ring.mul(a, b))
    \ideal_coset<A, ring>(I, ring.mul(a, b)) = {q A: $ideal_coset_member(A, ring, I, ring.mul(a, b), q)}
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::ring_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::additive_commutative_group_laws(A, ring.add, ring.zero, ring.neg)
    obtain u from exist idx A st {idx $in I, x = ring.add(a, idx)}
    obtain v from exist idx A st {idx $in I, y = ring.add(b, idx)}
    ring.mul(a, v) $in I
    ring.mul(b, u) $in I
    ring.mul(u, b) = ring.mul(b, u)
    ring.mul(u, b) $in I
    ring.mul(u, v) $in I
    ring.add(ring.mul(u, b), ring.mul(u, v)) $in I
    ring.add(ring.mul(a, v), ring.add(ring.mul(u, b), ring.mul(u, v))) $in I
    have offset A = ring.add(ring.mul(a, v), ring.add(ring.mul(u, b), ring.mul(u, v)))
    offset $in I
    ring.mul(a, ring.add(b, v)) = ring.add(ring.mul(a, b), ring.mul(a, v))
    ring.mul(u, ring.add(b, v)) = ring.add(ring.mul(u, b), ring.mul(u, v))
    release thm object_substitution(A, A, fn(t A) A {ring.add(t, ring.mul(u, ring.add(b, v)))}, ring.mul(a, ring.add(b, v)), ring.add(ring.mul(a, b), ring.mul(a, v)))
    ring.add(ring.mul(a, ring.add(b, v)), ring.mul(u, ring.add(b, v))) = ring.add(ring.add(ring.mul(a, b), ring.mul(a, v)), ring.mul(u, ring.add(b, v)))
    release thm object_substitution(A, A, fn(t A) A {ring.add(ring.add(ring.mul(a, b), ring.mul(a, v)), t)}, ring.mul(u, ring.add(b, v)), ring.add(ring.mul(u, b), ring.mul(u, v)))
    ring.add(ring.add(ring.mul(a, b), ring.mul(a, v)), ring.mul(u, ring.add(b, v))) = ring.add(ring.add(ring.mul(a, b), ring.mul(a, v)), ring.add(ring.mul(u, b), ring.mul(u, v)))
    ring.mul(x, y) = ring.mul(ring.add(a, u), ring.add(b, v)) = ring.add(ring.mul(a, ring.add(b, v)), ring.mul(u, ring.add(b, v))) = ring.add(ring.add(ring.mul(a, b), ring.mul(a, v)), ring.mul(u, ring.add(b, v))) = ring.add(ring.add(ring.mul(a, b), ring.mul(a, v)), ring.add(ring.mul(u, b), ring.mul(u, v))) = ring.add(ring.mul(a, b), ring.add(ring.mul(a, v), ring.add(ring.mul(u, b), ring.mul(u, v)))) = ring.add(ring.mul(a, b), offset)
    witness $ideal_coset_member(A, ring, I, ring.mul(a, b), ring.mul(x, y)) from offset
    release thm set_builder_member(ring.mul(x, y), {q A: $ideal_coset_member(A, ring, I, ring.mul(a, b), q)})
    ring.mul(x, y) $in {q A: $ideal_coset_member(A, ring, I, ring.mul(a, b), q)}

prop is_quotient_ring_add_value(A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), q, r, s power_set(A)):
    exist a, b A st {q = \ideal_coset<A, ring>(I, a), r = \ideal_coset<A, ring>(I, b), s = \ideal_coset<A, ring>(I, ring.add(a, b))}

template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have fn quotient_ring_add by exist!:
        ? forall q, r \quotient_ring_nonempty<A, ring, I>:
            exist! s \quotient_ring_nonempty<A, ring, I> st {$is_quotient_ring_add_value(A, ring, I, q, r, s)}
        \quotient_ring_nonempty<A, ring, I> = \quotient_ring_carrier<A, ring>(I)
        q $in \quotient_ring_carrier<A, ring>(I)
        \quotient_ring_carrier<A, ring>(I) = {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)}
        q $in {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)}
        $is_ideal_coset(A, ring, I, q)
        obtain a from $is_ideal_coset(A, ring, I, q)
        r $in \quotient_ring_carrier<A, ring>(I)
        r $in {CarrierC power_set(A): $is_ideal_coset(A, ring, I, CarrierC)}
        $is_ideal_coset(A, ring, I, r)
        obtain b from exist representative A st {r = \ideal_coset<A, ring>(I, representative)}
        release thm ideal_coset_in_quotient_ring_carrier(A, ring, I, ring.add(a, b))
        \ideal_coset<A, ring>(I, ring.add(a, b)) $in \quotient_ring_carrier<A, ring>(I)
        \quotient_ring_nonempty<A, ring, I> = \quotient_ring_carrier<A, ring>(I)
        \ideal_coset<A, ring>(I, ring.add(a, b)) $in \quotient_ring_nonempty<A, ring, I>
        have candidate \quotient_ring_nonempty<A, ring, I> = \ideal_coset<A, ring>(I, ring.add(a, b))
        witness exist s \quotient_ring_nonempty<A, ring, I> st {$is_quotient_ring_add_value(A, ring, I, q, r, s)} from candidate:
            witness $is_quotient_ring_add_value(A, ring, I, q, r, candidate) from a, b
        claim:
            ? forall s1, s2 \quotient_ring_nonempty<A, ring, I>:
                $is_quotient_ring_add_value(A, ring, I, q, r, s1)
                $is_quotient_ring_add_value(A, ring, I, q, r, s2)
                =>:
                    s1 = s2
            obtain a1, b1 from $is_quotient_ring_add_value(A, ring, I, q, r, s1)
            obtain a2, b2 from $is_quotient_ring_add_value(A, ring, I, q, r, s2)
            release thm ideal_coset_center_mem(A, ring, I, a2)
            a2 $in \ideal_coset<A, ring>(I, a2)
            \ideal_coset<A, ring>(I, a2) = q = \ideal_coset<A, ring>(I, a1)
            a2 $in \ideal_coset<A, ring>(I, a1)
            release thm ideal_coset_center_mem(A, ring, I, b2)
            b2 $in \ideal_coset<A, ring>(I, b2)
            \ideal_coset<A, ring>(I, b2) = r = \ideal_coset<A, ring>(I, b1)
