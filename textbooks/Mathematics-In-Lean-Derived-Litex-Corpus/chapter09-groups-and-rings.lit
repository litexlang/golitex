thm quotient_ring_add_of_representatives:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, q, r power_set(A), x, y A:
        $is_ideal(A, ring, I)
        q $in \quotient_ring_nonempty<A, ring, I>
        r $in \quotient_ring_nonempty<A, ring, I>
        q = \quotient_ring_mk<A, ring, I>(x)
        r = \quotient_ring_mk<A, ring, I>(y)
        =>:
            \quotient_ring_add<A, ring, I>(q, r) = \quotient_ring_mk<A, ring, I>(ring.add(x, y))
    release thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(t \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I> {\quotient_ring_add<A, ring, I>(t, r)}, q, \quotient_ring_mk<A, ring, I>(x))
    release thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(t \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I> {\quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), t)}, r, \quotient_ring_mk<A, ring, I>(y))
    release thm quotient_ring_add_mk(A, ring, I, x, y)
    \quotient_ring_add<A, ring, I>(q, r) = \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), r) = \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \quotient_ring_mk<A, ring, I>(ring.add(x, y))

