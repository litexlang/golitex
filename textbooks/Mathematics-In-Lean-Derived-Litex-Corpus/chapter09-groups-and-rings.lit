                =>:
                    s1 = s2
            obtain a1, b1 from exist a0, b0 A st {q = \ideal_coset<A, ring>(I, a0), r = \ideal_coset<A, ring>(I, b0), s1 = \ideal_coset<A, ring>(I, ring.mul(a0, b0))}
            obtain a2, b2 from exist a0, b0 A st {q = \ideal_coset<A, ring>(I, a0), r = \ideal_coset<A, ring>(I, b0), s2 = \ideal_coset<A, ring>(I, ring.mul(a0, b0))}
            by thm ideal_coset_center_mem(A, ring, I, a2)
            a2 $in \ideal_coset<A, ring>(I, a2)
            \ideal_coset<A, ring>(I, a2) = q = \ideal_coset<A, ring>(I, a1)
            a2 $in \ideal_coset<A, ring>(I, a1)
            by thm ideal_coset_center_mem(A, ring, I, b2)
            b2 $in \ideal_coset<A, ring>(I, b2)
            \ideal_coset<A, ring>(I, b2) = r = \ideal_coset<A, ring>(I, b1)
            b2 $in \ideal_coset<A, ring>(I, b1)
            by thm ideal_coset_mul_mem(A, ring, I, a1, b1, a2, b2)
            ring.mul(a2, b2) $in \ideal_coset<A, ring>(I, ring.mul(a1, b1))
            by thm ideal_coset_eq_of_mem(A, ring, I, ring.mul(a1, b1), ring.mul(a2, b2))
            \ideal_coset<A, ring>(I, ring.mul(a2, b2)) = \ideal_coset<A, ring>(I, ring.mul(a1, b1))
            s2 = \ideal_coset<A, ring>(I, ring.mul(a2, b2)) = \ideal_coset<A, ring>(I, ring.mul(a1, b1)) = s1
            s1 = s2

thm quotient_ring_add_mk:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), x, y A:
        $is_ideal(A, ring, I)
        =>:
            \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \quotient_ring_mk<A, ring, I>(ring.add(x, y))
    $is_quotient_ring_add_value(A, ring, I, \quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y), \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)))
    obtain x1, y1 from exist a, b A st {\quotient_ring_mk<A, ring, I>(x) = \ideal_coset<A, ring>(I, a), \quotient_ring_mk<A, ring, I>(y) = \ideal_coset<A, ring>(I, b), \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \ideal_coset<A, ring>(I, ring.add(a, b))}
    by thm ideal_coset_center_mem(A, ring, I, x)
    x $in \ideal_coset<A, ring>(I, x)
    \ideal_coset<A, ring>(I, x) = \quotient_ring_mk<A, ring, I>(x) = \ideal_coset<A, ring>(I, x1)
    x $in \ideal_coset<A, ring>(I, x1)
    by thm ideal_coset_center_mem(A, ring, I, y)
    y $in \ideal_coset<A, ring>(I, y)
    \ideal_coset<A, ring>(I, y) = \quotient_ring_mk<A, ring, I>(y) = \ideal_coset<A, ring>(I, y1)
    y $in \ideal_coset<A, ring>(I, y1)
    by thm ideal_coset_add_mem(A, ring, I, x1, y1, x, y)
    ring.add(x, y) $in \ideal_coset<A, ring>(I, ring.add(x1, y1))
    by thm ideal_coset_eq_of_mem(A, ring, I, ring.add(x1, y1), ring.add(x, y))
    \ideal_coset<A, ring>(I, ring.add(x, y)) = \ideal_coset<A, ring>(I, ring.add(x1, y1))
    \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \ideal_coset<A, ring>(I, ring.add(x1, y1)) = \ideal_coset<A, ring>(I, ring.add(x, y)) = \quotient_ring_mk<A, ring, I>(ring.add(x, y))

thm quotient_ring_neg_mk:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), x A:
        $is_ideal(A, ring, I)
        =>:
            \quotient_ring_neg<A, ring, I>(\quotient_ring_mk<A, ring, I>(x)) = \quotient_ring_mk<A, ring, I>(ring.neg(x))
    $is_quotient_ring_neg_value(A, ring, I, \quotient_ring_mk<A, ring, I>(x), \quotient_ring_neg<A, ring, I>(\quotient_ring_mk<A, ring, I>(x)))
    obtain x1 from exist a A st {\quotient_ring_mk<A, ring, I>(x) = \ideal_coset<A, ring>(I, a), \quotient_ring_neg<A, ring, I>(\quotient_ring_mk<A, ring, I>(x)) = \ideal_coset<A, ring>(I, ring.neg(a))}
    by thm ideal_coset_center_mem(A, ring, I, x)
    x $in \ideal_coset<A, ring>(I, x)
    \ideal_coset<A, ring>(I, x) = \quotient_ring_mk<A, ring, I>(x) = \ideal_coset<A, ring>(I, x1)
    x $in \ideal_coset<A, ring>(I, x1)
    by thm ideal_coset_neg_mem(A, ring, I, x1, x)
    ring.neg(x) $in \ideal_coset<A, ring>(I, ring.neg(x1))
    by thm ideal_coset_eq_of_mem(A, ring, I, ring.neg(x1), ring.neg(x))
    \ideal_coset<A, ring>(I, ring.neg(x)) = \ideal_coset<A, ring>(I, ring.neg(x1))
    \quotient_ring_neg<A, ring, I>(\quotient_ring_mk<A, ring, I>(x)) = \ideal_coset<A, ring>(I, ring.neg(x1)) = \ideal_coset<A, ring>(I, ring.neg(x)) = \quotient_ring_mk<A, ring, I>(ring.neg(x))

thm quotient_ring_mul_mk:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), x, y A:
        $is_ideal(A, ring, I)
        =>:
            \quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \quotient_ring_mk<A, ring, I>(ring.mul(x, y))
    $is_quotient_ring_mul_value(A, ring, I, \quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y), \quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)))
    obtain x1, y1 from exist a, b A st {\quotient_ring_mk<A, ring, I>(x) = \ideal_coset<A, ring>(I, a), \quotient_ring_mk<A, ring, I>(y) = \ideal_coset<A, ring>(I, b), \quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \ideal_coset<A, ring>(I, ring.mul(a, b))}
    by thm ideal_coset_center_mem(A, ring, I, x)
    x $in \ideal_coset<A, ring>(I, x)
    \ideal_coset<A, ring>(I, x) = \quotient_ring_mk<A, ring, I>(x) = \ideal_coset<A, ring>(I, x1)
    x $in \ideal_coset<A, ring>(I, x1)
    by thm ideal_coset_center_mem(A, ring, I, y)
    y $in \ideal_coset<A, ring>(I, y)
    \ideal_coset<A, ring>(I, y) = \quotient_ring_mk<A, ring, I>(y) = \ideal_coset<A, ring>(I, y1)
    y $in \ideal_coset<A, ring>(I, y1)
    by thm ideal_coset_mul_mem(A, ring, I, x1, y1, x, y)
    ring.mul(x, y) $in \ideal_coset<A, ring>(I, ring.mul(x1, y1))
    by thm ideal_coset_eq_of_mem(A, ring, I, ring.mul(x1, y1), ring.mul(x, y))
    \ideal_coset<A, ring>(I, ring.mul(x, y)) = \ideal_coset<A, ring>(I, ring.mul(x1, y1))
    \quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \ideal_coset<A, ring>(I, ring.mul(x1, y1)) = \ideal_coset<A, ring>(I, ring.mul(x, y)) = \quotient_ring_mk<A, ring, I>(ring.mul(x, y))

thm quotient_ring_has_mk_preimage:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, q power_set(A):
        $is_ideal(A, ring, I)
        q $in \quotient_ring_nonempty<A, ring, I>
        =>:
            exist x A st {q = \quotient_ring_mk<A, ring, I>(x)}
    obtain representative from exist x A st {q = \ideal_coset<A, ring>(I, x)}
    \quotient_ring_mk<A, ring, I>(representative) = \ideal_coset<A, ring>(I, representative)
    witness exist x A st {q = \quotient_ring_mk<A, ring, I>(x)} from representative

thm quotient_ring_add_of_representatives:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, q, r power_set(A), x, y A:
        $is_ideal(A, ring, I)
        q $in \quotient_ring_nonempty<A, ring, I>
        r $in \quotient_ring_nonempty<A, ring, I>
        q = \quotient_ring_mk<A, ring, I>(x)
        r = \quotient_ring_mk<A, ring, I>(y)
        =>:
            \quotient_ring_add<A, ring, I>(q, r) = \quotient_ring_mk<A, ring, I>(ring.add(x, y))
    by thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(t \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I> {\quotient_ring_add<A, ring, I>(t, r)}, q, \quotient_ring_mk<A, ring, I>(x))
    by thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(t \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I> {\quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), t)}, r, \quotient_ring_mk<A, ring, I>(y))
    by thm quotient_ring_add_mk(A, ring, I, x, y)
    \quotient_ring_add<A, ring, I>(q, r) = \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), r) = \quotient_ring_add<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \quotient_ring_mk<A, ring, I>(ring.add(x, y))

thm quotient_ring_neg_of_representative:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, q power_set(A), x A:
        $is_ideal(A, ring, I)
        q $in \quotient_ring_nonempty<A, ring, I>
        q = \quotient_ring_mk<A, ring, I>(x)
        =>:
            \quotient_ring_neg<A, ring, I>(q) = \quotient_ring_mk<A, ring, I>(ring.neg(x))
    by thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, \quotient_ring_neg<A, ring, I>, q, \quotient_ring_mk<A, ring, I>(x))
    by thm quotient_ring_neg_mk(A, ring, I, x)
    \quotient_ring_neg<A, ring, I>(q) = \quotient_ring_neg<A, ring, I>(\quotient_ring_mk<A, ring, I>(x)) = \quotient_ring_mk<A, ring, I>(ring.neg(x))

thm quotient_ring_mul_of_representatives:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, q, r power_set(A), x, y A:
        $is_ideal(A, ring, I)
        q $in \quotient_ring_nonempty<A, ring, I>
        r $in \quotient_ring_nonempty<A, ring, I>
        q = \quotient_ring_mk<A, ring, I>(x)
        r = \quotient_ring_mk<A, ring, I>(y)
        =>:
            \quotient_ring_mul<A, ring, I>(q, r) = \quotient_ring_mk<A, ring, I>(ring.mul(x, y))
    by thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(t \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I> {\quotient_ring_mul<A, ring, I>(t, r)}, q, \quotient_ring_mk<A, ring, I>(x))
    by thm object_substitution(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(t \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I> {\quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), t)}, r, \quotient_ring_mk<A, ring, I>(y))
    by thm quotient_ring_mul_mk(A, ring, I, x, y)
    \quotient_ring_mul<A, ring, I>(q, r) = \quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), r) = \quotient_ring_mul<A, ring, I>(\quotient_ring_mk<A, ring, I>(x), \quotient_ring_mk<A, ring, I>(y)) = \quotient_ring_mk<A, ring, I>(ring.mul(x, y))

template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have quotient_ring_zero \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mk<A, ring, I>(ring.zero)

template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have quotient_ring_one \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mk<A, ring, I>(ring.one)

thm quotient_ring_tuple_is_commutative_ring:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A):
        $is_ideal(A, ring, I)
        =>:
            (\quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>) $in &chap7::CommutativeRing<\quotient_ring_nonempty<A, ring, I>>
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::is_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::is_additive_commutative_group(A, ring.add, ring.zero, ring.neg)
    claim:
        ? forall q, r, s \quotient_ring_nonempty<A, ring, I>:
            \quotient_ring_add<A, ring, I>(\quotient_ring_add<A, ring, I>(q, r), s) = \quotient_ring_add<A, ring, I>(q, \quotient_ring_add<A, ring, I>(r, s))
        obtain x from exist a A st {q = \quotient_ring_mk<A, ring, I>(a)}
        obtain y from exist a A st {r = \quotient_ring_mk<A, ring, I>(a)}
        obtain z from exist a A st {s = \quotient_ring_mk<A, ring, I>(a)}
        by thm quotient_ring_add_of_representatives(A, ring, I, q, r, x, y)
        have qr \quotient_ring_nonempty<A, ring, I> = \quotient_ring_add<A, ring, I>(q, r)
        qr = \quotient_ring_mk<A, ring, I>(ring.add(x, y))
        by thm quotient_ring_add_of_representatives(A, ring, I, qr, s, ring.add(x, y), z)
        by thm quotient_ring_add_of_representatives(A, ring, I, r, s, y, z)
        have rs \quotient_ring_nonempty<A, ring, I> = \quotient_ring_add<A, ring, I>(r, s)
        rs = \quotient_ring_mk<A, ring, I>(ring.add(y, z))
        by thm quotient_ring_add_of_representatives(A, ring, I, q, rs, x, ring.add(y, z))
        ring.add(ring.add(x, y), z) = ring.add(x, ring.add(y, z))
        \quotient_ring_add<A, ring, I>(\quotient_ring_add<A, ring, I>(q, r), s) = \quotient_ring_add<A, ring, I>(qr, s) = \quotient_ring_mk<A, ring, I>(ring.add(ring.add(x, y), z)) = \quotient_ring_mk<A, ring, I>(ring.add(x, ring.add(y, z))) = \quotient_ring_add<A, ring, I>(q, rs) = \quotient_ring_add<A, ring, I>(q, \quotient_ring_add<A, ring, I>(r, s))
    claim:
        ? forall q \quotient_ring_nonempty<A, ring, I>:
            \quotient_ring_add<A, ring, I>(\quotient_ring_zero<A, ring, I>, q) = q
            \quotient_ring_add<A, ring, I>(\quotient_ring_neg<A, ring, I>(q), q) = \quotient_ring_zero<A, ring, I>
        obtain x from exist a A st {q = \quotient_ring_mk<A, ring, I>(a)}
        by thm quotient_ring_add_of_representatives(A, ring, I, \quotient_ring_zero<A, ring, I>, q, ring.zero, x)
        ring.add(ring.zero, x) = x
        \quotient_ring_add<A, ring, I>(\quotient_ring_zero<A, ring, I>, q) = \quotient_ring_mk<A, ring, I>(ring.add(ring.zero, x)) = \quotient_ring_mk<A, ring, I>(x) = q
        by thm quotient_ring_neg_of_representative(A, ring, I, q, x)
        have nq \quotient_ring_nonempty<A, ring, I> = \quotient_ring_neg<A, ring, I>(q)
        nq = \quotient_ring_mk<A, ring, I>(ring.neg(x))
        by thm quotient_ring_add_of_representatives(A, ring, I, nq, q, ring.neg(x), x)
        ring.add(ring.neg(x), x) = ring.zero
        \quotient_ring_add<A, ring, I>(\quotient_ring_neg<A, ring, I>(q), q) = \quotient_ring_add<A, ring, I>(nq, q) = \quotient_ring_mk<A, ring, I>(ring.add(ring.neg(x), x)) = \quotient_ring_mk<A, ring, I>(ring.zero) = \quotient_ring_zero<A, ring, I>
    claim:
        ? forall q, r \quotient_ring_nonempty<A, ring, I>:
            \quotient_ring_add<A, ring, I>(q, r) = \quotient_ring_add<A, ring, I>(r, q)
        obtain x from exist a A st {q = \quotient_ring_mk<A, ring, I>(a)}
        obtain y from exist a A st {r = \quotient_ring_mk<A, ring, I>(a)}
        by thm quotient_ring_add_of_representatives(A, ring, I, q, r, x, y)
        by thm quotient_ring_add_of_representatives(A, ring, I, r, q, y, x)
        ring.add(x, y) = ring.add(y, x)
        \quotient_ring_add<A, ring, I>(q, r) = \quotient_ring_mk<A, ring, I>(ring.add(x, y)) = \quotient_ring_mk<A, ring, I>(ring.add(y, x)) = \quotient_ring_add<A, ring, I>(r, q)
    claim:
        ? forall q, r, s \quotient_ring_nonempty<A, ring, I>:
            \quotient_ring_mul<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, r), s) = \quotient_ring_mul<A, ring, I>(q, \quotient_ring_mul<A, ring, I>(r, s))
            \quotient_ring_mul<A, ring, I>(q, \quotient_ring_add<A, ring, I>(r, s)) = \quotient_ring_add<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, r), \quotient_ring_mul<A, ring, I>(q, s))
            \quotient_ring_mul<A, ring, I>(\quotient_ring_add<A, ring, I>(q, r), s) = \quotient_ring_add<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, s), \quotient_ring_mul<A, ring, I>(r, s))
        obtain x from exist a A st {q = \quotient_ring_mk<A, ring, I>(a)}
        obtain y from exist a A st {r = \quotient_ring_mk<A, ring, I>(a)}
        obtain z from exist a A st {s = \quotient_ring_mk<A, ring, I>(a)}
        have qr \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mul<A, ring, I>(q, r)
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, r, x, y)
        qr = \quotient_ring_mk<A, ring, I>(ring.mul(x, y))
        by thm quotient_ring_mul_of_representatives(A, ring, I, qr, s, ring.mul(x, y), z)
        have rs \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mul<A, ring, I>(r, s)
        by thm quotient_ring_mul_of_representatives(A, ring, I, r, s, y, z)
        rs = \quotient_ring_mk<A, ring, I>(ring.mul(y, z))
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, rs, x, ring.mul(y, z))
        ring.mul(ring.mul(x, y), z) = ring.mul(x, ring.mul(y, z))
        \quotient_ring_mul<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, r), s) = \quotient_ring_mul<A, ring, I>(qr, s) = \quotient_ring_mk<A, ring, I>(ring.mul(ring.mul(x, y), z)) = \quotient_ring_mk<A, ring, I>(ring.mul(x, ring.mul(y, z))) = \quotient_ring_mul<A, ring, I>(q, rs) = \quotient_ring_mul<A, ring, I>(q, \quotient_ring_mul<A, ring, I>(r, s))
        have ars \quotient_ring_nonempty<A, ring, I> = \quotient_ring_add<A, ring, I>(r, s)
        by thm quotient_ring_add_of_representatives(A, ring, I, r, s, y, z)
        ars = \quotient_ring_mk<A, ring, I>(ring.add(y, z))
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, ars, x, ring.add(y, z))
        have qrm \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mul<A, ring, I>(q, r)
        have qsm \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mul<A, ring, I>(q, s)
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, r, x, y)
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, s, x, z)
        qrm = \quotient_ring_mk<A, ring, I>(ring.mul(x, y))
        qsm = \quotient_ring_mk<A, ring, I>(ring.mul(x, z))
        by thm quotient_ring_add_of_representatives(A, ring, I, qrm, qsm, ring.mul(x, y), ring.mul(x, z))
        ring.mul(x, ring.add(y, z)) = ring.add(ring.mul(x, y), ring.mul(x, z))
        \quotient_ring_mul<A, ring, I>(q, \quotient_ring_add<A, ring, I>(r, s)) = \quotient_ring_mul<A, ring, I>(q, ars) = \quotient_ring_mk<A, ring, I>(ring.mul(x, ring.add(y, z))) = \quotient_ring_mk<A, ring, I>(ring.add(ring.mul(x, y), ring.mul(x, z))) = \quotient_ring_add<A, ring, I>(qrm, qsm) = \quotient_ring_add<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, r), \quotient_ring_mul<A, ring, I>(q, s))
        have aqr \quotient_ring_nonempty<A, ring, I> = \quotient_ring_add<A, ring, I>(q, r)
        by thm quotient_ring_add_of_representatives(A, ring, I, q, r, x, y)
        aqr = \quotient_ring_mk<A, ring, I>(ring.add(x, y))
        by thm quotient_ring_mul_of_representatives(A, ring, I, aqr, s, ring.add(x, y), z)
        have qzs \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mul<A, ring, I>(q, s)
        have rzs \quotient_ring_nonempty<A, ring, I> = \quotient_ring_mul<A, ring, I>(r, s)
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, s, x, z)
        by thm quotient_ring_mul_of_representatives(A, ring, I, r, s, y, z)
        qzs = \quotient_ring_mk<A, ring, I>(ring.mul(x, z))
        rzs = \quotient_ring_mk<A, ring, I>(ring.mul(y, z))
        by thm quotient_ring_add_of_representatives(A, ring, I, qzs, rzs, ring.mul(x, z), ring.mul(y, z))
        ring.mul(ring.add(x, y), z) = ring.add(ring.mul(x, z), ring.mul(y, z))
        \quotient_ring_mul<A, ring, I>(\quotient_ring_add<A, ring, I>(q, r), s) = \quotient_ring_mul<A, ring, I>(aqr, s) = \quotient_ring_mk<A, ring, I>(ring.mul(ring.add(x, y), z)) = \quotient_ring_mk<A, ring, I>(ring.add(ring.mul(x, z), ring.mul(y, z))) = \quotient_ring_add<A, ring, I>(qzs, rzs) = \quotient_ring_add<A, ring, I>(\quotient_ring_mul<A, ring, I>(q, s), \quotient_ring_mul<A, ring, I>(r, s))
    claim:
        ? forall q \quotient_ring_nonempty<A, ring, I>:
            \quotient_ring_mul<A, ring, I>(\quotient_ring_one<A, ring, I>, q) = q
            \quotient_ring_mul<A, ring, I>(q, \quotient_ring_one<A, ring, I>) = q
        obtain x from exist a A st {q = \quotient_ring_mk<A, ring, I>(a)}
        by thm quotient_ring_mul_of_representatives(A, ring, I, \quotient_ring_one<A, ring, I>, q, ring.one, x)
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, \quotient_ring_one<A, ring, I>, x, ring.one)
        ring.mul(ring.one, x) = x
        ring.mul(x, ring.one) = x
        \quotient_ring_mul<A, ring, I>(\quotient_ring_one<A, ring, I>, q) = \quotient_ring_mk<A, ring, I>(ring.mul(ring.one, x)) = \quotient_ring_mk<A, ring, I>(x) = q
        \quotient_ring_mul<A, ring, I>(q, \quotient_ring_one<A, ring, I>) = \quotient_ring_mk<A, ring, I>(ring.mul(x, ring.one)) = \quotient_ring_mk<A, ring, I>(x) = q
    claim:
        ? forall q, r \quotient_ring_nonempty<A, ring, I>:
            \quotient_ring_mul<A, ring, I>(q, r) = \quotient_ring_mul<A, ring, I>(r, q)
        obtain x from exist a A st {q = \quotient_ring_mk<A, ring, I>(a)}
        obtain y from exist a A st {r = \quotient_ring_mk<A, ring, I>(a)}
        by thm quotient_ring_mul_of_representatives(A, ring, I, q, r, x, y)
        by thm quotient_ring_mul_of_representatives(A, ring, I, r, q, y, x)
        ring.mul(x, y) = ring.mul(y, x)
        \quotient_ring_mul<A, ring, I>(q, r) = \quotient_ring_mk<A, ring, I>(ring.mul(x, y)) = \quotient_ring_mk<A, ring, I>(ring.mul(y, x)) = \quotient_ring_mul<A, ring, I>(r, q)
    by def:
        ? $chap2::is_additive_commutative_group(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>)
    by def:
        ? $chap2::is_ring(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>)
    by def:
        ? $chap7::is_commutative_ring(\quotient_ring_nonempty<A, ring, I>, \quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>)
    \quotient_ring_add<A, ring, I> $in fn(q, r \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I>
    \quotient_ring_zero<A, ring, I> $in \quotient_ring_nonempty<A, ring, I>
    \quotient_ring_neg<A, ring, I> $in fn(q \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I>
    \quotient_ring_mul<A, ring, I> $in fn(q, r \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I>
    \quotient_ring_one<A, ring, I> $in \quotient_ring_nonempty<A, ring, I>
    by thm cart_member_from_coordinates((\quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>), cart(fn(q, r \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>, fn(q \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I>, fn(q, r \quotient_ring_nonempty<A, ring, I>) \quotient_ring_nonempty<A, ring, I>, \quotient_ring_nonempty<A, ring, I>))
    by thm struct_member((\quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>), &chap7::CommutativeRing<\quotient_ring_nonempty<A, ring, I>>)

template<A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A): $is_ideal(A, ring, I)>:
    have quotient_commutative_ring &chap7::CommutativeRing<\quotient_ring_nonempty<A, ring, I>> = (\quotient_ring_add<A, ring, I>, \quotient_ring_zero<A, ring, I>, \quotient_ring_neg<A, ring, I>, \quotient_ring_mul<A, ring, I>, \quotient_ring_one<A, ring, I>)

prop ideal_sum_member(A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), x A):
    exist a, b A st {a $in I, b $in J, x = ring.add(a, b)}

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn ideal_sum(I, J power_set(A)) power_set(A) = {x A: $ideal_sum_member(A, ring, I, J, x)}

thm ideal_contains_finite_range_sum:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I power_set(A), f fn(index N) A, n N:
        $is_ideal(A, ring, I)
        forall index range(0, n):
            f(index) $in I
        =>:
            \finite_range_sum<A, ring.add, ring.zero>(f, n) $in I
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::is_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::is_additive_commutative_group(A, ring.add, ring.zero, ring.neg)
    claim:
        ? forall x A:
            ring.add(x, ring.zero) = x
        by thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
    by def:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    prop _ideal_contains_finite_range_sum_at(count N):
        forall target power_set(A):
            target = I
            forall index range(0, count):
                f(index) $in target
            =>:
                \finite_range_sum<A, ring.add, ring.zero>(f, count) $in target
    claim:
        ? forall count N:
            $_ideal_contains_finite_range_sum_at(count)
        by induc count from 0:
            ? $_ideal_contains_finite_range_sum_at(count)
            ? from count = 0:
                claim:
                    ? forall target power_set(A):
                        target = I
                        forall index range(0, count):
                            f(index) $in target
                        =>:
                            \finite_range_sum<A, ring.add, ring.zero>(f, count) $in target
                    by thm finite_range_sum_zero(A, ring.add, ring.zero, f)
                    ring.zero $in I
                    ring.zero $in target
                    \finite_range_sum<A, ring.add, ring.zero>(f, count) = ring.zero
                    \finite_range_sum<A, ring.add, ring.zero>(f, count) $in target
                by def:
                    ? $_ideal_contains_finite_range_sum_at(count)
                $_ideal_contains_finite_range_sum_at(count)
            ? induc:
                $_ideal_contains_finite_range_sum_at(count)
                claim:
                    ? forall target power_set(A):
                        target = I
                        forall index range(0, count + 1):
                            f(index) $in target
                        =>:
                            \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) $in target
                    claim:
                        ? forall index range(0, count):
                            f(index) $in I
                        index < count < count + 1
                        f(index) $in target
                        f(index) $in I
                    $_ideal_contains_finite_range_sum_at(count)
                    I = I
                    \finite_range_sum<A, ring.add, ring.zero>(f, count) $in I
                    count < count + 1
                    f(count) $in target
                    f(count) $in I
                    ring.add(\finite_range_sum<A, ring.add, ring.zero>(f, count), f(count)) $in I
                    by thm finite_range_sum_succ(A, ring.add, ring.zero, f, count)
                    \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) = ring.add(\finite_range_sum<A, ring.add, ring.zero>(f, count), f(count))
                    \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) $in I
                    \finite_range_sum<A, ring.add, ring.zero>(f, count + 1) $in target
                by def:
                    ? $_ideal_contains_finite_range_sum_at(count + 1)
                $_ideal_contains_finite_range_sum_at(count + 1)
    $_ideal_contains_finite_range_sum_at(n)
    I = I
    \finite_range_sum<A, ring.add, ring.zero>(f, n) $in I

prop ideal_product_factors(A set, I, J power_set(A), n N, left, right fn(index N) A):
    forall index range(0, n):
        left(index) $in I
        right(index) $in J

prop ideal_product_member(A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A), x A):
    exist n N, left, right fn(index N) A st {$ideal_product_factors(A, I, J, n, left, right), x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)}

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn ideal_product(I, J power_set(A)) power_set(A) = {x A: $ideal_product_member(A, ring, I, J, x)}

thm ideal_product_subset_factors:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A):
        $is_ideal(A, ring, I)
        $is_ideal(A, ring, J)
        =>:
            \ideal_product<A, ring>(I, J) $subset I
            \ideal_product<A, ring>(I, J) $subset J
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    claim:
        ? forall x \ideal_product<A, ring>(I, J):
            x $in I
        by def:
            ? $ideal_product_member(A, ring, I, J, x)
        obtain n, left, right from exist n N, left, right fn(index N) A st {$ideal_product_factors(A, I, J, n, left, right), x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)}
        claim:
            ? forall index range(0, n):
                ring.mul(left(index), right(index)) $in I
            left(index) $in I
            right(index) $in J
            ring.mul(right(index), left(index)) $in I
            ring.mul(left(index), right(index)) = ring.mul(right(index), left(index))
            ring.mul(left(index), right(index)) $in I
        by thm ideal_contains_finite_range_sum(A, ring, I, fn(index N) A {ring.mul(left(index), right(index))}, n)
        x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)
        x $in I
    by def:
        ? \ideal_product<A, ring>(I, J) $subset I
    \ideal_product<A, ring>(I, J) $subset I
    claim:
        ? forall x \ideal_product<A, ring>(I, J):
            x $in J
        by def:
            ? $ideal_product_member(A, ring, I, J, x)
        obtain n, left, right from exist n N, left, right fn(index N) A st {$ideal_product_factors(A, I, J, n, left, right), x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)}
        claim:
            ? forall index range(0, n):
                ring.mul(left(index), right(index)) $in J
            left(index) $in I
            right(index) $in J
            ring.mul(left(index), right(index)) $in J
        by thm ideal_contains_finite_range_sum(A, ring, J, fn(index N) A {ring.mul(left(index), right(index))}, n)
        x = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {ring.mul(left(index), right(index))}, n)
        x $in J
    by def:
        ? \ideal_product<A, ring>(I, J) $subset J
    \ideal_product<A, ring>(I, J) $subset J

template<A set>:
    have fn ideal_infimum_pair(I, J power_set(A)) power_set(A) = {x A: x $in I and x $in J}

template<A, S set, f fn(x A) S>:
    have fn ideal_comap(J power_set(S)) power_set(A) = {x A: f(x) $in J}

prop has_ideal_map_preimage(A, S set, f fn(x A) S, I power_set(A), y S):
    exist x A st {x $in I, f(x) = y}

template<A, S set, f fn(x A) S>:
    have fn ideal_map(I power_set(A)) power_set(S) = {y S: $has_ideal_map_preimage(A, S, f, I, y)}

template<A, S set, zeroS S, f fn(x A) S>:
    have ring_kernel power_set(A) = {x A: f(x) = zeroS}

template<A, S set, f fn(x A) S>:
    have ring_range power_set(S) = \ideal_map<A, S, f>(A)

thm ring_kernel_is_ideal:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            $is_ideal(A, source, \ring_kernel<A, S, target.zero, f>)
    $chap7::is_commutative_ring(A, source.add, source.zero, source.neg, source.mul, source.one)
    $chap7::is_commutative_ring(S, target.add, target.zero, target.neg, target.mul, target.one)
    $chap2::is_ring(A, source.add, source.zero, source.neg, source.mul, source.one)
    $chap2::is_ring(S, target.add, target.zero, target.neg, target.mul, target.one)
    $chap2::is_additive_commutative_group(A, source.add, source.zero, source.neg)
    $chap2::is_additive_commutative_group(S, target.add, target.zero, target.neg)
    \ring_kernel<A, S, target.zero, f> = {x A: f(x) = target.zero}
    by thm commutative_ring_hom_map_zero(A, S, source, target, f)
    f(source.zero) = target.zero
    by thm set_builder_member(source.zero, {x A: f(x) = target.zero})
    source.zero $in {x A: f(x) = target.zero}
    source.zero $in \ring_kernel<A, S, target.zero, f>
    claim:
        ? forall x, y A:
            x $in \ring_kernel<A, S, target.zero, f>
            y $in \ring_kernel<A, S, target.zero, f>
            =>:
                source.add(x, y) $in \ring_kernel<A, S, target.zero, f>
        f(x) = target.zero
        f(y) = target.zero
        by thm commutative_ring_hom_map_add(A, S, source, target, f, x, y)
        f(source.add(x, y)) = target.add(f(x), f(y)) = target.add(target.zero, target.zero) = target.zero
        by thm set_builder_member(source.add(x, y), {z A: f(z) = target.zero})
        source.add(x, y) $in {z A: f(z) = target.zero}
        source.add(x, y) $in \ring_kernel<A, S, target.zero, f>
    claim:
        ? forall x A:
            x $in \ring_kernel<A, S, target.zero, f>
            =>:
                source.neg(x) $in \ring_kernel<A, S, target.zero, f>
        f(x) = target.zero
        source.add(source.neg(x), x) = source.zero
        by thm commutative_ring_hom_map_add(A, S, source, target, f, source.neg(x), x)
        f(source.add(source.neg(x), x)) = target.add(f(source.neg(x)), f(x))
        f(source.add(source.neg(x), x)) = f(source.zero) = target.zero
        target.add(f(source.neg(x)), f(x)) = target.add(f(source.neg(x)), target.zero) = target.zero
        by thm chap2::add_zero_from_laws(S, target.add, target.zero, target.neg, f(source.neg(x)))
        target.add(f(source.neg(x)), target.zero) = f(source.neg(x))
        f(source.neg(x)) = target.zero
        by thm set_builder_member(source.neg(x), {z A: f(z) = target.zero})
        source.neg(x) $in {z A: f(z) = target.zero}
        source.neg(x) $in \ring_kernel<A, S, target.zero, f>
    claim:
        ? forall r, x A:
            x $in \ring_kernel<A, S, target.zero, f>
            =>:
                source.mul(r, x) $in \ring_kernel<A, S, target.zero, f>
        f(x) = target.zero
        by thm commutative_ring_hom_map_mul(A, S, source, target, f, r, x)
        f(source.mul(r, x)) = target.mul(f(r), f(x)) = target.mul(f(r), target.zero)
        by thm chap2::mul_zero_from_laws(S, target.add, target.zero, target.neg, target.mul, target.one, f(r))
        target.mul(f(r), target.zero) = target.zero
        f(source.mul(r, x)) = target.zero
        by thm set_builder_member(source.mul(r, x), {z A: f(z) = target.zero})
        source.mul(r, x) $in {z A: f(z) = target.zero}
        source.mul(r, x) $in \ring_kernel<A, S, target.zero, f>
    by def:
        ? $is_ideal(A, source, \ring_kernel<A, S, target.zero, f>)

thm ring_range_is_nonempty:
    ? forall A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S:
        $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)
        =>:
            $is_nonempty_set(\ring_range<A, S, f>)
    \ideal_map<A, S, f>(A) = {y S: $has_ideal_map_preimage(A, S, f, A, y)}
    witness exist x A st {x $in A, f(x) = f(source.zero)} from source.zero
    by def:
        ? $has_ideal_map_preimage(A, S, f, A, f(source.zero))
    by thm set_builder_member(f(source.zero), {y S: $has_ideal_map_preimage(A, S, f, A, y)})
    f(source.zero) $in {y S: $has_ideal_map_preimage(A, S, f, A, y)}
    f(source.zero) $in \ideal_map<A, S, f>(A)
    \ring_range<A, S, f> = \ideal_map<A, S, f>(A)
    f(source.zero) $in \ring_range<A, S, f>
    witness $is_nonempty_set(\ring_range<A, S, f>) from f(source.zero)

template<A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S: $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)>:
    have ring_range_nonempty nonempty_set = \ring_range<A, S, f>

prop is_quotient_ring_first_isomorphism_value(A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S, q power_set(A), y S):
    exist x A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, x), y = f(x)}

template<A, S nonempty_set, source &chap7::CommutativeRing<A>, target &chap7::CommutativeRing<S>, f fn(x A) S: $is_ring_hom(A, S, (source.add, source.zero, source.neg, source.mul, source.one), (target.add, target.zero, target.neg, target.mul, target.one), f)>:
    have fn quotient_ring_first_isomorphism by exist!:
        ? forall q \quotient_ring_carrier<A, source>(\ring_kernel<A, S, target.zero, f>):
            exist! y \ring_range_nonempty<A, S, source, target, f> st {$is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y)}
        \ideal_map<A, S, f>(A) = {y S: $has_ideal_map_preimage(A, S, f, A, y)}
        obtain a from exist representative A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, representative)}
        witness exist x A st {x $in A, f(x) = f(a)} from a
        by def:
            ? $has_ideal_map_preimage(A, S, f, A, f(a))
        by thm set_builder_member(f(a), {y S: $has_ideal_map_preimage(A, S, f, A, y)})
        f(a) $in {y S: $has_ideal_map_preimage(A, S, f, A, y)}
        f(a) $in \ideal_map<A, S, f>(A)
        \ring_range<A, S, f> = \ideal_map<A, S, f>(A)
        f(a) $in \ring_range<A, S, f>
        \ring_range_nonempty<A, S, source, target, f> = \ring_range<A, S, f>
        f(a) $in \ring_range_nonempty<A, S, source, target, f>
        have candidate \ring_range_nonempty<A, S, source, target, f> = f(a)
        witness exist y \ring_range_nonempty<A, S, source, target, f> st {$is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y)} from candidate:
            witness exist x A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, x), candidate = f(x)} from a
            by def:
                ? $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, candidate)
        claim:
            ? forall y1, y2 \ring_range_nonempty<A, S, source, target, f>:
                $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y1)
                $is_quotient_ring_first_isomorphism_value(A, S, source, target, f, q, y2)
                =>:
                    y1 = y2
            obtain a1 from exist x A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, x), y1 = f(x)}
            obtain a2 from exist x A st {q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, x), y2 = f(x)}
            by thm ring_kernel_is_ideal(A, S, source, target, f)
            by thm ideal_coset_center_mem(A, source, \ring_kernel<A, S, target.zero, f>, a2)
            a2 $in \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a2)
            \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a2) = q = \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a1)
            a2 $in \ideal_coset<A, source>(\ring_kernel<A, S, target.zero, f>, a1)
            obtain k from exist idx A st {idx $in \ring_kernel<A, S, target.zero, f>, a2 = source.add(a1, idx)}
            f(k) = target.zero
            by thm commutative_ring_hom_map_add(A, S, source, target, f, a1, k)
            by thm chap2::add_zero_from_laws(S, target.add, target.zero, target.neg, f(a1))
            f(a2) = f(source.add(a1, k)) = target.add(f(a1), f(k)) = target.add(f(a1), target.zero) = f(a1)
            y2 = f(a2) = f(a1) = y1
            y1 = y2

prop is_commutative_ring_ideal_family(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A)):
    forall idx Index:
        $is_ideal(A, ring, I(idx))

prop ideals_coprime(A nonempty_set, ring &chap7::CommutativeRing<A>, I, J power_set(A)):
    $is_ideal(A, ring, I)
    $is_ideal(A, ring, J)
    \ideal_sum<A, ring>(I, J) = A

prop ideals_pairwise_coprime(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A)):
    $is_commutative_ring_ideal_family(Index, A, ring, I)
    forall idx, j Index:
        idx != j
        =>:
            $ideals_coprime(A, ring, I(idx), I(j))

prop belongs_to_every_ideal(Index, A set, I fn(idx Index) power_set(A), x A):
    forall idx Index:
        x $in I(idx)

template<Index, A set, I fn(idx Index) power_set(A)>:
    have ideal_infimum power_set(A) = {x A: $belongs_to_every_ideal(Index, A, I, x)}

prop is_quotient_tuple(Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A), q fn(idx Index) power_set(A)):
    forall idx Index:
        q(idx) $in \quotient_ring_carrier<A, ring>(I(idx))

template<Index set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A)>:
    have quotient_product power_set(fn(idx Index) power_set(A)) = {q fn(idx Index) power_set(A): $is_quotient_tuple(Index, A, ring, I, q)}

# The Chinese map sends a class to its family of residue classes. Its
# injectivity, finite-family surjectivity, and selected equivalence are debt.
template<Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A): $is_commutative_ring_ideal_family(Index, A, ring, I)>:
    trust have chinese_map fn(x \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>)) \quotient_product<Index, A, ring, I>

trust forall Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A):
    $is_commutative_ring_ideal_family(Index, A, ring, I)
    $ideals_pairwise_coprime(Index, A, ring, I)
    =>:
        $chap4::bijective_fn(\quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>), \quotient_product<Index, A, ring, I>, \chinese_map<Index, A, ring, I>)

template<Index finite_set, A nonempty_set, ring &chap7::CommutativeRing<A>, I fn(idx Index) power_set(A): $is_commutative_ring_ideal_family(Index, A, ring, I), $ideals_pairwise_coprime(Index, A, ring, I)>:
    trust have chinese_remainder_inverse fn(q \quotient_product<Index, A, ring, I>) \quotient_ring_carrier<A, ring>(\ideal_infimum<Index, A, I>)

# ---------------------------------------------------------------------------
# 9.2.3 Algebras and polynomials
# ---------------------------------------------------------------------------

prop is_algebra(A, B set, addA fn(x, y A) A, mulA fn(x, y A) A, addB fn(x, y B) B, smul fn(r A, b B) B):
    forall r, s A, b B:
        smul(addA(r, s), b) = addB(smul(r, b), smul(s, b))
        smul(mulA(r, s), b) = smul(r, smul(s, b))

thm algebra_add_smul:
    ? forall A, B set, addA fn(x, y A) A, mulA fn(x, y A) A, addB fn(x, y B) B, smul fn(r A, b B) B, r, s A, b B:
        $is_algebra(A, B, addA, mulA, addB, smul)
        =>:
            smul(addA(r, s), b) = addB(smul(r, b), smul(s, b))
    smul(addA(r, s), b) = addB(smul(r, b), smul(s, b))

prop supports_polynomial(A set, zero A, p fn(n N) A, support finite_set):
    support $subset N
    forall n N:
        p(n) != zero
        =>:
            n $in support

prop polynomial_has_finite_support(A set, zero A, p fn(n N) A):
    exist support finite_set st {$supports_polynomial(A, zero, p, support)}

template<A set, zero A>:
    have polynomial_carrier power_set(fn(n N) A) = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, zero, candidate_polynomial)}

template<A set, zero A>:
    have fn polynomial_coeff(p \polynomial_carrier<A, zero>, n N) A = p(n)

# Polynomial constructors and operations remain coefficient functions with
# finite support.
prop is_polynomial_X(A set, zero, one A, p fn(n N) A):
    p(1) = one
    forall n N:
        n != 1
        =>:
            p(n) = zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_X_selected by exist!:
        ? forall marker {0}:
            exist! p \polynomial_carrier<A, ring.zero> st {$is_polynomial_X(A, ring.zero, ring.one, p)}
        have fn candidate(n N) A by cases:
            case n = 1: ring.one
            case n != 1: ring.zero
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        claim:
            ? $polynomial_has_finite_support(A, ring.zero, candidate)
            claim:
                ? $supports_polynomial(A, ring.zero, candidate, {1})
                {1} $subset N
                claim:
                    ? forall n N:
                        candidate(n) != ring.zero
                        =>:
                            n $in {1}
                    by cases:
                        ? n $in {1}
                        case n = 1:
                            n $in {1}
                        case n != 1:
                            candidate(n) = ring.zero
                            impossible candidate(n) = ring.zero
                by def:
                    ? $supports_polynomial(A, ring.zero, candidate, {1})
            witness exist support finite_set st {$supports_polynomial(A, ring.zero, candidate, support)} from {1}
            by def:
                ? $polynomial_has_finite_support(A, ring.zero, candidate)
        by thm set_builder_member(candidate, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        candidate $in {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        candidate $in \polynomial_carrier<A, ring.zero>
        witness exist p \polynomial_carrier<A, ring.zero> st {$is_polynomial_X(A, ring.zero, ring.one, p)} from candidate:
            candidate(1) = ring.one
            forall n N:
                n != 1
                =>:
                    candidate(n) = ring.zero
            by def:
                ? $is_polynomial_X(A, ring.zero, ring.one, candidate)
        claim:
            ? forall p, q \polynomial_carrier<A, ring.zero>:
                $is_polynomial_X(A, ring.zero, ring.one, p)
                $is_polynomial_X(A, ring.zero, ring.one, q)
                =>:
                    p = q
            claim:
                ? forall n N:
                    p(n) = q(n)
                by cases:
                    ? p(n) = q(n)
                    case n = 1:
                        p(n) = ring.one = q(n)
                    case n != 1:
                        p(n) = ring.zero = q(n)
            by def:
                ? $fn_eq(p, q)
            $fn_eq(p, q)
            p = q

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have polynomial_X \polynomial_carrier<A, ring.zero> = \polynomial_X_selected<A, ring>(0)

prop is_polynomial_C(A set, zero, a A, p fn(n N) A):
    p(0) = a
    forall n N:
        n != 0
        =>:
            p(n) = zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_C by exist!:
        ? forall a A:
            exist! p \polynomial_carrier<A, ring.zero> st {$is_polynomial_C(A, ring.zero, a, p)}
        have fn candidate(n N) A by cases:
            case n = 0: a
            case n != 0: ring.zero
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        claim:
            ? $polynomial_has_finite_support(A, ring.zero, candidate)
            claim:
                ? $supports_polynomial(A, ring.zero, candidate, {0})
                {0} $subset N
                claim:
                    ? forall n N:
                        candidate(n) != ring.zero
                        =>:
                            n $in {0}
                    by cases:
                        ? n $in {0}
                        case n = 0:
                            n $in {0}
                        case n != 0:
                            candidate(n) = ring.zero
                            impossible candidate(n) = ring.zero
                by def:
                    ? $supports_polynomial(A, ring.zero, candidate, {0})
            witness exist support finite_set st {$supports_polynomial(A, ring.zero, candidate, support)} from {0}
            by def:
                ? $polynomial_has_finite_support(A, ring.zero, candidate)
        by thm set_builder_member(candidate, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        candidate $in {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        candidate $in \polynomial_carrier<A, ring.zero>
        witness exist p \polynomial_carrier<A, ring.zero> st {$is_polynomial_C(A, ring.zero, a, p)} from candidate:
            candidate(0) = a
            forall n N:
                n != 0
                =>:
                    candidate(n) = ring.zero
            by def:
                ? $is_polynomial_C(A, ring.zero, a, candidate)
        claim:
            ? forall p, q \polynomial_carrier<A, ring.zero>:
                $is_polynomial_C(A, ring.zero, a, p)
                $is_polynomial_C(A, ring.zero, a, q)
                =>:
                    p = q
            claim:
                ? forall n N:
                    p(n) = q(n)
                by cases:
                    ? p(n) = q(n)
                    case n = 0:
                        p(n) = a = q(n)
                    case n != 0:
                        p(n) = ring.zero = q(n)
            by def:
                ? $fn_eq(p, q)
            $fn_eq(p, q)
            p = q

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_add_coeff(p, q \polynomial_carrier<A, ring.zero>, n N) A = ring.add(p(n), q(n))

thm polynomial_add_coeff_has_finite_support:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)})
    obtain support_p from exist support finite_set st {$supports_polynomial(A, ring.zero, p, support)}
    obtain support_q from exist support finite_set st {$supports_polynomial(A, ring.zero, q, support)}
    claim:
        ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, union(support_p, support_q))
        claim:
            ? forall index union(support_p, support_q):
                index $in N
            index $in support_p or index $in support_q
            by cases:
                ? index $in N
                case index $in support_p:
                    index $in N
                case index $in support_q:
                    index $in N
        union(support_p, support_q) $subset N
        claim:
            ? forall n N:
                \polynomial_add_coeff<A, ring>(p, q, n) != ring.zero
                =>:
                    n $in union(support_p, support_q)
            by contra:
                ? n $in union(support_p, support_q)
                claim:
                    ? p(n) = ring.zero
                    by contra:
                        ? p(n) = ring.zero
                        p(n) != ring.zero
                        n $in support_p
                        n $in union(support_p, support_q)
                        impossible n $in union(support_p, support_q)
                claim:
                    ? q(n) = ring.zero
                    by contra:
                        ? q(n) = ring.zero
                        q(n) != ring.zero
                        n $in support_q
                        n $in union(support_p, support_q)
                        impossible n $in union(support_p, support_q)
                \polynomial_add_coeff<A, ring>(p, q, n) = ring.add(p(n), q(n)) = ring.add(ring.zero, ring.zero) = ring.zero
                impossible \polynomial_add_coeff<A, ring>(p, q, n) != ring.zero
        by def:
            ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, union(support_p, support_q))
    witness exist support finite_set st {$supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, support)} from union(support_p, support_q)
    by def:
        ? $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)})

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_add by exist!:
        ? forall p, q \polynomial_carrier<A, ring.zero>:
            exist! result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}}
        by thm polynomial_add_coeff_has_finite_support(A, ring, p, q)
        by thm set_builder_member(fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)} $in \polynomial_carrier<A, ring.zero>
        witness exist result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}} from fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}
        claim:
            ? forall result1, result2 \polynomial_carrier<A, ring.zero>:
                result1 = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}
                result2 = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)}
                =>:
                    result1 = result2
            result1 = fn(n N) A {\polynomial_add_coeff<A, ring>(p, q, n)} = result2

thm polynomial_add_apply:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>, n N:
        \polynomial_add<A, ring>(p, q)(n) = \polynomial_add_coeff<A, ring>(p, q, n)
    \polynomial_add<A, ring>(p, q) = fn(index N) A {\polynomial_add_coeff<A, ring>(p, q, index)}
    by thm object_substitution(fn(index N) A, A, fn(candidate fn(index N) A) A {candidate(n)}, \polynomial_add<A, ring>(p, q), fn(index N) A {\polynomial_add_coeff<A, ring>(p, q, index)})
    \polynomial_add<A, ring>(p, q)(n) = (fn(index N) A {\polynomial_add_coeff<A, ring>(p, q, index)})(n) = \polynomial_add_coeff<A, ring>(p, q, n)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_mul_term(p, q \polynomial_carrier<A, ring.zero>, n, index N) A by cases:
        case index <= n: ring.mul(p(index), q(n - index))
        case index > n: ring.zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_mul_coeff(p, q \polynomial_carrier<A, ring.zero>, n N) A = \finite_range_sum<A, ring.add, ring.zero>(fn(index N) A {\polynomial_mul_term<A, ring>(p, q, n, index)}, n + 1)

thm polynomial_mul_coeff_has_finite_support:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)})
    obtain support_p from exist support finite_set st {$supports_polynomial(A, ring.zero, p, support)}
    obtain support_q from exist support finite_set st {$supports_polynomial(A, ring.zero, q, support)}
    claim:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
        $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::is_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
        $chap2::is_additive_commutative_group(A, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x A:
                ring.add(x, ring.zero) = x
            by thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
        by def:
            ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    have fn support_index_sum(pair cart(support_p, support_q)) N = pair[1] + pair[2]
    have product_support finite_set = fn_range(support_index_sum)
    claim:
        ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, product_support)
        claim:
            ? product_support $subset N
            claim:
                ? forall n product_support:
                    n $in N
                product_support = fn_range(support_index_sum)
                n $in fn_range(support_index_sum)
                obtain pair from exist input cart(support_p, support_q) st {n = support_index_sum(input)}
                support_index_sum(pair) $in N
                n $in N
            by def:
                ? product_support $subset N
        claim:
            ? forall n N:
                \polynomial_mul_coeff<A, ring>(p, q, n) != ring.zero
                =>:
                    n $in product_support
            by contra:
                ? n $in product_support
                claim:
                    ? forall index range(0, n + 1):
                        \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                    by cases:
                        ? \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                        case index <= n:
                            \polynomial_mul_term<A, ring>(p, q, n, index) = ring.mul(p(index), q(n - index))
                            by cases:
                                ? \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                                case p(index) = ring.zero:
                                    by thm chap2::zero_mul_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, q(n - index))
                                    ring.mul(p(index), q(n - index)) = ring.mul(ring.zero, q(n - index)) = ring.zero
                                case p(index) != ring.zero:
                                    claim:
                                        ? q(n - index) = ring.zero
                                        by contra:
                                            ? q(n - index) = ring.zero
                                            q(n - index) != ring.zero
                                            index $in support_p
                                            n - index $in support_q
                                            (index, n - index) $in cart(support_p, support_q)
                                            support_index_sum((index, n - index)) $in fn_range(support_index_sum)
                                            support_index_sum((index, n - index)) = index + (n - index)
                                            index + (n - index) $in fn_range(support_index_sum)
                                            n = index + (n - index)
                                            n $in product_support
                                            impossible n $in product_support
                                    by thm chap2::mul_zero_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, p(index))
                                    ring.mul(p(index), q(n - index)) = ring.mul(p(index), ring.zero) = ring.zero
                        case index > n:
                            \polynomial_mul_term<A, ring>(p, q, n, index) = ring.zero
                by thm finite_range_sum_all_zero(A, ring.add, ring.zero, fn(index N) A {\polynomial_mul_term<A, ring>(p, q, n, index)}, n + 1)
                \polynomial_mul_coeff<A, ring>(p, q, n) = ring.zero
                impossible \polynomial_mul_coeff<A, ring>(p, q, n) != ring.zero
        by def:
            ? $supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, product_support)
    witness exist support finite_set st {$supports_polynomial(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, support)} from product_support
    by def:
        ? $polynomial_has_finite_support(A, ring.zero, fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)})

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_mul by exist!:
        ? forall p, q \polynomial_carrier<A, ring.zero>:
            exist! result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}}
        by thm polynomial_mul_coeff_has_finite_support(A, ring, p, q)
        by thm set_builder_member(fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}, {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)})
        \polynomial_carrier<A, ring.zero> = {candidate_polynomial fn(n N) A: $polynomial_has_finite_support(A, ring.zero, candidate_polynomial)}
        fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)} $in \polynomial_carrier<A, ring.zero>
        witness exist result \polynomial_carrier<A, ring.zero> st {result = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}} from fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}
        claim:
            ? forall result1, result2 \polynomial_carrier<A, ring.zero>:
                result1 = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}
                result2 = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)}
                =>:
                    result1 = result2
            result1 = fn(n N) A {\polynomial_mul_coeff<A, ring>(p, q, n)} = result2

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_pow(p \polynomial_carrier<A, ring.zero>, n N) \polynomial_carrier<A, ring.zero> by induc n from 0:
        case n = 0: \polynomial_C<A, ring>(ring.one)
        case n > 0: \polynomial_mul<A, ring>(polynomial_pow(p, n - 1), p)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_nonzero_support(p \polynomial_carrier<A, ring.zero>) power_set(N) = {n N: p(n) != ring.zero}

thm polynomial_nonzero_support_is_finite:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        $is_finite_set(\polynomial_nonzero_support<A, ring>(p))
    obtain support from exist support finite_set st {$supports_polynomial(A, ring.zero, p, support)}
    claim:
        ? \polynomial_nonzero_support<A, ring>(p) $subset support
        claim:
            ? forall n \polynomial_nonzero_support<A, ring>(p):
                n $in support
            p(n) != ring.zero
            n $in support
        by def:
            ? \polynomial_nonzero_support<A, ring>(p) $subset support
    \polynomial_nonzero_support<A, ring>(p) = set_minus(support, set_minus(support, \polynomial_nonzero_support<A, ring>(p)))
    $is_finite_set(set_minus(support, set_minus(support, \polynomial_nonzero_support<A, ring>(p))))
    $is_finite_set(\polynomial_nonzero_support<A, ring>(p))

template<A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>>:
    have polynomial_nonzero_support_finite finite_set = \polynomial_nonzero_support<A, ring>(p)

prop is_polynomial_eval_bound(A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, bound N):
    bound $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
    forall n N:
        n $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
        =>:
            n <= bound

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_eval_bound by exist!:
        ? forall p \polynomial_carrier<A, ring.zero>:
            exist! bound N st {$is_polynomial_eval_bound(A, ring, p, bound)}
        claim:
            ? \polynomial_nonzero_support_finite<A, ring, p> $subset N
            \polynomial_nonzero_support_finite<A, ring, p> = \polynomial_nonzero_support<A, ring>(p)
            claim:
                ? forall n \polynomial_nonzero_support<A, ring>(p):
                    n $in N
                n $in N
            by def:
                ? \polynomial_nonzero_support<A, ring>(p) $subset N
        $is_finite_set(union({0}, \polynomial_nonzero_support_finite<A, ring, p>))
        witness $is_nonempty_set(union({0}, \polynomial_nonzero_support_finite<A, ring, p>)) from 0:
            0 $in {0}
            0 $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
        union({0}, \polynomial_nonzero_support_finite<A, ring, p>) $subset N
        exist bound N st {$is_polynomial_eval_bound(A, ring, p, bound)}
        obtain candidate from exist bound N st {$is_polynomial_eval_bound(A, ring, p, bound)}
        witness exist bound N st {$is_polynomial_eval_bound(A, ring, p, bound)} from candidate
        claim:
            ? forall bound1, bound2 N:
                $is_polynomial_eval_bound(A, ring, p, bound1)
                $is_polynomial_eval_bound(A, ring, p, bound2)
                =>:
                    bound1 = bound2
            bound1 <= bound2
            bound2 <= bound1
            bound1 = bound2

thm polynomial_eval_bound_is_natural:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        \polynomial_eval_bound<A, ring>(p) $in N
    \polynomial_eval_bound<A, ring>(p) $in N

thm polynomial_eval_bound_member:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>:
        \polynomial_eval_bound<A, ring>(p) $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
    $is_polynomial_eval_bound(A, ring, p, \polynomial_eval_bound<A, ring>(p))
    \polynomial_eval_bound<A, ring>(p) $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)

thm polynomial_eval_bound_dominates:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, n N:
        n $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
        =>:
            n <= \polynomial_eval_bound<A, ring>(p)
    $is_polynomial_eval_bound(A, ring, p, \polynomial_eval_bound<A, ring>(p))
    n <= \polynomial_eval_bound<A, ring>(p)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_scalar_pow(x A, n N) A by induc n from 0:
        case n = 0: ring.one
        case n > 0: ring.mul(polynomial_scalar_pow(x, n - 1), x)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_eval(p \polynomial_carrier<A, ring.zero>, x A) A = \finite_range_sum<A, ring.add, ring.zero>(fn(n N) A {ring.mul(p(n), \polynomial_scalar_pow<A, ring>(x, n))}, \polynomial_eval_bound<A, ring>(p) + 1)

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_nat_degree(p \polynomial_carrier<A, ring.zero>) N = \polynomial_eval_bound<A, ring>(p)

prop is_polynomial_root(A nonempty_set, ring &chap7::CommutativeRing<A>, p \polynomial_carrier<A, ring.zero>, x A):
    \polynomial_eval<A, ring>(p, x) = ring.zero

template<A nonempty_set, ring &chap7::CommutativeRing<A>>:
    have fn polynomial_roots(p \polynomial_carrier<A, ring.zero>) power_set(A) = {x A: $is_polynomial_root(A, ring, p, x)}

# The source's `natDegree_mul` requires nonzero factors and no zero divisors.
# Its finite-support maximum proof remains localized proof debt.
thm polynomial_nat_degree_mul:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, p, q \polynomial_carrier<A, ring.zero>:
        $has_no_zero_divisors(A, ring.zero, ring.mul)
        p != \polynomial_C<A, ring>(ring.zero)
        q != \polynomial_C<A, ring>(ring.zero)
        =>:
            \polynomial_nat_degree<A, ring>(\polynomial_mul<A, ring>(p, q)) = \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)
    trust \polynomial_nat_degree<A, ring>(\polynomial_mul<A, ring>(p, q)) = \polynomial_nat_degree<A, ring>(p) + \polynomial_nat_degree<A, ring>(q)

thm polynomial_X_sub_C_eval:
    ? forall A nonempty_set, ring &chap7::CommutativeRing<A>, r A:
        \polynomial_eval<A, ring>(\polynomial_add<A, ring>(\polynomial_X<A, ring>, \polynomial_C<A, ring>(ring.neg(r))), r) = ring.zero
    have px \polynomial_carrier<A, ring.zero> = \polynomial_X<A, ring>
    have pc \polynomial_carrier<A, ring.zero> = \polynomial_C<A, ring>(ring.neg(r))
    have p \polynomial_carrier<A, ring.zero> = \polynomial_add<A, ring>(px, pc)
    claim:
        ? forall n N:
            p(n) = ring.add(px(n), pc(n))
        p = \polynomial_add<A, ring>(px, pc)
        by thm object_substitution(fn(index N) A, A, fn(candidate fn(index N) A) A {candidate(n)}, p, \polynomial_add<A, ring>(px, pc))
        by thm polynomial_add_apply(A, ring, px, pc, n)
        p(n) = \polynomial_add<A, ring>(px, pc)(n) = \polynomial_add_coeff<A, ring>(px, pc, n) = ring.add(px(n), pc(n))
    p $in \polynomial_carrier<A, ring.zero>
    $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    $chap2::is_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    claim:
        ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
        $chap2::is_additive_commutative_group(A, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x A:
                ring.add(x, ring.zero) = x
            by thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, x)
        by def:
            ? $is_additive_commutative_monoid(A, ring.add, ring.zero)
    by cases:
        ? \polynomial_eval<A, ring>(p, r) = ring.zero
        case ring.one = ring.zero:
            $chap7::is_commutative_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
            $chap2::is_ring(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
            by thm chap2::zero_mul_from_laws(A, ring.add, ring.zero, ring.neg, ring.mul, ring.one, \polynomial_eval<A, ring>(p, r))
            ring.mul(ring.one, \polynomial_eval<A, ring>(p, r)) = \polynomial_eval<A, ring>(p, r)
            ring.mul(ring.one, \polynomial_eval<A, ring>(p, r)) = ring.mul(ring.zero, \polynomial_eval<A, ring>(p, r)) = ring.zero
            \polynomial_eval<A, ring>(p, r) = ring.zero
        case ring.one != ring.zero:
            $is_polynomial_X(A, ring.zero, ring.one, \polynomial_X_selected<A, ring>(0))
            px = \polynomial_X_selected<A, ring>(0)
            $is_polynomial_X(A, ring.zero, ring.one, px)
            $is_polynomial_C(A, ring.zero, ring.neg(r), \polynomial_C<A, ring>(ring.neg(r)))
            pc = \polynomial_C<A, ring>(ring.neg(r))
            $is_polynomial_C(A, ring.zero, ring.neg(r), pc)
            px(0) = ring.zero
            pc(0) = ring.neg(r)
            p(0) = ring.add(px(0), pc(0)) = ring.add(ring.zero, ring.neg(r)) = ring.neg(r)
            px(1) = ring.one
            pc(1) = ring.zero
            by thm chap2::add_zero_from_laws(A, ring.add, ring.zero, ring.neg, ring.one)
            p(1) = ring.add(px(1), pc(1)) = ring.add(ring.one, ring.zero) = ring.one
            1 $in \polynomial_nonzero_support<A, ring>(p)
            claim:
                ? \polynomial_nonzero_support<A, ring>(p) $subset {0, 1}
                claim:
                    ? forall n \polynomial_nonzero_support<A, ring>(p):
                        n $in {0, 1}
                    p(n) != ring.zero
                    by cases:
                        ? n $in {0, 1}
                        case n = 0:
                            n $in {0, 1}
                        case n != 0:
                            by cases:
                                ? n $in {0, 1}
                                case n = 1:
                                    n $in {0, 1}
                                case n != 1:
                                    px(n) = ring.zero
                                    pc(n) = ring.zero
                                    p(n) = ring.add(px(n), pc(n)) = ring.add(ring.zero, ring.zero) = ring.zero
                                    impossible p(n) = ring.zero
                by def:
                    ? \polynomial_nonzero_support<A, ring>(p) $subset {0, 1}
            claim:
                ? union({0}, \polynomial_nonzero_support_finite<A, ring, p>) $subset {0, 1}
                claim:
                    ? forall n union({0}, \polynomial_nonzero_support_finite<A, ring, p>):
                        n $in {0, 1}
                    by cases:
                        ? n $in {0, 1}
                        case n $in {0}:
                            n = 0
                            n $in {0, 1}
                        case n $in \polynomial_nonzero_support_finite<A, ring, p>:
                            n $in \polynomial_nonzero_support<A, ring>(p)
                            n $in {0, 1}
                by def:
                    ? union({0}, \polynomial_nonzero_support_finite<A, ring, p>) $subset {0, 1}
            1 $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
            have bound N = \polynomial_eval_bound<A, ring>(p)
            by thm polynomial_eval_bound_member(A, ring, p)
            bound $in union({0}, \polynomial_nonzero_support_finite<A, ring, p>)
            bound $in {0, 1}
            by thm polynomial_eval_bound_dominates(A, ring, p, 1)
            bound >= 1
            bound = 0 or bound = 1
            by cases:
                ? bound = 1
                case bound = 0:
                    0 >= 1
                    impossible 0 >= 1
                case bound = 1:
                    bound = 1
            \polynomial_eval_bound<A, ring>(p) = bound = 1
            \polynomial_scalar_pow<A, ring>(r, 0) = ring.one
            \polynomial_scalar_pow<A, ring>(r, 1) = ring.mul(\polynomial_scalar_pow<A, ring>(r, 0), r) = ring.mul(ring.one, r) = r
            have fn term(n N) A = ring.mul(p(n), \polynomial_scalar_pow<A, ring>(r, n))
            term(0) = ring.mul(p(0), \polynomial_scalar_pow<A, ring>(r, 0)) = ring.mul(ring.neg(r), ring.one) = ring.neg(r)
            term(1) = ring.mul(p(1), \polynomial_scalar_pow<A, ring>(r, 1)) = ring.mul(ring.one, r) = r
            by thm finite_range_sum_zero(A, ring.add, ring.zero, term)
            by thm finite_range_sum_succ(A, ring.add, ring.zero, term, 0)
            by thm finite_range_sum_succ(A, ring.add, ring.zero, term, 1)
            \finite_range_sum<A, ring.add, ring.zero>(term, 0) = ring.zero
            \finite_range_sum<A, ring.add, ring.zero>(term, 1) = ring.add(\finite_range_sum<A, ring.add, ring.zero>(term, 0), term(0)) = ring.add(ring.zero, ring.neg(r)) = ring.neg(r)
            \finite_range_sum<A, ring.add, ring.zero>(term, 2) = ring.add(\finite_range_sum<A, ring.add, ring.zero>(term, 1), term(1)) = ring.add(ring.neg(r), r) = ring.zero
            \polynomial_eval<A, ring>(p, r) = \finite_range_sum<A, ring.add, ring.zero>(term, \polynomial_eval_bound<A, ring>(p) + 1) = \finite_range_sum<A, ring.add, ring.zero>(term, 2) = ring.zero
    by thm object_substitution(\polynomial_carrier<A, ring.zero>, A, fn(candidate \polynomial_carrier<A, ring.zero>) A {\polynomial_eval<A, ring>(candidate, r)}, p, \polynomial_add<A, ring>(px, pc))
    \polynomial_eval<A, ring>(\polynomial_add<A, ring>(\polynomial_X<A, ring>, \polynomial_C<A, ring>(ring.neg(r))), r) = \polynomial_eval<A, ring>(\polynomial_add<A, ring>(px, pc), r) = \polynomial_eval<A, ring>(p, r) = ring.zero
