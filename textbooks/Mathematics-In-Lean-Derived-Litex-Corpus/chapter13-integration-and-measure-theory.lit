# Chapter 13 — Integration and Measure Theory
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter keeps the mathematical interfaces that can presently be defined
# without postulating selected analytic objects. Interval and Bochner
# integrals, extended nonnegative reals, product measures, and their major
# theorems remain source-visible proof debt in todo.lit.

# ---------------------------------------------------------------------------
# Section 13.1 — Elementary Analytic Vocabulary
# ---------------------------------------------------------------------------

# The unoriented segment between a and b. The product criterion is symmetric
# in the endpoints and avoids separate min and max operations.
have fn real_closed_segment(a, b R) power_set(R) = {x R: (x - a) * (x - b) <= 0}

prop real_continuity_control(f fn(x R) R, x R, epsilon, delta R+):
    forall y R:
        abs(y - x) < delta
        =>:
            abs(f(y) - f(x)) < epsilon

prop is_continuous_real_function(f fn(x R) R):
    forall x R, epsilon R+:
        exist delta R+ st {$real_continuity_control(f, x, epsilon, delta)}

prop real_derivative_control(f fn(x R) R, x, L R, epsilon, delta R+):
    forall y R:
        y != x
        abs(y - x) < delta
        =>:
            abs((f(y) - f(x)) / (y - x) - L) < epsilon

prop has_real_derivative_at(f fn(x R) R, x, L R):
    forall epsilon R+:
        exist delta R+ st {$real_derivative_control(f, x, L, epsilon, delta)}

prop has_derivative_on_segment(f, fprime fn(x R) R, a, b R):
    forall x real_closed_segment(a, b):
        $has_real_derivative_at(f, x, fprime(x))

# ---------------------------------------------------------------------------
# Section 13.2 — Measurable Spaces
# ---------------------------------------------------------------------------

prop _member_of_countable_union(X set, A fn(n N) power_set(X), x X):
    exist n N st {x $in A(n)}

prop _member_of_countable_intersection(X set, A fn(n N) power_set(X), x X):
    forall n N:
        x $in A(n)

template<X set>:
    have fn countable_union(A fn(n N) power_set(X)) power_set(X) = {x X: $_member_of_countable_union(X, A, x)}

template<X set>:
    have fn countable_intersection(A fn(n N) power_set(X)) power_set(X) = {x X: $_member_of_countable_intersection(X, A, x)}

# Construction-only closure relation for a raw candidate family.
prop measurable_sequence_in_candidate(X set, M power_set(power_set(X)), A fn(n N) power_set(X)):
    forall n N:
        A(n) $in M

# A measurable space is represented by its sigma-algebra of measurable sets.
prop is_measurable_space_on(X set, M power_set(power_set(X))):
    {} $in M
    forall S M:
        set_minus(X, S) $in M
    forall A fn(n N) power_set(X):
        $measurable_sequence_in_candidate(X, M, A)
        =>:
            {x X: $_member_of_countable_union(X, A, x)} $in M

template<X set>:
    have MeasurableSpace set = {M power_set(power_set(X)): $is_measurable_space_on(X, M)}

thm measurable_space_member_is_measurable_space:
    ? forall X set, M \MeasurableSpace<X>:
        $is_measurable_space_on(X, M)
    M $in \MeasurableSpace<X>
    \MeasurableSpace<X> = {candidate power_set(power_set(X)): $is_measurable_space_on(X, candidate)}
    M $in {candidate power_set(power_set(X)): $is_measurable_space_on(X, candidate)}

prop is_measurable_sequence(X set, M \MeasurableSpace<X>, A fn(n N) power_set(X)):
    forall n N:
        A(n) $in M

prop is_measurable_set(X set, M \MeasurableSpace<X>, S power_set(X)):
    S $in M

thm measurable_empty:
    ? forall X set, M \MeasurableSpace<X>:
        $is_measurable_set(X, M, {})
    by thm measurable_space_member_is_measurable_space(X, M)
    {} $in M
    by def:
        ? $is_measurable_set(X, M, {})

thm measurable_universe:
    ? forall X set, M \MeasurableSpace<X>:
        $is_measurable_set(X, M, X)
    by thm measurable_space_member_is_measurable_space(X, M)
    by extension:
        ? set_minus(X, {}) = X
        claim:
            ? forall x set_minus(X, {}):
                x $in X
        claim:
            ? forall x X:
                x $in set_minus(X, {})
            not x $in {}
    set_minus(X, {}) $in M
    X $in M
    by def:
        ? $is_measurable_set(X, M, X)

thm measurable_complement:
    ? forall X set, M \MeasurableSpace<X>, S power_set(X):
        $is_measurable_set(X, M, S)
        =>:
            $is_measurable_set(X, M, set_minus(X, S))
    by thm measurable_space_member_is_measurable_space(X, M)
    by def:
        ? $is_measurable_set(X, M, set_minus(X, S))

# The closure theorems keep the membership set builders visible for their
# elementwise proofs; the named symbolic countable-set templates also unfold.
thm measurable_countable_union:
    ? forall X set, M \MeasurableSpace<X>, A fn(n N) power_set(X):
        $is_measurable_sequence(X, M, A)
        =>:
            $is_measurable_set(X, M, {x X: $_member_of_countable_union(X, A, x)})
    by thm measurable_space_member_is_measurable_space(X, M)
    by def:
        ? $measurable_sequence_in_candidate(X, M, A)
    {x X: $_member_of_countable_union(X, A, x)} $in M
    by def:
        ? $is_measurable_set(X, M, {x X: $_member_of_countable_union(X, A, x)})

thm measurable_countable_intersection:
    ? forall X set, M \MeasurableSpace<X>, A fn(n N) power_set(X):
        $is_measurable_sequence(X, M, A)
        =>:
            $is_measurable_set(X, M, {x X: $_member_of_countable_intersection(X, A, x)})
    by thm measurable_space_member_is_measurable_space(X, M)
    by def:
        ? $measurable_sequence_in_candidate(X, M, A)
    claim:
        ? $is_measurable_sequence(X, M, fn(k N) power_set(X) {{y X: not y $in A(k)}})
        claim:
            ? forall n N:
                (fn(k N) power_set(X) {{y X: not y $in A(k)}})(n) $in M
            A(n) $in power_set(X)
            A(n) $in M
            set_minus(X, A(n)) $in M
            claim:
                ? {y X: not y $in A(n)} = set_minus(X, A(n))
                by extension:
                    ? {y X: not y $in A(n)} = set_minus(X, A(n))
                    claim forall y {q X: not q $in A(n)} => {y $in set_minus(X, A(n))}:
                        y $in X
                        not y $in A(n)
                        y $in set_minus(X, A(n))
                    claim forall y set_minus(X, A(n)) => {y $in {q X: not q $in A(n)}}:
                        not y $in A(n)
                        by thm set_builder_member(y, {q X: not q $in A(n)})
            {y X: not y $in A(n)} $in M
            (fn(k N) power_set(X) {{y X: not y $in A(k)}})(n) = {y X: not y $in A(n)}
        by def:
            ? $is_measurable_sequence(X, M, fn(k N) power_set(X) {{y X: not y $in A(k)}})
    by def:
        ? $measurable_sequence_in_candidate(X, M, fn(k N) power_set(X) {{y X: not y $in A(k)}})
    {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)} $in M
    set_minus(X, {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}) $in M
    by extension:
        ? {x X: $_member_of_countable_intersection(X, A, x)} = set_minus(X, {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)})
        claim:
            ? forall x1 {x X: $_member_of_countable_intersection(X, A, x)}:
                x1 $in set_minus(X, {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)})
            by def:
                ? $_member_of_countable_intersection(X, A, x1)
            x1 $in A(0)
            x1 $in X
            claim:
                ? not x1 $in {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}
                by contra:
                    ? not x1 $in {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}
                    x1 $in {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}
                    obtain n from exist n N st {x1 $in (fn(k N) power_set(X) {{y X: not y $in A(k)}})(n)}
                    (fn(k N) power_set(X) {{y X: not y $in A(k)}})(n) = {y X: not y $in A(n)}
                    x1 $in {y X: not y $in A(n)}
                    not x1 $in A(n)
                    x1 $in A(n)
                    impossible not x1 $in A(n)
        claim:
            ? forall x1 set_minus(X, {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}):
                x1 $in {x X: $_member_of_countable_intersection(X, A, x)}
            not x1 $in {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}
            claim:
                ? forall n N:
                    x1 $in A(n)
                by contra:
                    ? x1 $in A(n)
                    x1 $in X
                    A(n) $in power_set(X)
                    by thm set_builder_member(x1, {y X: not y $in A(n)})
                    (fn(k N) power_set(X) {{y X: not y $in A(k)}})(n) = {y X: not y $in A(n)}
                    x1 $in (fn(k N) power_set(X) {{y X: not y $in A(k)}})(n)
                    witness exist j N st {x1 $in (fn(k N) power_set(X) {{y X: not y $in A(k)}})(j)} from n
                    by def:
                        ? $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x1)
                    by thm set_builder_member(x1, {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)})
                    impossible not x1 $in {x X: $_member_of_countable_union(X, fn(k N) power_set(X) {{y X: not y $in A(k)}}, x)}
            by def:
                ? $_member_of_countable_intersection(X, A, x1)
            by thm set_builder_member(x1, {x X: $_member_of_countable_intersection(X, A, x)})
    {x X: $_member_of_countable_intersection(X, A, x)} $in M
    by def:
        ? $is_measurable_set(X, M, {x X: $_member_of_countable_intersection(X, A, x)})

# ---------------------------------------------------------------------------
# Section 13.3 — Countably Additive Measure Candidates
# ---------------------------------------------------------------------------

prop pairwise_disjoint_sequence(X set, A fn(n N) power_set(X)):
    forall idx, j N:
        idx != j
        =>:
            intersect(A(idx), A(j)) = {}

template<X, V set, mu fn(Tset power_set(X)) V, A fn(n N) power_set(X)>:
    have fn measured_sequence(n N) V = mu(A(n))

# The value carrier and its infinite-sum operation are explicit parameters.
# This keeps the measure law usable without pretending that ENNReal has already
# been constructed in Litex.
prop is_countably_additive_set_function_on(X, V set, M \MeasurableSpace<X>, zero V, infinite_sum fn(a fn(n N) V) V, mu fn(Tset power_set(X)) V):
    mu({}) = zero
    forall A fn(n N) power_set(X):
        $is_measurable_sequence(X, M, A)
        $pairwise_disjoint_sequence(X, A)
        =>:
            mu({x X: $_member_of_countable_union(X, A, x)}) = infinite_sum(\measured_sequence<X, V, mu, A>)

thm countably_additive_set_function_disjoint_union:
    ? forall X, V set, M \MeasurableSpace<X>, zero V, infinite_sum fn(a fn(n N) V) V, mu fn(Tset power_set(X)) V, A fn(n N) power_set(X):
        $is_countably_additive_set_function_on(X, V, M, zero, infinite_sum, mu)
        $is_measurable_sequence(X, M, A)
        $pairwise_disjoint_sequence(X, A)
        =>:
            mu({x X: $_member_of_countable_union(X, A, x)}) = infinite_sum(\measured_sequence<X, V, mu, A>)

# Almost-everywhere truth is represented by a measurable zero-valued
# exceptional set.
prop holds_almost_everywhere(X, V set, M \MeasurableSpace<X>, zero V, mu fn(Tset power_set(X)) V, P power_set(X)):
    exist Nset power_set(X) st {Nset $in M, mu(Nset) = zero, set_minus(X, Nset) $subset P}

template<X, V set, M \MeasurableSpace<X>, zero V, mu fn(Tset power_set(X)) V>:
    have ae_large_sets power_set(power_set(X)) = {P power_set(X): $holds_almost_everywhere(X, V, M, zero, mu, P)}

thm ae_large_sets_member:
    ? forall X, V set, M \MeasurableSpace<X>, zero V, mu fn(Tset power_set(X)) V, P power_set(X):
        $holds_almost_everywhere(X, V, M, zero, mu, P)
        =>:
            P $in \ae_large_sets<X, V, M, zero, mu>
    by thm set_builder_member(P, {candidate power_set(X): $holds_almost_everywhere(X, V, M, zero, mu, candidate)})
    \ae_large_sets<X, V, M, zero, mu> = {candidate power_set(X): $holds_almost_everywhere(X, V, M, zero, mu, candidate)}

thm ae_large_sets_holds:
    ? forall X, V set, M \MeasurableSpace<X>, zero V, mu fn(Tset power_set(X)) V, P \ae_large_sets<X, V, M, zero, mu>:
        $holds_almost_everywhere(X, V, M, zero, mu, P)
    P $in \ae_large_sets<X, V, M, zero, mu>
    \ae_large_sets<X, V, M, zero, mu> = {candidate power_set(X): $holds_almost_everywhere(X, V, M, zero, mu, candidate)}
    P $in {candidate power_set(X): $holds_almost_everywhere(X, V, M, zero, mu, candidate)}

prop eventually_in_filter(X set, F power_set(power_set(X)), P power_set(X)):
    P $in F

thm eventually_in_filter_member:
    ? forall X set, F power_set(power_set(X)), P power_set(X):
        $eventually_in_filter(X, F, P)
        =>:
            P $in F

prop almost_everywhere_eventually_equivalence(X, V set, M \MeasurableSpace<X>, zero V, mu fn(Tset power_set(X)) V, P power_set(X)):
    not $holds_almost_everywhere(X, V, M, zero, mu, P) or $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
    not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P) or $holds_almost_everywhere(X, V, M, zero, mu, P)

# MIL low-prerequisite C13 S02: the source's almost-everywhere notation is
# definitionally eventual truth in the ae family.
thm almost_everywhere_iff_eventually:
    ? forall X, V set, M \MeasurableSpace<X>, zero V, mu fn(Tset power_set(X)) V, P power_set(X):
        $almost_everywhere_eventually_equivalence(X, V, M, zero, mu, P)
    claim:
        ? not $holds_almost_everywhere(X, V, M, zero, mu, P) or $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
        $holds_almost_everywhere(X, V, M, zero, mu, P) or not $holds_almost_everywhere(X, V, M, zero, mu, P)
        by cases:
            ? not $holds_almost_everywhere(X, V, M, zero, mu, P) or $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
            case $holds_almost_everywhere(X, V, M, zero, mu, P):
                by thm ae_large_sets_member(X, V, M, zero, mu, P)
                by def:
                    ? $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
                not $holds_almost_everywhere(X, V, M, zero, mu, P) or $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
            case not $holds_almost_everywhere(X, V, M, zero, mu, P):
                not $holds_almost_everywhere(X, V, M, zero, mu, P) or $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
    claim:
        ? not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P) or $holds_almost_everywhere(X, V, M, zero, mu, P)
        $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P) or not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P)
        by cases:
            ? not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P) or $holds_almost_everywhere(X, V, M, zero, mu, P)
            case $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P):
                by thm eventually_in_filter_member(X, \ae_large_sets<X, V, M, zero, mu>, P)
                by thm ae_large_sets_holds(X, V, M, zero, mu, P)
                not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P) or $holds_almost_everywhere(X, V, M, zero, mu, P)
            case not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P):
                not $eventually_in_filter(X, \ae_large_sets<X, V, M, zero, mu>, P) or $holds_almost_everywhere(X, V, M, zero, mu, P)
    by def:
        ? $almost_everywhere_eventually_equivalence(X, V, M, zero, mu, P)

