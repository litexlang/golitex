# Resumed MIL C13 S01 source slice
# ---------------------------------------------------------------------------

# Source-library objects needed by the elementary integration examples.
# proof_debt: construct oriented interval integration, whole-line integration,
# logarithm, and total reciprocal from the real-analysis library.
trust have oriented_interval_integral fn(integrand fn(argument R) R, left, right R) R
trust have whole_real_integral fn(integrand fn(argument R) R) R
trust have real_log fn(x R) R
trust have real_reciprocal fn(x R) R

prop is_interval_integrable(f fn(x R) R, a, b R)

have fn real_convolution(f, g fn(argument R) R, x R) R = whole_real_integral(fn(t R) R {f(t) * g(x - t)})

# MIL30 ITEM 26 — oriented interval integral of the identity.
# proof_debt: construction of the interval integral and the antiderivative
# calculation.
thm oriented_interval_integral_identity:
    ? forall a, b R:
        oriented_interval_integral(fn(x R) R {x}, a, b) = (b^2 - a^2) / 2
    trust oriented_interval_integral(fn(x R) R {x}, a, b) = (b^2 - a^2) / 2

# MIL30 ITEM 27 — oriented interval integral of the reciprocal.
# proof_debt: reciprocal/logarithm derivative and the no-zero interval
# argument.
thm oriented_interval_integral_reciprocal:
    ? forall a, b R:
        not 0 $in real_closed_segment(a, b)
        a != 0
        =>:
            oriented_interval_integral(real_reciprocal, a, b) = real_log(b / a)
    trust oriented_interval_integral(real_reciprocal, a, b) = real_log(b / a)

# MIL30 ITEM 28 — first fundamental theorem of calculus.
# proof_debt: continuity implies interval integrability and differentiation of
# the variable-upper-endpoint integral.
thm fundamental_theorem_of_calculus_first:
    ? forall f fn(x R) R, a, b R:
        $is_continuous_real_function(f)
        =>:
            chap12::real_deriv(fn(u R) R {oriented_interval_integral(f, a, u)}, b) = f(b)
    trust chap12::real_deriv(fn(u R) R {oriented_interval_integral(f, a, u)}, b) = f(b)

# MIL30 ITEM 29 — second fundamental theorem of calculus.
# proof_debt: oriented interval integral foundation and endpoint bookkeeping.
thm fundamental_theorem_of_calculus_second:
    ? forall f, fprime fn(x R) R, a, b R:
        $has_derivative_on_segment(f, fprime, a, b)
        $is_interval_integrable(fprime, a, b)
        =>:
            oriented_interval_integral(fprime, a, b) = f(b) - f(a)
    trust oriented_interval_integral(fprime, a, b) = f(b) - f(a)

# MIL30 ITEM 30 — real convolution is the whole-line integral of translated
# products.
thm real_convolution_formula:
    ? forall f, g fn(argument R) R, x R:
        real_convolution(f, g, x) = whole_real_integral(fn(t R) R {f(t) * g(x - t)})
