# Chapter 6 — Discrete Mathematics
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/blocked status.

# Only source definitions, principal mathematical results, and the constructors
# needed to use them are retained. Repeated tactic presentations are collapsed.

# 6.1 Finsets and Fintypes

# Source definition: example1. A finite set is unordered and has no duplicate
# elements; later source spelling variants are presentation examples only.
have finite_set_example finite_set = {0, 1, 2}

# Source definition: f. The source function is integer-valued and remains
# callable instead of being replaced by a predicate about squares.
have fn square_int(n N) Z = n^2

# The source identifies cardinality with a sum of ones. This is checked by the
# finite constant-sum rule.
thm finite_set_card_as_sum_ones:
    ? forall A finite_set:
        finite_set_size(A) = finite_set_sum(A, fn(x A) N {1})
    finite_set_sum(A, fn(x A) N {1}) = finite_set_size(A) * 1 = finite_set_size(A)

# Source finite-set induction example.
# Proof debt: the direct real-context probe leaves positivity of a symbolic
# finite-set product unknown; Litex does not yet expose finite-set induction
# for this aggregate.
thm finite_product_ne_zero:
    ? forall A finite_set, f fn(x A) N:
        forall x A:
            f(x) != 0
        =>:
            finite_set_product(A, f) != 0
    trust finite_set_product(A, f) != 0

# 6.2 Counting Arguments

# The first counting formulas are direct finite-set cardinality laws.
thm card_cartesian_product:
    ? forall A, B finite_set:
        finite_set_size(cart(A, B)) = finite_set_size(A) * finite_set_size(B)
    finite_set_size(cart(A, B)) = finite_set_size(A) * finite_set_size(B)

thm card_union_inclusion_exclusion:
    ? forall A, B finite_set:
        finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B))
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B))

# Disjointness is a relation between two candidate sets, so this is correctly a
# prop. The following named result is a fact, not another proposition wrapper.
prop disjoint_sets(A, B set):
    intersect(A, B) = {}

thm card_union_of_disjoint:
    ? forall A, B finite_set:
        $disjoint_sets(A, B)
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    intersect(A, B) = {}
    finite_set_size(intersect(A, B)) = finite_set_size({}) = 0
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B)) = finite_set_size(A) + finite_set_size(B)

# Source definition: triangle. Delete pairs whose first coordinate is at least
# their second from the finite Cartesian square. The dependent codomain keeps
# triangle callable and records its exact finite ambient carrier.
have fn triangle(n N) power_set(cart(range(0, n + 1), range(0, n + 1))) = set_minus(cart(range(0, n + 1), range(0, n + 1)), {p cart(range(0, n + 1), range(0, n + 1)): p[1] >= p[2]})

thm triangle_is_finite:
    ? forall n N:
        $is_finite_set(triangle(n))
    triangle(n) $in power_set(cart(range(0, n + 1), range(0, n + 1)))
    triangle(n) $subset cart(range(0, n + 1), range(0, n + 1))
    $is_finite_set(cart(range(0, n + 1), range(0, n + 1)))
    triangle(n) = set_minus(cart(range(0, n + 1), range(0, n + 1)), set_minus(cart(range(0, n + 1), range(0, n + 1)), triangle(n)))
    $is_finite_set(set_minus(cart(range(0, n + 1), range(0, n + 1)), set_minus(cart(range(0, n + 1), range(0, n + 1)), triangle(n))))
    $is_finite_set(triangle(n))

# Source triangle-cardinality family.  Its three source proofs share this one
# mathematical statement.
# Proof debt: the missing step is a finite disjoint-fiber decomposition of the
# strict upper triangle.
thm triangle_card:
    ? forall n N:
        finite_set_size(triangle(n)) = (n + 1) * n / 2
    trust finite_set_size(triangle(n)) = (n + 1) * n / 2

# Source theorem: doubleCounting.  A zero-one incidence function is the
# Litex-native representation of the finite relation; its row and column sums
# are the source fiber cardinalities.
# Proof debt: exchange the two finite sums and apply the row/column bounds.
thm double_counting:
    ? forall A, B finite_set, incidence fn(a A, b B) N:
        forall a A, b B:
            incidence(a, b) = 0 or incidence(a, b) = 1
        forall a A:
            finite_set_sum(B, fn(b B) N {incidence(a, b)}) >= 3
        forall b B:
            finite_set_sum(A, fn(a A) N {incidence(a, b)}) <= 1
        =>:
            3 * finite_set_size(A) <= finite_set_size(B)
    trust 3 * finite_set_size(A) <= finite_set_size(B)

# 6.3 Inductive Structures

# Litex does not yet declare user-defined inductive carrier families. The
# reusable interface therefore keeps the element carrier A and the list carrier
# L explicit. ListCore packages the callable constructors and their structural
# induction principle; no nullary prop is used as a fake list object.
struct ListCore<A set, L nonempty_set>:
    nil L
    cons fn(a A, xs L) L
    <=>:
        forall P power_set(L):
            nil $in P
            forall a A, xs L:
                xs $in P
                =>:
                    cons(a, xs) $in P
            =>:
                P = L

# Source definition: append. is_list_append is a property of a candidate
# callable function; list_append is the corresponding selected function.
prop is_list_append(A set, L nonempty_set, core &ListCore<A, L>, append fn(xs, ys L) L):
    forall ys L:
        append(&ListCore<A, L>{core}.nil, ys) = ys
    forall a A, xs, ys L:
        append(&ListCore<A, L>{core}.cons(a, xs), ys) = &ListCore<A, L>{core}.cons(a, append(xs, ys))

# Source definition: map. Its domain and codomain list carriers remain
# independent, exactly as in List.map.
prop is_list_map(A, B set, L_A, L_B nonempty_set, core_A &ListCore<A, L_A>, core_B &ListCore<B, L_B>, f fn(x A) B, map_fn fn(xs L_A) L_B):
    map_fn(&ListCore<A, L_A>{core_A}.nil) = &ListCore<B, L_B>{core_B}.nil
    forall a A, xs L_A:
        map_fn(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<B, L_B>{core_B}.cons(f(a), map_fn(xs))

# Source callable selections for append and map.
# Proof debt: ListCore exposes structural induction but Litex has no generic
# recursor that constructs these two functions, so selection and the exact
# recursion specifications remain trusted.
template<A set, L nonempty_set, core &ListCore<A, L>>:
    trust have list_append fn(xs, ys L) L

trust forall A set, L nonempty_set, core &ListCore<A, L>:
    $is_list_append(A, L, core, \list_append<A, L, core>)

template<A, B set, L_A, L_B nonempty_set, core_A &ListCore<A, L_A>, core_B &ListCore<B, L_B>, f fn(x A) B>:
    trust have list_map fn(xs L_A) L_B

trust forall A, B set, L_A, L_B nonempty_set, core_A &ListCore<A, L_A>, core_B &ListCore<B, L_B>, f fn(x A) B:
    $is_list_map(A, B, L_A, L_B, core_A, core_B, f, \list_map<A, B, L_A, L_B, core_A, core_B, f>)

# Source theorem: append_nil. Structural induction uses the nil equation as the
# base case and the cons equation to transport the induction hypothesis.
thm list_append_nil:
    ? forall A set, L nonempty_set, core &ListCore<A, L>, append fn(x, y L) L, target L:
        $is_list_append(A, L, core, append)
        =>:
            append(target, &ListCore<A, L>{core}.nil) = target
    by def $is_list_append(A, L, core, append)
    have P power_set(L) = {z L: append(z, &ListCore<A, L>{core}.nil) = z}
    append(&ListCore<A, L>{core}.nil, &ListCore<A, L>{core}.nil) = &ListCore<A, L>{core}.nil
    by thm set_builder_member(&ListCore<A, L>{core}.nil, {z L: append(z, &ListCore<A, L>{core}.nil) = z})
    &ListCore<A, L>{core}.nil $in {z L: append(z, &ListCore<A, L>{core}.nil) = z}
    &ListCore<A, L>{core}.nil $in P
    claim:
        ? forall a A, xs L:
            xs $in P
            =>:
                &ListCore<A, L>{core}.cons(a, xs) $in P
        append(&ListCore<A, L>{core}.cons(a, xs), &ListCore<A, L>{core}.nil) = &ListCore<A, L>{core}.cons(a, append(xs, &ListCore<A, L>{core}.nil))
        append(&ListCore<A, L>{core}.cons(a, xs), &ListCore<A, L>{core}.nil) = &ListCore<A, L>{core}.cons(a, xs)
        by thm set_builder_member(&ListCore<A, L>{core}.cons(a, xs), {z L: append(z, &ListCore<A, L>{core}.nil) = z})
        &ListCore<A, L>{core}.cons(a, xs) $in {z L: append(z, &ListCore<A, L>{core}.nil) = z}
        &ListCore<A, L>{core}.cons(a, xs) $in P
    P = L
    target $in P
    target $in {z L: append(z, &ListCore<A, L>{core}.nil) = z}

# Source theorem: map_map. Structural induction compares the three map
# specifications; the cons case composes g(f(a)) and reuses the tail result.
thm list_map_map:
    ? forall A, B, CarrierC set, L_A, L_B, L_C nonempty_set, core_A &ListCore<A, L_A>, core_B &ListCore<B, L_B>, core_C &ListCore<CarrierC, L_C>, f fn(x A) B, g fn(y B) CarrierC, map_f fn(xs L_A) L_B, map_g fn(ys L_B) L_C, map_gf fn(xs L_A) L_C, target L_A:
        $is_list_map(A, B, L_A, L_B, core_A, core_B, f, map_f)
        $is_list_map(B, CarrierC, L_B, L_C, core_B, core_C, g, map_g)
        $is_list_map(A, CarrierC, L_A, L_C, core_A, core_C, fn(x A) CarrierC {g(f(x))}, map_gf)
        =>:
            map_g(map_f(target)) = map_gf(target)
    by def $is_list_map(A, B, L_A, L_B, core_A, core_B, f, map_f)
    by def $is_list_map(B, CarrierC, L_B, L_C, core_B, core_C, g, map_g)
    by def $is_list_map(A, CarrierC, L_A, L_C, core_A, core_C, fn(x A) CarrierC {g(f(x))}, map_gf)
    have P power_set(L_A) = {z L_A: map_g(map_f(z)) = map_gf(z)}
    map_f(&ListCore<A, L_A>{core_A}.nil) = &ListCore<B, L_B>{core_B}.nil
    map_g(&ListCore<B, L_B>{core_B}.nil) = &ListCore<CarrierC, L_C>{core_C}.nil
    map_gf(&ListCore<A, L_A>{core_A}.nil) = &ListCore<CarrierC, L_C>{core_C}.nil
    map_g(map_f(&ListCore<A, L_A>{core_A}.nil)) = map_g(&ListCore<B, L_B>{core_B}.nil) = &ListCore<CarrierC, L_C>{core_C}.nil = map_gf(&ListCore<A, L_A>{core_A}.nil)
    by thm set_builder_member(&ListCore<A, L_A>{core_A}.nil, {z L_A: map_g(map_f(z)) = map_gf(z)})
    &ListCore<A, L_A>{core_A}.nil $in {z L_A: map_g(map_f(z)) = map_gf(z)}
    &ListCore<A, L_A>{core_A}.nil $in P
    claim:
        ? forall a A, xs L_A:
            xs $in P
            =>:
                &ListCore<A, L_A>{core_A}.cons(a, xs) $in P
        map_f(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<B, L_B>{core_B}.cons(f(a), map_f(xs))
        map_g(map_f(&ListCore<A, L_A>{core_A}.cons(a, xs))) = map_g(&ListCore<B, L_B>{core_B}.cons(f(a), map_f(xs)))
        map_g(&ListCore<B, L_B>{core_B}.cons(f(a), map_f(xs))) = &ListCore<CarrierC, L_C>{core_C}.cons(g(f(a)), map_g(map_f(xs)))
        map_g(map_f(&ListCore<A, L_A>{core_A}.cons(a, xs))) = &ListCore<CarrierC, L_C>{core_C}.cons(g(f(a)), map_g(map_f(xs)))
        map_gf(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<CarrierC, L_C>{core_C}.cons((fn(x A) CarrierC {g(f(x))})(a), map_gf(xs))
        (fn(x A) CarrierC {g(f(x))})(a) = g(f(a))
        map_gf(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<CarrierC, L_C>{core_C}.cons(g(f(a)), map_gf(xs))
        map_g(map_f(&ListCore<A, L_A>{core_A}.cons(a, xs))) = map_gf(&ListCore<A, L_A>{core_A}.cons(a, xs))
        by thm set_builder_member(&ListCore<A, L_A>{core_A}.cons(a, xs), {z L_A: map_g(map_f(z)) = map_gf(z)})
        &ListCore<A, L_A>{core_A}.cons(a, xs) $in {z L_A: map_g(map_f(z)) = map_gf(z)}
        &ListCore<A, L_A>{core_A}.cons(a, xs) $in P
    P = L_A
    target $in P
    target $in {z L_A: map_g(map_f(z)) = map_gf(z)}

# Source definition: reverse, with its defining equations.
# Proof debt: the selected structural recursion and the two induction theorems
# depend on the missing generic list recursor.
template<A set, L nonempty_set, core &ListCore<A, L>>:
    trust have list_reverse fn(xs L) L

trust forall A set, L nonempty_set, core &ListCore<A, L>:
    \list_reverse<A, L, core>(&ListCore<A, L>{core}.nil) = &ListCore<A, L>{core}.nil

trust forall A set, L nonempty_set, core &ListCore<A, L>, a A, xs L:
    \list_reverse<A, L, core>(&ListCore<A, L>{core}.cons(a, xs)) = \list_append<A, L, core>(\list_reverse<A, L, core>(xs), &ListCore<A, L>{core}.cons(a, &ListCore<A, L>{core}.nil))

thm list_reverse_append:
    ? forall A set, L nonempty_set, core &ListCore<A, L>, xs, ys L:
        \list_reverse<A, L, core>(\list_append<A, L, core>(xs, ys)) = \list_append<A, L, core>(\list_reverse<A, L, core>(ys), \list_reverse<A, L, core>(xs))
    trust \list_reverse<A, L, core>(\list_append<A, L, core>(xs, ys)) = \list_append<A, L, core>(\list_reverse<A, L, core>(ys), \list_reverse<A, L, core>(xs))

thm list_reverse_reverse:
    ? forall A set, L nonempty_set, core &ListCore<A, L>, xs L:
        \list_reverse<A, L, core>(\list_reverse<A, L, core>(xs)) = xs
    trust \list_reverse<A, L, core>(\list_reverse<A, L, core>(xs)) = xs

# The source uses Nat.max in the depth recursion.
have fn nat_max(left, right N) N by cases:
    case left >= right: left
    case left < right: right

# Boolean values used by the source's formula evaluator are represented by the
# actual two-element carrier {0,1}. The formula construction itself is tracked
# in todo.lit until its recursive interface is checked.
have Boolean finite_set = {0, 1}

have fn boolean_not(value {0, 1}) {0, 1} by cases:
    case value = 0: 1
    case value = 1: 0

have fn boolean_and(left, right {0, 1}) {0, 1} by cases:
    case left = 0: 0
    case left = 1: right

have fn boolean_or(left, right {0, 1}) {0, 1} by cases:
    case left = 0: right
    case left = 1: 1

# The source's substitution proof updates one input of a Boolean valuation.
# Keep that construction callable while the surrounding formula syntax and
# evaluator remain tracked separately.
template<valuation fn(idx N) {0, 1}, idx N, bit {0, 1}>:
    have fn updated_boolean_valuation(m N) {0, 1} by cases:
        case m = idx: bit
        case m != idx: valuation(m)

# Source construction: BinTree.
# Proof debt: the independent carrier, constructors, recursor-selected
# functions, and computation equations require user-defined inductive types.
trust have BinaryTree nonempty_set
trust have binary_tree_empty BinaryTree
trust have binary_tree_node fn(left, right BinaryTree) BinaryTree
trust forall P power_set(BinaryTree):
    binary_tree_empty $in P
    forall left, right BinaryTree:
        left $in P
        right $in P
        =>:
            binary_tree_node(left, right) $in P
    =>:
        P = BinaryTree

trust have binary_tree_size fn(tree BinaryTree) N
trust binary_tree_size(binary_tree_empty) = 0
trust forall left, right BinaryTree:
    binary_tree_size(binary_tree_node(left, right)) = binary_tree_size(left) + binary_tree_size(right) + 1

trust have binary_tree_depth fn(tree BinaryTree) N
trust binary_tree_depth(binary_tree_empty) = 0
trust forall left, right BinaryTree:
    binary_tree_depth(binary_tree_node(left, right)) = finite_set_max(union({binary_tree_depth(left)}, {binary_tree_depth(right)})) + 1

trust have binary_tree_flip fn(tree BinaryTree) BinaryTree
trust binary_tree_flip(binary_tree_empty) = binary_tree_empty
trust forall left, right BinaryTree:
    binary_tree_flip(binary_tree_node(left, right)) = binary_tree_node(binary_tree_flip(right), binary_tree_flip(left))

# Source structural-induction theorem family for binary trees.
thm binary_tree_size_le:
    ? forall tree BinaryTree:
        binary_tree_size(tree) <= 2^binary_tree_depth(tree) - 1
    trust binary_tree_size(tree) <= 2^binary_tree_depth(tree) - 1

thm binary_tree_depth_le_size:
    ? forall tree BinaryTree:
        binary_tree_depth(tree) <= binary_tree_size(tree)
    trust binary_tree_depth(tree) <= binary_tree_size(tree)

thm binary_tree_size_flip:
    ? forall tree BinaryTree:
        binary_tree_size(binary_tree_flip(tree)) = binary_tree_size(tree)
    trust binary_tree_size(binary_tree_flip(tree)) = binary_tree_size(tree)

# Source construction: PropForm.
# Proof debt: the carrier, five constructors, recursor-selected functions, and
# their computation equations require user-defined inductive types.
trust have PropForm nonempty_set
trust have formula_var fn(idx N) PropForm
trust have formula_false PropForm
trust have formula_conj fn(left, right PropForm) PropForm
trust have formula_disj fn(left, right PropForm) PropForm
trust have formula_impl fn(left, right PropForm) PropForm

trust forall P power_set(PropForm):
    forall idx N:
        formula_var(idx) $in P
    formula_false $in P
    forall left, right PropForm:
        left $in P
        right $in P
        =>:
            formula_conj(left, right) $in P
            formula_disj(left, right) $in P
            formula_impl(left, right) $in P
    =>:
        P = PropForm

trust have formula_eval fn(formula PropForm, valuation fn(idx N) {0, 1}) {0, 1}
trust forall idx N, valuation fn(input N) {0, 1}:
    formula_eval(formula_var(idx), valuation) = valuation(idx)
trust forall valuation fn(input N) {0, 1}:
    formula_eval(formula_false, valuation) = 0
trust forall left, right PropForm, valuation fn(input N) {0, 1}:
    formula_eval(formula_conj(left, right), valuation) = boolean_and(formula_eval(left, valuation), formula_eval(right, valuation))
trust forall left, right PropForm, valuation fn(input N) {0, 1}:
    formula_eval(formula_disj(left, right), valuation) = boolean_or(formula_eval(left, valuation), formula_eval(right, valuation))
trust forall left, right PropForm, valuation fn(input N) {0, 1}:
    formula_eval(formula_impl(left, right), valuation) = boolean_or(boolean_not(formula_eval(left, valuation)), formula_eval(right, valuation))

trust have formula_vars fn(formula PropForm) power_set(N)
trust forall formula PropForm:
    $is_finite_set(formula_vars(formula))
trust forall idx N:
    formula_vars(formula_var(idx)) = {idx}
trust formula_vars(formula_false) = {}
trust forall left, right PropForm:
    formula_vars(formula_conj(left, right)) = union(formula_vars(left), formula_vars(right))
    formula_vars(formula_disj(left, right)) = union(formula_vars(left), formula_vars(right))
    formula_vars(formula_impl(left, right)) = union(formula_vars(left), formula_vars(right))

trust have formula_subst fn(formula PropForm, idx N, repl PropForm) PropForm
trust forall source_idx, target_idx N, repl PropForm:
    source_idx = target_idx
    =>:
        formula_subst(formula_var(source_idx), target_idx, repl) = repl
trust forall source_idx, target_idx N, repl PropForm:
    source_idx != target_idx
    =>:
        formula_subst(formula_var(source_idx), target_idx, repl) = formula_var(source_idx)
trust forall target_idx N, repl PropForm:
    formula_subst(formula_false, target_idx, repl) = formula_false
trust forall left, right PropForm, target_idx N, repl PropForm:
    formula_subst(formula_conj(left, right), target_idx, repl) = formula_conj(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))
    formula_subst(formula_disj(left, right), target_idx, repl) = formula_disj(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))
    formula_subst(formula_impl(left, right), target_idx, repl) = formula_impl(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))

# Source theorem family for evaluation agreement and substitution.
thm formula_eval_eq_eval:
    ? forall formula PropForm, valuation1, valuation2 fn(input N) {0, 1}:
        forall idx N:
            idx $in formula_vars(formula)
            =>:
                valuation1(idx) = valuation2(idx)
        =>:
            formula_eval(formula, valuation1) = formula_eval(formula, valuation2)
    trust formula_eval(formula, valuation1) = formula_eval(formula, valuation2)

thm formula_subst_eq_of_not_mem_vars:
    ? forall formula PropForm, idx N, repl PropForm:
        not idx $in formula_vars(formula)
        =>:
            formula_subst(formula, idx, repl) = formula
    trust formula_subst(formula, idx, repl) = formula

thm formula_subst_eval_eq:
    ? forall formula PropForm, idx N, repl PropForm, valuation fn(input N) {0, 1}:
        formula_eval(formula_subst(formula, idx, repl), valuation) = formula_eval(formula, \updated_boolean_valuation<valuation, idx, formula_eval(repl, valuation)>)
    trust formula_eval(formula_subst(formula, idx, repl), valuation) = formula_eval(formula, \updated_boolean_valuation<valuation, idx, formula_eval(repl, valuation)>)
