# Chapter 6 — Discrete Mathematics
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/blocked status.

# Only source definitions, principal mathematical results, and the constructors
# needed to use them are retained. Repeated tactic presentations are collapsed.

# 6.1 Finsets and Fintypes

# Source definition: example1. A finite set is unordered and has no duplicate
# elements; later source spelling variants are presentation examples only.
have finite_set_example finite_set = {0, 1, 2}

# Source definition: f. The source function is integer-valued and remains
# callable instead of being replaced by a predicate about squares.
have fn square_int(n N) Z = n^2

# The source identifies cardinality with a sum of ones. This is checked by the
# finite constant-sum rule.
thm finite_set_card_as_sum_ones:
    ? forall A finite_set:
        finite_set_size(A) = finite_set_sum(A, fn(x A) N {1})
    finite_set_sum(A, fn(x A) N {1}) = finite_set_size(A) * 1 = finite_set_size(A)

# Source finite-set induction example. The induction ranges over subsets of the
# ambient domain so that the original callable f remains available throughout.
thm finite_product_ne_zero:
    ? forall A finite_set, f fn(x A) N:
        forall x A:
            f(x) != 0
        =>:
            finite_set_product(A, f) != 0
    by induc P in A:
        ? finite_set_product(P, fn(x P) N {f(x)}) != 0
        ? from P = {}:
            finite_set_product({}, fn(x {}) N {f(x)}) = 1
            1 != 0
        ? induc z, S:
            f(z) != 0
            claim:
                ? forall x union({z}, S):
                    x $in A
                x $in union({z}, S)
                union({z}, S) $subset A
            finite_set_product(union({z}, S), fn(x union({z}, S)) N {f(x)}) = finite_set_product(S, fn(x S) N {f(x)}) * f(z)
            finite_set_product(union({z}, S), fn(x union({z}, S)) N {f(x)}) != 0
    finite_set_product(A, f) = finite_set_product(A, fn(x A) N {f(x)})

# 6.2 Counting Arguments

# The first counting formulas are direct finite-set cardinality laws.
thm card_cartesian_product:
    ? forall A, B finite_set:
        finite_set_size(cart(A, B)) = finite_set_size(A) * finite_set_size(B)

thm card_union_inclusion_exclusion:
    ? forall A, B finite_set:
        finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B))

# Disjointness is a relation between two candidate sets, so this is correctly a
# prop. The following named result is a fact, not another proposition wrapper.
prop disjoint_sets(A, B set):
    intersect(A, B) = {}

thm card_union_of_disjoint:
    ? forall A, B finite_set:
        $disjoint_sets(A, B)
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    intersect(A, B) = {}
    finite_set_size(intersect(A, B)) = finite_set_size({}) = 0
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B)) = finite_set_size(A) + finite_set_size(B)

# Source definition: triangle. Delete pairs whose first coordinate is at least
# their second from the finite Cartesian square. The dependent codomain keeps
# triangle callable and records its exact finite ambient carrier.
have fn triangle(n N) power_set(cart(range(0, n + 1), range(0, n + 1))) = set_minus(cart(range(0, n + 1), range(0, n + 1)), {p cart(range(0, n + 1), range(0, n + 1)): p[1] >= p[2]})

thm triangle_is_finite:
    ? forall n N:
        $is_finite_set(triangle(n))
    triangle(n) $in power_set(cart(range(0, n + 1), range(0, n + 1)))
    triangle(n) $subset cart(range(0, n + 1), range(0, n + 1))
    $is_finite_set(cart(range(0, n + 1), range(0, n + 1)))
    triangle(n) = set_minus(cart(range(0, n + 1), range(0, n + 1)), set_minus(cart(range(0, n + 1), range(0, n + 1)), triangle(n)))
    $is_finite_set(set_minus(cart(range(0, n + 1), range(0, n + 1)), set_minus(cart(range(0, n + 1), range(0, n + 1)), triangle(n))))

# The successor proof below makes the finite fiber decomposition explicit.  Its
# new top column is represented as the range of an exact-carrier embedding.
template<closed_n N>:
    have fn triangle_closed_column_embedding(closed_index closed_range(0, closed_n)) cart(range(0, closed_n + 2), range(0, closed_n + 2)) = (closed_index, closed_n + 1)

template<closed_n N>:
    have triangle_closed_column power_set(cart(range(0, closed_n + 2), range(0, closed_n + 2))) = fn_range(\triangle_closed_column_embedding<closed_n>)

thm triangle_closed_column_embedding_injective:
    ? forall closed_n N:
        $injective(closed_range(0, closed_n), cart(range(0, closed_n + 2), range(0, closed_n + 2)), \triangle_closed_column_embedding<closed_n>)
    claim:
        ? forall left_closed, right_closed closed_range(0, closed_n):
            \triangle_closed_column_embedding<closed_n>(left_closed) = \triangle_closed_column_embedding<closed_n>(right_closed)
            =>:
                left_closed = right_closed
        \triangle_closed_column_embedding<closed_n>(left_closed)[1] = left_closed
        \triangle_closed_column_embedding<closed_n>(right_closed)[1] = right_closed
        \triangle_closed_column_embedding<closed_n>(left_closed)[1] = \triangle_closed_column_embedding<closed_n>(right_closed)[1]
        left_closed = right_closed
    by def $injective(closed_range(0, closed_n), cart(range(0, closed_n + 2), range(0, closed_n + 2)), \triangle_closed_column_embedding<closed_n>)

thm triangle_closed_column_is_finite:
    ? forall closed_n N:
        $is_finite_set(\triangle_closed_column<closed_n>)
    \triangle_closed_column<closed_n> = fn_range(\triangle_closed_column_embedding<closed_n>)
    $is_finite_set(closed_range(0, closed_n))
    $is_finite_set(fn_range(\triangle_closed_column_embedding<closed_n>))

thm triangle_closed_column_card:
    ? forall closed_n N:
        finite_set_size(\triangle_closed_column<closed_n>) = closed_n + 1
    release thm triangle_closed_column_is_finite(closed_n)
    release thm triangle_closed_column_embedding_injective(closed_n)
    \triangle_closed_column<closed_n> = fn_range(\triangle_closed_column_embedding<closed_n>)
    finite_set_size(\triangle_closed_column<closed_n>) = finite_set_size(fn_range(\triangle_closed_column_embedding<closed_n>))
    finite_set_size(fn_range(\triangle_closed_column_embedding<closed_n>)) = finite_set_size(closed_range(0, closed_n))
    finite_set_size(closed_range(0, closed_n)) = closed_n - 0 + 1 = closed_n + 1

thm triangle_member_implies_strict:
    ? forall triangle_n N, triangle_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)):
        triangle_point $in triangle(triangle_n)
        =>:
            triangle_point[1] < triangle_point[2]
    triangle(triangle_n) = set_minus(cart(range(0, triangle_n + 1), range(0, triangle_n + 1)), {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]})
    triangle_point $in set_minus(cart(range(0, triangle_n + 1), range(0, triangle_n + 1)), {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]})
    not triangle_point $in {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]}
    triangle_point[1] < triangle_point[2] or triangle_point[1] >= triangle_point[2]
    by cases:
        ? triangle_point[1] < triangle_point[2]
        case triangle_point[1] < triangle_point[2]:
            triangle_point[1] < triangle_point[2]
        case triangle_point[1] >= triangle_point[2]:
            release thm set_builder_member(triangle_point, {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]})
            triangle_point $in {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]}
            impossible triangle_point $in {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]}

thm triangle_strict_implies_member:
    ? forall triangle_n N, triangle_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)):
        triangle_point[1] < triangle_point[2]
        =>:
            triangle_point $in triangle(triangle_n)
    by contra:
        ? not triangle_point $in {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]}
        triangle_point $in {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]}
        triangle_point[1] >= triangle_point[2]
        impossible triangle_point[1] >= triangle_point[2]
    triangle_point $in set_minus(cart(range(0, triangle_n + 1), range(0, triangle_n + 1)), {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]})
    triangle(triangle_n) = set_minus(cart(range(0, triangle_n + 1), range(0, triangle_n + 1)), {candidate_point cart(range(0, triangle_n + 1), range(0, triangle_n + 1)): candidate_point[1] >= candidate_point[2]})

thm triangle_successor_union:
    ? forall successor_n N:
        triangle(successor_n + 1) = union(triangle(successor_n), \triangle_closed_column<successor_n>)
    (successor_n + 1) + 1 = successor_n + 2
    range(0, (successor_n + 1) + 1) = range(0, successor_n + 2)
    cart(range(0, (successor_n + 1) + 1), range(0, (successor_n + 1) + 1)) = cart(range(0, successor_n + 2), range(0, successor_n + 2))
    by extension:
        ? triangle(successor_n + 1) = union(triangle(successor_n), \triangle_closed_column<successor_n>)
        claim:
            ? forall successor_point triangle(successor_n + 1):
                successor_point $in union(triangle(successor_n), \triangle_closed_column<successor_n>)
            successor_point $in cart(range(0, (successor_n + 1) + 1), range(0, (successor_n + 1) + 1))
            successor_point $in cart(range(0, successor_n + 2), range(0, successor_n + 2))
            release thm triangle_member_implies_strict(successor_n + 1, successor_point)
            successor_point[1] < successor_point[2]
            successor_point[2] <= successor_n or successor_point[2] > successor_n
            by cases:
                ? successor_point $in union(triangle(successor_n), \triangle_closed_column<successor_n>)
                case successor_point[2] <= successor_n:
                    successor_point[1] $in range(0, successor_n + 1)
                    successor_point[2] $in range(0, successor_n + 1)
                    (successor_point[1], successor_point[2]) $in cart(range(0, successor_n + 1), range(0, successor_n + 1))
                    successor_point = (successor_point[1], successor_point[2])
                    successor_point $in cart(range(0, successor_n + 1), range(0, successor_n + 1))
                    release thm triangle_strict_implies_member(successor_n, successor_point)
                    successor_point $in triangle(successor_n)
                    successor_point $in union(triangle(successor_n), \triangle_closed_column<successor_n>)
                case successor_point[2] > successor_n:
                    successor_point[2] $in range(0, successor_n + 2)
                    successor_point[2] >= successor_n + 1
                    successor_point[2] <= successor_n + 1
                    successor_point[2] = successor_n + 1
                    successor_point[1] $in closed_range(0, successor_n)
                    successor_point = (successor_point[1], successor_point[2])
                    successor_point = (successor_point[1], successor_point[2]) = (successor_point[1], successor_n + 1)
                    (successor_point[1], successor_n + 1) = successor_point
                    \triangle_closed_column_embedding<successor_n>(successor_point[1]) = (successor_point[1], successor_n + 1) = successor_point
                    \triangle_closed_column_embedding<successor_n>(successor_point[1]) $in fn_range(\triangle_closed_column_embedding<successor_n>)
                    successor_point $in fn_range(\triangle_closed_column_embedding<successor_n>)
                    \triangle_closed_column<successor_n> = fn_range(\triangle_closed_column_embedding<successor_n>)
                    successor_point $in \triangle_closed_column<successor_n>
                    successor_point $in union(triangle(successor_n), \triangle_closed_column<successor_n>)
        claim:
            ? forall union_point union(triangle(successor_n), \triangle_closed_column<successor_n>):
                union_point $in triangle(successor_n + 1)
            union_point $in triangle(successor_n) or union_point $in \triangle_closed_column<successor_n>
            by cases:
                ? union_point $in triangle(successor_n + 1)
                case union_point $in triangle(successor_n):
                    union_point $in cart(range(0, successor_n + 1), range(0, successor_n + 1))
                    union_point[1] $in range(0, successor_n + 2)
                    union_point[2] $in range(0, successor_n + 2)
                    (union_point[1], union_point[2]) $in cart(range(0, successor_n + 2), range(0, successor_n + 2))
                    union_point = (union_point[1], union_point[2])
                    union_point $in cart(range(0, successor_n + 2), range(0, successor_n + 2))
                    union_point $in cart(range(0, (successor_n + 1) + 1), range(0, (successor_n + 1) + 1))
                    release thm triangle_member_implies_strict(successor_n, union_point)
                    union_point[1] < union_point[2]
                    release thm triangle_strict_implies_member(successor_n + 1, union_point)
                case union_point $in \triangle_closed_column<successor_n>:
                    \triangle_closed_column<successor_n> = fn_range(\triangle_closed_column_embedding<successor_n>)
                    union_point $in fn_range(\triangle_closed_column_embedding<successor_n>)
                    have by preimage closed_index from union_point $in fn_range(\triangle_closed_column_embedding<successor_n>)
                    union_point = \triangle_closed_column_embedding<successor_n>(closed_index)
                    \triangle_closed_column_embedding<successor_n>(closed_index) = (closed_index, successor_n + 1)
                    union_point = \triangle_closed_column_embedding<successor_n>(closed_index) = (closed_index, successor_n + 1)
                    union_point $in cart(range(0, successor_n + 2), range(0, successor_n + 2))
                    union_point $in cart(range(0, (successor_n + 1) + 1), range(0, (successor_n + 1) + 1))
                    union_point[1] = closed_index
                    union_point[2] = successor_n + 1
                    closed_index <= successor_n
                    closed_index < successor_n + 1
                    union_point[1] < union_point[2]
                    release thm triangle_strict_implies_member(successor_n + 1, union_point)

thm triangle_closed_column_disjoint:
    ? forall disjoint_n N:
        intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>) = {}
    claim:
        ? intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>) $subset {}
        claim:
            ? forall disjoint_point intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>):
                disjoint_point $in {}
            by contra:
                ? disjoint_point $in {}
                disjoint_point $in triangle(disjoint_n)
                disjoint_point $in \triangle_closed_column<disjoint_n>
                disjoint_point $in cart(range(0, disjoint_n + 1), range(0, disjoint_n + 1))
                disjoint_point[2] $in range(0, disjoint_n + 1)
                disjoint_point[2] < disjoint_n + 1
                \triangle_closed_column<disjoint_n> = fn_range(\triangle_closed_column_embedding<disjoint_n>)
                disjoint_point $in fn_range(\triangle_closed_column_embedding<disjoint_n>)
                have by preimage disjoint_index from disjoint_point $in fn_range(\triangle_closed_column_embedding<disjoint_n>)
                disjoint_point = \triangle_closed_column_embedding<disjoint_n>(disjoint_index)
                \triangle_closed_column_embedding<disjoint_n>(disjoint_index) = (disjoint_index, disjoint_n + 1)
                disjoint_point = \triangle_closed_column_embedding<disjoint_n>(disjoint_index) = (disjoint_index, disjoint_n + 1)
                disjoint_point[2] = disjoint_n + 1
                impossible disjoint_point[2] < disjoint_n + 1
        by def:
            ? intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>) $subset {}
    claim:
        ? {} $subset intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>)
        claim:
            ? forall empty_point {}:
                empty_point $in intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>)
            by contra:
                ? empty_point $in intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>)
                impossible empty_point $in {}
        by def:
            ? {} $subset intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>)
    by extension:
        ? intersect(triangle(disjoint_n), \triangle_closed_column<disjoint_n>) = {}

thm triangle_zero:
    ? forall zero_n N:
        zero_n = 0
        =>:
            triangle(zero_n) = {}
    claim:
        ? triangle(zero_n) $subset {}
        claim:
            ? forall zero_point triangle(zero_n):
                zero_point $in {}
            by contra:
                ? zero_point $in {}
                zero_point $in cart(range(0, zero_n + 1), range(0, zero_n + 1))
                release thm triangle_member_implies_strict(zero_n, zero_point)
                zero_point[1] < zero_point[2]
                zero_n = 0
                zero_point[1] $in range(0, zero_n + 1) = range(0, 1)
                zero_point[2] $in range(0, zero_n + 1) = range(0, 1)
                zero_point[1] >= 0
                zero_point[1] < 1
                zero_point[1] = 0
                zero_point[2] >= 0
                zero_point[2] < 1
                zero_point[2] = 0
                impossible zero_point[1] < zero_point[2]
        by def:
            ? triangle(zero_n) $subset {}
    claim:
        ? {} $subset triangle(zero_n)
        claim:
            ? forall empty_point {}:
                empty_point $in triangle(zero_n)
            by contra:
                ? empty_point $in triangle(zero_n)
                impossible empty_point $in {}
        by def:
            ? {} $subset triangle(zero_n)
    by extension:
        ? triangle(zero_n) = {}

# Source triangle-cardinality family.  Its three source proofs share this one
# mathematical statement; the proof is the explicit disjoint-column induction.
thm triangle_card:
    ? forall n N:
        finite_set_size(triangle(n)) = (n + 1) * n / 2
    release thm triangle_is_finite(n)
    by induc n from 0:
        ? finite_set_size(triangle(n)) = (n + 1) * n / 2
        ? from n = 0:
            release thm triangle_zero(n)
            finite_set_size(triangle(n)) = finite_set_size({}) = 0
            (n + 1) * n / 2 = 0
        ? induc:
            release thm triangle_successor_union(n)
            release thm triangle_is_finite(n)
            release thm triangle_closed_column_is_finite(n)
            release thm card_union_inclusion_exclusion(triangle(n), \triangle_closed_column<n>)
            release thm triangle_closed_column_disjoint(n)
            finite_set_size(intersect(triangle(n), \triangle_closed_column<n>)) = finite_set_size({}) = 0
            release thm triangle_closed_column_card(n)
            finite_set_size(triangle(n + 1)) = finite_set_size(union(triangle(n), \triangle_closed_column<n>))
            finite_set_size(union(triangle(n), \triangle_closed_column<n>)) = finite_set_size(triangle(n)) + finite_set_size(\triangle_closed_column<n>) - finite_set_size(intersect(triangle(n), \triangle_closed_column<n>))
            finite_set_size(triangle(n + 1)) = finite_set_size(union(triangle(n), \triangle_closed_column<n>)) = finite_set_size(triangle(n)) + finite_set_size(\triangle_closed_column<n>) - finite_set_size(intersect(triangle(n), \triangle_closed_column<n>)) = finite_set_size(triangle(n)) + (n + 1) - 0 = finite_set_size(triangle(n)) + (n + 1)
            finite_set_size(triangle(n)) = (n + 1) * n / 2
            finite_set_size(triangle(n + 1)) = finite_set_size(triangle(n)) + (n + 1) = (n + 1) * n / 2 + (n + 1)
            (n + 1) * n / 2 + (n + 1) = ((n + 1) + 1) * (n + 1) / 2
            finite_set_size(triangle(n + 1)) = (n + 1) * n / 2 + (n + 1) = ((n + 1) + 1) * (n + 1) / 2

# Source theorem: doubleCounting.  A zero-one incidence function is the
# Litex-native representation of the finite relation; its row and column sums
# are the source fiber cardinalities.
thm finite_fubini_N:
    ? forall X, Y finite_set, f fn(z cart(X, Y)) N:
        finite_set_sum(X, fn(x X) N {finite_set_sum(Y, fn(y Y) N {f((x, y))})}) = finite_set_sum(Y, fn(y Y) N {finite_set_sum(X, fn(x X) N {f((x, y))})})

thm double_counting:
    ? forall A, B finite_set, incidence fn(a A, b B) N:
        forall a A, b B:
            incidence(a, b) = 0 or incidence(a, b) = 1
        forall a A:
            finite_set_sum(B, fn(b B) N {incidence(a, b)}) >= 3
        forall b B:
            finite_set_sum(A, fn(a A) N {incidence(a, b)}) <= 1
        =>:
            3 * finite_set_size(A) <= finite_set_size(B)
    have row_total N = finite_set_sum(A, fn(a A) N {finite_set_sum(B, fn(b B) N {incidence(a, b)})})
    have column_total N = finite_set_sum(B, fn(b B) N {finite_set_sum(A, fn(a A) N {incidence(a, b)})})
    claim:
        ? finite_set_sum(A, fn(a A) N {3}) <= row_total
        forall a A:
            3 <= finite_set_sum(B, fn(b B) N {incidence(a, b)})
        row_total = finite_set_sum(A, fn(a A) N {finite_set_sum(B, fn(b B) N {incidence(a, b)})})
        release thm finite_set_sum_le_from_pointwise(finite_set_sum(A, fn(a A) N {3}), finite_set_sum(A, fn(a A) N {finite_set_sum(B, fn(b B) N {incidence(a, b)})}))
    finite_set_sum(A, fn(a A) N {3}) = finite_set_size(A) * 3 = 3 * finite_set_size(A)
    3 * finite_set_size(A) <= row_total
    claim:
        ? column_total <= finite_set_sum(B, fn(b B) N {1})
        forall b B:
            finite_set_sum(A, fn(a A) N {incidence(a, b)}) <= 1
        column_total = finite_set_sum(B, fn(b B) N {finite_set_sum(A, fn(a A) N {incidence(a, b)})})
        release thm finite_set_sum_le_from_pointwise(finite_set_sum(B, fn(b B) N {finite_set_sum(A, fn(a A) N {incidence(a, b)})}), finite_set_sum(B, fn(b B) N {1}))
    finite_set_sum(B, fn(b B) N {1}) = finite_set_size(B) * 1 = finite_set_size(B)
    column_total <= finite_set_size(B)
    release thm finite_fubini_N(A, B, fn(z cart(A, B)) N {incidence(z[1], z[2])})
    row_total = finite_set_sum(A, fn(a A) N {finite_set_sum(B, fn(b B) N {incidence(a, b)})}) = finite_set_sum(B, fn(b B) N {finite_set_sum(A, fn(a A) N {incidence(a, b)})}) = column_total
    3 * finite_set_size(A) <= row_total = column_total <= finite_set_size(B)

# 6.3 Inductive Structures

# A finite list is represented directly by its length and its entries on the
# exact positive index interval 1,...,n.  This exposes all dependencies locally
# and needs neither an opaque list carrier nor a trusted generic recursor.
struct CheckedList<A set, n N>:
    length N
    entries fn(idx N+: idx <= n) A
    <=>:
        length = n

# The second append branch needs a checked dependent index in 1,...,right_length.
template<left_length, right_length N>:
    have fn checked_list_tail_index by exist!:
        ? forall idx N+:
            idx <= left_length + right_length
            idx > left_length
            =>:
                exist! shifted N+ st {shifted = idx - left_length, shifted <= right_length}
        idx - left_length >= 1
        idx - left_length $in Z
        idx - left_length $in N+
        left_length + right_length = right_length + left_length
        idx <= right_length + left_length
        idx - left_length <= right_length
        claim:
            ? forall shifted1, shifted2 N+:
                shifted1 = idx - left_length
                shifted1 <= right_length
                shifted2 = idx - left_length
                shifted2 <= right_length
                =>:
                    shifted1 = shifted2
            shifted1 = idx - left_length = shifted2
        have selected_shift N+ = idx - left_length
        witness exist! shifted N+ st {shifted = idx - left_length, shifted <= right_length} from selected_shift

template<A set, left_length, right_length N>:
    have fn checked_list_append_entries(left &CheckedList<A, left_length>, right &CheckedList<A, right_length>, idx N+: idx <= left_length + right_length) A by cases:
        case idx <= left_length: left.entries(idx)
        case idx > left_length: right.entries(\checked_list_tail_index<left_length, right_length>(idx))

template<A set, left_length, right_length N>:
    have fn checked_list_append(left &CheckedList<A, left_length>, right &CheckedList<A, right_length>) &CheckedList<A, left_length + right_length> = (left_length + right_length, fn(idx N+: idx <= left_length + right_length) A {\checked_list_append_entries<A, left_length, right_length>(left, right, idx)})

template<A, B set, n N, f fn(x A) B>:
    have fn checked_list_map_entries(source &CheckedList<A, n>, idx N+: idx <= n) B = f(source.entries(idx))

template<A, B set, n N, f fn(x A) B>:
    have fn checked_list_map(source &CheckedList<A, n>) &CheckedList<B, n> = (n, fn(idx N+: idx <= n) B {\checked_list_map_entries<A, B, n, f>(source, idx)})

# Reversal uses the checked involutive index n+1-i.
template<n N>:
    have fn checked_list_reverse_index by exist!:
        ? forall idx N+:
            idx <= n
            =>:
                exist! shifted N+ st {shifted = n + 1 - idx, shifted <= n}
        idx + 1 <= n + 1
        n + 1 - idx >= idx + 1 - idx = 1
        n + 1 - idx >= 1
        n + 1 - idx $in Z
        n + 1 - idx $in N+
        idx >= 1
        n + 1 - idx <= n + 1 - 1 = n
        n + 1 - idx <= n
        claim:
            ? forall shifted1, shifted2 N+:
                shifted1 = n + 1 - idx
                shifted1 <= n
                shifted2 = n + 1 - idx
                shifted2 <= n
                =>:
                    shifted1 = shifted2
            shifted1 = n + 1 - idx = shifted2
        have selected_reverse N+ = n + 1 - idx
        witness exist! shifted N+ st {shifted = n + 1 - idx, shifted <= n} from selected_reverse

template<A set, n N>:
    have fn checked_list_reverse_entries(source &CheckedList<A, n>, idx N+: idx <= n) A = source.entries(\checked_list_reverse_index<n>(idx))

template<A set, n N>:
    have fn checked_list_reverse(source &CheckedList<A, n>) &CheckedList<A, n> = (n, fn(idx N+: idx <= n) A {\checked_list_reverse_entries<A, n>(source, idx)})

# Equality of dependent lists is extensional: their lengths agree and every
# entry agrees wherever both exact dependent domains are available.
prop same_checked_list(A set, left_length, right_length N, left &CheckedList<A, left_length>, right &CheckedList<A, right_length>):
    left_length = right_length
    forall idx N+:
        idx <= left_length
        idx <= right_length
        =>:
            left.entries(idx) = right.entries(idx)

# Source theorem: append_nil.
thm checked_list_append_zero:
    ? forall A set, n N, left &CheckedList<A, n>, empty &CheckedList<A, 0>:
        $same_checked_list(A, n + 0, n, \checked_list_append<A, n, 0>(left, empty), left)
    n + 0 = n
    claim:
        ? forall idx N+:
            idx <= n + 0
            idx <= n
            =>:
                \checked_list_append<A, n, 0>(left, empty).entries(idx) = left.entries(idx)
        \checked_list_append<A, n, 0>(left, empty).entries(idx) = \checked_list_append_entries<A, n, 0>(left, empty, idx)
        \checked_list_append_entries<A, n, 0>(left, empty, idx) = left.entries(idx)
    by def $same_checked_list(A, n + 0, n, \checked_list_append<A, n, 0>(left, empty), left)

template<A, B, CarrierC set, f fn(x A) B, g fn(y B) CarrierC>:
    have fn checked_list_composed(x A) CarrierC = g(f(x))

# Source theorem: map_map.
thm checked_list_map_map:
    ? forall A, B, CarrierC set, n N, source &CheckedList<A, n>, f fn(x A) B, g fn(y B) CarrierC:
        $same_checked_list(CarrierC, n, n, \checked_list_map<B, CarrierC, n, g>(\checked_list_map<A, B, n, f>(source)), \checked_list_map<A, CarrierC, n, \checked_list_composed<A, B, CarrierC, f, g>>(source))
    n = n
    claim:
        ? forall idx N+:
            idx <= n
            idx <= n
            =>:
                \checked_list_map<B, CarrierC, n, g>(\checked_list_map<A, B, n, f>(source)).entries(idx) = \checked_list_map<A, CarrierC, n, \checked_list_composed<A, B, CarrierC, f, g>>(source).entries(idx)
        \checked_list_map<B, CarrierC, n, g>(\checked_list_map<A, B, n, f>(source)).entries(idx) = \checked_list_map_entries<B, CarrierC, n, g>(\checked_list_map<A, B, n, f>(source), idx) = g(\checked_list_map<A, B, n, f>(source).entries(idx))
        \checked_list_map<A, B, n, f>(source).entries(idx) = \checked_list_map_entries<A, B, n, f>(source, idx) = f(source.entries(idx))
        \checked_list_map<B, CarrierC, n, g>(\checked_list_map<A, B, n, f>(source)).entries(idx) = g(f(source.entries(idx)))
        \checked_list_map<A, CarrierC, n, \checked_list_composed<A, B, CarrierC, f, g>>(source).entries(idx) = \checked_list_map_entries<A, CarrierC, n, \checked_list_composed<A, B, CarrierC, f, g>>(source, idx) = \checked_list_composed<A, B, CarrierC, f, g>(source.entries(idx)) = g(f(source.entries(idx)))
    by def $same_checked_list(CarrierC, n, n, \checked_list_map<B, CarrierC, n, g>(\checked_list_map<A, B, n, f>(source)), \checked_list_map<A, CarrierC, n, \checked_list_composed<A, B, CarrierC, f, g>>(source))

# The two index regions of reverse-append are exposed as reusable checked
# lemmas.  Keeping the dependent bounds explicit makes the proof inspectable.
thm checked_list_reverse_append_front:
    ? forall A set, left_length, right_length N, left &CheckedList<A, left_length>, right &CheckedList<A, right_length>, idx N+:
        idx <= left_length + right_length
        idx <= right_length
        =>:
            \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_reverse<A, right_length>(right).entries(idx)
    \checked_list_reverse_index<left_length + right_length>(idx) <= left_length + right_length
    have total_index N+ = \checked_list_reverse_index<left_length + right_length>(idx)
    total_index = \checked_list_reverse_index<left_length + right_length>(idx) <= left_length + right_length
    total_index = left_length + right_length + 1 - idx
    left_length + right_length + 1 - idx >= left_length + right_length + 1 - right_length = left_length + 1
    total_index >= left_length + 1 > left_length
    \checked_list_tail_index<left_length, right_length>(total_index) <= right_length
    \checked_list_tail_index<left_length, right_length>(total_index) = total_index - left_length = right_length + 1 - idx
    \checked_list_reverse_index<right_length>(idx) <= right_length
    \checked_list_reverse_index<right_length>(idx) = right_length + 1 - idx
    \checked_list_tail_index<left_length, right_length>(total_index) = \checked_list_reverse_index<right_length>(idx)
    \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_reverse_entries<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right), idx)
    \checked_list_reverse_entries<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right), idx) = \checked_list_append<A, left_length, right_length>(left, right).entries(total_index)
    \checked_list_append<A, left_length, right_length>(left, right).entries(total_index) = \checked_list_append_entries<A, left_length, right_length>(left, right, total_index)
    \checked_list_append_entries<A, left_length, right_length>(left, right, total_index) = right.entries(\checked_list_tail_index<left_length, right_length>(total_index))
    right.entries(\checked_list_tail_index<left_length, right_length>(total_index)) = right.entries(\checked_list_reverse_index<right_length>(idx))
    \checked_list_reverse<A, right_length>(right).entries(idx) = \checked_list_reverse_entries<A, right_length>(right, idx) = right.entries(\checked_list_reverse_index<right_length>(idx))

thm checked_list_reverse_append_back:
    ? forall A set, left_length, right_length N, left &CheckedList<A, left_length>, right &CheckedList<A, right_length>, idx N+:
        idx <= left_length + right_length
        idx <= right_length + left_length
        idx > right_length
        =>:
            \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_reverse<A, left_length>(left).entries(\checked_list_tail_index<right_length, left_length>(idx))
    \checked_list_reverse_index<left_length + right_length>(idx) <= left_length + right_length
    have total_index N+ = \checked_list_reverse_index<left_length + right_length>(idx)
    total_index = \checked_list_reverse_index<left_length + right_length>(idx) <= left_length + right_length
    total_index = left_length + right_length + 1 - idx
    idx >= right_length + 1
    left_length + right_length + 1 - idx <= left_length + right_length + 1 - (right_length + 1) = left_length
    total_index <= left_length
    \checked_list_tail_index<right_length, left_length>(idx) <= left_length
    have shifted_index N+ = \checked_list_tail_index<right_length, left_length>(idx)
    shifted_index = \checked_list_tail_index<right_length, left_length>(idx) <= left_length
    shifted_index = idx - right_length
    \checked_list_reverse_index<left_length>(shifted_index) <= left_length
    \checked_list_reverse_index<left_length>(shifted_index) = left_length + 1 - shifted_index = left_length + 1 - (idx - right_length) = left_length + right_length + 1 - idx = total_index
    \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_reverse_entries<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right), idx)
    \checked_list_reverse_entries<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right), idx) = \checked_list_append<A, left_length, right_length>(left, right).entries(total_index)
    \checked_list_append<A, left_length, right_length>(left, right).entries(total_index) = \checked_list_append_entries<A, left_length, right_length>(left, right, total_index)
    \checked_list_append_entries<A, left_length, right_length>(left, right, total_index) = left.entries(total_index)
    \checked_list_reverse<A, left_length>(left).entries(\checked_list_tail_index<right_length, left_length>(idx)) = \checked_list_reverse<A, left_length>(left).entries(shifted_index)
    \checked_list_reverse<A, left_length>(left).entries(shifted_index) = \checked_list_reverse_entries<A, left_length>(left, shifted_index) = left.entries(\checked_list_reverse_index<left_length>(shifted_index)) = left.entries(total_index)

# Source theorem: reverse_append.
thm checked_list_reverse_append:
    ? forall A set, left_length, right_length N, left &CheckedList<A, left_length>, right &CheckedList<A, right_length>:
        $same_checked_list(A, left_length + right_length, right_length + left_length, \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)), \checked_list_append<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left)))
    left_length + right_length = right_length + left_length
    claim:
        ? forall idx N+:
            idx <= left_length + right_length
            idx <= right_length + left_length
            =>:
                \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_append<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left)).entries(idx)
        idx <= right_length or idx > right_length
        by cases:
            ? \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_append<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left)).entries(idx)
            case idx <= right_length:
                release thm checked_list_reverse_append_front(A, left_length, right_length, left, right, idx)
                \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_reverse<A, right_length>(right).entries(idx)
                \checked_list_append<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left)).entries(idx) = \checked_list_append_entries<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left), idx) = \checked_list_reverse<A, right_length>(right).entries(idx)
            case idx > right_length:
                release thm checked_list_reverse_append_back(A, left_length, right_length, left, right, idx)
                \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)).entries(idx) = \checked_list_reverse<A, left_length>(left).entries(\checked_list_tail_index<right_length, left_length>(idx))
                \checked_list_append<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left)).entries(idx) = \checked_list_append_entries<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left), idx) = \checked_list_reverse<A, left_length>(left).entries(\checked_list_tail_index<right_length, left_length>(idx))
    by def $same_checked_list(A, left_length + right_length, right_length + left_length, \checked_list_reverse<A, left_length + right_length>(\checked_list_append<A, left_length, right_length>(left, right)), \checked_list_append<A, right_length, left_length>(\checked_list_reverse<A, right_length>(right), \checked_list_reverse<A, left_length>(left)))

# Source theorem: reverse_reverse.
thm checked_list_reverse_reverse:
    ? forall A set, n N, source &CheckedList<A, n>:
        $same_checked_list(A, n, n, \checked_list_reverse<A, n>(\checked_list_reverse<A, n>(source)), source)
    n = n
    claim:
        ? forall idx N+:
            idx <= n
            idx <= n
            =>:
                \checked_list_reverse<A, n>(\checked_list_reverse<A, n>(source)).entries(idx) = source.entries(idx)
        \checked_list_reverse_index<n>(idx) $in N+
        \checked_list_reverse_index<n>(idx) <= n
        \checked_list_reverse_index<n>(idx) = n + 1 - idx
        \checked_list_reverse_index<n>(\checked_list_reverse_index<n>(idx)) = n + 1 - \checked_list_reverse_index<n>(idx) = n + 1 - (n + 1 - idx) = idx
        \checked_list_reverse<A, n>(\checked_list_reverse<A, n>(source)).entries(idx) = \checked_list_reverse_entries<A, n>(\checked_list_reverse<A, n>(source), idx) = \checked_list_reverse<A, n>(source).entries(\checked_list_reverse_index<n>(idx))
        \checked_list_reverse<A, n>(source).entries(\checked_list_reverse_index<n>(idx)) = \checked_list_reverse_entries<A, n>(source, \checked_list_reverse_index<n>(idx)) = source.entries(\checked_list_reverse_index<n>(\checked_list_reverse_index<n>(idx))) = source.entries(idx)
    by def $same_checked_list(A, n, n, \checked_list_reverse<A, n>(\checked_list_reverse<A, n>(source)), source)

# The source uses Nat.max in the depth recursion.
have fn nat_max(left, right N) N by cases:
    case left >= right: left
    case left < right: right

# Boolean values used by the source's formula evaluator are represented by the
# actual two-element carrier {0,1}. The formula construction itself is tracked
# in todo.lit until its recursive interface is checked.
have Boolean finite_set = {0, 1}

have fn boolean_not(value {0, 1}) {0, 1} by cases:
    case value = 0: 1
    case value = 1: 0

have fn boolean_and(left, right {0, 1}) {0, 1} by cases:
    case left = 0: 0
    case left = 1: right

have fn boolean_or(left, right {0, 1}) {0, 1} by cases:
    case left = 0: right
    case left = 1: 1

# The source's substitution proof updates one input of a Boolean valuation.
# Keep that construction callable while the surrounding formula syntax and
# evaluator remain tracked separately.
template<valuation fn(idx N) {0, 1}, idx N, bit {0, 1}>:
    have fn updated_boolean_valuation(m N) {0, 1} by cases:
        case m = idx: bit
        case m != idx: valuation(m)

# Source construction: BinTree. We use native N as the visible Goedel-code
# carrier: 0 is empty and every positive code is the reversible pair
# 2^left * (2*right+1). This keeps the recursive representation explicit and
# avoids a cosmetic carrier alias that would hide no mathematics.
have fn code_pair(left, right N) N+ = 2^left * (2 * right + 1)

have fn code_pair_left(code N+) N = chap5::prime_factor_exponent(code, 2)

have fn code_pair_residual by exist!:
    ? forall code N+:
        exist! residual N+ st {code = 2^code_pair_left(code) * residual, not $chap2::divides(2, residual)}
    code != 0
    $prime(2)
    release thm chap5::prime_factor_exponent_residual(code, 2)
    obtain q from exist q N+ st {code = 2^chap5::prime_factor_exponent(code, 2) * q, not $chap2::divides(2, q)}
    code_pair_left(code) = chap5::prime_factor_exponent(code, 2)
    code = 2^code_pair_left(code) * q
    claim:
        ? forall residual1, residual2 N+:
            code = 2^code_pair_left(code) * residual1
            not $chap2::divides(2, residual1)
            code = 2^code_pair_left(code) * residual2
            not $chap2::divides(2, residual2)
            =>:
                residual1 = residual2
        2^code_pair_left(code) * residual1 = code = 2^code_pair_left(code) * residual2
        2^code_pair_left(code) != 0
        release thm chap5::integer_left_multiplication_cancellation(2^code_pair_left(code), residual1, residual2)
    have selected_residual N+ = q
    witness exist! residual N+ st {code = 2^code_pair_left(code) * residual, not $chap2::divides(2, residual)} from selected_residual

have fn code_pair_right by exist!:
    ? forall code N+:
        exist! right N st {code_pair_residual(code) = 2 * right + 1}
    code_pair_residual(code) % 2 = 0 or code_pair_residual(code) % 2 = 1
    claim:
        ? code_pair_residual(code) % 2 = 1
        by cases:
            ? code_pair_residual(code) % 2 = 1
            case code_pair_residual(code) % 2 = 0:
                code_pair_residual(code) = 2 * chap5::integer_quotient(code_pair_residual(code), 2) + code_pair_residual(code) % 2
                have even_q Z = chap5::integer_quotient(code_pair_residual(code), 2)
                2 * chap5::integer_quotient(code_pair_residual(code), 2) = 2 * even_q
                code_pair_residual(code) = 2 * chap5::integer_quotient(code_pair_residual(code), 2) + code_pair_residual(code) % 2 = 2 * even_q + 0 = 2 * even_q
                witness $chap2::divides(2, code_pair_residual(code)) from even_q:
                    code_pair_residual(code) = 2 * even_q
                impossible not $chap2::divides(2, code_pair_residual(code))
            case code_pair_residual(code) % 2 = 1:
                code_pair_residual(code) % 2 = 1
    code_pair_residual(code) = 2 * chap5::integer_quotient(code_pair_residual(code), 2) + code_pair_residual(code) % 2
    have quotient Z = chap5::integer_quotient(code_pair_residual(code), 2)
    2 * chap5::integer_quotient(code_pair_residual(code), 2) = 2 * quotient
    code_pair_residual(code) = 2 * chap5::integer_quotient(code_pair_residual(code), 2) + code_pair_residual(code) % 2 = 2 * quotient + 1
    claim:
        ? quotient >= 0
        by contra:
            ? quotient >= 0
            quotient < 0
            quotient <= -1
            2 * quotient + 1 <= 2 * (-1) + 1 = -1
            code_pair_residual(code) <= -1
            code_pair_residual(code) > 0
            impossible code_pair_residual(code) > 0
    quotient $in N
    claim:
        ? forall right1, right2 N:
            code_pair_residual(code) = 2 * right1 + 1
            code_pair_residual(code) = 2 * right2 + 1
            =>:
                right1 = right2
        2 * right1 + 1 = code_pair_residual(code) = 2 * right2 + 1
        2 * right1 = 2 * right1 + 1 - 1 = 2 * right2 + 1 - 1 = 2 * right2
        release thm chap5::integer_left_multiplication_cancellation(2, right1, right2)
    have selected_right N = quotient
    code_pair_residual(code) = 2 * quotient + 1 = 2 * selected_right + 1
    witness exist! right N st {code_pair_residual(code) = 2 * right + 1} from selected_right

thm prime_factor_exponent_zero_of_not_divides:
    ? forall n, p N+:
        $prime(p)
        not $chap2::divides(p, n)
        =>:
            chap5::prime_factor_exponent(n, p) = 0
    chap5::prime_factor_exponent(n, p) = 0 or chap5::prime_factor_exponent(n, p) > 0
    by cases:
        ? chap5::prime_factor_exponent(n, p) = 0
        case chap5::prime_factor_exponent(n, p) = 0:
            chap5::prime_factor_exponent(n, p) = 0
        case chap5::prime_factor_exponent(n, p) > 0:
            release thm chap5::prime_factor_exponent_residual(n, p)
            obtain residual from exist residual N+ st {n = p^chap5::prime_factor_exponent(n, p) * residual, not $chap2::divides(p, residual)}
            chap5::prime_factor_exponent(n, p) - 1 >= 0
            chap5::prime_factor_exponent(n, p) - 1 $in N
            chap5::prime_factor_exponent(n, p) = 1 + (chap5::prime_factor_exponent(n, p) - 1)
            p^chap5::prime_factor_exponent(n, p) = p^(1 + (chap5::prime_factor_exponent(n, p) - 1)) = p * p^(chap5::prime_factor_exponent(n, p) - 1)
            witness $chap2::divides(p, n) from p^(chap5::prime_factor_exponent(n, p) - 1) * residual:
                n = p^chap5::prime_factor_exponent(n, p) * residual = p * p^(chap5::prime_factor_exponent(n, p) - 1) * residual = p * (p^(chap5::prime_factor_exponent(n, p) - 1) * residual)
            impossible not $chap2::divides(p, n)

thm two_not_divides_odd:
    ? forall right N:
        not $chap2::divides(2, 2 * right + 1)
    by contra:
        ? not $chap2::divides(2, 2 * right + 1)
        $chap2::divides(2, 2 * right + 1)
        obtain quotient from exist quotient Z st {2 * right + 1 = 2 * quotient}
        (2 * right) % 2 = 0
        (2 * right + 1) % 2 = (((2 * right) % 2) + (1 % 2)) % 2 = (0 + 1) % 2 = 1
        (2 * quotient) % 2 = 0
        (2 * right + 1) % 2 = (2 * quotient) % 2
        1 = (2 * right + 1) % 2 = (2 * quotient) % 2 = 0
        impossible 1 = 0

thm natural_lt_two_power:
    ? forall n N:
        n < 2^n
    by induc n from 0:
        ? n < 2^n
        ? from n = 0:
            0 < 1 = 2^0
        ? induc:
            n < 2^n
            n + 1 < 2^n + 1
            2^n $in N+
            2^n >= 1
            2^n + 1 <= 2^n + 2^n = 2^n * 2
            2^(n + 1) = 2^n * 2
            n + 1 < 2^n + 1 <= 2^n * 2 = 2^(n + 1)

thm code_pair_left_of_pair:
    ? forall left, right N:
        code_pair_left(code_pair(left, right)) = left
    $prime(2)
    2^left $in N+
    2^left != 0
    2 * right + 1 > 0
    2 * right + 1 != 0
    release thm chap5::factorization_mul(2^left, 2 * right + 1, 2)
    chap5::prime_factor_exponent(2^left * (2 * right + 1), 2) = chap5::prime_factor_exponent(2^left, 2) + chap5::prime_factor_exponent(2 * right + 1, 2)
    release thm chap5::factorization_pow(2, left, 2)
    chap5::prime_factor_exponent(2^left, 2) = left * chap5::prime_factor_exponent(2, 2)
    release thm chap5::prime_factorization_self(2)
    chap5::prime_factor_exponent(2, 2) = 1
    release thm two_not_divides_odd(right)
    release thm prime_factor_exponent_zero_of_not_divides(2 * right + 1, 2)
    chap5::prime_factor_exponent(2 * right + 1, 2) = 0
    chap5::prime_factor_exponent(2^left, 2) + chap5::prime_factor_exponent(2 * right + 1, 2) = left * chap5::prime_factor_exponent(2, 2) + chap5::prime_factor_exponent(2 * right + 1, 2) = left * 1 + chap5::prime_factor_exponent(2 * right + 1, 2) = left * 1 + 0 = left
    code_pair_left(code_pair(left, right)) = chap5::prime_factor_exponent(2^left * (2 * right + 1), 2) = chap5::prime_factor_exponent(2^left, 2) + chap5::prime_factor_exponent(2 * right + 1, 2) = left

thm code_pair_residual_of_pair:
    ? forall left, right N:
        code_pair_residual(code_pair(left, right)) = 2 * right + 1
    release thm code_pair_left_of_pair(left, right)
    code_pair(left, right) = 2^code_pair_left(code_pair(left, right)) * code_pair_residual(code_pair(left, right))
    2^code_pair_left(code_pair(left, right)) * code_pair_residual(code_pair(left, right)) = 2^left * code_pair_residual(code_pair(left, right))
    code_pair(left, right) = 2^left * (2 * right + 1)
    2^left * code_pair_residual(code_pair(left, right)) = code_pair(left, right) = 2^left * (2 * right + 1)
    2^left != 0
    release thm chap5::integer_left_multiplication_cancellation(2^left, code_pair_residual(code_pair(left, right)), 2 * right + 1)

thm code_pair_right_of_pair:
    ? forall left, right N:
        code_pair_right(code_pair(left, right)) = right
    release thm code_pair_residual_of_pair(left, right)
    code_pair_residual(code_pair(left, right)) = 2 * code_pair_right(code_pair(left, right)) + 1
    2 * code_pair_right(code_pair(left, right)) + 1 = code_pair_residual(code_pair(left, right)) = 2 * right + 1
    2 * code_pair_right(code_pair(left, right)) = 2 * code_pair_right(code_pair(left, right)) + 1 - 1 = 2 * right + 1 - 1 = 2 * right
    release thm chap5::integer_left_multiplication_cancellation(2, code_pair_right(code_pair(left, right)), right)

thm code_pair_reconstruct:
    ? forall code N+:
        code_pair(code_pair_left(code), code_pair_right(code)) = code
    code = 2^code_pair_left(code) * code_pair_residual(code)
    code_pair_residual(code) = 2 * code_pair_right(code) + 1
    code = 2^code_pair_left(code) * code_pair_residual(code) = 2^code_pair_left(code) * (2 * code_pair_right(code) + 1) = code_pair(code_pair_left(code), code_pair_right(code))

thm code_pair_left_lt_pair:
    ? forall left, right N:
        left < code_pair(left, right)
    release thm natural_lt_two_power(left)
    2 * right + 1 >= 1
    2^left > 0
    2^left * 1 <= 2^left * (2 * right + 1)
    2^left * 1 = 2^left
    code_pair(left, right) = 2^left * (2 * right + 1)
    left < 2^left = 2^left * 1 <= 2^left * (2 * right + 1) = code_pair(left, right)

thm code_pair_right_lt_pair:
    ? forall left, right N:
        right < code_pair(left, right)
    right < 2 * right + 1
    2^left $in N+
    2^left >= 1
    1 * (2 * right + 1) <= 2^left * (2 * right + 1)
    1 * (2 * right + 1) = 2 * right + 1
    code_pair(left, right) = 2^left * (2 * right + 1)
    right < 2 * right + 1 = 1 * (2 * right + 1) <= 2^left * (2 * right + 1) = code_pair(left, right)

thm code_pair_left_lt:
    ? forall code N+:
        code_pair_left(code) < code
    release thm code_pair_left_lt_pair(code_pair_left(code), code_pair_right(code))
    release thm code_pair_reconstruct(code)
    code_pair_left(code) < code_pair(code_pair_left(code), code_pair_right(code)) = code

thm code_pair_right_lt:
    ? forall code N+:
        code_pair_right(code) < code
    release thm code_pair_right_lt_pair(code_pair_left(code), code_pair_right(code))
    release thm code_pair_reconstruct(code)
    code_pair_right(code) < code_pair(code_pair_left(code), code_pair_right(code)) = code

have binary_tree_empty N = 0

have fn binary_tree_node(left, right N) N = code_pair(left, right)

have fn binary_tree_size(tree N) N by induc tree from 0:
    case tree = 0: 0
    case tree > 0: binary_tree_size(code_pair_left(tree)) + binary_tree_size(code_pair_right(tree)) + 1

have fn binary_tree_depth(tree N) N by induc tree from 0:
    case tree = 0: 0
    case tree > 0: nat_max(binary_tree_depth(code_pair_left(tree)), binary_tree_depth(code_pair_right(tree))) + 1

have fn binary_tree_flip(tree N) N by induc tree from 0:
    case tree = 0: 0
    case tree > 0: code_pair(binary_tree_flip(code_pair_right(tree)), binary_tree_flip(code_pair_left(tree)))

# Strong induction is derived from Litex's ordinary induction by carrying the
# full prefix of already established cases.
thm natural_strong_induction:
    ? forall P power_set(N):
        forall n N:
            forall k N:
                k < n
                =>:
                    k $in P
            =>:
                n $in P
        =>:
            P = N
    prop all_up_to(n N):
        forall k N:
            k <= n
            =>:
                k $in P
    claim:
        ? forall n N:
            $all_up_to(n)
        by induc n from 0:
            ? $all_up_to(n)
            ? from n = 0:
                claim:
                    ? forall smaller N:
                        smaller < 0
                        =>:
                            smaller $in P
                    by contra:
                        ? smaller $in P
                        smaller >= 0
                        impossible smaller < 0
                0 $in P
                claim:
                    ? forall k N:
                        k <= 0
                        =>:
                            k $in P
                    k = 0
                    k $in P
                by def $all_up_to(n)
                $all_up_to(n)
            ? induc:
                $all_up_to(n)
                claim:
                    ? forall smaller N:
                        smaller < n + 1
                        =>:
                            smaller $in P
                    smaller <= n
                    by def $all_up_to(n)
                    smaller $in P
                n + 1 $in P
                claim:
                    ? forall k N:
                        k <= n + 1
                        =>:
                            k $in P
                    k <= n or k > n
                    by cases:
                        ? k $in P
                        case k <= n:
                            by def $all_up_to(n)
                            k $in P
                        case k > n:
                            k >= n + 1
                            k = n + 1
                            k $in P
                by def $all_up_to(n + 1)
                $all_up_to(n + 1)
    claim:
        ? N $subset P
        claim:
            ? forall n N:
                n $in P
            $all_up_to(n)
            by def $all_up_to(n)
            n <= n
            n $in P
        N $subset P
    P $subset N
    by extension P = N

thm binary_tree_induction:
    ? forall P power_set(N):
        binary_tree_empty $in P
        forall left, right N:
            left $in P
            right $in P
            =>:
                binary_tree_node(left, right) $in P
        =>:
            P = N
    claim:
        ? forall tree N:
            forall smaller N:
                smaller < tree
                =>:
                    smaller $in P
            =>:
                tree $in P
        tree = 0 or tree > 0
        by cases:
            ? tree $in P
            case tree = 0:
                tree = 0 = binary_tree_empty
                tree $in P
            case tree > 0:
                code_pair_left(tree) < tree
                code_pair_right(tree) < tree
                code_pair_left(tree) $in P
                code_pair_right(tree) $in P
                binary_tree_node(code_pair_left(tree), code_pair_right(tree)) $in P
                release thm code_pair_reconstruct(tree)
                binary_tree_node(code_pair_left(tree), code_pair_right(tree)) = code_pair(code_pair_left(tree), code_pair_right(tree)) = tree
                tree $in P
    release thm natural_strong_induction(P)

claim:
    ? binary_tree_size(binary_tree_empty) = 0
    binary_tree_empty = 0
    binary_tree_size(binary_tree_empty) = binary_tree_size(0) = 0

thm binary_tree_size_node:
    ? forall left, right N:
        binary_tree_size(binary_tree_node(left, right)) = binary_tree_size(left) + binary_tree_size(right) + 1
    binary_tree_node(left, right) = code_pair(left, right)
    code_pair(left, right) > 0
    binary_tree_size(binary_tree_node(left, right)) = binary_tree_size(code_pair(left, right)) = binary_tree_size(code_pair_left(code_pair(left, right))) + binary_tree_size(code_pair_right(code_pair(left, right))) + 1
    release thm code_pair_left_of_pair(left, right)
    release thm code_pair_right_of_pair(left, right)
    binary_tree_size(code_pair_left(code_pair(left, right))) + binary_tree_size(code_pair_right(code_pair(left, right))) + 1 = binary_tree_size(left) + binary_tree_size(right) + 1

claim:
    ? binary_tree_depth(binary_tree_empty) = 0
    binary_tree_empty = 0
    binary_tree_depth(binary_tree_empty) = binary_tree_depth(0) = 0

thm binary_tree_depth_node:
    ? forall left, right N:
        binary_tree_depth(binary_tree_node(left, right)) = nat_max(binary_tree_depth(left), binary_tree_depth(right)) + 1
    binary_tree_node(left, right) = code_pair(left, right)
    code_pair(left, right) > 0
    binary_tree_depth(binary_tree_node(left, right)) = binary_tree_depth(code_pair(left, right)) = nat_max(binary_tree_depth(code_pair_left(code_pair(left, right))), binary_tree_depth(code_pair_right(code_pair(left, right)))) + 1
    release thm code_pair_left_of_pair(left, right)
    release thm code_pair_right_of_pair(left, right)
    nat_max(binary_tree_depth(code_pair_left(code_pair(left, right))), binary_tree_depth(code_pair_right(code_pair(left, right)))) + 1 = nat_max(binary_tree_depth(left), binary_tree_depth(right)) + 1

claim:
    ? binary_tree_flip(binary_tree_empty) = binary_tree_empty
    binary_tree_empty = 0
    binary_tree_flip(binary_tree_empty) = binary_tree_flip(0) = 0 = binary_tree_empty

thm binary_tree_flip_node:
    ? forall left, right N:
        binary_tree_flip(binary_tree_node(left, right)) = binary_tree_node(binary_tree_flip(right), binary_tree_flip(left))
    binary_tree_node(left, right) = code_pair(left, right)
    code_pair(left, right) > 0
    binary_tree_flip(binary_tree_node(left, right)) = binary_tree_flip(code_pair(left, right)) = code_pair(binary_tree_flip(code_pair_right(code_pair(left, right))), binary_tree_flip(code_pair_left(code_pair(left, right))))
    release thm code_pair_left_of_pair(left, right)
    release thm code_pair_right_of_pair(left, right)
    code_pair(binary_tree_flip(code_pair_right(code_pair(left, right))), binary_tree_flip(code_pair_left(code_pair(left, right)))) = code_pair(binary_tree_flip(right), binary_tree_flip(left)) = binary_tree_node(binary_tree_flip(right), binary_tree_flip(left))

thm nat_max_ge_left:
    ? forall left, right N:
        left <= nat_max(left, right)
    left >= right or left < right
    by cases:
        ? left <= nat_max(left, right)
        case left >= right:
            nat_max(left, right) = left
            left <= nat_max(left, right)
        case left < right:
            nat_max(left, right) = right
            left <= nat_max(left, right)

thm nat_max_ge_right:
    ? forall left, right N:
        right <= nat_max(left, right)
    left >= right or left < right
    by cases:
        ? right <= nat_max(left, right)
        case left >= right:
            nat_max(left, right) = left
            right <= nat_max(left, right)
        case left < right:
            nat_max(left, right) = right
            right <= nat_max(left, right)

thm two_power_mono:
    ? forall lower, upper N:
        lower <= upper
        =>:
            2^lower <= 2^upper
    upper - lower >= 0
    upper - lower $in N
    upper = lower + (upper - lower)
    2^(upper - lower) $in N+
    2^(upper - lower) >= 1
    2^lower > 0
    2^lower * 1 <= 2^lower * 2^(upper - lower)
    2^upper = 2^(lower + (upper - lower)) = 2^lower * 2^(upper - lower)
    2^lower = 2^lower * 1 <= 2^lower * 2^(upper - lower) = 2^upper

# Source structural-induction theorem family for binary trees.
thm binary_tree_size_le:
    ? forall tree N:
        binary_tree_size(tree) <= 2^binary_tree_depth(tree) - 1
    prop size_bounded_by_depth(candidate N):
        binary_tree_size(candidate) <= 2^binary_tree_depth(candidate) - 1
    claim:
        ? binary_tree_empty $in {candidate N: $size_bounded_by_depth(candidate)}
        binary_tree_size(binary_tree_empty) = 0
        binary_tree_depth(binary_tree_empty) = 0
        2^binary_tree_depth(binary_tree_empty) - 1 = 2^0 - 1 = 0
        binary_tree_size(binary_tree_empty) <= 2^binary_tree_depth(binary_tree_empty) - 1
        by def $size_bounded_by_depth(binary_tree_empty)
        binary_tree_empty $in {candidate N: $size_bounded_by_depth(candidate)}
    claim:
        ? forall left, right N:
            left $in {candidate N: $size_bounded_by_depth(candidate)}
            right $in {candidate N: $size_bounded_by_depth(candidate)}
            =>:
                binary_tree_node(left, right) $in {candidate N: $size_bounded_by_depth(candidate)}
        by def $size_bounded_by_depth(left)
        by def $size_bounded_by_depth(right)
        binary_tree_size(left) <= 2^binary_tree_depth(left) - 1
        binary_tree_size(right) <= 2^binary_tree_depth(right) - 1
        have max_depth N = nat_max(binary_tree_depth(left), binary_tree_depth(right))
        release thm nat_max_ge_left(binary_tree_depth(left), binary_tree_depth(right))
        release thm nat_max_ge_right(binary_tree_depth(left), binary_tree_depth(right))
        binary_tree_depth(left) <= max_depth
        binary_tree_depth(right) <= max_depth
        release thm two_power_mono(binary_tree_depth(left), max_depth)
        release thm two_power_mono(binary_tree_depth(right), max_depth)
        2^binary_tree_depth(left) <= 2^max_depth
        2^binary_tree_depth(right) <= 2^max_depth
        2^binary_tree_depth(left) - 1 <= 2^max_depth - 1
        2^binary_tree_depth(right) - 1 <= 2^max_depth - 1
        binary_tree_size(left) <= 2^max_depth - 1
        binary_tree_size(right) <= 2^max_depth - 1
        binary_tree_size(left) + binary_tree_size(right) + 1 <= (2^max_depth - 1) + (2^max_depth - 1) + 1
        2^max_depth $in N+
        2^max_depth >= 1
        (2^max_depth - 1) + (2^max_depth - 1) + 1 = 2 * 2^max_depth - 1
        2^(max_depth + 1) = 2^max_depth * 2 = 2 * 2^max_depth
        2 * 2^max_depth - 1 = 2^(max_depth + 1) - 1
        binary_tree_size(left) + binary_tree_size(right) + 1 <= 2^(max_depth + 1) - 1
        release thm binary_tree_size_node(left, right)
        release thm binary_tree_depth_node(left, right)
        binary_tree_size(binary_tree_node(left, right)) = binary_tree_size(left) + binary_tree_size(right) + 1
        binary_tree_depth(binary_tree_node(left, right)) = nat_max(binary_tree_depth(left), binary_tree_depth(right)) + 1 = max_depth + 1
        binary_tree_size(binary_tree_node(left, right)) <= 2^binary_tree_depth(binary_tree_node(left, right)) - 1
        by def $size_bounded_by_depth(binary_tree_node(left, right))
        binary_tree_node(left, right) $in {candidate N: $size_bounded_by_depth(candidate)}
    release thm binary_tree_induction({candidate N: $size_bounded_by_depth(candidate)})
    {candidate N: $size_bounded_by_depth(candidate)} = N
    tree $in N
    tree $in {candidate N: $size_bounded_by_depth(candidate)}
    by def $size_bounded_by_depth(tree)
    $size_bounded_by_depth(tree)

thm binary_tree_depth_le_size:
    ? forall tree N:
        binary_tree_depth(tree) <= binary_tree_size(tree)
    prop depth_bounded_by_size(candidate N):
        binary_tree_depth(candidate) <= binary_tree_size(candidate)
    claim:
        ? binary_tree_empty $in {candidate N: $depth_bounded_by_size(candidate)}
        by def $depth_bounded_by_size(binary_tree_empty)
        binary_tree_depth(binary_tree_empty) = 0
        binary_tree_size(binary_tree_empty) = 0
        binary_tree_depth(binary_tree_empty) <= binary_tree_size(binary_tree_empty)
    claim:
        ? forall left, right N:
            left $in {candidate N: $depth_bounded_by_size(candidate)}
            right $in {candidate N: $depth_bounded_by_size(candidate)}
            =>:
                binary_tree_node(left, right) $in {candidate N: $depth_bounded_by_size(candidate)}
        by def $depth_bounded_by_size(left)
        by def $depth_bounded_by_size(right)
        binary_tree_depth(left) <= binary_tree_size(left)
        binary_tree_depth(right) <= binary_tree_size(right)
        release thm nat_max_ge_left(binary_tree_depth(left), binary_tree_depth(right))
        release thm nat_max_ge_right(binary_tree_depth(left), binary_tree_depth(right))
        binary_tree_depth(left) <= nat_max(binary_tree_depth(left), binary_tree_depth(right))
        binary_tree_depth(right) <= nat_max(binary_tree_depth(left), binary_tree_depth(right))
        claim:
            ? nat_max(binary_tree_depth(left), binary_tree_depth(right)) <= binary_tree_size(left) + binary_tree_size(right)
            binary_tree_depth(left) >= binary_tree_depth(right) or binary_tree_depth(left) < binary_tree_depth(right)
            by cases:
                ? nat_max(binary_tree_depth(left), binary_tree_depth(right)) <= binary_tree_size(left) + binary_tree_size(right)
                case binary_tree_depth(left) >= binary_tree_depth(right):
                    nat_max(binary_tree_depth(left), binary_tree_depth(right)) = binary_tree_depth(left)
                    binary_tree_size(right) >= 0
                    binary_tree_depth(left) <= binary_tree_size(left) <= binary_tree_size(left) + binary_tree_size(right)
                case binary_tree_depth(left) < binary_tree_depth(right):
                    nat_max(binary_tree_depth(left), binary_tree_depth(right)) = binary_tree_depth(right)
                    binary_tree_size(left) >= 0
                    binary_tree_depth(right) <= binary_tree_size(right) <= binary_tree_size(left) + binary_tree_size(right)
        release thm binary_tree_depth_node(left, right)
        release thm binary_tree_size_node(left, right)
        binary_tree_depth(binary_tree_node(left, right)) = nat_max(binary_tree_depth(left), binary_tree_depth(right)) + 1
        binary_tree_size(binary_tree_node(left, right)) = binary_tree_size(left) + binary_tree_size(right) + 1
        nat_max(binary_tree_depth(left), binary_tree_depth(right)) + 1 <= binary_tree_size(left) + binary_tree_size(right) + 1
        binary_tree_depth(binary_tree_node(left, right)) <= binary_tree_size(binary_tree_node(left, right))
        by def $depth_bounded_by_size(binary_tree_node(left, right))
        binary_tree_node(left, right) $in {candidate N: $depth_bounded_by_size(candidate)}
    release thm binary_tree_induction({candidate N: $depth_bounded_by_size(candidate)})
    {candidate N: $depth_bounded_by_size(candidate)} = N
    tree $in N
    tree $in {candidate N: $depth_bounded_by_size(candidate)}
    by def $depth_bounded_by_size(tree)
    $depth_bounded_by_size(tree)

thm binary_tree_size_flip:
    ? forall tree N:
        binary_tree_size(binary_tree_flip(tree)) = binary_tree_size(tree)
    prop flip_preserves_size(candidate N):
        binary_tree_size(binary_tree_flip(candidate)) = binary_tree_size(candidate)
    claim:
        ? binary_tree_empty $in {candidate N: $flip_preserves_size(candidate)}
        binary_tree_flip(binary_tree_empty) = binary_tree_empty
        binary_tree_size(binary_tree_flip(binary_tree_empty)) = binary_tree_size(binary_tree_empty)
        by def $flip_preserves_size(binary_tree_empty)
        binary_tree_empty $in {candidate N: $flip_preserves_size(candidate)}
    claim:
        ? forall left, right N:
            left $in {candidate N: $flip_preserves_size(candidate)}
            right $in {candidate N: $flip_preserves_size(candidate)}
            =>:
                binary_tree_node(left, right) $in {candidate N: $flip_preserves_size(candidate)}
        by def $flip_preserves_size(left)
        by def $flip_preserves_size(right)
        binary_tree_size(binary_tree_flip(left)) = binary_tree_size(left)
        binary_tree_size(binary_tree_flip(right)) = binary_tree_size(right)
        release thm binary_tree_flip_node(left, right)
        release thm binary_tree_size_node(binary_tree_flip(right), binary_tree_flip(left))
        release thm binary_tree_size_node(left, right)
        binary_tree_size(binary_tree_flip(binary_tree_node(left, right))) = binary_tree_size(binary_tree_node(binary_tree_flip(right), binary_tree_flip(left))) = binary_tree_size(binary_tree_flip(right)) + binary_tree_size(binary_tree_flip(left)) + 1 = binary_tree_size(right) + binary_tree_size(left) + 1 = binary_tree_size(left) + binary_tree_size(right) + 1 = binary_tree_size(binary_tree_node(left, right))
        by def $flip_preserves_size(binary_tree_node(left, right))
        binary_tree_node(left, right) $in {candidate N: $flip_preserves_size(candidate)}
    release thm binary_tree_induction({candidate N: $flip_preserves_size(candidate)})
    {candidate N: $flip_preserves_size(candidate)} = N
    tree $in N
    tree $in {candidate N: $flip_preserves_size(candidate)}
    by def $flip_preserves_size(tree)
    $flip_preserves_size(tree)

# Source construction: PropForm. Native N is the visible Goedel-code carrier:
# false is 0, variables have residue 1 modulo 4, and the three binary
# constructors have residues 2, 3, and 0. Pair payloads use the already checked
# reversible code_pair interface above. This exposes the full representation
# and avoids a cosmetic carrier alias.
have fn natural_quarter by exist!:
    ? forall n N:
        exist! q N st {n = 4 * q + n % 4}
    have quotient Z = chap5::integer_quotient(n, 4)
    n = 4 * chap5::integer_quotient(n, 4) + n % 4 = 4 * quotient + n % 4
    claim:
        ? quotient >= 0
        by contra:
            ? quotient >= 0
            quotient < 0
            quotient <= -1
            n % 4 < 4
            4 * quotient <= 4 * (-1) = -4
            4 * quotient + n % 4 < -4 + 4 = 0
            n < 0
            n >= 0
            impossible n >= 0
    quotient $in N
    claim:
        ? forall q1, q2 N:
            n = 4 * q1 + n % 4
            n = 4 * q2 + n % 4
            =>:
                q1 = q2
        4 * q1 + n % 4 = n = 4 * q2 + n % 4
        4 * q1 = 4 * q1 + n % 4 - n % 4 = 4 * q2 + n % 4 - n % 4 = 4 * q2
        release thm chap5::integer_left_multiplication_cancellation(4, q1, q2)
    have selected_quarter N = quotient
    n = 4 * quotient + n % 4 = 4 * selected_quarter + n % 4
    witness exist! q N st {n = 4 * q + n % 4} from selected_quarter

thm natural_quarter_of_exact_decomposition:
    ? forall n, q, residue N:
        n = 4 * q + residue
        n % 4 = residue
        =>:
            natural_quarter(n) = q
    n = 4 * natural_quarter(n) + n % 4 = 4 * natural_quarter(n) + residue
    4 * natural_quarter(n) + residue = n = 4 * q + residue
    4 * natural_quarter(n) = 4 * natural_quarter(n) + residue - residue = 4 * q + residue - residue = 4 * q
    release thm chap5::integer_left_multiplication_cancellation(4, natural_quarter(n), q)

thm natural_quarter_lt_positive:
    ? forall n N:
        n > 0
        =>:
            natural_quarter(n) < n
    n = 4 * natural_quarter(n) + n % 4
    natural_quarter(n) = 0 or natural_quarter(n) > 0
    by cases:
        ? natural_quarter(n) < n
        case natural_quarter(n) = 0:
            natural_quarter(n) = 0 < n
        case natural_quarter(n) > 0:
            natural_quarter(n) < 4 * natural_quarter(n)
            n % 4 >= 0
            4 * natural_quarter(n) <= 4 * natural_quarter(n) + n % 4 = n
            natural_quarter(n) < 4 * natural_quarter(n) <= 4 * natural_quarter(n) + n % 4 = n

thm natural_quarter_positive_of_mod_zero:
    ? forall n N:
        n > 0
        n % 4 = 0
        =>:
            natural_quarter(n) > 0
    natural_quarter(n) = 0 or natural_quarter(n) > 0
    by cases:
        ? natural_quarter(n) > 0
        case natural_quarter(n) = 0:
            n = 4 * natural_quarter(n) + n % 4 = 4 * 0 + 0 = 0
            impossible n > 0
        case natural_quarter(n) > 0:
            natural_quarter(n) > 0

have fn natural_predecessor(value N) N by cases:
    case value = 0: 0
    case value > 0: value - 1

thm natural_predecessor_le:
    ? forall value N:
        natural_predecessor(value) <= value
    value = 0 or value > 0
    by cases:
        ? natural_predecessor(value) <= value
        case value = 0:
            natural_predecessor(value) = 0 = value
        case value > 0:
            natural_predecessor(value) = value - 1 <= value

# Shift the positive pair code down by one so every natural is a payload.
have fn code_pair0(left, right N) N = code_pair(left, right) - 1
have fn code_pair0_left(code N) N = code_pair_left(code + 1)
have fn code_pair0_right(code N) N = code_pair_right(code + 1)

thm code_pair0_succ:
    ? forall left, right N:
        code_pair0(left, right) + 1 = code_pair(left, right)
    code_pair(left, right) $in N+
    code_pair(left, right) >= 1
    code_pair0(left, right) = code_pair(left, right) - 1
    code_pair0(left, right) + 1 = code_pair(left, right) - 1 + 1 = code_pair(left, right)

thm code_pair0_left_of_pair:
    ? forall left, right N:
        code_pair0_left(code_pair0(left, right)) = left
    release thm code_pair0_succ(left, right)
    code_pair0_left(code_pair0(left, right)) = code_pair_left(code_pair0(left, right) + 1) = code_pair_left(code_pair(left, right))
    release thm code_pair_left_of_pair(left, right)

thm code_pair0_right_of_pair:
    ? forall left, right N:
        code_pair0_right(code_pair0(left, right)) = right
    release thm code_pair0_succ(left, right)
    code_pair0_right(code_pair0(left, right)) = code_pair_right(code_pair0(left, right) + 1) = code_pair_right(code_pair(left, right))
    release thm code_pair_right_of_pair(left, right)

thm code_pair0_reconstruct:
    ? forall code N:
        code_pair0(code_pair0_left(code), code_pair0_right(code)) = code
    code + 1 $in N+
    release thm code_pair_reconstruct(code + 1)
    code_pair(code_pair_left(code + 1), code_pair_right(code + 1)) = code + 1
    code_pair0_left(code) = code_pair_left(code + 1)
    code_pair0_right(code) = code_pair_right(code + 1)
    code_pair0(code_pair0_left(code), code_pair0_right(code)) = code_pair(code_pair_left(code + 1), code_pair_right(code + 1)) - 1 = code + 1 - 1 = code

thm code_pair0_left_le:
    ? forall code N:
        code_pair0_left(code) <= code
    code + 1 $in N+
    release thm code_pair_left_lt(code + 1)
    code_pair0_left(code) = code_pair_left(code + 1) < code + 1
    code_pair0_left(code) <= code

thm code_pair0_right_le:
    ? forall code N:
        code_pair0_right(code) <= code
    code + 1 $in N+
    release thm code_pair_right_lt(code + 1)
    code_pair0_right(code) = code_pair_right(code + 1) < code + 1
    code_pair0_right(code) <= code

have formula_false N = 0
have fn formula_var(idx N) N = 4 * idx + 1
have fn formula_conj(left, right N) N = 4 * code_pair0(left, right) + 2
have fn formula_disj(left, right N) N = 4 * code_pair0(left, right) + 3
have fn formula_impl(left, right N) N = 4 * code_pair0(left, right) + 4

have fn formula_payload_code(formula N) N by cases:
    case formula % 4 = 0: natural_predecessor(natural_quarter(formula))
    case formula % 4 = 1: natural_quarter(formula)
    case formula % 4 = 2: natural_quarter(formula)
    case formula % 4 = 3: natural_quarter(formula)

have fn formula_left_code(formula N) N = code_pair0_left(formula_payload_code(formula))
have fn formula_right_code(formula N) N = code_pair0_right(formula_payload_code(formula))

thm formula_payload_code_lt:
    ? forall formula N:
        formula > 0
        =>:
            formula_payload_code(formula) < formula
    release thm natural_quarter_lt_positive(formula)
    claim:
        ? formula_payload_code(formula) <= natural_quarter(formula)
        formula % 4 = 0 or formula % 4 = 1 or formula % 4 = 2 or formula % 4 = 3
        by cases:
            ? formula_payload_code(formula) <= natural_quarter(formula)
            case formula % 4 = 0:
                formula_payload_code(formula) = natural_predecessor(natural_quarter(formula))
                release thm natural_predecessor_le(natural_quarter(formula))
            case formula % 4 = 1:
                formula_payload_code(formula) = natural_quarter(formula)
            case formula % 4 = 2:
                formula_payload_code(formula) = natural_quarter(formula)
            case formula % 4 = 3:
                formula_payload_code(formula) = natural_quarter(formula)
    formula_payload_code(formula) <= natural_quarter(formula) < formula

thm formula_left_code_lt:
    ? forall formula N:
        formula > 0
        =>:
            formula_left_code(formula) < formula
    release thm code_pair0_left_le(formula_payload_code(formula))
    release thm formula_payload_code_lt(formula)
    formula_left_code(formula) = code_pair0_left(formula_payload_code(formula)) <= formula_payload_code(formula) < formula

thm formula_right_code_lt:
    ? forall formula N:
        formula > 0
        =>:
            formula_right_code(formula) < formula
    release thm code_pair0_right_le(formula_payload_code(formula))
    release thm formula_payload_code_lt(formula)
    formula_right_code(formula) = code_pair0_right(formula_payload_code(formula)) <= formula_payload_code(formula) < formula

thm formula_var_tag:
    ? forall idx N:
        formula_var(idx) % 4 = 1
    formula_var(idx) = 4 * idx + 1
    (4 * idx) % 4 = 0
    (4 * idx + 1) % 4 = (((4 * idx) % 4) + (1 % 4)) % 4 = (0 + 1) % 4 = 1

thm formula_conj_tag:
    ? forall left, right N:
        formula_conj(left, right) % 4 = 2
    formula_conj(left, right) = 4 * code_pair0(left, right) + 2
    (4 * code_pair0(left, right)) % 4 = 0
    (4 * code_pair0(left, right) + 2) % 4 = (((4 * code_pair0(left, right)) % 4) + (2 % 4)) % 4 = (0 + 2) % 4 = 2

thm formula_disj_tag:
    ? forall left, right N:
        formula_disj(left, right) % 4 = 3
    formula_disj(left, right) = 4 * code_pair0(left, right) + 3
    (4 * code_pair0(left, right)) % 4 = 0
    (4 * code_pair0(left, right) + 3) % 4 = (((4 * code_pair0(left, right)) % 4) + (3 % 4)) % 4 = (0 + 3) % 4 = 3

thm formula_impl_tag:
    ? forall left, right N:
        formula_impl(left, right) % 4 = 0
    formula_impl(left, right) = 4 * code_pair0(left, right) + 4 = 4 * (code_pair0(left, right) + 1)
    (4 * code_pair0(left, right)) % 4 = 0
    (4 * code_pair0(left, right) + 4) % 4 = (((4 * code_pair0(left, right)) % 4) + (4 % 4)) % 4 = (0 + 0) % 4 = 0

thm formula_quarter_var:
    ? forall idx N:
        natural_quarter(formula_var(idx)) = idx
    release thm formula_var_tag(idx)
    formula_var(idx) = 4 * idx + 1
    release thm natural_quarter_of_exact_decomposition(formula_var(idx), idx, 1)

thm formula_quarter_conj:
    ? forall left, right N:
        natural_quarter(formula_conj(left, right)) = code_pair0(left, right)
    release thm formula_conj_tag(left, right)
    formula_conj(left, right) = 4 * code_pair0(left, right) + 2
    release thm natural_quarter_of_exact_decomposition(formula_conj(left, right), code_pair0(left, right), 2)

thm formula_quarter_disj:
    ? forall left, right N:
        natural_quarter(formula_disj(left, right)) = code_pair0(left, right)
    release thm formula_disj_tag(left, right)
    formula_disj(left, right) = 4 * code_pair0(left, right) + 3
    release thm natural_quarter_of_exact_decomposition(formula_disj(left, right), code_pair0(left, right), 3)

thm formula_quarter_impl:
    ? forall left, right N:
        natural_quarter(formula_impl(left, right)) = code_pair0(left, right) + 1
    release thm formula_impl_tag(left, right)
    formula_impl(left, right) = 4 * code_pair0(left, right) + 4 = 4 * (code_pair0(left, right) + 1) + 0
    release thm natural_quarter_of_exact_decomposition(formula_impl(left, right), code_pair0(left, right) + 1, 0)

thm formula_payload_code_var:
    ? forall idx N:
        formula_payload_code(formula_var(idx)) = idx
    release thm formula_var_tag(idx)
    release thm formula_quarter_var(idx)
    formula_payload_code(formula_var(idx)) = natural_quarter(formula_var(idx)) = idx

thm formula_payload_code_conj:
    ? forall left, right N:
        formula_payload_code(formula_conj(left, right)) = code_pair0(left, right)
    release thm formula_conj_tag(left, right)
    release thm formula_quarter_conj(left, right)
    formula_payload_code(formula_conj(left, right)) = natural_quarter(formula_conj(left, right)) = code_pair0(left, right)

thm formula_payload_code_disj:
    ? forall left, right N:
        formula_payload_code(formula_disj(left, right)) = code_pair0(left, right)
    release thm formula_disj_tag(left, right)
    release thm formula_quarter_disj(left, right)
    formula_payload_code(formula_disj(left, right)) = natural_quarter(formula_disj(left, right)) = code_pair0(left, right)

thm formula_payload_code_impl:
    ? forall left, right N:
        formula_payload_code(formula_impl(left, right)) = code_pair0(left, right)
    release thm formula_impl_tag(left, right)
    release thm formula_quarter_impl(left, right)
    code_pair0(left, right) + 1 > 0
    natural_predecessor(code_pair0(left, right) + 1) = code_pair0(left, right) + 1 - 1 = code_pair0(left, right)
    formula_payload_code(formula_impl(left, right)) = natural_predecessor(natural_quarter(formula_impl(left, right))) = natural_predecessor(code_pair0(left, right) + 1) = code_pair0(left, right)

thm formula_left_code_conj:
    ? forall left, right N:
        formula_left_code(formula_conj(left, right)) = left
    release thm formula_payload_code_conj(left, right)
    release thm code_pair0_left_of_pair(left, right)
    formula_left_code(formula_conj(left, right)) = code_pair0_left(code_pair0(left, right)) = left

thm formula_right_code_conj:
    ? forall left, right N:
        formula_right_code(formula_conj(left, right)) = right
    release thm formula_payload_code_conj(left, right)
    release thm code_pair0_right_of_pair(left, right)
    formula_right_code(formula_conj(left, right)) = code_pair0_right(code_pair0(left, right)) = right

thm formula_left_code_disj:
    ? forall left, right N:
        formula_left_code(formula_disj(left, right)) = left
    release thm formula_payload_code_disj(left, right)
    release thm code_pair0_left_of_pair(left, right)
    formula_left_code(formula_disj(left, right)) = code_pair0_left(code_pair0(left, right)) = left

thm formula_right_code_disj:
    ? forall left, right N:
        formula_right_code(formula_disj(left, right)) = right
    release thm formula_payload_code_disj(left, right)
    release thm code_pair0_right_of_pair(left, right)
    formula_right_code(formula_disj(left, right)) = code_pair0_right(code_pair0(left, right)) = right

thm formula_left_code_impl:
    ? forall left, right N:
        formula_left_code(formula_impl(left, right)) = left
    release thm formula_payload_code_impl(left, right)
    release thm code_pair0_left_of_pair(left, right)
    formula_left_code(formula_impl(left, right)) = code_pair0_left(code_pair0(left, right)) = left

thm formula_right_code_impl:
    ? forall left, right N:
        formula_right_code(formula_impl(left, right)) = right
    release thm formula_payload_code_impl(left, right)
    release thm code_pair0_right_of_pair(left, right)
    formula_right_code(formula_impl(left, right)) = code_pair0_right(code_pair0(left, right)) = right

thm formula_reconstruct_var:
    ? forall formula N:
        formula % 4 = 1
        =>:
            formula_var(natural_quarter(formula)) = formula
    formula = 4 * natural_quarter(formula) + formula % 4 = 4 * natural_quarter(formula) + 1
    formula_var(natural_quarter(formula)) = 4 * natural_quarter(formula) + 1 = formula

thm formula_reconstruct_conj:
    ? forall formula N:
        formula % 4 = 2
        =>:
            formula_conj(formula_left_code(formula), formula_right_code(formula)) = formula
    formula_payload_code(formula) = natural_quarter(formula)
    release thm code_pair0_reconstruct(formula_payload_code(formula))
    formula_left_code(formula) = code_pair0_left(formula_payload_code(formula))
    formula_right_code(formula) = code_pair0_right(formula_payload_code(formula))
    code_pair0(formula_left_code(formula), formula_right_code(formula)) = code_pair0(code_pair0_left(formula_payload_code(formula)), code_pair0_right(formula_payload_code(formula))) = formula_payload_code(formula) = natural_quarter(formula)
    formula = 4 * natural_quarter(formula) + formula % 4 = 4 * natural_quarter(formula) + 2
    formula_conj(formula_left_code(formula), formula_right_code(formula)) = 4 * code_pair0(formula_left_code(formula), formula_right_code(formula)) + 2 = 4 * natural_quarter(formula) + 2 = formula

thm formula_reconstruct_disj:
    ? forall formula N:
        formula % 4 = 3
        =>:
            formula_disj(formula_left_code(formula), formula_right_code(formula)) = formula
    formula_payload_code(formula) = natural_quarter(formula)
    release thm code_pair0_reconstruct(formula_payload_code(formula))
    formula_left_code(formula) = code_pair0_left(formula_payload_code(formula))
    formula_right_code(formula) = code_pair0_right(formula_payload_code(formula))
    code_pair0(formula_left_code(formula), formula_right_code(formula)) = code_pair0(code_pair0_left(formula_payload_code(formula)), code_pair0_right(formula_payload_code(formula))) = formula_payload_code(formula) = natural_quarter(formula)
    formula = 4 * natural_quarter(formula) + formula % 4 = 4 * natural_quarter(formula) + 3
    formula_disj(formula_left_code(formula), formula_right_code(formula)) = 4 * code_pair0(formula_left_code(formula), formula_right_code(formula)) + 3 = 4 * natural_quarter(formula) + 3 = formula

thm formula_reconstruct_impl:
    ? forall formula N:
        formula > 0
        formula % 4 = 0
        =>:
            formula_impl(formula_left_code(formula), formula_right_code(formula)) = formula
    release thm natural_quarter_positive_of_mod_zero(formula)
    natural_quarter(formula) > 0
    natural_predecessor(natural_quarter(formula)) = natural_quarter(formula) - 1
    formula_payload_code(formula) = natural_predecessor(natural_quarter(formula)) = natural_quarter(formula) - 1
    release thm code_pair0_reconstruct(formula_payload_code(formula))
    formula_left_code(formula) = code_pair0_left(formula_payload_code(formula))
    formula_right_code(formula) = code_pair0_right(formula_payload_code(formula))
    code_pair0(formula_left_code(formula), formula_right_code(formula)) = code_pair0(code_pair0_left(formula_payload_code(formula)), code_pair0_right(formula_payload_code(formula))) = formula_payload_code(formula) = natural_quarter(formula) - 1
    formula = 4 * natural_quarter(formula) + formula % 4 = 4 * natural_quarter(formula)
    formula_impl(formula_left_code(formula), formula_right_code(formula)) = 4 * code_pair0(formula_left_code(formula), formula_right_code(formula)) + 4 = 4 * (natural_quarter(formula) - 1) + 4 = 4 * natural_quarter(formula) = formula

thm formula_induction:
    ? forall P power_set(N):
        forall idx N:
            formula_var(idx) $in P
        formula_false $in P
        forall left, right N:
            left $in P
            right $in P
            =>:
                formula_conj(left, right) $in P
                formula_disj(left, right) $in P
                formula_impl(left, right) $in P
        =>:
            P = N
    claim:
        ? forall formula N:
            forall smaller N:
                smaller < formula
                =>:
                    smaller $in P
            =>:
                formula $in P
        formula = 0 or formula > 0
        by cases:
            ? formula $in P
            case formula = 0:
                formula = 0 = formula_false
                formula $in P
            case formula > 0:
                formula % 4 = 0 or formula % 4 = 1 or formula % 4 = 2 or formula % 4 = 3
                by cases:
                    ? formula $in P
                    case formula % 4 = 0:
                        formula_left_code(formula) < formula
                        formula_right_code(formula) < formula
                        formula_left_code(formula) $in P
                        formula_right_code(formula) $in P
                        formula_impl(formula_left_code(formula), formula_right_code(formula)) $in P
                        release thm formula_reconstruct_impl(formula)
                        formula_impl(formula_left_code(formula), formula_right_code(formula)) = formula
                        formula $in P
                    case formula % 4 = 1:
                        formula_var(natural_quarter(formula)) $in P
                        release thm formula_reconstruct_var(formula)
                        formula_var(natural_quarter(formula)) = formula
                        formula $in P
                    case formula % 4 = 2:
                        formula_left_code(formula) < formula
                        formula_right_code(formula) < formula
                        formula_left_code(formula) $in P
                        formula_right_code(formula) $in P
                        formula_conj(formula_left_code(formula), formula_right_code(formula)) $in P
                        release thm formula_reconstruct_conj(formula)
                        formula_conj(formula_left_code(formula), formula_right_code(formula)) = formula
                        formula $in P
                    case formula % 4 = 3:
                        formula_left_code(formula) < formula
                        formula_right_code(formula) < formula
                        formula_left_code(formula) $in P
                        formula_right_code(formula) $in P
                        formula_disj(formula_left_code(formula), formula_right_code(formula)) $in P
                        release thm formula_reconstruct_disj(formula)
                        formula_disj(formula_left_code(formula), formula_right_code(formula)) = formula
                        formula $in P
    release thm natural_strong_induction(P)

have fn formula_eval_step(formula N, valuation fn(input N) {0, 1}, left_eval, right_eval {0, 1}) {0, 1} by cases:
    case formula % 4 = 0: boolean_or(boolean_not(left_eval), right_eval)
    case formula % 4 = 1: valuation(natural_quarter(formula))
    case formula % 4 = 2: boolean_and(left_eval, right_eval)
    case formula % 4 = 3: boolean_or(left_eval, right_eval)

have fn formula_eval(formula N, valuation fn(idx N) {0, 1}) {0, 1} by induc formula from 0:
    case formula = 0: 0
    case formula > 0: formula_eval_step(formula, valuation, formula_eval(formula_left_code(formula), valuation), formula_eval(formula_right_code(formula), valuation))

thm formula_eval_var:
    ? forall idx N, valuation fn(input N) {0, 1}:
        formula_eval(formula_var(idx), valuation) = valuation(idx)
    formula_var(idx) = 4 * idx + 1 > 0
    release thm formula_var_tag(idx)
    release thm formula_quarter_var(idx)
    formula_eval(formula_var(idx), valuation) = formula_eval_step(formula_var(idx), valuation, formula_eval(formula_left_code(formula_var(idx)), valuation), formula_eval(formula_right_code(formula_var(idx)), valuation)) = valuation(natural_quarter(formula_var(idx))) = valuation(idx)

thm formula_eval_false:
    ? forall valuation fn(input N) {0, 1}:
        formula_eval(formula_false, valuation) = 0
    formula_false = 0
    formula_eval(formula_false, valuation) = formula_eval(0, valuation) = 0

thm formula_eval_conj:
    ? forall left, right N, valuation fn(input N) {0, 1}:
        formula_eval(formula_conj(left, right), valuation) = boolean_and(formula_eval(left, valuation), formula_eval(right, valuation))
    formula_conj(left, right) = 4 * code_pair0(left, right) + 2 > 0
    release thm formula_conj_tag(left, right)
    release thm formula_left_code_conj(left, right)
    release thm formula_right_code_conj(left, right)
    formula_eval(formula_conj(left, right), valuation) = formula_eval_step(formula_conj(left, right), valuation, formula_eval(formula_left_code(formula_conj(left, right)), valuation), formula_eval(formula_right_code(formula_conj(left, right)), valuation)) = boolean_and(formula_eval(formula_left_code(formula_conj(left, right)), valuation), formula_eval(formula_right_code(formula_conj(left, right)), valuation)) = boolean_and(formula_eval(left, valuation), formula_eval(right, valuation))

thm formula_eval_disj:
    ? forall left, right N, valuation fn(input N) {0, 1}:
        formula_eval(formula_disj(left, right), valuation) = boolean_or(formula_eval(left, valuation), formula_eval(right, valuation))
    formula_disj(left, right) = 4 * code_pair0(left, right) + 3 > 0
    release thm formula_disj_tag(left, right)
    release thm formula_left_code_disj(left, right)
    release thm formula_right_code_disj(left, right)
    formula_eval(formula_disj(left, right), valuation) = formula_eval_step(formula_disj(left, right), valuation, formula_eval(formula_left_code(formula_disj(left, right)), valuation), formula_eval(formula_right_code(formula_disj(left, right)), valuation)) = boolean_or(formula_eval(formula_left_code(formula_disj(left, right)), valuation), formula_eval(formula_right_code(formula_disj(left, right)), valuation)) = boolean_or(formula_eval(left, valuation), formula_eval(right, valuation))

thm formula_eval_impl:
    ? forall left, right N, valuation fn(input N) {0, 1}:
        formula_eval(formula_impl(left, right), valuation) = boolean_or(boolean_not(formula_eval(left, valuation)), formula_eval(right, valuation))
    formula_impl(left, right) = 4 * code_pair0(left, right) + 4 > 0
    release thm formula_impl_tag(left, right)
    release thm formula_left_code_impl(left, right)
    release thm formula_right_code_impl(left, right)
    formula_eval(formula_impl(left, right), valuation) = formula_eval_step(formula_impl(left, right), valuation, formula_eval(formula_left_code(formula_impl(left, right)), valuation), formula_eval(formula_right_code(formula_impl(left, right)), valuation)) = boolean_or(boolean_not(formula_eval(formula_left_code(formula_impl(left, right)), valuation)), formula_eval(formula_right_code(formula_impl(left, right)), valuation)) = boolean_or(boolean_not(formula_eval(left, valuation)), formula_eval(right, valuation))

have fn formula_vars_step(formula N, left_vars, right_vars power_set(N)) power_set(N) by cases:
    case formula % 4 = 0: union(left_vars, right_vars)
    case formula % 4 = 1: {natural_quarter(formula)}
    case formula % 4 = 2: union(left_vars, right_vars)
    case formula % 4 = 3: union(left_vars, right_vars)

have fn formula_vars(formula N) power_set(N) by induc formula from 0:
    case formula = 0: {}
    case formula > 0: formula_vars_step(formula, formula_vars(formula_left_code(formula)), formula_vars(formula_right_code(formula)))

thm formula_vars_var:
    ? forall idx N:
        formula_vars(formula_var(idx)) = {idx}
    formula_var(idx) = 4 * idx + 1 > 0
    release thm formula_var_tag(idx)
    release thm formula_quarter_var(idx)
    formula_vars(formula_var(idx)) = formula_vars_step(formula_var(idx), formula_vars(formula_left_code(formula_var(idx))), formula_vars(formula_right_code(formula_var(idx)))) = {natural_quarter(formula_var(idx))} = {idx}

claim:
    ? formula_vars(formula_false) = {}
    formula_false = 0
    formula_vars(formula_false) = formula_vars(0) = {}

thm formula_vars_conj:
    ? forall left, right N:
        formula_vars(formula_conj(left, right)) = union(formula_vars(left), formula_vars(right))
    formula_conj(left, right) = 4 * code_pair0(left, right) + 2 > 0
    release thm formula_conj_tag(left, right)
    release thm formula_left_code_conj(left, right)
    release thm formula_right_code_conj(left, right)
    formula_vars(formula_conj(left, right)) = formula_vars_step(formula_conj(left, right), formula_vars(formula_left_code(formula_conj(left, right))), formula_vars(formula_right_code(formula_conj(left, right)))) = union(formula_vars(formula_left_code(formula_conj(left, right))), formula_vars(formula_right_code(formula_conj(left, right)))) = union(formula_vars(left), formula_vars(right))

thm formula_vars_disj:
    ? forall left, right N:
        formula_vars(formula_disj(left, right)) = union(formula_vars(left), formula_vars(right))
    formula_disj(left, right) = 4 * code_pair0(left, right) + 3 > 0
    release thm formula_disj_tag(left, right)
    release thm formula_left_code_disj(left, right)
    release thm formula_right_code_disj(left, right)
    formula_vars(formula_disj(left, right)) = formula_vars_step(formula_disj(left, right), formula_vars(formula_left_code(formula_disj(left, right))), formula_vars(formula_right_code(formula_disj(left, right)))) = union(formula_vars(formula_left_code(formula_disj(left, right))), formula_vars(formula_right_code(formula_disj(left, right)))) = union(formula_vars(left), formula_vars(right))

thm formula_vars_impl:
    ? forall left, right N:
        formula_vars(formula_impl(left, right)) = union(formula_vars(left), formula_vars(right))
    formula_impl(left, right) = 4 * code_pair0(left, right) + 4 > 0
    release thm formula_impl_tag(left, right)
    release thm formula_left_code_impl(left, right)
    release thm formula_right_code_impl(left, right)
    formula_vars(formula_impl(left, right)) = formula_vars_step(formula_impl(left, right), formula_vars(formula_left_code(formula_impl(left, right))), formula_vars(formula_right_code(formula_impl(left, right)))) = union(formula_vars(formula_left_code(formula_impl(left, right))), formula_vars(formula_right_code(formula_impl(left, right)))) = union(formula_vars(left), formula_vars(right))

thm formula_vars_finite:
    ? forall formula N:
        $is_finite_set(formula_vars(formula))
    prop finite_formula_variables(candidate N):
        $is_finite_set(formula_vars(candidate))
    claim:
        ? forall idx N:
            formula_var(idx) $in {candidate N: $finite_formula_variables(candidate)}
        release thm formula_vars_var(idx)
        $is_finite_set({idx})
        $is_finite_set(formula_vars(formula_var(idx)))
        by def $finite_formula_variables(formula_var(idx))
        formula_var(idx) $in {candidate N: $finite_formula_variables(candidate)}
    claim:
        ? formula_false $in {candidate N: $finite_formula_variables(candidate)}
        formula_vars(formula_false) = {}
        $is_finite_set({})
        $is_finite_set(formula_vars(formula_false))
        by def $finite_formula_variables(formula_false)
        formula_false $in {candidate N: $finite_formula_variables(candidate)}
    claim:
        ? forall left, right N:
            left $in {candidate N: $finite_formula_variables(candidate)}
            right $in {candidate N: $finite_formula_variables(candidate)}
            =>:
                formula_conj(left, right) $in {candidate N: $finite_formula_variables(candidate)}
                formula_disj(left, right) $in {candidate N: $finite_formula_variables(candidate)}
                formula_impl(left, right) $in {candidate N: $finite_formula_variables(candidate)}
        by def $finite_formula_variables(left)
        by def $finite_formula_variables(right)
        $is_finite_set(union(formula_vars(left), formula_vars(right)))
        release thm formula_vars_conj(left, right)
        $is_finite_set(formula_vars(formula_conj(left, right)))
        by def $finite_formula_variables(formula_conj(left, right))
        formula_conj(left, right) $in {candidate N: $finite_formula_variables(candidate)}
        release thm formula_vars_disj(left, right)
        $is_finite_set(formula_vars(formula_disj(left, right)))
        by def $finite_formula_variables(formula_disj(left, right))
        formula_disj(left, right) $in {candidate N: $finite_formula_variables(candidate)}
        release thm formula_vars_impl(left, right)
        $is_finite_set(formula_vars(formula_impl(left, right)))
        by def $finite_formula_variables(formula_impl(left, right))
        formula_impl(left, right) $in {candidate N: $finite_formula_variables(candidate)}
    release thm formula_induction({candidate N: $finite_formula_variables(candidate)})
    {candidate N: $finite_formula_variables(candidate)} = N
    formula $in N
    formula $in {candidate N: $finite_formula_variables(candidate)}
    by def $finite_formula_variables(formula)
    $finite_formula_variables(formula)

have fn formula_var_subst_step(formula, target_idx, repl N) N by cases:
    case natural_quarter(formula) = target_idx: repl
    case natural_quarter(formula) != target_idx: formula_var(natural_quarter(formula))

have fn formula_subst_step(formula, target_idx, repl, left_subst, right_subst N) N by cases:
    case formula % 4 = 0: formula_impl(left_subst, right_subst)
    case formula % 4 = 1: formula_var_subst_step(formula, target_idx, repl)
    case formula % 4 = 2: formula_conj(left_subst, right_subst)
    case formula % 4 = 3: formula_disj(left_subst, right_subst)

have fn formula_subst(formula, target_idx, repl N) N by induc formula from 0:
    case formula = 0: formula_false
    case formula > 0: formula_subst_step(formula, target_idx, repl, formula_subst(formula_left_code(formula), target_idx, repl), formula_subst(formula_right_code(formula), target_idx, repl))

thm formula_subst_var_eq:
    ? forall source_idx, target_idx N, repl N:
        source_idx = target_idx
        =>:
            formula_subst(formula_var(source_idx), target_idx, repl) = repl
    formula_var(source_idx) = 4 * source_idx + 1 > 0
    release thm formula_var_tag(source_idx)
    release thm formula_quarter_var(source_idx)
    formula_var_subst_step(formula_var(source_idx), target_idx, repl) = repl
    formula_subst(formula_var(source_idx), target_idx, repl) = formula_subst_step(formula_var(source_idx), target_idx, repl, formula_subst(formula_left_code(formula_var(source_idx)), target_idx, repl), formula_subst(formula_right_code(formula_var(source_idx)), target_idx, repl)) = formula_var_subst_step(formula_var(source_idx), target_idx, repl) = repl

thm formula_subst_var_ne:
    ? forall source_idx, target_idx N, repl N:
        source_idx != target_idx
        =>:
            formula_subst(formula_var(source_idx), target_idx, repl) = formula_var(source_idx)
    formula_var(source_idx) = 4 * source_idx + 1 > 0
    release thm formula_var_tag(source_idx)
    release thm formula_quarter_var(source_idx)
    formula_var_subst_step(formula_var(source_idx), target_idx, repl) = formula_var(natural_quarter(formula_var(source_idx))) = formula_var(source_idx)
    formula_subst(formula_var(source_idx), target_idx, repl) = formula_subst_step(formula_var(source_idx), target_idx, repl, formula_subst(formula_left_code(formula_var(source_idx)), target_idx, repl), formula_subst(formula_right_code(formula_var(source_idx)), target_idx, repl)) = formula_var_subst_step(formula_var(source_idx), target_idx, repl) = formula_var(source_idx)

thm formula_subst_false:
    ? forall target_idx N, repl N:
        formula_subst(formula_false, target_idx, repl) = formula_false
    formula_false = 0
    formula_subst(formula_false, target_idx, repl) = formula_subst(0, target_idx, repl) = formula_false

thm formula_subst_conj:
    ? forall left, right N, target_idx N, repl N:
        formula_subst(formula_conj(left, right), target_idx, repl) = formula_conj(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))
    formula_conj(left, right) = 4 * code_pair0(left, right) + 2 > 0
    release thm formula_conj_tag(left, right)
    release thm formula_left_code_conj(left, right)
    release thm formula_right_code_conj(left, right)
    formula_subst(formula_conj(left, right), target_idx, repl) = formula_subst_step(formula_conj(left, right), target_idx, repl, formula_subst(formula_left_code(formula_conj(left, right)), target_idx, repl), formula_subst(formula_right_code(formula_conj(left, right)), target_idx, repl)) = formula_conj(formula_subst(formula_left_code(formula_conj(left, right)), target_idx, repl), formula_subst(formula_right_code(formula_conj(left, right)), target_idx, repl)) = formula_conj(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))

thm formula_subst_disj:
    ? forall left, right N, target_idx N, repl N:
        formula_subst(formula_disj(left, right), target_idx, repl) = formula_disj(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))
    formula_disj(left, right) = 4 * code_pair0(left, right) + 3 > 0
    release thm formula_disj_tag(left, right)
    release thm formula_left_code_disj(left, right)
    release thm formula_right_code_disj(left, right)
    formula_subst(formula_disj(left, right), target_idx, repl) = formula_subst_step(formula_disj(left, right), target_idx, repl, formula_subst(formula_left_code(formula_disj(left, right)), target_idx, repl), formula_subst(formula_right_code(formula_disj(left, right)), target_idx, repl)) = formula_disj(formula_subst(formula_left_code(formula_disj(left, right)), target_idx, repl), formula_subst(formula_right_code(formula_disj(left, right)), target_idx, repl)) = formula_disj(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))

thm formula_subst_impl:
    ? forall left, right N, target_idx N, repl N:
        formula_subst(formula_impl(left, right), target_idx, repl) = formula_impl(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))
    formula_impl(left, right) = 4 * code_pair0(left, right) + 4 > 0
    release thm formula_impl_tag(left, right)
    release thm formula_left_code_impl(left, right)
    release thm formula_right_code_impl(left, right)
    formula_subst(formula_impl(left, right), target_idx, repl) = formula_subst_step(formula_impl(left, right), target_idx, repl, formula_subst(formula_left_code(formula_impl(left, right)), target_idx, repl), formula_subst(formula_right_code(formula_impl(left, right)), target_idx, repl)) = formula_impl(formula_subst(formula_left_code(formula_impl(left, right)), target_idx, repl), formula_subst(formula_right_code(formula_impl(left, right)), target_idx, repl)) = formula_impl(formula_subst(left, target_idx, repl), formula_subst(right, target_idx, repl))

# Source theorem family for evaluation agreement and substitution.
thm formula_eval_eq_eval:
    ? forall formula N, valuation1, valuation2 fn(input N) {0, 1}:
        forall idx N:
            idx $in formula_vars(formula)
            =>:
                valuation1(idx) = valuation2(idx)
        =>:
            formula_eval(formula, valuation1) = formula_eval(formula, valuation2)
    prop evaluation_agrees(candidate N):
        forall first, second fn(input N) {0, 1}:
            forall idx N:
                idx $in formula_vars(candidate)
                =>:
                    first(idx) = second(idx)
            =>:
                formula_eval(candidate, first) = formula_eval(candidate, second)
    claim:
        ? forall source N:
            formula_var(source) $in {candidate N: $evaluation_agrees(candidate)}
        claim:
            ? forall first, second fn(input N) {0, 1}:
                forall idx N:
                    idx $in formula_vars(formula_var(source))
                    =>:
                        first(idx) = second(idx)
                =>:
                    formula_eval(formula_var(source), first) = formula_eval(formula_var(source), second)
            release thm formula_vars_var(source)
            source $in {source}
            source $in formula_vars(formula_var(source))
            first(source) = second(source)
            release thm formula_eval_var(source, first)
            release thm formula_eval_var(source, second)
            formula_eval(formula_var(source), first) = first(source) = second(source) = formula_eval(formula_var(source), second)
        by def $evaluation_agrees(formula_var(source))
        formula_var(source) $in {candidate N: $evaluation_agrees(candidate)}
    claim:
        ? formula_false $in {candidate N: $evaluation_agrees(candidate)}
        claim:
            ? forall first, second fn(input N) {0, 1}:
                forall idx N:
                    idx $in formula_vars(formula_false)
                    =>:
                        first(idx) = second(idx)
                =>:
                    formula_eval(formula_false, first) = formula_eval(formula_false, second)
            release thm formula_eval_false(first)
            release thm formula_eval_false(second)
            formula_eval(formula_false, first) = 0 = formula_eval(formula_false, second)
        by def $evaluation_agrees(formula_false)
        formula_false $in {candidate N: $evaluation_agrees(candidate)}
    claim:
        ? forall left, right N:
            left $in {candidate N: $evaluation_agrees(candidate)}
            right $in {candidate N: $evaluation_agrees(candidate)}
            =>:
                formula_conj(left, right) $in {candidate N: $evaluation_agrees(candidate)}
                formula_disj(left, right) $in {candidate N: $evaluation_agrees(candidate)}
                formula_impl(left, right) $in {candidate N: $evaluation_agrees(candidate)}
        by def $evaluation_agrees(left)
        by def $evaluation_agrees(right)
        claim:
            ? formula_conj(left, right) $in {candidate N: $evaluation_agrees(candidate)}
            claim:
                ? forall first, second fn(input N) {0, 1}:
                    forall idx N:
                        idx $in formula_vars(formula_conj(left, right))
                        =>:
                            first(idx) = second(idx)
                    =>:
                        formula_eval(formula_conj(left, right), first) = formula_eval(formula_conj(left, right), second)
                release thm formula_vars_conj(left, right)
                claim:
                    ? forall idx N:
                        idx $in formula_vars(left)
                        =>:
                            first(idx) = second(idx)
                    idx $in union(formula_vars(left), formula_vars(right))
                    idx $in formula_vars(formula_conj(left, right))
                    first(idx) = second(idx)
                claim:
                    ? forall idx N:
                        idx $in formula_vars(right)
                        =>:
                            first(idx) = second(idx)
                    idx $in union(formula_vars(left), formula_vars(right))
                    idx $in formula_vars(formula_conj(left, right))
                    first(idx) = second(idx)
                formula_eval(left, first) = formula_eval(left, second)
                formula_eval(right, first) = formula_eval(right, second)
                release thm formula_eval_conj(left, right, first)
                release thm formula_eval_conj(left, right, second)
                formula_eval(formula_conj(left, right), first) = boolean_and(formula_eval(left, first), formula_eval(right, first)) = boolean_and(formula_eval(left, second), formula_eval(right, second)) = formula_eval(formula_conj(left, right), second)
            by def $evaluation_agrees(formula_conj(left, right))
            formula_conj(left, right) $in {candidate N: $evaluation_agrees(candidate)}
        claim:
            ? formula_disj(left, right) $in {candidate N: $evaluation_agrees(candidate)}
            claim:
                ? forall first, second fn(input N) {0, 1}:
                    forall idx N:
                        idx $in formula_vars(formula_disj(left, right))
                        =>:
                            first(idx) = second(idx)
                    =>:
                        formula_eval(formula_disj(left, right), first) = formula_eval(formula_disj(left, right), second)
                release thm formula_vars_disj(left, right)
                claim:
                    ? forall idx N:
                        idx $in formula_vars(left)
                        =>:
                            first(idx) = second(idx)
                    idx $in union(formula_vars(left), formula_vars(right))
                    idx $in formula_vars(formula_disj(left, right))
                    first(idx) = second(idx)
                claim:
                    ? forall idx N:
                        idx $in formula_vars(right)
                        =>:
                            first(idx) = second(idx)
                    idx $in union(formula_vars(left), formula_vars(right))
                    idx $in formula_vars(formula_disj(left, right))
                    first(idx) = second(idx)
                formula_eval(left, first) = formula_eval(left, second)
                formula_eval(right, first) = formula_eval(right, second)
                release thm formula_eval_disj(left, right, first)
                release thm formula_eval_disj(left, right, second)
                formula_eval(formula_disj(left, right), first) = boolean_or(formula_eval(left, first), formula_eval(right, first)) = boolean_or(formula_eval(left, second), formula_eval(right, second)) = formula_eval(formula_disj(left, right), second)
            by def $evaluation_agrees(formula_disj(left, right))
            formula_disj(left, right) $in {candidate N: $evaluation_agrees(candidate)}
        claim:
            ? formula_impl(left, right) $in {candidate N: $evaluation_agrees(candidate)}
            claim:
                ? forall first, second fn(input N) {0, 1}:
                    forall idx N:
                        idx $in formula_vars(formula_impl(left, right))
                        =>:
                            first(idx) = second(idx)
                    =>:
                        formula_eval(formula_impl(left, right), first) = formula_eval(formula_impl(left, right), second)
                release thm formula_vars_impl(left, right)
                claim:
                    ? forall idx N:
                        idx $in formula_vars(left)
                        =>:
                            first(idx) = second(idx)
                    idx $in union(formula_vars(left), formula_vars(right))
                    idx $in formula_vars(formula_impl(left, right))
                    first(idx) = second(idx)
                claim:
                    ? forall idx N:
                        idx $in formula_vars(right)
                        =>:
                            first(idx) = second(idx)
                    idx $in union(formula_vars(left), formula_vars(right))
                    idx $in formula_vars(formula_impl(left, right))
                    first(idx) = second(idx)
                formula_eval(left, first) = formula_eval(left, second)
                formula_eval(right, first) = formula_eval(right, second)
                release thm formula_eval_impl(left, right, first)
                release thm formula_eval_impl(left, right, second)
                formula_eval(formula_impl(left, right), first) = boolean_or(boolean_not(formula_eval(left, first)), formula_eval(right, first)) = boolean_or(boolean_not(formula_eval(left, second)), formula_eval(right, second)) = formula_eval(formula_impl(left, right), second)
            by def $evaluation_agrees(formula_impl(left, right))
            formula_impl(left, right) $in {candidate N: $evaluation_agrees(candidate)}
    release thm formula_induction({candidate N: $evaluation_agrees(candidate)})
    {candidate N: $evaluation_agrees(candidate)} = N
    formula $in N
    formula $in {candidate N: $evaluation_agrees(candidate)}
    by def $evaluation_agrees(formula)
    $evaluation_agrees(formula)

thm formula_subst_eq_of_not_mem_vars:
    ? forall formula N, target_index N, replacement_formula N:
        not target_index $in formula_vars(formula)
        =>:
            formula_subst(formula, target_index, replacement_formula) = formula
    prop substitution_absent(candidate N):
        forall query_index, substitution_formula N:
            not query_index $in formula_vars(candidate)
            =>:
                formula_subst(candidate, query_index, substitution_formula) = candidate
    claim:
        ? forall source N:
            formula_var(source) $in {candidate N: $substitution_absent(candidate)}
        claim:
            ? forall query_index, substitution_formula N:
                not query_index $in formula_vars(formula_var(source))
                =>:
                    formula_subst(formula_var(source), query_index, substitution_formula) = formula_var(source)
            release thm formula_vars_var(source)
            source = query_index or source != query_index
            by cases:
                ? formula_subst(formula_var(source), query_index, substitution_formula) = formula_var(source)
                case source = query_index:
                    query_index $in {source}
                    query_index $in formula_vars(formula_var(source))
                    impossible not query_index $in formula_vars(formula_var(source))
                case source != query_index:
                    release thm formula_subst_var_ne(source, query_index, substitution_formula)
        by def $substitution_absent(formula_var(source))
        formula_var(source) $in {candidate N: $substitution_absent(candidate)}
    claim:
        ? formula_false $in {candidate N: $substitution_absent(candidate)}
        claim:
            ? forall query_index, substitution_formula N:
                not query_index $in formula_vars(formula_false)
                =>:
                    formula_subst(formula_false, query_index, substitution_formula) = formula_false
            release thm formula_subst_false(query_index, substitution_formula)
        by def $substitution_absent(formula_false)
        formula_false $in {candidate N: $substitution_absent(candidate)}
    claim:
        ? forall left, right N:
            left $in {candidate N: $substitution_absent(candidate)}
            right $in {candidate N: $substitution_absent(candidate)}
            =>:
                formula_conj(left, right) $in {candidate N: $substitution_absent(candidate)}
                formula_disj(left, right) $in {candidate N: $substitution_absent(candidate)}
                formula_impl(left, right) $in {candidate N: $substitution_absent(candidate)}
        by def $substitution_absent(left)
        by def $substitution_absent(right)
        claim:
            ? formula_conj(left, right) $in {candidate N: $substitution_absent(candidate)}
            claim:
                ? forall query_index, substitution_formula N:
                    not query_index $in formula_vars(formula_conj(left, right))
                    =>:
                        formula_subst(formula_conj(left, right), query_index, substitution_formula) = formula_conj(left, right)
                release thm formula_vars_conj(left, right)
                claim:
                    ? not query_index $in formula_vars(left)
                    by contra:
                        ? not query_index $in formula_vars(left)
                        query_index $in union(formula_vars(left), formula_vars(right))
                        query_index $in formula_vars(formula_conj(left, right))
                        impossible not query_index $in formula_vars(formula_conj(left, right))
                claim:
                    ? not query_index $in formula_vars(right)
                    by contra:
                        ? not query_index $in formula_vars(right)
                        query_index $in union(formula_vars(left), formula_vars(right))
                        query_index $in formula_vars(formula_conj(left, right))
                        impossible not query_index $in formula_vars(formula_conj(left, right))
                formula_subst(left, query_index, substitution_formula) = left
                formula_subst(right, query_index, substitution_formula) = right
                release thm formula_subst_conj(left, right, query_index, substitution_formula)
                formula_subst(formula_conj(left, right), query_index, substitution_formula) = formula_conj(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula)) = formula_conj(left, right)
            by def $substitution_absent(formula_conj(left, right))
            formula_conj(left, right) $in {candidate N: $substitution_absent(candidate)}
        claim:
            ? formula_disj(left, right) $in {candidate N: $substitution_absent(candidate)}
            claim:
                ? forall query_index, substitution_formula N:
                    not query_index $in formula_vars(formula_disj(left, right))
                    =>:
                        formula_subst(formula_disj(left, right), query_index, substitution_formula) = formula_disj(left, right)
                release thm formula_vars_disj(left, right)
                claim:
                    ? not query_index $in formula_vars(left)
                    by contra:
                        ? not query_index $in formula_vars(left)
                        query_index $in union(formula_vars(left), formula_vars(right))
                        query_index $in formula_vars(formula_disj(left, right))
                        impossible not query_index $in formula_vars(formula_disj(left, right))
                claim:
                    ? not query_index $in formula_vars(right)
                    by contra:
                        ? not query_index $in formula_vars(right)
                        query_index $in union(formula_vars(left), formula_vars(right))
                        query_index $in formula_vars(formula_disj(left, right))
                        impossible not query_index $in formula_vars(formula_disj(left, right))
                formula_subst(left, query_index, substitution_formula) = left
                formula_subst(right, query_index, substitution_formula) = right
                release thm formula_subst_disj(left, right, query_index, substitution_formula)
                formula_subst(formula_disj(left, right), query_index, substitution_formula) = formula_disj(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula)) = formula_disj(left, right)
            by def $substitution_absent(formula_disj(left, right))
            formula_disj(left, right) $in {candidate N: $substitution_absent(candidate)}
        claim:
            ? formula_impl(left, right) $in {candidate N: $substitution_absent(candidate)}
            claim:
                ? forall query_index, substitution_formula N:
                    not query_index $in formula_vars(formula_impl(left, right))
                    =>:
                        formula_subst(formula_impl(left, right), query_index, substitution_formula) = formula_impl(left, right)
                release thm formula_vars_impl(left, right)
                claim:
                    ? not query_index $in formula_vars(left)
                    by contra:
                        ? not query_index $in formula_vars(left)
                        query_index $in union(formula_vars(left), formula_vars(right))
                        query_index $in formula_vars(formula_impl(left, right))
                        impossible not query_index $in formula_vars(formula_impl(left, right))
                claim:
                    ? not query_index $in formula_vars(right)
                    by contra:
                        ? not query_index $in formula_vars(right)
                        query_index $in union(formula_vars(left), formula_vars(right))
                        query_index $in formula_vars(formula_impl(left, right))
                        impossible not query_index $in formula_vars(formula_impl(left, right))
                formula_subst(left, query_index, substitution_formula) = left
                formula_subst(right, query_index, substitution_formula) = right
                release thm formula_subst_impl(left, right, query_index, substitution_formula)
                formula_subst(formula_impl(left, right), query_index, substitution_formula) = formula_impl(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula)) = formula_impl(left, right)
            by def $substitution_absent(formula_impl(left, right))
            formula_impl(left, right) $in {candidate N: $substitution_absent(candidate)}
    release thm formula_induction({candidate N: $substitution_absent(candidate)})
    {candidate N: $substitution_absent(candidate)} = N
    formula $in N
    formula $in {candidate N: $substitution_absent(candidate)}
    by def $substitution_absent(formula)
    $substitution_absent(formula)

thm formula_subst_eval_eq:
    ? forall formula N, target_index N, replacement_formula N, valuation fn(input N) {0, 1}:
        formula_eval(formula_subst(formula, target_index, replacement_formula), valuation) = formula_eval(formula, \updated_boolean_valuation<valuation, target_index, formula_eval(replacement_formula, valuation)>)
    prop substitution_evaluation(candidate N):
        forall query_index N, substitution_formula N, candidate_valuation fn(input N) {0, 1}:
            formula_eval(formula_subst(candidate, query_index, substitution_formula), candidate_valuation) = formula_eval(candidate, \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
    claim:
        ? forall source N:
            formula_var(source) $in {candidate N: $substitution_evaluation(candidate)}
        claim:
            ? forall query_index N, substitution_formula N, candidate_valuation fn(input N) {0, 1}:
                formula_eval(formula_subst(formula_var(source), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_var(source), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
            let updated_valuation = \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>
            source = query_index or source != query_index
            by cases:
                ? formula_eval(formula_subst(formula_var(source), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_var(source), updated_valuation)
                case source = query_index:
                    release thm formula_subst_var_eq(source, query_index, substitution_formula)
                    release thm formula_eval_var(source, updated_valuation)
                    updated_valuation(source) = formula_eval(substitution_formula, candidate_valuation)
                    formula_eval(formula_subst(formula_var(source), query_index, substitution_formula), candidate_valuation) = formula_eval(substitution_formula, candidate_valuation) = updated_valuation(source) = formula_eval(formula_var(source), updated_valuation)
                case source != query_index:
                    release thm formula_subst_var_ne(source, query_index, substitution_formula)
                    release thm formula_eval_var(source, candidate_valuation)
                    release thm formula_eval_var(source, updated_valuation)
                    updated_valuation(source) = candidate_valuation(source)
                    formula_eval(formula_subst(formula_var(source), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_var(source), candidate_valuation) = candidate_valuation(source) = updated_valuation(source) = formula_eval(formula_var(source), updated_valuation)
            formula_eval(formula_subst(formula_var(source), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_var(source), updated_valuation) = formula_eval(formula_var(source), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
        by def $substitution_evaluation(formula_var(source))
        formula_var(source) $in {candidate N: $substitution_evaluation(candidate)}
    claim:
        ? formula_false $in {candidate N: $substitution_evaluation(candidate)}
        claim:
            ? forall query_index N, substitution_formula N, candidate_valuation fn(input N) {0, 1}:
                formula_eval(formula_subst(formula_false, query_index, substitution_formula), candidate_valuation) = formula_eval(formula_false, \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
            let updated_valuation = \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>
            release thm formula_subst_false(query_index, substitution_formula)
            release thm formula_eval_false(candidate_valuation)
            release thm formula_eval_false(updated_valuation)
            formula_eval(formula_subst(formula_false, query_index, substitution_formula), candidate_valuation) = formula_eval(formula_false, candidate_valuation) = 0 = formula_eval(formula_false, updated_valuation)
            formula_eval(formula_subst(formula_false, query_index, substitution_formula), candidate_valuation) = formula_eval(formula_false, updated_valuation) = formula_eval(formula_false, \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
        by def $substitution_evaluation(formula_false)
        formula_false $in {candidate N: $substitution_evaluation(candidate)}
    claim:
        ? forall left, right N:
            left $in {candidate N: $substitution_evaluation(candidate)}
            right $in {candidate N: $substitution_evaluation(candidate)}
            =>:
                formula_conj(left, right) $in {candidate N: $substitution_evaluation(candidate)}
                formula_disj(left, right) $in {candidate N: $substitution_evaluation(candidate)}
                formula_impl(left, right) $in {candidate N: $substitution_evaluation(candidate)}
        by def $substitution_evaluation(left)
        by def $substitution_evaluation(right)
        claim:
            ? formula_conj(left, right) $in {candidate N: $substitution_evaluation(candidate)}
            claim:
                ? forall query_index N, substitution_formula N, candidate_valuation fn(input N) {0, 1}:
                    formula_eval(formula_subst(formula_conj(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_conj(left, right), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
                let updated_valuation = \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>
                formula_eval(formula_subst(left, query_index, substitution_formula), candidate_valuation) = formula_eval(left, updated_valuation)
                formula_eval(formula_subst(right, query_index, substitution_formula), candidate_valuation) = formula_eval(right, updated_valuation)
                release thm formula_subst_conj(left, right, query_index, substitution_formula)
                release thm formula_eval_conj(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula), candidate_valuation)
                release thm formula_eval_conj(left, right, updated_valuation)
                formula_eval(formula_subst(formula_conj(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_conj(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula)), candidate_valuation) = boolean_and(formula_eval(formula_subst(left, query_index, substitution_formula), candidate_valuation), formula_eval(formula_subst(right, query_index, substitution_formula), candidate_valuation)) = boolean_and(formula_eval(left, updated_valuation), formula_eval(right, updated_valuation)) = formula_eval(formula_conj(left, right), updated_valuation)
                formula_eval(formula_subst(formula_conj(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_conj(left, right), updated_valuation) = formula_eval(formula_conj(left, right), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
            by def $substitution_evaluation(formula_conj(left, right))
            formula_conj(left, right) $in {candidate N: $substitution_evaluation(candidate)}
        claim:
            ? formula_disj(left, right) $in {candidate N: $substitution_evaluation(candidate)}
            claim:
                ? forall query_index N, substitution_formula N, candidate_valuation fn(input N) {0, 1}:
                    formula_eval(formula_subst(formula_disj(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_disj(left, right), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
                let updated_valuation = \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>
                formula_eval(formula_subst(left, query_index, substitution_formula), candidate_valuation) = formula_eval(left, updated_valuation)
                formula_eval(formula_subst(right, query_index, substitution_formula), candidate_valuation) = formula_eval(right, updated_valuation)
                release thm formula_subst_disj(left, right, query_index, substitution_formula)
                release thm formula_eval_disj(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula), candidate_valuation)
                release thm formula_eval_disj(left, right, updated_valuation)
                formula_eval(formula_subst(formula_disj(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_disj(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula)), candidate_valuation) = boolean_or(formula_eval(formula_subst(left, query_index, substitution_formula), candidate_valuation), formula_eval(formula_subst(right, query_index, substitution_formula), candidate_valuation)) = boolean_or(formula_eval(left, updated_valuation), formula_eval(right, updated_valuation)) = formula_eval(formula_disj(left, right), updated_valuation)
                formula_eval(formula_subst(formula_disj(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_disj(left, right), updated_valuation) = formula_eval(formula_disj(left, right), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
            by def $substitution_evaluation(formula_disj(left, right))
            formula_disj(left, right) $in {candidate N: $substitution_evaluation(candidate)}
        claim:
            ? formula_impl(left, right) $in {candidate N: $substitution_evaluation(candidate)}
            claim:
                ? forall query_index N, substitution_formula N, candidate_valuation fn(input N) {0, 1}:
                    formula_eval(formula_subst(formula_impl(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_impl(left, right), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
                let updated_valuation = \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>
                formula_eval(formula_subst(left, query_index, substitution_formula), candidate_valuation) = formula_eval(left, updated_valuation)
                formula_eval(formula_subst(right, query_index, substitution_formula), candidate_valuation) = formula_eval(right, updated_valuation)
                release thm formula_subst_impl(left, right, query_index, substitution_formula)
                release thm formula_eval_impl(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula), candidate_valuation)
                release thm formula_eval_impl(left, right, updated_valuation)
                formula_eval(formula_subst(formula_impl(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_impl(formula_subst(left, query_index, substitution_formula), formula_subst(right, query_index, substitution_formula)), candidate_valuation) = boolean_or(boolean_not(formula_eval(formula_subst(left, query_index, substitution_formula), candidate_valuation)), formula_eval(formula_subst(right, query_index, substitution_formula), candidate_valuation)) = boolean_or(boolean_not(formula_eval(left, updated_valuation)), formula_eval(right, updated_valuation)) = formula_eval(formula_impl(left, right), updated_valuation)
                formula_eval(formula_subst(formula_impl(left, right), query_index, substitution_formula), candidate_valuation) = formula_eval(formula_impl(left, right), updated_valuation) = formula_eval(formula_impl(left, right), \updated_boolean_valuation<candidate_valuation, query_index, formula_eval(substitution_formula, candidate_valuation)>)
            by def $substitution_evaluation(formula_impl(left, right))
            formula_impl(left, right) $in {candidate N: $substitution_evaluation(candidate)}
    release thm formula_induction({candidate N: $substitution_evaluation(candidate)})
    {candidate N: $substitution_evaluation(candidate)} = N
    formula $in N
    formula $in {candidate N: $substitution_evaluation(candidate)}
    by def $substitution_evaluation(formula)
    $substitution_evaluation(formula)
