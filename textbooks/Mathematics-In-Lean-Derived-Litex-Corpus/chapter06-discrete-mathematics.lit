# Chapter 6 — Discrete Mathematics
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/blocked status.

# Only source definitions, principal mathematical results, and the constructors
# needed to use them are retained. Repeated tactic presentations are collapsed.

# 6.1 Finsets and Fintypes

# Source definition: example1. A finite set is unordered and has no duplicate
# elements; later source spelling variants are presentation examples only.
have finite_set_example finite_set = {0, 1, 2}

# Source definition: f. The source function is integer-valued and remains
# callable instead of being replaced by a predicate about squares.
have fn square_int(n N) Z = n^2

# The source identifies cardinality with a sum of ones. This is checked by the
# finite constant-sum rule.
thm finite_set_card_as_sum_ones:
    ? forall A finite_set:
        finite_set_size(A) = finite_set_sum(A, fn(x A) N {1})
    finite_set_sum(A, fn(x A) N {1}) = finite_set_size(A) * 1 = finite_set_size(A)

# 6.2 Counting Arguments

# The first counting formulas are direct finite-set cardinality laws.
thm card_cartesian_product:
    ? forall A, B finite_set:
        finite_set_size(cart(A, B)) = finite_set_size(A) * finite_set_size(B)
    finite_set_size(cart(A, B)) = finite_set_size(A) * finite_set_size(B)

thm card_union_inclusion_exclusion:
    ? forall A, B finite_set:
        finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B))
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B))

# Disjointness is a relation between two candidate sets, so this is correctly a
# prop. The following named result is a fact, not another proposition wrapper.
prop disjoint_sets(A, B set):
    intersect(A, B) = {}

thm card_union_of_disjoint:
    ? forall A, B finite_set:
        $disjoint_sets(A, B)
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    intersect(A, B) = {}
    finite_set_size(intersect(A, B)) = finite_set_size({}) = 0
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B)) = finite_set_size(A) + finite_set_size(B)

# Source definition: triangle. Delete pairs whose first coordinate is at least
# their second from the finite Cartesian square. The dependent codomain keeps
# triangle callable and records its exact finite ambient carrier.
have fn triangle(n N) power_set(cart(range(0, n + 1), range(0, n + 1))) = set_minus(cart(range(0, n + 1), range(0, n + 1)), {p cart(range(0, n + 1), range(0, n + 1)): p[1] >= p[2]})

thm triangle_is_finite:
    ? forall n N:
        $is_finite_set(triangle(n))
    triangle(n) = set_minus(cart(range(0, n + 1), range(0, n + 1)), {p cart(range(0, n + 1), range(0, n + 1)): p[1] >= p[2]})
    $is_finite_set(set_minus(cart(range(0, n + 1), range(0, n + 1)), {p cart(range(0, n + 1), range(0, n + 1)): p[1] >= p[2]}))

# 6.3 Inductive Structures

# Litex does not yet declare user-defined inductive carrier families. The
# reusable interface therefore keeps the element carrier A and the list carrier
# L explicit. ListCore packages the callable constructors and their structural
# induction principle; no nullary prop is used as a fake list object.
struct ListCore<A set, L nonempty_set>:
    nil L
    cons fn(a A, xs L) L
    <=>:
        forall P power_set(L):
            nil $in P
            forall a A, xs L:
                xs $in P
                =>:
                    cons(a, xs) $in P
            =>:
                P = L

# Source definition: append. is_list_append is a property of a candidate
# callable function; list_append is the corresponding selected function.
prop is_list_append(A set, L nonempty_set, core &ListCore<A, L>, append fn(xs, ys L) L):
    forall ys L:
        append(&ListCore<A, L>{core}.nil, ys) = ys
    forall a A, xs, ys L:
        append(&ListCore<A, L>{core}.cons(a, xs), ys) = &ListCore<A, L>{core}.cons(a, append(xs, ys))

# Source definition: map. Its domain and codomain list carriers remain
# independent, exactly as in List.map.
prop is_list_map(A, B set, L_A, L_B nonempty_set, core_A &ListCore<A, L_A>, core_B &ListCore<B, L_B>, f fn(x A) B, map_fn fn(xs L_A) L_B):
    map_fn(&ListCore<A, L_A>{core_A}.nil) = &ListCore<B, L_B>{core_B}.nil
    forall a A, xs L_A:
        map_fn(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<B, L_B>{core_B}.cons(f(a), map_fn(xs))

# Source theorem: append_nil. Structural induction uses the nil equation as the
# base case and the cons equation to transport the induction hypothesis.
thm list_append_nil:
    ? forall A set, L nonempty_set, core &ListCore<A, L>, append fn(x, y L) L, target L:
        $is_list_append(A, L, core, append)
        =>:
            append(target, &ListCore<A, L>{core}.nil) = target
    have P power_set(L) = {z L: append(z, &ListCore<A, L>{core}.nil) = z}
    &ListCore<A, L>{core}.nil $in {z L: append(z, &ListCore<A, L>{core}.nil) = z}
    &ListCore<A, L>{core}.nil $in P
    claim:
        ? forall a A, xs L:
            xs $in P
            =>:
                &ListCore<A, L>{core}.cons(a, xs) $in P
        append(&ListCore<A, L>{core}.cons(a, xs), &ListCore<A, L>{core}.nil) = &ListCore<A, L>{core}.cons(a, append(xs, &ListCore<A, L>{core}.nil))
        append(&ListCore<A, L>{core}.cons(a, xs), &ListCore<A, L>{core}.nil) = &ListCore<A, L>{core}.cons(a, xs)
        &ListCore<A, L>{core}.cons(a, xs) $in {z L: append(z, &ListCore<A, L>{core}.nil) = z}
        &ListCore<A, L>{core}.cons(a, xs) $in P
    P = L
    target $in P
    target $in {z L: append(z, &ListCore<A, L>{core}.nil) = z}

# Source theorem: map_map. Structural induction compares the three map
# specifications; the cons case composes g(f(a)) and reuses the tail result.
thm list_map_map:
    ? forall A, B, C set, L_A, L_B, L_C nonempty_set, core_A &ListCore<A, L_A>, core_B &ListCore<B, L_B>, core_C &ListCore<C, L_C>, f fn(x A) B, g fn(y B) C, map_f fn(xs L_A) L_B, map_g fn(ys L_B) L_C, map_gf fn(xs L_A) L_C, target L_A:
        $is_list_map(A, B, L_A, L_B, core_A, core_B, f, map_f)
        $is_list_map(B, C, L_B, L_C, core_B, core_C, g, map_g)
        $is_list_map(A, C, L_A, L_C, core_A, core_C, fn(x A) C {g(f(x))}, map_gf)
        =>:
            map_g(map_f(target)) = map_gf(target)
    have P power_set(L_A) = {z L_A: map_g(map_f(z)) = map_gf(z)}
    &ListCore<A, L_A>{core_A}.nil $in {z L_A: map_g(map_f(z)) = map_gf(z)}
    &ListCore<A, L_A>{core_A}.nil $in P
    claim:
        ? forall a A, xs L_A:
            xs $in P
            =>:
                &ListCore<A, L_A>{core_A}.cons(a, xs) $in P
        map_f(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<B, L_B>{core_B}.cons(f(a), map_f(xs))
        map_g(map_f(&ListCore<A, L_A>{core_A}.cons(a, xs))) = map_g(&ListCore<B, L_B>{core_B}.cons(f(a), map_f(xs)))
        map_g(&ListCore<B, L_B>{core_B}.cons(f(a), map_f(xs))) = &ListCore<C, L_C>{core_C}.cons(g(f(a)), map_g(map_f(xs)))
        map_g(map_f(&ListCore<A, L_A>{core_A}.cons(a, xs))) = &ListCore<C, L_C>{core_C}.cons(g(f(a)), map_g(map_f(xs)))
        map_gf(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<C, L_C>{core_C}.cons((fn(x A) C {g(f(x))})(a), map_gf(xs))
        (fn(x A) C {g(f(x))})(a) = g(f(a))
        map_gf(&ListCore<A, L_A>{core_A}.cons(a, xs)) = &ListCore<C, L_C>{core_C}.cons(g(f(a)), map_gf(xs))
        map_g(map_f(&ListCore<A, L_A>{core_A}.cons(a, xs))) = map_gf(&ListCore<A, L_A>{core_A}.cons(a, xs))
        &ListCore<A, L_A>{core_A}.cons(a, xs) $in {z L_A: map_g(map_f(z)) = map_gf(z)}
        &ListCore<A, L_A>{core_A}.cons(a, xs) $in P
    P = L_A
    target $in P
    target $in {z L_A: map_g(map_f(z)) = map_gf(z)}

# The source uses Nat.max in the depth recursion.
have fn nat_max(left, right N) N by cases:
    case left >= right: left
    case left < right: right

# Boolean values used by the source's formula evaluator are represented by the
# actual two-element carrier {0,1}. The formula construction itself is tracked
# in todo.lit until its recursive interface is checked.
have Boolean finite_set = {0, 1}

have fn boolean_not(value {0, 1}) {0, 1} by cases:
    case value = 0: 1
    case value = 1: 0

have fn boolean_and(left, right {0, 1}) {0, 1} by cases:
    case left = 0: 0
    case left = 1: right

have fn boolean_or(left, right {0, 1}) {0, 1} by cases:
    case left = 0: right
    case left = 1: 1

# The source's substitution proof updates one input of a Boolean valuation.
# Keep that construction callable while the surrounding formula syntax and
# evaluator remain tracked separately.
template<valuation fn(i N) {0, 1}, idx N, bit {0, 1}>:
    have fn updated_boolean_valuation(m N) {0, 1} by cases:
        case m = idx: bit
        case m != idx: valuation(m)
