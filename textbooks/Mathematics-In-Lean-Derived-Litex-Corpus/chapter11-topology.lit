# Chapter 11 — Topology
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter follows the source order: filters, metric spaces, and then
# topological spaces. Lean implementation demonstrations are compressed to
# their mathematical interfaces.

# ---------------------------------------------------------------------------
# Section 11.1 — Filters
# ---------------------------------------------------------------------------

# A filter on X is represented by its collection of large subsets.  This is a
# property of a candidate collection, not the filter object itself.
prop is_filter_on(X set, F power_set(power_set(X))):
    X $in F
    forall U, V F:
        intersect(U, V) $in F
    forall U F, V power_set(X):
        U $subset V
        =>:
            V $in F

template<X set>:
    have Filter set = {F power_set(power_set(X)): $is_filter_on(X, F)}

thm filter_member:
    ? forall X set, F power_set(power_set(X)):
        $is_filter_on(X, F)
        =>:
            F $in \Filter<X>
    by thm set_builder_member(F, {candidate power_set(power_set(X)): $is_filter_on(X, candidate)})
    \Filter<X> = {candidate power_set(power_set(X)): $is_filter_on(X, candidate)}

thm filter_member_is_filter:
    ? forall X set, F \Filter<X>:
        $is_filter_on(X, F)
    F $in \Filter<X>
    \Filter<X> = {candidate power_set(power_set(X)): $is_filter_on(X, candidate)}
    F $in {candidate power_set(power_set(X)): $is_filter_on(X, candidate)}

# Source definition `principal`. The current checked result is its family of
# large sets; promoting it to `Filter<X>` requires the separate closure proof.
template<X set>:
    have fn principal_filter_sets(s power_set(X)) power_set(power_set(X)) = {U power_set(X): s $subset U}

thm principal_filter_sets_member:
    ? forall X set, s, U power_set(X):
        s $subset U
        =>:
            U $in \principal_filter_sets<X>(s)
    by thm set_builder_member(U, {V power_set(X): s $subset V})
    \principal_filter_sets<X>(s) = {V power_set(X): s $subset V}

thm principal_filter_sets_contains_base:
    ? forall X set, s power_set(X), U \principal_filter_sets<X>(s):
        s $subset U
    U $in \principal_filter_sets<X>(s)
    \principal_filter_sets<X>(s) = {V power_set(X): s $subset V}
    U $in {V power_set(X): s $subset V}

# The source's concrete atTop filter on the naturals consists of sets which
# contain a tail.  Both helpers are direct, fixed-carrier definitions.
prop contains_natural_tail_from(a N, S power_set(N)):
    forall b N:
        b >= a
        =>:
            b $in S

prop contains_natural_tail(S power_set(N)):
    exist a N st {$contains_natural_tail_from(a, S)}

have at_top_N_sets power_set(power_set(N)) = {S power_set(N): $contains_natural_tail(S)}

thm at_top_N_sets_member:
    ? forall S power_set(N):
        $contains_natural_tail(S)
        =>:
            S $in at_top_N_sets
    by thm set_builder_member(S, {candidate power_set(N): $contains_natural_tail(candidate)})
    at_top_N_sets = {candidate power_set(N): $contains_natural_tail(candidate)}

# Source construction `Filter.map`.
template<X, Y set>:
    have fn map_filter_sets(f fn(x X) Y, F power_set(power_set(X))) power_set(power_set(Y)) = {V power_set(Y): {x X: f(x) $in V} $in F}

# `comap` contains every set which contains the preimage of a large target set.
prop _contains_filter_preimage(X, Y set, f fn(x X) Y, G power_set(power_set(Y)), U power_set(X)):
    exist V G st {{x X: f(x) $in V} $subset U}

template<X, Y set>:
    have fn comap_filter_sets(f fn(x X) Y, G power_set(power_set(Y))) power_set(power_set(X)) = {U power_set(X): $_contains_filter_preimage(X, Y, f, G, U)}

# Lean's filter order is reverse inclusion of the collections of large sets.
prop filter_le(X set, F, G power_set(power_set(X))):
    G $subset F

# Source definitions `Tendsto₁` and `Tendsto₂`.
prop tends_to_by_preimage(X, Y set, f fn(x X) Y, F power_set(power_set(X)), G power_set(power_set(Y))):
    forall V G:
        {x X: f(x) $in V} $in F

prop tends_to_by_map(X, Y set, f fn(x X) Y, F power_set(power_set(X)), G power_set(power_set(Y))):
    $filter_le(Y, \map_filter_sets<X, Y>(f, F), G)

thm tends_to_by_preimage_member:
    ? forall X, Y set, f fn(x X) Y, F power_set(power_set(X)), G power_set(power_set(Y)), V power_set(Y):
        $tends_to_by_preimage(X, Y, f, F, G)
        V $in G
        =>:
            {x X: f(x) $in V} $in F

thm tends_to_by_preimage_intro:
    ? forall X, Y set, f fn(x X) Y, F power_set(power_set(X)), G power_set(power_set(Y)):
        forall V G:
            {x X: f(x) $in V} $in F
        =>:
            $tends_to_by_preimage(X, Y, f, F, G)
    by def:
        ? $tends_to_by_preimage(X, Y, f, F, G)

thm set_preimage_member_of_image_member:
    ? forall X, Y set, f fn(x X) Y, x X, B power_set(Y):
        f(x) $in B
        =>:
            x $in \chap4::set_preimage<X, Y, f>(B)
    by thm set_builder_member(x, {z X: f(z) $in B})
    \chap4::set_preimage<X, Y, f>(B) = {z X: f(z) $in B}

thm set_image_member_of_source_member:
    ? forall X, Y set, f fn(x X) Y, A power_set(X), x X:
        x $in A
        =>:
            f(x) $in \chap4::set_image<X, Y, f, A>
    fn(z A) Y {f(z)}(x) = f(x)
    fn(z A) Y {f(z)}(x) $in fn_range(fn(z A) Y {f(z)})
    \chap4::set_image<X, Y, f, A> = fn_range(fn(z A) Y {f(z)})

# Source limit-composition theorem in the preimage formulation. The explicit
# projection and introduction helpers lock every filter parameter.
thm filter_limits_compose:
    ? forall X, Y, W set, f fn(x X) Y, g fn(y Y) W, F power_set(power_set(X)), G power_set(power_set(Y)), H power_set(power_set(W)):
        $tends_to_by_preimage(X, Y, f, F, G)
        $tends_to_by_preimage(Y, W, g, G, H)
        =>:
            $tends_to_by_preimage(X, W, fn(x X) W {g(f(x))}, F, H)
    claim:
        ? forall V H:
            {x X: g(f(x)) $in V} $in F
        have S power_set(Y) = {x Y: g(x) $in V}
        by thm tends_to_by_preimage_member(Y, W, g, G, H, V)
        S $in G
        by thm tends_to_by_preimage_member(X, Y, f, F, G, S)
        have A power_set(X) = {x X: f(x) $in S}
        have B power_set(X) = {x X: g(f(x)) $in V}
        claim:
            ? A $subset B
            claim:
                ? forall z A:
                    z $in B
                z $in {x X: f(x) $in S}
                f(z) $in S
                f(z) $in {x Y: g(x) $in V}
                g(f(z)) $in V
                by thm set_builder_member(z, {x X: g(f(x)) $in V})
                z $in {x X: g(f(x)) $in V}
            by def:
                ? A $subset B
        claim:
            ? B $subset A
            claim:
                ? forall z B:
                    z $in A
                z $in {x X: g(f(x)) $in V}
                g(f(z)) $in V
                by thm set_builder_member(f(z), {x Y: g(x) $in V})
                f(z) $in {x Y: g(x) $in V}
                f(z) $in S
                by thm set_builder_member(z, {x X: f(x) $in S})
                z $in {x X: f(x) $in S}
            by def:
                ? B $subset A
        by extension:
            ? A = B
        A $in F
        B $in F
    by thm tends_to_by_preimage_intro(X, W, fn(x X) W {g(f(x))}, F, H)

# The epsilon-N formulation of real sequence convergence is used throughout
# the later metric development.
prop real_sequence_is_epsilon_close_from(u fn(n N) R, x0 R, epsilon R+, N0 N):
    forall n N:
        n >= N0
        =>:
            abs(u(n) - x0) < epsilon

prop real_sequence_converges(u fn(n N) R, x0 R):
    forall epsilon R+:
        exist N0 N st {$real_sequence_is_epsilon_close_from(u, x0, epsilon, N0)}

# A product sequence converges when both coordinate sequences converge.  The
# relation exposes the mathematical content without importing a product-filter
# implementation.
prop product_real_sequence_converges(u fn(n N) cart(R, R), x0, y0 R):
    $real_sequence_converges(fn(n N) R {u(n)[1]}, x0)
    $real_sequence_converges(fn(n N) R {u(n)[2]}, y0)

# Neighborhoods of a real point are the sets containing some positive open
# interval around that point.
prop real_open_interval_is_subset(x0 R, epsilon R+, U power_set(R)):
    forall y R:
        x0 - epsilon < y
        y < x0 + epsilon
        =>:
            y $in U

prop contains_real_neighborhood_interval(x0 R, U power_set(R)):
    exist epsilon R+ st {$real_open_interval_is_subset(x0, epsilon, U)}

have fn real_neighborhood_filter(x0 R) power_set(power_set(R)) = {U power_set(R): $contains_real_neighborhood_interval(x0, U)}

# Eventually means membership in the chosen filter.  For atTop on N this is
# exactly eventual truth after a natural threshold.
prop eventually(X set, F power_set(power_set(X)), P power_set(X)):
    P $in F

prop eventually_on_N(P power_set(N)):
    $contains_natural_tail(P)

prop eventually_equal_real_sequences(u, v fn(n N) R):
    $eventually_on_N({n N: u(n) = v(n)})

prop intersection_membership_implies(P, Qset, R0 power_set(N), n N):
    not n $in intersect(P, Qset) or n $in R0

# These projections keep each set argument explicit. This matters here because
# the verifier must not infer a different set parameter while applying a
# universal membership fact.
thm natural_tail_contains_later:
    ? forall a N, S power_set(N), n N:
        $contains_natural_tail_from(a, S)
        n >= a
        =>:
            n $in S

# Source `Filter.Eventually` conjunction law, specialized to the concrete
# atTop filter on N used by this chapter.
thm eventually_conjunction_on_N:
    ? forall P, Qset power_set(N):
        $eventually_on_N(P)
        $eventually_on_N(Qset)
        =>:
            $eventually_on_N(intersect(P, Qset))
    intersect(P, Qset) $subset P $subset N
    intersect(P, Qset) $in power_set(N)
    $contains_natural_tail(P)
    $contains_natural_tail(Qset)
    obtain a from exist a0 N st {$contains_natural_tail_from(a0, P)}
    obtain b from exist b0 N st {$contains_natural_tail_from(b0, Qset)}
    have c N = a + b
    claim:
        ? forall n N:
            n >= c
            =>:
                n $in intersect(P, Qset)
        a + b >= a
        a + b >= b
        n >= c = a + b >= a
        n >= c = a + b >= b
        by thm natural_tail_contains_later(a, P, n)
        by thm natural_tail_contains_later(b, Qset, n)
    witness exist k N st {$contains_natural_tail_from(k, intersect(P, Qset))} from c:
        by def:
            ? $contains_natural_tail_from(c, intersect(P, Qset))
    by def:
        ? $contains_natural_tail(intersect(P, Qset))
    by def:
        ? $eventually_on_N(intersect(P, Qset))

thm real_sequence_close_later:
    ? forall u fn(n N) R, x0 R, epsilon R+, N0, n N:
        $real_sequence_is_epsilon_close_from(u, x0, epsilon, N0)
        n >= N0
        =>:
            abs(u(n) - x0) < epsilon

thm eventual_equality_later:
    ? forall u, v fn(n N) R, a, k N:
        $contains_natural_tail_from(a, {n N: u(n) = v(n)})
        k >= a
        =>:
            u(k) = v(k)
    by thm natural_tail_contains_later(a, {n N: u(n) = v(n)}, k)
    k $in {n N: u(n) = v(n)}

# Eventual equality is symmetric. This lets the reverse limit implication
# reuse the checked forward theorem instead of repeating its epsilon proof.
thm eventually_equal_real_sequences_symmetric:
    ? forall u, v fn(n N) R:
        $eventually_equal_real_sequences(u, v)
        =>:
            $eventually_equal_real_sequences(v, u)
    $eventually_on_N({n N: u(n) = v(n)})
    $contains_natural_tail({n N: u(n) = v(n)})
    obtain a from exist a0 N st {$contains_natural_tail_from(a0, {n N: u(n) = v(n)})}
    claim:
        ? forall n N:
            n >= a
            =>:
                n $in {k N: v(k) = u(k)}
        by thm eventual_equality_later(u, v, a, n)
        by thm set_builder_member(n, {k N: v(k) = u(k)})
    witness exist k N st {$contains_natural_tail_from(k, {n N: v(n) = u(n)})} from a:
        by def:
            ? $contains_natural_tail_from(a, {n N: v(n) = u(n)})
    by def:
        ? $contains_natural_tail({n N: v(n) = u(n)})
    by def:
        ? $eventually_on_N({n N: v(n) = u(n)})
    by def:
        ? $eventually_equal_real_sequences(v, u)

# Source `tendsto_congr'`: eventual equality preserves a real-sequence limit.
# Both directions are kept explicit because the source presents an iff.
thm eventually_equal_preserves_real_limit_forward:
    ? forall u, v fn(n N) R, x0 R:
        $eventually_equal_real_sequences(u, v)
        $real_sequence_converges(u, x0)
        =>:
            $real_sequence_converges(v, x0)
    $eventually_on_N({n N: u(n) = v(n)})
    $contains_natural_tail({n N: u(n) = v(n)})
    obtain a from exist a0 N st {$contains_natural_tail_from(a0, {n N: u(n) = v(n)})}
    claim:
        ? forall epsilon R+:
            exist N0 N st {$real_sequence_is_epsilon_close_from(v, x0, epsilon, N0)}
        obtain b from exist b0 N st {$real_sequence_is_epsilon_close_from(u, x0, epsilon, b0)}
        have c N = a + b
        claim:
            ? forall n N:
                n >= c
                =>:
                    abs(v(n) - x0) < epsilon
            a + b >= a
            a + b >= b
            n >= c = a + b >= a
            n >= c = a + b >= b
            by thm eventual_equality_later(u, v, a, n)
            by thm real_sequence_close_later(u, x0, epsilon, b, n)
            abs(v(n) - x0) = abs(u(n) - x0) < epsilon
        witness exist N0 N st {$real_sequence_is_epsilon_close_from(v, x0, epsilon, N0)} from c:
            by def:
                ? $real_sequence_is_epsilon_close_from(v, x0, epsilon, c)
    by def:
        ? $real_sequence_converges(v, x0)

thm eventually_equal_preserves_real_limit_reverse:
    ? forall u, v fn(n N) R, x0 R:
        $eventually_equal_real_sequences(u, v)
        $real_sequence_converges(v, x0)
        =>:
            $real_sequence_converges(u, x0)
    by thm eventually_equal_real_sequences_symmetric(u, v)
    by thm eventually_equal_preserves_real_limit_forward(v, u, x0)

thm _intersection_membership_implies_apply:
    ? forall P, Qset, R0 power_set(N), n N:
        $intersection_membership_implies(P, Qset, R0, n)
        n $in P
        n $in Qset
        =>:
            n $in R0
    n $in intersect(P, Qset)
    not n $in intersect(P, Qset) or n $in R0
    by cases:
        ? n $in R0
        case not n $in intersect(P, Qset):
            impossible not n $in intersect(P, Qset)
        case n $in R0

# Source `Filter.Eventually` implication law on the same concrete filter.
thm eventually_implication_on_N:
    ? forall P, Qset, R0 power_set(N):
        $eventually_on_N(P)
        $eventually_on_N(Qset)
        $eventually_on_N({n N: $intersection_membership_implies(P, Qset, R0, n)})
        =>:
            $eventually_on_N(R0)
    $contains_natural_tail(P)
    $contains_natural_tail(Qset)
    $contains_natural_tail({n N: $intersection_membership_implies(P, Qset, R0, n)})
    obtain a from exist a0 N st {$contains_natural_tail_from(a0, P)}
    obtain b from exist b0 N st {$contains_natural_tail_from(b0, Qset)}
    obtain d from exist d0 N st {$contains_natural_tail_from(d0, {n N: $intersection_membership_implies(P, Qset, R0, n)})}
    have c N = a + b + d
    claim:
        ? forall n N:
            n >= c
            =>:
                n $in R0
        a + b + d >= a
        a + b + d >= b
        a + b + d >= d
        n >= c = a + b + d >= a
        n >= c = a + b + d >= b
        n >= c = a + b + d >= d
        by thm natural_tail_contains_later(a, P, n)
        by thm natural_tail_contains_later(b, Qset, n)
        by thm natural_tail_contains_later(d, {m N: $intersection_membership_implies(P, Qset, R0, m)}, n)
        $intersection_membership_implies(P, Qset, R0, n)
        by thm _intersection_membership_implies_apply(P, Qset, R0, n)
    witness exist k N st {$contains_natural_tail_from(k, R0)} from c:
        by def:
            ? $contains_natural_tail_from(c, R0)
    by def:
        ? $contains_natural_tail(R0)
    by def:
        ? $eventually_on_N(R0)

# The raw source constructions satisfy the filter laws. The proofs keep the
# callable set families visible: principal and map use closure under
# intersection/preimage, while comap combines explicit target witnesses.
thm principal_filter_is_filter:
    ? forall X set, s power_set(X):
        \principal_filter_sets<X>(s) $in \Filter<X>
    claim:
        ? X $in \principal_filter_sets<X>(s)
        s $subset X
        by thm set_builder_member(X, {U power_set(X): s $subset U})
        \principal_filter_sets<X>(s) = {U power_set(X): s $subset U}
        X $in \principal_filter_sets<X>(s)
    claim:
        ? forall U, V \principal_filter_sets<X>(s):
            intersect(U, V) $in \principal_filter_sets<X>(s)
        claim:
            ? s $subset intersect(U, V)
            forall x s:
                x $in U
                x $in V
                x $in intersect(U, V)
            by def:
                ? s $subset intersect(U, V)
        s $subset intersect(U, V)
        intersect(U, V) $subset U $subset X
        intersect(U, V) $in power_set(X)
        by thm set_builder_member(intersect(U, V), {W power_set(X): s $subset W})
        \principal_filter_sets<X>(s) = {W power_set(X): s $subset W}
    claim:
        ? forall U \principal_filter_sets<X>(s), V power_set(X):
            U $subset V
            =>:
                V $in \principal_filter_sets<X>(s)
        s $subset U $subset V
        by thm set_builder_member(V, {W power_set(X): s $subset W})
        \principal_filter_sets<X>(s) = {W power_set(X): s $subset W}
    by def:
        ? $is_filter_on(X, \principal_filter_sets<X>(s))
    by thm set_builder_member(\principal_filter_sets<X>(s), {F power_set(power_set(X)): $is_filter_on(X, F)})
    \Filter<X> = {F power_set(power_set(X)): $is_filter_on(X, F)}

thm at_top_N_is_filter:
    ? forall marker {0}:
        at_top_N_sets $in \Filter<N>
    claim:
        ? N $in at_top_N_sets
        claim:
            ? $contains_natural_tail_from(0, N)
            by def:
                ? $contains_natural_tail_from(0, N)
        claim:
            ? exist a N st {$contains_natural_tail_from(a, N)}
            witness exist a N st {$contains_natural_tail_from(a, N)} from 0
        by def:
            ? $contains_natural_tail(N)
        $contains_natural_tail(N)
        by thm set_builder_member(N, {S power_set(N): $contains_natural_tail(S)})
        at_top_N_sets = {S power_set(N): $contains_natural_tail(S)}
        N $in at_top_N_sets
    claim:
        ? forall U, V at_top_N_sets:
            intersect(U, V) $in at_top_N_sets
        U $in at_top_N_sets
        V $in at_top_N_sets
        at_top_N_sets = {S power_set(N): $contains_natural_tail(S)}
        U $in {S power_set(N): $contains_natural_tail(S)}
        V $in {S power_set(N): $contains_natural_tail(S)}
        $contains_natural_tail(U)
        $contains_natural_tail(V)
        by def:
            ? $eventually_on_N(U)
        by def:
            ? $eventually_on_N(V)
        by thm eventually_conjunction_on_N(U, V)
        $contains_natural_tail(intersect(U, V))
        intersect(U, V) $subset U $subset N
        intersect(U, V) $in power_set(N)
        by thm set_builder_member(intersect(U, V), {S power_set(N): $contains_natural_tail(S)})
        at_top_N_sets = {S power_set(N): $contains_natural_tail(S)}
    claim:
        ? forall U at_top_N_sets, V power_set(N):
            U $subset V
            =>:
                V $in at_top_N_sets
        U $in at_top_N_sets
        at_top_N_sets = {S power_set(N): $contains_natural_tail(S)}
        U $in {S power_set(N): $contains_natural_tail(S)}
        $contains_natural_tail(U)
        by def:
            ? $contains_natural_tail(U)
        obtain a from exist a0 N st {$contains_natural_tail_from(a0, U)}
        claim:
            ? $contains_natural_tail_from(a, V)
            claim:
                ? forall n N:
                    n >= a
                    =>:
                        n $in V
                by thm natural_tail_contains_later(a, U, n)
            by def:
                ? $contains_natural_tail_from(a, V)
        claim:
            ? exist a0 N st {$contains_natural_tail_from(a0, V)}
            witness exist a0 N st {$contains_natural_tail_from(a0, V)} from a
        by def:
            ? $contains_natural_tail(V)
        by thm set_builder_member(V, {S power_set(N): $contains_natural_tail(S)})
        at_top_N_sets = {S power_set(N): $contains_natural_tail(S)}
    by def:
        ? $is_filter_on(N, at_top_N_sets)
    by thm set_builder_member(at_top_N_sets, {F power_set(power_set(N)): $is_filter_on(N, F)})
    \Filter<N> = {F power_set(power_set(N)): $is_filter_on(N, F)}

thm map_filter_is_filter:
    ? forall X, Y set, f fn(x X) Y, F \Filter<X>:
        \map_filter_sets<X, Y>(f, F) $in \Filter<Y>
    F $in \Filter<X>
    \Filter<X> = {source_filter power_set(power_set(X)): $is_filter_on(X, source_filter)}
    F $in {source_filter power_set(power_set(X)): $is_filter_on(X, source_filter)}
    $is_filter_on(X, F)
    by def:
        ? $is_filter_on(X, F)
    claim:
        ? Y $in \map_filter_sets<X, Y>(f, F)
        have preimage_univ power_set(X) = {x X: f(x) $in Y}
        claim:
            ? X $subset preimage_univ
            claim:
                ? forall x X:
                    x $in preimage_univ
                f(x) $in Y
                by thm set_builder_member(x, {z X: f(z) $in Y})
                x $in {z X: f(z) $in Y}
            by def:
                ? X $subset preimage_univ
        preimage_univ $subset X
        by extension:
            ? preimage_univ = X
        preimage_univ $in F
        by thm set_builder_member(Y, {V power_set(Y): {x X: f(x) $in V} $in F})
        \map_filter_sets<X, Y>(f, F) = {V power_set(Y): {x X: f(x) $in V} $in F}
        Y $in \map_filter_sets<X, Y>(f, F)
    claim:
        ? forall U, V \map_filter_sets<X, Y>(f, F):
            intersect(U, V) $in \map_filter_sets<X, Y>(f, F)
        have preimage_U power_set(X) = {x X: f(x) $in U}
        have preimage_V power_set(X) = {x X: f(x) $in V}
        have preimage_intersection power_set(X) = {x X: f(x) $in intersect(U, V)}
        U $in \map_filter_sets<X, Y>(f, F)
        V $in \map_filter_sets<X, Y>(f, F)
        \map_filter_sets<X, Y>(f, F) = {W power_set(Y): {x X: f(x) $in W} $in F}
        U $in {W power_set(Y): {x X: f(x) $in W} $in F}
        V $in {W power_set(Y): {x X: f(x) $in W} $in F}
        {x X: f(x) $in U} $in F
        {x X: f(x) $in V} $in F
        preimage_U $in F
        preimage_V $in F
        intersect(preimage_U, preimage_V) $in F
        claim:
            ? preimage_intersection $subset intersect(preimage_U, preimage_V)
            claim:
                ? forall x preimage_intersection:
                    x $in intersect(preimage_U, preimage_V)
                x $in preimage_intersection
                preimage_intersection = {z X: f(z) $in intersect(U, V)}
                x $in {z X: f(z) $in intersect(U, V)}
                f(x) $in intersect(U, V)
                f(x) $in U
                f(x) $in V
                by thm set_builder_member(x, {z X: f(z) $in U})
                by thm set_builder_member(x, {z X: f(z) $in V})
                preimage_U = {z X: f(z) $in U}
                preimage_V = {z X: f(z) $in V}
                x $in preimage_U
                x $in preimage_V
            by def:
                ? preimage_intersection $subset intersect(preimage_U, preimage_V)
        claim:
            ? intersect(preimage_U, preimage_V) $subset preimage_intersection
            claim:
                ? forall x intersect(preimage_U, preimage_V):
                    x $in preimage_intersection
                x $in preimage_U
                x $in preimage_V
                preimage_U = {z X: f(z) $in U}
                preimage_V = {z X: f(z) $in V}
                x $in {z X: f(z) $in U}
                x $in {z X: f(z) $in V}
                f(x) $in U
                f(x) $in V
                f(x) $in intersect(U, V)
                by thm set_builder_member(x, {z X: f(z) $in intersect(U, V)})
                preimage_intersection = {z X: f(z) $in intersect(U, V)}
            by def:
                ? intersect(preimage_U, preimage_V) $subset preimage_intersection
        by extension:
            ? preimage_intersection = intersect(preimage_U, preimage_V)
        preimage_intersection $in F
        intersect(U, V) $subset U $subset Y
        intersect(U, V) $in power_set(Y)
        by thm set_builder_member(intersect(U, V), {W power_set(Y): {x X: f(x) $in W} $in F})
        \map_filter_sets<X, Y>(f, F) = {W power_set(Y): {x X: f(x) $in W} $in F}
    claim:
        ? forall U \map_filter_sets<X, Y>(f, F), V power_set(Y):
            U $subset V
            =>:
                V $in \map_filter_sets<X, Y>(f, F)
        have preimage_U power_set(X) = {x X: f(x) $in U}
        have preimage_V power_set(X) = {x X: f(x) $in V}
        U $in \map_filter_sets<X, Y>(f, F)
        \map_filter_sets<X, Y>(f, F) = {W power_set(Y): {x X: f(x) $in W} $in F}
        U $in {W power_set(Y): {x X: f(x) $in W} $in F}
        {x X: f(x) $in U} $in F
        preimage_U $in F
        claim:
            ? preimage_U $subset preimage_V
            claim:
                ? forall x preimage_U:
                    x $in preimage_V
                x $in preimage_U
                preimage_U = {z X: f(z) $in U}
                x $in {z X: f(z) $in U}
                f(x) $in U
                f(x) $in V
                by thm set_builder_member(x, {z X: f(z) $in V})
                preimage_V = {z X: f(z) $in V}
            by def:
                ? preimage_U $subset preimage_V
        preimage_V $in F
        by thm set_builder_member(V, {W power_set(Y): {x X: f(x) $in W} $in F})
        \map_filter_sets<X, Y>(f, F) = {W power_set(Y): {x X: f(x) $in W} $in F}
    by def:
        ? $is_filter_on(Y, \map_filter_sets<X, Y>(f, F))
    by thm set_builder_member(\map_filter_sets<X, Y>(f, F), {target_filter power_set(power_set(Y)): $is_filter_on(Y, target_filter)})
    \Filter<Y> = {target_filter power_set(power_set(Y)): $is_filter_on(Y, target_filter)}

thm comap_filter_is_filter:
    ? forall X, Y set, f fn(x X) Y, G \Filter<Y>:
        \comap_filter_sets<X, Y>(f, G) $in \Filter<X>
    G $in \Filter<Y>
    \Filter<Y> = {source_filter power_set(power_set(Y)): $is_filter_on(Y, source_filter)}
    G $in {source_filter power_set(power_set(Y)): $is_filter_on(Y, source_filter)}
    $is_filter_on(Y, G)
    by def:
        ? $is_filter_on(Y, G)
    claim:
        ? X $in \comap_filter_sets<X, Y>(f, G)
        claim:
            ? {x X: f(x) $in Y} $subset X
            claim:
                ? forall x {z X: f(z) $in Y}:
                    x $in X
            by def:
                ? {x X: f(x) $in Y} $subset X
        claim:
            ? exist V G st {{x X: f(x) $in V} $subset X}
            witness exist V G st {{x X: f(x) $in V} $subset X} from Y
        by def:
            ? $_contains_filter_preimage(X, Y, f, G, X)
        by thm set_builder_member(X, {U power_set(X): $_contains_filter_preimage(X, Y, f, G, U)})
        \comap_filter_sets<X, Y>(f, G) = {U power_set(X): $_contains_filter_preimage(X, Y, f, G, U)}
        X $in \comap_filter_sets<X, Y>(f, G)
    claim:
        ? forall U, V \comap_filter_sets<X, Y>(f, G):
            intersect(U, V) $in \comap_filter_sets<X, Y>(f, G)
        U $in \comap_filter_sets<X, Y>(f, G)
        V $in \comap_filter_sets<X, Y>(f, G)
        \comap_filter_sets<X, Y>(f, G) = {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
        U $in {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
        V $in {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
        $_contains_filter_preimage(X, Y, f, G, U)
        $_contains_filter_preimage(X, Y, f, G, V)
        by def:
            ? $_contains_filter_preimage(X, Y, f, G, U)
        by def:
            ? $_contains_filter_preimage(X, Y, f, G, V)
        obtain large_U from exist A G st {{x X: f(x) $in A} $subset U}
        obtain large_V from exist B G st {{x X: f(x) $in B} $subset V}
        intersect(large_U, large_V) $in G
        claim:
            ? {x X: f(x) $in intersect(large_U, large_V)} $subset intersect(U, V)
            claim:
                ? forall x {z X: f(z) $in intersect(large_U, large_V)}:
                    x $in intersect(U, V)
                x $in {z X: f(z) $in intersect(large_U, large_V)}
                f(x) $in large_U
                f(x) $in large_V
                by thm set_builder_member(x, {z X: f(z) $in large_U})
                by thm set_builder_member(x, {z X: f(z) $in large_V})
                x $in U
                x $in V
            by def:
                ? {x X: f(x) $in intersect(large_U, large_V)} $subset intersect(U, V)
        intersect(U, V) $subset U $subset X
        intersect(U, V) $in power_set(X)
        claim:
            ? exist W G st {{x X: f(x) $in W} $subset intersect(U, V)}
            witness exist W G st {{x X: f(x) $in W} $subset intersect(U, V)} from intersect(large_U, large_V)
        by def:
            ? $_contains_filter_preimage(X, Y, f, G, intersect(U, V))
        by thm set_builder_member(intersect(U, V), {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)})
        \comap_filter_sets<X, Y>(f, G) = {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
    claim:
        ? forall U \comap_filter_sets<X, Y>(f, G), V power_set(X):
            U $subset V
            =>:
                V $in \comap_filter_sets<X, Y>(f, G)
        U $in \comap_filter_sets<X, Y>(f, G)
        \comap_filter_sets<X, Y>(f, G) = {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
        U $in {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
        $_contains_filter_preimage(X, Y, f, G, U)
        by def:
            ? $_contains_filter_preimage(X, Y, f, G, U)
        obtain large_U from exist A G st {{x X: f(x) $in A} $subset U}
        {x X: f(x) $in large_U} $subset U $subset V
        claim:
            ? exist W G st {{x X: f(x) $in W} $subset V}
            witness exist W G st {{x X: f(x) $in W} $subset V} from large_U
        by def:
            ? $_contains_filter_preimage(X, Y, f, G, V)
        by thm set_builder_member(V, {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)})
        \comap_filter_sets<X, Y>(f, G) = {W power_set(X): $_contains_filter_preimage(X, Y, f, G, W)}
    by def:
        ? $is_filter_on(X, \comap_filter_sets<X, Y>(f, G))
    by thm set_builder_member(\comap_filter_sets<X, Y>(f, G), {target_filter power_set(power_set(X)): $is_filter_on(X, target_filter)})
    \Filter<X> = {target_filter power_set(power_set(X)): $is_filter_on(X, target_filter)}

thm tends_to_preimage_implies_map:
    ? forall X, Y set, f fn(x X) Y, F power_set(power_set(X)), G power_set(power_set(Y)):
        $tends_to_by_preimage(X, Y, f, F, G)
        =>:
            $tends_to_by_map(X, Y, f, F, G)
    by def:
        ? $tends_to_by_preimage(X, Y, f, F, G)
    claim:
        ? G $subset \map_filter_sets<X, Y>(f, F)
        claim:
            ? forall V G:
                V $in \map_filter_sets<X, Y>(f, F)
            {x X: f(x) $in V} $in F
            by thm set_builder_member(V, {W power_set(Y): {x X: f(x) $in W} $in F})
            \map_filter_sets<X, Y>(f, F) = {W power_set(Y): {x X: f(x) $in W} $in F}
        by def:
            ? G $subset \map_filter_sets<X, Y>(f, F)
    by def:
        ? $filter_le(Y, \map_filter_sets<X, Y>(f, F), G)
    by def:
        ? $tends_to_by_map(X, Y, f, F, G)

thm tends_to_map_implies_preimage:
    ? forall X, Y set, f fn(x X) Y, F power_set(power_set(X)), G power_set(power_set(Y)):
        $tends_to_by_map(X, Y, f, F, G)
        =>:
            $tends_to_by_preimage(X, Y, f, F, G)
    by def:
        ? $tends_to_by_map(X, Y, f, F, G)
    by def:
        ? $filter_le(Y, \map_filter_sets<X, Y>(f, F), G)
    claim:
        ? forall V G:
            {x X: f(x) $in V} $in F
        V $in G
        V $in \map_filter_sets<X, Y>(f, F)
        \map_filter_sets<X, Y>(f, F) = {W power_set(Y): {x X: f(x) $in W} $in F}
        V $in {W power_set(Y): {x X: f(x) $in W} $in F}
    by def:
        ? $tends_to_by_preimage(X, Y, f, F, G)

# Chapter 3 already proves the same epsilon-N limit algebra. These two
# witness-preserving bridges cross only the private helper-predicate names.
thm real_sequence_converges_to_chap3:
    ? forall u fn(n N) R, a R:
        $real_sequence_converges(u, a)
        =>:
            $chap3::converges_to(u, a)
    claim:
        ? forall epsilon R+:
            exist N0 N st {$chap3::_is_eventually_close(u, a, epsilon, N0)}
        obtain cutoff from exist K N st {$real_sequence_is_epsilon_close_from(u, a, epsilon, K)}
        witness exist N0 N st {$chap3::_is_eventually_close(u, a, epsilon, N0)} from cutoff:
            claim:
                ? forall n N:
                    n >= cutoff
                    =>:
                        abs(u(n) - a) < epsilon
                by thm real_sequence_close_later(u, a, epsilon, cutoff, n)
            by def:
                ? $chap3::_is_eventually_close(u, a, epsilon, cutoff)
    by def:
        ? $chap3::converges_to(u, a)

thm chap3_converges_to_real_sequence:
    ? forall u fn(n N) R, a R:
        $chap3::converges_to(u, a)
        =>:
            $real_sequence_converges(u, a)
    claim:
        ? forall epsilon R+:
            exist N0 N st {$real_sequence_is_epsilon_close_from(u, a, epsilon, N0)}
        obtain cutoff from exist K N st {$chap3::_is_eventually_close(u, a, epsilon, K)}
        witness exist N0 N st {$real_sequence_is_epsilon_close_from(u, a, epsilon, N0)} from cutoff:
            claim:
                ? forall n N:
                    n >= cutoff
                    =>:
                        abs(u(n) - a) < epsilon
            by def:
                ? $real_sequence_is_epsilon_close_from(u, a, epsilon, cutoff)
    by def:
        ? $real_sequence_converges(u, a)

thm real_sequence_limit_add:
    ? forall u, v fn(n N) R, a, b R:
        $real_sequence_converges(u, a)
        $real_sequence_converges(v, b)
        =>:
            $real_sequence_converges(fn(n N) R {u(n) + v(n)}, a + b)
    by thm real_sequence_converges_to_chap3(u, a)
    by thm real_sequence_converges_to_chap3(v, b)
    by thm chap3::converges_to_add(u, v, a, b)
    by thm chap3_converges_to_real_sequence(fn(n N) R {u(n) + v(n)}, a + b)

thm real_sequence_limit_mul_const:
    ? forall u fn(n N) R, a, c R:
        $real_sequence_converges(u, a)
        =>:
            $real_sequence_converges(fn(n N) R {c * u(n)}, c * a)
    by thm real_sequence_converges_to_chap3(u, a)
    by thm chap3::converges_to_mul_const(u, a, c)
    by thm chap3_converges_to_real_sequence(fn(n N) R {c * u(n)}, c * a)

# ---------------------------------------------------------------------------
# Section 11.2 — Metric Spaces
# ---------------------------------------------------------------------------

# Chapter 2 packages its candidate distance laws as MetricSpace<X>. This
# chapter consumes that object directly in every metric property and theorem.
template<X set>:
    have Metric set = &MILAlternative::chap2_struct::MetricSpace<X>

# The real metric is directly callable.
have fn real_distance(x, y R) R = abs(x - y)

thm real_distance_nonnegative:
    ? forall x, y R:
        real_distance(x, y) >= 0
    real_distance(x, y) = abs(x - y) >= 0

thm real_distance_separates_points_forward:
    ? forall x, y R:
        real_distance(x, y) = 0
        =>:
            x = y
    real_distance(x, y) = abs(x - y)
    abs(x - y) = real_distance(x, y) = 0
    x - y = 0

thm real_distance_separates_points_reverse:
    ? forall x, y R:
        x = y
        =>:
            real_distance(x, y) = 0
    x - y = 0
    real_distance(x, y) = abs(x - y) = abs(0) = 0

thm real_distance_symmetric:
    ? forall x, y R:
        real_distance(x, y) = real_distance(y, x)
    real_distance(x, y) = abs(x - y) = abs(-(x - y)) = abs(y - x) = real_distance(y, x)

thm real_distance_triangle:
    ? forall x, y, z R:
        real_distance(x, z) <= real_distance(x, y) + real_distance(y, z)
    x - z = (x - y) + (y - z)
    real_distance(x, z) = abs(x - z) = abs((x - y) + (y - z)) <= abs(x - y) + abs(y - z) = real_distance(x, y) + real_distance(y, z)

by thm struct_member(real_distance, &MILAlternative::chap2_struct::MetricSpace<R>)
have real_metric &MILAlternative::chap2_struct::MetricSpace<R> = real_distance

prop metric_sequence_is_epsilon_close_from(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, a X, epsilon R+, N0 N):
    forall n N:
        n >= N0
        =>:
            dist(u(n), a) < epsilon

prop metric_sequence_converges(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, a X):
    forall epsilon R+:
        exist N0 N st {$metric_sequence_is_epsilon_close_from(X, dist, u, a, epsilon, N0)}

prop is_metric_delta_controlled_at(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y, a X, epsilon R+, delta R+):
    forall x X:
        dist_X(x, a) < delta
        =>:
            dist_Y(f(x), f(a)) < epsilon

prop is_metric_continuous_at(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y, a X):
    forall epsilon R+:
        exist delta R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, epsilon, delta)}

prop is_metric_continuous(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y):
    forall a X:
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)

thm metric_continuous_maps_sequence_limit:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y, u fn(n N) X, a X:
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        $metric_sequence_converges(X, dist_X, u, a)
        =>:
            $metric_sequence_converges(Y, dist_Y, fn(n N) Y {f(u(n))}, f(a))
    $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
    claim:
        ? forall epsilon R+:
            exist cutoff N st {$metric_sequence_is_epsilon_close_from(Y, dist_Y, fn(n N) Y {f(u(n))}, f(a), epsilon, cutoff)}
        obtain delta from exist radius R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, epsilon, radius)}
        obtain N0 from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist_X, u, a, delta, cutoff)}
        claim:
            ? $metric_sequence_is_epsilon_close_from(Y, dist_Y, fn(n N) Y {f(u(n))}, f(a), epsilon, N0)
            claim:
                ? forall n N:
                    n >= N0
                    =>:
                        dist_Y(f(u(n)), f(a)) < epsilon
                dist_X(u(n), a) < delta
            by def:
                ? $metric_sequence_is_epsilon_close_from(Y, dist_Y, fn(n N) Y {f(u(n))}, f(a), epsilon, N0)
        witness exist cutoff N st {$metric_sequence_is_epsilon_close_from(Y, dist_Y, fn(n N) Y {f(u(n))}, f(a), epsilon, cutoff)} from N0
    by def:
        ? $metric_sequence_converges(Y, dist_Y, fn(n N) Y {f(u(n))}, f(a))

thm metric_distance_difference_le:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, p, q, r, s X:
        =>:
            abs(dist(p, q) - dist(r, s)) <= dist(p, r) + dist(q, s)
    dist(s, q) = dist(q, s)
    dist(r, p) = dist(p, r)
    dist(p, r) + (dist(r, s) + dist(q, s)) = dist(p, r) + dist(r, s) + dist(q, s)
    dist(p, r) + (dist(p, q) + dist(q, s)) = dist(p, r) + dist(p, q) + dist(q, s)
    dist(r, q) <= dist(r, s) + dist(s, q)
    dist(p, r) + dist(r, q) <= dist(p, r) + (dist(r, s) + dist(s, q))
    dist(p, q) <= dist(p, r) + dist(r, q)
    by thm chap9::object_substitution(R, R, fn(t R) R {dist(p, r) + (dist(r, s) + t)}, dist(s, q), dist(q, s))
    dist(p, r) + (dist(r, s) + dist(s, q)) = dist(p, r) + (dist(r, s) + dist(q, s))
    dist(p, q) <= dist(p, r) + dist(r, q) <= dist(p, r) + (dist(r, s) + dist(s, q)) = dist(p, r) + (dist(r, s) + dist(q, s)) = dist(p, r) + dist(r, s) + dist(q, s)
    dist(p, s) <= dist(p, q) + dist(q, s)
    dist(r, p) + dist(p, s) <= dist(r, p) + (dist(p, q) + dist(q, s))
    dist(r, s) <= dist(r, p) + dist(p, s)
    by thm chap9::object_substitution(R, R, fn(t R) R {t + (dist(p, q) + dist(q, s))}, dist(r, p), dist(p, r))
    dist(r, p) + (dist(p, q) + dist(q, s)) = dist(p, r) + (dist(p, q) + dist(q, s))
    dist(r, s) <= dist(r, p) + dist(p, s) <= dist(r, p) + (dist(p, q) + dist(q, s)) = dist(p, r) + (dist(p, q) + dist(q, s)) = dist(p, r) + dist(p, q) + dist(q, s)
    dist(p, r) + dist(r, s) + dist(q, s) = (dist(p, r) + dist(q, s)) + dist(r, s)
    dist(p, r) + dist(p, q) + dist(q, s) = (dist(p, r) + dist(q, s)) + dist(p, q)
    have distance_pq R = dist(p, q)
    have distance_rs R = dist(r, s)
    have endpoint_movement R = dist(p, r) + dist(q, s)
    distance_pq = dist(p, q) <= dist(p, r) + dist(r, s) + dist(q, s) = (dist(p, r) + dist(q, s)) + dist(r, s) = endpoint_movement + distance_rs
    distance_rs = dist(r, s) <= dist(p, r) + dist(p, q) + dist(q, s) = (dist(p, r) + dist(q, s)) + dist(p, q) = endpoint_movement + distance_pq
    distance_pq - distance_rs <= endpoint_movement
    distance_rs - distance_pq <= endpoint_movement
    by cases:
        ? abs(distance_pq - distance_rs) <= endpoint_movement
        case distance_pq - distance_rs >= 0:
            abs(distance_pq - distance_rs) = distance_pq - distance_rs <= endpoint_movement
        case distance_pq - distance_rs < 0:
            abs(distance_pq - distance_rs) = -(distance_pq - distance_rs) = distance_rs - distance_pq <= endpoint_movement
    abs(dist(p, q) - dist(r, s)) = abs(distance_pq - distance_rs) <= endpoint_movement = dist(p, r) + dist(q, s)

# Shallow builtin execution retains the two bound projections for a binary
# finite minimum, but does not automatically preserve a common subtype.
thm binary_min_positive:
    ? forall a, b R+:
        finite_set_min(union({a}, {b})) $in R+
    a <= b or a > b
    by cases:
        ? finite_set_min(union({a}, {b})) $in R+
        case a <= b:
            finite_set_min(union({a}, {b})) <= a
            a <= finite_set_min(union({a}, {b}))
            finite_set_min(union({a}, {b})) = a
            finite_set_min(union({a}, {b})) $in R+
        case a > b:
            b <= a
            finite_set_min(union({a}, {b})) <= b
            b <= finite_set_min(union({a}, {b}))
            finite_set_min(union({a}, {b})) = b
            finite_set_min(union({a}, {b})) $in R+

# Five source proof variants collapse to this two-function continuity theorem.
thm metric_distance_of_continuous_maps:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f, g fn(point X) Y:
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        $is_metric_continuous(X, Y, dist_X, dist_Y, g)
        =>:
            $is_metric_continuous(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))})
    claim:
        ? forall a X:
            $is_metric_continuous_at(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))}, a)
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, g, a)
        claim:
            ? forall epsilon R+:
                exist delta R+ st {$is_metric_delta_controlled_at(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))}, a, epsilon, delta)}
            epsilon / 2 $in R+
            exist d R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, epsilon / 2, d)}
            exist d R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, g, a, epsilon / 2, d)}
            obtain delta_f from exist d R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, epsilon / 2, d)}
            obtain delta_g from exist d R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, g, a, epsilon / 2, d)}
            by thm binary_min_positive(delta_f, delta_g)
            finite_set_min(union({delta_f}, {delta_g})) <= delta_f
            finite_set_min(union({delta_f}, {delta_g})) <= delta_g
            witness exist delta R+ st {$is_metric_delta_controlled_at(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))}, a, epsilon, delta)} from finite_set_min(union({delta_f}, {delta_g})):
                claim:
                    ? forall x X:
                        dist_X(x, a) < finite_set_min(union({delta_f}, {delta_g}))
                        =>:
                            real_distance(fn(point X) R {dist_Y(f(point), g(point))}(x), fn(point X) R {dist_Y(f(point), g(point))}(a)) < epsilon
                    dist_X(x, a) < finite_set_min(union({delta_f}, {delta_g})) <= delta_f
                    dist_X(x, a) < finite_set_min(union({delta_f}, {delta_g})) <= delta_g
                    dist_Y(f(x), f(a)) < epsilon / 2
                    dist_Y(g(x), g(a)) < epsilon / 2
                    by thm metric_distance_difference_le(Y, dist_Y, f(x), g(x), f(a), g(a))
                    abs(dist_Y(f(x), g(x)) - dist_Y(f(a), g(a))) <= dist_Y(f(x), f(a)) + dist_Y(g(x), g(a)) < epsilon / 2 + epsilon / 2 = epsilon
                    real_distance(fn(point X) R {dist_Y(f(point), g(point))}(x), fn(point X) R {dist_Y(f(point), g(point))}(a)) = abs(dist_Y(f(x), g(x)) - dist_Y(f(a), g(a))) < epsilon
                by def:
                    ? $is_metric_delta_controlled_at(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))}, a, epsilon, finite_set_min(union({delta_f}, {delta_g})))
        by def:
            ? $is_metric_continuous_at(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))}, a)
    by def:
        ? $is_metric_continuous(X, R, dist_X, real_distance, fn(point X) R {dist_Y(f(point), g(point))})

thm metric_continuous_composition:
    ? forall X, Y, Zset set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, dist_Z &MILAlternative::chap2_struct::MetricSpace<Zset>, f fn(x X) Y, g fn(y Y) Zset:
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        $is_metric_continuous(Y, Zset, dist_Y, dist_Z, g)
        =>:
            $is_metric_continuous(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))})
    claim:
        ? forall a X:
            $is_metric_continuous_at(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))}, a)
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        $is_metric_continuous_at(Y, Zset, dist_Y, dist_Z, g, f(a))
        claim:
            ? forall epsilon R+:
                exist delta R+ st {$is_metric_delta_controlled_at(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))}, a, epsilon, delta)}
            exist eta R+ st {$is_metric_delta_controlled_at(Y, Zset, dist_Y, dist_Z, g, f(a), epsilon, eta)}
            obtain eta from exist radius R+ st {$is_metric_delta_controlled_at(Y, Zset, dist_Y, dist_Z, g, f(a), epsilon, radius)}
            exist delta R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, eta, delta)}
            obtain delta from exist radius R+ st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, eta, radius)}
            witness exist radius R+ st {$is_metric_delta_controlled_at(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))}, a, epsilon, radius)} from delta:
                claim:
                    ? forall x X:
                        dist_X(x, a) < delta
                        =>:
                            dist_Z(fn(point X) Zset {g(f(point))}(x), fn(point X) Zset {g(f(point))}(a)) < epsilon
                    dist_Y(f(x), f(a)) < eta
                    dist_Z(g(f(x)), g(f(a))) < epsilon
                    dist_Z(fn(point X) Zset {g(f(point))}(x), fn(point X) Zset {g(f(point))}(a)) = dist_Z(g(f(x)), g(f(a))) < epsilon
                by def:
                    ? $is_metric_delta_controlled_at(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))}, a, epsilon, delta)
        by def:
            ? $is_metric_continuous_at(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))}, a)
    by def:
        ? $is_metric_continuous(X, Zset, dist_X, dist_Z, fn(x X) Zset {g(f(x))})

thm real_quadratic_is_metric_continuous:
    ? forall marker {0}:
        $is_metric_continuous(R, R, real_distance, real_distance, fn(x R) R {x^2 + x})
    claim:
        ? forall a R:
            $is_metric_continuous_at(R, R, real_distance, real_distance, fn(x R) R {x^2 + x}, a)
        claim:
            ? forall epsilon R+:
                exist delta R+ st {$is_metric_delta_controlled_at(R, R, real_distance, real_distance, fn(x R) R {x^2 + x}, a, epsilon, delta)}
            abs(a) >= 0
            2 * abs(a) + 2 > 0
            2 * abs(a) + 2 != 0
            epsilon / (2 * abs(a) + 2) $in R+
            1 $in R+
            by thm binary_min_positive(1, epsilon / (2 * abs(a) + 2))
            finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)})) <= 1
            finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)})) <= epsilon / (2 * abs(a) + 2)
            witness exist delta R+ st {$is_metric_delta_controlled_at(R, R, real_distance, real_distance, fn(x R) R {x^2 + x}, a, epsilon, delta)} from finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)})):
                claim:
                    ? forall x R:
                        real_distance(x, a) < finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)}))
                        =>:
                            real_distance(fn(t R) R {t^2 + t}(x), fn(t R) R {t^2 + t}(a)) < epsilon
                    real_distance(x, a) = abs(x - a)
                    abs(x - a) < finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)})) <= 1
                    abs(x - a) < 1
                    x = (x - a) + a
                    abs(x) = abs((x - a) + a) <= abs(x - a) + abs(a) < 1 + abs(a)
                    abs(x + a) <= abs(x) + abs(a)
                    abs(x + a + 1) <= abs(x + a) + abs(1) = abs(x + a) + 1 <= abs(x) + abs(a) + 1
                    abs(x) + abs(a) + 1 < (1 + abs(a)) + abs(a) + 1 = 2 * abs(a) + 2
                    abs(x + a + 1) <= abs(x) + abs(a) + 1 < (1 + abs(a)) + abs(a) + 1 = 2 * abs(a) + 2
                    abs(x + a + 1) < 2 * abs(a) + 2
                    abs(x - a) < finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)})) <= epsilon / (2 * abs(a) + 2)
                    abs(x - a) < epsilon / (2 * abs(a) + 2)
                    abs(x - a) <= epsilon / (2 * abs(a) + 2)
                    abs(x - a) >= 0
                    abs(x + a + 1) >= 0
                    epsilon / (2 * abs(a) + 2) > 0
                    abs(x - a) * abs(x + a + 1) <= (epsilon / (2 * abs(a) + 2)) * abs(x + a + 1)
                    (epsilon / (2 * abs(a) + 2)) * abs(x + a + 1) < (epsilon / (2 * abs(a) + 2)) * (2 * abs(a) + 2)
                    abs(x - a) * abs(x + a + 1) <= (epsilon / (2 * abs(a) + 2)) * abs(x + a + 1) < (epsilon / (2 * abs(a) + 2)) * (2 * abs(a) + 2) = epsilon
                    (x^2 + x) - (a^2 + a) = (x - a) * (x + a + 1)
                    abs((x^2 + x) - (a^2 + a)) = abs((x - a) * (x + a + 1)) = abs(x - a) * abs(x + a + 1) < epsilon
                    real_distance(fn(t R) R {t^2 + t}(x), fn(t R) R {t^2 + t}(a)) = abs((x^2 + x) - (a^2 + a)) < epsilon
                by def:
                    ? $is_metric_delta_controlled_at(R, R, real_distance, real_distance, fn(x R) R {x^2 + x}, a, epsilon, finite_set_min(union({1}, {epsilon / (2 * abs(a) + 2)})))
        by def:
            ? $is_metric_continuous_at(R, R, real_distance, real_distance, fn(x R) R {x^2 + x}, a)
    by def:
        ? $is_metric_continuous(R, R, real_distance, real_distance, fn(x R) R {x^2 + x})

# Source example `x ↦ f (x² + x)`.
thm metric_continuous_after_real_quadratic:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, f fn(value R) X:
        $is_metric_continuous(R, X, real_distance, dist, f)
        =>:
            $is_metric_continuous(R, X, real_distance, dist, fn(x R) X {f(x^2 + x)})
    by thm real_quadratic_is_metric_continuous(0)
    by thm metric_continuous_composition(R, R, X, real_distance, real_distance, dist, fn(x R) R {x^2 + x}, f)

# Five Lean proof variants of this source fact collapse to one theorem.
# Source definitions `Metric.ball` and `Metric.closedBall` remain set-valued
# functions.  A failed construction must never turn either object into a prop.
template<X set, dist &MILAlternative::chap2_struct::MetricSpace<X>>:
    have fn metric_ball(a X, r R) power_set(X) = {x X: dist(x, a) < r}

template<X set, dist &MILAlternative::chap2_struct::MetricSpace<X>>:
    have fn metric_closed_ball(a X, r R) power_set(X) = {x X: dist(x, a) <= r}

thm metric_ball_member_distance:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, center X, radius R, point \metric_ball<X, dist>(center, radius):
        dist(point, center) < radius
    point $in \metric_ball<X, dist>(center, radius)
    \metric_ball<X, dist>(center, radius) = {candidate X: dist(candidate, center) < radius}
    point $in {candidate X: dist(candidate, center) < radius}

thm metric_ball_contains_center:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, a X, r R:
        r > 0
        =>:
            a $in {x X: dist(x, a) < r}
    dist(a, a) = 0
    dist(a, a) < r
    by thm set_builder_member(a, {x X: dist(x, a) < r})

thm metric_closed_ball_member_of_distance:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, center, point X, radius R:
        dist(point, center) <= radius
        =>:
            point $in \metric_closed_ball<X, dist>(center, radius)
    by thm set_builder_member(point, {candidate X: dist(candidate, center) <= radius})
    \metric_closed_ball<X, dist>(center, radius) = {candidate X: dist(candidate, center) <= radius}

thm metric_closed_ball_contains_center:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, a X, r R:
        r >= 0
        =>:
            a $in \metric_closed_ball<X, dist>(a, r)
    dist(a, a) = 0
    dist(a, a) <= r
    by thm metric_closed_ball_member_of_distance(X, dist, a, a, r)

prop is_metric_open(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X)):
    forall x S:
        exist epsilon R+ st {\metric_ball<X, dist>(x, epsilon) $subset S}

prop is_metric_closed(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X)):
    $is_metric_open(X, dist, set_minus(X, S))

# The closure object is the set of all points approached arbitrarily closely
# by S.  It remains a selected set-valued construction.
prop is_metric_adherent_point(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X), x X):
    forall epsilon R+:
        exist y S st {dist(x, y) < epsilon}

template<X set, dist &MILAlternative::chap2_struct::MetricSpace<X>>:
    have fn metric_closure(S power_set(X)) power_set(X) = {x X: $is_metric_adherent_point(X, dist, S, x)}

prop is_sequence_in_set(X set, S power_set(X), u fn(n N) X):
    forall n N:
        u(n) $in S

thm metric_closed_contains_sequence_limit:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X), u fn(n N) X, a X:
        $is_metric_closed(X, dist, S)
        $metric_sequence_converges(X, dist, u, a)
        $is_sequence_in_set(X, S, u)
        =>:
            a $in S
    by contra:
        ? a $in S
        not a $in S
        a $in set_minus(X, S)
        $is_metric_open(X, dist, set_minus(X, S))
        obtain epsilon from exist radius R+ st {\metric_ball<X, dist>(a, radius) $subset set_minus(X, S)}
        obtain N0 from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, u, a, epsilon, cutoff)}
        N0 >= N0
        dist(u(N0), a) < epsilon
        by thm set_builder_member(u(N0), {x X: dist(x, a) < epsilon})
        \metric_ball<X, dist>(a, epsilon) = {x X: dist(x, a) < epsilon}
        u(N0) $in \metric_ball<X, dist>(a, epsilon)
        u(N0) $in set_minus(X, S)
        not u(N0) $in S
        u(N0) $in S
        impossible u(N0) $in S

thm sequence_limit_lies_in_metric_closure:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X), u fn(n N) X, a X:
        $metric_sequence_converges(X, dist, u, a)
        $is_sequence_in_set(X, S, u)
        =>:
            a $in \metric_closure<X, dist>(S)
    claim:
        ? $is_metric_adherent_point(X, dist, S, a)
        claim:
            ? forall epsilon R+:
                exist y S st {dist(a, y) < epsilon}
            obtain N0 from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, u, a, epsilon, cutoff)}
            N0 >= N0
            dist(u(N0), a) < epsilon
            dist(a, u(N0)) = dist(u(N0), a)
            u(N0) $in S
            witness exist y S st {dist(a, y) < epsilon} from u(N0)
        by def:
            ? $is_metric_adherent_point(X, dist, S, a)
    by thm set_builder_member(a, {x X: $is_metric_adherent_point(X, dist, S, x)})
    \metric_closure<X, dist>(S) = {x X: $is_metric_adherent_point(X, dist, S, x)}

prop is_metric_neighborhood(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, x X, S power_set(X)):
    exist epsilon R+ st {\metric_ball<X, dist>(x, epsilon) $subset S}

prop contains_metric_closed_ball(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, x X, S power_set(X)):
    exist epsilon R+ st {\metric_closed_ball<X, dist>(x, epsilon) $subset S}

# Sequential compactness is equivalent to compactness for metric spaces and is
# the source-facing formulation needed by the subsequence examples.
prop strictly_increasing_natural_map(phi fn(n N) N):
    forall m, n N:
        m < n
        =>:
            phi(m) < phi(n)

thm archimedean_reciprocal_cutoff:
    ? forall epsilon R+:
        exist n N+ st {1 / n < epsilon}

thm strictly_increasing_natural_map_ge_identity:
    ? forall phi fn(n N) N, n N:
        $strictly_increasing_natural_map(phi)
        =>:
            phi(n) >= n
    by induc n from 0:
        ? phi(n) >= n

        ? from n = 0:
            phi(0) >= 0

        ? induc:
            phi(n) >= n
            phi(n) < phi(n + 1)
            n + 1 <= phi(n) + 1
            phi(n) + 1 <= phi(n + 1)
            n + 1 <= phi(n) + 1 <= phi(n + 1)
            phi(n + 1) >= n + 1

thm metric_sequence_limit_unique:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, a, b X:
        $metric_sequence_converges(X, dist, u, a)
        $metric_sequence_converges(X, dist, u, b)
        =>:
            a = b
    by contra:
        ? a = b
        a != b
        dist(a, b) >= 0
        by contra:
            ? dist(a, b) > 0
            dist(a, b) <= 0
            dist(a, b) = 0
            a = b
            impossible a != b
        have epsilon R+ = dist(a, b) / 3
        obtain Na from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, u, a, epsilon, cutoff)}
        obtain Nb from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, u, b, epsilon, cutoff)}
        Na + Nb >= Na
        Na + Nb >= Nb
        dist(u(Na + Nb), a) < epsilon
        dist(u(Na + Nb), b) < epsilon
        dist(a, u(Na + Nb)) = dist(u(Na + Nb), a)
        dist(a, b) <= dist(a, u(Na + Nb)) + dist(u(Na + Nb), b)
        dist(a, u(Na + Nb)) + dist(u(Na + Nb), b) < epsilon + epsilon
        by thm chap9::object_substitution(R, R, fn(t R) R {t + t}, epsilon, dist(a, b) / 3)
        epsilon + epsilon = dist(a, b) / 3 + dist(a, b) / 3
        dist(a, b) / 3 + dist(a, b) / 3 = dist(a, b) * 2 / 3
        dist(a, b) * 2 < dist(a, b) * 3
        dist(a, b) * 2 / 3 < dist(a, b) * 3 / 3 = dist(a, b)
        dist(a, b) <= dist(a, u(Na + Nb)) + dist(u(Na + Nb), b) < epsilon + epsilon = dist(a, b) / 3 + dist(a, b) / 3 = dist(a, b) * 2 / 3 < dist(a, b) * 3 / 3 = dist(a, b)
        impossible dist(a, b) < dist(a, b)

prop has_reciprocal_metric_approach(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, x X):
    forall n N:
        n + 1 > 0
        dist(u(n), x) < 1 / (n + 1)

thm reciprocal_approach_subsequence_converges:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, x X, phi fn(n N) N:
        $has_reciprocal_metric_approach(X, dist, u, x)
        $strictly_increasing_natural_map(phi)
        =>:
            $metric_sequence_converges(X, dist, fn(n N) X {u(phi(n))}, x)
    claim:
        ? forall epsilon R+:
            exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {u(phi(n))}, x, epsilon, cutoff)}
        obtain p from exist q N+ st {1 / q < epsilon}
        claim:
            ? $metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {u(phi(n))}, x, epsilon, p)
            claim:
                ? forall n N:
                    n >= p
                    =>:
                        dist(u(phi(n)), x) < epsilon
                phi(n) >= n
                phi(n) + 1 > 0
                dist(u(phi(n)), x) < 1 / (phi(n) + 1)
                phi(n) + 1 >= n + 1 >= p
                p * (phi(n) + 1) > 0
                1 / (phi(n) + 1) = p / (p * (phi(n) + 1))
                p / (p * (phi(n) + 1)) <= (phi(n) + 1) / (p * (phi(n) + 1))
                (phi(n) + 1) / (p * (phi(n) + 1)) = 1 / p
                1 / (phi(n) + 1) <= 1 / p
                dist(u(phi(n)), x) < 1 / (phi(n) + 1) <= 1 / p < epsilon
            by def:
                ? $metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {u(phi(n))}, x, epsilon, p)
        witness exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {u(phi(n))}, x, epsilon, cutoff)} from p
    by def:
        ? $metric_sequence_converges(X, dist, fn(n N) X {u(phi(n))}, x)

have fn reciprocal_natural_radius(n N+) R = 1 / n

prop has_metric_complement_ball(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X), x X):
    exist epsilon R+ st {\metric_ball<X, dist>(x, epsilon) $subset set_minus(X, S)}

thm no_complement_ball_gives_reciprocal_hit:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X), x X, n N:
        not $has_metric_complement_ball(X, dist, S, x)
        =>:
            intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))) != {}
    by contra:
        ? intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))) != {}
        intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))) = {}
        n + 1 > 0
        reciprocal_natural_radius(n + 1) = 1 / (n + 1) > 0
        have epsilon R+ = reciprocal_natural_radius(n + 1)
        claim:
            ? \metric_ball<X, dist>(x, epsilon) $subset set_minus(X, S)
            claim:
                ? forall y \metric_ball<X, dist>(x, epsilon):
                    y $in set_minus(X, S)
                by contra:
                    ? y $in set_minus(X, S)
                    not y $in set_minus(X, S)
                    y $in X
                    by contra:
                        ? y $in S
                        not y $in S
                        y $in set_minus(X, S)
                        impossible y $in set_minus(X, S)
                    y $in \metric_ball<X, dist>(x, epsilon)
                    epsilon = reciprocal_natural_radius(n + 1)
                    y $in intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                    y $in {}
                    impossible y $in {}
            by def:
                ? \metric_ball<X, dist>(x, epsilon) $subset set_minus(X, S)
        witness exist radius R+ st {\metric_ball<X, dist>(x, radius) $subset set_minus(X, S)} from epsilon
        by def:
            ? $has_metric_complement_ball(X, dist, S, x)
        impossible $has_metric_complement_ball(X, dist, S, x)

prop has_reciprocal_pair_approach(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u, v fn(n N) X):
    forall n N:
        n + 1 > 0
        dist(u(n), v(n)) < 1 / (n + 1)

thm reciprocal_close_subsequence_shares_limit:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u, v fn(n N) X, phi fn(n N) N, a X:
        $has_reciprocal_pair_approach(X, dist, u, v)
        $strictly_increasing_natural_map(phi)
        $metric_sequence_converges(X, dist, fn(n N) X {u(phi(n))}, a)
        =>:
            $metric_sequence_converges(X, dist, fn(n N) X {v(phi(n))}, a)
    claim:
        ? forall epsilon R+:
            exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {v(phi(n))}, a, epsilon, cutoff)}
        epsilon / 2 $in R+
        obtain Nu from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {u(phi(n))}, a, epsilon / 2, cutoff)}
        obtain p from exist q N+ st {1 / q < epsilon / 2}
        Nu + p >= Nu
        Nu + p >= p
        claim:
            ? $metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {v(phi(n))}, a, epsilon, Nu + p)
            claim:
                ? forall n N:
                    n >= Nu + p
                    =>:
                        dist(v(phi(n)), a) < epsilon
                n >= Nu + p >= Nu
                n >= Nu + p >= p
                dist(fn(index N) X {u(phi(index))}(n), a) < epsilon / 2
                dist(u(phi(n)), a) = dist(fn(index N) X {u(phi(index))}(n), a) < epsilon / 2
                phi(n) >= n
                phi(n) + 1 > 0
                dist(u(phi(n)), v(phi(n))) < 1 / (phi(n) + 1)
                phi(n) + 1 >= n + 1 >= p
                p * (phi(n) + 1) > 0
                1 / (phi(n) + 1) = p / (p * (phi(n) + 1))
                p / (p * (phi(n) + 1)) <= (phi(n) + 1) / (p * (phi(n) + 1))
                (phi(n) + 1) / (p * (phi(n) + 1)) = 1 / p
                dist(u(phi(n)), v(phi(n))) < 1 / (phi(n) + 1) <= 1 / p < epsilon / 2
                dist(v(phi(n)), u(phi(n))) = dist(u(phi(n)), v(phi(n))) < epsilon / 2
                dist(v(phi(n)), a) <= dist(v(phi(n)), u(phi(n))) + dist(u(phi(n)), a) < epsilon / 2 + epsilon / 2 = epsilon
            by def:
                ? $metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {v(phi(n))}, a, epsilon, Nu + p)
        witness exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, fn(n N) X {v(phi(n))}, a, epsilon, cutoff)} from Nu + p
    by def:
        ? $metric_sequence_converges(X, dist, fn(n N) X {v(phi(n))}, a)

prop pair_sequence_is_epsilon_close_from(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u, v fn(n N) X, epsilon R+, cutoff N):
    forall n N:
        n >= cutoff
        =>:
            dist(u(n), v(n)) < epsilon

thm same_metric_limit_implies_eventually_pair_close:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u, v fn(n N) X, a X, epsilon R+:
        $metric_sequence_converges(X, dist, u, a)
        $metric_sequence_converges(X, dist, v, a)
        =>:
            exist cutoff N st {$pair_sequence_is_epsilon_close_from(X, dist, u, v, epsilon, cutoff)}
    epsilon / 2 $in R+
    obtain Nu from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, u, a, epsilon / 2, cutoff)}
    obtain Nv from exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, v, a, epsilon / 2, cutoff)}
    Nu + Nv >= Nu
    Nu + Nv >= Nv
    claim:
        ? $pair_sequence_is_epsilon_close_from(X, dist, u, v, epsilon, Nu + Nv)
        claim:
            ? forall n N:
                n >= Nu + Nv
                =>:
                    dist(u(n), v(n)) < epsilon
            n >= Nu + Nv >= Nu
            n >= Nu + Nv >= Nv
            dist(u(n), a) < epsilon / 2
            dist(v(n), a) < epsilon / 2
            dist(a, v(n)) = dist(v(n), a) < epsilon / 2
            dist(u(n), v(n)) <= dist(u(n), a) + dist(a, v(n)) < epsilon / 2 + epsilon / 2 = epsilon
        by def:
            ? $pair_sequence_is_epsilon_close_from(X, dist, u, v, epsilon, Nu + Nv)
    witness exist cutoff N st {$pair_sequence_is_epsilon_close_from(X, dist, u, v, epsilon, cutoff)} from Nu + Nv

prop is_metric_compact(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X)):
    forall u fn(n N) X:
        $is_sequence_in_set(X, S, u)
        =>:
            exist a S, phi fn(n N) N st {$strictly_increasing_natural_map(phi), $metric_sequence_converges(X, dist, fn(n N) X {u(phi(n))}, a)}

have fn closed_real_interval(a, b R) power_set(R) = {x R: a <= x <= b}

have closed_unit_interval power_set(R) = closed_real_interval(0, 1)

prop is_minimizer_on(X set, S power_set(X), f fn(x X) R, x S):
    forall y S:
        f(x) <= f(y)

prop is_maximizer_on(X set, S power_set(X), f fn(x X) R, x S):
    forall y S:
        f(y) <= f(x)

prop is_compact_metric_space(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>):
    $is_metric_compact(X, dist, X)

# Unproved source goal: needs a checked real-completeness or
# Bolzano-Weierstrass interface. This proposition records the target without
# publishing it as a trusted theorem fact.
prop closed_unit_interval_metric_compactness_goal():
    $is_metric_compact(R, real_distance, closed_unit_interval)

# The whole carrier is compact exactly when the metric space is compact.
thm compact_metric_space_universe_is_compact:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>:
        $is_compact_metric_space(X, dist)
        =>:
            $is_metric_compact(X, dist, X)
    by def:
        ? $is_compact_metric_space(X, dist)

# Reusable countable choice from Chapter 4's checked total-inverse interface.
# This block precedes its metric and topology clients because Litex resolves
# theorem calls in source order.
prop _is_countable_choice_pair(X set, A fn(n N) power_set(X), pair cart(N, X)):
    pair[2] $in A(pair[1])

template<X set>:
    have fn countable_choice_pair_carrier(A fn(n N) power_set(X)) power_set(cart(N, X)) = {pair cart(N, X): $_is_countable_choice_pair(X, A, pair)}

prop is_countable_choice_sequence(X set, A fn(n N) power_set(X), selected fn(n N) X):
    forall n N:
        selected(n) $in A(n)

thm countable_choice_member_in_superset:
    ? forall X set, A fn(n N) power_set(X), selected fn(n N) X, n N, B power_set(X):
        $is_countable_choice_sequence(X, A, selected)
        A(n) $subset B
        =>:
            selected(n) $in B
    selected(n) $in A(n)

thm set_equality_implies_subset:
    ? forall X set, A, B power_set(X):
        A = B
        =>:
            A $subset B
    claim:
        ? forall x A:
            x $in B
        x $in A
        A = B
    by def:
        ? A $subset B

thm set_valued_object_equality_implies_subset:
    ? forall X, Y set, f fn(x X) power_set(Y), a, b X:
        a = b
        =>:
            f(a) $subset f(b)
    by thm chap9::object_substitution(X, power_set(Y), f, a, b)
    f(a) = f(b)
    by thm set_equality_implies_subset(Y, f(a), f(b))

thm set_not_empty_implies_nonempty:
    ? forall X set, S power_set(X):
        S != {}
        =>:
            $is_nonempty_set(S)
    by contra:
        ? $is_nonempty_set(S)
        not $is_nonempty_set(S)
        S = {}
        impossible S != {}

thm set_equality_transports_nonempty:
    ? forall X set, A, B power_set(X):
        A = B
        $is_nonempty_set(B)
        =>:
            $is_nonempty_set(A)
    obtain value from exist element B st {element $in B}
    B = A
    by thm set_equality_implies_subset(X, B, A)
    B $subset A
    value $in A
    witness $is_nonempty_set(A) from value:
        value $in A

thm countable_nonempty_family_has_choice_sequence:
    ? forall X set, A fn(n N) power_set(X):
        forall n N:
            $is_nonempty_set(A(n))
        =>:
            exist selected fn(n N) X st {$is_countable_choice_sequence(X, A, selected)}
    $is_nonempty_set(A(0))
    obtain x0 from exist x A(0) st {x $in A(0)}
    have default_pair cart(N, X) = (0, x0)
    claim:
        ? default_pair $in \countable_choice_pair_carrier<X>(A)
        default_pair[2] = x0
        default_pair[1] = 0
        x0 $in A(0)
        by def:
            ? $_is_countable_choice_pair(X, A, default_pair)
        by thm set_builder_member(default_pair, {pair cart(N, X): $_is_countable_choice_pair(X, A, pair)})
        \countable_choice_pair_carrier<X>(A) = {pair cart(N, X): $_is_countable_choice_pair(X, A, pair)}
        default_pair $in \countable_choice_pair_carrier<X>(A)
    witness $is_nonempty_set(\countable_choice_pair_carrier<X>(A)) from default_pair:
        default_pair $in \countable_choice_pair_carrier<X>(A)
    have choice_pairs nonempty_set = \countable_choice_pair_carrier<X>(A)
    have fn choice_index(pair choice_pairs) N = pair[1]
    by thm chap4::total_inverse_exists(choice_pairs, N, default_pair, choice_index)
    obtain inverse from exist inverse0 fn(index N) choice_pairs st {$chap4::is_total_inverse(choice_pairs, N, default_pair, choice_index, inverse0)}
    claim:
        ? forall n N:
            $chap4::has_preimage(choice_pairs, N, choice_index, n)
        $is_nonempty_set(A(n))
        obtain value from exist x A(n) st {x $in A(n)}
        have raw_pair cart(N, X) = (n, value)
        claim:
            ? raw_pair $in \countable_choice_pair_carrier<X>(A)
            raw_pair[2] = value
            raw_pair[1] = n
            value $in A(n)
            by def:
                ? $_is_countable_choice_pair(X, A, raw_pair)
            by thm set_builder_member(raw_pair, {candidate_pair cart(N, X): $_is_countable_choice_pair(X, A, candidate_pair)})
            \countable_choice_pair_carrier<X>(A) = {candidate_pair cart(N, X): $_is_countable_choice_pair(X, A, candidate_pair)}
            raw_pair $in \countable_choice_pair_carrier<X>(A)
        have pair choice_pairs = raw_pair
        witness exist candidate choice_pairs st {choice_index(candidate) = n} from pair:
            choice_index(pair) = pair[1] = raw_pair[1] = n
        by def:
            ? $chap4::has_preimage(choice_pairs, N, choice_index, n)
    claim:
        ? forall n N:
            choice_index(inverse(n)) = n
        by thm chap4::total_inverse_spec(choice_pairs, N, default_pair, choice_index, inverse, n)
    have fn ambient_inverse(n N) cart(N, X) = inverse(n)
    have fn selected(n N) X = ambient_inverse(n)[2]
    claim:
        ? forall n N:
            selected(n) $in A(n)
        inverse(n) $in choice_pairs
        ambient_inverse(n) = inverse(n)
        ambient_inverse(n) $in \countable_choice_pair_carrier<X>(A)
        \countable_choice_pair_carrier<X>(A) = {candidate_pair cart(N, X): $_is_countable_choice_pair(X, A, candidate_pair)}
        ambient_inverse(n) $in {candidate_pair cart(N, X): $_is_countable_choice_pair(X, A, candidate_pair)}
        $_is_countable_choice_pair(X, A, ambient_inverse(n))
        ambient_inverse(n)[2] $in A(ambient_inverse(n)[1])
        choice_index(inverse(n)) = inverse(n)[1] = ambient_inverse(n)[1]
        choice_index(inverse(n)) = n
        ambient_inverse(n)[1] = n
        by thm chap9::object_substitution(N, power_set(X), A, ambient_inverse(n)[1], n)
        A(ambient_inverse(n)[1]) = A(n)
        ambient_inverse(n)[2] $in A(n)
        selected(n) = ambient_inverse(n)[2]
    by def:
        ? $is_countable_choice_sequence(X, A, selected)
    witness exist selection fn(n N) X st {$is_countable_choice_sequence(X, A, selection)} from selected

thm compact_metric_set_is_closed:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X):
        $is_metric_compact(X, dist, S)
        =>:
            $is_metric_closed(X, dist, S)
    claim:
        ? $is_metric_open(X, dist, set_minus(X, S))
        claim:
            ? forall x set_minus(X, S):
                exist epsilon R+ st {\metric_ball<X, dist>(x, epsilon) $subset set_minus(X, S)}
            by contra:
                ? $has_metric_complement_ball(X, dist, S, x)
                not $has_metric_complement_ball(X, dist, S, x)
                claim:
                    ? forall n N:
                        intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))) $in power_set(X)
                    intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))) $subset S $subset X
                have fn hits(n N) power_set(X) = intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                claim:
                    ? forall n N:
                        $is_nonempty_set(hits(n))
                    by thm no_complement_ball_gives_reciprocal_hit(X, dist, S, x, n)
                    intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))) != {}
                    hits(n) = intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                    hits(n) != {}
                    by thm set_not_empty_implies_nonempty(X, hits(n))
                by thm countable_nonempty_family_has_choice_sequence(X, hits)
                obtain selected from exist selected0 fn(n N) X st {$is_countable_choice_sequence(X, hits, selected0)}
                claim:
                    ? $is_sequence_in_set(X, S, selected)
                    claim:
                        ? forall n N:
                            selected(n) $in S
                        by thm set_equality_implies_subset(X, hits(n), intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))))
                        hits(n) $subset intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                        by thm countable_choice_member_in_superset(X, hits, selected, n, intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))))
                        selected(n) $in intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                    by def:
                        ? $is_sequence_in_set(X, S, selected)
                claim:
                    ? $has_reciprocal_metric_approach(X, dist, selected, x)
                    claim:
                        ? forall n N:
                            n + 1 > 0
                            dist(selected(n), x) < 1 / (n + 1)
                        n + 1 > 0
                        by thm set_equality_implies_subset(X, hits(n), intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))))
                        hits(n) $subset intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                        by thm countable_choice_member_in_superset(X, hits, selected, n, intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))))
                        selected(n) $in intersect(S, \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1)))
                        selected(n) $in \metric_ball<X, dist>(x, reciprocal_natural_radius(n + 1))
                        dist(selected(n), x) < reciprocal_natural_radius(n + 1) = 1 / (n + 1)
                    by def:
                        ? $has_reciprocal_metric_approach(X, dist, selected, x)
                obtain a, phi from exist limit S, reindex fn(n N) N st {$strictly_increasing_natural_map(reindex), $metric_sequence_converges(X, dist, fn(n N) X {selected(reindex(n))}, limit)}
                by thm reciprocal_approach_subsequence_converges(X, dist, selected, x, phi)
                by thm metric_sequence_limit_unique(X, dist, fn(n N) X {selected(phi(n))}, a, x)
                a = x
                a $in S
                x $in S
                impossible x $in S
            by def:
                ? $has_metric_complement_ball(X, dist, S, x)
        by def:
            ? $is_metric_open(X, dist, set_minus(X, S))
    by def:
        ? $is_metric_closed(X, dist, S)

prop is_uniform_delta_control(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y, epsilon R+, delta R+):
    forall a, b X:
        dist_X(a, b) < delta
        =>:
            dist_Y(f(a), f(b)) < epsilon

prop is_uniformly_metric_continuous(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y):
    forall epsilon R+:
        exist delta R+ st {$is_uniform_delta_control(X, Y, dist_X, dist_Y, f, epsilon, delta)}

prop is_cauchy_after(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, epsilon R+, N0 N):
    forall m, n N:
        m >= N0
        n >= N0
        =>:
            dist(u(m), u(n)) < epsilon

prop is_cauchy_sequence(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X):
    forall epsilon R+:
        exist N0 N st {$is_cauchy_after(X, dist, u, epsilon, N0)}

prop is_cauchy_anchored_after(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, epsilon R+, N0 N):
    forall n N:
        n >= N0
        =>:
            dist(u(n), u(N0)) < epsilon

prop is_cauchy_sequence_anchored(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X):
    forall epsilon R+:
        exist N0 N st {$is_cauchy_anchored_after(X, dist, u, epsilon, N0)}

# Source examples Metric.cauchySeq_iff and Metric.cauchySeq_iff'. The forward
# bridge uses the same cutoff and anchors the second index at that cutoff.
thm cauchy_characterizations_equivalent_forward:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X:
        $is_cauchy_sequence(X, dist, u)
        =>:
            $is_cauchy_sequence_anchored(X, dist, u)
    claim:
        ? forall epsilon R+:
            exist K N st {$is_cauchy_anchored_after(X, dist, u, epsilon, K)}
        obtain N0 from exist K N st {$is_cauchy_after(X, dist, u, epsilon, K)}
        witness exist K N st {$is_cauchy_anchored_after(X, dist, u, epsilon, K)} from N0:
            claim:
                ? forall n N:
                    n >= N0
                    =>:
                        dist(u(n), u(N0)) < epsilon
                N0 >= N0
            by def:
                ? $is_cauchy_anchored_after(X, dist, u, epsilon, N0)
    by def:
        ? $is_cauchy_sequence_anchored(X, dist, u)

prop is_complete_metric_space(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>):
    forall u fn(n N) X:
        $is_cauchy_sequence(X, dist, u)
        =>:
            exist x X st {$metric_sequence_converges(X, dist, u, x)}

# Source example cauchySeq_tendsto_of_complete. This is the direct operational
# consequence of the explicit completeness interface above.
thm cauchy_sequence_converges_in_complete_space:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X:
        $is_complete_metric_space(X, dist)
        $is_cauchy_sequence(X, dist, u)
        =>:
            exist x X st {$metric_sequence_converges(X, dist, u, x)}

prop has_geometric_step_bound(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X):
    forall n N:
        dist(u(n), u(n + 1)) <= (1 / 2)^n

# Shallow power reasoning exposes exponent addition and power-one separately.
thm real_natural_power_successor:
    ? forall a R, n N:
        a^(n + 1) = a^n * a
    a^(n + 1) = a^n * a^1
    a^1 = a
    by thm chap9::object_substitution(R, R, fn(t R) R {a^n * t}, a^1, a)
    a^n * a^1 = a^n * a
    a^(n + 1) = a^n * a^1 = a^n * a

thm geometric_step_finite_telescope:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X, m, k N:
        $has_geometric_step_bound(X, dist, u)
        =>:
            dist(u(m), u(m + k)) <= 2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)
    by induc k from 0:
        ? dist(u(m), u(m + k)) <= 2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)

        ? from k = 0:
            m + 0 = m
            dist(u(m), u(m)) = 0
            by thm chap9::object_substitution(N, R, fn(t N) R {2 * (1 / 2)^m - 2 * (1 / 2)^t}, m + 0, m)
            fn(t N) R {2 * (1 / 2)^m - 2 * (1 / 2)^t}(m + 0) = fn(t N) R {2 * (1 / 2)^m - 2 * (1 / 2)^t}(m)
            2 * (1 / 2)^m - 2 * (1 / 2)^(m + 0) = 2 * (1 / 2)^m - 2 * (1 / 2)^m
            2 * (1 / 2)^m - 2 * (1 / 2)^m = 0
            2 * (1 / 2)^m - 2 * (1 / 2)^(m + 0) = 0
            dist(u(m), u(m + 0)) = dist(u(m), u(m)) = 0 = 2 * (1 / 2)^m - 2 * (1 / 2)^(m + 0)
            dist(u(m), u(m + 0)) <= 2 * (1 / 2)^m - 2 * (1 / 2)^(m + 0)

        ? induc:
            dist(u(m), u(m + k)) <= 2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)
            dist(u(m + k), u(m + k + 1)) <= (1 / 2)^(m + k)
            dist(u(m), u(m + k + 1)) <= dist(u(m), u(m + k)) + dist(u(m + k), u(m + k + 1))
            dist(u(m), u(m + k)) + dist(u(m + k), u(m + k + 1)) <= (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + dist(u(m + k), u(m + k + 1))
            (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + dist(u(m + k), u(m + k + 1)) <= (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + (1 / 2)^(m + k)
            dist(u(m), u(m + k + 1)) <= dist(u(m), u(m + k)) + dist(u(m + k), u(m + k + 1)) <= (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + dist(u(m + k), u(m + k + 1)) <= (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + (1 / 2)^(m + k)
            by thm real_natural_power_successor(1 / 2, m + k)
            by thm chap9::object_substitution(R, R, fn(t R) R {2 * t}, (1 / 2)^(m + k + 1), (1 / 2)^(m + k) * (1 / 2))
            2 * (1 / 2)^(m + k + 1) = 2 * ((1 / 2)^(m + k) * (1 / 2)) = (1 / 2)^(m + k)
            (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + (1 / 2)^(m + k) = 2 * (1 / 2)^m - (1 / 2)^(m + k)
            by thm chap9::object_substitution(R, R, fn(t R) R {2 * (1 / 2)^m - t}, 2 * (1 / 2)^(m + k + 1), (1 / 2)^(m + k))
            2 * (1 / 2)^m - 2 * (1 / 2)^(m + k + 1) = 2 * (1 / 2)^m - (1 / 2)^(m + k)
            (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + (1 / 2)^(m + k) = 2 * (1 / 2)^m - (1 / 2)^(m + k) = 2 * (1 / 2)^m - 2 * (1 / 2)^(m + k + 1)
            m + (k + 1) = m + k + 1
            dist(u(m), u(m + (k + 1))) = dist(u(m), u(m + k + 1)) <= (2 * (1 / 2)^m - 2 * (1 / 2)^(m + k)) + (1 / 2)^(m + k) = 2 * (1 / 2)^m - 2 * (1 / 2)^(m + k + 1) = 2 * (1 / 2)^m - 2 * (1 / 2)^(m + (k + 1))

thm natural_successor_le_two_power:
    ? forall n N:
        n + 1 <= 2^n
    by induc n from 0:
        ? n + 1 <= 2^n

        ? from n = 0:
            0 + 1 = 1 = 2^0
            0 + 1 <= 2^0

        ? induc:
            n + 1 <= 2^n
            0 <= n
            0 + (n + 2) <= n + (n + 2)
            n + 2 = 0 + (n + 2) <= n + (n + 2) = 2 * (n + 1)
            2 * (n + 1) <= 2 * 2^n
            2 * 2^n = 2^(n + 1)
            n + 1 + 1 = n + 2 <= 2 * (n + 1) <= 2 * 2^n = 2^(n + 1)

thm half_power_is_reciprocal_two_power:
    ? forall n N:
        (1 / 2)^n = 1 / (2^n)
    by induc n from 0:
        ? (1 / 2)^n = 1 / (2^n)

        ? from n = 0:
            (1 / 2)^0 = 1 = 1 / (2^0)

        ? induc:
            (1 / 2)^n = 1 / (2^n)
            by thm real_natural_power_successor(1 / 2, n)
            (1 / 2)^n * (1 / 2) = (1 / (2^n)) * (1 / 2)
            2^n > 0
            2^n * 2 > 0
            2^n * 2 != 0
            (1 / (2^n)) * (1 / 2) = 1 / (2^n * 2)
            by thm real_natural_power_successor(2, n)
            (1 / 2)^(n + 1) = (1 / 2)^n * (1 / 2) = (1 / (2^n)) * (1 / 2) = 1 / (2^n * 2) = 1 / (2^(n + 1))

thm geometric_tail_cutoff:
    ? forall epsilon R+:
        exist p N st {2 * (1 / 2)^p < epsilon}
    epsilon / 2 $in R+
    obtain n from exist n N+ st {1 / n < epsilon / 2}
    by thm natural_successor_le_two_power(n)
    n < n + 1 <= 2^n
    n > 0
    2^n > 0
    n * 2^n > 0
    1 / (2^n) = n / (n * 2^n)
    n / (n * 2^n) < 2^n / (n * 2^n)
    2^n / (n * 2^n) = 1 / n
    1 / (2^n) = n / (n * 2^n) < 2^n / (n * 2^n) = 1 / n
    by thm half_power_is_reciprocal_two_power(n)
    witness exist p N st {2 * (1 / 2)^p < epsilon} from n:
        2 * (1 / 2)^n = 2 * (1 / (2^n)) < 2 * (1 / n) < 2 * (epsilon / 2) = epsilon

thm geometric_step_is_cauchy_anchored:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X:
        $has_geometric_step_bound(X, dist, u)
        =>:
            $is_cauchy_sequence_anchored(X, dist, u)
    claim:
        ? forall epsilon R+:
            exist p N st {$is_cauchy_anchored_after(X, dist, u, epsilon, p)}
        obtain p from exist cutoff N st {2 * (1 / 2)^cutoff < epsilon}
        witness exist cutoff N st {$is_cauchy_anchored_after(X, dist, u, epsilon, cutoff)} from p:
            claim:
                ? forall n N:
                    n >= p
                    =>:
                        dist(u(n), u(p)) < epsilon
                n - p >= 0
                n - p $in N
                p + (n - p) = n
                by thm geometric_step_finite_telescope(X, dist, u, p, n - p)
                by thm chap9::object_substitution(N, R, fn(t N) R {2 * (1 / 2)^p - 2 * (1 / 2)^t}, p + (n - p), n)
                2 * (1 / 2)^p - 2 * (1 / 2)^(p + (n - p)) = 2 * (1 / 2)^p - 2 * (1 / 2)^n
                (1 / 2)^n >= 0
                2 * (1 / 2)^n >= 0
                2 * (1 / 2)^p - 2 * (1 / 2)^n <= 2 * (1 / 2)^p
                dist(u(p), u(n)) = dist(u(p), u(p + (n - p))) <= 2 * (1 / 2)^p - 2 * (1 / 2)^(p + (n - p)) = 2 * (1 / 2)^p - 2 * (1 / 2)^n <= 2 * (1 / 2)^p < epsilon
                dist(u(n), u(p)) = dist(u(p), u(n)) < epsilon
            by def:
                ? $is_cauchy_anchored_after(X, dist, u, epsilon, p)
    by def:
        ? $is_cauchy_sequence_anchored(X, dist, u)

prop is_metric_dense(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X)):
    forall x X, epsilon R:
        epsilon > 0
        =>:
            exist y S st {dist(x, y) < epsilon}

prop _belongs_every_countable_set(X set, A fn(n N) power_set(X), x X):
    forall n N:
        x $in A(n)

template<X set>:
    have fn countable_intersection(A fn(n N) power_set(X)) power_set(X) = {x X: $_belongs_every_countable_set(X, A, x)}

thm countable_intersection_member:
    ? forall X set, A fn(n N) power_set(X), x X:
        forall n N:
            x $in A(n)
        =>:
            x $in \countable_intersection<X>(A)
    by def:
        ? $_belongs_every_countable_set(X, A, x)
    by thm set_builder_member(x, {candidate X: $_belongs_every_countable_set(X, A, candidate)})
    \countable_intersection<X>(A) = {candidate X: $_belongs_every_countable_set(X, A, candidate)}

# Source headline result: the Baire category theorem.  The local center/radius
# choice functions from the Lean proof remain proof-local and are not exported.
prop is_countable_family_metric_open(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X)):
    forall n N:
        $is_metric_open(X, dist, A(n))

prop is_countable_family_metric_dense(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X)):
    forall n N:
        $is_metric_dense(X, dist, A(n))

prop is_serial_relation(X set, relation power_set(cart(X, X))):
    forall x X:
        exist y X st {(x, y) $in relation}

prop _belongs_relation_pair_carrier(X set, relation power_set(cart(X, X)), pair cart(X, X)):
    pair $in relation

template<X set>:
    have fn relation_pair_carrier(relation power_set(cart(X, X))) power_set(cart(X, X)) = {pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, pair)}

prop is_relation_path_from(X set, relation power_set(cart(X, X)), x0 X, u fn(n N) X):
    u(0) = x0
    forall n N:
        (u(n), u(n + 1)) $in relation

thm serial_relation_has_path:
    ? forall X nonempty_set, relation power_set(cart(X, X)), x0 X:
        $is_serial_relation(X, relation)
        =>:
            exist u fn(n N) X st {$is_relation_path_from(X, relation, x0, u)}
    obtain y0 from exist y X st {(x0, y) $in relation}
    (x0, y0) $in relation
    claim:
        ? (x0, y0) $in \relation_pair_carrier<X>(relation)
        by def:
            ? $_belongs_relation_pair_carrier(X, relation, (x0, y0))
        by thm set_builder_member((x0, y0), {pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, pair)})
        \relation_pair_carrier<X>(relation) = {pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, pair)}
        (x0, y0) $in \relation_pair_carrier<X>(relation)
    witness $is_nonempty_set(\relation_pair_carrier<X>(relation)) from (x0, y0):
        (x0, y0) $in \relation_pair_carrier<X>(relation)
    have relation_pairs nonempty_set = \relation_pair_carrier<X>(relation)
    have default_pair relation_pairs = (x0, y0)
    have fn source(pair relation_pairs) X = pair[1]
    claim:
        ? forall x X:
            $chap4::has_preimage(relation_pairs, X, source, x)
        obtain y from exist fresh_y X st {(x, fresh_y) $in relation}
        have raw_pair cart(X, X) = (x, y)
        claim:
            ? raw_pair $in \relation_pair_carrier<X>(relation)
            raw_pair = (x, y)
            by def:
                ? $_belongs_relation_pair_carrier(X, relation, raw_pair)
            by thm set_builder_member(raw_pair, {candidate_pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, candidate_pair)})
            \relation_pair_carrier<X>(relation) = {candidate_pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, candidate_pair)}
            raw_pair $in \relation_pair_carrier<X>(relation)
        have pair relation_pairs = raw_pair
        source(pair) = pair[1] = raw_pair[1] = x
        witness exist p relation_pairs st {source(p) = x} from pair
        by def:
            ? $chap4::has_preimage(relation_pairs, X, source, x)
    by thm chap4::total_inverse_exists(relation_pairs, X, default_pair, source)
    obtain inverse from exist inverse0 fn(x X) relation_pairs st {$chap4::is_total_inverse(relation_pairs, X, default_pair, source, inverse0)}
    claim:
        ? forall x X:
            source(inverse(x)) = x
        by thm chap4::total_inverse_spec(relation_pairs, X, default_pair, source, inverse, x)
    have fn ambient_pair(x X) cart(X, X) = inverse(x)
    have fn next(x X) X = ambient_pair(x)[2]
    claim:
        ? forall x X:
            (x, next(x)) $in relation
        inverse(x) $in relation_pairs
        ambient_pair(x) = inverse(x)
        ambient_pair(x) $in \relation_pair_carrier<X>(relation)
        \relation_pair_carrier<X>(relation) = {candidate_pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, candidate_pair)}
        ambient_pair(x) $in {candidate_pair cart(X, X): $_belongs_relation_pair_carrier(X, relation, candidate_pair)}
        $_belongs_relation_pair_carrier(X, relation, ambient_pair(x))
        by def:
            ? $_belongs_relation_pair_carrier(X, relation, ambient_pair(x))
        ambient_pair(x) $in relation
        source(inverse(x)) = inverse(x)[1] = ambient_pair(x)[1]
        source(inverse(x)) = x
        ambient_pair(x)[1] = x
        next(x) = ambient_pair(x)[2]
        ambient_pair(x)[2] = next(x)
        by thm tuple_equal_from_coordinates(ambient_pair(x), (x, next(x)))
        ambient_pair(x) = (x, next(x))
    have fn path(n N) X by induc n from 0:
        case n = 0: x0
        case n >= 1: next(path(n - 1))
    claim:
        ? path(0) = x0
        path(0) = x0
    claim:
        ? forall n N:
            (path(n), path(n + 1)) $in relation
        path(n + 1) = next(path(n + 1 - 1)) = next(path(n))
        (path(n), next(path(n))) $in relation
    by def:
        ? $is_relation_path_from(X, relation, x0, path)
    witness exist u fn(n N) X st {$is_relation_path_from(X, relation, x0, u)} from path

# The reverse bridge uses the same cutoff and an epsilon/2 triangle estimate.
thm cauchy_characterizations_equivalent_reverse:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X:
        $is_cauchy_sequence_anchored(X, dist, u)
        =>:
            $is_cauchy_sequence(X, dist, u)
    claim:
        ? forall epsilon R+:
            exist N0 N st {$is_cauchy_after(X, dist, u, epsilon, N0)}
        epsilon / 2 $in R+
        obtain N0 from exist cutoff N st {$is_cauchy_anchored_after(X, dist, u, epsilon / 2, cutoff)}
        witness exist cutoff N st {$is_cauchy_after(X, dist, u, epsilon, cutoff)} from N0:
            claim:
                ? forall m, n N:
                    m >= N0
                    n >= N0
                    =>:
                        dist(u(m), u(n)) < epsilon
                dist(u(m), u(N0)) < epsilon / 2
                dist(u(n), u(N0)) < epsilon / 2
                dist(u(N0), u(n)) = dist(u(n), u(N0)) < epsilon / 2
                dist(u(m), u(n)) <= dist(u(m), u(N0)) + dist(u(N0), u(n)) < epsilon / 2 + epsilon / 2 = epsilon
            by def:
                ? $is_cauchy_after(X, dist, u, epsilon, N0)
    by def:
        ? $is_cauchy_sequence(X, dist, u)

# Geometrically shrinking successive steps produce a Cauchy sequence and hence
# a limit in a complete metric space.
thm geometric_step_converges_in_complete_metric_space:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, u fn(n N) X:
        $is_complete_metric_space(X, dist)
        $has_geometric_step_bound(X, dist, u)
        =>:
            exist x X st {$metric_sequence_converges(X, dist, u, x)}
    by thm geometric_step_is_cauchy_anchored(X, dist, u)
    by thm cauchy_characterizations_equivalent_reverse(X, dist, u)
    by thm cauchy_sequence_converges_in_complete_space(X, dist, u)

prop is_uniform_delta_control_on(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon, delta R+):
    forall x, y S:
        dist_X(x, y) < delta
        =>:
            dist_Y(f(x), f(y)) < epsilon

prop is_uniformly_metric_continuous_on(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y):
    forall epsilon R+:
        exist delta R+ st {$is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)}

prop has_uniform_delta_on_at_epsilon(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon R+):
    exist delta R+ st {$is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)}

prop has_uniform_failure_on(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y):
    exist epsilon R+ st {not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)}

thm not_uniformly_continuous_on_has_failure_epsilon:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y:
        not $is_uniformly_metric_continuous_on(X, Y, dist_X, dist_Y, S, f)
        =>:
            $has_uniform_failure_on(X, Y, dist_X, dist_Y, S, f)
    by contra:
        ? $has_uniform_failure_on(X, Y, dist_X, dist_Y, S, f)
        not $has_uniform_failure_on(X, Y, dist_X, dist_Y, S, f)
        claim:
            ? forall epsilon R+:
                exist delta R+ st {$is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)}
            by contra:
                ? $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
                not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
                witness exist bad_epsilon R+ st {not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, bad_epsilon)} from epsilon
                by def:
                    ? $has_uniform_failure_on(X, Y, dist_X, dist_Y, S, f)
                impossible $has_uniform_failure_on(X, Y, dist_X, dist_Y, S, f)
            by def:
                ? $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
        by def:
            ? $is_uniformly_metric_continuous_on(X, Y, dist_X, dist_Y, S, f)
        impossible $is_uniformly_metric_continuous_on(X, Y, dist_X, dist_Y, S, f)

prop is_uniform_failure_pair(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon, delta R+, pair cart(X, X)):
    pair[1] $in S
    pair[2] $in S
    dist_X(pair[1], pair[2]) < delta
    dist_Y(f(pair[1]), f(pair[2])) >= epsilon

thm uniform_failure_pair_set_nonempty:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon, delta R+:
        not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
        =>:
            {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, delta, pair)} != {}
    by contra:
        ? not $is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)
        $is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)
        witness exist radius R+ st {$is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, radius)} from delta
        by def:
            ? $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
        impossible $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
    by contra:
        ? {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, delta, pair)} != {}
        {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, delta, pair)} = {}
        claim:
            ? $is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)
            claim:
                ? forall left, right S:
                    dist_X(left, right) < delta
                    =>:
                        dist_Y(f(left), f(right)) < epsilon
                by contra:
                    ? dist_Y(f(left), f(right)) < epsilon
                    dist_Y(f(left), f(right)) >= epsilon
                    have pair cart(X, X) = (left, right)
                    pair[1] = left
                    pair[2] = right
                    claim:
                        ? $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, delta, pair)
                        by def:
                            ? $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, delta, pair)
                    by thm set_builder_member(pair, {candidate cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, delta, candidate)})
                    pair $in {}
                    impossible pair $in {}
            by def:
                ? $is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)
        impossible $is_uniform_delta_control_on(X, Y, dist_X, dist_Y, S, f, epsilon, delta)

thm uniform_failure_reciprocal_pair_set_nonempty:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon R+, n N:
        not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
        =>:
            $is_nonempty_set({pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)})
    n + 1 > 0
    reciprocal_natural_radius(n + 1) = 1 / (n + 1) > 0
    by thm uniform_failure_pair_set_nonempty(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1))
    {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)} != {}
    by thm set_not_empty_implies_nonempty(cart(X, X), {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)})

prop has_uniform_output_separation(X, Y set, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, f fn(x X) Y, u, v fn(n N) X, epsilon R+):
    forall n N:
        dist_Y(f(u(n)), f(v(n))) >= epsilon

prop has_uniform_failure_sequences(X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon R+):
    exist u, v fn(n N) X st {$is_sequence_in_set(X, S, u), $is_sequence_in_set(X, S, v), $has_reciprocal_pair_approach(X, dist_X, u, v), $has_uniform_output_separation(X, Y, dist_Y, f, u, v, epsilon)}

thm uniform_failure_epsilon_has_sequences:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y, epsilon R+:
        not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, epsilon)
        =>:
            $has_uniform_failure_sequences(X, Y, dist_X, dist_Y, S, f, epsilon)
    claim:
        ? forall n N:
            {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)} $in power_set(cart(X, X))
        claim:
            ? {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)} $subset cart(X, X)
            claim:
                ? forall pair {candidate cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), candidate)}:
                    pair $in cart(X, X)
            by def:
                ? {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)} $subset cart(X, X)
    have fn bad_pairs(n N) power_set(cart(X, X)) = {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)}
    claim:
        ? forall n N:
            $is_nonempty_set(bad_pairs(n))
        by thm uniform_failure_reciprocal_pair_set_nonempty(X, Y, dist_X, dist_Y, S, f, epsilon, n)
        bad_pairs(n) = {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)}
        by thm set_equality_transports_nonempty(cart(X, X), bad_pairs(n), {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)})
    by thm countable_nonempty_family_has_choice_sequence(cart(X, X), bad_pairs)
    obtain selected from exist selected0 fn(n N) cart(X, X) st {$is_countable_choice_sequence(cart(X, X), bad_pairs, selected0)}
    have fn left(n N) X = selected(n)[1]
    have fn right(n N) X = selected(n)[2]
    claim:
        ? forall n N:
            $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), selected(n))
        by thm set_equality_implies_subset(cart(X, X), bad_pairs(n), {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)})
        bad_pairs(n) $subset {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)}
        by thm countable_choice_member_in_superset(cart(X, X), bad_pairs, selected, n, {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)})
        selected(n) $in {pair cart(X, X): $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), pair)}
    claim:
        ? $is_sequence_in_set(X, S, left)
        claim:
            ? forall n N:
                left(n) $in S
            $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), selected(n))
            selected(n)[1] $in S
            left(n) = selected(n)[1]
        by def:
            ? $is_sequence_in_set(X, S, left)
    claim:
        ? $is_sequence_in_set(X, S, right)
        claim:
            ? forall n N:
                right(n) $in S
            $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), selected(n))
            selected(n)[2] $in S
            right(n) = selected(n)[2]
        by def:
            ? $is_sequence_in_set(X, S, right)
    claim:
        ? $has_reciprocal_pair_approach(X, dist_X, left, right)
        claim:
            ? forall n N:
                n + 1 > 0
                dist_X(left(n), right(n)) < 1 / (n + 1)
            n + 1 > 0
            $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), selected(n))
            dist_X(selected(n)[1], selected(n)[2]) < reciprocal_natural_radius(n + 1)
            left(n) = selected(n)[1]
            right(n) = selected(n)[2]
            reciprocal_natural_radius(n + 1) = 1 / (n + 1)
            dist_X(left(n), right(n)) < 1 / (n + 1)
        by def:
            ? $has_reciprocal_pair_approach(X, dist_X, left, right)
    claim:
        ? $has_uniform_output_separation(X, Y, dist_Y, f, left, right, epsilon)
        claim:
            ? forall n N:
                dist_Y(f(left(n)), f(right(n))) >= epsilon
            $is_uniform_failure_pair(X, Y, dist_X, dist_Y, S, f, epsilon, reciprocal_natural_radius(n + 1), selected(n))
            dist_Y(f(selected(n)[1]), f(selected(n)[2])) >= epsilon
            left(n) = selected(n)[1]
            right(n) = selected(n)[2]
            by thm chap9::object_substitution(X, Y, f, left(n), selected(n)[1])
            f(left(n)) = f(selected(n)[1])
            by thm chap9::object_substitution(X, Y, f, right(n), selected(n)[2])
            f(right(n)) = f(selected(n)[2])
            by thm chap9::object_substitution(Y, R, fn(value Y) R {dist_Y(value, f(right(n)))}, f(left(n)), f(selected(n)[1]))
            dist_Y(f(left(n)), f(right(n))) = dist_Y(f(selected(n)[1]), f(right(n)))
            by thm chap9::object_substitution(Y, R, fn(value Y) R {dist_Y(f(selected(n)[1]), value)}, f(right(n)), f(selected(n)[2]))
            dist_Y(f(selected(n)[1]), f(right(n))) = dist_Y(f(selected(n)[1]), f(selected(n)[2]))
            dist_Y(f(left(n)), f(right(n))) = dist_Y(f(selected(n)[1]), f(right(n))) = dist_Y(f(selected(n)[1]), f(selected(n)[2])) >= epsilon
        by def:
            ? $has_uniform_output_separation(X, Y, dist_Y, f, left, right, epsilon)
    witness exist u, v fn(n N) X st {$is_sequence_in_set(X, S, u), $is_sequence_in_set(X, S, v), $has_reciprocal_pair_approach(X, dist_X, u, v), $has_uniform_output_separation(X, Y, dist_Y, f, u, v, epsilon)} from left, right
    by def:
        ? $has_uniform_failure_sequences(X, Y, dist_X, dist_Y, S, f, epsilon)

thm compact_metric_continuous_is_uniformly_continuous_on:
    ? forall X, Y set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, dist_Y &MILAlternative::chap2_struct::MetricSpace<Y>, S power_set(X), f fn(x X) Y:
        $is_metric_compact(X, dist_X, S)
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        =>:
            $is_uniformly_metric_continuous_on(X, Y, dist_X, dist_Y, S, f)
    by contra:
        ? $is_uniformly_metric_continuous_on(X, Y, dist_X, dist_Y, S, f)
        not $is_uniformly_metric_continuous_on(X, Y, dist_X, dist_Y, S, f)
        by thm not_uniformly_continuous_on_has_failure_epsilon(X, Y, dist_X, dist_Y, S, f)
        obtain epsilon from exist bad_epsilon R+ st {not $has_uniform_delta_on_at_epsilon(X, Y, dist_X, dist_Y, S, f, bad_epsilon)}
        by thm uniform_failure_epsilon_has_sequences(X, Y, dist_X, dist_Y, S, f, epsilon)
        obtain u, v from exist left, right fn(n N) X st {$is_sequence_in_set(X, S, left), $is_sequence_in_set(X, S, right), $has_reciprocal_pair_approach(X, dist_X, left, right), $has_uniform_output_separation(X, Y, dist_Y, f, left, right, epsilon)}
        obtain a, phi from exist limit S, reindex fn(n N) N st {$strictly_increasing_natural_map(reindex), $metric_sequence_converges(X, dist_X, fn(n N) X {u(reindex(n))}, limit)}
        by thm reciprocal_close_subsequence_shares_limit(X, dist_X, u, v, phi, a)
        $metric_sequence_converges(X, dist_X, fn(n N) X {v(phi(n))}, a)
        by thm metric_continuous_maps_sequence_limit(X, Y, dist_X, dist_Y, f, fn(n N) X {u(phi(n))}, a)
        $metric_sequence_converges(Y, dist_Y, fn(n N) Y {f(u(phi(n)))}, f(a))
        by thm metric_continuous_maps_sequence_limit(X, Y, dist_X, dist_Y, f, fn(n N) X {v(phi(n))}, a)
        $metric_sequence_converges(Y, dist_Y, fn(n N) Y {f(v(phi(n)))}, f(a))
        by thm same_metric_limit_implies_eventually_pair_close(Y, dist_Y, fn(n N) Y {f(u(phi(n)))}, fn(n N) Y {f(v(phi(n)))}, f(a), epsilon)
        obtain cutoff from exist K N st {$pair_sequence_is_epsilon_close_from(Y, dist_Y, fn(n N) Y {f(u(phi(n)))}, fn(n N) Y {f(v(phi(n)))}, epsilon, K)}
        cutoff >= cutoff
        dist_Y(fn(index N) Y {f(u(phi(index)))}(cutoff), fn(index N) Y {f(v(phi(index)))}(cutoff)) < epsilon
        dist_Y(f(u(phi(cutoff))), f(v(phi(cutoff)))) = dist_Y(fn(index N) Y {f(u(phi(index)))}(cutoff), fn(index N) Y {f(v(phi(index)))}(cutoff)) < epsilon
        $has_uniform_output_separation(X, Y, dist_Y, f, u, v, epsilon)
        dist_Y(f(u(phi(cutoff))), f(v(phi(cutoff)))) >= epsilon
        impossible dist_Y(f(u(phi(cutoff))), f(v(phi(cutoff)))) < epsilon

# Unproved source goal: the existential payload remains callable, while the
# conditional theorem is not asserted until real order completeness is
# available through a checked interface.
prop has_compact_metric_continuous_extrema(X set, S power_set(X), f fn(x X) R):
    exist xmin, xmax S st {$is_minimizer_on(X, S, f, xmin), $is_maximizer_on(X, S, f, xmax)}

prop compact_metric_continuous_extrema_goal(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X), f fn(x X) R):
    not $is_metric_compact(X, dist, S) or not $is_nonempty_set(S) or not $is_metric_continuous(X, R, dist, fn(x, y R) R {abs(x - y)}, f) or $has_compact_metric_continuous_extrema(X, S, f)

thm metric_open_dense_refines_ball:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A power_set(X), x X, epsilon, bound R+:
        $is_metric_open(X, dist, A)
        $is_metric_dense(X, dist, A)
        =>:
            exist y X, radius R+ st {y $in \metric_ball<X, dist>(x, epsilon), y $in A, radius <= bound, \metric_closed_ball<X, dist>(y, radius) $subset \metric_ball<X, dist>(x, epsilon), \metric_closed_ball<X, dist>(y, radius) $subset A}
    epsilon / 2 $in R+
    obtain y from exist point A st {dist(x, point) < epsilon / 2}
    dist(y, x) = dist(x, y) < epsilon / 2 < epsilon
    by thm set_builder_member(y, {point X: dist(point, x) < epsilon})
    \metric_ball<X, dist>(x, epsilon) = {point X: dist(point, x) < epsilon}
    y $in \metric_ball<X, dist>(x, epsilon)
    obtain delta from exist openness_radius R+ st {\metric_ball<X, dist>(y, openness_radius) $subset A}
    have gap R+ = epsilon - dist(y, x)
    gap / 2 $in R+
    delta / 2 $in R+
    by thm binary_min_positive(gap / 2, bound)
    have inner_radius R+ = finite_set_min(union({gap / 2}, {bound}))
    by thm binary_min_positive(delta / 2, inner_radius)
    have radius R+ = finite_set_min(union({delta / 2}, {inner_radius}))
    radius <= delta / 2
    radius <= inner_radius
    inner_radius <= gap / 2
    inner_radius <= bound
    radius <= inner_radius <= gap / 2
    radius <= inner_radius <= bound
    claim:
        ? \metric_closed_ball<X, dist>(y, radius) $subset A
        claim:
            ? forall z \metric_closed_ball<X, dist>(y, radius):
                z $in A
            dist(z, y) <= radius <= delta / 2 < delta
            by thm set_builder_member(z, {point X: dist(point, y) < delta})
            \metric_ball<X, dist>(y, delta) = {point X: dist(point, y) < delta}
            z $in \metric_ball<X, dist>(y, delta)
        by def:
            ? \metric_closed_ball<X, dist>(y, radius) $subset A
    claim:
        ? \metric_closed_ball<X, dist>(y, radius) $subset \metric_ball<X, dist>(x, epsilon)
        claim:
            ? forall z \metric_closed_ball<X, dist>(y, radius):
                z $in \metric_ball<X, dist>(x, epsilon)
            dist(z, y) <= radius <= gap / 2 < gap
            gap = epsilon - dist(y, x)
            gap + dist(y, x) = epsilon - dist(y, x) + dist(y, x) = epsilon
            dist(z, x) <= dist(z, y) + dist(y, x) < gap + dist(y, x) = epsilon
            by thm set_builder_member(z, {point X: dist(point, x) < epsilon})
            \metric_ball<X, dist>(x, epsilon) = {point X: dist(point, x) < epsilon}
        by def:
            ? \metric_closed_ball<X, dist>(y, radius) $subset \metric_ball<X, dist>(x, epsilon)
    witness exist center X, small_radius R+ st {center $in \metric_ball<X, dist>(x, epsilon), center $in A, small_radius <= bound, \metric_closed_ball<X, dist>(center, small_radius) $subset \metric_ball<X, dist>(x, epsilon), \metric_closed_ball<X, dist>(center, small_radius) $subset A} from y, radius

thm metric_closed_ball_is_metric_closed:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, center X, radius R:
        =>:
            $is_metric_closed(X, dist, \metric_closed_ball<X, dist>(center, radius))
    claim:
        ? $is_metric_open(X, dist, set_minus(X, \metric_closed_ball<X, dist>(center, radius)))
        claim:
            ? forall x set_minus(X, \metric_closed_ball<X, dist>(center, radius)):
                exist epsilon R+ st {\metric_ball<X, dist>(x, epsilon) $subset set_minus(X, \metric_closed_ball<X, dist>(center, radius))}
            not x $in \metric_closed_ball<X, dist>(center, radius)
            claim:
                ? dist(x, center) > radius
                by contra:
                    ? dist(x, center) > radius
                    dist(x, center) <= radius
                    by thm set_builder_member(x, {point X: dist(point, center) <= radius})
                    \metric_closed_ball<X, dist>(center, radius) = {point X: dist(point, center) <= radius}
                    x $in \metric_closed_ball<X, dist>(center, radius)
                    impossible not x $in \metric_closed_ball<X, dist>(center, radius)
            have gap R+ = dist(x, center) - radius
            gap / 2 $in R+
            gap + radius = dist(x, center) - radius + radius = dist(x, center)
            dist(x, center) = radius + gap
            claim:
                ? \metric_ball<X, dist>(x, gap / 2) $subset set_minus(X, \metric_closed_ball<X, dist>(center, radius))
                claim:
                    ? forall y \metric_ball<X, dist>(x, gap / 2):
                        y $in set_minus(X, \metric_closed_ball<X, dist>(center, radius))
                    y $in \metric_ball<X, dist>(x, gap / 2)
                    by thm metric_ball_member_distance(X, dist, x, gap / 2, y)
                    dist(y, x) < gap / 2
                    dist(x, y) = dist(y, x) < gap / 2
                    dist(x, center) <= dist(x, y) + dist(y, center)
                    dist(x, center) - dist(x, y) <= dist(x, y) + dist(y, center) - dist(x, y) = dist(y, center)
                    dist(x, center) - dist(x, y) > dist(x, center) - gap / 2
                    dist(x, center) - gap / 2 = radius + gap - gap / 2 = radius + gap / 2 > radius
                    dist(y, center) >= dist(x, center) - dist(x, y) > dist(x, center) - gap / 2 = radius + gap / 2 > radius
                    claim:
                        ? not y $in \metric_closed_ball<X, dist>(center, radius)
                        by contra:
                            ? not y $in \metric_closed_ball<X, dist>(center, radius)
                            y $in \metric_closed_ball<X, dist>(center, radius)
                            \metric_closed_ball<X, dist>(center, radius) = {point X: dist(point, center) <= radius}
                            y $in {point X: dist(point, center) <= radius}
                            dist(y, center) <= radius
                            impossible dist(y, center) > radius
                by def:
                    ? \metric_ball<X, dist>(x, gap / 2) $subset set_minus(X, \metric_closed_ball<X, dist>(center, radius))
            witness exist epsilon R+ st {\metric_ball<X, dist>(x, epsilon) $subset set_minus(X, \metric_closed_ball<X, dist>(center, radius))} from gap / 2
        by def:
            ? $is_metric_open(X, dist, set_minus(X, \metric_closed_ball<X, dist>(center, radius)))
    by def:
        ? $is_metric_closed(X, dist, \metric_closed_ball<X, dist>(center, radius))

prop is_baire_nested_ball_step(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X), left, right cart(N, cart(X, R+))):
    right[1] = left[1] + 1
    right[2][1] $in A(right[1])
    right[2][2] <= (1 / 2)^right[1]
    \metric_closed_ball<X, dist>(right[2][1], right[2][2]) $subset \metric_ball<X, dist>(left[2][1], left[2][2])
    \metric_closed_ball<X, dist>(right[2][1], right[2][2]) $subset A(right[1])

prop _is_baire_nested_ball_step_pair(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X), pair cart(cart(N, cart(X, R+)), cart(N, cart(X, R+)))):
    $is_baire_nested_ball_step(X, dist, A, pair[1], pair[2])

template<X set, dist &MILAlternative::chap2_struct::MetricSpace<X>>:
    have fn baire_nested_ball_relation(A fn(n N) power_set(X)) power_set(cart(cart(N, cart(X, R+)), cart(N, cart(X, R+)))) = {pair cart(cart(N, cart(X, R+)), cart(N, cart(X, R+))): $_is_baire_nested_ball_step_pair(X, dist, A, pair)}

thm baire_nested_ball_relation_member:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X), pair cart(cart(N, cart(X, R+)), cart(N, cart(X, R+))):
        $is_baire_nested_ball_step(X, dist, A, pair[1], pair[2])
        =>:
            pair $in \baire_nested_ball_relation<X, dist>(A)
    by def:
        ? $_is_baire_nested_ball_step_pair(X, dist, A, pair)
    by thm set_builder_member(pair, {candidate cart(cart(N, cart(X, R+)), cart(N, cart(X, R+))): $_is_baire_nested_ball_step_pair(X, dist, A, candidate)})
    \baire_nested_ball_relation<X, dist>(A) = {candidate cart(cart(N, cart(X, R+)), cart(N, cart(X, R+))): $_is_baire_nested_ball_step_pair(X, dist, A, candidate)}

thm baire_nested_ball_relation_is_serial:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X):
        $is_countable_family_metric_open(X, dist, A)
        $is_countable_family_metric_dense(X, dist, A)
        =>:
            $is_serial_relation(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A))
    claim:
        ? forall current cart(N, cart(X, R+)):
            exist successor cart(N, cart(X, R+)) st {(current, successor) $in \baire_nested_ball_relation<X, dist>(A)}
        have next_stage N = current[1] + 1
        have bound R+ = (1 / 2)^next_stage
        by thm metric_open_dense_refines_ball(X, dist, A(next_stage), current[2][1], current[2][2], bound)
        obtain next_center, next_radius from exist y X, radius R+ st {y $in \metric_ball<X, dist>(current[2][1], current[2][2]), y $in A(next_stage), radius <= bound, \metric_closed_ball<X, dist>(y, radius) $subset \metric_ball<X, dist>(current[2][1], current[2][2]), \metric_closed_ball<X, dist>(y, radius) $subset A(next_stage)}
        have next_payload cart(X, R+) = (next_center, next_radius)
        have successor cart(N, cart(X, R+)) = (next_stage, next_payload)
        claim:
            ? $is_baire_nested_ball_step(X, dist, A, current, successor)
            successor[1] = next_stage = current[1] + 1
            successor[2] = next_payload
            successor[2][1] = next_payload[1] = next_center
            successor[2][2] = next_payload[2] = next_radius
            next_center $in A(next_stage)
            successor[2][1] $in A(successor[1])
            next_radius <= bound = (1 / 2)^next_stage = (1 / 2)^successor[1]
            \metric_closed_ball<X, dist>(successor[2][1], successor[2][2]) $subset \metric_ball<X, dist>(current[2][1], current[2][2])
            \metric_closed_ball<X, dist>(successor[2][1], successor[2][2]) $subset A(successor[1])
            by def:
                ? $is_baire_nested_ball_step(X, dist, A, current, successor)
        have step_pair cart(cart(N, cart(X, R+)), cart(N, cart(X, R+))) = (current, successor)
        claim:
            ? step_pair $in \baire_nested_ball_relation<X, dist>(A)
            step_pair[1] = current
            step_pair[2] = successor
            by thm baire_nested_ball_relation_member(X, dist, A, step_pair)
        witness exist next_state cart(N, cart(X, R+)) st {(current, next_state) $in \baire_nested_ball_relation<X, dist>(A)} from successor
    by def:
        ? $is_serial_relation(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A))

thm baire_state_path_radius_is_nonnegative:
    ? forall X set, path fn(n N) cart(N, cart(X, R+)), n N:
        path(n)[2][2] >= 0
    have payload cart(X, R+) = path(n)[2]
    have positive_radius R+ = payload[2]
    positive_radius > 0
    positive_radius >= 0
    positive_radius = payload[2] = path(n)[2][2]

thm baire_relation_path_has_step:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(n N) power_set(X), state0 cart(N, cart(X, R+)), path fn(n N) cart(N, cart(X, R+)), n N:
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        =>:
            $is_baire_nested_ball_step(X, dist, A, path(n), path(n + 1))
    (path(n), path(n + 1)) $in \baire_nested_ball_relation<X, dist>(A)
    have pair cart(cart(N, cart(X, R+)), cart(N, cart(X, R+))) = (path(n), path(n + 1))
    pair $in \baire_nested_ball_relation<X, dist>(A)
    by def:
        ? $_is_baire_nested_ball_step_pair(X, dist, A, pair)
    pair[1] = path(n)
    pair[2] = path(n + 1)

thm baire_relation_path_stage_is_index:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X), state0 cart(N, cart(X, R+)), path fn(level N) cart(N, cart(X, R+)), n N:
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        state0[1] = 0
        =>:
            path(n)[1] = n
    by induc n from 0:
        ? path(n)[1] = n

        ? from n = 0:
            path(0) = state0
            path(0)[1] = state0[1] = 0

        ? induc:
            path(n)[1] = n
            by thm baire_relation_path_has_step(X, dist, A, state0, path, n)
            path(n + 1)[1] = path(n)[1] + 1 = n + 1

thm baire_relation_path_radius_bound:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X), state0 cart(N, cart(X, R+)), path fn(level N) cart(N, cart(X, R+)), n N:
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        state0[1] = 0
        state0[2][2] <= 1
        =>:
            path(n)[2][2] <= (1 / 2)^n
    by induc n from 0:
        ? path(n)[2][2] <= (1 / 2)^n

        ? from n = 0:
            path(0) = state0
            path(0)[2][2] = state0[2][2] <= 1 = (1 / 2)^0

        ? induc:
            by thm baire_relation_path_has_step(X, dist, A, state0, path, n)
            path(n + 1)[2][2] <= (1 / 2)^path(n + 1)[1]
            by thm baire_relation_path_stage_is_index(X, dist, A, state0, path, n + 1)
            path(n + 1)[1] = n + 1
            path(n + 1)[2][2] <= (1 / 2)^(n + 1)

thm baire_relation_path_closed_ball_in_set:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X), state0 cart(N, cart(X, R+)), path fn(level N) cart(N, cart(X, R+)), n N:
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        state0[1] = 0
        \metric_closed_ball<X, dist>(state0[2][1], state0[2][2]) $subset A(0)
        =>:
            \metric_closed_ball<X, dist>(path(n)[2][1], path(n)[2][2]) $subset A(n)
    by induc n from 0:
        ? \metric_closed_ball<X, dist>(path(n)[2][1], path(n)[2][2]) $subset A(n)

        ? from n = 0:
            path(0) = state0
            path(0)[2] = state0[2]
            path(0)[2][1] = state0[2][1]
            path(0)[2][2] = state0[2][2]
            \metric_closed_ball<X, dist>(path(0)[2][1], path(0)[2][2]) $subset A(0)

        ? induc:
            by thm baire_relation_path_has_step(X, dist, A, state0, path, n)
            \metric_closed_ball<X, dist>(path(n + 1)[2][1], path(n + 1)[2][2]) $subset A(path(n + 1)[1])
            by thm baire_relation_path_stage_is_index(X, dist, A, state0, path, n + 1)
            path(n + 1)[1] = n + 1
            \metric_closed_ball<X, dist>(path(n + 1)[2][1], path(n + 1)[2][2]) $subset A(n + 1)

thm baire_relation_path_center_step_bound:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X), state0 cart(N, cart(X, R+)), path fn(level N) cart(N, cart(X, R+)), n N:
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        state0[1] = 0
        state0[2][2] <= 1
        =>:
            dist(path(n)[2][1], path(n + 1)[2][1]) <= (1 / 2)^n
    by thm baire_relation_path_has_step(X, dist, A, state0, path, n)
    by thm baire_state_path_radius_is_nonnegative(X, path, n + 1)
    by thm metric_closed_ball_contains_center(X, dist, path(n + 1)[2][1], path(n + 1)[2][2])
    path(n + 1)[2][1] $in \metric_closed_ball<X, dist>(path(n + 1)[2][1], path(n + 1)[2][2])
    \metric_closed_ball<X, dist>(path(n + 1)[2][1], path(n + 1)[2][2]) $subset \metric_ball<X, dist>(path(n)[2][1], path(n)[2][2])
    path(n + 1)[2][1] $in \metric_ball<X, dist>(path(n)[2][1], path(n)[2][2])
    dist(path(n + 1)[2][1], path(n)[2][1]) < path(n)[2][2]
    by thm baire_relation_path_radius_bound(X, dist, A, state0, path, n)
    dist(path(n)[2][1], path(n + 1)[2][1]) = dist(path(n + 1)[2][1], path(n)[2][1]) < path(n)[2][2] <= (1 / 2)^n

thm baire_relation_path_closed_balls_nested:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X), state0 cart(N, cart(X, R+)), path fn(level N) cart(N, cart(X, R+)), k, n N:
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        =>:
            \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2]) $subset \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
    by induc n from 0:
        ? \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2]) $subset \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])

        ? from n = 0:
            k + 0 = k
            by thm chap9::object_substitution(N, cart(N, cart(X, R+)), path, k + 0, k)
            path(k + 0) = path(k)
            by thm set_valued_object_equality_implies_subset(cart(N, cart(X, R+)), X, fn(state cart(N, cart(X, R+))) power_set(X) {\metric_closed_ball<X, dist>(state[2][1], state[2][2])}, path(k + 0), path(k))

        ? induc:
            \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2]) $subset \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
            by thm baire_relation_path_has_step(X, dist, A, state0, path, k + n)
            \metric_closed_ball<X, dist>(path(k + n + 1)[2][1], path(k + n + 1)[2][2]) $subset \metric_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
            claim:
                ? \metric_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2]) $subset \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
                claim:
                    ? forall z \metric_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2]):
                        z $in \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
                    by thm metric_ball_member_distance(X, dist, path(k + n)[2][1], path(k + n)[2][2], z)
                    dist(z, path(k + n)[2][1]) < path(k + n)[2][2]
                    dist(z, path(k + n)[2][1]) <= path(k + n)[2][2]
                    by thm metric_closed_ball_member_of_distance(X, dist, path(k + n)[2][1], z, path(k + n)[2][2])
                by def:
                    ? \metric_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2]) $subset \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
            claim:
                ? \metric_closed_ball<X, dist>(path(k + n + 1)[2][1], path(k + n + 1)[2][2]) $subset \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
                claim:
                    ? forall z \metric_closed_ball<X, dist>(path(k + n + 1)[2][1], path(k + n + 1)[2][2]):
                        z $in \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
                    z $in \metric_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
                    z $in \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
                by def:
                    ? \metric_closed_ball<X, dist>(path(k + n + 1)[2][1], path(k + n + 1)[2][2]) $subset \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
            k + (n + 1) = k + n + 1
            by thm chap9::object_substitution(N, cart(N, cart(X, R+)), path, k + (n + 1), k + n + 1)
            path(k + (n + 1)) = path(k + n + 1)
            path(k + (n + 1))[2][1] = path(k + n + 1)[2][1]
            path(k + (n + 1))[2][2] = path(k + n + 1)[2][2]
            \metric_closed_ball<X, dist>(path(k + (n + 1))[2][1], path(k + (n + 1))[2][2]) $subset \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])

prop is_baire_relation_path_limit(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, path fn(level N) cart(N, cart(X, R+)), limit X):
    $metric_sequence_converges(X, dist, fn(n N) X {path(n)[2][1]}, limit)
    forall k N:
        limit $in \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])

thm baire_relation_path_has_limit:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X), state0 cart(N, cart(X, R+)), path fn(level N) cart(N, cart(X, R+)):
        $is_complete_metric_space(X, dist)
        $is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path)
        state0[1] = 0
        state0[2][2] <= 1
        =>:
            exist limit X st {$is_baire_relation_path_limit(X, dist, path, limit)}
    have fn center(n N) X = path(n)[2][1]
    claim:
        ? $has_geometric_step_bound(X, dist, center)
        claim:
            ? forall n N:
                dist(center(n), center(n + 1)) <= (1 / 2)^n
            by thm baire_relation_path_center_step_bound(X, dist, A, state0, path, n)
            center(n) = path(n)[2][1]
            center(n + 1) = path(n + 1)[2][1]
        by def:
            ? $has_geometric_step_bound(X, dist, center)
    by thm geometric_step_converges_in_complete_metric_space(X, dist, center)
    obtain limit from exist point X st {$metric_sequence_converges(X, dist, center, point)}
    claim:
        ? forall k N:
            limit $in \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
        have fn shifted(n N) X = center(k + n)
        claim:
            ? $metric_sequence_converges(X, dist, shifted, limit)
            claim:
                ? forall eta R+:
                    exist cutoff N st {$metric_sequence_is_epsilon_close_from(X, dist, shifted, limit, eta, cutoff)}
                obtain cutoff from exist N0 N st {$metric_sequence_is_epsilon_close_from(X, dist, center, limit, eta, N0)}
                claim:
                    ? $metric_sequence_is_epsilon_close_from(X, dist, shifted, limit, eta, cutoff)
                    claim:
                        ? forall n N:
                            n >= cutoff
                            =>:
                                dist(shifted(n), limit) < eta
                        k + n >= n >= cutoff
                        dist(center(k + n), limit) < eta
                        shifted(n) = center(k + n)
                    by def:
                        ? $metric_sequence_is_epsilon_close_from(X, dist, shifted, limit, eta, cutoff)
                witness exist N0 N st {$metric_sequence_is_epsilon_close_from(X, dist, shifted, limit, eta, N0)} from cutoff
            by def:
                ? $metric_sequence_converges(X, dist, shifted, limit)
        claim:
            ? $is_sequence_in_set(X, \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2]), shifted)
            claim:
                ? forall n N:
                    shifted(n) $in \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
                by thm baire_state_path_radius_is_nonnegative(X, path, k + n)
                by thm metric_closed_ball_contains_center(X, dist, path(k + n)[2][1], path(k + n)[2][2])
                path(k + n)[2][1] $in \metric_closed_ball<X, dist>(path(k + n)[2][1], path(k + n)[2][2])
                by thm baire_relation_path_closed_balls_nested(X, dist, A, state0, path, k, n)
                path(k + n)[2][1] $in \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
                shifted(n) = center(k + n) = path(k + n)[2][1]
            by def:
                ? $is_sequence_in_set(X, \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2]), shifted)
        by thm metric_closed_ball_is_metric_closed(X, dist, path(k)[2][1], path(k)[2][2])
        by thm metric_closed_contains_sequence_limit(X, dist, \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2]), shifted, limit)
    claim:
        ? $metric_sequence_converges(X, dist, fn(n N) X {path(n)[2][1]}, limit)
        center = fn(n N) X {path(n)[2][1]}
        $metric_sequence_converges(X, dist, center, limit)
    by def:
        ? $is_baire_relation_path_limit(X, dist, path, limit)
    witness exist point X st {$is_baire_relation_path_limit(X, dist, path, point)} from limit

# Baire: a countable intersection of open dense sets is dense in a complete
# metric space. The intersection remains the callable set defined above.
thm baire_category_metric:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X):
        $is_complete_metric_space(X, dist)
        $is_countable_family_metric_open(X, dist, A)
        $is_countable_family_metric_dense(X, dist, A)
        =>:
            $is_metric_dense(X, dist, \countable_intersection<X>(A))
    claim:
        ? forall x X, epsilon R:
            epsilon > 0
            =>:
                exist y \countable_intersection<X>(A) st {dist(x, y) < epsilon}
        have epsilon_pos R+ = epsilon
        have one_pos R+ = 1
        by thm metric_open_dense_refines_ball(X, dist, A(0), x, epsilon_pos, one_pos)
        obtain center0, radius0 from exist y X, radius R+ st {y $in \metric_ball<X, dist>(x, epsilon_pos), y $in A(0), radius <= one_pos, \metric_closed_ball<X, dist>(y, radius) $subset \metric_ball<X, dist>(x, epsilon_pos), \metric_closed_ball<X, dist>(y, radius) $subset A(0)}
        have payload0 cart(X, R+) = (center0, radius0)
        have state0 cart(N, cart(X, R+)) = (0, payload0)
        state0[1] = 0
        state0[2] = payload0
        state0[2][1] = center0
        state0[2][2] = radius0
        state0[2][2] <= 1
        \metric_closed_ball<X, dist>(state0[2][1], state0[2][2]) $subset A(0)
        witness $is_nonempty_set(cart(N, cart(X, R+))) from state0:
            state0 $in cart(N, cart(X, R+))
        by thm baire_nested_ball_relation_is_serial(X, dist, A)
        by thm serial_relation_has_path(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0)
        obtain path from exist path0 fn(n N) cart(N, cart(X, R+)) st {$is_relation_path_from(cart(N, cart(X, R+)), \baire_nested_ball_relation<X, dist>(A), state0, path0)}
        by thm baire_relation_path_has_limit(X, dist, A, state0, path)
        obtain limit from exist point X st {$is_baire_relation_path_limit(X, dist, path, point)}
        claim:
            ? forall k N:
                limit $in A(k)
            limit $in \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2])
            by thm baire_relation_path_closed_ball_in_set(X, dist, A, state0, path, k)
            \metric_closed_ball<X, dist>(path(k)[2][1], path(k)[2][2]) $subset A(k)
        claim:
            ? limit $in \countable_intersection<X>(A)
            by thm countable_intersection_member(X, A, limit)
        limit $in \metric_closed_ball<X, dist>(path(0)[2][1], path(0)[2][2])
        path(0) = state0
        path(0)[2] = state0[2]
        path(0)[2][1] = state0[2][1] = center0
        path(0)[2][2] = state0[2][2] = radius0
        limit $in \metric_closed_ball<X, dist>(center0, radius0)
        \metric_closed_ball<X, dist>(center0, radius0) $subset \metric_ball<X, dist>(x, epsilon_pos)
        limit $in \metric_ball<X, dist>(x, epsilon_pos)
        dist(limit, x) < epsilon_pos
        dist(x, limit) = dist(limit, x) < epsilon_pos = epsilon
        witness exist y \countable_intersection<X>(A) st {dist(x, y) < epsilon} from limit
    by def:
        ? $is_metric_dense(X, dist, \countable_intersection<X>(A))

prop contains_metric_open_ball(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X)):
    exist center X, epsilon R+ st {\metric_ball<X, dist>(center, epsilon) $subset S}

prop has_metric_point_within(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, T power_set(X), x X, epsilon R+):
    exist y T st {dist(x, y) < epsilon}

thm no_metric_open_ball_implies_dense_complement:
    ? forall X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, S power_set(X):
        not $contains_metric_open_ball(X, dist, S)
        =>:
            $is_metric_dense(X, dist, set_minus(X, S))
    claim:
        ? forall x X, epsilon R+:
            $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
        by contra:
            ? $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
            not $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
            claim:
                ? forall y \metric_ball<X, dist>(x, epsilon):
                    y $in S
                by contra:
                    ? y $in S
                    not y $in S
                    y $in set_minus(X, S)
                    dist(y, x) < epsilon
                    dist(x, y) = dist(y, x) < epsilon
                    witness exist z set_minus(X, S) st {dist(x, z) < epsilon} from y
                    by def:
                        ? $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
                    impossible not $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
            by def:
                ? \metric_ball<X, dist>(x, epsilon) $subset S
            witness exist center X, radius R+ st {\metric_ball<X, dist>(center, radius) $subset S} from x, epsilon
            by def:
                ? $contains_metric_open_ball(X, dist, S)
            impossible not $contains_metric_open_ball(X, dist, S)
    claim:
        ? forall x X, epsilon R:
            epsilon > 0
            =>:
                exist y set_minus(X, S) st {dist(x, y) < epsilon}
        epsilon $in R+
        $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
        by def:
            ? $has_metric_point_within(X, dist, set_minus(X, S), x, epsilon)
    by def:
        ? $is_metric_dense(X, dist, set_minus(X, S))

prop indexed_family_contains_metric_ball(X set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X)):
    exist k N, center X, epsilon R+ st {\metric_ball<X, dist>(center, epsilon) $subset A(k)}

# Closed-cover form of Baire used by the uniform boundedness principle.
# If countably many closed sets cover a nonempty complete metric space, one
# member contains an open ball.
thm complete_metric_closed_cover_has_ball_checked:
    ? forall X nonempty_set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X):
        $is_complete_metric_space(X, dist)
        forall k N:
            $is_metric_closed(X, dist, A(k))
        forall x X:
            exist k N st {x $in A(k)}
        =>:
            $indexed_family_contains_metric_ball(X, dist, A)
    by contra:
        ? $indexed_family_contains_metric_ball(X, dist, A)
        not $indexed_family_contains_metric_ball(X, dist, A)
        claim:
            ? forall k N:
                not $contains_metric_open_ball(X, dist, A(k))
            by contra:
                ? not $contains_metric_open_ball(X, dist, A(k))
                $contains_metric_open_ball(X, dist, A(k))
                obtain center, epsilon from exist point X, radius R+ st {\metric_ball<X, dist>(point, radius) $subset A(k)}
                claim:
                    ? $indexed_family_contains_metric_ball(X, dist, A)
                    witness exist level N, point X, radius R+ st {\metric_ball<X, dist>(point, radius) $subset A(level)} from k, center, epsilon
                    by def:
                        ? $indexed_family_contains_metric_ball(X, dist, A)
                impossible $indexed_family_contains_metric_ball(X, dist, A)
        have fn complements(k N) power_set(X) = set_minus(X, A(k))
        claim:
            ? $is_countable_family_metric_open(X, dist, complements)
            claim:
                ? forall k N:
                    $is_metric_open(X, dist, complements(k))
                $is_metric_closed(X, dist, A(k))
                $is_metric_open(X, dist, set_minus(X, A(k)))
                complements(k) = set_minus(X, A(k))
            by def:
                ? $is_countable_family_metric_open(X, dist, complements)
        claim:
            ? $is_countable_family_metric_dense(X, dist, complements)
            claim:
                ? forall k N:
                    $is_metric_dense(X, dist, complements(k))
                by thm no_metric_open_ball_implies_dense_complement(X, dist, A(k))
                complements(k) = set_minus(X, A(k))
            by def:
                ? $is_countable_family_metric_dense(X, dist, complements)
        by thm baire_category_metric(X, dist, complements)
        obtain x from exist point X st {point $in X}
        have one R+ = 1
        obtain y from exist point \countable_intersection<X>(complements) st {dist(x, point) < one}
        obtain k from exist level N st {y $in A(level)}
        y $in complements(k)
        complements(k) = set_minus(X, A(k))
        y $in set_minus(X, A(k))
        not y $in A(k)
        impossible y $in A(k)

thm complete_metric_closed_cover_has_ball:
    ? forall X nonempty_set, dist &MILAlternative::chap2_struct::MetricSpace<X>, A fn(level N) power_set(X):
        $is_complete_metric_space(X, dist)
        forall k N:
            $is_metric_closed(X, dist, A(k))
        forall x X:
            exist k N st {x $in A(k)}
        =>:
            exist k N, center X, epsilon R+ st {\metric_ball<X, dist>(center, epsilon) $subset A(k)}
    by thm complete_metric_closed_cover_has_ball_checked(X, dist, A)
    by def:
        ? $indexed_family_contains_metric_ball(X, dist, A)

# ---------------------------------------------------------------------------
# Section 11.3 — Topological Spaces
# ---------------------------------------------------------------------------

prop _belongs_family_union(X set, family power_set(power_set(X)), x X):
    exist U family st {x $in U}

template<X set>:
    have fn family_union(family power_set(power_set(X))) power_set(X) = {x X: $_belongs_family_union(X, family, x)}

thm family_union_member:
    ? forall X set, family power_set(power_set(X)), x X:
        $_belongs_family_union(X, family, x)
        =>:
            x $in \family_union<X>(family)
    by thm set_builder_member(x, {candidate X: $_belongs_family_union(X, family, candidate)})
    \family_union<X>(family) = {candidate X: $_belongs_family_union(X, family, candidate)}

# A topology is a candidate collection of open sets satisfying the usual
# axioms.  It is not itself collapsed into a proposition.
prop is_topology_on(X set, T power_set(power_set(X))):
    {} $in T
    X $in T
    forall U, V T:
        intersect(U, V) $in T
    forall family power_set(power_set(X)):
        family $subset T
        =>:
            \family_union<X>(family) $in T

template<X set>:
    have Topology set = {T power_set(power_set(X)): $is_topology_on(X, T)}

thm topology_member:
    ? forall X set, T power_set(power_set(X)):
        $is_topology_on(X, T)
        =>:
            T $in \Topology<X>
    by thm set_builder_member(T, {candidate power_set(power_set(X)): $is_topology_on(X, candidate)})
    \Topology<X> = {candidate power_set(power_set(X)): $is_topology_on(X, candidate)}

thm topology_member_is_topology:
    ? forall X set, T \Topology<X>:
        $is_topology_on(X, T)
    T $in \Topology<X>
    \Topology<X> = {candidate power_set(power_set(X)): $is_topology_on(X, candidate)}
    T $in {candidate power_set(power_set(X)): $is_topology_on(X, candidate)}

prop is_topologically_open(X set, T power_set(power_set(X)), U power_set(X)):
    U $in T

prop is_topologically_closed(X set, T power_set(power_set(X)), S power_set(X)):
    set_minus(X, S) $in T

thm topology_contains_empty_and_univ:
    ? forall X set, T power_set(power_set(X)):
        $is_topology_on(X, T)
        =>:
            {} $in T
            X $in T
    {} $in T
    X $in T

thm topology_closed_under_arbitrary_unions:
    ? forall X set, T power_set(power_set(X)), family power_set(power_set(X)):
        $is_topology_on(X, T)
        family $subset T
        =>:
            \family_union<X>(family) $in T

prop has_open_preimages(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), f fn(x X) Y):
    forall V T_Y:
        {x X: f(x) $in V} $in T_X

prop _is_topological_neighborhood(X set, T power_set(power_set(X)), x X, S power_set(X)):
    exist U T st {x $in U, U $subset S}

template<X set>:
    have fn topological_neighborhood_filter_sets(T power_set(power_set(X)), x X) power_set(power_set(X)) = {S power_set(X): $_is_topological_neighborhood(X, T, x, S)}

thm topological_neighborhood_filter_sets_member:
    ? forall X set, T power_set(power_set(X)), x X, S power_set(X):
        $_is_topological_neighborhood(X, T, x, S)
        =>:
            S $in \topological_neighborhood_filter_sets<X>(T, x)
    by thm set_builder_member(S, {candidate power_set(X): $_is_topological_neighborhood(X, T, x, candidate)})
    \topological_neighborhood_filter_sets<X>(T, x) = {candidate power_set(X): $_is_topological_neighborhood(X, T, x, candidate)}

thm topological_neighborhood_filter_sets_is_neighborhood:
    ? forall X set, T power_set(power_set(X)), x X, S \topological_neighborhood_filter_sets<X>(T, x):
        $_is_topological_neighborhood(X, T, x, S)
    S $in \topological_neighborhood_filter_sets<X>(T, x)
    \topological_neighborhood_filter_sets<X>(T, x) = {candidate power_set(X): $_is_topological_neighborhood(X, T, x, candidate)}
    S $in {candidate power_set(X): $_is_topological_neighborhood(X, T, x, candidate)}

prop is_topologically_continuous_at(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), f fn(x X) Y, x X):
    $tends_to_by_preimage(X, Y, f, \topological_neighborhood_filter_sets<X>(T_X, x), \topological_neighborhood_filter_sets<Y>(T_Y, f(x)))

prop is_topologically_continuous(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), f fn(x X) Y):
    forall x X:
        $is_topologically_continuous_at(X, Y, T_X, T_Y, f, x)

thm continuous_iff_open_preimages_forward:
    ? forall X, Y set, T_X \Topology<X>, T_Y \Topology<Y>, f fn(x X) Y:
        $is_topologically_continuous(X, Y, T_X, T_Y, f)
        =>:
            $has_open_preimages(X, Y, T_X, T_Y, f)
    $is_topology_on(X, T_X)
    claim:
        ? forall V T_Y:
            {q X: f(q) $in V} $in T_X
        have P power_set(X) = {q X: f(q) $in V}
        have family power_set(power_set(X)) = {U T_X: U $subset P}
        claim:
            ? family $subset T_X
            claim:
                ? forall U family:
                    U $in T_X
            by def:
                ? family $subset T_X
        by thm topology_closed_under_arbitrary_unions(X, T_X, family)
        claim:
            ? \family_union<X>(family) $subset P
            claim:
                ? forall z \family_union<X>(family):
                    z $in P
                $_belongs_family_union(X, family, z)
                obtain U from exist U family st {z $in U}
                U $subset P
            by def:
                ? \family_union<X>(family) $subset P
        claim:
            ? P $subset \family_union<X>(family)
            claim:
                ? forall z P:
                    z $in \family_union<X>(family)
                f(z) $in V
                claim:
                    ? V $in \topological_neighborhood_filter_sets<Y>(T_Y, f(z))
                    witness exist W T_Y st {f(z) $in W, W $subset V} from V:
                        V $subset V
                    by def:
                        ? $_is_topological_neighborhood(Y, T_Y, f(z), V)
                    by thm topological_neighborhood_filter_sets_member(Y, T_Y, f(z), V)
                $is_topologically_continuous_at(X, Y, T_X, T_Y, f, z)
                $tends_to_by_preimage(X, Y, f, \topological_neighborhood_filter_sets<X>(T_X, z), \topological_neighborhood_filter_sets<Y>(T_Y, f(z)))
                by thm tends_to_by_preimage_member(X, Y, f, \topological_neighborhood_filter_sets<X>(T_X, z), \topological_neighborhood_filter_sets<Y>(T_Y, f(z)), V)
                {q X: f(q) $in V} $in \topological_neighborhood_filter_sets<X>(T_X, z)
                P $in \topological_neighborhood_filter_sets<X>(T_X, z)
                $_is_topological_neighborhood(X, T_X, z, P)
                obtain U from exist U T_X st {z $in U, U $subset P}
                by thm set_builder_member(U, {W T_X: W $subset P})
                U $in {W T_X: W $subset P}
                U $in family
                witness exist W family st {z $in W} from U
                by def:
                    ? $_belongs_family_union(X, family, z)
                by thm family_union_member(X, family, z)
            by def:
                ? P $subset \family_union<X>(family)
        by extension:
            ? \family_union<X>(family) = P
        P $in T_X
    by def:
        ? $has_open_preimages(X, Y, T_X, T_Y, f)

thm continuous_iff_open_preimages_reverse:
    ? forall X, Y set, T_X \Topology<X>, T_Y \Topology<Y>, f fn(x X) Y:
        $has_open_preimages(X, Y, T_X, T_Y, f)
        =>:
            $is_topologically_continuous(X, Y, T_X, T_Y, f)
    claim:
        ? forall x X:
            $is_topologically_continuous_at(X, Y, T_X, T_Y, f, x)
        claim:
            ? forall S power_set(Y):
                S $in \topological_neighborhood_filter_sets<Y>(T_Y, f(x))
                =>:
                    {q X: f(q) $in S} $in \topological_neighborhood_filter_sets<X>(T_X, x)
            $_is_topological_neighborhood(Y, T_Y, f(x), S)
            obtain V from exist V T_Y st {f(x) $in V, V $subset S}
            have U T_X = {q X: f(q) $in V}
            claim:
                ? U $subset {q X: f(q) $in S}
                claim:
                    ? forall w U:
                        w $in {q X: f(q) $in S}
                    f(w) $in V
                    f(w) $in S
                    by thm set_builder_member(w, {q X: f(q) $in S})
                by def:
                    ? U $subset {q X: f(q) $in S}
            witness exist U0 T_X st {x $in U0, U0 $subset {q X: f(q) $in S}} from U:
                f(x) $in V
                by thm set_builder_member(x, {q X: f(q) $in V})
                x $in U
            by def:
                ? $_is_topological_neighborhood(X, T_X, x, {q X: f(q) $in S})
        by def:
            ? $tends_to_by_preimage(X, Y, f, \topological_neighborhood_filter_sets<X>(T_X, x), \topological_neighborhood_filter_sets<Y>(T_Y, f(x)))
        by def:
            ? $is_topologically_continuous_at(X, Y, T_X, T_Y, f, x)
    by def:
        ? $is_topologically_continuous(X, Y, T_X, T_Y, f)

# Supplementary ordinary continuity-composition lemma. The retained source
# item changes the middle topology to a coinduced topology and remains in
# todo.lit; named intermediate preimages make this fixed-topology proof explicit.
thm topologically_continuous_composition:
    ? forall A, B, CarrierC set, T_A \Topology<A>, T_B \Topology<B>, T_C \Topology<CarrierC>, f fn(x A) B, g fn(y B) CarrierC:
        $is_topologically_continuous(A, B, T_A, T_B, f)
        $is_topologically_continuous(B, CarrierC, T_B, T_C, g)
        =>:
            $is_topologically_continuous(A, CarrierC, T_A, T_C, fn(x A) CarrierC {g(f(x))})
    by thm continuous_iff_open_preimages_forward(A, B, T_A, T_B, f)
    by thm continuous_iff_open_preimages_forward(B, CarrierC, T_B, T_C, g)
    claim:
        ? forall U T_C:
            {x A: g(f(x)) $in U} $in T_A
        {x B: g(x) $in U} $in T_B
        have V T_B = {x B: g(x) $in U}
        {x A: f(x) $in V} $in T_A
        have pre1 T_A = {x A: f(x) $in V}
        have pre2 power_set(A) = {x A: g(f(x)) $in U}
        claim:
            ? pre1 $subset pre2
            claim:
                ? forall z pre1:
                    z $in pre2
                f(z) $in V
                g(f(z)) $in U
                by thm set_builder_member(z, {x A: g(f(x)) $in U})
            by def:
                ? pre1 $subset pre2
        claim:
            ? pre2 $subset pre1
            claim:
                ? forall z pre2:
                    z $in pre1
                g(f(z)) $in U
                by thm set_builder_member(f(z), {x B: g(x) $in U})
                f(z) $in V
                by thm set_builder_member(z, {x A: f(x) $in V})
            by def:
                ? pre2 $subset pre1
        by extension:
            ? pre1 = pre2
        pre2 $in T_A
    claim:
        ? forall U T_C:
            {candidate A: fn(argument A) CarrierC {g(f(argument))}(candidate) $in U} $in T_A
        have direct_preimage T_A = {candidate A: g(f(candidate)) $in U}
        have literal_preimage power_set(A) = {candidate A: fn(argument A) CarrierC {g(f(argument))}(candidate) $in U}
        claim:
            ? literal_preimage $subset direct_preimage
            claim:
                ? forall z literal_preimage:
                    z $in direct_preimage
                fn(argument A) CarrierC {g(f(argument))}(z) = g(f(z))
                g(f(z)) $in U
                by thm set_builder_member(z, {candidate A: g(f(candidate)) $in U})
            by def:
                ? literal_preimage $subset direct_preimage
        claim:
            ? direct_preimage $subset literal_preimage
            claim:
                ? forall z direct_preimage:
                    z $in literal_preimage
                g(f(z)) $in U
                fn(argument A) CarrierC {g(f(argument))}(z) = g(f(z))
                fn(argument A) CarrierC {g(f(argument))}(z) $in U
                by thm set_builder_member(z, {candidate A: fn(argument A) CarrierC {g(f(argument))}(candidate) $in U})
            by def:
                ? direct_preimage $subset literal_preimage
        by extension:
            ? literal_preimage = direct_preimage
        literal_preimage $in T_A
    by def:
        ? $has_open_preimages(A, CarrierC, T_A, T_C, fn(x A) CarrierC {g(f(x))})
    by thm continuous_iff_open_preimages_reverse(A, CarrierC, T_A, T_C, fn(x A) CarrierC {g(f(x))})

# Source constructions `coinduced` and `induced` are topology-valued functions.
template<X, Y set>:
    have fn coinduced_open_family(f fn(x X) Y, T_X power_set(power_set(X))) power_set(power_set(Y)) = {V power_set(Y): {x X: f(x) $in V} $in T_X}

thm coinduced_open_family_member:
    ? forall X, Y set, f fn(x X) Y, T_X power_set(power_set(X)), V power_set(Y):
        {x X: f(x) $in V} $in T_X
        =>:
            V $in \coinduced_open_family<X, Y>(f, T_X)
    by thm set_builder_member(V, {candidate power_set(Y): {x X: f(x) $in candidate} $in T_X})
    \coinduced_open_family<X, Y>(f, T_X) = {candidate power_set(Y): {x X: f(x) $in candidate} $in T_X}

thm coinduced_open_family_preimage_open:
    ? forall X, Y set, f fn(x X) Y, T_X power_set(power_set(X)), V \coinduced_open_family<X, Y>(f, T_X):
        {x X: f(x) $in V} $in T_X
    V $in \coinduced_open_family<X, Y>(f, T_X)
    \coinduced_open_family<X, Y>(f, T_X) = {candidate power_set(Y): {x X: f(x) $in candidate} $in T_X}
    V $in {candidate power_set(Y): {x X: f(x) $in candidate} $in T_X}

prop _is_induced_open(X, Y set, f fn(x X) Y, T_Y power_set(power_set(Y)), U power_set(X)):
    exist V T_Y st {{x X: f(x) $in V} = U}

template<X, Y set>:
    have fn induced_open_family(f fn(x X) Y, T_Y power_set(power_set(Y))) power_set(power_set(X)) = {U power_set(X): $_is_induced_open(X, Y, f, T_Y, U)}

thm induced_open_family_member:
    ? forall X, Y set, f fn(x X) Y, T_Y power_set(power_set(Y)), U power_set(X):
        $_is_induced_open(X, Y, f, T_Y, U)
        =>:
            U $in \induced_open_family<X, Y>(f, T_Y)
    by thm set_builder_member(U, {candidate power_set(X): $_is_induced_open(X, Y, f, T_Y, candidate)})
    \induced_open_family<X, Y>(f, T_Y) = {candidate power_set(X): $_is_induced_open(X, Y, f, T_Y, candidate)}

thm induced_open_family_is_induced_open:
    ? forall X, Y set, f fn(x X) Y, T_Y power_set(power_set(Y)), U \induced_open_family<X, Y>(f, T_Y):
        $_is_induced_open(X, Y, f, T_Y, U)
    U $in \induced_open_family<X, Y>(f, T_Y)
    \induced_open_family<X, Y>(f, T_Y) = {candidate power_set(X): $_is_induced_open(X, Y, f, T_Y, candidate)}
    U $in {candidate power_set(X): $_is_induced_open(X, Y, f, T_Y, candidate)}

thm set_preimage_empty:
    ? forall X, Y set, f fn(x X) Y:
        {x X: f(x) $in {}} = {}
    claim:
        ? {x X: f(x) $in {}} $subset {}
        claim:
            ? forall x {x0 X: f(x0) $in {}}:
                x $in {}
            by contra:
                ? x $in {}
                have mapped_value Y = f(x)
                mapped_value $in {}
                impossible mapped_value $in {}
        by def:
            ? {x X: f(x) $in {}} $subset {}
    claim:
        ? {} $subset {x X: f(x) $in {}}
        claim:
            ? forall x {}:
                x $in {x0 X: f(x0) $in {}}
            by contra:
                ? x $in {x0 X: f(x0) $in {}}
                impossible x $in {}
        by def:
            ? {} $subset {x X: f(x) $in {}}
    by extension:
        ? {x X: f(x) $in {}} = {}

thm set_preimage_universe:
    ? forall X, Y set, f fn(x X) Y:
        {x X: f(x) $in Y} = X
    claim:
        ? {x X: f(x) $in Y} $subset X
        claim:
            ? forall x {x0 X: f(x0) $in Y}:
                x $in X
        by def:
            ? {x X: f(x) $in Y} $subset X
    claim:
        ? X $subset {x X: f(x) $in Y}
        claim:
            ? forall x X:
                x $in {x0 X: f(x0) $in Y}
            f(x) $in Y
            by thm set_builder_member(x, {x0 X: f(x0) $in Y})
        by def:
            ? X $subset {x X: f(x) $in Y}
    by extension:
        ? {x X: f(x) $in Y} = X

thm set_preimage_intersection:
    ? forall X, Y set, f fn(x X) Y, U, V power_set(Y):
        {x X: f(x) $in intersect(U, V)} = intersect({x X: f(x) $in U}, {x X: f(x) $in V})
    claim:
        ? {x X: f(x) $in intersect(U, V)} $subset intersect({x X: f(x) $in U}, {x X: f(x) $in V})
        claim:
            ? forall x {x0 X: f(x0) $in intersect(U, V)}:
                x $in intersect({x0 X: f(x0) $in U}, {x0 X: f(x0) $in V})
            f(x) $in U
            f(x) $in V
            by thm set_builder_member(x, {x0 X: f(x0) $in U})
            by thm set_builder_member(x, {x0 X: f(x0) $in V})
        by def:
            ? {x X: f(x) $in intersect(U, V)} $subset intersect({x X: f(x) $in U}, {x X: f(x) $in V})
    claim:
        ? intersect({x X: f(x) $in U}, {x X: f(x) $in V}) $subset {x X: f(x) $in intersect(U, V)}
        claim:
            ? forall x intersect({x0 X: f(x0) $in U}, {x0 X: f(x0) $in V}):
                x $in {x0 X: f(x0) $in intersect(U, V)}
            f(x) $in U
            f(x) $in V
            f(x) $in intersect(U, V)
            by thm set_builder_member(x, {x0 X: f(x0) $in intersect(U, V)})
        by def:
            ? intersect({x X: f(x) $in U}, {x X: f(x) $in V}) $subset {x X: f(x) $in intersect(U, V)}
    by extension:
        ? {x X: f(x) $in intersect(U, V)} = intersect({x X: f(x) $in U}, {x X: f(x) $in V})

prop _is_coinduced_family_preimage(X, Y set, f fn(x X) Y, family power_set(power_set(Y)), P power_set(X)):
    exist V family st {P = {x X: f(x) $in V}}

thm coinduced_family_union_preimage_open:
    ? forall X, Y set, f fn(x X) Y, T_X \Topology<X>, family power_set(power_set(Y)):
        family $subset \coinduced_open_family<X, Y>(f, T_X)
        =>:
            {x X: f(x) $in \family_union<Y>(family)} $in T_X
    have preimage_family power_set(power_set(X)) = {P T_X: $_is_coinduced_family_preimage(X, Y, f, family, P)}
    claim:
        ? preimage_family $subset T_X
        claim:
            ? forall P preimage_family:
                P $in T_X
        by def:
            ? preimage_family $subset T_X
    \family_union<X>(preimage_family) $in T_X
    claim:
        ? \family_union<X>(preimage_family) $subset {x X: f(x) $in \family_union<Y>(family)}
        claim:
            ? forall x \family_union<X>(preimage_family):
                x $in {x0 X: f(x0) $in \family_union<Y>(family)}
            obtain P from exist P0 preimage_family st {x $in P0}
            $_is_coinduced_family_preimage(X, Y, f, family, P)
            obtain V from exist V0 family st {P = {x0 X: f(x0) $in V0}}
            {x0 X: f(x0) $in V} = P
            x $in {x0 X: f(x0) $in V}
            f(x) $in V
            witness exist W family st {f(x) $in W} from V
            by def:
                ? $_belongs_family_union(Y, family, f(x))
            by thm family_union_member(Y, family, f(x))
            by thm set_builder_member(x, {x0 X: f(x0) $in \family_union<Y>(family)})
        by def:
            ? \family_union<X>(preimage_family) $subset {x X: f(x) $in \family_union<Y>(family)}
    claim:
        ? {x X: f(x) $in \family_union<Y>(family)} $subset \family_union<X>(preimage_family)
        claim:
            ? forall x {x0 X: f(x0) $in \family_union<Y>(family)}:
                x $in \family_union<X>(preimage_family)
            obtain V from exist V0 family st {f(x) $in V0}
            V $in \coinduced_open_family<X, Y>(f, T_X)
            {x0 X: f(x0) $in V} $in T_X
            claim:
                ? $_is_coinduced_family_preimage(X, Y, f, family, {x0 X: f(x0) $in V})
                witness exist W family st {{x0 X: f(x0) $in V} = {x0 X: f(x0) $in W}} from V:
                    {x0 X: f(x0) $in V} = {x0 X: f(x0) $in V}
                by def:
                    ? $_is_coinduced_family_preimage(X, Y, f, family, {x0 X: f(x0) $in V})
            by thm set_builder_member({x0 X: f(x0) $in V}, {P T_X: $_is_coinduced_family_preimage(X, Y, f, family, P)})
            {x0 X: f(x0) $in V} $in preimage_family
            by thm set_builder_member(x, {x0 X: f(x0) $in V})
            witness exist P preimage_family st {x $in P} from {x0 X: f(x0) $in V}
            by def:
                ? $_belongs_family_union(X, preimage_family, x)
            by thm family_union_member(X, preimage_family, x)
        by def:
            ? {x X: f(x) $in \family_union<Y>(family)} $subset \family_union<X>(preimage_family)
    by extension:
        ? \family_union<X>(preimage_family) = {x X: f(x) $in \family_union<Y>(family)}

prop _is_inducing_family_witness(X, Y set, f fn(x X) Y, family power_set(power_set(X)), V power_set(Y)):
    exist U family st {{x X: f(x) $in V} = U}

thm induced_family_union_is_induced_open:
    ? forall X, Y set, f fn(x X) Y, T_Y \Topology<Y>, family power_set(power_set(X)):
        family $subset \induced_open_family<X, Y>(f, T_Y)
        =>:
            $_is_induced_open(X, Y, f, T_Y, \family_union<X>(family))
    have witness_family power_set(power_set(Y)) = {V T_Y: $_is_inducing_family_witness(X, Y, f, family, V)}
    claim:
        ? witness_family $subset T_Y
        claim:
            ? forall V witness_family:
                V $in T_Y
        by def:
            ? witness_family $subset T_Y
    \family_union<Y>(witness_family) $in T_Y
    claim:
        ? {x X: f(x) $in \family_union<Y>(witness_family)} $subset \family_union<X>(family)
        claim:
            ? forall x {x0 X: f(x0) $in \family_union<Y>(witness_family)}:
                x $in \family_union<X>(family)
            obtain V from exist V0 witness_family st {f(x) $in V0}
            $_is_inducing_family_witness(X, Y, f, family, V)
            obtain U from exist U0 family st {{x0 X: f(x0) $in V} = U0}
            by thm set_builder_member(x, {x0 X: f(x0) $in V})
            x $in U
            witness exist W family st {x $in W} from U
            by def:
                ? $_belongs_family_union(X, family, x)
            by thm family_union_member(X, family, x)
        by def:
            ? {x X: f(x) $in \family_union<Y>(witness_family)} $subset \family_union<X>(family)
    claim:
        ? \family_union<X>(family) $subset {x X: f(x) $in \family_union<Y>(witness_family)}
        claim:
            ? forall x \family_union<X>(family):
                x $in {x0 X: f(x0) $in \family_union<Y>(witness_family)}
            obtain U from exist U0 family st {x $in U0}
            U $in \induced_open_family<X, Y>(f, T_Y)
            $_is_induced_open(X, Y, f, T_Y, U)
            obtain V from exist V0 T_Y st {{x0 X: f(x0) $in V0} = U}
            claim:
                ? $_is_inducing_family_witness(X, Y, f, family, V)
                witness exist W family st {{x0 X: f(x0) $in V} = W} from U:
                    {x0 X: f(x0) $in V} = U
                by def:
                    ? $_is_inducing_family_witness(X, Y, f, family, V)
            by thm set_builder_member(V, {candidate T_Y: $_is_inducing_family_witness(X, Y, f, family, candidate)})
            V $in witness_family
            {x0 X: f(x0) $in V} = U
            x $in {x0 X: f(x0) $in V}
            f(x) $in V
            witness exist W witness_family st {f(x) $in W} from V
            by def:
                ? $_belongs_family_union(Y, witness_family, f(x))
            by thm family_union_member(Y, witness_family, f(x))
            by thm set_builder_member(x, {x0 X: f(x0) $in \family_union<Y>(witness_family)})
        by def:
            ? \family_union<X>(family) $subset {x X: f(x) $in \family_union<Y>(witness_family)}
    by extension:
        ? {x X: f(x) $in \family_union<Y>(witness_family)} = \family_union<X>(family)
    witness exist V T_Y st {{x X: f(x) $in V} = \family_union<X>(family)} from \family_union<Y>(witness_family)
    by def:
        ? $_is_induced_open(X, Y, f, T_Y, \family_union<X>(family))

thm induced_binary_intersection_is_induced_open:
    ? forall X, Y set, f fn(x X) Y, T_Y \Topology<Y>, U, V \induced_open_family<X, Y>(f, T_Y):
        $_is_induced_open(X, Y, f, T_Y, intersect(U, V))
    $_is_induced_open(X, Y, f, T_Y, U)
    $_is_induced_open(X, Y, f, T_Y, V)
    obtain U_target from exist W T_Y st {{x X: f(x) $in W} = U}
    obtain V_target from exist W T_Y st {{x X: f(x) $in W} = V}
    intersect(U_target, V_target) $in T_Y
    by thm chap9::object_substitution(power_set(X), power_set(X), fn(P power_set(X)) power_set(X) {intersect(P, {x X: f(x) $in V_target})}, {x X: f(x) $in U_target}, U)
    intersect({x X: f(x) $in U_target}, {x X: f(x) $in V_target}) = intersect(U, {x X: f(x) $in V_target})
    by thm chap9::object_substitution(power_set(X), power_set(X), fn(P power_set(X)) power_set(X) {intersect(U, P)}, {x X: f(x) $in V_target}, V)
    intersect(U, {x X: f(x) $in V_target}) = intersect(U, V)
    by thm set_preimage_intersection(X, Y, f, U_target, V_target)
    {x X: f(x) $in intersect(U_target, V_target)} = intersect({x X: f(x) $in U_target}, {x X: f(x) $in V_target}) = intersect(U, {x X: f(x) $in V_target}) = intersect(U, V)
    {x X: f(x) $in intersect(U_target, V_target)} = intersect(U, V)
    intersect(U, V) $subset U $subset X
    intersect(U, V) $in power_set(X)
    witness exist W T_Y st {{x X: f(x) $in W} = intersect(U, V)} from intersect(U_target, V_target)
    by def:
        ? $_is_induced_open(X, Y, f, T_Y, intersect(U, V))

prop is_hausdorff_topology(X set, T power_set(power_set(X))):
    forall x, y X:
        x != y
        =>:
            exist U, V T st {x $in U, y $in V, intersect(U, V) = {}}

prop is_regular_topology(X set, T power_set(power_set(X))):
    forall x X, U T:
        x $in U
        =>:
            exist V T, closed_set power_set(X) st {x $in V, V $subset closed_set, $is_topologically_closed(X, T, closed_set), closed_set $subset U}

prop is_topologically_dense(X set, T power_set(power_set(X)), A power_set(X)):
    forall U T:
        U != {}
        =>:
            intersect(A, U) != {}

# Closure remains a selected set-valued object.  A point belongs when every
# neighborhood meets the original set.
prop is_topological_adherent_point(X set, T power_set(power_set(X)), A power_set(X), x X):
    forall U \topological_neighborhood_filter_sets<X>(T, x):
        intersect(U, A) != {}

template<X set>:
    have fn topological_closure(T power_set(power_set(X)), A power_set(X)) power_set(X) = {x X: $is_topological_adherent_point(X, T, A, x)}

prop is_countable_neighborhood_basis(X set, T power_set(power_set(X)), x X, basis fn(n N) power_set(X)):
    forall n N:
        basis(n) $in \topological_neighborhood_filter_sets<X>(T, x)
    forall m, n N:
        m <= n
        =>:
            basis(n) $subset basis(m)
    forall U \topological_neighborhood_filter_sets<X>(T, x):
        exist n N st {basis(n) $subset U}

prop is_first_countable_topology(X set, T power_set(power_set(X))):
    forall x X:
        exist basis fn(n N) power_set(X) st {$is_countable_neighborhood_basis(X, T, x, basis)}

prop has_dense_subset_limit_at_every_point(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), A power_set(X), f fn(a A) Y):
    forall x X:
        exist c Y st {$tends_to_by_preimage(A, Y, f, \comap_filter_sets<A, X>(fn(a A) X {a}, \topological_neighborhood_filter_sets<X>(T_X, x)), \topological_neighborhood_filter_sets<Y>(T_Y, c))}

prop is_continuous_extension(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), A power_set(X), f fn(a A) Y, phi fn(x X) Y):
    $is_topologically_continuous(X, Y, T_X, T_Y, phi)
    forall a A:
        phi(a) = f(a)

prop is_sequence_from_set_converging_to(X set, T power_set(power_set(X)), S power_set(X), a X, u fn(n N) X):
    $is_sequence_in_set(X, S, u)
    $tends_to_by_preimage(N, X, u, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))

prop is_sequential_closure_point(X set, T power_set(power_set(X)), S power_set(X), a X):
    exist u fn(n N) X st {$is_sequence_from_set_converging_to(X, T, S, a, u)}

prop is_proper_filter_on(X set, F power_set(power_set(X))):
    $is_filter_on(X, F)
    not {} $in F

prop is_cluster_point(X set, T power_set(power_set(X)), F power_set(power_set(X)), x X):
    forall U \topological_neighborhood_filter_sets<X>(T, x), V F:
        intersect(U, V) != {}

prop is_topologically_compact(X set, T power_set(power_set(X)), S power_set(X)):
    forall F power_set(power_set(X)):
        $is_proper_filter_on(X, F)
        $filter_le(X, F, \principal_filter_sets<X>(S))
        =>:
            exist a S st {$is_cluster_point(X, T, F, a)}

# Finite families are represented by a finite enumeration.  The empty-family
# branch keeps the definition valid for every carrier.
prop has_finite_family_enumeration(X set, S power_set(power_set(X)), n N, enum fn(k N) power_set(X)):
    forall U S:
        exist k N st {k < n, enum(k) = U}

prop is_finite_family(X set, S power_set(power_set(X))):
    exist n N, enum fn(k N) power_set(X) st {$has_finite_family_enumeration(X, S, n, enum)}

# ---------------------------------------------------------------------------
# Resumed MIL C11 S03 source slice
# ---------------------------------------------------------------------------

prop topology_le(X set, T, Tprime power_set(power_set(X))):
    Tprime $subset T

# MIL30 ITEM 01 — `TopologicalSpace.coinduced`.
thm coinduced_open_family_is_topology:
    ? forall X, Y set, f fn(x X) Y, T_X \Topology<X>:
        \coinduced_open_family<X, Y>(f, T_X) $in \Topology<Y>
    $is_topology_on(X, T_X)
    claim:
        ? $is_topology_on(Y, \coinduced_open_family<X, Y>(f, T_X))
        claim:
            ? {} $in \coinduced_open_family<X, Y>(f, T_X)
            by thm set_preimage_empty(X, Y, f)
            {x X: f(x) $in {}} $in T_X
            by thm coinduced_open_family_member(X, Y, f, T_X, {})
        claim:
            ? Y $in \coinduced_open_family<X, Y>(f, T_X)
            by thm set_preimage_universe(X, Y, f)
            {x X: f(x) $in Y} $in T_X
            by thm coinduced_open_family_member(X, Y, f, T_X, Y)
        claim:
            ? forall U, V \coinduced_open_family<X, Y>(f, T_X):
                intersect(U, V) $in \coinduced_open_family<X, Y>(f, T_X)
            {x X: f(x) $in U} $in T_X
            {x X: f(x) $in V} $in T_X
            intersect({x X: f(x) $in U}, {x X: f(x) $in V}) $in T_X
            by thm set_preimage_intersection(X, Y, f, U, V)
            {x X: f(x) $in intersect(U, V)} $in T_X
            intersect(U, V) $subset U $subset Y
            intersect(U, V) $in power_set(Y)
            by thm coinduced_open_family_member(X, Y, f, T_X, intersect(U, V))
        claim:
            ? forall family power_set(power_set(Y)):
                family $subset \coinduced_open_family<X, Y>(f, T_X)
                =>:
                    \family_union<Y>(family) $in \coinduced_open_family<X, Y>(f, T_X)
            by thm coinduced_family_union_preimage_open(X, Y, f, T_X, family)
            by thm coinduced_open_family_member(X, Y, f, T_X, \family_union<Y>(family))
        by def:
            ? $is_topology_on(Y, \coinduced_open_family<X, Y>(f, T_X))
    by thm topology_member(Y, \coinduced_open_family<X, Y>(f, T_X))

# MIL30 ITEM 02 — `TopologicalSpace.induced`.
thm induced_open_family_is_topology:
    ? forall X, Y set, f fn(x X) Y, T_Y \Topology<Y>:
        \induced_open_family<X, Y>(f, T_Y) $in \Topology<X>
    $is_topology_on(Y, T_Y)
    claim:
        ? $is_topology_on(X, \induced_open_family<X, Y>(f, T_Y))
        claim:
            ? {} $in \induced_open_family<X, Y>(f, T_Y)
            claim:
                ? $_is_induced_open(X, Y, f, T_Y, {})
                witness exist V T_Y st {{x X: f(x) $in V} = {}} from {}:
                    by thm set_preimage_empty(X, Y, f)
                by def:
                    ? $_is_induced_open(X, Y, f, T_Y, {})
            by thm induced_open_family_member(X, Y, f, T_Y, {})
        claim:
            ? X $in \induced_open_family<X, Y>(f, T_Y)
            claim:
                ? $_is_induced_open(X, Y, f, T_Y, X)
                witness exist V T_Y st {{x X: f(x) $in V} = X} from Y:
                    by thm set_preimage_universe(X, Y, f)
                by def:
                    ? $_is_induced_open(X, Y, f, T_Y, X)
            by thm induced_open_family_member(X, Y, f, T_Y, X)
        claim:
            ? forall U, V \induced_open_family<X, Y>(f, T_Y):
                intersect(U, V) $in \induced_open_family<X, Y>(f, T_Y)
            by thm induced_binary_intersection_is_induced_open(X, Y, f, T_Y, U, V)
            intersect(U, V) $subset U $subset X
            intersect(U, V) $in power_set(X)
            by thm induced_open_family_member(X, Y, f, T_Y, intersect(U, V))
        claim:
            ? forall family power_set(power_set(X)):
                family $subset \induced_open_family<X, Y>(f, T_Y)
                =>:
                    \family_union<X>(family) $in \induced_open_family<X, Y>(f, T_Y)
            by thm induced_family_union_is_induced_open(X, Y, f, T_Y, family)
            by thm induced_open_family_member(X, Y, f, T_Y, \family_union<X>(family))
        by def:
            ? $is_topology_on(X, \induced_open_family<X, Y>(f, T_Y))
    by thm topology_member(X, \induced_open_family<X, Y>(f, T_Y))

prop coinduced_induced_adjunction(X, Y set, f fn(x X) Y, T_X power_set(power_set(X)), T_Y power_set(power_set(Y))):
    not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y))
    not $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)

# MIL30 ITEM 03 — `coinduced_le_iff_le_induced`.
thm coinduced_le_iff_le_induced:
    ? forall X, Y set, f fn(x X) Y, T_X \Topology<X>, T_Y \Topology<Y>:
        $coinduced_induced_adjunction(X, Y, f, T_X, T_Y)
    $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
    by cases:
        ? not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y))
        case $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y):
            claim:
                ? forall U \induced_open_family<X, Y>(f, T_Y):
                    U $in T_X
                by thm induced_open_family_is_induced_open(X, Y, f, T_Y, U)
                obtain V from exist W T_Y st {{x X: f(x) $in W} = U}
                V $in \coinduced_open_family<X, Y>(f, T_X)
                by thm coinduced_open_family_preimage_open(X, Y, f, T_X, V)
                {x X: f(x) $in V} = U
            by def:
                ? \induced_open_family<X, Y>(f, T_Y) $subset T_X
            by def:
                ? $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y))
            not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y))
        case not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y):
            not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y))
    $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)) or not $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y))
    by cases:
        ? not $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
        case $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)):
            claim:
                ? forall V T_Y:
                    V $in \coinduced_open_family<X, Y>(f, T_X)
                claim:
                    ? $_is_induced_open(X, Y, f, T_Y, {x X: f(x) $in V})
                    witness exist W T_Y st {{x X: f(x) $in W} = {x X: f(x) $in V}} from V:
                        {x X: f(x) $in V} = {x X: f(x) $in V}
                    by def:
                        ? $_is_induced_open(X, Y, f, T_Y, {x X: f(x) $in V})
                by thm induced_open_family_member(X, Y, f, T_Y, {x X: f(x) $in V})
                {x X: f(x) $in V} $in T_X
                by thm coinduced_open_family_member(X, Y, f, T_X, V)
            by def:
                ? T_Y $subset \coinduced_open_family<X, Y>(f, T_X)
            by def:
                ? $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
            not $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
        case not $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)):
            not $topology_le(X, T_X, \induced_open_family<X, Y>(f, T_Y)) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
    by def:
        ? $coinduced_induced_adjunction(X, Y, f, T_X, T_Y)

prop topology_open_inclusion(X set, T, Tprime power_set(power_set(X))):
    forall U Tprime:
        U $in T

prop topology_order_characterization(X set, T, Tprime power_set(power_set(X))):
    not $topology_le(X, T, Tprime) or $topology_open_inclusion(X, T, Tprime)
    not $topology_open_inclusion(X, T, Tprime) or $topology_le(X, T, Tprime)

# MIL30 ITEM 04 — topology order is reverse inclusion of open sets.
thm topology_order_iff_open_inclusion:
    ? forall X set, T, Tprime \Topology<X>:
        $topology_order_characterization(X, T, Tprime)
    $topology_le(X, T, Tprime) or not $topology_le(X, T, Tprime)
    by cases:
        ? not $topology_le(X, T, Tprime) or $topology_open_inclusion(X, T, Tprime)
        case $topology_le(X, T, Tprime):
            by def:
                ? $topology_le(X, T, Tprime)
            claim:
                ? forall U Tprime:
                    U $in T
            by def:
                ? $topology_open_inclusion(X, T, Tprime)
            not $topology_le(X, T, Tprime) or $topology_open_inclusion(X, T, Tprime)
        case not $topology_le(X, T, Tprime):
            not $topology_le(X, T, Tprime) or $topology_open_inclusion(X, T, Tprime)
    $topology_open_inclusion(X, T, Tprime) or not $topology_open_inclusion(X, T, Tprime)
    by cases:
        ? not $topology_open_inclusion(X, T, Tprime) or $topology_le(X, T, Tprime)
        case $topology_open_inclusion(X, T, Tprime):
            by def:
                ? $topology_open_inclusion(X, T, Tprime)
            claim:
                ? Tprime $subset T
                claim:
                    ? forall U Tprime:
                        U $in T
                by def:
                    ? Tprime $subset T
            by def:
                ? $topology_le(X, T, Tprime)
            not $topology_open_inclusion(X, T, Tprime) or $topology_le(X, T, Tprime)
        case not $topology_open_inclusion(X, T, Tprime):
            not $topology_open_inclusion(X, T, Tprime) or $topology_le(X, T, Tprime)
    by def:
        ? $topology_order_characterization(X, T, Tprime)

prop continuity_coinduced_characterization(X, Y set, f fn(x X) Y, T_X power_set(power_set(X)), T_Y power_set(power_set(Y))):
    not $is_topologically_continuous(X, Y, T_X, T_Y, f) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
    not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $is_topologically_continuous(X, Y, T_X, T_Y, f)

# MIL30 ITEM 05 — `continuous_iff_coinduced_le`.
# proof_debt: connect neighborhood continuity to the checked open-preimage
# criterion while changing the target topology.
thm continuous_iff_coinduced_le:
    ? forall X, Y set, f fn(x X) Y, T_X \Topology<X>, T_Y \Topology<Y>:
        $continuity_coinduced_characterization(X, Y, f, T_X, T_Y)
    $is_topologically_continuous(X, Y, T_X, T_Y, f) or not $is_topologically_continuous(X, Y, T_X, T_Y, f)
    by cases:
        ? not $is_topologically_continuous(X, Y, T_X, T_Y, f) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
        case $is_topologically_continuous(X, Y, T_X, T_Y, f):
            by thm continuous_iff_open_preimages_forward(X, Y, T_X, T_Y, f)
            claim:
                ? forall V T_Y:
                    V $in \coinduced_open_family<X, Y>(f, T_X)
                {x X: f(x) $in V} $in T_X
                by thm coinduced_open_family_member(X, Y, f, T_X, V)
            by def:
                ? T_Y $subset \coinduced_open_family<X, Y>(f, T_X)
            by def:
                ? $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
            not $is_topologically_continuous(X, Y, T_X, T_Y, f) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
        case not $is_topologically_continuous(X, Y, T_X, T_Y, f):
            not $is_topologically_continuous(X, Y, T_X, T_Y, f) or $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
    $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y)
    by cases:
        ? not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $is_topologically_continuous(X, Y, T_X, T_Y, f)
        case $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y):
            claim:
                ? forall V T_Y:
                    {x X: f(x) $in V} $in T_X
                V $in \coinduced_open_family<X, Y>(f, T_X)
                by thm coinduced_open_family_preimage_open(X, Y, f, T_X, V)
            by def:
                ? $has_open_preimages(X, Y, T_X, T_Y, f)
            by thm continuous_iff_open_preimages_reverse(X, Y, T_X, T_Y, f)
            not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $is_topologically_continuous(X, Y, T_X, T_Y, f)
        case not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y):
            not $topology_le(Y, \coinduced_open_family<X, Y>(f, T_X), T_Y) or $is_topologically_continuous(X, Y, T_X, T_Y, f)
    by def:
        ? $continuity_coinduced_characterization(X, Y, f, T_X, T_Y)

# These two transport helpers isolate the set-family rewrite needed when a
# nested preimage is normalized to the preimage of an explicit composite.
thm nested_preimage_open_implies_composite_preimage_open:
    ? forall X, Y, CarrierZ set, f fn(x X) Y, g fn(y Y) CarrierZ, U power_set(CarrierZ), T power_set(power_set(X)):
        {x X: f(x) $in {y Y: g(y) $in U}} $in T
        =>:
            {x X: fn(argument X) CarrierZ {g(f(argument))}(x) $in U} $in T
    have nested_open T = {x X: f(x) $in {y Y: g(y) $in U}}
    have composite_preimage power_set(X) = {x X: fn(argument X) CarrierZ {g(f(argument))}(x) $in U}
    claim:
        ? composite_preimage $subset nested_open
        claim:
            ? forall x composite_preimage:
                x $in nested_open
            x $in {x0 X: fn(argument X) CarrierZ {g(f(argument))}(x0) $in U}
            fn(argument X) CarrierZ {g(f(argument))}(x) = g(f(x))
            g(f(x)) $in U
            by thm set_builder_member(f(x), {y Y: g(y) $in U})
            by thm set_builder_member(x, {x0 X: f(x0) $in {y Y: g(y) $in U}})
        by def:
            ? composite_preimage $subset nested_open
    claim:
        ? nested_open $subset composite_preimage
        claim:
            ? forall x nested_open:
                x $in composite_preimage
            x $in {x0 X: f(x0) $in {y Y: g(y) $in U}}
            f(x) $in {y Y: g(y) $in U}
            g(f(x)) $in U
            fn(argument X) CarrierZ {g(f(argument))}(x) = g(f(x))
            fn(argument X) CarrierZ {g(f(argument))}(x) $in U
            by thm set_builder_member(x, {x0 X: fn(argument X) CarrierZ {g(f(argument))}(x0) $in U})
        by def:
            ? nested_open $subset composite_preimage
    by extension:
        ? composite_preimage = nested_open
    composite_preimage $in T

thm composite_preimage_open_implies_nested_preimage_open:
    ? forall X, Y, CarrierZ set, f fn(x X) Y, g fn(y Y) CarrierZ, U power_set(CarrierZ), T power_set(power_set(X)):
        {x X: fn(argument X) CarrierZ {g(f(argument))}(x) $in U} $in T
        =>:
            {x X: f(x) $in {y Y: g(y) $in U}} $in T
    have composite_open T = {x X: fn(argument X) CarrierZ {g(f(argument))}(x) $in U}
    have nested_preimage power_set(X) = {x X: f(x) $in {y Y: g(y) $in U}}
    claim:
        ? nested_preimage $subset composite_open
        claim:
            ? forall x nested_preimage:
                x $in composite_open
            x $in {x0 X: f(x0) $in {y Y: g(y) $in U}}
            f(x) $in {y Y: g(y) $in U}
            g(f(x)) $in U
            fn(argument X) CarrierZ {g(f(argument))}(x) = g(f(x))
            fn(argument X) CarrierZ {g(f(argument))}(x) $in U
            by thm set_builder_member(x, {x0 X: fn(argument X) CarrierZ {g(f(argument))}(x0) $in U})
        by def:
            ? nested_preimage $subset composite_open
    claim:
        ? composite_open $subset nested_preimage
        claim:
            ? forall x composite_open:
                x $in nested_preimage
            x $in {x0 X: fn(argument X) CarrierZ {g(f(argument))}(x0) $in U}
            fn(argument X) CarrierZ {g(f(argument))}(x) = g(f(x))
            g(f(x)) $in U
            by thm set_builder_member(f(x), {y Y: g(y) $in U})
            by thm set_builder_member(x, {x0 X: f(x0) $in {y Y: g(y) $in U}})
        by def:
            ? composite_open $subset nested_preimage
    by extension:
        ? nested_preimage = composite_open
    nested_preimage $in T

prop coinduced_continuity_composition_iff(X, Y, CarrierZ set, f fn(x X) Y, g fn(y Y) CarrierZ, T_X power_set(power_set(X)), T_Z power_set(power_set(CarrierZ))):
    not $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g) or $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
    not $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}) or $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)

# MIL30 ITEM 06 — continuity from a coinduced topology iff continuity of the
# composite.
# proof_debt: coinduced topology comparison and lambda-preimage normalization.
thm continuous_from_coinduced_iff_composite:
    ? forall X, Y, CarrierZ set, f fn(x X) Y, g fn(y Y) CarrierZ, T_X \Topology<X>, T_Z \Topology<CarrierZ>:
        $coinduced_continuity_composition_iff(X, Y, CarrierZ, f, g, T_X, T_Z)
    $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g) or not $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
    by cases:
        ? not $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g) or $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
        case $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g):
            by thm coinduced_open_family_is_topology(X, Y, f, T_X)
            by thm continuous_iff_open_preimages_forward(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
            claim:
                ? forall U T_Z:
                    {x X: fn(argument X) CarrierZ {g(f(argument))}(x) $in U} $in T_X
                {y Y: g(y) $in U} $in \coinduced_open_family<X, Y>(f, T_X)
                by thm coinduced_open_family_preimage_open(X, Y, f, T_X, {y Y: g(y) $in U})
                by thm nested_preimage_open_implies_composite_preimage_open(X, Y, CarrierZ, f, g, U, T_X)
            by def:
                ? $has_open_preimages(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
            by thm continuous_iff_open_preimages_reverse(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
            not $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g) or $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
        case not $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g):
            not $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g) or $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
    $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}) or not $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
    by cases:
        ? not $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}) or $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
        case $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}):
            by thm coinduced_open_family_is_topology(X, Y, f, T_X)
            by thm continuous_iff_open_preimages_forward(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))})
            claim:
                ? forall U T_Z:
                    {y Y: g(y) $in U} $in \coinduced_open_family<X, Y>(f, T_X)
                have literal_open T_X = {candidate X: fn(argument X) CarrierZ {g(f(argument))}(candidate) $in U}
                have direct_preimage power_set(X) = {candidate X: g(f(candidate)) $in U}
                claim:
                    ? direct_preimage $subset literal_open
                    claim:
                        ? forall z direct_preimage:
                            z $in literal_open
                        g(f(z)) $in U
                        fn(argument X) CarrierZ {g(f(argument))}(z) = g(f(z))
                        fn(argument X) CarrierZ {g(f(argument))}(z) $in U
                        by thm set_builder_member(z, {candidate X: fn(argument X) CarrierZ {g(f(argument))}(candidate) $in U})
                    by def:
                        ? direct_preimage $subset literal_open
                claim:
                    ? literal_open $subset direct_preimage
                    claim:
                        ? forall z literal_open:
                            z $in direct_preimage
                        z $in {candidate X: fn(argument X) CarrierZ {g(f(argument))}(candidate) $in U}
                        fn(argument X) CarrierZ {g(f(argument))}(z) = g(f(z))
                        g(f(z)) $in U
                        by thm set_builder_member(z, {candidate X: g(f(candidate)) $in U})
                    by def:
                        ? literal_open $subset direct_preimage
                by extension:
                    ? direct_preimage = literal_open
                direct_preimage $in T_X
                {x X: g(f(x)) $in U} $in T_X
                by thm composite_preimage_open_implies_nested_preimage_open(X, Y, CarrierZ, f, g, U, T_X)
                {x X: f(x) $in {y Y: g(y) $in U}} $in T_X
                by thm coinduced_open_family_member(X, Y, f, T_X, {y Y: g(y) $in U})
            by def:
                ? $has_open_preimages(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
            by thm continuous_iff_open_preimages_reverse(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
            not $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}) or $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
        case not $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}):
            not $is_topologically_continuous(X, CarrierZ, T_X, T_Z, fn(x X) CarrierZ {g(f(x))}) or $is_topologically_continuous(Y, CarrierZ, \coinduced_open_family<X, Y>(f, T_X), T_Z, g)
    by def:
        ? $coinduced_continuity_composition_iff(X, Y, CarrierZ, f, g, T_X, T_Z)

# A uniform-coordinate product topology is characterized by its projections.
# The fully dependent carrier family remains part of the localized source debt.
prop all_coordinate_projections_continuous(I, X, Product set, T_X fn(index I) power_set(power_set(X)), projection fn(index I) fn(point Product) X, T power_set(power_set(Product))):
    forall coordinate I:
        $is_topologically_continuous(Product, X, T, T_X(coordinate), projection(coordinate))

prop is_pi_topology(I, X, Product set, T_X fn(index I) power_set(power_set(X)), projection fn(index I) fn(point Product) X, T power_set(power_set(Product))):
    $all_coordinate_projections_continuous(I, X, Product, T_X, projection, T)
    forall Tprime \Topology<Product>:
        $all_coordinate_projections_continuous(I, X, Product, T_X, projection, Tprime)
        =>:
            $topology_le(Product, T, Tprime)

# MIL30 ITEM 07 — Pi topology as the infimum of induced coordinate topologies.
# proof_debt: existence and leastness of the arbitrary topology infimum.
thm pi_topology_characterization:
    ? forall I, X, Product set, T_X fn(index I) power_set(power_set(X)), projection fn(index I) fn(point Product) X, T \Topology<Product>:
        $is_pi_topology(I, X, Product, T_X, projection, T)
        =>:
            $is_pi_topology(I, X, Product, T_X, projection, T)

# MIL30 ITEM 08 — uniqueness of limits in a Hausdorff topology.
# proof_debt: separate unequal limits and contradict eventual membership in
# disjoint neighborhoods.
thm hausdorff_sequence_limit_unique:
    ? forall X set, T \Topology<X>, u fn(n N) X, a, b X:
        $is_hausdorff_topology(X, T)
        $tends_to_by_preimage(N, X, u, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
        $tends_to_by_preimage(N, X, u, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, b))
        =>:
            a = b
    by contra:
        ? a = b
        a != b
        obtain U, V from exist U0, V0 T st {a $in U0, b $in V0, intersect(U0, V0) = {}}
        claim:
            ? U $in \topological_neighborhood_filter_sets<X>(T, a)
            claim:
                ? $_is_topological_neighborhood(X, T, a, U)
                witness exist W T st {a $in W, W $subset U} from U
                by def:
                    ? $_is_topological_neighborhood(X, T, a, U)
            by thm topological_neighborhood_filter_sets_member(X, T, a, U)
        claim:
            ? V $in \topological_neighborhood_filter_sets<X>(T, b)
            claim:
                ? $_is_topological_neighborhood(X, T, b, V)
                witness exist W T st {b $in W, W $subset V} from V
                by def:
                    ? $_is_topological_neighborhood(X, T, b, V)
            by thm topological_neighborhood_filter_sets_member(X, T, b, V)
        have late_in_U power_set(N) = {n N: u(n) $in U}
        have late_in_V power_set(N) = {n N: u(n) $in V}
        by thm tends_to_by_preimage_member(N, X, u, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a), U)
        late_in_U $in at_top_N_sets
        by thm tends_to_by_preimage_member(N, X, u, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, b), V)
        late_in_V $in at_top_N_sets
        $contains_natural_tail(late_in_U)
        $contains_natural_tail(late_in_V)
        by def:
            ? $eventually_on_N(late_in_U)
        by def:
            ? $eventually_on_N(late_in_V)
        by thm eventually_conjunction_on_N(late_in_U, late_in_V)
        by def:
            ? $eventually_on_N(intersect(late_in_U, late_in_V))
        $contains_natural_tail(intersect(late_in_U, late_in_V))
        obtain k from exist k0 N st {$contains_natural_tail_from(k0, intersect(late_in_U, late_in_V))}
        k >= k
        by thm natural_tail_contains_later(k, intersect(late_in_U, late_in_V), k)
        k $in intersect(late_in_U, late_in_V)
        k $in late_in_U
        k $in late_in_V
        u(k) $in U
        u(k) $in V
        u(k) $in intersect(U, V)
        have point X = u(k)
        point $in intersect(U, V)
        point $in {}
        impossible point $in {}

prop is_closed_neighborhood_basis(X set, T power_set(power_set(X)), a X):
    forall U \topological_neighborhood_filter_sets<X>(T, a):
        exist V power_set(X) st {V $in \topological_neighborhood_filter_sets<X>(T, a), $is_topologically_closed(X, T, V), V $subset U}

# MIL30 ITEM 09 — closed neighborhoods form a basis in a regular space.
thm regular_topology_has_closed_neighborhood_basis:
    ? forall X set, T \Topology<X>, a X:
        $is_regular_topology(X, T)
        =>:
            $is_closed_neighborhood_basis(X, T, a)
    claim:
        ? forall U \topological_neighborhood_filter_sets<X>(T, a):
            exist V power_set(X) st {V $in \topological_neighborhood_filter_sets<X>(T, a), $is_topologically_closed(X, T, V), V $subset U}
        by thm topological_neighborhood_filter_sets_is_neighborhood(X, T, a, U)
        obtain O from exist O0 T st {a $in O0, O0 $subset U}
        obtain W, closed_set from exist W0 T, closed_set0 power_set(X) st {a $in W0, W0 $subset closed_set0, $is_topologically_closed(X, T, closed_set0), closed_set0 $subset O}
        claim:
            ? closed_set $in \topological_neighborhood_filter_sets<X>(T, a)
            claim:
                ? $_is_topological_neighborhood(X, T, a, closed_set)
                witness exist V T st {a $in V, V $subset closed_set} from W
                by def:
                    ? $_is_topological_neighborhood(X, T, a, closed_set)
            by thm topological_neighborhood_filter_sets_member(X, T, a, closed_set)
        closed_set $subset O $subset U
        witness exist V power_set(X) st {V $in \topological_neighborhood_filter_sets<X>(T, a), $is_topologically_closed(X, T, V), V $subset U} from closed_set
    by def:
        ? $is_closed_neighborhood_basis(X, T, a)

prop is_open_neighborhood_basis(X set, T power_set(power_set(X)), a X):
    forall U \topological_neighborhood_filter_sets<X>(T, a):
        exist V T st {a $in V, V $subset U}

# MIL30 ITEM 10 — open neighborhoods form a basis.
thm topology_has_open_neighborhood_basis:
    ? forall X set, T \Topology<X>, a X:
        $is_open_neighborhood_basis(X, T, a)
    by def:
        ? $is_open_neighborhood_basis(X, T, a)

prop has_open_neighborhood_preimage_refinement(X, Y, A set, T_X power_set(power_set(X)), c fn(a A) X, f fn(a A) Y, x X, F power_set(power_set(Y)), Vprime power_set(Y)):
    exist V power_set(X) st {V $in \topological_neighborhood_filter_sets<X>(T_X, x), V $in T_X, {a A: c(a) $in V} $subset {a A: f(a) $in Vprime}}

# MIL30 ITEM 11 — source auxiliary neighborhood-extraction theorem.
# proof_debt: promote the comap-filter limit into an open neighborhood witness.
thm dense_extension_auxiliary_neighborhood:
    ? forall X, Y, A set, T_X \Topology<X>, c fn(a A) X, f fn(a A) Y, x X, F power_set(power_set(Y)), Vprime F:
        $tends_to_by_preimage(A, Y, f, \comap_filter_sets<A, X>(c, \topological_neighborhood_filter_sets<X>(T_X, x)), F)
        =>:
            $has_open_neighborhood_preimage_refinement(X, Y, A, T_X, c, f, x, F, Vprime)
    by thm tends_to_by_preimage_member(A, Y, f, \comap_filter_sets<A, X>(c, \topological_neighborhood_filter_sets<X>(T_X, x)), F, Vprime)
    {a A: f(a) $in Vprime} $in \comap_filter_sets<A, X>(c, \topological_neighborhood_filter_sets<X>(T_X, x))
    $_contains_filter_preimage(A, X, c, \topological_neighborhood_filter_sets<X>(T_X, x), {a A: f(a) $in Vprime})
    obtain S from exist S0 \topological_neighborhood_filter_sets<X>(T_X, x) st {{a A: c(a) $in S0} $subset {a A: f(a) $in Vprime}}
    by thm topological_neighborhood_filter_sets_is_neighborhood(X, T_X, x, S)
    obtain V from exist V0 T_X st {x $in V0, V0 $subset S}
    claim:
        ? {a A: c(a) $in V} $subset {a A: f(a) $in Vprime}
        claim:
            ? forall index {a A: c(a) $in V}:
                index $in {a A: f(a) $in Vprime}
            c(index) $in V
            c(index) $in S
            by thm set_builder_member(index, {a A: c(a) $in S})
        by def:
            ? {a A: c(a) $in V} $subset {a A: f(a) $in Vprime}
    claim:
        ? V $in \topological_neighborhood_filter_sets<X>(T_X, x)
        claim:
            ? $_is_topological_neighborhood(X, T_X, x, V)
            witness exist W T_X st {x $in W, W $subset V} from V
            by def:
                ? $_is_topological_neighborhood(X, T_X, x, V)
        by thm topological_neighborhood_filter_sets_member(X, T_X, x, V)
    witness exist W power_set(X) st {W $in \topological_neighborhood_filter_sets<X>(T_X, x), W $in T_X, {a A: c(a) $in W} $subset {a A: f(a) $in Vprime}} from V
    by def:
        ? $has_open_neighborhood_preimage_refinement(X, Y, A, T_X, c, f, x, F, Vprime)

# MIL30 ITEM 12 — unproved continuous-extension goal. The existential payload
# and exact conditional target remain explicit, but no trusted theorem fact is
# published until the arbitrary-choice and limit-compatibility proof is checked.
prop has_dense_subset_continuous_extension(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), A power_set(X), f fn(a A) Y):
    exist phi fn(x X) Y st {$is_continuous_extension(X, Y, T_X, T_Y, A, f, phi)}

prop dense_subset_continuous_extension_goal(X, Y set, T_X power_set(power_set(X)), T_Y power_set(power_set(Y)), A power_set(X), f fn(a A) Y):
    not $is_topologically_dense(X, T_X, A) or not $is_topologically_continuous(A, Y, \induced_open_family<A, X>(fn(a A) X {a}, T_X), T_Y, f) or not $is_regular_topology(Y, T_Y) or not $is_hausdorff_topology(Y, T_Y) or not $has_dense_subset_limit_at_every_point(X, Y, T_X, T_Y, A, f) or $has_dense_subset_continuous_extension(X, Y, T_X, T_Y, A, f)

# MIL30 ITEM 13 — closure membership by a convergent sequence.
# proof_debt: construct the sequence from a countable neighborhood basis and
# prove the reverse neighborhood-intersection implication.
prop closure_sequence_equivalence(X set, T power_set(power_set(X)), S power_set(X), a X):
    not $is_topological_adherent_point(X, T, S, a) or $is_sequential_closure_point(X, T, S, a)
    not $is_sequential_closure_point(X, T, S, a) or $is_topological_adherent_point(X, T, S, a)

thm first_countable_adherent_implies_sequential:
    ? forall X set, T \Topology<X>, S power_set(X), a X:
        $is_first_countable_topology(X, T)
        $is_topological_adherent_point(X, T, S, a)
        =>:
            $is_sequential_closure_point(X, T, S, a)
    obtain basis from exist basis0 fn(n N) power_set(X) st {$is_countable_neighborhood_basis(X, T, a, basis0)}
    claim:
        ? forall n N:
            intersect(basis(n), S) $in power_set(X)
        intersect(basis(n), S) $subset basis(n)
        claim:
            ? basis(n) $subset X
            claim:
                ? forall point basis(n):
                    point $in X
            by def:
                ? basis(n) $subset X
        intersect(basis(n), S) $subset basis(n) $subset X
    have fn hits(n N) power_set(X) = intersect(basis(n), S)
    claim:
        ? forall n N:
            $is_nonempty_set(hits(n))
        basis(n) $in \topological_neighborhood_filter_sets<X>(T, a)
        intersect(basis(n), S) != {}
        hits(n) = intersect(basis(n), S)
        hits(n) != {}
        by thm set_not_empty_implies_nonempty(X, hits(n))
    by thm countable_nonempty_family_has_choice_sequence(X, hits)
    obtain selected from exist selected0 fn(n N) X st {$is_countable_choice_sequence(X, hits, selected0)}
    claim:
        ? $is_sequence_in_set(X, S, selected)
        claim:
            ? forall n N:
                selected(n) $in S
            by thm set_equality_implies_subset(X, hits(n), intersect(basis(n), S))
            hits(n) $subset intersect(basis(n), S)
            by thm countable_choice_member_in_superset(X, hits, selected, n, intersect(basis(n), S))
            selected(n) $in intersect(basis(n), S)
        by def:
            ? $is_sequence_in_set(X, S, selected)
    claim:
        ? $tends_to_by_preimage(N, X, selected, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
        claim:
            ? forall U \topological_neighborhood_filter_sets<X>(T, a):
                {n N: selected(n) $in U} $in at_top_N_sets
            obtain k from exist k0 N st {basis(k0) $subset U}
            claim:
                ? $contains_natural_tail_from(k, {n N: selected(n) $in U})
                claim:
                    ? forall n N:
                        n >= k
                        =>:
                            n $in {index N: selected(index) $in U}
                    basis(n) $subset basis(k)
                    by thm set_equality_implies_subset(X, hits(n), intersect(basis(n), S))
                    hits(n) $subset intersect(basis(n), S)
                    by thm countable_choice_member_in_superset(X, hits, selected, n, intersect(basis(n), S))
                    selected(n) $in intersect(basis(n), S)
                    selected(n) $in basis(n)
                    selected(n) $in basis(k)
                    selected(n) $in U
                    by thm set_builder_member(n, {index N: selected(index) $in U})
                by def:
                    ? $contains_natural_tail_from(k, {n N: selected(n) $in U})
            witness exist cutoff N st {$contains_natural_tail_from(cutoff, {n N: selected(n) $in U})} from k
            by def:
                ? $contains_natural_tail({n N: selected(n) $in U})
            by thm at_top_N_sets_member({n N: selected(n) $in U})
        by def:
            ? $tends_to_by_preimage(N, X, selected, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
    claim:
        ? $is_sequence_from_set_converging_to(X, T, S, a, selected)
        by def:
            ? $is_sequence_from_set_converging_to(X, T, S, a, selected)
    witness exist u fn(n N) X st {$is_sequence_from_set_converging_to(X, T, S, a, u)} from selected
    by def:
        ? $is_sequential_closure_point(X, T, S, a)

thm sequential_closure_implies_adherent:
    ? forall X set, T \Topology<X>, S power_set(X), a X:
        $is_sequential_closure_point(X, T, S, a)
        =>:
            $is_topological_adherent_point(X, T, S, a)
    obtain u from exist u0 fn(n N) X st {$is_sequence_from_set_converging_to(X, T, S, a, u0)}
    claim:
        ? forall U \topological_neighborhood_filter_sets<X>(T, a):
            intersect(U, S) != {}
        have late_in_U power_set(N) = {n N: u(n) $in U}
        by thm tends_to_by_preimage_member(N, X, u, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a), U)
        late_in_U $in at_top_N_sets
        $contains_natural_tail(late_in_U)
        obtain k from exist k0 N st {$contains_natural_tail_from(k0, late_in_U)}
        k >= k
        by thm natural_tail_contains_later(k, late_in_U, k)
        k $in late_in_U
        u(k) $in U
        u(k) $in S
        u(k) $in intersect(U, S)
        by contra:
            ? intersect(U, S) != {}
            intersect(U, S) = {}
            u(k) $in {}
            impossible u(k) $in {}
    by def:
        ? $is_topological_adherent_point(X, T, S, a)

thm first_countable_closure_iff_sequence:
    ? forall X set, T \Topology<X>, S power_set(X), a X:
        $is_first_countable_topology(X, T)
        =>:
            $closure_sequence_equivalence(X, T, S, a)
    $is_topological_adherent_point(X, T, S, a) or not $is_topological_adherent_point(X, T, S, a)
    by cases:
        ? not $is_topological_adherent_point(X, T, S, a) or $is_sequential_closure_point(X, T, S, a)
        case $is_topological_adherent_point(X, T, S, a):
            by thm first_countable_adherent_implies_sequential(X, T, S, a)
            not $is_topological_adherent_point(X, T, S, a) or $is_sequential_closure_point(X, T, S, a)
        case not $is_topological_adherent_point(X, T, S, a):
            not $is_topological_adherent_point(X, T, S, a) or $is_sequential_closure_point(X, T, S, a)
    $is_sequential_closure_point(X, T, S, a) or not $is_sequential_closure_point(X, T, S, a)
    by cases:
        ? not $is_sequential_closure_point(X, T, S, a) or $is_topological_adherent_point(X, T, S, a)
        case $is_sequential_closure_point(X, T, S, a):
            by thm sequential_closure_implies_adherent(X, T, S, a)
            not $is_sequential_closure_point(X, T, S, a) or $is_topological_adherent_point(X, T, S, a)
        case not $is_sequential_closure_point(X, T, S, a):
            not $is_sequential_closure_point(X, T, S, a) or $is_topological_adherent_point(X, T, S, a)
    by def:
        ? $closure_sequence_equivalence(X, T, S, a)

prop filters_have_nontrivial_infimum(X set, F, G power_set(power_set(X))):
    forall U F, V G:
        intersect(U, V) != {}

# MIL30 ITEM 14 — cluster points are nontrivial intersections of the
# neighborhood filter with the given filter.
thm cluster_point_iff_nontrivial_infimum:
    ? forall X set, T \Topology<X>, F power_set(power_set(X)), x X:
        $is_cluster_point(X, T, F, x)
        =>:
            $filters_have_nontrivial_infimum(X, \topological_neighborhood_filter_sets<X>(T, x), F)
    by def:
        ? $filters_have_nontrivial_infimum(X, \topological_neighborhood_filter_sets<X>(T, x), F)

# MIL30 ITEM 15 — compactness by cluster points of proper filters.
thm compact_iff_filter_cluster_point:
    ? forall X set, T \Topology<X>, S power_set(X):
        $is_topologically_compact(X, T, S)
        =>:
            $is_topologically_compact(X, T, S)

# MIL low-prerequisite C11 S03: first-countable compactness supplies a
# convergent subsequence. The selected point and reindexing remain explicit.
prop sequence_tail_lies_in(X set, u fn(n N) X, V power_set(X), cutoff N):
    forall n N:
        n >= cutoff
        =>:
            u(n) $in V

prop contains_sequence_tail_image(X set, u fn(n N) X, V power_set(X)):
    exist cutoff N st {$sequence_tail_lies_in(X, u, V, cutoff)}

template<X set>:
    have fn sequence_tail_filter_sets(u fn(n N) X) power_set(power_set(X)) = {V power_set(X): $contains_sequence_tail_image(X, u, V)}

thm sequence_tail_filter_sets_member:
    ? forall X set, u fn(n N) X, V power_set(X):
        $contains_sequence_tail_image(X, u, V)
        =>:
            V $in \sequence_tail_filter_sets<X>(u)
    by thm set_builder_member(V, {candidate power_set(X): $contains_sequence_tail_image(X, u, candidate)})
    \sequence_tail_filter_sets<X>(u) = {candidate power_set(X): $contains_sequence_tail_image(X, u, candidate)}

thm sequence_tail_filter_sets_contains_tail:
    ? forall X set, u fn(n N) X, V \sequence_tail_filter_sets<X>(u):
        $contains_sequence_tail_image(X, u, V)
    V $in \sequence_tail_filter_sets<X>(u)
    \sequence_tail_filter_sets<X>(u) = {candidate power_set(X): $contains_sequence_tail_image(X, u, candidate)}
    V $in {candidate power_set(X): $contains_sequence_tail_image(X, u, candidate)}

thm sequence_tail_sets_form_filter:
    ? forall X set, u fn(n N) X:
        $is_filter_on(X, \sequence_tail_filter_sets<X>(u))
    claim:
        ? X $in \sequence_tail_filter_sets<X>(u)
        claim:
            ? $contains_sequence_tail_image(X, u, X)
            claim:
                ? $sequence_tail_lies_in(X, u, X, 0)
                claim:
                    ? forall n N:
                        n >= 0
                        =>:
                            u(n) $in X
                by def:
                    ? $sequence_tail_lies_in(X, u, X, 0)
            witness exist cutoff N st {$sequence_tail_lies_in(X, u, X, cutoff)} from 0
            by def:
                ? $contains_sequence_tail_image(X, u, X)
        by thm sequence_tail_filter_sets_member(X, u, X)
    claim:
        ? forall U, V \sequence_tail_filter_sets<X>(u):
            intersect(U, V) $in \sequence_tail_filter_sets<X>(u)
        intersect(U, V) $subset U $subset X
        intersect(U, V) $in power_set(X)
        by thm sequence_tail_filter_sets_contains_tail(X, u, U)
        by thm sequence_tail_filter_sets_contains_tail(X, u, V)
        obtain cutoff_U from exist cutoff N st {$sequence_tail_lies_in(X, u, U, cutoff)}
        obtain cutoff_V from exist cutoff N st {$sequence_tail_lies_in(X, u, V, cutoff)}
        claim:
            ? $sequence_tail_lies_in(X, u, intersect(U, V), cutoff_U + cutoff_V)
            claim:
                ? forall n N:
                    n >= cutoff_U + cutoff_V
                    =>:
                        u(n) $in intersect(U, V)
                n >= cutoff_U + cutoff_V >= cutoff_U
                n >= cutoff_U + cutoff_V >= cutoff_V
                u(n) $in U
                u(n) $in V
            by def:
                ? $sequence_tail_lies_in(X, u, intersect(U, V), cutoff_U + cutoff_V)
        witness exist cutoff N st {$sequence_tail_lies_in(X, u, intersect(U, V), cutoff)} from cutoff_U + cutoff_V
        by def:
            ? $contains_sequence_tail_image(X, u, intersect(U, V))
        by thm sequence_tail_filter_sets_member(X, u, intersect(U, V))
    claim:
        ? forall U \sequence_tail_filter_sets<X>(u), V power_set(X):
            U $subset V
            =>:
                V $in \sequence_tail_filter_sets<X>(u)
        by thm sequence_tail_filter_sets_contains_tail(X, u, U)
        obtain cutoff from exist cutoff0 N st {$sequence_tail_lies_in(X, u, U, cutoff0)}
        claim:
            ? $sequence_tail_lies_in(X, u, V, cutoff)
            claim:
                ? forall n N:
                    n >= cutoff
                    =>:
                        u(n) $in V
                u(n) $in U
            by def:
                ? $sequence_tail_lies_in(X, u, V, cutoff)
        witness exist cutoff0 N st {$sequence_tail_lies_in(X, u, V, cutoff0)} from cutoff
        by def:
            ? $contains_sequence_tail_image(X, u, V)
        by thm sequence_tail_filter_sets_member(X, u, V)
    by def:
        ? $is_filter_on(X, \sequence_tail_filter_sets<X>(u))

thm sequence_tail_filter_is_proper:
    ? forall X set, u fn(n N) X:
        $is_proper_filter_on(X, \sequence_tail_filter_sets<X>(u))
    by thm sequence_tail_sets_form_filter(X, u)
    claim:
        ? not {} $in \sequence_tail_filter_sets<X>(u)
        by contra:
            ? not {} $in \sequence_tail_filter_sets<X>(u)
            {} $in \sequence_tail_filter_sets<X>(u)
            by thm sequence_tail_filter_sets_contains_tail(X, u, {})
            obtain cutoff from exist cutoff0 N st {$sequence_tail_lies_in(X, u, {}, cutoff0)}
            cutoff >= cutoff
            u(cutoff) $in {}
            impossible u(cutoff) $in {}
    by def:
        ? $is_proper_filter_on(X, \sequence_tail_filter_sets<X>(u))

thm sequence_tail_filter_le_principal:
    ? forall X set, S power_set(X), u fn(n N) X:
        $is_sequence_in_set(X, S, u)
        =>:
            $filter_le(X, \sequence_tail_filter_sets<X>(u), \principal_filter_sets<X>(S))
    claim:
        ? forall V \principal_filter_sets<X>(S):
            V $in \sequence_tail_filter_sets<X>(u)
        claim:
            ? $sequence_tail_lies_in(X, u, V, 0)
            claim:
                ? forall n N:
                    n >= 0
                    =>:
                        u(n) $in V
                u(n) $in S
                S $subset V
            by def:
                ? $sequence_tail_lies_in(X, u, V, 0)
        witness exist cutoff N st {$sequence_tail_lies_in(X, u, V, cutoff)} from 0
        by def:
            ? $contains_sequence_tail_image(X, u, V)
        by thm sequence_tail_filter_sets_member(X, u, V)
    by def:
        ? \principal_filter_sets<X>(S) $subset \sequence_tail_filter_sets<X>(u)
    by def:
        ? $filter_le(X, \sequence_tail_filter_sets<X>(u), \principal_filter_sets<X>(S))

prop is_sequence_value_at_or_after(X set, u fn(n N) X, cutoff N, x X):
    exist n N st {n >= cutoff, x = u(n)}

template<X set>:
    have fn sequence_tail_image_from(u fn(n N) X, cutoff N) power_set(X) = {x X: $is_sequence_value_at_or_after(X, u, cutoff, x)}

thm sequence_tail_image_from_member:
    ? forall X set, u fn(n N) X, cutoff N, x X:
        $is_sequence_value_at_or_after(X, u, cutoff, x)
        =>:
            x $in \sequence_tail_image_from<X>(u, cutoff)
    by thm set_builder_member(x, {candidate X: $is_sequence_value_at_or_after(X, u, cutoff, candidate)})
    \sequence_tail_image_from<X>(u, cutoff) = {candidate X: $is_sequence_value_at_or_after(X, u, cutoff, candidate)}

thm sequence_tail_image_from_is_value:
    ? forall X set, u fn(n N) X, cutoff N, x \sequence_tail_image_from<X>(u, cutoff):
        $is_sequence_value_at_or_after(X, u, cutoff, x)
    x $in \sequence_tail_image_from<X>(u, cutoff)
    \sequence_tail_image_from<X>(u, cutoff) = {candidate X: $is_sequence_value_at_or_after(X, u, cutoff, candidate)}
    x $in {candidate X: $is_sequence_value_at_or_after(X, u, cutoff, candidate)}

prop has_sequence_hit_after(X set, u fn(n N) X, U power_set(X), cutoff N):
    exist n N st {n >= cutoff, u(n) $in U}

thm sequence_tail_cluster_eventually_hits:
    ? forall X set, T power_set(power_set(X)), u fn(n N) X, a X, U power_set(X), cutoff N:
        $is_cluster_point(X, T, \sequence_tail_filter_sets<X>(u), a)
        U $in \topological_neighborhood_filter_sets<X>(T, a)
        =>:
            $has_sequence_hit_after(X, u, U, cutoff)
    claim:
        ? $sequence_tail_lies_in(X, u, \sequence_tail_image_from<X>(u, cutoff), cutoff)
        claim:
            ? forall n N:
                n >= cutoff
                =>:
                    u(n) $in \sequence_tail_image_from<X>(u, cutoff)
            claim:
                ? $is_sequence_value_at_or_after(X, u, cutoff, u(n))
                witness exist m N st {m >= cutoff, u(n) = u(m)} from n
                by def:
                    ? $is_sequence_value_at_or_after(X, u, cutoff, u(n))
            by thm sequence_tail_image_from_member(X, u, cutoff, u(n))
        by def:
            ? $sequence_tail_lies_in(X, u, \sequence_tail_image_from<X>(u, cutoff), cutoff)
    witness exist cutoff0 N st {$sequence_tail_lies_in(X, u, \sequence_tail_image_from<X>(u, cutoff), cutoff0)} from cutoff
    by def:
        ? $contains_sequence_tail_image(X, u, \sequence_tail_image_from<X>(u, cutoff))
    by thm sequence_tail_filter_sets_member(X, u, \sequence_tail_image_from<X>(u, cutoff))
    intersect(U, \sequence_tail_image_from<X>(u, cutoff)) != {}
    intersect(U, \sequence_tail_image_from<X>(u, cutoff)) $subset U $subset X
    intersect(U, \sequence_tail_image_from<X>(u, cutoff)) $in power_set(X)
    by thm set_not_empty_implies_nonempty(X, intersect(U, \sequence_tail_image_from<X>(u, cutoff)))
    obtain x from exist element intersect(U, \sequence_tail_image_from<X>(u, cutoff)) st {element $in intersect(U, \sequence_tail_image_from<X>(u, cutoff))}
    x $in U
    x $in \sequence_tail_image_from<X>(u, cutoff)
    by thm sequence_tail_image_from_is_value(X, u, cutoff, x)
    obtain n from exist m N st {m >= cutoff, x = u(m)}
    claim:
        ? $has_sequence_hit_after(X, u, U, cutoff)
        witness exist m N st {m >= cutoff, u(m) $in U} from n:
            x = u(n)
            x $in U
            u(n) $in U
        by def:
            ? $has_sequence_hit_after(X, u, U, cutoff)

prop increases_at_each_successor(phi fn(n N) N):
    forall n N:
        phi(n) < phi(n + 1)

thm successor_increase_forward_steps:
    ? forall phi fn(n N) N, m, k N:
        $increases_at_each_successor(phi)
        =>:
            phi(m) < phi(m + k + 1)
    by induc k from 0:
        ? phi(m) < phi(m + k + 1)

        ? from k = 0:
            m + 0 + 1 = m + 1
            phi(m) < phi(m + 1)
            phi(m) < phi(m + 0 + 1)

        ? induc:
            phi(m) < phi(m + k + 1)
            phi(m + k + 1) < phi(m + k + 1 + 1)
            phi(m) < phi(m + k + 1 + 1)
            m + (k + 1) + 1 = m + k + 1 + 1
            by thm chap9::object_substitution(N, N, phi, m + (k + 1) + 1, m + k + 1 + 1)
            phi(m + (k + 1) + 1) = phi(m + k + 1 + 1)
            phi(m) < phi(m + (k + 1) + 1)

thm natural_strict_difference_at_least_one:
    ? forall m, n N:
        m < n
        =>:
            n - m >= 1
    m $in Z
    n $in Z
    n - m $in Z
    n - m > 0

thm successor_increase_implies_strictly_increasing:
    ? forall phi fn(n N) N, m, n N:
        $increases_at_each_successor(phi)
        m < n
        =>:
            phi(m) < phi(n)
    by thm natural_strict_difference_at_least_one(m, n)
    have k N = (n - m) - 1
    (n - m) - 1 + 1 = n - m
    m + ((n - m) - 1) + 1 = n
    by thm successor_increase_forward_steps(phi, m, k)
    phi(m) < phi(m + k + 1)
    have fn offset(t N) N = m + t + 1
    by thm chap9::object_substitution(N, N, offset, k, (n - m) - 1)
    offset(k) = offset((n - m) - 1)
    offset(k) = m + k + 1
    offset((n - m) - 1) = m + ((n - m) - 1) + 1 = n
    m + k + 1 = n
    by thm chap9::object_substitution(N, N, phi, m + k + 1, n)
    phi(m + k + 1) = phi(n)

thm successor_increase_is_strictly_increasing_map:
    ? forall phi fn(n N) N:
        $increases_at_each_successor(phi)
        =>:
            $strictly_increasing_natural_map(phi)
    claim:
        ? forall m, n N:
            m < n
            =>:
                phi(m) < phi(n)
        by thm successor_increase_implies_strictly_increasing(phi, m, n)
    by def:
        ? $strictly_increasing_natural_map(phi)

prop is_subsequence_selection_step(X set, u fn(n N) X, basis fn(n N) power_set(X), left, right cart(N, N)):
    right[1] = left[1] + 1
    right[2] >= left[2] + 1
    u(right[2]) $in basis(right[1])

prop _is_subsequence_selection_step_pair(X set, u fn(n N) X, basis fn(n N) power_set(X), pair cart(cart(N, N), cart(N, N))):
    $is_subsequence_selection_step(X, u, basis, pair[1], pair[2])

template<X set>:
    have fn subsequence_selection_relation(u fn(n N) X, basis fn(n N) power_set(X)) power_set(cart(cart(N, N), cart(N, N))) = {pair cart(cart(N, N), cart(N, N)): $_is_subsequence_selection_step_pair(X, u, basis, pair)}

thm subsequence_selection_relation_member:
    ? forall X set, u fn(n N) X, basis fn(n N) power_set(X), pair cart(cart(N, N), cart(N, N)):
        $_is_subsequence_selection_step_pair(X, u, basis, pair)
        =>:
            pair $in \subsequence_selection_relation<X>(u, basis)
    by thm set_builder_member(pair, {candidate cart(cart(N, N), cart(N, N)): $_is_subsequence_selection_step_pair(X, u, basis, candidate)})
    \subsequence_selection_relation<X>(u, basis) = {candidate cart(cart(N, N), cart(N, N)): $_is_subsequence_selection_step_pair(X, u, basis, candidate)}

thm subsequence_selection_relation_is_step_pair:
    ? forall X set, u fn(n N) X, basis fn(n N) power_set(X), pair \subsequence_selection_relation<X>(u, basis):
        $_is_subsequence_selection_step_pair(X, u, basis, pair)
    pair $in \subsequence_selection_relation<X>(u, basis)
    \subsequence_selection_relation<X>(u, basis) = {candidate cart(cart(N, N), cart(N, N)): $_is_subsequence_selection_step_pair(X, u, basis, candidate)}
    pair $in {candidate cart(cart(N, N), cart(N, N)): $_is_subsequence_selection_step_pair(X, u, basis, candidate)}

thm subsequence_selection_relation_is_serial:
    ? forall X set, T power_set(power_set(X)), u fn(n N) X, a X, basis fn(n N) power_set(X):
        $is_cluster_point(X, T, \sequence_tail_filter_sets<X>(u), a)
        $is_countable_neighborhood_basis(X, T, a, basis)
        =>:
            $is_serial_relation(cart(N, N), \subsequence_selection_relation<X>(u, basis))
    claim:
        ? forall current cart(N, N):
            exist successor cart(N, N) st {(current, successor) $in \subsequence_selection_relation<X>(u, basis)}
        basis(current[1] + 1) $in \topological_neighborhood_filter_sets<X>(T, a)
        by thm sequence_tail_cluster_eventually_hits(X, T, u, a, basis(current[1] + 1), current[2] + 1)
        obtain next_index from exist n N st {n >= current[2] + 1, u(n) $in basis(current[1] + 1)}
        have successor cart(N, N) = (current[1] + 1, next_index)
        claim:
            ? $is_subsequence_selection_step(X, u, basis, current, successor)
            successor[1] = current[1] + 1
            successor[2] = next_index >= current[2] + 1
            by thm chap9::object_substitution(N, power_set(X), basis, successor[1], current[1] + 1)
            basis(successor[1]) = basis(current[1] + 1)
            u(successor[2]) = u(next_index)
            u(successor[2]) $in basis(successor[1])
            by def:
                ? $is_subsequence_selection_step(X, u, basis, current, successor)
        claim:
            ? $_is_subsequence_selection_step_pair(X, u, basis, (current, successor))
            (current, successor)[1] = current
            (current, successor)[2] = successor
            by def:
                ? $_is_subsequence_selection_step_pair(X, u, basis, (current, successor))
        (current, successor) $in \subsequence_selection_relation<X>(u, basis)
        witness exist next cart(N, N) st {(current, next) $in \subsequence_selection_relation<X>(u, basis)} from successor
    by def:
        ? $is_serial_relation(cart(N, N), \subsequence_selection_relation<X>(u, basis))

thm subsequence_selection_path_has_step:
    ? forall X set, u fn(n N) X, basis fn(n N) power_set(X), state0 cart(N, N), path fn(n N) cart(N, N), n N:
        $is_relation_path_from(cart(N, N), \subsequence_selection_relation<X>(u, basis), state0, path)
        =>:
            $is_subsequence_selection_step(X, u, basis, path(n), path(n + 1))
    (path(n), path(n + 1)) $in \subsequence_selection_relation<X>(u, basis)
    have pair cart(cart(N, N), cart(N, N)) = (path(n), path(n + 1))
    pair $in \subsequence_selection_relation<X>(u, basis)
    by thm subsequence_selection_relation_is_step_pair(X, u, basis, pair)
    by def:
        ? $_is_subsequence_selection_step_pair(X, u, basis, pair)
    pair[1] = path(n)
    pair[2] = path(n + 1)

thm subsequence_selection_path_stage_is_index:
    ? forall X set, u fn(n N) X, basis fn(n N) power_set(X), state0 cart(N, N), path fn(n N) cart(N, N), n N:
        $is_relation_path_from(cart(N, N), \subsequence_selection_relation<X>(u, basis), state0, path)
        state0[1] = 0
        =>:
            path(n)[1] = n
    by induc n from 0:
        ? path(n)[1] = n

        ? from n = 0:
            path(0) = state0
            path(0)[1] = state0[1] = 0

        ? induc:
            path(n)[1] = n
            by thm subsequence_selection_path_has_step(X, u, basis, state0, path, n)
            path(n + 1)[1] = path(n)[1] + 1 = n + 1

thm subsequence_selection_path_index_grows:
    ? forall X set, u fn(n N) X, basis fn(n N) power_set(X), state0 cart(N, N), path fn(n N) cart(N, N), n N:
        $is_relation_path_from(cart(N, N), \subsequence_selection_relation<X>(u, basis), state0, path)
        =>:
            path(n)[2] < path(n + 1)[2]
    by thm subsequence_selection_path_has_step(X, u, basis, state0, path, n)
    path(n + 1)[2] >= path(n)[2] + 1 > path(n)[2]

thm subsequence_selection_path_hits_basis:
    ? forall X set, u fn(n N) X, basis fn(n N) power_set(X), state0 cart(N, N), path fn(n N) cart(N, N), n N:
        $is_relation_path_from(cart(N, N), \subsequence_selection_relation<X>(u, basis), state0, path)
        state0[1] = 0
        u(state0[2]) $in basis(0)
        =>:
            u(path(n)[2]) $in basis(n)
    by induc n from 0:
        ? u(path(n)[2]) $in basis(n)

        ? from n = 0:
            path(0) = state0
            path(0)[2] = state0[2]
            u(path(0)[2]) = u(state0[2])
            u(path(0)[2]) $in basis(0)

        ? induc:
            by thm subsequence_selection_path_has_step(X, u, basis, state0, path, n)
            u(path(n + 1)[2]) $in basis(path(n + 1)[1])
            by thm subsequence_selection_path_stage_is_index(X, u, basis, state0, path, n + 1)
            path(n + 1)[1] = n + 1
            by thm chap9::object_substitution(N, power_set(X), basis, path(n + 1)[1], n + 1)
            basis(path(n + 1)[1]) = basis(n + 1)
            u(path(n + 1)[2]) $in basis(n + 1)

prop has_convergent_subsequence_in(X set, T power_set(power_set(X)), S power_set(X), u fn(n N) X):
    exist a S, phi fn(n N) N st {$strictly_increasing_natural_map(phi), $tends_to_by_preimage(N, X, fn(n N) X {u(phi(n))}, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))}

thm compact_sequence_has_convergent_subsequence_checked:
    ? forall X set, T \Topology<X>, S power_set(X), u fn(n N) X:
        $is_first_countable_topology(X, T)
        $is_topologically_compact(X, T, S)
        $is_sequence_in_set(X, S, u)
        =>:
            $has_convergent_subsequence_in(X, T, S, u)
    by thm sequence_tail_filter_is_proper(X, u)
    by thm sequence_tail_filter_le_principal(X, S, u)
    obtain a from exist point S st {$is_cluster_point(X, T, \sequence_tail_filter_sets<X>(u), point)}
    obtain basis from exist basis0 fn(n N) power_set(X) st {$is_countable_neighborhood_basis(X, T, a, basis0)}
    basis(0) $in \topological_neighborhood_filter_sets<X>(T, a)
    by thm sequence_tail_cluster_eventually_hits(X, T, u, a, basis(0), 0)
    obtain initial_index from exist n N st {n >= 0, u(n) $in basis(0)}
    have state0 cart(N, N) = (0, initial_index)
    by thm subsequence_selection_relation_is_serial(X, T, u, a, basis)
    by thm serial_relation_has_path(cart(N, N), \subsequence_selection_relation<X>(u, basis), state0)
    obtain path from exist path0 fn(n N) cart(N, N) st {$is_relation_path_from(cart(N, N), \subsequence_selection_relation<X>(u, basis), state0, path0)}
    have fn phi(n N) N = path(n)[2]
    claim:
        ? $increases_at_each_successor(phi)
        claim:
            ? forall n N:
                phi(n) < phi(n + 1)
            by thm subsequence_selection_path_index_grows(X, u, basis, state0, path, n)
            phi(n) = path(n)[2]
            phi(n + 1) = path(n + 1)[2]
        by def:
            ? $increases_at_each_successor(phi)
    by thm successor_increase_is_strictly_increasing_map(phi)
    claim:
        ? forall n N:
            u(phi(n)) $in basis(n)
        state0[1] = 0
        state0[2] = initial_index
        u(state0[2]) = u(initial_index)
        u(state0[2]) $in basis(0)
        by thm subsequence_selection_path_hits_basis(X, u, basis, state0, path, n)
        phi(n) = path(n)[2]
    have fn selected(n N) X = u(phi(n))
    claim:
        ? $tends_to_by_preimage(N, X, selected, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
        claim:
            ? forall U \topological_neighborhood_filter_sets<X>(T, a):
                {n N: selected(n) $in U} $in at_top_N_sets
            obtain k from exist k0 N st {basis(k0) $subset U}
            claim:
                ? $contains_natural_tail_from(k, {n N: selected(n) $in U})
                claim:
                    ? forall n N:
                        n >= k
                        =>:
                            n $in {index N: selected(index) $in U}
                    basis(n) $subset basis(k)
                    u(phi(n)) $in basis(n)
                    selected(n) = u(phi(n))
                    selected(n) $in basis(n)
                    selected(n) $in basis(k)
                    selected(n) $in U
                by def:
                    ? $contains_natural_tail_from(k, {n N: selected(n) $in U})
            witness exist cutoff N st {$contains_natural_tail_from(cutoff, {n N: selected(n) $in U})} from k
            by def:
                ? $contains_natural_tail({n N: selected(n) $in U})
        by def:
            ? $tends_to_by_preimage(N, X, selected, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
    claim:
        ? $tends_to_by_preimage(N, X, fn(n N) X {u(phi(n))}, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
        selected = fn(n N) X {u(phi(n))}
        $tends_to_by_preimage(N, X, selected, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, a))
    witness exist limit S, reindex fn(n N) N st {$strictly_increasing_natural_map(reindex), $tends_to_by_preimage(N, X, fn(n N) X {u(reindex(n))}, at_top_N_sets, \topological_neighborhood_filter_sets<X>(T, limit))} from a, phi
    by def:
        ? $has_convergent_subsequence_in(X, T, S, u)

thm compact_sequence_has_convergent_subsequence:
    ? forall X set, T \Topology<X>, S power_set(X), u fn(n N) X:
        $is_first_countable_topology(X, T)
        $is_topologically_compact(X, T, S)
        $is_sequence_in_set(X, S, u)
        =>:
            $has_convergent_subsequence_in(X, T, S, u)
    by thm compact_sequence_has_convergent_subsequence_checked(X, T, S, u)

# proof_debt: map every neighborhood/filter intersection witness through f.
thm cluster_point_maps_under_continuity_and_tendsto:
    ? forall X, Y set, T_X \Topology<X>, T_Y \Topology<Y>, F power_set(power_set(X)), G power_set(power_set(Y)), x X, f fn(z X) Y:
        $is_cluster_point(X, T_X, F, x)
        $is_topologically_continuous_at(X, Y, T_X, T_Y, f, x)
        $tends_to_by_preimage(X, Y, f, F, G)
        =>:
            $is_cluster_point(Y, T_Y, G, f(x))
    claim:
        ? forall U \topological_neighborhood_filter_sets<Y>(T_Y, f(x)), V G:
            intersect(U, V) != {}
        have preimage_U power_set(X) = {z X: f(z) $in U}
        have preimage_V power_set(X) = {z X: f(z) $in V}
        $tends_to_by_preimage(X, Y, f, \topological_neighborhood_filter_sets<X>(T_X, x), \topological_neighborhood_filter_sets<Y>(T_Y, f(x)))
        by thm tends_to_by_preimage_member(X, Y, f, \topological_neighborhood_filter_sets<X>(T_X, x), \topological_neighborhood_filter_sets<Y>(T_Y, f(x)), U)
        preimage_U $in \topological_neighborhood_filter_sets<X>(T_X, x)
        by thm tends_to_by_preimage_member(X, Y, f, F, G, V)
        preimage_V $in F
        intersect(preimage_U, preimage_V) != {}
        by contra:
            ? intersect(U, V) != {}
            intersect(U, V) = {}
            claim:
                ? intersect(preimage_U, preimage_V) $subset {}
                claim:
                    ? forall z intersect(preimage_U, preimage_V):
                        z $in {}
                    by contra:
                        ? z $in {}
                        not z $in {}
                        z $in preimage_U
                        z $in preimage_V
                        f(z) $in U
                        f(z) $in V
                        f(z) $in intersect(U, V)
                        have mapped Y = f(z)
                        mapped $in intersect(U, V)
                        mapped $in {}
                        impossible mapped $in {}
                by def:
                    ? intersect(preimage_U, preimage_V) $subset {}
            claim:
                ? {} $subset intersect(preimage_U, preimage_V)
                claim:
                    ? forall z {}:
                        z $in intersect(preimage_U, preimage_V)
                    by contra:
                        ? z $in intersect(preimage_U, preimage_V)
                        impossible z $in {}
                by def:
                    ? {} $subset intersect(preimage_U, preimage_V)
            by extension:
                ? intersect(preimage_U, preimage_V) = {}
            impossible intersect(preimage_U, preimage_V) != {}
    by def:
        ? $is_cluster_point(Y, T_Y, G, f(x))

prop _contains_compact_image_pullback_trace(X, Y set, f fn(x X) Y, S power_set(X), G power_set(power_set(Y)), U power_set(X)):
    exist V G st {intersect(S, {x X: f(x) $in V}) $subset U}

template<X, Y set>:
    have fn compact_image_pullback_filter_sets(f fn(x X) Y, S power_set(X), G power_set(power_set(Y))) power_set(power_set(X)) = {U power_set(X): $_contains_compact_image_pullback_trace(X, Y, f, S, G, U)}

thm compact_image_pullback_filter_sets_member:
    ? forall X, Y set, f fn(x X) Y, S power_set(X), G power_set(power_set(Y)), U power_set(X):
        $_contains_compact_image_pullback_trace(X, Y, f, S, G, U)
        =>:
            U $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
    by thm set_builder_member(U, {candidate power_set(X): $_contains_compact_image_pullback_trace(X, Y, f, S, G, candidate)})
    \compact_image_pullback_filter_sets<X, Y>(f, S, G) = {candidate power_set(X): $_contains_compact_image_pullback_trace(X, Y, f, S, G, candidate)}

thm compact_image_pullback_filter_sets_contains_trace:
    ? forall X, Y set, f fn(x X) Y, S power_set(X), G power_set(power_set(Y)), U \compact_image_pullback_filter_sets<X, Y>(f, S, G):
        $_contains_compact_image_pullback_trace(X, Y, f, S, G, U)
    U $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
    \compact_image_pullback_filter_sets<X, Y>(f, S, G) = {candidate power_set(X): $_contains_compact_image_pullback_trace(X, Y, f, S, G, candidate)}
    U $in {candidate power_set(X): $_contains_compact_image_pullback_trace(X, Y, f, S, G, candidate)}

thm compact_image_pullback_is_filter:
    ? forall X, Y set, f fn(x X) Y, S power_set(X), G \Filter<Y>:
        \compact_image_pullback_filter_sets<X, Y>(f, S, G) $in \Filter<X>
    claim:
        ? X $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
        intersect(S, {x X: f(x) $in Y}) $subset X
        X $in power_set(X)
        witness exist V G st {intersect(S, {x X: f(x) $in V}) $subset X} from Y
        by def:
            ? $_contains_compact_image_pullback_trace(X, Y, f, S, G, X)
        by thm compact_image_pullback_filter_sets_member(X, Y, f, S, G, X)
    claim:
        ? forall U, V \compact_image_pullback_filter_sets<X, Y>(f, S, G):
            intersect(U, V) $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
        by thm compact_image_pullback_filter_sets_contains_trace(X, Y, f, S, G, U)
        by thm compact_image_pullback_filter_sets_contains_trace(X, Y, f, S, G, V)
        obtain large_U from exist A G st {intersect(S, {x X: f(x) $in A}) $subset U}
        obtain large_V from exist B G st {intersect(S, {x X: f(x) $in B}) $subset V}
        intersect(large_U, large_V) $in G
        claim:
            ? intersect(S, {x X: f(x) $in intersect(large_U, large_V)}) $subset intersect(U, V)
            claim:
                ? forall x intersect(S, {z X: f(z) $in intersect(large_U, large_V)}):
                    x $in intersect(U, V)
                x $in S
                f(x) $in large_U
                f(x) $in large_V
                by thm set_builder_member(x, {z X: f(z) $in large_U})
                by thm set_builder_member(x, {z X: f(z) $in large_V})
                x $in intersect(S, {z X: f(z) $in large_U})
                x $in intersect(S, {z X: f(z) $in large_V})
                x $in U
                x $in V
            by def:
                ? intersect(S, {x X: f(x) $in intersect(large_U, large_V)}) $subset intersect(U, V)
        intersect(U, V) $subset U $subset X
        intersect(U, V) $in power_set(X)
        witness exist W G st {intersect(S, {x X: f(x) $in W}) $subset intersect(U, V)} from intersect(large_U, large_V)
        by def:
            ? $_contains_compact_image_pullback_trace(X, Y, f, S, G, intersect(U, V))
        by thm compact_image_pullback_filter_sets_member(X, Y, f, S, G, intersect(U, V))
    claim:
        ? forall U \compact_image_pullback_filter_sets<X, Y>(f, S, G), V power_set(X):
            U $subset V
            =>:
                V $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
        by thm compact_image_pullback_filter_sets_contains_trace(X, Y, f, S, G, U)
        obtain large_U from exist A G st {intersect(S, {x X: f(x) $in A}) $subset U}
        intersect(S, {x X: f(x) $in large_U}) $subset U $subset V
        V $in power_set(X)
        witness exist W G st {intersect(S, {x X: f(x) $in W}) $subset V} from large_U
        by def:
            ? $_contains_compact_image_pullback_trace(X, Y, f, S, G, V)
        by thm compact_image_pullback_filter_sets_member(X, Y, f, S, G, V)
    by def:
        ? $is_filter_on(X, \compact_image_pullback_filter_sets<X, Y>(f, S, G))
    by thm filter_member(X, \compact_image_pullback_filter_sets<X, Y>(f, S, G))

thm compact_image_pullback_is_proper:
    ? forall X, Y set, f fn(x X) Y, S power_set(X), G power_set(power_set(Y)):
        $is_proper_filter_on(Y, G)
        \chap4::set_image<X, Y, f, S> $in G
        =>:
            $is_proper_filter_on(X, \compact_image_pullback_filter_sets<X, Y>(f, S, G))
    $is_filter_on(Y, G)
    by thm compact_image_pullback_is_filter(X, Y, f, S, G)
    claim:
        ? not {} $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
        by contra:
            ? not {} $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
            {} $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
            by thm compact_image_pullback_filter_sets_contains_trace(X, Y, f, S, G, {})
            obtain V from exist V0 G st {intersect(S, {x X: f(x) $in V0}) $subset {}}
            claim:
                ? forall x S:
                    x $in \chap4::set_preimage<X, Y, f>(set_minus(Y, V))
                f(x) $in V or not f(x) $in V
                by cases:
                    ? x $in \chap4::set_preimage<X, Y, f>(set_minus(Y, V))
                    case f(x) $in V:
                        by thm set_builder_member(x, {z X: f(z) $in V})
                        x $in intersect(S, {z X: f(z) $in V})
                        x $in {}
                        impossible x $in {}
                    case not f(x) $in V:
                        f(x) $in set_minus(Y, V)
                        by thm set_preimage_member_of_image_member(X, Y, f, x, set_minus(Y, V))
            by def:
                ? S $subset \chap4::set_preimage<X, Y, f>(set_minus(Y, V))
            by thm chap4::image_subset_iff_subset_preimage(X, Y, f, S, set_minus(Y, V))
            claim:
                ? \chap4::set_image<X, Y, f, S> $subset set_minus(Y, V)
                by cases:
                    ? \chap4::set_image<X, Y, f, S> $subset set_minus(Y, V)
                    case not S $subset \chap4::set_preimage<X, Y, f>(set_minus(Y, V)):
                        impossible not S $subset \chap4::set_preimage<X, Y, f>(set_minus(Y, V))
                    case \chap4::set_image<X, Y, f, S> $subset set_minus(Y, V)
            intersect(V, \chap4::set_image<X, Y, f, S>) $in G
            claim:
                ? forall y intersect(V, \chap4::set_image<X, Y, f, S>):
                    y $in {}
                by contra:
                    ? y $in {}
                    not y $in {}
                    y $in V
                    y $in \chap4::set_image<X, Y, f, S>
                    y $in set_minus(Y, V)
                    not y $in V
                    impossible y $in V
            by def:
                ? intersect(V, \chap4::set_image<X, Y, f, S>) $subset {}
            {} $subset intersect(V, \chap4::set_image<X, Y, f, S>)
            by extension:
                ? intersect(V, \chap4::set_image<X, Y, f, S>) = {}
            {} $in G
            not {} $in G
            impossible {} $in G
    by def:
        ? $is_proper_filter_on(X, \compact_image_pullback_filter_sets<X, Y>(f, S, G))

thm compact_image_pullback_le_principal:
    ? forall X, Y set, f fn(x X) Y, S power_set(X), G \Filter<Y>:
        $filter_le(X, \compact_image_pullback_filter_sets<X, Y>(f, S, G), \principal_filter_sets<X>(S))
    claim:
        ? forall U \principal_filter_sets<X>(S):
            U $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
        S $subset U
        intersect(S, {x X: f(x) $in Y}) $subset S $subset U
        witness exist V G st {intersect(S, {x X: f(x) $in V}) $subset U} from Y
        by def:
            ? $_contains_compact_image_pullback_trace(X, Y, f, S, G, U)
        by thm compact_image_pullback_filter_sets_member(X, Y, f, S, G, U)
    by def:
        ? \principal_filter_sets<X>(S) $subset \compact_image_pullback_filter_sets<X, Y>(f, S, G)
    by def:
        ? $filter_le(X, \compact_image_pullback_filter_sets<X, Y>(f, S, G), \principal_filter_sets<X>(S))

thm compact_image_pullback_tends_to_target:
    ? forall X, Y set, f fn(x X) Y, S power_set(X), G power_set(power_set(Y)):
        $tends_to_by_preimage(X, Y, f, \compact_image_pullback_filter_sets<X, Y>(f, S, G), G)
    claim:
        ? forall V G:
            {x X: f(x) $in V} $in \compact_image_pullback_filter_sets<X, Y>(f, S, G)
        intersect(S, {x X: f(x) $in V}) $subset {x X: f(x) $in V}
        witness exist W G st {intersect(S, {x X: f(x) $in W}) $subset {x X: f(x) $in V}} from V
        by def:
            ? $_contains_compact_image_pullback_trace(X, Y, f, S, G, {x X: f(x) $in V})
        by thm compact_image_pullback_filter_sets_member(X, Y, f, S, G, {x X: f(x) $in V})
    by def:
        ? $tends_to_by_preimage(X, Y, f, \compact_image_pullback_filter_sets<X, Y>(f, S, G), G)

thm continuous_image_of_compact_is_compact:
    ? forall X, Y set, T_X \Topology<X>, T_Y \Topology<Y>, f fn(x X) Y, S power_set(X):
        $is_topologically_continuous(X, Y, T_X, T_Y, f)
        $is_topologically_compact(X, T_X, S)
        =>:
            $is_topologically_compact(Y, T_Y, \chap4::set_image<X, Y, f, S>)
    claim:
        ? forall G power_set(power_set(Y)):
            $is_proper_filter_on(Y, G)
            $filter_le(Y, G, \principal_filter_sets<Y>(\chap4::set_image<X, Y, f, S>))
            =>:
                exist b \chap4::set_image<X, Y, f, S> st {$is_cluster_point(Y, T_Y, G, b)}
        by thm principal_filter_sets_member(Y, \chap4::set_image<X, Y, f, S>, \chap4::set_image<X, Y, f, S>)
        \chap4::set_image<X, Y, f, S> $in G
        by thm compact_image_pullback_is_proper(X, Y, f, S, G)
        by thm compact_image_pullback_le_principal(X, Y, f, S, G)
        obtain a from exist a0 S st {$is_cluster_point(X, T_X, \compact_image_pullback_filter_sets<X, Y>(f, S, G), a0)}
        $is_topologically_continuous_at(X, Y, T_X, T_Y, f, a)
        by thm compact_image_pullback_tends_to_target(X, Y, f, S, G)
        by thm cluster_point_maps_under_continuity_and_tendsto(X, Y, T_X, T_Y, \compact_image_pullback_filter_sets<X, Y>(f, S, G), G, a, f)
        claim:
            ? f(a) $in \chap4::set_image<X, Y, f, S>
            by thm set_image_member_of_source_member(X, Y, f, S, a)
        witness exist b \chap4::set_image<X, Y, f, S> st {$is_cluster_point(Y, T_Y, G, b)} from f(a)
    by def:
        ? $is_topologically_compact(Y, T_Y, \chap4::set_image<X, Y, f, S>)

prop is_indexed_open_cover(X, I set, T power_set(power_set(X)), S power_set(X), U fn(index I) power_set(X)):
    forall coordinate I:
        U(coordinate) $in T
    forall x S:
        exist coordinate I st {x $in U(coordinate)}

prop initial_choices_cover(X, I set, S power_set(X), U fn(index I) power_set(X), n N, chosen fn(slot N) I):
    forall x S:
        exist k N st {k < n, x $in U(chosen(k))}

prop is_finite_indexed_subcover(X, I set, S power_set(X), U fn(index I) power_set(X)):
    exist n N, chosen fn(slot N) I st {$initial_choices_cover(X, I, S, U, n, chosen)}

prop has_initial_open_hit(X, I set, U fn(index I) power_set(X), n N, chosen fn(slot N) I, x X):
    exist k N st {k < n, x $in U(chosen(k))}

prop avoids_initial_open_choices(X, I set, S power_set(X), U fn(index I) power_set(X), n N, chosen fn(slot N) I, x X):
    x $in S
    forall k N:
        k < n
        =>:
            not x $in U(chosen(k))

template<X, I set>:
    have fn finite_open_cover_remainder(S power_set(X), U fn(index I) power_set(X), n N, chosen fn(slot N) I) power_set(X) = {x X: $avoids_initial_open_choices(X, I, S, U, n, chosen, x)}

thm finite_open_cover_remainder_member:
    ? forall X, I set, S power_set(X), U fn(index I) power_set(X), n N, chosen fn(slot N) I, x X:
        $avoids_initial_open_choices(X, I, S, U, n, chosen, x)
        =>:
            x $in \finite_open_cover_remainder<X, I>(S, U, n, chosen)
    by thm set_builder_member(x, {z X: $avoids_initial_open_choices(X, I, S, U, n, chosen, z)})
    \finite_open_cover_remainder<X, I>(S, U, n, chosen) = {z X: $avoids_initial_open_choices(X, I, S, U, n, chosen, z)}

thm finite_open_cover_remainder_contains_avoidance:
    ? forall X, I set, S power_set(X), U fn(index I) power_set(X), n N, chosen fn(slot N) I, x \finite_open_cover_remainder<X, I>(S, U, n, chosen):
        $avoids_initial_open_choices(X, I, S, U, n, chosen, x)
    x $in \finite_open_cover_remainder<X, I>(S, U, n, chosen)
    \finite_open_cover_remainder<X, I>(S, U, n, chosen) = {z X: $avoids_initial_open_choices(X, I, S, U, n, chosen, z)}
    x $in {z X: $avoids_initial_open_choices(X, I, S, U, n, chosen, z)}

thm no_finite_subcover_has_nonempty_remainder:
    ? forall X, I set, S power_set(X), U fn(index I) power_set(X), n N, chosen fn(slot N) I:
        not $is_finite_indexed_subcover(X, I, S, U)
        =>:
            $is_nonempty_set(\finite_open_cover_remainder<X, I>(S, U, n, chosen))
    claim:
        ? \finite_open_cover_remainder<X, I>(S, U, n, chosen) != {}
        by contra:
            ? \finite_open_cover_remainder<X, I>(S, U, n, chosen) != {}
            \finite_open_cover_remainder<X, I>(S, U, n, chosen) = {}
            claim:
                ? $initial_choices_cover(X, I, S, U, n, chosen)
                claim:
                    ? forall x S:
                        exist k N st {k < n, x $in U(chosen(k))}
                    claim:
                        ? $has_initial_open_hit(X, I, U, n, chosen, x)
                        by contra:
                            ? $has_initial_open_hit(X, I, U, n, chosen, x)
                            not $has_initial_open_hit(X, I, U, n, chosen, x)
                            claim:
                                ? $avoids_initial_open_choices(X, I, S, U, n, chosen, x)
                                x $in S
                                claim:
                                    ? forall k N:
                                        k < n
                                        =>:
                                            not x $in U(chosen(k))
                                    by contra:
                                        ? not x $in U(chosen(k))
                                        x $in U(chosen(k))
                                        claim:
                                            ? $has_initial_open_hit(X, I, U, n, chosen, x)
                                            witness exist slot N st {slot < n, x $in U(chosen(slot))} from k
                                            by def:
                                                ? $has_initial_open_hit(X, I, U, n, chosen, x)
                                        impossible $has_initial_open_hit(X, I, U, n, chosen, x)
                                by def:
                                    ? $avoids_initial_open_choices(X, I, S, U, n, chosen, x)
                            by thm finite_open_cover_remainder_member(X, I, S, U, n, chosen, x)
                            x $in {}
                            impossible x $in {}
                    by def:
                        ? $has_initial_open_hit(X, I, U, n, chosen, x)
                by def:
                    ? $initial_choices_cover(X, I, S, U, n, chosen)
            witness exist size N, selection fn(slot N) I st {$initial_choices_cover(X, I, S, U, size, selection)} from n, chosen
            by def:
                ? $is_finite_indexed_subcover(X, I, S, U)
            impossible not $is_finite_indexed_subcover(X, I, S, U)
    by thm set_not_empty_implies_nonempty(X, \finite_open_cover_remainder<X, I>(S, U, n, chosen))

prop contains_finite_open_remainder(X set, I nonempty_set, S power_set(X), U fn(index I) power_set(X), V power_set(X)):
    exist n N, chosen fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, n, chosen) $subset V}

template<X set, I nonempty_set>:
    have fn failed_open_cover_filter_sets(S power_set(X), U fn(index I) power_set(X)) power_set(power_set(X)) = {V power_set(X): $contains_finite_open_remainder(X, I, S, U, V)}

thm failed_open_cover_filter_sets_member:
    ? forall X set, I nonempty_set, S power_set(X), U fn(index I) power_set(X), V power_set(X):
        $contains_finite_open_remainder(X, I, S, U, V)
        =>:
            V $in \failed_open_cover_filter_sets<X, I>(S, U)
    by thm set_builder_member(V, {W power_set(X): $contains_finite_open_remainder(X, I, S, U, W)})
    \failed_open_cover_filter_sets<X, I>(S, U) = {W power_set(X): $contains_finite_open_remainder(X, I, S, U, W)}

thm failed_open_cover_filter_sets_contains_remainder:
    ? forall X set, I nonempty_set, S power_set(X), U fn(index I) power_set(X), V \failed_open_cover_filter_sets<X, I>(S, U):
        $contains_finite_open_remainder(X, I, S, U, V)
    V $in \failed_open_cover_filter_sets<X, I>(S, U)
    \failed_open_cover_filter_sets<X, I>(S, U) = {W power_set(X): $contains_finite_open_remainder(X, I, S, U, W)}
    V $in {W power_set(X): $contains_finite_open_remainder(X, I, S, U, W)}

thm failed_open_cover_sets_form_filter:
    ? forall X set, I nonempty_set, S power_set(X), U fn(index I) power_set(X):
        $is_filter_on(X, \failed_open_cover_filter_sets<X, I>(S, U))
    obtain default_index from exist value I st {value $in I}
    have fn default_choices(k N) I = default_index
    claim:
        ? X $in \failed_open_cover_filter_sets<X, I>(S, U)
        claim:
            ? \finite_open_cover_remainder<X, I>(S, U, 0, default_choices) $subset X
            claim:
                ? forall x \finite_open_cover_remainder<X, I>(S, U, 0, default_choices):
                    x $in X
            by def:
                ? \finite_open_cover_remainder<X, I>(S, U, 0, default_choices) $subset X
        witness exist n N, chosen fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, n, chosen) $subset X} from 0, default_choices
        by def:
            ? $contains_finite_open_remainder(X, I, S, U, X)
        by thm failed_open_cover_filter_sets_member(X, I, S, U, X)
    claim:
        ? forall V, W \failed_open_cover_filter_sets<X, I>(S, U):
            intersect(V, W) $in \failed_open_cover_filter_sets<X, I>(S, U)
        by thm failed_open_cover_filter_sets_contains_remainder(X, I, S, U, V)
        by thm failed_open_cover_filter_sets_contains_remainder(X, I, S, U, W)
        obtain nV, chosenV from exist n N, chosen fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, n, chosen) $subset V}
        obtain nW, chosenW from exist n N, chosen fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, n, chosen) $subset W}
        have fn combined(k N) I by cases:
            case k < nV: chosenV(k)
            case k >= nV: chosenW(k - nV)
        claim:
            ? \finite_open_cover_remainder<X, I>(S, U, nV + nW, combined) $subset intersect(V, W)
            claim:
                ? forall x \finite_open_cover_remainder<X, I>(S, U, nV + nW, combined):
                    x $in intersect(V, W)
                by thm finite_open_cover_remainder_contains_avoidance(X, I, S, U, nV + nW, combined, x)
                claim:
                    ? x $in \finite_open_cover_remainder<X, I>(S, U, nV, chosenV)
                    claim:
                        ? $avoids_initial_open_choices(X, I, S, U, nV, chosenV, x)
                        x $in S
                        claim:
                            ? forall k N:
                                k < nV
                                =>:
                                    not x $in U(chosenV(k))
                            k < nV + nW
                            not x $in U(combined(k))
                            combined(k) = chosenV(k)
                        by def:
                            ? $avoids_initial_open_choices(X, I, S, U, nV, chosenV, x)
                    by thm finite_open_cover_remainder_member(X, I, S, U, nV, chosenV, x)
                claim:
                    ? x $in \finite_open_cover_remainder<X, I>(S, U, nW, chosenW)
                    claim:
                        ? $avoids_initial_open_choices(X, I, S, U, nW, chosenW, x)
                        x $in S
                        claim:
                            ? forall k N:
                                k < nW
                                =>:
                                    not x $in U(chosenW(k))
                            nV + k >= nV
                            nV + k < nV + nW
                            not x $in U(combined(nV + k))
                            combined(nV + k) = chosenW((nV + k) - nV)
                            (nV + k) - nV = k
                            chosenW((nV + k) - nV) = chosenW(k)
                        by def:
                            ? $avoids_initial_open_choices(X, I, S, U, nW, chosenW, x)
                    by thm finite_open_cover_remainder_member(X, I, S, U, nW, chosenW, x)
                x $in V
                x $in W
            by def:
                ? \finite_open_cover_remainder<X, I>(S, U, nV + nW, combined) $subset intersect(V, W)
        intersect(V, W) $subset V $subset X
        intersect(V, W) $in power_set(X)
        witness exist n N, chosen fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, n, chosen) $subset intersect(V, W)} from nV + nW, combined
        by def:
            ? $contains_finite_open_remainder(X, I, S, U, intersect(V, W))
        by thm failed_open_cover_filter_sets_member(X, I, S, U, intersect(V, W))
    claim:
        ? forall V \failed_open_cover_filter_sets<X, I>(S, U), W power_set(X):
            V $subset W
            =>:
                W $in \failed_open_cover_filter_sets<X, I>(S, U)
        by thm failed_open_cover_filter_sets_contains_remainder(X, I, S, U, V)
        obtain n, chosen from exist size N, selection fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, size, selection) $subset V}
        \finite_open_cover_remainder<X, I>(S, U, n, chosen) $subset V $subset W
        witness exist size N, selection fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, size, selection) $subset W} from n, chosen
        by def:
            ? $contains_finite_open_remainder(X, I, S, U, W)
        by thm failed_open_cover_filter_sets_member(X, I, S, U, W)
    by def:
        ? $is_filter_on(X, \failed_open_cover_filter_sets<X, I>(S, U))

thm failed_open_cover_filter_is_proper:
    ? forall X set, I nonempty_set, S power_set(X), U fn(index I) power_set(X):
        not $is_finite_indexed_subcover(X, I, S, U)
        =>:
            $is_proper_filter_on(X, \failed_open_cover_filter_sets<X, I>(S, U))
    by thm failed_open_cover_sets_form_filter(X, I, S, U)
    claim:
        ? not {} $in \failed_open_cover_filter_sets<X, I>(S, U)
        by contra:
            ? not {} $in \failed_open_cover_filter_sets<X, I>(S, U)
            {} $in \failed_open_cover_filter_sets<X, I>(S, U)
            by thm failed_open_cover_filter_sets_contains_remainder(X, I, S, U, {})
            obtain n, chosen from exist size N, selection fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, size, selection) $subset {}}
            by thm no_finite_subcover_has_nonempty_remainder(X, I, S, U, n, chosen)
            obtain x from exist point \finite_open_cover_remainder<X, I>(S, U, n, chosen) st {point $in \finite_open_cover_remainder<X, I>(S, U, n, chosen)}
            x $in {}
            impossible x $in {}
    by def:
        ? $is_proper_filter_on(X, \failed_open_cover_filter_sets<X, I>(S, U))

thm failed_open_cover_filter_le_principal:
    ? forall X set, I nonempty_set, S power_set(X), U fn(index I) power_set(X):
        $filter_le(X, \failed_open_cover_filter_sets<X, I>(S, U), \principal_filter_sets<X>(S))
    obtain default_index from exist value I st {value $in I}
    have fn default_choices(k N) I = default_index
    claim:
        ? forall V \principal_filter_sets<X>(S):
            V $in \failed_open_cover_filter_sets<X, I>(S, U)
        by thm principal_filter_sets_contains_base(X, S, V)
        claim:
            ? \finite_open_cover_remainder<X, I>(S, U, 0, default_choices) $subset S
            claim:
                ? forall x \finite_open_cover_remainder<X, I>(S, U, 0, default_choices):
                    x $in S
                by thm finite_open_cover_remainder_contains_avoidance(X, I, S, U, 0, default_choices, x)
            by def:
                ? \finite_open_cover_remainder<X, I>(S, U, 0, default_choices) $subset S
        \finite_open_cover_remainder<X, I>(S, U, 0, default_choices) $subset S $subset V
        witness exist size N, selection fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, size, selection) $subset V} from 0, default_choices
        by def:
            ? $contains_finite_open_remainder(X, I, S, U, V)
        by thm failed_open_cover_filter_sets_member(X, I, S, U, V)
    by def:
        ? \principal_filter_sets<X>(S) $subset \failed_open_cover_filter_sets<X, I>(S, U)
    by def:
        ? $filter_le(X, \failed_open_cover_filter_sets<X, I>(S, U), \principal_filter_sets<X>(S))

thm compact_open_cover_has_finite_subcover_checked:
    ? forall X set, I nonempty_set, T \Topology<X>, S power_set(X), U fn(index I) power_set(X):
        $is_topologically_compact(X, T, S)
        $is_indexed_open_cover(X, I, T, S, U)
        =>:
            $is_finite_indexed_subcover(X, I, S, U)
    by contra:
        ? $is_finite_indexed_subcover(X, I, S, U)
        not $is_finite_indexed_subcover(X, I, S, U)
        by thm failed_open_cover_filter_is_proper(X, I, S, U)
        by thm failed_open_cover_filter_le_principal(X, I, S, U)
        obtain a from exist point S st {$is_cluster_point(X, T, \failed_open_cover_filter_sets<X, I>(S, U), point)}
        obtain cover_index from exist coordinate I st {a $in U(coordinate)}
        U(cover_index) $in T
        claim:
            ? U(cover_index) $in \topological_neighborhood_filter_sets<X>(T, a)
            claim:
                ? $_is_topological_neighborhood(X, T, a, U(cover_index))
                witness exist O T st {a $in O, O $subset U(cover_index)} from U(cover_index)
                by def:
                    ? $_is_topological_neighborhood(X, T, a, U(cover_index))
            by thm topological_neighborhood_filter_sets_member(X, T, a, U(cover_index))
        have fn chosen(k N) I = cover_index
        claim:
            ? \finite_open_cover_remainder<X, I>(S, U, 1, chosen) $in \failed_open_cover_filter_sets<X, I>(S, U)
            \finite_open_cover_remainder<X, I>(S, U, 1, chosen) $subset \finite_open_cover_remainder<X, I>(S, U, 1, chosen)
            witness exist size N, selection fn(slot N) I st {\finite_open_cover_remainder<X, I>(S, U, size, selection) $subset \finite_open_cover_remainder<X, I>(S, U, 1, chosen)} from 1, chosen
            by def:
                ? $contains_finite_open_remainder(X, I, S, U, \finite_open_cover_remainder<X, I>(S, U, 1, chosen))
            by thm failed_open_cover_filter_sets_member(X, I, S, U, \finite_open_cover_remainder<X, I>(S, U, 1, chosen))
        intersect(U(cover_index), \finite_open_cover_remainder<X, I>(S, U, 1, chosen)) != {}
        intersect(U(cover_index), \finite_open_cover_remainder<X, I>(S, U, 1, chosen)) $subset U(cover_index) $subset X
        intersect(U(cover_index), \finite_open_cover_remainder<X, I>(S, U, 1, chosen)) $in power_set(X)
        by thm set_not_empty_implies_nonempty(X, intersect(U(cover_index), \finite_open_cover_remainder<X, I>(S, U, 1, chosen)))
        obtain x from exist point intersect(U(cover_index), \finite_open_cover_remainder<X, I>(S, U, 1, chosen)) st {point $in intersect(U(cover_index), \finite_open_cover_remainder<X, I>(S, U, 1, chosen))}
        x $in U(cover_index)
        by thm finite_open_cover_remainder_contains_avoidance(X, I, S, U, 1, chosen, x)
        0 < 1
        not x $in U(chosen(0))
        chosen(0) = cover_index
        not x $in U(cover_index)
        impossible x $in U(cover_index)

thm compact_open_cover_has_finite_subcover:
    ? forall X set, I nonempty_set, T \Topology<X>, S power_set(X), U fn(index I) power_set(X):
        $is_topologically_compact(X, T, S)
        $is_indexed_open_cover(X, I, T, S, U)
        =>:
            $is_finite_indexed_subcover(X, I, S, U)
    by thm compact_open_cover_has_finite_subcover_checked(X, I, T, S, U)
