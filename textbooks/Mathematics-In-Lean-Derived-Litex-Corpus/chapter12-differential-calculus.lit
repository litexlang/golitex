# Chapter 12 — Differential Calculus
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# Derivative assertions are relations between a function and a candidate
# derivative. Selected derivatives, operator norms, higher derivatives, and
# local inverses require existence and uniqueness results that are not yet
# implemented in this corpus; those source results are recorded in todo.lit.

# ---------------------------------------------------------------------------
# Section 12.1 — Elementary Differential Calculus
# ---------------------------------------------------------------------------

prop derivative_delta_control(f fn(x R) R, x0, L R, epsilon, delta R+):
    forall x R:
        x != x0
        abs(x - x0) < delta
        =>:
            abs((f(x) - f(x0)) / (x - x0) - L) < epsilon

# Source relation `HasDerivAt`.
prop has_derivative_at(f fn(x R) R, x0, L R):
    forall epsilon R+:
        exist delta R+ st {$derivative_delta_control(f, x0, L, epsilon, delta)}

prop is_differentiable_at(f fn(x R) R, x0 R):
    exist L R st {$has_derivative_at(f, x0, L)}

have fn add_real_functions(f, g fn(t R) R, x R) R = f(x) + g(x)

prop is_local_minimum_with_radius(f fn(x R) R, a R, delta R+):
    forall x R:
        abs(x - a) < delta
        =>:
            f(a) <= f(x)

prop is_local_minimum(f fn(x R) R, a R):
    exist delta R+ st {$is_local_minimum_with_radius(f, a, delta)}

have fn closed_interval(a, b R) power_set(R) = {x R: a <= x <= b}
have fn open_interval(a, b R) power_set(R) = {x R: a < x < b}

prop real_continuity_delta_control(f fn(x R) R, a R, epsilon, delta R+):
    forall x R:
        abs(x - a) < delta
        =>:
            abs(f(x) - f(a)) < epsilon

prop is_continuous_at_real(f fn(x R) R, a R):
    forall epsilon R+:
        exist delta R+ st {$real_continuity_delta_control(f, a, epsilon, delta)}

prop is_continuous_on_real_set(S power_set(R), f fn(x R) R):
    forall x S:
        $is_continuous_at_real(f, x)

prop is_differentiable_on_real_set(S power_set(R), f fn(x R) R):
    forall x S:
        $is_differentiable_at(f, x)

# ---------------------------------------------------------------------------
# Section 12.2 — Differential Calculus in Normed Spaces
# ---------------------------------------------------------------------------

prop is_normed_additive_commutative_group(E nonempty_set, add fn(x, y E) E, zero E, neg fn(x E) E, norm fn(x E) R):
    $MILAlternative::chap2_struct::additive_commutative_group_laws(E, add, zero, neg)
    forall x E:
        norm(x) >= 0
    forall x E:
        norm(x) = 0
        =>:
            x = zero
    forall x E:
        x = zero
        =>:
            norm(x) = 0
    forall x, y E:
        norm(add(x, y)) <= norm(x) + norm(y)

prop is_real_normed_space(E nonempty_set, add fn(x, y E) E, zero E, neg fn(x E) E, smul fn(a R, x E) E, norm fn(x E) R):
    $is_normed_additive_commutative_group(E, add, zero, neg, norm)
    forall a, b R, x, y E:
        smul(a + b, x) = add(smul(a, x), smul(b, x))
        smul(a, add(x, y)) = add(smul(a, x), smul(a, y))
        smul(a * b, x) = smul(a, smul(b, x))
        smul(1, x) = x
        norm(smul(a, x)) = abs(a) * norm(x)

struct RealNormedSpace<E nonempty_set>:
    add fn(x, y E) E
    zero E
    neg fn(x E) E
    smul fn(a R, x E) E
    norm fn(x E) R
    <=>:
        $is_real_normed_space(E, add, zero, neg, smul, norm)

setting RealNormedSpaceSetting:
    E nonempty_set
    space &RealNormedSpace<E>

setting RealNormedSpacesSetting:
    E, F nonempty_set
    source &RealNormedSpace<E>
    target &RealNormedSpace<F>

template<E nonempty_set, space &RealNormedSpace<E>>:
    have fn norm_distance(x, y E) R = space.norm(space.add(x, space.neg(y)))

prop norm_is_one_lipschitz(E nonempty_set, space &RealNormedSpace<E>):
    forall x, y E:
        abs(space.norm(x) - space.norm(y)) <= space.norm(space.add(x, space.neg(y)))

# The first six source examples expose the norm laws and induced metric through
# named theorem interfaces instead of requiring clients to unfold the struct.
thm norm_nonnegative:
    ? forall [RealNormedSpaceSetting], x E:
        space.norm(x) >= 0

prop norm_zero_equivalence(E nonempty_set, space &RealNormedSpace<E>, x E):
    not space.norm(x) = 0 or x = space.zero
    not x = space.zero or space.norm(x) = 0

thm norm_eq_zero_iff:
    ? forall [RealNormedSpaceSetting], x E:
        $norm_zero_equivalence(E, space, x)
    by def:
        ? $norm_zero_equivalence(E, space, x)

thm norm_add_le:
    ? forall [RealNormedSpaceSetting], x, y E:
        space.norm(space.add(x, y)) <= space.norm(x) + space.norm(y)

# proof_debt: derive symmetry and the triangle inequality for norm_distance
# from the additive-group laws and norm triangle inequality.
thm norm_distance_is_metric:
    ? forall [RealNormedSpaceSetting]:
        \norm_distance<E, space> $in &MILAlternative::chap2_struct::MetricSpace<E>
    trust \norm_distance<E, space> $in &MILAlternative::chap2_struct::MetricSpace<E>

# proof_debt: apply the reverse-triangle one-Lipschitz estimate to a
# metric-continuous map.
thm norm_of_metric_continuous_map_is_continuous:
    ? forall X set, dist_X &MILAlternative::chap2_struct::MetricSpace<X>, E nonempty_set, space &RealNormedSpace<E>, f fn(point X) E:
        $chap11::is_metric_continuous(X, E, dist_X, \norm_distance<E, space>, f)
        =>:
            $chap11::is_metric_continuous(X, R, dist_X, chap11::real_metric, fn(point X) R {space.norm(f(point))})
    trust $chap11::is_metric_continuous(X, R, dist_X, chap11::real_metric, fn(point X) R {space.norm(f(point))})

thm norm_smul:
    ? forall [RealNormedSpaceSetting], a R, x E:
        space.norm(space.smul(a, x)) = abs(a) * space.norm(x)

# Finite dimensionality is the finite-basis relation developed in Chapter 10.
# An arbitrary injection into finitely many real coordinates is not enough: it
# need not be linear or have a spanning inverse.  The Chapter 10 interface
# keeps the carrier operations and a finite basis visible.

prop is_norm_cauchy_after(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E, epsilon R+, N0 N):
    forall m, n N:
        m >= N0
        n >= N0
        =>:
            space.norm(space.add(u(m), space.neg(u(n)))) < epsilon

prop is_norm_cauchy_sequence(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E):
    forall epsilon R+:
        exist N0 N st {$is_norm_cauchy_after(E, space, u, epsilon, N0)}

prop norm_sequence_close_after(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E, x E, epsilon R+, N0 N):
    forall n N:
        n >= N0
        =>:
            space.norm(space.add(u(n), space.neg(x))) < epsilon

prop norm_sequence_converges(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E, x E):
    forall epsilon R+:
        exist N0 N st {$norm_sequence_close_after(E, space, u, x, epsilon, N0)}

prop is_complete_normed_space(E nonempty_set, space &RealNormedSpace<E>):
    forall u fn(n N) E:
        $is_norm_cauchy_sequence(E, space, u)
        =>:
            exist x E st {$norm_sequence_converges(E, space, u, x)}

prop is_nontrivially_normed_field(K nonempty_set, field &chap10::Field<K>, norm fn(x K) R):
    forall x, y K:
        norm(field.mul(x, y)) = norm(x) * norm(y)
    exist x K st {norm(x) > 1}
    norm(field.one) = 1

thm norm_is_multiplicative_in_normed_field:
    ? forall K nonempty_set, field &chap10::Field<K>, norm fn(x K) R, x, y K:
        $is_nontrivially_normed_field(K, field, norm)
        =>:
            norm(field.mul(x, y)) = norm(x) * norm(y)

thm normed_field_has_element_of_norm_greater_than_one:
    ? forall K nonempty_set, field &chap10::Field<K>, norm fn(x K) R:
        $is_nontrivially_normed_field(K, field, norm)
        =>:
            exist x K st {norm(x) > 1}

# Continuous linear maps are candidate functions satisfying algebraic laws and
# a global operator bound.
prop is_operator_bound(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, CarrierC R):
    CarrierC >= 0
    forall x E:
        target.norm(f(x)) <= CarrierC * source.norm(x)

prop is_real_linear_map(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F):
    forall x, y E:
        f(source.add(x, y)) = target.add(f(x), f(y))
    forall a R, x E:
        f(source.smul(a, x)) = target.smul(a, f(x))

prop is_continuous_real_linear_map(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F):
    $is_real_linear_map(E, F, source, target, f)
    exist CarrierC R st {$is_operator_bound(E, F, source, target, f, CarrierC)}

template<E nonempty_set>:
    have fn identity_map(x E) E = x

# The theorem keeps the identity lambda visible so its algebraic and norm
# calculations are explicit; the named symbolic template also unfolds.
thm identity_is_continuous_linear:
    ? forall [RealNormedSpaceSetting]:
        $is_continuous_real_linear_map(E, E, space, space, fn(x E) E {x})
    forall x, y E:
        (fn(z E) E {z})(space.add(x, y)) = space.add(x, y) = space.add((fn(z E) E {z})(x), (fn(z E) E {z})(y))
    forall a R, x E:
        (fn(z E) E {z})(space.smul(a, x)) = space.smul(a, x) = space.smul(a, (fn(z E) E {z})(x))
    by def:
        ? $is_real_linear_map(E, E, space, space, fn(x E) E {x})
    witness exist CarrierC R st {$is_operator_bound(E, E, space, space, fn(x E) E {x}, CarrierC)} from 1:
        1 >= 0
        forall x E:
            space.norm((fn(z E) E {z})(x)) = space.norm(x) = 1 * space.norm(x)
            space.norm((fn(z E) E {z})(x)) <= 1 * space.norm(x)
        by def:
            ? $is_operator_bound(E, E, space, space, fn(x E) E {x}, 1)
    by def:
        ? $is_continuous_real_linear_map(E, E, space, space, fn(x E) E {x})

# A continuous linear map is already stored as a callable function, so the
# source coercion example needs no separate wrapper.
thm continuous_real_linear_map_is_metric_continuous:
    ? forall [RealNormedSpacesSetting], f fn(input E) F:
        $is_continuous_real_linear_map(E, F, source, target, f)
        =>:
            $chap11::is_metric_continuous(E, F, \norm_distance<E, source>, \norm_distance<F, target>, f)
    trust $chap11::is_metric_continuous(E, F, \norm_distance<E, source>, \norm_distance<F, target>, f)

thm continuous_real_linear_map_add:
    ? forall [RealNormedSpacesSetting], f fn(input E) F, x, y E:
        $is_continuous_real_linear_map(E, F, source, target, f)
        =>:
            f(source.add(x, y)) = target.add(f(x), f(y))

thm continuous_real_linear_map_smul:
    ? forall [RealNormedSpacesSetting], f fn(input E) F, a R, x E:
        $is_continuous_real_linear_map(E, F, source, target, f)
        =>:
            f(source.smul(a, x)) = target.smul(a, f(x))

# The source uses operator norm as a value. Its supremum construction is
# localized debt, while the callable object and characteristic laws are kept.
template<E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(input E) F: $is_continuous_real_linear_map(E, F, source, target, f)>:
    trust have operator_norm R

# proof_debt: prove the supremum upper bound.
thm continuous_linear_map_le_operator_norm:
    ? forall [RealNormedSpacesSetting], f fn(input E) F, x E:
        $is_continuous_real_linear_map(E, F, source, target, f)
        =>:
            target.norm(f(x)) <= \operator_norm<E, F, source, target, f> * source.norm(x)
    trust target.norm(f(x)) <= \operator_norm<E, F, source, target, f> * source.norm(x)

# proof_debt: prove leastness of the selected supremum among nonnegative
# operator bounds.
thm operator_norm_le_bound:
    ? forall [RealNormedSpacesSetting], f fn(input E) F, M R:
        $is_continuous_real_linear_map(E, F, source, target, f)
        M >= 0
        $is_operator_bound(E, F, source, target, f, M)
        =>:
            \operator_norm<E, F, source, target, f> <= M
    trust \operator_norm<E, F, source, target, f> <= M

# The source's Banach–Steinhaus example is specialized here to real normed
# spaces, matching this chapter's existing scalar interface.  A family is
# continuous linear when each indexed function has the displayed laws.
prop is_continuous_real_linear_map_family(Index set, E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F):
    forall j Index:
        $is_continuous_real_linear_map(E, F, source, target, g(j))

# A bound at one source point controls every member of the family there.
prop is_pointwise_bound_for_map_family(Index set, E, F nonempty_set, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F, x E, bound R):
    forall j Index:
        target.norm(g(j)(x)) <= bound

prop is_pointwise_bounded_map_family(Index set, E, F nonempty_set, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F):
    forall x E:
        exist bound R st {$is_pointwise_bound_for_map_family(Index, E, F, target, g, x, bound)}

# This relation keeps the operator-norm side condition adjacent to each
# operator-norm application so its selected value is well-defined.
prop is_uniform_operator_norm_bound(Index set, E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F, bound R):
    forall j Index:
        $is_continuous_real_linear_map(E, F, source, target, g(j))
        \operator_norm<E, F, source, target, g(j)> <= bound

prop is_uniformly_bounded_continuous_linear_map_family(Index set, E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F):
    exist bound R st {$is_uniform_operator_norm_bound(Index, E, F, source, target, g, bound)}

# An operator shell bound controls a continuous linear map on one annulus.
# Mathlib's source proof uses this reusable interface to convert the annular
# estimate into a global operator-norm estimate.
prop is_operator_shell_bound(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, inner_radius, outer_radius, bound R):
    inner_radius > 0
    outer_radius > inner_radius
    bound >= 0
    forall y E:
        inner_radius <= source.norm(y)
        source.norm(y) < outer_radius
        =>:
            target.norm(f(y)) <= bound * source.norm(y)

# proof_debt: scale an arbitrary nonzero vector into the annulus and then use
# linearity and the selected operator norm's least-bound law.
thm operator_norm_le_of_shell:
    ? forall [RealNormedSpacesSetting], f fn(x E) F, inner_radius, outer_radius, bound R:
        $is_continuous_real_linear_map(E, F, source, target, f)
        $is_operator_shell_bound(E, F, source, target, f, inner_radius, outer_radius, bound)
        =>:
            \operator_norm<E, F, source, target, f> <= bound
    trust \operator_norm<E, F, source, target, f> <= bound

# The natural-number level set used by the source proof contains exactly the
# points where the whole family has common bound n.
template<Index set, E, F nonempty_set, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F>:
    have fn pointwise_bound_level_set(n N) power_set(E) = {x E: $is_pointwise_bound_for_map_family(Index, E, F, target, g, x, n)}

# proof_debt: unfold the two Cauchy/convergence presentations and transport
# them along norm_distance.
thm complete_normed_space_is_complete_metric:
    ? forall [RealNormedSpaceSetting]:
        $is_complete_normed_space(E, space)
        =>:
            $chap11::is_complete_metric_space(E, \norm_distance<E, space>)
    trust $chap11::is_complete_metric_space(E, \norm_distance<E, space>)

have fn shell_bound_constant(level N, half R+) R = (level + level) / half

thm shell_bound_constant_eq:
    ? forall level N, half R+:
        shell_bound_constant(level, half) = (level + level) / half

thm shell_bound_constant_nonnegative:
    ? forall level N, half R+:
        shell_bound_constant(level, half) >= 0
    shell_bound_constant(level, half) = (level + level) / half
    level + level >= 0
    half > 0
    (level + level) / half >= 0

# The ball obtained from Baire contains both the center and every translate
# center + y with norm(y) < epsilon.  Linearity and the triangle inequality
# then give the common bound level + level on the outer ball.  The remaining
# displayed calculation is the checked annular rescaling inequality.
thm pointwise_bound_ball_gives_shell_bound:
    ? forall Index set, E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F, level N, center E, epsilon R+, j Index:
        $is_continuous_real_linear_map(E, F, source, target, g(j))
        \chap11::metric_ball<E, \norm_distance<E, source>>(center, epsilon) $subset \pointwise_bound_level_set<Index, E, F, target, g>(level)
        =>:
            $is_operator_shell_bound(E, F, source, target, g(j), epsilon / 2, epsilon, shell_bound_constant(level, epsilon / 2))
    epsilon / 2 > 0
    epsilon / 2 != 0
    epsilon > epsilon / 2
    by thm shell_bound_constant_eq(level, epsilon / 2)
    by thm shell_bound_constant_nonnegative(level, epsilon / 2)
    # proof_debt: formalize the translation identity
    # g(y) = g(center + y) - g(center), including norm invariance under
    # additive inverse, from the current flat real-normed-space laws.
    trust forall y E:
        epsilon / 2 <= source.norm(y)
        source.norm(y) < epsilon
        =>:
            target.norm(g(j)(y)) <= level + level
    forall y E:
        epsilon / 2 <= source.norm(y)
        source.norm(y) < epsilon
        =>:
            target.norm(g(j)(y)) <= level + level
            shell_bound_constant(level, epsilon / 2) * (epsilon / 2) <= shell_bound_constant(level, epsilon / 2) * source.norm(y)
            shell_bound_constant(level, epsilon / 2) * (epsilon / 2) = level + level
            level + level <= shell_bound_constant(level, epsilon / 2) * source.norm(y)
            target.norm(g(j)(y)) <= shell_bound_constant(level, epsilon / 2) * source.norm(y)
    by def:
        ? $is_operator_shell_bound(E, F, source, target, g(j), epsilon / 2, epsilon, shell_bound_constant(level, epsilon / 2))

# Banach–Steinhaus (uniform boundedness principle), in the real-scalar
# specialization supported by this chapter.  Pointwise boundedness produces a
# countable closed cover; Baire supplies one level set containing a ball; the
# checked shell calculation above then gives one operator-norm bound for every
# member of the family.
thm banach_steinhaus:
    ? forall Index set, E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, g fn(index Index) fn(x E) F:
        $is_continuous_real_linear_map_family(Index, E, F, source, target, g)
        $is_pointwise_bounded_map_family(Index, E, F, target, g)
        $is_complete_normed_space(E, source)
        =>:
            $is_uniformly_bounded_continuous_linear_map_family(Index, E, F, source, target, g)
    # proof_debt: arbitrary intersections of inverse images of closed real
    # rays are closed for continuous maps.
    trust forall n N:
        $chap11::is_metric_closed(E, \norm_distance<E, source>, \pointwise_bound_level_set<Index, E, F, target, g>(n))
    # proof_debt: choose a natural number above the pointwise real bound.
    trust forall x E:
        exist n N st {x $in \pointwise_bound_level_set<Index, E, F, target, g>(n)}
    by thm complete_normed_space_is_complete_metric(E, source)
    by thm chap11::complete_metric_closed_cover_has_ball(E, \norm_distance<E, source>, \pointwise_bound_level_set<Index, E, F, target, g>)
    obtain level, center, epsilon from exist k N, c E, r R+ st {\chap11::metric_ball<E, \norm_distance<E, source>>(c, r) $subset \pointwise_bound_level_set<Index, E, F, target, g>(k)}
    witness exist bound R st {$is_uniform_operator_norm_bound(Index, E, F, source, target, g, bound)} from shell_bound_constant(level, epsilon / 2):
        claim:
            ? forall j Index:
                $is_continuous_real_linear_map(E, F, source, target, g(j))
                \operator_norm<E, F, source, target, g(j)> <= shell_bound_constant(level, epsilon / 2)
            $is_continuous_real_linear_map(E, F, source, target, g(j))
            by thm pointwise_bound_ball_gives_shell_bound(Index, E, F, source, target, g, level, center, epsilon, j)
            by thm operator_norm_le_of_shell(E, F, source, target, g(j), epsilon / 2, epsilon, shell_bound_constant(level, epsilon / 2))
        by def:
            ? $is_uniform_operator_norm_bound(Index, E, F, source, target, g, shell_bound_constant(level, epsilon / 2))
    by def:
        ? $is_uniformly_bounded_continuous_linear_map_family(Index, E, F, source, target, g)

# Asymptotic relations are genuine properties of candidate functions and a
# filter, not selected functions.
prop is_big_o_with(A set, E, F nonempty_set, filter power_set(power_set(A)), source &RealNormedSpace<E>, target &RealNormedSpace<F>, c R, f fn(a A) E, g fn(a A) F):
    {a A: source.norm(f(a)) <= c * target.norm(g(a))} $in filter

prop is_big_o(A set, E, F nonempty_set, filter power_set(power_set(A)), source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(a A) E, g fn(a A) F):
    exist c R st {$is_big_o_with(A, E, F, filter, source, target, c, f, g)}

prop is_little_o(A set, E, F nonempty_set, filter power_set(power_set(A)), source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(a A) E, g fn(a A) F):
    forall c R+:
        $is_big_o_with(A, E, F, filter, source, target, c, f, g)

prop is_asymptotically_equivalent(A set, E nonempty_set, filter power_set(power_set(A)), space &RealNormedSpace<E>, f, g fn(a A) E):
    $is_little_o(A, E, E, filter, space, space, fn(a A) E {space.add(f(a), space.neg(g(a)))}, g)

# Fréchet derivative relation: the candidate derivative is required to be a
# continuous real-linear map and its remainder is little compared with the
# displacement.
prop frechet_remainder_delta_control(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E, epsilon, delta R+):
    forall x E:
        source.norm(source.add(x, source.neg(x0))) < delta
        =>:
            target.norm(target.add(target.add(f(x), target.neg(f(x0))), target.neg(fprime(source.add(x, source.neg(x0)))))) <= epsilon * source.norm(source.add(x, source.neg(x0)))

prop has_frechet_derivative_at(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E):
    $is_continuous_real_linear_map(E, F, source, target, fprime)
    forall epsilon R+:
        exist delta R+ st {$frechet_remainder_delta_control(E, F, source, target, f, fprime, x0, epsilon, delta)}

# The source's total `fderiv` is a selected callable linear candidate. Its
# construction and default value outside differentiability remain proof debt.
template<E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(input E) F, x0 E>:
    trust have selected_frechet_derivative fn(delta E) F

# proof_debt: uniqueness of Fréchet derivatives identifies the selected value.
thm selected_frechet_derivative_eq:
    ? forall [RealNormedSpacesSetting], f fn(input E) F, fprime fn(delta E) F, x0 E:
        $has_frechet_derivative_at(E, F, source, target, f, fprime, x0)
        =>:
            \selected_frechet_derivative<E, F, source, target, f, x0> = fprime
    trust \selected_frechet_derivative<E, F, source, target, f, x0> = fprime

prop strict_frechet_delta_control(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E, epsilon, delta R+):
    forall x, y E:
        source.norm(source.add(x, source.neg(x0))) < delta
        source.norm(source.add(y, source.neg(x0))) < delta
        =>:
            target.norm(target.add(target.add(f(y), target.neg(f(x))), target.neg(fprime(source.add(y, source.neg(x)))))) <= epsilon * source.norm(source.add(y, source.neg(x)))

prop has_strict_frechet_derivative_at(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E):
    $is_continuous_real_linear_map(E, F, source, target, fprime)
    forall epsilon R+:
        exist delta R+ st {$strict_frechet_delta_control(E, F, source, target, f, fprime, x0, epsilon, delta)}

# A local-inverse derivative is a continuous linear equivalence, not merely a
# pair of inverse functions.  Both directions retain their linear and norm
# control hypotheses, then the two inverse equations state bijectivity.
prop is_continuous_real_linear_equivalence(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, forward fn(x E) F, inverse fn(y F) E):
    $is_continuous_real_linear_map(E, F, source, target, forward)
    $is_continuous_real_linear_map(F, E, target, source, inverse)
    forall x E:
        inverse(forward(x)) = x
    forall y F:
        forward(inverse(y)) = y

struct ContinuousRealLinearEquiv<E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>>:
    forward fn(x E) F
    inverse fn(y F) E
    <=>:
        $is_continuous_real_linear_equivalence(E, F, source, target, forward, inverse)

prop near_point_subset(E nonempty_set, space &RealNormedSpace<E>, a E, P power_set(E), delta R+):
    forall x E:
        space.norm(space.add(x, space.neg(a))) < delta
        =>:
            x $in P

prop eventually_near_point(E nonempty_set, space &RealNormedSpace<E>, a E, P power_set(E)):
    exist delta R+ st {$near_point_subset(E, space, a, P, delta)}

# ---------------------------------------------------------------------------
# Resumed MIL C12 S01 source slice
# ---------------------------------------------------------------------------

# Source-library objects needed by the elementary examples.
# proof_debt: construct sine, pi, and the total derivative selector from a
# real-analysis library and replace these three object-level assumptions.
trust have real_sine fn(x R) R
trust have real_pi R
trust have real_deriv fn(f fn(argument R) R, point R) R

have fn real_fifth_power(x R) R = x^5

# MIL30 ITEM 16 — sine has derivative one at zero.
# proof_debt: the sine epsilon proof belongs to the missing real-analysis
# library.
thm real_sine_has_derivative_one_at_zero:
    ? forall marker {0}:
        $has_derivative_at(real_sine, 0, 1)
    trust $has_derivative_at(real_sine, 0, 1)

# MIL30 ITEM 17 — sine is differentiable at every real point.
# proof_debt: derivative of sine at an arbitrary point.
thm real_sine_differentiable_everywhere:
    ? forall x R:
        $is_differentiable_at(real_sine, x)
    trust $is_differentiable_at(real_sine, x)

# MIL30 ITEM 18 — a candidate derivative is the selected derivative.
# proof_debt: uniqueness of the epsilon-defined derivative and construction of
# the total selector.
thm real_deriv_eq_of_has_derivative:
    ? forall f fn(x R) R, x, L R:
        $has_derivative_at(f, x, L)
        =>:
            real_deriv(f, x) = L
    trust real_deriv(f, x) = L

# MIL30 ITEM 19 — the selected derivative is zero at a nondifferentiable point.
# proof_debt: characteristic law of the total derivative selector.
thm real_deriv_zero_of_not_differentiable:
    ? forall f fn(x R) R, x R:
        not $is_differentiable_at(f, x)
        =>:
            real_deriv(f, x) = 0
    trust real_deriv(f, x) = 0

# MIL30 ITEM 20 — derivative of a sum.
# proof_debt: epsilon proof for addition and the selected-derivative laws.
thm real_deriv_add:
    ? forall f, g fn(t R) R, x R:
        $is_differentiable_at(f, x)
        $is_differentiable_at(g, x)
        =>:
            real_deriv(fn(t R) R {f(t) + g(t)}, x) = real_deriv(f, x) + real_deriv(g, x)
    trust real_deriv(fn(t R) R {f(t) + g(t)}, x) = real_deriv(f, x) + real_deriv(g, x)

# MIL30 ITEM 21 — derivative vanishes at a local minimum.
# proof_debt: compare the two one-sided difference quotients.
thm local_minimum_real_deriv_zero:
    ? forall f fn(x R) R, a R:
        $is_local_minimum(f, a)
        =>:
            real_deriv(f, a) = 0
    trust real_deriv(f, a) = 0

# MIL30 ITEM 22 — Rolle's theorem.
# proof_debt: extreme-value theorem plus the local-minimum derivative result.
thm rolle:
    ? forall f fn(x R) R, a, b R:
        a < b
        $is_continuous_on_real_set(closed_interval(a, b), f)
        f(a) = f(b)
        =>:
            exist c open_interval(a, b) st {real_deriv(f, c) = 0}
    trust exist c open_interval(a, b) st {real_deriv(f, c) = 0}

# MIL30 ITEM 23 — mean value theorem.
# proof_debt: apply Rolle to the source auxiliary secant-line function.
thm mean_value:
    ? forall f fn(x R) R, a, b R:
        a < b
        b - a != 0
        $is_continuous_on_real_set(closed_interval(a, b), f)
        $is_differentiable_on_real_set(open_interval(a, b), f)
        =>:
            exist c open_interval(a, b) st {real_deriv(f, c) = (f(b) - f(a)) / (b - a)}
    trust exist c open_interval(a, b) st {real_deriv(f, c) = (f(b) - f(a)) / (b - a)}

# MIL30 ITEM 24 — derivative of x^5 at six.
# proof_debt: power rule for the selected derivative.
thm real_fifth_power_deriv_at_six:
    ? forall marker {0}:
        real_deriv(real_fifth_power, 6) = 5 * 6^4
    trust real_deriv(real_fifth_power, 6) = 5 * 6^4

# MIL30 ITEM 25 — derivative of sine at pi.
# proof_debt: sine/cosine derivative and the value cos(pi) = -1.
thm real_sine_deriv_at_pi:
    ? forall marker {0}:
        real_deriv(real_sine, real_pi) = -1
    trust real_deriv(real_sine, real_pi) = -1
