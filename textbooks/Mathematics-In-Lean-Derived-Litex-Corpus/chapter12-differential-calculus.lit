# Chapter 12 — Differential Calculus
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# Derivative assertions are relations between a function and a candidate
# derivative. Selected derivatives, operator norms, higher derivatives, and
# local inverses require existence and uniqueness results that are not yet
# implemented in this corpus; those source results are recorded in todo.lit.

# ---------------------------------------------------------------------------
# Section 12.1 — Elementary Differential Calculus
# ---------------------------------------------------------------------------

prop derivative_delta_control(f fn(x R) R, x0, L R, epsilon, delta R_pos):
    forall x R:
        x != x0
        abs(x - x0) < delta
        =>:
            abs((f(x) - f(x0)) / (x - x0) - L) < epsilon

# Source relation `HasDerivAt`.
prop has_derivative_at(f fn(x R) R, x0, L R):
    forall epsilon R_pos:
        exist delta R_pos st {$derivative_delta_control(f, x0, L, epsilon, delta)}

prop is_differentiable_at(f fn(x R) R, x0 R):
    exist L R st {$has_derivative_at(f, x0, L)}

have fn add_real_functions(f, g fn(t R) R, x R) R = f(x) + g(x)

prop is_local_minimum_with_radius(f fn(x R) R, a R, delta R_pos):
    forall x R:
        abs(x - a) < delta
        =>:
            f(a) <= f(x)

prop is_local_minimum(f fn(x R) R, a R):
    exist delta R_pos st {$is_local_minimum_with_radius(f, a, delta)}

have fn closed_interval(a, b R) power_set(R) = {x R: a <= x <= b}
have fn open_interval(a, b R) power_set(R) = {x R: a < x < b}

prop real_continuity_delta_control(f fn(x R) R, a R, epsilon, delta R_pos):
    forall x R:
        abs(x - a) < delta
        =>:
            abs(f(x) - f(a)) < epsilon

prop is_continuous_at_real(f fn(x R) R, a R):
    forall epsilon R_pos:
        exist delta R_pos st {$real_continuity_delta_control(f, a, epsilon, delta)}

prop is_continuous_on_real_set(S power_set(R), f fn(x R) R):
    forall x S:
        $is_continuous_at_real(f, x)

prop is_differentiable_on_real_set(S power_set(R), f fn(x R) R):
    forall x S:
        $is_differentiable_at(f, x)

# ---------------------------------------------------------------------------
# Section 12.2 — Differential Calculus in Normed Spaces
# ---------------------------------------------------------------------------

prop is_normed_additive_commutative_group(E nonempty_set, add fn(x, y E) E, zero E, neg fn(x E) E, norm fn(x E) R):
    $chap2::is_additive_commutative_group(E, add, zero, neg)
    forall x E:
        norm(x) >= 0
    forall x E:
        norm(x) = 0
        =>:
            x = zero
    forall x E:
        x = zero
        =>:
            norm(x) = 0
    forall x, y E:
        norm(add(x, y)) <= norm(x) + norm(y)

prop is_real_normed_space(E nonempty_set, add fn(x, y E) E, zero E, neg fn(x E) E, smul fn(a R, x E) E, norm fn(x E) R):
    $is_normed_additive_commutative_group(E, add, zero, neg, norm)
    forall a, b R, x, y E:
        smul(a + b, x) = add(smul(a, x), smul(b, x))
        smul(a, add(x, y)) = add(smul(a, x), smul(a, y))
        smul(a * b, x) = smul(a, smul(b, x))
        smul(1, x) = x
        norm(smul(a, x)) = abs(a) * norm(x)

struct RealNormedSpace<E nonempty_set>:
    add fn(x, y E) E
    zero E
    neg fn(x E) E
    smul fn(a R, x E) E
    norm fn(x E) R
    <=>:
        $is_real_normed_space(E, add, zero, neg, smul, norm)

template<E nonempty_set, space &RealNormedSpace<E>>:
    have fn norm_distance(x, y E) R = space.norm(space.add(x, space.neg(y)))

prop norm_is_one_lipschitz(E nonempty_set, space &RealNormedSpace<E>):
    forall x, y E:
        abs(space.norm(x) - space.norm(y)) <= space.norm(space.add(x, space.neg(y)))

# Finite dimensionality is the finite-basis relation developed in Chapter 10.
# An arbitrary injection into finitely many real coordinates is not enough: it
# need not be linear or have a spanning inverse.  The Chapter 10 interface
# keeps the carrier operations and a finite basis visible.

prop is_norm_cauchy_after(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E, epsilon R_pos, N0 N):
    forall m, n N:
        m >= N0
        n >= N0
        =>:
            space.norm(space.add(u(m), space.neg(u(n)))) < epsilon

prop is_norm_cauchy_sequence(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E):
    forall epsilon R_pos:
        exist N0 N st {$is_norm_cauchy_after(E, space, u, epsilon, N0)}

prop norm_sequence_close_after(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E, x E, epsilon R_pos, N0 N):
    forall n N:
        n >= N0
        =>:
            space.norm(space.add(u(n), space.neg(x))) < epsilon

prop norm_sequence_converges(E nonempty_set, space &RealNormedSpace<E>, u fn(n N) E, x E):
    forall epsilon R_pos:
        exist N0 N st {$norm_sequence_close_after(E, space, u, x, epsilon, N0)}

prop is_complete_normed_space(E nonempty_set, space &RealNormedSpace<E>):
    forall u fn(n N) E:
        $is_norm_cauchy_sequence(E, space, u)
        =>:
            exist x E st {$norm_sequence_converges(E, space, u, x)}

prop is_nontrivially_normed_field(K nonempty_set, field &chap10::Field<K>, norm fn(x K) R):
    forall x, y K:
        norm(field.mul(x, y)) = norm(x) * norm(y)
    exist x K st {norm(x) > 1}
    norm(field.one) = 1

thm norm_is_multiplicative_in_normed_field:
    ? forall K nonempty_set, field &chap10::Field<K>, norm fn(x K) R, x, y K:
        $is_nontrivially_normed_field(K, field, norm)
        =>:
            norm(field.mul(x, y)) = norm(x) * norm(y)
    norm(field.mul(x, y)) = norm(x) * norm(y)

thm normed_field_has_element_of_norm_greater_than_one:
    ? forall K nonempty_set, field &chap10::Field<K>, norm fn(x K) R:
        $is_nontrivially_normed_field(K, field, norm)
        =>:
            exist x K st {norm(x) > 1}
    exist x K st {norm(x) > 1}

# Continuous linear maps are candidate functions satisfying algebraic laws and
# a global operator bound.
prop is_operator_bound(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, C R):
    C >= 0
    forall x E:
        target.norm(f(x)) <= C * source.norm(x)

prop is_real_linear_map(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F):
    forall x, y E:
        f(source.add(x, y)) = target.add(f(x), f(y))
    forall a R, x E:
        f(source.smul(a, x)) = target.smul(a, f(x))

prop is_continuous_real_linear_map(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F):
    $is_real_linear_map(E, F, source, target, f)
    exist C R st {$is_operator_bound(E, F, source, target, f, C)}

template<E nonempty_set>:
    have fn identity_map(x E) E = x

# The theorem keeps the identity lambda visible so its algebraic and norm
# calculations are explicit; the named symbolic template also unfolds.
thm identity_is_continuous_linear:
    ? forall E nonempty_set, space &RealNormedSpace<E>:
        $is_continuous_real_linear_map(E, E, space, space, fn(x E) E {x})
    forall x, y E:
        (fn(z E) E {z})(space.add(x, y)) = space.add(x, y) = space.add((fn(z E) E {z})(x), (fn(z E) E {z})(y))
    forall a R, x E:
        (fn(z E) E {z})(space.smul(a, x)) = space.smul(a, x) = space.smul(a, (fn(z E) E {z})(x))
    witness exist C R st {$is_operator_bound(E, E, space, space, fn(x E) E {x}, C)} from 1:
        1 >= 0
        forall x E:
            space.norm((fn(z E) E {z})(x)) = space.norm(x) = 1 * space.norm(x)
            space.norm((fn(z E) E {z})(x)) <= 1 * space.norm(x)
        by def $is_operator_bound(E, E, space, space, fn(x E) E {x}, 1)
    by def $is_continuous_real_linear_map(E, E, space, space, fn(x E) E {x})

# Asymptotic relations are genuine properties of candidate functions and a
# filter, not selected functions.
prop is_big_o_with(A set, E, F nonempty_set, filter power_set(power_set(A)), source &RealNormedSpace<E>, target &RealNormedSpace<F>, c R, f fn(a A) E, g fn(a A) F):
    {a A: source.norm(f(a)) <= c * target.norm(g(a))} $in filter

prop is_big_o(A set, E, F nonempty_set, filter power_set(power_set(A)), source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(a A) E, g fn(a A) F):
    exist c R st {$is_big_o_with(A, E, F, filter, source, target, c, f, g)}

prop is_little_o(A set, E, F nonempty_set, filter power_set(power_set(A)), source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(a A) E, g fn(a A) F):
    forall c R_pos:
        $is_big_o_with(A, E, F, filter, source, target, c, f, g)

prop is_asymptotically_equivalent(A set, E nonempty_set, filter power_set(power_set(A)), space &RealNormedSpace<E>, f, g fn(a A) E):
    $is_little_o(A, E, E, filter, space, space, fn(a A) E {space.add(f(a), space.neg(g(a)))}, g)

# Fréchet derivative relation: the candidate derivative is required to be a
# continuous real-linear map and its remainder is little compared with the
# displacement.
prop frechet_remainder_delta_control(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E, epsilon, delta R_pos):
    forall x E:
        source.norm(source.add(x, source.neg(x0))) < delta
        =>:
            target.norm(target.add(target.add(f(x), target.neg(f(x0))), target.neg(fprime(source.add(x, source.neg(x0)))))) <= epsilon * source.norm(source.add(x, source.neg(x0)))

prop has_frechet_derivative_at(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E):
    $is_continuous_real_linear_map(E, F, source, target, fprime)
    forall epsilon R_pos:
        exist delta R_pos st {$frechet_remainder_delta_control(E, F, source, target, f, fprime, x0, epsilon, delta)}

prop strict_frechet_delta_control(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E, epsilon, delta R_pos):
    forall x, y E:
        source.norm(source.add(x, source.neg(x0))) < delta
        source.norm(source.add(y, source.neg(x0))) < delta
        =>:
            target.norm(target.add(target.add(f(y), target.neg(f(x))), target.neg(fprime(source.add(y, source.neg(x)))))) <= epsilon * source.norm(source.add(y, source.neg(x)))

prop has_strict_frechet_derivative_at(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, f fn(x E) F, fprime fn(x E) F, x0 E):
    $is_continuous_real_linear_map(E, F, source, target, fprime)
    forall epsilon R_pos:
        exist delta R_pos st {$strict_frechet_delta_control(E, F, source, target, f, fprime, x0, epsilon, delta)}

# A local-inverse derivative is a continuous linear equivalence, not merely a
# pair of inverse functions.  Both directions retain their linear and norm
# control hypotheses, then the two inverse equations state bijectivity.
prop is_continuous_real_linear_equivalence(E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>, forward fn(x E) F, inverse fn(y F) E):
    $is_continuous_real_linear_map(E, F, source, target, forward)
    $is_continuous_real_linear_map(F, E, target, source, inverse)
    forall x E:
        inverse(forward(x)) = x
    forall y F:
        forward(inverse(y)) = y

struct ContinuousRealLinearEquiv<E, F nonempty_set, source &RealNormedSpace<E>, target &RealNormedSpace<F>>:
    forward fn(x E) F
    inverse fn(y F) E
    <=>:
        $is_continuous_real_linear_equivalence(E, F, source, target, forward, inverse)

prop near_point_subset(E nonempty_set, space &RealNormedSpace<E>, a E, P power_set(E), delta R_pos):
    forall x E:
        space.norm(space.add(x, space.neg(a))) < delta
        =>:
            x $in P

prop eventually_near_point(E nonempty_set, space &RealNormedSpace<E>, a E, P power_set(E)):
    exist delta R_pos st {$near_point_subset(E, space, a, P, delta)}
