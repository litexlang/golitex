# Chapter 8 — Hierarchies
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter translates mathematical interfaces, not Lean's elaborator
# mechanics. Repeated class-extension, coercion, outParam, and to_additive
# presentations are collapsed when they expose the same data and laws. Actual
# structures remain records or sets of callable maps; only properties of
# explicit candidates are props. The source's order hierarchy and
# order-preserving-hom presentation variants are outside this core slice.

# 8.1 Basics

# One1/One2 and Dia1 are one-field carrier-dependent interfaces. Their data are
# preserved below as the `one` and `mul` fields of actual Monoid/Group records;
# no one-field object is misrepresented as a proposition.
prop is_semigroup(s nonempty_set, mul fn(x, y s) s):
    forall x, y, z s:
        mul(mul(x, y), z) = mul(x, mul(y, z))

struct Monoid<s nonempty_set>:
    mul fn(x, y s) s
    one s
    <=>:
        $is_semigroup(s, mul)
        forall x s:
            mul(one, x) = x
        forall x s:
            mul(x, one) = x

# This source hierarchy assumes both identity directions as primitive laws,
# unlike Chapter 2's left-facing canonical Group interface.
struct TwoSidedGroup<s nonempty_set>:
    mul fn(x, y s) s
    one s
    inv fn(x s) s
    <=>:
        $is_semigroup(s, mul)
        forall x s:
            mul(one, x) = x
        forall x s:
            mul(x, one) = x
        forall x s:
            mul(inv(x), x) = one

# Source lemma left_inv_eq_right_inv1.
thm monoid_left_inverse_unique:
    ? forall s nonempty_set, monoid &Monoid<s>, a, b, c s:
        monoid.mul(b, a) = monoid.one
        monoid.mul(a, c) = monoid.one
        =>:
            b = c
    b = monoid.mul(b, monoid.one) = monoid.mul(b, monoid.mul(a, c)) = monoid.mul(monoid.mul(b, a), c) = monoid.mul(monoid.one, c) = c

# Source lemma inv_eq_of_dia.
thm group_inverse_eq_of_right_inverse:
    ? forall s nonempty_set, group &TwoSidedGroup<s>, a, b s:
        group.mul(a, b) = group.one
        =>:
            group.inv(a) = b
    group.mul(group.inv(a), a) = group.one
    group.inv(a) = group.mul(group.inv(a), group.one) = group.mul(group.inv(a), group.mul(a, b)) = group.mul(group.mul(group.inv(a), a), b) = group.mul(group.one, b) = b

# Source lemma dia_inv. It is a fact about every Group object, not a new prop.
thm group_right_inverse:
    ? forall s nonempty_set, group &TwoSidedGroup<s>, a s:
        group.mul(a, group.inv(a)) = group.one
    release thm group_inverse_eq_of_right_inverse(s, group, group.inv(a), a)
    group.inv(group.inv(a)) = a
    group.mul(group.inv(group.inv(a)), group.inv(a)) = group.one
    group.mul(a, group.inv(a)) = group.mul(group.inv(group.inv(a)), group.inv(a)) = group.one

# AddSemigroup3 through AddCommGroup3 are the additive branch of the hierarchy.
struct AdditiveMonoid<s nonempty_set>:
    add fn(x, y s) s
    zero s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
        forall x s:
            add(x, zero) = x

struct AdditiveGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
        forall x s:
            add(x, zero) = x
        forall x s:
            add(neg(x), x) = zero

prop is_additive_commutative_group(s nonempty_set, add fn(x, y s) s, zero s, neg fn(x s) s):
    forall x, y, z s:
        add(add(x, y), z) = add(x, add(y, z))
    forall x, y s:
        add(x, y) = add(y, x)
    forall x s:
        add(zero, x) = x
    forall x s:
        add(x, zero) = x
    forall x s:
        add(neg(x), x) = zero

struct AdditiveCommutativeGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        $is_additive_commutative_group(s, add, zero, neg)

# Source instance: every Ring3 has commutative addition. Chapter 2's canonical
# Ring already exposes this law through its flat additive-group interface.
thm ring_add_comm:
    ? forall Carrier nonempty_set, ring &chap2::Ring<Carrier>, x, y Carrier:
        ring.add(x, y) = ring.add(y, x)

# Source instance Ring₃ ℤ. Chapter 2 owns the canonical flat Ring interface,
# so this hierarchy example constructs that record instead of redeclaring it.
thm integer_ring_laws:
    ? forall anchor {0}:
        $chap2::ring_laws(Z, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1)
    claim:
        ? forall x, y, z Z:
            fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
            fn(a, b Z) Z {a + b}(x, y) = fn(a, b Z) Z {a + b}(y, x)
        fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = (x + y) + z = x + (y + z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
        fn(a, b Z) Z {a + b}(x, y) = x + y = y + x = fn(a, b Z) Z {a + b}(y, x)
    claim:
        ? forall x Z:
            fn(a, b Z) Z {a + b}(0, x) = x
            fn(a, b Z) Z {a + b}(x, 0) = x
            fn(a Z) Z {(-a)}(x) + x = 0
        fn(a, b Z) Z {a + b}(0, x) = 0 + x = x
        fn(a, b Z) Z {a + b}(x, 0) = x + 0 = x
        fn(a Z) Z {(-a)}(x) + x = (-x) + x = 0
    by def:
        ? $chap2::additive_commutative_group_laws(Z, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)})
    claim:
        ? forall x, y, z Z:
            fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a * b}(x, y), z) = fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a * b}(y, z))
            fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a + b}(y, z)) = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, y), fn(a, b Z) Z {a * b}(x, z))
            fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a + b}(x, y), z) = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, z), fn(a, b Z) Z {a * b}(y, z))
        fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a * b}(x, y), z) = (x * y) * z = x * (y * z) = fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a * b}(y, z))
        fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a + b}(y, z)) = x * (y + z) = x * y + x * z = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, y), fn(a, b Z) Z {a * b}(x, z))
        fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a + b}(x, y), z) = (x + y) * z = x * z + y * z = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, z), fn(a, b Z) Z {a * b}(y, z))
    claim:
        ? forall x Z:
            fn(a, b Z) Z {a * b}(1, x) = x
            fn(a, b Z) Z {a * b}(x, 1) = x
        fn(a, b Z) Z {a * b}(1, x) = 1 * x = x
        fn(a, b Z) Z {a * b}(x, 1) = x * 1 = x
    by def:
        ? $chap2::ring_laws(Z, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1)

release thm integer_ring_laws(0)
release thm fn_set_member(fn(x, y Z) Z {x + y}, fn(x, y Z) Z)
0 $in Z
release thm fn_set_member(fn(x Z) Z {(-x)}, fn(x Z) Z)
release thm fn_set_member(fn(x, y Z) Z {x * y}, fn(x, y Z) Z)
1 $in Z
release thm cart_member_from_coordinates((fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1), cart(fn(x, y Z) Z, Z, fn(x Z) Z, fn(x, y Z) Z, Z))
release thm struct_member((fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1), &chap2::Ring<Z>)
have integer_ring &chap2::Ring<Z> = (fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1)

# The source's LE1/Preorder1/PartialOrder1/OrderedCommMonoid1 block is an
# alternate hierarchy presentation and is outside this core slice.

prop is_module(Scalar, M nonempty_set, scalar_add fn(x, y Scalar) Scalar, scalar_zero Scalar, scalar_neg fn(x Scalar) Scalar, scalar_mul fn(x, y Scalar) Scalar, scalar_one Scalar, add fn(x, y M) M, zero M, neg fn(x M) M, smul fn(r Scalar, m M) M):
    $chap2::ring_laws(Scalar, scalar_add, scalar_zero, scalar_neg, scalar_mul, scalar_one)
    $is_additive_commutative_group(M, add, zero, neg)
    forall m M:
        smul(scalar_zero, m) = zero
    forall m M:
        smul(scalar_one, m) = m
    forall a, b Scalar, m M:
        smul(scalar_mul(a, b), m) = smul(a, smul(b, m))
    forall a, b Scalar, m M:
        smul(scalar_add(a, b), m) = add(smul(a, m), smul(b, m))
    forall a Scalar, m, n M:
        smul(a, add(m, n)) = add(smul(a, m), smul(a, n))

struct Module<Scalar, M nonempty_set>:
    scalar_add fn(x, y Scalar) Scalar
    scalar_zero Scalar
    scalar_neg fn(x Scalar) Scalar
    scalar_mul fn(x, y Scalar) Scalar
    scalar_one Scalar
    add fn(x, y M) M
    zero M
    neg fn(x M) M
    smul fn(r Scalar, m M) M
    <=>:
        $is_module(Scalar, M, scalar_add, scalar_zero, scalar_neg, scalar_mul, scalar_one, add, zero, neg, smul)

# Source selfModule and abGrpModule. Both objects below are transparent:
# the generic natural action is recursive, the integer action uses native abs,
# and every structure law is proved from the stored additive-group/ring laws.

claim:
    ? forall Carrier nonempty_set, ring &chap2::Ring<Carrier>:
        (ring.add, ring.zero, ring.neg, ring.mul, ring.one, ring.add, ring.zero, ring.neg, ring.mul) $in &Module<Carrier, Carrier>
    $chap2::ring_laws(Carrier, ring.add, ring.zero, ring.neg, ring.mul, ring.one)
    claim:
        ? $is_additive_commutative_group(Carrier, ring.add, ring.zero, ring.neg)
        claim:
            ? forall x, y, z Carrier:
                ring.add(ring.add(x, y), z) = ring.add(x, ring.add(y, z))
            ring.add(ring.add(x, y), z) = ring.add(x, ring.add(y, z))
        claim:
            ? forall x, y Carrier:
                ring.add(x, y) = ring.add(y, x)
            ring.add(x, y) = ring.add(y, x)
        claim:
            ? forall x Carrier:
                ring.add(ring.zero, x) = x
                ring.add(x, ring.zero) = x
                ring.add(ring.neg(x), x) = ring.zero
            ring.add(ring.zero, x) = x
            ring.add(x, ring.zero) = ring.add(ring.zero, x) = x
            ring.add(ring.neg(x), x) = ring.zero
        by def $is_additive_commutative_group(Carrier, ring.add, ring.zero, ring.neg)
    claim:
        ? forall m Carrier:
            ring.mul(ring.zero, m) = ring.zero
            ring.mul(ring.one, m) = m
        release thm chap2::zero_mul_structure(Carrier, ring.add, ring.zero, ring.neg, ring.mul, ring.one, m)
        ring.mul(ring.zero, m) = ring.zero
        ring.mul(ring.one, m) = m
    claim:
        ? forall a, b Carrier, m Carrier:
            ring.mul(ring.mul(a, b), m) = ring.mul(a, ring.mul(b, m))
            ring.mul(ring.add(a, b), m) = ring.add(ring.mul(a, m), ring.mul(b, m))
        ring.mul(ring.mul(a, b), m) = ring.mul(a, ring.mul(b, m))
        ring.mul(ring.add(a, b), m) = ring.add(ring.mul(a, m), ring.mul(b, m))
    claim:
        ? forall a Carrier, m, n Carrier:
            ring.mul(a, ring.add(m, n)) = ring.add(ring.mul(a, m), ring.mul(a, n))
        ring.mul(a, ring.add(m, n)) = ring.add(ring.mul(a, m), ring.mul(a, n))
    by def $is_module(Carrier, Carrier, ring.add, ring.zero, ring.neg, ring.mul, ring.one, ring.add, ring.zero, ring.neg, ring.mul)
    release thm cart_member_from_coordinates((ring.add, ring.zero, ring.neg, ring.mul, ring.one, ring.add, ring.zero, ring.neg, ring.mul), cart(fn(x, y Carrier) Carrier, Carrier, fn(x Carrier) Carrier, fn(x, y Carrier) Carrier, Carrier, fn(x, y Carrier) Carrier, Carrier, fn(x Carrier) Carrier, fn(r Carrier, m Carrier) Carrier))
    release thm struct_member((ring.add, ring.zero, ring.neg, ring.mul, ring.one, ring.add, ring.zero, ring.neg, ring.mul), &Module<Carrier, Carrier>)

template<Carrier nonempty_set, ring &chap2::Ring<Carrier>>:
    have self_module &Module<Carrier, Carrier> = (ring.add, ring.zero, ring.neg, ring.mul, ring.one, ring.add, ring.zero, ring.neg, ring.mul)

template<Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>>:
    have fn additive_nsmul(n N, x Carrier) Carrier by induc n from 0:
        case n = 0: group.zero
        case n > 0: group.add(x, additive_nsmul(n - 1, x))

forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, x Carrier:
    \additive_nsmul<Carrier, group>(0, x) = group.zero

forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
    n + 1 > 0
    (n + 1) - 1 = n
    \additive_nsmul<Carrier, group>(n + 1, x) = group.add(x, \additive_nsmul<Carrier, group>(n, x))

template<Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>>:
    have fn additive_zsmul(n Z, x Carrier) Carrier by cases:
        case n >= 0: \additive_nsmul<Carrier, group>(abs(n), x)
        case n < 0: group.neg(\additive_nsmul<Carrier, group>(abs(n), x))

forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
    n >= 0
    abs(n) = n
    \additive_zsmul<Carrier, group>(n, x) = \additive_nsmul<Carrier, group>(abs(n), x) = \additive_nsmul<Carrier, group>(n, x)

forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
    n + 1 > 0
    -1 < 0
    -1 * (n + 1) < 0
    -(n + 1) = -1 * (n + 1) < 0
    abs(-(n + 1)) = n + 1
    \additive_zsmul<Carrier, group>(-(n + 1), x) = group.neg(\additive_nsmul<Carrier, group>(abs(-(n + 1)), x)) = group.neg(\additive_nsmul<Carrier, group>(n + 1, x))

thm additive_group_laws_from_object:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>:
        $chap2::additive_commutative_group_laws(Carrier, group.add, group.zero, group.neg)
    claim:
        ? forall x, y, z Carrier:
            group.add(group.add(x, y), z) = group.add(x, group.add(y, z))
            group.add(x, y) = group.add(y, x)
        group.add(group.add(x, y), z) = group.add(x, group.add(y, z))
        group.add(x, y) = group.add(y, x)
    claim:
        ? forall x Carrier:
            group.add(group.zero, x) = x
            group.add(x, group.zero) = x
            group.add(group.neg(x), x) = group.zero
        group.add(group.zero, x) = x
        group.add(x, group.zero) = x
        group.add(group.neg(x), x) = group.zero
    by def:
        ? $chap2::additive_commutative_group_laws(Carrier, group.add, group.zero, group.neg)

thm additive_nsmul_zero_arg:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N:
        \additive_nsmul<Carrier, group>(n, group.zero) = group.zero
    release thm additive_group_laws_from_object(Carrier, group)
    by induc n from 0:
        ? \additive_nsmul<Carrier, group>(n, group.zero) = group.zero
        ? from n = 0:
            \additive_nsmul<Carrier, group>(0, group.zero) = group.zero
        ? induc:
            \additive_nsmul<Carrier, group>(n, group.zero) = group.zero
            \additive_nsmul<Carrier, group>(n + 1, group.zero) = group.add(group.zero, \additive_nsmul<Carrier, group>(n, group.zero)) = group.add(group.zero, group.zero) = group.zero

thm additive_nsmul_add_arg:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x, y Carrier:
        \additive_nsmul<Carrier, group>(n, group.add(x, y)) = group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(n, y))
    release thm additive_group_laws_from_object(Carrier, group)
    by induc n from 0:
        ? \additive_nsmul<Carrier, group>(n, group.add(x, y)) = group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(n, y))
        ? from n = 0:
            \additive_nsmul<Carrier, group>(0, group.add(x, y)) = group.zero
            \additive_nsmul<Carrier, group>(0, x) = group.zero
            \additive_nsmul<Carrier, group>(0, y) = group.zero
            group.add(group.zero, group.zero) = group.zero
            \additive_nsmul<Carrier, group>(0, group.add(x, y)) = group.zero = group.add(group.zero, group.zero) = group.add(\additive_nsmul<Carrier, group>(0, x), \additive_nsmul<Carrier, group>(0, y))
        ? induc:
            \additive_nsmul<Carrier, group>(n, group.add(x, y)) = group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(n, y))
            \additive_nsmul<Carrier, group>(n + 1, x) = group.add(x, \additive_nsmul<Carrier, group>(n, x))
            \additive_nsmul<Carrier, group>(n + 1, y) = group.add(y, \additive_nsmul<Carrier, group>(n, y))
            release thm chap2::add_reorder_four_structure(Carrier, group.add, group.zero, group.neg, x, y, \additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(n, y))
            \additive_nsmul<Carrier, group>(n + 1, group.add(x, y)) = group.add(group.add(x, y), \additive_nsmul<Carrier, group>(n, group.add(x, y))) = group.add(group.add(x, y), group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(n, y))) = group.add(group.add(x, \additive_nsmul<Carrier, group>(n, x)), group.add(y, \additive_nsmul<Carrier, group>(n, y))) = group.add(\additive_nsmul<Carrier, group>(n + 1, x), \additive_nsmul<Carrier, group>(n + 1, y))

thm additive_nsmul_add_index:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n, m N, x Carrier:
        \additive_nsmul<Carrier, group>(n + m, x) = group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(m, x))
    release thm additive_group_laws_from_object(Carrier, group)
    by induc n from 0:
        ? \additive_nsmul<Carrier, group>(n + m, x) = group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(m, x))
        ? from n = 0:
            0 + m = m
            \additive_nsmul<Carrier, group>(0, x) = group.zero
            group.add(group.zero, \additive_nsmul<Carrier, group>(m, x)) = \additive_nsmul<Carrier, group>(m, x)
            \additive_nsmul<Carrier, group>(0 + m, x) = \additive_nsmul<Carrier, group>(m, x) = group.add(group.zero, \additive_nsmul<Carrier, group>(m, x)) = group.add(\additive_nsmul<Carrier, group>(0, x), \additive_nsmul<Carrier, group>(m, x))
        ? induc:
            \additive_nsmul<Carrier, group>(n + m, x) = group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(m, x))
            (n + 1) + m = (n + m) + 1
            \additive_nsmul<Carrier, group>((n + m) + 1, x) = group.add(x, \additive_nsmul<Carrier, group>(n + m, x))
            \additive_nsmul<Carrier, group>(n + 1, x) = group.add(x, \additive_nsmul<Carrier, group>(n, x))
            \additive_nsmul<Carrier, group>((n + 1) + m, x) = \additive_nsmul<Carrier, group>((n + m) + 1, x) = group.add(x, \additive_nsmul<Carrier, group>(n + m, x)) = group.add(x, group.add(\additive_nsmul<Carrier, group>(n, x), \additive_nsmul<Carrier, group>(m, x))) = group.add(group.add(x, \additive_nsmul<Carrier, group>(n, x)), \additive_nsmul<Carrier, group>(m, x)) = group.add(\additive_nsmul<Carrier, group>(n + 1, x), \additive_nsmul<Carrier, group>(m, x))

thm additive_nsmul_mul_index:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n, m N, x Carrier:
        \additive_nsmul<Carrier, group>(n * m, x) = \additive_nsmul<Carrier, group>(n, \additive_nsmul<Carrier, group>(m, x))
    by induc n from 0:
        ? \additive_nsmul<Carrier, group>(n * m, x) = \additive_nsmul<Carrier, group>(n, \additive_nsmul<Carrier, group>(m, x))
        ? from n = 0:
            0 * m = 0
            \additive_nsmul<Carrier, group>(0 * m, x) = \additive_nsmul<Carrier, group>(0, x) = group.zero = \additive_nsmul<Carrier, group>(0, \additive_nsmul<Carrier, group>(m, x))
        ? induc:
            \additive_nsmul<Carrier, group>(n * m, x) = \additive_nsmul<Carrier, group>(n, \additive_nsmul<Carrier, group>(m, x))
            (n + 1) * m = n * m + m
            release thm additive_nsmul_add_index(Carrier, group, n * m, m, x)
            \additive_nsmul<Carrier, group>(n + 1, \additive_nsmul<Carrier, group>(m, x)) = group.add(\additive_nsmul<Carrier, group>(m, x), \additive_nsmul<Carrier, group>(n, \additive_nsmul<Carrier, group>(m, x)))
            group.add(\additive_nsmul<Carrier, group>(n * m, x), \additive_nsmul<Carrier, group>(m, x)) = group.add(\additive_nsmul<Carrier, group>(m, x), \additive_nsmul<Carrier, group>(n * m, x))
            \additive_nsmul<Carrier, group>((n + 1) * m, x) = \additive_nsmul<Carrier, group>(n * m + m, x) = group.add(\additive_nsmul<Carrier, group>(n * m, x), \additive_nsmul<Carrier, group>(m, x)) = group.add(\additive_nsmul<Carrier, group>(m, x), \additive_nsmul<Carrier, group>(n * m, x)) = group.add(\additive_nsmul<Carrier, group>(m, x), \additive_nsmul<Carrier, group>(n, \additive_nsmul<Carrier, group>(m, x))) = \additive_nsmul<Carrier, group>(n + 1, \additive_nsmul<Carrier, group>(m, x))

thm additive_nsmul_neg_arg:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
        \additive_nsmul<Carrier, group>(n, group.neg(x)) = group.neg(\additive_nsmul<Carrier, group>(n, x))
    release thm additive_group_laws_from_object(Carrier, group)
    by induc n from 0:
        ? \additive_nsmul<Carrier, group>(n, group.neg(x)) = group.neg(\additive_nsmul<Carrier, group>(n, x))
        ? from n = 0:
            release thm chap2::neg_zero_structure(Carrier, group.add, group.zero, group.neg)
            \additive_nsmul<Carrier, group>(0, x) = group.zero
            group.neg(\additive_nsmul<Carrier, group>(0, x)) = group.neg(group.zero)
            \additive_nsmul<Carrier, group>(0, group.neg(x)) = group.zero = group.neg(group.zero) = group.neg(\additive_nsmul<Carrier, group>(0, x))
        ? induc:
            \additive_nsmul<Carrier, group>(n, group.neg(x)) = group.neg(\additive_nsmul<Carrier, group>(n, x))
            release thm chap2::add_reorder_four_structure(Carrier, group.add, group.zero, group.neg, x, \additive_nsmul<Carrier, group>(n, x), group.neg(x), group.neg(\additive_nsmul<Carrier, group>(n, x)))
            release thm chap2::add_neg_cancel_from_laws(Carrier, group.add, group.zero, group.neg, x)
            release thm chap2::add_neg_cancel_from_laws(Carrier, group.add, group.zero, group.neg, \additive_nsmul<Carrier, group>(n, x))
            group.add(group.add(x, \additive_nsmul<Carrier, group>(n, x)), group.add(group.neg(x), group.neg(\additive_nsmul<Carrier, group>(n, x)))) = group.add(group.add(x, group.neg(x)), group.add(\additive_nsmul<Carrier, group>(n, x), group.neg(\additive_nsmul<Carrier, group>(n, x)))) = group.add(group.zero, group.zero) = group.zero
            release thm chap2::eq_neg_of_add_eq_zero_structure(Carrier, group.add, group.zero, group.neg, group.add(x, \additive_nsmul<Carrier, group>(n, x)), group.add(group.neg(x), group.neg(\additive_nsmul<Carrier, group>(n, x))))
            group.add(group.neg(x), group.neg(\additive_nsmul<Carrier, group>(n, x))) = group.neg(group.add(x, \additive_nsmul<Carrier, group>(n, x)))
            \additive_nsmul<Carrier, group>(n + 1, x) = group.add(x, \additive_nsmul<Carrier, group>(n, x))
            group.neg(\additive_nsmul<Carrier, group>(n + 1, x)) = group.neg(group.add(x, \additive_nsmul<Carrier, group>(n, x)))
            \additive_nsmul<Carrier, group>(n + 1, group.neg(x)) = group.add(group.neg(x), \additive_nsmul<Carrier, group>(n, group.neg(x))) = group.add(group.neg(x), group.neg(\additive_nsmul<Carrier, group>(n, x))) = group.neg(group.add(x, \additive_nsmul<Carrier, group>(n, x))) = group.neg(\additive_nsmul<Carrier, group>(n + 1, x))

thm additive_neg_add:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, x, y Carrier:
        group.neg(group.add(x, y)) = group.add(group.neg(x), group.neg(y))
    release thm additive_group_laws_from_object(Carrier, group)
    release thm chap2::add_reorder_four_structure(Carrier, group.add, group.zero, group.neg, x, y, group.neg(x), group.neg(y))
    release thm chap2::add_neg_cancel_from_laws(Carrier, group.add, group.zero, group.neg, x)
    release thm chap2::add_neg_cancel_from_laws(Carrier, group.add, group.zero, group.neg, y)
    group.add(group.add(x, y), group.add(group.neg(x), group.neg(y))) = group.add(group.add(x, group.neg(x)), group.add(y, group.neg(y))) = group.add(group.zero, group.zero) = group.zero
    release thm chap2::eq_neg_of_add_eq_zero_structure(Carrier, group.add, group.zero, group.neg, group.add(x, y), group.add(group.neg(x), group.neg(y)))
    group.add(group.neg(x), group.neg(y)) = group.neg(group.add(x, y))
    group.neg(group.add(x, y)) = group.add(group.neg(x), group.neg(y))

thm additive_zsmul_zero:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, x Carrier:
        \additive_zsmul<Carrier, group>(0, x) = group.zero
    let nsmul = \additive_nsmul<Carrier, group>
    let zsmul = \additive_zsmul<Carrier, group>
    0 >= 0
    abs(0) = 0
    zsmul(0, x) = nsmul(abs(0), x) = nsmul(0, x) = group.zero

thm additive_zsmul_one:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, x Carrier:
        \additive_zsmul<Carrier, group>(1, x) = x
    let nsmul = \additive_nsmul<Carrier, group>
    let zsmul = \additive_zsmul<Carrier, group>
    release thm additive_group_laws_from_object(Carrier, group)
    1 >= 0
    abs(1) = 1
    nsmul(0, x) = group.zero
    group.add(x, nsmul(0, x)) = group.add(x, group.zero)
    nsmul(1, x) = group.add(x, nsmul(0, x)) = group.add(x, group.zero) = x
    zsmul(1, x) = nsmul(abs(1), x) = nsmul(1, x) = x

thm additive_zsmul_add_arg:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a Z, x, y Carrier:
        \additive_zsmul<Carrier, group>(a, group.add(x, y)) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(a, y))
    by cases:
        ? \additive_zsmul<Carrier, group>(a, group.add(x, y)) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(a, y))
        case a >= 0:
            \additive_zsmul<Carrier, group>(a, group.add(x, y)) = \additive_nsmul<Carrier, group>(abs(a), group.add(x, y))
            \additive_zsmul<Carrier, group>(a, x) = \additive_nsmul<Carrier, group>(abs(a), x)
            \additive_zsmul<Carrier, group>(a, y) = \additive_nsmul<Carrier, group>(abs(a), y)
            release thm additive_nsmul_add_arg(Carrier, group, abs(a), x, y)
            group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(a, y)) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(a), y))
            \additive_zsmul<Carrier, group>(a, group.add(x, y)) = \additive_nsmul<Carrier, group>(abs(a), group.add(x, y)) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(a), y)) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(a, y))
        case a < 0:
            \additive_zsmul<Carrier, group>(a, group.add(x, y)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), group.add(x, y)))
            \additive_zsmul<Carrier, group>(a, x) = group.neg(\additive_nsmul<Carrier, group>(abs(a), x))
            \additive_zsmul<Carrier, group>(a, y) = group.neg(\additive_nsmul<Carrier, group>(abs(a), y))
            release thm additive_nsmul_add_arg(Carrier, group, abs(a), x, y)
            release thm additive_neg_add(Carrier, group, \additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(a), y))
            group.neg(\additive_nsmul<Carrier, group>(abs(a), group.add(x, y))) = group.neg(group.add(\additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(a), y))) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)), group.neg(\additive_nsmul<Carrier, group>(abs(a), y)))
            group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(a, y)) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)), group.neg(\additive_nsmul<Carrier, group>(abs(a), y)))
            \additive_zsmul<Carrier, group>(a, group.add(x, y)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), group.add(x, y))) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)), group.neg(\additive_nsmul<Carrier, group>(abs(a), y))) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(a, y))

thm additive_zsmul_neg_arg:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a Z, x Carrier:
        \additive_zsmul<Carrier, group>(a, group.neg(x)) = group.neg(\additive_zsmul<Carrier, group>(a, x))
    release thm additive_group_laws_from_object(Carrier, group)
    by cases:
        ? \additive_zsmul<Carrier, group>(a, group.neg(x)) = group.neg(\additive_zsmul<Carrier, group>(a, x))
        case a >= 0:
            \additive_zsmul<Carrier, group>(a, group.neg(x)) = \additive_nsmul<Carrier, group>(abs(a), group.neg(x))
            \additive_zsmul<Carrier, group>(a, x) = \additive_nsmul<Carrier, group>(abs(a), x)
            release thm additive_nsmul_neg_arg(Carrier, group, abs(a), x)
            group.neg(\additive_zsmul<Carrier, group>(a, x)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), x))
            \additive_zsmul<Carrier, group>(a, group.neg(x)) = \additive_nsmul<Carrier, group>(abs(a), group.neg(x)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), x)) = group.neg(\additive_zsmul<Carrier, group>(a, x))
        case a < 0:
            \additive_zsmul<Carrier, group>(a, group.neg(x)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), group.neg(x)))
            \additive_zsmul<Carrier, group>(a, x) = group.neg(\additive_nsmul<Carrier, group>(abs(a), x))
            release thm additive_nsmul_neg_arg(Carrier, group, abs(a), x)
            release thm chap2::neg_neg_structure(Carrier, group.add, group.zero, group.neg, \additive_nsmul<Carrier, group>(abs(a), x))
            group.neg(\additive_nsmul<Carrier, group>(abs(a), group.neg(x))) = group.neg(group.neg(\additive_nsmul<Carrier, group>(abs(a), x))) = \additive_nsmul<Carrier, group>(abs(a), x)
            group.neg(\additive_zsmul<Carrier, group>(a, x)) = group.neg(group.neg(\additive_nsmul<Carrier, group>(abs(a), x))) = \additive_nsmul<Carrier, group>(abs(a), x)
            \additive_zsmul<Carrier, group>(a, group.neg(x)) = \additive_nsmul<Carrier, group>(abs(a), x) = group.neg(\additive_zsmul<Carrier, group>(a, x))

thm additive_nsmul_sub_index:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, p, q N, x Carrier:
        p >= q
        =>:
            group.add(\additive_nsmul<Carrier, group>(p, x), group.neg(\additive_nsmul<Carrier, group>(q, x))) = \additive_nsmul<Carrier, group>(p - q, x)
    release thm additive_group_laws_from_object(Carrier, group)
    (p - q) + q = p
    release thm additive_nsmul_add_index(Carrier, group, p - q, q, x)
    \additive_nsmul<Carrier, group>((p - q) + q, x) = group.add(\additive_nsmul<Carrier, group>(p - q, x), \additive_nsmul<Carrier, group>(q, x))
    \additive_nsmul<Carrier, group>(p, x) = group.add(\additive_nsmul<Carrier, group>(p - q, x), \additive_nsmul<Carrier, group>(q, x))
    release thm chap2::add_neg_cancel_from_laws(Carrier, group.add, group.zero, group.neg, \additive_nsmul<Carrier, group>(q, x))
    release thm chap2::add_zero_from_laws(Carrier, group.add, group.zero, group.neg, \additive_nsmul<Carrier, group>(p - q, x))
    group.add(\additive_nsmul<Carrier, group>(p, x), group.neg(\additive_nsmul<Carrier, group>(q, x))) = group.add(group.add(\additive_nsmul<Carrier, group>(p - q, x), \additive_nsmul<Carrier, group>(q, x)), group.neg(\additive_nsmul<Carrier, group>(q, x))) = group.add(\additive_nsmul<Carrier, group>(p - q, x), group.add(\additive_nsmul<Carrier, group>(q, x), group.neg(\additive_nsmul<Carrier, group>(q, x)))) = group.add(\additive_nsmul<Carrier, group>(p - q, x), group.zero) = \additive_nsmul<Carrier, group>(p - q, x)

thm abs_add_of_nonnegative:
    ? forall a, b Z:
        a >= 0
        b >= 0
        =>:
            abs(a + b) = abs(a) + abs(b)
    a + b >= 0
    abs(a) = a
    abs(b) = b
    abs(a + b) = a + b = abs(a) + abs(b)

thm abs_add_of_negative:
    ? forall a, b Z:
        a < 0
        b < 0
        =>:
            abs(a + b) = abs(a) + abs(b)
    a + b < 0
    abs(a) = -a
    abs(b) = -b
    abs(a + b) = -(a + b) = (-a) + (-b) = abs(a) + abs(b)

thm abs_add_mixed_nonnegative:
    ? forall a, b Z:
        a >= 0
        b < 0
        a + b >= 0
        =>:
            abs(a) >= abs(b)
            abs(a + b) = abs(a) - abs(b)
    abs(a) = a
    abs(b) = -b
    abs(a + b) = a + b
    (a + b) + (-b) >= 0 + (-b)
    (a + b) + (-b) = a
    0 + (-b) = -b
    a >= -b
    abs(a) = a >= -b = abs(b)
    abs(a + b) = a + b = a - (-b) = abs(a) - abs(b)

thm abs_add_mixed_negative:
    ? forall a, b Z:
        a >= 0
        b < 0
        a + b < 0
        =>:
            abs(b) >= abs(a)
            abs(a + b) = abs(b) - abs(a)
    abs(a) = a
    abs(b) = -b
    abs(a + b) = -(a + b)
    (a + b) + (-b) < 0 + (-b)
    (a + b) + (-b) = a
    0 + (-b) = -b
    a < -b
    abs(b) = -b > a = abs(a)
    abs(a + b) = -(a + b) = (-b) - a = abs(b) - abs(a)

thm additive_zsmul_add_mixed:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a, b Z, x Carrier:
        a >= 0
        b < 0
        =>:
            \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
    release thm additive_group_laws_from_object(Carrier, group)
    \additive_zsmul<Carrier, group>(a, x) = \additive_nsmul<Carrier, group>(abs(a), x)
    \additive_zsmul<Carrier, group>(b, x) = group.neg(\additive_nsmul<Carrier, group>(abs(b), x))
    group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x)) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
    by cases:
        ? \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
        case a + b >= 0:
            release thm abs_add_mixed_nonnegative(a, b)
            release thm additive_nsmul_sub_index(Carrier, group, abs(a), abs(b), x)
            \additive_zsmul<Carrier, group>(a + b, x) = \additive_nsmul<Carrier, group>(abs(a + b), x) = \additive_nsmul<Carrier, group>(abs(a) - abs(b), x) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x))) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
        case a + b < 0:
            release thm abs_add_mixed_negative(a, b)
            release thm additive_nsmul_sub_index(Carrier, group, abs(b), abs(a), x)
            release thm additive_neg_add(Carrier, group, \additive_nsmul<Carrier, group>(abs(b), x), group.neg(\additive_nsmul<Carrier, group>(abs(a), x)))
            release thm chap2::neg_neg_structure(Carrier, group.add, group.zero, group.neg, \additive_nsmul<Carrier, group>(abs(a), x))
            group.neg(group.add(\additive_nsmul<Carrier, group>(abs(b), x), group.neg(\additive_nsmul<Carrier, group>(abs(a), x)))) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(b), x)), group.neg(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)))) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(b), x)), \additive_nsmul<Carrier, group>(abs(a), x)) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
            group.neg(\additive_nsmul<Carrier, group>(abs(b) - abs(a), x)) = group.neg(group.add(\additive_nsmul<Carrier, group>(abs(b), x), group.neg(\additive_nsmul<Carrier, group>(abs(a), x)))) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
            \additive_zsmul<Carrier, group>(a + b, x) = group.neg(\additive_nsmul<Carrier, group>(abs(a + b), x)) = group.neg(\additive_nsmul<Carrier, group>(abs(b) - abs(a), x)) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x))) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))

thm additive_zsmul_add_nonnegative:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a, b Z, x Carrier:
        a >= 0
        b >= 0
        =>:
            \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
    a + b >= 0
    release thm abs_add_of_nonnegative(a, b)
    \additive_zsmul<Carrier, group>(a + b, x) = \additive_nsmul<Carrier, group>(abs(a + b), x)
    \additive_zsmul<Carrier, group>(a, x) = \additive_nsmul<Carrier, group>(abs(a), x)
    \additive_zsmul<Carrier, group>(b, x) = \additive_nsmul<Carrier, group>(abs(b), x)
    release thm additive_nsmul_add_index(Carrier, group, abs(a), abs(b), x)
    group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x)) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(b), x))
    \additive_zsmul<Carrier, group>(a + b, x) = \additive_nsmul<Carrier, group>(abs(a + b), x) = \additive_nsmul<Carrier, group>(abs(a) + abs(b), x) = group.add(\additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(b), x)) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))

thm additive_zsmul_add_negative:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a, b Z, x Carrier:
        a < 0
        b < 0
        =>:
            \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
    a + b < 0
    release thm abs_add_of_negative(a, b)
    \additive_zsmul<Carrier, group>(a + b, x) = group.neg(\additive_nsmul<Carrier, group>(abs(a + b), x))
    \additive_zsmul<Carrier, group>(a, x) = group.neg(\additive_nsmul<Carrier, group>(abs(a), x))
    \additive_zsmul<Carrier, group>(b, x) = group.neg(\additive_nsmul<Carrier, group>(abs(b), x))
    release thm additive_nsmul_add_index(Carrier, group, abs(a), abs(b), x)
    release thm additive_neg_add(Carrier, group, \additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(b), x))
    group.neg(\additive_nsmul<Carrier, group>(abs(a + b), x)) = group.neg(\additive_nsmul<Carrier, group>(abs(a) + abs(b), x)) = group.neg(group.add(\additive_nsmul<Carrier, group>(abs(a), x), \additive_nsmul<Carrier, group>(abs(b), x))) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
    group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x)) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
    \additive_zsmul<Carrier, group>(a + b, x) = group.add(group.neg(\additive_nsmul<Carrier, group>(abs(a), x)), group.neg(\additive_nsmul<Carrier, group>(abs(b), x))) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))

thm additive_zsmul_add_index:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a, b Z, x Carrier:
        \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
    by cases:
        ? \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
        case a >= 0:
            by cases:
                ? \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
                case b >= 0:
                    release thm additive_zsmul_add_nonnegative(Carrier, group, a, b, x)
                case b < 0:
                    release thm additive_zsmul_add_mixed(Carrier, group, a, b, x)
        case a < 0:
            by cases:
                ? \additive_zsmul<Carrier, group>(a + b, x) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))
                case b < 0:
                    release thm additive_zsmul_add_negative(Carrier, group, a, b, x)
                case b >= 0:
                    release thm additive_zsmul_add_mixed(Carrier, group, b, a, x)
                    a + b = b + a
                    group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x)) = group.add(\additive_zsmul<Carrier, group>(b, x), \additive_zsmul<Carrier, group>(a, x))
                    \additive_zsmul<Carrier, group>(a + b, x) = \additive_zsmul<Carrier, group>(b + a, x) = group.add(\additive_zsmul<Carrier, group>(b, x), \additive_zsmul<Carrier, group>(a, x)) = group.add(\additive_zsmul<Carrier, group>(a, x), \additive_zsmul<Carrier, group>(b, x))

thm integer_abs_mul:
    ? forall a, b Z:
        abs(a * b) = abs(a) * abs(b)

thm additive_zsmul_natural:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
        \additive_zsmul<Carrier, group>(n, x) = \additive_nsmul<Carrier, group>(n, x)
    let nsmul = \additive_nsmul<Carrier, group>
    let zsmul = \additive_zsmul<Carrier, group>
    n >= 0
    abs(n) = n
    zsmul(n, x) = nsmul(abs(n), x) = nsmul(n, x)

thm additive_zsmul_neg_natural:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
        \additive_zsmul<Carrier, group>(-n, x) = group.neg(\additive_nsmul<Carrier, group>(n, x))
    release thm additive_group_laws_from_object(Carrier, group)
    by induc n from 0:
        ? \additive_zsmul<Carrier, group>(-n, x) = group.neg(\additive_nsmul<Carrier, group>(n, x))
        ? from n = 0:
            release thm chap2::neg_zero_structure(Carrier, group.add, group.zero, group.neg)
            -0 = 0
            \additive_zsmul<Carrier, group>(-0, x) = \additive_zsmul<Carrier, group>(0, x) = group.zero
            \additive_nsmul<Carrier, group>(0, x) = group.zero
            group.neg(\additive_nsmul<Carrier, group>(0, x)) = group.neg(group.zero) = group.zero
            \additive_zsmul<Carrier, group>(-0, x) = group.zero = group.neg(\additive_nsmul<Carrier, group>(0, x))
        ? induc:
            \additive_zsmul<Carrier, group>(-(n + 1), x) = group.neg(\additive_nsmul<Carrier, group>(n + 1, x))

thm additive_nsmul_congr_arg:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x, y Carrier:
        x = y
        =>:
            \additive_nsmul<Carrier, group>(n, x) = \additive_nsmul<Carrier, group>(n, y)

thm additive_neg_congr:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, x, y Carrier:
        x = y
        =>:
            group.neg(x) = group.neg(y)

thm integer_mul_abs_nonnegative_negative:
    ? forall a, b Z:
        a >= 0
        b < 0
        =>:
            a * b = -(abs(a) * abs(b))
    abs(a) = a
    abs(b) = -b
    -(abs(a) * abs(b)) = -(a * (-b)) = a * b
    a * b = -(abs(a) * abs(b))

thm integer_mul_abs_negative_nonnegative:
    ? forall a, b Z:
        a < 0
        b >= 0
        =>:
            a * b = -(abs(a) * abs(b))
    abs(a) = -a
    abs(b) = b
    -(abs(a) * abs(b)) = -((-a) * b) = a * b
    a * b = -(abs(a) * abs(b))

thm integer_mul_abs_negative:
    ? forall a, b Z:
        a < 0
        b < 0
        =>:
            a * b = abs(a) * abs(b)
    abs(a) = -a
    abs(b) = -b
    abs(a) * abs(b) = (-a) * (-b) = a * b
    a * b = abs(a) * abs(b)

thm additive_zsmul_mul_index:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, a, b Z, x Carrier:
        \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
    release thm additive_group_laws_from_object(Carrier, group)
    by cases:
        ? \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
        case a >= 0:
            abs(a) = a
            by cases:
                ? \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
                case b >= 0:
                    abs(b) = b
                    a * b = abs(a) * abs(b)
                    release thm additive_zsmul_natural(Carrier, group, abs(a) * abs(b), x)
                    release thm additive_zsmul_natural(Carrier, group, abs(b), x)
                    release thm additive_nsmul_congr_arg(Carrier, group, abs(a), \additive_zsmul<Carrier, group>(b, x), \additive_nsmul<Carrier, group>(abs(b), x))
                    release thm additive_zsmul_natural(Carrier, group, abs(a), \additive_zsmul<Carrier, group>(b, x))
                    release thm additive_nsmul_mul_index(Carrier, group, abs(a), abs(b), x)
                    \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x)) = \additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x)) = \additive_nsmul<Carrier, group>(abs(a), \additive_nsmul<Carrier, group>(abs(b), x)) = \additive_nsmul<Carrier, group>(abs(a) * abs(b), x)
                    \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(abs(a) * abs(b), x) = \additive_nsmul<Carrier, group>(abs(a) * abs(b), x) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
                case b < 0:
                    release thm integer_mul_abs_nonnegative_negative(a, b)
                    release thm additive_zsmul_neg_natural(Carrier, group, abs(a) * abs(b), x)
                    \additive_zsmul<Carrier, group>(b, x) = group.neg(\additive_nsmul<Carrier, group>(abs(b), x))
                    release thm additive_nsmul_congr_arg(Carrier, group, abs(a), \additive_zsmul<Carrier, group>(b, x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
                    \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x)) = \additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x))
                    release thm additive_nsmul_neg_arg(Carrier, group, abs(a), \additive_nsmul<Carrier, group>(abs(b), x))
                    release thm additive_nsmul_mul_index(Carrier, group, abs(a), abs(b), x)
                    \additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x)) = \additive_nsmul<Carrier, group>(abs(a), group.neg(\additive_nsmul<Carrier, group>(abs(b), x))) = group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_nsmul<Carrier, group>(abs(b), x))) = group.neg(\additive_nsmul<Carrier, group>(abs(a) * abs(b), x))
                    \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(-(abs(a) * abs(b)), x) = group.neg(\additive_nsmul<Carrier, group>(abs(a) * abs(b), x)) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
        case a < 0:
            abs(a) = -a
            by cases:
                ? \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
                case b >= 0:
                    release thm integer_mul_abs_negative_nonnegative(a, b)
                    release thm additive_zsmul_neg_natural(Carrier, group, abs(a) * abs(b), x)
                    \additive_zsmul<Carrier, group>(b, x) = \additive_nsmul<Carrier, group>(abs(b), x)
                    release thm additive_nsmul_congr_arg(Carrier, group, abs(a), \additive_zsmul<Carrier, group>(b, x), \additive_nsmul<Carrier, group>(abs(b), x))
                    release thm additive_neg_congr(Carrier, group, \additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x)), \additive_nsmul<Carrier, group>(abs(a), \additive_nsmul<Carrier, group>(abs(b), x)))
                    \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x)))
                    release thm additive_nsmul_mul_index(Carrier, group, abs(a), abs(b), x)
                    group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x))) = group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_nsmul<Carrier, group>(abs(b), x))) = group.neg(\additive_nsmul<Carrier, group>(abs(a) * abs(b), x))
                    \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(-(abs(a) * abs(b)), x) = group.neg(\additive_nsmul<Carrier, group>(abs(a) * abs(b), x)) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))
                case b < 0:
                    release thm integer_mul_abs_negative(a, b)
                    release thm additive_zsmul_natural(Carrier, group, abs(a) * abs(b), x)
                    \additive_zsmul<Carrier, group>(b, x) = group.neg(\additive_nsmul<Carrier, group>(abs(b), x))
                    release thm additive_nsmul_congr_arg(Carrier, group, abs(a), \additive_zsmul<Carrier, group>(b, x), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))
                    release thm additive_neg_congr(Carrier, group, \additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x)), \additive_nsmul<Carrier, group>(abs(a), group.neg(\additive_nsmul<Carrier, group>(abs(b), x))))
                    \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x)) = group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x)))
                    release thm additive_nsmul_neg_arg(Carrier, group, abs(a), \additive_nsmul<Carrier, group>(abs(b), x))
                    release thm additive_nsmul_mul_index(Carrier, group, abs(a), abs(b), x)
                    release thm chap2::neg_neg_structure(Carrier, group.add, group.zero, group.neg, \additive_nsmul<Carrier, group>(abs(a) * abs(b), x))
                    group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_zsmul<Carrier, group>(b, x))) = group.neg(\additive_nsmul<Carrier, group>(abs(a), group.neg(\additive_nsmul<Carrier, group>(abs(b), x)))) = group.neg(group.neg(\additive_nsmul<Carrier, group>(abs(a), \additive_nsmul<Carrier, group>(abs(b), x)))) = group.neg(group.neg(\additive_nsmul<Carrier, group>(abs(a) * abs(b), x))) = \additive_nsmul<Carrier, group>(abs(a) * abs(b), x)
                    \additive_zsmul<Carrier, group>(a * b, x) = \additive_zsmul<Carrier, group>(abs(a) * abs(b), x) = \additive_nsmul<Carrier, group>(abs(a) * abs(b), x) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, x))

claim:
    ? forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>:
        (fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1, group.add, group.zero, group.neg, \additive_zsmul<Carrier, group>) $in &Module<Z, Carrier>
    release thm integer_ring_laws(0)
    release thm additive_group_laws_from_object(Carrier, group)
    claim:
        ? forall m Carrier:
            \additive_zsmul<Carrier, group>(0, m) = group.zero
        release thm additive_zsmul_zero(Carrier, group, m)
    claim:
        ? forall m Carrier:
            \additive_zsmul<Carrier, group>(1, m) = m
        release thm additive_zsmul_one(Carrier, group, m)
    claim:
        ? forall a, b Z, m Carrier:
            \additive_zsmul<Carrier, group>(a * b, m) = \additive_zsmul<Carrier, group>(a, \additive_zsmul<Carrier, group>(b, m))
        release thm additive_zsmul_mul_index(Carrier, group, a, b, m)
    claim:
        ? forall a, b Z, m Carrier:
            \additive_zsmul<Carrier, group>(a + b, m) = group.add(\additive_zsmul<Carrier, group>(a, m), \additive_zsmul<Carrier, group>(b, m))
        release thm additive_zsmul_add_index(Carrier, group, a, b, m)
    claim:
        ? forall a Z, m, n Carrier:
            \additive_zsmul<Carrier, group>(a, group.add(m, n)) = group.add(\additive_zsmul<Carrier, group>(a, m), \additive_zsmul<Carrier, group>(a, n))
        release thm additive_zsmul_add_arg(Carrier, group, a, m, n)
    by def $is_module(Z, Carrier, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1, group.add, group.zero, group.neg, \additive_zsmul<Carrier, group>)
    release thm cart_member_from_coordinates((fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1, group.add, group.zero, group.neg, \additive_zsmul<Carrier, group>), cart(fn(x, y Z) Z, Z, fn(x Z) Z, fn(x, y Z) Z, Z, fn(x, y Carrier) Carrier, Carrier, fn(x Carrier) Carrier, fn(r Z, m Carrier) Carrier))
    release thm struct_member((fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1, group.add, group.zero, group.neg, \additive_zsmul<Carrier, group>), &Module<Z, Carrier>)

template<Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>>:
    have integer_module &Module<Z, Carrier> = (fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {(-x)}, fn(x, y Z) Z {x * y}, 1, group.add, group.zero, group.neg, \additive_zsmul<Carrier, group>)

# AddMonoid4 makes the natural scalar function a customizable data field.
struct AdditiveMonoidWithNSmul<s nonempty_set>:
    add fn(x, y s) s
    zero s
    nsmul fn(n N, x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
        forall x s:
            add(x, zero) = x
        forall x s:
            nsmul(0, x) = zero
        forall n N, x s:
            nsmul(n + 1, x) = add(x, nsmul(n, x))

# Source instance AddMonoid4 Z. Integer addition, zero, and multiplication by
# a natural scalar satisfy the customized scalar laws directly.
thm integer_additive_monoid_with_nsmul_closed:
    ? forall anchor {0}:
        (fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x}) $in &AdditiveMonoidWithNSmul<Z>
    claim:
        ? forall x, y, z Z:
            fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
        fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = (x + y) + z = x + (y + z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
    claim:
        ? forall x Z:
            fn(a, b Z) Z {a + b}(0, x) = x
            fn(a, b Z) Z {a + b}(x, 0) = x
            fn(n N, a Z) Z {n * a}(0, x) = 0
        fn(a, b Z) Z {a + b}(0, x) = 0 + x = x
        fn(a, b Z) Z {a + b}(x, 0) = x + 0 = x
        fn(n N, a Z) Z {n * a}(0, x) = 0 * x = 0
    claim:
        ? forall n N, x Z:
            fn(k N, a Z) Z {k * a}(n + 1, x) = fn(a, b Z) Z {a + b}(x, fn(k N, a Z) Z {k * a}(n, x))
        fn(k N, a Z) Z {k * a}(n + 1, x) = (n + 1) * x = x + n * x = fn(a, b Z) Z {a + b}(x, fn(k N, a Z) Z {k * a}(n, x))
    release thm fn_set_member(fn(x, y Z) Z {x + y}, fn(x, y Z) Z)
    0 $in Z
    release thm fn_set_member(fn(n N, x Z) Z {n * x}, fn(n N, x Z) Z)
    release thm cart_member_from_coordinates((fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x}), cart(fn(x, y Z) Z, Z, fn(n N, x Z) Z))
    release thm struct_member((fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x}), &AdditiveMonoidWithNSmul<Z>)

release thm integer_additive_monoid_with_nsmul_closed(0)
have integer_additive_monoid_with_nsmul &AdditiveMonoidWithNSmul<Z> = (fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x})

# Source product instance for AddMonoid4. The two componentwise operations
# are named once so the law proofs expose their shared definitions without
# repeatedly normalizing large anonymous function terms.
template<A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>>:
    have fn product_add(p, q cart(A, B)) cart(A, B) = (left.add(p[1], q[1]), right.add(p[2], q[2]))

template<A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>>:
    have fn product_nsmul(n N, p cart(A, B)) cart(A, B) = (left.nsmul(n, p[1]), right.nsmul(n, p[2]))

thm cart_pair_extensionality:
    ? forall A, B set, left, right cart(A, B):
        left[1] = right[1]
        left[2] = right[2]
        =>:
            left = right
    release thm tuple_equal_from_coordinates(left, (left[1], left[2]))
    release thm tuple_equal_from_coordinates(right, (right[1], right[2]))
    (left[1], left[2]) = (right[1], right[2])
    left = (left[1], left[2]) = (right[1], right[2]) = right

thm product_add_associative:
    ? forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>, p, q, r cart(A, B):
        \product_add<A, B, left, right>(\product_add<A, B, left, right>(p, q), r) = \product_add<A, B, left, right>(p, \product_add<A, B, left, right>(q, r))
    left.add(left.add(p[1], q[1]), r[1]) = left.add(p[1], left.add(q[1], r[1]))
    right.add(right.add(p[2], q[2]), r[2]) = right.add(p[2], right.add(q[2], r[2]))
    release thm cart_pair_extensionality(A, B, (left.add(left.add(p[1], q[1]), r[1]), right.add(right.add(p[2], q[2]), r[2])), (left.add(p[1], left.add(q[1], r[1])), right.add(p[2], right.add(q[2], r[2]))))
    \product_add<A, B, left, right>(\product_add<A, B, left, right>(p, q), r) = (left.add(left.add(p[1], q[1]), r[1]), right.add(right.add(p[2], q[2]), r[2])) = (left.add(p[1], left.add(q[1], r[1])), right.add(p[2], right.add(q[2], r[2]))) = \product_add<A, B, left, right>(p, \product_add<A, B, left, right>(q, r))

thm product_add_left_identity:
    ? forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>, p cart(A, B):
        \product_add<A, B, left, right>((left.zero, right.zero), p) = p
    left.add(left.zero, p[1]) = p[1]
    right.add(right.zero, p[2]) = p[2]
    (left.add(left.zero, p[1]), right.add(right.zero, p[2])) = (p[1], p[2])
    release thm tuple_equal_from_coordinates(p, (p[1], p[2]))
    p = (p[1], p[2])
    \product_add<A, B, left, right>((left.zero, right.zero), p) = (left.add(left.zero, p[1]), right.add(right.zero, p[2])) = (p[1], p[2]) = p

thm product_add_right_identity:
    ? forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>, p cart(A, B):
        \product_add<A, B, left, right>(p, (left.zero, right.zero)) = p
    left.add(p[1], left.zero) = p[1]
    right.add(p[2], right.zero) = p[2]
    (left.add(p[1], left.zero), right.add(p[2], right.zero)) = (p[1], p[2])
    release thm tuple_equal_from_coordinates(p, (p[1], p[2]))
    p = (p[1], p[2])
    \product_add<A, B, left, right>(p, (left.zero, right.zero)) = (left.add(p[1], left.zero), right.add(p[2], right.zero)) = (p[1], p[2]) = p

thm product_nsmul_zero:
    ? forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>, p cart(A, B):
        \product_nsmul<A, B, left, right>(0, p) = (left.zero, right.zero)
    left.nsmul(0, p[1]) = left.zero
    right.nsmul(0, p[2]) = right.zero
    release thm cart_pair_extensionality(A, B, (left.nsmul(0, p[1]), right.nsmul(0, p[2])), (left.zero, right.zero))
    \product_nsmul<A, B, left, right>(0, p) = (left.nsmul(0, p[1]), right.nsmul(0, p[2])) = (left.zero, right.zero)

thm product_nsmul_successor:
    ? forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>, n N, p cart(A, B):
        \product_nsmul<A, B, left, right>(n + 1, p) = \product_add<A, B, left, right>(p, \product_nsmul<A, B, left, right>(n, p))
    left.nsmul(n + 1, p[1]) = left.add(p[1], left.nsmul(n, p[1]))
    right.nsmul(n + 1, p[2]) = right.add(p[2], right.nsmul(n, p[2]))
    release thm cart_pair_extensionality(A, B, (left.nsmul(n + 1, p[1]), right.nsmul(n + 1, p[2])), (left.add(p[1], left.nsmul(n, p[1])), right.add(p[2], right.nsmul(n, p[2]))))
    \product_nsmul<A, B, left, right>(n + 1, p) = (left.nsmul(n + 1, p[1]), right.nsmul(n + 1, p[2])) = (left.add(p[1], left.nsmul(n, p[1])), right.add(p[2], right.nsmul(n, p[2]))) = \product_add<A, B, left, right>(p, \product_nsmul<A, B, left, right>(n, p))

claim:
    ? forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>:
        (\product_add<A, B, left, right>, (left.zero, right.zero), \product_nsmul<A, B, left, right>) $in &AdditiveMonoidWithNSmul<cart(A, B)>
    claim:
        ? forall p, q, r cart(A, B):
            \product_add<A, B, left, right>(\product_add<A, B, left, right>(p, q), r) = \product_add<A, B, left, right>(p, \product_add<A, B, left, right>(q, r))
        release thm product_add_associative(A, B, left, right, p, q, r)
    claim:
        ? forall p cart(A, B):
            \product_add<A, B, left, right>((left.zero, right.zero), p) = p
        release thm product_add_left_identity(A, B, left, right, p)
    claim:
        ? forall p cart(A, B):
            \product_add<A, B, left, right>(p, (left.zero, right.zero)) = p
        release thm product_add_right_identity(A, B, left, right, p)
    claim:
        ? forall p cart(A, B):
            \product_nsmul<A, B, left, right>(0, p) = (left.zero, right.zero)
        release thm product_nsmul_zero(A, B, left, right, p)
    claim:
        ? forall n N, p cart(A, B):
            \product_nsmul<A, B, left, right>(n + 1, p) = \product_add<A, B, left, right>(p, \product_nsmul<A, B, left, right>(n, p))
        release thm product_nsmul_successor(A, B, left, right, n, p)
    \product_add<A, B, left, right> $in fn(p, q cart(A, B)) cart(A, B)
    left.zero $in A
    right.zero $in B
    release thm cart_member_from_coordinates((left.zero, right.zero), cart(A, B))
    \product_nsmul<A, B, left, right> $in fn(n N, p cart(A, B)) cart(A, B)
    release thm cart_member_from_coordinates((\product_add<A, B, left, right>, (left.zero, right.zero), \product_nsmul<A, B, left, right>), cart(fn(p, q cart(A, B)) cart(A, B), cart(A, B), fn(n N, p cart(A, B)) cart(A, B)))
    release thm struct_member((\product_add<A, B, left, right>, (left.zero, right.zero), \product_nsmul<A, B, left, right>), &AdditiveMonoidWithNSmul<cart(A, B)>)

template<A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>>:
    have product_additive_monoid_with_nsmul &AdditiveMonoidWithNSmul<cart(A, B)> = (\product_add<A, B, left, right>, (left.zero, right.zero), \product_nsmul<A, B, left, right>)


# 8.2 Morphisms

# isMonoidHom1/isMonoidHom2 collapse to one relation on an explicit candidate
# function. MonoidHom1 itself is the actual set of maps satisfying it.
prop is_monoid_hom(G, H nonempty_set, source &Monoid<G>, target &Monoid<H>, f fn(x G) H):
    f(source.one) = target.one
    forall x, y G:
        f(source.mul(x, y)) = target.mul(f(x), f(y))

template<G, H nonempty_set, source &Monoid<G>, target &Monoid<H>>:
    have MonoidHom set = {f fn(x G) H: $is_monoid_hom(G, H, source, target, f)}

prop is_additive_monoid_hom(G, H nonempty_set, source &AdditiveMonoid<G>, target &AdditiveMonoid<H>, f fn(x G) H):
    f(source.zero) = target.zero
    forall x, y G:
        f(source.add(x, y)) = target.add(f(x), f(y))

template<G, H nonempty_set, source &AdditiveMonoid<G>, target &AdditiveMonoid<H>>:
    have AdditiveMonoidHom set = {f fn(x G) H: $is_additive_monoid_hom(G, H, source, target, f)}

prop is_ring_hom(A, B nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<B>, f fn(x A) B):
    f(source.zero) = target.zero
    f(source.one) = target.one
    forall x, y A:
        f(source.add(x, y)) = target.add(f(x), f(y))
    forall x, y A:
        f(source.mul(x, y)) = target.mul(f(x), f(y))

template<A, B nonempty_set, source &chap2::Ring<A>, target &chap2::Ring<B>>:
    have RingHom set = {f fn(x A) B: $is_ring_hom(A, B, source, target, f)}

# Source lemma map_inv_of_inv. It is direct once the hom laws are explicit.
thm monoid_hom_maps_inverse_pair:
    ? forall SourceCarrier, TargetCarrier nonempty_set, source &Monoid<SourceCarrier>, target &Monoid<TargetCarrier>, f fn(x SourceCarrier) TargetCarrier, m, m_inverse SourceCarrier:
        $is_monoid_hom(SourceCarrier, TargetCarrier, source, target, f)
        source.mul(m, m_inverse) = source.one
        =>:
            target.mul(f(m), f(m_inverse)) = target.one
    f(source.mul(m, m_inverse)) = target.mul(f(m), f(m_inverse))
    f(source.one) = target.one
    f(source.mul(m, m_inverse)) = f(source.one) = target.one
    target.mul(f(m), f(m_inverse)) = f(source.mul(m, m_inverse)) = target.one

# MonoidHomClass1--3 and their coercion instances are alternate API wrappers
# around the three function spaces above and introduce no new mathematics.
# OrderPresHom and OrderPresMonoidHom are alternate hierarchy APIs outside this
# core slice.

# 8.3 Subobjects

prop is_submonoid(M nonempty_set, monoid &Monoid<M>, carrier power_set(M)):
    monoid.one $in carrier
    forall x, y carrier:
        monoid.mul(x, y) $in carrier

template<M nonempty_set, monoid &Monoid<M>>:
    have Submonoid set = {carrier power_set(M): $is_submonoid(M, monoid, carrier)}

thm submonoid_carrier_nonempty:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        =>:
            $is_nonempty_set(carrier)
    witness $is_nonempty_set(carrier) from monoid.one:
        monoid.one $in carrier

thm _inherited_submonoid_tuple_is_monoid:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), restricted_mul fn(x, y carrier) carrier:
        $is_nonempty_set(carrier)
        forall x, y carrier:
            restricted_mul(x, y) = monoid.mul(x, y)
        monoid.one $in carrier
        =>:
            (restricted_mul, monoid.one) $in &Monoid<carrier>
    claim:
        ? forall x, y, z carrier:
            restricted_mul(restricted_mul(x, y), z) = restricted_mul(x, restricted_mul(y, z))
        restricted_mul(x, y) = monoid.mul(x, y)
        restricted_mul(y, z) = monoid.mul(y, z)
        restricted_mul(restricted_mul(x, y), z) = monoid.mul(restricted_mul(x, y), z) = monoid.mul(monoid.mul(x, y), z) = monoid.mul(x, monoid.mul(y, z)) = monoid.mul(x, restricted_mul(y, z)) = restricted_mul(x, restricted_mul(y, z))
    by def $is_semigroup(carrier, restricted_mul)
    claim:
        ? forall x carrier:
            restricted_mul(monoid.one, x) = x
        restricted_mul(monoid.one, x) = monoid.mul(monoid.one, x) = x
    claim:
        ? forall x carrier:
            restricted_mul(x, monoid.one) = x
        restricted_mul(x, monoid.one) = monoid.mul(x, monoid.one) = x

# Source SubMonoid1Monoid instance. The restricted multiplication is named so
# its carrier is declaration-owned before the Monoid object is assembled.
template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $is_nonempty_set(carrier)>:
    have fn inherited_submonoid_mul(x, y carrier) carrier = monoid.mul(x, y)

thm _inherited_submonoid_mul_is_monoid:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        $is_nonempty_set(carrier)
        =>:
            (\inherited_submonoid_mul<M, monoid, carrier>, monoid.one) $in &Monoid<carrier>
    release thm _inherited_submonoid_tuple_is_monoid(M, monoid, carrier, \inherited_submonoid_mul<M, monoid, carrier>)

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $is_nonempty_set(carrier)>:
    have inherited_submonoid &Monoid<carrier> = (\inherited_submonoid_mul<M, monoid, carrier>, monoid.one)

thm submonoid_intersection_closed:
    ? forall M nonempty_set, monoid &Monoid<M>, left, right power_set(M):
        $is_submonoid(M, monoid, left)
        $is_submonoid(M, monoid, right)
        =>:
            $is_submonoid(M, monoid, {x M: x $in left and x $in right})
    monoid.one $in left
    monoid.one $in right
    release thm set_builder_member(monoid.one, {x M: x $in left and x $in right})
    monoid.one $in {x M: x $in left and x $in right}
    claim:
        ? forall x, y {x M: x $in left and x $in right}:
            monoid.mul(x, y) $in {z M: z $in left and z $in right}
        x $in left
        x $in right
        y $in left
        y $in right
        monoid.mul(x, y) $in left
        monoid.mul(x, y) $in right
        release thm set_builder_member(monoid.mul(x, y), {z M: z $in left and z $in right})
    by def:
        ? $is_submonoid(M, monoid, {x M: x $in left and x $in right})

# Source Submonoid.Setoid. The relation is correctly a prop because its
# candidate elements x and y are explicit parameters.
prop submonoid_fraction_equiv(M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M):
    exist w, z M st {w $in carrier, z $in carrier, monoid.mul(x, w) = monoid.mul(y, z)}

prop monoid_is_commutative(M nonempty_set, monoid &Monoid<M>):
    forall x, y M:
        monoid.mul(x, y) = monoid.mul(y, x)

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M)>:
    have fn fraction_class(x M) power_set(M) = {y M: $submonoid_fraction_equiv(M, monoid, carrier, x, y)}

prop is_fraction_class(M nonempty_set, monoid &Monoid<M>, carrier power_set(M), CarrierC power_set(M)):
    exist x M st {CarrierC = \fraction_class<M, monoid, carrier>(x)}

thm fraction_relation_reflexive:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x M:
        $is_submonoid(M, monoid, carrier)
        =>:
            $submonoid_fraction_equiv(M, monoid, carrier, x, x)
    witness $submonoid_fraction_equiv(M, monoid, carrier, x, x) from monoid.one, monoid.one

thm fraction_relation_symmetric:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M:
        $submonoid_fraction_equiv(M, monoid, carrier, x, y)
        =>:
            $submonoid_fraction_equiv(M, monoid, carrier, y, x)
    obtain w, z from $submonoid_fraction_equiv(M, monoid, carrier, x, y)
    witness $submonoid_fraction_equiv(M, monoid, carrier, y, x) from z, w

thm fraction_relation_transitive:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y, z M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        $submonoid_fraction_equiv(M, monoid, carrier, x, y)
        $submonoid_fraction_equiv(M, monoid, carrier, y, z)
        =>:
            $submonoid_fraction_equiv(M, monoid, carrier, x, z)
    thm function_substitution:
        ? forall A, B set, f fn(q A) B, u, v A:
            u = v
            =>:
                f(u) = f(v)
    obtain x_den, y_num from $submonoid_fraction_equiv(M, monoid, carrier, x, y)
    obtain y_den, z_num from exist w, q M st {w $in carrier, q $in carrier, monoid.mul(y, w) = monoid.mul(z, q)}
    have left_den M = monoid.mul(x_den, y_den)
    have right_num M = monoid.mul(y_num, z_num)
    monoid.mul(x_den, y_den) $in carrier
    monoid.mul(y_num, z_num) $in carrier
    left_den = monoid.mul(x_den, y_den)
    right_num = monoid.mul(y_num, z_num)
    left_den $in carrier
    right_num $in carrier
    monoid.mul(y_num, y_den) = monoid.mul(y_den, y_num)
    monoid.mul(z_num, y_num) = monoid.mul(y_num, z_num)
    release thm function_substitution(M, M, fn(q M) M {monoid.mul(y, q)}, monoid.mul(y_num, y_den), monoid.mul(y_den, y_num))
    release thm function_substitution(M, M, fn(q M) M {monoid.mul(z, q)}, monoid.mul(z_num, y_num), monoid.mul(y_num, z_num))
    monoid.mul(x, left_den) = monoid.mul(x, monoid.mul(x_den, y_den)) = monoid.mul(monoid.mul(x, x_den), y_den) = monoid.mul(monoid.mul(y, y_num), y_den) = monoid.mul(y, monoid.mul(y_num, y_den)) = monoid.mul(y, monoid.mul(y_den, y_num)) = monoid.mul(monoid.mul(y, y_den), y_num) = monoid.mul(monoid.mul(z, z_num), y_num) = monoid.mul(z, monoid.mul(z_num, y_num)) = monoid.mul(z, monoid.mul(y_num, z_num)) = monoid.mul(z, right_num)
    witness $submonoid_fraction_equiv(M, monoid, carrier, x, z) from left_den, right_num

# Source quotient constructor. The represented-class carrier becomes a genuine
# quotient only for a commutative monoid and a submonoid carrier.
template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient power_set(power_set(M)) = {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}

# Source QuotientMonoid.mk. Membership is exposed through the represented-class
# witness instead of being hidden behind a library quotient constructor.
thm fraction_class_in_quotient:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        =>:
            \fraction_class<M, monoid, carrier>(x) $in \fraction_quotient<M, monoid, carrier>
    \fraction_quotient<M, monoid, carrier> = {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}
    witness $is_fraction_class(M, monoid, carrier, \fraction_class<M, monoid, carrier>(x)) from x
    release thm set_builder_member(\fraction_class<M, monoid, carrier>(x), {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)})
    \fraction_class<M, monoid, carrier>(x) $in {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}

thm fraction_class_center_mem:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x M:
        $is_submonoid(M, monoid, carrier)
        =>:
            x $in \fraction_class<M, monoid, carrier>(x)
    \fraction_class<M, monoid, carrier>(x) = {y M: $submonoid_fraction_equiv(M, monoid, carrier, x, y)}
    release thm fraction_relation_reflexive(M, monoid, carrier, x)
    release thm set_builder_member(x, {y M: $submonoid_fraction_equiv(M, monoid, carrier, x, y)})
    x $in {y M: $submonoid_fraction_equiv(M, monoid, carrier, x, y)}

thm fraction_class_eq_of_mem:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        y $in \fraction_class<M, monoid, carrier>(x)
        =>:
            \fraction_class<M, monoid, carrier>(y) = \fraction_class<M, monoid, carrier>(x)
    \fraction_class<M, monoid, carrier>(x) = {z M: $submonoid_fraction_equiv(M, monoid, carrier, x, z)}
    \fraction_class<M, monoid, carrier>(y) = {z M: $submonoid_fraction_equiv(M, monoid, carrier, y, z)}
    $submonoid_fraction_equiv(M, monoid, carrier, x, y)
    claim:
        ? forall z \fraction_class<M, monoid, carrier>(y):
            z $in \fraction_class<M, monoid, carrier>(x)
        $submonoid_fraction_equiv(M, monoid, carrier, y, z)
        release thm fraction_relation_transitive(M, monoid, carrier, x, y, z)
        release thm set_builder_member(z, {q M: $submonoid_fraction_equiv(M, monoid, carrier, x, q)})
    by def:
        ? \fraction_class<M, monoid, carrier>(y) $subset \fraction_class<M, monoid, carrier>(x)
    claim:
        ? forall z \fraction_class<M, monoid, carrier>(x):
            z $in \fraction_class<M, monoid, carrier>(y)
        $submonoid_fraction_equiv(M, monoid, carrier, x, z)
        release thm fraction_relation_symmetric(M, monoid, carrier, x, y)
        $submonoid_fraction_equiv(M, monoid, carrier, y, x)
        release thm fraction_relation_transitive(M, monoid, carrier, y, x, z)
        release thm set_builder_member(z, {q M: $submonoid_fraction_equiv(M, monoid, carrier, y, q)})
    by def:
        ? \fraction_class<M, monoid, carrier>(x) $subset \fraction_class<M, monoid, carrier>(y)
    by extension:
        ? \fraction_class<M, monoid, carrier>(y) = \fraction_class<M, monoid, carrier>(x)

# A small, reusable commutative-monoid rearrangement isolates the algebraic
# normalization needed by multiplication on classes.
thm monoid_reorder_four:
    ? forall M nonempty_set, monoid &Monoid<M>, a, b, c, d M:
        $monoid_is_commutative(M, monoid)
        =>:
            monoid.mul(monoid.mul(a, b), monoid.mul(c, d)) = monoid.mul(monoid.mul(a, c), monoid.mul(b, d))
    monoid.mul(b, monoid.mul(c, d)) = monoid.mul(monoid.mul(b, c), d)
    monoid.mul(b, c) = monoid.mul(c, b)
    monoid.mul(monoid.mul(b, c), d) = monoid.mul(monoid.mul(c, b), d) = monoid.mul(c, monoid.mul(b, d))
    monoid.mul(monoid.mul(a, b), monoid.mul(c, d)) = monoid.mul(a, monoid.mul(b, monoid.mul(c, d))) = monoid.mul(a, monoid.mul(monoid.mul(b, c), d)) = monoid.mul(a, monoid.mul(monoid.mul(c, b), d)) = monoid.mul(a, monoid.mul(c, monoid.mul(b, d))) = monoid.mul(monoid.mul(a, c), monoid.mul(b, d))

thm fraction_class_mul_mem:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), a, b, x, y M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        x $in \fraction_class<M, monoid, carrier>(a)
        y $in \fraction_class<M, monoid, carrier>(b)
        =>:
            monoid.mul(x, y) $in \fraction_class<M, monoid, carrier>(monoid.mul(a, b))
    \fraction_class<M, monoid, carrier>(a) = {q M: $submonoid_fraction_equiv(M, monoid, carrier, a, q)}
    \fraction_class<M, monoid, carrier>(b) = {q M: $submonoid_fraction_equiv(M, monoid, carrier, b, q)}
    \fraction_class<M, monoid, carrier>(monoid.mul(a, b)) = {q M: $submonoid_fraction_equiv(M, monoid, carrier, monoid.mul(a, b), q)}
    $submonoid_fraction_equiv(M, monoid, carrier, a, x)
    $submonoid_fraction_equiv(M, monoid, carrier, b, y)
    obtain a_den, x_den from $submonoid_fraction_equiv(M, monoid, carrier, a, x)
    obtain b_den, y_den from $submonoid_fraction_equiv(M, monoid, carrier, b, y)
    monoid.mul(a_den, b_den) $in carrier
    monoid.mul(x_den, y_den) $in carrier
    have left_den M = monoid.mul(a_den, b_den)
    have right_den M = monoid.mul(x_den, y_den)
    left_den = monoid.mul(a_den, b_den)
    right_den = monoid.mul(x_den, y_den)
    left_den $in carrier
    right_den $in carrier
    release thm monoid_reorder_four(M, monoid, a, b, a_den, b_den)
    release thm monoid_reorder_four(M, monoid, x, x_den, y, y_den)
    monoid.mul(monoid.mul(a, b), left_den) = monoid.mul(monoid.mul(a, b), monoid.mul(a_den, b_den)) = monoid.mul(monoid.mul(a, a_den), monoid.mul(b, b_den)) = monoid.mul(monoid.mul(x, x_den), monoid.mul(y, y_den)) = monoid.mul(monoid.mul(x, y), monoid.mul(x_den, y_den)) = monoid.mul(monoid.mul(x, y), right_den)
    witness $submonoid_fraction_equiv(M, monoid, carrier, monoid.mul(a, b), monoid.mul(x, y)) from left_den, right_den
    release thm set_builder_member(monoid.mul(x, y), {q M: $submonoid_fraction_equiv(M, monoid, carrier, monoid.mul(a, b), q)})

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fn fraction_quotient_mk(x M) \fraction_quotient<M, monoid, carrier> = \fraction_class<M, monoid, carrier>(x)

thm fraction_quotient_nonempty:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        =>:
            $is_nonempty_set(\fraction_quotient<M, monoid, carrier>)
    witness $is_nonempty_set(\fraction_quotient<M, monoid, carrier>) from \fraction_class<M, monoid, carrier>(monoid.one):
        \fraction_class<M, monoid, carrier>(monoid.one) $in \fraction_quotient<M, monoid, carrier>

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient_carrier nonempty_set = \fraction_quotient<M, monoid, carrier>

# Quotient.map2 becomes a uniquely selected callable on represented classes.
# The proposition records its representatives explicitly, so well-definedness
# is visible and reusable rather than delegated to an external quotient API.
prop is_fraction_quotient_mul_value(M nonempty_set, monoid &Monoid<M>, carrier power_set(M), q, r, s power_set(M)):
    exist a, b M st {q = \fraction_class<M, monoid, carrier>(a), r = \fraction_class<M, monoid, carrier>(b), s = \fraction_class<M, monoid, carrier>(monoid.mul(a, b))}

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fn fraction_quotient_mul by exist!:
        ? forall q, r \fraction_quotient_carrier<M, monoid, carrier>:
            exist! s \fraction_quotient_carrier<M, monoid, carrier> st {$is_fraction_quotient_mul_value(M, monoid, carrier, q, r, s)}
        \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
        q $in \fraction_quotient<M, monoid, carrier>
        \fraction_quotient<M, monoid, carrier> = {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}
        q $in {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}
        $is_fraction_class(M, monoid, carrier, q)
        obtain a from $is_fraction_class(M, monoid, carrier, q)
        r $in \fraction_quotient<M, monoid, carrier>
        r $in {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}
        $is_fraction_class(M, monoid, carrier, r)
        obtain b from exist representative M st {r = \fraction_class<M, monoid, carrier>(representative)}
        release thm fraction_class_in_quotient(M, monoid, carrier, monoid.mul(a, b))
        \fraction_class<M, monoid, carrier>(monoid.mul(a, b)) $in \fraction_quotient<M, monoid, carrier>
        \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
        \fraction_class<M, monoid, carrier>(monoid.mul(a, b)) $in \fraction_quotient_carrier<M, monoid, carrier>
        have candidate \fraction_quotient_carrier<M, monoid, carrier> = \fraction_class<M, monoid, carrier>(monoid.mul(a, b))
        witness exist s \fraction_quotient_carrier<M, monoid, carrier> st {$is_fraction_quotient_mul_value(M, monoid, carrier, q, r, s)} from candidate:
            witness $is_fraction_quotient_mul_value(M, monoid, carrier, q, r, candidate) from a, b
        claim:
            ? forall s1, s2 \fraction_quotient_carrier<M, monoid, carrier>:
                $is_fraction_quotient_mul_value(M, monoid, carrier, q, r, s1)
                $is_fraction_quotient_mul_value(M, monoid, carrier, q, r, s2)
                =>:
                    s1 = s2
            obtain a1, b1 from $is_fraction_quotient_mul_value(M, monoid, carrier, q, r, s1)
            obtain a2, b2 from $is_fraction_quotient_mul_value(M, monoid, carrier, q, r, s2)
            release thm fraction_class_center_mem(M, monoid, carrier, a2)
            a2 $in \fraction_class<M, monoid, carrier>(a2)
            \fraction_class<M, monoid, carrier>(a2) = q = \fraction_class<M, monoid, carrier>(a1)
            a2 $in \fraction_class<M, monoid, carrier>(a1)
            release thm fraction_class_center_mem(M, monoid, carrier, b2)
            b2 $in \fraction_class<M, monoid, carrier>(b2)
            \fraction_class<M, monoid, carrier>(b2) = r = \fraction_class<M, monoid, carrier>(b1)
            b2 $in \fraction_class<M, monoid, carrier>(b1)
            release thm fraction_class_mul_mem(M, monoid, carrier, a1, b1, a2, b2)
            monoid.mul(a2, b2) $in \fraction_class<M, monoid, carrier>(monoid.mul(a1, b1))
            release thm fraction_class_eq_of_mem(M, monoid, carrier, monoid.mul(a1, b1), monoid.mul(a2, b2))
            \fraction_class<M, monoid, carrier>(monoid.mul(a2, b2)) = \fraction_class<M, monoid, carrier>(monoid.mul(a1, b1))
            s2 = \fraction_class<M, monoid, carrier>(monoid.mul(a2, b2)) = \fraction_class<M, monoid, carrier>(monoid.mul(a1, b1)) = s1

thm fraction_quotient_mul_mk:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        =>:
            \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y)) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, y))
    $is_fraction_quotient_mul_value(M, monoid, carrier, \fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y), \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y)))
    obtain x1, y1 from exist a, b M st {\fraction_quotient_mk<M, monoid, carrier>(x) = \fraction_class<M, monoid, carrier>(a), \fraction_quotient_mk<M, monoid, carrier>(y) = \fraction_class<M, monoid, carrier>(b), \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y)) = \fraction_class<M, monoid, carrier>(monoid.mul(a, b))}
    release thm fraction_class_center_mem(M, monoid, carrier, x)
    x $in \fraction_class<M, monoid, carrier>(x)
    \fraction_class<M, monoid, carrier>(x) = \fraction_quotient_mk<M, monoid, carrier>(x) = \fraction_class<M, monoid, carrier>(x1)
    x $in \fraction_class<M, monoid, carrier>(x1)
    release thm fraction_class_center_mem(M, monoid, carrier, y)
    y $in \fraction_class<M, monoid, carrier>(y)
    \fraction_class<M, monoid, carrier>(y) = \fraction_quotient_mk<M, monoid, carrier>(y) = \fraction_class<M, monoid, carrier>(y1)
    y $in \fraction_class<M, monoid, carrier>(y1)
    release thm fraction_class_mul_mem(M, monoid, carrier, x1, y1, x, y)
    monoid.mul(x, y) $in \fraction_class<M, monoid, carrier>(monoid.mul(x1, y1))
    release thm fraction_class_eq_of_mem(M, monoid, carrier, monoid.mul(x1, y1), monoid.mul(x, y))
    \fraction_class<M, monoid, carrier>(monoid.mul(x, y)) = \fraction_class<M, monoid, carrier>(monoid.mul(x1, y1))
    \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y)) = \fraction_class<M, monoid, carrier>(monoid.mul(x1, y1)) = \fraction_class<M, monoid, carrier>(monoid.mul(x, y)) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, y))

thm fraction_quotient_has_mk_preimage:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier, q power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        q $in \fraction_quotient_carrier<M, monoid, carrier>
        =>:
            exist x M st {q = \fraction_quotient_mk<M, monoid, carrier>(x)}
    \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
    q $in \fraction_quotient<M, monoid, carrier>
    \fraction_quotient<M, monoid, carrier> = {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}
    q $in {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}
    $is_fraction_class(M, monoid, carrier, q)
    obtain representative from $is_fraction_class(M, monoid, carrier, q)
    \fraction_quotient_mk<M, monoid, carrier>(representative) = \fraction_class<M, monoid, carrier>(representative)
    witness exist x M st {q = \fraction_quotient_mk<M, monoid, carrier>(x)} from representative

thm fraction_quotient_mul_of_representatives:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier, q, r power_set(M), x, y M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        q $in \fraction_quotient_carrier<M, monoid, carrier>
        r $in \fraction_quotient_carrier<M, monoid, carrier>
        q = \fraction_quotient_mk<M, monoid, carrier>(x)
        r = \fraction_quotient_mk<M, monoid, carrier>(y)
        =>:
            \fraction_quotient_mul<M, monoid, carrier>(q, r) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, y))
    thm object_substitution:
        ? forall A, B set, f fn(t A) B, u, v A:
            u = v
            =>:
                f(u) = f(v)
    release thm object_substitution(\fraction_quotient_carrier<M, monoid, carrier>, \fraction_quotient_carrier<M, monoid, carrier>, fn(t \fraction_quotient_carrier<M, monoid, carrier>) \fraction_quotient_carrier<M, monoid, carrier> {\fraction_quotient_mul<M, monoid, carrier>(t, r)}, q, \fraction_quotient_mk<M, monoid, carrier>(x))
    release thm object_substitution(\fraction_quotient_carrier<M, monoid, carrier>, \fraction_quotient_carrier<M, monoid, carrier>, fn(t \fraction_quotient_carrier<M, monoid, carrier>) \fraction_quotient_carrier<M, monoid, carrier> {\fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), t)}, r, \fraction_quotient_mk<M, monoid, carrier>(y))
    release thm fraction_quotient_mul_mk(M, monoid, carrier, x, y)
    \fraction_quotient_mul<M, monoid, carrier>(q, r) = \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), r) = \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y)) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, y))

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient_one \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient_mk<M, monoid, carrier>(monoid.one)

# Quotient laws are proved by selecting representatives and reducing each law
# to the corresponding law in the source monoid.
thm fraction_quotient_mul_associative:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), q, r, s power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        q $in \fraction_quotient_carrier<M, monoid, carrier>
        r $in \fraction_quotient_carrier<M, monoid, carrier>
        s $in \fraction_quotient_carrier<M, monoid, carrier>
        =>:
            \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mul<M, monoid, carrier>(q, r), s) = \fraction_quotient_mul<M, monoid, carrier>(q, \fraction_quotient_mul<M, monoid, carrier>(r, s))
    \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
    release thm fraction_quotient_has_mk_preimage(M, monoid, carrier, q)
    obtain x from exist a M st {q = \fraction_quotient_mk<M, monoid, carrier>(a)}
    release thm fraction_quotient_has_mk_preimage(M, monoid, carrier, r)
    obtain y from exist a M st {r = \fraction_quotient_mk<M, monoid, carrier>(a)}
    release thm fraction_quotient_has_mk_preimage(M, monoid, carrier, s)
    obtain z from exist a M st {s = \fraction_quotient_mk<M, monoid, carrier>(a)}
    have qr \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient_mul<M, monoid, carrier>(q, r)
    qr $in \fraction_quotient<M, monoid, carrier>
    release thm fraction_quotient_mul_of_representatives(M, monoid, carrier, q, r, x, y)
    qr = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, y))
    release thm fraction_quotient_mul_of_representatives(M, monoid, carrier, qr, s, monoid.mul(x, y), z)
    have rs \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient_mul<M, monoid, carrier>(r, s)
    rs $in \fraction_quotient<M, monoid, carrier>
    release thm fraction_quotient_mul_of_representatives(M, monoid, carrier, r, s, y, z)
    rs = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(y, z))
    release thm fraction_quotient_mul_of_representatives(M, monoid, carrier, q, rs, x, monoid.mul(y, z))
    monoid.mul(monoid.mul(x, y), z) = monoid.mul(x, monoid.mul(y, z))
    \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mul<M, monoid, carrier>(q, r), s) = \fraction_quotient_mul<M, monoid, carrier>(qr, s) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(monoid.mul(x, y), z)) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, monoid.mul(y, z))) = \fraction_quotient_mul<M, monoid, carrier>(q, rs) = \fraction_quotient_mul<M, monoid, carrier>(q, \fraction_quotient_mul<M, monoid, carrier>(r, s))

thm fraction_quotient_mul_left_identity:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), q power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        q $in \fraction_quotient_carrier<M, monoid, carrier>
        =>:
            \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_one<M, monoid, carrier>, q) = q
    \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
    \fraction_quotient_one<M, monoid, carrier> $in \fraction_quotient<M, monoid, carrier>
    release thm fraction_quotient_has_mk_preimage(M, monoid, carrier, q)
    obtain x from exist a M st {q = \fraction_quotient_mk<M, monoid, carrier>(a)}
    release thm fraction_quotient_mul_of_representatives(M, monoid, carrier, \fraction_quotient_one<M, monoid, carrier>, q, monoid.one, x)
    monoid.mul(monoid.one, x) = x
    \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_one<M, monoid, carrier>, q) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(monoid.one, x)) = \fraction_quotient_mk<M, monoid, carrier>(x) = q

thm fraction_quotient_mul_right_identity:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), q power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        q $in \fraction_quotient_carrier<M, monoid, carrier>
        =>:
            \fraction_quotient_mul<M, monoid, carrier>(q, \fraction_quotient_one<M, monoid, carrier>) = q
    \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
    \fraction_quotient_one<M, monoid, carrier> $in \fraction_quotient<M, monoid, carrier>
    release thm fraction_quotient_has_mk_preimage(M, monoid, carrier, q)
    obtain x from exist a M st {q = \fraction_quotient_mk<M, monoid, carrier>(a)}
    release thm fraction_quotient_mul_of_representatives(M, monoid, carrier, q, \fraction_quotient_one<M, monoid, carrier>, x, monoid.one)
    monoid.mul(x, monoid.one) = x
    \fraction_quotient_mul<M, monoid, carrier>(q, \fraction_quotient_one<M, monoid, carrier>) = \fraction_quotient_mk<M, monoid, carrier>(monoid.mul(x, monoid.one)) = \fraction_quotient_mk<M, monoid, carrier>(x) = q

thm fraction_quotient_tuple_is_monoid:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        =>:
            (\fraction_quotient_mul<M, monoid, carrier>, \fraction_quotient_one<M, monoid, carrier>) $in &Monoid<\fraction_quotient_carrier<M, monoid, carrier>>
    \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient<M, monoid, carrier>
    claim:
        ? forall q, r, s \fraction_quotient_carrier<M, monoid, carrier>:
            \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mul<M, monoid, carrier>(q, r), s) = \fraction_quotient_mul<M, monoid, carrier>(q, \fraction_quotient_mul<M, monoid, carrier>(r, s))
        q $in \fraction_quotient<M, monoid, carrier>
        r $in \fraction_quotient<M, monoid, carrier>
        s $in \fraction_quotient<M, monoid, carrier>
        release thm fraction_quotient_mul_associative(M, monoid, carrier, q, r, s)
    claim:
        ? forall q \fraction_quotient_carrier<M, monoid, carrier>:
            \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_one<M, monoid, carrier>, q) = q
        q $in \fraction_quotient<M, monoid, carrier>
        release thm fraction_quotient_mul_left_identity(M, monoid, carrier, q)
    claim:
        ? forall q \fraction_quotient_carrier<M, monoid, carrier>:
            \fraction_quotient_mul<M, monoid, carrier>(q, \fraction_quotient_one<M, monoid, carrier>) = q
        q $in \fraction_quotient<M, monoid, carrier>
        release thm fraction_quotient_mul_right_identity(M, monoid, carrier, q)
    by def:
        ? $is_semigroup(\fraction_quotient_carrier<M, monoid, carrier>, \fraction_quotient_mul<M, monoid, carrier>)
    \fraction_quotient_mul<M, monoid, carrier> $in fn(q, r \fraction_quotient_carrier<M, monoid, carrier>) \fraction_quotient_carrier<M, monoid, carrier>
    \fraction_quotient_one<M, monoid, carrier> $in \fraction_quotient_carrier<M, monoid, carrier>
    release thm cart_member_from_coordinates((\fraction_quotient_mul<M, monoid, carrier>, \fraction_quotient_one<M, monoid, carrier>), cart(fn(q, r \fraction_quotient_carrier<M, monoid, carrier>) \fraction_quotient_carrier<M, monoid, carrier>, \fraction_quotient_carrier<M, monoid, carrier>))
    release thm struct_member((\fraction_quotient_mul<M, monoid, carrier>, \fraction_quotient_one<M, monoid, carrier>), &Monoid<\fraction_quotient_carrier<M, monoid, carrier>>)

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient_monoid &Monoid<\fraction_quotient_carrier<M, monoid, carrier>> = (\fraction_quotient_mul<M, monoid, carrier>, \fraction_quotient_one<M, monoid, carrier>)
