# Chapter 8 — Hierarchies
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter translates mathematical interfaces, not Lean's elaborator
# mechanics. Repeated class-extension, coercion, outParam, and to_additive
# presentations are collapsed when they expose the same data and laws. Actual
# structures remain records or sets of callable maps; only properties of
# explicit candidates are props. The source's order hierarchy and
# order-preserving-hom presentation variants are outside this core slice.

# 8.1 Basics

# One1/One2 and Dia1 are one-field carrier-dependent interfaces. Their data are
# preserved below as the `one` and `mul` fields of actual Monoid/Group records;
# no one-field object is misrepresented as a proposition.
prop is_semigroup(s nonempty_set, mul fn(x, y s) s):
    forall x, y, z s:
        mul(mul(x, y), z) = mul(x, mul(y, z))

struct Monoid<s nonempty_set>:
    mul fn(x, y s) s
    one s
    <=>:
        $is_semigroup(s, mul)
        forall x s:
            mul(one, x) = x
            mul(x, one) = x

# This source hierarchy assumes both identity directions as primitive laws,
# unlike Chapter 2's left-facing canonical Group interface.
struct TwoSidedGroup<s nonempty_set>:
    mul fn(x, y s) s
    one s
    inv fn(x s) s
    <=>:
        $is_semigroup(s, mul)
        forall x s:
            mul(one, x) = x
            mul(x, one) = x
            mul(inv(x), x) = one

# Source lemma left_inv_eq_right_inv1.
thm monoid_left_inverse_unique:
    ? forall s nonempty_set, monoid &Monoid<s>, a, b, c s:
        &Monoid<s>{monoid}.mul(b, a) = &Monoid<s>{monoid}.one
        &Monoid<s>{monoid}.mul(a, c) = &Monoid<s>{monoid}.one
        =>:
            b = c
    b = &Monoid<s>{monoid}.mul(b, &Monoid<s>{monoid}.one) = &Monoid<s>{monoid}.mul(b, &Monoid<s>{monoid}.mul(a, c)) = &Monoid<s>{monoid}.mul(&Monoid<s>{monoid}.mul(b, a), c) = &Monoid<s>{monoid}.mul(&Monoid<s>{monoid}.one, c) = c

# Source lemma inv_eq_of_dia.
thm group_inverse_eq_of_right_inverse:
    ? forall s nonempty_set, group &TwoSidedGroup<s>, a, b s:
        &TwoSidedGroup<s>{group}.mul(a, b) = &TwoSidedGroup<s>{group}.one
        =>:
            &TwoSidedGroup<s>{group}.inv(a) = b
    &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.inv(a), a) = &TwoSidedGroup<s>{group}.one
    &TwoSidedGroup<s>{group}.inv(a) = &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.inv(a), &TwoSidedGroup<s>{group}.one) = &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.inv(a), &TwoSidedGroup<s>{group}.mul(a, b)) = &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.inv(a), a), b) = &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.one, b) = b

# Source lemma dia_inv. It is a fact about every Group object, not a new prop.
thm group_right_inverse:
    ? forall s nonempty_set, group &TwoSidedGroup<s>, a s:
        &TwoSidedGroup<s>{group}.mul(a, &TwoSidedGroup<s>{group}.inv(a)) = &TwoSidedGroup<s>{group}.one
    by thm group_inverse_eq_of_right_inverse(s, group, &TwoSidedGroup<s>{group}.inv(a), a)
    &TwoSidedGroup<s>{group}.inv(&TwoSidedGroup<s>{group}.inv(a)) = a
    &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.inv(&TwoSidedGroup<s>{group}.inv(a)), &TwoSidedGroup<s>{group}.inv(a)) = &TwoSidedGroup<s>{group}.one
    &TwoSidedGroup<s>{group}.mul(a, &TwoSidedGroup<s>{group}.inv(a)) = &TwoSidedGroup<s>{group}.mul(&TwoSidedGroup<s>{group}.inv(&TwoSidedGroup<s>{group}.inv(a)), &TwoSidedGroup<s>{group}.inv(a)) = &TwoSidedGroup<s>{group}.one

# AddSemigroup3 through AddCommGroup3 are the additive branch of the hierarchy.
struct AdditiveMonoid<s nonempty_set>:
    add fn(x, y s) s
    zero s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
            add(x, zero) = x

struct AdditiveGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
            add(x, zero) = x
            add(neg(x), x) = zero

prop is_additive_commutative_group(s nonempty_set, add fn(x, y s) s, zero s, neg fn(x s) s):
    forall x, y, z s:
        add(add(x, y), z) = add(x, add(y, z))
    forall x, y s:
        add(x, y) = add(y, x)
    forall x s:
        add(zero, x) = x
        add(x, zero) = x
        add(neg(x), x) = zero

struct AdditiveCommutativeGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        $is_additive_commutative_group(s, add, zero, neg)

# Source instance: every Ring3 has commutative addition. Chapter 2's canonical
# Ring already exposes this law through its flat additive-group interface.
thm ring_add_comm:
    ? forall Carrier nonempty_set, ring &MILAlternative::chap2_struct::Ring<Carrier>, x, y Carrier:
        &MILAlternative::chap2_struct::Ring<Carrier>{ring}.add(x, y) = &MILAlternative::chap2_struct::Ring<Carrier>{ring}.add(y, x)

# Source instance Ring₃ ℤ. Chapter 2 owns the canonical flat Ring interface,
# so this hierarchy example constructs that record instead of redeclaring it.
thm integer_ring_laws:
    ? forall anchor {0}:
        $MILAlternative::chap2_struct::ring_laws(Z, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1)
    claim:
        ? forall x, y, z Z:
            fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
            fn(a, b Z) Z {a + b}(x, y) = fn(a, b Z) Z {a + b}(y, x)
        fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = (x + y) + z = x + (y + z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
        fn(a, b Z) Z {a + b}(x, y) = x + y = y + x = fn(a, b Z) Z {a + b}(y, x)
    claim:
        ? forall x Z:
            fn(a, b Z) Z {a + b}(0, x) = x
            fn(a, b Z) Z {a + b}(x, 0) = x
            fn(a Z) Z {-a}(x) + x = 0
        fn(a, b Z) Z {a + b}(0, x) = 0 + x = x
        fn(a, b Z) Z {a + b}(x, 0) = x + 0 = x
        fn(a Z) Z {-a}(x) + x = -x + x = 0
    by def:
        ? $MILAlternative::chap2_struct::additive_commutative_group_laws(Z, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x})
    claim:
        ? forall x, y, z Z:
            fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a * b}(x, y), z) = fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a * b}(y, z))
            fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a + b}(y, z)) = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, y), fn(a, b Z) Z {a * b}(x, z))
            fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a + b}(x, y), z) = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, z), fn(a, b Z) Z {a * b}(y, z))
        fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a * b}(x, y), z) = (x * y) * z = x * (y * z) = fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a * b}(y, z))
        fn(a, b Z) Z {a * b}(x, fn(a, b Z) Z {a + b}(y, z)) = x * (y + z) = x * y + x * z = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, y), fn(a, b Z) Z {a * b}(x, z))
        fn(a, b Z) Z {a * b}(fn(a, b Z) Z {a + b}(x, y), z) = (x + y) * z = x * z + y * z = fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a * b}(x, z), fn(a, b Z) Z {a * b}(y, z))
    claim:
        ? forall x Z:
            fn(a, b Z) Z {a * b}(1, x) = x
            fn(a, b Z) Z {a * b}(x, 1) = x
        fn(a, b Z) Z {a * b}(1, x) = 1 * x = x
        fn(a, b Z) Z {a * b}(x, 1) = x * 1 = x
    by def:
        ? $MILAlternative::chap2_struct::ring_laws(Z, fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1)

by thm integer_ring_laws(0)
by thm fn_set_member(fn(x, y Z) Z {x + y}, fn(x, y Z) Z)
0 $in Z
by thm fn_set_member(fn(x Z) Z {-x}, fn(x Z) Z)
by thm fn_set_member(fn(x, y Z) Z {x * y}, fn(x, y Z) Z)
1 $in Z
by thm cart_member_from_coordinates((fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1), cart(fn(x, y Z) Z, Z, fn(x Z) Z, fn(x, y Z) Z, Z))
by thm struct_member((fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1), &MILAlternative::chap2_struct::Ring<Z>)
have integer_ring &MILAlternative::chap2_struct::Ring<Z> = (fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1)

# The source's LE1/Preorder1/PartialOrder1/OrderedCommMonoid1 block is an
# alternate hierarchy presentation and is outside this core slice.

prop is_module(Scalar, M nonempty_set, scalar_add fn(x, y Scalar) Scalar, scalar_zero Scalar, scalar_neg fn(x Scalar) Scalar, scalar_mul fn(x, y Scalar) Scalar, scalar_one Scalar, add fn(x, y M) M, zero M, neg fn(x M) M, smul fn(r Scalar, m M) M):
    $MILAlternative::chap2_struct::ring_laws(Scalar, scalar_add, scalar_zero, scalar_neg, scalar_mul, scalar_one)
    $is_additive_commutative_group(M, add, zero, neg)
    forall m M:
        smul(scalar_zero, m) = zero
        smul(scalar_one, m) = m
    forall a, b Scalar, m M:
        smul(scalar_mul(a, b), m) = smul(a, smul(b, m))
        smul(scalar_add(a, b), m) = add(smul(a, m), smul(b, m))
    forall a Scalar, m, n M:
        smul(a, add(m, n)) = add(smul(a, m), smul(a, n))

struct Module<Scalar, M nonempty_set>:
    scalar_add fn(x, y Scalar) Scalar
    scalar_zero Scalar
    scalar_neg fn(x Scalar) Scalar
    scalar_mul fn(x, y Scalar) Scalar
    scalar_one Scalar
    add fn(x, y M) M
    zero M
    neg fn(x M) M
    smul fn(r Scalar, m M) M
    <=>:
        $is_module(Scalar, M, scalar_add, scalar_zero, scalar_neg, scalar_mul, scalar_one, add, zero, neg, smul)

# Source selfModule. The object reuses the ring operations and takes scalar
# multiplication to be multiplication. Proof debt is the exact structure
# membership bridge; the underlying ring laws are already stored in ring.
trust forall Carrier nonempty_set, ring &MILAlternative::chap2_struct::Ring<Carrier>:
    (&MILAlternative::chap2_struct::Ring<Carrier>{ring}.add, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.zero, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.neg, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.mul, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.one, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.add, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.zero, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.neg, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.mul) $in &Module<Carrier, Carrier>

template<Carrier nonempty_set, ring &MILAlternative::chap2_struct::Ring<Carrier>>:
    have self_module &Module<Carrier, Carrier> = (&MILAlternative::chap2_struct::Ring<Carrier>{ring}.add, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.zero, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.neg, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.mul, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.one, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.add, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.zero, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.neg, &MILAlternative::chap2_struct::Ring<Carrier>{ring}.mul)

# Source definitions nsmul1 and zsmul1. Litex has no generic recursive
# function constructor over an arbitrary additive carrier, so the two callable
# selections and their computation equations are explicit proof debt.
template<Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>>:
    trust have additive_nsmul fn(n N, x Carrier) Carrier

trust forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, x Carrier:
    \additive_nsmul<Carrier, group>(0, x) = &AdditiveCommutativeGroup<Carrier>{group}.zero
trust forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
    \additive_nsmul<Carrier, group>(n + 1, x) = &AdditiveCommutativeGroup<Carrier>{group}.add(x, \additive_nsmul<Carrier, group>(n, x))

template<Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>>:
    trust have additive_zsmul fn(n Z, x Carrier) Carrier

trust forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
    \additive_zsmul<Carrier, group>(n, x) = \additive_nsmul<Carrier, group>(n, x)
trust forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>, n N, x Carrier:
    \additive_zsmul<Carrier, group>(-(n + 1), x) = &AdditiveCommutativeGroup<Carrier>{group}.neg(\additive_nsmul<Carrier, group>(n + 1, x))

# Source abGrpModule. The integer action remains callable; its module-law
# package is localized proof debt around the selected recursive action.
trust forall Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>:
    (fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1, &AdditiveCommutativeGroup<Carrier>{group}.add, &AdditiveCommutativeGroup<Carrier>{group}.zero, &AdditiveCommutativeGroup<Carrier>{group}.neg, \additive_zsmul<Carrier, group>) $in &Module<Z, Carrier>

template<Carrier nonempty_set, group &AdditiveCommutativeGroup<Carrier>>:
    have integer_module &Module<Z, Carrier> = (fn(x, y Z) Z {x + y}, 0, fn(x Z) Z {-x}, fn(x, y Z) Z {x * y}, 1, &AdditiveCommutativeGroup<Carrier>{group}.add, &AdditiveCommutativeGroup<Carrier>{group}.zero, &AdditiveCommutativeGroup<Carrier>{group}.neg, \additive_zsmul<Carrier, group>)

# AddMonoid4 makes the natural scalar function a customizable data field.
struct AdditiveMonoidWithNSmul<s nonempty_set>:
    add fn(x, y s) s
    zero s
    nsmul fn(n N, x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
            add(x, zero) = x
            nsmul(0, x) = zero
        forall n N, x s:
            nsmul(n + 1, x) = add(x, nsmul(n, x))

# Source instance AddMonoid4 Z. Integer addition, zero, and multiplication by
# a natural scalar satisfy the customized scalar laws directly.
thm integer_additive_monoid_with_nsmul_closed:
    ? forall anchor {0}:
        (fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x}) $in &AdditiveMonoidWithNSmul<Z>
    claim:
        ? forall x, y, z Z:
            fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
        fn(a, b Z) Z {a + b}(fn(a, b Z) Z {a + b}(x, y), z) = (x + y) + z = x + (y + z) = fn(a, b Z) Z {a + b}(x, fn(a, b Z) Z {a + b}(y, z))
    claim:
        ? forall x Z:
            fn(a, b Z) Z {a + b}(0, x) = x
            fn(a, b Z) Z {a + b}(x, 0) = x
            fn(n N, a Z) Z {n * a}(0, x) = 0
        fn(a, b Z) Z {a + b}(0, x) = 0 + x = x
        fn(a, b Z) Z {a + b}(x, 0) = x + 0 = x
        fn(n N, a Z) Z {n * a}(0, x) = 0 * x = 0
    claim:
        ? forall n N, x Z:
            fn(k N, a Z) Z {k * a}(n + 1, x) = fn(a, b Z) Z {a + b}(x, fn(k N, a Z) Z {k * a}(n, x))
        fn(k N, a Z) Z {k * a}(n + 1, x) = (n + 1) * x = x + n * x = fn(a, b Z) Z {a + b}(x, fn(k N, a Z) Z {k * a}(n, x))
    by thm fn_set_member(fn(x, y Z) Z {x + y}, fn(x, y Z) Z)
    0 $in Z
    by thm fn_set_member(fn(n N, x Z) Z {n * x}, fn(n N, x Z) Z)
    by thm cart_member_from_coordinates((fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x}), cart(fn(x, y Z) Z, Z, fn(n N, x Z) Z))
    by thm struct_member((fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x}), &AdditiveMonoidWithNSmul<Z>)

by thm integer_additive_monoid_with_nsmul_closed(0)
have integer_additive_monoid_with_nsmul &AdditiveMonoidWithNSmul<Z> = (fn(x, y Z) Z {x + y}, 0, fn(n N, x Z) Z {n * x})

# Source product instance for AddMonoid4. Addition, zero, and natural scalar
# multiplication are componentwise. The structure is kept as a callable
# parameterized object; its coordinatewise law package remains explicit debt.
trust forall A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>:
    (fn(p, q cart(A, B)) cart(A, B) {(&AdditiveMonoidWithNSmul<A>{left}.add(p[1], q[1]), &AdditiveMonoidWithNSmul<B>{right}.add(p[2], q[2]))}, (&AdditiveMonoidWithNSmul<A>{left}.zero, &AdditiveMonoidWithNSmul<B>{right}.zero), fn(n N, p cart(A, B)) cart(A, B) {(&AdditiveMonoidWithNSmul<A>{left}.nsmul(n, p[1]), &AdditiveMonoidWithNSmul<B>{right}.nsmul(n, p[2]))}) $in &AdditiveMonoidWithNSmul<cart(A, B)>

template<A, B nonempty_set, left &AdditiveMonoidWithNSmul<A>, right &AdditiveMonoidWithNSmul<B>>:
    have product_additive_monoid_with_nsmul &AdditiveMonoidWithNSmul<cart(A, B)> = (fn(p, q cart(A, B)) cart(A, B) {(&AdditiveMonoidWithNSmul<A>{left}.add(p[1], q[1]), &AdditiveMonoidWithNSmul<B>{right}.add(p[2], q[2]))}, (&AdditiveMonoidWithNSmul<A>{left}.zero, &AdditiveMonoidWithNSmul<B>{right}.zero), fn(n N, p cart(A, B)) cart(A, B) {(&AdditiveMonoidWithNSmul<A>{left}.nsmul(n, p[1]), &AdditiveMonoidWithNSmul<B>{right}.nsmul(n, p[2]))})

# 8.2 Morphisms

# isMonoidHom1/isMonoidHom2 collapse to one relation on an explicit candidate
# function. MonoidHom1 itself is the actual set of maps satisfying it.
prop is_monoid_hom(G, H nonempty_set, source &Monoid<G>, target &Monoid<H>, f fn(x G) H):
    f(&Monoid<G>{source}.one) = &Monoid<H>{target}.one
    forall x, y G:
        f(&Monoid<G>{source}.mul(x, y)) = &Monoid<H>{target}.mul(f(x), f(y))

template<G, H nonempty_set, source &Monoid<G>, target &Monoid<H>>:
    have MonoidHom set = {f fn(x G) H: $is_monoid_hom(G, H, source, target, f)}

prop is_additive_monoid_hom(G, H nonempty_set, source &AdditiveMonoid<G>, target &AdditiveMonoid<H>, f fn(x G) H):
    f(&AdditiveMonoid<G>{source}.zero) = &AdditiveMonoid<H>{target}.zero
    forall x, y G:
        f(&AdditiveMonoid<G>{source}.add(x, y)) = &AdditiveMonoid<H>{target}.add(f(x), f(y))

template<G, H nonempty_set, source &AdditiveMonoid<G>, target &AdditiveMonoid<H>>:
    have AdditiveMonoidHom set = {f fn(x G) H: $is_additive_monoid_hom(G, H, source, target, f)}

prop is_ring_hom(A, B nonempty_set, source &MILAlternative::chap2_struct::Ring<A>, target &MILAlternative::chap2_struct::Ring<B>, f fn(x A) B):
    f(&MILAlternative::chap2_struct::Ring<A>{source}.zero) = &MILAlternative::chap2_struct::Ring<B>{target}.zero
    f(&MILAlternative::chap2_struct::Ring<A>{source}.one) = &MILAlternative::chap2_struct::Ring<B>{target}.one
    forall x, y A:
        f(&MILAlternative::chap2_struct::Ring<A>{source}.add(x, y)) = &MILAlternative::chap2_struct::Ring<B>{target}.add(f(x), f(y))
        f(&MILAlternative::chap2_struct::Ring<A>{source}.mul(x, y)) = &MILAlternative::chap2_struct::Ring<B>{target}.mul(f(x), f(y))

template<A, B nonempty_set, source &MILAlternative::chap2_struct::Ring<A>, target &MILAlternative::chap2_struct::Ring<B>>:
    have RingHom set = {f fn(x A) B: $is_ring_hom(A, B, source, target, f)}

# Source lemma map_inv_of_inv. It is direct once the hom laws are explicit.
thm monoid_hom_maps_inverse_pair:
    ? forall SourceCarrier, TargetCarrier nonempty_set, source &Monoid<SourceCarrier>, target &Monoid<TargetCarrier>, f fn(x SourceCarrier) TargetCarrier, m, m_inverse SourceCarrier:
        $is_monoid_hom(SourceCarrier, TargetCarrier, source, target, f)
        &Monoid<SourceCarrier>{source}.mul(m, m_inverse) = &Monoid<SourceCarrier>{source}.one
        =>:
            &Monoid<TargetCarrier>{target}.mul(f(m), f(m_inverse)) = &Monoid<TargetCarrier>{target}.one
    f(&Monoid<SourceCarrier>{source}.mul(m, m_inverse)) = &Monoid<TargetCarrier>{target}.mul(f(m), f(m_inverse))
    f(&Monoid<SourceCarrier>{source}.one) = &Monoid<TargetCarrier>{target}.one
    f(&Monoid<SourceCarrier>{source}.mul(m, m_inverse)) = f(&Monoid<SourceCarrier>{source}.one) = &Monoid<TargetCarrier>{target}.one
    &Monoid<TargetCarrier>{target}.mul(f(m), f(m_inverse)) = f(&Monoid<SourceCarrier>{source}.mul(m, m_inverse)) = &Monoid<TargetCarrier>{target}.one

# MonoidHomClass1--3 and their coercion instances are alternate API wrappers
# around the three function spaces above and introduce no new mathematics.
# OrderPresHom and OrderPresMonoidHom are alternate hierarchy APIs outside this
# core slice.

# 8.3 Subobjects

prop is_submonoid(M nonempty_set, monoid &Monoid<M>, carrier power_set(M)):
    &Monoid<M>{monoid}.one $in carrier
    forall x, y carrier:
        &Monoid<M>{monoid}.mul(x, y) $in carrier

template<M nonempty_set, monoid &Monoid<M>>:
    have Submonoid set = {carrier power_set(M): $is_submonoid(M, monoid, carrier)}

thm submonoid_carrier_nonempty:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        =>:
            $is_nonempty_set(carrier)
    witness $is_nonempty_set(carrier) from &Monoid<M>{monoid}.one:
        &Monoid<M>{monoid}.one $in carrier

thm _inherited_submonoid_tuple_is_monoid:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        $is_nonempty_set(carrier)
        # The anonymous function's declared return carrier is checked while
        # this header is elaborated, before a prop premise is unfolded. Keep
        # the two operational consequences explicit at that boundary.
        forall x, y carrier:
            &Monoid<M>{monoid}.mul(x, y) $in carrier
        &Monoid<M>{monoid}.one $in carrier
        =>:
            (fn(x, y carrier) carrier {&Monoid<M>{monoid}.mul(x, y)}, &Monoid<M>{monoid}.one) $in &Monoid<carrier>
    forall x, y, z carrier:
        x $in M
        y $in M
        z $in M
        (fn(a, b carrier) carrier {&Monoid<M>{monoid}.mul(a, b)})((fn(a, b carrier) carrier {&Monoid<M>{monoid}.mul(a, b)})(x, y), z) = &Monoid<M>{monoid}.mul(&Monoid<M>{monoid}.mul(x, y), z) = &Monoid<M>{monoid}.mul(x, &Monoid<M>{monoid}.mul(y, z)) = (fn(a, b carrier) carrier {&Monoid<M>{monoid}.mul(a, b)})(x, (fn(a, b carrier) carrier {&Monoid<M>{monoid}.mul(a, b)})(y, z))
    by def:
        ? $is_semigroup(carrier, fn(x, y carrier) carrier {&Monoid<M>{monoid}.mul(x, y)})
    forall x carrier:
        x $in M
        (fn(a, b carrier) carrier {&Monoid<M>{monoid}.mul(a, b)})(&Monoid<M>{monoid}.one, x) = &Monoid<M>{monoid}.mul(&Monoid<M>{monoid}.one, x) = x
        (fn(a, b carrier) carrier {&Monoid<M>{monoid}.mul(a, b)})(x, &Monoid<M>{monoid}.one) = &Monoid<M>{monoid}.mul(x, &Monoid<M>{monoid}.one) = x
    by thm fn_set_member(fn(x, y carrier) carrier {&Monoid<M>{monoid}.mul(x, y)}, fn(x, y carrier) carrier)
    &Monoid<M>{monoid}.one $in carrier
    by thm cart_member_from_coordinates((fn(x, y carrier) carrier {&Monoid<M>{monoid}.mul(x, y)}, &Monoid<M>{monoid}.one), cart(fn(x, y carrier) carrier, carrier))
    by thm struct_member((fn(x, y carrier) carrier {&Monoid<M>{monoid}.mul(x, y)}, &Monoid<M>{monoid}.one), &Monoid<carrier>)

# Source SubMonoid1Monoid instance. The explicit nonempty guard remains a
# template premise; submonoid_carrier_nonempty proves it is available.
template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $is_nonempty_set(carrier)>:
    have inherited_submonoid &Monoid<carrier> = (fn(x, y carrier) carrier {&Monoid<M>{monoid}.mul(x, y)}, &Monoid<M>{monoid}.one)

thm submonoid_intersection_closed:
    ? forall M nonempty_set, monoid &Monoid<M>, left, right power_set(M):
        $is_submonoid(M, monoid, left)
        $is_submonoid(M, monoid, right)
        =>:
            $is_submonoid(M, monoid, {x M: x $in left and x $in right})
    &Monoid<M>{monoid}.one $in left
    &Monoid<M>{monoid}.one $in right
    by thm set_builder_member(&Monoid<M>{monoid}.one, {x M: x $in left and x $in right})
    &Monoid<M>{monoid}.one $in {x M: x $in left and x $in right}
    claim:
        ? forall x, y {x M: x $in left and x $in right}:
            &Monoid<M>{monoid}.mul(x, y) $in {z M: z $in left and z $in right}
        x $in left
        x $in right
        y $in left
        y $in right
        &Monoid<M>{monoid}.mul(x, y) $in left
        &Monoid<M>{monoid}.mul(x, y) $in right
        by thm set_builder_member(&Monoid<M>{monoid}.mul(x, y), {z M: z $in left and z $in right})
    by def:
        ? $is_submonoid(M, monoid, {x M: x $in left and x $in right})

# Source Submonoid.Setoid. The relation is correctly a prop because its
# candidate elements x and y are explicit parameters.
prop submonoid_fraction_equiv(M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M):
    exist w, z M st {w $in carrier, z $in carrier, &Monoid<M>{monoid}.mul(x, w) = &Monoid<M>{monoid}.mul(y, z)}

prop monoid_is_commutative(M nonempty_set, monoid &Monoid<M>):
    forall x, y M:
        &Monoid<M>{monoid}.mul(x, y) = &Monoid<M>{monoid}.mul(y, x)

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M)>:
    have fn fraction_class(x M) power_set(M) = {y M: $submonoid_fraction_equiv(M, monoid, carrier, x, y)}

prop is_fraction_class(M nonempty_set, monoid &Monoid<M>, carrier power_set(M), CarrierC power_set(M)):
    exist x M st {CarrierC = \fraction_class<M, monoid, carrier>(x)}

thm fraction_relation_reflexive:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x M:
        $is_submonoid(M, monoid, carrier)
        =>:
            $submonoid_fraction_equiv(M, monoid, carrier, x, x)
    witness exist w, z M st {w $in carrier, z $in carrier, &Monoid<M>{monoid}.mul(x, w) = &Monoid<M>{monoid}.mul(x, z)} from &Monoid<M>{monoid}.one, &Monoid<M>{monoid}.one
    by def:
        ? $submonoid_fraction_equiv(M, monoid, carrier, x, x)

thm fraction_relation_symmetric:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M:
        $submonoid_fraction_equiv(M, monoid, carrier, x, y)
        =>:
            $submonoid_fraction_equiv(M, monoid, carrier, y, x)
    obtain w, z from exist w, z M st {w $in carrier, z $in carrier, &Monoid<M>{monoid}.mul(x, w) = &Monoid<M>{monoid}.mul(y, z)}
    witness exist w2, z2 M st {w2 $in carrier, z2 $in carrier, &Monoid<M>{monoid}.mul(y, w2) = &Monoid<M>{monoid}.mul(x, z2)} from z, w
    by def:
        ? $submonoid_fraction_equiv(M, monoid, carrier, y, x)

thm fraction_relation_transitive:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y, z M:
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        $submonoid_fraction_equiv(M, monoid, carrier, x, y)
        $submonoid_fraction_equiv(M, monoid, carrier, y, z)
        =>:
            $submonoid_fraction_equiv(M, monoid, carrier, x, z)
    thm function_substitution:
        ? forall A, B set, f fn(q A) B, u, v A:
            u = v
            =>:
                f(u) = f(v)
    obtain x_den, y_num from exist w, q M st {w $in carrier, q $in carrier, &Monoid<M>{monoid}.mul(x, w) = &Monoid<M>{monoid}.mul(y, q)}
    obtain y_den, z_num from exist w, q M st {w $in carrier, q $in carrier, &Monoid<M>{monoid}.mul(y, w) = &Monoid<M>{monoid}.mul(z, q)}
    have left_den M = &Monoid<M>{monoid}.mul(x_den, y_den)
    have right_num M = &Monoid<M>{monoid}.mul(y_num, z_num)
    &Monoid<M>{monoid}.mul(x_den, y_den) $in carrier
    &Monoid<M>{monoid}.mul(y_num, z_num) $in carrier
    left_den = &Monoid<M>{monoid}.mul(x_den, y_den)
    right_num = &Monoid<M>{monoid}.mul(y_num, z_num)
    left_den $in carrier
    right_num $in carrier
    &Monoid<M>{monoid}.mul(y_num, y_den) = &Monoid<M>{monoid}.mul(y_den, y_num)
    &Monoid<M>{monoid}.mul(z_num, y_num) = &Monoid<M>{monoid}.mul(y_num, z_num)
    by thm function_substitution(M, M, fn(q M) M {&Monoid<M>{monoid}.mul(y, q)}, &Monoid<M>{monoid}.mul(y_num, y_den), &Monoid<M>{monoid}.mul(y_den, y_num))
    by thm function_substitution(M, M, fn(q M) M {&Monoid<M>{monoid}.mul(z, q)}, &Monoid<M>{monoid}.mul(z_num, y_num), &Monoid<M>{monoid}.mul(y_num, z_num))
    &Monoid<M>{monoid}.mul(x, left_den) = &Monoid<M>{monoid}.mul(x, &Monoid<M>{monoid}.mul(x_den, y_den)) = &Monoid<M>{monoid}.mul(&Monoid<M>{monoid}.mul(x, x_den), y_den) = &Monoid<M>{monoid}.mul(&Monoid<M>{monoid}.mul(y, y_num), y_den) = &Monoid<M>{monoid}.mul(y, &Monoid<M>{monoid}.mul(y_num, y_den)) = &Monoid<M>{monoid}.mul(y, &Monoid<M>{monoid}.mul(y_den, y_num)) = &Monoid<M>{monoid}.mul(&Monoid<M>{monoid}.mul(y, y_den), y_num) = &Monoid<M>{monoid}.mul(&Monoid<M>{monoid}.mul(z, z_num), y_num) = &Monoid<M>{monoid}.mul(z, &Monoid<M>{monoid}.mul(z_num, y_num)) = &Monoid<M>{monoid}.mul(z, &Monoid<M>{monoid}.mul(y_num, z_num)) = &Monoid<M>{monoid}.mul(z, right_num)
    witness exist w, q M st {w $in carrier, q $in carrier, &Monoid<M>{monoid}.mul(x, w) = &Monoid<M>{monoid}.mul(z, q)} from left_den, right_num
    by def:
        ? $submonoid_fraction_equiv(M, monoid, carrier, x, z)

# Source quotient constructor. The represented-class carrier becomes a genuine
# quotient only for a commutative monoid and a submonoid carrier.
template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient power_set(power_set(M)) = {CarrierC power_set(M): $is_fraction_class(M, monoid, carrier, CarrierC)}

# Source QuotientMonoid.mk. The class-membership bridge is localized proof
# debt because the verifier does not fold the existential is_fraction_class
# witness back into membership in the quotient set.
trust forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x M:
    $is_submonoid(M, monoid, carrier)
    $monoid_is_commutative(M, monoid)
    =>:
        \fraction_class<M, monoid, carrier>(x) $in \fraction_quotient<M, monoid, carrier>

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fn fraction_quotient_mk(x M) \fraction_quotient<M, monoid, carrier> = \fraction_class<M, monoid, carrier>(x)

thm fraction_quotient_nonempty:
    ? forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
        $is_submonoid(M, monoid, carrier)
        $monoid_is_commutative(M, monoid)
        =>:
            $is_nonempty_set(\fraction_quotient<M, monoid, carrier>)
    witness $is_nonempty_set(\fraction_quotient<M, monoid, carrier>) from \fraction_class<M, monoid, carrier>(&Monoid<M>{monoid}.one):
        \fraction_class<M, monoid, carrier>(&Monoid<M>{monoid}.one) $in \fraction_quotient<M, monoid, carrier>

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient_carrier nonempty_set = \fraction_quotient<M, monoid, carrier>

# Quotient.map2 becomes a selected callable on classes. Its representative
# equation is the exact well-definedness interface needed by clients.
template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    trust have fraction_quotient_mul fn(left, right \fraction_quotient_carrier<M, monoid, carrier>) \fraction_quotient_carrier<M, monoid, carrier>

trust forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M), x, y M:
    $is_submonoid(M, monoid, carrier)
    $monoid_is_commutative(M, monoid)
    =>:
        \fraction_quotient_mul<M, monoid, carrier>(\fraction_quotient_mk<M, monoid, carrier>(x), \fraction_quotient_mk<M, monoid, carrier>(y)) = \fraction_quotient_mk<M, monoid, carrier>(&Monoid<M>{monoid}.mul(x, y))

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient_one \fraction_quotient_carrier<M, monoid, carrier> = \fraction_quotient_mk<M, monoid, carrier>(&Monoid<M>{monoid}.one)

# Proof debt: quotient associativity and identity follow by representatives,
# but require the missing quotient eliminator/congruence support.
trust forall M nonempty_set, monoid &Monoid<M>, carrier power_set(M):
    $is_submonoid(M, monoid, carrier)
    $monoid_is_commutative(M, monoid)
    =>:
        (\fraction_quotient_mul<M, monoid, carrier>, \fraction_quotient_one<M, monoid, carrier>) $in &Monoid<\fraction_quotient_carrier<M, monoid, carrier>>

template<M nonempty_set, monoid &Monoid<M>, carrier power_set(M): $is_submonoid(M, monoid, carrier), $monoid_is_commutative(M, monoid)>:
    have fraction_quotient_monoid &Monoid<\fraction_quotient_carrier<M, monoid, carrier>> = (\fraction_quotient_mul<M, monoid, carrier>, \fraction_quotient_one<M, monoid, carrier>)
