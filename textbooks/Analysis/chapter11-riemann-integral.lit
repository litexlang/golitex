        by axiom_of_choice: set fn_range(lower_piece_value_set)
    obtain choose_lower from exist f fn(A fn_range(lower_piece_value_set)) family_union(fn_range(lower_piece_value_set)) st {$is_choice_function_for(fn_range(lower_piece_value_set), fn_range(lower_piece_value_set), fn(A fn_range(lower_piece_value_set)) fn_range(lower_piece_value_set) {A}, f)}
    claim:
