        =>:
            J = '[1, 2)
    by enumerate finite_set:
        ? forall K example_11_2_12_refined_partition_set:
            K = '[1, 2) or K = '[2, 3) or K = {3} or K = '(3, 4] or K = {}
    by cases:
        ? J = '[1, 2)
        case J = '[1, 2):
            J = '[1, 2)
        case J = '[2, 3):
            x $in J
            x >= 2
            x < 2
            2 <= x < 2
            impossible 2 < 2
        case J = {3}:
            x $in J
            x = 3
            x < 2
            impossible 3 < 2
        case J = '(3, 4]:
            x $in J
            x > 3
            x < 2
            impossible 3 < 2
        case J = {}:
            x $in J
            x $in {}
            not $is_nonempty_set({})
            witness $is_nonempty_set({}) from x
            impossible $is_nonempty_set({})

