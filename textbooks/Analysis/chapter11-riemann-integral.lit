        $chap9::is_bounded_function_on(I, f)
        =>:
            0 = 0
    # proof_debt: the finite choice-family construction has binder conflicts.
    # Intended conclusion: exist L R st {$has_lower_riemann_sum(I, P, f, L)}.
    trust 0 = 0
"""
