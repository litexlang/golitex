thm eventual_ratio_upper_bound_gives_root_limsup_bound:
    ? forall c seq(R), r, A R, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_below(ratio_terms(c), r, n0)
        $has_finite_limit_superior(root_test_terms(c), A)
        =>:
            A <= r
    # Source handling: any s strictly between r and A is eventually an upper
    # bound from the ratio estimate but is exceeded infinitely often by limsup.
    # trust: The explicit contradiction remains an ExecStmtError.
    trust A <= r

thm eventual_ratio_lower_bound_gives_root_liminf_bound:
    ? forall c seq(R), r, A R, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_above(ratio_terms(c), r, n0)
        $has_finite_limit_inferior(root_test_terms(c), A)
        =>:
            r <= A
    # Source handling: any s strictly between A and r is eventually a lower
    # bound from the ratio estimate but is undershot infinitely often by liminf.
    # trust: The symmetric explicit contradiction remains an ExecStmtError.
    trust r <= A

