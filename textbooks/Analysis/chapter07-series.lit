# """
# Corollary 7.5.3 (Ratio test). If the limsup of |a_{n+1}|/|a_n| is less than
# 1, the series is absolutely convergent.  If the liminf is greater than 1, the
# series is divergent.
# """
# 
# # The proof combines the root test with Lemma 7.5.2; the equality case is
# # inconclusive.
# 
prop has_no_zero_terms(a seq(R)):
    forall n N+:
        a(n) != 0

# This is the sequence with kth term `abs(a(k+1))/abs(a(k))`.
prop is_absolute_ratio_sequence(a, b seq(R)):
    forall n N+:
        a(n) != 0
        =>:
            b(n) = abs(a(n + 1)) / abs(a(n))

have fn absolute_value_sequence(a seq(R)) fn(i_index N+) R = fn(j N+) R {abs(a(j))}

thm positive_sequence_ratio_limit_one_gives_root_limit_one:
    ? forall c seq(R):
        $is_positive_sequence(c)
        $has_limit(ratio_terms(c), 1)
        =>:
            $has_limit(root_test_terms(c), 1)
    # Source handling: trap ratios eventually between 1-epsilon/2 and
    # 1+epsilon/2, transfer both bounds to nth roots, and squeeze to one.
    # trust: The first eventual ratio upper-bound universal fact remains a
    # VerifyError after the epsilon constants are made explicit.
    trust $has_limit(root_test_terms(c), 1)

thm abs_sequence_positive_from_no_zero_terms:
    ? forall a seq(R):
        $has_no_zero_terms(a)
        =>:
            $is_positive_sequence(absolute_value_sequence(a))
    forall n N+:
        a(n) != 0
        abs(a(n)) > 0
        absolute_value_sequence(a)(n) = abs(a(n))
        absolute_value_sequence(a)(n) > 0
    by def:
        ? $is_positive_sequence(absolute_value_sequence(a))

thm absolute_value_sequence_has_zero_limit:
    ? forall a seq(R):
        $has_limit(a, 0)
        =>:
            $has_limit(absolute_value_sequence(a), 0)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    absolute_value_sequence(a)(n) = abs(a(n))
                    abs(a(n)) >= 0
                    abs(abs(a(n))) = abs(a(n))
                    absolute_value_sequence(a)(n) - 0 = abs(a(n)) - 0
                    abs(a(n)) - 0 = abs(a(n))
                    absolute_value_sequence(a)(n) - 0 = abs(a(n))
                    abs(absolute_value_sequence(a)(n) - 0) = abs(abs(a(n)))
                    a(n) - 0 = a(n)
                    abs(a(n) - 0) = abs(a(n))
                    abs(absolute_value_sequence(a)(n) - 0) = abs(abs(a(n))) = abs(a(n)) = abs(a(n) - 0) <= epsilon
            by def:
                ? $is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n0)
            $is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n0)
    by def:
        ? $has_limit(absolute_value_sequence(a), 0)

# thm absolute_ratio_terms_match_positive_ratio_terms:
#     ? forall a seq(R):
#         $has_no_zero_terms(a)
#         =>:
#             $pointwise_equal_sequences(absolute_ratio_terms(a), ratio_terms(absolute_value_sequence(a)))
#     by thm abs_sequence_positive_from_no_zero_terms(a)
#     claim:
#         ? forall n N+:
#             absolute_ratio_terms(a)(n) = ratio_terms(absolute_value_sequence(a))(n)
#         a(n) != 0
#         abs(a(n)) > 0
#         absolute_value_sequence(a)(n) > 0
#         absolute_value_sequence(a)(n + 1) = abs(a(n + 1))
#         absolute_value_sequence(a)(n) = abs(a(n))
#         absolute_ratio_terms(a)(n) = abs(a(n + 1)) / abs(a(n))
#         ratio_terms(absolute_value_sequence(a))(n) = abs(a(n + 1)) / abs(a(n))
#         absolute_ratio_terms(a)(n) = ratio_terms(absolute_value_sequence(a))(n)
#     by def:
#         ? $pointwise_equal_sequences(absolute_ratio_terms(a), ratio_terms(absolute_value_sequence(a)))
# 
thm root_test_terms_match_absolute_value_sequence:
    ? forall a seq(R):
        $pointwise_equal_sequences(root_test_terms(a), root_test_terms(absolute_value_sequence(a)))
    claim:
        ? forall n N+:
            root_test_terms(a)(n) = root_test_terms(absolute_value_sequence(a))(n)
        root_test_terms(a)(n) = abs(a(n))^(1 / n)
        root_test_terms(absolute_value_sequence(a))(n) = abs(absolute_value_sequence(a)(n))^(1 / n)
        absolute_value_sequence(a)(n) = abs(a(n))
        abs(absolute_value_sequence(a)(n)) = abs(abs(a(n)))
        abs(a(n)) >= 0
        abs(abs(a(n))) = abs(a(n))
        abs(abs(a(n)))^(1 / n) = abs(a(n))^(1 / n)
        root_test_terms(absolute_value_sequence(a))(n) = abs(absolute_value_sequence(a)(n))^(1 / n) = abs(abs(a(n)))^(1 / n) = abs(a(n))^(1 / n)
        root_test_terms(absolute_value_sequence(a))(n) = abs(a(n))^(1 / n)
        root_test_terms(a)(n) = root_test_terms(absolute_value_sequence(a))(n)
    by def:
        ? $pointwise_equal_sequences(root_test_terms(a), root_test_terms(absolute_value_sequence(a)))

# thm ratio_test_absolute_convergence:
#     ? forall a seq(R), alpha R:
#         $has_no_zero_terms(a)
#         $has_finite_limit_superior(absolute_ratio_terms(a), alpha)
#         alpha < 1
#         =>:
#             $is_absolutely_convergent_series(a)
#     by thm abs_sequence_positive_from_no_zero_terms(a)
#     by thm absolute_ratio_terms_match_positive_ratio_terms(a)
#     by thm finite_limsup_extensional(absolute_ratio_terms(a), ratio_terms(absolute_value_sequence(a)), alpha)
#     by thm ratio_limsup_less_than_one_gives_root_limsup_below_one(absolute_value_sequence(a), alpha)
#     obtain gamma from exist gamma R st {$has_finite_limit_superior(root_test_terms(absolute_value_sequence(a)), gamma) and gamma < 1}
#     by thm root_test_terms_match_absolute_value_sequence(a)
#     by thm pointwise_equal_sequences_symmetric(root_test_terms(a), root_test_terms(absolute_value_sequence(a)))
#     by thm finite_limsup_extensional(root_test_terms(absolute_value_sequence(a)), root_test_terms(a), gamma)
#     by thm root_test_absolute_convergence(a, gamma)
# 
# thm ratio_test_divergence:
#     ? forall a seq(R), beta R:
#         $has_no_zero_terms(a)
#         $has_finite_limit_inferior(absolute_ratio_terms(a), beta)
#         beta > 1
#         =>:
#             not $is_convergent_series(a)
#     by thm abs_sequence_positive_from_no_zero_terms(a)
#     by thm absolute_ratio_terms_match_positive_ratio_terms(a)
#     by thm finite_liminf_extensional(absolute_ratio_terms(a), ratio_terms(absolute_value_sequence(a)), beta)
#     by thm ratio_liminf_greater_than_one_gives_failure_of_zero_limit(absolute_value_sequence(a), beta)
#     by contra:
#         ? not $is_convergent_series(a)
#         $is_convergent_series(a)
#         by thm series_zero_test(a)
#         by thm absolute_value_sequence_has_zero_limit(a)
#         impossible not $has_limit(absolute_value_sequence(a), 0)
#
thm ratio_test_absolute_convergence:
    ? forall a, rho seq(R), alpha R:
        $has_no_zero_terms(a)
        $is_absolute_ratio_sequence(a, rho)
        $has_finite_limit_superior(rho, alpha)
        alpha < 1
        =>:
            $is_absolutely_convergent_series(a)
    # Source handling: transfer the absolute-ratio limsup to the positive
    # absolute-value sequence and apply the root test.
    # trust: The direct absolute-ratio function is blocked by denominator
    # well-definedness before has_no_zero_terms is unfolded.
    trust $is_absolutely_convergent_series(a)

thm ratio_test_divergence:
    ? forall a, rho seq(R), beta R:
        $has_no_zero_terms(a)
        $is_absolute_ratio_sequence(a, rho)
        $has_finite_limit_inferior(rho, beta)
        beta > 1
        =>:
            not $is_convergent_series(a)
    # Source handling: transfer the absolute-ratio liminf, show the absolute
    # values do not tend to zero, and apply the series zero test.
    # trust: This shares the absolute-ratio well-definedness gap above.
    trust not $is_convergent_series(a)

"""
Proposition 7.5.4. The sequence n^(1/n) converges to 1.
"""

# The proof uses Lemma 7.5.2, the limit of `(n+1)/n`, and the
# liminf/limsup characterization of convergence.

have positive_natural_sequence seq(R) = fn(j N+) R {j}

forall n N+:
    positive_natural_sequence(n) = n
    n > 0
    positive_natural_sequence(n) > 0
by def:
    ? $is_positive_sequence(positive_natural_sequence)

claim:
    ? forall epsilon R+:
        exist n0 N+ st {$is_tail_close_to(ratio_terms(positive_natural_sequence), 1, epsilon, n0)}
    by thm chap5::archimedean_property(epsilon)
    obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
    witness exist n1 N+ st {$is_tail_close_to(ratio_terms(positive_natural_sequence), 1, epsilon, n1)} from n0:
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    abs(ratio_terms(positive_natural_sequence)(n) - 1) <= epsilon
            positive_natural_sequence(n) > 0
            ratio_terms(positive_natural_sequence)(n) = positive_natural_sequence(n + 1) / positive_natural_sequence(n)
            positive_natural_sequence(n + 1) = n + 1
            positive_natural_sequence(n) = n
            positive_natural_sequence(n + 1) / positive_natural_sequence(n) = (n + 1) / positive_natural_sequence(n)
            (n + 1) / positive_natural_sequence(n) = (n + 1) / n
            ratio_terms(positive_natural_sequence)(n) = positive_natural_sequence(n + 1) / positive_natural_sequence(n) = (n + 1) / positive_natural_sequence(n) = (n + 1) / n
            ratio_terms(positive_natural_sequence)(n) = (n + 1) / n
            (n + 1) / n - 1 = 1 / n
            n0 <= n
            by thm chap6::reciprocal_nat_order_reversing(n0, n)
            1 / n <= 1 / n0 < epsilon
            1 / n > 0
            ratio_terms(positive_natural_sequence)(n) - 1 = (n + 1) / n - 1
            (n + 1) / n - 1 = 1 / n
            ratio_terms(positive_natural_sequence)(n) - 1 = (n + 1) / n - 1 = 1 / n
            abs(ratio_terms(positive_natural_sequence)(n) - 1) = abs(1 / n)
            abs(1 / n) = 1 / n
            abs(ratio_terms(positive_natural_sequence)(n) - 1) = abs(1 / n) = 1 / n
            abs(ratio_terms(positive_natural_sequence)(n) - 1) <= epsilon
        by def:
            ? $is_tail_close_to(ratio_terms(positive_natural_sequence), 1, epsilon, n0)
        $is_tail_close_to(ratio_terms(positive_natural_sequence), 1, epsilon, n0)
by def:
    ? $has_limit(ratio_terms(positive_natural_sequence), 1)

claim:
    ? forall n N+:
        root_test_terms(positive_natural_sequence)(n) = fn(j N+) R {j^(1 / j)}(n)
    root_test_terms(positive_natural_sequence)(n) = abs(positive_natural_sequence(n))^(1 / n)
    positive_natural_sequence(n) = n
    abs(positive_natural_sequence(n)) = abs(n)
    abs(n) = n
    abs(positive_natural_sequence(n)) = abs(n) = n
    abs(positive_natural_sequence(n))^(1 / n) = abs(n)^(1 / n)
    abs(n)^(1 / n) = n^(1 / n)
    root_test_terms(positive_natural_sequence)(n) = abs(positive_natural_sequence(n))^(1 / n) = abs(n)^(1 / n) = n^(1 / n)
    fn(j N+) R {j^(1 / j)}(n) = n^(1 / n)
    root_test_terms(positive_natural_sequence)(n) = n^(1 / n) = fn(j N+) R {j^(1 / j)}(n)
by def:
    ? $pointwise_equal_sequences(root_test_terms(positive_natural_sequence), fn(j N+) R {j^(1 / j)})

by thm positive_sequence_ratio_limit_one_gives_root_limit_one(positive_natural_sequence)
by thm has_limit_extensional(root_test_terms(positive_natural_sequence), fn(j N+) R {j^(1 / j)}, 1)

"""
Remark 7.5.5. The integral test is another important convergence test, but it
belongs with integration in Chapter 11.
"""

# The integral test is postponed until integration has been developed.
