#             rearranged_series(a, phi)(i) = a(phi(i))
#             image_index(i) = raw_image(i) = phi(i)
#             rearranged_series(a, phi)(i) = a(image_index(i))
#     fn(i D) R {rearranged_series(a, phi)(i)} = fn(i D) R {a(image_index(i))}
#     finite_set_sum(D, fn(i D) R {rearranged_series(a, phi)(i)}) = finite_set_sum(D, fn(i D) R {a(image_index(i))})
#     finite_set_sum(D, fn(i D) R {a(image_index(i))}) = finite_set_sum(T, fn(y T) R {a(y)})
#     partial_sum(rearranged_series(a, phi), n) = finite_set_sum(T, fn(y T) R {a(y)})
#     forall i E:
#         a(i) >= 0
#     by thm finite_set_sum_subset_le_for_nonnegative_terms(E, T, fn(i E) R {a(i)})
#     partial_sum(a, M) = sum(1, M, fn(i N+) R {a(i)})
#     sum(1, M, fn(i N+) R {a(i)}) = finite_set_sum(E, fn(i E) R {a(i)})
#     partial_sum(a, M) = finite_set_sum(E, fn(i E) R {a(i)})
#     finite_set_sum(T, fn(y T) R {a(y)}) <= finite_set_sum(E, fn(i E) R {a(i)})
#     partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, M)
# 
thm rearranged_partial_sum_le_original_at_bounded_prefix:
    ? forall a seq(R), phi fn(i_index N+) N+, n, M N+:
        $is_nonnegative_sequence(a)
        $is_permutation_of_positive_integers(phi)
        $has_bounded_prefix_image(phi, n, M)
        =>:
            partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, M)
    # Source handling: identify the finite prefix image inside {1,...,M},
    # substitute along the permutation, and compare the nonnegative sums.
    # trust: The finite-range image function is rejected as not belonging to
    # its declared fn_range return set despite its defining membership.
    trust partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, M)

