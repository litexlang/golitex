thm eventual_ratio_upper_bound_gives_eventual_root_upper_bound:
    ? forall c seq(R), r, s R+, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_below(ratio_terms(c), r, n0)
        r < s
        =>:
            exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)}
    # Source handling: use the product bound and let the fixed prefix factor
    # c(n0)^(1/n) tend to one.
    # trust: The real-power comparison needed to control that prefix factor
    # remains a VerifyError.
    trust exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)}

thm eventual_ratio_lower_bound_gives_eventual_root_lower_bound:
    ? forall c seq(R), r, s R+, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_above(ratio_terms(c), r, n0)
        s < r
        =>:
            exist n1 N+ st {$is_eventually_above(root_test_terms(c), s, n1)}
    # Source handling: use the lower product bound and the same vanishing
    # influence of the fixed prefix factor.
    # trust: This is the symmetric real-power comparison gap.
    trust exist n1 N+ st {$is_eventually_above(root_test_terms(c), s, n1)}

