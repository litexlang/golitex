thm eventually_upper_bounded_positive_root_terms_are_bounded:
    ? forall c seq(R), s R+, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_below(root_test_terms(c), s, n0)
        =>:
            $chap6::is_bounded_sequence(root_test_terms(c))
    # Source handling: bound the finite prefix by prefix_bound and the tail by s.
    # trust: Litex does not establish nonnegativity of the prefix bound here.
    trust $chap6::is_bounded_sequence(root_test_terms(c))

