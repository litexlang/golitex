#             c(n0 + h) > 0
#             ratio_terms(c)(n0 + h) = c(n0 + h + 1) / c(n0 + h)
#             c(n0 + h + 1) < r * c(n0 + h)
#             r > 0
#             r * c(n0 + h) <= r * (c(n0) * r^h)
#             r * (c(n0) * r^h) = c(n0) * (r^h * r) = c(n0) * r^(h + 1)
#             n0 + (h + 1) = n0 + h + 1
#             c(n0 + (h + 1)) <= c(n0) * r^(h + 1)
# 
# thm eventual_ratio_lower_product_bound:
#     ? forall c seq(R), r R+, n0 N+, h N:
#         $is_positive_sequence(c)
#         $is_eventually_above(ratio_terms(c), r, n0)
#         =>:
#             c(n0 + h) >= c(n0) * r^h
#     by induc h from 0:
#         ? c(n0 + h) >= c(n0) * r^h
#         ? from h = 0:
#             n0 + 0 = n0
#             r^0 = 1
#             c(n0 + 0) = c(n0) = c(n0) * 1 = c(n0) * r^0
#         ? induc:
#             c(n0 + h) >= c(n0) * r^h
#             n0 + h $in N+
#             n0 + h >= n0
#             ratio_terms(c)(n0 + h) > r
#             c(n0 + h) > 0
#             ratio_terms(c)(n0 + h) = c(n0 + h + 1) / c(n0 + h)
#             c(n0 + h + 1) > r * c(n0 + h)
#             r > 0
#             r * c(n0 + h) >= r * (c(n0) * r^h)
#             r * (c(n0) * r^h) = c(n0) * (r^h * r) = c(n0) * r^(h + 1)
#             n0 + (h + 1) = n0 + h + 1
#             c(n0 + (h + 1)) >= c(n0) * r^(h + 1)
# 
thm eventual_ratio_upper_product_bound:
    ? forall c seq(R), r R+, n0 N+, h N:
        $is_positive_sequence(c)
        $is_eventually_below(ratio_terms(c), r, n0)
        =>:
            c(n0 + h) <= c(n0) * r^h
    # Source handling: iterate c(k+1) < r*c(k) from n0 through n0+h.
    # trust: The induction cannot derive the multiplication step from the
    # ratio inequality after unfolding ratio_terms.
    trust c(n0 + h) <= c(n0) * r^h

thm eventual_ratio_lower_product_bound:
    ? forall c seq(R), r R+, n0 N+, h N:
        $is_positive_sequence(c)
        $is_eventually_above(ratio_terms(c), r, n0)
        =>:
            c(n0 + h) >= c(n0) * r^h
    # Source handling: iterate c(k+1) > r*c(k) from n0 through n0+h.
    # trust: This is the symmetric ratio-to-product induction gap.
    trust c(n0 + h) >= c(n0) * r^h

