#             partial_sum(condensed_terms(a), K + 1) <= 2 * partial_sum(a, 2^(K - 1)) + 2 * sum(2^(K - 1) + 1, 2^K, fn(i N+) R {a(i)})
#             2^K = 2^(K - 1) + 2^(K - 1)
#             2^(K - 1) > 0
#             2^(K - 1) + 2^(K - 1) > 2^(K - 1)
#             2^K > 2^(K - 1)
#             2^(K - 1) < 2^K
#             by thm partial_sum_split_after(a, 2^(K - 1), 2^K)
#             2 * partial_sum(a, 2^K) = 2 * (partial_sum(a, 2^(K - 1)) + sum(2^(K - 1) + 1, 2^K, fn(i N+) R {a(i)}))
#             2 * (partial_sum(a, 2^(K - 1)) + sum(2^(K - 1) + 1, 2^K, fn(i N+) R {a(i)})) = 2 * partial_sum(a, 2^(K - 1)) + 2 * sum(2^(K - 1) + 1, 2^K, fn(i N+) R {a(i)})
#             partial_sum(condensed_terms(a), K + 1) <= 2 * partial_sum(a, 2^K)
#             (K + 1) - 1 = K
#             2^((K + 1) - 1) = 2^K
#             partial_sum(a, 2^((K + 1) - 1)) = partial_sum(a, 2^K)
#             2 * partial_sum(a, 2^((K + 1) - 1)) = 2 * partial_sum(a, 2^K)
#             partial_sum(condensed_terms(a), K + 1) <= 2 * partial_sum(a, 2^((K + 1) - 1))
# 
# """
# Remark 7.3.5. Cauchy's criterion only samples the terms whose indices are
# powers of two, yet it decides convergence for monotone non-negative series.
# """
# 
# """
# Lemma 7.3.6. The dyadic partial sums used in Cauchy's criterion bound each
# other: ordinary partial sums up to a dyadic endpoint are below the condensed
# partial sums, and condensed partial sums are below twice an ordinary partial
# sum.
# """
# 
# # Tao proves this lemma in the text by induction over dyadic blocks.  The lower
# # blocks are bounded by their left endpoint; the upper blocks are bounded using
# # the preceding dyadic block and non-negativity.
# 
thm cauchy_condensation_partial_sum_upper_strong:
    ? forall a seq(R), K N+:
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        =>:
            partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^(K - 1))
    # Source handling: group the original series into dyadic blocks and use
    # decreasingness to bound each condensed term by twice its block sum.
    # trust: The explicit induction reaches its final distributive equality,
    # but that algebraic normalization remains an ExecStmtError.
    trust partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^(K - 1))

thm cauchy_condensation_partial_sum_bounds:
    ? forall a seq(R), K N+:
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        2^K - 1 $in N
        =>:
            partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
            partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^K)
    by thm cauchy_condensation_partial_sum_lower_bound(a, K)
    by thm cauchy_condensation_partial_sum_upper_strong(a, K)
    K >= 1
    K - 1 $in N
    2^(K - 1) $in N+
    2^K $in N+
    2^K = 2^((K - 1) + 1)
    2^((K - 1) + 1) = 2^(K - 1) * 2^1
    2^1 = 2
    2^K = 2^(K - 1) * 2
    2^(K - 1) * 2 = 2^(K - 1) + 2^(K - 1)
    2^(K - 1) >= 0
    2^(K - 1) + 2^(K - 1) >= 2^(K - 1)
    2^K >= 2^(K - 1)
    2^(K - 1) <= 2^K
    by thm nonnegative_partial_sums_monotone(a, 2^(K - 1), 2^K)
    2 >= 0
    2 * partial_sum(a, 2^(K - 1)) <= 2 * partial_sum(a, 2^K)
    partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^(K - 1)) <= 2 * partial_sum(a, 2^K)

thm cauchy_condensation_test_forward:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        $is_convergent_series(a)
        =>:
            $is_convergent_series(condensed_terms(a))
    by thm nonnegative_series_convergent_has_bounded_partial_sums(a)
    obtain M from exist M R st {$is_partial_sum_bound(a, M)}
    have B R = 2 * M
    claim:
        ? forall K N+:
            partial_sum(condensed_terms(a), K) <= B
        2^K $in N+
        2^K >= 1
        2^K - 1 $in N
        by thm cauchy_condensation_partial_sum_bounds(a, K)
        partial_sum(a, 2^K) <= M
        2 >= 0
        2 * partial_sum(a, 2^K) <= 2 * M
        partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^K) <= 2 * M
        2 * M = B
    by def:
        ? $is_partial_sum_bound(condensed_terms(a), B)
    witness exist set_C R st {$is_partial_sum_bound(condensed_terms(a), set_C)} from B
    by def:
        ? $has_bounded_partial_sums(condensed_terms(a))
    by thm condensed_terms_nonnegative(a)
    by thm nonnegative_series_bounded_partial_sums_converge(condensed_terms(a))

thm cauchy_condensation_test_reverse:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        $is_convergent_series(condensed_terms(a))
        =>:
            $is_convergent_series(a)
    by thm condensed_terms_nonnegative(a)
    by thm nonnegative_series_convergent_has_bounded_partial_sums(condensed_terms(a))
    obtain M from exist M R st {$is_partial_sum_bound(condensed_terms(a), M)}
    claim:
        ? forall k N+:
            partial_sum(a, k) <= M
        by thm dyadic_endpoint_covers_index(k)
        obtain K from exist K N+ st {k <= 2^K - 1}
        2^K $in N+
        2^K >= 1
        2^K - 1 $in N
        by thm nonnegative_partial_sums_monotone(a, k, 2^K - 1)
        by thm cauchy_condensation_partial_sum_bounds(a, K)
        partial_sum(condensed_terms(a), K) <= M
        partial_sum(a, k) <= partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K) <= M
    by def:
        ? $is_partial_sum_bound(a, M)
    witness exist B R st {$is_partial_sum_bound(a, B)} from M
    by def:
        ? $has_bounded_partial_sums(a)
    by thm nonnegative_series_bounded_partial_sums_converge(a)

"""
Corollary 7.3.7. The p-series sum 1/n^q converges exactly when q > 1.
"""

# The proof applies Cauchy's criterion and rewrites the condensed terms
# as a geometric series.  For q > 0, the sequence `1/n^q` is non-negative and
# decreasing by the rational exponent laws.  Cauchy's criterion says the
# p-series converges exactly when the condensed series with terms
# `2^k/(2^k)^q` converges; exponent laws rewrite this term as `(2^(1-q))^k`.
# The geometric series criterion then gives convergence exactly when
# `abs(2^(1-q)) < 1`, which is equivalent to `q > 1`.

prop is_p_series_term_value(q R+, n N+, value R):
    n^q != 0
    value = 1 / n^q

thm p_series_term_value_exists_unique:
    ? forall q R+, n N+:
        exist! value R st {$is_p_series_term_value(q, n, value)}
    n $in R+
    by thm chap6::real_power_positive(n, q)
    n^q > 0
    n^q != 0
    witness exist value R st {$is_p_series_term_value(q, n, value)} from 1 / n^q:
        n^q != 0
        1 / n^q = 1 / n^q
        by def:
            ? $is_p_series_term_value(q, n, 1 / n^q)
    obtain chosen from exist value R st {$is_p_series_term_value(q, n, value)}
    claim:
        ? forall value1, value2 R:
            $is_p_series_term_value(q, n, value1)
            $is_p_series_term_value(q, n, value2)
            =>:
                value1 = value2
        by def:
            ? $is_p_series_term_value(q, n, value1)
        by def:
            ? $is_p_series_term_value(q, n, value2)
        value1 = 1 / n^q = value2
    witness exist! value R st {$is_p_series_term_value(q, n, value)} from chosen

have fn p_series_term by exist!:
    ? forall q R+, n N+:
        exist! value R st {$is_p_series_term_value(q, n, value)}
    by thm p_series_term_value_exists_unique(q, n)

thm p_series_term_apply:
    ? forall q R+, n N+:
        n^q != 0
        =>:
            p_series_term(q, n) = 1 / n^q
    $is_p_series_term_value(q, n, p_series_term(q, n))
    by def:
        ? $is_p_series_term_value(q, n, p_series_term(q, n))

have fn p_series_terms(q R+) fn(i_index N+) R = fn(j N+) R {p_series_term(q, j)}

thm p_series_terms_apply:
    ? forall q R+, n N+:
        n^q != 0
        =>:
            p_series_terms(q)(n) = 1 / n^q
    p_series_terms(q)(n) = p_series_term(q, n)
    by thm p_series_term_apply(q, n)

thm p_series_terms_nonnegative:
    ? forall q R+:
        $is_nonnegative_sequence(p_series_terms(q))
    claim:
        ? forall n N+:
            p_series_terms(q)(n) >= 0
        n $in R+
        by thm chap6::real_power_positive(n, q)
        n^q > 0
        1 / n^q > 0
        by thm p_series_terms_apply(q, n)
        p_series_terms(q)(n) = 1 / n^q >= 0
    by def:
        ? $is_nonnegative_sequence(p_series_terms(q))

thm p_series_terms_decreasing:
    ? forall q R+:
        $is_decreasing_sequence(p_series_terms(q))
    # Source handling: positive real powers increase with the positive base,
    # so taking reciprocals makes the p-series terms decrease.
    # trust: Litex proves the strict power comparison but does not verify the
    # corresponding reciprocal inequality in this context.
    trust $is_decreasing_sequence(p_series_terms(q))

thm condensed_p_series_is_geometric:
    ? forall q R+, j N+:
        condensed_terms(p_series_terms(q))(j) = geometric_series_terms(2^(1 - q))(j)
    # Source handling: rewrite the condensed term using the real-power product,
    # quotient, and power laws to obtain ratio 2^(1-q).
    # trust: The real-power quotient normalization remains a VerifyError.
    trust condensed_terms(p_series_terms(q))(j) = geometric_series_terms(2^(1 - q))(j)

thm p_series_converges_when_exponent_gt_one:
    ? forall q R+:
        q > 1
        =>:
            $is_convergent_series(p_series_terms(q))
    # Source handling: condensation turns the p-series into a geometric series
    # with ratio 2^(1-q), whose absolute value is below one when q > 1.
    # trust: The geometric-series result does not currently expose the
    # convergence proposition needed by the condensation route.
    trust $is_convergent_series(p_series_terms(q))

thm p_series_diverges_when_exponent_le_one:
    ? forall q R+:
        q <= 1
        =>:
            not $is_convergent_series(p_series_terms(q))
    have two R+ = 2
    have r R+ = 2^(1 - q)
    claim:
        ? r >= 1
        q = 1 or q < 1
        by cases:
            ? r >= 1
            case q = 1:
                1 - q = 0
                r = 2^0 = 1
            case q < 1:
                1 - q > 0
                by thm chap6::real_power_exponent_strict_mono_above_one(two, 1 - q, 0)
                2^(1 - q) > 2^0 = 1
                r > 1
    r > 0
    abs(r) = r >= 1
    by thm geometric_series_diverges_when_abs_ge_one(r)
    by contra:
        ? not $is_convergent_series(p_series_terms(q))
        $is_convergent_series(p_series_terms(q))
        by thm p_series_terms_nonnegative(q)
        by thm p_series_terms_decreasing(q)
        by thm cauchy_condensation_test_forward(p_series_terms(q))
        claim:
            ? forall j N+:
                condensed_terms(p_series_terms(q))(j) = geometric_series_terms(r)(j)
            by thm condensed_p_series_is_geometric(q, j)
        by thm series_convergence_extensional(condensed_terms(p_series_terms(q)), geometric_series_terms(r))
        impossible not $is_convergent_series(geometric_series_terms(r))

"""
Remark 7.3.8. The convergent p-series sums define the Riemann zeta function
zeta(q), whose deeper number-theoretic properties lie outside this chapter.
"""


# 7.4 Rearrangement of series

"""
Proposition 7.4.1. A convergent non-negative series may be rearranged by a
bijection of the index set without changing its sum.
"""

prop is_permutation_of_positive_integers(phi fn(i_index N+) N+):
    forall y N+:
        exist! x N+ st {phi(x) = y}

have fn rearranged_series(a seq(R), phi fn(i_index N+) N+) fn(i_index N+) R = fn(j N+) R {a(phi(j))}

thm rearranged_series_apply:
    ? forall a seq(R), phi fn(i_index N+) N+, n N+:
        rearranged_series(a, phi)(n) = a(phi(n))
    rearranged_series(a, phi)(n) = a(phi(n))

# Tao's proof compares finite partial sums.  For non-negative series, it is
# enough that every finite partial sum of either order is bounded by a later
# finite partial sum of the other order.

prop has_mutually_cofinal_partial_sums(a, b seq(R)):
    forall n N+:
        exist m N+ st {partial_sum(a, n) <= partial_sum(b, m)}
    forall n N+:
        exist m N+ st {partial_sum(b, n) <= partial_sum(a, m)}

prop has_bounded_prefix_image(phi fn(i_index N+) N+, n N+, M N+):
    forall j N+:
        j <= n
        =>:
            phi(j) <= M

prop has_bounded_prefix_preimage(phi fn(i_index N+) N+, n N+, M N+):
    forall j N+:
        j <= n
        =>:
            exist t N+ st {t <= M, phi(t) = j}

# Proof-package helper: the running maximum bounds the image of a finite prefix.
have fn positive_nat_max(left, right N+) N+ by cases:
    case left >= right: left
    case left < right: right

thm positive_nat_max_left_bound:
    ? forall left, right N+:
        left <= positive_nat_max(left, right)
    left >= right or left < right
    by cases:
        ? left <= positive_nat_max(left, right)
        case left >= right:
            positive_nat_max(left, right) = left
        case left < right:
            positive_nat_max(left, right) = right
            left <= right

thm positive_nat_max_right_bound:
    ? forall left, right N+:
        right <= positive_nat_max(left, right)
    left >= right or left < right
    by cases:
        ? right <= positive_nat_max(left, right)
        case left >= right:
            positive_nat_max(left, right) = left
            right <= left
        case left < right:
            positive_nat_max(left, right) = right

have fn prefix_image_bound(phi fn(i_index N+) N+, n Z: n >= 1) N+ by induc n from 1:
    case n = 1: phi(1)
    case n > 1: positive_nat_max(prefix_image_bound(phi, n - 1), phi(n))

prop prefix_image_bound_bounds_up_to(phi fn(i_index N+) N+, n N+):
    forall j N+:
        j <= n
        =>:
            phi(j) <= prefix_image_bound(phi, n)

thm prefix_image_bound_bounds:
    ? forall phi fn(i_index N+) N+, n N+:
        $prefix_image_bound_bounds_up_to(phi, n)
    by induc n from 1:
        ? $prefix_image_bound_bounds_up_to(phi, n)
        ? from n = 1:
            claim:
                ? forall j N+:
                    j <= 1
                    =>:
                        phi(j) <= prefix_image_bound(phi, 1)
                j >= 1
                j = 1
                phi(j) = phi(1)
                prefix_image_bound(phi, 1) = phi(1)
                phi(j) <= prefix_image_bound(phi, 1)
            by def:
                ? $prefix_image_bound_bounds_up_to(phi, 1)
            $prefix_image_bound_bounds_up_to(phi, 1)
        ? induc:
            n + 1 > 1
            n + 1 - 1 = n
            prefix_image_bound(phi, n + 1) = positive_nat_max(prefix_image_bound(phi, n + 1 - 1), phi(n + 1))
            prefix_image_bound(phi, n + 1 - 1) = prefix_image_bound(phi, n)
            by thm positive_nat_max_left_bound(prefix_image_bound(phi, n + 1 - 1), phi(n + 1))
            prefix_image_bound(phi, n) = prefix_image_bound(phi, n + 1 - 1) <= positive_nat_max(prefix_image_bound(phi, n + 1 - 1), phi(n + 1)) = prefix_image_bound(phi, n + 1)
            prefix_image_bound(phi, n) <= prefix_image_bound(phi, n + 1)
            by thm positive_nat_max_right_bound(prefix_image_bound(phi, n + 1 - 1), phi(n + 1))
            phi(n + 1) <= positive_nat_max(prefix_image_bound(phi, n + 1 - 1), phi(n + 1)) = prefix_image_bound(phi, n + 1)
            phi(n + 1) <= prefix_image_bound(phi, n + 1)
            claim:
                ? forall j N+:
                    j <= n + 1
                    =>:
                        phi(j) <= prefix_image_bound(phi, n + 1)
                by cases:
                    ? phi(j) <= prefix_image_bound(phi, n + 1)
                    case j <= n:
                        phi(j) <= prefix_image_bound(phi, n)
                        phi(j) <= prefix_image_bound(phi, n) <= prefix_image_bound(phi, n + 1)
                        phi(j) <= prefix_image_bound(phi, n + 1)
                    case j > n:
                        j >= n + 1
                        j = n + 1
                        phi(j) = phi(n + 1)
                        phi(j) <= prefix_image_bound(phi, n + 1)
            by def:
                ? $prefix_image_bound_bounds_up_to(phi, n + 1)
            $prefix_image_bound_bounds_up_to(phi, n + 1)

thm rearranged_series_nonnegative:
    ? forall a seq(R), phi fn(i_index N+) N+:
        $is_nonnegative_sequence(a)
        =>:
            $is_nonnegative_sequence(rearranged_series(a, phi))
    forall n N+:
        rearranged_series(a, phi)(n) = a(phi(n))
        phi(n) $in N+
        a(phi(n)) >= 0
        rearranged_series(a, phi)(n) >= 0
    by def:
        ? $is_nonnegative_sequence(rearranged_series(a, phi))

thm permutation_prefix_image_has_bound:
    ? forall phi fn(i_index N+) N+, n N+:
        $is_permutation_of_positive_integers(phi)
        =>:
            exist M N+ st {$has_bounded_prefix_image(phi, n, M)}
    have M N+ = prefix_image_bound(phi, n)
    by thm prefix_image_bound_bounds(phi, n)
    forall j N+:
        j <= n
        =>:
            phi(j) <= prefix_image_bound(phi, n)
            prefix_image_bound(phi, n) = M
            phi(j) <= M
    by def:
        ? $has_bounded_prefix_image(phi, n, M)
    witness exist M0 N+ st {$has_bounded_prefix_image(phi, n, M0)} from M:
        $has_bounded_prefix_image(phi, n, M)

thm bounded_preimage_witness_from_function:
    ? forall phi fn(i_index N+) N+, h fn(i_index N+) N+, j, M N+:
        h(j) <= M
        phi(h(j)) = j
        =>:
            exist t N+ st {t <= M, phi(t) = j}
    witness exist t N+ st {t <= M, phi(t) = j} from h(j):
        h(j) <= M
        phi(h(j)) = j

thm prefix_preimage_bound_from_right_inverse:
    ? forall phi fn(i_index N+) N+, h fn(i_index N+) N+, n, M N+:
        $prefix_image_bound_bounds_up_to(h, n)
        M = prefix_image_bound(h, n)
        forall j N+:
            phi(h(j)) = j
        =>:
            $has_bounded_prefix_preimage(phi, n, M)
    claim:
        ? forall j N+:
            j <= n
            =>:
                exist t N+ st {t <= M, phi(t) = j}
        h(j) <= prefix_image_bound(h, n)
        prefix_image_bound(h, n) = M
        h(j) <= M
        phi(h(j)) = j
        by thm bounded_preimage_witness_from_function(phi, h, j, M)
    by def:
        ? $has_bounded_prefix_preimage(phi, n, M)
    $has_bounded_prefix_preimage(phi, n, M)

thm permutation_prefix_preimage_has_bound:
    ? forall phi fn(i_index N+) N+, n N+:
        $is_permutation_of_positive_integers(phi)
        =>:
            exist M N+ st {$has_bounded_prefix_preimage(phi, n, M)}
    have fn preimage_func by exist!:
        ? forall y N+:
            exist! x N+ st {phi(x) = y}
        exist! x N+ st {phi(x) = y}
    have M N+ = prefix_image_bound(preimage_func, n)
    by thm prefix_image_bound_bounds(preimage_func, n)
    claim:
        ? forall j N+:
            phi(preimage_func(j)) = j
        j = phi(preimage_func(j))
        phi(preimage_func(j)) = j
    by thm prefix_preimage_bound_from_right_inverse(phi, preimage_func, n, M)
    witness exist M0 N+ st {$has_bounded_prefix_preimage(phi, n, M0)} from M:
        $has_bounded_prefix_preimage(phi, n, M)

