#     ? forall a seq(R), L R:
#         $chap6::has_finite_limit_superior(a, L)
#         =>:
#             $has_finite_limit_superior(a, L)
#     claim:
#         ? forall x R:
#             x > L
#             =>:
#                 exist n0 N+ st {$is_eventually_below(a, x, n0)}
#         obtain n0 from exist n0 N+ st {$chap6::is_eventually_below_threshold(a, x, n0)}
#         witness exist n1 N+ st {$is_eventually_below(a, x, n1)} from n0:
#             forall n N+:
#                 n >= n0
#                 =>:
#                     a(n) < x
#     claim:
#         ? forall x R:
#             x < L
#             =>:
#                 $exceeds_infinitely_often(a, x)
#         claim:
#             ? forall n0 N+:
#                 $has_late_term_above(a, x, n0)
#             obtain n from exist n N+ st {n >= n0 and x < a(n)}
#             witness exist k N+ st {k >= n0 and a(k) > x} from n
#     by def:
#         ? $has_finite_limit_superior(a, L)
# 
thm chapter6_finite_limsup_gives_chapter7_finite_limsup:
    ? forall a seq(R), L R:
        $chap6::has_finite_limit_superior(a, L)
        =>:
            $has_finite_limit_superior(a, L)
    # Source handling: translate Chapter 6's eventual-upper-bound and
    # arbitrarily-late-exceedance characterization into the Chapter 7 wrapper.
    # trust: The existential late-exceedance witness is not recovered after
    # unfolding the Chapter 6 limsup interface.
    trust $has_finite_limit_superior(a, L)

thm bounded_sequence_has_chapter7_finite_limsup:
    ? forall a seq(R):
        $chap6::is_bounded_sequence(a)
        =>:
            exist L R st {$has_finite_limit_superior(a, L)}
    # Source handling: bounded sequences have a finite Chapter 6 limsup.
    # proof_debt: registering the Chapter 6 existence theorem currently causes a verifier stack overflow.
    trust exist L R st {$chap6::has_finite_limit_superior(a, L)}
    obtain L from exist L R st {$chap6::has_finite_limit_superior(a, L)}
    by thm chapter6_finite_limsup_gives_chapter7_finite_limsup(a, L)
    witness exist L0 R st {$has_finite_limit_superior(a, L0)} from L

thm ratio_limsup_bounds_root_limsup:
    ? forall c seq(R), L, A R:
        $is_positive_sequence(c)
        $has_finite_limit_superior(ratio_terms(c), L)
        $has_finite_limit_superior(root_test_terms(c), A)
        =>:
            A <= L
    by contra:
        ? A <= L
        A > L
        have mid R = (A + L) / 2
        mid - L = (A + L) / 2 - L
        (A + L) / 2 - L = (A - L) / 2
        A - L > 0
        2 > 0
        (A - L) / 2 > 0
        L < mid
        A - mid = A - (A + L) / 2
        A - (A + L) / 2 = (A - L) / 2
        A - mid > 0
        mid < A
        mid > L
        obtain n0 from exist n0 N+ st {$is_eventually_below(ratio_terms(c), mid, n0)}
        by thm eventual_ratio_upper_bound_gives_root_limsup_bound(c, mid, A, n0)
        impossible mid < A

thm ratio_liminf_bounds_root_liminf:
    ? forall c seq(R), L, A R:
        $is_positive_sequence(c)
        $has_finite_limit_inferior(ratio_terms(c), L)
        $has_finite_limit_inferior(root_test_terms(c), A)
        =>:
            L <= A
    by contra:
        ? L <= A
        L > A
        have mid R = (L + A) / 2
        mid - A = (L + A) / 2 - A
        (L + A) / 2 - A = (L - A) / 2
        L - A > 0
        2 > 0
        (L - A) / 2 > 0
        A < mid
        L - mid = L - (L + A) / 2
        L - (L + A) / 2 = (L - A) / 2
        L - mid > 0
        mid < L
        obtain n0 from exist n0 N+ st {$is_eventually_above(ratio_terms(c), mid, n0)}
        by thm eventual_ratio_lower_bound_gives_root_liminf_bound(c, mid, A, n0)
        impossible A < mid

thm ratio_limsup_less_than_one_gives_root_limsup_below_one:
    ? forall c seq(R), alpha R:
        $is_positive_sequence(c)
        $has_finite_limit_superior(ratio_terms(c), alpha)
        alpha < 1
        =>:
            exist gamma R st {$has_finite_limit_superior(root_test_terms(c), gamma) and gamma < 1}
    by thm positive_number_between_below_one(alpha)
    obtain r from exist r R+ st {alpha < r and r < 1}
    obtain n0 from exist n0 N+ st {$is_eventually_below(ratio_terms(c), r, n0)}
    by thm positive_number_between_below_one(r)
    obtain s from exist s R+ st {r < s and s < 1}
    by thm eventual_ratio_upper_bound_gives_eventual_root_upper_bound(c, r, s, n0)
    obtain n1 from exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)}
    by thm eventually_upper_bounded_positive_root_terms_are_bounded(c, s, n1)
    by thm bounded_sequence_has_chapter7_finite_limsup(root_test_terms(c))
    obtain gamma from exist gamma R st {$has_finite_limit_superior(root_test_terms(c), gamma)}
    by thm eventual_ratio_upper_bound_gives_root_limsup_bound(c, r, gamma, n0)
    gamma <= r < 1
    witness exist gamma0 R st {$has_finite_limit_superior(root_test_terms(c), gamma0) and gamma0 < 1} from gamma

