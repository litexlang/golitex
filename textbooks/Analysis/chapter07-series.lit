thm ratio_liminf_greater_than_one_gives_failure_of_zero_limit:
    ? forall c seq(R), beta R:
        $is_positive_sequence(c)
        $has_finite_limit_inferior(ratio_terms(c), beta)
        beta > 1
        =>:
            not $has_limit(c, 0)
    # Source handling: choose 1 < s < r < beta, obtain an eventual lower root
    # bound above one, and contradict convergence of c to zero.
    # trust: Even the explicit midpoint arithmetic remains a VerifyError.
    trust not $has_limit(c, 0)

