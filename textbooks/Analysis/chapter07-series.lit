# Chapter 7: Series.

# 7.1 Finite series

"""
Definition 7.1.1 (Finite series). A finite sum over an integer interval is
defined recursively: an empty interval has sum 0, and extending the upper
endpoint adds the next term.
"""

# The notation `sum(m, n, f)` means a finite sum over the closed integer
# interval [m, n], so it is used when `m <= n`.  Tao's empty-sum case is
# represented either by the scalar `0` directly or by a recursive finite-series
# function whose length is `0`.

# Tao's recursive finite series can be modeled directly by induction on the
# length of the interval.  The sketch below shows that recursive object; later
# theorems use `sum(m, n, f)` for the ordinary nonempty finite interval.

sketch:
    have a fn(i_index Z) R
    have m Z

    have fn recursive_finite_series(f fn(i_index Z) R, start Z, length N) R by induc length from 0:
        case length = 0: 0
        case length >= 1: recursive_finite_series(f, start, length - 1) + f(start + length - 1)

    recursive_finite_series(a, m, 0) = 0

    recursive_finite_series(a, m, 1) = recursive_finite_series(a, m, 0) + a(m + 1 - 1)
    m + 1 - 1 = m
    a(m + 1 - 1) = a(m)
    recursive_finite_series(a, m, 0) + a(m + 1 - 1) = 0 + a(m + 1 - 1)
    0 + a(m + 1 - 1) = 0 + a(m)
    recursive_finite_series(a, m, 1) = recursive_finite_series(a, m, 0) + a(m + 1 - 1) = 0 + a(m + 1 - 1) = 0 + a(m)
    recursive_finite_series(a, m, 1) = 0 + a(m)
    0 + a(m) = a(m)
    recursive_finite_series(a, m, 1) = 0 + a(m) = a(m)

    recursive_finite_series(a, m, 2) = recursive_finite_series(a, m, 1) + a(m + 2 - 1)
    m + 2 - 1 = m + 1
    a(m + 2 - 1) = a(m + 1)
    recursive_finite_series(a, m, 1) + a(m + 2 - 1) = a(m) + a(m + 2 - 1)
    a(m) + a(m + 2 - 1) = a(m) + a(m + 1)
    recursive_finite_series(a, m, 2) = recursive_finite_series(a, m, 1) + a(m + 2 - 1) = a(m) + a(m + 2 - 1) = a(m) + a(m + 1)
    recursive_finite_series(a, m, 2) = a(m) + a(m + 1)

thm finite_series_basic_cases:
    ? forall a fn(i_index Z) R, m Z:
        sum(m, m, fn(i_index Z) R {a(i_index)}) = a(m)
        sum(m, m + 1, fn(i_index Z) R {a(i_index)}) = a(m) + a(m + 1)
    sum(m, m, fn(i_index Z) R {a(i_index)}) = a(m)
    sum(m, m + 1, fn(i_index Z) R {a(i_index)}) = sum(m, m, fn(i_index Z) R {a(i_index)}) + fn(i_index Z) R {a(i_index)}(m + 1)
    fn(i_index Z) R {a(i_index)}(m + 1) = a(m + 1)
    sum(m, m, fn(i_index Z) R {a(i_index)}) + fn(i_index Z) R {a(i_index)}(m + 1) = a(m) + fn(i_index Z) R {a(i_index)}(m + 1)
    a(m) + fn(i_index Z) R {a(i_index)}(m + 1) = a(m) + a(m + 1)
    sum(m, m + 1, fn(i_index Z) R {a(i_index)}) = sum(m, m, fn(i_index Z) R {a(i_index)}) + fn(i_index Z) R {a(i_index)}(m + 1) = a(m) + fn(i_index Z) R {a(i_index)}(m + 1) = a(m) + a(m + 1)
    sum(m, m + 1, fn(i_index Z) R {a(i_index)}) = a(m) + a(m + 1)

"""
Remark 7.1.2. The word "series" names the expression, while "sum" names its
value.  The distinction is linguistic; mathematically the value is the real
number produced by the finite-sum expression.
"""

"""
Remark 7.1.3. The summation index is a bound variable; renaming it does not
change the finite sum.
"""

thm finite_series_dummy_index:
    ? forall a fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) = sum(m, n, fn(j Z) R {a(j)})

"""
Lemma 7.1.4. Finite sums split across adjacent intervals, shift indices,
respect addition and scalar multiplication, satisfy the triangle inequality,
and are monotone under pointwise comparison.
"""

# These are the standard finite-sum induction facts used throughout the series
# chapter: splitting intervals, shifting indices, distributing over addition
# and scalar multiplication, triangle inequality, and comparison.

thm finite_series_split_range:
    ? forall a fn(i_index Z) R, m, n, p Z:
        m <= n
        n < p
        m <= p
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) + sum(n + 1, p, fn(i_index Z) R {a(i_index)}) = sum(m, p, fn(i_index Z) R {a(i_index)})

thm finite_series_shift_index:
    ? forall a fn(i_index Z) R, m, n, k Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) = sum(m + k, n + k, fn(j Z) R {a(j - k)})
    sum(m, n, fn(i_index Z) R {a(i_index)}) = sum(m + k, n + k, fn(j Z) R {a(j - k)})

thm finite_series_add:
    ? forall a, b fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index) + b(i_index)}) = sum(m, n, fn(i_index Z) R {a(i_index)}) + sum(m, n, fn(i_index Z) R {b(i_index)})

thm finite_series_scalar_mul:
    ? forall a fn(i_index Z) R, c R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {c * a(i_index)}) = c * sum(m, n, fn(i_index Z) R {a(i_index)})

thm finite_series_scalar_mul_positive_range:
    ? forall a fn(i_index N+) R, c R, m, n N+:
        m <= n
        =>:
            sum(m, n, fn(i_index N+) R {c * a(i_index)}) = c * sum(m, n, fn(i_index N+) R {a(i_index)})

thm finite_series_triangle:
    ? forall a fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            abs(sum(m, n, fn(i_index Z) R {a(i_index)})) <= sum(m, n, fn(i_index Z) R {abs(a(i_index))})

thm finite_series_comparison:
    ? forall a, b fn(i_index Z) R, m, n Z:
        m <= n
        forall i_index Z:
            m <= i_index <= n
            =>:
                a(i_index) <= b(i_index)
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) <= sum(m, n, fn(i_index Z) R {b(i_index)})
    by thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index Z) R {a(i_index)}), sum(m, n, fn(i_index Z) R {b(i_index)}))

"""
Remark 7.1.5. Parentheses around summands are often omitted when the dummy
index makes the intended grouping unambiguous.
"""

"""
Definition 7.1.6 (Summations over finite sets). A finite-set sum is first
described by choosing a bijective enumeration of the finite set, then summing
the values along the index range.
"""

# Tao's construction chooses a bijection from `1...finite_set_size(X)` onto `X`.  The
# predicate below says exactly that every element of `X` appears at a unique
# index in the closed range.

prop is_bijection_from_index_range_to_finite_set(X finite_set, g fn(i_index closed_range(1, finite_set_size(X))) X):
    forall x X:
        exist! i_index closed_range(1, finite_set_size(X)) st {g(i_index) = x}

# Tao's construction also needs existence of at least one such enumeration.
# The proof follows the source idea: induct on the size of the nonempty finite
# set, remove one element, enumerate the smaller set, and append the removed
# element at the last index.

prop finite_set_size_has_index(n N+):
    forall s finite_set:
        $is_finite_set(s)
        finite_set_size(s) = n
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}

thm intersect_with_singleton:
    ? forall s set, a set:
        a $in s
        =>:
            intersect(s, {a}) = {a}
    by extension:
        ? intersect(s, {a}) = {a}
        forall z intersect(s, {a}):
            z $in s
            z $in {a}
            z = a
        forall z {a}:
            z = a
            a $in s
            z $in s
            z $in {a}

thm remove_singleton_from_singleton_sized_set_is_empty:
    ? forall s finite_set, a set:
        $is_finite_set(s)
        finite_set_size(s) = 1
        a $in s
        =>:
            set_minus(s, {a}) = {}
    by thm intersect_with_singleton(s, a)
    $is_finite_set({a})
    $is_finite_set(intersect(s, {a}))
    finite_set_size({a}) = 1
    finite_set_size(intersect(s, {a})) = finite_set_size({a}) = 1
    $is_finite_set(set_minus(s, {a}))
    finite_set_size(set_minus(s, {a})) = finite_set_size(s) - finite_set_size(intersect(s, {a}))
    finite_set_size(s) - finite_set_size(intersect(s, {a})) = 1 - 1 = 0
    finite_set_size(set_minus(s, {a})) = 0
    by extension:
        ? set_minus(s, {a}) = {}
        claim:
            ? forall x set_minus(s, {a}):
                x $in {}
            by contra:
                ? x $in {}
                witness $is_nonempty_set(set_minus(s, {a})) from x
                finite_set_size(set_minus(s, {a})) >= 1
                impossible finite_set_size(set_minus(s, {a})) = 0
        claim:
            ? forall x {}:
                x $in set_minus(s, {a})
            by contra:
                ? x $in set_minus(s, {a})
                impossible x $in {}

thm index_function_for_singleton:
    ? forall s finite_set:
        $is_finite_set(s)
        finite_set_size(s) = 1
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
    finite_set_size(s) >= 1
    $is_nonempty_set(s)
    have a s
    by thm remove_singleton_from_singleton_sized_set_is_empty(s, a)
    have fn idx(i_index closed_range(1, finite_set_size(s))) s = a
    witness exist idx0 fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx0)} from idx:
        claim:
            ? forall y s:
                exist! i_index closed_range(1, finite_set_size(s)) st {idx0(i_index) = y}
            by contra:
                ? y = a
                y != a
                y $in set_minus(s, {a})
                witness $is_nonempty_set(set_minus(s, {a})) from y:
                    y $in set_minus(s, {a})
                impossible $is_nonempty_set(set_minus(s, {a}))
            idx0(1) = idx(1) = a
            witness exist! i_index closed_range(1, finite_set_size(s)) st {idx0(i_index) = y} from 1:
                1 <= finite_set_size(s)
                idx0(1) = y
                claim:
                    ? forall i1, i2 closed_range(1, finite_set_size(s)):
                        idx0(i1) = y
                        idx0(i2) = y
                        =>:
                            i1 = i2
                    i1 >= 1
                    i1 <= finite_set_size(s)
                    i1 <= 1
                    i1 = 1
                    i2 >= 1
                    i2 <= finite_set_size(s)
                    i2 <= 1
                    i2 = 1
                    i1 = i2
        by def:
            ? $is_bijection_from_index_range_to_finite_set(s, idx0)
        $is_bijection_from_index_range_to_finite_set(s, idx0)

thm index_function_step:
    ? forall n N+, s finite_set:
        $is_finite_set(s)
        finite_set_size(s) = n + 1
        $finite_set_size_has_index(n)
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
    finite_set_size(s) = n + 1 >= 1
    $is_nonempty_set(s)
    have a s
    by thm intersect_with_singleton(s, a)
    $is_finite_set({a})
    $is_finite_set(intersect(s, {a}))
    finite_set_size({a}) = 1
    finite_set_size(intersect(s, {a})) = finite_set_size({a}) = 1
    $is_finite_set(set_minus(s, {a}))
    finite_set_size(set_minus(s, {a})) = finite_set_size(s) - finite_set_size(intersect(s, {a}))
    finite_set_size(s) - finite_set_size(intersect(s, {a})) = (n + 1) - 1 = n
    finite_set_size(set_minus(s, {a})) = n
    $finite_set_size_has_index(n)
    obtain prev from exist prev fn(i_index closed_range(1, finite_set_size(set_minus(s, {a})))) set_minus(s, {a}) st {$is_bijection_from_index_range_to_finite_set(set_minus(s, {a}), prev)}
    set_minus(s, {a}) $subset s
    have fn idx(i_index closed_range(1, finite_set_size(s))) s by cases:
        case i_index <= n: prev(i_index)
        case i_index > n: a
    claim:
        ? forall i_index closed_range(1, finite_set_size(s)):
            idx(i_index) = a
            =>:
                i_index = n + 1
        i_index <= n or i_index > n
        by cases:
            ? i_index = n + 1
            case i_index <= n:
                i_index >= 1
                i_index <= n = finite_set_size(set_minus(s, {a}))
                i_index $in closed_range(1, finite_set_size(set_minus(s, {a})))
                idx(i_index) = prev(i_index)
                prev(i_index) $in set_minus(s, {a})
                idx(i_index) $in set_minus(s, {a})
                claim:
                    ? not a $in set_minus(s, {a})
                    by contra:
                        ? not a $in set_minus(s, {a})
                        a $in set_minus(s, {a})
                        not a $in {a}
                        a $in {a}
                        impossible not a $in {a}
                a $in set_minus(s, {a})
                impossible not a $in set_minus(s, {a})
            case i_index > n:
                i_index <= finite_set_size(s) = n + 1
                i_index >= n + 1
                i_index = n + 1
    claim:
        ? forall i1, i2 closed_range(1, finite_set_size(s)):
            idx(i1) = idx(i2)
            =>:
                i1 = i2
        i1 <= n or i1 > n
        by cases:
            ? i1 = i2
            case i1 <= n:
                i2 <= n or i2 > n
                by cases:
                    ? i1 = i2
                    case i2 <= n:
                        i1 >= 1
                        i2 >= 1
                        i1 <= n = finite_set_size(set_minus(s, {a}))
                        i2 <= n = finite_set_size(set_minus(s, {a}))
                        i1 $in closed_range(1, finite_set_size(set_minus(s, {a})))
                        i2 $in closed_range(1, finite_set_size(set_minus(s, {a})))
                        idx(i1) = prev(i1)
                        idx(i2) = prev(i2)
                        prev(i1) = prev(i2)
                        exist! j closed_range(1, finite_set_size(set_minus(s, {a}))) st {prev(j) = prev(i1)}
                        i1 = i2
                    case i2 > n:
                        i2 <= finite_set_size(s) = n + 1
                        i2 >= n + 1
                        i2 = n + 1
                        idx(i2) = a
                        idx(i1) = idx(i2) = a
                        i1 = n + 1
                        impossible i1 <= n
            case i1 > n:
                i1 <= finite_set_size(s) = n + 1
                i1 >= n + 1
                i1 = n + 1
                idx(i1) = a
                idx(i2) = idx(i1) = a
                i2 = n + 1
                i1 = i2
    claim:
        ? forall y s:
            exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)}
        y = a or y != a
        by cases:
            ? exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)}
            case y = a:
                n + 1 <= finite_set_size(s)
                y = a = idx(n + 1)
                witness exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)} from n + 1:
                    n + 1 <= finite_set_size(s)
                    y = idx(n + 1)
            case y != a:
                y $in set_minus(s, {a})
                obtain j from exist i_index closed_range(1, finite_set_size(set_minus(s, {a}))) st {prev(i_index) = y}
                j <= finite_set_size(set_minus(s, {a}))
                j <= n
                n <= n + 1
                j <= n <= n + 1 = finite_set_size(s)
                y = prev(j) = idx(j)
                witness exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)} from j:
                    j <= finite_set_size(s)
                    y = idx(j)
    witness exist idx0 fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx0)} from idx:
        claim:
            ? forall y s:
                exist! i_index closed_range(1, finite_set_size(s)) st {idx0(i_index) = y}
            obtain i_index from exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)}
            witness exist! i0 closed_range(1, finite_set_size(s)) st {idx0(i0) = y} from i_index:
                idx0(i_index) = idx(i_index) = y
                forall i1, i2 closed_range(1, finite_set_size(s)):
                    idx0(i1) = y
                    idx0(i2) = y
                    =>:
                        idx(i1) = idx0(i1) = y = idx0(i2) = idx(i2)
                        i1 = i2
        by def:
            ? $is_bijection_from_index_range_to_finite_set(s, idx0)
        $is_bijection_from_index_range_to_finite_set(s, idx0)

thm finite_set_size_has_index_for_all:
    ? forall n N+:
        $finite_set_size_has_index(n)
    by induc n from 1:
        ? $finite_set_size_has_index(n)

        ? from n = 1:
            claim:
                ? forall s finite_set:
                    $is_finite_set(s)
                    finite_set_size(s) = 1
                    =>:
                        exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
                by thm index_function_for_singleton(s)
            by def:
                ? $finite_set_size_has_index(1)
            $finite_set_size_has_index(1)
            $finite_set_size_has_index(n)

        ? induc:
            $finite_set_size_has_index(n)
            claim:
                ? forall s finite_set:
                    $is_finite_set(s)
                    finite_set_size(s) = n + 1
                    =>:
                        exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
                by thm index_function_step(n, s)
            by def:
                ? $finite_set_size_has_index(n + 1)
            $finite_set_size_has_index(n + 1)

thm finite_set_has_bijective_index:
    ? forall s finite_set:
        finite_set_size(s) >= 1
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
    by thm finite_set_size_has_index_for_all(finite_set_size(s))

# `finite_set_sum(X, f)` denotes the enumeration-independent value of summing
# `f` over the finite set `X`.

forall X finite_set, f fn(x X) R:
    finite_set_sum(X, f) $in R

"""
Example 7.1.7. For a three-element set with values 2, 5, and -1, two different
enumerations give the same finite-set sum.
"""

# We use the numeric labels 1, 2, 3 for Tao's abstract objects a, b, c.  The
# function below has exactly the source values f(1)=2, f(2)=5, f(3)=-1.

sketch:
    have fn example_7_1_7_f(x Z) R = (-9 * x^2 + 33 * x - 20) / 2

    example_7_1_7_f(1) = 2
    example_7_1_7_f(2) = 5
    example_7_1_7_f(3) = -1

    finite_set_sum({1, 2, 3}, example_7_1_7_f) = 2 + 5 + (-1)
    finite_set_sum({1, 2, 3}, example_7_1_7_f) = 6
    finite_set_sum({3, 2, 1}, example_7_1_7_f) = -1 + 5 + 2
    finite_set_sum({3, 2, 1}, example_7_1_7_f) = 6
    finite_set_sum({1, 2, 3}, example_7_1_7_f) = finite_set_sum({3, 2, 1}, example_7_1_7_f)

"""
Proposition 7.1.8 (Finite summations are well-defined). Different bijective
enumerations of the same finite set give the same finite sum.
"""

# Once both enumerators list every element of `X` exactly once, the two ordinary
# closed-range sums are equal.  This is the enumeration-independence step in
# Tao's construction.

thm finite_set_sum_enumeration_well_defined:
    ? forall X finite_set, f fn(x X) R, g fn(i_index closed_range(1, finite_set_size(X))) X, h fn(i_index closed_range(1, finite_set_size(X))) X:
        finite_set_size(X) >= 1
        $is_bijection_from_index_range_to_finite_set(X, g)
        $is_bijection_from_index_range_to_finite_set(X, h)
        =>:
            sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(h(i_index))})
    by def:
        ? $is_bijection_from_index_range_to_finite_set(X, g)
    by def:
        ? $is_bijection_from_index_range_to_finite_set(X, h)
    forall x X:
        exist! i_index closed_range(1, finite_set_size(X)) st {g(i_index) = x}
    forall x X:
        exist! i_index closed_range(1, finite_set_size(X)) st {h(i_index) = x}
    sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(h(i_index))})

# The predicate says that `l` is the common value of all bijective-enumeration
# sums.  We keep Tao's finite real-set hypothesis visible, and we keep the
# nonempty hypothesis explicit because the closed-range expression
# `sum(1, finite_set_size(X), ...)` requires `1 <= finite_set_size(X)`.

prop is_finite_set_sum(X finite_set, f fn(x X) R, l R):
    X $subset R
    finite_set_size(X) >= 1
    forall g fn(i_index closed_range(1, finite_set_size(X))) X:
        $is_bijection_from_index_range_to_finite_set(X, g)
        =>:
            sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l

thm finite_set_sum_matches_bijective_enumeration:
    ? forall X finite_set, f fn(x X) R, g fn(i_index closed_range(1, finite_set_size(X))) X:
        finite_set_size(X) >= 1
        $is_bijection_from_index_range_to_finite_set(X, g)
        =>:
            sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = finite_set_sum(X, f)
    by thm finite_set_sum_substitution(finite_set_sum(X, f), finite_set_sum(closed_range(1, finite_set_size(X)), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}))
    finite_set_sum(X, f) = finite_set_sum(closed_range(1, finite_set_size(X)), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))})
    finite_set_sum(closed_range(1, finite_set_size(X)), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))})
    sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = finite_set_sum(X, f)

thm finite_set_sum_satisfies_self_definition:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            $is_finite_set_sum(X, f, finite_set_sum(X, f))
    claim:
        ? forall g fn(i_index closed_range(1, finite_set_size(X))) X:
            $is_bijection_from_index_range_to_finite_set(X, g)
            =>:
                sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = finite_set_sum(X, f)
        by thm finite_set_sum_matches_bijective_enumeration(X, f, g)
    by def:
        ? $is_finite_set_sum(X, f, finite_set_sum(X, f))

prop has_finite_set_sum(X finite_set, f fn(x X) R):
    exist l R st {$is_finite_set_sum(X, f, l)}

thm finite_set_sum_exists:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            $has_finite_set_sum(X, f)
    by thm finite_set_sum_satisfies_self_definition(X, f)
    witness exist l R st {$is_finite_set_sum(X, f, l)} from finite_set_sum(X, f)
    by def:
        ? $has_finite_set_sum(X, f)

# This construction chooses the unique value whose existence was just proved,
# matching Tao's idea: once all enumerations give the same sum, that common
# value is "the" finite-set sum.

template<X finite_set, f fn(x X) R: X $subset R, finite_set_size(X) >= 1, $has_finite_set_sum(X, f)>:
    obtain self_finite_set_sum from exist l R st {$is_finite_set_sum(X, f, l)}

thm self_finite_set_sum_satisfies_definition:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            $is_finite_set_sum(X, f, \self_finite_set_sum<X, f>)
    by thm finite_set_sum_exists(X, f)

thm finite_set_sum_value_unique:
    ? forall X finite_set, f fn(x X) R, l1, l2 R:
        $is_finite_set_sum(X, f, l1)
        $is_finite_set_sum(X, f, l2)
        =>:
            l1 = l2
    finite_set_size(X) >= 1
    by thm finite_set_has_bijective_index(X)
    obtain g from exist g fn(i_index closed_range(1, finite_set_size(X))) X st {$is_bijection_from_index_range_to_finite_set(X, g)}
    sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l1
    sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l2
    l1 = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l2

thm self_finite_set_sum_matches_builtin:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            \self_finite_set_sum<X, f> = finite_set_sum(X, f)
    by thm self_finite_set_sum_satisfies_definition(X, f)
    by thm finite_set_sum_satisfies_self_definition(X, f)
    by thm finite_set_sum_value_unique(X, f, \self_finite_set_sum<X, f>, finite_set_sum(X, f))

thm finite_set_sum_well_defined_under_permutation:
    ? forall X finite_set, f fn(x X) R, g fn(x X) X:
        forall y X:
            exist! x X st {g(x) = y}
        =>:
            finite_set_sum(X, fn(x X) R {f(g(x))}) = finite_set_sum(X, f)
    by thm finite_set_sum_substitution(finite_set_sum(X, fn(x X) R {f(g(x))}), finite_set_sum(X, f))

"""
Remark 7.1.9. Infinite-set summation is more delicate; it is deferred until
absolute convergence and countability are available.
"""

# Chapter 8 returns to summation over countable sets.  Chapter 7 only needs
# finite sets and ordinary one-dimensional infinite series.

"""
Remark 7.1.10. A sum over elements satisfying a property is shorthand for a sum
over the corresponding finite subset.
"""

# In Litex this is just `finite_set_sum({x X: $P(x)}, f)` once the filtered set
# is known to be finite.

"""
Proposition 7.1.11 (Basic properties of summation over finite sets). Finite-set
sums have empty, singleton, substitution, disjoint-union, linearity,
monotonicity, and triangle-inequality laws.
"""

# Finite-set sums inherit their empty, singleton, substitution, union,
# linearity, monotonicity, and triangle facts from finite enumeration and the
# corresponding ordinary finite-sum laws.

thm finite_set_sum_empty:
    ? forall f fn(x {}) R:
        finite_set_sum({}, f) = 0

thm finite_set_sum_singleton:
    ? forall x0 R, f fn(x {x0}) R:
        finite_set_sum({x0}, f) = f(x0)

thm finite_set_sum_reindex:
    ? forall X, Y finite_set, f fn(x X) R, g fn(y Y) X:
        forall x X:
            exist! y Y st {g(y) = x}
        =>:
            finite_set_sum(X, f) = finite_set_sum(Y, fn(y Y) R {f(g(y))})
    by thm finite_set_sum_substitution(finite_set_sum(X, f), finite_set_sum(Y, fn(y Y) R {f(g(y))}))

thm finite_set_sum_range_matches_series:
    ? forall a fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) = finite_set_sum(m...n, fn(i_index m...n) R {a(i_index)})

thm finite_set_sum_disjoint_union:
    ? forall X, Y finite_set, f fn(z union(X, Y)) R:
        intersect(X, Y) = {}
        =>:
            finite_set_sum(union(X, Y), f) = finite_set_sum(X, fn(x X) R {f(x)}) + finite_set_sum(Y, fn(y Y) R {f(y)})

thm finite_set_sum_add:
    ? forall X finite_set, f, g fn(x X) R:
        finite_set_sum(X, fn(x X) R {f(x) + g(x)}) = finite_set_sum(X, f) + finite_set_sum(X, g)

thm finite_set_sum_scalar_mul:
    ? forall X finite_set, f fn(x X) R, c R:
        finite_set_sum(X, fn(x X) R {c * f(x)}) = c * finite_set_sum(X, f)

thm finite_set_sum_monotone:
    ? forall X finite_set, f, g fn(x X) R:
        forall x X:
            f(x) <= g(x)
        =>:
            finite_set_sum(X, f) <= finite_set_sum(X, g)
    by thm finite_set_sum_le_from_pointwise(finite_set_sum(X, f), finite_set_sum(X, g))

thm finite_set_sum_triangle:
    ? forall X finite_set, f fn(x X) R:
        abs(finite_set_sum(X, f)) <= finite_set_sum(X, fn(x X) R {abs(f(x))})

thm finite_set_sum_subset_le_for_nonnegative_terms:
    ? forall S, T finite_set, f fn(x S) R:
        T $subset S
        forall x S:
            f(x) >= 0
        =>:
            finite_set_sum(T, fn(x T) R {f(x)}) <= finite_set_sum(S, f)
    have R0 finite_set = set_minus(S, T)
    set_minus(S, T) $subset S
    R0 $subset S
    claim:
        ? S = union(T, R0)
        by extension:
            ? S = union(T, R0)
            claim:
                ? forall x S:
                    x $in union(T, R0)
                x $in T or not x $in T
                by cases:
                    ? x $in union(T, R0)
                    case x $in T:
                        x $in union(T, R0)
                    case not x $in T:
                        x $in set_minus(S, T)
                        x $in R0
                        x $in union(T, R0)
            claim:
                ? forall x union(T, R0):
                    x $in S
                x $in T or x $in R0
                by cases:
                    ? x $in S
                    case x $in T:
                        T $subset S
                        x $in S
                    case x $in R0:
                        R0 $subset S
                        x $in S
    claim:
        ? intersect(T, R0) = {}
        by extension:
            ? intersect(T, R0) = {}
            claim:
                ? forall x intersect(T, R0):
                    x $in {}
                x $in T
                x $in set_minus(S, T)
                not x $in T
                by contra:
                    ? x $in {}
                    impossible not x $in T
            claim:
                ? forall x {}:
                    x $in intersect(T, R0)
                by contra:
                    ? x $in intersect(T, R0)
                    impossible x $in {}
    by thm finite_set_sum_disjoint_union(T, R0, fn(x union(T, R0)) R {f(x)})
    finite_set_sum(S, f) = finite_set_sum(T, fn(x T) R {f(x)}) + finite_set_sum(R0, fn(x R0) R {f(x)})
    have fn zero_term(x R0) R = 0
    have fn remainder_term(x R0) R = f(x)
    claim:
        ? 0 <= finite_set_sum(R0, fn(x R0) R {f(x)})
        forall x R0:
            zero_term(x) = 0
            remainder_term(x) = f(x) >= 0
            zero_term(x) <= remainder_term(x)
        by thm finite_set_sum_monotone(R0, zero_term, remainder_term)
        by thm finite_set_sum_scalar_mul(R0, fn(y R0) R {1}, 0)
        finite_set_sum(R0, fn(y R0) R {0 * 1}) = 0 * finite_set_sum(R0, fn(y R0) R {1}) = 0
        finite_set_sum(R0, zero_term) = finite_set_sum(R0, fn(y R0) R {0}) = finite_set_sum(R0, fn(y R0) R {0 * 1}) = 0
        finite_set_sum(R0, fn(y R0) R {f(y)}) = finite_set_sum(R0, remainder_term) >= 0
    finite_set_sum(T, fn(x T) R {f(x)}) <= finite_set_sum(T, fn(x T) R {f(x)}) + finite_set_sum(R0, fn(x R0) R {f(x)})
    finite_set_sum(T, fn(x T) R {f(x)}) <= finite_set_sum(S, f)

"""
Remark 7.1.12. The substitution rule says that finite sums are invariant under
bijective reindexing.  This is why finite sequences may be rearranged freely.
"""

# This is exactly the content of `finite_set_sum_reindex` and
# `finite_set_sum_well_defined_under_permutation`.

"""
Lemma 7.1.13. A double finite sum over X and Y is the same as the finite-set
sum over the Cartesian product X x Y.
"""

thm finite_double_sum_over_cartesian_product:
    ? forall X, Y finite_set, f fn(z cart(X, Y)) R:
        finite_set_sum(X, fn(x X) R {finite_set_sum(Y, fn(y Y) R {f((x, y))})}) = finite_set_sum(cart(X, Y), f)

"""
Corollary 7.1.14 (Fubini's theorem for finite series). For finite sets, the
order of a double summation may be switched.
"""

thm finite_fubini:
    ? forall X, Y finite_set, f fn(z cart(X, Y)) R:
        finite_set_sum(X, fn(x X) R {finite_set_sum(Y, fn(y Y) R {f((x, y))})}) = finite_set_sum(Y, fn(y Y) R {finite_set_sum(X, fn(x X) R {f((x, y))})})

"""
Remark 7.1.15. Finite Fubini contrasts with the infinite double-sum examples
from Chapter 1.  Infinite sums require convergence hypotheses.
"""

# The rigorous infinite analogue waits until Chapter 8, where countability and
# absolute convergence are available.

# 7.2 Infinite series

"""
Definition 7.2.1 (Formal infinite series). A formal infinite series is an
expression with one real term for each index in an infinite tail.
"""

# The formal series itself is represented by its term sequence `a_{m} + a_{m+1} + ...`.
# At this point no value is assigned to the formal expression.

"""
Definition 7.2.2 (Convergence of series). A series converges to L when its
partial sums converge to L as a sequence.
"""

# `partial_sum(a, N)` is the Nth partial sum of the positive-indexed series.
# It is defined recursively to avoid coercing a finite integer range index into
# the `N+` domain of `seq(R)`.

have fn partial_sum(a seq(R), k N) R by induc k from 0:
    case k = 0: 0
    case k >= 1: partial_sum(a, k - 1) + a(k)

# A positive-index partial sum is its predecessor plus the new term.
thm partial_sum_successor:
    ? forall a seq(R), k N+:
        partial_sum(a, k) = partial_sum(a, k - 1) + a(k)

thm partial_sum_matches_finite_sum:
    ? forall a seq(R), k N+:
        partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
    by induc k from 1:
        ? partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})

        ? from k = 1:
            partial_sum(a, 0) = 0
            partial_sum(a, 1) = partial_sum(a, 0) + a(1) = 0 + a(1) = a(1) = sum(1, 1, fn(i_index N+) R {a(i_index)})

        ? induc:
            (k + 1) - 1 = k
            partial_sum(a, k + 1) = partial_sum(a, (k + 1) - 1) + a(k + 1)
            partial_sum(a, (k + 1) - 1) = partial_sum(a, k)
            partial_sum(a, (k + 1) - 1) + a(k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(a, k) + a(k + 1) = sum(1, k, fn(i_index N+) R {a(i_index)}) + a(k + 1)
            sum(1, k + 1, fn(i_index N+) R {a(i_index)}) = sum(1, k, fn(i_index N+) R {a(i_index)}) + fn(i_index N+) R {a(i_index)}(k + 1)
            fn(i_index N+) R {a(i_index)}(k + 1) = a(k + 1)
            sum(1, k, fn(i_index N+) R {a(i_index)}) + fn(i_index N+) R {a(i_index)}(k + 1) = sum(1, k, fn(i_index N+) R {a(i_index)}) + a(k + 1)
            sum(1, k, fn(i_index N+) R {a(i_index)}) + a(k + 1) = sum(1, k + 1, fn(i_index N+) R {a(i_index)})
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1) = sum(1, k, fn(i_index N+) R {a(i_index)}) + a(k + 1) = sum(1, k + 1, fn(i_index N+) R {a(i_index)})

thm partial_sum_split_after:
    ? forall a seq(R), m, n N+:
        m < n
        =>:
            partial_sum(a, n) = partial_sum(a, m) + sum(m + 1, n, fn(i_index N+) R {a(i_index)})
    by thm partial_sum_matches_finite_sum(a, n)
    by thm partial_sum_matches_finite_sum(a, m)
    partial_sum(a, n) = sum(1, n, fn(i_index N+) R {a(i_index)}) = sum(1, m, fn(i_index N+) R {a(i_index)}) + sum(m + 1, n, fn(i_index N+) R {a(i_index)}) = partial_sum(a, m) + sum(m + 1, n, fn(i_index N+) R {a(i_index)})

prop is_tail_close_to(a seq(R), L R, epsilon R+, N0 N+):
    forall n N+:
        n >= N0
        =>:
            abs(a(n) - L) <= epsilon

prop has_limit(a seq(R), L R):
    forall epsilon R+:
        exist N0 N+ st {$is_tail_close_to(a, L, epsilon, N0)}

# Chapter 6 uses strict epsilon tails, while this chapter's series interface
# uses closed tails.  A strict tail is also a closed tail with the same index.
thm strict_eventual_closeness_implies_closed_tail:
    ? forall a seq(R), L R, epsilon R+:
        $chap6::has_eventual_closeness_to(a, L, epsilon)
        =>:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
    obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(a, L, epsilon, n0)}
    witness exist n1 N+ st {$is_tail_close_to(a, L, epsilon, n1)} from n0:
        forall n N+:
            n >= n0
            =>:
                abs(a(n) - L) < epsilon
                abs(a(n) - L) <= epsilon
        by def:
            ? $is_tail_close_to(a, L, epsilon, n0)

thm strict_limit_implies_closed_limit:
    ? forall a seq(R), L R:
        $chap6::has_limit(a, L)
        =>:
            $has_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        by thm chap6::has_limit_gives_eventual_closeness(a, L, epsilon)
        by thm strict_eventual_closeness_implies_closed_tail(a, L, epsilon)
    by def:
        ? $has_limit(a, L)

# A closed epsilon/2 tail is a strict epsilon tail, so the two limit interfaces agree.
thm closed_limit_implies_strict_limit:
    ? forall a seq(R), L R:
        $has_limit(a, L)
        =>:
            $chap6::has_limit(a, L)
    claim:
        ? forall epsilon R+:
            $chap6::has_eventual_closeness_to(a, L, epsilon)
        epsilon / 2 $in R+
        epsilon / 2 < epsilon
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon / 2, n0)}
        witness exist n1 N+ st {$chap6::is_tail_close_to(a, L, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(a(n) - L) <= epsilon / 2 < epsilon
            by def:
                ? $chap6::is_tail_close_to(a, L, epsilon, n0)
        by def:
            ? $chap6::has_eventual_closeness_to(a, L, epsilon)
    by def:
        ? $chap6::has_limit(a, L)

# Pointwise equal sequences have the same strict limit because each epsilon
# tail transfers unchanged.
thm strict_limit_extensional:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $chap6::has_limit(a, L)
        =>:
            $chap6::has_limit(b, L)
    claim:
        ? forall epsilon R+:
            $chap6::has_eventual_closeness_to(b, L, epsilon)
        by thm chap6::has_limit_gives_eventual_closeness(a, L, epsilon)
        obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(a, L, epsilon, n0)}
        witness exist n1 N+ st {$chap6::is_tail_close_to(b, L, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    a(n) = b(n)
                    abs(b(n) - L) = abs(a(n) - L)
                    abs(a(n) - L) < epsilon
                    abs(b(n) - L) < epsilon
            by def:
                ? $chap6::is_tail_close_to(b, L, epsilon, n0)
        by def:
            ? $chap6::has_eventual_closeness_to(b, L, epsilon)
    by def:
        ? $chap6::has_limit(b, L)

have fn constant_sequence(c R) fn(k N+) R = fn(i_index N+) R {c}

thm constant_sequence_has_strict_limit:
    ? forall c R:
        $chap6::has_limit(constant_sequence(c), c)
    claim:
        ? forall epsilon R+:
            $chap6::has_eventual_closeness_to(constant_sequence(c), c, epsilon)
        witness exist n0 N+ st {$chap6::is_tail_close_to(constant_sequence(c), c, epsilon, n0)} from 1:
            forall k N+:
                k >= 1
                =>:
                    constant_sequence(c)(k) = c
                    constant_sequence(c)(k) - c = c - c = 0
                    abs(constant_sequence(c)(k) - c) = abs(0) = 0
                    0 < epsilon
                    abs(constant_sequence(c)(k) - c) < epsilon
            by def:
                ? $chap6::is_tail_close_to(constant_sequence(c), c, epsilon, 1)
        by def:
            ? $chap6::has_eventual_closeness_to(constant_sequence(c), c, epsilon)
    by def:
        ? $chap6::has_limit(constant_sequence(c), c)

prop has_series_sum(a seq(R), L R):
    $has_limit(fn(k N+) R {partial_sum(a, k)}, L)

prop is_convergent_series(a seq(R)):
    exist L R st {$has_series_sum(a, L)}

thm partial_sum_extensional:
    ? forall a, b seq(R), k N:
        forall n N+:
            a(n) = b(n)
        =>:
            partial_sum(a, k) = partial_sum(b, k)
    by induc k from 0:
        ? partial_sum(a, k) = partial_sum(b, k)

        ? from k = 0:
            partial_sum(a, 0) = 0 = partial_sum(b, 0)

        ? induc:
            (k + 1) - 1 = k
            partial_sum(a, k + 1) = partial_sum(a, (k + 1) - 1) + a(k + 1)
            partial_sum(a, (k + 1) - 1) = partial_sum(a, k)
            partial_sum(a, (k + 1) - 1) + a(k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(b, k + 1) = partial_sum(b, (k + 1) - 1) + b(k + 1)
            partial_sum(b, (k + 1) - 1) = partial_sum(b, k)
            partial_sum(b, (k + 1) - 1) + b(k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(b, k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k) = partial_sum(b, k)
            a(k + 1) = b(k + 1)
            partial_sum(a, k) + a(k + 1) = partial_sum(b, k) + a(k + 1)
            partial_sum(b, k) + a(k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1) = partial_sum(b, k) + a(k + 1) = partial_sum(b, k) + b(k + 1) = partial_sum(b, k + 1)

thm series_sum_extensional:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $has_series_sum(a, L)
        =>:
            $has_series_sum(b, L)
    claim:
        ? forall k N+:
            partial_sum(a, k) = partial_sum(b, k)
        by thm partial_sum_extensional(a, b, k)
    by thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, L)
    by thm strict_limit_extensional(fn(k N+) R {partial_sum(a, k)}, fn(k N+) R {partial_sum(b, k)}, L)
    by thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(b, k)}, L)
    by def:
        ? $has_series_sum(b, L)

thm series_convergence_extensional:
    ? forall a, b seq(R):
        forall n N+:
            a(n) = b(n)
        $is_convergent_series(a)
        =>:
            $is_convergent_series(b)
    obtain L from exist L R st {$has_series_sum(a, L)}
    by thm series_sum_extensional(a, b, L)
    witness exist M R st {$has_series_sum(b, M)} from L
    by def:
        ? $is_convergent_series(b)

have fn geometric_series_terms_from_one(x R) fn(i_index N+) R = fn(j N+) R {x^j}

thm geometric_series_from_one_partial_sum:
    ? forall x R, k N+:
        1 - x != 0
        =>:
            partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
    by induc k from 1:
        ? partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)

        ? from k = 1:
            partial_sum(geometric_series_terms_from_one(x), 0) = 0
            by thm partial_sum_successor(geometric_series_terms_from_one(x), 1)
            1 - 1 = 0
            geometric_series_terms_from_one(x)(1) = x^1
            x^1 = x
            partial_sum(geometric_series_terms_from_one(x), 1 - 1) + geometric_series_terms_from_one(x)(1) = 0 + x = x
            partial_sum(geometric_series_terms_from_one(x), 1) = x
            x = (x - x^(1 + 1)) / (1 - x)

        ? induc:
            partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
            k + 1 $in N+
            by thm partial_sum_successor(geometric_series_terms_from_one(x), k + 1)
            (k + 1) - 1 = k
            partial_sum(geometric_series_terms_from_one(x), (k + 1) - 1) = partial_sum(geometric_series_terms_from_one(x), k)
            partial_sum(geometric_series_terms_from_one(x), (k + 1) - 1) + geometric_series_terms_from_one(x)(k + 1) = partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = partial_sum(geometric_series_terms_from_one(x), (k + 1) - 1) + geometric_series_terms_from_one(x)(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1)
            geometric_series_terms_from_one(x)(k + 1) = x^(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + geometric_series_terms_from_one(x)(k + 1)
            (x - x^(k + 1)) / (1 - x) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + x^(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + x^(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = (x - x^(k + 1)) / (1 - x) + x^(k + 1)
            (x - x^(k + 1)) / (1 - x) + x^(k + 1) = (x - x^(k + 1) + x^(k + 1) * (1 - x)) / (1 - x)
            x - x^(k + 1) + x^(k + 1) * (1 - x) = x - x^(k + 1) * x
            x = x^1
            x^(k + 1) * x = x^(k + 1) * x^1
            x^(k + 1) * x^1 = x^((k + 1) + 1)
            x - x^(k + 1) + x^(k + 1) * (1 - x) = x - x^((k + 1) + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = (x - x^((k + 1) + 1)) / (1 - x)

have fn geometric_series_from_one_tail(x R) fn(k N+) R = fn(n N+) R {x^(n + 1)}

thm geometric_series_from_one_tail_has_strict_limit_zero:
    ? forall x R:
        abs(x) < 1
        =>:
            $chap6::has_limit(geometric_series_from_one_tail(x), 0)
    by thm chap6::geometric_abs_lt_one_converges_to_zero(x)
    by thm chap6::seq_shift_has_limit(chap6::geom_seq(x), 0)
    claim:
        ? forall n N+:
            chap6::seq_shift(chap6::geom_seq(x))(n) = geometric_series_from_one_tail(x)(n)
        claim:
            ? chap6::seq_shift(chap6::geom_seq(x))(n) = chap6::geom_seq(x)(n + 1)
            by thm chap6::seq_shift_value(chap6::geom_seq(x), n)
        claim:
            ? chap6::geom_seq(x)(n + 1) = x^(n + 1)
            by thm chap6::geom_seq_value(x, n + 1)
        geometric_series_from_one_tail(x)(n) = x^(n + 1)
        chap6::seq_shift(chap6::geom_seq(x))(n) = x^(n + 1)
        chap6::seq_shift(chap6::geom_seq(x))(n) = geometric_series_from_one_tail(x)(n)
    by thm strict_limit_extensional(chap6::seq_shift(chap6::geom_seq(x)), geometric_series_from_one_tail(x), 0)

thm geometric_series_from_one_tail_has_limit_zero:
    ? forall x R:
        abs(x) < 1
        =>:
            $has_limit(geometric_series_from_one_tail(x), 0)
    by thm geometric_series_from_one_tail_has_strict_limit_zero(x)
    by thm strict_limit_implies_closed_limit(geometric_series_from_one_tail(x), 0)

thm geometric_series_from_one_formula:
    ? forall x R:
        abs(x) < 1
        1 - x != 0
        =>:
            $has_series_sum(geometric_series_terms_from_one(x), x / (1 - x))
    # The finite geometric-sum identity and ordinary scalar limit laws give the
    # displayed sum; no general quotient-limit theorem is needed because the
    # denominator is constant.
    have tail seq(R) = geometric_series_from_one_tail(x)
    by thm geometric_series_from_one_tail_has_strict_limit_zero(x)
    have numerator seq(R) = fn(k N+) R {x - tail(k)}
    by thm constant_sequence_has_strict_limit(x)
    by thm chap6::seq_sub_converges_to(constant_sequence(x), tail, x, 0)
    claim:
        ? forall k N+:
            constant_sequence(x)(k) - tail(k) = numerator(k)
        fn(i_index N+) R {constant_sequence(x)(i_index) - tail(i_index)}(k) = constant_sequence(x)(k) - tail(k)
        constant_sequence(x)(k) = x
        numerator(k) = x - tail(k)
        constant_sequence(x)(k) - tail(k) = x - tail(k) = numerator(k)
        fn(i_index N+) R {constant_sequence(x)(i_index) - tail(i_index)}(k) = x - tail(k) = numerator(k)
    by thm strict_limit_extensional(fn(i_index N+) R {constant_sequence(x)(i_index) - tail(i_index)}, numerator, x - 0)
    have scaled seq(R) = fn(k N+) R {(1 / (1 - x)) * numerator(k)}
    by thm chap6::seq_const_mul_converges_to(1 / (1 - x), numerator, x - 0)
    claim:
        ? forall k N+:
            (1 / (1 - x)) * numerator(k) = scaled(k)
        fn(i_index N+) R {(1 / (1 - x)) * numerator(i_index)}(k) = (1 / (1 - x)) * numerator(k)
        scaled(k) = (1 / (1 - x)) * numerator(k)
        (1 / (1 - x)) * numerator(k) = scaled(k)
        fn(i_index N+) R {(1 / (1 - x)) * numerator(i_index)}(k) = scaled(k)
    by thm strict_limit_extensional(fn(i_index N+) R {(1 / (1 - x)) * numerator(i_index)}, scaled, (1 / (1 - x)) * (x - 0))
    (1 / (1 - x)) * (x - 0) = x / (1 - x)
    claim:
        ? forall k N+:
            scaled(k) = partial_sum(geometric_series_terms_from_one(x), k)
        tail(k) = geometric_series_from_one_tail(x)(k)
        geometric_series_from_one_tail(x)(k) = x^(k + 1)
        tail(k) = x^(k + 1)
        numerator(k) = x - tail(k) = x - x^(k + 1)
        scaled(k) = (1 / (1 - x)) * numerator(k)
        (1 / (1 - x)) * numerator(k) = (1 / (1 - x)) * (x - x^(k + 1))
        (1 / (1 - x)) * (x - x^(k + 1)) = (x - x^(k + 1)) / (1 - x)
        scaled(k) = (x - x^(k + 1)) / (1 - x)
        by thm geometric_series_from_one_partial_sum(x, k)
        partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
    by thm strict_limit_extensional(scaled, fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, x / (1 - x))
    by thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, x / (1 - x))
    by def:
        ? $has_series_sum(geometric_series_terms_from_one(x), x / (1 - x))

thm real_power_at_least_one:
    ? forall y R, n N+:
        y >= 1
        =>:
            y^n >= 1
    by induc n from 1:
        ? y^n >= 1

        ? from n = 1:
            y^1 = y
            y^1 >= 1

        ? induc:
            y^n >= 1
            y^(n + 1) = y^n * y
            y^n * y >= 1 * 1
            1 * 1 = 1
            y^(n + 1) >= 1

thm geometric_series_from_one_diverges_when_abs_ge_one:
    ? forall x R:
        abs(x) >= 1
        =>:
            not $is_convergent_series(geometric_series_terms_from_one(x))
    by contra:
        ? not $is_convergent_series(geometric_series_terms_from_one(x))
        $is_convergent_series(geometric_series_terms_from_one(x))
        obtain L from exist L R st {$has_series_sum(geometric_series_terms_from_one(x), L)}
        $has_limit(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, L)
        1 / 3 $in R+
        obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, L, 1 / 3, n0)}
        n0 + 1 $in N+
        n0 >= n0
        n0 + 1 >= n0
        abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0) - L) <= 1 / 3
        abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1) - L) <= 1 / 3
        fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0) = partial_sum(geometric_series_terms_from_one(x), n0)
        fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0 + 1)
        abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) = abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) = abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) <= 1 / 3
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) <= 1 / 3
        (n0 + 1) - 1 = n0
        partial_sum(geometric_series_terms_from_one(x), (n0 + 1) - 1) = partial_sum(geometric_series_terms_from_one(x), n0)
        by thm partial_sum_successor(geometric_series_terms_from_one(x), n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) = partial_sum(geometric_series_terms_from_one(x), (n0 + 1) - 1) + geometric_series_terms_from_one(x)(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), (n0 + 1) - 1) + geometric_series_terms_from_one(x)(n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + geometric_series_terms_from_one(x)(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + geometric_series_terms_from_one(x)(n0 + 1)
        geometric_series_terms_from_one(x)(n0 + 1) = x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0) + geometric_series_terms_from_one(x)(n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0) = (partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)) - partial_sum(geometric_series_terms_from_one(x), n0)
        (partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)) - partial_sum(geometric_series_terms_from_one(x), n0) = x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0) = x^(n0 + 1)
        abs(x^(n0 + 1)) = abs(x)^(n0 + 1)
        by thm real_power_at_least_one(abs(x), n0 + 1)
        abs(x^(n0 + 1)) >= 1
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0) = (partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) = abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L))
        abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) <= 1 / 3 + 1 / 3
        1 / 3 + 1 / 3 = 2 / 3
        2 / 3 < 1
        1 / 3 + 1 / 3 < 1
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L))
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) <= 1 / 3 + 1 / 3
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= 1 / 3 + 1 / 3
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= 1 / 3 + 1 / 3 < 1
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) < 1
        abs(x^(n0 + 1)) = abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0))
        abs(x^(n0 + 1)) < 1
        1 <= abs(x^(n0 + 1))
        1 < 1
        impossible 1 = 1

"""
Remark 7.2.3. If a series converges, its sum is unique because sequence limits
are unique.
"""

# Proposition 6.1.7 says that a sequence has at most one limit.  Applying that
# result to the partial-sum sequence gives uniqueness of a series sum.

thm sequence_limit_unique_cite_from_chap6:
    ? forall b seq(R), M1, M2 R:
        $has_limit(b, M1)
        $has_limit(b, M2)
        =>:
            M1 = M2
    by thm closed_limit_implies_strict_limit(b, M1)
    by thm closed_limit_implies_strict_limit(b, M2)
    by thm chap6::sequence_limit_unique(b, M1, M2)

thm series_sum_unique:
    ? forall a seq(R), L1, L2 R:
        $has_series_sum(a, L1)
        $has_series_sum(a, L2)
        =>:
            L1 = L2
    by thm sequence_limit_unique_cite_from_chap6(fn(k N+) R {partial_sum(a, k)}, L1, L2)

"""
Examples 7.2.4. The geometric series with terms 2^{-n} converges to 1, while
the series with terms 2^n diverges.
"""

sketch:
    have half_power_terms seq(R) = geometric_series_terms_from_one(1 / 2)
    have two_power_terms seq(R) = geometric_series_terms_from_one(2)

    claim:
        ? forall k N+:
            half_power_terms(k) = 2^(-k)
            two_power_terms(k) = 2^k
        half_power_terms(k) = geometric_series_terms_from_one(1 / 2)(k)
        geometric_series_terms_from_one(1 / 2)(k) = (1 / 2)^k
        2^(-1) = 1 / 2^1
        2^1 = 2
        1 / 2^1 = 1 / 2
        2^(-1) = 1 / 2
        1 / 2 = 2^(-1)
        (1 / 2)^k = (2^(-1))^k
        (2^(-1))^k = 2^((-1) * k)
        (-1) * k = -k
        2^((-1) * k) = 2^(-k)
        (1 / 2)^k = 2^(-k)
        half_power_terms(k) = 2^(-k)
        two_power_terms(k) = geometric_series_terms_from_one(2)(k)
        geometric_series_terms_from_one(2)(k) = 2^k

    abs(1 / 2) < 1
    1 - 1 / 2 != 0
    by thm geometric_series_from_one_formula(1 / 2)
    (1 / 2) / (1 - 1 / 2) = 1
    $has_series_sum(geometric_series_terms_from_one(1 / 2), 1)
    $has_series_sum(half_power_terms, 1)

    claim:
        ? not $is_convergent_series(two_power_terms)
        abs(2) >= 1
        by thm geometric_series_from_one_diverges_when_abs_ge_one(2)
        not $is_convergent_series(two_power_terms)

"""
Proposition 7.2.5. A series converges iff all sufficiently late finite tails
are arbitrarily small.
"""

# This is the Cauchy criterion for series: convergence of partial sums is
# equivalent to every sufficiently late finite tail having small absolute value.

have fn finite_tail_sum(a seq(R), p, q N+) R by cases:
    case q < p: 0
    case q >= p: partial_sum(a, q) - partial_sum(a, p - 1)

prop has_small_tail_sums_after(a seq(R), epsilon R+, n0 N+):
    forall p, q N+:
        p >= n0
        q >= n0
        =>:
            abs(finite_tail_sum(a, p, q)) <= epsilon

prop has_cauchy_series_tails(a seq(R)):
    forall epsilon R+:
        exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}

thm series_cauchy_criterion_forward:
    ? forall a seq(R):
        $is_convergent_series(a)
        =>:
            $has_cauchy_series_tails(a)
    obtain L from exist L R st {$has_series_sum(a, L)}
    $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        obtain N0 from exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon / 2, N0)}
        witness exist n1 N+ st {$has_small_tail_sums_after(a, epsilon, n1)} from N0 + 1:
            claim:
                ? forall p, q N+:
                    p >= N0 + 1
                    q >= N0 + 1
                    =>:
                        abs(finite_tail_sum(a, p, q)) <= epsilon
                by cases:
                    ? abs(finite_tail_sum(a, p, q)) <= epsilon
                    case q < p:
                        finite_tail_sum(a, p, q) = 0
                    case q >= p:
                        q >= N0 + 1 > N0
                        p - 1 >= (N0 + 1) - 1 = N0 > 0
                        p - 1 > 0
                        p - 1 >= 0
                        p - 1 $in N
                        p - 1 != 0
                        have positive_predecessor N = p - 1
                        positive_predecessor = p - 1
                        positive_predecessor $in N+
                        p - 1 $in N+
                        abs(fn(k N+) R {partial_sum(a, k)}(q) - L) <= epsilon / 2
                        abs(fn(k N+) R {partial_sum(a, k)}(p - 1) - L) <= epsilon / 2
                        fn(k N+) R {partial_sum(a, k)}(q) = partial_sum(a, q)
                        fn(k N+) R {partial_sum(a, k)}(p - 1) = partial_sum(a, p - 1)
                        abs(partial_sum(a, q) - L) = abs(fn(k N+) R {partial_sum(a, k)}(q) - L)
                        abs(partial_sum(a, p - 1) - L) = abs(fn(k N+) R {partial_sum(a, k)}(p - 1) - L)
                        abs(partial_sum(a, q) - L) <= epsilon / 2
                        abs(partial_sum(a, p - 1) - L) <= epsilon / 2
                        finite_tail_sum(a, p, q) = partial_sum(a, q) - partial_sum(a, p - 1)
                        partial_sum(a, q) - partial_sum(a, p - 1) = (partial_sum(a, q) - L) + (L - partial_sum(a, p - 1))
                        abs(finite_tail_sum(a, p, q)) = abs((partial_sum(a, q) - L) + (L - partial_sum(a, p - 1)))
                        abs((partial_sum(a, q) - L) + (L - partial_sum(a, p - 1))) <= abs(partial_sum(a, q) - L) + abs(L - partial_sum(a, p - 1))
                        abs(L - partial_sum(a, p - 1)) = abs(partial_sum(a, p - 1) - L)
                        abs(finite_tail_sum(a, p, q)) <= abs(partial_sum(a, q) - L) + abs(L - partial_sum(a, p - 1))
                        abs(L - partial_sum(a, p - 1)) <= epsilon / 2
                        abs(partial_sum(a, q) - L) + abs(L - partial_sum(a, p - 1)) <= epsilon / 2 + epsilon / 2
                        abs(finite_tail_sum(a, p, q)) <= epsilon / 2 + epsilon / 2 = epsilon
            by def:
                ? $has_small_tail_sums_after(a, epsilon, N0 + 1)
    by def:
        ? $has_cauchy_series_tails(a)

thm real_closeness_is_symmetric:
    ? forall epsilon R+, x, y R:
        $chap5::is_close_in_R(epsilon, x, y)
        =>:
            $chap5::is_close_in_R(epsilon, y, x)
    by def:
        ? $chap5::is_close_in_R(epsilon, x, y)
    chap5::dist_R(x, y) = abs(x - y)
    x - y = -(y - x)
    abs(x - y) = abs(-(y - x))
    abs(-(y - x)) = abs(y - x)
    chap5::dist_R(y, x) = abs(y - x)
    chap5::dist_R(y, x) = chap5::dist_R(x, y)
    chap5::dist_R(y, x) <= epsilon
    by def:
        ? $chap5::is_close_in_R(epsilon, y, x)
    $chap5::is_close_in_R(epsilon, y, x)

thm partial_sums_close_when_first_index_before_second:
    ? forall a seq(R), epsilon R+, n0, j, k N+:
        $has_small_tail_sums_after(a, epsilon, n0)
        j >= n0
        k >= n0
        j < k
        =>:
            $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
    j + 1 $in N+
    j + 1 >= n0
    k >= j + 1
    abs(finite_tail_sum(a, j + 1, k)) <= epsilon
    finite_tail_sum(a, j + 1, k) = partial_sum(a, k) - partial_sum(a, (j + 1) - 1)
    (j + 1) - 1 = j
    partial_sum(a, (j + 1) - 1) = partial_sum(a, j)
    partial_sum(a, k) - partial_sum(a, (j + 1) - 1) = partial_sum(a, k) - partial_sum(a, j)
    finite_tail_sum(a, j + 1, k) = partial_sum(a, k) - partial_sum(a, (j + 1) - 1) = partial_sum(a, k) - partial_sum(a, j)
    finite_tail_sum(a, j + 1, k) = partial_sum(a, k) - partial_sum(a, j)
    abs(finite_tail_sum(a, j + 1, k)) = abs(partial_sum(a, k) - partial_sum(a, j))
    abs(partial_sum(a, k) - partial_sum(a, j)) <= epsilon
    abs(partial_sum(a, j) - partial_sum(a, k)) = abs(-(partial_sum(a, k) - partial_sum(a, j)))
    abs(-(partial_sum(a, k) - partial_sum(a, j))) = abs(partial_sum(a, k) - partial_sum(a, j))
    abs(partial_sum(a, j) - partial_sum(a, k)) <= epsilon
    chap5::dist_R(partial_sum(a, j), partial_sum(a, k)) = abs(partial_sum(a, j) - partial_sum(a, k))
    chap5::dist_R(partial_sum(a, j), partial_sum(a, k)) <= epsilon
    by def:
        ? $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
    $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))

thm partial_sums_are_close_after_small_series_tail:
    ? forall a seq(R), epsilon R+, n0, j, k N+:
        $has_small_tail_sums_after(a, epsilon, n0)
        j >= n0
        k >= n0
        =>:
            $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
    by cases:
        ? $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
        case j < k:
            by thm partial_sums_close_when_first_index_before_second(a, epsilon, n0, j, k)
            fn(n N+) R {partial_sum(a, n)}(j) = partial_sum(a, j)
            fn(n N+) R {partial_sum(a, n)}(k) = partial_sum(a, k)
            $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
            $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
        case j >= k:
            k < j or k >= j
            by cases:
                ? $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
                case k < j:
                    by thm partial_sums_close_when_first_index_before_second(a, epsilon, n0, k, j)
                    by thm real_closeness_is_symmetric(epsilon, partial_sum(a, k), partial_sum(a, j))
                    fn(n N+) R {partial_sum(a, n)}(j) = partial_sum(a, j)
                    fn(n N+) R {partial_sum(a, n)}(k) = partial_sum(a, k)
                    $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
                    $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
                case k >= j:
                    j = k
                    fn(n N+) R {partial_sum(a, n)}(j) = partial_sum(a, j)
                    fn(n N+) R {partial_sum(a, n)}(k) = partial_sum(a, k)
                    partial_sum(a, j) = partial_sum(a, k)
                    partial_sum(a, j) - partial_sum(a, j) = 0
                    abs(partial_sum(a, j) - partial_sum(a, j)) = abs(0) = 0
                    chap5::dist_R(partial_sum(a, j), partial_sum(a, j)) = abs(partial_sum(a, j) - partial_sum(a, j)) = 0
                    chap5::dist_R(partial_sum(a, j), partial_sum(a, k)) = chap5::dist_R(partial_sum(a, j), partial_sum(a, j)) = 0
                    0 <= epsilon
                    by def:
                        ? $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
                    $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))

thm small_series_tail_gives_partial_sum_cauchy_tail:
    ? forall a seq(R), epsilon R+, n0 N+:
        $has_small_tail_sums_after(a, epsilon, n0)
        =>:
            $chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n0)
    claim:
        ? forall j, k N+:
            j >= n0
            k >= n0
            =>:
                $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
        by thm partial_sums_are_close_after_small_series_tail(a, epsilon, n0, j, k)
    by def:
        ? $chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n0)

thm cauchy_series_tails_make_partial_sums_cauchy_in_R:
    ? forall a seq(R):
        $has_cauchy_series_tails(a)
        =>:
            $chap5::is_cauchy_sequence_in_R(fn(k N+) R {partial_sum(a, k)})
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        by thm small_series_tail_gives_partial_sum_cauchy_tail(a, epsilon, n0)
        witness exist n1 N+ st {$chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n1)} from n0
    by def:
        ? $chap5::is_cauchy_sequence_in_R(fn(n N+) R {partial_sum(a, n)})

thm nonstrict_real_limit_gives_series_limit:
    ? forall a seq(R), L R:
        $chap5::has_limit_in_R(a, L)
        =>:
            $has_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        epsilon / 2 $in R+
        epsilon / 2 < epsilon
        obtain n0 from exist n0 N+ st {$chap5::is_tail_close_to_in_R(a, L, epsilon / 2, n0)}
        witness exist n1 N+ st {$is_tail_close_to(a, L, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    $chap5::is_close_in_R(epsilon / 2, a(n), L)
                    chap5::dist_R(a(n), L) = abs(a(n) - L)
                    abs(a(n) - L) <= epsilon / 2 < epsilon
                    abs(a(n) - L) < epsilon
                    abs(a(n) - L) <= epsilon
            by def:
                ? $is_tail_close_to(a, L, epsilon, n0)
    by def:
        ? $has_limit(a, L)
    $has_limit(a, L)

thm series_cauchy_criterion_reverse:
    ? forall a seq(R):
        $has_cauchy_series_tails(a)
        =>:
            $is_convergent_series(a)
    by thm cauchy_series_tails_make_partial_sums_cauchy_in_R(a)
    by thm chap5::real_cauchy_sequence_has_limit_in_R(fn(k N+) R {partial_sum(a, k)})
    obtain L from exist L R st {$chap5::has_limit_in_R(fn(k N+) R {partial_sum(a, k)}, L)}
    by thm nonstrict_real_limit_gives_series_limit(fn(k N+) R {partial_sum(a, k)}, L)
    witness exist M R st {$has_series_sum(a, M)} from L:
        $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
        by def:
            ? $has_series_sum(a, L)
        $has_series_sum(a, L)
    by def:
        ? $is_convergent_series(a)

"""
Corollary 7.2.6 (Zero test). Every convergent series has terms tending to 0.
If the terms fail to tend to 0, the series diverges.
"""

# The zero test says convergence of the partial sums forces the individual
# increments `a(n)` to become small; equivalently, a nonzero term tail obstructs
# convergence of the series.

thm series_zero_test:
    ? forall a seq(R):
        $is_convergent_series(a)
        =>:
            $has_limit(a, 0)
    by thm series_cauchy_criterion_forward(a)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(a, 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(finite_tail_sum(a, n, n)) <= epsilon
                    finite_tail_sum(a, n, n) = partial_sum(a, n) - partial_sum(a, n - 1)
                    partial_sum(a, n) = partial_sum(a, n - 1) + a(n)
                    partial_sum(a, n) - partial_sum(a, n - 1) = a(n)
                    finite_tail_sum(a, n, n) = a(n)
                    a(n) - 0 = a(n)
                    abs(a(n) - 0) = abs(a(n))
                    abs(finite_tail_sum(a, n, n)) = abs(a(n))
                    abs(a(n) - 0) = abs(finite_tail_sum(a, n, n))
                    abs(a(n) - 0) <= epsilon
            by def:
                ? $is_tail_close_to(a, 0, epsilon, n0)
            $is_tail_close_to(a, 0, epsilon, n0)
    by def:
        ? $has_limit(a, 0)

"""
Example 7.2.7. The series with constant term 1 diverges, and the alternating
series with terms (-1)^n also diverges, because neither term sequence tends to
0.  A term sequence tending to 0 is necessary but not sufficient for the series
to converge.
"""

sketch:
    have fn ones_series_terms(k N+) R = 1
    have fn alternating_ones_terms(k N+) R = (-1)^k

    claim:
        ? not $has_limit(ones_series_terms, 0)
        by contra:
            ? not $has_limit(ones_series_terms, 0)
            $has_limit(ones_series_terms, 0)
            1 / 2 $in R+
            obtain n0 from exist n0 N+ st {$is_tail_close_to(ones_series_terms, 0, 1 / 2, n0)}
            n0 >= n0
            abs(ones_series_terms(n0) - 0) <= 1 / 2
            ones_series_terms(n0) = fn(k N+) R {1}(n0)
            fn(k N+) R {1}(n0) = 1
            ones_series_terms(n0) - 0 = 1
            abs(ones_series_terms(n0) - 0) = abs(1)
            abs(1) = 1
            1 <= 1 / 2
            impossible 1 <= 1 / 2

    claim:
        ? not $is_convergent_series(ones_series_terms)
        by contra:
            ? not $is_convergent_series(ones_series_terms)
            $is_convergent_series(ones_series_terms)
            by thm series_zero_test(ones_series_terms)
            impossible not $has_limit(ones_series_terms, 0)

    claim:
        ? not $has_limit(alternating_ones_terms, 0)
        by contra:
            ? not $has_limit(alternating_ones_terms, 0)
            $has_limit(alternating_ones_terms, 0)
            1 / 2 $in R+
            obtain n0 from exist n0 N+ st {$is_tail_close_to(alternating_ones_terms, 0, 1 / 2, n0)}
            2 * n0 $in N+
            2 * n0 >= n0
            abs(alternating_ones_terms(2 * n0) - 0) <= 1 / 2
            alternating_ones_terms(2 * n0) = fn(k N+) R {(-1)^k}(2 * n0)
            fn(k N+) R {(-1)^k}(2 * n0) = (-1)^(2 * n0)
            (-1)^2 = 1
            ((-1)^2)^n0 = 1^n0
            1^n0 = 1
            ((-1)^2)^n0 = (-1)^(2 * n0)
            (-1)^(2 * n0) = 1
            alternating_ones_terms(2 * n0) = 1
            alternating_ones_terms(2 * n0) - 0 = 1
            abs(alternating_ones_terms(2 * n0) - 0) = abs(1)
            abs(1) = 1
            1 <= 1 / 2
            impossible 1 <= 1 / 2

    claim:
        ? not $is_convergent_series(alternating_ones_terms)
        by contra:
            ? not $is_convergent_series(alternating_ones_terms)
            $is_convergent_series(alternating_ones_terms)
            by thm series_zero_test(alternating_ones_terms)
            impossible not $has_limit(alternating_ones_terms, 0)

"""
Definition 7.2.8 (Absolute convergence). A series is absolutely convergent when
the series of absolute values converges.
"""

prop is_absolutely_convergent_series(a seq(R)):
    $is_convergent_series(fn(j N+) R {abs(a(j))})

"""
Proposition 7.2.9 (Absolute convergence test). Absolute convergence implies
ordinary convergence, and the absolute value of the sum is bounded by the sum
of absolute values.
"""

# Absolute convergence controls signed finite tails by the corresponding
# absolute tails, and the bound on the final sum is the finite triangle
# inequality passed to the limit.

thm partial_sum_abs_matches_finite_sum:
    ? forall a seq(R), k N+:
        partial_sum(fn(j N+) R {abs(a(j))}, k) = sum(1, k, fn(i_index N+) R {abs(a(i_index))})
    by thm partial_sum_matches_finite_sum(fn(j N+) R {abs(a(j))}, k)
    partial_sum(fn(j N+) R {abs(a(j))}, k) = sum(1, k, fn(i_index N+) R {abs(a(i_index))})

thm finite_sum_abs_nonnegative:
    ? forall a seq(R), p, q N+:
        p <= q
        =>:
            sum(p, q, fn(i_index N+) R {abs(a(i_index))}) >= 0
    forall i_index N+:
        p <= i_index <= q
        =>:
            0 <= abs(a(i_index))
    by thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {0}), sum(p, q, fn(i_index N+) R {abs(a(i_index))}))
    sum(p, q, fn(i_index N+) R {0}) <= sum(p, q, fn(i_index N+) R {abs(a(i_index))})
    forall i_index N+:
        p <= i_index <= q
        =>:
            0 = 0 * 1
            0 <= 0 * 1
            0 * 1 <= 0
    by thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {0}), sum(p, q, fn(i_index N+) R {0 * 1}))
    by thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {0 * 1}), sum(p, q, fn(i_index N+) R {0}))
    sum(p, q, fn(i_index N+) R {0}) <= sum(p, q, fn(i_index N+) R {0 * 1})
    sum(p, q, fn(i_index N+) R {0 * 1}) <= sum(p, q, fn(i_index N+) R {0})
    sum(p, q, fn(i_index N+) R {0}) = sum(p, q, fn(i_index N+) R {0 * 1})
    by thm finite_series_scalar_mul_positive_range(fn(i_index N+) R {1}, 0, p, q)
    sum(p, q, fn(i_index N+) R {0 * 1}) = 0 * sum(p, q, fn(i_index N+) R {1}) = 0
    sum(p, q, fn(i_index N+) R {0}) = sum(p, q, fn(i_index N+) R {0 * 1}) = 0
    0 <= sum(p, q, fn(i_index N+) R {abs(a(i_index))})
    sum(p, q, fn(i_index N+) R {abs(a(i_index))}) >= 0

thm finite_tail_matches_finite_sum:
    ? forall a seq(R), p, q N+:
        p <= q
        =>:
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
    by cases:
        ? finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
        case p = 1:
            p - 1 = 0
            partial_sum(a, 0) = 0
            finite_tail_sum(a, p, q) = partial_sum(a, q) - partial_sum(a, p - 1)
            partial_sum(a, p - 1) = 0
            partial_sum(a, q) - partial_sum(a, p - 1) = partial_sum(a, q) - 0
            partial_sum(a, q) - 0 = partial_sum(a, q)
            finite_tail_sum(a, p, q) = partial_sum(a, q)
            by thm partial_sum_matches_finite_sum(a, q)
            partial_sum(a, q) = sum(1, q, fn(i_index N+) R {a(i_index)})
            sum(1, q, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(a, p, q) = partial_sum(a, q) = sum(1, q, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
        case p > 1:
            finite_tail_sum(a, p, q) = partial_sum(a, q) - partial_sum(a, p - 1)
            p - 1 >= 1 > 0
            p - 1 >= 0
            p - 1 $in N
            p - 1 != 0
            p - 1 $in N+
            p - 1 < p <= q
            p - 1 < q
            by thm partial_sum_split_after(a, p - 1, q)
            (p - 1) + 1 = p
            partial_sum(a, q) = partial_sum(a, p - 1) + sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)})
            sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, p - 1) + sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}) = partial_sum(a, p - 1) + sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, q) = partial_sum(a, p - 1) + sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}) = partial_sum(a, p - 1) + sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, q) = partial_sum(a, p - 1) + sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, q) - partial_sum(a, p - 1) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})

thm finite_tail_abs_nonnegative:
    ? forall a seq(R), p, q N+:
        finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) >= 0
    by cases:
        ? finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) >= 0
        case q < p:
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = 0
        case q >= p:
            by thm finite_tail_matches_finite_sum(fn(j N+) R {abs(a(j))}, p, q)
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)})
            sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            by thm finite_sum_abs_nonnegative(a, p, q)

thm finite_tail_abs_bound:
    ? forall a seq(R), p, q N+:
        abs(finite_tail_sum(a, p, q)) <= finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q)
    by cases:
        ? abs(finite_tail_sum(a, p, q)) <= finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q)
        case q < p:
            finite_tail_sum(a, p, q) = 0
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = 0
        case q >= p:
            by thm finite_tail_matches_finite_sum(a, p, q)
            by thm finite_tail_matches_finite_sum(fn(j N+) R {abs(a(j))}, p, q)
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)})
            sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            abs(finite_tail_sum(a, p, q)) = abs(sum(p, q, fn(i_index N+) R {a(i_index)}))
            abs(sum(p, q, fn(i_index N+) R {a(i_index)})) <= sum(p, q, fn(i_index N+) R {abs(a(i_index))})

thm absolute_tail_control:
    ? forall a seq(R), epsilon R+, n0 N+:
        $has_small_tail_sums_after(fn(j N+) R {abs(a(j))}, epsilon, n0)
        =>:
            $has_small_tail_sums_after(a, epsilon, n0)
    # Source handling: Tao's comparison test applies the triangle inequality to
    # each finite tail of the original series and its absolute-value series.
    # trust: The finite-tail bound and nonnegativity lemmas are checked above,
    # but their comparison chain does not close inside this quantified predicate.
    trust $has_small_tail_sums_after(a, epsilon, n0)

thm absolute_convergence_test:
    ? forall a seq(R):
        $is_absolutely_convergent_series(a)
        =>:
            $is_convergent_series(a)
    $is_convergent_series(fn(j N+) R {abs(a(j))})
    by thm series_cauchy_criterion_forward(fn(j N+) R {abs(a(j))})
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$has_small_tail_sums_after(fn(j N+) R {abs(a(j))}, epsilon, n0)}
        by thm absolute_tail_control(a, epsilon, n0)
        witness exist n1 N+ st {$has_small_tail_sums_after(a, epsilon, n1)} from n0:
            $has_small_tail_sums_after(a, epsilon, n0)
    by def:
        ? $has_cauchy_series_tails(a)
    $has_cauchy_series_tails(a)
    by thm series_cauchy_criterion_reverse(a)

thm partial_sum_triangle_bound:
    ? forall a seq(R), n N+:
        abs(partial_sum(a, n)) <= partial_sum(fn(j N+) R {abs(a(j))}, n)
    by thm partial_sum_matches_finite_sum(a, n)
    by thm partial_sum_abs_matches_finite_sum(a, n)
    1 <= n
    abs(sum(1, n, fn(i_index N+) R {a(i_index)})) <= sum(1, n, fn(i_index N+) R {abs(a(i_index))})
    abs(partial_sum(a, n)) = abs(sum(1, n, fn(i_index N+) R {a(i_index)}))
    abs(partial_sum(a, n)) <= sum(1, n, fn(i_index N+) R {abs(a(i_index))})
    sum(1, n, fn(i_index N+) R {abs(a(i_index))}) = partial_sum(fn(j N+) R {abs(a(j))}, n)
    partial_sum(fn(j N+) R {abs(a(j))}, n) <= partial_sum(fn(j N+) R {abs(a(j))}, n)
    sum(1, n, fn(i_index N+) R {abs(a(i_index))}) <= partial_sum(fn(j N+) R {abs(a(j))}, n)
    abs(partial_sum(a, n)) <= sum(1, n, fn(i_index N+) R {abs(a(i_index))}) <= partial_sum(fn(j N+) R {abs(a(j))}, n)
    abs(partial_sum(a, n)) <= partial_sum(fn(j N+) R {abs(a(j))}, n)

thm absolute_convergence_triangle_bound:
    ? forall a seq(R), L, A R:
        $has_series_sum(a, L)
        $has_series_sum(fn(j N+) R {abs(a(j))}, A)
        =>:
            abs(L) <= A
    # Source handling: compare a sufficiently late partial sum with both
    # limits, then use the checked finite partial-sum triangle bound.
    # trust: The direct eta/4 contradiction proof fails in the ordered chapter
    # context; factor its two limit estimates into reusable low-search lemmas.
    trust abs(L) <= A

"""
Remark 7.2.10. The converse to absolute convergence is false: some convergent
series are not absolutely convergent.
"""

# Example 7.2.13 gives the alternating harmonic series as the local example.

"""
Remark 7.2.11. Tao uses "conditionally convergent" broadly unless he says
"only conditionally convergent"; absolute convergence is a subclass of
ordinary convergence.
"""

prop is_only_conditionally_convergent_series(a seq(R)):
    $is_convergent_series(a)
    not $is_absolutely_convergent_series(a)

"""
Proposition 7.2.12 (Alternating series test). A non-negative decreasing
sequence gives a convergent alternating series exactly when its terms tend to 0.
"""

# Tao's proof compares the even and odd partial sums.  The finite induction
# gives a tail estimate: every late alternating tail is bounded by its first
# allowed term.  Once this is available, the forward direction is a direct
# Cauchy-tail proof, and the reverse direction is the zero test plus the fact
# that the sign `(-1)^n` does not change distance from 0.

prop is_nonnegative_sequence(a seq(R)):
    forall n N+:
        a(n) >= 0

prop is_decreasing_sequence(a seq(R)):
    forall n N+:
        a(n + 1) <= a(n)

thm decreasing_seq_le_add:
    ? forall a seq(R), h N, n N+:
        $is_decreasing_sequence(a)
        =>:
            a(n + h) <= a(n)
    by induc h from 0:
        ? a(n + h) <= a(n)

        ? from h = 0:
            n + 0 = n
            a(n + 0) = a(n)
            a(n + 0) <= a(n)

        ? induc:
            a(n + h) <= a(n)
            n + h $in N+
            a(n + h + 1) <= a(n + h)
            n + (h + 1) = n + h + 1
            a(n + (h + 1)) = a(n + h + 1)
            a(n + (h + 1)) <= a(n + h) <= a(n)
            a(n + (h + 1)) <= a(n)

thm decreasing_seq_le_of_le:
    ? forall a seq(R), m, n N+:
        $is_decreasing_sequence(a)
        m <= n
        =>:
            a(n) <= a(m)
    n - m $in N
    m + (n - m) = n
    by thm decreasing_seq_le_add(a, n - m, m)
    a(n) = a(m + (n - m))
    a(n) <= a(m)

thm decreasing_finite_block_upper_by_left_endpoint:
    ? forall a seq(R), m, n N+:
        $is_decreasing_sequence(a)
        m <= n
        =>:
            sum(m, n, fn(i_index N+) R {a(i_index)}) <= sum(m, n, fn(i_index N+) R {a(m)})
    forall i_index N+:
        m <= i_index <= n
        =>:
            a(i_index) <= a(m)
    by thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index N+) R {a(i_index)}), sum(m, n, fn(i_index N+) R {a(m)}))
    sum(m, n, fn(i_index N+) R {a(i_index)}) <= sum(m, n, fn(i_index N+) R {a(m)})

thm decreasing_finite_block_lower_by_right_endpoint:
    ? forall a seq(R), m, n N+:
        $is_decreasing_sequence(a)
        m <= n
        =>:
            sum(m, n, fn(i_index N+) R {a(n)}) <= sum(m, n, fn(i_index N+) R {a(i_index)})
    forall i_index N+:
        m <= i_index <= n
        =>:
            a(n) <= a(i_index)
    by thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index N+) R {a(n)}), sum(m, n, fn(i_index N+) R {a(i_index)}))
    sum(m, n, fn(i_index N+) R {a(n)}) <= sum(m, n, fn(i_index N+) R {a(i_index)})

thm nonnegative_partial_sum_le_add:
    ? forall a seq(R), h N, n N+:
        $is_nonnegative_sequence(a)
        =>:
            partial_sum(a, n) <= partial_sum(a, n + h)
    by induc h from 0:
        ? partial_sum(a, n) <= partial_sum(a, n + h)

        ? from h = 0:
            n + 0 = n
            partial_sum(a, n + 0) = partial_sum(a, n)
            partial_sum(a, n) <= partial_sum(a, n + 0)

        ? induc:
            partial_sum(a, n) <= partial_sum(a, n + h)
            n + h $in N+
            (n + h + 1) - 1 = n + h
            partial_sum(a, (n + h + 1) - 1) = partial_sum(a, n + h)
            partial_sum(a, (n + h + 1) - 1) + a(n + h + 1) = partial_sum(a, n + h) + a(n + h + 1)
            by thm partial_sum_successor(a, n + h + 1)
            partial_sum(a, n + h + 1) = partial_sum(a, n + h) + a(n + h + 1)
            a(n + h + 1) >= 0
            partial_sum(a, n + h) <= partial_sum(a, n + h) + a(n + h + 1)
            partial_sum(a, n) <= partial_sum(a, n + h) <= partial_sum(a, n + h + 1)
            n + (h + 1) = n + h + 1
            partial_sum(a, n + (h + 1)) = partial_sum(a, n + h + 1)
            partial_sum(a, n) <= partial_sum(a, n + (h + 1))

thm nonnegative_partial_sum_le_of_le:
    ? forall a seq(R), m, n N+:
        $is_nonnegative_sequence(a)
        m <= n
        =>:
            partial_sum(a, m) <= partial_sum(a, n)
    n - m $in N
    m + (n - m) = n
    by thm nonnegative_partial_sum_le_add(a, n - m, m)
    partial_sum(a, m + (n - m)) = partial_sum(a, n)
    partial_sum(a, m) <= partial_sum(a, n)

have fn harmonic_terms(k N+) R = 1 / k

thm harmonic_term_nonnegative:
    ? forall n N+:
        harmonic_terms(n) = 1 / n
        1 / n > 0
        =>:
            harmonic_terms(n) >= 0
    harmonic_terms(n) = 1 / n
    1 / n > 0
    harmonic_terms(n) >= 0

thm harmonic_term_decreases:
    ? forall n N+:
        harmonic_terms(n + 1) = 1 / (n + 1)
        harmonic_terms(n) = 1 / n
        =>:
            harmonic_terms(n + 1) <= harmonic_terms(n)
    harmonic_terms(n + 1) = 1 / (n + 1)
    harmonic_terms(n) = 1 / n
    n * (n + 1) > 0
    1 / (n + 1) = n / (n * (n + 1))
    1 / n = (n + 1) / (n * (n + 1))
    n <= n + 1
    n / (n * (n + 1)) <= (n + 1) / (n * (n + 1))
    harmonic_terms(n + 1) <= harmonic_terms(n)

claim:
    ? $is_nonnegative_sequence(harmonic_terms)
    forall n N+:
        harmonic_terms(n) = 1 / n
        1 / n > 0
        harmonic_terms(n) >= 0
    by def:
        ? $is_nonnegative_sequence(harmonic_terms)

claim:
    ? $is_decreasing_sequence(harmonic_terms)
    forall n N+:
        harmonic_terms(n + 1) = 1 / (n + 1)
        harmonic_terms(n) = 1 / n
        n * (n + 1) > 0
        1 / (n + 1) = n / (n * (n + 1))
        1 / n = (n + 1) / (n * (n + 1))
        n <= n + 1
        n / (n * (n + 1)) <= (n + 1) / (n * (n + 1))
        harmonic_terms(n + 1) <= harmonic_terms(n)
    by def:
        ? $is_decreasing_sequence(harmonic_terms)

thm two_power_at_least_index:
    ? forall K N+:
        2^K >= K
    by induc K from 1:
        ? 2^K >= K

        ? from K = 1:
            2^1 = 2 >= 1

        ? induc:
            2^K >= K
            2^(K + 1) = 2^K * 2
            2^K * 2 = 2^K + 2^K
            2^K >= 1
            2^K + 2^K >= K + 1
            2^(K + 1) >= K + 1

thm harmonic_dyadic_partial_sum_lower_bound:
    ? forall K N+:
        partial_sum(harmonic_terms, 2^K) >= 1 + K / 2
    # Source handling: group terms from 2^K + 1 through 2^(K + 1), bound each
    # by the right endpoint, and add the resulting one-half increment.
    # trust: The induction's natural-number subtraction arithmetic does not
    # close after several explicit bridges in the ordered chapter context.
    trust partial_sum(harmonic_terms, 2^K) >= 1 + K / 2

claim:
    ? not $is_convergent_series(harmonic_terms)
    # Source handling: compare the dyadic lower bound with a late partial sum
    # that is within one of its putative limit.
    # trust: The final contradiction does not execute after the lower-bound
    # interface is used in the ordered chapter context.
    trust not $is_convergent_series(harmonic_terms)

have fn alternating_series_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {(-1)^j * a(j)}

thm alternating_sign_abs_one:
    ? forall n N+:
        abs((-1)^n) = 1
    by induc n from 1:
        ? abs((-1)^n) = 1

        ? from n = 1:
            (-1)^1 = -1
            abs((-1)^1) = abs(-1)
            abs(-1) = 1

        ? induc:
            abs((-1)^n) = 1
            (-1)^(n + 1) = (-1)^n * (-1)
            abs((-1)^(n + 1)) = abs((-1)^n * (-1))
            abs((-1)^n * (-1)) = abs((-1)^n) * abs(-1)
            abs(-1) = 1
            abs((-1)^n) * abs(-1) = 1 * 1
            1 * 1 = 1
            abs((-1)^(n + 1)) = 1

thm alternating_sign_value_cases:
    ? forall h N:
        (-1)^h = 1 or (-1)^h = -1
    by induc h from 0:
        ? (-1)^h = 1 or (-1)^h = -1

        ? from h = 0:
            (-1)^0 = 1

        ? induc:
            (-1)^h = 1 or (-1)^h = -1
            (-1)^(h + 1) = (-1)^h * (-1)
            by cases:
                ? (-1)^(h + 1) = 1 or (-1)^(h + 1) = -1
                case (-1)^h = 1:
                    (-1)^(h + 1) = 1 * (-1) = -1
                case (-1)^h = -1:
                    (-1)^(h + 1) = (-1) * (-1) = 1

thm alternating_sign_square_one:
    ? forall p N:
        (-1)^p * (-1)^p = 1
    (-1)^p * (-1)^p = (-1)^(p + p)
    p + p = 2 * p
    (-1)^(2 * p) = ((-1)^2)^p
    (-1)^2 = 1
    ((-1)^2)^p = 1^p = 1

thm normalized_alternating_term:
    ? forall a seq(R), p N+, h N:
        (-1)^p * alternating_series_terms(a)(p + h + 1) = (-1)^(h + 1) * a(p + h + 1)
    # Source handling: split the alternating sign at p + (h + 1) and cancel
    # the square (-1)^p * (-1)^p.
    # trust: The natural exponent-addition rewrite fails in the ordered context.
    trust (-1)^p * alternating_series_terms(a)(p + h + 1) = (-1)^(h + 1) * a(p + h + 1)

thm finite_tail_sum_singleton:
    ? forall a seq(R), p N+:
        finite_tail_sum(a, p, p) = a(p)
    # Source handling: a one-point finite tail is its sole summand.
    # trust: The direct finite-sum normalization did not return in the
    # persistent ordered-chapter session.
    trust finite_tail_sum(a, p, p) = a(p)

thm finite_tail_sum_successor:
    ? forall a seq(R), p, q N+:
        p <= q
        =>:
            finite_tail_sum(a, p, q + 1) = finite_tail_sum(a, p, q) + a(q + 1)
    # Source handling: extending a finite tail by one endpoint adds the new
    # summand, by the recursive finite-sum identity.
    # trust: The direct subtraction rewrite remains an ExecStmtError in the
    # ordered Chapter 7 session after the partial-sum successor theorem fires.
    trust finite_tail_sum(a, p, q + 1) = finite_tail_sum(a, p, q) + a(q + 1)

prop alternating_tail_pair_state(a seq(R), p N+, k N):
    0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k)
    (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k) <= a(p)
    a(p + 2 * k) <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k)
    0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k + 1)
    (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k + 1) <= a(p) - a(p + 2 * k + 1)

thm alternating_tail_pair_induction:
    ? forall a seq(R), p N+, k N:
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        =>:
            $alternating_tail_pair_state(a, p, k)
    # Source handling: pair successive positive decreasing terms; every even
    # normalized tail stays between its last term and the first term, and each
    # following odd tail stays between zero and the corresponding difference.
    # trust: The explicit induction remains an ExecStmtError in the ordered
    # session after splitting the base-case sign calculation.
    trust $alternating_tail_pair_state(a, p, k)

thm alternating_terms_distance_from_zero:
    ? forall a seq(R), n N+:
        abs(alternating_series_terms(a)(n) - 0) = abs(a(n) - 0)
    alternating_series_terms(a)(n) = (-1)^n * a(n)
    alternating_series_terms(a)(n) - 0 = ((-1)^n * a(n)) - 0
    ((-1)^n * a(n)) - 0 = (-1)^n * a(n)
    alternating_series_terms(a)(n) - 0 = ((-1)^n * a(n)) - 0 = (-1)^n * a(n)
    alternating_series_terms(a)(n) - 0 = (-1)^n * a(n)
    abs(alternating_series_terms(a)(n) - 0) = abs((-1)^n * a(n))
    abs((-1)^n * a(n)) = abs((-1)^n) * abs(a(n))
    by thm alternating_sign_abs_one(n)
    abs((-1)^n) * abs(a(n)) = 1 * abs(a(n))
    1 * abs(a(n)) = abs(a(n))
    abs(alternating_series_terms(a)(n) - 0) = abs(a(n))
    a(n) - 0 = a(n)
    abs(a(n) - 0) = abs(a(n))
    abs(alternating_series_terms(a)(n) - 0) = abs(a(n) - 0)


thm alternating_terms_abs_value:
    ? forall a seq(R), n N+:
        abs(alternating_series_terms(a)(n)) = abs(a(n))
    alternating_series_terms(a)(n) = (-1)^n * a(n)
    abs(alternating_series_terms(a)(n)) = abs((-1)^n * a(n))
    abs((-1)^n * a(n)) = abs((-1)^n) * abs(a(n))
    by thm alternating_sign_abs_one(n)
    abs((-1)^n) * abs(a(n)) = 1 * abs(a(n))
    1 * abs(a(n)) = abs(a(n))
    abs(alternating_series_terms(a)(n)) = abs(a(n))

thm alternating_series_tail_bound:
    ? forall a seq(R), n0, p, q N+:
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        p >= n0
        q >= n0
        =>:
            abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0)
    # Source handling: pair consecutive alternating terms and use monotonicity
    # to bound every normalized finite tail by its first unsigned term.
    # trust: The parity split remains an ExecStmtError in the q >= p branch
    # after the pair-state induction has been exposed as a theorem interface.
    trust abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0)

thm alternating_series_test:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        $has_limit(a, 0)
        =>:
            $is_convergent_series(alternating_series_terms(a))
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$has_small_tail_sums_after(alternating_series_terms(a), epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        witness exist n1 N+ st {$has_small_tail_sums_after(alternating_series_terms(a), epsilon, n1)} from n0:
            forall p, q N+:
                p >= n0
                q >= n0
                =>:
                    abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0)
                    n0 >= n0
                    abs(a(n0) - 0) <= epsilon
                    a(n0) >= 0
                    a(n0) - 0 = a(n0)
                    abs(a(n0) - 0) = abs(a(n0))
                    abs(a(n0)) = a(n0)
                    a(n0) <= epsilon
                    abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0) <= epsilon
                    abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= epsilon
            by def:
                ? $has_small_tail_sums_after(alternating_series_terms(a), epsilon, n0)
            $has_small_tail_sums_after(alternating_series_terms(a), epsilon, n0)
    by def:
        ? $has_cauchy_series_tails(alternating_series_terms(a))
    $has_cauchy_series_tails(alternating_series_terms(a))
    by thm series_cauchy_criterion_reverse(alternating_series_terms(a))

thm alternating_series_test_reverse:
    ? forall a seq(R):
        $is_convergent_series(alternating_series_terms(a))
        =>:
            $has_limit(a, 0)
    by thm series_zero_test(alternating_series_terms(a))
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(alternating_series_terms(a), 0, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(a, 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(alternating_series_terms(a)(n) - 0) <= epsilon
                    abs(alternating_series_terms(a)(n) - 0) = abs(a(n) - 0)
                    abs(a(n) - 0) <= epsilon
            by def:
                ? $is_tail_close_to(a, 0, epsilon, n0)
            $is_tail_close_to(a, 0, epsilon, n0)
    by def:
        ? $has_limit(a, 0)
    $has_limit(a, 0)

"""
Example 7.2.13. The alternating harmonic series converges by the alternating
series test, but it is not absolutely convergent because the harmonic series
diverges.
"""

sketch:
    have alternating_harmonic_terms seq(R) = alternating_series_terms(harmonic_terms)

    claim:
        ? forall k N+:
            alternating_harmonic_terms(k) = (-1)^k / k
        alternating_harmonic_terms(k) = alternating_series_terms(harmonic_terms)(k)
        alternating_series_terms(harmonic_terms)(k) = (-1)^k * harmonic_terms(k)
        harmonic_terms(k) = 1 / k
        (-1)^k * harmonic_terms(k) = (-1)^k * (1 / k)
        (-1)^k * (1 / k) = (-1)^k / k
        alternating_harmonic_terms(k) = (-1)^k / k

    forall n N+:
        harmonic_terms(n) = 1 / n
        1 / n > 0
        1 / n >= 0
        harmonic_terms(n) >= 0
    by def:
        ? $is_nonnegative_sequence(harmonic_terms)

    forall n N+:
        harmonic_terms(n + 1) = 1 / (n + 1)
        harmonic_terms(n) = 1 / n
        n + 1 $in N+
        n * (n + 1) > 0
        1 / (n + 1) = n / (n * (n + 1))
        1 / n = (n + 1) / (n * (n + 1))
        n <= n + 1
        n / (n * (n + 1)) <= (n + 1) / (n * (n + 1))
        1 / (n + 1) <= 1 / n
        harmonic_terms(n + 1) <= harmonic_terms(n)
    by def:
        ? $is_decreasing_sequence(harmonic_terms)

    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(harmonic_terms, 0, epsilon, n0)}
        by thm chap5::archimedean_property(epsilon)
        obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
        witness exist n1 N+ st {$is_tail_close_to(harmonic_terms, 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    harmonic_terms(n) = 1 / n
                    n0 <= n
                    n0 * n > 0
                    1 / n = n0 / (n0 * n)
                    n0 / (n0 * n) <= n / (n0 * n)
                    n / (n0 * n) = 1 / n0
                    1 / n <= 1 / n0
                    1 / n <= 1 / n0 < epsilon
                    1 / n < epsilon
                    1 / n > 0
                    1 / n - 0 = 1 / n
                    1 / n - 0 >= 0
                    abs(1 / n - 0) = 1 / n - 0
                    abs(1 / n - 0) = 1 / n
                    abs(harmonic_terms(n) - 0) = abs(1 / n - 0)
                    abs(harmonic_terms(n) - 0) < epsilon
                    abs(harmonic_terms(n) - 0) <= epsilon
            by def:
                ? $is_tail_close_to(harmonic_terms, 0, epsilon, n0)
            $is_tail_close_to(harmonic_terms, 0, epsilon, n0)
    by def:
        ? $has_limit(harmonic_terms, 0)

    by thm alternating_series_test(harmonic_terms)
    $is_convergent_series(alternating_harmonic_terms)

    claim:
        ? not $is_convergent_series(harmonic_terms)
        not $is_convergent_series(harmonic_terms)

    $is_convergent_series(alternating_harmonic_terms)
    claim:
        ? not $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
        by contra:
            ? not $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
            $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
            claim:
                ? forall n N+:
                    abs(alternating_harmonic_terms(n)) = harmonic_terms(n)
                alternating_harmonic_terms(n) = alternating_series_terms(harmonic_terms)(n)
                abs(alternating_harmonic_terms(n)) = abs(alternating_series_terms(harmonic_terms)(n))
                by thm alternating_terms_abs_value(harmonic_terms, n)
                harmonic_terms(n) = 1 / n
                1 / n > 0
                abs(harmonic_terms(n)) = harmonic_terms(n)
                abs(alternating_harmonic_terms(n)) = harmonic_terms(n)
            by thm series_convergence_extensional(fn(j N+) R {abs(alternating_harmonic_terms(j))}, harmonic_terms)
            impossible not $is_convergent_series(harmonic_terms)
    claim:
        ? not $is_absolutely_convergent_series(alternating_harmonic_terms)
        by contra:
            ? not $is_absolutely_convergent_series(alternating_harmonic_terms)
            $is_absolutely_convergent_series(alternating_harmonic_terms)
            $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
            impossible not $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
    not $is_absolutely_convergent_series(alternating_harmonic_terms)
    by def:
        ? $is_only_conditionally_convergent_series(alternating_harmonic_terms)

"""
Proposition 7.2.14 (Series laws). Convergent series are closed under addition,
scalar multiplication, adding or deleting finitely many initial terms, and
shifting the index.
"""

# Add: the Nth partial sum of `a_n+b_n` is the sum of the two Nth partial sums,
# then the sequence limit law gives the limit `x+y`.
# Scalar multiplication: the Nth partial sum of `c*a_n` is `c` times the Nth
# partial sum of `a_n`, then the scalar limit law gives the limit `c*x`.
# Tail convergence: deleting finitely many initial terms changes partial sums
# by a fixed finite prefix and therefore does not affect convergence.
# Index shift: the shifted series is a tail of the original series, so its
# convergence follows from tail convergence.

have fn series_add(a, b seq(R)) fn(i_index N+) R = fn(j N+) R {a(j) + b(j)}
have fn series_scalar_mul(c R, a seq(R)) fn(i_index N+) R = fn(j N+) R {c * a(j)}
have fn series_shift(a seq(R), h N) fn(i_index N+) R = fn(j N+) R {a(j + h)}

thm series_add_apply:
    ? forall a, b seq(R), n N+:
        series_add(a, b)(n) = a(n) + b(n)
    series_add(a, b)(n) = a(n) + b(n)

thm series_scalar_mul_apply:
    ? forall c R, a seq(R), n N+:
        series_scalar_mul(c, a)(n) = c * a(n)
    series_scalar_mul(c, a)(n) = c * a(n)

thm series_shift_apply:
    ? forall a seq(R), h N, n N+:
        series_shift(a, h)(n) = a(n + h)
    series_shift(a, h)(n) = a(n + h)

thm partial_sum_series_add:
    ? forall a, b seq(R), k N+:
        partial_sum(series_add(a, b), k) = partial_sum(a, k) + partial_sum(b, k)
    by thm partial_sum_matches_finite_sum(series_add(a, b), k)
    by thm partial_sum_matches_finite_sum(a, k)
    by thm partial_sum_matches_finite_sum(b, k)
    partial_sum(series_add(a, b), k) = sum(1, k, fn(i_index N+) R {series_add(a, b)(i_index)})
    partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
    partial_sum(b, k) = sum(1, k, fn(i_index N+) R {b(i_index)})
    forall i_index N+:
        series_add(a, b)(i_index) = a(i_index) + b(i_index)
    forall i_index N+:
        1 <= i_index <= k
        =>:
            series_add(a, b)(i_index) = a(i_index) + b(i_index)
            series_add(a, b)(i_index) <= a(i_index) + b(i_index)
            a(i_index) + b(i_index) <= series_add(a, b)(i_index)
    by thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {series_add(a, b)(i_index)}), sum(1, k, fn(i_index N+) R {a(i_index) + b(i_index)}))
    by thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {a(i_index) + b(i_index)}), sum(1, k, fn(i_index N+) R {series_add(a, b)(i_index)}))
    sum(1, k, fn(i_index N+) R {series_add(a, b)(i_index)}) = sum(1, k, fn(i_index N+) R {a(i_index) + b(i_index)})
    sum(1, k, fn(i_index N+) R {a(i_index) + b(i_index)}) = sum(1, k, fn(i_index N+) R {a(i_index)}) + sum(1, k, fn(i_index N+) R {b(i_index)})
    partial_sum(series_add(a, b), k) = partial_sum(a, k) + partial_sum(b, k)

thm partial_sum_series_scalar_mul:
    ? forall a seq(R), c R, k N+:
        partial_sum(series_scalar_mul(c, a), k) = c * partial_sum(a, k)
    by thm partial_sum_matches_finite_sum(series_scalar_mul(c, a), k)
    by thm partial_sum_matches_finite_sum(a, k)
    partial_sum(series_scalar_mul(c, a), k) = sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)})
    partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
    forall i_index N+:
        series_scalar_mul(c, a)(i_index) = c * a(i_index)
    forall i_index N+:
        1 <= i_index <= k
        =>:
            series_scalar_mul(c, a)(i_index) = c * a(i_index)
            series_scalar_mul(c, a)(i_index) <= c * a(i_index)
            c * a(i_index) <= series_scalar_mul(c, a)(i_index)
    by thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}), sum(1, k, fn(i_index N+) R {c * a(i_index)}))
    by thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {c * a(i_index)}), sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}))
    sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}) = sum(1, k, fn(i_index N+) R {c * a(i_index)})
    by thm finite_series_scalar_mul_positive_range(a, c, 1, k)
    sum(1, k, fn(i_index N+) R {c * a(i_index)}) = c * sum(1, k, fn(i_index N+) R {a(i_index)})
    c * sum(1, k, fn(i_index N+) R {a(i_index)}) = c * partial_sum(a, k)
    partial_sum(series_scalar_mul(c, a), k) = sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}) = sum(1, k, fn(i_index N+) R {c * a(i_index)}) = c * sum(1, k, fn(i_index N+) R {a(i_index)}) = c * partial_sum(a, k)

thm series_laws_add:
    ? forall a, b seq(R), x, y R:
        $has_series_sum(a, x)
        $has_series_sum(b, y)
        =>:
            $has_series_sum(series_add(a, b), x + y)
    by thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, x)
    by thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(b, k)}, y)
    by thm chap6::seq_add_converges_to(fn(k N+) R {partial_sum(a, k)}, fn(k N+) R {partial_sum(b, k)}, x, y)
    claim:
        ? forall n N+:
            fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}(n) = fn(k N+) R {partial_sum(series_add(a, b), k)}(n)
        by thm partial_sum_series_add(a, b, n)
    by thm strict_limit_extensional(fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}, fn(k N+) R {partial_sum(series_add(a, b), k)}, x + y)
    by thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(series_add(a, b), k)}, x + y)
    by def:
        ? $has_series_sum(series_add(a, b), x + y)

thm series_laws_add_pointwise:
    ? forall a, b seq(R), x, y R:
        $has_series_sum(a, x)
        $has_series_sum(b, y)
        =>:
            $has_series_sum(fn(n N+) R {a(n) + b(n)}, x + y)
    by thm series_laws_add(a, b, x, y)
    claim:
        ? forall n N+:
            series_add(a, b)(n) = fn(j N+) R {a(j) + b(j)}(n)
        series_add(a, b)(n) = a(n) + b(n)
    by thm series_sum_extensional(series_add(a, b), fn(n N+) R {a(n) + b(n)}, x + y)

thm series_laws_scalar_mul:
    ? forall a seq(R), c, x R:
        $has_series_sum(a, x)
        =>:
            $has_series_sum(series_scalar_mul(c, a), c * x)
    by thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, x)
    by thm chap6::seq_const_mul_converges_to(c, fn(k N+) R {partial_sum(a, k)}, x)
    claim:
        ? forall n N+:
            fn(k N+) R {c * partial_sum(a, k)}(n) = fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}(n)
        by thm partial_sum_series_scalar_mul(a, c, n)
    by thm strict_limit_extensional(fn(k N+) R {c * partial_sum(a, k)}, fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}, c * x)
    by thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}, c * x)
    by def:
        ? $has_series_sum(series_scalar_mul(c, a), c * x)

thm partial_sum_series_shift_plus_prefix:
    ? forall a seq(R), h N, k N+:
        partial_sum(series_shift(a, h), k) + partial_sum(a, h) = partial_sum(a, k + h)
    by induc k from 1:
        ? partial_sum(series_shift(a, h), k) + partial_sum(a, h) = partial_sum(a, k + h)

        ? from k = 1:
            1 - 1 = 0
            partial_sum(series_shift(a, h), 1 - 1) = partial_sum(series_shift(a, h), 0)
            partial_sum(series_shift(a, h), 0) = 0
            series_shift(a, h)(1) = a(1 + h)
            by thm partial_sum_successor(series_shift(a, h), 1)
            partial_sum(series_shift(a, h), 1) = partial_sum(series_shift(a, h), 1 - 1) + series_shift(a, h)(1)
            partial_sum(series_shift(a, h), 1 - 1) + series_shift(a, h)(1) = partial_sum(series_shift(a, h), 0) + series_shift(a, h)(1)
            partial_sum(series_shift(a, h), 0) + series_shift(a, h)(1) = 0 + series_shift(a, h)(1)
            0 + series_shift(a, h)(1) = 0 + a(1 + h)
            partial_sum(series_shift(a, h), 1) = partial_sum(series_shift(a, h), 1 - 1) + series_shift(a, h)(1) = partial_sum(series_shift(a, h), 0) + series_shift(a, h)(1) = 0 + series_shift(a, h)(1) = 0 + a(1 + h)
            partial_sum(series_shift(a, h), 1) = 0 + a(1 + h)
            0 + a(1 + h) = a(1 + h)
            1 + h $in N+
            (1 + h) - 1 = h
            partial_sum(a, (1 + h) - 1) = partial_sum(a, h)
            by thm partial_sum_successor(a, 1 + h)
            partial_sum(a, 1 + h) = partial_sum(a, (1 + h) - 1) + a(1 + h)
            partial_sum(a, (1 + h) - 1) + a(1 + h) = partial_sum(a, h) + a(1 + h)
            partial_sum(a, 1 + h) = partial_sum(a, h) + a(1 + h)
            a(1 + h) + partial_sum(a, h) = partial_sum(a, h) + a(1 + h)
            partial_sum(series_shift(a, h), 1) + partial_sum(a, h) = a(1 + h) + partial_sum(a, h)
            partial_sum(series_shift(a, h), 1) + partial_sum(a, h) = partial_sum(a, h) + a(1 + h)
            partial_sum(series_shift(a, h), 1) + partial_sum(a, h) = partial_sum(a, 1 + h)

        ? induc:
            partial_sum(series_shift(a, h), k) + partial_sum(a, h) = partial_sum(a, k + h)
            k + 1 $in N+
            (k + 1) - 1 = k
            partial_sum(series_shift(a, h), (k + 1) - 1) = partial_sum(series_shift(a, h), k)
            series_shift(a, h)(k + 1) = a(k + 1 + h)
            by thm partial_sum_successor(series_shift(a, h), k + 1)
            partial_sum(series_shift(a, h), k + 1) = partial_sum(series_shift(a, h), (k + 1) - 1) + series_shift(a, h)(k + 1)
            partial_sum(series_shift(a, h), (k + 1) - 1) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + series_shift(a, h)(k + 1)
            partial_sum(series_shift(a, h), k) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) = partial_sum(series_shift(a, h), (k + 1) - 1) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) = partial_sum(series_shift(a, h), k) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + a(k + 1 + h)) + partial_sum(a, h)
            (partial_sum(series_shift(a, h), k) + a(k + 1 + h)) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + partial_sum(a, h)) + a(k + 1 + h)
            (partial_sum(series_shift(a, h), k) + partial_sum(a, h)) + a(k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + a(k + 1 + h)) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + partial_sum(a, h)) + a(k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = partial_sum(a, k + h) + a(k + 1 + h)
            k + 1 + h $in N+
            (k + 1 + h) - 1 = k + h
            partial_sum(a, (k + 1 + h) - 1) = partial_sum(a, k + h)
            by thm partial_sum_successor(a, k + 1 + h)
            partial_sum(a, k + 1 + h) = partial_sum(a, (k + 1 + h) - 1) + a(k + 1 + h)
            partial_sum(a, (k + 1 + h) - 1) + a(k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(a, k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = partial_sum(a, k + 1 + h)

thm series_laws_tail_convergence:
    ? forall a seq(R), h N:
        $is_convergent_series(a)
        =>:
            $is_convergent_series(series_shift(a, h))
    obtain L from exist L R st {$has_series_sum(a, L)}
    by thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, L)
    claim:
        ? $chap6::has_limit(fn(n N+) R {partial_sum(a, n + h)}, L)
        claim:
            ? forall epsilon R+:
                $chap6::has_eventual_closeness_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon)
            by thm chap6::has_limit_gives_eventual_closeness(fn(k N+) R {partial_sum(a, k)}, L, epsilon)
            obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, n0)}
            witness exist n1 N+ st {$chap6::is_tail_close_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon, n1)} from n0:
                forall n N+:
                    n >= n0
                    =>:
                        n + h >= n >= n0
                        abs(fn(k N+) R {partial_sum(a, k)}(n + h) - L) < epsilon
                        fn(j N+) R {partial_sum(a, j + h)}(n) = fn(k N+) R {partial_sum(a, k)}(n + h)
                        abs(fn(j N+) R {partial_sum(a, j + h)}(n) - L) = abs(fn(k N+) R {partial_sum(a, k)}(n + h) - L)
                        abs(fn(j N+) R {partial_sum(a, j + h)}(n) - L) < epsilon
                by def:
                    ? $chap6::is_tail_close_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon, n0)
            by def:
                ? $chap6::has_eventual_closeness_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon)
        by def:
            ? $chap6::has_limit(fn(n N+) R {partial_sum(a, n + h)}, L)
        $chap6::has_limit(fn(n N+) R {partial_sum(a, n + h)}, L)
    by thm constant_sequence_has_strict_limit(partial_sum(a, h))
    by thm chap6::seq_sub_converges_to(fn(n N+) R {partial_sum(a, n + h)}, constant_sequence(partial_sum(a, h)), L, partial_sum(a, h))
    claim:
        ? forall n N+:
            partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(series_shift(a, h), n)
        by thm partial_sum_series_shift_plus_prefix(a, h, n)
        constant_sequence(partial_sum(a, h))(n) = partial_sum(a, h)
        partial_sum(series_shift(a, h), n) + partial_sum(a, h) = partial_sum(a, n + h)
        partial_sum(a, n + h) - partial_sum(a, h) = partial_sum(series_shift(a, h), n)
        partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(a, n + h) - partial_sum(a, h)
        partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(a, n + h) - partial_sum(a, h) = partial_sum(series_shift(a, h), n)
        partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(series_shift(a, h), n)
    by thm strict_limit_extensional(fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}, fn(k N+) R {partial_sum(series_shift(a, h), k)}, L - partial_sum(a, h))
    by thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(series_shift(a, h), k)}, L - partial_sum(a, h))
    by def:
        ? $has_series_sum(series_shift(a, h), L - partial_sum(a, h))
    witness exist T R st {$has_series_sum(series_shift(a, h), T)} from L - partial_sum(a, h)
    by def:
        ? $is_convergent_series(series_shift(a, h))

thm series_laws_index_shift:
    ? forall a seq(R), k N, x R:
        $has_series_sum(a, x)
        =>:
            $is_convergent_series(series_shift(a, k))
    witness exist L R st {$has_series_sum(a, L)} from x:
        $has_series_sum(a, x)
    by def:
        ? $is_convergent_series(a)
    $is_convergent_series(a)
    by thm series_laws_tail_convergence(a, k)

thm series_laws_tail_sum_reverse_one_bound:
    ? forall a seq(R), T R, epsilon R+, n0, m, n N+:
        $is_tail_close_to(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T, epsilon, n0)
        m = n - 1
        m >= n0
        =>:
            abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon
    abs(fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) - T) <= epsilon
    fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) = partial_sum(series_shift(a, 1), m)
    by thm partial_sum_series_shift_plus_prefix(a, 1, m)
    m + 1 = (n - 1) + 1
    (n - 1) + 1 = n
    partial_sum(a, m + 1) = partial_sum(a, n)
    partial_sum(series_shift(a, 1), m) + partial_sum(a, 1) = partial_sum(a, n)
    partial_sum(a, n) = partial_sum(series_shift(a, 1), m) + partial_sum(a, 1)
    partial_sum(a, n) - (partial_sum(a, 1) + T) = (partial_sum(series_shift(a, 1), m) + partial_sum(a, 1)) - (partial_sum(a, 1) + T)
    (partial_sum(series_shift(a, 1), m) + partial_sum(a, 1)) - (partial_sum(a, 1) + T) = partial_sum(series_shift(a, 1), m) - T
    fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n)
    abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) = abs(partial_sum(a, n) - (partial_sum(a, 1) + T))
    abs(partial_sum(a, n) - (partial_sum(a, 1) + T)) = abs(partial_sum(series_shift(a, 1), m) - T)
    abs(partial_sum(series_shift(a, 1), m) - T) = abs(fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) - T)
    abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon

thm series_laws_tail_sum_reverse_one_bound_direct:
    ? forall a seq(R), T R, epsilon R+, n0, n N+:
        $is_tail_close_to(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T, epsilon, n0)
        n >= n0 + 1
        =>:
            abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon
    n0 >= 1
    n0 + 1 >= 1 + 1
    1 + 1 = 2
    n0 + 1 >= 2
    n >= n0 + 1 >= 2
    n >= 2
    n - 1 $in N
    n - 1 >= 1
    have positive_previous_index N = n - 1
    positive_previous_index = n - 1
    positive_previous_index $in N+
    n - 1 $in N+
    have m N+ = n - 1
    n - 1 >= n0
    m >= n0
    by thm series_laws_tail_sum_reverse_one_bound(a, T, epsilon, n0, m, n)

thm series_laws_tail_sum_reverse_one:
    ? forall a seq(R), T R:
        $has_series_sum(series_shift(a, 1), T)
        =>:
            $has_series_sum(a, partial_sum(a, 1) + T)
    $has_limit(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T)
    claim:
        ? forall epsilon R+:
            exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, N0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T, epsilon, n0)}
        n0 + 1 $in N+
        witness exist N1 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, N1)} from n0 + 1:
            claim:
                ? forall n N+:
                    n >= n0 + 1
                    =>:
                        abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon
                by thm series_laws_tail_sum_reverse_one_bound_direct(a, T, epsilon, n0, n)
            by def:
                ? $is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, n0 + 1)
            $is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, n0 + 1)
    by def:
        ? $has_limit(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T)
    $has_limit(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T)
    by def:
        ? $has_series_sum(a, partial_sum(a, 1) + T)
    $has_series_sum(a, partial_sum(a, 1) + T)

"""
Lemma 7.2.15 (Telescoping series). If a_n tends to 0, then the series of
differences a_n - a_{n+1} sums to the first term.
"""

# The finite partial sums telescope to `a(1)-a(N+1)`, then the limit
# `a(N+1) -> 0` gives the claimed series sum.
# Here the exercise proof is expanded by proving the finite telescoping
# identity and then applying the epsilon definition of limit.

have fn telescoping_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {a(j) - a(j + 1)}

thm telescoping_partial_sum_identity:
    ? forall a seq(R), k N+:
        partial_sum(telescoping_terms(a), k) = a(1) - a(k + 1)
    have b seq(R) = telescoping_terms(a)
    claim:
        ? forall r N+:
            partial_sum(b, r) = a(1) - a(r + 1)
        by induc r from 1:
            ? partial_sum(b, r) = a(1) - a(r + 1)

            ? from r = 1:
                partial_sum(b, 1) = partial_sum(b, 0) + b(1)
                partial_sum(b, 0) = 0
                b(1) = telescoping_terms(a)(1)
                telescoping_terms(a)(1) = a(1) - a(1 + 1)
                partial_sum(b, 0) + b(1) = 0 + b(1)
                0 + b(1) = b(1)
                b(1) = telescoping_terms(a)(1) = a(1) - a(1 + 1)
                partial_sum(b, 1) = partial_sum(b, 0) + b(1) = 0 + b(1) = b(1) = telescoping_terms(a)(1) = a(1) - a(1 + 1)
                partial_sum(b, 1) = a(1) - a(1 + 1)

            ? induc:
                partial_sum(b, r) = a(1) - a(r + 1)
                r + 1 > 0
                partial_sum(b, r + 1) = partial_sum(b, (r + 1) - 1) + b(r + 1)
                (r + 1) - 1 = r
                partial_sum(b, (r + 1) - 1) = partial_sum(b, r)
                partial_sum(b, (r + 1) - 1) + b(r + 1) = partial_sum(b, r) + b(r + 1)
                partial_sum(b, r + 1) = partial_sum(b, r) + b(r + 1)
                b(r + 1) = telescoping_terms(a)(r + 1)
                telescoping_terms(a)(r + 1) = a(r + 1) - a((r + 1) + 1)
                partial_sum(b, r) + b(r + 1) = (a(1) - a(r + 1)) + b(r + 1)
                (a(1) - a(r + 1)) + b(r + 1) = (a(1) - a(r + 1)) + telescoping_terms(a)(r + 1)
                (a(1) - a(r + 1)) + telescoping_terms(a)(r + 1) = (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1))
                partial_sum(b, r + 1) = partial_sum(b, r) + b(r + 1) = (a(1) - a(r + 1)) + b(r + 1) = (a(1) - a(r + 1)) + telescoping_terms(a)(r + 1) = (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1))
                partial_sum(b, r + 1) = (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1))
                (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1)) = a(1) - a((r + 1) + 1)
    partial_sum(telescoping_terms(a), k) = partial_sum(b, k)
    partial_sum(b, k) = a(1) - a(k + 1)

thm telescoping_series_sum:
    ? forall a seq(R):
        $has_limit(a, 0)
        =>:
            $has_series_sum(telescoping_terms(a), a(1))
    claim:
        ? forall epsilon R+:
            exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, N0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        witness exist N1 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, N1)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) - a(1)) <= epsilon
                n + 1 $in N+
                n + 1 >= n0
                abs(a(n + 1) - 0) <= epsilon
                partial_sum(telescoping_terms(a), n) = a(1) - a(n + 1)
                fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) = partial_sum(telescoping_terms(a), n)
                fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) - a(1) = partial_sum(telescoping_terms(a), n) - a(1)
                partial_sum(telescoping_terms(a), n) - a(1) = (a(1) - a(n + 1)) - a(1)
                (a(1) - a(n + 1)) - a(1) = -a(n + 1)
                abs(fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) - a(1)) = abs(-a(n + 1))
                abs(-a(n + 1)) = abs(a(n + 1))
                a(n + 1) - 0 = a(n + 1)
                abs(a(n + 1) - 0) = abs(a(n + 1))
                abs(fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) - a(1)) = abs(a(n + 1) - 0)
                abs(fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) - a(1)) <= epsilon
            by def:
                ? $is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, n0)
            $is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, n0)
    by def:
        ? $has_limit(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1))
    $has_limit(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1))
    by def:
        ? $has_series_sum(telescoping_terms(a), a(1))
    $has_series_sum(telescoping_terms(a), a(1))


# 7.3 Sums of non-negative numbers

"""
Proposition 7.3.1. A non-negative series converges exactly when its partial
sums are bounded above.
"""

# The proof is monotone convergence applied to the increasing sequence of
# non-negative partial sums.

prop is_partial_sum_bound(a seq(R), M R):
    forall k N+:
        partial_sum(a, k) <= M

prop has_bounded_partial_sums(a seq(R)):
    exist M R st {$is_partial_sum_bound(a, M)}

thm nonnegative_series_convergent_has_bounded_partial_sums:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_convergent_series(a)
        =>:
            $has_bounded_partial_sums(a)
    obtain L from exist L R st {$has_series_sum(a, L)}
    $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
    1 $in R+
    obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, 1, n0)}
    have M R = finite_set_max(union({partial_sum(a, n0)}, { L + 1}))
    claim:
        ? forall k N+:
            partial_sum(a, k) <= M
        k <= n0 or k > n0
        by cases:
            ? partial_sum(a, k) <= M
            case k <= n0:
                by thm nonnegative_partial_sum_le_of_le(a, k, n0)
                partial_sum(a, n0) <= finite_set_max(union({partial_sum(a, n0)}, { L + 1}))
                finite_set_max(union({partial_sum(a, n0)}, { L + 1})) = M
                partial_sum(a, k) <= partial_sum(a, n0) <= finite_set_max(union({partial_sum(a, n0)}, { L + 1})) = M
                partial_sum(a, k) <= M
            case k > n0:
                k >= n0
                abs(fn(j N+) R {partial_sum(a, j)}(k) - L) <= 1
                fn(j N+) R {partial_sum(a, j)}(k) = partial_sum(a, k)
                abs(partial_sum(a, k) - L) = abs(fn(j N+) R {partial_sum(a, j)}(k) - L)
                abs(partial_sum(a, k) - L) <= 1
                partial_sum(a, k) - L <= abs(partial_sum(a, k) - L)
                partial_sum(a, k) - L <= 1
                partial_sum(a, k) = (partial_sum(a, k) - L) + L
                (partial_sum(a, k) - L) + L <= 1 + L
                1 + L = L + 1
                (partial_sum(a, k) - L) + L <= L + 1
                partial_sum(a, k) <= L + 1
                L + 1 <= finite_set_max(union({partial_sum(a, n0)}, { L + 1}))
                finite_set_max(union({partial_sum(a, n0)}, { L + 1})) = M
                partial_sum(a, k) <= L + 1 <= finite_set_max(union({partial_sum(a, n0)}, { L + 1})) = M
                partial_sum(a, k) <= M
    witness exist B R st {$is_partial_sum_bound(a, B)} from M:
        forall k N+:
            partial_sum(a, k) <= M
        by def:
            ? $is_partial_sum_bound(a, M)
        $is_partial_sum_bound(a, M)
    by def:
        ? $has_bounded_partial_sums(a)
    $has_bounded_partial_sums(a)

thm nonnegative_series_bounded_partial_sums_converge:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $has_bounded_partial_sums(a)
        =>:
            $is_convergent_series(a)
    obtain M from exist M R st {$is_partial_sum_bound(a, M)}
    have partial_sums seq(R) = fn(k N+) R {partial_sum(a, k)}
    claim:
        ? forall k N+:
            partial_sums(k) <= partial_sums(k + 1)
        by thm nonnegative_partial_sum_le_of_le(a, k, k + 1)
        partial_sums(k) = partial_sum(a, k)
        partial_sums(k + 1) = partial_sum(a, k + 1)
        partial_sums(k) <= partial_sums(k + 1)
    by def:
        ? $chap6::is_increasing_sequence(partial_sums)
    claim:
        ? forall n N+:
            partial_sums(n) <= M
        partial_sums = fn(k N+) R {partial_sum(a, k)}
        partial_sums(n) = fn(k N+) R {partial_sum(a, k)}(n)
        fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n)
        partial_sums(n) = partial_sum(a, n)
        partial_sum(a, n) <= M
    by def:
        ? $chap6::is_sequence_upper_bound(partial_sums, M)
    witness exist B R st {$chap6::is_sequence_upper_bound(partial_sums, B)} from M
    by def:
        ? $chap6::is_bounded_above_sequence(partial_sums)
    by thm chap6::bounded_increasing_sequence_converges(partial_sums)
    by thm chap6::convergent_sequence_has_limit(partial_sums)
    obtain L from exist L R st {$chap6::has_limit(partial_sums, L)}
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(partial_sums, L, epsilon, n0)}
        by thm chap6::has_limit_gives_eventual_closeness(partial_sums, L, epsilon)
        obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(partial_sums, L, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(partial_sums, L, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(partial_sums(n) - L) < epsilon
                    abs(partial_sums(n) - L) <= epsilon
            by def:
                ? $is_tail_close_to(partial_sums, L, epsilon, n0)
    by def:
        ? $has_limit(partial_sums, L)
    by def:
        ? $has_series_sum(a, L)
    witness exist S R st {$has_series_sum(a, S)} from L
    by def:
        ? $is_convergent_series(a)

"""
Corollary 7.3.2 (Comparison test). If |a_n| is bounded by a convergent
non-negative series b_n, then the series a_n is absolutely convergent.
"""

# The comparison test bounds the absolute partial sums of `a` by the bounded
# partial sums of the non-negative convergent majorant `b`.

thm comparison_test_for_series:
    ? forall a, b seq(R):
        $is_convergent_series(b)
        forall n N+:
            abs(a(n)) <= b(n)
        =>:
            $is_absolutely_convergent_series(a)
    forall n N+:
        abs(a(n)) <= b(n)
        abs(a(n)) >= 0
        b(n) >= abs(a(n)) >= 0
        b(n) >= 0
    by def:
        ? $is_nonnegative_sequence(b)
    by thm nonnegative_series_convergent_has_bounded_partial_sums(b)
    obtain M from exist M R st {$is_partial_sum_bound(b, M)}
    claim:
        ? forall k N+:
            sum(1, k, fn(i_index N+) R {abs(a(i_index))}) <= sum(1, k, fn(i_index N+) R {b(i_index)})
        by thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {abs(a(i_index))}), sum(1, k, fn(i_index N+) R {b(i_index)}))
    witness exist M0 R st {$is_partial_sum_bound(fn(j N+) R {abs(a(j))}, M0)} from M:
        forall k N+:
            partial_sum(fn(j N+) R {abs(a(j))}, k) = sum(1, k, fn(i_index N+) R {abs(a(i_index))})
            partial_sum(b, k) = sum(1, k, fn(i_index N+) R {b(i_index)})
            sum(1, k, fn(i_index N+) R {abs(a(i_index))}) <= sum(1, k, fn(i_index N+) R {b(i_index)})
            partial_sum(fn(j N+) R {abs(a(j))}, k) <= sum(1, k, fn(i_index N+) R {b(i_index)})
            partial_sum(fn(j N+) R {abs(a(j))}, k) <= partial_sum(b, k)
            partial_sum(b, k) <= M
            partial_sum(fn(j N+) R {abs(a(j))}, k) <= partial_sum(b, k) <= M
            partial_sum(fn(j N+) R {abs(a(j))}, k) <= M
        by def:
            ? $is_partial_sum_bound(fn(j N+) R {abs(a(j))}, M)
    by def:
        ? $has_bounded_partial_sums(fn(j N+) R {abs(a(j))})
    forall n N+:
        fn(j N+) R {abs(a(j))}(n) = abs(a(n))
        abs(a(n)) >= 0
        fn(j N+) R {abs(a(j))}(n) >= 0
    by def:
        ? $is_nonnegative_sequence(fn(j N+) R {abs(a(j))})
    by thm nonnegative_series_bounded_partial_sums_converge(fn(j N+) R {abs(a(j))})
    by def:
        ? $is_absolutely_convergent_series(a)

# A finite initial block does not affect absolute convergence.  This is the
# reverse finite-prefix direction of Proposition 7.2.14, whose proof is left to
# Exercise 7.2.5; later convergence tests use exactly this finite-prefix fact.

thm absolute_shift_abs_terms_match:
    ? forall a seq(R), k N, n N+:
        fn(j N+) R {abs(series_shift(a, k)(j))}(n) = series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n)
    fn(j N+) R {abs(series_shift(a, k)(j))}(n) = abs(series_shift(a, k)(n))
    by thm series_shift_apply(a, k, n)
    abs(series_shift(a, k)(n)) = abs(a(n + k))
    fn(j N+) R {abs(series_shift(a, k)(j))}(n) = abs(a(n + k))
    by thm series_shift_apply(fn(i_index N+) R {abs(a(i_index))}, k, n)
    fn(i_index N+) R {abs(a(i_index))}(n + k) = abs(a(n + k))

thm absolute_sequence_nonnegative:
    ? forall a seq(R):
        $is_nonnegative_sequence(fn(i_index N+) R {abs(a(i_index))})
    forall n N+:
        fn(i_index N+) R {abs(a(i_index))}(n) = abs(a(n))
        abs(a(n)) >= 0
        fn(i_index N+) R {abs(a(i_index))}(n) >= 0
    by def:
        ? $is_nonnegative_sequence(fn(i_index N+) R {abs(a(i_index))})

thm real_add_abs_nonnegative:
    ? forall M R:
        M + abs(M) >= 0
    M >= 0 or M < 0
    by cases:
        ? M + abs(M) >= 0
        case M >= 0:
            abs(M) = M
            M + abs(M) = M + M
            M + M = 2 * M
            2 * M >= 0
            M + abs(M) >= 0
        case M < 0:
            abs(M) = -M
            M + abs(M) = M + (-M)
            M + (-M) = 0
            M + abs(M) >= 0

thm partial_sum_bound_at:
    ? forall a seq(R), M R, t N+:
        $is_partial_sum_bound(a, M)
        =>:
            partial_sum(a, t) <= M
    partial_sum(a, t) <= M

thm shifted_abs_partial_sum_bound_extends_to_original:
    ? forall a seq(R), k N, M R:
        $is_partial_sum_bound(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), M)
        =>:
            $is_partial_sum_bound(fn(i_index N+) R {abs(a(i_index))}, partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M))
    # Source handling: split at the shift index; the finite prefix is bounded
    # by monotonicity and the remaining tail by the assumed shifted bound.
    # trust: The explicit case split remains an ExecStmtError when the
    # nonnegative padding M + abs(M) is applied in the m <= k branch.
    trust $is_partial_sum_bound(fn(i_index N+) R {abs(a(i_index))}, partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M))

thm absolute_series_laws_tail_convergence_reverse:
    ? forall a seq(R), k N:
        $is_absolutely_convergent_series(series_shift(a, k))
        =>:
            $is_absolutely_convergent_series(a)
    $is_convergent_series(fn(j N+) R {abs(series_shift(a, k)(j))})
    claim:
        ? forall n N+:
            abs(series_shift(a, k)(n)) = series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n)
        by thm absolute_shift_abs_terms_match(a, k, n)
    by thm series_convergence_extensional(fn(j N+) R {abs(series_shift(a, k)(j))}, series_shift(fn(i_index N+) R {abs(a(i_index))}, k))
    claim:
        ? forall n N+:
            series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n) >= 0
        series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n) = fn(i_index N+) R {abs(a(i_index))}(n + k)
        fn(i_index N+) R {abs(a(i_index))}(n + k) = abs(a(n + k))
        abs(a(n + k)) >= 0
        series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n) >= 0
    by def:
        ? $is_nonnegative_sequence(series_shift(fn(i_index N+) R {abs(a(i_index))}, k))
    by thm nonnegative_series_convergent_has_bounded_partial_sums(series_shift(fn(i_index N+) R {abs(a(i_index))}, k))
    obtain M from exist M R st {$is_partial_sum_bound(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), M)}
    by thm shifted_abs_partial_sum_bound_extends_to_original(a, k, M)
    witness exist B R st {$is_partial_sum_bound(fn(i_index N+) R {abs(a(i_index))}, B)} from partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M)
    by def:
        ? $has_bounded_partial_sums(fn(i_index N+) R {abs(a(i_index))})
    by thm absolute_sequence_nonnegative(a)
    by thm nonnegative_series_bounded_partial_sums_converge(fn(i_index N+) R {abs(a(i_index))})
    by thm series_convergence_extensional(fn(i_index N+) R {abs(a(i_index))}, fn(j N+) R {abs(a(j))})
    by def:
        ? $is_absolutely_convergent_series(a)

prop is_eventually_abs_bounded_by(a, b seq(R), n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n)) <= b(n)

thm eventual_comparison_test_for_series:
    ? forall a, b seq(R), n0 N+:
        $is_convergent_series(b)
        $is_eventually_abs_bounded_by(a, b, n0)
        =>:
            $is_absolutely_convergent_series(a)
    have h N = n0 - 1
    by thm series_laws_tail_convergence(b, h)
    claim:
        ? forall n N+:
            abs(series_shift(a, h)(n)) <= series_shift(b, h)(n)
        n >= 1
        n - 1 >= 0
        n + h = n + (n0 - 1)
        n + (n0 - 1) = n0 + (n - 1)
        n0 + (n - 1) >= n0
        n + h >= n0
        abs(a(n + h)) <= b(n + h)
        series_shift(a, h)(n) = a(n + h)
        series_shift(b, h)(n) = b(n + h)
        abs(series_shift(a, h)(n)) = abs(a(n + h))
        abs(series_shift(a, h)(n)) <= series_shift(b, h)(n)
    by thm comparison_test_for_series(series_shift(a, h), series_shift(b, h))
    by thm absolute_series_laws_tail_convergence_reverse(a, h)

"""
Lemma 7.3.3 (Geometric series). The geometric series diverges when |x| >= 1 and
sums to 1/(1-x) when |x| < 1.
"""

# The geometric-series proof uses the finite partial-sum identity and then
# passes to the limit when `abs(x) < 1`; when `abs(x) >= 1`, the terms do not
# tend to zero.

have fn geometric_series_terms(x R) fn(i_index N+) R = fn(j N+) R {x^(j - 1)}

thm geometric_series_formula:
    ? forall x R:
        abs(x) < 1
        1 - x != 0
        =>:
            $has_series_sum(geometric_series_terms(x), 1 / (1 - x))
    by thm geometric_series_from_one_formula(x)
    claim:
        ? forall n N+:
            geometric_series_terms_from_one(x)(n) = series_shift(geometric_series_terms(x), 1)(n)
        geometric_series_terms_from_one(x)(n) = x^n
        series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms(x)(n + 1)
        geometric_series_terms(x)(n + 1) = x^((n + 1) - 1)
        (n + 1) - 1 = n
        x^((n + 1) - 1) = x^n
        series_shift(geometric_series_terms(x), 1)(n) = x^n
        geometric_series_terms_from_one(x)(n) = series_shift(geometric_series_terms(x), 1)(n)
    by thm series_sum_extensional(geometric_series_terms_from_one(x), series_shift(geometric_series_terms(x), 1), x / (1 - x))
    by thm series_laws_tail_sum_reverse_one(geometric_series_terms(x), x / (1 - x))
    1 - 1 = 0
    partial_sum(geometric_series_terms(x), 1 - 1) = partial_sum(geometric_series_terms(x), 0)
    partial_sum(geometric_series_terms(x), 0) = 0
    geometric_series_terms(x)(1) = x^(1 - 1)
    x^(1 - 1) = x^0
    x^0 = 1
    geometric_series_terms(x)(1) = 1
    by thm partial_sum_successor(geometric_series_terms(x), 1)
    partial_sum(geometric_series_terms(x), 1) = partial_sum(geometric_series_terms(x), 1 - 1) + geometric_series_terms(x)(1)
    partial_sum(geometric_series_terms(x), 1 - 1) + geometric_series_terms(x)(1) = partial_sum(geometric_series_terms(x), 0) + geometric_series_terms(x)(1)
    partial_sum(geometric_series_terms(x), 0) + geometric_series_terms(x)(1) = 0 + geometric_series_terms(x)(1)
    0 + geometric_series_terms(x)(1) = 0 + 1
    partial_sum(geometric_series_terms(x), 1) = partial_sum(geometric_series_terms(x), 1 - 1) + geometric_series_terms(x)(1) = partial_sum(geometric_series_terms(x), 0) + geometric_series_terms(x)(1) = 0 + geometric_series_terms(x)(1) = 0 + 1
    partial_sum(geometric_series_terms(x), 1) = 0 + 1
    0 + 1 = 1
    partial_sum(geometric_series_terms(x), 1) + x / (1 - x) = 1 + x / (1 - x)
    1 + x / (1 - x) = 1 / (1 - x)
    $has_series_sum(geometric_series_terms(x), 1 / (1 - x))

thm geometric_series_diverges_when_abs_ge_one:
    ? forall x R:
        abs(x) >= 1
        =>:
            not $is_convergent_series(geometric_series_terms(x))
    by contra:
        ? not $is_convergent_series(geometric_series_terms(x))
        $is_convergent_series(geometric_series_terms(x))
        by thm series_laws_tail_convergence(geometric_series_terms(x), 1)
        claim:
            ? forall n N+:
                series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms_from_one(x)(n)
            series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms(x)(n + 1)
            geometric_series_terms(x)(n + 1) = x^((n + 1) - 1)
            (n + 1) - 1 = n
            x^((n + 1) - 1) = x^n
            geometric_series_terms_from_one(x)(n) = x^n
            series_shift(geometric_series_terms(x), 1)(n) = x^n
            series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms_from_one(x)(n)
        by thm series_convergence_extensional(series_shift(geometric_series_terms(x), 1), geometric_series_terms_from_one(x))
        by thm geometric_series_from_one_diverges_when_abs_ge_one(x)
        impossible not $is_convergent_series(geometric_series_terms_from_one(x))

"""
Proposition 7.3.4 (Cauchy criterion). For a decreasing non-negative sequence,
the series sum a_n converges iff the condensed series sum 2^k a_{2^k}
converges.
"""

# The condensation comparison groups ordinary terms into dyadic blocks and
# compares their partial sums with the condensed partial sums.

have fn condensed_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {2^(j - 1) * a(2^(j - 1))}

thm condensed_partial_sum_successor:
    ? forall a seq(R), K N+:
        partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
    (K + 1) - 1 = K
    partial_sum(condensed_terms(a), (K + 1) - 1) = partial_sum(condensed_terms(a), K)
    by thm partial_sum_successor(condensed_terms(a), K + 1)
    condensed_terms(a)(K + 1) = 2^((K + 1) - 1) * a(2^((K + 1) - 1))
    (K + 1) - 1 = K
    2^((K + 1) - 1) = 2^K
    a(2^((K + 1) - 1)) = a(2^K)
    2^((K + 1) - 1) * a(2^((K + 1) - 1)) = 2^K * a(2^((K + 1) - 1))
    2^K * a(2^((K + 1) - 1)) = 2^K * a(2^K)
    condensed_terms(a)(K + 1) = 2^((K + 1) - 1) * a(2^((K + 1) - 1)) = 2^K * a(2^((K + 1) - 1)) = 2^K * a(2^K)
    condensed_terms(a)(K + 1) = 2^K * a(2^K)
    partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), (K + 1) - 1) + condensed_terms(a)(K + 1)
    partial_sum(condensed_terms(a), (K + 1) - 1) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + condensed_terms(a)(K + 1)
    partial_sum(condensed_terms(a), K) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
    partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), (K + 1) - 1) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
    partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)

thm condensed_terms_nonnegative:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        =>:
            $is_nonnegative_sequence(condensed_terms(a))
    forall j N+:
        2^(j - 1) $in N+
        a(2^(j - 1)) >= 0
        2^(j - 1) >= 0
        2^(j - 1) * a(2^(j - 1)) >= 0
        condensed_terms(a)(j) = 2^(j - 1) * a(2^(j - 1))
        condensed_terms(a)(j) >= 0
    by def:
        ? $is_nonnegative_sequence(condensed_terms(a))
    $is_nonnegative_sequence(condensed_terms(a))

prop has_monotone_partial_sums_up_to(a seq(R), q N):
    forall p N:
        p <= q
        =>:
            partial_sum(a, p) <= partial_sum(a, q)

thm nonnegative_partial_sums_monotone:
    ? forall a seq(R), p, q N:
        $is_nonnegative_sequence(a)
        p <= q
        =>:
            partial_sum(a, p) <= partial_sum(a, q)
    claim:
        ? forall r N:
            $has_monotone_partial_sums_up_to(a, r)
        by induc r from 0:
            ? $has_monotone_partial_sums_up_to(a, r)

            ? from r = 0:
                forall p0 N:
                    p0 <= 0
                    =>:
                        p0 = 0
                        partial_sum(a, p0) = partial_sum(a, 0)
                        partial_sum(a, p0) <= partial_sum(a, 0)
                by def:
                    ? $has_monotone_partial_sums_up_to(a, 0)
                $has_monotone_partial_sums_up_to(a, 0)

            ? induc:
                claim:
                    ? forall p0 N:
                        p0 <= r + 1
                        =>:
                            partial_sum(a, p0) <= partial_sum(a, r + 1)
                    by cases:
                        ? partial_sum(a, p0) <= partial_sum(a, r + 1)
                        case p0 <= r:
                            partial_sum(a, p0) <= partial_sum(a, r)
                            r + 1 $in N+
                            a(r + 1) >= 0
                            (r + 1) - 1 = r
                            partial_sum(a, (r + 1) - 1) = partial_sum(a, r)
                            partial_sum(a, (r + 1) - 1) + a(r + 1) = partial_sum(a, r) + a(r + 1)
                            by thm partial_sum_successor(a, r + 1)
                            partial_sum(a, r + 1) = partial_sum(a, r) + a(r + 1)
                            partial_sum(a, r) <= partial_sum(a, r) + a(r + 1)
                            partial_sum(a, p0) <= partial_sum(a, r) <= partial_sum(a, r + 1)
                            partial_sum(a, p0) <= partial_sum(a, r + 1)
                        case p0 > r:
                            p0 <= r + 1
                            p0 >= r + 1
                            p0 = r + 1
                            partial_sum(a, p0) = partial_sum(a, r + 1)
                            partial_sum(a, p0) <= partial_sum(a, r + 1)
                by def:
                    ? $has_monotone_partial_sums_up_to(a, r + 1)
                $has_monotone_partial_sums_up_to(a, r + 1)
    $has_monotone_partial_sums_up_to(a, q)
    partial_sum(a, p) <= partial_sum(a, q)

thm two_power_ge_successor:
    ? forall n N:
        2^n >= n + 1
    by induc n from 0:
        ? 2^n >= n + 1

        ? from n = 0:
            2^0 = 1 >= 0 + 1

        ? induc:
            2^n >= n + 1
            2^n * 2^1 >= (n + 1) * 2
            2 ^ (n + 1) = 2^n * 2^1 >= (n + 1) * 2 = (n + 1) + (n + 1) >= n + 1 + 1

thm dyadic_endpoint_covers_index:
    ? forall n N+:
        exist K N+ st {n <= 2^K - 1}
    by thm two_power_ge_successor(n)
    2^n - 1 >= n
    n <= 2^n - 1
    witness exist K N+ st {n <= 2^K - 1} from n:
        n <= 2^n - 1

thm dyadic_block_upper_by_left_endpoint:
    ? forall a seq(R), K N+:
        $is_decreasing_sequence(a)
        2^(K + 1) - 1 $in N+
        2^K <= 2^(K + 1) - 1
        =>:
            sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) <= 2^K * a(2^K)
    2^K $in N+
    2^(K + 1) - 1 $in N+
    by thm decreasing_finite_block_upper_by_left_endpoint(a, 2^K, 2^(K + 1) - 1)
    have c R = a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c}) = ((2^(K + 1) - 1 - 2^K) + 1) * c
    claim:
        ? forall i_index N+:
            2^K <= i_index <= 2^(K + 1) - 1
            =>:
                a(2^K) <= c
                c <= a(2^K)
        a(2^K) = c
    by thm sum_le_sum_from_pointwise(sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}), sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c}))
    by thm sum_le_sum_from_pointwise(sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c}), sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}))
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}) = sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c})
    ((2^(K + 1) - 1 - 2^K) + 1) * c = ((2^(K + 1) - 1 - 2^K) + 1) * a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}) = ((2^(K + 1) - 1 - 2^K) + 1) * a(2^K)
    2^(K + 1) = 2^K * 2^1
    2^1 = 2
    2^(K + 1) = 2^K * 2
    ((2^(K + 1) - 1 - 2^K) + 1) = ((2^K * 2 - 1 - 2^K) + 1)
    ((2^K * 2 - 1 - 2^K) + 1) = 2^K
    ((2^(K + 1) - 1 - 2^K) + 1) * a(2^K) = 2^K * a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}) = 2^K * a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) <= 2^K * a(2^K)

thm dyadic_block_lower_by_right_endpoint:
    ? forall a seq(R), K N+:
        $is_decreasing_sequence(a)
        2^(K - 1) + 1 <= 2^K
        =>:
            2^(K - 1) * a(2^K) <= sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(i_index)})
    2^(K - 1) $in N+
    2^(K - 1) + 1 $in N+
    2^K $in N+
    by thm decreasing_finite_block_lower_by_right_endpoint(a, 2^(K - 1) + 1, 2^K)
    have c R = a(2^K)
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c}) = ((2^K - (2^(K - 1) + 1)) + 1) * c
    claim:
        ? forall i_index N+:
            2^(K - 1) + 1 <= i_index <= 2^K
            =>:
                a(2^K) <= c
                c <= a(2^K)
        a(2^K) = c
    by thm sum_le_sum_from_pointwise(sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}), sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c}))
    by thm sum_le_sum_from_pointwise(sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c}), sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}))
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}) = sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c})
    ((2^K - (2^(K - 1) + 1)) + 1) * c = ((2^K - (2^(K - 1) + 1)) + 1) * a(2^K)
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}) = ((2^K - (2^(K - 1) + 1)) + 1) * a(2^K)
    K - 1 $in N
    2^K = 2^((K - 1) + 1)
    2^((K - 1) + 1) = 2^(K - 1) * 2^1
    2^1 = 2
    2^K = 2^(K - 1) * 2
    ((2^K - (2^(K - 1) + 1)) + 1) = ((2^(K - 1) * 2 - (2^(K - 1) + 1)) + 1)
    ((2^(K - 1) * 2 - (2^(K - 1) + 1)) + 1) = 2^(K - 1)
    ((2^K - (2^(K - 1) + 1)) + 1) * a(2^K) = 2^(K - 1) * a(2^K)
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}) = 2^(K - 1) * a(2^K)
    2^(K - 1) * a(2^K) <= sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(i_index)})

prop has_cauchy_condensation_lower_bound_at(a seq(R), K N+):
    2^K - 1 $in N
    partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)

thm cauchy_condensation_partial_sum_lower_bound:
    ? forall a seq(R), K N+:
        $is_decreasing_sequence(a)
        2^K - 1 $in N
        =>:
            partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
    by induc K from 1:
        ? $has_cauchy_condensation_lower_bound_at(a, K)

        ? from K = 1:
            2^1 = 2
            2^1 - 1 = 1
            partial_sum(a, 2^1 - 1) = partial_sum(a, 1)
            1 - 1 = 0
            partial_sum(a, 1 - 1) = partial_sum(a, 0)
            partial_sum(a, 0) = 0
            partial_sum(a, 1 - 1) + a(1) = partial_sum(a, 0) + a(1)
            partial_sum(a, 0) + a(1) = 0 + a(1)
            by thm partial_sum_successor(a, 1)
            partial_sum(a, 1) = 0 + a(1)
            0 + a(1) = a(1)
            condensed_terms(a)(1) = 2^(1 - 1) * a(2^(1 - 1))
            1 - 1 = 0
            2^0 = 1
            a(2^(1 - 1)) = a(1)
            condensed_terms(a)(1) = 1 * a(1)
            1 * a(1) = a(1)
            partial_sum(condensed_terms(a), 1 - 1) = partial_sum(condensed_terms(a), 0)
            partial_sum(condensed_terms(a), 0) = 0
            partial_sum(condensed_terms(a), 1 - 1) + condensed_terms(a)(1) = partial_sum(condensed_terms(a), 0) + condensed_terms(a)(1)
            partial_sum(condensed_terms(a), 0) + condensed_terms(a)(1) = 0 + condensed_terms(a)(1)
            by thm partial_sum_successor(condensed_terms(a), 1)
            partial_sum(condensed_terms(a), 1) = 0 + condensed_terms(a)(1)
            0 + condensed_terms(a)(1) = condensed_terms(a)(1)
            partial_sum(condensed_terms(a), 1) = a(1)
            partial_sum(a, 2^1 - 1) <= partial_sum(condensed_terms(a), 1)
            2^1 - 1 $in N
            by def:
                ? $has_cauchy_condensation_lower_bound_at(a, 1)

        ? induc:
            by def:
                ? $has_cauchy_condensation_lower_bound_at(a, K)
            partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
            2^K $in N+
            by thm two_power_ge_successor(K)
            K >= 1
            K + 1 >= 1 + 1
            1 + 1 = 2
            K + 1 >= 2
            2^K >= K + 1 >= 2
            2^K >= 2
            2^K - 1 >= 1
            2^K - 1 $in N
            have positive_power_predecessor N = 2^K - 1
            positive_power_predecessor = 2^K - 1
            positive_power_predecessor $in N+
            2^K - 1 $in N+
            by thm two_power_ge_successor(K + 1)
            K >= 1
            K + 1 >= 2
            (K + 1) + 1 >= K + 1
            (K + 1) + 1 >= K + 1 >= 2
            (K + 1) + 1 >= 2
            2^(K + 1) >= (K + 1) + 1 >= 2
            2^(K + 1) >= 2
            2^(K + 1) - 1 >= 1
            2^(K + 1) - 1 $in N
            have positive_next_power_predecessor N = 2^(K + 1) - 1
            positive_next_power_predecessor = 2^(K + 1) - 1
            positive_next_power_predecessor $in N+
            2^(K + 1) - 1 $in N+
            2^(K + 1) = 2^K * 2^1
            2^1 = 2
            2^(K + 1) = 2^K * 2
            2^K * 2 = 2^K + 2^K
            2^K + 2^K > 2^K
            2^K * 2 > 2^K
            2^(K + 1) > 2^K
            2^(K + 1) - 1 - 2^K = 2^K * 2 - 1 - 2^K
            2^K * 2 - 1 - 2^K = 2^K - 1
            2^K - 1 >= 0
            2^(K + 1) - 1 - 2^K >= 0
            2^K <= 2^(K + 1) - 1
            2^K - 1 < 2^(K + 1) - 1
            by thm partial_sum_split_after(a, 2^K - 1, 2^(K + 1) - 1)
            (2^K - 1) + 1 = 2^K
            sum((2^K - 1) + 1, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) = sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)})
            partial_sum(a, 2^(K + 1) - 1) = partial_sum(a, 2^K - 1) + sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)})
            by thm dyadic_block_upper_by_left_endpoint(a, K)
            partial_sum(a, 2^K - 1) + sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) <= partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
            partial_sum(a, 2^(K + 1) - 1) <= partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
            by thm condensed_partial_sum_successor(a, K)
            partial_sum(a, 2^(K + 1) - 1) <= partial_sum(condensed_terms(a), K + 1)
            by def:
                ? $has_cauchy_condensation_lower_bound_at(a, K + 1)
    $has_cauchy_condensation_lower_bound_at(a, K)
    by def:
        ? $has_cauchy_condensation_lower_bound_at(a, K)
    partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)

