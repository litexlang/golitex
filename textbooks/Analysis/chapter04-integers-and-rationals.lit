# Chapter 4: Integers and rationals.


"""
Definition 4.1.1 (Integers). An integer is an expression a--b where a and b are
natural numbers. Two expressions a-b and c-d are equal iff a+d = c+b.
"""

# A formal difference is an ordered pair `(a,b)` of natural numbers. It is
# intentionally not the truncated natural-number value `a-b`.

have formal_difference set = cart(N, N)

# The pair `(a,b)` represents the same integer as `(c,d)` exactly when
# `a+d=c+b`.

prop represent_same_integer(p, q cart(N, N)):
    p[1] + q[2] = q[1] + p[2]

# For example, `(3,1)` and `(4,2)` both represent the integer two.

by def $represent_same_integer((3, 1), (4, 2))

"""
Definition 4.1.2. Addition of formal differences is
(a-b)+(c-d) := (a+c)-(b+d), and multiplication is
(a-b)(c-d) := (ac+bd)-(ad+bc).
"""

# Definition 4.1.2 gives actual operations on representatives. Multiplication
# separates the positive terms `ac+bd` from the negative terms `ad+bc`.

have fn add_formal_differences(p, q cart(N, N)) cart(N, N) = (p[1] + q[1], p[2] + q[2])

have fn multiply_formal_differences(p, q cart(N, N)) cart(N, N) = (p[1] * q[1] + p[2] * q[2], p[1] * q[2] + p[2] * q[1])

"""
Lemma 4.1.3. Addition and multiplication are well-defined.
"""

# Well-definedness means that replacing a representative by an equivalent one
# leaves the resulting equivalence class unchanged.

thm addition_respects_formal_difference_equivalence:
    ? forall p, q, r cart(N, N):
        $represent_same_integer(p, q)
        =>:
            $represent_same_integer(add_formal_differences(p, r), add_formal_differences(q, r))
    p[1] + q[2] = q[1] + p[2]
    add_formal_differences(p, r) = (p[1] + r[1], p[2] + r[2])
    add_formal_differences(q, r) = (q[1] + r[1], q[2] + r[2])
    add_formal_differences(p, r)[1] = p[1] + r[1]
    add_formal_differences(p, r)[2] = p[2] + r[2]
    add_formal_differences(q, r)[1] = q[1] + r[1]
    add_formal_differences(q, r)[2] = q[2] + r[2]
    add_formal_differences(p, r)[1] + add_formal_differences(q, r)[2] = (p[1] + r[1]) + (q[2] + r[2]) = (p[1] + q[2]) + (r[1] + r[2]) = (q[1] + p[2]) + (r[1] + r[2]) = (q[1] + r[1]) + (p[2] + r[2]) = add_formal_differences(q, r)[1] + add_formal_differences(p, r)[2]
    by def $represent_same_integer(add_formal_differences(p, r), add_formal_differences(q, r))

thm multiplication_respects_formal_difference_equivalence:
    ? forall p, q, r cart(N, N):
        $represent_same_integer(p, q)
        =>:
            $represent_same_integer(multiply_formal_differences(p, r), multiply_formal_differences(q, r))
    p[1] + q[2] = q[1] + p[2]
    multiply_formal_differences(p, r) = (p[1] * r[1] + p[2] * r[2], p[1] * r[2] + p[2] * r[1])
    multiply_formal_differences(q, r) = (q[1] * r[1] + q[2] * r[2], q[1] * r[2] + q[2] * r[1])
    multiply_formal_differences(p, r)[1] = p[1] * r[1] + p[2] * r[2]
    multiply_formal_differences(p, r)[2] = p[1] * r[2] + p[2] * r[1]
    multiply_formal_differences(q, r)[1] = q[1] * r[1] + q[2] * r[2]
    multiply_formal_differences(q, r)[2] = q[1] * r[2] + q[2] * r[1]
    p[2] + q[1] = q[1] + p[2] = p[1] + q[2] = q[2] + p[1]
    multiply_formal_differences(p, r)[1] + multiply_formal_differences(q, r)[2] = (p[1] * r[1] + p[2] * r[2]) + (q[1] * r[2] + q[2] * r[1]) = (p[1] + q[2]) * r[1] + (p[2] + q[1]) * r[2] = (q[1] + p[2]) * r[1] + (p[2] + q[1]) * r[2] = (q[1] + p[2]) * r[1] + (q[2] + p[1]) * r[2] = (q[1] * r[1] + q[2] * r[2]) + (p[1] * r[2] + p[2] * r[1]) = multiply_formal_differences(q, r)[1] + multiply_formal_differences(p, r)[2]
    by def $represent_same_integer(multiply_formal_differences(p, r), multiply_formal_differences(q, r))

# Natural-number arithmetic agrees with the representative embedding `n |->
# (n,0)`.

forall n, m N:
    add_formal_differences((n, 0), (m, 0)) = (n + m, 0)
    multiply_formal_differences((n, 0), (m, 0)) = (n * m, 0)

"""
Definition 4.1.4 (Negation of integers). The negation of a-b is b-a.
"""

# Negating a formal difference swaps its two natural-number coordinates. This
# operation is well-defined on equivalence classes.

have fn negate_formal_difference(p cart(N, N)) cart(N, N) = (p[2], p[1])

thm negation_respects_formal_difference_equivalence:
    ? forall p, q cart(N, N):
        $represent_same_integer(p, q)
        =>:
            $represent_same_integer(negate_formal_difference(p), negate_formal_difference(q))
    p[1] + q[2] = q[1] + p[2]
    negate_formal_difference(p) = (p[2], p[1])
    negate_formal_difference(q) = (q[2], q[1])
    negate_formal_difference(p)[1] = p[2]
    negate_formal_difference(p)[2] = p[1]
    negate_formal_difference(q)[1] = q[2]
    negate_formal_difference(q)[2] = q[1]
    negate_formal_difference(p)[1] + negate_formal_difference(q)[2] = p[2] + q[1] = q[1] + p[2] = p[1] + q[2] = q[2] + p[1] = negate_formal_difference(q)[1] + negate_formal_difference(p)[2]
    by def $represent_same_integer(negate_formal_difference(p), negate_formal_difference(q))

# The swapped representative is the additive inverse.

forall x Z:
    x + (-x) = 0
    (-x) + x = 0

# Positive natural numbers have negative integer inverses.

forall n N_pos:
    -n $in Z
    -n < 0

"""
Lemma 4.1.5 (Trichotomy of integers). Every integer is positive, zero, or
negative, and exactly one of these cases holds.
"""

# The representative proof splits an integer written as `a-b` into the cases
# `a>b`, `a=b`, and `a<b`; the conclusions are positive, zero, and negative
# respectively.

forall x Z:
    x > 0 or x = 0 or x < 0

forall x Z:
    x > 0
    =>:
        x != 0
        not x < 0

forall x Z:
    x = 0
    =>:
        not x > 0
        not x < 0

forall x Z:
    x < 0
    =>:
        x != 0
        not x > 0

"""
Proposition 4.1.6 (Laws of algebra for integers). The integers form a
commutative ring.
"""

# Proposition 4.1.6 lists the commutative-ring laws for integer arithmetic.

# These laws can be proved by expanding representatives `a-b`, `c-d`, `e-f`
# and reducing the identities to natural-number algebra.

forall x, y, z Z:
    x + y = y + x
    (x + y) + z = x + (y + z)
    x + 0 = x
    0 + x = x
    x + (-x) = 0
    (-x) + x = 0
    x * y = y * x
    (x * y) * z = x * (y * z)
    x * 1 = x
    1 * x = x
    x * (y + z) = x * y + x * z
    (y + z) * x = y * x + z * x

"""
Remark 4.1.7. These identities say that the integers form a commutative ring.
A proof can either split into sign cases or expand representatives a-b, c-d,
e-f and reduce to natural-number algebra.
"""

"""
Proposition 4.1.8. Integers have no zero divisors.
"""

# The zero-divisor law says a product of two integers can be zero only when at
# least one factor is zero.

forall a, b Z:
    a * b = 0
    =>:
        a = 0 or b = 0

"""
Corollary 4.1.9. Cancellation law for integers.
"""

# Cancellation says equal products by the same nonzero integer have equal
# remaining factors.

thm integer_multiplication_cancellation:
    ? forall a, b, c Z:
        a * c = b * c
        c != 0
        =>:
            a = b
    (a - b) * c = a * c - b * c = 0
    (a - b) * c = 0
    a - b = 0 or c = 0
    by cases:
        ? a = b
        case a - b = 0:
            a = a - b + b = b
        case c = 0:
            c != 0
            impossible c != 0

"""
Definition 4.1.10. Ordering of integers.
"""

# Definition 4.1.10 defines order by a natural-number difference:
# `a <= b` means that `b` can be written as `a+x` for some `x in N`.
# For `a < b`, the witness is the positive difference `b-a`.

forall a, b Z:
    a < b
    =>:
        b - a $in N_pos
        b = a + (b - a)

# The same definition in existential form: if `a < b`, a natural witness
# `x=b-a` satisfies `b=a+x`.

claim:
    ? forall a, b Z:
        a < b
        =>:
            exist x N st {b = a + x}
    witness exist x N st {b = a + x} from b - a

# The non-strict order version allows the same witness `x=b-a`, now possibly
# zero.

claim:
    ? forall a, b Z:
        a <= b
        =>:
            exist x N st {b = a + x}
    witness exist x N st {b = a + x} from b - a

"""
Lemma 4.1.11. Integer order is compatible with addition, positive
multiplication, negation, transitivity, and trichotomy.
"""

# Lemma 4.1.11(a): strict order is detected by a positive difference.  In
# ordinary algebraic reasoning, `a > b`, `b < a`, and `a - b > 0` are the same
# comparison written in different forms.

forall a, b Z:
    a > b
    =>:
        a - b > 0

forall a, b Z:
    a - b $in N_pos
    =>:
        a > b

forall a, b Z:
    =>:
        a > b
    <=>:
        a - b $in N_pos

# Lemma 4.1.11(b): adding the same integer preserves strict order.

forall a, b, c Z:
    a > b
    =>:
        a + c > b + c

# Lemma 4.1.11(c): multiplying by a positive integer preserves strict order.

forall a, b, c Z:
    a > b
    c > 0
    =>:
        a * c > b * c

# Lemma 4.1.11(d): negation reverses strict order.

forall a, b Z:
    a > b
    =>:
        -a < -b

# Lemma 4.1.11(e): strict order is transitive.

forall a, b, c Z:
    a > b
    b > c
    =>:
        a > c

# Lemma 4.1.11(f): integer order has trichotomy.

forall a, b Z:
    a > b or a = b or a < b

forall a, b Z:
    a > b
    =>:
        a != b

forall a, b Z:
    a > b
    =>:
        a >= b
        not a < b

thm equal_integers_are_not_strictly_ordered:
    ? forall a, b Z:
        a = b
        =>:
            not a > b
            not a < b
    claim:
        ? not a > b
        by contra:
            ? not a > b
            a - b > 0
            a - b = 0
            impossible a - b = 0
    claim:
        ? not a < b
        by contra:
            ? not a < b
            b - a > 0
            b - a = 0
            impossible b - a = 0

forall a, b Z:
    a < b
    =>:
        a != b

forall a, b Z:
    a < b
    =>:
        a <= b
        not a > b

"""
Definition 4.2.1. A rational number is an expression a//b with b non-zero.
Two quotients a//b and c//d are equal iff ad = cb.
"""

# Definition 4.2.1 has two mathematical parts: every rational is represented
# by an integer numerator and a nonzero integer denominator, and two
# representatives are equal exactly when their cross-products agree.
# Litex carrier suffixes record the same restrictions: `_nz` means nonzero,
# while `_pos` and `_neg` mean strictly positive and strictly negative.  Thus
# `Z_nz` below is the set of nonzero integers.

thm rational_equality_gives_cross_products:
    ? forall a Z, b Z_nz, c Z, d Z_nz:
        a / b = c / d
        =>:
            a * d = c * b
    b != 0
    d != 0
    a * d = (a / b) * (b * d) = (c / d) * (b * d) = c * b

thm cross_products_give_rational_equality:
    ? forall a Z, b Z_nz, c Z, d Z_nz:
        a * d = c * b
        =>:
            a / b = c / d
    b != 0
    d != 0
    b * d != 0
    a / b = (a * d) / (b * d) = (c * b) / (b * d) = c / d

forall a Z, b Z_nz, c Z, d Z_nz:
    =>:
        a / b = c / d
    <=>:
        a * d = c * b

# Fraction representation existence: every rational can be written as `a/b`
# with `a` an integer and `b` a nonzero integer.  This is the representation
# used later in the proof idea for irrationality of sqrt(2).

forall q Q:
    exist a Z, b Z_nz st {q = a / b}

"""
Definition 4.2.2. Rational addition, multiplication, and negation.
"""

# Definition 4.2.2 gives addition, multiplication, and negation by formulas
# on quotient representatives.

forall b, d Z_nz:
    b * d != 0

forall a Z, b Z_nz, c Z, d Z_nz:
    (a / b) + (c / d) = (a * d + b * c) / (b * d)
    (a / b) * (c / d) = (a * c) / (b * d)
    -(a / b) = (-a) / b

"""
Lemma 4.2.3. These operations are well-defined.
"""

# Lemma 4.2.3 says these quotient formulas are well-defined: replacing one
# representative by an equal quotient leaves sums, products, and negations
# unchanged.

thm rational_operations_respect_left_representative:
    ? forall a Z, b Z_nz, a1 Z, b1 Z_nz, c Z, d Z_nz:
        a * b1 = a1 * b
        =>:
            (a / b) + (c / d) = (a1 / b1) + (c / d)
            (a / b) * (c / d) = (a1 / b1) * (c / d)
            -(a / b) = -(a1 / b1)
    by thm cross_products_give_rational_equality(a, b, a1, b1)
    a / b = a1 / b1
    (a / b) + (c / d) = (a1 / b1) + (c / d)
    (a / b) * (c / d) = (a1 / b1) * (c / d)
    -(a / b) = -(a1 / b1)

thm rational_operations_respect_right_representative:
    ? forall a Z, b Z_nz, c Z, d Z_nz, c1 Z, d1 Z_nz:
        c * d1 = c1 * d
        =>:
            (a / b) + (c / d) = (a / b) + (c1 / d1)
            (a / b) * (c / d) = (a / b) * (c1 / d1)
    by thm cross_products_give_rational_equality(c, d, c1, d1)
    c / d = c1 / d1
    (a / b) + (c / d) = (a / b) + (c1 / d1)
    (a / b) * (c / d) = (a / b) * (c1 / d1)

# Integer quotients `a/1` embed integers into rationals and preserve arithmetic.

forall a, b Z:
    (a / 1) + (b / 1) = (a + b) / 1
    (a / 1) * (b / 1) = (a * b) / 1
    -(a / 1) = (-a) / 1

thm integer_embedding_into_rationals_is_injective:
    ? forall a, b Z:
        a / 1 = b / 1
        =>:
            a = b
    by thm rational_equality_gives_cross_products(a, 1, b, 1)
    a * 1 = b * 1
    a = a * 1 = b * 1 = b

forall a, b Z:
    a = b
    =>:
        a / 1 = b / 1

forall a, b Z:
    =>:
        a / 1 = b / 1
    <=>:
        a = b

# A quotient is zero exactly when its numerator is zero; hence a quotient with
# nonzero numerator and denominator is nonzero.

thm rational_quotient_zero_has_zero_numerator:
    ? forall a Z, b Z_nz:
        a / b = 0
        =>:
            a = 0
    0 = 0 / 1
    a / b = 0 / 1
    by thm rational_equality_gives_cross_products(a, b, 0, 1)
    a * 1 = 0 * b
    a = a * 1 = 0 * b = 0

forall a Z, b Z_nz:
    a = 0
    =>:
        a / b = 0

forall a Z, b Z_nz:
    =>:
        a / b = 0
    <=>:
        a = 0

forall a Z_nz, b Z_nz:
    a / b != 0

# The reciprocal of a nonzero quotient swaps numerator and denominator.

forall a Z_nz, b Z_nz:
    1 / (a / b) = b / a

"""
Proposition 4.2.4. The rationals form a field.
"""

# Proposition 4.2.4 records the field laws for rational arithmetic.

forall x, y, z Q:
    x + y = y + x
    (x + y) + z = x + (y + z)
    x + 0 = x
    0 + x = x
    x + (-x) = 0
    (-x) + x = 0
    x * y = y * x
    (x * y) * z = x * (y * z)
    x * 1 = x
    1 * x = x
    x * (y + z) = x * y + x * z
    (y + z) * x = y * x + z * x

# The builtin carrier `Q_nz` is the set of nonzero rational numbers, exactly
# the domain on which the reciprocal `1/x` is defined.

forall x Q_nz:
    x * (1 / x) = 1
    (1 / x) * x = 1

"""
Remark 4.2.5. These identities say that Q is a field. The extra feature beyond
the integer ring is multiplicative inverse for non-zero rationals.
"""

"""
Definition 4.2.6. Positive and negative rationals.
"""

# Definition 4.2.6: a positive rational has a positive-integer quotient
# representation.  Conversely, every quotient of positive integers is positive.

forall a, b N_pos:
    a / b > 0

forall x Q:
    x > 0
    =>:
        exist a N_pos, b N_pos st {x = a / b}

# Definition 4.2.6, negative part: a negative rational is the additive inverse
# of a positive rational.

claim:
    ? forall q Q:
        q < 0
        =>:
            exist y Q st {y > 0, q = -y}
    witness exist y Q st {y > 0, q = -y} from -q

# Conversely, the additive inverse of a positive rational is negative.

forall y Q:
    y > 0
    =>:
        -y < 0

# In quotient form, `(-a)/b` is negative when `a` and `b` are positive.

forall a, b N_pos:
    a / b > 0
    -(a / b) < 0
    (-a) / b = -(a / b)
    (-a) / b < 0

"""
Lemma 4.2.7. Trichotomy of rationals.
"""

# Lemma 4.2.7: every rational is positive, zero, or negative.

forall x Q:
    x > 0 or x = 0 or x < 0

# Lemma 4.2.7 also says the three sign cases are mutually exclusive.

forall x Q:
    x > 0
    =>:
        x != 0
        not x < 0

forall x Q:
    x = 0
    =>:
        not x > 0
        not x < 0

forall x Q:
    x < 0
    =>:
        x != 0
        not x > 0

"""
Definition 4.2.8. Ordering of the rationals.
"""

# Definition 4.2.8 says rational order is detected by the sign of `x-y`.

forall x, y Q:
    =>:
        x > y
    <=>:
        x - y > 0

forall x, y Q:
    =>:
        x < y
    <=>:
        x - y < 0

"""
Proposition 4.2.9. Basic properties of order on the rationals.
"""

# Proposition 4.2.9(a): two rationals satisfy exactly one of equality,
# strict less-than, or strict greater-than.

forall x, y Q:
    x > y or x = y or x < y

thm rational_less_excludes_equal_and_greater:
    ? forall x, y Q:
        x < y
        =>:
            x != y
            not x > y
    x != y
    x - y < 0
    claim:
        ? not x > y
        by contra:
            ? not x > y
            x - y > 0
            impossible x - y < 0

thm equal_rationals_are_not_strictly_ordered:
    ? forall x, y Q:
        x = y
        =>:
            not x < y
            not x > y
    x - y = 0
    claim:
        ? not x < y
        by contra:
            ? not x < y
            x - y < 0
            impossible x - y = 0
    claim:
        ? not x > y
        by contra:
            ? not x > y
            x - y > 0
            impossible x - y = 0

thm rational_greater_excludes_equal_and_less:
    ? forall x, y Q:
        x > y
        =>:
            x != y
            not x < y
    x != y
    x - y > 0
    claim:
        ? not x < y
        by contra:
            ? not x < y
            x - y < 0
            impossible x - y > 0

# Proposition 4.2.9(b): reversing the arguments reverses the inequality symbol.

forall x, y Q:
    x < y
    =>:
        y > x

# Proposition 4.2.9(c): rational order is transitive.

forall x, y, z Q:
    x < y
    y < z
    =>:
        x < z

# Proposition 4.2.9(d): adding the same rational preserves strict order.

forall x, y, z Q:
    x < y
    =>:
        x + z < y + z

# Proposition 4.2.9(e): multiplying by a positive rational preserves strict order.

forall x, y, z Q:
    x < y
    z > 0
    =>:
        x * z < y * z

"""
Remark 4.2.10. The field laws plus the rational order laws say that Q is an
ordered field. Multiplication preserves order only by a positive factor.
"""

"""
Definition 4.3.1 (Absolute value on Q). For a rational number x, |x| is x if
x is positive, -x if x is negative, and 0 if x=0. Thus |x| measures the
distance of x from 0 and is always non-negative.
"""

# Definition 4.3.1 is piecewise: positive numbers keep their value, negative
# numbers take their additive inverse, and zero stays zero.  Litex uses the
# standard notation `abs` for this operation.

forall x Q:
    x > 0
    =>:
        abs(x) = x

forall x Q:
    x < 0
    =>:
        abs(x) = -x

forall x Q:
    x = 0
    =>:
        abs(x) = 0

"""
Definition 4.3.2 (Distance on Q). For rational numbers x and y, define
d(x,y) := |x-y|. This distance is non-negative, symmetric, and is zero
exactly when x=y.
"""

# Definition 4.3.2 names `abs(x-y)` as the distance between two rationals.

have fn dist_Q(x, y Q) Q = abs(x - y)

# The named formula is the cross-module proof interface for unfolding the
# rational distance function.

thm rational_distance_formula:
    ? forall x, y Q:
        dist_Q(x, y) = abs(x - y)
    dist_Q(x, y) = abs(x - y)

"""
Proposition 4.3.3. Basic properties of absolute value and distance.
"""

# Proposition 4.3.3(a), first half: absolute value is always non-negative.

forall x Q:
    abs(x) >= 0

# Proposition 4.3.3(a), zero direction: if `abs(x)=0`, then `x=0`.

forall x Q:
    abs(x) = 0
    =>:
        x = 0

# Proposition 4.3.3(a), strict version: nonzero rationals have positive
# absolute value.  The proof splits the sign of `abs(x)` and rules out zero
# and negative cases.

forall x Q:
    x != 0
    =>:
        abs(x) > 0

# Proposition 4.3.3(c): `-y <= x <= y` is equivalent to `y >= abs(x)`.

forall x, y Q:
    -y <= x
    x <= y
    =>:
        y >= abs(x)

thm rational_abs_upper_bound_gives_two_sided_bound:
    ? forall x, y Q:
        y >= abs(x)
        =>:
            -y <= x
            x <= y
    x <= abs(x)
    -x <= abs(x)
    -y <= -abs(x)
    -abs(x) <= x
    -y <= -abs(x) <= x
    x <= abs(x) <= y

forall x, y Q:
    =>:
        -y <= x
        x <= y
    <=>:
        y >= abs(x)

# The special case `y=abs(x)` gives the usual two-sided bound.

forall x Q:
    x <= abs(x)
    -x <= abs(x)

# Proposition 4.3.3(d): absolute value is multiplicative.

forall x, y Q:
    abs(x * y) = abs(x) * abs(y)

# Taking `y=-1` in multiplicativity gives `abs(-x)=abs(x)`.

forall x Q:
    abs(-x) = abs(x)

# Proposition 4.3.3(b): the absolute-value triangle inequality.

forall x, y Q:
    abs(x + y) <= abs(x) + abs(y)

# Proposition 4.3.3(e), non-negativity of distance, unfolded from
# `dist_Q(x,y)=abs(x-y)`.

thm rational_distance_nonnegative:
    ? forall x, y Q:
        dist_Q(x, y) >= 0
    dist_Q(x, y) = abs(x - y)
    abs(x - y) >= 0
    dist_Q(x, y) >= 0

# Proposition 4.3.3(e), one zero-distance direction: equal points have
# distance zero.

thm equal_rationals_have_zero_distance:
    ? forall x, y Q:
        x = y
        =>:
            dist_Q(x, y) = 0
    dist_Q(x, y) = abs(x - y) = abs(0) = 0

# Proposition 4.3.3(e), the other zero-distance direction: distance zero
# forces the difference to be zero, hence the two rationals are equal.

thm zero_rational_distance_gives_equality:
    ? forall x, y Q:
        dist_Q(x, y) = 0
        =>:
            x = y
    dist_Q(x, y) = abs(x - y)
    abs(x - y) = 0
    x - y = 0
    x = x - y + y = y

# Proposition 4.3.3(f): symmetry follows from
# `abs(x-y)=abs(-(y-x))=abs(y-x)`.

thm rational_distance_is_symmetric:
    ? forall x, y Q:
        dist_Q(x, y) = dist_Q(y, x)
    dist_Q(x, y) = abs(x - y)
    dist_Q(y, x) = abs(y - x)
    x - y = -(y - x)
    abs(x - y) = abs(-(y - x)) = abs(y - x)
    dist_Q(x, y) = abs(x - y) = abs(y - x) = dist_Q(y, x)

# Proposition 4.3.3(g): the triangle inequality follows from
# `x-z=(x-y)+(y-z)` and the triangle inequality for absolute value.

thm rational_distance_triangle_inequality:
    ? forall x, y, z Q:
        dist_Q(x, z) <= dist_Q(x, y) + dist_Q(y, z)
    dist_Q(x, z) = abs(x - z)
    dist_Q(x, y) = abs(x - y)
    dist_Q(y, z) = abs(y - z)
    x - z = (x - y) + (y - z)
    abs(x - z) = abs((x - y) + (y - z))
    abs((x - y) + (y - z)) <= abs(x - y) + abs(y - z)
    dist_Q(x, z) = abs(x - z) <= abs(x - y) + abs(y - z) = dist_Q(x, y) + dist_Q(y, z)

"""
Definition 4.3.4 (epsilon-closeness). Let epsilon be a positive rational
number. A rational y is epsilon-close to a rational x iff d(y,x) <= epsilon;
that is, their rational distance is bounded by the chosen tolerance.
"""

# Epsilon-closeness is approximate equality: the distance is bounded by a
# positive tolerance.

# The definition wording is: `y` is epsilon-close to `x` iff `d(y,x) <= epsilon`.
# Distance symmetry lets this predicate be used with either argument order.
# The builtin carrier `Q_pos` is the set of strictly positive rational numbers,
# so the binder `epsilon Q_pos` is the source assumption `epsilon > 0`.

prop is_close_in_Q(epsilon Q_pos, x, y Q):
    dist_Q(x, y) <= epsilon

"""
Remark 4.3.5. This definition is not standard in mathematics textbooks; we
will use it as "scaffolding" to construct the more important notions of limits
and Cauchy sequences later on.
"""

"""
Examples 4.3.6. The numbers 0.99 and 1.01 are 0.1-close, but not 0.01-close,
because d(0.99,1.01)=|0.99-1.01|=0.02 is larger than 0.01. The numbers 2 and
2 are epsilon-close for every positive epsilon.
"""

sketch:
    dist_Q(0.99, 1.01) = abs(0.99 - 1.01) = abs(-0.02) = 0.02
    0.02 <= 0.1
    $is_close_in_Q(0.1, 0.99, 1.01)
    0.02 > 0.01
    claim:
        ? not $is_close_in_Q(0.01, 0.99, 1.01)
        by contra:
            ? not $is_close_in_Q(0.01, 0.99, 1.01)
            impossible 0.02 <= 0.01
    forall epsilon Q_pos:
        dist_Q(2, 2) = abs(2 - 2) = 0
        0 <= epsilon
        $is_close_in_Q(epsilon, 2, 2)

"""
Proposition 4.3.7. Epsilon-closeness is reflexive, symmetric, and transitive
after adding errors. A bound remains true when the tolerance is enlarged;
addition, subtraction, multiplication, and intermediate points obey the
corresponding error estimates.
"""

# Proposition 4.3.7(a), reflexive direction: every rational is epsilon-close to itself.

thm rational_closeness_is_reflexive:
    ? forall epsilon Q_pos, x Q:
        $is_close_in_Q(epsilon, x, x)
    dist_Q(x, x) = abs(x - x) = 0
    0 <= epsilon
    by def $is_close_in_Q(epsilon, x, x)

# Relaxing the tolerance preserves closeness: a bound by `epsilon` is also a
# bound by any larger positive `epsilon_prime`.

forall epsilon, epsilon_prime Q_pos, x, y Q:
    $is_close_in_Q(epsilon, x, y)
    epsilon_prime > epsilon
    =>:
        $is_close_in_Q(epsilon_prime, x, y)

# Proposition 4.3.7(a), converse direction: if two rationals are epsilon-close
# for every positive epsilon, then they are equal.  The contradiction chooses
# the too-small epsilon `abs(x-y)/2`.

claim:
    ? forall x, y Q:
        forall epsilon Q_pos:
            $is_close_in_Q(epsilon, x, y)
        =>:
            x = y
    by contra:
        ? x = y
        abs(x - y) / 2 $in Q_pos
        $is_close_in_Q(abs(x - y) / 2, x, y)
        dist_Q(x, y) <= abs(x - y) / 2
        abs(x - y) = dist_Q(x, y) <= abs(x - y) / 2
        impossible abs(x - y) <= abs(x - y) / 2

# Proposition 4.3.7(b): epsilon-closeness is symmetric because distance is symmetric.

thm rational_closeness_is_symmetric:
    ? forall epsilon Q_pos, x, y Q:
        $is_close_in_Q(epsilon, x, y)
        =>:
            $is_close_in_Q(epsilon, y, x)
    dist_Q(y, x) = dist_Q(x, y) <= epsilon

# Proposition 4.3.7(c): closeness composes, with errors adding.

thm rational_closeness_is_transitive:
    ? forall epsilon, delta Q_pos, x, y, z Q:
        $is_close_in_Q(epsilon, x, y)
        $is_close_in_Q(delta, y, z)
        =>:
            $is_close_in_Q(epsilon + delta, x, z)
    by thm rational_distance_triangle_inequality(x, y, z)
    dist_Q(x, z) <= dist_Q(x, y) + dist_Q(y, z) <= epsilon + delta

# Proposition 4.3.7(d): addition and subtraction preserve closeness, with the
# two errors adding.

thm rational_closeness_preserved_by_addition_and_subtraction:
    ? forall epsilon, delta Q_pos, x, y, z, w Q:
        $is_close_in_Q(epsilon, x, y)
        $is_close_in_Q(delta, z, w)
        =>:
            $is_close_in_Q(epsilon + delta, x + z, y + w)
            $is_close_in_Q(epsilon + delta, x - z, y - w)
    dist_Q(x + z, y + w) = abs((x + z) - (y + w)) = abs((x - y) + (z - w)) <= abs(x - y) + abs(z - w) = dist_Q(x, y) + dist_Q(z, w) <= epsilon + delta
    dist_Q(x - z, y - w) = abs((x - z) - (y - w)) = abs((x - y) + (w - z)) <= abs(x - y) + abs(w - z) = dist_Q(x, y) + dist_Q(z, w) <= epsilon + delta

# Proposition 4.3.7(f): if two endpoints are epsilon-close to `x`, then every
# point between those endpoints is also epsilon-close to `x`.

thm rational_closeness_of_between_points:
    ? forall epsilon Q_pos, x, y, z, w Q:
        $is_close_in_Q(epsilon, y, x)
        $is_close_in_Q(epsilon, z, x)
        y <= w
        w <= z
        =>:
            $is_close_in_Q(epsilon, w, x)
    dist_Q(y, x) <= epsilon
    abs(y - x) = dist_Q(y, x) <= epsilon
    by thm rational_abs_upper_bound_gives_two_sided_bound(y - x, epsilon)
    -epsilon <= y - x
    dist_Q(z, x) <= epsilon
    abs(z - x) = dist_Q(z, x) <= epsilon
    by thm rational_abs_upper_bound_gives_two_sided_bound(z - x, epsilon)
    z - x <= epsilon
    -epsilon <= y - x <= w - x
    w - x <= z - x <= epsilon
    dist_Q(w, x) = abs(w - x) <= epsilon

thm rational_closeness_of_reverse_between_points:
    ? forall epsilon Q_pos, x, y, z, w Q:
        $is_close_in_Q(epsilon, y, x)
        $is_close_in_Q(epsilon, z, x)
        z <= w
        w <= y
        =>:
            $is_close_in_Q(epsilon, w, x)
    by thm rational_closeness_of_between_points(epsilon, x, z, y, w)

# Multiplication by a fixed rational scales the error by `abs(z)`: rewrite
# `(x*z)-(y*z)` as `(x-y)*z`, then use multiplicativity of absolute value.

thm rational_closeness_scaled_by_nonzero_factor:
    ? forall epsilon Q_pos, x, y, z Q:
        $is_close_in_Q(epsilon, x, y)
        z != 0
        =>:
            $is_close_in_Q(epsilon * abs(z), x * z, y * z)
    dist_Q(x * z, y * z) = abs(x * z - y * z) = abs((x - y) * z) = abs(x - y) * abs(z) = dist_Q(x, y) * abs(z) <= epsilon * abs(z)

# Source handling: Proposition 4.3.7 rewrites `xz-yw` as
# `(x-y)z + x(z-w) - (x-y)(z-w)` and applies the triangle inequality to the
# three error terms.
#
# proof_debt: The complete estimate verifies in isolation, but the current
# chapter context spends unbounded search time on this proof shape.  Keep only
# the final product-closeness interface unchecked until the calculation is
# refactored into smaller reusable estimates.

thm rational_closeness_of_products:
    ? forall epsilon, delta Q_pos, x, y, z, w Q:
        $is_close_in_Q(epsilon, x, y)
        $is_close_in_Q(delta, z, w)
        =>:
            $is_close_in_Q(epsilon * abs(z) + delta * abs(x) + epsilon * delta, x * z, y * w)
    trust $is_close_in_Q(epsilon * abs(z) + delta * abs(x) + epsilon * delta, x * z, y * w)

"""
Remark 4.3.8. It is often useful to think of the notion of "epsilon-close" as an approximate substitute for that of equality in analysis.
"""

"""
Definition 4.3.9. Exponentiation to a natural number.
"""

# Definition 4.3.9 recursively defines natural powers by `x^0=1` and
# `x^(n+1)=x^n*x`.

forall x Q:
    x^0 = 1

forall x Q, n N:
    x^(n + 1) = x^n * x

# Examples for Definition 4.3.9: small concrete natural powers.

sketch:
    2^3 = 8
    2^3 * 2^2 = 2^(3 + 2)
    (2 * 3)^2 = 2^2 * 3^2

"""
Proposition 4.3.10. Properties of exponentiation, I.
"""

# Proposition 4.3.10(a): natural-number exponents satisfy the three standard
# laws for products of powers, powers of powers, and powers of products.

forall x Q, n, m N:
    x^n * x^m = x^(n + m)

forall x Q, n, m N:
    (x^n)^m = x^(n * m)

forall x, y Q, n N:
    (x * y)^n = x^n * y^n

# Proposition 4.3.10(b): for positive `n`, `x^n=0` iff `x=0`.

forall x Q, n N_pos:
    x^n = 0
    =>:
        x = 0

forall x Q, n N_pos:
    x = 0
    =>:
        x^n = 0^n = 0

forall x Q, n N_pos:
    =>:
        x^n = 0
    <=>:
        x = 0

# Proposition 4.3.10(c), non-strict monotonicity for non-negative rationals.

forall x, y Q, n N_pos:
    x >= y
    y >= 0
    =>:
        x^n >= y^n
        y^n >= 0

# Proposition 4.3.10(c), strict monotonicity for positive natural exponents.

forall x, y Q, n N_pos:
    x > y
    y >= 0
    =>:
        x^n > y^n
        y^n >= 0

# Proposition 4.3.10(d): absolute value commutes with natural powers.

forall x Q, n N:
    abs(x^n) = abs(x)^n

"""
Definition 4.3.11. Exponentiation to a negative number.
"""

# Definition 4.3.11 defines negative powers as reciprocals of positive powers:
# for nonzero `x` and positive `n`, `x^(-n) = 1/x^n`.

forall x Q_nz, n N_pos:
    x^n != 0

forall x Q_nz, n N_pos:
    x^(-n) = 1 / x^n

"""
Proposition 4.3.12. Properties of exponentiation, II.
"""

# Proposition 4.3.12(a): the exponent laws extend to integer exponents when
# the rational base is nonzero.

forall x Q_nz, n, m Z:
    x^n * x^m = x^(n + m)

# A nonzero base has only nonzero integer powers; this supplies the
# nonzero inner base needed for the power-of-a-power law.

forall x Q_nz, n Z:
    x^n != 0

forall x Q_nz, n, m Z:
    (x^n)^m = x^(n * m)

forall x, y Q_nz, n Z:
    (x * y)^n = x^n * y^n


# Proposition 4.3.12(b): positive integer exponents preserve order on positive
# rationals; negative exponents reverse it.

forall x, y Q_pos, n Z:
    x >= y
    n > 0
    =>:
        x^n >= y^n
        y^n > 0

forall x, y Q_pos, n Z:
    x >= y
    n < 0
    =>:
        x^n > 0
        x^n <= y^n

# Proposition 4.3.12(c): a nonzero integer power is injective on positive
# rationals.

forall x, y Q_pos, n Z:
    n != 0
    x^n = y^n
    =>:
        x = y

# Proposition 4.3.12(d): absolute value commutes with integer powers of a
# nonzero rational.

forall x Q_nz, n Z:
    abs(x^n) = abs(x)^n

# Source handling: Proposition 4.4.1 uses the standard fact that every rational
# admits an integer numerator and a positive natural denominator.
#
# proof_debt: The direct construction replaces a nonzero denominator by its
# absolute value and negates the numerator when needed.  That proof verifies in
# a focused context but remains too search-heavy in the ordered chapter.

thm rational_has_positive_denominator_representation:
    ? forall x Q:
        exist a0 Z, b0 N_pos st {x = a0 / b0}
    trust exist a0 Z, b0 N_pos st {x = a0 / b0}

"""
Proposition 4.4.1 (Interspersing of integers by rationals). Every rational x
lies in a unique interval [n, n+1), and some natural number is bigger than x.
"""

# Proposition 4.4.1 says each rational lies in a unit interval `[n,n+1)`
# with integer endpoint `n`; it also implies a natural number lies above it.

# First prove the interval statement for an explicit quotient `a / b`.
# The remainder facts give `a = n*b + r` with `0 <= r < b`; dividing by the
# positive denominator gives `n <= a/b < n+1`.
# Select the unique Euclidean quotient `n` in `a = b*n + a%b`; later chapters
# refer to this source-owned function as `chap4::integer_quotient`.

have fn integer_quotient by exist!:
    ? forall a Z, d N_pos:
        exist! q Z st {a = d * q + a % d}

thm rational_quotient_integer_interval_exists:
    ? forall a Z, b N_pos:
        exist m Z st {m <= a / b, a / b < m + 1}
    have n Z = integer_quotient(a, b)
    a = b * integer_quotient(a, b) + a % b = b * n + a % b
    0 <= a % b
    a % b < b
    b * n <= b * n + a % b = a
    n <= a / b
    a = b * n + a % b < b * n + b = b * (n + 1)
    a / b < (b * (n + 1)) / b = n + 1
    witness exist m Z st {m <= a / b, a / b < m + 1} from n

# Then use the built-in meaning of rational number: every rational can be
# represented as an integer divided by a positive natural number.

thm rational_integer_interval_exists:
    ? forall x Q:
        exist n Z st {n <= x, x < n + 1}
    by thm rational_has_positive_denominator_representation(x)
    obtain a, b from exist a Z, b N_pos st {x = a / b}
    by thm rational_quotient_integer_interval_exists(a, b)
    obtain m from exist m Z st {m <= a / b, a / b < m + 1}
    witness exist n Z st {n <= x, x < n + 1} from m

# The integer endpoint is unique: two intervals `[n,n+1)` and `[m,m+1)`
# containing the same rational must have `n=m`.

thm rational_integer_interval_is_unique:
    ? forall x Q, n, m Z:
        n <= x
        x < n + 1
        m <= x
        x < m + 1
        =>:
            n = m
    claim:
        ? m <= n
        m <= n or m > n
        by cases:
            ? m <= n
            case m <= n:
                m <= n
            case m > n:
                n + 1 <= m
                x < n + 1 <= m
                x < m
                impossible m <= x
    claim:
        ? n <= m
        n <= m or n > m
        by cases:
            ? n <= m
            case n <= m:
                n <= m
            case n > m:
                m + 1 <= n
                x < m + 1 <= n
                x < n
                impossible n <= x
    n = m

thm natural_upper_bound_for_rational:
    ? forall x Q:
        exist n N st {n > x}
    by thm rational_integer_interval_exists(x)
    obtain m from exist m Z st {m <= x, x < m + 1}
    m >= 0 or m < 0
    by cases:
        ? exist n N st {n > x}
        case m >= 0:
            have n N = m + 1
            witness exist k N st {k > x} from n
        case m < 0:
            m + 1 <= 0
            x < m + 1 <= 0 < 1
            witness exist n N st {n > x} from 1

"""
Remark 4.4.2. The integer n with n <= x < n + 1 is the integer part of x,
usually written floor(x).
"""

"""
Proposition 4.4.3 (Interspersing of rationals by rationals). If x < y, then
there exists z with x < z < y.
"""

# The proof chooses the midpoint `(x+y)/2`, which lies strictly between `x` and `y`.

thm rationals_are_dense:
    ? forall x, y Q:
        x < y
        =>:
            exist z Q st {x < z < y}
    2 * x = x + x < x + y
    x + y < y + y = 2 * y
    x = (2 * x) / 2 < (x + y) / 2
    (x + y) / 2 < (2 * y) / 2 = y
    witness exist z Q st {x < z < y} from (x + y) / 2


"""
Proposition 4.4.4. There is no rational x such that x^2 = 2.
"""

# The proof idea is the classical parity contradiction.  Write a rational
# square root as a reduced fraction, show the numerator is even, then show the
# denominator is even, contradicting reducedness.
# A reduced numerator and positive denominator exist for every rational.  The
# residue cases modulo two show that they cannot both be even, since otherwise
# two would be a common positive divisor of a reduced fraction.

# A square divisible by two has even base.  This is the source's residue
# argument, expressed through the Euclidean quotient/remainder primitives.
thm integer_square_multiple_of_two_has_even_base:
    ? forall p, r Z:
        p^2 = 2 * r
        =>:
            p % 2 = 0
    0 < 2
    p^2 = 2 * r + 0
    p^2 % 2 = 0
    p % 2 = 0 or p % 2 = 1
    by cases:
        ? p % 2 = 0
        case p % 2 = 0:
            p % 2 = 0
        case p % 2 = 1:
            p^2 % 2 = ((p % 2)^2) % 2 = (1^2) % 2 = 1
            impossible p^2 % 2 = 0

thm rational_reduced_fraction_parity_witness:
    ? forall x Q:
        exist p Z, q N_pos st {x = p / q, p % 2 != 0 or q % 2 != 0}
    exist p Z, q N_pos st {x = p / q, forall! k N_pos: p % k = 0 and q % k = 0 => {k = 1}}
    obtain p, q from exist p Z, q N_pos st {x = p / q, forall! k N_pos: p % k = 0 and q % k = 0 => {k = 1}}
    claim:
        ? p % 2 != 0 or q % 2 != 0
        p % 2 = 0 or p % 2 = 1
        by cases:
            ? p % 2 != 0 or q % 2 != 0
            case p % 2 = 0:
                q % 2 = 0 or q % 2 = 1
                by cases:
                    ? p % 2 != 0 or q % 2 != 0
                    case q % 2 = 0:
                        2 = 1
                        impossible 2 = 1
                    case q % 2 = 1:
                        q % 2 != 0
            case p % 2 = 1:
                p % 2 != 0
    witness exist p0 Z, q0 N_pos st {x = p0 / q0, p0 % 2 != 0 or q0 % 2 != 0} from p, q

thm rational_square_not_two:
    ? forall x Q:
        x^2 != 2
    by contra x^2 != 2:
        by thm rational_reduced_fraction_parity_witness(x)
        obtain p, q from exist p Z, q N_pos st {x = p / q, p % 2 != 0 or q % 2 != 0}
        (p / q)^2 = x^2 = 2
        p^2 / q^2 = (p / q)^2 = 2
        p^2 = (p^2 / q^2) * q^2 = 2 * q^2
        by thm integer_square_multiple_of_two_has_even_base(p, q^2)
        have s Z = integer_quotient(p, 2)
        p = 2 * integer_quotient(p, 2) + p % 2 = 2 * s + p % 2 = 2 * s
        2 * q^2 = p^2 = (2 * s)^2 = 4 * s^2
        q^2 = (2 * q^2) / 2 = (4 * s^2) / 2 = 2 * s^2
        by thm integer_square_multiple_of_two_has_even_base(q, s^2)
        by cases:
            ? q % 2 != 0
            case p % 2 != 0:
                impossible p % 2 = 0
            case q % 2 != 0:
                q % 2 != 0
        impossible q % 2 = 0

"""
Proposition 4.4.5. For every rational epsilon > 0, there exists a
non-negative rational x such that x^2 < 2 < (x+epsilon)^2.
"""

# Although `sqrt(2)` is not rational, rationals can straddle the gap at
# arbitrarily small positive width.

# This predicate records the condition on a proposed witness.  It is a
# property, not a selected function: Proposition 4.4.5 proves existence but
# does not choose a canonical rational `x`.

prop is_rational_sqrt_two_gap_witness(epsilon Q_pos, x Q):
    x >= 0
    x^2 < 2
    2 < (x + epsilon)^2

# If no gap witness exists, adding `epsilon` to any non-negative rational whose
# square is below two must stay below two.  Equality is excluded by
# `rational_square_not_two`.

thm rational_sqrt_two_no_gap_step:
    ? forall epsilon Q_pos, y Q:
        not exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
        y >= 0
        y^2 < 2
        =>:
            (y + epsilon)^2 < 2
    claim:
        ? not 2 < (y + epsilon)^2
        by contra:
            ? not 2 < (y + epsilon)^2
            by def $is_rational_sqrt_two_gap_witness(epsilon, y)
            impossible not $is_rational_sqrt_two_gap_witness(epsilon, y)
    by thm rational_square_not_two(y + epsilon)
    (y + epsilon)^2 != 2
    (y + epsilon)^2 < 2 or (y + epsilon)^2 = 2 or (y + epsilon)^2 > 2
    by cases:
        ? (y + epsilon)^2 < 2
        case (y + epsilon)^2 < 2:
            (y + epsilon)^2 < 2
        case (y + epsilon)^2 = 2:
            impossible (y + epsilon)^2 != 2
        case (y + epsilon)^2 > 2:
            impossible not 2 < (y + epsilon)^2

# Under the same no-gap assumption, induction keeps every natural multiple of
# `epsilon` below the square threshold.

thm rational_sqrt_two_no_gap_forces_each_multiple_below_two:
    ? forall epsilon Q_pos, n N:
        not exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
        =>:
            (n * epsilon)^2 < 2
    by induc n from 0:
        ? (n * epsilon)^2 < 2
        ? from n = 0:
            (0 * epsilon)^2 = 0 < 2
        ? induc:
            n * epsilon >= 0
            by thm rational_sqrt_two_no_gap_step(epsilon, n * epsilon)
            (n * epsilon + epsilon)^2 < 2
            (n + 1) * epsilon = n * epsilon + epsilon
            ((n + 1) * epsilon)^2 = (n * epsilon + epsilon)^2 < 2

thm rational_sqrt_two_gap:
    ? forall epsilon Q_pos:
        exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
    by contra:
        ? exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
        by thm natural_upper_bound_for_rational(2 / epsilon)
        obtain n from exist n N st {n > 2 / epsilon}
        by thm rational_sqrt_two_no_gap_forces_each_multiple_below_two(epsilon, n)
        n * epsilon > (2 / epsilon) * epsilon = 2
        (n * epsilon)^2 > 2^2 = 4 > 2
        impossible (n * epsilon)^2 < 2

"""
Example 4.4.6. For epsilon = 0.001 one may take x = 1.414, since x^2 is below
2 and (x + epsilon)^2 is above 2.
"""

# This numerical example illustrates Proposition 4.4.5: Q has no sqrt(2),
# but rational numbers can straddle the gap at arbitrarily small positive width.

sketch:
    1.414^2 = 1.999396
    1.999396 < 2
    (1.414 + 0.001)^2 = 2.002225
    2 < 2.002225
