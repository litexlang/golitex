# Chapter 3. Integer Functions.
# The chapter develops floor, ceiling, modular arithmetic, and finite sums
# involving integer-valued rounding operations.

# Section 3.1. Floors and Ceilings.
# Equation (3.1). Litex provides floor and ceiling as native callable
# functions R -> Z. Their characteristic inequalities and integer fixed-point
# laws are builtin facts, so the textbook interface needs no wrapper.
floor(2.71828) = 2
ceil(2.71828) = 3
floor(-2.71828) = -3
ceil(-2.71828) = -2

forall x R:
    floor(x) $in Z
    ceil(x) $in Z
    floor(x) <= x
    x < floor(x) + 1
    ceil(x) - 1 < x
    x <= ceil(x)

forall n Z:
    floor(n) = n
    ceil(n) = n

# Equation (3.2). Iverson's noninteger bracket is a checked 0/1 function.
# In the noninteger case, the two rounded integers are adjacent: native bounds
# and integer adjacency squeeze ceil(x) between floor(x)+1 on both sides.
have fn noninteger_indicator_32(x R) N by cases:
    case x $in Z: 0
    case not x $in Z: 1

thm floor_ceil_gap_32:
    ? forall x R:
        ceil(x) - floor(x) = noninteger_indicator_32(x)
    by cases:
        ? ceil(x) - floor(x) = noninteger_indicator_32(x)
        case x $in Z:
            floor(x) = x
            ceil(x) = x
            noninteger_indicator_32(x) = 0
            ceil(x) - floor(x) = x - x = 0 = noninteger_indicator_32(x)
        case not x $in Z:
            floor(x) $in Z
            ceil(x) $in Z
            floor(x) + 1 $in Z
            floor(x) <= x
            floor(x) != x
            claim:
                ? floor(x) < x
                by contra:
                    ? floor(x) < x
                    x <= floor(x)
                    floor(x) = x
                    impossible floor(x) != x
            floor(x) < x <= ceil(x)
            floor(x) + 1 < ceil(x) + 1
            floor(x) + 1 <= ceil(x)
            ceil(x) - 1 < x < floor(x) + 1
            ceil(x) = (ceil(x) - 1) + 1 < (floor(x) + 1) + 1
            ceil(x) <= floor(x) + 1
            ceil(x) = floor(x) + 1
            noninteger_indicator_32(x) = 1
            ceil(x) - floor(x) = floor(x) + 1 - floor(x) = 1 = noninteger_indicator_32(x)

noninteger_indicator_32(3) = 0
noninteger_indicator_32(2.75) = 1
ceil(2.75) - floor(2.75) = 3 - 2 = 1 = noninteger_indicator_32(2.75)

# Equation (3.3). The outer unit bounds are explicit algebraic rearrangements
# of the native characteristic inequalities.
thm rounding_unit_bounds_33:
    ? forall x R:
        x - 1 < floor(x)
        floor(x) <= x
        x <= ceil(x)
        ceil(x) < x + 1
    floor(x) <= x
    x < floor(x) + 1
    ceil(x) - 1 < x
    x <= ceil(x)
    x - 1 < (floor(x) + 1) - 1 = floor(x)
    ceil(x) = (ceil(x) - 1) + 1 < x + 1

# Equation (3.5a). The forward direction is exactly the native floor bounds.
# Conversely, integer adjacency turns the two strict successor bounds into
# opposite weak bounds between floor(x) and n.
thm floor_value_gives_bounds_35a:
    ? forall x R, n Z:
        floor(x) = n
        =>:
            n <= x
            x < n + 1
    floor(x) <= x
    x < floor(x) + 1
    n <= x
    x < n + 1

thm floor_bounds_give_value_35a:
    ? forall x R, n Z:
        n <= x
        x < n + 1
        =>:
            floor(x) = n
    floor(x) $in Z
    floor(x) <= x < n + 1
    floor(x) <= n
    n <= x < floor(x) + 1
    n <= floor(x)
    floor(x) = n

forall x R, n Z:
    =>:
        floor(x) = n
    <=>:
        n <= x
        x < n + 1

# Equation (3.5b) is the same floor interval with n placed in the middle.
thm floor_value_gives_middle_bounds_35b:
    ? forall x R, n Z:
        floor(x) = n
        =>:
            x - 1 < n
            n <= x
    by thm floor_value_gives_bounds_35a(x, n)
    x - 1 < (n + 1) - 1 = n

thm floor_middle_bounds_give_value_35b:
    ? forall x R, n Z:
        x - 1 < n
        n <= x
        =>:
            floor(x) = n
    x = (x - 1) + 1 < n + 1
    by thm floor_bounds_give_value_35a(x, n)

forall x R, n Z:
    =>:
        floor(x) = n
    <=>:
        x - 1 < n
        n <= x

# Equations (3.5c)--(3.5d). The ceiling characterizations are symmetric.
thm ceil_value_gives_bounds_35c:
    ? forall x R, n Z:
        ceil(x) = n
        =>:
            n - 1 < x
            x <= n
    ceil(x) - 1 < x
    x <= ceil(x)
    n - 1 < x
    x <= n

thm ceil_bounds_give_value_35c:
    ? forall x R, n Z:
        n - 1 < x
        x <= n
        =>:
            ceil(x) = n
    ceil(x) $in Z
    ceil(x) - 1 < x <= n
    ceil(x) = (ceil(x) - 1) + 1 < n + 1
    ceil(x) <= n
    n - 1 < x <= ceil(x)
    n = (n - 1) + 1 < ceil(x) + 1
    n <= ceil(x)
    ceil(x) = n

forall x R, n Z:
    =>:
        ceil(x) = n
    <=>:
        n - 1 < x
        x <= n

thm ceil_value_gives_middle_bounds_35d:
    ? forall x R, n Z:
        ceil(x) = n
        =>:
            x <= n
            n < x + 1
    by thm ceil_value_gives_bounds_35c(x, n)
    n = (n - 1) + 1 < x + 1

thm ceil_middle_bounds_give_value_35d:
    ? forall x R, n Z:
        x <= n
        n < x + 1
        =>:
            ceil(x) = n
    n - 1 < (x + 1) - 1 = x
    by thm ceil_bounds_give_value_35c(x, n)

forall x R, n Z:
    =>:
        ceil(x) = n
    <=>:
        x <= n
        n < x + 1

# Equation (3.4) appeared just before the characterization rules in the
# source. Its checked proof uses (3.5a), so the declarations are placed here.
# Each reflection fits the negated candidate into the opposite rounding
# characterization, avoiding a symbolic sign rearrangement of an equality.
thm floor_negation_34:
    ? forall x R:
        floor(-x) = -ceil(x)
    x <= ceil(x)
    ceil(x) - 1 < x
    -ceil(x) <= -x
    -x < -(ceil(x) - 1) = -ceil(x) + 1
    by thm floor_bounds_give_value_35a(-x, -ceil(x))

thm ceil_negation_34:
    ? forall x R:
        ceil(-x) = -floor(x)
    floor(x) <= x
    x < floor(x) + 1
    -x <= -floor(x)
    -floor(x) - 1 = -(floor(x) + 1) < -x
    by thm ceil_bounds_give_value_35c(-x, -floor(x))

# Equation (3.6). Translating the native characteristic intervals by an
# integer gives the two shifted rounding values.
thm floor_integer_shift_36:
    ? forall x R, n Z:
        floor(x + n) = floor(x) + n
    floor(x) <= x
    x < floor(x) + 1
    floor(x) + n <= x + n
    x + n < (floor(x) + 1) + n = floor(x) + n + 1
    by thm floor_bounds_give_value_35a(x + n, floor(x) + n)

thm ceil_integer_shift_36:
    ? forall x R, n Z:
        ceil(x + n) = ceil(x) + n
    ceil(x) - 1 < x
    x <= ceil(x)
    ceil(x) + n - 1 = (ceil(x) - 1) + n < x + n
    x + n <= ceil(x) + n
    by thm ceil_bounds_give_value_35c(x + n, ceil(x) + n)

# Equation (3.7). Each equivalence has one direction from a native rounding
# bound and one direction from integer adjacency. The explicit direction
# theorems let the final source-facing iff facts remain checked and readable.
thm x_lt_integer_gives_floor_lt_37a:
    ? forall x R, n Z:
        x < n
        =>:
            floor(x) < n
    floor(x) <= x < n

thm floor_lt_integer_gives_x_lt_37a:
    ? forall x R, n Z:
        floor(x) < n
        =>:
            x < n
    floor(x) $in Z
    x < floor(x) + 1
    floor(x) + 1 < n + 1
    floor(x) + 1 <= n
    x < floor(x) + 1 <= n

forall x R, n Z:
    =>:
        x < n
    <=>:
        floor(x) < n

thm integer_lt_x_gives_integer_lt_ceil_37b:
    ? forall x R, n Z:
        n < x
        =>:
            n < ceil(x)
    n < x <= ceil(x)

thm integer_lt_ceil_gives_integer_lt_x_37b:
    ? forall x R, n Z:
        n < ceil(x)
        =>:
            n < x
    ceil(x) $in Z
    ceil(x) - 1 < x
    n + 1 < ceil(x) + 1
    n + 1 <= ceil(x)
    n = (n + 1) - 1 <= ceil(x) - 1 < x

forall x R, n Z:
    =>:
        n < x
    <=>:
        n < ceil(x)

thm x_le_integer_gives_ceil_le_37c:
    ? forall x R, n Z:
        x <= n
        =>:
            ceil(x) <= n
    ceil(x) $in Z
    ceil(x) - 1 < x <= n
    ceil(x) = (ceil(x) - 1) + 1 < n + 1
    ceil(x) <= n

thm ceil_le_integer_gives_x_le_37c:
    ? forall x R, n Z:
        ceil(x) <= n
        =>:
            x <= n
    x <= ceil(x) <= n

forall x R, n Z:
    =>:
        x <= n
    <=>:
        ceil(x) <= n

thm integer_le_x_gives_integer_le_floor_37d:
    ? forall x R, n Z:
        n <= x
        =>:
            n <= floor(x)
    floor(x) $in Z
    n <= x < floor(x) + 1
    n <= floor(x)

thm integer_le_floor_gives_integer_le_x_37d:
    ? forall x R, n Z:
        n <= floor(x)
        =>:
            n <= x
    n <= floor(x) <= x

forall x R, n Z:
    =>:
        n <= x
    <=>:
        n <= floor(x)

# Equation (3.8). Fractional part is a formula-defined callable function. Its
# half-open unit bounds and the decomposition x=floor(x)+{x} are checked.
have fn fractional_part(x R) R = x - floor(x)

claim:
    ? forall x R:
        0 <= fractional_part(x)
        fractional_part(x) < 1
        x = floor(x) + fractional_part(x)
    floor(x) <= x
    x < floor(x) + 1
    fractional_part(x) = x - floor(x)
    0 <= x - floor(x)
    0 <= fractional_part(x)
    x - floor(x) < (floor(x) + 1) - floor(x) = 1
    fractional_part(x) < 1
    x = floor(x) + (x - floor(x)) = floor(x) + fractional_part(x)

fractional_part(2.75) = 2.75 - floor(2.75) = 0.75
fractional_part(-2.75) = -2.75 - floor(-2.75) = 0.25

# Section 3.2. Floor/Ceiling Applications.
# Equation (3.9). A positive integer n has floor(log_2(n))+1 binary digits.
# At n=1 the formula is 1; for n>1, the logarithm sign rule and the floor
# comparison theorem prove the formula remains positive. Unique selection
# therefore keeps the source's N+ -> N+ interface without trust.
have fn binary_digit_length_39 by exist!:
    ? forall n N+:
        exist! value N+ st {value = floor(log(2, n)) + 1}
    have count Z = floor(log(2, n)) + 1
    claim:
        ? count >= 1
        by cases:
            ? count >= 1
            case n = 1:
                count = floor(log(2, n)) + 1 = floor(log(2, 1)) + 1 = floor(0) + 1 = 1
            case n > 1:
                0 < log(2, n)
                by thm integer_le_x_gives_integer_le_floor_37d(log(2, n), 0)
                1 <= floor(log(2, n)) + 1 = count
    count $in N+
    witness exist value N+ st {value = floor(log(2, n)) + 1} from count
    forall value1, value2 N+:
        value1 = floor(log(2, n)) + 1
        value2 = floor(log(2, n)) + 1
        =>:
            value1 = floor(log(2, n)) + 1 = value2

log(2, 8) = 3
binary_digit_length_39(8) = floor(log(2, 8)) + 1 = floor(3) + 1 = 4

# The other part of (3.9) says that floor and ceiling commute with square root
# on nonnegative inputs. Both identities are checked by squaring the relevant
# integer bound, transferring it through floor or ceiling, and taking square
# roots again with explicit nonnegative radicands.
thm ceil_nonnegative_from_nonnegative_39:
    ? forall x R:
        x >= 0
        =>:
            ceil(x) >= 0
    x <= ceil(x)
    0 <= ceil(x)

thm floor_sqrt_commutes_39:
    ? forall x R:
        x >= 0
        =>:
            floor(sqrt(floor(x))) = floor(sqrt(x))
    0 <= x
    sqrt(x) >= 0
    by thm integer_le_x_gives_integer_le_floor_37d(sqrt(x), 0)
    0 <= floor(sqrt(x))
    floor(sqrt(x)) <= sqrt(x)
    floor(sqrt(x))^2 <= sqrt(x)^2 = x
    floor(sqrt(x))^2 $in Z
    by thm integer_le_x_gives_integer_le_floor_37d(x, floor(sqrt(x))^2)
    floor(sqrt(x))^2 <= floor(x)
    by thm integer_le_x_gives_integer_le_floor_37d(x, 0)
    0 <= floor(x)
    floor(sqrt(x))^2 >= 0
    sqrt(floor(sqrt(x))^2) <= sqrt(floor(x))
    sqrt(floor(sqrt(x))^2) = floor(sqrt(x))
    floor(sqrt(x)) <= sqrt(floor(x))
    floor(x) <= x
    sqrt(floor(x)) <= sqrt(x)
    sqrt(x) < floor(sqrt(x)) + 1
    floor(sqrt(x)) <= sqrt(floor(x)) < floor(sqrt(x)) + 1
    by thm floor_bounds_give_value_35a(sqrt(floor(x)), floor(sqrt(x)))

thm ceil_sqrt_commutes_39:
    ? forall x R:
        x >= 0
        =>:
            ceil(sqrt(ceil(x))) = ceil(sqrt(x))
    0 <= x
    sqrt(x) >= 0
    by thm ceil_nonnegative_from_nonnegative_39(sqrt(x))
    0 <= ceil(sqrt(x))
    sqrt(x) <= ceil(sqrt(x))
    x = sqrt(x)^2 <= ceil(sqrt(x))^2
    ceil(sqrt(x))^2 $in Z
    by thm x_le_integer_gives_ceil_le_37c(x, ceil(sqrt(x))^2)
    ceil(x) <= ceil(sqrt(x))^2
    by thm ceil_nonnegative_from_nonnegative_39(x)
    0 <= ceil(x)
    ceil(sqrt(x))^2 >= 0
    sqrt(ceil(x)) <= sqrt(ceil(sqrt(x))^2)
    sqrt(ceil(sqrt(x))^2) = ceil(sqrt(x))
    sqrt(ceil(x)) <= ceil(sqrt(x))
    x <= ceil(x)
    sqrt(x) <= sqrt(ceil(x))
    ceil(sqrt(x)) - 1 < sqrt(x)
    ceil(sqrt(x)) - 1 < sqrt(x) <= sqrt(ceil(x))
    by thm ceil_bounds_give_value_35c(sqrt(ceil(x)), ceil(sqrt(x)))

floor(sqrt(floor(9))) = floor(sqrt(9)) = floor(3) = 3
ceil(sqrt(ceil(9))) = ceil(sqrt(9)) = ceil(3) = 3

# Equation (3.10). The source assumes a continuous strictly increasing map
# whose integer outputs have integer preimages. The proof uses continuity only
# through the following intermediate-value witness, so that dependency is
# stated directly instead of introducing an unrelated analysis hierarchy. If
# the rounded output lay strictly between the endpoint images, that witness
# would be an integer inside a one-unit rounding interval and hence its endpoint.
prop is_rounding_compatible_map_310(f fn(rounding_input_310 R) R):
    forall a, b R:
        a < b
        =>:
            f(a) < f(b)
    forall y R:
        f(y) $in Z
        =>:
            y $in Z
    forall a, b, t R:
        a <= b
        f(a) <= t
        t <= f(b)
        =>:
            exist y R st {a <= y, y <= b, f(y) = t}

thm rounding_compatible_map_commutes_310:
    ? forall f fn(rounding_theorem_input_310 R) R, x R:
        $is_rounding_compatible_map_310(f)
        =>:
            floor(f(x)) = floor(f(floor(x)))
            ceil(f(x)) = ceil(f(ceil(x)))
    floor(x) <= x
    claim:
        ? f(floor(x)) <= f(x)
        by cases:
            ? f(floor(x)) <= f(x)
            case floor(x) = x:
                f(floor(x)) = f(x)
            case floor(x) < x:
                f(floor(x)) < f(x)
    floor(f(floor(x))) <= f(floor(x)) <= f(x)
    by thm integer_le_x_gives_integer_le_floor_37d(f(x), floor(f(floor(x))))
    claim:
        ? floor(f(x)) <= f(floor(x))
        by contra:
            ? floor(f(x)) <= f(floor(x))
            f(floor(x)) < floor(f(x)) <= f(x)
            exist y R st {floor(x) <= y, y <= x, f(y) = floor(f(x))}
            obtain y from exist y R st {floor(x) <= y, y <= x, f(y) = floor(f(x))}
            floor(f(x)) $in Z
            f(y) = floor(f(x))
            f(y) $in Z
            y $in Z
            x < floor(x) + 1 <= y + 1
            by thm floor_bounds_give_value_35a(x, y)
            f(floor(x)) = f(y) = floor(f(x))
            impossible f(floor(x)) < floor(f(x))
    by thm integer_le_x_gives_integer_le_floor_37d(f(floor(x)), floor(f(x)))
    floor(f(x)) = floor(f(floor(x)))
    x <= ceil(x)
    claim:
        ? f(x) <= f(ceil(x))
        by cases:
            ? f(x) <= f(ceil(x))
            case x = ceil(x):
                f(x) = f(ceil(x))
            case x < ceil(x):
                f(x) < f(ceil(x))
    f(x) <= f(ceil(x)) <= ceil(f(ceil(x)))
    by thm x_le_integer_gives_ceil_le_37c(f(x), ceil(f(ceil(x))))
    claim:
        ? f(ceil(x)) <= ceil(f(x))
        by contra:
            ? f(ceil(x)) <= ceil(f(x))
            f(x) <= ceil(f(x)) < f(ceil(x))
            exist y R st {x <= y, y <= ceil(x), f(y) = ceil(f(x))}
            obtain y from exist y R st {x <= y, y <= ceil(x), f(y) = ceil(f(x))}
            ceil(f(x)) $in Z
            f(y) = ceil(f(x))
            f(y) $in Z
            y $in Z
            y - 1 <= ceil(x) - 1 < x
            by thm ceil_bounds_give_value_35c(x, y)
            f(ceil(x)) = f(y) = ceil(f(x))
            impossible ceil(f(x)) < f(ceil(x))
    by thm x_le_integer_gives_ceil_le_37c(f(ceil(x)), ceil(f(x)))
    ceil(f(x)) = ceil(f(ceil(x)))

# Equation (3.11). Positive integer scaling can absorb the inner rounding.
thm floor_nested_quotient_311:
    ? forall x R, m Z, n N+:
        floor((x + m) / n) = floor((floor(x) + m) / n)
    floor(x) $in Z
    floor((floor(x) + m) / n) $in Z
    n > 0
    floor((floor(x) + m) / n) <= (floor(x) + m) / n
    (floor(x) + m) / n < floor((floor(x) + m) / n) + 1
    n * floor((floor(x) + m) / n) <= n * ((floor(x) + m) / n)
    n * ((floor(x) + m) / n) = floor(x) + m
    n * floor((floor(x) + m) / n) <= floor(x) + m
    n * ((floor(x) + m) / n) < n * (floor((floor(x) + m) / n) + 1)
    floor(x) + m < n * (floor((floor(x) + m) / n) + 1)
    floor(x) + m $in Z
    n * (floor((floor(x) + m) / n) + 1) $in Z
    floor(x) + m + 1 <= n * (floor((floor(x) + m) / n) + 1)
    floor(x) <= x
    x < floor(x) + 1
    floor(x) + m <= x + m
    x + m < (floor(x) + 1) + m = floor(x) + m + 1
    n * floor((floor(x) + m) / n) <= floor(x) + m <= x + m
    x + m < floor(x) + m + 1 <= n * (floor((floor(x) + m) / n) + 1)
    floor((floor(x) + m) / n) <= (x + m) / n
    (x + m) / n < (n * (floor((floor(x) + m) / n) + 1)) / n = floor((floor(x) + m) / n) + 1
    by thm floor_bounds_give_value_35a((x + m) / n, floor((floor(x) + m) / n))

thm ceil_nested_quotient_311:
    ? forall x R, m Z, n N+:
        ceil((x + m) / n) = ceil((ceil(x) + m) / n)
    ceil(x) $in Z
    ceil((ceil(x) + m) / n) $in Z
    n > 0
    ceil((ceil(x) + m) / n) - 1 < (ceil(x) + m) / n
    (ceil(x) + m) / n <= ceil((ceil(x) + m) / n)
    n * (ceil((ceil(x) + m) / n) - 1) < n * ((ceil(x) + m) / n)
    n * ((ceil(x) + m) / n) = ceil(x) + m
    n * (ceil((ceil(x) + m) / n) - 1) < ceil(x) + m
    n * (ceil((ceil(x) + m) / n) - 1) $in Z
    ceil(x) + m $in Z
    n * (ceil((ceil(x) + m) / n) - 1) + 1 <= ceil(x) + m
    n * ((ceil(x) + m) / n) <= n * ceil((ceil(x) + m) / n)
    ceil(x) + m <= n * ceil((ceil(x) + m) / n)
    ceil(x) - 1 < x
    x <= ceil(x)
    n * (ceil((ceil(x) + m) / n) - 1) <= ceil(x) + m - 1
    (ceil(x) - 1) + m < x + m
    (ceil(x) - 1) + m = ceil(x) + m - 1
    ceil(x) + m - 1 < x + m
    n * (ceil((ceil(x) + m) / n) - 1) < x + m
    x + m <= ceil(x) + m <= n * ceil((ceil(x) + m) / n)
    ceil((ceil(x) + m) / n) - 1 = (n * (ceil((ceil(x) + m) / n) - 1)) / n < (x + m) / n
    (x + m) / n <= (n * ceil((ceil(x) + m) / n)) / n = ceil((ceil(x) + m) / n)
    by thm ceil_bounds_give_value_35c((x + m) / n, ceil((ceil(x) + m) / n))

floor((3.5 + 1) / 2) = 2
floor((floor(3.5) + 1) / 2) = 2
ceil((3.5 + 1) / 2) = 3
ceil((ceil(3.5) + 1) / 2) = 3

# Equation (3.12). Each endpoint convention defines a canonical N-valued
# count. The floor/ceiling comparison laws prove the source formula is
# nonnegative; unique selection then preserves both the count carrier and the
# callable formula without weakening the result to Z.
have fn closed_integer_count_312 by exist!:
    ? forall alpha, beta R:
        alpha <= beta
        =>:
            exist! value N st {value = floor(beta) - ceil(alpha) + 1}
    alpha <= beta < floor(beta) + 1
    by thm x_le_integer_gives_ceil_le_37c(alpha, floor(beta) + 1)
    have count Z = floor(beta) - ceil(alpha) + 1
    0 <= (floor(beta) + 1) - ceil(alpha) = floor(beta) - ceil(alpha) + 1 = count
    count $in N
    witness exist value N st {value = floor(beta) - ceil(alpha) + 1} from count
    forall value1, value2 N:
        value1 = floor(beta) - ceil(alpha) + 1
        value2 = floor(beta) - ceil(alpha) + 1
        =>:
            value1 = floor(beta) - ceil(alpha) + 1 = value2

have fn left_half_open_integer_count_312 by exist!:
    ? forall alpha, beta R:
        alpha <= beta
        =>:
            exist! value N st {value = ceil(beta) - ceil(alpha)}
    alpha <= beta <= ceil(beta)
    by thm x_le_integer_gives_ceil_le_37c(alpha, ceil(beta))
    have count Z = ceil(beta) - ceil(alpha)
    0 <= ceil(beta) - ceil(alpha) = count
    count $in N
    witness exist value N st {value = ceil(beta) - ceil(alpha)} from count
    forall value1, value2 N:
        value1 = ceil(beta) - ceil(alpha)
        value2 = ceil(beta) - ceil(alpha)
        =>:
            value1 = ceil(beta) - ceil(alpha) = value2

have fn right_half_open_integer_count_312 by exist!:
    ? forall alpha, beta R:
        alpha <= beta
        =>:
            exist! value N st {value = floor(beta) - floor(alpha)}
    floor(alpha) <= alpha <= beta
    by thm integer_le_x_gives_integer_le_floor_37d(beta, floor(alpha))
    have count Z = floor(beta) - floor(alpha)
    0 <= floor(beta) - floor(alpha) = count
    count $in N
    witness exist value N st {value = floor(beta) - floor(alpha)} from count
    forall value1, value2 N:
        value1 = floor(beta) - floor(alpha)
        value2 = floor(beta) - floor(alpha)
        =>:
            value1 = floor(beta) - floor(alpha) = value2

have fn open_integer_count_312 by exist!:
    ? forall alpha, beta R:
        alpha < beta
        =>:
            exist! value N st {value = ceil(beta) - floor(alpha) - 1}
    floor(alpha) <= alpha < beta <= ceil(beta)
    floor(alpha) + 1 < ceil(beta) + 1
    floor(alpha) + 1 $in Z
    ceil(beta) $in Z
    floor(alpha) + 1 <= ceil(beta)
    have count Z = ceil(beta) - floor(alpha) - 1
    0 <= ceil(beta) - (floor(alpha) + 1) = ceil(beta) - floor(alpha) - 1 = count
    count $in N
    witness exist value N st {value = ceil(beta) - floor(alpha) - 1} from count
    forall value1, value2 N:
        value1 = ceil(beta) - floor(alpha) - 1
        value2 = ceil(beta) - floor(alpha) - 1
        =>:
            value1 = ceil(beta) - floor(alpha) - 1 = value2

closed_integer_count_312(1.2, 4.8) = floor(4.8) - ceil(1.2) + 1 = 3
left_half_open_integer_count_312(1.2, 4.8) = ceil(4.8) - ceil(1.2) = 3
right_half_open_integer_count_312(1.2, 4.8) = floor(4.8) - floor(1.2) = 3
open_integer_count_312(1.2, 4.8) = ceil(4.8) - floor(1.2) - 1 = 3

# Equation (3.13). A number wins when its positive cube-block index divides
# it. The count is the cardinality of that source-defined finite winner set.
prop is_roulette_winner_313(n N+):
    exist k N+ st {k^3 <= n, n < (k + 1)^3, n % k = 0}

have fn roulette_winner_count_313(wheel_size N+) N = finite_set_size({n closed_range(1, wheel_size): $is_roulette_winner_313(n)})

thm roulette_winner_count_formula_313:
    ? forall wheel_size, cube_floor N+:
        cube_floor^3 <= wheel_size
        wheel_size < (cube_floor + 1)^3
        =>:
            roulette_winner_count_313(wheel_size) = floor(wheel_size / cube_floor) + cube_floor^2 / 2 + 5 * cube_floor / 2 - 3
    # Missing generic bridge: partition this filtered range by its unique
    # cube block, count 3*k+4 winners in every complete block, and count the
    # final partial block through floor(wheel_size/cube_floor)-cube_floor^2+1.
    trust:
        finite_set_size({n closed_range(1, wheel_size): $is_roulette_winner_313(n)}) = (3 * cube_floor + 8) * (cube_floor - 1) / 2 + floor(wheel_size / cube_floor) - cube_floor^2 + 1
    (3 * cube_floor + 8) * (cube_floor - 1) / 2 + floor(wheel_size / cube_floor) - cube_floor^2 + 1 = floor(wheel_size / cube_floor) + cube_floor^2 / 2 + 5 * cube_floor / 2 - 3

10^3 <= 1000
1000 < (10 + 1)^3
by thm roulette_winner_count_formula_313(1000, 10)
roulette_winner_count_313(1000) = floor(1000 / 10) + 10^2 / 2 + 5 * 10 / 2 - 3 = 172

# Equation (3.14). The spectrum of alpha has term floor(k*alpha), and the
# number of its terms at most n is ceil((n+1)/alpha)-1. Positivity of the
# quotient makes the ceiling at least one, so unique selection realizes the
# formula as an N-valued count without requiring a multiset primitive.
have fn spectrum_314(alpha R+, k N+) Z = floor(k * alpha)

have fn spectrum_prefix_count_314 by exist!:
    ? forall alpha R+, n N:
        exist! value N st {value = ceil((n + 1) / alpha) - 1}
    0 < n + 1
    0 < (n + 1) / alpha
    (n + 1) / alpha <= ceil((n + 1) / alpha)
    0 < ceil((n + 1) / alpha)
    ceil((n + 1) / alpha) $in Z
    1 <= ceil((n + 1) / alpha)
    have count Z = ceil((n + 1) / alpha) - 1
    0 <= ceil((n + 1) / alpha) - 1 = count
    witness exist value N st {value = ceil((n + 1) / alpha) - 1} from count
    forall value1, value2 N:
        value1 = ceil((n + 1) / alpha) - 1
        value2 = ceil((n + 1) / alpha) - 1
        =>:
            value1 = ceil((n + 1) / alpha) - 1 = value2

prop spectra_partition_positive_integers_314(alpha, beta R+):
    forall n N+:
        spectrum_prefix_count_314(alpha, n) + spectrum_prefix_count_314(beta, n) = n

# The source reciprocal and floor/ceiling argument is checked below. Only the
# foundational irrationality fact for sqrt(2), not the partition conclusion,
# remains localized as proof debt.
thm complementary_sqrt_two_spectra_314:
    ? forall n N+:
        spectrum_prefix_count_314(sqrt(2), n) + spectrum_prefix_count_314(2 + sqrt(2), n) = n
    trust:
        not sqrt(2) $in Q
    sqrt(2)^2 = 2
    sqrt(2) != 0
    0 < 2 + sqrt(2)
    2 + sqrt(2) != 0
    have x R+ = (n + 1) / sqrt(2)
    have y R+ = (n + 1) / (2 + sqrt(2))
    sqrt(2)^2 / 2 = 1
    1 / sqrt(2) = (1 / sqrt(2)) * 1 = (1 / sqrt(2)) * (sqrt(2)^2 / 2) = sqrt(2) / 2
    (2 - sqrt(2)) * (2 + sqrt(2)) = 4 - sqrt(2)^2 = 2
    ((2 - sqrt(2)) * (2 + sqrt(2))) / 2 = 1
    1 / (2 + sqrt(2)) = (1 / (2 + sqrt(2))) * 1 = (1 / (2 + sqrt(2))) * (((2 - sqrt(2)) * (2 + sqrt(2))) / 2) = (2 - sqrt(2)) / 2
    x = (n + 1) / sqrt(2) = (n + 1) * (1 / sqrt(2))
    y = (n + 1) / (2 + sqrt(2)) = (n + 1) * (1 / (2 + sqrt(2)))
    x + y = (n + 1) * (1 / sqrt(2)) + (n + 1) * (1 / (2 + sqrt(2))) = (n + 1) * (1 / sqrt(2) + 1 / (2 + sqrt(2))) = (n + 1) * (sqrt(2) / 2 + (2 - sqrt(2)) / 2) = n + 1
    claim:
        ? not x $in Z
        by contra:
            ? not x $in Z
            x $in Z
            x $in Q
            x != 0
            x * sqrt(2) = n + 1
            sqrt(2) = (n + 1) / x
            (n + 1) / x $in Q
            sqrt(2) $in Q
            impossible not sqrt(2) $in Q
    claim:
        ? not y $in Z
        by contra:
            ? not y $in Z
            y $in Z
            y $in Q
            y != 0
            y * (2 + sqrt(2)) = n + 1
            2 + sqrt(2) = (n + 1) / y
            (n + 1) / y $in Q
            2 + sqrt(2) $in Q
            sqrt(2) = (2 + sqrt(2)) - 2
            (2 + sqrt(2)) - 2 $in Q
            sqrt(2) $in Q
            impossible not sqrt(2) $in Q
    claim:
        ? floor(x) != x
        by contra:
            ? floor(x) != x
            floor(x) = x
            floor(x) $in Z
            x $in Z
            impossible not x $in Z
    floor(x) <= x
    claim:
        ? floor(x) < x
        by contra:
            ? floor(x) < x
            x <= floor(x)
            floor(x) = x
            impossible floor(x) != x
    floor(y) <= y
    floor(x) + floor(y) $in Z
    floor(x) + floor(y) < x + y = n + 1
    floor(x) + floor(y) <= n
    x < floor(x) + 1
    y < floor(y) + 1
    n + 1 = x + y < (floor(x) + 1) + y < (floor(x) + 1) + (floor(y) + 1) = floor(x) + floor(y) + 2
    n = (n + 1) - 1 < (floor(x) + floor(y) + 2) - 1 = floor(x) + floor(y) + 1
    n <= floor(x) + floor(y)
    floor(x) + floor(y) = n
    noninteger_indicator_32(x) = 1
    noninteger_indicator_32(y) = 1
    by thm floor_ceil_gap_32(x)
    ceil(x) - floor(x) = noninteger_indicator_32(x) = 1
    ceil(x) = (ceil(x) - floor(x)) + floor(x) = 1 + floor(x) = floor(x) + 1
    ceil(x) - 1 = floor(x) + 1 - 1 = floor(x)
    by thm floor_ceil_gap_32(y)
    ceil(y) - floor(y) = noninteger_indicator_32(y) = 1
    ceil(y) = (ceil(y) - floor(y)) + floor(y) = 1 + floor(y) = floor(y) + 1
    ceil(y) - 1 = floor(y) + 1 - 1 = floor(y)
    spectrum_prefix_count_314(sqrt(2), n) = ceil((n + 1) / sqrt(2)) - 1 = ceil(x) - 1 = floor(x)
    spectrum_prefix_count_314(2 + sqrt(2), n) = ceil((n + 1) / (2 + sqrt(2))) - 1 = ceil(y) - 1 = floor(y)
    spectrum_prefix_count_314(sqrt(2), n) + spectrum_prefix_count_314(2 + sqrt(2), n) = floor(x) + floor(y) = n

spectrum_314(2, 3) = floor(3 * 2) = floor(6) = 6
spectrum_prefix_count_314(2, 5) = ceil((5 + 1) / 2) - 1 = 2

# Equation (3.15). The integer-adjacency builtin now closes the formerly
# trusted strict-successor-to-weak-bound direction directly.
forall m, n Z:
    =>:
        m <= n
    <=>:
        m < n + 1

# Section 3.3. Floor/Ceiling Recurrences.
# Equation (3.16). A rounded quotient is mathematically a natural index even
# though floor returns Z. Nonnegativity selects the exact floor value in N;
# comparing n-1 with (n-1)*divisor proves the selected recursive index is
# strictly smaller than n without changing the recurrence's carrier.
have fn natural_floor_quotient_316 by exist!:
    ? forall dividend N, divisor N+:
        exist! value N st {value = floor(dividend / divisor)}
    0 <= dividend / divisor
    by thm integer_le_x_gives_integer_le_floor_37d(dividend / divisor, 0)
    have quotient Z = floor(dividend / divisor)
    0 <= floor(dividend / divisor) = quotient
    witness exist value N st {value = floor(dividend / divisor)} from quotient
    forall value1, value2 N:
        value1 = floor(dividend / divisor)
        value2 = floor(dividend / divisor)
        =>:
            value1 = floor(dividend / divisor) = value2

claim:
    ? forall n N+, divisor N+:
        natural_floor_quotient_316(n - 1, divisor) < n
    divisor >= 1
    0 <= n - 1
    n - 1 <= (n - 1) * divisor
    (n - 1) / divisor <= ((n - 1) * divisor) / divisor = n - 1
    floor((n - 1) / divisor) <= (n - 1) / divisor
    natural_floor_quotient_316(n - 1, divisor) = floor((n - 1) / divisor)
    natural_floor_quotient_316(n - 1, divisor) <= floor((n - 1) / divisor) <= (n - 1) / divisor <= n - 1 < n

natural_floor_quotient_316(6, 2) = floor(6 / 2) = floor(3) = 3 < 7

# The source recurrence returns one plus a minimum of positive values. This
# casewise helper preserves that N+ carrier, while the theorem records its
# ordinary min expression.
have fn positive_min_plus_one_316(a, b N+) N+ by cases:
    case a <= b: 1 + a
    case a > b: 1 + b

thm positive_min_plus_one_formula_316:
    ? forall a, b N+:
        positive_min_plus_one_316(a, b) = 1 + min(a, b)
    by cases:
        ? positive_min_plus_one_316(a, b) = 1 + min(a, b)
        case a <= b:
            positive_min_plus_one_316(a, b) = 1 + a
            min(a, b) = a
            positive_min_plus_one_316(a, b) = 1 + a = 1 + min(a, b)
        case a > b:
            b < a
            b <= a
            positive_min_plus_one_316(a, b) = 1 + b
            min(a, b) = b
            positive_min_plus_one_316(a, b) = 1 + b = 1 + min(a, b)

# The typed quotient and positive-min helper discharge the recursive-call and
# result-carrier obligations without changing the source's N -> N+ interface.
have fn knuth_number_316(n N) N+ by induc n from 0:
    case n = 0: 1
    case n > 0: positive_min_plus_one_316(2 * knuth_number_316(natural_floor_quotient_316(n - 1, 2)), 3 * knuth_number_316(natural_floor_quotient_316(n - 1, 3)))

# Equation (3.17). Fit n-floor(n/2) into the characteristic ceiling interval;
# no parity split or trusted rounding identity is needed.
thm integer_half_split_317:
    ? forall n N:
        n = ceil(n / 2) + floor(n / 2)
    floor(n / 2) <= n / 2
    n / 2 < floor(n / 2) + 1
    n / 2 = n - n / 2 <= n - floor(n / 2)
    n - (floor(n / 2) + 1) < n - n / 2 = n / 2
    n - floor(n / 2) - 1 = n - (floor(n / 2) + 1)
    n - floor(n / 2) - 1 < n / 2
    n - floor(n / 2) $in Z
    by thm ceil_bounds_give_value_35c(n / 2, n - floor(n / 2))
    ceil(n / 2) = n - floor(n / 2)
    n = (n - floor(n / 2)) + floor(n / 2) = ceil(n / 2) + floor(n / 2)

ceil(7 / 2) + floor(7 / 2) = 4 + 3 = 7

# Equation (3.18). The two rounded subproblem sizes are positive and strictly
# smaller when n>1. Typed selectors expose exactly those construction facts,
# allowing the merge-comparison recurrence itself to verify.
have fn positive_floor_half_318 by exist!:
    ? forall n N+:
        n > 1
        =>:
            exist! value N+ st {value = floor(n / 2)}
    2 = 1 + 1 < n + 1
    2 <= n
    1 = 2 / 2 <= n / 2
    by thm integer_le_x_gives_integer_le_floor_37d(n / 2, 1)
    have floor_half Z = floor(n / 2)
    1 <= floor(n / 2) = floor_half
    floor_half $in N+
    witness exist value N+ st {value = floor(n / 2)} from floor_half
    forall value1, value2 N+:
        value1 = floor(n / 2)
        value2 = floor(n / 2)
        =>:
            value1 = floor(n / 2) = value2

have fn positive_ceil_half_318 by exist!:
    ? forall n N+:
        n > 1
        =>:
            exist! value N+ st {value = ceil(n / 2)}
    0 < n / 2 <= ceil(n / 2)
    ceil(n / 2) $in Z
    1 <= ceil(n / 2)
    have ceil_half Z = ceil(n / 2)
    1 <= ceil(n / 2) = ceil_half
    ceil_half $in N+
    witness exist value N+ st {value = ceil(n / 2)} from ceil_half
    forall value1, value2 N+:
        value1 = ceil(n / 2)
        value2 = ceil(n / 2)
        =>:
            value1 = ceil(n / 2) = value2

claim:
    ? forall n N+:
        n > 1
        =>:
            positive_floor_half_318(n) = floor(n / 2)
            positive_ceil_half_318(n) = ceil(n / 2)
            positive_floor_half_318(n) < n
            positive_ceil_half_318(n) < n
    2 = 1 + 1 < n + 1
    2 <= n
    n / 2 < n
    floor(n / 2) <= n / 2
    positive_floor_half_318(n) = floor(n / 2)
    positive_floor_half_318(n) = floor(n / 2) <= n / 2 < n
    0 <= n - 2
    n = n + 0 <= n + (n - 2) = 2 * n - 2 = 2 * (n - 1)
    n / 2 <= (2 * (n - 1)) / 2 = n - 1
    by thm x_le_integer_gives_ceil_le_37c(n / 2, n - 1)
    ceil(n / 2) <= n - 1 < n
    positive_ceil_half_318(n) = ceil(n / 2)
    positive_ceil_half_318(n) = ceil(n / 2) <= n - 1 < n

positive_floor_half_318(7) = floor(7 / 2) = 3
positive_ceil_half_318(7) = ceil(7 / 2) = 4

# Both typed half selectors are positive and smaller than n in the recursive
# branch, so the source's N+ -> N recurrence is a checked definition.
have fn merge_comparison_bound_318(n N+) N by induc n from 1:
    case n = 1: 0
    case n > 1: merge_comparison_bound_318(positive_ceil_half_318(n)) + merge_comparison_bound_318(positive_floor_half_318(n)) + n - 1

# Equations (3.19)--(3.20). The generalized Josephus solution uses the first
# threshold D_k above (q-1)n, where D_0=1 and
# D_k=ceil(q D_{k-1}/(q-1)). The threshold's minimal-index construction is a
# genuine selection interface; the source formula is retained without adding
# a kernel rule for this one recurrence.
have josephus_moduli_319 power_set(N+) = {q N+: q > 1}

# Keep the source denominator as a formula-defined helper. The explicit
# comparison chain exposes its positivity to later division checks.
have fn josephus_denominator_320(q josephus_moduli_319) Z = q - 1

forall q josephus_moduli_319:
    q > 1
    josephus_denominator_320(q) = q - 1
    q - 1 > 0
    josephus_denominator_320(q) = q - 1 > 0
    josephus_denominator_320(q) != 0

# Package the positive ceil update once, so the recursive branch preserves the
# source's N+ carrier without weakening the sequence to integers.
have fn positive_josephus_threshold_step_320 by exist!:
    ? forall q josephus_moduli_319, previous N+:
        exist! value N+ st {value = ceil(q * previous / josephus_denominator_320(q))}
    q > 1
    q > 0
    josephus_denominator_320(q) > 0
    q * previous > 0
    q * previous / josephus_denominator_320(q) > 0
    q * previous / josephus_denominator_320(q) <= ceil(q * previous / josephus_denominator_320(q))
    0 < q * previous / josephus_denominator_320(q) <= ceil(q * previous / josephus_denominator_320(q))
    ceil(q * previous / josephus_denominator_320(q)) $in Z
    1 <= ceil(q * previous / josephus_denominator_320(q))
    have next_threshold Z = ceil(q * previous / josephus_denominator_320(q))
    1 <= ceil(q * previous / josephus_denominator_320(q)) = next_threshold
    next_threshold $in N+
    witness exist value N+ st {value = ceil(q * previous / josephus_denominator_320(q))} from next_threshold
    forall value1, value2 N+:
        value1 = ceil(q * previous / josephus_denominator_320(q))
        value2 = ceil(q * previous / josephus_denominator_320(q))
        =>:
            value1 = ceil(q * previous / josephus_denominator_320(q)) = value2

have fn josephus_threshold_320(q josephus_moduli_319, step N) N+ by induc step from 0:
    case step = 0: 1
    case step > 0: positive_josephus_threshold_step_320(q, josephus_threshold_320(q, step - 1))

forall q josephus_moduli_319, step N+:
    josephus_threshold_320(q, step) = positive_josephus_threshold_step_320(q, josephus_threshold_320(q, step - 1))
    positive_josephus_threshold_step_320(q, josephus_threshold_320(q, step - 1)) = ceil(q * josephus_threshold_320(q, step - 1) / josephus_denominator_320(q))
    josephus_threshold_320(q, step) = ceil(q * josephus_threshold_320(q, step - 1) / josephus_denominator_320(q))

# Each rounded update is strictly larger than its predecessor. Consequently
# D_k >= k+1, which supplies a finite search bound for the first threshold.
forall q josephus_moduli_319, previous N+:
    q > 1
    josephus_denominator_320(q) = q - 1 > 0
    previous / josephus_denominator_320(q) > 0
    q = (q - 1) + 1 = josephus_denominator_320(q) + 1
    previous + previous / josephus_denominator_320(q) > previous
    q * previous / josephus_denominator_320(q) = (josephus_denominator_320(q) + 1) * previous / josephus_denominator_320(q) = previous + previous / josephus_denominator_320(q) > previous
    q * previous / josephus_denominator_320(q) <= ceil(q * previous / josephus_denominator_320(q))
    positive_josephus_threshold_step_320(q, previous) = ceil(q * previous / josephus_denominator_320(q)) > previous

forall q josephus_moduli_319, step N:
    step + 1 > 0
    (step + 1) - 1 = step
    josephus_threshold_320(q, step + 1) = positive_josephus_threshold_step_320(q, josephus_threshold_320(q, (step + 1) - 1))
    josephus_threshold_320(q, (step + 1) - 1) = josephus_threshold_320(q, step)
    positive_josephus_threshold_step_320(q, josephus_threshold_320(q, (step + 1) - 1)) = positive_josephus_threshold_step_320(q, josephus_threshold_320(q, step))
    positive_josephus_threshold_step_320(q, josephus_threshold_320(q, step)) > josephus_threshold_320(q, step)
    josephus_threshold_320(q, step + 1) = positive_josephus_threshold_step_320(q, josephus_threshold_320(q, (step + 1) - 1)) = positive_josephus_threshold_step_320(q, josephus_threshold_320(q, step)) > josephus_threshold_320(q, step)

claim:
    ? forall q josephus_moduli_319, step N:
        josephus_threshold_320(q, step) >= step + 1
    by induc step from 0:
        ? josephus_threshold_320(q, step) >= step + 1
        ? from step = 0:
            josephus_threshold_320(q, 0) = 1 = 0 + 1
        ? induc:
            josephus_threshold_320(q, step + 1) > josephus_threshold_320(q, step) >= step + 1
            josephus_threshold_320(q, step + 1) $in Z
            josephus_threshold_320(q, step) $in Z
            josephus_threshold_320(q, step + 1) >= josephus_threshold_320(q, step) + 1
            josephus_threshold_320(q, step) + 1 >= (step + 1) + 1
            josephus_threshold_320(q, step + 1) >= (step + 1) + 1

prop is_first_josephus_threshold_319(q josephus_moduli_319, population N+, step N):
    josephus_threshold_320(q, step) > (q - 1) * population
    forall earlier N:
        earlier < step
        =>:
            josephus_threshold_320(q, earlier) <= (q - 1) * population

# Search only through the textbook bound (q-1)n. The bound itself qualifies
# because D_b >= b+1, so the filtered closed range is finite and nonempty.
claim:
    ? forall q josephus_moduli_319, population N+:
        $is_finite_set({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population})
        $is_nonempty_set({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population})
    q - 1 $in N
    (q - 1) * population $in N
    $is_finite_set({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population})
    josephus_threshold_320(q, (q - 1) * population) >= (q - 1) * population + 1 > (q - 1) * population
    (q - 1) * population $in {step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}
    witness $is_nonempty_set({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}) from (q - 1) * population

have fn josephus_threshold_index_319(q josephus_moduli_319, population N+) N = finite_set_min({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population})

forall q josephus_moduli_319, population N+:
    josephus_threshold_index_319(q, population) = finite_set_min({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population})
    finite_set_min({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}) $in {step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}
    josephus_threshold_index_319(q, population) $in {step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}
    josephus_threshold_320(q, josephus_threshold_index_319(q, population)) > (q - 1) * population

claim:
    ? forall q josephus_moduli_319, population N+, earlier N:
        earlier < josephus_threshold_index_319(q, population)
        =>:
            josephus_threshold_320(q, earlier) <= (q - 1) * population
    by contra:
        ? josephus_threshold_320(q, earlier) <= (q - 1) * population
        josephus_threshold_320(q, earlier) > (q - 1) * population
        josephus_threshold_index_319(q, population) $in {step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}
        josephus_threshold_index_319(q, population) $in closed_range(0, (q - 1) * population)
        earlier < josephus_threshold_index_319(q, population) <= (q - 1) * population
        earlier $in closed_range(0, (q - 1) * population)
        earlier $in {step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}
        finite_set_min({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}) <= earlier
        josephus_threshold_index_319(q, population) = finite_set_min({step closed_range(0, (q - 1) * population): josephus_threshold_320(q, step) > (q - 1) * population}) <= earlier
        impossible earlier < josephus_threshold_index_319(q, population)

claim:
    ? forall q josephus_moduli_319, population N+:
        $is_first_josephus_threshold_319(q, population, josephus_threshold_index_319(q, population))
    by def $is_first_josephus_threshold_319(q, population, josephus_threshold_index_319(q, population))

# Minimality supplies D_{k-1} <= (q-1)n. The recurrence then gives D_k <= qn,
# hence the source survivor formula is a strictly positive integer.
claim:
    ? forall q josephus_moduli_319, population N+:
        q * population + 1 - josephus_threshold_320(q, josephus_threshold_index_319(q, population)) $in N+
    have k N = josephus_threshold_index_319(q, population)
    k = josephus_threshold_index_319(q, population)
    josephus_threshold_320(q, k) = josephus_threshold_320(q, josephus_threshold_index_319(q, population)) > (q - 1) * population
    claim:
        ? k > 0
        by contra:
            ? k > 0
            k <= 0
            0 <= k
            k = 0
            q - 1 $in N+
            population >= 1
            q - 1 >= 1
            (q - 1) * population >= 1 * population = population >= 1
            josephus_threshold_320(q, k) = josephus_threshold_320(q, 0) = 1 <= (q - 1) * population
            impossible josephus_threshold_320(q, k) > (q - 1) * population
    k - 1 $in N
    k - 1 < k
    josephus_threshold_320(q, k - 1) <= (q - 1) * population
    q > 0
    josephus_denominator_320(q) = q - 1 > 0
    q * josephus_threshold_320(q, k - 1) <= q * ((q - 1) * population) = q * (josephus_denominator_320(q) * population)
    q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q) <= q * (josephus_denominator_320(q) * population) / josephus_denominator_320(q) = q * population
    ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) $in Z
    ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) - 1 $in Z
    q * population $in Z
    ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) - 1 < q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q) <= q * population
    ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) - 1 < q * population
    (ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) - 1) + 1 <= q * population
    (ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) - 1) + 1 = ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q))
    ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) = (ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) - 1) + 1 <= q * population
    josephus_threshold_320(q, k) = ceil(q * josephus_threshold_320(q, k - 1) / josephus_denominator_320(q)) <= q * population
    -josephus_threshold_320(q, k) >= -(q * population)
    q * population + 1 - josephus_threshold_320(q, k) = q * population + 1 + (-josephus_threshold_320(q, k)) >= q * population + 1 + (-(q * population)) = 1
    q * population + 1 - josephus_threshold_320(q, k) >= 1
    q * population + 1 - josephus_threshold_320(q, k) >= 1 > 0
    q * population + 1 - josephus_threshold_320(q, k) $in Z
    have survivor_value Z = q * population + 1 - josephus_threshold_320(q, k)
    survivor_value = q * population + 1 - josephus_threshold_320(q, k) >= 1 > 0
    survivor_value $in N+
    q * population + 1 - josephus_threshold_320(q, k) = survivor_value
    q * population + 1 - josephus_threshold_320(q, k) $in N+
    josephus_threshold_320(q, k) = josephus_threshold_320(q, josephus_threshold_index_319(q, population))
    q * population + 1 - josephus_threshold_320(q, josephus_threshold_index_319(q, population)) $in N+

have fn generalized_josephus_survivor_319(q josephus_moduli_319, population N+) N+ = q * population + 1 - josephus_threshold_320(q, josephus_threshold_index_319(q, population))

forall q josephus_moduli_319, population N+:
    generalized_josephus_survivor_319(q, population) = q * population + 1 - josephus_threshold_320(q, josephus_threshold_index_319(q, population))

# A checked consumer of the q=2 threshold recurrence.
2 > 1
by thm set_builder_member(2, {q N+: q > 1})
2 $in josephus_moduli_319
josephus_threshold_320(2, 0) = 1
josephus_denominator_320(2) = 1
josephus_threshold_320(2, 1) = ceil(2 * josephus_threshold_320(2, 0) / josephus_denominator_320(2)) = 2

# Section 3.4. Mod: The Binary Operation.
# Equations (3.21)--(3.22). The source extends real remainder by x mod 0=x.
# This is an ordinary case-defined Litex function, not a special builtin.
have fn real_mod_322(x, y R) R by cases:
    case y = 0: x
    case y != 0: x - y * floor(x / y)

real_mod_322(6, 3) = 6 - 3 * floor(6 / 3) = 0
real_mod_322(5, 0) = 5

# The sign-sensitive range statements follow directly from the characteristic
# floor inequalities. Both proofs are checked rather than entrusted.
thm real_mod_positive_bounds_321:
    ? forall x R, y R+:
        0 <= real_mod_322(x, y)
        real_mod_322(x, y) < y
    y > 0
    y != 0
    real_mod_322(x, y) = x - y * floor(x / y)
    floor(x / y) <= x / y
    x / y < floor(x / y) + 1
    y * floor(x / y) <= y * (x / y) = x
    0 <= x - y * floor(x / y) = real_mod_322(x, y)
    x = y * (x / y) < y * (floor(x / y) + 1) = y * floor(x / y) + y
    real_mod_322(x, y) = x - y * floor(x / y) < (y * floor(x / y) + y) - y * floor(x / y) = y

thm real_mod_negative_bounds_321:
    ? forall x R, y R-:
        y < real_mod_322(x, y)
        real_mod_322(x, y) <= 0
    y < 0
    y != 0
    real_mod_322(x, y) = x - y * floor(x / y)
    floor(x / y) <= x / y
    x / y < floor(x / y) + 1
    y * floor(x / y) >= y * (x / y) = x
    real_mod_322(x, y) = x - y * floor(x / y) <= 0
    x = y * (x / y) > y * (floor(x / y) + 1) = y * floor(x / y) + y
    real_mod_322(x, y) = x - y * floor(x / y) > (y * floor(x / y) + y) - y * floor(x / y) = y

# Equation (3.23). Scaling both arguments preserves their quotient. The zero
# scalar and zero divisor are handled separately; otherwise the definition
# unfolds and ordinary field cancellation proves the identity.
thm real_mod_scaling_323:
    ? forall c, x, y R:
        c * real_mod_322(x, y) = real_mod_322(c * x, c * y)
    c = 0 or c != 0
    by cases:
        ? c * real_mod_322(x, y) = real_mod_322(c * x, c * y)
        case c = 0:
            c * real_mod_322(x, y) = 0
            c * x = 0
            c * y = 0
            real_mod_322(c * x, c * y) = real_mod_322(0, 0) = 0
            c * real_mod_322(x, y) = real_mod_322(c * x, c * y)
        case c != 0:
            y = 0 or y != 0
            by cases:
                ? c * real_mod_322(x, y) = real_mod_322(c * x, c * y)
                case y = 0:
                    c * y = 0
                    real_mod_322(x, y) = x
                    real_mod_322(c * x, c * y) = c * x
                    c * real_mod_322(x, y) = c * x = real_mod_322(c * x, c * y)
                case y != 0:
                    c * y != 0
                    real_mod_322(x, y) = x - y * floor(x / y)
                    real_mod_322(c * x, c * y) = c * x - (c * y) * floor((c * x) / (c * y))
                    (c * x) / (c * y) = x / y
                    c * real_mod_322(x, y) = c * (x - y * floor(x / y)) = c * x - (c * y) * floor(x / y) = c * x - (c * y) * floor((c * x) / (c * y)) = real_mod_322(c * x, c * y)

# Equations (3.24)--(3.26). The first two sums partition an integer into
# nonincreasing or nondecreasing near-equal parts. The third is the source's
# floor-distribution identity for every positive integer m.
thm division_remainder_bounds_324:
    ? forall a Z, m N+:
        0 <= a - floor(a / m) * m
        a - floor(a / m) * m < m
    m > 0
    floor(a / m) <= a / m
    a / m < floor(a / m) + 1
    m * floor(a / m) <= m * (a / m)
    floor(a / m) * m = m * floor(a / m) <= m * (a / m) = a
    0 <= a - floor(a / m) * m
    m * (a / m) < m * (floor(a / m) + 1)
    a = m * (a / m) < m * (floor(a / m) + 1) = floor(a / m) * m + m
    a - floor(a / m) * m < (floor(a / m) * m + m) - floor(a / m) * m = m

thm ceil_partition_zero_term_324:
    ? forall a, q Z, m, k N+:
        a = q * m
        k <= m
        =>:
            ceil((a - k + 1) / m) = q
    m > 0
    q * m - m < q * m - k + 1 = a - k + 1
    q - 1 = (q * m - m) / m < (a - k + 1) / m
    1 <= k
    1 - k <= k - k = 0
    a - k + 1 = a + (1 - k) <= a + 0 = a = q * m
    (a - k + 1) / m <= (q * m) / m = q
    by thm ceil_bounds_give_value_35c((a - k + 1) / m, q)

thm ceil_partition_high_term_324:
    ? forall a, q Z, m, k N+, r Z:
        a = q * m + r
        k <= r
        r < m
        =>:
            ceil((a - k + 1) / m) = q + 1
    m > 0
    r - k >= 0
    q * m < q * m + (r - k + 1)
    q * m + (r - k + 1) = (q * m + r) - k + 1 = a - k + 1
    (q + 1) - 1 = q = (q * m) / m < (a - k + 1) / m
    1 <= k
    1 - k <= 0
    r - k + 1 = r + (1 - k) <= r
    a - k + 1 = (q * m + r) - k + 1 = q * m + (r - k + 1) <= q * m + r < q * m + m = (q + 1) * m
    (a - k + 1) / m < ((q + 1) * m) / m = q + 1
    (a - k + 1) / m <= q + 1
    by thm ceil_bounds_give_value_35c((a - k + 1) / m, q + 1)

thm ceil_partition_low_term_324:
    ? forall a, q Z, m, k N+, r Z:
        a = q * m + r
        0 <= r
        r + 1 <= k
        k <= m
        =>:
            ceil((a - k + 1) / m) = q + 0 * r
    m > 0
    r + 1 - k <= k - k = 0
    r - k + 1 = r + 1 - k <= 0
    a - k + 1 = (q * m + r) - k + 1 = q * m + (r - k + 1) <= q * m
    (a - k + 1) / m <= (q * m) / m = q
    m - k >= 0
    r + (m - k) + 1 > 0
    q * m - m < (q * m - m) + (r + (m - k) + 1)
    (q * m - m) + (r + (m - k) + 1) = q * m + r - k + 1 = (q * m + r) - k + 1 = a - k + 1
    q - 1 = (q * m - m) / m < (a - k + 1) / m
    by thm ceil_bounds_give_value_35c((a - k + 1) / m, q)
    ceil((a - k + 1) / m) = q = q + 0 * r

thm floor_partition_zero_term_325:
    ? forall a, q Z, m, k N+:
        a = q * m
        k <= m
        =>:
            floor((a + k - 1) / m) = q
    m > 0
    1 <= k
    0 <= k - 1
    q * m <= q * m + (k - 1)
    q * m + (k - 1) = a + (k - 1) = a + k - 1
    q * m <= a + k - 1
    q = (q * m) / m <= (a + k - 1) / m
    k - 1 < k <= m
    a + k - 1 = q * m + (k - 1)
    q * m + (k - 1) < q * m + m = (q + 1) * m
    a + k - 1 < (q + 1) * m
    (a + k - 1) / m < ((q + 1) * m) / m = q + 1
    by thm floor_bounds_give_value_35a((a + k - 1) / m, q)

thm floor_partition_low_term_325:
    ? forall a, q Z, m, k N+, r Z:
        a = q * m + r
        0 <= r
        k <= m - r
        =>:
            floor((a + k - 1) / m) = q + 0 * r
    m > 0
    1 <= k
    0 <= r + k - 1
    q * m <= q * m + (r + k - 1)
    q * m + (r + k - 1) = (q * m + r) + k - 1 = a + k - 1
    q = (q * m) / m <= (a + k - 1) / m
    r + k <= r + (m - r) = m
    r + k - 1 < r + k <= m
    a + k - 1 = (q * m + r) + k - 1 = q * m + (r + k - 1) < q * m + m = (q + 1) * m
    (a + k - 1) / m < ((q + 1) * m) / m = q + 1
    by thm floor_bounds_give_value_35a((a + k - 1) / m, q)
    floor((a + k - 1) / m) = q = q + 0 * r

thm floor_partition_high_term_325:
    ? forall a, q Z, m, k N+, r Z:
        a = q * m + r
        0 <= r
        r < m
        m - r + 1 <= k
        k <= m
        =>:
            floor((a + k - 1) / m) = q + 1 + 0 * r
    m > 0
    m - r < m - r + 1 <= k
    m = r + (m - r) < r + k
    m $in Z
    r + k $in Z
    m + 1 <= r + k
    m <= (r + k) - 1
    (q + 1) * m = q * m + m <= q * m + (r + k - 1)
    q * m + (r + k - 1) = (q * m + r) + k - 1 = a + k - 1
    q + 1 = ((q + 1) * m) / m <= (a + k - 1) / m
    r + 1 <= m
    r <= m - 1
    r + k - 1 <= (m - 1) + m - 1 = 2 * m - 2 < 2 * m
    q * m + (r + k - 1) < q * m + 2 * m
    a + k - 1 = (q * m + r) + k - 1 = q * m + (r + k - 1) < q * m + 2 * m = (q + 2) * m
    (a + k - 1) / m < ((q + 2) * m) / m = q + 2 = q + 1 + 1
    by thm floor_bounds_give_value_35a((a + k - 1) / m, q + 1)
    floor((a + k - 1) / m) = q + 1 = q + 1 + 0 * r

thm equal_partition_ceiling_sum_324:
    ? forall n Z, m N+:
        n = sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)})
    have q Z = floor(n / m)
    have r Z = n - q * m
    q = floor(n / m)
    r = n - q * m = n - floor(n / m) * m
    by thm division_remainder_bounds_324(n, m)
    0 <= n - floor(n / m) * m = r
    0 <= r
    r = n - floor(n / m) * m < m
    n = q * m + (n - q * m) = q * m + r
    r = 0 or r > 0
    by cases:
        ? n = sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)})
        case r = 0:
            claim:
                ? forall k N+:
                    k <= m
                    =>:
                        ceil((n - k + 1) / m) = q
                n = q * m + r = q * m
                by thm ceil_partition_zero_term_324(n, q, m, k)
            sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)}) = sum(1, m, fn(k N+) Z {q})
            sum(1, m, fn(k N+) Z {q}) = (m - 1 + 1) * q = m * q
            n = q * m + r = q * m = m * q
            n = sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)})
        case r > 0:
            1 <= r
            r $in N+
            r + 1 $in N+
            r + 1 <= m
            claim:
                ? forall k N+:
                    1 <= k
                    k <= r
                    =>:
                        ceil((n - k + 1) / m) = q + 1
                by thm ceil_partition_high_term_324(n, q, m, k, r)
            claim:
                ? forall k N+:
                    r + 1 <= k
                    k <= m
                    =>:
                        ceil((n - k + 1) / m) = q + 0 * r
                by thm ceil_partition_low_term_324(n, q, m, k, r)
            sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)}) = sum(1, r, fn(k N+) Z {ceil((n - k + 1) / m)}) + sum(r + 1, m, fn(k N+) Z {ceil((n - k + 1) / m)})
            sum(1, r, fn(k N+) Z {ceil((n - k + 1) / m)}) = sum(1, r, fn(k N+) Z {q + 1})
            sum(r + 1, m, fn(k N+) Z {ceil((n - k + 1) / m)}) = sum(r + 1, m, fn(k N+) Z {q + 0 * r})
            sum(1, r, fn(k N+) Z {q + 1}) = (r - 1 + 1) * (q + 1)
            sum(r + 1, m, fn(k N+) Z {q + 0 * r}) = (m - (r + 1) + 1) * (q + 0 * r)
            (r - 1 + 1) * (q + 1) + (m - (r + 1) + 1) * (q + 0 * r) = q * m + r
            sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)}) = q * m + r = n
            n = sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)})

thm equal_partition_floor_sum_325:
    ? forall n Z, m N+:
        n = sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)})
    have q Z = floor(n / m)
    have r Z = n - q * m
    q = floor(n / m)
    r = n - q * m = n - floor(n / m) * m
    by thm division_remainder_bounds_324(n, m)
    0 <= n - floor(n / m) * m = r
    0 <= r
    r = n - floor(n / m) * m < m
    n = q * m + (n - q * m) = q * m + r
    m - r > 0
    m - r $in Z
    1 <= m - r
    m - r <= m
    r = 0 or r > 0
    by cases:
        ? n = sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)})
        case r = 0:
            claim:
                ? forall k N+:
                    k <= m
                    =>:
                        floor((n + k - 1) / m) = q
                n = q * m + r = q * m
                by thm floor_partition_zero_term_325(n, q, m, k)
            sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)}) = sum(1, m, fn(k N+) Z {q})
            sum(1, m, fn(k N+) Z {q}) = (m - 1 + 1) * q = m * q
            n = q * m + r = q * m = m * q
            n = sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)})
        case r > 0:
            1 <= r
            r $in N+
            m - r + 1 <= m - 1 + 1 = m
            m - r + 1 $in N+
            claim:
                ? forall k N+:
                    1 <= k
                    k <= m - r
                    =>:
                        floor((n + k - 1) / m) = q + 0 * r
                by thm floor_partition_low_term_325(n, q, m, k, r)
            claim:
                ? forall k N+:
                    m - r + 1 <= k
                    k <= m
                    =>:
                        floor((n + k - 1) / m) = q + 1 + 0 * r
                by thm floor_partition_high_term_325(n, q, m, k, r)
            sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)}) = sum(1, m - r, fn(k N+) Z {floor((n + k - 1) / m)}) + sum(m - r + 1, m, fn(k N+) Z {floor((n + k - 1) / m)})
            sum(1, m - r, fn(k N+) Z {floor((n + k - 1) / m)}) = sum(1, m - r, fn(k N+) Z {q + 0 * r})
            sum(m - r + 1, m, fn(k N+) Z {floor((n + k - 1) / m)}) = sum(m - r + 1, m, fn(k N+) Z {q + 1 + 0 * r})
            sum(1, m - r, fn(k N+) Z {q + 0 * r}) = ((m - r) - 1 + 1) * (q + 0 * r)
            sum(m - r + 1, m, fn(k N+) Z {q + 1 + 0 * r}) = (m - (m - r + 1) + 1) * (q + 1 + 0 * r)
            ((m - r) - 1 + 1) * (q + 0 * r) + (m - (m - r + 1) + 1) * (q + 1 + 0 * r) = q * m + r
            sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)}) = q * m + r = n
            n = sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)})

thm equal_partition_rounding_sums_324_326:
    ? forall n Z, m N+, x R:
        n = sum(1, m, fn(k N+) Z {ceil((n - k + 1) / m)})
        n = sum(1, m, fn(k N+) Z {floor((n + k - 1) / m)})
        floor(m * x) = chap2::finite_integer_sum(0, m - 1, fn(k Z) Z {floor(x + k / m)})
    by thm equal_partition_ceiling_sum_324(n, m)
    by thm equal_partition_floor_sum_325(n, m)
    floor(m * x) $in Z
    by thm equal_partition_floor_sum_325(floor(m * x), m)
    floor(m * x) = sum(1, m, fn(k N+) Z {floor((floor(m * x) + k - 1) / m)})
    claim:
        ? forall k N+:
            k <= m
            =>:
                floor((floor(m * x) + k - 1) / m) = floor(x + (k - 1) / m)
        k - 1 $in Z
        by thm floor_nested_quotient_311(m * x, k - 1, m)
        floor((floor(m * x) + (k - 1)) / m) = floor((m * x + (k - 1)) / m)
        floor((floor(m * x) + k - 1) / m) = floor((floor(m * x) + (k - 1)) / m) = floor((m * x + (k - 1)) / m)
        (m * x + (k - 1)) / m = x + (k - 1) / m
        floor((floor(m * x) + k - 1) / m) = floor((m * x + (k - 1)) / m) = floor(x + (k - 1) / m)
    sum(1, m, fn(k N+) Z {floor((floor(m * x) + k - 1) / m)}) = sum(1, m, fn(k N+) Z {floor(x + (k - 1) / m)})
    sum(1, m, fn(k N+) Z {floor(x + (k - 1) / m)}) = sum(1, m, fn(k Z) Z {floor(x + (k - 1) / m)})
    claim:
        ? forall j Z:
            0 <= j
            j <= m - 1
            =>:
                floor(x + ((j + 1) - 1) / m) = floor(x + j / m)
        (j + 1) - 1 = j
        floor(x + ((j + 1) - 1) / m) = floor(x + j / m)
    (m - 1) - m = 0 - 1
    sum(1, m, fn(k Z) Z {floor(x + (k - 1) / m)}) = sum(0, m - 1, fn(j Z) Z {floor(x + j / m)})
    0 <= m - 1
    chap2::finite_integer_sum(0, m - 1, fn(k Z) Z {floor(x + k / m)}) = sum(0, m - 1, fn(k Z) Z {floor(x + k / m)})
    floor(m * x) = chap2::finite_integer_sum(0, m - 1, fn(k Z) Z {floor(x + k / m)})

by thm equal_partition_rounding_sums_324_326(37, 5, 1.2)
37 = sum(1, 5, fn(k N+) Z {ceil((37 - k + 1) / 5)})
37 = sum(1, 5, fn(k N+) Z {floor((37 + k - 1) / 5)})
floor(3 * 1.2) = chap2::finite_integer_sum(0, 3 - 1, fn(k Z) Z {floor(1.2 + k / 3)})

# Section 3.5. Floor/Ceiling Sums.
# Equation (3.27). The finite sum is an ordinary checked Litex function. The
# rounded square root is selected in N from its proved nonnegativity, and the
# source's closed form is checked by induction across consecutive squares.
have fn natural_floor_sqrt_327 by exist!:
    ? forall n N:
        exist! value N st {value = floor(sqrt(n))}
    0 <= sqrt(n)
    by thm integer_le_x_gives_integer_le_floor_37d(sqrt(n), 0)
    have rounded Z = floor(sqrt(n))
    0 <= floor(sqrt(n)) = rounded
    rounded $in N
    witness exist value N st {value = floor(sqrt(n))} from rounded
    forall value1, value2 N:
        value1 = floor(sqrt(n))
        value2 = floor(sqrt(n))
        =>:
            value1 = value2

have fn floor_sqrt_prefix_sum_327(n N) N by cases:
    case n = 0: 0
    case n > 0: sum(0, n - 1, fn(k N) N {natural_floor_sqrt_327(k)})

thm floor_sqrt_sum_formula_327:
    ? forall n N:
        floor_sqrt_prefix_sum_327(n) = n * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6
    by induc n from 0:
        ? floor_sqrt_prefix_sum_327(n) = n * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6
        ? from n = 0:
            sqrt(0) = 0
            floor(sqrt(0)) = floor(0) = 0
            natural_floor_sqrt_327(0) = floor(sqrt(0)) = 0
            floor_sqrt_prefix_sum_327(0) = 0 = 0 * natural_floor_sqrt_327(0) - natural_floor_sqrt_327(0)^3 / 3 - natural_floor_sqrt_327(0)^2 / 2 - natural_floor_sqrt_327(0) / 6
        ? induc:
            n + 1 > 0
            (n + 1) - 1 = n
            floor_sqrt_prefix_sum_327(n + 1) = sum(0, (n + 1) - 1, fn(k N) N {natural_floor_sqrt_327(k)})
            sum(0, (n + 1) - 1, fn(k N) N {natural_floor_sqrt_327(k)}) = sum(0, n, fn(k N) N {natural_floor_sqrt_327(k)})
            floor_sqrt_prefix_sum_327(n + 1) = sum(0, n, fn(k N) N {natural_floor_sqrt_327(k)})
            claim:
                ? floor_sqrt_prefix_sum_327(n + 1) = floor_sqrt_prefix_sum_327(n) + natural_floor_sqrt_327(n)
                by cases:
                    ? floor_sqrt_prefix_sum_327(n + 1) = floor_sqrt_prefix_sum_327(n) + natural_floor_sqrt_327(n)
                    case n = 0:
                        floor_sqrt_prefix_sum_327(0) = 0
                        floor_sqrt_prefix_sum_327(1) = sum(0, 0, fn(k N) N {natural_floor_sqrt_327(k)}) = natural_floor_sqrt_327(0) = floor_sqrt_prefix_sum_327(0) + natural_floor_sqrt_327(0)
                    case n > 0:
                        n = (n - 1) + 1
                        floor_sqrt_prefix_sum_327(n) = sum(0, n - 1, fn(k N) N {natural_floor_sqrt_327(k)})
                        fn(k N) N {natural_floor_sqrt_327(k)}(n) = natural_floor_sqrt_327(n)
                        floor_sqrt_prefix_sum_327(n + 1) = sum(0, n, fn(k N) N {natural_floor_sqrt_327(k)}) = sum(0, n - 1, fn(k N) N {natural_floor_sqrt_327(k)}) + fn(k N) N {natural_floor_sqrt_327(k)}(n) = floor_sqrt_prefix_sum_327(n) + natural_floor_sqrt_327(n)
            natural_floor_sqrt_327(n) = floor(sqrt(n))
            natural_floor_sqrt_327(n + 1) = floor(sqrt(n + 1))
            0 <= n
            0 <= n + 1
            n <= n + 1
            sqrt(n) <= sqrt(n + 1)
            floor(sqrt(n)) <= sqrt(n) <= sqrt(n + 1)
            floor(sqrt(n)) $in Z
            by thm integer_le_x_gives_integer_le_floor_37d(sqrt(n + 1), floor(sqrt(n)))
            floor(sqrt(n)) <= floor(sqrt(n + 1))
            sqrt(n + 1)^2 = n + 1
            sqrt(n)^2 = n
            sqrt(n) >= 0
            2 * sqrt(n) >= 0
            (sqrt(n) + 1)^2 = sqrt(n)^2 + 2 * sqrt(n) + 1 = n + 2 * sqrt(n) + 1 >= n + 1
            sqrt(n + 1) >= 0
            sqrt(n) + 1 >= 0
            sqrt(n + 1)^2 = n + 1 <= (sqrt(n) + 1)^2
            sqrt(n + 1) <= sqrt(n) + 1
            sqrt(n) < floor(sqrt(n)) + 1
            sqrt(n) + 1 < floor(sqrt(n)) + 1 + 1 = floor(sqrt(n)) + 2
            sqrt(n + 1) <= sqrt(n) + 1 < floor(sqrt(n)) + 2
            sqrt(n + 1) < floor(sqrt(n)) + 2
            floor(sqrt(n + 1)) $in Z
            floor(sqrt(n)) + 1 $in Z
            by thm x_lt_integer_gives_floor_lt_37a(sqrt(n + 1), floor(sqrt(n)) + 2)
            floor(sqrt(n + 1)) < floor(sqrt(n)) + 2
            floor(sqrt(n + 1)) <= floor(sqrt(n)) + 1
            natural_floor_sqrt_327(n) = floor(sqrt(n)) <= floor(sqrt(n + 1)) = natural_floor_sqrt_327(n + 1)
            natural_floor_sqrt_327(n) <= natural_floor_sqrt_327(n + 1)
            by cases:
                ? floor_sqrt_prefix_sum_327(n + 1) = (n + 1) * natural_floor_sqrt_327(n + 1) - natural_floor_sqrt_327(n + 1)^3 / 3 - natural_floor_sqrt_327(n + 1)^2 / 2 - natural_floor_sqrt_327(n + 1) / 6
                case natural_floor_sqrt_327(n + 1) = natural_floor_sqrt_327(n):
                    floor_sqrt_prefix_sum_327(n + 1) = floor_sqrt_prefix_sum_327(n) + natural_floor_sqrt_327(n) = n * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6 + natural_floor_sqrt_327(n) = (n + 1) * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6 = (n + 1) * natural_floor_sqrt_327(n + 1) - natural_floor_sqrt_327(n + 1)^3 / 3 - natural_floor_sqrt_327(n + 1)^2 / 2 - natural_floor_sqrt_327(n + 1) / 6
                case natural_floor_sqrt_327(n + 1) != natural_floor_sqrt_327(n):
                    natural_floor_sqrt_327(n) != natural_floor_sqrt_327(n + 1)
                    claim:
                        ? natural_floor_sqrt_327(n) < natural_floor_sqrt_327(n + 1)
                        by cases:
                            ? natural_floor_sqrt_327(n) < natural_floor_sqrt_327(n + 1)
                            case natural_floor_sqrt_327(n) < natural_floor_sqrt_327(n + 1):
                                natural_floor_sqrt_327(n) < natural_floor_sqrt_327(n + 1)
                            case natural_floor_sqrt_327(n) >= natural_floor_sqrt_327(n + 1):
                                natural_floor_sqrt_327(n) <= natural_floor_sqrt_327(n + 1) <= natural_floor_sqrt_327(n)
                                natural_floor_sqrt_327(n) = natural_floor_sqrt_327(n + 1)
                                impossible natural_floor_sqrt_327(n) != natural_floor_sqrt_327(n + 1)
                    natural_floor_sqrt_327(n) < natural_floor_sqrt_327(n + 1)
                    natural_floor_sqrt_327(n) < natural_floor_sqrt_327(n + 1) <= natural_floor_sqrt_327(n) + 1
                    natural_floor_sqrt_327(n + 1) = natural_floor_sqrt_327(n) + 1
                    natural_floor_sqrt_327(n) + 1 <= sqrt(n + 1)
                    (natural_floor_sqrt_327(n) + 1)^2 <= sqrt(n + 1)^2 = n + 1
                    sqrt(n) < natural_floor_sqrt_327(n) + 1
                    n = sqrt(n)^2 < (natural_floor_sqrt_327(n) + 1)^2
                    n + 1 <= (natural_floor_sqrt_327(n) + 1)^2
                    n + 1 = (natural_floor_sqrt_327(n) + 1)^2
                    n = (natural_floor_sqrt_327(n) + 1)^2 - 1 = natural_floor_sqrt_327(n)^2 + 2 * natural_floor_sqrt_327(n)
                    floor_sqrt_prefix_sum_327(n + 1) = floor_sqrt_prefix_sum_327(n) + natural_floor_sqrt_327(n) = n * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6 + natural_floor_sqrt_327(n)
                    n * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6 + natural_floor_sqrt_327(n) = (natural_floor_sqrt_327(n)^2 + 2 * natural_floor_sqrt_327(n)) * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6 + natural_floor_sqrt_327(n)
                    (natural_floor_sqrt_327(n)^2 + 2 * natural_floor_sqrt_327(n)) * natural_floor_sqrt_327(n) - natural_floor_sqrt_327(n)^3 / 3 - natural_floor_sqrt_327(n)^2 / 2 - natural_floor_sqrt_327(n) / 6 + natural_floor_sqrt_327(n) = (natural_floor_sqrt_327(n) + 1)^2 * (natural_floor_sqrt_327(n) + 1) - (natural_floor_sqrt_327(n) + 1)^3 / 3 - (natural_floor_sqrt_327(n) + 1)^2 / 2 - (natural_floor_sqrt_327(n) + 1) / 6
                    (natural_floor_sqrt_327(n) + 1)^2 * (natural_floor_sqrt_327(n) + 1) - (natural_floor_sqrt_327(n) + 1)^3 / 3 - (natural_floor_sqrt_327(n) + 1)^2 / 2 - (natural_floor_sqrt_327(n) + 1) / 6 = (n + 1) * (natural_floor_sqrt_327(n) + 1) - (natural_floor_sqrt_327(n) + 1)^3 / 3 - (natural_floor_sqrt_327(n) + 1)^2 / 2 - (natural_floor_sqrt_327(n) + 1) / 6
                    (n + 1) * (natural_floor_sqrt_327(n) + 1) - (natural_floor_sqrt_327(n) + 1)^3 / 3 - (natural_floor_sqrt_327(n) + 1)^2 / 2 - (natural_floor_sqrt_327(n) + 1) / 6 = (n + 1) * natural_floor_sqrt_327(n + 1) - natural_floor_sqrt_327(n + 1)^3 / 3 - natural_floor_sqrt_327(n + 1)^2 / 2 - natural_floor_sqrt_327(n + 1) / 6
                    floor_sqrt_prefix_sum_327(n + 1) = (n + 1) * natural_floor_sqrt_327(n + 1) - natural_floor_sqrt_327(n + 1)^3 / 3 - natural_floor_sqrt_327(n + 1)^2 / 2 - natural_floor_sqrt_327(n + 1) / 6

sqrt(4) = 2
natural_floor_sqrt_327(4) = floor(sqrt(4)) = floor(2) = 2
by thm floor_sqrt_sum_formula_327(4)
floor_sqrt_prefix_sum_327(4) = 4 * natural_floor_sqrt_327(4) - natural_floor_sqrt_327(4)^3 / 3 - natural_floor_sqrt_327(4)^2 / 2 - natural_floor_sqrt_327(4) / 6 = 3

# Equation (3.28). Almost-everywhere continuity and the unit-interval integral
# belong to analysis rather than this integer-functions chapter. They are kept
# as explicit semantic interfaces; the sequence convergence itself is defined
# fully by epsilon and an eventual cutoff.
trust have almost_everywhere_continuous_unit_functions_328 power_set(fn(x R) R)
trust have unit_interval_integral_328 fn(f fn(x R) R) R

prop is_fractional_average_tail_close_328(alpha R, f fn(x R) R, limit R, epsilon R+, cutoff N+):
    forall n N+:
        n >= cutoff
        =>:
            abs(sum(0, n - 1, fn(k N) R {f(fractional_part(k * alpha))}) / n - limit) < epsilon

prop fractional_average_converges_328(alpha R, f fn(x R) R, limit R):
    forall epsilon R+:
        exist cutoff N+ st {$is_fractional_average_tail_close_328(alpha, f, limit, epsilon, cutoff)}

thm bohl_sierpinski_weyl_328:
    ? forall alpha R, f fn(x R) R:
        f $in almost_everywhere_continuous_unit_functions_328
        not alpha $in Q
        =>:
            $fractional_average_converges_328(alpha, f, unit_interval_integral_328(f))
    trust:
        $fractional_average_converges_328(alpha, f, unit_interval_integral_328(f))

# Equation (3.29). The indicator and each finite discrepancy sum are checked.
# The maximum is characterized by an upper-bound fact and an attaining point;
# compactness/attainment is the localized trust boundary.
have fn iverson_lt_real_329(left, right R) N by cases:
    case left < right: 1
    case left >= right: 0

have fn discrepancy_sum_329(alpha R, n N, v '[0, 1]) R by cases:
    case n = 0: 0
    case n > 0: sum(0, n - 1, fn(k N) R {iverson_lt_real_329(fractional_part(k * alpha), v) - v})

prop is_discrepancy_maximum_329(alpha R, n N, value R):
    value >= 0
    forall v '[0, 1]:
        abs(discrepancy_sum_329(alpha, n, v)) <= value
    exist v '[0, 1] st {value = abs(discrepancy_sum_329(alpha, n, v))}

# The source's maximum theorem supplies existence. Its value is unique because
# each candidate is bounded by the other candidate at an attaining point.
have fn discrepancy_329 by exist!:
    ? forall alpha R, n N:
        exist! value R st {$is_discrepancy_maximum_329(alpha, n, value)}
    trust exist maximum R st {$is_discrepancy_maximum_329(alpha, n, maximum)}
    obtain maximum from exist maximum R st {$is_discrepancy_maximum_329(alpha, n, maximum)}
    witness exist value R st {$is_discrepancy_maximum_329(alpha, n, value)} from maximum
    claim:
        ? forall value1, value2 R:
            $is_discrepancy_maximum_329(alpha, n, value1)
            $is_discrepancy_maximum_329(alpha, n, value2)
            =>:
                value1 = value2
        obtain v1 from exist v '[0, 1] st {value1 = abs(discrepancy_sum_329(alpha, n, v))}
        obtain v2 from exist v '[0, 1] st {value2 = abs(discrepancy_sum_329(alpha, n, v))}
        abs(discrepancy_sum_329(alpha, n, v1)) <= value2
        abs(discrepancy_sum_329(alpha, n, v2)) <= value1
        value1 <= value2
        value2 <= value1
        value1 = value2

claim:
    ? forall alpha R, n N:
        discrepancy_329(alpha, n) >= 0
    $is_discrepancy_maximum_329(alpha, n, discrepancy_329(alpha, n))
    by def $is_discrepancy_maximum_329(alpha, n, discrepancy_329(alpha, n))

claim:
    ? forall alpha R, n N, v '[0, 1]:
        abs(discrepancy_sum_329(alpha, n, v)) <= discrepancy_329(alpha, n)
    $is_discrepancy_maximum_329(alpha, n, discrepancy_329(alpha, n))
    by def $is_discrepancy_maximum_329(alpha, n, discrepancy_329(alpha, n))

claim:
    ? forall alpha R, n N:
        exist v '[0, 1] st {discrepancy_329(alpha, n) = abs(discrepancy_sum_329(alpha, n, v))}
    $is_discrepancy_maximum_329(alpha, n, discrepancy_329(alpha, n))
    by def $is_discrepancy_maximum_329(alpha, n, discrepancy_329(alpha, n))

discrepancy_sum_329(2, 0, 0.5) = 0
claim:
    ? $is_discrepancy_maximum_329(2, 0, 0)
    claim:
        ? forall v '[0, 1]:
            abs(discrepancy_sum_329(2, 0, v)) <= 0
        discrepancy_sum_329(2, 0, v) = 0
        abs(discrepancy_sum_329(2, 0, v)) = abs(0) = 0
    witness exist v '[0, 1] st {0 = abs(discrepancy_sum_329(2, 0, v))} from 0.5:
        discrepancy_sum_329(2, 0, 0.5) = 0
        0 = abs(0) = abs(discrepancy_sum_329(2, 0, 0.5))
    by def $is_discrepancy_maximum_329(2, 0, 0)
discrepancy_329(2, 0) = 0

# Equation (3.30). These checked auxiliaries name exactly the source's changed
# variables. The natural-valued ceiling is selected from its nonnegativity; S
# is the omitted-boundary correction, explicitly bounded as in the text.
have fn alpha_prime_330(alpha R+) R = fractional_part(1 / alpha)
have fn ceiling_band_330(alpha R+, v '[0, 1]) Z = ceil(v / alpha)
have fn transformed_v_330(alpha R+, v '[0, 1]) R = ceiling_band_330(alpha, v) - v / alpha

have fn natural_ceil_product_330 by exist!:
    ? forall alpha R+, n N:
        exist! value N st {value = ceil(n * alpha)}
    0 <= n * alpha <= ceil(n * alpha)
    have rounded Z = ceil(n * alpha)
    0 <= ceil(n * alpha) = rounded
    rounded $in N
    witness exist value N st {value = ceil(n * alpha)} from rounded
    forall value1, value2 N:
        value1 = ceil(n * alpha)
        value2 = ceil(n * alpha)
        =>:
            value1 = value2

have fn transformed_ceiling_sum_330(alpha R+, n N, v '[0, 1]) Z = chap2::finite_integer_sum(0, natural_ceil_product_330(alpha, n) - 1, fn(j Z) Z {ceil(j * alpha_prime_330(alpha) - transformed_v_330(alpha, v)) - ceil(j * alpha_prime_330(alpha))})

trust have boundary_correction_330 fn(alpha R+, n N, v '[0, 1]) N
trust forall alpha R+, n N, v '[0, 1]:
    boundary_correction_330(alpha, n, v) <= ceil(v / alpha)

thm discrepancy_transform_330:
    ? forall alpha R+, n N, v '[0, 1]:
        alpha < 1
        not alpha $in Q
        =>:
            discrepancy_sum_329(alpha, n, v) = -n * v + natural_ceil_product_330(alpha, n) * ceiling_band_330(alpha, v) + transformed_ceiling_sum_330(alpha, n, v) - boundary_correction_330(alpha, n, v)
    trust:
        discrepancy_sum_329(alpha, n, v) = -n * v + natural_ceil_product_330(alpha, n) * ceiling_band_330(alpha, v) + transformed_ceiling_sum_330(alpha, n, v) - boundary_correction_330(alpha, n, v)

# Equation (3.31). The rounded recursive index is selected in N from the
# product's proved nonnegativity; the discrepancy estimate is the exact theorem
# in the text.
have fn natural_floor_product_331 by exist!:
    ? forall alpha R+, n N:
        exist! value N st {value = floor(alpha * n)}
    0 <= alpha * n
    by thm integer_le_x_gives_integer_le_floor_37d(alpha * n, 0)
    have rounded Z = floor(alpha * n)
    0 <= floor(alpha * n) = rounded
    rounded $in N
    witness exist value N st {value = floor(alpha * n)} from rounded
    forall value1, value2 N:
        value1 = floor(alpha * n)
        value2 = floor(alpha * n)
        =>:
            value1 = value2

thm discrepancy_recurrence_331:
    ? forall alpha R+, n N:
        alpha < 1
        not alpha $in Q
        =>:
            discrepancy_329(alpha, n) <= discrepancy_329(alpha_prime_330(alpha), natural_floor_product_331(alpha, n)) + 1 / alpha + 2
    trust:
        discrepancy_329(alpha, n) <= discrepancy_329(alpha_prime_330(alpha), natural_floor_product_331(alpha, n)) + 1 / alpha + 2

# Equation (3.32). The finite floor progression is checked. Native gcd facts
# prove the nonzero divisor and the positive-input commutativity needed for the
# final reciprocity law; only the source's closed-form evaluation is trusted.
thm positive_modulus_gcd_332:
    ? forall m N+, n Z:
        gcd(m, n) != 0
    m > 0
    m != 0
    m != 0 or n != 0
    gcd(m, n) $in N+
    gcd(m, n) > 0
    gcd(m, n) != 0

have fn floor_progression_sum_332(m N+, n Z, x R) Z = chap2::finite_integer_sum(0, m - 1, fn(k Z) Z {floor((n * k + x) / m)})

thm floor_progression_sum_formula_332:
    ? forall m N+, n Z, x R:
        floor_progression_sum_332(m, n, x) = gcd(m, n) * floor(x / gcd(m, n)) + (m - 1) * (n - 1) / 2 + (gcd(m, n) - 1) / 2
    by thm positive_modulus_gcd_332(m, n)
    trust:
        floor_progression_sum_332(m, n, x) = gcd(m, n) * floor(x / gcd(m, n)) + (m - 1) * (n - 1) / 2 + (gcd(m, n) - 1) / 2

floor_progression_sum_332(2, 3, 0) = chap2::finite_integer_sum(0, 1, fn(k Z) Z {floor((3 * k + 0) / 2)})
by thm floor_progression_sum_formula_332(2, 3, 0)
floor_progression_sum_332(2, 3, 0) = gcd(2, 3) * floor(0 / gcd(2, 3)) + (2 - 1) * (3 - 1) / 2 + (gcd(2, 3) - 1) / 2 = 1

thm gcd_comm_for_positive_332:
    ? forall m, n N+:
        gcd(m, n) = gcd(n, m)
    gcd(m, n) $in N+
    m % gcd(m, n) = 0
    n % gcd(m, n) = 0
    gcd(m, n) <= gcd(n, m)
    gcd(n, m) $in N+
    n % gcd(n, m) = 0
    m % gcd(n, m) = 0
    gcd(n, m) <= gcd(m, n)
    gcd(m, n) = gcd(n, m)

thm floor_progression_reciprocity_332:
    ? forall m, n N+, x R:
        floor_progression_sum_332(m, n, x) = floor_progression_sum_332(n, m, x)
    by thm floor_progression_sum_formula_332(m, n, x)
    by thm floor_progression_sum_formula_332(n, m, x)
    by thm gcd_comm_for_positive_332(m, n)
    floor_progression_sum_332(m, n, x) = gcd(m, n) * floor(x / gcd(m, n)) + (m - 1) * (n - 1) / 2 + (gcd(m, n) - 1) / 2
    gcd(m, n) * floor(x / gcd(m, n)) + (m - 1) * (n - 1) / 2 + (gcd(m, n) - 1) / 2 = gcd(n, m) * floor(x / gcd(n, m)) + (n - 1) * (m - 1) / 2 + (gcd(n, m) - 1) / 2
    floor_progression_sum_332(n, m, x) = gcd(n, m) * floor(x / gcd(n, m)) + (n - 1) * (m - 1) / 2 + (gcd(n, m) - 1) / 2
