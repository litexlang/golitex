# Chapter 5. Fourier series.

# Definition 5.1.1. A function has period L when translation by L leaves all
# of its values unchanged.
prop is_periodic_with_period(f fn(x R) &chap4::ComplexNumber, L R+):
    forall x R:
        f(x + L) = f(x)

# Example 5.1.2. Sine, cosine, and exp(ix) have period 2*pi; the identity
# function is not periodic, while a constant function has every period.
prop is_example_512_function_data(sine, cosine, exponential, identity, constant fn(x R) &chap4::ComplexNumber):
    forall x R:
        sine(x) = chap4::complex_of_real(chap4::real_sin(x))
        cosine(x) = chap4::complex_of_real(chap4::real_cos(x))
        exponential(x) = chap4::exp_complex(chap4::complex_mul(chap4::imaginary_unit, chap4::complex_of_real(x)))
        identity(x) = chap4::complex_of_real(x)
        constant(x) = chap4::complex_one

prop has_example_512_periodicity_results(sine, cosine, exponential, identity, constant fn(x R) &chap4::ComplexNumber):
    $is_periodic_with_period(sine, 2 * chap4::pi_real)
    $is_periodic_with_period(cosine, 2 * chap4::pi_real)
    $is_periodic_with_period(exponential, 2 * chap4::pi_real)
    not exist L R+ st {$is_periodic_with_period(identity, L)}
    forall L R+:
        $is_periodic_with_period(constant, L)

thm example_512_basic_periodic_functions:
    ? forall sine, cosine, exponential, identity, constant fn(x R) &chap4::ComplexNumber:
        $is_example_512_function_data(sine, cosine, exponential, identity, constant)
        =>:
            $has_example_512_periodicity_results(sine, cosine, exponential, identity, constant)
    # proof_debt: apply the trigonometric and complex-exponential period laws,
    # and compare two translated values of the identity.
    trust $has_example_512_periodicity_results(sine, cosine, exponential, identity, constant)

# Remark 5.1.3. An L-periodic function is invariant under every integer
# multiple of its period.
thm periodic_integer_translation:
    ? forall f fn(x R) &chap4::ComplexNumber, L R+, k Z, x R:
        $is_periodic_with_period(f, L)
        =>:
            f(x + k * L) = f(x)
    # proof_debt: iterate the period law for positive integers and use
    # substitution for negative integers, as in source Remark 5.1.3.
    trust f(x + k * L) = f(x)

# Example 5.1.4. Integer-frequency characters and a square wave are
# one-periodic.
prop is_integer_frequency_example(n Z, cosine, sine, exponential fn(x R) &chap4::ComplexNumber):
    forall x R:
        cosine(x) = chap4::complex_of_real(chap4::real_cos(2 * chap4::pi_real * n * x))
        sine(x) = chap4::complex_of_real(chap4::real_sin(2 * chap4::pi_real * n * x))
        exponential(x) = chap4::exp_complex(chap4::complex_mul(chap4::imaginary_unit, chap4::complex_of_real(2 * chap4::pi_real * n * x)))

prop is_square_wave(square_wave fn(x R) &chap4::ComplexNumber):
    forall x R:
        exist k Z st {k <= x < k + 1 / 2, square_wave(x) = chap4::complex_one} or exist k Z st {k + 1 / 2 <= x < k + 1, square_wave(x) = chap4::complex_zero}

prop has_example_514_periodicity_results(cosine, sine, exponential, square_wave fn(x R) &chap4::ComplexNumber):
    $is_periodic_with_period(cosine, 1)
    $is_periodic_with_period(sine, 1)
    $is_periodic_with_period(exponential, 1)
    $is_periodic_with_period(square_wave, 1)

thm example_514_integer_frequencies_and_square_wave:
    ? forall n Z, cosine, sine, exponential, square_wave fn(x R) &chap4::ComplexNumber:
        $is_integer_frequency_example(n, cosine, sine, exponential)
        $is_square_wave(square_wave)
        =>:
            $has_example_514_periodicity_results(cosine, sine, exponential, square_wave)
    # proof_debt: use integer-frequency trigonometric periodicity and shift
    # the square-wave interval witness by one.
    trust $has_example_514_periodicity_results(cosine, sine, exponential, square_wave)

prop is_continuous_one_periodic(f fn(x R) &chap4::ComplexNumber):
    $is_periodic_with_period(f, 1)
    $chap2::is_metric_continuous(R, &chap4::ComplexNumber, chap1::real_distance, chap4::complex_distance, f)

# Lemma 5.1.5. Continuous one-periodic functions are bounded, closed under the
# complex algebra operations, and closed under uniform limits.
prop is_complex_function_bound(f fn(x R) &chap4::ComplexNumber, M R+):
    forall x R:
        chap4::complex_abs(f(x)) <= M

prop is_pointwise_complex_sum(f, g, h fn(x R) &chap4::ComplexNumber):
    forall x R:
        h(x) = chap4::complex_add(f(x), g(x))

prop is_pointwise_complex_product(f, g, h fn(x R) &chap4::ComplexNumber):
    forall x R:
        h(x) = chap4::complex_mul(f(x), g(x))

prop is_pointwise_complex_difference(f, g, h fn(x R) &chap4::ComplexNumber):
    forall x R:
        h(x) = chap4::complex_add(f(x), chap4::complex_neg(g(x)))

prop is_pointwise_complex_scalar_multiple(c &chap4::ComplexNumber, f, scaled fn(x R) &chap4::ComplexNumber):
    forall x R:
        scaled(x) = chap4::complex_mul(c, f(x))

prop has_continuous_periodic_function_laws(f, sum_function, difference_function, product_function, scaled_function, uniform_limit fn(x R) &chap4::ComplexNumber):
    exist M R+ st {$is_complex_function_bound(f, M)}
    $is_continuous_one_periodic(sum_function)
    $is_continuous_one_periodic(difference_function)
    $is_continuous_one_periodic(product_function)
    $is_continuous_one_periodic(scaled_function)
    $is_continuous_one_periodic(uniform_limit)

thm continuous_periodic_function_laws:
    ? forall f, g, sum_function, difference_function, product_function, scaled_function fn(x R) &chap4::ComplexNumber, scalar &chap4::ComplexNumber, family fn(k N+) fn(x R) &chap4::ComplexNumber, uniform_limit fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        $is_pointwise_complex_sum(f, g, sum_function)
        $is_pointwise_complex_difference(f, g, difference_function)
        $is_pointwise_complex_product(f, g, product_function)
        $is_pointwise_complex_scalar_multiple(scalar, f, scaled_function)
        forall k N+:
            $is_continuous_one_periodic(family(k))
        $chap3::is_uniformly_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, family, uniform_limit)
        =>:
            $has_continuous_periodic_function_laws(f, sum_function, difference_function, product_function, scaled_function, uniform_limit)
    # proof_debt: use compactness on one period and closure of continuity under algebra and uniform limits.
    trust $has_continuous_periodic_function_laws(f, sum_function, difference_function, product_function, scaled_function, uniform_limit)

# Definition 5.2.1. The Hermitian inner product integrates the real and
# imaginary coordinate formulas for f times the conjugate of g.
prop is_complex_function_coordinate_view(f fn(x R) &chap4::ComplexNumber, real_part, imaginary_part fn(x R) R):
    forall x R:
        f(x) = (real_part(x), imaginary_part(x))

prop is_periodic_inner_product_coordinate_data(f, g fn(x R) &chap4::ComplexNumber, f_re, f_im, g_re, g_im fn(x R) R, value &chap4::ComplexNumber):
    $is_complex_function_coordinate_view(f, f_re, f_im)
    $is_complex_function_coordinate_view(g, g_re, g_im)
    $chap3::has_riemann_integral_value('[0, 1], fn(x '[0, 1]) R {f_re(x) * g_re(x) + f_im(x) * g_im(x)}, value.real_part)
    $chap3::has_riemann_integral_value('[0, 1], fn(x '[0, 1]) R {f_im(x) * g_re(x) - f_re(x) * g_im(x)}, value.im)

prop has_periodic_inner_product(f, g fn(x R) &chap4::ComplexNumber, value &chap4::ComplexNumber):
    $is_continuous_one_periodic(f)
    $is_continuous_one_periodic(g)
    exist f_re fn(x R) R, f_im fn(x R) R, g_re fn(x R) R, g_im fn(x R) R st {$is_periodic_inner_product_coordinate_data(f, g, f_re, f_im, g_re, g_im, value)}

have fn periodic_inner_product by exist!:
    ? forall f, g fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        =>:
            exist! value &chap4::ComplexNumber st {$has_periodic_inner_product(f, g, value)}
    # proof_debt: existence follows from the two real coordinate integrals and
    # uniqueness from their integral uniqueness; that bridge is not yet formalized.
    trust exist! value &chap4::ComplexNumber st {$has_periodic_inner_product(f, g, value)}

thm selected_periodic_inner_product_has_value:
    ? forall f, g fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        =>:
            $has_periodic_inner_product(f, g, periodic_inner_product(f, g))

prop is_zero_complex_function(f fn(x R) &chap4::ComplexNumber):
    forall x R:
        f(x) = chap4::complex_zero

prop has_periodic_inner_product_full_laws(f fn(x R) &chap4::ComplexNumber, scalar, fg, gf, ff, fh, gh, sum_fg_h, scaled_f_g, f_sum_gh, f_scaled_g &chap4::ComplexNumber):
    gf = chap4::complex_conjugate(fg)
    ff.im = 0
    ff.real_part >= 0
    ff != chap4::complex_zero or $is_zero_complex_function(f)
    not $is_zero_complex_function(f) or ff = chap4::complex_zero
    sum_fg_h = chap4::complex_add(fh, gh)
    scaled_f_g = chap4::complex_mul(scalar, fg)
    f_sum_gh = chap4::complex_add(fg, fh)
    f_scaled_g = chap4::complex_mul(chap4::complex_conjugate(scalar), fg)

# Lemma 5.2.5. The periodic inner product is Hermitian, positive definite,
# linear in the first variable, and conjugate-linear in the second.
thm periodic_inner_product_laws:
    ? forall f, g, h, sum_fg, sum_gh, scaled_f, scaled_g fn(x R) &chap4::ComplexNumber, scalar, fg, gf, ff, fh, gh, sum_fg_h, scaled_f_g, f_sum_gh, f_scaled_g &chap4::ComplexNumber:
        $is_pointwise_complex_sum(f, g, sum_fg)
        $is_pointwise_complex_sum(g, h, sum_gh)
        $is_pointwise_complex_scalar_multiple(scalar, f, scaled_f)
        $is_pointwise_complex_scalar_multiple(scalar, g, scaled_g)
        $has_periodic_inner_product(f, g, fg)
        $has_periodic_inner_product(g, f, gf)
        $has_periodic_inner_product(f, f, ff)
        $has_periodic_inner_product(f, h, fh)
        $has_periodic_inner_product(g, h, gh)
        $has_periodic_inner_product(sum_fg, h, sum_fg_h)
        $has_periodic_inner_product(scaled_f, g, scaled_f_g)
        $has_periodic_inner_product(f, sum_gh, f_sum_gh)
        $has_periodic_inner_product(f, scaled_g, f_scaled_g)
        =>:
            $has_periodic_inner_product_full_laws(f, scalar, fg, gf, ff, fh, gh, sum_fg_h, scaled_f_g, f_sum_gh, f_scaled_g)
    # proof_debt: apply real integral linearity and complex coordinate identities.
    trust $has_periodic_inner_product_full_laws(f, scalar, fg, gf, ff, fh, gh, sum_fg_h, scaled_f_g, f_sum_gh, f_scaled_g)

# Lemma 5.2.7. The induced L2 norm is non-degenerate and satisfies
# Cauchy--Schwarz, the triangle inequality, Pythagoras, and homogeneity.
prop has_periodic_l2_norm(f fn(x R) &chap4::ComplexNumber, norm R):
    norm >= 0
    exist value &chap4::ComplexNumber st {$has_periodic_inner_product(f, f, value), value.im = 0, norm^2 = value.real_part}

have fn periodic_l2_norm by exist!:
    ? forall f fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        =>:
            exist! norm R st {$has_periodic_l2_norm(f, norm)}
    # proof_debt: select the unique nonnegative square root of the real
    # self-inner-product value.
    trust exist! norm R st {$has_periodic_l2_norm(f, norm)}

thm selected_periodic_l2_norm_has_value:
    ? forall f fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        =>:
            $has_periodic_l2_norm(f, periodic_l2_norm(f))

prop zero_l2_norm_implies_zero_function(f fn(x R) &chap4::ComplexNumber, norm R):
    norm != 0 or $is_zero_complex_function(f)

prop zero_function_implies_zero_l2_norm(f fn(x R) &chap4::ComplexNumber, norm R):
    not $is_zero_complex_function(f) or norm = 0

prop has_periodic_l2_pythagorean_law(inner_product &chap4::ComplexNumber, norm_f, norm_g, norm_sum R):
    inner_product != chap4::complex_zero or norm_sum^2 = norm_f^2 + norm_g^2

prop has_periodic_l2_pair_laws(f, g, sum_function, scaled_function fn(x R) &chap4::ComplexNumber, scalar, inner_product &chap4::ComplexNumber, norm_f, norm_g, norm_sum, norm_scaled R):
    $zero_l2_norm_implies_zero_function(f, norm_f)
    $zero_function_implies_zero_l2_norm(f, norm_f)
    chap4::complex_abs(inner_product) <= norm_f * norm_g
    norm_sum <= norm_f + norm_g
    $has_periodic_l2_pythagorean_law(inner_product, norm_f, norm_g, norm_sum)
    norm_scaled = chap4::complex_abs(scalar) * norm_f

thm periodic_l2_norm_laws:
    ? forall f, g, sum_function, scaled_function fn(x R) &chap4::ComplexNumber, scalar, inner_product &chap4::ComplexNumber, norm_f, norm_g, norm_sum, norm_scaled R:
        $is_pointwise_complex_sum(f, g, sum_function)
        $is_pointwise_complex_scalar_multiple(scalar, f, scaled_function)
        $has_periodic_inner_product(f, g, inner_product)
        $has_periodic_l2_norm(f, norm_f)
        $has_periodic_l2_norm(g, norm_g)
        $has_periodic_l2_norm(sum_function, norm_sum)
        $has_periodic_l2_norm(scaled_function, norm_scaled)
        =>:
            $has_periodic_l2_pair_laws(f, g, sum_function, scaled_function, scalar, inner_product, norm_f, norm_g, norm_sum, norm_scaled)
    # proof_debt: derive Cauchy--Schwarz from positivity, then the remaining norm laws.
    trust $has_periodic_l2_pair_laws(f, g, sum_function, scaled_function, scalar, inner_product, norm_f, norm_g, norm_sum, norm_scaled)

# Definition 5.3.1. The character of frequency n is exp(2 pi i n x).
have fn character(n Z, x R) &chap4::ComplexNumber = chap4::exp_complex(chap4::complex_mul(chap4::imaginary_unit, chap4::complex_of_real(2 * chap4::pi_real * n * x)))

template<n Z>:
    have fn character_function(x R) &chap4::ComplexNumber = character(n, x)

thm character_coordinate_formula:
    ? forall n Z, x R:
        character(n, x) = (chap4::real_cos(2 * chap4::pi_real * n * x), chap4::real_sin(2 * chap4::pi_real * n * x))
    by thm chap4::euler_formula(2 * chap4::pi_real * n * x)
    character(n, x) = chap4::exp_complex(chap4::complex_mul(chap4::imaginary_unit, chap4::complex_of_real(2 * chap4::pi_real * n * x))) = (chap4::real_cos(2 * chap4::pi_real * n * x), chap4::real_sin(2 * chap4::pi_real * n * x))

thm character_is_continuous_one_periodic:
    ? forall n Z:
        $is_continuous_one_periodic(\character_function<n>)
    # proof_debt: combine global trigonometric continuity with integer-period
    # translation at the frequency-scaled angle.
    trust $is_continuous_one_periodic(\character_function<n>)

prop has_character_orthonormality(n, m Z, inner_product &chap4::ComplexNumber, norm R):
    n = m and inner_product = chap4::complex_one or n != m and inner_product = chap4::complex_zero
    norm = 1

# Definition 5.3.2. A trigonometric polynomial has finitely many integer
# frequencies and real coordinate coefficient families.
prop is_trigonometric_polynomial_presentation(f fn(x R) &chap4::ComplexNumber, degree N, coefficient_re, coefficient_im fn(k closed_range(-degree, degree)) R):
    $is_continuous_one_periodic(f)
    forall x R:
        f(x) = (sum(-degree, degree, fn(k closed_range(-degree, degree)) R {coefficient_re(k) * chap4::real_cos(2 * chap4::pi_real * k * x) - coefficient_im(k) * chap4::real_sin(2 * chap4::pi_real * k * x)}), sum(-degree, degree, fn(k closed_range(-degree, degree)) R {coefficient_re(k) * chap4::real_sin(2 * chap4::pi_real * k * x) + coefficient_im(k) * chap4::real_cos(2 * chap4::pi_real * k * x)}))

prop is_trigonometric_polynomial(f fn(x R) &chap4::ComplexNumber):
    exist degree N, coefficient_re fn(k closed_range(-degree, degree)) R, coefficient_im fn(k closed_range(-degree, degree)) R st {$is_trigonometric_polynomial_presentation(f, degree, coefficient_re, coefficient_im)}

# Lemma 5.3.5. Distinct characters are orthogonal and every character has
# L2 norm one.
thm characters_are_orthonormal:
    ? forall n, m Z, inner_product &chap4::ComplexNumber, norm R:
        $has_periodic_inner_product(\character_function<n>, \character_function<m>, inner_product)
        $has_periodic_l2_norm(\character_function<n>, norm)
        =>:
            $has_character_orthonormality(n, m, inner_product, norm)
    trust $has_character_orthonormality(n, m, inner_product, norm)

# Corollary 5.3.6. Inner products with characters recover the coefficients of
# a trigonometric polynomial, and Parseval is a finite coefficient identity.
prop has_trigonometric_polynomial_coefficient_recovery(f fn(x R) &chap4::ComplexNumber, degree N, coefficient_re, coefficient_im fn(k closed_range(-degree, degree)) R, norm R):
    forall k closed_range(-degree, degree):
        $has_periodic_inner_product(f, \character_function<k>, (coefficient_re(k), coefficient_im(k)))
    forall n Z:
        n < -degree or n > degree
        =>:
            $has_periodic_inner_product(f, \character_function<n>, chap4::complex_zero)
    sum(-degree, degree, fn(k closed_range(-degree, degree)) R {chap4::complex_abs((coefficient_re(k), coefficient_im(k)))^2}) = norm^2

thm trigonometric_polynomial_coefficient_recovery:
    ? forall f fn(x R) &chap4::ComplexNumber, degree N, coefficient_re, coefficient_im fn(k closed_range(-degree, degree)) R, norm R:
        $is_trigonometric_polynomial_presentation(f, degree, coefficient_re, coefficient_im)
        $has_periodic_l2_norm(f, norm)
        =>:
            $has_trigonometric_polynomial_coefficient_recovery(f, degree, coefficient_re, coefficient_im, norm)
    # proof_debt: apply character orthogonality term by term and finite Parseval.
    trust $has_trigonometric_polynomial_coefficient_recovery(f, degree, coefficient_re, coefficient_im, norm)

# Definition 5.3.7. A Fourier coefficient is the inner product with the
# corresponding character.
prop has_fourier_coefficient(f fn(x R) &chap4::ComplexNumber, n Z, value &chap4::ComplexNumber):
    $has_periodic_inner_product(f, \character_function<n>, value)

have fn fourier_coefficient by exist!:
    ? forall f fn(x R) &chap4::ComplexNumber, n Z:
        $is_continuous_one_periodic(f)
        =>:
            exist! value &chap4::ComplexNumber st {$has_fourier_coefficient(f, n, value)}
    # proof_debt: connect selected inner-product existence and uniqueness with
    # the already established continuous one-periodicity of each character.
    trust exist! value &chap4::ComplexNumber st {$has_fourier_coefficient(f, n, value)}

thm selected_fourier_coefficient_has_value:
    ? forall f fn(x R) &chap4::ComplexNumber, n Z:
        $is_continuous_one_periodic(f)
        =>:
            $has_fourier_coefficient(f, n, fourier_coefficient(f, n))

# Theorem 5.4.1. Every continuous one-periodic function is uniformly
# approximable by a trigonometric polynomial.
prop is_uniform_complex_approximation(f, P fn(x R) &chap4::ComplexNumber, epsilon R+):
    forall x R:
        chap4::complex_distance(f(x), P(x)) <= epsilon

thm periodic_weierstrass_approximation:
    ? forall f fn(x R) &chap4::ComplexNumber, epsilon R+:
        $is_continuous_one_periodic(f)
        =>:
            exist P fn(x R) &chap4::ComplexNumber st {$is_trigonometric_polynomial(P), $is_uniform_complex_approximation(f, P, epsilon)}
    trust exist P fn(x R) &chap4::ComplexNumber st {$is_trigonometric_polynomial(P), $is_uniform_complex_approximation(f, P, epsilon)}

# Definition 5.4.2. Periodic convolution is characterized by integrating its
# real and imaginary coordinate integrands on one period.
prop is_periodic_convolution_coordinate_data(f, g fn(x R) &chap4::ComplexNumber, f_re, f_im, g_re, g_im fn(x R) R, x R, value &chap4::ComplexNumber):
    $is_complex_function_coordinate_view(f, f_re, f_im)
    $is_complex_function_coordinate_view(g, g_re, g_im)
    $chap3::has_riemann_integral_value('[0, 1], fn(y '[0, 1]) R {f_re(y) * g_re(x - y) - f_im(y) * g_im(x - y)}, value.real_part)
    $chap3::has_riemann_integral_value('[0, 1], fn(y '[0, 1]) R {f_re(y) * g_im(x - y) + f_im(y) * g_re(x - y)}, value.im)

prop has_periodic_convolution_value(f, g fn(x R) &chap4::ComplexNumber, x R, value &chap4::ComplexNumber):
    exist f_re fn(y R) R, f_im fn(y R) R, g_re fn(y R) R, g_im fn(y R) R st {$is_periodic_convolution_coordinate_data(f, g, f_re, f_im, g_re, g_im, x, value)}

prop is_periodic_convolution_function(f, g, convolution fn(x R) &chap4::ComplexNumber):
    forall x R:
        $has_periodic_convolution_value(f, g, x, convolution(x))

have fn periodic_convolution by exist!:
    ? forall f, g fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        =>:
            exist! convolution fn(x R) &chap4::ComplexNumber st {$is_periodic_convolution_function(f, g, convolution)}
    # proof_debt: construct the coordinate integrals pointwise and use their
    # uniqueness plus function extensionality.
    trust exist! convolution fn(x R) &chap4::ComplexNumber st {$is_periodic_convolution_function(f, g, convolution)}

thm selected_periodic_convolution_is_function:
    ? forall f, g fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        =>:
            $is_periodic_convolution_function(f, g, periodic_convolution(f, g))

prop has_periodic_convolution_full_laws(conv_fg, conv_gf, conv_fh, conv_gh, conv_f_sum_gh, conv_sum_fg_h, scaled_conv_fg, conv_scaled_f_g, conv_f_scaled_g fn(x R) &chap4::ComplexNumber):
    $is_continuous_one_periodic(conv_fg)
    forall x R:
        conv_fg(x) = conv_gf(x)
        conv_f_sum_gh(x) = chap4::complex_add(conv_fg(x), conv_fh(x))
        conv_sum_fg_h(x) = chap4::complex_add(conv_fh(x), conv_gh(x))
        scaled_conv_fg(x) = conv_scaled_f_g(x)
        conv_scaled_f_g(x) = conv_f_scaled_g(x)

# Lemma 5.4.4. Periodic convolution is closed, commutative, and bilinear.
thm periodic_convolution_laws:
    ? forall f, g, h, sum_gh, sum_fg, scaled_f, scaled_g, conv_fg, conv_gf, conv_fh, conv_gh, conv_f_sum_gh, conv_sum_fg_h, scaled_conv_fg, conv_scaled_f_g, conv_f_scaled_g fn(x R) &chap4::ComplexNumber, scalar &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        $is_continuous_one_periodic(h)
        $is_pointwise_complex_sum(g, h, sum_gh)
        $is_pointwise_complex_sum(f, g, sum_fg)
        $is_pointwise_complex_scalar_multiple(scalar, f, scaled_f)
        $is_pointwise_complex_scalar_multiple(scalar, g, scaled_g)
        $is_pointwise_complex_scalar_multiple(scalar, conv_fg, scaled_conv_fg)
        $is_periodic_convolution_function(f, g, conv_fg)
        $is_periodic_convolution_function(g, f, conv_gf)
        $is_periodic_convolution_function(f, h, conv_fh)
        $is_periodic_convolution_function(g, h, conv_gh)
        $is_periodic_convolution_function(f, sum_gh, conv_f_sum_gh)
        $is_periodic_convolution_function(sum_fg, h, conv_sum_fg_h)
        $is_periodic_convolution_function(scaled_f, g, conv_scaled_f_g)
        $is_periodic_convolution_function(f, scaled_g, conv_f_scaled_g)
        =>:
            $has_periodic_convolution_full_laws(conv_fg, conv_gf, conv_fh, conv_gh, conv_f_sum_gh, conv_sum_fg_h, scaled_conv_fg, conv_scaled_f_g, conv_f_scaled_g)
    # proof_debt: use periodic changes of variables and linearity of the
    # coordinate Riemann integrals.
    trust $has_periodic_convolution_full_laws(conv_fg, conv_gf, conv_fh, conv_gh, conv_f_sum_gh, conv_sum_fg_h, scaled_conv_fg, conv_scaled_f_g, conv_f_scaled_g)

# The source next computes convolution with one character and then extends the
# identity to every trigonometric polynomial.
thm periodic_convolution_with_character:
    ? forall f fn(x R) &chap4::ComplexNumber, n Z, x R:
        $is_continuous_one_periodic(f)
        =>:
            periodic_convolution(f, \character_function<n>)(x) = chap4::complex_mul(fourier_coefficient(f, n), character(n, x))
    # proof_debt: factor exp(2*pi*i*n*x) out of the coordinate integral.
    trust periodic_convolution(f, \character_function<n>)(x) = chap4::complex_mul(fourier_coefficient(f, n), character(n, x))

thm periodic_convolution_with_trigonometric_polynomial:
    ? forall f, P fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        # The trigonometric-polynomial prop contains this fact, but the
        # selected convolution's domain check needs it before prop unfolding.
        $is_continuous_one_periodic(P)
        $is_trigonometric_polynomial(P)
        =>:
            $is_trigonometric_polynomial(periodic_convolution(f, P))
    # proof_debt: expand P into characters and apply bilinearity together with
    # periodic_convolution_with_character.
    trust $is_trigonometric_polynomial(periodic_convolution(f, P))

# Definition 5.4.5. A periodic approximation to the identity is nonnegative,
# has integral one, and is small away from the integer lattice.
prop is_periodic_approximation_to_identity(kernel fn(x R) &chap4::ComplexNumber, real_kernel fn(x R) R, epsilon R+, delta R):
    $is_continuous_one_periodic(kernel)
    $is_complex_function_coordinate_view(kernel, real_kernel, fn(x R) R {0})
    0 < delta < 1 / 2
    forall x R:
        real_kernel(x) >= 0
    $chap3::has_riemann_integral_value('[0, 1], fn(x '[0, 1]) R {real_kernel(x)}, 1)
    forall x R:
        delta <= abs(x) <= 1 - delta
        =>:
            real_kernel(x) < epsilon

# Lemma 5.4.6. Fejer kernels give trigonometric-polynomial approximations to
# the identity.
thm periodic_approximation_to_identity_exists:
    ? forall epsilon R+, delta R:
        0 < delta < 1 / 2
        =>:
            exist P fn(x R) &chap4::ComplexNumber, p fn(x R) R st {$is_trigonometric_polynomial(P), $is_periodic_approximation_to_identity(P, p, epsilon, delta)}
    trust exist P fn(x R) &chap4::ComplexNumber, p fn(x R) R st {$is_trigonometric_polynomial(P), $is_periodic_approximation_to_identity(P, p, epsilon, delta)}

# Theorem 5.5.1. Symmetric Fourier partial sums converge to a continuous
# periodic function in the L2 metric.
prop has_periodic_l2_distance(f, g fn(x R) &chap4::ComplexNumber, distance R):
    exist difference fn(x R) &chap4::ComplexNumber st {$is_pointwise_complex_difference(f, g, difference), $has_periodic_l2_norm(difference, distance)}

have fn periodic_l2_distance by exist!:
    ? forall f, g fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        =>:
            exist! distance R st {$has_periodic_l2_distance(f, g, distance)}
    # proof_debt: construct the continuous periodic pointwise difference and
    # use uniqueness of its selected L2 norm.
    trust exist! distance R st {$has_periodic_l2_distance(f, g, distance)}

thm selected_periodic_l2_distance_has_value:
    ? forall f, g fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_continuous_one_periodic(g)
        =>:
            $has_periodic_l2_distance(f, g, periodic_l2_distance(f, g))

prop is_l2_convergence_tail(family fn(index N+) fn(x R) &chap4::ComplexNumber, f fn(x R) &chap4::ComplexNumber, epsilon R+, N0 N+):
    forall index N+:
        index >= N0
        =>:
            exist distance R st {$has_periodic_l2_distance(f, family(index), distance), distance < epsilon}

prop is_l2_convergent_to(family fn(index N+) fn(x R) &chap4::ComplexNumber, f fn(x R) &chap4::ComplexNumber):
    forall epsilon R+:
        exist N0 N+ st {$is_l2_convergence_tail(family, f, epsilon, N0)}

prop is_fourier_coefficient_coordinate_family(f fn(x R) &chap4::ComplexNumber, coefficient_re, coefficient_im fn(n Z) R):
    forall n Z:
        $has_fourier_coefficient(f, n, (coefficient_re(n), coefficient_im(n)))

prop is_fourier_coordinate_restriction(coefficient_re, coefficient_im fn(n Z) R, degree N, restricted_re, restricted_im fn(k closed_range(-degree, degree)) R):
    forall k closed_range(-degree, degree):
        restricted_re(k) = coefficient_re(k)
        restricted_im(k) = coefficient_im(k)

prop is_symmetric_fourier_partial_sum(coefficient_re, coefficient_im fn(n Z) R, degree N, partial_sum fn(x R) &chap4::ComplexNumber):
    exist restricted_re fn(k closed_range(-degree, degree)) R, restricted_im fn(k closed_range(-degree, degree)) R st {$is_trigonometric_polynomial_presentation(partial_sum, degree, restricted_re, restricted_im), $is_fourier_coordinate_restriction(coefficient_re, coefficient_im, degree, restricted_re, restricted_im)}

prop is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber):
    forall degree N+:
        $is_symmetric_fourier_partial_sum(coefficient_re, coefficient_im, degree, partial_sums(degree))

prop has_absolutely_summable_symmetric_fourier_coefficients(coefficient_re, coefficient_im fn(n Z) R):
    exist total R st {$chap3::has_real_series_sum(fn(k N+) R {chap4::complex_abs((coefficient_re(k), coefficient_im(k))) + chap4::complex_abs((coefficient_re(-k), coefficient_im(-k)))}, total)}

thm fourier_theorem:
    ? forall f fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        =>:
            exist coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber st {$is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im), $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums), $is_l2_convergent_to(partial_sums, f)}
    # proof_debt: approximate by a trigonometric polynomial and use orthogonality.
    trust exist coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber st {$is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im), $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums), $is_l2_convergent_to(partial_sums, f)}

# Remark 5.5.2. Continuous periodic Fourier series need not converge
# pointwise or uniformly, while additional differentiability restores these
# stronger modes. The source states these facts without proving them.
prop has_complex_derivative_coordinate_data(f fn(x R) &chap4::ComplexNumber, f_re, f_im, derivative_re, derivative_im fn(x R) R):
    $is_complex_function_coordinate_view(f, f_re, f_im)
    forall x R:
        $chap3::has_derivative_at(R, f_re, x, derivative_re(x))
        $chap3::has_derivative_at(R, f_im, x, derivative_im(x))

prop has_continuous_complex_derivative_coordinate_data(f fn(x R) &chap4::ComplexNumber, f_re, f_im, derivative_re, derivative_im fn(x R) R):
    $is_complex_function_coordinate_view(f, f_re, f_im)
    $chap3::has_continuous_derivative_on(R, f_re, derivative_re)
    $chap3::has_continuous_derivative_on(R, f_im, derivative_im)

prop has_continuous_periodic_fourier_pointwise_counterexample():
    exist f fn(x R) &chap4::ComplexNumber, coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber st {$is_continuous_one_periodic(f), $is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im), $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums), not $chap3::is_pointwise_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)}

# Source handling: the original records existence but leaves the result beyond
# the scope of the text.
trust $has_continuous_periodic_fourier_pointwise_counterexample()

prop has_continuous_periodic_fourier_uniform_counterexample():
    exist f fn(x R) &chap4::ComplexNumber, coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber st {$is_continuous_one_periodic(f), $is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im), $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums), not $chap3::is_uniformly_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)}

# Source handling: the original records existence but leaves the result beyond
# the scope of the text.
trust $has_continuous_periodic_fourier_uniform_counterexample()

thm differentiable_periodic_fourier_series_converges_pointwise:
    ? forall f fn(x R) &chap4::ComplexNumber, f_re, f_im, derivative_re, derivative_im fn(x R) R, coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $has_complex_derivative_coordinate_data(f, f_re, f_im, derivative_re, derivative_im)
        $is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im)
        $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums)
        =>:
            $chap3::is_pointwise_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)
    # proof_debt: the source states this regularity theorem without proof.
    trust $chap3::is_pointwise_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)

thm continuously_differentiable_periodic_fourier_series_converges_uniformly:
    ? forall f fn(x R) &chap4::ComplexNumber, f_re, f_im, derivative_re, derivative_im fn(x R) R, coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $has_continuous_complex_derivative_coordinate_data(f, f_re, f_im, derivative_re, derivative_im)
        $is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im)
        $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums)
        =>:
            $chap3::is_uniformly_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)
    # proof_debt: the source states this regularity theorem without proof.
    trust $chap3::is_uniformly_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)

# Theorem 5.5.3. Absolute summability of Fourier coefficients strengthens the
# convergence to uniform convergence.
thm absolutely_summable_fourier_series_converges_uniformly:
    ? forall f fn(x R) &chap4::ComplexNumber, coefficient_re, coefficient_im fn(n Z) R, partial_sums fn(degree N+) fn(x R) &chap4::ComplexNumber:
        $is_continuous_one_periodic(f)
        $is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im)
        $is_symmetric_fourier_partial_sum_family(coefficient_re, coefficient_im, partial_sums)
        $has_absolutely_summable_symmetric_fourier_coefficients(coefficient_re, coefficient_im)
        =>:
            $chap3::is_uniformly_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)
    # proof_debt: apply the Weierstrass M-test, then identify the L2 limit.
    trust $chap3::is_uniformly_convergent_to(R, &chap4::ComplexNumber, chap4::complex_distance, partial_sums, f)

# Theorem 5.5.4. The squared Fourier coefficients are summable and their sum
# equals the squared L2 norm.
prop has_plancherel_energy_identity(coefficient_re, coefficient_im fn(n Z) R, norm R):
    exist total R st {$chap3::has_real_series_sum(fn(k N+) R {chap4::complex_abs((coefficient_re(k), coefficient_im(k)))^2 + chap4::complex_abs((coefficient_re(-k), coefficient_im(-k)))^2}, total), total + chap4::complex_abs((coefficient_re(0), coefficient_im(0)))^2 = norm^2}

thm plancherel_theorem:
    ? forall f fn(x R) &chap4::ComplexNumber, norm R, coefficient_re, coefficient_im fn(n Z) R:
        $is_continuous_one_periodic(f)
        $has_periodic_l2_norm(f, norm)
        $is_fourier_coefficient_coordinate_family(f, coefficient_re, coefficient_im)
        =>:
            $has_plancherel_energy_identity(coefficient_re, coefficient_im, norm)
    # proof_debt: take norms in the L2 convergence of symmetric partial sums.
    trust $has_plancherel_energy_identity(coefficient_re, coefficient_im, norm)
