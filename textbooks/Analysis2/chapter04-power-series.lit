# Chapter 4. Power series.
#
# Natural-number indices include the constant coefficient at index zero.

# Definition 4.1.1 (Formal power series).
have formal_power_series_data set = cart(R, fn(n N) R)

have fn power_series_term(coefficients fn(m N) R, center R, n N, x R) R = coefficients(n) * (x - center)^n

have fn power_series_partial_sum(coefficients fn(m N) R, center R, k N, x R) R = sum(0, k, fn(j closed_range(0, k)) R {coefficients(j) * (x - center)^j})

# Definition 4.1.3 (Radius of convergence). A tagged pair `(0,r)` denotes a
# finite nonnegative value and `(1,0)` denotes positive infinity.
have nonnegative_reals set = {r R: r >= 0}
have power_series_radius set = union(cart({0}, nonnegative_reals), {(1, 0)})

prop is_power_series_coefficient_root_sequence(coefficients fn(n N) R, roots fn(n N+) R):
    forall n N+:
        roots(n) >= 0
        roots(n)^n = abs(coefficients(n))

prop is_eventual_nonnegative_sequence_upper_bound(sequence fn(n N+) R, value R, epsilon R+, N0 N+):
    forall n N+:
        n >= N0
        =>:
            sequence(n) <= value + epsilon

prop is_finite_nonnegative_sequence_limsup(sequence fn(n N+) R, value nonnegative_reals):
    forall epsilon R+:
        exist N0 N+ st {$is_eventual_nonnegative_sequence_upper_bound(sequence, value, epsilon, N0)}
    forall epsilon R+, N0 N+:
        exist n N+ st {n >= N0, sequence(n) >= value - epsilon}

prop is_positive_infinite_nonnegative_sequence_limsup(sequence fn(n N+) R):
    forall bound R, N0 N+:
        exist n N+ st {n >= N0, sequence(n) > bound}

prop is_tagged_nonnegative_sequence_limsup(sequence fn(n N+) R, value power_series_radius):
    forall finite_value nonnegative_reals:
        value = (0, finite_value)
        =>:
            $is_finite_nonnegative_sequence_limsup(sequence, finite_value)
    forall infinite_tag {(1, 0)}:
        value = infinite_tag
        =>:
            $is_positive_infinite_nonnegative_sequence_limsup(sequence)

prop is_reciprocal_extended_nonnegative(limsup_value, radius power_series_radius):
    forall finite_value nonnegative_reals:
        limsup_value = (0, finite_value)
        finite_value = 0
        =>:
            radius = (1, 0)
    forall finite_value nonnegative_reals:
        limsup_value = (0, finite_value)
        finite_value > 0
        =>:
            exist reciprocal nonnegative_reals st {radius = (0, reciprocal), finite_value * reciprocal = 1}
    forall infinite_tag {(1, 0)}:
        limsup_value = infinite_tag
        =>:
            radius = (0, 0)

prop is_radius_of_convergence(coefficients fn(n N) R, radius power_series_radius):
    exist roots fn(n N+) R, limsup_value power_series_radius st {$is_power_series_coefficient_root_sequence(coefficients, roots), $is_tagged_nonnegative_sequence_limsup(roots, limsup_value), $is_reciprocal_extended_nonnegative(limsup_value, radius)}

# Theorem 4.1.6 (convergence, uniform convergence, differentiation, and
# integration within the radius).
prop has_power_series_sum(coefficients fn(m N) R, center, x, L R):
    $chap1::has_metric_limit(R, chap1::real_distance, fn(k N+) R {power_series_partial_sum(coefficients, center, k, x)}, L)

prop is_power_series_absolutely_convergent_at(coefficients fn(m N) R, center, x R):
    exist L R st {$chap1::has_metric_limit(R, chap1::real_distance, fn(k N+) R {sum(0, k, fn(j closed_range(0, k)) R {abs(coefficients(j) * (x - center)^j)})}, L)}

prop is_power_series_divergent_at(coefficients fn(m N) R, center, x R):
    not exist L R st {$has_power_series_sum(coefficients, center, x, L)}

prop is_power_series_uniform_tail(coefficients fn(m N) R, center R, I power_set(R), f fn(x I) R, epsilon R+, N0 N+):
    forall k N+, x I:
        k >= N0
        =>:
            abs(power_series_partial_sum(coefficients, center, k, x) - f(x)) < epsilon

prop is_power_series_uniformly_convergent_on(coefficients fn(m N) R, center R, I power_set(R), f fn(x I) R):
    forall epsilon R+:
        exist N0 N+ st {$is_power_series_uniform_tail(coefficients, center, I, f, epsilon, N0)}

thm power_series_diverges_outside_finite_radius:
    ? forall coefficients fn(m N) R, center, radius, x R:
        radius >= 0
        $is_radius_of_convergence(coefficients, (0, radius))
        abs(x - center) > radius
        =>:
            $is_power_series_divergent_at(coefficients, center, x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $is_power_series_divergent_at(coefficients, center, x)

thm power_series_converges_absolutely_inside_finite_radius:
    ? forall coefficients fn(m N) R, center, radius, x R:
        radius >= 0
        $is_radius_of_convergence(coefficients, (0, radius))
        abs(x - center) < radius
        =>:
            $is_power_series_absolutely_convergent_at(coefficients, center, x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $is_power_series_absolutely_convergent_at(coefficients, center, x)

thm power_series_uniformly_converges_on_compact_subinterval:
    ? forall coefficients fn(m N) R, center, radius, r R+, f fn(x '[center - r, center + r]) R:
        radius > r
        $is_radius_of_convergence(coefficients, (0, radius))
        forall x '[center - r, center + r]:
            $has_power_series_sum(coefficients, center, x, f(x))
        =>:
            $is_power_series_uniformly_convergent_on(coefficients, center, '[center - r, center + r], f)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $is_power_series_uniformly_convergent_on(coefficients, center, '[center - r, center + r], f)

prop has_termwise_derivative_power_series(coefficients fn(m N) R, center, radius R+, derivative fn(x '(center - radius, center + radius)) R):
    forall x '(center - radius, center + radius):
        $has_power_series_sum(fn(n N) R {(n + 1) * coefficients(n + 1)}, center, x, derivative(x))

prop is_power_series_derivative_restriction(center R, r, radius R+, derivative fn(x '(center - radius, center + radius)) R, restricted_derivative fn(x '[center - r, center + r]) R):
    r < radius
    '[center - r, center + r] $subset '(center - radius, center + radius)
    forall x '[center - r, center + r]:
        x $in '(center - radius, center + radius)
        restricted_derivative(x) = derivative(x)

prop has_power_series_derivative_conclusions(coefficients fn(m N) R, center, radius R+, f, derivative fn(x '(center - radius, center + radius)) R):
    $chap3::has_continuous_derivative_on('(center - radius, center + radius), f, derivative)
    $has_termwise_derivative_power_series(coefficients, center, radius, derivative)
    forall r R+:
        r < radius
        =>:
            exist restricted_derivative fn(x '[center - r, center + r]) R st {$is_power_series_derivative_restriction(center, r, radius, derivative, restricted_derivative), $is_power_series_uniformly_convergent_on(fn(n N) R {(n + 1) * coefficients(n + 1)}, center, '[center - r, center + r], restricted_derivative)}

thm power_series_may_be_differentiated_termwise:
    ? forall coefficients fn(m N) R, center, radius R+, f fn(x '(center - radius, center + radius)) R:
        $is_radius_of_convergence(coefficients, (0, radius))
        forall x '(center - radius, center + radius):
            $has_power_series_sum(coefficients, center, x, f(x))
        =>:
            exist derivative fn(x '(center - radius, center + radius)) R st {$has_power_series_derivative_conclusions(coefficients, center, radius, f, derivative)}
    # proof_debt: apply the uniform derivative limit theorem to the partial
    # sums and control the derived series on every smaller closed interval.
    trust exist derivative fn(x '(center - radius, center + radius)) R st {$has_power_series_derivative_conclusions(coefficients, center, radius, f, derivative)}

prop is_power_series_function_restriction(center R, radius R+, y, z R, f fn(x '(center - radius, center + radius)) R, restricted_f fn(x '[y, z]) R):
    y <= z
    '[y, z] $subset '(center - radius, center + radius)
    forall x '[y, z]:
        x $in '(center - radius, center + radius)
        restricted_f(x) = f(x)

prop is_integrated_power_series_coefficient_family(coefficients, integrated_coefficients fn(m N) R, center, y, z R):
    forall n N:
        (n + 1) * integrated_coefficients(n) = coefficients(n) * ((z - center)^(n + 1) - (y - center)^(n + 1))

prop has_power_series_integral_conclusions(coefficients fn(m N) R, center R, radius R+, y, z R, f fn(x '(center - radius, center + radius)) R, restricted_f fn(x '[y, z]) R, integrated_coefficients fn(m N) R, A R):
    $is_power_series_function_restriction(center, radius, y, z, f, restricted_f)
    $chap3::has_riemann_integral_value('[y, z], restricted_f, A)
    $is_integrated_power_series_coefficient_family(coefficients, integrated_coefficients, center, y, z)
    $has_power_series_sum(integrated_coefficients, 0, 1, A)

thm power_series_may_be_integrated_termwise:
    ? forall coefficients fn(m N) R, center R, radius R+, y, z R, f fn(x '(center - radius, center + radius)) R:
        $is_radius_of_convergence(coefficients, (0, radius))
        y <= z
        '[y, z] $subset '(center - radius, center + radius)
        forall x '(center - radius, center + radius):
            $has_power_series_sum(coefficients, center, x, f(x))
        =>:
            exist restricted_f fn(x '[y, z]) R, integrated_coefficients fn(m N) R, A R st {$has_power_series_integral_conclusions(coefficients, center, radius, y, z, f, restricted_f, integrated_coefficients, A)}
    # proof_debt: integrate the uniformly convergent power-series partial sums
    # on the closed interval and pass the finite integral formula to the limit.
    trust exist restricted_f fn(x '[y, z]) R, integrated_coefficients fn(m N) R, A R st {$has_power_series_integral_conclusions(coefficients, center, radius, y, z, f, restricted_f, integrated_coefficients, A)}

# Definition 4.2.1 (Real analytic functions).
prop is_power_series_expansion_on(E power_set(R), f fn(x E) R, center R, r R+, coefficients fn(n N) R):
    '(center - r, center + r) $subset E
    forall x '(center - r, center + r):
        $has_power_series_sum(coefficients, center, x, f(x))

prop is_real_analytic_at(E power_set(R), f fn(x E) R, center E):
    $chap1::is_metric_interior_point(R, chap1::real_distance, E, center)
    exist r R+, coefficients fn(n N) R st {$is_power_series_expansion_on(E, f, center, r, coefficients)}

prop is_real_analytic_on(E power_set(R), f fn(x E) R):
    $chap1::is_metric_open(R, chap1::real_distance, E)
    forall center E:
        $is_real_analytic_at(E, f, center)

# Definition 4.2.4 (k-times differentiability). Analysis II uses the
# canonical typed calculus boundary introduced in Chapter 3 rather than a
# second untyped derivative placeholder.
prop has_derivative_on(E power_set(R), f, derivative fn(x E) R):
    $chap3::has_continuous_derivative_on(E, f, derivative)

prop is_derivative_tower(E power_set(R), f fn(x E) R, derivatives fn(k N) fn(x E) R, order N):
    forall x E:
        derivatives(0)(x) = f(x)
    forall k N:
        k < order
        =>:
            $has_derivative_on(E, derivatives(k), derivatives(k + 1))

prop is_k_times_differentiable(E power_set(R), f fn(x E) R, order N):
    exist derivatives fn(k N) fn(x E) R st {$is_derivative_tower(E, f, derivatives, order)}

prop is_infinitely_differentiable(E power_set(R), f fn(x E) R):
    forall order N:
        $is_k_times_differentiable(E, f, order)

# Proposition 4.2.6 (Real analytic functions are k-times differentiable).
have fn factorial_real(n N) R by induc n from 0:
    case n = 0: 1
    case n > 0: n * factorial_real(n - 1)

prop has_analytic_derivative_coefficients(coefficients fn(m N) R, derivative_coefficients fn(p cart(N, N)) R):
    forall order, n N:
        factorial_real(n) * derivative_coefficients((order, n)) = coefficients(n + order) * factorial_real(n + order)

prop has_analytic_derivative_expansions(center R, radius R+, derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R):
    forall order N, x '(center - radius, center + radius):
        $has_power_series_sum(fn(n N) R {derivative_coefficients((order, n))}, center, x, derivatives(order)(x))

prop has_full_analytic_derivative_data(center R, radius R+, f fn(x '(center - radius, center + radius)) R, coefficients fn(n N) R, derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R):
    forall order N:
        $is_derivative_tower('(center - radius, center + radius), f, derivatives, order)
    $has_analytic_derivative_coefficients(coefficients, derivative_coefficients)
    $has_analytic_derivative_expansions(center, radius, derivatives, derivative_coefficients)

thm real_analytic_functions_are_k_times_differentiable:
    ? forall center R, radius R+, f fn(x '(center - radius, center + radius)) R, coefficients fn(n N) R:
        forall x '(center - radius, center + radius):
            $has_power_series_sum(coefficients, center, x, f(x))
        =>:
            exist derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R st {$has_full_analytic_derivative_data(center, radius, f, coefficients, derivatives, derivative_coefficients)}
    # proof_debt: construct the derivative family by repeated termwise
    # differentiation and prove the factorial coefficient formula.
    trust exist derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R st {$has_full_analytic_derivative_data(center, radius, f, coefficients, derivatives, derivative_coefficients)}

# Corollary 4.2.7 (Real analytic functions are infinitely differentiable).
prop has_analytic_derivative_family(E power_set(R), derivatives fn(k N) fn(x E) R):
    forall order N:
        $is_real_analytic_on(E, derivatives(order))

prop has_full_global_analytic_derivative_data(E power_set(R), f fn(x E) R, derivatives fn(k N) fn(x E) R):
    forall x E:
        derivatives(0)(x) = f(x)
    forall order N:
        $is_derivative_tower(E, f, derivatives, order)
    $is_infinitely_differentiable(E, f)
    $has_analytic_derivative_family(E, derivatives)

thm real_analytic_functions_are_infinitely_differentiable:
    ? forall E power_set(R), f fn(x E) R:
        $is_real_analytic_on(E, f)
        =>:
            exist derivatives fn(k N) fn(x E) R st {$has_full_global_analytic_derivative_data(E, f, derivatives)}
    # proof_debt: patch the local derivative families from Proposition 4.2.6
    # over the open domain and prove that every resulting derivative is analytic.
    trust exist derivatives fn(k N) fn(x E) R st {$has_full_global_analytic_derivative_data(E, f, derivatives)}

# Corollary 4.2.10 (Taylor's formula).
prop has_taylor_coefficients(center R, radius R+, coefficients fn(n N) R, derivatives fn(k N) fn(x '(center - radius, center + radius)) R):
    forall k N:
        derivatives(k)(center) = factorial_real(k) * coefficients(k)

prop has_taylor_formula_data(center R, radius R+, f fn(x '(center - radius, center + radius)) R, coefficients fn(n N) R, derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R):
    $has_full_analytic_derivative_data(center, radius, f, coefficients, derivatives, derivative_coefficients)
    $has_taylor_coefficients(center, radius, coefficients, derivatives)

thm analytic_power_series_has_taylor_coefficients:
    ? forall coefficients fn(n N) R, center R, radius R+, f fn(x '(center - radius, center + radius)) R:
        forall x '(center - radius, center + radius):
            $has_power_series_sum(coefficients, center, x, f(x))
        =>:
            exist derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R st {$has_taylor_formula_data(center, radius, f, coefficients, derivatives, derivative_coefficients)}
    # proof_debt: construct the derivative data from Proposition 4.2.6 and
    # evaluate each derivative power series at the center.
    trust exist derivatives fn(k N) fn(x '(center - radius, center + radius)) R, derivative_coefficients fn(p cart(N, N)) R st {$has_taylor_formula_data(center, radius, f, coefficients, derivatives, derivative_coefficients)}

# Corollary 4.2.12 (Uniqueness of power series).
thm analytic_power_series_coefficients_are_unique:
    ? forall E power_set(R), center E, f fn(x E) R, coefficients1, coefficients2 fn(k N) R, radius1, radius2 R+, n N:
        $chap1::is_metric_interior_point(R, chap1::real_distance, E, center)
        '(center - radius1, center + radius1) $subset E
        '(center - radius2, center + radius2) $subset E
        forall x '(center - radius1, center + radius1):
            $has_power_series_sum(coefficients1, center, x, f(x))
        forall x '(center - radius2, center + radius2):
            $has_power_series_sum(coefficients2, center, x, f(x))
        =>:
            coefficients1(n) = coefficients2(n)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust coefficients1(n) = coefficients2(n)

# Theorem 4.3.1 (Abel's theorem). The interval domain determines the side
# from which the endpoint is approached; the limiting relation itself reuses
# Chapter 3's concrete metric function-limit interface.
prop has_left_limit_at(E power_set(R), f fn(x E) R, endpoint, L R):
    $chap3::has_function_limit(R, R, chap1::real_distance, chap1::real_distance, E, f, endpoint, L)

prop has_right_limit_at(E power_set(R), f fn(x E) R, endpoint, L R):
    $chap3::has_function_limit(R, R, chap1::real_distance, chap1::real_distance, E, f, endpoint, L)

thm abel_theorem_at_right_endpoint:
    ? forall coefficients fn(n N) R, center R, radius R+, f fn(x '(center - radius, center + radius)) R, endpoint_sum R:
        $is_radius_of_convergence(coefficients, (0, radius))
        forall x '(center - radius, center + radius):
            $has_power_series_sum(coefficients, center, x, f(x))
        $has_power_series_sum(coefficients, center, center + radius, endpoint_sum)
        =>:
            $has_left_limit_at('(center - radius, center + radius), f, center + radius, endpoint_sum)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_left_limit_at('(center - radius, center + radius), f, center + radius, endpoint_sum)

thm abel_theorem_at_left_endpoint:
    ? forall coefficients fn(n N) R, center R, radius R+, f fn(x '(center - radius, center + radius)) R, endpoint_sum R:
        $is_radius_of_convergence(coefficients, (0, radius))
        forall x '(center - radius, center + radius):
            $has_power_series_sum(coefficients, center, x, f(x))
        $has_power_series_sum(coefficients, center, center - radius, endpoint_sum)
        =>:
            $has_right_limit_at('(center - radius, center + radius), f, center - radius, endpoint_sum)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_right_limit_at('(center - radius, center + radius), f, center - radius, endpoint_sum)

# Lemma 4.3.2 (Summation by parts).
prop has_zero_indexed_series_sum(sequence fn(n N) R, L R):
    $chap1::has_metric_limit(R, chap1::real_distance, fn(k N+) R {sum(0, k, fn(j closed_range(0, k)) R {sequence(j)})}, L)

thm summation_by_parts:
    ? forall a, b fn(n N) R, A, B, left_sum R:
        $chap1::has_metric_limit(R, chap1::real_distance, fn(n N+) R {a(n)}, A)
        $chap1::has_metric_limit(R, chap1::real_distance, fn(n N+) R {b(n)}, B)
        $has_zero_indexed_series_sum(fn(n N) R {(a(n + 1) - a(n)) * b(n)}, left_sum)
        =>:
            $has_zero_indexed_series_sum(fn(n N) R {a(n + 1) * (b(n + 1) - b(n))}, A * B - a(0) * b(0) - left_sum)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_zero_indexed_series_sum(fn(n N) R {a(n + 1) * (b(n + 1) - b(n))}, A * B - a(0) * b(0) - left_sum)

# Theorem 4.4.1 (Products of analytic power series).
have fn power_series_convolution(c, d fn(k N) R, n N) R = sum(0, n, fn(m closed_range(0, n)) R {c(m) * d(n - m)})

prop has_analytic_power_series_product_conclusions(center R, radius R+, c, d fn(n N) R, f, g fn(x '(center - radius, center + radius)) R):
    $is_real_analytic_on('(center - radius, center + radius), fn(x '(center - radius, center + radius)) R {f(x) * g(x)})
    forall x '(center - radius, center + radius):
        $has_power_series_sum(fn(n N) R {power_series_convolution(c, d, n)}, center, x, f(x) * g(x))

thm product_of_analytic_power_series:
    ? forall center R, radius R+, c, d fn(n N) R, f, g fn(x '(center - radius, center + radius)) R:
        $is_real_analytic_on('(center - radius, center + radius), f)
        $is_real_analytic_on('(center - radius, center + radius), g)
        forall x '(center - radius, center + radius):
            $has_power_series_sum(c, center, x, f(x))
            $has_power_series_sum(d, center, x, g(x))
        =>:
            $has_analytic_power_series_product_conclusions(center, radius, c, d, f, g)
    # proof_debt: use absolute convergence to justify the Cauchy product and
    # prove analyticity of the resulting product function on the interval.
    trust $has_analytic_power_series_product_conclusions(center, radius, c, d, f, g)

# Definition 4.5.1 (Exponential function).
prop is_exponential_coefficient(n N, c R):
    factorial_real(n) * c = 1

have fn exponential_coefficient by exist!:
    ? forall n N:
        exist! c R st {$is_exponential_coefficient(n, c)}
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exist! c R st {$is_exponential_coefficient(n, c)}

have fn exp_real by exist!:
    ? forall x R:
        exist! L R st {$has_power_series_sum(fn(n N) R {exponential_coefficient(n)}, 0, x, L)}
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exist! L R st {$has_power_series_sum(fn(n N) R {exponential_coefficient(n)}, 0, x, L)}

# Theorem 4.5.2 (Basic properties of exponential).
thm exponential_basic_properties:
    ? forall x, y R:
        $is_radius_of_convergence(fn(n N) R {exponential_coefficient(n)}, (1, 0))
        $is_power_series_absolutely_convergent_at(fn(n N) R {exponential_coefficient(n)}, 0, x)
        $has_power_series_sum(fn(n N) R {exponential_coefficient(n)}, 0, x, exp_real(x))
        $is_real_analytic_on(R, fn(t R) R {exp_real(t)})
        $has_derivative_on(R, fn(t R) R {exp_real(t)}, fn(t R) R {exp_real(t)})
        $chap2::is_metric_continuous(R, R, chap1::real_distance, chap1::real_distance, fn(t R) R {exp_real(t)})
        exp_real(x + y) = exp_real(x) * exp_real(y)
        exp_real(0) = 1
        exp_real(x) > 0
        exp_real(-x) = 1 / exp_real(x)
    # proof_debt: show the reciprocal-factorial coefficients have infinite radius.
    trust $is_radius_of_convergence(fn(n N) R {exponential_coefficient(n)}, (1, 0))
    # proof_debt: prove absolute convergence of the exponential series at x.
    trust $is_power_series_absolutely_convergent_at(fn(n N) R {exponential_coefficient(n)}, 0, x)
    # proof_debt: connect the selected exponential value to its series sum.
    trust $has_power_series_sum(fn(n N) R {exponential_coefficient(n)}, 0, x, exp_real(x))
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $is_real_analytic_on(R, fn(t R) R {exp_real(t)})
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_derivative_on(R, fn(t R) R {exp_real(t)}, fn(t R) R {exp_real(t)})
    # proof_debt: derive continuity from differentiability.
    trust $chap2::is_metric_continuous(R, R, chap1::real_distance, chap1::real_distance, fn(t R) R {exp_real(t)})
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
