thm real_implies_conjugation_fixed:
    ? forall z &ComplexNumber:
        $is_real_complex(z)
        =>:
            complex_conjugate(z) = z
    # proof_debt: struct-valued function unfolding does not bridge the
    # zero-imaginary coordinate computation back to z.
    trust complex_conjugate(z) = z

# Definition 4.6.10 (Complex absolute value).
have fn complex_abs(z &ComplexNumber) R = sqrt(z.real_part^2 + z.im^2)

# Lemma 4.6.11 (Properties of complex absolute value).
thm complex_absolute_value_laws:
    ? forall z, w &ComplexNumber:
        complex_abs(z) >= 0
        complex_mul(z, complex_conjugate(z)) = complex_of_real(complex_abs(z)^2)
        complex_abs(complex_mul(z, w)) = complex_abs(z) * complex_abs(w)
        complex_abs(complex_conjugate(z)) = complex_abs(z)
        -complex_abs(z) <= z.real_part
        z.real_part <= complex_abs(z)
        -complex_abs(z) <= z.im
        z.im <= complex_abs(z)
        complex_abs(z) <= abs(z.real_part) + abs(z.im)
        complex_abs(complex_add(z, w)) <= complex_abs(z) + complex_abs(w)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust complex_abs(z) >= 0
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust complex_mul(z, complex_conjugate(z)) = complex_of_real(complex_abs(z)^2)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust complex_abs(complex_mul(z, w)) = complex_abs(z) * complex_abs(w)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust complex_abs(complex_conjugate(z)) = complex_abs(z)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust -complex_abs(z) <= z.real_part
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust z.real_part <= complex_abs(z)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust -complex_abs(z) <= z.im
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust z.im <= complex_abs(z)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust complex_abs(z) <= abs(z.real_part) + abs(z.im)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust complex_abs(complex_add(z, w)) <= complex_abs(z) + complex_abs(w)

thm complex_absolute_value_zero:
    ? forall z &ComplexNumber:
        complex_abs(z) = 0
        =>:
            z = complex_zero
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust z = complex_zero

thm complex_zero_has_absolute_value_zero:
    ? forall z &ComplexNumber:
        z = complex_zero
        =>:
            complex_abs(z) = 0
    # proof_debt: struct equality does not yet expose both zero coordinates
