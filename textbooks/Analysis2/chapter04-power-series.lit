    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_complex_quotient_limit(z, w, limit_z, limit_w)

# Definition 4.6.15 (Complex exponential).
have fn complex_power(z &ComplexNumber, n N) &ComplexNumber by induc n from 0:
    case n = 0: complex_one
    case n > 0: complex_mul(z, complex_power(z, n - 1))

prop is_complex_exponential_coordinate_data(z &ComplexNumber, data fn(entry cart(N, closed_range(0, 3))) R):
    data((0, 0)) = 1
    data((0, 1)) = 0
    data((0, 2)) = 1
    data((0, 3)) = 0
    forall n N+:
        data((n, 0)) = z.real_part * data((n - 1, 0)) - z.im * data((n - 1, 1))
        data((n, 1)) = z.real_part * data((n - 1, 1)) + z.im * data((n - 1, 0))
        factorial_real(n) * (data((n, 2)) - data((n - 1, 2))) = data((n, 0))
        factorial_real(n) * (data((n, 3)) - data((n - 1, 3))) = data((n, 1))

prop is_complex_exponential_partial_sum_view(data fn(entry cart(N, closed_range(0, 3))) R, partial_sums fn(n N+) &ComplexNumber):
    forall n N+:
        partial_sums(n) = (data((n, 2)), data((n, 3)))

prop has_complex_exponential_series_sum(z, L &ComplexNumber):
    exist data fn(entry cart(N, closed_range(0, 3))) R, partial_sums fn(n N+) &ComplexNumber st {$is_complex_exponential_coordinate_data(z, data), $is_complex_exponential_partial_sum_view(data, partial_sums), $chap1::has_metric_limit(&ComplexNumber, complex_distance, partial_sums, L)}

have fn exp_complex by exist!:
    ? forall z &ComplexNumber:
        exist! L &ComplexNumber st {$has_complex_exponential_series_sum(z, L)}
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exist! L &ComplexNumber st {$has_complex_exponential_series_sum(z, L)}

# Definition 4.7.1 (Trigonometric functions).
have fn complex_scale(a R, z &ComplexNumber) &ComplexNumber = (a * z.real_part, a * z.im)
have fn complex_cos(z &ComplexNumber) &ComplexNumber = complex_scale(1 / 2, complex_add(exp_complex(complex_mul(imaginary_unit, z)), exp_complex(complex_neg(complex_mul(imaginary_unit, z)))))
have fn complex_sin(z &ComplexNumber) &ComplexNumber = complex_mul((0, -1 / 2), complex_add(exp_complex(complex_mul(imaginary_unit, z)), complex_neg(exp_complex(complex_neg(complex_mul(imaginary_unit, z))))))

prop is_real_cosine_value(x, y R):
    y = &ComplexNumber{exp_complex(complex_mul(imaginary_unit, complex_of_real(x)))}.real_part

prop is_real_sine_value(x, y R):
    y = &ComplexNumber{exp_complex(complex_mul(imaginary_unit, complex_of_real(x)))}.im

have fn real_cos by exist!:
    ? forall x R:
        exist! y R st {$is_real_cosine_value(x, y)}
    # proof_debt: the concrete coordinate graph is defined, but the verifier
    # does not propagate the R-valued field type through exp_complex.
    trust exist! y R st {$is_real_cosine_value(x, y)}

have fn real_sin by exist!:
    ? forall x R:
        exist! y R st {$is_real_sine_value(x, y)}
    # proof_debt: the concrete coordinate graph is defined, but the verifier
    # does not propagate the R-valued field type through exp_complex.
    trust exist! y R st {$is_real_sine_value(x, y)}

prop is_cosine_taylor_coefficient(n N, c R):
    exist k N st {n = 2 * k, factorial_real(n) * c = (-1)^k} or not exist k N st {n = 2 * k} and c = 0

have fn cosine_taylor_coefficient by exist!:
    ? forall n N:
        exist! c R st {$is_cosine_taylor_coefficient(n, c)}
    # proof_debt: parity decomposition and reciprocal-factorial uniqueness are
    # not yet available as a reusable checked interface.
    trust exist! c R st {$is_cosine_taylor_coefficient(n, c)}

prop is_sine_taylor_coefficient(n N, c R):
    exist k N st {n = 2 * k + 1, factorial_real(n) * c = (-1)^k} or not exist k N st {n = 2 * k + 1} and c = 0

have fn sine_taylor_coefficient by exist!:
    ? forall n N:
        exist! c R st {$is_sine_taylor_coefficient(n, c)}
    # proof_debt: parity decomposition and reciprocal-factorial uniqueness are
    # not yet available as a reusable checked interface.
    trust exist! c R st {$is_sine_taylor_coefficient(n, c)}

thm trigonometric_power_series_are_entire:
    ? forall x R:
        $is_radius_of_convergence(fn(n N) R {cosine_taylor_coefficient(n)}, (1, 0))
        $is_radius_of_convergence(fn(n N) R {sine_taylor_coefficient(n)}, (1, 0))
        $is_power_series_absolutely_convergent_at(fn(n N) R {cosine_taylor_coefficient(n)}, 0, x)
        $is_power_series_absolutely_convergent_at(fn(n N) R {sine_taylor_coefficient(n)}, 0, x)
        $has_power_series_sum(fn(n N) R {cosine_taylor_coefficient(n)}, 0, x, real_cos(x))
        $has_power_series_sum(fn(n N) R {sine_taylor_coefficient(n)}, 0, x, real_sin(x))
        $is_real_analytic_on(R, fn(t R) R {real_cos(t)})
        $is_real_analytic_on(R, fn(t R) R {real_sin(t)})
        $chap2::is_metric_continuous(R, R, chap1::real_distance, chap1::real_distance, fn(t R) R {real_cos(t)})
        $chap2::is_metric_continuous(R, R, chap1::real_distance, chap1::real_distance, fn(t R) R {real_sin(t)})
    # proof_debt: the ratio-test argument for the cosine coefficients is not yet formalized.
    trust $is_radius_of_convergence(fn(n N) R {cosine_taylor_coefficient(n)}, (1, 0))
    # proof_debt: the ratio-test argument for the sine coefficients is not yet formalized.
    trust $is_radius_of_convergence(fn(n N) R {sine_taylor_coefficient(n)}, (1, 0))
    # proof_debt: absolute convergence of the cosine series at x is not yet formalized.
    trust $is_power_series_absolutely_convergent_at(fn(n N) R {cosine_taylor_coefficient(n)}, 0, x)
    # proof_debt: absolute convergence of the sine series at x is not yet formalized.
    trust $is_power_series_absolutely_convergent_at(fn(n N) R {sine_taylor_coefficient(n)}, 0, x)
    # proof_debt: identify the selected real cosine value with its factorial series.
    trust $has_power_series_sum(fn(n N) R {cosine_taylor_coefficient(n)}, 0, x, real_cos(x))
    # proof_debt: identify the selected real sine value with its factorial series.
    trust $has_power_series_sum(fn(n N) R {sine_taylor_coefficient(n)}, 0, x, real_sin(x))
    # proof_debt: transport the local power-series expansions to every real center.
    trust $is_real_analytic_on(R, fn(t R) R {real_cos(t)})
    # proof_debt: transport the local power-series expansions to every real center.
    trust $is_real_analytic_on(R, fn(t R) R {real_sin(t)})
    # proof_debt: derive continuity from global analyticity.
    trust $chap2::is_metric_continuous(R, R, chap1::real_distance, chap1::real_distance, fn(t R) R {real_cos(t)})
    # proof_debt: derive continuity from global analyticity.
    trust $chap2::is_metric_continuous(R, R, chap1::real_distance, chap1::real_distance, fn(t R) R {real_sin(t)})

# Theorem 4.7.2 (Trigonometric identities).
thm trigonometric_identities:
    ? forall x, y R:
        real_sin(x)^2 + real_cos(x)^2 = 1
        -1 <= real_sin(x)
        real_sin(x) <= 1
        -1 <= real_cos(x)
        real_cos(x) <= 1
        real_sin(-x) = -real_sin(x)
        real_cos(-x) = real_cos(x)
        real_cos(x + y) = real_cos(x) * real_cos(y) - real_sin(x) * real_sin(y)
        real_sin(x + y) = real_sin(x) * real_cos(y) + real_cos(x) * real_sin(y)
        real_sin(0) = 0
        real_cos(0) = 1
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_sin(x)^2 + real_cos(x)^2 = 1
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust -1 <= real_sin(x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_sin(x) <= 1
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust -1 <= real_cos(x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_cos(x) <= 1
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_sin(-x) = -real_sin(x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_cos(-x) = real_cos(x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_cos(x + y) = real_cos(x) * real_cos(y) - real_sin(x) * real_sin(y)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_sin(x + y) = real_sin(x) * real_cos(y) + real_cos(x) * real_sin(y)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_sin(0) = 0
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_cos(0) = 1

thm trigonometric_derivatives:
    ? forall x R:
        $has_derivative_on(R, fn(t R) R {real_sin(t)}, fn(t R) R {real_cos(t)})
        $has_derivative_on(R, fn(t R) R {real_cos(t)}, fn(t R) R {-real_sin(t)})
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_derivative_on(R, fn(t R) R {real_sin(t)}, fn(t R) R {real_cos(t)})
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_derivative_on(R, fn(t R) R {real_cos(t)}, fn(t R) R {-real_sin(t)})

thm euler_formula:
    ? forall x R:
        exp_complex(complex_mul(imaginary_unit, complex_of_real(x))) = (real_cos(x), real_sin(x))
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exp_complex(complex_mul(imaginary_unit, complex_of_real(x))) = (real_cos(x), real_sin(x))

thm negative_euler_formula:
    ? forall x R:
        exp_complex(complex_neg(complex_mul(imaginary_unit, complex_of_real(x)))) = (real_cos(x), -real_sin(x))
    # proof_debt: combine the exponential inverse law with the trigonometric
    # parity identities in the complex carrier.
    trust exp_complex(complex_neg(complex_mul(imaginary_unit, complex_of_real(x)))) = (real_cos(x), -real_sin(x))

# Lemma 4.7.3 (A positive zero of sine exists).
thm positive_sine_zero_exists:
    ? forall anchor R:
        exist x R+ st {real_sin(x) = 0}
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exist x R+ st {real_sin(x) = 0}

# Definition 4.7.4 (Pi).
prop is_least_positive_sine_zero(p R):
    p > 0
    real_sin(p) = 0
    forall x R+:
        real_sin(x) = 0
        =>:
            p <= x

have fn pi_selector by exist!:
    ? forall anchor R:
        exist! p R st {$is_least_positive_sine_zero(p)}
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exist! p R st {$is_least_positive_sine_zero(p)}

have pi_real R = pi_selector(0)

thm pi_trigonometric_values:
    ? forall anchor R:
        pi_real > 0
        real_sin(pi_real) = 0
        real_cos(pi_real) = -1
        exp_complex(complex_mul(imaginary_unit, complex_of_real(pi_real))) = complex_neg(complex_one)
    # proof_debt: the selected least-positive-zero facts do not propagate
    # through the named alias pi_real.
    trust pi_real > 0
    # proof_debt: the selected least-positive-zero facts do not propagate
    # through the named alias pi_real.
    trust real_sin(pi_real) = 0
    # proof_debt: use monotonicity on the first positive-zero interval and
    # sin^2 + cos^2 = 1 to select the negative cosine value.
    trust real_cos(pi_real) = -1
    # proof_debt: combine Euler's formula with the displayed sine/cosine values
    # through the concrete complex coordinates.
    trust exp_complex(complex_mul(imaginary_unit, complex_of_real(pi_real))) = complex_neg(complex_one)

# Theorem 4.7.5 (Periodicity and zero sets).
prop is_integer_multiple_of_pi(x R):
    exist k Z st {x = k * pi_real}

prop is_half_integer_multiple_of_pi(x R):
    exist k Z st {2 * x = (2 * k + 1) * pi_real}

thm trigonometric_half_periodicity:
    ? forall x R:
        real_cos(x + pi_real) = -real_cos(x)
        real_sin(x + pi_real) = -real_sin(x)
    # proof_debt: the half-period identities still need the source analytic proof.
    trust real_cos(x + pi_real) = -real_cos(x)
    # proof_debt: the half-period identities still need the source analytic proof.
    trust real_sin(x + pi_real) = -real_sin(x)

thm trigonometric_periodicity:
    ? forall x R:
        real_cos(x + pi_real) = -real_cos(x)
        real_sin(x + pi_real) = -real_sin(x)
        real_cos(x + 2 * pi_real) = real_cos(x)
        real_sin(x + 2 * pi_real) = real_sin(x)
    by thm trigonometric_half_periodicity(x)
    by thm trigonometric_half_periodicity(x + pi_real)
    real_cos(x + 2 * pi_real) = real_cos((x + pi_real) + pi_real) = -real_cos(x + pi_real) = -(-real_cos(x)) = real_cos(x)
    real_sin(x + 2 * pi_real) = real_sin((x + pi_real) + pi_real) = -real_sin(x + pi_real) = -(-real_sin(x)) = real_sin(x)

thm sine_zero_characterization_forward:
    ? forall x R:
        real_sin(x) = 0
        =>:
            $is_integer_multiple_of_pi(x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $is_integer_multiple_of_pi(x)

thm sine_zero_characterization_reverse:
    ? forall x R:
        $is_integer_multiple_of_pi(x)
        =>:
            real_sin(x) = 0
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_sin(x) = 0

thm cosine_zero_characterization_forward:
    ? forall x R:
        real_cos(x) = 0
        =>:
            $is_half_integer_multiple_of_pi(x)
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $is_half_integer_multiple_of_pi(x)

thm cosine_zero_characterization_reverse:
    ? forall x R:
        $is_half_integer_multiple_of_pi(x)
        =>:
            real_cos(x) = 0
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust real_cos(x) = 0
