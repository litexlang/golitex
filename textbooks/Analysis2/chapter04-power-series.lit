# Lemma 4.6.14 (Complex limit laws). These are concrete convergence
# conclusions over the Chapter 1 metric-limit relation, not opaque flags.
template<z, w fn(n N+) &ComplexNumber>:
    have fn complex_sum_sequence(n N+) &ComplexNumber = complex_add(z(n), w(n))

template<z, w fn(n N+) &ComplexNumber>:
    have fn complex_product_sequence(n N+) &ComplexNumber = complex_mul(z(n), w(n))

template<z, w fn(n N+) &ComplexNumber>:
    have fn complex_difference_sequence(n N+) &ComplexNumber = complex_add(z(n), complex_neg(w(n)))

template<z fn(n N+) &ComplexNumber, c &ComplexNumber>:
    have fn complex_constant_product_sequence(n N+) &ComplexNumber = complex_mul(c, z(n))

template<z fn(n N+) &ComplexNumber>:
    have fn complex_conjugate_sequence(n N+) &ComplexNumber = complex_conjugate(z(n))

prop has_basic_complex_limit_laws(z, w fn(n N+) &ComplexNumber, c, limit_z, limit_w &ComplexNumber):
    $chap1::has_metric_limit(&ComplexNumber, complex_distance, \complex_sum_sequence<z, w>, complex_add(limit_z, limit_w))
    $chap1::has_metric_limit(&ComplexNumber, complex_distance, \complex_difference_sequence<z, w>, complex_add(limit_z, complex_neg(limit_w)))
    $chap1::has_metric_limit(&ComplexNumber, complex_distance, \complex_product_sequence<z, w>, complex_mul(limit_z, limit_w))
    $chap1::has_metric_limit(&ComplexNumber, complex_distance, \complex_constant_product_sequence<z, c>, complex_mul(c, limit_z))
    $chap1::has_metric_limit(&ComplexNumber, complex_distance, \complex_conjugate_sequence<z>, complex_conjugate(limit_z))

have fn complex_safe_divide(z, w &ComplexNumber) &ComplexNumber by cases:
    case w != complex_zero: complex_divide(z, w)
    case w = complex_zero: complex_zero

template<z, w fn(n N+) &ComplexNumber>:
    have fn complex_quotient_sequence(n N+) &ComplexNumber = complex_safe_divide(z(n), w(n))

prop has_complex_quotient_limit(z, w fn(n N+) &ComplexNumber, limit_z, limit_w &ComplexNumber):
    forall n N+:
        w(n) != complex_zero
    limit_w != complex_zero
    $chap1::has_metric_limit(&ComplexNumber, complex_distance, \complex_quotient_sequence<z, w>, complex_divide(limit_z, limit_w))

thm complex_limit_laws:
    ? forall z, w fn(n N+) &ComplexNumber, c, limit_z, limit_w &ComplexNumber:
