# Definition 4.5.3 (Euler's number).
have euler_number R = exp_real(1)

# Proposition 4.5.4. Positive-base real exponentiation uses Analysis I's
# concrete real-power operation.
prop has_real_power_value(base, exponent, value R):
    base > 0
    value = base^exponent

