# Definition 4.6.1 (Informal complex-number carrier).
have informal_complex_coordinates set = cart(R, R)

# Definition 4.6.2 (Formal complex numbers).
struct ComplexNumber:
    real_part R
    im R

# Definition 4.6.3 (Complex addition, negation, and zero).
have complex_zero &ComplexNumber = (0, 0)
have fn complex_add(z, w &ComplexNumber) &ComplexNumber = (z.real_part + w.real_part, z.im + w.im)
have fn complex_neg(z &ComplexNumber) &ComplexNumber = (-z.real_part, -z.im)

# Lemma 4.6.4 (The complex numbers are an additive group).
thm complex_additive_group_laws:
    ? forall z1, z2, z3 &ComplexNumber:
        complex_add(z1, z2) = complex_add(z2, z1)
        complex_add(complex_add(z1, z2), z3) = complex_add(z1, complex_add(z2, z3))
        complex_add(z1, complex_zero) = z1
        complex_add(complex_zero, z1) = z1
        complex_add(z1, complex_neg(z1)) = complex_zero
        complex_add(complex_neg(z1), z1) = complex_zero
    complex_add(z1, z2) = (z1.real_part + z2.real_part, z1.im + z2.im) = (z2.real_part + z1.real_part, z2.im + z1.im) = complex_add(z2, z1)
    # proof_debt: nested struct-valued function unfolding does not yet expose the coordinate associativity calculation.
    trust complex_add(complex_add(z1, z2), z3) = complex_add(z1, complex_add(z2, z3))
    # proof_debt: struct-valued function unfolding does not yet bridge the computed tuple to the named operand.
    trust complex_add(z1, complex_zero) = z1
    # proof_debt: struct-valued function unfolding does not yet bridge the computed tuple to the named operand.
    trust complex_add(complex_zero, z1) = z1
    # proof_debt: struct-valued function unfolding does not yet bridge the computed tuple to complex_zero.
    trust complex_add(z1, complex_neg(z1)) = complex_zero
    # proof_debt: struct-valued function unfolding does not yet bridge the computed tuple to complex_zero.
    trust complex_add(complex_neg(z1), z1) = complex_zero

# Definition 4.6.5 (Complex multiplication).
have complex_one &ComplexNumber = (1, 0)
have fn complex_mul(z, w &ComplexNumber) &ComplexNumber = (z.real_part * w.real_part - z.im * w.im, z.real_part * w.im + z.im * w.real_part)

# Lemma 4.6.6 (Complex multiplication laws).
thm complex_multiplication_laws:
    ? forall z1, z2, z3 &ComplexNumber:
        complex_mul(z1, z2) = complex_mul(z2, z1)
        complex_mul(complex_mul(z1, z2), z3) = complex_mul(z1, complex_mul(z2, z3))
        complex_mul(z1, complex_one) = z1
        complex_mul(complex_one, z1) = z1
        complex_mul(z1, complex_add(z2, z3)) = complex_add(complex_mul(z1, z2), complex_mul(z1, z3))
        complex_mul(complex_add(z2, z3), z1) = complex_add(complex_mul(z2, z1), complex_mul(z3, z1))
    complex_mul(z1, z2) = (z1.real_part * z2.real_part - z1.im * z2.im, z1.real_part * z2.im + z1.im * z2.real_part) = (z2.real_part * z1.real_part - z2.im * z1.im, z2.real_part * z1.im + z2.im * z1.real_part) = complex_mul(z2, z1)
    # proof_debt: nested struct-valued function unfolding does not yet expose the coordinate associativity calculation.
    trust complex_mul(complex_mul(z1, z2), z3) = complex_mul(z1, complex_mul(z2, z3))
    # proof_debt: struct-valued function unfolding does not yet bridge the computed tuple to the named operand.
    trust complex_mul(z1, complex_one) = z1
    # proof_debt: struct-valued function unfolding does not yet bridge the computed tuple to the named operand.
    trust complex_mul(complex_one, z1) = z1
    # proof_debt: nested struct-valued function unfolding does not yet expose the coordinate distributivity calculation.
    trust complex_mul(z1, complex_add(z2, z3)) = complex_add(complex_mul(z1, z2), complex_mul(z1, z3))
    # migration_forced_trust: shallow replay cannot yet combine struct-valued
    # function congruence with the two coordinate commutativity substitutions.
    trust complex_mul(complex_add(z2, z3), z1) = complex_add(complex_mul(z2, z1), complex_mul(z3, z1))

# Lemma 4.6.7 (Real-imaginary representation).
have imaginary_unit &ComplexNumber = (0, 1)
have fn complex_of_real(x R) &ComplexNumber = (x, 0)

thm complex_cartesian_representation:
    ? forall z &ComplexNumber:
        z = complex_add(complex_of_real(z.real_part), complex_mul(complex_of_real(z.im), imaginary_unit))
        complex_mul(imaginary_unit, imaginary_unit) = complex_neg(complex_one)
        complex_neg(z) = complex_mul(complex_of_real(-1), z)
    # proof_debt: nested struct-valued function unfolding does not yet bridge the coordinate computation back to z.
    trust z = complex_add(complex_of_real(z.real_part), complex_mul(complex_of_real(z.im), imaginary_unit))
    # proof_debt: struct-valued function unfolding does not yet normalize both computed constants to the same tuple.
    trust complex_mul(imaginary_unit, imaginary_unit) = complex_neg(complex_one)
    # proof_debt: struct-valued function unfolding does not yet normalize the two coordinate expressions.
    trust complex_neg(z) = complex_mul(complex_of_real(-1), z)

# Definition 4.6.8 (Real part, imaginary part, and conjugate).
have fn complex_real_part(z &ComplexNumber) R = z.real_part
have fn complex_imaginary_part(z &ComplexNumber) R = z.im
have fn complex_conjugate(z &ComplexNumber) &ComplexNumber = (z.real_part, -z.im)

prop is_real_complex(z &ComplexNumber):
    z.im = 0

prop is_imaginary_complex(z &ComplexNumber):
    z.real_part = 0

# Lemma 4.6.9 (Complex conjugation is an involution).
thm complex_conjugation_laws:
    ? forall z, w &ComplexNumber:
        complex_conjugate(complex_add(z, w)) = complex_add(complex_conjugate(z), complex_conjugate(w))
        complex_conjugate(complex_neg(z)) = complex_neg(complex_conjugate(z))
        complex_conjugate(complex_mul(z, w)) = complex_mul(complex_conjugate(z), complex_conjugate(w))
        complex_conjugate(complex_conjugate(z)) = z
    # proof_debt: nested struct-valued function unfolding does not yet expose the coordinate computation.
    trust complex_conjugate(complex_add(z, w)) = complex_add(complex_conjugate(z), complex_conjugate(w))
    # proof_debt: nested struct-valued function unfolding does not yet expose the coordinate computation.
    trust complex_conjugate(complex_neg(z)) = complex_neg(complex_conjugate(z))
    # proof_debt: nested struct-valued function unfolding does not yet expose the coordinate computation.
    trust complex_conjugate(complex_mul(z, w)) = complex_mul(complex_conjugate(z), complex_conjugate(w))
    # proof_debt: nested struct-valued function unfolding does not yet bridge the computed tuple to z.
    trust complex_conjugate(complex_conjugate(z)) = z

thm equal_conjugates_imply_equal_originals:
    ? forall z, w &ComplexNumber:
        complex_conjugate(z) = complex_conjugate(w)
        =>:
            z = w
    # proof_debt: apply conjugation again and use involution.
    trust z = w

thm equal_originals_imply_equal_conjugates:
    ? forall z, w &ComplexNumber:
        z = w
        =>:
            complex_conjugate(z) = complex_conjugate(w)
    complex_conjugate(z) = complex_conjugate(w)

thm conjugation_fixed_implies_real:
    ? forall z &ComplexNumber:
        complex_conjugate(z) = z
        =>:
            $is_real_complex(z)
    # proof_debt: unfold the conjugate coordinate equality.
