    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust $has_basic_complex_limit_laws(z, w, c, limit_z, limit_w)

thm complex_quotient_limit_law:
    ? forall z, w fn(n N+) &ComplexNumber, limit_z, limit_w &ComplexNumber:
