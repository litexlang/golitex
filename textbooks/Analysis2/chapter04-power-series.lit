# Definition 4.6.12 (Complex reciprocal and quotient).
prop is_complex_reciprocal(z, w &ComplexNumber):
    complex_mul(z, w) = complex_one

have fn complex_reciprocal by exist!:
    ? forall z &ComplexNumber:
        z != complex_zero
        =>:
            exist! w &ComplexNumber st {$is_complex_reciprocal(z, w)}
    # proof_debt: source proof or supporting analysis interface is not yet formalized.
    trust exist! w &ComplexNumber st {$is_complex_reciprocal(z, w)}

have fn complex_divide(z, w &ComplexNumber: w != complex_zero) &ComplexNumber = complex_mul(z, complex_reciprocal(w))

# Lemma 4.6.13 (Complex metric and coordinatewise convergence).
have fn complex_distance(z, w &ComplexNumber) R = complex_abs(complex_add(z, complex_neg(w)))

thm complex_distance_is_metric:
