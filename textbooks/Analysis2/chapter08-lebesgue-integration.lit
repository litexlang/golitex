# Chapter 8. Lebesgue integration.

# Definition 8.1.1. A simple function is measurable and has finite image.
prop has_finite_value_cover(domain set, f fn(x domain) R, values finite_set):
    forall x domain:
        exist value values st {f(x) = value}

prop is_simple_function(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R):
    $chap7::is_lebesgue_measurable(n, domain)
    $chap7::is_finite_real_superlevel_measurable(n, domain, f)
    exist values finite_set st {$has_finite_value_cover(domain, f, values)}

# Example 8.1.2. A characteristic function of a measurable subset is
# measurable and simple.
prop is_characteristic_function_on(domain set, piece_set power_set(domain), indicator fn(x domain) R):
    forall x domain:
        x $in piece_set and indicator(x) = 1 or not x $in piece_set and indicator(x) = 0

prop has_characteristic_function_example_results(n N+, domain power_set(\chap7::euclidean_space<n>), piece_set power_set(domain), indicator fn(x domain) R):
    $chap7::is_finite_real_superlevel_measurable(n, domain, indicator)
    $is_simple_function(n, domain, indicator)

thm example_812_characteristic_function_is_simple:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), piece_set power_set(domain), indicator fn(x domain) R:
        $chap7::is_lebesgue_measurable(n, domain)
        $chap7::is_lebesgue_measurable(n, piece_set)
        $is_characteristic_function_on(domain, piece_set, indicator)
        =>:
            $has_characteristic_function_example_results(n, domain, piece_set, indicator)
    # proof_debt: identify the two measurable level sets and the finite image {0,1}.
    trust $has_characteristic_function_example_results(n, domain, piece_set, indicator)

# Lemma 8.1.3. Simple functions are closed under addition and arbitrary real
# scalar multiplication.
prop has_simple_function_algebra_results(n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function, scaled_function fn(x domain) R, scalar R):
    $chap7::is_pointwise_real_sum(domain, f, g, sum_function)
    forall x domain:
        scaled_function(x) = scalar * f(x)
    $is_simple_function(n, domain, sum_function)
    $is_simple_function(n, domain, scaled_function)

thm simple_function_algebra:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) R, scalar R:
        $is_simple_function(n, domain, f)
        $is_simple_function(n, domain, g)
        =>:
            exist sum_function, scaled_function fn(x domain) R st {$has_simple_function_algebra_results(n, domain, f, g, sum_function, scaled_function, scalar)}
    trust exist sum_function, scaled_function fn(x domain) R st {$has_simple_function_algebra_results(n, domain, f, g, sum_function, scaled_function, scalar)}

# Lemma 8.1.4. Every simple function is a finite linear combination of
# characteristic functions of pairwise-disjoint measurable subsets.
prop is_simple_function_presentation(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, pieces finite_set, sets fn(piece pieces) power_set(\chap7::euclidean_space<n>), values fn(piece pieces) R, indicators fn(piece pieces) fn(x domain) R):
    $chap7::is_pairwise_disjoint_family(\chap7::euclidean_space<n>, pieces, sets)
    forall piece pieces:
        sets(piece) $subset domain
        $chap7::is_lebesgue_measurable(n, sets(piece))
        $is_characteristic_function_on(domain, sets(piece), indicators(piece))
    forall x domain:
        f(x) = finite_set_sum(pieces, fn(piece pieces) R {values(piece) * indicators(piece)(x)})

thm simple_function_has_characteristic_decomposition:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R:
        $is_simple_function(n, domain, f)
        =>:
            exist pieces finite_set, sets fn(piece pieces) power_set(\chap7::euclidean_space<n>), values fn(piece pieces) R, indicators fn(piece pieces) fn(x domain) R st {$is_simple_function_presentation(n, domain, f, pieces, sets, values, indicators)}
    trust exist pieces finite_set, sets fn(piece pieces) power_set(\chap7::euclidean_space<n>), values fn(piece pieces) R, indicators fn(piece pieces) fn(x domain) R st {$is_simple_function_presentation(n, domain, f, pieces, sets, values, indicators)}

# Lemma 8.1.5. A nonnegative measurable function is the pointwise increasing
# limit of nonnegative simple functions.
prop is_pointwise_nondecreasing_to(domain set, family fn(k N+) fn(x domain) R, f fn(x domain) R):
    forall x domain, k N+:
        0 <= family(k)(x) <= family(k + 1)(x) <= f(x)
    forall x domain, epsilon R+:
        exist k N+ st {f(x) - family(k)(x) < epsilon}

prop is_nondecreasing_simple_approximation(n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) R, f fn(x domain) R):
    forall k N+:
        $is_simple_function(n, domain, family(k))
    $is_pointwise_nondecreasing_to(domain, family, f)

thm measurable_function_has_simple_approximation:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R:
        $chap7::is_finite_real_superlevel_measurable(n, domain, f)
        forall x domain:
            f(x) >= 0
        =>:
            exist family fn(k N+) fn(x domain) R st {$is_nondecreasing_simple_approximation(n, domain, family, f)}
    trust exist family fn(k N+) fn(x domain) R st {$is_nondecreasing_simple_approximation(n, domain, family, f)}

# Definition 8.1.6. The integral of a simple function is the finite sum of its
# values multiplied by the measures of their level pieces.
prop is_simple_integral_presentation(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, integral R, pieces finite_set, sets fn(piece pieces) power_set(\chap7::euclidean_space<n>), values fn(piece pieces) R, indicators fn(piece pieces) fn(x domain) R, measures fn(piece pieces) R):
    $is_simple_function_presentation(n, domain, f, pieces, sets, values, indicators)
    forall piece pieces:
        $chap7::has_outer_measure_value(n, sets(piece), measures(piece))
    integral = finite_set_sum(pieces, fn(piece pieces) R {values(piece) * measures(piece)})

prop has_finite_simple_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, integral R):
    $is_simple_function(n, domain, f)
    forall x domain:
        f(x) >= 0
    exist pieces finite_set, sets fn(piece pieces) power_set(\chap7::euclidean_space<n>), values fn(piece pieces) R, indicators fn(piece pieces) fn(x domain) R, measures fn(piece pieces) R st {$is_simple_integral_presentation(n, domain, f, integral, pieces, sets, values, indicators, measures)}

prop is_infinite_positive_level_set(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, positive_value R+, level_set power_set(\chap7::euclidean_space<n>)):
    level_set $subset domain
    forall x domain:
        =>:
            x $in level_set
        <=>:
            f(x) = positive_value
    $chap7::has_infinite_outer_measure(n, level_set)

prop has_infinite_simple_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R):
    $is_simple_function(n, domain, f)
    forall x domain:
        f(x) >= 0
    exist positive_value R+, level_set power_set(\chap7::euclidean_space<n>) st {$is_infinite_positive_level_set(n, domain, f, positive_value, level_set)}

have extended_nonnegative_real set = union(cart({0}, chap4::nonnegative_reals), {(1, 0)})

# proof_debt: the tagged finite-nonnegative and positive-infinity values are
# definitionally contained in chap7::extended_real, but the verifier does not
# replay the nested union/cartesian-product inclusion at this boundary.
thm extended_nonnegative_real_is_extended_real:
    ? forall value extended_nonnegative_real:
        value $in chap7::extended_real
    trust value $in chap7::extended_real

prop has_finite_simple_lebesgue_integral_branch(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value extended_nonnegative_real):
    exist finite_value R st {finite_value >= 0, value = (0, finite_value), $has_finite_simple_lebesgue_integral(n, domain, f, finite_value)}

prop has_infinite_simple_lebesgue_integral_branch(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value extended_nonnegative_real):
    value = (1, 0)
    $has_infinite_simple_lebesgue_integral(n, domain, f)

prop has_simple_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value extended_nonnegative_real):
    $has_finite_simple_lebesgue_integral_branch(n, domain, f, value) or $has_infinite_simple_lebesgue_integral_branch(n, domain, f, value)

# Example 8.1.7. Two concrete simple functions have integral 11 and positive
# infinity, respectively.
prop is_example_817_f(f fn(point \chap6::row_vector_space<1>) R):
    forall point \chap6::row_vector_space<1>:
        1 <= point(1) <= 2 and f(point) = 3 or 2 < point(1) < 4 and f(point) = 4 or (point(1) < 1 or point(1) >= 4) and f(point) = 0

prop is_example_817_g(g fn(point \chap6::row_vector_space<1>) R):
    forall point \chap6::row_vector_space<1>:
        point(1) >= 0 and g(point) = 1 or point(1) < 0 and g(point) = 0

thm example_817_f_has_integral_eleven:
    ? forall f fn(point \chap6::row_vector_space<1>) R:
        $is_example_817_f(f)
        =>:
            $has_simple_lebesgue_integral(1, \chap7::euclidean_space<1>, f, (0, 11))
    # proof_debt: verify the three measurable pieces and compute 3*1 + 4*2.
    trust $has_simple_lebesgue_integral(1, \chap7::euclidean_space<1>, f, (0, 11))

thm example_817_g_has_infinite_integral:
    ? forall g fn(point \chap6::row_vector_space<1>) R:
        $is_example_817_g(g)
        =>:
            $has_simple_lebesgue_integral(1, \chap7::euclidean_space<1>, g, (1, 0))
    # proof_debt: verify the half-line characteristic function and its
    # positive level set has infinite outer measure.
    trust $has_simple_lebesgue_integral(1, \chap7::euclidean_space<1>, g, (1, 0))

prop is_zero_outside_set(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, exceptional power_set(\chap7::euclidean_space<n>)):
    $chap7::has_outer_measure_value(n, exceptional, 0)
    forall x domain:
        not x $in exceptional
        =>:
            f(x) = 0

prop is_zero_almost_everywhere(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R):
    exist exceptional power_set(\chap7::euclidean_space<n>) st {$is_zero_outside_set(n, domain, f, exceptional)}

prop majorizes(domain set, g, f fn(x domain) R):
    forall x domain:
        g(x) >= f(x)

# Lemma 8.1.9. Refining or changing a measurable simple-function presentation
# does not change its integral.
thm simple_integral_is_presentation_independent:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, first, second R:
        $has_finite_simple_lebesgue_integral(n, domain, f, first)
        $has_finite_simple_lebesgue_integral(n, domain, f, second)
        =>:
            first = second
    trust first = second

# Proposition 8.1.10. Simple integrals are positive, linear, monotone, and
# compatible with restriction to measurable subsets.
prop has_simple_integral_full_laws(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) R, scalar R+, F, G, sum_integral, scaled_integral R):
    F >= 0
    F != 0 or $is_zero_almost_everywhere(n, domain, f)
    not $is_zero_almost_everywhere(n, domain, f) or F = 0
    sum_integral = F + G
    scaled_integral = scalar * F
    not $majorizes(domain, g, f) or F <= G

thm simple_integral_laws:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function, scaled_function fn(x domain) R, scalar R+, F, G, sum_integral, scaled_integral R:
        $chap7::is_lebesgue_measurable(n, domain)
        $is_simple_function(n, domain, f)
        $is_simple_function(n, domain, g)
        forall x domain:
            f(x) >= 0
            g(x) >= 0
        $chap7::is_pointwise_real_sum(domain, f, g, sum_function)
        forall x domain:
            scaled_function(x) = scalar * f(x)
        $has_finite_simple_lebesgue_integral(n, domain, f, F)
        $has_finite_simple_lebesgue_integral(n, domain, g, G)
        $has_finite_simple_lebesgue_integral(n, domain, sum_function, sum_integral)
        $has_finite_simple_lebesgue_integral(n, domain, scaled_function, scaled_integral)
        =>:
            $has_simple_integral_full_laws(n, domain, f, g, scalar, F, G, sum_integral, scaled_integral)
    # proof_debt: refine the simple-function presentations and use finite measure additivity.
    trust $has_simple_integral_full_laws(n, domain, f, g, scalar, F, G, sum_integral, scaled_integral)

# Definition 8.2.1. A function majorizes another when it is pointwise greater
# than or equal to it. The relation is declared above for use by Proposition
# 8.1.10(d).

# Definition 8.2.2. The source permits both the function and its integral to
# take the value positive infinity.
prop is_extended_nonnegative_extended_real_embedding(domain set, f fn(x domain) extended_nonnegative_real, embedded fn(x domain) chap7::extended_real):
    forall x domain:
        embedded(x) = f(x)

prop has_extended_nonnegative_sequence_supremum(sequence fn(k N+) extended_nonnegative_real, value extended_nonnegative_real):
    exist embedded fn(k N+) chap7::extended_real st {$is_extended_nonnegative_extended_real_embedding(N+, sequence, embedded), $chap7::is_extended_real_sequence_supremum(embedded, value)}

prop has_extended_nonnegative_sequence_liminf(sequence fn(k N+) extended_nonnegative_real, value extended_nonnegative_real):
    exist embedded fn(k N+) chap7::extended_real st {$is_extended_nonnegative_extended_real_embedding(N+, sequence, embedded), $chap7::is_extended_real_sequence_liminf(embedded, value)}

prop is_extended_nonnegative_measurable(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real):
    exist embedded fn(x domain) chap7::extended_real st {$is_extended_nonnegative_extended_real_embedding(domain, f, embedded), $chap7::is_extended_real_measurable(n, domain, embedded)}

prop is_simple_minorant_of_extended_nonnegative(n N+, domain power_set(\chap7::euclidean_space<n>), simple fn(x domain) R, f fn(x domain) extended_nonnegative_real):
    $is_simple_function(n, domain, simple)
    forall x domain:
        simple(x) >= 0
        $chap7::is_extended_real_le((0, simple(x)), f(x))

prop is_extended_nonnegative_integral_upper_bound(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real, upper extended_nonnegative_real):
    forall simple fn(x domain) R, integral extended_nonnegative_real:
        $is_simple_minorant_of_extended_nonnegative(n, domain, simple, f)
        $has_simple_lebesgue_integral(n, domain, simple, integral)
        =>:
            $chap7::is_extended_real_le(integral, upper)

prop has_extended_nonnegative_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real, value extended_nonnegative_real):
    $chap7::is_lebesgue_measurable(n, domain)
    $is_extended_nonnegative_measurable(n, domain, f)
    $is_extended_nonnegative_integral_upper_bound(n, domain, f, value)
    forall upper extended_nonnegative_real:
        not $is_extended_nonnegative_integral_upper_bound(n, domain, f, upper) or $chap7::is_extended_real_le(value, upper)

# Remark 8.2.4. Integration on a measurable subdomain uses the restricted
# function, and the nonnegative integral extends the simple integral.
prop is_extended_nonnegative_domain_restriction(domain set, subdomain power_set(domain), f fn(x domain) extended_nonnegative_real, restricted fn(x subdomain) extended_nonnegative_real):
    forall x subdomain:
        restricted(x) = f(x)

prop is_finite_nonnegative_embedding(domain set, f fn(x domain) R, embedded fn(x domain) extended_nonnegative_real):
    forall x domain:
        f(x) >= 0
        embedded(x) = (0, f(x))

thm remark_824_simple_integral_consistency:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, embedded fn(x domain) extended_nonnegative_real, value extended_nonnegative_real:
        $chap7::is_lebesgue_measurable(n, domain)
        $is_simple_function(n, domain, f)
        $is_finite_nonnegative_embedding(domain, f, embedded)
        $has_simple_lebesgue_integral(n, domain, f, value)
        =>:
            $has_extended_nonnegative_lebesgue_integral(n, domain, embedded, value)
    # proof_debt: use the simple-integral monotonicity law to identify the
    # supremum over every simple minorant with the function's own integral.
    trust $has_extended_nonnegative_lebesgue_integral(n, domain, embedded, value)

# Finite-real-valued companion to Definition 8.2.2, retained while the
# remaining Chapter 8 theorem interfaces migrate to the tagged carrier.
prop is_finite_nonnegative_integral_lower_bound(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value R):
    forall simple fn(x domain) R, simple_integral R:
        $is_simple_function(n, domain, simple)
        $majorizes(domain, f, simple)
        $has_finite_simple_lebesgue_integral(n, domain, simple, simple_integral)
        =>:
            simple_integral <= value

prop has_finite_nonnegative_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value R):
    $chap7::is_lebesgue_measurable(n, domain)
    $chap7::is_finite_real_superlevel_measurable(n, domain, f)
    forall x domain:
        f(x) >= 0
    $is_finite_nonnegative_integral_lower_bound(n, domain, f, value)
    forall epsilon R+:
        exist simple fn(x domain) R, simple_integral R st {$is_simple_function(n, domain, simple), $majorizes(domain, f, simple), $has_finite_simple_lebesgue_integral(n, domain, simple, simple_integral), value - epsilon < simple_integral}

prop has_infinite_positive_scalar_product_in_extended_nonnegative(value, scaled_value extended_nonnegative_real):
    value = (1, 0)
    scaled_value = (1, 0)

prop has_finite_positive_scalar_product_in_extended_nonnegative(scalar R+, value, scaled_value extended_nonnegative_real):
    exist finite, finite_product R st {finite >= 0, value = (0, finite), finite_product = scalar * finite, scaled_value = (0, finite_product)}

prop has_positive_scalar_product_in_extended_nonnegative(scalar R+, value, scaled_value extended_nonnegative_real):
    $has_infinite_positive_scalar_product_in_extended_nonnegative(value, scaled_value) or $has_finite_positive_scalar_product_in_extended_nonnegative(scalar, value, scaled_value)

prop is_pointwise_extended_nonnegative_scalar_product(domain set, scalar R+, f, scaled fn(x domain) extended_nonnegative_real):
    forall x domain:
        $has_positive_scalar_product_in_extended_nonnegative(scalar, f(x), scaled(x))

prop is_pointwise_extended_nonnegative_le(domain set, f, g fn(x domain) extended_nonnegative_real):
    forall x domain:
        $chap7::is_extended_real_le(f(x), g(x))

prop is_extended_nonnegative_zero_outside_set(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real, exceptional power_set(\chap7::euclidean_space<n>)):
    exceptional $subset domain
    $chap7::has_outer_measure_value(n, exceptional, 0)
    forall x domain:
        x $in exceptional or f(x) = (0, 0)

prop is_extended_nonnegative_zero_almost_everywhere(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real):
    exist exceptional power_set(\chap7::euclidean_space<n>) st {$is_extended_nonnegative_zero_outside_set(n, domain, f, exceptional)}

prop is_extended_nonnegative_equal_outside_set(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) extended_nonnegative_real, exceptional power_set(\chap7::euclidean_space<n>)):
    $chap7::has_outer_measure_value(n, exceptional, 0)
    exceptional $subset domain
    forall x domain:
        x $in exceptional or f(x) = g(x)

prop is_extended_nonnegative_equal_outside_null_set(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) extended_nonnegative_real):
    exist exceptional power_set(\chap7::euclidean_space<n>) st {$is_extended_nonnegative_equal_outside_set(n, domain, f, g, exceptional)}

prop has_extended_nonnegative_integral_full_laws(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) extended_nonnegative_real, scalar R+, F, G, scaled_integral, restricted_integral extended_nonnegative_real):
    $chap7::is_extended_real_le((0, 0), F)
    F != (0, 0) or $is_extended_nonnegative_zero_almost_everywhere(n, domain, f)
    not $is_extended_nonnegative_zero_almost_everywhere(n, domain, f) or F = (0, 0)
    $has_positive_scalar_product_in_extended_nonnegative(scalar, F, scaled_integral)
    not $is_pointwise_extended_nonnegative_le(domain, f, g) or $chap7::is_extended_real_le(F, G)
    not $is_extended_nonnegative_equal_outside_null_set(n, domain, f, g) or F = G
    $chap7::is_extended_real_le(restricted_integral, F)

# Proposition 8.2.6. The tagged nonnegative integral is monotone,
# homogeneous, and compatible with restriction and almost-everywhere equality.
thm nonnegative_lebesgue_integral_laws:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), subdomain power_set(domain), f, g, scaled_function fn(x domain) extended_nonnegative_real, restricted_function fn(x subdomain) extended_nonnegative_real, scalar R+, F, G, scaled_integral, restricted_integral extended_nonnegative_real:
        $chap7::is_lebesgue_measurable(n, domain)
        $chap7::is_lebesgue_measurable(n, subdomain)
        $is_pointwise_extended_nonnegative_scalar_product(domain, scalar, f, scaled_function)
        $is_extended_nonnegative_domain_restriction(domain, subdomain, f, restricted_function)
        $has_extended_nonnegative_lebesgue_integral(n, domain, f, F)
        $has_extended_nonnegative_lebesgue_integral(n, domain, g, G)
        $has_extended_nonnegative_lebesgue_integral(n, domain, scaled_function, scaled_integral)
        $has_extended_nonnegative_lebesgue_integral(n, subdomain, restricted_function, restricted_integral)
        =>:
            $has_extended_nonnegative_integral_full_laws(n, domain, f, g, scalar, F, G, scaled_integral, restricted_integral)
    # proof_debt: compare simple minorants, null-set modifications, and
    # measurable restrictions in the tagged carrier.
    trust $has_extended_nonnegative_integral_full_laws(n, domain, f, g, scalar, F, G, scaled_integral, restricted_integral)

# Finite-real-valued companion to Proposition 8.2.6.
prop is_finite_domain_restriction(domain set, subdomain power_set(domain), f fn(x domain) R, restricted fn(x subdomain) R):
    forall x subdomain:
        restricted(x) = f(x)

prop has_finite_nonnegative_integral_full_laws(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) R, scalar R+, F, G, scaled_integral, restricted_integral R):
    F >= 0
    F != 0 or $is_zero_almost_everywhere(n, domain, f)
    not $is_zero_almost_everywhere(n, domain, f) or F = 0
    scaled_integral = scalar * F
    not $majorizes(domain, g, f) or F <= G
    not $chap7::is_equal_outside_null_set(n, domain, f, g) or F = G
    restricted_integral <= F

thm finite_nonnegative_lebesgue_integral_laws:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), subdomain power_set(domain), f, g, scaled_function fn(x domain) R, restricted_function fn(x subdomain) R, scalar R+, F, G, scaled_integral, restricted_integral R:
        $chap7::is_lebesgue_measurable(n, domain)
        $chap7::is_lebesgue_measurable(n, subdomain)
        forall x domain:
            scaled_function(x) = scalar * f(x)
        $is_finite_domain_restriction(domain, subdomain, f, restricted_function)
        $has_finite_nonnegative_lebesgue_integral(n, domain, f, F)
        $has_finite_nonnegative_lebesgue_integral(n, domain, g, G)
        $has_finite_nonnegative_lebesgue_integral(n, domain, scaled_function, scaled_integral)
        $has_finite_nonnegative_lebesgue_integral(n, subdomain, restricted_function, restricted_integral)
        =>:
            $has_finite_nonnegative_integral_full_laws(n, domain, f, g, scalar, F, G, scaled_integral, restricted_integral)
    # proof_debt: compare simple minorants, null-set modifications, and measurable restrictions.
    trust $has_finite_nonnegative_integral_full_laws(n, domain, f, g, scalar, F, G, scaled_integral, restricted_integral)

# Theorem 8.2.9. Integrals commute with pointwise increasing suprema of
# tagged nonnegative measurable functions.
prop is_pointwise_extended_nonnegative_nondecreasing_to(domain set, family fn(k N+) fn(x domain) extended_nonnegative_real, limit fn(x domain) extended_nonnegative_real):
    forall x domain, k N+:
        $chap7::is_extended_real_le(family(k)(x), family(k + 1)(x))
    forall x domain:
        $has_extended_nonnegative_sequence_supremum(fn(k N+) extended_nonnegative_real {family(k)(x)}, limit(x))

prop has_extended_monotone_convergence_conclusion(n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) extended_nonnegative_real, limit fn(x domain) extended_nonnegative_real, integrals fn(k N+) extended_nonnegative_real, total extended_nonnegative_real):
    forall k N+:
        $chap7::is_extended_real_le(integrals(k), integrals(k + 1))
    $has_extended_nonnegative_sequence_supremum(integrals, total)
    $has_extended_nonnegative_lebesgue_integral(n, domain, limit, total)

thm monotone_convergence_theorem:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) extended_nonnegative_real, limit fn(x domain) extended_nonnegative_real, integrals fn(k N+) extended_nonnegative_real, total extended_nonnegative_real:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $is_extended_nonnegative_measurable(n, domain, family(k))
            $has_extended_nonnegative_lebesgue_integral(n, domain, family(k), integrals(k))
        $is_pointwise_extended_nonnegative_nondecreasing_to(domain, family, limit)
        =>:
            $has_extended_monotone_convergence_conclusion(n, domain, family, limit, integrals, total)
    # proof_debt: approximate the tagged supremum from below by simple
    # functions and compare their integrals with the member-integral sequence.
    trust $has_extended_monotone_convergence_conclusion(n, domain, family, limit, integrals, total)

# Finite-real-valued companion to Theorem 8.2.9.
prop has_finite_monotone_convergence_conclusion(n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) R, limit fn(x domain) R, integrals fn(k N+) R, total R):
    forall k N+:
        integrals(k) <= integrals(k + 1)
    $chap7::is_real_sequence_supremum(integrals, total)
    $has_finite_nonnegative_lebesgue_integral(n, domain, limit, total)

thm finite_monotone_convergence_theorem:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) R, limit fn(x domain) R, integrals fn(k N+) R, total R:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $chap7::is_finite_real_superlevel_measurable(n, domain, family(k))
            $has_finite_nonnegative_lebesgue_integral(n, domain, family(k), integrals(k))
        $is_pointwise_nondecreasing_to(domain, family, limit)
        =>:
            $has_finite_monotone_convergence_conclusion(n, domain, family, limit, integrals, total)
    # proof_debt: approximate the limit from below by simple functions and
    # compare their integrals with the supplied member-integral sequence.
    trust $has_finite_monotone_convergence_conclusion(n, domain, family, limit, integrals, total)

# Lemma 8.2.10. Tagged extended-nonnegative integration is additive.
prop has_infinite_extended_nonnegative_sum(left, right, total extended_nonnegative_real):
    left = (1, 0) or right = (1, 0)
    total = (1, 0)

prop has_finite_extended_nonnegative_sum(left, right, total extended_nonnegative_real):
    exist left_finite, right_finite, total_finite R st {left_finite >= 0, right_finite >= 0, left = (0, left_finite), right = (0, right_finite), total_finite = left_finite + right_finite, total = (0, total_finite)}

prop has_extended_nonnegative_sum(left, right, total extended_nonnegative_real):
    $has_infinite_extended_nonnegative_sum(left, right, total) or $has_finite_extended_nonnegative_sum(left, right, total)

prop is_pointwise_extended_nonnegative_sum(domain set, f, g, h fn(x domain) extended_nonnegative_real):
    forall x domain:
        $has_extended_nonnegative_sum(f(x), g(x), h(x))

thm nonnegative_integral_additivity:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f, g, h fn(x domain) extended_nonnegative_real, F, G, H extended_nonnegative_real:
        $is_pointwise_extended_nonnegative_sum(domain, f, g, h)
        $has_extended_nonnegative_lebesgue_integral(n, domain, f, F)
        $has_extended_nonnegative_lebesgue_integral(n, domain, g, G)
        $has_extended_nonnegative_lebesgue_integral(n, domain, h, H)
        =>:
            $has_extended_nonnegative_sum(F, G, H)
    # proof_debt: combine simple minorants and apply tagged monotone convergence.
    trust $has_extended_nonnegative_sum(F, G, H)

# Finite-real-valued companion to Lemma 8.2.10.
thm finite_nonnegative_integral_additivity:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f, g, h fn(x domain) R, F, G, H R:
        $chap7::is_pointwise_real_sum(domain, f, g, h)
        $has_finite_nonnegative_lebesgue_integral(n, domain, f, F)
        $has_finite_nonnegative_lebesgue_integral(n, domain, g, G)
        $has_finite_nonnegative_lebesgue_integral(n, domain, h, H)
        =>:
            H = F + G
    trust H = F + G

# Corollary 8.2.11. The integral of a countable tagged nonnegative sum is the
# tagged supremum of the finite partial sums of the member integrals.
prop is_extended_nonnegative_partial_sum_family(domain set, family, partial_sums fn(k N+) fn(x domain) extended_nonnegative_real):
    forall x domain:
        partial_sums(1)(x) = family(1)(x)
    forall x domain, k N+:
        $has_extended_nonnegative_sum(partial_sums(k)(x), family(k + 1)(x), partial_sums(k + 1)(x))

prop is_pointwise_extended_nonnegative_series_sum(domain set, family, partial_sums fn(k N+) fn(x domain) extended_nonnegative_real, sum_function fn(x domain) extended_nonnegative_real):
    $is_extended_nonnegative_partial_sum_family(domain, family, partial_sums)
    forall x domain:
        $has_extended_nonnegative_sequence_supremum(fn(k N+) extended_nonnegative_real {partial_sums(k)(x)}, sum_function(x))

prop has_extended_nonnegative_integral_series_sum(integrals, partial_sums fn(k N+) extended_nonnegative_real, total extended_nonnegative_real):
    partial_sums(1) = integrals(1)
    forall k N+:
        $has_extended_nonnegative_sum(partial_sums(k), integrals(k + 1), partial_sums(k + 1))
    $has_extended_nonnegative_sequence_supremum(partial_sums, total)

thm tonelli_for_nonnegative_series:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family, pointwise_partial_sums fn(k N+) fn(x domain) extended_nonnegative_real, sum_function fn(x domain) extended_nonnegative_real, integrals, integral_partial_sums fn(k N+) extended_nonnegative_real, total extended_nonnegative_real:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $is_extended_nonnegative_measurable(n, domain, family(k))
            $has_extended_nonnegative_lebesgue_integral(n, domain, family(k), integrals(k))
        $is_pointwise_extended_nonnegative_series_sum(domain, family, pointwise_partial_sums, sum_function)
        $has_extended_nonnegative_integral_series_sum(integrals, integral_partial_sums, total)
        =>:
            $has_extended_nonnegative_lebesgue_integral(n, domain, sum_function, total)
    # proof_debt: identify finite partial-sum integrals by additivity and apply
    # tagged monotone convergence.
    trust $has_extended_nonnegative_lebesgue_integral(n, domain, sum_function, total)

# Finite-real-valued companion to Corollary 8.2.11.
prop is_pointwise_finite_nonnegative_series_sum(domain set, family fn(k N+) fn(x domain) R, sum_function fn(x domain) R):
    forall x domain:
        $chap3::has_real_series_sum(fn(k N+) R {family(k)(x)}, sum_function(x))

thm finite_tonelli_for_nonnegative_series:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) R, sum_function fn(x domain) R, integrals fn(k N+) R, total R:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $chap7::is_finite_real_superlevel_measurable(n, domain, family(k))
            $has_finite_nonnegative_lebesgue_integral(n, domain, family(k), integrals(k))
        $is_pointwise_finite_nonnegative_series_sum(domain, family, sum_function)
        $chap3::has_real_series_sum(integrals, total)
        =>:
            $has_finite_nonnegative_lebesgue_integral(n, domain, sum_function, total)
    # proof_debt: derive finite partial-sum integrals and apply monotone convergence.
    trust $has_finite_nonnegative_lebesgue_integral(n, domain, sum_function, total)

# Remark 8.2.12. Moving unit bumps converge pointwise to zero while every
# member integral remains one.
prop is_moving_unit_bump_family(family fn(k N+) fn(point \chap6::row_vector_space<1>) R):
    forall k N+, point \chap6::row_vector_space<1>:
        k <= point(1) < k + 1 and family(k)(point) = 1 or (point(1) < k or point(1) >= k + 1) and family(k)(point) = 0

prop has_moving_bump_counterexample(family fn(k N+) fn(point \chap6::row_vector_space<1>) R, zero_function fn(point \chap6::row_vector_space<1>) R):
    forall point \chap6::row_vector_space<1>:
        zero_function(point) = 0
    $chap3::is_pointwise_convergent_to(\chap7::euclidean_space<1>, R, chap1::real_distance, family, zero_function)
    forall k N+:
        $has_finite_nonnegative_lebesgue_integral(1, \chap7::euclidean_space<1>, family(k), 1)
    $has_finite_nonnegative_lebesgue_integral(1, \chap7::euclidean_space<1>, zero_function, 0)
    1 != 0

thm remark_8212_moving_bump_counterexample:
    ? forall family fn(k N+) fn(point \chap6::row_vector_space<1>) R, zero_function fn(point \chap6::row_vector_space<1>) R:
        $is_moving_unit_bump_family(family)
        forall point \chap6::row_vector_space<1>:
            zero_function(point) = 0
        =>:
            $has_moving_bump_counterexample(family, zero_function)
    # proof_debt: prove eventual pointwise vanishing and compute each translated
    # half-open interval's measure as one.
    trust $has_moving_bump_counterexample(family, zero_function)

# Lemma 8.2.13. Fatou's lemma bounds the tagged integral of a pointwise liminf
# by the tagged liminf of the member integrals.
prop is_pointwise_extended_nonnegative_liminf(domain set, family fn(k N+) fn(x domain) extended_nonnegative_real, pointwise_liminf fn(x domain) extended_nonnegative_real):
    forall x domain:
        $has_extended_nonnegative_sequence_liminf(fn(k N+) extended_nonnegative_real {family(k)(x)}, pointwise_liminf(x))

prop is_extended_nonnegative_integral_liminf(integrals fn(k N+) extended_nonnegative_real, integral_liminf extended_nonnegative_real):
    $has_extended_nonnegative_sequence_liminf(integrals, integral_liminf)

thm fatou_lemma:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) extended_nonnegative_real, pointwise_liminf fn(x domain) extended_nonnegative_real, integrals fn(k N+) extended_nonnegative_real, lower_integral, integral_liminf extended_nonnegative_real:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $is_extended_nonnegative_measurable(n, domain, family(k))
            $has_extended_nonnegative_lebesgue_integral(n, domain, family(k), integrals(k))
        $is_pointwise_extended_nonnegative_liminf(domain, family, pointwise_liminf)
        $has_extended_nonnegative_lebesgue_integral(n, domain, pointwise_liminf, lower_integral)
        $is_extended_nonnegative_integral_liminf(integrals, integral_liminf)
        =>:
            $chap7::is_extended_real_le(lower_integral, integral_liminf)
    # proof_debt: apply tagged monotone convergence to the pointwise tail infima.
    trust $chap7::is_extended_real_le(lower_integral, integral_liminf)

# Finite-real-valued companion to Lemma 8.2.13.
thm finite_fatou_lemma:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) R, pointwise_liminf fn(x domain) R, integrals fn(k N+) R, lower_integral, integral_liminf R:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $chap7::is_finite_real_superlevel_measurable(n, domain, family(k))
            $has_finite_nonnegative_lebesgue_integral(n, domain, family(k), integrals(k))
        $chap7::is_pointwise_real_liminf(domain, family, pointwise_liminf)
        $has_finite_nonnegative_lebesgue_integral(n, domain, pointwise_liminf, lower_integral)
        $chap7::is_real_sequence_liminf(integrals, integral_liminf)
        =>:
            lower_integral <= integral_liminf
    # proof_debt: apply monotone convergence to the pointwise tail infima.
    trust lower_integral <= integral_liminf

# Lemma 8.2.14. A tagged nonnegative measurable function with finite integral
# is finite almost everywhere.
prop is_extended_nonnegative_finite_outside_set(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real, exceptional power_set(\chap7::euclidean_space<n>)):
    exceptional $subset domain
    $chap7::has_outer_measure_value(n, exceptional, 0)
    forall x domain:
        x $in exceptional or f(x) != (1, 0)

prop is_extended_nonnegative_finite_almost_everywhere(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real):
    exist exceptional power_set(\chap7::euclidean_space<n>) st {$is_extended_nonnegative_finite_outside_set(n, domain, f, exceptional)}

thm finite_integral_implies_finite_almost_everywhere:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real, integral extended_nonnegative_real:
        $has_extended_nonnegative_lebesgue_integral(n, domain, f, integral)
        exist finite_integral R st {finite_integral >= 0, integral = (0, finite_integral)}
        =>:
            $is_extended_nonnegative_finite_almost_everywhere(n, domain, f)
    # proof_debt: show the positive-infinity level set has measure zero.
    trust $is_extended_nonnegative_finite_almost_everywhere(n, domain, f)

# Lemma 8.2.15 (Borel--Cantelli). If the sum of the measures is finite, the
# set of points lying in infinitely many family members is null.
prop is_in_infinitely_many_sets(n N+, family fn(k N+) power_set(\chap7::euclidean_space<n>), x \chap7::euclidean_space<n>):
    forall cutoff N+:
        exist k N+ st {k >= cutoff, x $in family(k)}

prop is_infinitely_often_set(n N+, family fn(k N+) power_set(\chap7::euclidean_space<n>), limsup_set power_set(\chap7::euclidean_space<n>)):
    limsup_set = {x \chap7::euclidean_space<n>: $is_in_infinitely_many_sets(n, family, x)}

thm borel_cantelli_lemma:
    ? forall n N+, family fn(k N+) power_set(\chap7::euclidean_space<n>), measures fn(k N+) R, total R, limsup_set power_set(\chap7::euclidean_space<n>):
        forall k N+:
            $chap7::is_lebesgue_measurable(n, family(k))
            $chap7::has_outer_measure_value(n, family(k), measures(k))
        $chap3::has_real_series_sum(measures, total)
        $is_infinitely_often_set(n, family, limsup_set)
        =>:
            $chap7::has_outer_measure_value(n, limsup_set, 0)
    # proof_debt: apply tagged Tonelli to the indicator functions and then
    # use Lemma 8.2.14 on their pointwise series.
    trust $chap7::has_outer_measure_value(n, limsup_set, 0)

# Definition 8.3.1. An extended-real measurable function is absolutely
# integrable when the tagged nonnegative integral of its absolute value is
# finite.
prop has_infinite_extended_real_absolute_value(value chap7::extended_real, absolute_value extended_nonnegative_real):
    value = (-1, 0) or value = (1, 0)
    absolute_value = (1, 0)

prop has_finite_extended_real_absolute_value(value chap7::extended_real, absolute_value extended_nonnegative_real):
    exist finite R st {value = (0, finite), absolute_value = (0, abs(finite))}

prop has_extended_real_absolute_value(value chap7::extended_real, absolute_value extended_nonnegative_real):
    $has_infinite_extended_real_absolute_value(value, absolute_value) or $has_finite_extended_real_absolute_value(value, absolute_value)

prop is_extended_real_absolute_value_function(domain set, f fn(x domain) chap7::extended_real, absolute_value fn(x domain) extended_nonnegative_real):
    forall x domain:
        $has_extended_real_absolute_value(f(x), absolute_value(x))

prop is_absolutely_integrable(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) chap7::extended_real):
    $chap7::is_lebesgue_measurable(n, domain)
    $chap7::is_extended_real_measurable(n, domain, f)
    exist absolute_value fn(x domain) extended_nonnegative_real, tagged_total extended_nonnegative_real, finite_total R st {$is_extended_real_absolute_value_function(domain, f, absolute_value), $has_extended_nonnegative_lebesgue_integral(n, domain, absolute_value, tagged_total), finite_total >= 0, tagged_total = (0, finite_total)}

# Finite-real-valued companion to Definition 8.3.1.
prop is_finite_absolute_value_function(domain set, f, absolute_value fn(x domain) R):
    forall x domain:
        absolute_value(x) = abs(f(x))

prop is_finite_absolutely_integrable(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R):
    $chap7::is_lebesgue_measurable(n, domain)
    $chap7::is_finite_real_superlevel_measurable(n, domain, f)
    exist absolute_value fn(x domain) R, total R st {$is_finite_absolute_value_function(domain, f, absolute_value), $has_finite_nonnegative_lebesgue_integral(n, domain, absolute_value, total)}

# Definition 8.3.2. The signed Lebesgue integral is the difference between the
# finite tagged integrals of the positive and negative parts.
prop has_positive_infinite_parts(value chap7::extended_real, positive, negative extended_nonnegative_real):
    value = (1, 0)
    positive = (1, 0)
    negative = (0, 0)

prop has_negative_infinite_parts(value chap7::extended_real, positive, negative extended_nonnegative_real):
    value = (-1, 0)
    positive = (0, 0)
    negative = (1, 0)

prop has_finite_positive_negative_parts(value chap7::extended_real, positive, negative extended_nonnegative_real):
    exist finite, positive_finite, negative_finite R st {value = (0, finite), positive_finite >= 0, negative_finite >= 0, finite < 0 or positive_finite = finite, finite >= 0 or positive_finite = 0, finite >= 0 or negative_finite = -finite, finite < 0 or negative_finite = 0, positive = (0, positive_finite), negative = (0, negative_finite)}

prop has_extended_positive_negative_parts(value chap7::extended_real, positive, negative extended_nonnegative_real):
    $has_positive_infinite_parts(value, positive, negative) or $has_negative_infinite_parts(value, positive, negative) or $has_finite_positive_negative_parts(value, positive, negative)

prop is_extended_positive_negative_part_decomposition(domain set, f fn(x domain) chap7::extended_real, positive, negative fn(x domain) extended_nonnegative_real):
    forall x domain:
        $has_extended_positive_negative_parts(f(x), positive(x), negative(x))

prop has_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) chap7::extended_real, value R):
    $is_absolutely_integrable(n, domain, f)
    exist positive, negative fn(x domain) extended_nonnegative_real, positive_integral, negative_integral extended_nonnegative_real, positive_finite, negative_finite R st {$is_extended_positive_negative_part_decomposition(domain, f, positive, negative), $has_extended_nonnegative_lebesgue_integral(n, domain, positive, positive_integral), $has_extended_nonnegative_lebesgue_integral(n, domain, negative, negative_integral), positive_finite >= 0, negative_finite >= 0, positive_integral = (0, positive_finite), negative_integral = (0, negative_finite), value = positive_finite - negative_finite}

# Finite-real-valued companion to Definition 8.3.2.
prop is_finite_positive_negative_part_decomposition(domain set, f, positive, negative fn(x domain) R):
    forall x domain:
        positive(x) >= 0
        negative(x) >= 0
        f(x) < 0 or positive(x) = f(x)
        f(x) >= 0 or positive(x) = 0
        f(x) >= 0 or negative(x) = -f(x)
        f(x) < 0 or negative(x) = 0
        f(x) = positive(x) - negative(x)
        abs(f(x)) = positive(x) + negative(x)

prop has_finite_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value R):
    $is_finite_absolutely_integrable(n, domain, f)
    exist positive, negative fn(x domain) R, positive_integral, negative_integral R st {$is_finite_positive_negative_part_decomposition(domain, f, positive, negative), $has_finite_nonnegative_lebesgue_integral(n, domain, positive, positive_integral), $has_finite_nonnegative_lebesgue_integral(n, domain, negative, negative_integral), value = positive_integral - negative_integral}

# Consequences after Definition 8.3.2. The signed integral extends the
# nonnegative integral and obeys the integral triangle inequality.
prop is_extended_nonnegative_view(domain set, nonnegative fn(x domain) extended_nonnegative_real, signed fn(x domain) chap7::extended_real):
    forall x domain:
        signed(x) = nonnegative(x)

thm nonnegative_signed_integral_consistency:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), nonnegative fn(x domain) extended_nonnegative_real, signed fn(x domain) chap7::extended_real, tagged_value extended_nonnegative_real, value R:
        $is_extended_nonnegative_view(domain, nonnegative, signed)
        $has_extended_nonnegative_lebesgue_integral(n, domain, nonnegative, tagged_value)
        tagged_value = (0, value)
        =>:
            $has_lebesgue_integral(n, domain, signed, value)
    # proof_debt: identify the positive part with f and the negative part with
    # zero, then simplify the signed integral definition.
    trust $has_lebesgue_integral(n, domain, signed, value)

prop has_signed_integral_triangle_conclusion(signed_value, positive_value, negative_value, absolute_value R):
    abs(signed_value) <= positive_value + negative_value
    positive_value + negative_value = absolute_value

thm lebesgue_integral_triangle_inequality:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) chap7::extended_real, positive, negative, absolute_function fn(x domain) extended_nonnegative_real, signed_value R, positive_integral, negative_integral, absolute_integral extended_nonnegative_real, positive_value, negative_value, absolute_value R:
        $is_extended_positive_negative_part_decomposition(domain, f, positive, negative)
        $is_extended_real_absolute_value_function(domain, f, absolute_function)
        $has_lebesgue_integral(n, domain, f, signed_value)
        $has_extended_nonnegative_lebesgue_integral(n, domain, positive, positive_integral)
        $has_extended_nonnegative_lebesgue_integral(n, domain, negative, negative_integral)
        $has_extended_nonnegative_lebesgue_integral(n, domain, absolute_function, absolute_integral)
        positive_integral = (0, positive_value)
        negative_integral = (0, negative_value)
        absolute_integral = (0, absolute_value)
        =>:
            $has_signed_integral_triangle_conclusion(signed_value, positive_value, negative_value, absolute_value)
    # proof_debt: apply the real triangle inequality to the two finite part
    # integrals and nonnegative additivity to |f| = f^+ + f^-.
    trust $has_signed_integral_triangle_conclusion(signed_value, positive_value, negative_value, absolute_value)

# Proposition 8.3.3. Extended-real absolutely integrable functions and their
# real-valued integrals obey linearity, monotonicity, and null-set invariance.
prop has_finite_extended_real_sum(left, right, total chap7::extended_real):
    exist left_finite, right_finite R st {left = (0, left_finite), right = (0, right_finite), total = (0, left_finite + right_finite)}

prop has_positive_infinite_extended_real_sum(left, right, total chap7::extended_real):
    left = (1, 0) and right != (-1, 0) or right = (1, 0) and left != (-1, 0)
    total = (1, 0)

prop has_negative_infinite_extended_real_sum(left, right, total chap7::extended_real):
    left = (-1, 0) and right != (1, 0) or right = (-1, 0) and left != (1, 0)
    total = (-1, 0)

prop has_extended_real_sum(left, right, total chap7::extended_real):
    $has_finite_extended_real_sum(left, right, total) or $has_positive_infinite_extended_real_sum(left, right, total) or $has_negative_infinite_extended_real_sum(left, right, total)

prop is_pointwise_extended_real_sum_outside_set(n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function fn(x domain) chap7::extended_real, exceptional power_set(\chap7::euclidean_space<n>)):
    exceptional $subset domain
    $chap7::has_outer_measure_value(n, exceptional, 0)
    forall x domain:
        x $in exceptional or $has_extended_real_sum(f(x), g(x), sum_function(x))

prop is_pointwise_extended_real_sum_almost_everywhere(n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function fn(x domain) chap7::extended_real):
    exist exceptional power_set(\chap7::euclidean_space<n>) st {$is_pointwise_extended_real_sum_outside_set(n, domain, f, g, sum_function, exceptional)}

prop has_zero_extended_real_scalar_product(scalar R, value, scaled chap7::extended_real):
    scalar = 0
    scaled = (0, 0)

prop has_finite_extended_real_scalar_product(scalar R, value, scaled chap7::extended_real):
    exist finite R st {value = (0, finite), scaled = (0, scalar * finite)}

prop has_positive_extended_real_scalar_product(scalar R+, value, scaled chap7::extended_real):
    value = (1, 0) and scaled = (1, 0) or value = (-1, 0) and scaled = (-1, 0)

prop has_negative_extended_real_scalar_product(scalar R-, value, scaled chap7::extended_real):
    value = (1, 0) and scaled = (-1, 0) or value = (-1, 0) and scaled = (1, 0)

prop has_extended_real_scalar_product(scalar R, value, scaled chap7::extended_real):
    $has_zero_extended_real_scalar_product(scalar, value, scaled) or $has_finite_extended_real_scalar_product(scalar, value, scaled) or scalar > 0 and $has_positive_extended_real_scalar_product(scalar, value, scaled) or scalar < 0 and $has_negative_extended_real_scalar_product(scalar, value, scaled)

prop is_pointwise_extended_real_scalar_product(domain set, scalar R, f, scaled fn(x domain) chap7::extended_real):
    forall x domain:
        $has_extended_real_scalar_product(scalar, f(x), scaled(x))

prop is_pointwise_extended_real_le(domain set, f, g fn(x domain) chap7::extended_real):
    forall x domain:
        $chap7::is_extended_real_le(f(x), g(x))

prop is_extended_real_equal_outside_set(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) chap7::extended_real, exceptional power_set(\chap7::euclidean_space<n>)):
    exceptional $subset domain
    $chap7::has_outer_measure_value(n, exceptional, 0)
    forall x domain:
        x $in exceptional or f(x) = g(x)

prop is_extended_real_equal_outside_null_set(n N+, domain power_set(\chap7::euclidean_space<n>), f, g fn(x domain) chap7::extended_real):
    exist exceptional power_set(\chap7::euclidean_space<n>) st {$is_extended_real_equal_outside_set(n, domain, f, g, exceptional)}

prop has_extended_signed_integral_full_laws(n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function, scaled_function fn(x domain) chap7::extended_real, scalar, F, G R):
    $has_lebesgue_integral(n, domain, scaled_function, scalar * F)
    $has_lebesgue_integral(n, domain, sum_function, F + G)
    not $is_pointwise_extended_real_le(domain, f, g) or F <= G
    not $is_extended_real_equal_outside_null_set(n, domain, f, g) or F = G

thm lebesgue_integral_laws:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function, scaled_function fn(x domain) chap7::extended_real, scalar, F, G R:
        $is_pointwise_extended_real_sum_almost_everywhere(n, domain, f, g, sum_function)
        $is_pointwise_extended_real_scalar_product(domain, scalar, f, scaled_function)
        $has_lebesgue_integral(n, domain, f, F)
        $has_lebesgue_integral(n, domain, g, G)
        =>:
            $has_extended_signed_integral_full_laws(n, domain, f, g, sum_function, scaled_function, scalar, F, G)
    # proof_debt: reduce extended-real functions to finite representatives off
    # null exceptional sets, then use tagged nonnegative integration.
    trust $has_extended_signed_integral_full_laws(n, domain, f, g, sum_function, scaled_function, scalar, F, G)

# Finite-real-valued companion to Proposition 8.3.3.
prop has_finite_signed_integral_full_laws(n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function, scaled_function fn(x domain) R, scalar, F, G R):
    $has_finite_lebesgue_integral(n, domain, scaled_function, scalar * F)
    $has_finite_lebesgue_integral(n, domain, sum_function, F + G)
    not $majorizes(domain, g, f) or F <= G
    not $chap7::is_equal_outside_null_set(n, domain, f, g) or F = G

thm finite_lebesgue_integral_laws:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f, g, sum_function, scaled_function fn(x domain) R, scalar, F, G R:
        $chap7::is_pointwise_real_sum(domain, f, g, sum_function)
        forall x domain:
            scaled_function(x) = scalar * f(x)
        $has_finite_lebesgue_integral(n, domain, f, F)
        $has_finite_lebesgue_integral(n, domain, g, G)
        =>:
            $has_finite_signed_integral_full_laws(n, domain, f, g, sum_function, scaled_function, scalar, F, G)
    # proof_debt: reduce signed functions to positive and negative parts.
    trust $has_finite_signed_integral_full_laws(n, domain, f, g, sum_function, scaled_function, scalar, F, G)

# Theorem 8.3.4. Dominated convergence permits interchange of a pointwise
# limit and the Lebesgue integral.
prop is_pointwise_extended_absolutely_dominated(domain set, f fn(x domain) chap7::extended_real, dominator fn(x domain) extended_nonnegative_real):
    forall x domain:
        exist absolute_value extended_nonnegative_real st {$has_extended_real_absolute_value(f(x), absolute_value), $chap7::is_extended_real_le(absolute_value, dominator(x))}

prop has_finite_extended_nonnegative_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) extended_nonnegative_real):
    exist tagged_total extended_nonnegative_real, finite_total R st {$has_extended_nonnegative_lebesgue_integral(n, domain, f, tagged_total), finite_total >= 0, tagged_total = (0, finite_total)}

prop is_pointwise_finite_absolutely_dominated(domain set, f, dominator fn(x domain) R):
    forall x domain:
        abs(f(x)) <= dominator(x)

thm dominated_convergence_theorem:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) chap7::extended_real, limit fn(x domain) chap7::extended_real, dominator fn(x domain) extended_nonnegative_real, integrals fn(k N+) R:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $has_lebesgue_integral(n, domain, family(k), integrals(k))
            $is_pointwise_extended_absolutely_dominated(domain, family(k), dominator)
        $chap7::is_pointwise_extended_real_limit(domain, family, limit)
        $is_extended_nonnegative_measurable(n, domain, dominator)
        $has_finite_extended_nonnegative_integral(n, domain, dominator)
        =>:
            exist value R st {$has_lebesgue_integral(n, domain, limit, value), $chap1::has_metric_limit(R, chap1::real_distance, integrals, value)}
    # proof_debt: apply Fatou to the positive differences from the dominator.
    trust exist value R st {$has_lebesgue_integral(n, domain, limit, value), $chap1::has_metric_limit(R, chap1::real_distance, integrals, value)}

# Finite-real-valued companion to Theorem 8.3.4.
thm finite_dominated_convergence_theorem:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), family fn(k N+) fn(x domain) R, limit, dominator fn(x domain) R, integrals fn(k N+) R:
        $chap7::is_lebesgue_measurable(n, domain)
        forall k N+:
            $chap7::is_finite_real_superlevel_measurable(n, domain, family(k))
            $has_finite_lebesgue_integral(n, domain, family(k), integrals(k))
            $is_pointwise_finite_absolutely_dominated(domain, family(k), dominator)
        $chap3::is_pointwise_convergent_to(domain, R, chap1::real_distance, family, limit)
        $is_finite_absolutely_integrable(n, domain, dominator)
        =>:
            exist value R st {$has_finite_lebesgue_integral(n, domain, limit, value), $chap1::has_metric_limit(R, chap1::real_distance, integrals, value)}
    # proof_debt: finite-real companion to dominated convergence.
    trust exist value R st {$has_finite_lebesgue_integral(n, domain, limit, value), $chap1::has_metric_limit(R, chap1::real_distance, integrals, value)}

# Definition 8.3.5. Upper and lower Lebesgue integrals optimize over
# extended-real integrable majorants and minorants.
prop has_upper_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) chap7::extended_real, value R):
    $chap7::is_lebesgue_measurable(n, domain)
    forall g fn(x domain) chap7::extended_real, integral R:
        $is_pointwise_extended_real_le(domain, f, g)
        $has_lebesgue_integral(n, domain, g, integral)
        =>:
            value <= integral
    forall epsilon R+:
        exist g fn(x domain) chap7::extended_real, integral R st {$is_pointwise_extended_real_le(domain, f, g), $has_lebesgue_integral(n, domain, g, integral), integral < value + epsilon}

prop has_lower_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) chap7::extended_real, value R):
    $chap7::is_lebesgue_measurable(n, domain)
    forall g fn(x domain) chap7::extended_real, integral R:
        $is_pointwise_extended_real_le(domain, g, f)
        $has_lebesgue_integral(n, domain, g, integral)
        =>:
            integral <= value
    forall epsilon R+:
        exist g fn(x domain) chap7::extended_real, integral R st {$is_pointwise_extended_real_le(domain, g, f), $has_lebesgue_integral(n, domain, g, integral), value - epsilon < integral}

# Lemma 8.3.6. Equal upper and lower integrals characterize integrability.
thm upper_lower_lebesgue_integral_characterizes_integrability:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) chap7::extended_real, value R:
        $has_upper_lebesgue_integral(n, domain, f, value)
        $has_lower_lebesgue_integral(n, domain, f, value)
        =>:
            $has_lebesgue_integral(n, domain, f, value)
    # proof_debt: squeeze integrable majorants and minorants with a common value.
    trust $has_lebesgue_integral(n, domain, f, value)

# Finite-real-valued companions to Definition 8.3.5 and Lemma 8.3.6.
prop has_finite_upper_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value R):
    $chap7::is_lebesgue_measurable(n, domain)
    forall g fn(x domain) R, integral R:
        $majorizes(domain, g, f)
        $has_finite_lebesgue_integral(n, domain, g, integral)
        =>:
            value <= integral
    forall epsilon R+:
        exist g fn(x domain) R, integral R st {$majorizes(domain, g, f), $has_finite_lebesgue_integral(n, domain, g, integral), integral < value + epsilon}

prop has_finite_lower_lebesgue_integral(n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value R):
    $chap7::is_lebesgue_measurable(n, domain)
    forall g fn(x domain) R, integral R:
        $majorizes(domain, f, g)
        $has_finite_lebesgue_integral(n, domain, g, integral)
        =>:
            integral <= value
    forall epsilon R+:
        exist g fn(x domain) R, integral R st {$majorizes(domain, f, g), $has_finite_lebesgue_integral(n, domain, g, integral), value - epsilon < integral}

thm finite_upper_lower_lebesgue_integral_characterizes_integrability:
    ? forall n N+, domain power_set(\chap7::euclidean_space<n>), f fn(x domain) R, value R:
        $has_finite_upper_lebesgue_integral(n, domain, f, value)
        $has_finite_lower_lebesgue_integral(n, domain, f, value)
        =>:
            $has_finite_lebesgue_integral(n, domain, f, value)
    # proof_debt: finite-real companion to the upper/lower criterion.
    trust $has_finite_lebesgue_integral(n, domain, f, value)

# Proposition 8.4.1. Every Riemann-integrable function on a bounded interval is
# absolutely integrable, and the Riemann and Lebesgue values agree.
thm riemann_integral_agrees_with_lebesgue_integral:
    ? forall I power_set(R), f fn(x I) R, value R:
        $chap3::has_riemann_integral_value(I, f, value)
        =>:
            $has_finite_lebesgue_integral(1, I, f, value)
    trust $has_finite_lebesgue_integral(1, I, f, value)

# Example after Proposition 8.4.1. The rational indicator on the unit interval
# is Lebesgue integrable but not Riemann integrable.
prop is_rational_indicator_on_unit_interval(f fn(x '[0, 1]) R):
    forall x '[0, 1]:
        x $in Q and f(x) = 1 or not x $in Q and f(x) = 0

thm rational_indicator_separates_lebesgue_and_riemann_integrals:
    ? forall f fn(x '[0, 1]) R:
        $is_rational_indicator_on_unit_interval(f)
        =>:
            not exist value R st {$chap3::has_riemann_integral_value('[0, 1], f, value)}
            $has_finite_lebesgue_integral(1, '[0, 1], f, 0)
    # proof_debt: use the density of rationals and irrationals to rule out
    # Riemann integrability.
    trust not exist value R st {$chap3::has_riemann_integral_value('[0, 1], f, value)}
    # proof_debt: identify the function almost everywhere with zero using the
    # rational null-set calculation.
    trust $has_finite_lebesgue_integral(1, '[0, 1], f, 0)

# Theorem 8.5.1. Fubini's theorem identifies an absolutely integrable function
# on R^2 with both iterated integrals, almost everywhere defined.
prop is_real_null_set(exceptional power_set(R)):
    $chap7::has_outer_measure_value(1, exceptional, 0)

prop is_fubini_section_data(f fn(x \chap6::row_vector_space<2>) R, x_sections fn(x R) fn(y R) R, y_sections fn(y R) fn(x R) R, first_sections, second_sections fn(t R) R, x_exceptional, y_exceptional power_set(R)):
    $is_real_null_set(x_exceptional)
    $is_real_null_set(y_exceptional)
    forall point \chap6::row_vector_space<2>:
        x_sections(point(1))(point(2)) = f(point)
        y_sections(point(2))(point(1)) = f(point)
    forall x R:
        x $in x_exceptional or $has_finite_lebesgue_integral(1, R, x_sections(x), first_sections(x))
    forall y R:
        y $in y_exceptional or $has_finite_lebesgue_integral(1, R, y_sections(y), second_sections(y))

prop are_fubini_iterated_integrals(f fn(x \chap6::row_vector_space<2>) R, first_sections, second_sections fn(t R) R, value R):
    exist x_sections fn(x R) fn(y R) R, y_sections fn(y R) fn(x R) R, x_exceptional, y_exceptional power_set(R) st {$is_fubini_section_data(f, x_sections, y_sections, first_sections, second_sections, x_exceptional, y_exceptional)}
    $has_finite_lebesgue_integral(1, R, first_sections, value)
    $has_finite_lebesgue_integral(1, R, second_sections, value)

prop has_fubini_iterated_integral(f fn(x \chap6::row_vector_space<2>) R, value R):
    exist first_sections, second_sections fn(t R) R st {$are_fubini_iterated_integrals(f, first_sections, second_sections, value)}

thm fubini_theorem:
    ? forall f fn(x \chap6::row_vector_space<2>) R:
        $is_finite_absolutely_integrable(2, \chap7::euclidean_space<2>, f)
        =>:
            exist value R st {$has_finite_lebesgue_integral(2, \chap7::euclidean_space<2>, f, value), $has_fubini_iterated_integral(f, value)}
    trust exist value R st {$has_finite_lebesgue_integral(2, \chap7::euclidean_space<2>, f, value), $has_fubini_iterated_integral(f, value)}

# Remark 8.5.2. A null vertical-line example explains why Fubini only promises
# integrable sections almost everywhere.
prop is_fubini_null_vertical_line_example(f fn(point \chap6::row_vector_space<2>) R):
    forall point \chap6::row_vector_space<2>:
        point(1) = 0
        point(2) > 0
        =>:
            f(point) = 1
    forall point \chap6::row_vector_space<2>:
        point(1) = 0
        point(2) < 0
        =>:
            f(point) = -1
    forall point \chap6::row_vector_space<2>:
        point(1) != 0 or point(2) = 0
        =>:
            f(point) = 0

prop is_vertical_section_family(f fn(point \chap6::row_vector_space<2>) R, sections fn(x R) fn(y R) R):
    forall point \chap6::row_vector_space<2>:
        sections(point(1))(point(2)) = f(point)

prop has_fubini_exceptional_section_results(f fn(point \chap6::row_vector_space<2>) R, sections fn(x R) fn(y R) R):
    $is_finite_absolutely_integrable(2, \chap7::euclidean_space<2>, f)
    $has_finite_lebesgue_integral(2, \chap7::euclidean_space<2>, f, 0)
    not $is_finite_absolutely_integrable(1, R, sections(0))
    forall x R:
        x != 0
        =>:
            $has_finite_lebesgue_integral(1, R, sections(x), 0)

thm remark_852_exceptional_section_is_necessary:
    ? forall f fn(point \chap6::row_vector_space<2>) R, sections fn(x R) fn(y R) R:
        $is_fubini_null_vertical_line_example(f)
        $is_vertical_section_family(f, sections)
        =>:
            $has_fubini_exceptional_section_results(f, sections)
    # proof_debt: use the planar null line, then calculate its exceptional
    # section and the identically-zero sections off that line.
    trust $has_fubini_exceptional_section_results(f, sections)
