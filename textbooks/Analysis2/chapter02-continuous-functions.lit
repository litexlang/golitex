# Chapter 2: Continuous Functions on Metric Spaces
#
# This chapter follows Tao's source order. Standalone exercises are omitted.
# Named results whose proofs are assigned to exercises retain source-facing
# statements with explicit, narrow proof-debt boundaries.

# Definition 2.1.1 (Continuity). The residual predicate isolates one selected
# epsilon--delta pair used by the quantified pointwise definition.
prop is_metric_delta_controlled_at(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X, epsilon R_pos, delta R_pos):
    forall x X:
        dist_X(x, a) < delta
        =>:
            dist_Y(f(x), f(a)) < epsilon

prop is_metric_continuous_at(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X):
    forall epsilon R_pos:
        exist delta R_pos st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, epsilon, delta)}

prop is_metric_continuous(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y):
    forall a X:
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)

# This checked projection is the representative use probe for Definition
# 2.1.1 and is reused by later domain-level theorems.
thm metric_continuous_implies_continuous_at:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X:
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        =>:
            $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
    by def $is_metric_continuous(X, Y, dist_X, dist_Y, f)
    $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)

# The two residual relations below expose statements (b) and (c) of Theorem
# 2.1.4 without conflating either characterization with the definition.
prop preserves_metric_limits_at(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X):
    forall u fn(n N_pos) X:
        $chap1::has_metric_limit(X, dist_X, u, a)
        =>:
            $chap1::has_metric_limit(Y, dist_Y, fn(n N_pos) Y {f(u(n))}, f(a))

prop is_metric_open_neighborhood_witness_at(X, Y set, dist_X fn(x, y X) R, f fn(x X) Y, a X, V power_set(Y), U power_set(X)):
    $chap1::is_metric_open(X, dist_X, U)
    a $in U
    forall x U:
        f(x) $in V

prop has_metric_open_neighborhood_form_at(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X):
    forall V power_set(Y):
        $chap1::is_metric_open(Y, dist_Y, V)
        f(a) $in V
        =>:
            exist U power_set(X) st {$is_metric_open_neighborhood_witness_at(X, Y, dist_X, f, a, V, U)}

# Theorem 2.1.4 (Continuity preserves convergence). Tao states a three-way
# equivalence and assigns its proof to Exercise 2.1.1. The four directions
# below keep all three source clauses independently reusable.
thm metric_continuous_at_implies_preserves_limits:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        =>:
            $preserves_metric_limits_at(X, Y, dist_X, dist_Y, f, a)
    # trust: Tao assigns this direction to Exercise 2.1.1.
    trust $preserves_metric_limits_at(X, Y, dist_X, dist_Y, f, a)

thm preserves_limits_implies_metric_continuous_at:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $preserves_metric_limits_at(X, Y, dist_X, dist_Y, f, a)
        =>:
            $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
    # trust: Tao assigns this direction to Exercise 2.1.1.
    trust $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)

thm metric_continuous_at_implies_open_neighborhood_form:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        =>:
            $has_metric_open_neighborhood_form_at(X, Y, dist_X, dist_Y, f, a)
    # trust: Tao assigns this direction to Exercise 2.1.1.
    trust $has_metric_open_neighborhood_form_at(X, Y, dist_X, dist_Y, f, a)

thm open_neighborhood_form_implies_metric_continuous_at:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y, a X:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $has_metric_open_neighborhood_form_at(X, Y, dist_X, dist_Y, f, a)
        =>:
            $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
    # trust: Tao assigns this direction to Exercise 2.1.1.
    trust $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)

# Theorem 2.1.5 uses the canonical inverse image of a subset.
template<X, Y set, f fn(x X) Y, E power_set(Y)>:
    have function_preimage power_set(X) = {x X: f(x) $in E}

prop preserves_metric_limits(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y):
    forall a X, u fn(n N_pos) X:
        $chap1::has_metric_limit(X, dist_X, u, a)
        =>:
            $chap1::has_metric_limit(Y, dist_Y, fn(n N_pos) Y {f(u(n))}, f(a))

prop pulls_back_metric_open_sets(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y):
    forall V power_set(Y):
        $chap1::is_metric_open(Y, dist_Y, V)
        =>:
            $chap1::is_metric_open(X, dist_X, \function_preimage<X, Y, f, V>)

prop pulls_back_metric_closed_sets(X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y):
    forall F power_set(Y):
        $chap1::is_metric_closed(Y, dist_Y, F)
        =>:
            $chap1::is_metric_closed(X, dist_X, \function_preimage<X, Y, f, F>)

# Theorem 2.1.5. The sequential equivalence is checked from Theorem 2.1.4.
thm metric_continuous_implies_preserves_all_limits:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        =>:
            $preserves_metric_limits(X, Y, dist_X, dist_Y, f)
    claim:
        ? forall a X, u fn(n N_pos) X:
            $chap1::has_metric_limit(X, dist_X, u, a)
            =>:
                $chap1::has_metric_limit(Y, dist_Y, fn(n N_pos) Y {f(u(n))}, f(a))
        by thm metric_continuous_implies_continuous_at(X, Y, dist_X, dist_Y, f, a)
        by thm metric_continuous_at_implies_preserves_limits(X, Y, dist_X, dist_Y, f, a)
        by def $preserves_metric_limits_at(X, Y, dist_X, dist_Y, f, a)
        $chap1::has_metric_limit(Y, dist_Y, fn(n N_pos) Y {f(u(n))}, f(a))
    by def $preserves_metric_limits(X, Y, dist_X, dist_Y, f)

thm preserves_all_limits_implies_metric_continuous:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $preserves_metric_limits(X, Y, dist_X, dist_Y, f)
        =>:
            $is_metric_continuous(X, Y, dist_X, dist_Y, f)
    claim:
        ? forall a X:
            $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        claim:
            ? $preserves_metric_limits_at(X, Y, dist_X, dist_Y, f, a)
            claim:
                ? forall u fn(n N_pos) X:
                    $chap1::has_metric_limit(X, dist_X, u, a)
                    =>:
                        $chap1::has_metric_limit(Y, dist_Y, fn(n N_pos) Y {f(u(n))}, f(a))
                by def $preserves_metric_limits(X, Y, dist_X, dist_Y, f)
                $chap1::has_metric_limit(Y, dist_Y, fn(n N_pos) Y {f(u(n))}, f(a))
            by def $preserves_metric_limits_at(X, Y, dist_X, dist_Y, f, a)
        by thm preserves_limits_implies_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
    by def $is_metric_continuous(X, Y, dist_X, dist_Y, f)

thm metric_continuous_implies_pulls_back_open_sets:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        =>:
            $pulls_back_metric_open_sets(X, Y, dist_X, dist_Y, f)
    # trust: Tao assigns this characterization to Exercise 2.1.2.
    trust $pulls_back_metric_open_sets(X, Y, dist_X, dist_Y, f)

thm pulls_back_open_sets_implies_metric_continuous:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $pulls_back_metric_open_sets(X, Y, dist_X, dist_Y, f)
        =>:
            $is_metric_continuous(X, Y, dist_X, dist_Y, f)
    # trust: Tao assigns this characterization to Exercise 2.1.2.
    trust $is_metric_continuous(X, Y, dist_X, dist_Y, f)

thm metric_continuous_implies_pulls_back_closed_sets:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        =>:
            $pulls_back_metric_closed_sets(X, Y, dist_X, dist_Y, f)
    # trust: Tao assigns this characterization to Exercise 2.1.2.
    trust $pulls_back_metric_closed_sets(X, Y, dist_X, dist_Y, f)

thm pulls_back_closed_sets_implies_metric_continuous:
    ? forall X, Y set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, f fn(x X) Y:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $pulls_back_metric_closed_sets(X, Y, dist_X, dist_Y, f)
        =>:
            $is_metric_continuous(X, Y, dist_X, dist_Y, f)
    # trust: Tao assigns this characterization to Exercise 2.1.2.
