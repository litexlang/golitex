# Corollary 2.1.7 (Continuity is preserved by composition). Both the
# pointwise and global statements are checked directly.
thm metric_continuous_at_composition:
    ? forall X, Y, W set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, dist_W fn(x, y W) R, f fn(x X) Y, g fn(y Y) W, a X:
        $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        $is_metric_continuous_at(Y, W, dist_Y, dist_W, g, f(a))
        =>:
            $is_metric_continuous_at(X, W, dist_X, dist_W, fn(x X) W {g(f(x))}, a)
    claim:
        ? forall epsilon R_pos:
            exist delta R_pos st {$is_metric_delta_controlled_at(X, W, dist_X, dist_W, fn(x X) W {g(f(x))}, a, epsilon, delta)}
        by def $is_metric_continuous_at(Y, W, dist_Y, dist_W, g, f(a))
        obtain eta from exist eta R_pos st {$is_metric_delta_controlled_at(Y, W, dist_Y, dist_W, g, f(a), epsilon, eta)}
        by def $is_metric_continuous_at(X, Y, dist_X, dist_Y, f, a)
        obtain delta from exist delta R_pos st {$is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, eta, delta)}
        witness exist radius R_pos st {$is_metric_delta_controlled_at(X, W, dist_X, dist_W, fn(x X) W {g(f(x))}, a, epsilon, radius)} from delta:
            claim:
                ? forall x X:
                    dist_X(x, a) < delta
                    =>:
                        dist_W(fn(t X) W {g(f(t))}(x), fn(t X) W {g(f(t))}(a)) < epsilon
                by def $is_metric_delta_controlled_at(X, Y, dist_X, dist_Y, f, a, eta, delta)
                dist_Y(f(x), f(a)) < eta
                by def $is_metric_delta_controlled_at(Y, W, dist_Y, dist_W, g, f(a), epsilon, eta)
                dist_W(g(f(x)), g(f(a))) < epsilon
                fn(t X) W {g(f(t))}(x) = g(f(x))
                fn(t X) W {g(f(t))}(a) = g(f(a))
                dist_W(fn(t X) W {g(f(t))}(x), fn(t X) W {g(f(t))}(a)) = dist_W(g(f(x)), g(f(a))) < epsilon
            by def $is_metric_delta_controlled_at(X, W, dist_X, dist_W, fn(x X) W {g(f(x))}, a, epsilon, delta)
    by def $is_metric_continuous_at(X, W, dist_X, dist_W, fn(x X) W {g(f(x))}, a)

thm metric_continuous_composition:
    ? forall X, Y, W set, dist_X fn(x, y X) R, dist_Y fn(x, y Y) R, dist_W fn(x, y W) R, f fn(x X) Y, g fn(y Y) W:
        $chap1::is_metric_space(X, dist_X)
        $chap1::is_metric_space(Y, dist_Y)
        $chap1::is_metric_space(W, dist_W)
        $is_metric_continuous(X, Y, dist_X, dist_Y, f)
        $is_metric_continuous(Y, W, dist_Y, dist_W, g)
        =>:
            $is_metric_continuous(X, W, dist_X, dist_W, fn(x X) W {g(f(x))})
    claim:
        ? forall a X:
            $is_metric_continuous_at(X, W, dist_X, dist_W, fn(x X) W {g(f(x))}, a)
        by thm metric_continuous_implies_continuous_at(X, Y, dist_X, dist_Y, f, a)
        by thm metric_continuous_implies_continuous_at(Y, W, dist_Y, dist_W, g, f(a))
        by thm metric_continuous_at_composition(X, Y, W, dist_X, dist_Y, dist_W, f, g, a)
    by def $is_metric_continuous(X, W, dist_X, dist_W, fn(x X) W {g(f(x))})

# Lemma 2.2.1. A real-valued function pair is represented in the existing
# two-dimensional finite-vector carrier.
have fn real_pair_coordinate(a, b R, j closed_range(1, 2)) R by cases:
    case j = 1: a
    case j != 1: b

template<X set, f, g fn(x X) R>:
    have fn real_function_pair(x X) \chap1::finite_real_vector<2> = fn(j N_pos: j <= 2) R {real_pair_coordinate(f(x), g(x), j)}

thm real_function_pair_continuous_at_implies_components:
    ? forall X set, dist fn(x, y X) R, f, g fn(x X) R, a X:
        $chap1::is_metric_space(X, dist)
        $is_metric_continuous_at(X, \chap1::finite_real_vector<2>, dist, \chap1::l2_distance<2>, \real_function_pair<X, f, g>, a)
        =>:
            $is_metric_continuous_at(X, R, dist, chap1::real_distance, f, a)
            $is_metric_continuous_at(X, R, dist, chap1::real_distance, g, a)
    # trust: Tao assigns Lemma 2.2.1 to Exercise 2.2.1.
    trust:
        $is_metric_continuous_at(X, R, dist, chap1::real_distance, f, a)
        $is_metric_continuous_at(X, R, dist, chap1::real_distance, g, a)

thm real_components_continuous_at_imply_pair:
    ? forall X set, dist fn(x, y X) R, f, g fn(x X) R, a X:
        $chap1::is_metric_space(X, dist)
        $is_metric_continuous_at(X, R, dist, chap1::real_distance, f, a)
        $is_metric_continuous_at(X, R, dist, chap1::real_distance, g, a)
        =>:
            $is_metric_continuous_at(X, \chap1::finite_real_vector<2>, dist, \chap1::l2_distance<2>, \real_function_pair<X, f, g>, a)
    # trust: Tao assigns Lemma 2.2.1 to Exercise 2.2.1.
    trust $is_metric_continuous_at(X, \chap1::finite_real_vector<2>, dist, \chap1::l2_distance<2>, \real_function_pair<X, f, g>, a)

thm real_function_pair_continuous_implies_components:
    ? forall X set, dist fn(x, y X) R, f, g fn(x X) R:
        $chap1::is_metric_space(X, dist)
        $is_metric_continuous(X, \chap1::finite_real_vector<2>, dist, \chap1::l2_distance<2>, \real_function_pair<X, f, g>)
        =>:
            $is_metric_continuous(X, R, dist, chap1::real_distance, f)
            $is_metric_continuous(X, R, dist, chap1::real_distance, g)
    # trust: Tao assigns Lemma 2.2.1 to Exercise 2.2.1.
    trust:
        $is_metric_continuous(X, R, dist, chap1::real_distance, f)
        $is_metric_continuous(X, R, dist, chap1::real_distance, g)

thm real_components_continuous_imply_pair:
    ? forall X set, dist fn(x, y X) R, f, g fn(x X) R:
        $chap1::is_metric_space(X, dist)
        $is_metric_continuous(X, R, dist, chap1::real_distance, f)
        $is_metric_continuous(X, R, dist, chap1::real_distance, g)
        =>:
            $is_metric_continuous(X, \chap1::finite_real_vector<2>, dist, \chap1::l2_distance<2>, \real_function_pair<X, f, g>)
    # trust: Tao assigns Lemma 2.2.1 to Exercise 2.2.1.
    trust $is_metric_continuous(X, \chap1::finite_real_vector<2>, dist, \chap1::l2_distance<2>, \real_function_pair<X, f, g>)

# Lemma 2.2.2. These are the concrete arithmetic maps whose continuity the
# source assigns to Exercise 2.2.2.
have fn real_pair_add(v \chap1::finite_real_vector<2>) R = v(1) + v(2)

have fn real_pair_subtract(v \chap1::finite_real_vector<2>) R = v(1) - v(2)

have fn real_pair_multiply(v \chap1::finite_real_vector<2>) R = v(1) * v(2)

have fn real_pair_maximum(v \chap1::finite_real_vector<2>) R by cases:
    case v(1) >= v(2): v(1)
    case v(1) < v(2): v(2)

have fn real_pair_minimum(v \chap1::finite_real_vector<2>) R by cases:
    case v(1) <= v(2): v(1)
    case v(1) > v(2): v(2)

have nonzero_second_real_pairs set = {v \chap1::finite_real_vector<2>: v(2) != 0}

have fn real_pair_divide(v nonzero_second_real_pairs) R = v(1) / v(2)

have fn real_scalar_multiply(c, x R) R = c * x

thm real_pair_add_is_continuous_at_every_point:
    ? forall a \chap1::finite_real_vector<2>:
        $is_metric_continuous_at(\chap1::finite_real_vector<2>, R, \chap1::l2_distance<2>, chap1::real_distance, real_pair_add, a)
    # trust: Tao assigns Lemma 2.2.2 to Exercise 2.2.2.
    trust $is_metric_continuous_at(\chap1::finite_real_vector<2>, R, \chap1::l2_distance<2>, chap1::real_distance, real_pair_add, a)

