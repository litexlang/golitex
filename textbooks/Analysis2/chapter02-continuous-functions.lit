thm real_pair_divide_is_continuous_at_every_point:
    ? forall a nonzero_second_real_pairs:
        $is_metric_continuous_at(nonzero_second_real_pairs, R, fn(x, y nonzero_second_real_pairs) R {\chap1::l2_distance<2>(x, y)}, chap1::real_distance, real_pair_divide, a)
    # trust: Tao assigns Lemma 2.2.2 to Exercise 2.2.2.
    trust $is_metric_continuous_at(nonzero_second_real_pairs, R, fn(x, y nonzero_second_real_pairs) R {\chap1::l2_distance<2>(x, y)}, chap1::real_distance, real_pair_divide, a)

thm real_scalar_multiply_is_continuous_at_every_point:
    ? forall c, a R:
        $is_metric_continuous_at(R, R, chap1::real_distance, chap1::real_distance, fn(x R) R {real_scalar_multiply(c, x)}, a)
    # trust: Tao assigns Lemma 2.2.2 to Exercise 2.2.2.
    trust $is_metric_continuous_at(R, R, chap1::real_distance, chap1::real_distance, fn(x R) R {real_scalar_multiply(c, x)}, a)

# Corollary 2.2.3. Pointwise arithmetic combinations remain callable maps.
template<X set, f, g fn(x X) R>:
    have fn real_function_sum(x X) R = f(x) + g(x)

template<X set, f, g fn(x X) R>:
    have fn real_function_difference(x X) R = f(x) - g(x)

template<X set, f, g fn(x X) R>:
    have fn real_function_product(x X) R = f(x) * g(x)

template<X set, f, g fn(x X) R>:
    have fn real_function_maximum(x X) R = real_pair_maximum(\real_function_pair<X, f, g>(x))

template<X set, f, g fn(x X) R>:
    have fn real_function_minimum(x X) R = real_pair_minimum(\real_function_pair<X, f, g>(x))

template<X set, f fn(x X) R, c R>:
    have fn real_function_scalar_multiple(x X) R = c * f(x)

have fn real_safe_divide(a, b R) R by cases:
    case b != 0: a / b
    case b = 0: 0

template<X set, f, g fn(x X) R>:
    have fn real_function_quotient(x X) R = real_safe_divide(f(x), g(x))

prop is_nowhere_zero(X set, g fn(x X) R):
    forall x X:
        g(x) != 0

thm continuous_at_real_function_sum:
    ? forall X set, dist fn(x, y X) R, f, g fn(x X) R, a X:
        $chap1::is_metric_space(X, dist)
        $is_metric_continuous_at(X, R, dist, chap1::real_distance, f, a)
        $is_metric_continuous_at(X, R, dist, chap1::real_distance, g, a)
        =>:
            $is_metric_continuous_at(X, R, dist, chap1::real_distance, \real_function_sum<X, f, g>, a)
    # trust: composition is checked up to the pair/add-to-named-sum function equality.
    trust $is_metric_continuous_at(X, R, dist, chap1::real_distance, \real_function_sum<X, f, g>, a)

thm continuous_real_function_sum:
    ? forall X set, dist fn(x, y X) R, f, g fn(x X) R:
        $chap1::is_metric_space(X, dist)
        $is_metric_continuous(X, R, dist, chap1::real_distance, f)
        $is_metric_continuous(X, R, dist, chap1::real_distance, g)
        =>:
            $is_metric_continuous(X, R, dist, chap1::real_distance, \real_function_sum<X, f, g>)
    claim:
        ? forall a X:
            $is_metric_continuous_at(X, R, dist, chap1::real_distance, \real_function_sum<X, f, g>, a)
        by thm metric_continuous_implies_continuous_at(X, R, dist, chap1::real_distance, f, a)
        by thm metric_continuous_implies_continuous_at(X, R, dist, chap1::real_distance, g, a)
        by thm continuous_at_real_function_sum(X, dist, f, g, a)
    by def $is_metric_continuous(X, R, dist, chap1::real_distance, \real_function_sum<X, f, g>)

