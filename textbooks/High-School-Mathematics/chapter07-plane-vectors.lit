# High School Mathematics
# Plane Vectors
# Source unit: scripts/high_school_book/knowledge_core_json/required-2.json (required-2.plane_vectors).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

have fn add2(u, v cart(R, R)) cart(R, R) = (u[1] + v[1], u[2] + v[2])
have fn sub2(u, v cart(R, R)) cart(R, R) = (u[1] - v[1], u[2] - v[2])
have fn smul2(k R, u cart(R, R)) cart(R, R) = (k * u[1], k * u[2])
have fn dot2(u, v cart(R, R)) R = u[1] * v[1] + u[2] * v[2]
have fn norm2_sq(u cart(R, R)) R = dot2(u, u)

prop parallel2(u, v cart(R, R)):
    exist k R st {u[1] = k * v[1], u[2] = k * v[2]}

prop perpendicular2(u, v cart(R, R)):
    dot2(u, v) = 0

add2((1, 2), (3, 4)) = (4, 6)
sub2((5, 7), (2, 3)) = (3, 4)
smul2(3, (2, -1)) = (6, -3)
dot2((1, 2), (3, 4)) = 1 * 3 + 2 * 4 = 11
norm2_sq((3, 4)) = dot2((3, 4), (3, 4)) = 25

forall u, v cart(R, R):
    add2(u, v) = (u[1] + v[1], u[2] + v[2]) = (v[1] + u[1], v[2] + u[2]) = add2(v, u)
    dot2(u, v) = u[1] * v[1] + u[2] * v[2] = v[1] * u[1] + v[2] * u[2] = dot2(v, u)

$perpendicular2((1, 0), (0, 1))

witness exist k R st {(2, 4)[1] = k * (1, 2)[1], (2, 4)[2] = k * (1, 2)[2]} from 2
$parallel2((2, 4), (1, 2))
