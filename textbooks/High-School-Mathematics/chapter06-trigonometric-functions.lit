# High School Mathematics
# Trigonometric Functions
# Source unit: scripts/high_school_book/knowledge_core_json/required-2.json (required-2.trigonometric_functions).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

forall x R:
    -1 <= sin(x) <= 1
    -1 <= cos(x) <= 1

forall x R:
    sin(-x) = -sin(x)
    cos(-x) = cos(x)

forall x R:
    sin(x + 2 * pi) = sin(x)
    cos(x + 2 * pi) = cos(x)

forall x R:
    cos(x) != 0
    cos(x + pi) != 0
    cos(x + 1 * pi) != 0
    =>:
        tan(x + pi) = tan(x)
        tan(x + 1 * pi) = tan(x)

have fn transformed_sine(A, omega, phi, x R) R = A * sin(omega * x + phi)
have fn sine_scale_amplitude(A R) R = abs(A)

transformed_sine(2, 3, pi / 6, 0) = 2 * sin(3 * 0 + pi / 6)
sine_scale_amplitude(-3) = abs(-3) = 3
