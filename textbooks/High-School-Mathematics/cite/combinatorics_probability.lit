# High-school combinatorics and probability interfaces.

# Pascal's triangle gives a total, executable combination-count function.
have fn pascal_entry(a Z, b Z: a >= 0, b >= 0) N by induc a + b from 0:
    case a = 0: 1
    case a > 0:
        case b = 0: 1
        case b > 0: pascal_entry(a - 1, b) + pascal_entry(a, b - 1)

have fn choose_fn(n, k N) N:
    case k <= n: pascal_entry(k, n - k)
    case k > n: 0

prop has_combination_count(n, r N+, value R):
    r <= n
    value * factorial(r) = product(1, r, fn(k N+) R {n - r + k})

prop pascal_identity_for_combination_counts(n, r N+):
    r < n
    r > 1
    choose_fn(n, r) = choose_fn(n - 1, r) + choose_fn(n - 1, r - 1)

prop sum_of_binomial_coefficients(n N+):
    sum(0, n, fn(k N) N {choose_fn(n, k)}) = 2^n

prop is_bernoulli_distribution(p R, values, probs finite_seq(R, 2)):
    0 <= p <= 1
    values(1) = 0
    values(2) = 1
    probs(1) = 1 - p
    probs(2) = p

prop binomial_probability_mass(n, k N, p, probability R):
    k <= n
    0 <= p <= 1
    probability = choose_fn(n, k) * p^k * (1 - p)^(n - k)

prop hypergeometric_probability_relation(population, success_count, draws, k N, probability R):
    success_count <= population
    draws <= population
    k <= success_count
    k <= draws
    draws - k <= population - success_count
    probability * choose_fn(population, draws) = choose_fn(success_count, k) * choose_fn(population - success_count, draws - k)

prop normal_density_value(mu, x R, sigma, normalization R+, exponent, density R):
    exponent * (2 * sigma^2) = -1 * (x - mu)^2
    density * normalization = exp(exponent)

prop is_probability_vector2(p finite_seq(R, 2)):
    p(1) >= 0
    p(2) >= 0
    p(1) + p(2) = 1

have fn expectation2(values, probs finite_seq(R, 2)) R = values(1) * probs(1) + values(2) * probs(2)
have fn variance2(values, probs finite_seq(R, 2)) R = (values(1) - expectation2(values, probs))^2 * probs(1) + (values(2) - expectation2(values, probs))^2 * probs(2)
have fn affine_combine2(X, Y finite_seq(R, 2), a, b R) finite_seq(R, 2) = fn(k N+: k <= 2) R {a * X(k) + b * Y(k)}

# Native factorial supplies the positive-integer product used below.
have fn permutation_count(n, r N+: r <= n) R = product(1, r, fn(k N+) R {n - r + k})

thm combination_count_from_permutations:
    ? forall n, r N+, value R:
        r <= n
        value * factorial(r) = permutation_count(n, r)
        =>:
            $has_combination_count(n, r, value)
    r <= n
    value * factorial(r) = permutation_count(n, r)
    permutation_count(n, r) = product(1, r, fn(k N+) R {n - r + k})
    value * factorial(r) = product(1, r, fn(k N+) R {n - r + k})
    by def:
        ? $has_combination_count(n, r, value)

thm pascal_identity:
    ? forall n, r N+:
        r < n
        r > 1
        =>:
            $pascal_identity_for_combination_counts(n, r)
    r < n
    r > 1
    r <= n
    r <= n - 1
    r - 1 <= n - 1
    n - r > 0
    r > 0

    claim:
        ? choose_fn(n, r) = pascal_entry(r, n - r)
        by cases:
            ? choose_fn(n, r) = pascal_entry(r, n - r)
            case r <= n:
                do_nothing
            case r > n:
                impossible r < n

    claim:
        ? choose_fn(n - 1, r) = pascal_entry(r, (n - 1) - r)
        by cases:
            ? choose_fn(n - 1, r) = pascal_entry(r, (n - 1) - r)
            case r <= n - 1:
                do_nothing
            case r > n - 1:
                impossible r <= n - 1

    claim:
        ? choose_fn(n - 1, r - 1) = pascal_entry(r - 1, (n - 1) - (r - 1))
        by cases:
            ? choose_fn(n - 1, r - 1) = pascal_entry(r - 1, (n - 1) - (r - 1))
            case r - 1 <= n - 1:
                do_nothing
            case r - 1 > n - 1:
                impossible r - 1 <= n - 1

    (n - 1) - r = n - r - 1
    (n - 1) - (r - 1) = n - r
    choose_fn(n - 1, r - 1) = pascal_entry(r - 1, (n - 1) - (r - 1)) = pascal_entry(r - 1, n - r)
    choose_fn(n - 1, r) = pascal_entry(r, (n - 1) - r) = pascal_entry(r, n - r - 1)
    pascal_entry(r, n - r) = pascal_entry(r - 1, n - r) + pascal_entry(r, n - r - 1)
    choose_fn(n, r) = pascal_entry(r, n - r) = pascal_entry(r - 1, n - r) + pascal_entry(r, n - r - 1)

    choose_fn(n - 1, r - 1) + choose_fn(n - 1, r) = pascal_entry(r - 1, n - r) + choose_fn(n - 1, r)
    choose_fn(n - 1, r - 1) + choose_fn(n - 1, r) = pascal_entry(r - 1, n - r) + pascal_entry(r, n - r - 1)

    choose_fn(n, r) = choose_fn(n - 1, r - 1) + choose_fn(n - 1, r) = choose_fn(n - 1, r) + choose_fn(n - 1, r - 1)
    by def:
        ? $pascal_identity_for_combination_counts(n, r)

thm binomial_sum:
    ? forall n N+:
        $sum_of_binomial_coefficients(n)
    # trust: retained after third-pass audit; this is the finite binomial theorem at x=y=1 and needs checked finite-sum induction/reindexing support.
    trust $sum_of_binomial_coefficients(n)

thm expectation_affine_two:
    ? forall X, Y finite_seq(R, 2), p finite_seq(R, 2), a, b R:
        $is_probability_vector2(p)
        =>:
            expectation2(affine_combine2(X, Y, a, b), p) = a * expectation2(X, p) + b * expectation2(Y, p)
    $is_probability_vector2(p)
    affine_combine2(X, Y, a, b)(1) = a * X(1) + b * Y(1)
    affine_combine2(X, Y, a, b)(2) = a * X(2) + b * Y(2)
    expectation2(X, p) = X(1) * p(1) + X(2) * p(2)
    expectation2(Y, p) = Y(1) * p(1) + Y(2) * p(2)
    expectation2(affine_combine2(X, Y, a, b), p) = affine_combine2(X, Y, a, b)(1) * p(1) + affine_combine2(X, Y, a, b)(2) * p(2)
    expectation2(affine_combine2(X, Y, a, b), p) = (a * X(1) + b * Y(1)) * p(1) + (a * X(2) + b * Y(2)) * p(2) = a * (X(1) * p(1) + X(2) * p(2)) + b * (Y(1) * p(1) + Y(2) * p(2))
    a * expectation2(X, p) + b * expectation2(Y, p) = a * (X(1) * p(1) + X(2) * p(2)) + b * (Y(1) * p(1) + Y(2) * p(2))
    expectation2(affine_combine2(X, Y, a, b), p) = a * expectation2(X, p) + b * expectation2(Y, p)

thm bernoulli_distribution_from_entries:
    ? forall p R, values, probs finite_seq(R, 2):
        0 <= p <= 1
        values(1) = 0
        values(2) = 1
        probs(1) = 1 - p
        probs(2) = p
        =>:
            $is_bernoulli_distribution(p, values, probs)
    0 <= p <= 1
    values(1) = 0
    values(2) = 1
    probs(1) = 1 - p
    probs(2) = p
    by def:
        ? $is_bernoulli_distribution(p, values, probs)

thm binomial_probability_mass_formula:
    ? forall n, k N, p, probability R:
        k <= n
        0 <= p <= 1
        probability = choose_fn(n, k) * p^k * (1 - p)^(n - k)
        =>:
            $binomial_probability_mass(n, k, p, probability)
    k <= n
    0 <= p <= 1
    probability = choose_fn(n, k) * p^k * (1 - p)^(n - k)
    by def:
        ? $binomial_probability_mass(n, k, p, probability)

thm cauchy_schwarz_three:
    ? forall a1, a2, a3, b1, b2, b3 R:
        (a1 * b1 + a2 * b2 + a3 * b3)^2 <= (a1^2 + a2^2 + a3^2) * (b1^2 + b2^2 + b3^2)
    (a1 * b2 - a2 * b1)^2 >= 0
    (a1 * b3 - a3 * b1)^2 >= 0
    (a2 * b3 - a3 * b2)^2 >= 0
    (a1 * b2 - a2 * b1)^2 + (a1 * b3 - a3 * b1)^2 + (a2 * b3 - a3 * b2)^2 >= 0
    (a1^2 + a2^2 + a3^2) * (b1^2 + b2^2 + b3^2) - (a1 * b1 + a2 * b2 + a3 * b3)^2 = (a1 * b2 - a2 * b1)^2 + (a1 * b3 - a3 * b1)^2 + (a2 * b3 - a3 * b2)^2
    (a1^2 + a2^2 + a3^2) * (b1^2 + b2^2 + b3^2) - (a1 * b1 + a2 * b2 + a3 * b3)^2 >= 0
    (a1 * b1 + a2 * b2 + a3 * b3)^2 <= (a1^2 + a2^2 + a3^2) * (b1^2 + b2^2 + b3^2)

thm correlation_bound_from_covariance:
    ? forall variance_x, variance_y, covariance, correlation R:
        variance_x > 0
        variance_y > 0
        covariance^2 <= variance_x * variance_y
        correlation * sqrt(variance_x * variance_y) = covariance
        =>:
            -1 <= correlation <= 1
    variance_x > 0
    variance_y > 0
    covariance^2 <= variance_x * variance_y
    correlation * sqrt(variance_x * variance_y) = covariance
    variance_x * variance_y > 0
    sqrt(variance_x * variance_y) > 0
    sqrt(variance_x * variance_y) != 0
    sqrt(variance_x * variance_y)^2 = variance_x * variance_y
    (correlation * sqrt(variance_x * variance_y))^2 = covariance^2
    (correlation * sqrt(variance_x * variance_y))^2 = correlation^2 * sqrt(variance_x * variance_y)^2
    correlation^2 * sqrt(variance_x * variance_y)^2 = correlation^2 * (variance_x * variance_y)
    (correlation * sqrt(variance_x * variance_y))^2 = correlation^2 * (variance_x * variance_y)
    correlation^2 * (variance_x * variance_y) = covariance^2
    correlation^2 * (variance_x * variance_y) <= variance_x * variance_y

    claim:
        ? correlation^2 <= 1
        by contra:
            ? correlation^2 <= 1
            correlation^2 > 1
            correlation^2 * (variance_x * variance_y) > variance_x * variance_y
            impossible correlation^2 * (variance_x * variance_y) <= variance_x * variance_y

    claim:
        ? correlation <= 1
        by contra:
            ? correlation <= 1
            correlation > 1
            correlation > 0
            correlation * correlation > 1 * correlation = correlation > 1
            correlation * correlation > 1
            correlation^2 = correlation * correlation
            correlation^2 > 1
            impossible correlation^2 <= 1

    claim:
        ? -1 <= correlation
        by contra:
            ? -1 <= correlation
            correlation < -1
            -correlation > 1
            -correlation > 0
            (-correlation) * (-correlation) > 1 * (-correlation) = -correlation > 1
            (-correlation) * (-correlation) > 1
            (-correlation)^2 = (-correlation) * (-correlation)
            (-correlation)^2 > 1
            (-correlation)^2 = correlation^2
            correlation^2 > 1
            impossible correlation^2 <= 1

    -1 <= correlation <= 1
