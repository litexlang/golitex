# High-school analysis interfaces shared by isolated source files.

prop derivative_limit_condition(X set, f fn(x R) R, x0, L, epsilon R, delta R+):
    forall x R:
        x $in X
        x != x0
        abs(x - x0) < delta
        =>:
            abs((f(x) - f(x0)) / (x - x0) - L) < epsilon

prop has_derivative_at_R(X set, f fn(x R) R, x0, L R):
    x0 $in X
    forall epsilon R+:
        exist delta R+ st {$derivative_limit_condition(X, f, x0, L, epsilon, delta)}

prop derivative_function_on_R(a, b R, f fn(x R) R, df fn(x R) R):
    a <= b
    forall x R:
        a <= x <= b
        =>:
            $has_derivative_at_R(R, f, x, df(x))

prop is_increasing_on_R(a, b R, f fn(x R) R):
    a <= b
    forall x, y R:
        a <= x <= b
        a <= y <= b
        x <= y
        =>:
            f(x) <= f(y)

prop is_decreasing_on_R(a, b R, f fn(x R) R):
    a <= b
    forall x, y R:
        a <= x <= b
        a <= y <= b
        x <= y
        =>:
            f(y) <= f(x)

prop local_maximum_near(f fn(x R) R, x0, value, delta R+):
    forall x R:
        abs(x - x0) < delta
        =>:
            f(x) <= value

prop local_minimum_near(f fn(x R) R, x0, value, delta R+):
    forall x R:
        abs(x - x0) < delta
        =>:
            value <= f(x)

prop has_local_maximum_at_R(f fn(x R) R, x0, value R):
    f(x0) = value
    exist delta R+ st {$local_maximum_near(f, x0, value, delta)}

prop has_local_minimum_at_R(f fn(x R) R, x0, value R):
    f(x0) = value
    exist delta R+ st {$local_minimum_near(f, x0, value, delta)}

thm square_derivative_R:
    ? forall x0 R:
        $has_derivative_at_R(R, fn(x R) R {x^2}, x0, 2 * x0)
    x0 $in R
    claim:
        ? forall epsilon R+:
            exist delta R+ st {$derivative_limit_condition(R, fn(x R) R {x^2}, x0, 2 * x0, epsilon, delta)}
        witness exist delta R+ st {$derivative_limit_condition(R, fn(x R) R {x^2}, x0, 2 * x0, epsilon, delta)} from epsilon:
            forall x R:
                x $in R
                x != x0
                abs(x - x0) < epsilon
                =>:
                    x - x0 != 0
                    (fn(t R) R {t^2})(x) = x^2
                    (fn(t R) R {t^2})(x0) = x0^2
                    x^2 - x0^2 = (x - x0) * (x + x0)
                    (x^2 - x0^2) / (x - x0) = x + x0
                    (x + x0) - 2 * x0 = x - x0
                    abs(((fn(t R) R {t^2})(x) - (fn(t R) R {t^2})(x0)) / (x - x0) - 2 * x0) = abs(x - x0) < epsilon
            by def $derivative_limit_condition(R, fn(x R) R {x^2}, x0, 2 * x0, epsilon, epsilon)
    by def $has_derivative_at_R(R, fn(x R) R {x^2}, x0, 2 * x0)

thm linear_derivative_R:
    ? forall m, b, x0 R:
        $has_derivative_at_R(R, fn(x R) R {m * x + b}, x0, m)
    x0 $in R
    claim:
        ? forall epsilon R+:
            exist delta R+ st {$derivative_limit_condition(R, fn(x R) R {m * x + b}, x0, m, epsilon, delta)}
        witness exist delta R+ st {$derivative_limit_condition(R, fn(x R) R {m * x + b}, x0, m, epsilon, delta)} from epsilon:
            forall x R:
                x $in R
                x != x0
                abs(x - x0) < epsilon
                =>:
                    x - x0 != 0
                    (fn(t R) R {m * t + b})(x) = m * x + b
                    (fn(t R) R {m * t + b})(x0) = m * x0 + b
                    (m * x + b) - (m * x0 + b) = m * (x - x0)
                    ((m * x + b) - (m * x0 + b)) / (x - x0) = m
                    m - m = 0
                    abs(m - m) = abs(0) = 0
                    0 < epsilon
                    abs(((fn(t R) R {m * t + b})(x) - (fn(t R) R {m * t + b})(x0)) / (x - x0) - m) = abs(m - m) = 0 < epsilon
            by def $derivative_limit_condition(R, fn(x R) R {m * x + b}, x0, m, epsilon, epsilon)
    by def $has_derivative_at_R(R, fn(x R) R {m * x + b}, x0, m)

thm positive_derivative_implies_increasing:
    ? forall a, b R, f, df fn(x R) R:
        $derivative_function_on_R(a, b, f, df)
        forall x R:
            a <= x <= b
            =>:
                df(x) > 0
        =>:
            $is_increasing_on_R(a, b, f)
    # trust: second-pass retained; the mean-value theorem needed for derivative-sign monotonicity is not modeled locally.
    trust $is_increasing_on_R(a, b, f)

thm negative_derivative_implies_decreasing:
    ? forall a, b R, f, df fn(x R) R:
        $derivative_function_on_R(a, b, f, df)
        forall x R:
            a <= x <= b
            =>:
                df(x) < 0
        =>:
            $is_decreasing_on_R(a, b, f)
    # trust: second-pass retained; the mean-value theorem needed for derivative-sign monotonicity is not modeled locally.
    trust $is_decreasing_on_R(a, b, f)

thm finite_union_cardinality:
    ? forall A, B set:
        intersect(A, B) = {}
        $is_finite_set(A)
        $is_finite_set(B)
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    intersect(A, B) = {}
    $is_finite_set(A)
    $is_finite_set(B)
    finite_set_size(intersect(A, B)) = finite_set_size({}) = 0
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B)) = finite_set_size(A) + finite_set_size(B)
