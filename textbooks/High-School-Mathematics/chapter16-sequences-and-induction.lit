# High School Mathematics
# Sequences and Induction
# Source unit: scripts/high_school_book/knowledge_core_json/optional-1.json (optional-1.sequences_and_induction).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

have arithmetic_sample finite_seq(R, 3) = [1, 4, 7]
arithmetic_sample $in fn(n N+: n <= 3) R
arithmetic_sample(1) = 1
arithmetic_sample(2) = 4
arithmetic_sample(3) = 7

have fn arith_term(a, d R, n N+) R = a + (n - 1) * d

forall a, d R, n N+:
    arith_term(a, d, n + 1) - arith_term(a, d, n) = (a + ((n + 1) - 1) * d) - (a + (n - 1) * d) = d

arith_term(2, 3, 1) = 2 + (1 - 1) * 3 = 2
arith_term(2, 3, 2) = 2 + (2 - 1) * 3 = 5
arith_term(2, 3, 3) = 2 + (3 - 1) * 3 = 8
arith_term(2, 3, 4) = 2 + (4 - 1) * 3 = 11

have fn geo_term(a, q R, n N+) R = a * q^(n - 1)
geo_term(2, 3, 1) = 2 * 3^(1 - 1) = 2
geo_term(2, 3, 2) = 2 * 3^(2 - 1) = 6
geo_term(2, 3, 3) = 2 * 3^(3 - 1) = 18
geo_term(2, 3, 4) = 2 * 3^(4 - 1) = 54

fn(k N+) R {arith_term(2, 3, k)}(1) = arith_term(2, 3, 1) = 2
fn(k N+) R {arith_term(2, 3, k)}(2) = arith_term(2, 3, 2) = 5
fn(k N+) R {arith_term(2, 3, k)}(3) = arith_term(2, 3, 3) = 8
sum(1, 1, fn(k N+) R {arith_term(2, 3, k)}) = fn(k N+) R {arith_term(2, 3, k)}(1) = 2
sum(1, 2, fn(k N+) R {arith_term(2, 3, k)}) = sum(1, 1, fn(k N+) R {arith_term(2, 3, k)}) + fn(k N+) R {arith_term(2, 3, k)}(2) = 2 + fn(k N+) R {arith_term(2, 3, k)}(2) = 2 + 5 = 7
sum(1, 3, fn(k N+) R {arith_term(2, 3, k)}) = sum(1, 2, fn(k N+) R {arith_term(2, 3, k)}) + fn(k N+) R {arith_term(2, 3, k)}(3) = 7 + fn(k N+) R {arith_term(2, 3, k)}(3) = 7 + 8 = 15

fn(k N+) R {geo_term(2, 3, k)}(1) = geo_term(2, 3, 1) = 2
fn(k N+) R {geo_term(2, 3, k)}(2) = geo_term(2, 3, 2) = 6
fn(k N+) R {geo_term(2, 3, k)}(3) = geo_term(2, 3, 3) = 18
sum(1, 1, fn(k N+) R {geo_term(2, 3, k)}) = fn(k N+) R {geo_term(2, 3, k)}(1) = 2
sum(1, 2, fn(k N+) R {geo_term(2, 3, k)}) = sum(1, 1, fn(k N+) R {geo_term(2, 3, k)}) + fn(k N+) R {geo_term(2, 3, k)}(2) = 2 + fn(k N+) R {geo_term(2, 3, k)}(2) = 2 + 6 = 8
sum(1, 3, fn(k N+) R {geo_term(2, 3, k)}) = sum(1, 2, fn(k N+) R {geo_term(2, 3, k)}) + fn(k N+) R {geo_term(2, 3, k)}(3) = 8 + fn(k N+) R {geo_term(2, 3, k)}(3) = 8 + 18 = 26

have fn fib(n Z: n >= 0) R by induc n from 0:
    case n = 0: 0
    case n = 1: 1
    case n > 1: fib(n - 1) + fib(n - 2)

fib(0) = 0
fib(1) = 1
fib(2) = fib(1) + fib(0) = 1
fib(3) = fib(2) + fib(1) = 2

have fn babylon_step(x R+, n R+) R = (x + n / x) / 2
babylon_step(1, 2) = (1 + 2 / 1) / 2 = 3 / 2

claim:
    ? forall n N:
        2 ^ n >= n + 1
    by induc n from 0:
        ? 2 ^ n >= n + 1
        2^0 = 1 >= 0 + 1

        forall m Z:
            m >= 0
            2^m >= m + 1
            =>:
                2^m * 2^1 >= (m + 1) * 2
                2 ^ (m + 1) = 2 ^ m * 2^1 >= (m + 1) * 2 = (m + 1) + (m + 1) >= m + 1 + 1
