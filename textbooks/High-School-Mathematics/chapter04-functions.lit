# High School Mathematics
# Functions
# Source unit: scripts/high_school_book/knowledge_core_json/required-1.json (required-1.functions).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

have fn identity(x R) R = x
have fn identity_on_range(y fn_range(identity)) R = y
have fn square(x R) R = x^2
have fn neg_identity(x R) R = -x
have fn constant_five(x R) R = 5
have fn shifted_zero(x R) R = x - 2

forall x R:
    identity(-x) = -x = -identity(x)
by def $HighSchoolCite::functions::odd_fn(identity)

forall x R:
    square(-x) = (-x)^2 = x^2 = square(x)
by def $HighSchoolCite::functions::even_fn(square)

shifted_zero(2) = 2 - 2 = 0
by def $HighSchoolCite::functions::zero_of(shifted_zero, 2)

forall x R:
    identity(identity(x)) = identity(x) = x
by def $HighSchoolCite::functions::inverse_functions(identity, identity)

forall t R:
    neg_identity(t) = -t

forall y R:
    identity(y) = y
    shifted_zero(y) = y - 2

forall x, y R:
    x <= y
    =>:
        identity(x) = x <= y = identity(y)
        identity(x) <= identity(y)

forall x, y R:
    x < y
    =>:
        identity(x) = x < y = identity(y)
        identity(x) < identity(y)

by def $HighSchoolCite::functions::increasing_fn(identity)
by def $HighSchoolCite::functions::strictly_increasing_fn(identity)

claim:
    ? forall f fn(x R) R:
        $HighSchoolCite::functions::strictly_increasing_fn(f)
        =>:
            $HighSchoolCite::functions::injective_real_fn(f)
    release thm HighSchoolCite::functions::strictly_increasing_implies_injective(f)

claim:
    ? forall x, y R:
        identity(x) = identity(y)
        =>:
            x = y
    x = identity(x) = identity(y) = y

    release thm HighSchoolCite::functions::strictly_increasing_implies_injective(identity)

claim:
    ? forall f fn(x R) R:
        $HighSchoolCite::functions::injective_real_fn(f)
        =>:
            exist g fn(y fn_range(f)) R st {$HighSchoolCite::functions::left_inverse_on_range(f, g)}
    release thm HighSchoolCite::functions::inverse_on_range_exists(f)

forall x R:
    identity_on_range(identity(x)) = identity(x) = x
by def $HighSchoolCite::functions::left_inverse_on_range(identity, identity_on_range)
witness exist g fn(y fn_range(identity)) R st {$HighSchoolCite::functions::left_inverse_on_range(identity, g)} from identity_on_range:
    $HighSchoolCite::functions::left_inverse_on_range(identity, identity_on_range)

forall x, y R:
    x <= y
    =>:
        neg_identity(y) = -y <= -x = neg_identity(x)
        neg_identity(y) <= neg_identity(x)

forall x, y R:
    x < y
    =>:
        neg_identity(y) = -y < -x = neg_identity(x)
        neg_identity(y) < neg_identity(x)

by def $HighSchoolCite::functions::decreasing_fn(neg_identity)
by def $HighSchoolCite::functions::strictly_decreasing_fn(neg_identity)

forall x R:
    constant_five(x) = 5 = constant_five(0)
    constant_five(x) <= constant_five(0)
    constant_five(0) <= constant_five(x)

by def $HighSchoolCite::functions::maximum_at(constant_five, 0)
by def $HighSchoolCite::functions::minimum_at(constant_five, 0)

by def $fn_eq(identity, fn(y R) R {y})
by def $fn_eq(shifted_zero, fn(y R) R {y - 2})

claim:
    ? forall f, g fn(x R) R:
        $HighSchoolCite::functions::inverse_functions(f, g)
        =>:
            HighSchoolCite::functions::graph_of(g) = HighSchoolCite::functions::reflected_graph(HighSchoolCite::functions::graph_of(f))
    release thm HighSchoolCite::functions::inverse_graph_reflection(f, g)

HighSchoolCite::functions::graph_of(identity) = HighSchoolCite::functions::reflected_graph(HighSchoolCite::functions::graph_of(identity))

identity(2) $in fn_range(identity)
fn_range(identity) $subset R

witness exist preimage_witness R st {identity(2) = identity(preimage_witness)} from 2:
    identity(2) = identity(2)

release thm HighSchoolCite::functions::shifted_zero_continuity_on_closed_interval(shifted_zero, 1, 3)

claim:
    ? forall f fn(x R) R, a, b R:
        a < b
        $HighSchoolCite::functions::continuous_on_closed_interval(f, a, b)
        f(a) <= 0
        0 <= f(b)
        =>:
            exist c R st {a <= c <= b, f(c) = 0}
    release thm HighSchoolCite::functions::intermediate_value_zero(f, a, b)

shifted_zero(1) = -1 <= 0
0 <= 1 = shifted_zero(3)
release thm HighSchoolCite::functions::intermediate_value_zero(shifted_zero, 1, 3)

forall x R:
    floor(x) <= x
    x < floor(x) + 1
