# High School Mathematics
# Probability Distributions
# Source unit: scripts/high_school_book/knowledge_core_json/optional-2.json (optional-2.probability_distributions).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

have fn probability(favorable, total R: total > 0) R = favorable / total
have fn conditional_probability(p_ab, p_b R: p_b > 0) R = p_ab / p_b
have fn bayes_posterior(prior, likelihood, evidence R: evidence > 0) R = likelihood * prior / evidence

have bernoulli_values finite_seq(R, 2) = [0, 1]
have fair_bernoulli_probs finite_seq(R, 2) = [1 / 2, 1 / 2]

$HighSchoolCite::combinatorics_probability::is_probability_vector2(fair_bernoulli_probs)

probability(3, 10) = 3 / 10
conditional_probability(1 / 5, 2 / 5) = (1 / 5) / (2 / 5) = 1 / 2
bayes_posterior(1 / 3, 3 / 4, 1 / 2) = (3 / 4) * (1 / 3) / (1 / 2) = 1 / 2

HighSchoolCite::combinatorics_probability::expectation2(bernoulli_values, fair_bernoulli_probs) = 0 * (1 / 2) + 1 * (1 / 2) = 1 / 2
HighSchoolCite::combinatorics_probability::variance2(bernoulli_values, fair_bernoulli_probs) = (0 - HighSchoolCite::combinatorics_probability::expectation2(bernoulli_values, fair_bernoulli_probs))^2 * (1 / 2) + (1 - HighSchoolCite::combinatorics_probability::expectation2(bernoulli_values, fair_bernoulli_probs))^2 * (1 / 2) = 1 / 4

claim:
    ? forall X, Y finite_seq(R, 2), p finite_seq(R, 2), a, b R:
        $HighSchoolCite::combinatorics_probability::is_probability_vector2(p)
        =>:
            HighSchoolCite::combinatorics_probability::expectation2(HighSchoolCite::combinatorics_probability::affine_combine2(X, Y, a, b), p) = a * HighSchoolCite::combinatorics_probability::expectation2(X, p) + b * HighSchoolCite::combinatorics_probability::expectation2(Y, p)
1release thm HighSchoolCite::combinatorics_probability::expectation_affine_two(X, Y, p, a, b)

claim:
    ? $HighSchoolCite::combinatorics_probability::is_bernoulli_distribution(1 / 2, bernoulli_values, fair_bernoulli_probs)
    0 <= 1 / 2 <= 1
    bernoulli_values(1) = 0
    bernoulli_values(2) = 1
    fair_bernoulli_probs(1) = 1 / 2 = 1 - 1 / 2
    fair_bernoulli_probs(2) = 1 / 2
1release thm HighSchoolCite::combinatorics_probability::bernoulli_distribution_from_entries(1 / 2, bernoulli_values, fair_bernoulli_probs)

claim:
    ? forall n, k N, p, mass R:
        k <= n
        0 <= p <= 1
        mass = HighSchoolCite::combinatorics_probability::choose_fn(n, k) * p^k * (1 - p)^(n - k)
        =>:
            $HighSchoolCite::combinatorics_probability::binomial_probability_mass(n, k, p, mass)
1release thm HighSchoolCite::combinatorics_probability::binomial_probability_mass_formula(n, k, p, mass)
