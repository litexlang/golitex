# High School Mathematics
# Powers, Exponentials, and Logarithms
# Source unit: scripts/high_school_book/knowledge_core_json/required-1.json (required-1.powers_exponentials_logarithms).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

forall a R:
    a^0 = 1

forall a R, m, n N:
    a^(m + n) = a^m * a^n

forall a, b R, n N:
    (a * b)^n = a^n * b^n

forall a N+, n N:
    a^n $in N+

forall x, y R, m N+:
    x >= 0
    y >= 0
    x <= y
    =>:
        x^m <= y^m

log(2, 8) = 3
log(10, 100) = 2
log(5, 5) = 1
log(3, 1) = 0

forall a, b R+:
    a != 1
    =>:
        a ^ log(a, b) = b
        log(a, a) = 1
        log(a, 1) = 0

forall a, x, y R+:
    a != 1
    =>:
        log(a, x * y) = log(a, x) + log(a, y)
        log(a, x / y) = log(a, x) - log(a, y)

forall a, x, b R+:
    a != 1
    =>:
        log(a, x^b) = b * log(a, x)

forall a, x, y R+:
    a > 1
    x < y
    =>:
        log(a, x) < log(a, y)

forall a, x, y R+:
    a < 1
    x < y
    =>:
        log(a, x) > log(a, y)

forall a, b R+, c R:
    a != 1
    =>:
        log(a, b) = c
    <=>:
        a^c = b

log(2, 8 * 4) = log(2, 8) + log(2, 4) = 3 + 2 = 5
log(4, 64) = log(2^2, 64) = log(2, 64) / 2 = 6 / 2 = 3

