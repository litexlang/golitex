# High School Mathematics
# Equations and Inequalities
# Source unit: scripts/high_school_book/knowledge_core_json/required-1.json (required-1.equations_and_inequalities).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

prop solution_of_zero(f fn(x R) R, x0 R):
    f(x0) = 0

prop root_of_quadratic(a, b, c, x R):
    a * x^2 + b * x + c = 0

prop double_root_candidate(a, b, c, x R):
    $root_of_quadratic(a, b, c, x)
    b^2 - 4 * a * c = 0

have fn linear_example(x R) R = 3 * x - 6
$solution_of_zero(linear_example, 2)

forall a, b, c R:
    a = b
    =>:
        a + c = b + c
        a - c = b - c
        a * c = b * c

forall a, b, c R:
    a <= b
    =>:
        a + c <= b + c
        a - c <= b - c

forall a, b, k R:
    a <= b
    k > 0
    =>:
        a * k <= b * k

forall a, b, k R:
    a <= b
    k < 0
    =>:
        a * k >= b * k

forall r, s, x R:
    (x - r) * (x - s) = x^2 - (r + s) * x + r * s

forall r, s R:
    r^2 - (r + s) * r + r * s = 0
    s^2 - (r + s) * s + r * s = 0

forall x, y R:
    abs(x + y) <= abs(x) + abs(y)
    abs(x - y) <= abs(x) + abs(y)

have fn arithmetic_mean(x, y R) R = (x + y) / 2
have fn geometric_mean(x, y R: x >= 0, y >= 0) R = sqrt(x * y)
have fn harmonic_mean(x, y R: x != 0, y != 0, x + y != 0) R = 2 * x * y / (x + y)

forall x R:
    x >= 0
    =>:
        arithmetic_mean(x, x) = (x + x) / 2 = x
        geometric_mean(x, x) = sqrt(x * x) = x

# Local high-school proof of two-variable AM-GM by contradiction.
claim:
    ? forall x, y R:
        x >= 0
        y >= 0
        =>:
            geometric_mean(x, y) <= arithmetic_mean(x, y)
    x * y >= 0
    sqrt(x * y)^2 = x * y
    (x + y)^2 - 4 * x * y = (x - y)^2
    0 <= (x - y)^2
    0 <= (x + y)^2 - 4 * x * y
    4 * x * y <= (x + y)^2
    x * y <= (x + y)^2 / 4
    ((x + y) / 2)^2 = (x + y)^2 / 4
    x * y <= ((x + y) / 2)^2
    0 <= sqrt(x * y)
    0 <= x + y
    0 < 2
    0 <= (x + y) / 2
    by contra:
        ? sqrt(x * y) <= (x + y) / 2
        sqrt(x * y) > (x + y) / 2
        sqrt(x * y)^2 > ((x + y) / 2)^2
        impossible x * y <= ((x + y) / 2)^2
    geometric_mean(x, y) = sqrt(x * y)
    arithmetic_mean(x, y) = (x + y) / 2

