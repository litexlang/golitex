# High School Mathematics
# Angles and Trigonometric Identities
# Source unit: scripts/high_school_book/knowledge_core_json/required-2.json (required-2.trigonometry_angles_and_identities).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

have fn deg(theta R) R = theta * pi / 180
have fn secant(theta R: cos(theta) != 0) R = 1 / cos(theta)

deg(180) = 180 * pi / 180 = pi
deg(90) = 90 * pi / 180 = pi / 2
deg(60) = 60 * pi / 180 = pi / 3
deg(45) = 45 * pi / 180 = pi / 4

forall x R:
    sin(x)^2 + cos(x)^2 = 1

forall x R:
    cos(x) != 0
    =>:
        tan(x) = sin(x) / cos(x)
        secant(x) = 1 / cos(x)
        1 + tan(x)^2 = 1 / cos(x)^2
        1 / cos(x)^2 = (1 / cos(x))^2
        (1 / cos(x))^2 = secant(x)^2

forall x, y R:
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    sin(x - y) = sin(x) * cos(y) - cos(x) * sin(y)
    cos(x - y) = cos(x) * cos(y) + sin(x) * sin(y)

forall x R:
    sin(2 * x) = 2 * sin(x) * cos(x)
    cos(2 * x) = cos(x)^2 - sin(x)^2
    cos(2 * x) = 2 * cos(x)^2 - 1
    cos(2 * x) = 1 - 2 * sin(x)^2

have fn cosine_law_third_side_sq(a, b, gamma R) R = a^2 + b^2 - 2 * a * b * cos(gamma)
have fn sine_law_ratio(side, angle R: sin(angle) != 0) R = side / sin(angle)

cos(pi / 2) = 0
cosine_law_third_side_sq(3, 4, pi / 2) = 3^2 + 4^2 - 2 * 3 * 4 * cos(pi / 2) = 3^2 + 4^2 - 2 * 3 * 4 * 0 = 25
