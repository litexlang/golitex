# High School Mathematics
# Derivatives
# Source unit: scripts/high_school_book/knowledge_core_json/optional-2.json (optional-2.derivatives).
# This chapter formalizes the source paraphrase; standalone exercises are omitted.

have fn average_change_rate(f fn(x R) R, a R, h R+) R = (f(a + h) - f(a)) / h

have fn circumference(r R) R = 2 * pi * r
have fn area_of_circle_radius(r R) R = pi * r^2

forall a R, h R+:
    circumference(a + h) = 2 * pi * (a + h)
    circumference(a) = 2 * pi * a
    average_change_rate(circumference, a, h) = (circumference(a + h) - circumference(a)) / h
    average_change_rate(circumference, a, h) = (2 * pi * (a + h) - 2 * pi * a) / h = 2 * pi

forall a R, h R+:
    area_of_circle_radius(a + h) = pi * (a + h)^2
    area_of_circle_radius(a) = pi * a^2
    average_change_rate(area_of_circle_radius, a, h) = (area_of_circle_radius(a + h) - area_of_circle_radius(a)) / h
    average_change_rate(area_of_circle_radius, a, h) = (pi * (a + h)^2 - pi * a^2) / h = pi * (2 * a + h)

claim:
    ? forall x0 R:
        $HighSchoolCite::analysis::has_derivative_at_R(R, fn(x R) R {x^2}, x0, 2 * x0)
    by thm HighSchoolCite::analysis::square_derivative_R(x0)

claim:
    ? forall m, b, x0 R:
        $HighSchoolCite::analysis::has_derivative_at_R(R, fn(x R) R {m * x + b}, x0, m)
    by thm HighSchoolCite::analysis::linear_derivative_R(m, b, x0)

claim:
    ? forall a, b R, f, df fn(x R) R:
        $HighSchoolCite::analysis::derivative_function_on_R(a, b, f, df)
        forall x R:
            a <= x <= b
            =>:
                df(x) > 0
        =>:
            $HighSchoolCite::analysis::is_increasing_on_R(a, b, f)
    by thm HighSchoolCite::analysis::positive_derivative_implies_increasing(a, b, f, df)

claim:
    ? forall a, b R, f, df fn(x R) R:
        $HighSchoolCite::analysis::derivative_function_on_R(a, b, f, df)
        forall x R:
            a <= x <= b
            =>:
                df(x) < 0
        =>:
            $HighSchoolCite::analysis::is_decreasing_on_R(a, b, f)
    by thm HighSchoolCite::analysis::negative_derivative_implies_decreasing(a, b, f, df)

have fn quadratic_model(x R) R = x^2 - 6 * x + 5
have fn quadratic_model_prime(x R) R = 2 * x - 6

prop stationary_point_for_derivative(df fn(x R) R, x0 R):
    df(x0) = 0

$stationary_point_for_derivative(quadratic_model_prime, 3)

quadratic_model(3) = 3^2 - 6 * 3 + 5 = -4
quadratic_model_prime(3) = 2 * 3 - 6 = 0
