# Section VII: generated subgroups, cyclic groups, and isomorphisms.

"""
The section begins with groups and subgroups.  A group has an associative
operation, a neutral element, and a two-sided inverse for every element.  A
subgroup contains the neutral element and is closed under multiplication and
inverses.
"""

prop is_group(G set, mul fn(x, y G) G, one G):
    forall x, y, z G:
        mul(mul(x, y), z) = mul(x, mul(y, z))
    forall x G:
        mul(one, x) = x
        mul(x, one) = x
        exist y G st {mul(x, y) = one, mul(y, x) = one}

# Definition. A subgroup is a subset containing the unit and closed under the
# operation and inverses; this is the carrier used by the generated subgroup.
prop is_subgroup(G set, mul fn(x, y G) G, one G, H power_set(G)):
    one $in H
    forall x, y G:
        x $in H
        y $in H
        =>:
            mul(x, y) $in H
    forall x G:
        x $in H
        =>:
            exist y G st {mul(x, y) = one, y $in H}

"""
The intersection of any family of subgroups is again a subgroup.  Consequently
the subgroup generated by elements a,b,...,c is the intersection of all
subgroups containing them, equivalently the smallest such subgroup.
"""

# `generated_subgroup_by` uses a set of generators so the same definition
# covers every finite list in the source.  `generated_subgroup` is its
# singleton specialization, used throughout the later sections.
prop generated_subgroup_by(G set, mul fn(x, y G) G, one G, A, H power_set(G)):
    $is_subgroup(G, mul, one, H)
    A $subset H
    forall K power_set(G):
        $is_subgroup(G, mul, one, K)
        A $subset K
        =>:
            H $subset K

prop generated_subgroup(G set, mul fn(x, y G) G, one G, x G, H power_set(G)):
    $generated_subgroup_by(G, mul, one, {x}, H)

"""
For an additively written group, nx is the n-fold sum for n>0, 0x=0, and
(-n)x=-(nx).  Induction gives mx+nx=(m+n)x and m(nx)=(mn)x.  In multiplicative
notation these are the usual integral powers x^n, with x^0=1 and negative
powers formed from the inverse.
"""

# A nonnegative power is represented by a finite multiplication sequence.
# An integral power balances a nonnegative power of x against a nonnegative
# power of a two-sided inverse, so its exponent is p-q.
prop is_group_power_sequence(G set, mul fn(x, y G) G, one G, x G, n N, a fn(idx_i N) G):
    a(0) = one
    forall idx_i N:
        idx_i < n
        =>:
            a(idx_i + 1) = mul(a(idx_i), x)

prop has_nonnegative_group_power(G set, mul fn(x, y G) G, one G, x G, n N, y G):
    exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, x, n, a), a(n) = y}

# Lemma VII.1. A finite multiplication sequence is determined by its initial
# value and successor rule. Thus two nonnegative powers with the same base and
# exponent have the same value. This is the normalization bridge used below
# when combining signed powers.
thm nonnegative_group_power_is_unique:
    ? forall G set, mul fn(x, y G) G, one G, x G, n N, y, z G:
        $has_nonnegative_group_power(G, mul, one, x, n, y)
        $has_nonnegative_group_power(G, mul, one, x, n, z)
        =>:
            y = z
    have fn pow(base G, k Z: k >= 0) G by induc k from 0:
        case k = 0: one
        case k > 0: mul(pow(base, k - 1), base)

    claim:
        ? forall base G, k N:
            pow(base, k + 1) = mul(pow(base, k), base)
        pow(base, k + 1) = mul(pow(base, (k + 1) - 1), base) = mul(pow(base, k), base)

    thm nonnegative_power_is_pow:
        ? forall base, value G, k N:
            $has_nonnegative_group_power(G, mul, one, base, k, value)
            =>:
                value = pow(base, k)
        obtain sequence from exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, base, k, a), a(k) = value}
        prop sequence_matches(idx_i N):
            forall:
                idx_i <= k
                =>:
                    sequence(idx_i) = pow(base, idx_i)
        claim:
            ? forall idx_i N:
                $sequence_matches(idx_i)
            by induc idx_i from 0:
                ? $sequence_matches(idx_i)
                ? from idx_i = 0:
                    claim:
                        ? forall:
                            0 <= k
                            =>:
                                sequence(0) = pow(base, 0)
                        sequence(0) = one
                        pow(base, 0) = one
                    by def:
                        ? $sequence_matches(0)
                ? induc:
                    claim:
                        ? forall:
                            idx_i + 1 <= k
                            =>:
                                sequence(idx_i + 1) = pow(base, idx_i + 1)
                        idx_i < idx_i + 1 <= k
                        idx_i <= k
                        sequence(idx_i) = pow(base, idx_i)
                        sequence(idx_i + 1) = mul(sequence(idx_i), base) = mul(pow(base, idx_i), base) = pow(base, idx_i + 1)
                    by def:
                        ? $sequence_matches(idx_i + 1)
        $sequence_matches(k)
        k <= k
        sequence(k) = pow(base, k)
        value = sequence(k) = pow(base, k)

    by thm nonnegative_power_is_pow(x, y, n)
    by thm nonnegative_power_is_pow(x, z, n)
    y = pow(x, n)
    z = pow(x, n)

prop has_group_power(G set, mul fn(x, y G) G, one G, x G, n Z, y G):
    exist inv, positive_part, negative_part G, p, q N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q, negative_part), n + q = p, y = mul(positive_part, negative_part)}

# Integral powers respect addition of exponents, including the inverse-power
# component of the signed representation.
thm group_power_add:
    ? forall G set, mul fn(x, y G) G, one G, x, y, z G, a, b Z:
        $is_group(G, mul, one)
        $has_group_power(G, mul, one, x, a, y)
        $has_group_power(G, mul, one, x, b, z)
        =>:
            $has_group_power(G, mul, one, x, a + b, mul(y, z))
    have fn inverse by exist!:
        ? forall base G:
            exist! w G st {mul(base, w) = one, mul(w, base) = one}
        obtain w from exist w G st {mul(base, w) = one, mul(w, base) = one}
        witness exist! w0 G st {mul(base, w0) = one, mul(w0, base) = one} from w:
            mul(base, w) = one
            mul(w, base) = one
            forall w1, w2 G:
                mul(base, w1) = one
                mul(w1, base) = one
                mul(base, w2) = one
                mul(w2, base) = one
                =>:
                    w1 = mul(w1, one) = mul(w1, mul(base, w2)) = mul(mul(w1, base), w2) = mul(one, w2) = w2

    have fn pow(base G, n Z: n >= 0) G by induc n from 0:
        case n = 0: one
        case n > 0: mul(pow(base, n - 1), base)

    claim:
        ? forall base G, n N:
            pow(base, n + 1) = mul(pow(base, n), base)
        pow(base, n + 1) = mul(pow(base, (n + 1) - 1), base) = mul(pow(base, n), base)

    thm pow_represents_nonnegative_power:
        ? forall base G, n N:
            $has_nonnegative_group_power(G, mul, one, base, n, pow(base, n))
        have fn sequence(idx_i N) G = pow(base, idx_i)
        sequence(n) = pow(base, n)
        witness exist sequence0 fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, base, n, sequence0), sequence0(n) = pow(base, n)} from sequence:
            claim:
                ? $is_group_power_sequence(G, mul, one, base, n, sequence)
                sequence(0) = pow(base, 0) = one
                claim:
                    ? forall idx_i N:
                        idx_i < n
                        =>:
                            sequence(idx_i + 1) = mul(sequence(idx_i), base)
                    sequence(idx_i + 1) = pow(base, idx_i + 1) = mul(pow(base, idx_i), base) = mul(sequence(idx_i), base)
                by def:
                    ? $is_group_power_sequence(G, mul, one, base, n, sequence)
        by def:
            ? $has_nonnegative_group_power(G, mul, one, base, n, pow(base, n))

    claim:
        ? forall base G, r, s N:
            mul(pow(base, r), pow(base, s)) = pow(base, r + s)
        by induc s from 0:
            ? mul(pow(base, r), pow(base, s)) = pow(base, r + s)
            ? from s = 0:
                pow(base, 0) = one
                r + 0 = r
                mul(pow(base, r), pow(base, 0)) = mul(pow(base, r), one) = pow(base, r) = pow(base, r + 0)
            ? induc:
                pow(base, s + 1) = mul(pow(base, s), base)
                pow(base, r + (s + 1)) = pow(base, (r + s) + 1) = mul(pow(base, r + s), base)
                mul(pow(base, r), pow(base, s + 1)) = mul(pow(base, r), mul(pow(base, s), base)) = mul(mul(pow(base, r), pow(base, s)), base) = mul(pow(base, r + s), base) = pow(base, r + (s + 1))

    prop cross_commutation(n N):
        mul(x, pow(inverse(x), n)) = mul(pow(inverse(x), n), x)
        mul(inverse(x), pow(x, n)) = mul(pow(x, n), inverse(x))

    claim:
        ? forall n N:
            $cross_commutation(n)
        by induc n from 0:
            ? $cross_commutation(n)
            ? from n = 0:
                pow(x, 0) = one
                pow(inverse(x), 0) = one
                mul(x, pow(inverse(x), 0)) = mul(x, one) = x = mul(one, x) = mul(pow(inverse(x), 0), x)
                mul(inverse(x), pow(x, 0)) = mul(inverse(x), one) = inverse(x) = mul(one, inverse(x)) = mul(pow(x, 0), inverse(x))
                by def:
                    ? $cross_commutation(0)
            ? induc:
                pow(x, n + 1) = mul(pow(x, n), x)
                pow(inverse(x), n + 1) = mul(pow(inverse(x), n), inverse(x))
                mul(x, inverse(x)) = one
                mul(inverse(x), x) = one
                mul(x, pow(inverse(x), n + 1)) = mul(x, mul(pow(inverse(x), n), inverse(x))) = mul(mul(x, pow(inverse(x), n)), inverse(x)) = mul(mul(pow(inverse(x), n), x), inverse(x)) = mul(pow(inverse(x), n), mul(x, inverse(x))) = mul(pow(inverse(x), n), one) = pow(inverse(x), n)
                mul(pow(inverse(x), n + 1), x) = mul(mul(pow(inverse(x), n), inverse(x)), x) = mul(pow(inverse(x), n), mul(inverse(x), x)) = mul(pow(inverse(x), n), one) = pow(inverse(x), n)
                mul(inverse(x), pow(x, n + 1)) = mul(inverse(x), mul(pow(x, n), x)) = mul(mul(inverse(x), pow(x, n)), x) = mul(mul(pow(x, n), inverse(x)), x) = mul(pow(x, n), mul(inverse(x), x)) = mul(pow(x, n), one) = pow(x, n)
                mul(pow(x, n + 1), inverse(x)) = mul(mul(pow(x, n), x), inverse(x)) = mul(pow(x, n), mul(x, inverse(x))) = mul(pow(x, n), one) = pow(x, n)
                by def:
                    ? $cross_commutation(n + 1)

    claim:
        ? forall r, s N:
            mul(pow(x, r), pow(inverse(x), s)) = mul(pow(inverse(x), s), pow(x, r))
        by induc r from 0:
            ? mul(pow(x, r), pow(inverse(x), s)) = mul(pow(inverse(x), s), pow(x, r))
            ? from r = 0:
                pow(x, 0) = one
                mul(pow(x, 0), pow(inverse(x), s)) = mul(one, pow(inverse(x), s)) = pow(inverse(x), s) = mul(pow(inverse(x), s), one) = mul(pow(inverse(x), s), pow(x, 0))
            ? induc:
                pow(x, r + 1) = mul(pow(x, r), x)
                $cross_commutation(s)
                mul(x, pow(inverse(x), s)) = mul(pow(inverse(x), s), x)
                mul(pow(x, r + 1), pow(inverse(x), s)) = mul(mul(pow(x, r), x), pow(inverse(x), s)) = mul(pow(x, r), mul(x, pow(inverse(x), s))) = mul(pow(x, r), mul(pow(inverse(x), s), x)) = mul(mul(pow(x, r), pow(inverse(x), s)), x) = mul(mul(pow(inverse(x), s), pow(x, r)), x) = mul(pow(inverse(x), s), mul(pow(x, r), x)) = mul(pow(inverse(x), s), pow(x, r + 1))

    obtain inv1, yp, yn, p, q from exist inv, positive_part, negative_part G, p, q N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q, negative_part), a + q = p, y = mul(positive_part, negative_part)}
    obtain inv2, zp, zn, r, s from exist inv, positive_part, negative_part G, p2, q2 N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p2, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q2, negative_part), b + q2 = p2, z = mul(positive_part, negative_part)}
    inv1 = inverse(x)
    inv2 = inverse(x)
    by thm pow_represents_nonnegative_power(x, p)
    by thm pow_represents_nonnegative_power(inv1, q)
    by thm pow_represents_nonnegative_power(x, r)
    by thm pow_represents_nonnegative_power(inv2, s)
    by thm nonnegative_group_power_is_unique(G, mul, one, x, p, yp, pow(x, p))
    by thm nonnegative_group_power_is_unique(G, mul, one, inv1, q, yn, pow(inv1, q))
    by thm nonnegative_group_power_is_unique(G, mul, one, x, r, zp, pow(x, r))
    by thm nonnegative_group_power_is_unique(G, mul, one, inv2, s, zn, pow(inv2, s))
    yp = pow(x, p)
    yn = pow(inv1, q) = pow(inverse(x), q)
    zp = pow(x, r)
    zn = pow(inv2, s) = pow(inverse(x), s)
    y = mul(yp, yn) = mul(pow(x, p), pow(inverse(x), q))
    z = mul(zp, zn) = mul(pow(x, r), pow(inverse(x), s))
    have positive_part G = pow(x, p + r)
    have negative_part G = pow(inverse(x), q + s)
    positive_part = pow(x, p + r)
    negative_part = pow(inverse(x), q + s)
    by thm pow_represents_nonnegative_power(x, p + r)
    by thm pow_represents_nonnegative_power(inverse(x), q + s)
    mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s))) = mul(mul(pow(inverse(x), q), pow(x, r)), pow(inverse(x), s))
    mul(mul(pow(x, p), pow(inverse(x), q)), mul(pow(x, r), pow(inverse(x), s))) = mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s))))
    mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s)))) = mul(pow(x, p), mul(mul(pow(inverse(x), q), pow(x, r)), pow(inverse(x), s)))
    mul(pow(inverse(x), q), pow(x, r)) = mul(pow(x, r), pow(inverse(x), q))
    mul(pow(x, p), mul(pow(inverse(x), q), pow(x, r))) = mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q)))
    mul(mul(pow(x, p), mul(pow(inverse(x), q), pow(x, r))), pow(inverse(x), s)) = mul(mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q))), pow(inverse(x), s))
    mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q))) = mul(mul(pow(x, p), pow(x, r)), pow(inverse(x), q))
    mul(pow(x, p), pow(x, r)) = pow(x, p + r)
    mul(mul(pow(x, p), pow(x, r)), pow(inverse(x), q)) = mul(pow(x, p + r), pow(inverse(x), q))
    mul(pow(inverse(x), q), pow(inverse(x), s)) = pow(inverse(x), q + s)
    mul(mul(pow(x, p + r), pow(inverse(x), q)), pow(inverse(x), s)) = mul(pow(x, p + r), mul(pow(inverse(x), q), pow(inverse(x), s)))
    mul(pow(x, p + r), mul(pow(inverse(x), q), pow(inverse(x), s))) = mul(pow(x, p + r), pow(inverse(x), q + s))
    mul(y, z) = mul(mul(pow(x, p), pow(inverse(x), q)), mul(pow(x, r), pow(inverse(x), s))) = mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s)))) = mul(pow(x, p), mul(mul(pow(inverse(x), q), pow(x, r)), pow(inverse(x), s))) = mul(mul(pow(x, p), mul(pow(inverse(x), q), pow(x, r))), pow(inverse(x), s)) = mul(mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q))), pow(inverse(x), s)) = mul(mul(mul(pow(x, p), pow(x, r)), pow(inverse(x), q)), pow(inverse(x), s)) = mul(mul(pow(x, p), pow(x, r)), mul(pow(inverse(x), q), pow(inverse(x), s))) = mul(pow(x, p + r), mul(pow(inverse(x), q), pow(inverse(x), s))) = mul(pow(x, p + r), pow(inverse(x), q + s)) = mul(positive_part, negative_part)
    mul(y, z) = mul(positive_part, negative_part)
    (a + b) + (q + s) = (a + q) + (b + s) = p + r
    witness exist inv, pp, nn G, idx_i, j N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, idx_i, pp), $has_nonnegative_group_power(G, mul, one, inv, j, nn), (a + b) + j = idx_i, mul(y, z) = mul(pp, nn)} from inverse(x), positive_part, negative_part, p + r, q + s
    by def:
        ? $has_group_power(G, mul, one, x, a + b, mul(y, z))

thm zero_group_power_is_one:
    ? forall G set, mul fn(x, y G) G, one G, x, y G:
        $is_group(G, mul, one)
        $has_group_power(G, mul, one, x, 0, y)
        =>:
            y = one
    have fn inverse by exist!:
        ? forall base G:
            exist! w G st {mul(base, w) = one, mul(w, base) = one}
        obtain w from exist w G st {mul(base, w) = one, mul(w, base) = one}
        witness exist! w0 G st {mul(base, w0) = one, mul(w0, base) = one} from w:
            mul(base, w) = one
            mul(w, base) = one
            forall w1, w2 G:
                mul(base, w1) = one
                mul(w1, base) = one
                mul(base, w2) = one
                mul(w2, base) = one
                =>:
                    w1 = mul(w1, one) = mul(w1, mul(base, w2)) = mul(mul(w1, base), w2) = mul(one, w2) = w2

    have fn pow(base G, n Z: n >= 0) G by induc n from 0:
        case n = 0: one
        case n > 0: mul(pow(base, n - 1), base)

    claim:
        ? forall base G, n N:
            pow(base, n + 1) = mul(pow(base, n), base)
        pow(base, n + 1) = mul(pow(base, (n + 1) - 1), base) = mul(pow(base, n), base)

    thm pow_represents_nonnegative_power:
        ? forall base G, n N:
            $has_nonnegative_group_power(G, mul, one, base, n, pow(base, n))
        have fn sequence(idx_i N) G = pow(base, idx_i)
        sequence(n) = pow(base, n)
        witness exist sequence0 fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, base, n, sequence0), sequence0(n) = pow(base, n)} from sequence:
            claim:
                ? $is_group_power_sequence(G, mul, one, base, n, sequence)
                sequence(0) = pow(base, 0) = one
                claim:
                    ? forall idx_i N:
                        idx_i < n
                        =>:
                            sequence(idx_i + 1) = mul(sequence(idx_i), base)
                    sequence(idx_i + 1) = pow(base, idx_i + 1) = mul(pow(base, idx_i), base) = mul(sequence(idx_i), base)
                by def:
                    ? $is_group_power_sequence(G, mul, one, base, n, sequence)
        by def:
            ? $has_nonnegative_group_power(G, mul, one, base, n, pow(base, n))

    prop cross_commutation(n N):
        mul(x, pow(inverse(x), n)) = mul(pow(inverse(x), n), x)
        mul(inverse(x), pow(x, n)) = mul(pow(x, n), inverse(x))

    claim:
        ? forall n N:
            $cross_commutation(n)
        by induc n from 0:
            ? $cross_commutation(n)
            ? from n = 0:
                pow(x, 0) = one
                pow(inverse(x), 0) = one
                mul(x, pow(inverse(x), 0)) = mul(x, one) = x = mul(one, x) = mul(pow(inverse(x), 0), x)
                mul(inverse(x), pow(x, 0)) = mul(inverse(x), one) = inverse(x) = mul(one, inverse(x)) = mul(pow(x, 0), inverse(x))
                by def:
                    ? $cross_commutation(0)
            ? induc:
                pow(x, n + 1) = mul(pow(x, n), x)
                pow(inverse(x), n + 1) = mul(pow(inverse(x), n), inverse(x))
                mul(x, inverse(x)) = one
                mul(inverse(x), x) = one
                mul(x, pow(inverse(x), n + 1)) = mul(x, mul(pow(inverse(x), n), inverse(x))) = mul(mul(x, pow(inverse(x), n)), inverse(x)) = mul(mul(pow(inverse(x), n), x), inverse(x)) = mul(pow(inverse(x), n), mul(x, inverse(x))) = mul(pow(inverse(x), n), one) = pow(inverse(x), n)
                mul(pow(inverse(x), n + 1), x) = mul(mul(pow(inverse(x), n), inverse(x)), x) = mul(pow(inverse(x), n), mul(inverse(x), x)) = mul(pow(inverse(x), n), one) = pow(inverse(x), n)
                mul(inverse(x), pow(x, n + 1)) = mul(inverse(x), mul(pow(x, n), x)) = mul(mul(inverse(x), pow(x, n)), x) = mul(mul(pow(x, n), inverse(x)), x) = mul(pow(x, n), mul(inverse(x), x)) = mul(pow(x, n), one) = pow(x, n)
                mul(pow(x, n + 1), inverse(x)) = mul(mul(pow(x, n), x), inverse(x)) = mul(pow(x, n), mul(x, inverse(x))) = mul(pow(x, n), one) = pow(x, n)
                by def:
                    ? $cross_commutation(n + 1)

    prop inverse_power_cancellation(n N):
        mul(pow(x, n), pow(inverse(x), n)) = one
        mul(pow(inverse(x), n), pow(x, n)) = one

    claim:
        ? forall n N:
            $inverse_power_cancellation(n)
        by induc n from 0:
            ? $inverse_power_cancellation(n)
            ? from n = 0:
                pow(x, 0) = one
                pow(inverse(x), 0) = one
                mul(pow(x, 0), pow(inverse(x), 0)) = mul(one, one) = one
                mul(pow(inverse(x), 0), pow(x, 0)) = mul(one, one) = one
                by def:
                    ? $inverse_power_cancellation(0)
            ? induc:
                pow(x, n + 1) = mul(pow(x, n), x)
                pow(inverse(x), n + 1) = mul(pow(inverse(x), n), inverse(x))
                mul(x, inverse(x)) = one
                mul(inverse(x), x) = one
                $cross_commutation(n)
                mul(x, pow(inverse(x), n)) = mul(pow(inverse(x), n), x)
                mul(inverse(x), pow(x, n)) = mul(pow(x, n), inverse(x))
                mul(x, mul(pow(inverse(x), n), inverse(x))) = mul(mul(x, pow(inverse(x), n)), inverse(x))
                mul(inverse(x), mul(pow(x, n), x)) = mul(mul(inverse(x), pow(x, n)), x)
                mul(pow(x, n), mul(x, pow(inverse(x), n))) = mul(pow(x, n), mul(pow(inverse(x), n), x))
                mul(pow(inverse(x), n), mul(inverse(x), pow(x, n))) = mul(pow(inverse(x), n), mul(pow(x, n), inverse(x)))
                mul(pow(x, n), mul(pow(inverse(x), n), x)) = mul(mul(pow(x, n), pow(inverse(x), n)), x)
                mul(pow(inverse(x), n), mul(pow(x, n), inverse(x))) = mul(mul(pow(inverse(x), n), pow(x, n)), inverse(x))
                mul(mul(pow(x, n), mul(pow(inverse(x), n), x)), inverse(x)) = mul(mul(mul(pow(x, n), pow(inverse(x), n)), x), inverse(x))
                mul(mul(pow(inverse(x), n), mul(pow(x, n), inverse(x))), x) = mul(mul(mul(pow(inverse(x), n), pow(x, n)), inverse(x)), x)
                mul(pow(x, n + 1), pow(inverse(x), n + 1)) = mul(mul(pow(x, n), x), mul(pow(inverse(x), n), inverse(x))) = mul(pow(x, n), mul(x, mul(pow(inverse(x), n), inverse(x)))) = mul(pow(x, n), mul(mul(x, pow(inverse(x), n)), inverse(x))) = mul(mul(pow(x, n), mul(x, pow(inverse(x), n))), inverse(x)) = mul(mul(pow(x, n), mul(pow(inverse(x), n), x)), inverse(x)) = mul(mul(mul(pow(x, n), pow(inverse(x), n)), x), inverse(x)) = mul(mul(pow(x, n), pow(inverse(x), n)), mul(x, inverse(x))) = mul(one, one) = one
                mul(pow(inverse(x), n + 1), pow(x, n + 1)) = mul(mul(pow(inverse(x), n), inverse(x)), mul(pow(x, n), x)) = mul(pow(inverse(x), n), mul(inverse(x), mul(pow(x, n), x))) = mul(pow(inverse(x), n), mul(mul(inverse(x), pow(x, n)), x)) = mul(mul(pow(inverse(x), n), mul(inverse(x), pow(x, n))), x) = mul(mul(pow(inverse(x), n), mul(pow(x, n), inverse(x))), x) = mul(mul(mul(pow(inverse(x), n), pow(x, n)), inverse(x)), x) = mul(mul(pow(inverse(x), n), pow(x, n)), mul(inverse(x), x)) = mul(one, one) = one
                by def:
                    ? $inverse_power_cancellation(n + 1)

    obtain inv, positive_part, negative_part, p, q from exist inv0, pp, nn G, idx_i, j N st {mul(x, inv0) = one, mul(inv0, x) = one, $has_nonnegative_group_power(G, mul, one, x, idx_i, pp), $has_nonnegative_group_power(G, mul, one, inv0, j, nn), 0 + j = idx_i, y = mul(pp, nn)}
    inv = inverse(x)
    p = q
    by thm pow_represents_nonnegative_power(x, p)
    by thm pow_represents_nonnegative_power(inv, q)
    by thm nonnegative_group_power_is_unique(G, mul, one, x, p, positive_part, pow(x, p))
    by thm nonnegative_group_power_is_unique(G, mul, one, inv, q, negative_part, pow(inv, q))
    positive_part = pow(x, p)
    negative_part = pow(inv, q) = pow(inverse(x), q)
    y = mul(positive_part, negative_part)
    mul(positive_part, negative_part) = mul(pow(x, p), pow(inverse(x), q))
    pow(x, p) = pow(x, q)
    $inverse_power_cancellation(q)
    mul(pow(x, q), pow(inverse(x), q)) = one

thm group_power_neg:
    ? forall G set, mul fn(x, y G) G, one G, x, y G, a Z:
        $is_group(G, mul, one)
        $has_group_power(G, mul, one, x, a, y)
        =>:
            exist z G st {$has_group_power(G, mul, one, x, -a, z), mul(y, z) = one, mul(z, y) = one}
    have fn pow(base G, n Z: n >= 0) G by induc n from 0:
        case n = 0: one
        case n > 0: mul(pow(base, n - 1), base)

    claim:
        ? forall base G, n N:
            pow(base, n + 1) = mul(pow(base, n), base)
        pow(base, n + 1) = mul(pow(base, (n + 1) - 1), base) = mul(pow(base, n), base)

    thm pow_represents_nonnegative_power:
        ? forall base G, n N:
            $has_nonnegative_group_power(G, mul, one, base, n, pow(base, n))
        have fn sequence(idx_i N) G = pow(base, idx_i)
        sequence(n) = pow(base, n)
        witness exist sequence0 fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, base, n, sequence0), sequence0(n) = pow(base, n)} from sequence:
            claim:
                ? $is_group_power_sequence(G, mul, one, base, n, sequence)
                sequence(0) = pow(base, 0) = one
                claim:
                    ? forall idx_i N:
                        idx_i < n
                        =>:
                            sequence(idx_i + 1) = mul(sequence(idx_i), base)
                    sequence(idx_i + 1) = pow(base, idx_i + 1) = mul(pow(base, idx_i), base) = mul(sequence(idx_i), base)
                by def:
                    ? $is_group_power_sequence(G, mul, one, base, n, sequence)
        by def:
            ? $has_nonnegative_group_power(G, mul, one, base, n, pow(base, n))

    obtain inv, positive_part, negative_part, p, q from exist inv0, pp, nn G, idx_i, j N st {mul(x, inv0) = one, mul(inv0, x) = one, $has_nonnegative_group_power(G, mul, one, x, idx_i, pp), $has_nonnegative_group_power(G, mul, one, inv0, j, nn), a + j = idx_i, y = mul(pp, nn)}
    have z G = mul(pow(x, q), pow(inv, p))
    by thm pow_represents_nonnegative_power(x, q)
    by thm pow_represents_nonnegative_power(inv, p)
    q = (a + q) - a = p - a = -a + p
    claim:
        ? $has_group_power(G, mul, one, x, -a, z)
        witness exist inv0, pp, nn G, idx_i, j N st {mul(x, inv0) = one, mul(inv0, x) = one, $has_nonnegative_group_power(G, mul, one, x, idx_i, pp), $has_nonnegative_group_power(G, mul, one, inv0, j, nn), -a + j = idx_i, z = mul(pp, nn)} from inv, pow(x, q), pow(inv, p), q, p
        by def:
            ? $has_group_power(G, mul, one, x, -a, z)
    witness exist z0 G st {$has_group_power(G, mul, one, x, -a, z0), mul(y, z0) = one, mul(z0, y) = one} from z:
        by thm group_power_add(G, mul, one, x, y, z, a, -a)
        a + (-a) = 0
        by thm zero_group_power_is_one(G, mul, one, x, mul(y, z))
        by thm group_power_add(G, mul, one, x, z, y, -a, a)
        (-a) + a = 0
        by thm zero_group_power_is_one(G, mul, one, x, mul(z, y))

# The group laws make the value represented by a fixed integral exponent
# unique.  Exposing this theorem once avoids rebuilding inverse cancellation
# inside every later power-index argument.
thm group_power_is_unique:
    ? forall G set, mul fn(x, y G) G, one G, x, y, z G, a Z:
        $is_group(G, mul, one)
        $has_group_power(G, mul, one, x, a, y)
        $has_group_power(G, mul, one, x, a, z)
        =>:
            y = z
    by thm group_power_neg(G, mul, one, x, z, a)
    obtain inverse_z from exist inverse_z0 G st {$has_group_power(G, mul, one, x, -a, inverse_z0), mul(z, inverse_z0) = one, mul(inverse_z0, z) = one}
    by thm group_power_add(G, mul, one, x, y, inverse_z, a, -a)
    a + (-a) = 0
    by thm zero_group_power_is_one(G, mul, one, x, mul(y, inverse_z))
    by thm group_power_neg(G, mul, one, x, inverse_z, -a)
    obtain restored from exist restored0 G st {$has_group_power(G, mul, one, x, -(-a), restored0), mul(inverse_z, restored0) = one, mul(restored0, inverse_z) = one}
    -(-a) = a
    y = mul(y, one) = mul(y, mul(inverse_z, restored)) = mul(mul(y, inverse_z), restored) = mul(one, restored) = restored
    z = mul(z, one) = mul(z, mul(inverse_z, restored)) = mul(mul(z, inverse_z), restored) = mul(one, restored) = restored

prop is_integral_power_of(G set, mul fn(x, y G) G, one G, x, y G):
    exist n Z st {$has_group_power(G, mul, one, x, n, y)}

template<G set, mul fn(x, y G) G, one G>:
    have fn integral_powers(x G) power_set(G) = {y G: $is_integral_power_of(G, mul, one, x, y)}

prop every_generated_element_is_power(G set, mul fn(x, y G) G, one G, x G, H power_set(G)):
    forall y H:
        exist n Z st {$has_group_power(G, mul, one, x, n, y)}

"""
Theorem VII.1.  If G is a multiplicative group and x is in G, the subgroup
generated by x consists exactly of the elements x^n for n in Z.
"""

# The forward direction constructs the integral powers as a subgroup containing
# x, then uses the minimality of the generated subgroup.
thm generated_subgroup_elements_are_powers:
    ? forall G set, mul fn(x, y G) G, one G, x G, H power_set(G):
        $is_group(G, mul, one)
        $generated_subgroup(G, mul, one, x, H)
        =>:
            $every_generated_element_is_power(G, mul, one, x, H)

    have fn inverse by exist!:
        ? forall z G:
            exist! w G st {mul(z, w) = one, mul(w, z) = one}
        obtain w from exist w G st {mul(z, w) = one, mul(w, z) = one}
        witness exist! w0 G st {mul(z, w0) = one, mul(w0, z) = one} from w:
            mul(z, w) = one
            mul(w, z) = one
            forall w1, w2 G:
                mul(z, w1) = one
                mul(w1, z) = one
                mul(z, w2) = one
                mul(w2, z) = one
                =>:
                    w1 = mul(w1, one) = mul(w1, mul(z, w2)) = mul(mul(w1, z), w2) = mul(one, w2) = w2

    have fn pow(z G, n Z: n >= 0) G by induc n from 0:
        case n = 0: one
        case n > 0: mul(pow(z, n - 1), z)

    claim:
        ? forall z G, n N:
            pow(z, n + 1) = mul(pow(z, n), z)
        pow(z, n + 1) = mul(pow(z, (n + 1) - 1), z) = mul(pow(z, n), z)

    thm pow_represents_nonnegative_power:
        ? forall z G, n N:
            $has_nonnegative_group_power(G, mul, one, z, n, pow(z, n))
        have fn sequence(idx_i N) G = pow(z, idx_i)
        sequence(n) = pow(z, n)
        witness exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, z, n, a), a(n) = pow(z, n)} from sequence:
            claim:
                ? $is_group_power_sequence(G, mul, one, z, n, sequence)
                sequence(0) = pow(z, 0) = one
                claim:
                    ? forall idx_i N:
                        idx_i < n
                        =>:
                            sequence(idx_i + 1) = mul(sequence(idx_i), z)
                    sequence(idx_i + 1) = pow(z, idx_i + 1) = mul(pow(z, idx_i), z) = mul(sequence(idx_i), z)
                by def:
                    ? $is_group_power_sequence(G, mul, one, z, n, sequence)
        by def:
            ? $has_nonnegative_group_power(G, mul, one, z, n, pow(z, n))

    thm nonnegative_power_is_pow:
        ? forall z, y G, n N:
            $has_nonnegative_group_power(G, mul, one, z, n, y)
            =>:
                y = pow(z, n)
        obtain sequence from exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, z, n, a), a(n) = y}
        prop sequence_matches(idx_i N):
            forall:
                idx_i <= n
                =>:
                    sequence(idx_i) = pow(z, idx_i)
        claim:
            ? forall idx_i N:
                $sequence_matches(idx_i)
            by induc idx_i from 0:
                ? $sequence_matches(idx_i)
                ? from idx_i = 0:
                    claim:
                        ? forall:
                            0 <= n
                            =>:
                                sequence(0) = pow(z, 0)
                        sequence(0) = one
                        pow(z, 0) = one
                    by def:
                        ? $sequence_matches(0)
                ? induc:
                    claim:
                        ? forall:
                            idx_i + 1 <= n
                            =>:
                                sequence(idx_i + 1) = pow(z, idx_i + 1)
                        idx_i < idx_i + 1 <= n
                        idx_i <= n
                        sequence(idx_i) = pow(z, idx_i)
                        sequence(idx_i + 1) = mul(sequence(idx_i), z) = mul(pow(z, idx_i), z) = pow(z, idx_i + 1)
                    by def:
                        ? $sequence_matches(idx_i + 1)
        $sequence_matches(n)
        n <= n
        sequence(n) = pow(z, n)
        y = sequence(n) = pow(z, n)

    claim:
        ? forall z G, r, s N:
            mul(pow(z, r), pow(z, s)) = pow(z, r + s)
        by induc s from 0:
            ? mul(pow(z, r), pow(z, s)) = pow(z, r + s)
            ? from s = 0:
                pow(z, 0) = one
                r + 0 = r
                mul(pow(z, r), pow(z, 0)) = mul(pow(z, r), one) = pow(z, r) = pow(z, r + 0)
            ? induc:
                pow(z, s + 1) = mul(pow(z, s), z)
                pow(z, r + (s + 1)) = pow(z, (r + s) + 1) = mul(pow(z, r + s), z)
                mul(pow(z, r), pow(z, s + 1)) = mul(pow(z, r), mul(pow(z, s), z)) = mul(mul(pow(z, r), pow(z, s)), z) = mul(pow(z, r + s), z) = pow(z, r + (s + 1))

    claim:
        ? forall z G, n N:
            mul(pow(z, n), z) = mul(z, pow(z, n))
        by induc n from 0:
            ? mul(pow(z, n), z) = mul(z, pow(z, n))
            ? from n = 0:
                pow(z, 0) = one
                mul(pow(z, 0), z) = mul(one, z) = z = mul(z, one) = mul(z, pow(z, 0))
            ? induc:
                pow(z, n + 1) = mul(pow(z, n), z)
                mul(pow(z, n), z) = mul(z, pow(z, n))
                mul(pow(z, n + 1), z) = mul(mul(pow(z, n), z), z) = mul(mul(z, pow(z, n)), z) = mul(z, mul(pow(z, n), z)) = mul(z, pow(z, n + 1))

    prop cross_commutation(n N):
        mul(x, pow(inverse(x), n)) = mul(pow(inverse(x), n), x)
        mul(inverse(x), pow(x, n)) = mul(pow(x, n), inverse(x))

    claim:
        ? forall n N:
            $cross_commutation(n)
        by induc n from 0:
            ? $cross_commutation(n)
            ? from n = 0:
                pow(x, 0) = one
                pow(inverse(x), 0) = one
                mul(x, pow(inverse(x), 0)) = mul(x, one) = x = mul(one, x) = mul(pow(inverse(x), 0), x)
                mul(inverse(x), pow(x, 0)) = mul(inverse(x), one) = inverse(x) = mul(one, inverse(x)) = mul(pow(x, 0), inverse(x))
                by def:
                    ? $cross_commutation(0)
            ? induc:
                pow(x, n + 1) = mul(pow(x, n), x)
                pow(inverse(x), n + 1) = mul(pow(inverse(x), n), inverse(x))
                mul(x, inverse(x)) = one
                mul(inverse(x), x) = one
                mul(x, pow(inverse(x), n + 1)) = mul(x, mul(pow(inverse(x), n), inverse(x))) = mul(mul(x, pow(inverse(x), n)), inverse(x)) = mul(mul(pow(inverse(x), n), x), inverse(x)) = mul(pow(inverse(x), n), mul(x, inverse(x))) = mul(pow(inverse(x), n), one) = pow(inverse(x), n)
                mul(pow(inverse(x), n + 1), x) = mul(mul(pow(inverse(x), n), inverse(x)), x) = mul(pow(inverse(x), n), mul(inverse(x), x)) = mul(pow(inverse(x), n), one) = pow(inverse(x), n)
                mul(inverse(x), pow(x, n + 1)) = mul(inverse(x), mul(pow(x, n), x)) = mul(mul(inverse(x), pow(x, n)), x) = mul(mul(pow(x, n), inverse(x)), x) = mul(pow(x, n), mul(inverse(x), x)) = mul(pow(x, n), one) = pow(x, n)
                mul(pow(x, n + 1), inverse(x)) = mul(mul(pow(x, n), x), inverse(x)) = mul(pow(x, n), mul(x, inverse(x))) = mul(pow(x, n), one) = pow(x, n)
                by def:
                    ? $cross_commutation(n + 1)

    claim:
        ? forall r, s N:
            mul(pow(x, r), pow(inverse(x), s)) = mul(pow(inverse(x), s), pow(x, r))
        by induc r from 0:
            ? mul(pow(x, r), pow(inverse(x), s)) = mul(pow(inverse(x), s), pow(x, r))
            ? from r = 0:
                pow(x, 0) = one
                mul(pow(x, 0), pow(inverse(x), s)) = mul(one, pow(inverse(x), s)) = pow(inverse(x), s) = mul(pow(inverse(x), s), one) = mul(pow(inverse(x), s), pow(x, 0))
            ? induc:
                pow(x, r + 1) = mul(pow(x, r), x)
                $cross_commutation(s)
                mul(x, pow(inverse(x), s)) = mul(pow(inverse(x), s), x)
                mul(pow(x, r), x) = pow(x, r + 1)
                mul(pow(x, r + 1), pow(inverse(x), s)) = mul(mul(pow(x, r), x), pow(inverse(x), s)) = mul(pow(x, r), mul(x, pow(inverse(x), s))) = mul(pow(x, r), mul(pow(inverse(x), s), x)) = mul(mul(pow(x, r), pow(inverse(x), s)), x) = mul(mul(pow(inverse(x), s), pow(x, r)), x) = mul(pow(inverse(x), s), mul(pow(x, r), x)) = mul(pow(inverse(x), s), pow(x, r + 1))

    prop inverse_power_cancellation(n N):
        mul(pow(x, n), pow(inverse(x), n)) = one
        mul(pow(inverse(x), n), pow(x, n)) = one

    claim:
        ? forall n N:
            $inverse_power_cancellation(n)
        by induc n from 0:
            ? $inverse_power_cancellation(n)
            ? from n = 0:
                pow(x, 0) = one
                pow(inverse(x), 0) = one
                mul(pow(x, 0), pow(inverse(x), 0)) = mul(one, one) = one
                mul(pow(inverse(x), 0), pow(x, 0)) = mul(one, one) = one
                by def:
                    ? $inverse_power_cancellation(0)
            ? induc:
                pow(x, n + 1) = mul(pow(x, n), x)
                pow(inverse(x), n + 1) = mul(pow(inverse(x), n), inverse(x))
                mul(x, inverse(x)) = one
                mul(inverse(x), x) = one
                $cross_commutation(n)
                mul(x, pow(inverse(x), n)) = mul(pow(inverse(x), n), x)
                mul(inverse(x), pow(x, n)) = mul(pow(x, n), inverse(x))
                mul(x, mul(pow(inverse(x), n), inverse(x))) = mul(mul(x, pow(inverse(x), n)), inverse(x))
                mul(inverse(x), mul(pow(x, n), x)) = mul(mul(inverse(x), pow(x, n)), x)
                mul(pow(x, n), mul(x, pow(inverse(x), n))) = mul(pow(x, n), mul(pow(inverse(x), n), x))
                mul(pow(inverse(x), n), mul(inverse(x), pow(x, n))) = mul(pow(inverse(x), n), mul(pow(x, n), inverse(x)))
                mul(pow(x, n), mul(pow(inverse(x), n), x)) = mul(mul(pow(x, n), pow(inverse(x), n)), x)
                mul(pow(inverse(x), n), mul(pow(x, n), inverse(x))) = mul(mul(pow(inverse(x), n), pow(x, n)), inverse(x))
                mul(mul(pow(x, n), mul(pow(inverse(x), n), x)), inverse(x)) = mul(mul(mul(pow(x, n), pow(inverse(x), n)), x), inverse(x))
                mul(mul(pow(inverse(x), n), mul(pow(x, n), inverse(x))), x) = mul(mul(mul(pow(inverse(x), n), pow(x, n)), inverse(x)), x)
                mul(pow(x, n + 1), pow(inverse(x), n + 1)) = mul(mul(pow(x, n), x), mul(pow(inverse(x), n), inverse(x))) = mul(pow(x, n), mul(x, mul(pow(inverse(x), n), inverse(x)))) = mul(pow(x, n), mul(mul(x, pow(inverse(x), n)), inverse(x))) = mul(mul(pow(x, n), mul(x, pow(inverse(x), n))), inverse(x)) = mul(mul(pow(x, n), mul(pow(inverse(x), n), x)), inverse(x)) = mul(mul(mul(pow(x, n), pow(inverse(x), n)), x), inverse(x)) = mul(mul(pow(x, n), pow(inverse(x), n)), mul(x, inverse(x))) = mul(one, one) = one
                mul(pow(inverse(x), n + 1), pow(x, n + 1)) = mul(mul(pow(inverse(x), n), inverse(x)), mul(pow(x, n), x)) = mul(pow(inverse(x), n), mul(inverse(x), mul(pow(x, n), x))) = mul(pow(inverse(x), n), mul(mul(inverse(x), pow(x, n)), x)) = mul(mul(pow(inverse(x), n), mul(inverse(x), pow(x, n))), x) = mul(mul(pow(inverse(x), n), mul(pow(x, n), inverse(x))), x) = mul(mul(mul(pow(inverse(x), n), pow(x, n)), inverse(x)), x) = mul(mul(pow(inverse(x), n), pow(x, n)), mul(inverse(x), x)) = mul(one, one) = one
                by def:
                    ? $inverse_power_cancellation(n + 1)

    prop is_integral_power_value(y G):
        exist n Z st {$has_group_power(G, mul, one, x, n, y)}

    have P power_set(G) = {y G: $is_integral_power_value(y)}
    P = {y G: $is_integral_power_value(y)}

    claim:
        ? $is_subgroup(G, mul, one, P)
        claim:
            ? one $in P
            pow(x, 0) = one
            pow(inverse(x), 0) = one
            by thm pow_represents_nonnegative_power(x, 0)
            by thm pow_represents_nonnegative_power(inverse(x), 0)
            witness exist inv, positive_part, negative_part G, p, q N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q, negative_part), 0 + q = p, one = mul(positive_part, negative_part)} from inverse(x), one, one, 0, 0:
                one = mul(one, one)
            by def:
                ? $has_group_power(G, mul, one, x, 0, one)
            witness exist n Z st {$has_group_power(G, mul, one, x, n, one)} from 0
            by def:
                ? $is_integral_power_value(one)
            by thm set_builder_member(one, {y G: $is_integral_power_value(y)})
            one $in {y G: $is_integral_power_value(y)}
            one $in P
        claim:
            ? forall y, z G:
                y $in P
                z $in P
                =>:
                    mul(y, z) $in P
            obtain a from exist a Z st {$has_group_power(G, mul, one, x, a, y)}
            obtain inv1, yp, yn, p, q from exist inv, positive_part, negative_part G, p, q N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q, negative_part), a + q = p, y = mul(positive_part, negative_part)}
            obtain b from exist b Z st {$has_group_power(G, mul, one, x, b, z)}
            obtain inv2, zp, zn, r, s from exist inv, positive_part, negative_part G, p2, q2 N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p2, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q2, negative_part), b + q2 = p2, z = mul(positive_part, negative_part)}
            inv1 = inverse(x)
            inv2 = inverse(x)
            by thm nonnegative_power_is_pow(x, yp, p)
            by thm nonnegative_power_is_pow(inv1, yn, q)
            by thm nonnegative_power_is_pow(x, zp, r)
            by thm nonnegative_power_is_pow(inv2, zn, s)
            yp = pow(x, p)
            yn = pow(inv1, q) = pow(inverse(x), q)
            zp = pow(x, r)
            zn = pow(inv2, s) = pow(inverse(x), s)
            mul(yp, yn) = mul(pow(x, p), pow(inverse(x), q))
            mul(zp, zn) = mul(pow(x, r), pow(inverse(x), s))
            y = mul(yp, yn) = mul(pow(x, p), pow(inverse(x), q))
            z = mul(zp, zn) = mul(pow(x, r), pow(inverse(x), s))
            have positive_part G = pow(x, p + r)
            have negative_part G = pow(inverse(x), q + s)
            positive_part = pow(x, p + r)
            negative_part = pow(inverse(x), q + s)
            by thm pow_represents_nonnegative_power(x, p + r)
            by thm pow_represents_nonnegative_power(inverse(x), q + s)
            mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s))) = mul(mul(pow(inverse(x), q), pow(x, r)), pow(inverse(x), s))
            mul(mul(pow(x, p), pow(inverse(x), q)), mul(pow(x, r), pow(inverse(x), s))) = mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s))))
            mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s)))) = mul(pow(x, p), mul(mul(pow(inverse(x), q), pow(x, r)), pow(inverse(x), s)))
            mul(pow(inverse(x), q), pow(x, r)) = mul(pow(x, r), pow(inverse(x), q))
            mul(pow(x, p), mul(pow(inverse(x), q), pow(x, r))) = mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q)))
            mul(mul(pow(x, p), mul(pow(inverse(x), q), pow(x, r))), pow(inverse(x), s)) = mul(mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q))), pow(inverse(x), s))
            mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q))) = mul(mul(pow(x, p), pow(x, r)), pow(inverse(x), q))
            mul(pow(x, p), pow(x, r)) = pow(x, p + r)
            mul(mul(pow(x, p), pow(x, r)), pow(inverse(x), q)) = mul(pow(x, p + r), pow(inverse(x), q))
            mul(pow(inverse(x), q), pow(inverse(x), s)) = pow(inverse(x), q + s)
            mul(mul(pow(x, p + r), pow(inverse(x), q)), pow(inverse(x), s)) = mul(pow(x, p + r), mul(pow(inverse(x), q), pow(inverse(x), s)))
            mul(pow(x, p + r), mul(pow(inverse(x), q), pow(inverse(x), s))) = mul(pow(x, p + r), pow(inverse(x), q + s))
            mul(pow(x, p + r), pow(inverse(x), q + s)) = mul(positive_part, negative_part)
            mul(y, z) = mul(mul(pow(x, p), pow(inverse(x), q)), mul(pow(x, r), pow(inverse(x), s))) = mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, r), pow(inverse(x), s)))) = mul(pow(x, p), mul(mul(pow(inverse(x), q), pow(x, r)), pow(inverse(x), s))) = mul(mul(pow(x, p), mul(pow(inverse(x), q), pow(x, r))), pow(inverse(x), s)) = mul(mul(pow(x, p), mul(pow(x, r), pow(inverse(x), q))), pow(inverse(x), s)) = mul(mul(mul(pow(x, p), pow(x, r)), pow(inverse(x), q)), pow(inverse(x), s)) = mul(mul(pow(x, p), pow(x, r)), mul(pow(inverse(x), q), pow(inverse(x), s))) = mul(pow(x, p + r), mul(pow(inverse(x), q), pow(inverse(x), s))) = mul(pow(x, p + r), pow(inverse(x), q + s)) = mul(positive_part, negative_part)
            (a + b) + (q + s) = (a + q) + (b + s) = p + r
            witness exist inv, pp, nn G, idx_i, j N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, idx_i, pp), $has_nonnegative_group_power(G, mul, one, inv, j, nn), (a + b) + j = idx_i, mul(y, z) = mul(pp, nn)} from inverse(x), positive_part, negative_part, p + r, q + s
            by def:
                ? $has_group_power(G, mul, one, x, a + b, mul(y, z))
            witness exist n Z st {$has_group_power(G, mul, one, x, n, mul(y, z))} from a + b
            by def:
                ? $is_integral_power_value(mul(y, z))
            by thm set_builder_member(mul(y, z), {t G: $is_integral_power_value(t)})
            mul(y, z) $in {t G: $is_integral_power_value(t)}
        claim:
            ? forall y G:
                y $in P
                =>:
                    exist z G st {mul(y, z) = one, z $in P}
            obtain a from exist a Z st {$has_group_power(G, mul, one, x, a, y)}
            obtain inv, yp, yn, p, q from exist inv, positive_part, negative_part G, p, q N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q, negative_part), a + q = p, y = mul(positive_part, negative_part)}
            inv = inverse(x)
            by thm nonnegative_power_is_pow(x, yp, p)
            by thm nonnegative_power_is_pow(inv, yn, q)
            yp = pow(x, p)
            yn = pow(inv, q) = pow(inverse(x), q)
            mul(yp, yn) = mul(pow(x, p), pow(inverse(x), q))
            y = mul(yp, yn) = mul(pow(x, p), pow(inverse(x), q))
            have z G = mul(pow(x, q), pow(inverse(x), p))
            by thm pow_represents_nonnegative_power(x, q)
            by thm pow_represents_nonnegative_power(inverse(x), p)
            q = (a + q) - a = p - a = -a + p
            witness exist inv0, pp, nn G, idx_i, j N st {mul(x, inv0) = one, mul(inv0, x) = one, $has_nonnegative_group_power(G, mul, one, x, idx_i, pp), $has_nonnegative_group_power(G, mul, one, inv0, j, nn), -a + j = idx_i, z = mul(pp, nn)} from inverse(x), pow(x, q), pow(inverse(x), p), q, p
            by def:
                ? $has_group_power(G, mul, one, x, -a, z)
            witness exist n Z st {$has_group_power(G, mul, one, x, n, z)} from -a
            by def:
                ? $is_integral_power_value(z)
            by thm set_builder_member(z, {t G: $is_integral_power_value(t)})
            z $in {t G: $is_integral_power_value(t)}
            z $in P
            witness exist z0 G st {mul(y, z0) = one, z0 $in P} from z:
                $inverse_power_cancellation(q)
                $inverse_power_cancellation(p)
                mul(pow(inverse(x), q), pow(x, q)) = one
                mul(mul(pow(inverse(x), q), pow(x, q)), pow(inverse(x), p)) = mul(one, pow(inverse(x), p))
                mul(pow(x, p), mul(mul(pow(inverse(x), q), pow(x, q)), pow(inverse(x), p))) = mul(pow(x, p), mul(one, pow(inverse(x), p)))
                mul(one, pow(inverse(x), p)) = pow(inverse(x), p)
                mul(pow(x, p), mul(one, pow(inverse(x), p))) = mul(pow(x, p), pow(inverse(x), p))
                mul(pow(x, p), pow(inverse(x), p)) = one
                mul(pow(inverse(x), q), mul(pow(x, q), pow(inverse(x), p))) = mul(mul(pow(inverse(x), q), pow(x, q)), pow(inverse(x), p))
                mul(mul(pow(x, p), pow(inverse(x), q)), mul(pow(x, q), pow(inverse(x), p))) = mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, q), pow(inverse(x), p))))
                mul(y, z) = mul(mul(pow(x, p), pow(inverse(x), q)), mul(pow(x, q), pow(inverse(x), p))) = mul(pow(x, p), mul(pow(inverse(x), q), mul(pow(x, q), pow(inverse(x), p)))) = mul(pow(x, p), mul(mul(pow(inverse(x), q), pow(x, q)), pow(inverse(x), p))) = mul(pow(x, p), mul(one, pow(inverse(x), p))) = mul(pow(x, p), pow(inverse(x), p)) = one
        by def:
            ? $is_subgroup(G, mul, one, P)

    claim:
        ? x $in P
        pow(x, 1) = mul(pow(x, 1 - 1), x)
        1 - 1 = 0
        pow(x, 0) = one
        pow(x, 1) = mul(pow(x, 0), x) = mul(one, x) = x
        pow(inverse(x), 0) = one
        by thm pow_represents_nonnegative_power(x, 1)
        by thm pow_represents_nonnegative_power(inverse(x), 0)
        witness exist inv, positive_part, negative_part G, p, q N st {mul(x, inv) = one, mul(inv, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv, q, negative_part), 1 + q = p, x = mul(positive_part, negative_part)} from inverse(x), x, one, 1, 0:
            x = mul(x, one)
        by def:
            ? $has_group_power(G, mul, one, x, 1, x)
        witness exist n Z st {$has_group_power(G, mul, one, x, n, x)} from 1
        by def:
            ? $is_integral_power_value(x)
        by thm set_builder_member(x, {t G: $is_integral_power_value(t)})
        x $in {t G: $is_integral_power_value(t)}
        x $in P
    {x} $subset P
    H $subset P
    forall y H:
        y $in P
        exist n Z st {$has_group_power(G, mul, one, x, n, y)}
    by def:
        ? $every_generated_element_is_power(G, mul, one, x, H)

thm generated_subgroup_contains_integral_powers:
    ? forall G set, mul fn(x, y G) G, one G, x G, H power_set(G), n Z, y G:
        $is_group(G, mul, one)
        $generated_subgroup(G, mul, one, x, H)
        $has_group_power(G, mul, one, x, n, y)
        =>:
            y $in H
    obtain inv, positive_part, negative_part, p, q from exist inv0, positive0, negative0 G, p0, q0 N st {mul(x, inv0) = one, mul(inv0, x) = one, $has_nonnegative_group_power(G, mul, one, x, p0, positive0), $has_nonnegative_group_power(G, mul, one, inv0, q0, negative0), n + q0 = p0, y = mul(positive0, negative0)}
    obtain h from exist h0 G st {mul(x, h0) = one, h0 $in H}
    h = mul(one, h) = mul(mul(inv, x), h) = mul(inv, mul(x, h)) = mul(inv, one) = inv
    inv $in H
    thm nonnegative_power_stays_in_H:
        ? forall z G, k N, w G:
            z $in H
            $has_nonnegative_group_power(G, mul, one, z, k, w)
            =>:
                w $in H
        obtain sequence from exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, z, k, a), a(k) = w}
        prop prefix_in_H(idx_i N):
            forall:
                idx_i <= k
                =>:
                    sequence(idx_i) $in H
        claim:
            ? forall idx_i N:
                $prefix_in_H(idx_i)
            by induc idx_i from 0:
                ? $prefix_in_H(idx_i)
                ? from idx_i = 0:
                    claim:
                        ? forall:
                            0 <= k
                            =>:
                                sequence(0) $in H
                        sequence(0) = one
                        one $in H
                    by def:
                        ? $prefix_in_H(0)
                ? induc:
                    claim:
                        ? forall:
                            idx_i + 1 <= k
                            =>:
                                sequence(idx_i + 1) $in H
                        idx_i < idx_i + 1 <= k
                        idx_i <= k
                        $prefix_in_H(idx_i)
                        sequence(idx_i) $in H
                        sequence(idx_i + 1) = mul(sequence(idx_i), z)
                        mul(sequence(idx_i), z) $in H
                    by def:
                        ? $prefix_in_H(idx_i + 1)
        $prefix_in_H(k)
        k <= k
        sequence(k) $in H
        sequence(k) = w
    by thm nonnegative_power_stays_in_H(x, p, positive_part)
    by thm nonnegative_power_stays_in_H(inv, q, negative_part)
    positive_part $in H
    negative_part $in H
    mul(positive_part, negative_part) $in H
    y = mul(positive_part, negative_part)

thm theorem_VII_1_generated_powers:
    ? forall G set, mul fn(x, y G) G, one G, x G, H power_set(G):
        $is_group(G, mul, one)
        $generated_subgroup(G, mul, one, x, H)
        =>:
            H = \integral_powers<G, mul, one>(x)
    by thm generated_subgroup_elements_are_powers(G, mul, one, x, H)
    by extension:
        ? H = \integral_powers<G, mul, one>(x)
        claim:
            ? forall y H:
                y $in \integral_powers<G, mul, one>(x)
            exist n Z st {$has_group_power(G, mul, one, x, n, y)}
            by def:
                ? $is_integral_power_of(G, mul, one, x, y)
            \integral_powers<G, mul, one>(x) = {t G: $is_integral_power_of(G, mul, one, x, t)}
            by thm set_builder_member(y, {t G: $is_integral_power_of(G, mul, one, x, t)})
        claim:
            ? forall y \integral_powers<G, mul, one>(x):
                y $in H
            $is_integral_power_of(G, mul, one, x, y)
            obtain n from exist n Z st {$has_group_power(G, mul, one, x, n, y)}
            by thm generated_subgroup_contains_integral_powers(G, mul, one, x, H, n, y)

"""
For fixed x, let M_x be the integers a for which x^a=1.  The identity
x^(a-b)=x^a(x^b)^(-1) shows that x^a=x^b exactly when a-b belongs to M_x,
and therefore M_x is nonempty and closed under subtraction.
"""

template<G set, mul fn(x, y G) G, one G>:
    have fn exponent_kernel(x G) power_set(Z) = {a Z: $has_group_power(G, mul, one, x, a, one)}

prop group_power_equality_kernel_law(G set, mul fn(x, y G) G, one G, x G):
    forall a, b Z, ya, yb G:
        $has_group_power(G, mul, one, x, a, ya)
        $has_group_power(G, mul, one, x, b, yb)
        =>:
            ya = yb
        <=>:
            a - b $in \exponent_kernel<G, mul, one>(x)

# The source rewrites x^(a-b) as x^a times the inverse of x^b.  The forward
# implication makes that inverse explicit; the reverse implication adds x^b
# back and uses uniqueness of the resulting signed-power value.
thm group_power_equality_iff_exponent_difference_in_kernel:
    ? forall G set, mul fn(x, y G) G, one G, x G:
        $is_group(G, mul, one)
        =>:
            $group_power_equality_kernel_law(G, mul, one, x)
    claim:
        ? forall a, b Z, ya, yb G:
            $has_group_power(G, mul, one, x, a, ya)
            $has_group_power(G, mul, one, x, b, yb)
            ya = yb
            =>:
                a - b $in \exponent_kernel<G, mul, one>(x)
        by thm group_power_neg(G, mul, one, x, yb, b)
        obtain invb from exist z G st {$has_group_power(G, mul, one, x, -b, z), mul(yb, z) = one, mul(z, yb) = one}
        by thm group_power_add(G, mul, one, x, ya, invb, a, -b)
        a + (-b) = a - b
        mul(ya, invb) = mul(yb, invb) = one
        $has_group_power(G, mul, one, x, a - b, one)
        \exponent_kernel<G, mul, one>(x) = {t Z: $has_group_power(G, mul, one, x, t, one)}
        by thm set_builder_member(a - b, {t Z: $has_group_power(G, mul, one, x, t, one)})

    claim:
        ? forall a, b Z, ya, yb G:
            $has_group_power(G, mul, one, x, a, ya)
            $has_group_power(G, mul, one, x, b, yb)
            a - b $in \exponent_kernel<G, mul, one>(x)
            =>:
                ya = yb
        $has_group_power(G, mul, one, x, a - b, one)
        by thm group_power_add(G, mul, one, x, yb, one, b, a - b)
        b + (a - b) = a
        mul(yb, one) = yb
        $has_group_power(G, mul, one, x, a, yb)
        by thm group_power_is_unique(G, mul, one, x, ya, yb, a)

    by def:
        ? $group_power_equality_kernel_law(G, mul, one, x)

thm zero_belongs_to_exponent_kernel:
    ? forall G set, mul fn(x, y G) G, one G, x G:
        $is_group(G, mul, one)
        =>:
            0 $in \exponent_kernel<G, mul, one>(x)
    obtain inv from exist inv0 G st {mul(x, inv0) = one, mul(inv0, x) = one}
    have fn sequence_x(idx_i N) G = one
    have fn sequence_inv(idx_i N) G = one
    claim:
        ? $is_group_power_sequence(G, mul, one, x, 0, sequence_x)
        sequence_x(0) = one
        claim:
            ? forall idx_i N:
                idx_i < 0
                =>:
                    sequence_x(idx_i + 1) = mul(sequence_x(idx_i), x)
            by contra:
                ? sequence_x(idx_i + 1) = mul(sequence_x(idx_i), x)
                impossible idx_i < 0
        by def:
            ? $is_group_power_sequence(G, mul, one, x, 0, sequence_x)
    claim:
        ? $is_group_power_sequence(G, mul, one, inv, 0, sequence_inv)
        sequence_inv(0) = one
        claim:
            ? forall idx_i N:
                idx_i < 0
                =>:
                    sequence_inv(idx_i + 1) = mul(sequence_inv(idx_i), inv)
            by contra:
                ? sequence_inv(idx_i + 1) = mul(sequence_inv(idx_i), inv)
                impossible idx_i < 0
        by def:
            ? $is_group_power_sequence(G, mul, one, inv, 0, sequence_inv)
    witness exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, x, 0, a), a(0) = one} from sequence_x
    by def:
        ? $has_nonnegative_group_power(G, mul, one, x, 0, one)
    witness exist a fn(idx_i N) G st {$is_group_power_sequence(G, mul, one, inv, 0, a), a(0) = one} from sequence_inv
    by def:
        ? $has_nonnegative_group_power(G, mul, one, inv, 0, one)
    witness exist inv0, positive_part, negative_part G, p, q N st {mul(x, inv0) = one, mul(inv0, x) = one, $has_nonnegative_group_power(G, mul, one, x, p, positive_part), $has_nonnegative_group_power(G, mul, one, inv0, q, negative_part), 0 + q = p, one = mul(positive_part, negative_part)} from inv, one, one, 0, 0:
        one = mul(one, one)
    by def:
        ? $has_group_power(G, mul, one, x, 0, one)
    \exponent_kernel<G, mul, one>(x) = {t Z: $has_group_power(G, mul, one, x, t, one)}
    by thm set_builder_member(0, {t Z: $has_group_power(G, mul, one, x, t, one)})

thm exponent_kernel_closed_under_subtraction:
    ? forall G set, mul fn(x, y G) G, one G, x G:
        $is_group(G, mul, one)
        =>:
            $section2::closed_under_subtraction(\exponent_kernel<G, mul, one>(x))
    by thm group_power_equality_iff_exponent_difference_in_kernel(G, mul, one, x)
    claim:
        ? forall a, b \exponent_kernel<G, mul, one>(x):
            a - b $in \exponent_kernel<G, mul, one>(x)
        $has_group_power(G, mul, one, x, a, one)
        $has_group_power(G, mul, one, x, b, one)
        one = one
    by def:
        ? $section2::closed_under_subtraction(\exponent_kernel<G, mul, one>(x))

thm exponent_kernel_is_mZ:
    ? forall G set, mul fn(x, y G) G, one G, x G:
        $is_group(G, mul, one)
        =>:
            exist! m N st {\exponent_kernel<G, mul, one>(x) = section2::mZ(m)}
    by thm zero_belongs_to_exponent_kernel(G, mul, one, x)
    witness $is_nonempty_set(\exponent_kernel<G, mul, one>(x)) from 0
    by thm exponent_kernel_closed_under_subtraction(G, mul, one, x)
    by thm section2::theorem_II_1_subgroups_of_Z(\exponent_kernel<G, mul, one>(x))

thm zero_exponent_kernel_gives_distinct_powers:
    ? forall G set, mul fn(x, y G) G, one G, base G, a, b Z, ya, yb G:
        $is_group(G, mul, one)
        \exponent_kernel<G, mul, one>(base) = section2::mZ(0)
        $has_group_power(G, mul, one, base, a, ya)
        $has_group_power(G, mul, one, base, b, yb)
        ya = yb
        =>:
            a = b
    by thm group_power_equality_iff_exponent_difference_in_kernel(G, mul, one, base)
    a - b $in \exponent_kernel<G, mul, one>(base)
    a - b $in section2::mZ(0)
    by thm section2::mZ_membership_characterization(0)
    a - b $in {x Z: $section1::divides_Z(0, x)}
    $section1::divides_Z(0, a - b)
    obtain k from exist k Z st {a - b = 0 * k}
    a - b = 0 * k = 0

prop powers_are_equal_iff_exponents_congruent(G set, mul fn(x, y G) G, one G, x G, m N+):
    forall a, b Z, ya, yb G:
        $has_group_power(G, mul, one, x, a, ya)
        $has_group_power(G, mul, one, x, b, yb)
        =>:
            ya = yb
        <=>:
            $section5::congruent_mod(m, a, b)

thm positive_exponent_kernel_gives_congruent_powers:
    ? forall G set, mul fn(x, y G) G, one G, base G, m N+:
        $is_group(G, mul, one)
        \exponent_kernel<G, mul, one>(base) = section2::mZ(m)
        =>:
            $powers_are_equal_iff_exponents_congruent(G, mul, one, base, m)
    by thm group_power_equality_iff_exponent_difference_in_kernel(G, mul, one, base)
    claim:
        ? forall a, b Z, ya, yb G:
            $has_group_power(G, mul, one, base, a, ya)
            $has_group_power(G, mul, one, base, b, yb)
            ya = yb
            =>:
                $section5::congruent_mod(m, a, b)
        a - b $in \exponent_kernel<G, mul, one>(base)
        a - b $in section2::mZ(m)
        by thm section2::mZ_membership_characterization(m)
        a - b $in {x Z: $section1::divides_Z(m, x)}
        $section1::divides_Z(m, a - b)
        by def:
            ? $section5::congruent_mod(m, a, b)
    claim:
        ? forall a, b Z, ya, yb G:
            $has_group_power(G, mul, one, base, a, ya)
            $has_group_power(G, mul, one, base, b, yb)
            $section5::congruent_mod(m, a, b)
            =>:
                ya = yb
        $section1::divides_Z(m, a - b)
        by thm section2::mZ_membership_characterization(m)
        by thm set_builder_member(a - b, {x Z: $section1::divides_Z(m, x)})
        a - b $in {x Z: $section1::divides_Z(m, x)}
        a - b $in section2::mZ(m)
        a - b $in \exponent_kernel<G, mul, one>(base)
    by def:
        ? $powers_are_equal_iff_exponents_congruent(G, mul, one, base, m)

"""
An isomorphism is a bijection that transports one group operation to the
other.  Isomorphic groups have the same group-theoretic structure.  The same
definition applies, with all operations preserved, to rings and fields.
"""

prop group_homomorphism(G set, H set, mulG fn(x, y G) G, mulH fn(x, y H) H, phi fn(x G) H):
    forall x, y G:
        phi(mulG(x, y)) = mulH(phi(x), phi(y))

prop group_isomorphism(G set, H set, mulG fn(x, y G) G, mulH fn(x, y H) H, phi fn(x G) H):
    $group_homomorphism(G, H, mulG, mulH, phi)
    forall x1, x2 G:
        phi(x1) = phi(x2)
        =>:
            x1 = x2
    forall y H:
        exist x G st {phi(x) = y}

prop is_generator_of_group(G set, mul fn(x, y G) G, one G, generator G):
    $is_group(G, mul, one)
    $generated_subgroup(G, mul, one, generator, G)

prop is_infinite_cyclic_index(G set, mul fn(x, y G) G, one G, generator G, index fn(y G) Z):
    $group_isomorphism(G, Z, mul, fn(a, b Z) Z {a + b}, index)
    forall a Z, y G:
        $has_group_power(G, mul, one, generator, a, y)
        =>:
            index(y) = a

prop infinite_cyclic_isomorphism(G set, mul fn(x, y G) G, one G, generator G):
    not $is_finite_set(G)
    exist index fn(y G) Z st {$is_infinite_cyclic_index(G, mul, one, generator, index)}

prop is_finite_cyclic_index(G set, mul fn(x, y G) G, one G, generator G, m N+, Classes finite_set, add fn(A, B Classes) Classes, zero Classes, index fn(y G) Classes):
    $section5::is_set_of_all_residue_classes_mod(m, Classes)
    finite_set_size(Classes) = m
    $section5::is_residue_class_addition_operation(m, Classes, add, zero)
    $section5::is_abelian_group(Classes, add, zero)
    $group_isomorphism(G, Classes, mul, add, index)
    forall a Z, y G:
        $has_group_power(G, mul, one, generator, a, y)
        =>:
            index(y) = section5::residue_class_mod(m, a)

prop finite_cyclic_isomorphism(G set, mul fn(x, y G) G, one G, generator G, m N+):
    $is_finite_set(G)
    finite_set_size(G) = m
    exist Classes finite_set, add fn(A, B Classes) Classes, zero Classes, index fn(y G) Classes st {$is_finite_cyclic_index(G, mul, one, generator, m, Classes, add, zero, index)}

prop has_finite_cyclic_isomorphism(G set, mul fn(x, y G) G, one G, generator G):
    exist m N+ st {$finite_cyclic_isomorphism(G, mul, one, generator, m)}

prop cyclic_group_classification(G set, mul fn(x, y G) G, one G, generator G):
    $infinite_cyclic_isomorphism(G, mul, one, generator) or $has_finite_cyclic_isomorphism(G, mul, one, generator)

"""
Theorem VII.2.  A group generated by x is either infinite and isomorphic to
the additive group Z by x^a |-> a, or finite of some order m and isomorphic to
the additive group of residue classes modulo m by x^a |-> (a mod m).
"""

# Source handling: the kernel classification above is checked once the
# integral-power subtraction law is supplied.  Constructing the two dependent
# index functions and transporting finite cardinality remain the exact proof
# debt; the theorem records the real group maps rather than a residue-only map.
thm theorem_VII_2_cyclic_group_classification:
    ? forall G set, mul fn(x, y G) G, one G, generator G:
        $is_generator_of_group(G, mul, one, generator)
        =>:
            $cyclic_group_classification(G, mul, one, generator)
    trust $cyclic_group_classification(G, mul, one, generator)

"""
Theorem VII.2 also applies to the subgroup generated by any element x of an
arbitrary group, with that subgroup used as the carrier.
"""

"""
The order of a finite group is its number of elements.  A finite group
generated by one element is cyclic.  If x generates a finite subgroup of
order m, then m is also called the order of x.
"""

prop cyclic_group(G set, mul fn(x, y G) G, one G, generator G):
    $is_generator_of_group(G, mul, one, generator)

prop finite_cyclic_group(G set, mul fn(x, y G) G, one G, generator G, m N+):
    $cyclic_group(G, mul, one, generator)
    $is_finite_set(G)
    finite_set_size(G) = m

prop group_element_has_order(G set, mul fn(x, y G) G, one G, x G, m N+):
    exist H power_set(G) st {$generated_subgroup(G, mul, one, x, H), $is_finite_set(H), finite_set_size(H) = m}
