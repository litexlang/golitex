# Section X: finite multiplicative subgroups, roots of unity, and primitive roots.

# A finite multiplicative subgroup of a field is a finite set of nonzero field
# elements whose group operation is the restriction of field multiplication.
# Keeping the ambient field visible is essential: an arbitrary finite group
# need not be cyclic.
prop finite_multiplicative_subgroup(K set, addK, mulK fn(x, y K) K, zero K, G finite_set, one G, mulG fn(x, y G) G):
    G $subset K
    $section6::is_field(K, addK, mulK, zero, one)
    forall x G:
        x != zero
    forall x, y G:
        mulG(x, y) = mulK(x, y)
    $section7::is_group(G, mulG, one)

# The n-th roots of unity are an actual set-valued construction over Z.
prop root_of_unity_Z(n N+, x Z):
    x ^ n = 1

have fn roots_of_unity_Z(n N+) power_set(Z) = {x Z: $root_of_unity_Z(n, x)}

# The order of a residue class is the least positive exponent returning to 1.
# Primitive root means that this order is the full unit-group cardinality.
prop multiplicative_order_mod(m N+, g Z, n N+):
    g ^ n % m = 1
    forall k N+:
        g ^ k % m = 1
        =>:
            n <= k

prop primitive_root_mod(m N+, g Z):
    $section3::relatively_prime_Z(g, m)
    $multiplicative_order_mod(m, g, section6::euler_phi(m))
    forall a Z:
        $section3::relatively_prime_Z(a, m)
        =>:
            exist! x N st {g ^ x % m = a % m, x < section6::euler_phi(m)}

# A finite subgroup is cyclic when one generator's generated carrier is the
# whole carrier.  The generated-subgroup object is inherited explicitly from
# Section VII.
prop finite_subgroup_has_generator(G set, mul fn(x, y G) G, one G):
    exist g G st {$section7::generated_subgroup(G, mul, one, g, G)}

prop cyclic_multiplicative_group_mod(m N+, g Z):
    $primitive_root_mod(m, g)
    $multiplicative_order_mod(m, g, section6::euler_phi(m))

# For a primitive root, the discrete-log index is the unique representative in
# the interval [0, phi(m)).  The selected value is a reusable function object;
# its existence and uniqueness are the remaining finite cyclic counting step.
prop index_mod_spec(m N+, g Z, a Z, x N):
    $section3::relatively_prime_Z(g, m)
    $section3::relatively_prime_Z(a, m)
    g ^ x % m = a % m
    x < section6::euler_phi(m)

have fn index_mod by exist!:
    ? forall m N+, g, a Z:
        $primitive_root_mod(m, g)
        $section3::relatively_prime_Z(a, m)
        =>:
            exist! x N st {$index_mod_spec(m, g, a, x)}
    by def:
        ? $primitive_root_mod(m, g)
    exist! z N st {g ^ z % m = a % m, z < section6::euler_phi(m)}
    obtain x from exist! z N st {g ^ z % m = a % m, z < section6::euler_phi(m)}
    witness exist y N st {$index_mod_spec(m, g, a, y)} from x:
        by def:
            ? $index_mod_spec(m, g, a, x)
    forall x1, x2 N:
        g ^ x1 % m = a % m
        x1 < section6::euler_phi(m)
        g ^ x2 % m = a % m
        x2 < section6::euler_phi(m)
        =>:
            x1 = x2
    forall x1, x2 N:
        $index_mod_spec(m, g, a, x1)
        $index_mod_spec(m, g, a, x2)
        =>:
            x1 = x2
    exist! y N st {$index_mod_spec(m, g, a, y)}

# The selected value already carries its defining relation.  Export that stored
# fact so downstream proofs do not try to reconstruct it with `by def`.
thm index_mod_satisfies_spec:
    ? forall m N+, g, a Z:
        $primitive_root_mod(m, g)
        $section3::relatively_prime_Z(a, m)
        =>:
            $index_mod_spec(m, g, a, index_mod(m, g, a))
    $index_mod_spec(m, g, a, index_mod(m, g, a))

# Minimal positive order implies divisibility of every natural return
# exponent.  Euclidean division leaves a remainder below n; if that remainder
# were positive, it would contradict the defining minimality of n.
thm multiplicative_order_divides_return_exponent:
    ? forall m N+, g Z, n N+, exponent N:
        $multiplicative_order_mod(m, g, n)
        g ^ exponent % m = 1
        =>:
            $section1::divides_Z(n, exponent)
    by def:
        ? $multiplicative_order_mod(m, g, n)
    0 <= g ^ n % m < m
    1 < m
    claim:
        ? $section2::euclidean_division_Z(1, m, 0, 1)
        m > 0
        1 = m * 0 + 1
        0 <= 1 < m
        by def:
            ? $section2::euclidean_division_Z(1, m, 0, 1)
    by thm section2::euclidean_division_remainder_is_mod(1, m, 0, 1)
    1 % m = 1
    by def:
        ? $section2::euclidean_division_Z(exponent, n, section2::integer_quotient(exponent, n), exponent % n)
    claim:
        ? section2::integer_quotient(exponent, n) >= 0
        by contra:
            ? section2::integer_quotient(exponent, n) >= 0
            section2::integer_quotient(exponent, n) < 0
            section2::integer_quotient(exponent, n) <= -1
            n * section2::integer_quotient(exponent, n) <= n * (-1) = -n
            exponent % n <= n - 1
            exponent = n * section2::integer_quotient(exponent, n) + exponent % n <= -n + (n - 1) = -1
            impossible exponent >= 0
    have qN N = section2::integer_quotient(exponent, n)
    have rN N = exponent % n
    exponent = n * qN + rN
    g ^ exponent = g ^ (n * qN + rN) = g ^ (n * qN) * g ^ rN
    g ^ (n * qN) = (g ^ n) ^ qN
    g ^ exponent = (g ^ n) ^ qN * g ^ rN
    ((g ^ n) ^ qN * g ^ rN) % m = (((g ^ n) ^ qN % m) * (g ^ rN % m)) % m
    g ^ n $in Z
    (g ^ n) ^ qN % m = ((g ^ n) % m) ^ qN % m = 1 ^ qN % m = 1 % m = 1
    g ^ exponent % m = ((g ^ n) ^ qN * g ^ rN) % m = (((g ^ n) ^ qN % m) * (g ^ rN % m)) % m = (1 * (g ^ rN % m)) % m = (g ^ rN % m) % m = g ^ rN % m
    g ^ rN % m = 1
    by cases:
        ? $section1::divides_Z(n, exponent)
        case rN = 0:
            witness exist factor Z st {exponent = n * factor} from qN
            by def:
                ? $section1::divides_Z(n, exponent)
        case rN > 0:
            rN $in N+
            n <= rN
            impossible rN < n

# The roots-of-unity version of cyclicity states directly that every root is
# an integral power of one chosen root, so later statements can use the set
# object rather than an existentially hidden group.
prop root_power_generated(n N+, g Z, x Z):
    $root_of_unity_Z(n, x)
    exist k N st {x = g ^ k}

prop root_generator_spec(n N+, g Z):
    $root_of_unity_Z(n, g)
    forall x roots_of_unity_Z(n):
        $root_power_generated(n, g, x)

prop roots_of_unity_form_cyclic_group(n N+):
    exist g Z st {$root_generator_spec(n, g)}

# The finite subgroup cyclicity theorem and the prime-modulus primitive-root
# theorem share the finite-field unit-group/cyclotomic counting package.
thm theorem_X_finite_subgroups_are_cyclic:
    ? forall K set, addK, mulK fn(x, y K) K, zero K, G finite_set, one G, mulG fn(x, y G) G:
        $finite_multiplicative_subgroup(K, addK, mulK, zero, G, one, mulG)
        =>:
            $finite_subgroup_has_generator(G, mulG, one)
    # trust: cyclicity still depends on the polynomial root bound from Section IX.
    trust $finite_subgroup_has_generator(G, mulG, one)

# The prime-modulus unit group is cyclic, so it admits a primitive root.
thm theorem_X_primitive_root_prime_modulus:
    ? forall p N+:
        $section4::is_prime_Z(p)
        =>:
            exist g Z st {$primitive_root_mod(p, g)}
    # trust: the finite-field cyclicity specialization is not yet proved.
    trust exist g Z st {$primitive_root_mod(p, g)}
