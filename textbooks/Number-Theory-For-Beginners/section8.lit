# Section VIII: cyclic subgroups, cosets, Lagrange's theorem, and Euler's theorem.

# Definition VIII.1. A left coset xH is the image of H under left
# multiplication by x.  It is a genuine set-valued function because later
# arguments compare its carrier, take its cardinality, and range over its
# members; a predicate alone would not support those uses.
prop left_coset_member(G set, mul fn(x, y G) G, H power_set(G), x, y G):
    exist h G st {h $in H, y = mul(x, h)}

template<G set, mul fn(x, y G) G>:
    have fn left_coset(H power_set(G), x G) power_set(G) = {y G: $left_coset_member(G, mul, H, x, y)}

thm left_coset_member_is_member:
    ? forall G set, mul fn(x, y G) G, H power_set(G), x, y G:
        $left_coset_member(G, mul, H, x, y)
        =>:
            y $in \left_coset<G, mul>(H, x)
    \left_coset<G, mul>(H, x) = {t G: $left_coset_member(G, mul, H, x, t)}
    by thm set_builder_member(y, {t G: $left_coset_member(G, mul, H, x, t)})

# A named coset carrier has exactly the membership condition in the source
# definition.  This relation keeps the representative explicit for the
# equal-or-disjoint lemma below.
prop is_left_coset(G set, mul fn(x, y G) G, H power_set(G), x G, carrier_C power_set(G)):
    carrier_C = \left_coset<G, mul>(H, x)

# Two cosets are compared through their carriers.  Naming their overlap makes
# the source's equal-or-disjoint dichotomy a direct propositional case split.
prop cosets_overlap(G set, C1, C2 power_set(G)):
    exist z G st {z $in C1, z $in C2}

prop cosets_equal(G set, C1, C2 power_set(G)):
    C1 = C2

prop cosets_disjoint(G set, C1, C2 power_set(G)):
    not $cosets_overlap(G, C1, C2)

# Every element lies in its own coset, and the source lemma says that two such
# carriers are either equal or disjoint.  The finite partition/counting step is
# kept as a named theorem interface below.
prop coset_partition_claim(G set, mul fn(x, y G) G, H power_set(G)):
    forall x G:
        exist carrier_C power_set(G) st {$is_left_coset(G, mul, H, x, carrier_C), x $in carrier_C}

# Lemma VIII.1. Left multiplication is injective, so a finite subgroup and
# each of its left cosets have the same cardinality.  The proof maps h to xh,
# cancels x using its inverse, and identifies the map's range with xH.
thm left_coset_has_subgroup_cardinality:
    ? forall G set, mul fn(x, y G) G, one, x G, H power_set(G):
        $section7::is_group(G, mul, one)
        $is_finite_set(H)
        =>:
            $is_finite_set(\left_coset<G, mul>(H, x))
            finite_set_size(\left_coset<G, mul>(H, x)) = finite_set_size(H)
    have fn translate(h H) G = mul(x, h)
    claim:
        ? forall h1, h2 H:
            translate(h1) = translate(h2)
            =>:
                h1 = h2
        obtain inv_x from exist inv0 G st {mul(x, inv0) = one, mul(inv0, x) = one}
        h1 = mul(one, h1) = mul(mul(inv_x, x), h1) = mul(inv_x, mul(x, h1))
        h2 = mul(one, h2) = mul(mul(inv_x, x), h2) = mul(inv_x, mul(x, h2))
        mul(x, h1) = translate(h1) = translate(h2) = mul(x, h2)
        h1 = mul(inv_x, mul(x, h1)) = mul(inv_x, mul(x, h2)) = h2
    by def $injective(H, G, translate)
    $is_finite_set(fn_range(translate))
    finite_set_size(fn_range(translate)) = finite_set_size(H)
    by extension fn_range(translate) = \left_coset<G, mul>(H, x):
        claim:
            ? forall y fn_range(translate):
                y $in \left_coset<G, mul>(H, x)
            have by preimage h from y $in fn_range(translate)
            h $in H
            y = translate(h) = mul(x, h)
            witness exist h0 G st {h0 $in H, y = mul(x, h0)} from h
            by def $left_coset_member(G, mul, H, x, y)
            \left_coset<G, mul>(H, x) = {t G: $left_coset_member(G, mul, H, x, t)}
            by thm set_builder_member(y, {t G: $left_coset_member(G, mul, H, x, t)})
        claim:
            ? forall y \left_coset<G, mul>(H, x):
                y $in fn_range(translate)
            $left_coset_member(G, mul, H, x, y)
            obtain h from exist h0 G st {h0 $in H, y = mul(x, h0)}
            y = mul(x, h) = translate(h)
            translate(h) $in fn_range(translate)
            y $in fn_range(translate)
    $is_finite_set(\left_coset<G, mul>(H, x))
    finite_set_size(\left_coset<G, mul>(H, x)) = finite_set_size(fn_range(translate)) = finite_set_size(H)

thm left_cosets_overlap_implies_equal:
    ? forall G set, mul fn(x, y G) G, one, x, y G, H power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
        =>:
            $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    obtain z from exist z0 G st {z0 $in \left_coset<G, mul>(H, x), z0 $in \left_coset<G, mul>(H, y)}
    $left_coset_member(G, mul, H, x, z)
    obtain h from exist h0 G st {h0 $in H, z = mul(x, h0)}
    $left_coset_member(G, mul, H, y, z)
    obtain k from exist k0 G st {k0 $in H, z = mul(y, k0)}
    by extension \left_coset<G, mul>(H, x) = \left_coset<G, mul>(H, y):
        claim:
            ? forall w \left_coset<G, mul>(H, x):
                w $in \left_coset<G, mul>(H, y)
            $left_coset_member(G, mul, H, x, w)
            obtain u from exist u0 G st {u0 $in H, w = mul(x, u0)}
            obtain inv_h from exist inv0 G st {mul(h, inv0) = one, inv0 $in H}
            mul(one, u) = u
            mul(k, inv_h) $in H
            mul(mul(k, inv_h), u) $in H
            mul(k, mul(inv_h, u)) = mul(mul(k, inv_h), u)
            mul(k, mul(inv_h, u)) $in H
            mul(mul(h, inv_h), u) = mul(h, mul(inv_h, u))
            mul(mul(x, h), mul(inv_h, u)) = mul(x, mul(h, mul(inv_h, u)))
            mul(x, h) = z = mul(y, k)
            mul(mul(y, k), mul(inv_h, u)) = mul(y, mul(k, mul(inv_h, u)))
            w = mul(x, u) = mul(x, mul(one, u)) = mul(x, mul(mul(h, inv_h), u)) = mul(x, mul(h, mul(inv_h, u))) = mul(mul(x, h), mul(inv_h, u)) = mul(mul(y, k), mul(inv_h, u)) = mul(y, mul(k, mul(inv_h, u)))
            witness exist q G st {q $in H, w = mul(y, q)} from mul(k, mul(inv_h, u)):
                mul(k, mul(inv_h, u)) $in H
                w = mul(y, mul(k, mul(inv_h, u)))
            by def $left_coset_member(G, mul, H, y, w)
            by thm left_coset_member_is_member(G, mul, H, y, w)
            w $in \left_coset<G, mul>(H, y)
        claim:
            ? forall w \left_coset<G, mul>(H, y):
                w $in \left_coset<G, mul>(H, x)
            $left_coset_member(G, mul, H, y, w)
            obtain v from exist v0 G st {v0 $in H, w = mul(y, v0)}
            obtain inv_k from exist inv0 G st {mul(k, inv0) = one, inv0 $in H}
            mul(one, v) = v
            mul(h, inv_k) $in H
            mul(mul(h, inv_k), v) $in H
            mul(h, mul(inv_k, v)) = mul(mul(h, inv_k), v)
            mul(h, mul(inv_k, v)) $in H
            mul(mul(k, inv_k), v) = mul(k, mul(inv_k, v))
            mul(mul(y, k), mul(inv_k, v)) = mul(y, mul(k, mul(inv_k, v)))
            mul(y, k) = z = mul(x, h)
            mul(mul(x, h), mul(inv_k, v)) = mul(x, mul(h, mul(inv_k, v)))
            w = mul(y, v) = mul(y, mul(one, v)) = mul(y, mul(mul(k, inv_k), v)) = mul(y, mul(k, mul(inv_k, v))) = mul(mul(y, k), mul(inv_k, v)) = mul(mul(x, h), mul(inv_k, v)) = mul(x, mul(h, mul(inv_k, v)))
            witness exist q G st {q $in H, w = mul(x, q)} from mul(h, mul(inv_k, v)):
                mul(h, mul(inv_k, v)) $in H
                w = mul(x, mul(h, mul(inv_k, v)))
            by def $left_coset_member(G, mul, H, x, w)
            by thm left_coset_member_is_member(G, mul, H, x, w)
            w $in \left_coset<G, mul>(H, x)
    by def $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))

# The remaining finite partition lemma follows immediately from the preceding
# overlap lemma once Litex has a reusable constant-fibre finite-cover count.
thm left_cosets_equal_or_disjoint:
    ? forall G set, mul fn(x, y G) G, one, x, y G, H power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        =>:
            $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)) or $cosets_disjoint(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)) or not $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    by cases:
        ? $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)) or $cosets_disjoint(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
        case $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)):
            by thm left_cosets_overlap_implies_equal(G, mul, one, x, y, H)
        case not $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)):
            by def $cosets_disjoint(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))

# A finite cover keeps its index domain fixed while its finite active index set
# varies.  This avoids changing a family function's type in the deletion step
# of the finite-set induction below.
prop fixed_indexed_subfamily(U, D set, S, T finite_set, F fn(K D) power_set(U)):
    S $subset U
    T $subset D
    forall K T:
        F(K) $subset S

prop fixed_unique_cover_of(U, D set, S, T finite_set, F fn(K D) power_set(U)):
    $fixed_indexed_subfamily(U, D, S, T, F)
    T $subset D
    forall x S:
        exist! K T st {x $in F(K)}

thm fixed_indexed_subfamily_intro:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U):
        S $subset U
        T $subset D
        forall K T:
            F(K) $subset S
        =>:
            $fixed_indexed_subfamily(U, D, S, T, F)
    S $subset U
    T $subset D
    forall K T:
        F(K) $subset S
    by def $fixed_indexed_subfamily(U, D, S, T, F)

thm fixed_unique_cover_distinct_fibers_are_disjoint:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U), K1, K2 T:
        T $subset D
        $fixed_unique_cover_of(U, D, S, T, F)
        K1 != K2
        =>:
            intersect(F(K1), F(K2)) = {}
    $fixed_indexed_subfamily(U, D, S, T, F)
    forall x S:
        exist! K0 T st {x $in F(K0)}
    by extension intersect(F(K1), F(K2)) = {}:
        claim:
            ? forall x intersect(F(K1), F(K2)):
                x $in {}
            by contra:
                ? x $in {}
                not x $in {}
                x $in F(K1)
                x $in F(K2)
                F(K1) $subset S
                x $in S
                exist! K0 T st {x $in F(K0)}
                obtain K0 from exist! K0 T st {x $in F(K0)}
                K0 = K1
                K0 = K2
                K1 = K2
                impossible K1 != K2
        claim:
            ? forall x {}:
                x $in intersect(F(K1), F(K2))
            by contra:
                ? x $in intersect(F(K1), F(K2))
                x $in {}
                impossible x $in {}

thm fixed_unique_cover_remove_inserted_index:
    ? forall U, D set, A, I finite_set, K D, F fn(L D) power_set(U):
        not K $in I
        $fixed_unique_cover_of(U, D, A, union({K}, I), F)
        =>:
            $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)
    $fixed_indexed_subfamily(U, D, A, union({K}, I), F)
    claim:
        ? $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
        set_minus(A, F(K)) $subset A
        A $subset U
        set_minus(A, F(K)) $subset U
        I $subset union({K}, I)
        union({K}, I) $subset D
        by def I $subset D
        I $subset D
        claim:
            ? forall L I:
                F(L) $subset set_minus(A, F(K))
            L $in union({K}, I)
            F(L) $subset A
            L != K
            by thm fixed_unique_cover_distinct_fibers_are_disjoint(U, D, A, union({K}, I), F, L, K)
            intersect(F(L), F(K)) = {}
            claim:
                ? forall x F(L):
                    x $in set_minus(A, F(K))
                x $in A
                claim:
                    ? not x $in F(K)
                    by contra:
                        ? not x $in F(K)
                        x $in F(K)
                        x $in intersect(F(L), F(K))
                        x $in {}
                        impossible not x $in {}
                x $in set_minus(A, F(K))
            by def F(L) $subset set_minus(A, F(K))
            F(L) $subset set_minus(A, F(K))
    by def $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
    claim:
        ? forall x set_minus(A, F(K)):
            exist! L I st {x $in F(L)}
        x $in A
        not x $in F(K)
        exist! L0 union({K}, I) st {x $in F(L0)}
        obtain L0 from exist! L0 union({K}, I) st {x $in F(L0)}
        claim:
            ? L0 $in I
            L0 $in {K} or L0 $in I
            by cases:
                ? L0 $in I
                case L0 $in {K}:
                    L0 = K
                    x $in F(L0) = F(K)
                    impossible not x $in F(K)
                case L0 $in I:
                    L0 $in I
        witness exist L I st {x $in F(L)} from L0:
            x $in F(L0)
            forall L1, L2 I:
                x $in F(L1)
                x $in F(L2)
                =>:
                    L1 $in union({K}, I)
                    L2 $in union({K}, I)
                    exist! L3 union({K}, I) st {x $in F(L3)}
                    L1 = L2
    by def $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)

thm finite_set_size_disjoint_union_fixed_cover:
    ? forall A, B finite_set:
        intersect(A, B) = {}
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    finite_set_sum(union(A, B), fn(x union(A, B)) N {1}) = finite_set_sum(A, fn(x A) N {1}) + finite_set_sum(B, fn(x B) N {1})
    finite_set_sum(union(A, B), fn(x union(A, B)) N {1}) = finite_set_size(union(A, B)) * 1 = finite_set_size(union(A, B))
    finite_set_sum(A, fn(x A) N {1}) = finite_set_size(A) * 1 = finite_set_size(A)
    finite_set_sum(B, fn(x B) N {1}) = finite_set_size(B) * 1 = finite_set_size(B)
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)


prop fixed_unique_cover_constant_size_holds(U, D set, T finite_set, n N):
    forall S finite_set, F fn(K D) power_set(U):
        $fixed_unique_cover_of(U, D, S, T, F)
        T $subset D
        forall K T:
            $is_finite_set(F(K))
            finite_set_size(F(K)) = n
        =>:
            finite_set_size(S) = finite_set_size(T) * n

thm finite_set_size_over_fixed_unique_constant_cover:
    ? forall U, D set, T finite_set, n N:
        $fixed_unique_cover_constant_size_holds(U, D, T, n)
    by induc P:
        ? $fixed_unique_cover_constant_size_holds(U, D, P, n)
        ? from P = {}:
            claim:
                ? forall A finite_set, F fn(K D) power_set(U):
                    $fixed_unique_cover_of(U, D, A, {}, F)
                    {} $subset D
                    forall K {}:
                        $is_finite_set(F(K))
                        finite_set_size(F(K)) = n
                    =>:
                        finite_set_size(A) = finite_set_size({}) * n
                claim:
                    ? A = {}
                    by extension A = {}:
                        claim:
                            ? forall x A:
                                x $in {}
                            by contra:
                                ? x $in {}
                                exist! K {} st {x $in F(K)}
                                obtain K from exist! K {} st {x $in F(K)}
                                impossible K $in {}
                        claim:
                            ? forall x {}:
                                x $in A
                            by contra:
                                ? x $in A
                                impossible x $in {}
                finite_set_size(A) = finite_set_size({}) = 0 = 0 * n
            by def $fixed_unique_cover_constant_size_holds(U, D, {}, n)
        ? induc K, I:
            $fixed_unique_cover_constant_size_holds(U, D, I, n)
            forall S0 finite_set, F0 fn(L D) power_set(U):
                $fixed_unique_cover_of(U, D, S0, I, F0)
                I $subset D
                forall L I:
                    $is_finite_set(F0(L))
                    finite_set_size(F0(L)) = n
                =>:
                    finite_set_size(S0) = finite_set_size(I) * n
            claim:
                ? forall A finite_set, F fn(L D) power_set(U):
                    $fixed_unique_cover_of(U, D, A, union({K}, I), F)
                    union({K}, I) $subset D
                    forall L union({K}, I):
                        $is_finite_set(F(L))
                        finite_set_size(F(L)) = n
                    =>:
                        finite_set_size(A) = finite_set_size(union({K}, I)) * n
                not K $in I
                $fixed_indexed_subfamily(U, D, A, union({K}, I), F)
                K $in union({K}, I)
                K $in D
                have A0 finite_set = set_minus(A, F(K))
                by thm fixed_unique_cover_remove_inserted_index(U, D, A, I, K, F)
                I $subset union({K}, I)
                I $subset D
                claim:
                    ? forall L I:
                        $is_finite_set(F(L))
                        finite_set_size(F(L)) = n
                    L $in union({K}, I)
                    $is_finite_set(F(L))
                    finite_set_size(F(L)) = n
                finite_set_size(set_minus(A, F(K))) = finite_set_size(I) * n
                finite_set_size(A0) = finite_set_size(I) * n
                $is_finite_set(F(K))
                finite_set_size(F(K)) = n
                claim:
                    ? A = union(F(K), A0)
                    by extension A = union(F(K), A0):
                        claim:
                            ? forall x A:
                                x $in union(F(K), A0)
                            x $in F(K) or not x $in F(K)
                            by cases:
                                ? x $in union(F(K), A0)
                                case x $in F(K):
                                    x $in union(F(K), A0)
                                case not x $in F(K):
                                    x $in set_minus(A, F(K))
                                    x $in A0
                                    x $in union(F(K), A0)
                        claim:
                            ? forall x union(F(K), A0):
                                x $in A
                            x $in F(K) or x $in A0
                            by cases:
                                ? x $in A
                                case x $in F(K):
                                    F(K) $subset A
                                    x $in A
                                case x $in A0:
                                    A0 = set_minus(A, F(K))
                                    x $in set_minus(A, F(K))
                                    x $in A
                claim:
                    ? intersect(F(K), A0) = {}
                    by extension intersect(F(K), A0) = {}:
                        claim:
                            ? forall x intersect(F(K), A0):
                                x $in {}
                            x $in F(K)
                            x $in A0
                            not x $in F(K)
                            by contra:
                                ? x $in {}
                                impossible not x $in F(K)
                        claim:
                            ? forall x {}:
                                x $in intersect(F(K), A0)
                            by contra:
                                ? x $in intersect(F(K), A0)
                                impossible x $in {}
                by thm finite_set_size_disjoint_union_fixed_cover(F(K), A0)
                finite_set_size(A) = finite_set_size(union(F(K), A0)) = finite_set_size(F(K)) + finite_set_size(A0) = n + finite_set_size(I) * n = (finite_set_size(I) + 1) * n
                claim:
                    ? intersect({K}, I) = {}
                    by extension intersect({K}, I) = {}:
                        claim:
                            ? forall L intersect({K}, I):
                                L $in {}
                            L = K
                            K $in I
                            by contra:
                                ? L $in {}
                                impossible not K $in I
                        claim:
                            ? forall L {}:
                                L $in intersect({K}, I)
                            by contra:
                                ? L $in intersect({K}, I)
                                impossible L $in {}
                finite_set_size({K}) = 1
                finite_set_size(intersect({K}, I)) = finite_set_size({}) = 0
                $is_finite_set({K})
                $is_finite_set(I)
                $is_finite_set(intersect({K}, I))
                finite_set_size(union({K}, I)) = finite_set_size({K}) + finite_set_size(I) - finite_set_size(intersect({K}, I))
                finite_set_size(union({K}, I)) = 1 + finite_set_size(I) - 0 = finite_set_size(I) + 1
                finite_set_size(A) = finite_set_size(union({K}, I)) * n
            by def $fixed_unique_cover_constant_size_holds(U, D, union({K}, I), n)

prop is_power_set_identity(G set, F fn(carrier_C power_set(G)) power_set(G)):
    forall carrier_C power_set(G):
        F(carrier_C) = carrier_C

thm power_set_identity_apply:
    ? forall G set, F fn(carrier_C power_set(G)) power_set(G), carrier_C power_set(G):
        $is_power_set_identity(G, F)
        =>:
            F(carrier_C) = carrier_C
    $is_power_set_identity(G, F)
    F(carrier_C) = carrier_C

thm power_set_identity_maps_to_subsets:
    ? forall G set, T finite_set, F fn(carrier_C power_set(G)) power_set(G), carrier_C T:
        $is_power_set_identity(G, F)
        T $subset power_set(G)
        =>:
            F(carrier_C) $subset G
    carrier_C $in power_set(G)
    by thm power_set_identity_apply(G, F, carrier_C)
    F(carrier_C) = carrier_C
    carrier_C $subset G
    F(carrier_C) $subset G

prop is_left_coset_carrier_map(G set, mul fn(x, y G) G, H power_set(G), L fn(x G) power_set(G)):
    forall x G:
        L(x) = \left_coset<G, mul>(H, x)

thm left_coset_carrier_map_apply:
    ? forall G set, mul fn(x, y G) G, H power_set(G), L fn(x G) power_set(G), x G:
        $is_left_coset_carrier_map(G, mul, H, L)
        =>:
            L(x) = \left_coset<G, mul>(H, x)
    $is_left_coset_carrier_map(G, mul, H, L)
    L(x) = \left_coset<G, mul>(H, x)

thm left_coset_carrier_has_representative:
    ? forall G set, mul fn(x, y G) G, H power_set(G), T finite_set, L fn(x G) power_set(G), carrier_C power_set(G):
        T = fn_range(L)
        carrier_C $in T
        $is_left_coset_carrier_map(G, mul, H, L)
        =>:
            exist x G st {carrier_C = \left_coset<G, mul>(H, x)}
    T = fn_range(L)
    carrier_C $in fn_range(L)
    have by preimage x from carrier_C $in fn_range(L)
    by thm left_coset_carrier_map_apply(G, mul, H, L, x)
    L(x) = \left_coset<G, mul>(H, x)
    witness exist x0 G st {carrier_C = \left_coset<G, mul>(H, x0)} from x:
        carrier_C = L(x) = \left_coset<G, mul>(H, x)

thm equal_left_coset_carriers_from_shared_member:
    ? forall G set, mul fn(x, y G) G, one G, H power_set(G), T finite_set, F fn(carrier_C power_set(G)) power_set(G), L fn(x G) power_set(G), g G, C1, C2 T:
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $is_power_set_identity(G, F)
        T = fn_range(L)
        $is_left_coset_carrier_map(G, mul, H, L)
        T $subset power_set(G)
        g $in F(C1)
        g $in F(C2)
        =>:
            C1 = C2
    fn_range(L) $subset power_set(G)
    T = fn_range(L)
    T $subset power_set(G)
    C1 $in power_set(G)
    C2 $in power_set(G)
    by thm left_coset_carrier_has_representative(G, mul, H, T, L, C1)
    obtain x from exist x0 G st {C1 = \left_coset<G, mul>(H, x0)}
    by thm left_coset_carrier_has_representative(G, mul, H, T, L, C2)
    obtain y from exist y0 G st {C2 = \left_coset<G, mul>(H, y0)}
    by thm power_set_identity_apply(G, F, C1)
    F(C1) = C1
    by thm power_set_identity_apply(G, F, C2)
    F(C2) = C2
    g $in C1
    g $in C2
    witness exist z G st {z $in \left_coset<G, mul>(H, x), z $in \left_coset<G, mul>(H, y)} from g:
        C1 = \left_coset<G, mul>(H, x)
        C2 = \left_coset<G, mul>(H, y)
        g $in C1
        g $in C2
    by def $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    by thm left_cosets_overlap_implies_equal(G, mul, one, x, y, H)
    \left_coset<G, mul>(H, x) = \left_coset<G, mul>(H, y)
    C1 = C2

thm left_coset_carriers_form_unique_cover:
    ? forall G set, mul fn(x, y G) G, one G, H power_set(G), T finite_set, F fn(carrier_C power_set(G)) power_set(G), L fn(x G) power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $is_finite_set(G)
        $is_power_set_identity(G, F)
        $is_left_coset_carrier_map(G, mul, H, L)
        T = fn_range(L)
        =>:
            $fixed_unique_cover_of(G, power_set(G), G, T, F)
    claim:
        ? forall carrier_C fn_range(L):
            carrier_C $in power_set(G)
        have by preimage x from carrier_C $in fn_range(L)
        carrier_C = L(x) = \left_coset<G, mul>(H, x)
        carrier_C $in power_set(G)
    fn_range(L) $subset power_set(G)
    G $subset G
    T = fn_range(L)
    T $subset power_set(G)
    claim:
        ? forall carrier_C T:
            F(carrier_C) $subset G
        by thm power_set_identity_maps_to_subsets(G, T, F, carrier_C)
    by thm fixed_indexed_subfamily_intro(G, power_set(G), G, T, F)
    claim:
        ? forall g G:
            exist! carrier_C T st {g $in F(carrier_C)}
        L(g) $in fn_range(L)
        T = fn_range(L)
        L(g) $in T
        by thm left_coset_carrier_map_apply(G, mul, H, L, g)
        L(g) = \left_coset<G, mul>(H, g)
        \left_coset<G, mul>(H, g) $in T
        have C0 T = \left_coset<G, mul>(H, g)
        C0 $in T
        C0 = \left_coset<G, mul>(H, g)
        one $in H
        mul(g, one) = g
        witness exist carrier_C T st {g $in F(carrier_C)} from C0:
            C0 = \left_coset<G, mul>(H, g)
            F(C0) = C0
            witness exist h G st {h $in H, g = mul(g, h)} from one:
                one $in H
                g = mul(g, one)
            by def $left_coset_member(G, mul, H, g, g)
            by thm left_coset_member_is_member(G, mul, H, g, g)
            g $in \left_coset<G, mul>(H, g)
            g $in C0
            g $in F(C0)
            claim:
                ? forall C1, C2 T:
                    g $in F(C1)
                    g $in F(C2)
                    =>:
                        C1 = C2
                by thm equal_left_coset_carriers_from_shared_member(G, mul, one, H, T, F, L, g, C1, C2)
    by def $fixed_unique_cover_of(G, power_set(G), G, T, F)

prop subgroup_order_divides_group_order(G set, mul fn(x, y G) G, one G, H power_set(G)):
    $section7::is_group(G, mul, one)
    $section7::is_subgroup(G, mul, one, H)
    $is_finite_set(G)
    $is_finite_set(H)
    $section1::divides_Z(finite_set_size(H), finite_set_size(G))

# Definition.  The order of x is the least positive exponent returning to the
# unit.  The relation is concrete; selecting a generic value for an arbitrary
# carrier is a separate function-family gap in the current Litex surface.
prop has_element_order(G set, mul fn(x, y G) G, one G, x G, n N+):
    $section7::has_group_power(G, mul, one, x, n, one)
    forall k N+:
        $section7::has_group_power(G, mul, one, x, k, one)
        =>:
            n <= k

prop euler_theorem_conclusion(m N+, a Z):
    $section3::relatively_prime_Z(a, m)
    $section5::congruent_mod(m, a ^ section6::euler_phi(m), 1)

# Theorem VIII.2 counts the finite family of distinct left-coset carriers.
thm theorem_VIII_Lagrange:
    ? forall G set, mul fn(x, y G) G, one G, H power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $subgroup_order_divides_group_order(G, mul, one, H)
    have fn L(x G) power_set(G) = \left_coset<G, mul>(H, x)
    claim:
        ? $is_left_coset_carrier_map(G, mul, H, L)
        forall x G:
            L(x) = \left_coset<G, mul>(H, x)
        by def $is_left_coset_carrier_map(G, mul, H, L)
    $is_finite_set(fn_range(L))
    have T finite_set = fn_range(L)
    have fn F(carrier_C power_set(G)) power_set(G) = carrier_C
    claim:
        ? $is_power_set_identity(G, F)
        forall carrier_C power_set(G):
            F(carrier_C) = carrier_C
        by def $is_power_set_identity(G, F)
    by thm left_coset_carriers_form_unique_cover(G, mul, one, H, T, F, L)
    claim:
        ? forall carrier_C T:
            $is_finite_set(F(carrier_C))
            finite_set_size(F(carrier_C)) = finite_set_size(H)
        by thm left_coset_carrier_has_representative(G, mul, H, T, L, carrier_C)
        obtain x from exist x0 G st {carrier_C = \left_coset<G, mul>(H, x0)}
        F(carrier_C) = carrier_C = \left_coset<G, mul>(H, x)
        by thm left_coset_has_subgroup_cardinality(G, mul, one, x, H)
        $is_finite_set(F(carrier_C))
        finite_set_size(F(carrier_C)) = finite_set_size(H)
    by thm finite_set_size_over_fixed_unique_constant_cover(G, power_set(G), T, finite_set_size(H))
    forall S finite_set, F0 fn(carrier_C power_set(G)) power_set(G):
        $fixed_unique_cover_of(G, power_set(G), S, T, F0)
        T $subset power_set(G)
        forall carrier_C T:
            $is_finite_set(F0(carrier_C))
            finite_set_size(F0(carrier_C)) = finite_set_size(H)
        =>:
            finite_set_size(S) = finite_set_size(T) * finite_set_size(H)
    finite_set_size(G) = finite_set_size(T) * finite_set_size(H) = finite_set_size(H) * finite_set_size(T)
    witness exist q Z st {finite_set_size(G) = finite_set_size(H) * q} from finite_set_size(T)
    by def $section1::divides_Z(finite_set_size(H), finite_set_size(G))
    by def $subgroup_order_divides_group_order(G, mul, one, H)

# Corollary to Theorem VIII.2.  The order of an element is the size of its
# finite generated subgroup, so Lagrange makes it divide the group order.
thm theorem_VIII_element_order_divides_group_order:
    ? forall G set, mul fn(x, y G) G, one G, x G, m N+:
        $section7::is_group(G, mul, one)
        $is_finite_set(G)
        $section7::group_element_has_order(G, mul, one, x, m)
        =>:
            $section1::divides_Z(m, finite_set_size(G))
    by def $section7::group_element_has_order(G, mul, one, x, m)
    obtain H from exist H power_set(G) st {$section7::generated_subgroup(G, mul, one, x, H), $is_finite_set(H), finite_set_size(H) = m}
    by def $section7::generated_subgroup(G, mul, one, x, H)
    $section7::generated_subgroup_by(G, mul, one, {x}, H)
    $section7::is_subgroup(G, mul, one, H)
    by thm theorem_VIII_Lagrange(G, mul, one, H)
    by def $subgroup_order_divides_group_order(G, mul, one, H)

thm integer_is_congruent_to_its_remainder_mod:
    ? forall m N+, t Z:
        $section5::congruent_mod(m, t, t % m)
    t = m * section2::integer_quotient(t, m) + t % m
    t - (t % m) = m * section2::integer_quotient(t, m)
    witness exist k Z st {t - (t % m) = m * k} from section2::integer_quotient(t, m)
    by def $section1::divides_Z(m, t - (t % m))
    by def $section5::congruent_mod(m, t, t % m)

thm congruent_representative_of_coprime_is_coprime:
    ? forall m N+, t, u Z:
        $section5::congruent_mod(m, t, u)
        $section3::relatively_prime_Z(t, m)
        =>:
            $section3::relatively_prime_Z(u, m)
    by thm section5::residue_class_eq_of_congruent(m, t, u)
    section5::residue_class_mod(m, t) = section5::residue_class_mod(m, u)
    by def $section6::residue_class_prime_to_mod(m, t)
    by thm section6::residue_class_prime_to_mod_is_representative_independent(m, t, u)
    $section6::residue_class_prime_to_mod(m, u)
    $section3::relatively_prime_Z(u, m)

# Euler's representative map is integer multiplication followed by the
# standard remainder. These source-facing closure theorems supply its checked
# codomain proof before the later finite-product argument.
thm reduced_residue_multiplication_closes:
    ? forall m N+, a, r Z:
        $section3::relatively_prime_Z(a, m)
        $section3::relatively_prime_Z(r, m)
        =>:
            a * r % m $in section6::coprime_remainders_mod(m)
    by thm section6::prime_to_residue_classes_closed_under_multiplication(m, a, r)
    $section3::relatively_prime_Z(a * r, m)
    by thm integer_is_congruent_to_its_remainder_mod(m, a * r)
    $section5::congruent_mod(m, a * r, a * r % m)
    by thm congruent_representative_of_coprime_is_coprime(m, a * r, a * r % m)
    $section3::relatively_prime_Z(a * r % m, m)
    0 <= a * r % m < m
    by def $section6::coprime_remainder_mod(m, a * r % m)
    by thm section6::coprime_remainder_is_member_of_coprime_remainders_mod(m, a * r % m)
    a * r % m $in section6::coprime_remainders_mod(m)

thm multiplication_by_coprime_preserves_coprime_remainders:
    ? forall m N+, a, r Z:
        r $in section6::coprime_remainders_mod(m)
        $section3::relatively_prime_Z(a, m)
        =>:
            a * r % m $in section6::coprime_remainders_mod(m)
    by thm section6::member_of_coprime_remainders_mod_is_coprime_remainder(m, r)
    $section6::coprime_remainder_mod(m, r)
    $section3::relatively_prime_Z(r, m)
    by thm reduced_residue_multiplication_closes(m, a, r)
    a * r % m $in section6::coprime_remainders_mod(m)

thm reduced_residue_multiplication_map_is_bijective:
    ? forall m N+, a Z, S finite_set, perm fn(r S) S:
        S = section6::coprime_remainders_mod(m)
        S $subset Z
        $section3::relatively_prime_Z(a, m)
        forall r S:
            perm(r) = a * r % m
        =>:
            $bijective(S, S, perm)
    claim:
        ? forall r1, r2 S:
            perm(r1) = perm(r2)
            =>:
                r1 = r2
        perm(r1) = a * r1 % m
        perm(r2) = a * r2 % m
        a * r1 % m = a * r2 % m
        by def $section5::same_remainder_mod(m, a * r1, a * r2)
        by thm section5::same_remainder_mod_is_congruent(m, a * r1, a * r2)
        by thm finite_product_toolkit::congruent_mod_cancel_coprime_multiplier(m, a, r1, r2)
        by thm section5::congruent_mod_has_same_remainder(m, r1, r2)
        by thm section6::member_of_coprime_remainders_mod_is_coprime_remainder(m, r1)
        by thm section6::member_of_coprime_remainders_mod_is_coprime_remainder(m, r2)
        claim:
            ? $section2::euclidean_division_Z(r1, m, 0, r1)
            m > 0
            r1 = m * 0 + r1
            0 <= r1 < m
            by def $section2::euclidean_division_Z(r1, m, 0, r1)
        claim:
            ? $section2::euclidean_division_Z(r2, m, 0, r2)
            m > 0
            r2 = m * 0 + r2
            0 <= r2 < m
            by def $section2::euclidean_division_Z(r2, m, 0, r2)
        by thm section2::euclidean_division_remainder_is_mod(r1, m, 0, r1)
        by thm section2::euclidean_division_remainder_is_mod(r2, m, 0, r2)
        r1 = r1 % m = r2 % m = r2
    by def $injective(S, S, perm)
    by thm finite_product_toolkit::finite_self_injective_is_bijective(S, perm)

thm reduced_residue_product_is_coprime:
    ? forall m N+, S finite_set, identity fn(r S) Z:
        S = section6::coprime_remainders_mod(m)
        S $subset Z
        forall r S:
            identity(r) = r
        =>:
            $section3::relatively_prime_Z(finite_set_product(S, identity), m)
    have P Z = finite_set_product(S, identity)
    claim:
        ? $section3::finite_product_of_integer_set(S, P)
        S $subset Z
        by def $fn_eq_in(identity, fn(r S) Z {r}, S)
        finite_set_product(S, identity) = finite_set_product(S, fn(r S) Z {r})
        P = finite_set_product(S, identity) = finite_set_product(S, fn(r S) Z {r})
        by def $section3::finite_product_of_integer_set(S, P)
    claim:
        ? forall r S:
            $section3::relatively_prime_Z(m, r)
        by thm section6::member_of_coprime_remainders_mod_is_coprime_remainder(m, r)
        by thm section6::relatively_prime_Z_symmetric(r, m)
    by thm section3::theorem_III_2_corollary_2(m, S, P)
    by thm section6::relatively_prime_Z_symmetric(m, P)

thm theorem_VIII_Euler:
    ? forall m N+, a Z:
        $section3::relatively_prime_Z(a, m)
        =>:
            $euler_theorem_conclusion(m, a)
    by thm section6::coprime_remainders_mod_is_finite(m)
    have S finite_set = section6::coprime_remainders_mod(m)
    claim:
        ? forall r S:
            r $in Z
        by thm section6::member_of_coprime_remainders_mod_is_coprime_remainder(m, r)
    by def S $subset Z
    claim:
        ? forall r S:
            a * r % m $in S
        by thm multiplication_by_coprime_preserves_coprime_remainders(m, a, r)
        S = section6::coprime_remainders_mod(m)
    have fn perm(r S) S = a * r % m
    claim:
        ? forall r S:
            perm(r) = a * r % m
        perm(r) = a * r % m
    by thm reduced_residue_multiplication_map_is_bijective(m, a, S, perm)
    $bijective(S, S, perm)

    have fn identity(r S) Z = r
    have fn mapped(r S) Z = identity(perm(r))
    by thm finite_product_toolkit::finite_set_product_bijective_reindex(S, S, perm, identity)
    finite_set_product(S, mapped) = finite_set_product(S, fn(r S) Z {identity(perm(r))}) = finite_set_product(S, identity)

    have fn scaled(r S) Z = a * r
    claim:
        ? forall r S:
            $section5::congruent_mod(m, scaled(r), mapped(r))
        scaled(r) = a * r
        mapped(r) = identity(perm(r)) = perm(r) = a * r % m
        by thm integer_is_congruent_to_its_remainder_mod(m, a * r)
    by thm finite_product_toolkit::finite_product_congruence(m, S)
    by def $finite_product_toolkit::finite_product_congruence_holds(m, S)
    $section5::congruent_mod(m, finite_set_product(S, scaled), finite_set_product(S, mapped))

    have fn constant(r S) Z = a
    by thm finite_product_toolkit::finite_product_distributes_over_pointwise_product(S, constant, identity)
    claim:
        ? forall r S:
            scaled(r) = constant(r) * identity(r)
        scaled(r) = a * r
        constant(r) * identity(r) = a * r
    by def $fn_eq_in(scaled, fn(r S) Z {constant(r) * identity(r)}, S)
    finite_set_product(S, scaled) = finite_set_product(S, fn(r S) Z {constant(r) * identity(r)})
    finite_set_product(S, scaled) = finite_set_product(S, fn(r S) Z {constant(r) * identity(r)}) = finite_set_product(S, constant) * finite_set_product(S, identity)
    by thm finite_product_toolkit::finite_set_product_constant_formula(S, a)
    claim:
        ? forall r S:
            constant(r) = a
        constant(r) = a
    by def $fn_eq_in(constant, fn(r S) Z {a}, S)
    finite_set_product(S, constant) = finite_set_product(S, fn(r S) Z {a}) = a ^ finite_set_size(S)
    $section6::euler_phi_spec(m, section6::euler_phi(m))
    finite_set_size(S) = finite_set_size(section6::coprime_remainders_mod(m)) = section6::euler_phi(m)
    finite_set_product(S, scaled) = finite_set_product(S, constant) * finite_set_product(S, identity) = a ^ finite_set_size(S) * finite_set_product(S, identity) = a ^ section6::euler_phi(m) * finite_set_product(S, identity)

    have P Z = finite_set_product(S, identity)
    claim:
        ? forall r S:
            identity(r) = r
        identity(r) = r
    by thm reduced_residue_product_is_coprime(m, S, identity)
    $section3::relatively_prime_Z(P, m)

    by thm finite_product_toolkit::congruent_mod_transport_equalities(m, a ^ section6::euler_phi(m) * P, P, finite_set_product(S, scaled), finite_set_product(S, mapped))
    a ^ section6::euler_phi(m) * P = P * a ^ section6::euler_phi(m)
    P = P * 1
    by thm finite_product_toolkit::congruent_mod_transport_equalities(m, P * a ^ section6::euler_phi(m), P * 1, a ^ section6::euler_phi(m) * P, P)
    by thm finite_product_toolkit::congruent_mod_cancel_coprime_multiplier(m, P, a ^ section6::euler_phi(m), 1)
    by def $euler_theorem_conclusion(m, a)

# Fermat's little theorem is the prime-modulus corollary of Euler's theorem.
# The divisible case is kept explicit so the statement applies to every
# integer a, not only to units modulo p.
prop fermat_little_theorem_conclusion(p N+, a Z):
    $section5::congruent_mod(p, a ^ p, a)

thm theorem_VIII_Fermat:
    ? forall p N+, a Z:
        $section4::is_prime_Z(p)
        =>:
            $fermat_little_theorem_conclusion(p, a)
    by thm section4::prime_divides_or_is_relatively_prime(p, a)
    by cases:
        ? $fermat_little_theorem_conclusion(p, a)
        case $section1::divides_Z(p, a):
            obtain k from exist k Z st {a = p * k}
            p = (p - 1) + 1
            a ^ ((p - 1) + 1) = a ^ (p - 1) * a
            a ^ p = a ^ ((p - 1) + 1) = a ^ (p - 1) * a
            a ^ p - a = a ^ (p - 1) * a - a
            a ^ (p - 1) * a - a = a * (a ^ (p - 1) - 1)
            a * (a ^ (p - 1) - 1) = (p * k) * (a ^ (p - 1) - 1)
            (p * k) * (a ^ (p - 1) - 1) = p * (k * (a ^ (p - 1) - 1))
            witness exist t Z st {a ^ p - a = p * t} from k * (a ^ (p - 1) - 1)
            by def $section1::divides_Z(p, a ^ p - a)
            by def $section5::congruent_mod(p, a ^ p, a)
            by def $fermat_little_theorem_conclusion(p, a)
        case $section3::relatively_prime_Z(p, a):
            by thm section6::relatively_prime_Z_symmetric(p, a)
            by thm theorem_VIII_Euler(p, a)
            by def $euler_theorem_conclusion(p, a)
            by thm section6::euler_phi_prime_value(p)
            by thm section5::congruent_mod_reflexive(p, a)
            by thm section5::congruent_mod_multiply(p, a ^ section6::euler_phi(p), 1, a, a)
            section6::euler_phi(p) + 1 = (p - 1) + 1 = p
            a ^ section6::euler_phi(p) * a = a ^ (section6::euler_phi(p) + 1) = a ^ p
            1 * a = a
            by thm finite_product_toolkit::congruent_mod_transport_equalities(p, a ^ p, a, a ^ section6::euler_phi(p) * a, 1 * a)
            by def $fermat_little_theorem_conclusion(p, a)
