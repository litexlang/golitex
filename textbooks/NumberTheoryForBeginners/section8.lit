# Section VIII: cyclic subgroups, cosets, Lagrange's theorem, and Euler's theorem.

# Definition VIII.1. A left coset xH is the image of H under left
# multiplication by x.  It is a genuine set-valued function because later
# arguments compare its carrier, take its cardinality, and range over its
# members; a predicate alone would not support those uses.
prop left_coset_member(G set, mul fn(x, y G) G, H power_set(G), x, y G):
    exist h G st {h $in H, y = mul(x, h)}

template<G set, mul fn(x, y G) G>:
    have fn left_coset(H power_set(G), x G) power_set(G) = {y G: $left_coset_member(G, mul, H, x, y)}

# A named coset carrier has exactly the membership condition in the source
# definition.  This relation keeps the representative explicit for the
# equal-or-disjoint lemma below.
prop is_left_coset(G set, mul fn(x, y G) G, H power_set(G), x G, C power_set(G)):
    C = \left_coset<G, mul>(H, x)

# Two cosets are compared through their carriers.  Naming their overlap makes
# the source's equal-or-disjoint dichotomy a direct propositional case split.
prop cosets_overlap(G set, C1, C2 power_set(G)):
    exist z G st {z $in C1, z $in C2}

prop cosets_equal(G set, C1, C2 power_set(G)):
    C1 = C2

prop cosets_disjoint(G set, C1, C2 power_set(G)):
    not $cosets_overlap(G, C1, C2)

# Every element lies in its own coset, and the source lemma says that two such
# carriers are either equal or disjoint.  The finite partition/counting step is
# kept as a named theorem interface below.
prop coset_partition_claim(G set, mul fn(x, y G) G, H power_set(G)):
    forall x G:
        exist C power_set(G) st {$is_left_coset(G, mul, H, x, C), x $in C}

# Lemma VIII.1. Left multiplication is injective, so a finite subgroup and
# each of its left cosets have the same cardinality.  The proof maps h to xh,
# cancels x using its inverse, and identifies the map's range with xH.
thm left_coset_has_subgroup_cardinality:
    ? forall G set, mul fn(x, y G) G, one, x G, H power_set(G):
        $section7::is_group(G, mul, one)
        $is_finite_set(H)
        =>:
            $is_finite_set(\left_coset<G, mul>(H, x))
            finite_set_size(\left_coset<G, mul>(H, x)) = finite_set_size(H)
    have f fn(h H) G = fn(h H) G {mul(x, h)}
    obtain x_inv from exist z G st {mul(x, z) = one, mul(z, x) = one}
    forall h1, h2 H:
        f(h1) = f(h2)
        =>:
            f(h1) = mul(x, h1)
            f(h2) = mul(x, h2)
            mul(x_inv, mul(x, h1)) = mul(x_inv, mul(x, h2))
            mul(x_inv, mul(x, h1)) = mul(mul(x_inv, x), h1) = mul(one, h1) = h1
            mul(x_inv, mul(x, h2)) = mul(mul(x_inv, x), h2) = mul(one, h2) = h2
            h1 = h2
    $injective(H, G, f)
    $is_finite_set(fn_range(f))
    finite_set_size(fn_range(f)) = finite_set_size(H)
    by extension fn_range(f) = \left_coset<G, mul>(H, x):
        claim:
            ? forall y fn_range(f):
                y $in \left_coset<G, mul>(H, x)
            have by preimage h from y $in fn_range(f)
            f(h) = mul(x, h)
            y = f(h) = mul(x, h)
            witness exist h0 G st {h0 $in H, y = mul(x, h0)} from h:
                h $in H
                y = mul(x, h)
            by def $left_coset_member(G, mul, H, x, y)
            y $in \left_coset<G, mul>(H, x)
        claim:
            ? forall y \left_coset<G, mul>(H, x):
                y $in fn_range(f)
            $left_coset_member(G, mul, H, x, y)
            obtain h from exist h G st {h $in H, y = mul(x, h)}
            have h_in_H H = h
            f(h_in_H) = mul(x, h_in_H) = mul(x, h) = y
            f(h_in_H) $in fn_range(f)
            y $in fn_range(f)
    fn_range(f) = \left_coset<G, mul>(H, x)
    $is_finite_set(\left_coset<G, mul>(H, x))
    finite_set_size(\left_coset<G, mul>(H, x)) = finite_set_size(H)

# Lemma VIII.1. If two left cosets meet, their common element writes as both
# xh and yk.  Multiplying an arbitrary xu by h^-1 transfers it to yH; the
# symmetric argument transfers yv to xH.
thm left_cosets_overlap_implies_equal:
    ? forall G set, mul fn(x, y G) G, one, x, y G, H power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
        =>:
            $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    obtain z from exist z0 G st {z0 $in \left_coset<G, mul>(H, x), z0 $in \left_coset<G, mul>(H, y)}
    $left_coset_member(G, mul, H, x, z)
    obtain h from exist h0 G st {h0 $in H, z = mul(x, h0)}
    $left_coset_member(G, mul, H, y, z)
    obtain k from exist k0 G st {k0 $in H, z = mul(y, k0)}
    by extension \left_coset<G, mul>(H, x) = \left_coset<G, mul>(H, y):
        claim:
            ? forall w \left_coset<G, mul>(H, x):
                w $in \left_coset<G, mul>(H, y)
            $left_coset_member(G, mul, H, x, w)
            obtain u from exist u0 G st {u0 $in H, w = mul(x, u0)}
            obtain inv_h from exist inv0 G st {mul(h, inv0) = one, inv0 $in H}
            mul(one, u) = u
            mul(k, inv_h) $in H
            mul(mul(k, inv_h), u) $in H
            mul(k, mul(inv_h, u)) = mul(mul(k, inv_h), u)
            mul(k, mul(inv_h, u)) $in H
            mul(mul(h, inv_h), u) = mul(h, mul(inv_h, u))
            mul(mul(x, h), mul(inv_h, u)) = mul(x, mul(h, mul(inv_h, u)))
            mul(x, h) = z = mul(y, k)
            mul(mul(y, k), mul(inv_h, u)) = mul(y, mul(k, mul(inv_h, u)))
            w = mul(x, u) = mul(x, mul(one, u)) = mul(x, mul(mul(h, inv_h), u)) = mul(x, mul(h, mul(inv_h, u))) = mul(mul(x, h), mul(inv_h, u)) = mul(mul(y, k), mul(inv_h, u)) = mul(y, mul(k, mul(inv_h, u)))
            witness exist q G st {q $in H, w = mul(y, q)} from mul(k, mul(inv_h, u)):
                mul(k, mul(inv_h, u)) $in H
                w = mul(y, mul(k, mul(inv_h, u)))
            by def $left_coset_member(G, mul, H, y, w)
            w $in \left_coset<G, mul>(H, y)
        claim:
            ? forall w \left_coset<G, mul>(H, y):
                w $in \left_coset<G, mul>(H, x)
            $left_coset_member(G, mul, H, y, w)
            obtain v from exist v0 G st {v0 $in H, w = mul(y, v0)}
            obtain inv_k from exist inv0 G st {mul(k, inv0) = one, inv0 $in H}
            mul(one, v) = v
            mul(h, inv_k) $in H
            mul(mul(h, inv_k), v) $in H
            mul(h, mul(inv_k, v)) = mul(mul(h, inv_k), v)
            mul(h, mul(inv_k, v)) $in H
            mul(mul(k, inv_k), v) = mul(k, mul(inv_k, v))
            mul(mul(y, k), mul(inv_k, v)) = mul(y, mul(k, mul(inv_k, v)))
            mul(y, k) = z = mul(x, h)
            mul(mul(x, h), mul(inv_k, v)) = mul(x, mul(h, mul(inv_k, v)))
            w = mul(y, v) = mul(y, mul(one, v)) = mul(y, mul(mul(k, inv_k), v)) = mul(y, mul(k, mul(inv_k, v))) = mul(mul(y, k), mul(inv_k, v)) = mul(mul(x, h), mul(inv_k, v)) = mul(x, mul(h, mul(inv_k, v)))
            witness exist q G st {q $in H, w = mul(x, q)} from mul(h, mul(inv_k, v)):
                mul(h, mul(inv_k, v)) $in H
                w = mul(x, mul(h, mul(inv_k, v)))
            by def $left_coset_member(G, mul, H, x, w)
            w $in \left_coset<G, mul>(H, x)
    by def $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))

# The remaining finite partition lemma follows immediately from the preceding
# overlap lemma once Litex has a reusable constant-fibre finite-cover count.
thm left_cosets_equal_or_disjoint:
    ? forall G set, mul fn(x, y G) G, one, x, y G, H power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        =>:
            $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)) or $cosets_disjoint(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)) or not $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
    by cases:
        ? $cosets_equal(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)) or $cosets_disjoint(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))
        case $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)):
            by thm left_cosets_overlap_implies_equal(G, mul, one, x, y, H)
        case not $cosets_overlap(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y)):
            by def $cosets_disjoint(G, \left_coset<G, mul>(H, x), \left_coset<G, mul>(H, y))

# A finite cover keeps its index domain fixed while its finite active index set
# varies.  This avoids changing a family function's type in the deletion step
# of the finite-set induction below.
prop fixed_indexed_subfamily(U, D set, S, T finite_set, F fn(K D) power_set(U)):
    S $subset U
    T $subset D
    forall K T:
        F(K) $subset S

prop fixed_unique_cover_of(U, D set, S, T finite_set, F fn(K D) power_set(U)):
    $fixed_indexed_subfamily(U, D, S, T, F)
    forall x S:
        exist! K T st {x $in F(K)}

thm fixed_indexed_subfamily_intro:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U):
        S $subset U
        T $subset D
        forall K T:
            F(K) $subset S
        =>:
            $fixed_indexed_subfamily(U, D, S, T, F)
    S $subset U
    T $subset D
    forall K T:
        F(K) $subset S
    by def $fixed_indexed_subfamily(U, D, S, T, F)

thm fixed_unique_cover_distinct_fibers_are_disjoint:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U), K1, K2 T:
        $fixed_unique_cover_of(U, D, S, T, F)
        K1 != K2
        =>:
            intersect(F(K1), F(K2)) = {}
    forall x S:
        exist! K0 T st {x $in F(K0)}
    by extension intersect(F(K1), F(K2)) = {}:
        claim:
            ? forall x intersect(F(K1), F(K2)):
                x $in {}
            by contra:
                ? x $in {}
                not x $in {}
                x $in F(K1)
                x $in F(K2)
                F(K1) $subset S
                x $in S
                exist! K0 T st {x $in F(K0)}
                obtain K0 from exist! K0 T st {x $in F(K0)}
                K0 = K1
                K0 = K2
                K1 = K2
                impossible K1 != K2
        claim:
            ? forall x {}:
                x $in intersect(F(K1), F(K2))
            by contra:
                ? x $in intersect(F(K1), F(K2))
                x $in {}
                impossible x $in {}

thm fixed_unique_cover_remove_inserted_index:
    ? forall U, D set, A, I finite_set, K D, F fn(L D) power_set(U):
        not K $in I
        $fixed_unique_cover_of(U, D, A, union({K}, I), F)
        =>:
            $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)
    claim:
        ? $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
        set_minus(A, F(K)) $subset A
        A $subset U
        set_minus(A, F(K)) $subset U
        I $subset union({K}, I)
        union({K}, I) $subset D
        I $subset D
        claim:
            ? forall L I:
                F(L) $subset set_minus(A, F(K))
            L $in union({K}, I)
            F(L) $subset A
            L != K
            by thm fixed_unique_cover_distinct_fibers_are_disjoint(U, D, A, union({K}, I), F, L, K)
            intersect(F(L), F(K)) = {}
            claim:
                ? forall x F(L):
                    x $in set_minus(A, F(K))
                x $in A
                claim:
                    ? not x $in F(K)
                    by contra:
                        ? not x $in F(K)
                        x $in F(K)
                        x $in intersect(F(L), F(K))
                        x $in {}
                        impossible not x $in {}
                x $in set_minus(A, F(K))
            F(L) $subset set_minus(A, F(K))
    by def $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
    claim:
        ? forall x set_minus(A, F(K)):
            exist! L I st {x $in F(L)}
        x $in A
        not x $in F(K)
        exist! L0 union({K}, I) st {x $in F(L0)}
        obtain L0 from exist! L0 union({K}, I) st {x $in F(L0)}
        claim:
            ? L0 $in I
            L0 $in {K} or L0 $in I
            by cases:
                ? L0 $in I
                case L0 $in {K}:
                    L0 = K
                    x $in F(L0) = F(K)
                    impossible not x $in F(K)
                case L0 $in I:
                    L0 $in I
        witness exist L I st {x $in F(L)} from L0:
            x $in F(L0)
            forall L1, L2 I:
                x $in F(L1)
                x $in F(L2)
                =>:
                    L1 $in union({K}, I)
                    L2 $in union({K}, I)
                    exist! L3 union({K}, I) st {x $in F(L3)}
                    L1 = L2
    by def $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)

thm finite_set_size_disjoint_union_fixed_cover:
    ? forall A, B finite_set:
        intersect(A, B) = {}
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    finite_set_sum(union(A, B), fn(x union(A, B)) N {1}) = finite_set_sum(A, fn(x A) N {1}) + finite_set_sum(B, fn(x B) N {1})
    finite_set_sum(union(A, B), fn(x union(A, B)) N {1}) = finite_set_size(union(A, B)) * 1 = finite_set_size(union(A, B))
    finite_set_sum(A, fn(x A) N {1}) = finite_set_size(A) * 1 = finite_set_size(A)
    finite_set_sum(B, fn(x B) N {1}) = finite_set_size(B) * 1 = finite_set_size(B)
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)

prop fixed_unique_cover_size_sum_holds(U, D set, T finite_set):
    forall S finite_set, F fn(K D) power_set(U):
        $fixed_unique_cover_of(U, D, S, T, F)
        forall K T:
            $is_finite_set(F(K))
        =>:
            finite_set_size(S) = finite_set_sum(T, fn(K T) N {finite_set_size(F(K))})

thm fixed_unique_cover_size_sum_insert_step:
    ? forall U, D set, K D, I, A finite_set, F fn(L D) power_set(U):
        not K $in I
        $fixed_unique_cover_size_sum_holds(U, D, I)
        $fixed_unique_cover_of(U, D, A, union({K}, I), F)
        forall L union({K}, I):
            $is_finite_set(F(L))
        =>:
            finite_set_size(A) = finite_set_sum(union({K}, I), fn(L union({K}, I)) N {finite_set_size(F(L))})
    have A0 finite_set = set_minus(A, F(K))
    by thm fixed_unique_cover_remove_inserted_index(U, D, A, I, K, F)
    $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)
    claim:
        ? forall L I:
            $is_finite_set(F(L))
        L $in union({K}, I)
        $is_finite_set(F(L))
    by def $fixed_unique_cover_size_sum_holds(U, D, I)
    finite_set_size(set_minus(A, F(K))) = finite_set_sum(I, fn(L I) N {finite_set_size(F(L))})
    A0 = set_minus(A, F(K))
    finite_set_size(A0) = finite_set_sum(I, fn(L I) N {finite_set_size(F(L))})
    K $in union({K}, I)
    $is_finite_set(F(K))
    claim:
        ? A = union(F(K), A0)
        by extension A = union(F(K), A0):
            claim:
                ? forall x A:
                    x $in union(F(K), A0)
                x $in F(K) or not x $in F(K)
                by cases:
                    ? x $in union(F(K), A0)
                    case x $in F(K):
                        x $in union(F(K), A0)
                    case not x $in F(K):
                        x $in set_minus(A, F(K))
                        x $in A0
                        x $in union(F(K), A0)
            claim:
                ? forall x union(F(K), A0):
                    x $in A
                x $in F(K) or x $in A0
                by cases:
                    ? x $in A
                    case x $in F(K):
                        F(K) $subset A
                        x $in A
                    case x $in A0:
                        A0 $subset A
                        x $in A
    claim:
        ? intersect(F(K), A0) = {}
        by extension intersect(F(K), A0) = {}:
            claim:
                ? forall x intersect(F(K), A0):
                    x $in {}
                x $in F(K)
                x $in A0
                x $in set_minus(A, F(K))
                not x $in F(K)
                by contra:
                    ? x $in {}
                    impossible not x $in F(K)
            claim:
                ? forall x {}:
                    x $in intersect(F(K), A0)
                by contra:
                    ? x $in intersect(F(K), A0)
                    x $in {}
                    impossible x $in {}
    by thm finite_set_size_disjoint_union_fixed_cover(F(K), A0)
    finite_set_size(union(F(K), A0)) = finite_set_size(F(K)) + finite_set_size(A0)
    A = union(F(K), A0)
    finite_set_size(A) = finite_set_size(F(K)) + finite_set_size(A0)
    finite_set_size(F(K)) + finite_set_size(A0) = finite_set_size(F(K)) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))})
    finite_set_size(A) = finite_set_size(F(K)) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))})
    claim:
        ? intersect({K}, I) = {}
        by extension intersect({K}, I) = {}:
            claim:
                ? forall L intersect({K}, I):
                    L $in {}
                L $in {K}
                L = K
                L $in I
                K $in I
                by contra:
                    ? L $in {}
                    impossible K $in I
            claim:
                ? forall L {}:
                    L $in intersect({K}, I)
                by contra:
                    ? L $in intersect({K}, I)
                    L $in {}
                    impossible L $in {}
    finite_set_sum(union({K}, I), fn(L union({K}, I)) N {finite_set_size(F(L))}) = finite_set_sum({K}, fn(L {K}) N {finite_set_size(F(L))}) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))})
    finite_set_sum({K}, fn(L {K}) N {finite_set_size(F(L))}) = finite_set_size(F(K))
    finite_set_size(F(K)) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))}) = finite_set_sum({K}, fn(L {K}) N {finite_set_size(F(L))}) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))})
    finite_set_sum({K}, fn(L {K}) N {finite_set_size(F(L))}) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))}) = finite_set_sum(union({K}, I), fn(L union({K}, I)) N {finite_set_size(F(L))})
    finite_set_size(F(K)) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))}) = finite_set_sum(union({K}, I), fn(L union({K}, I)) N {finite_set_size(F(L))})
    finite_set_size(A) = finite_set_size(F(K)) + finite_set_sum(I, fn(L I) N {finite_set_size(F(L))}) = finite_set_sum(union({K}, I), fn(L union({K}, I)) N {finite_set_size(F(L))})

thm finite_set_size_over_fixed_unique_cover:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U):
        $fixed_unique_cover_of(U, D, S, T, F)
        forall K T:
            $is_finite_set(F(K))
        =>:
            finite_set_size(S) = finite_set_sum(T, fn(K T) N {finite_set_size(F(K))})
    by induc P:
        ? $fixed_unique_cover_size_sum_holds(U, D, P)
        ? from P = {}:
            claim:
                ? forall A finite_set, G fn(K D) power_set(U):
                    $fixed_unique_cover_of(U, D, A, {}, G)
                    forall K {}:
                        $is_finite_set(G(K))
                    =>:
                        finite_set_size(A) = finite_set_sum({}, fn(K {}) N {finite_set_size(G(K))})
                claim:
                    ? A = {}
                    by extension A = {}:
                        claim:
                            ? forall x A:
                                x $in {}
                            by contra:
                                ? x $in {}
                                exist! K {} st {x $in G(K)}
                                obtain K from exist! K {} st {x $in G(K)}
                                K $in {}
                                impossible K $in {}
                        claim:
                            ? forall x {}:
                                x $in A
                            by contra:
                                ? x $in A
                                x $in {}
                                impossible x $in {}
                A = {}
                finite_set_size(A) = finite_set_size({}) = 0
                finite_set_sum({}, fn(K {}) N {finite_set_size(G(K))}) = 0
                finite_set_size(A) = 0 = finite_set_sum({}, fn(K {}) N {finite_set_size(G(K))})
            by def $fixed_unique_cover_size_sum_holds(U, D, {})
        ? induc K, I:
            $fixed_unique_cover_size_sum_holds(U, D, I)
            claim:
                ? forall A finite_set, G fn(L D) power_set(U):
                    $fixed_unique_cover_of(U, D, A, union({K}, I), G)
                    forall L union({K}, I):
                        $is_finite_set(G(L))
                    =>:
                        finite_set_size(A) = finite_set_sum(union({K}, I), fn(L union({K}, I)) N {finite_set_size(G(L))})
                K $in union({K}, I)
                union({K}, I) $subset D
                K $in D
                by thm fixed_unique_cover_size_sum_insert_step(U, D, K, I, A, G)
            by def $fixed_unique_cover_size_sum_holds(U, D, union({K}, I))
    $fixed_unique_cover_size_sum_holds(U, D, T)
    finite_set_size(S) = finite_set_sum(T, fn(K T) N {finite_set_size(F(K))})

# The active indices are exactly the distinct left-coset carriers.  The family
# itself is the identity on the fixed ambient domain power_set(G).
prop is_power_set_identity(G set, F fn(C power_set(G)) power_set(G)):
    forall C power_set(G):
        F(C) = C

thm power_set_identity_apply:
    ? forall G set, F fn(C power_set(G)) power_set(G), C power_set(G):
        $is_power_set_identity(G, F)
        =>:
            F(C) = C
    $is_power_set_identity(G, F)
    F(C) = C

thm power_set_identity_maps_to_subsets:
    ? forall G set, T finite_set, F fn(C power_set(G)) power_set(G), C T:
        $is_power_set_identity(G, F)
        T $subset power_set(G)
        =>:
            F(C) $subset G
    C $in power_set(G)
    by thm power_set_identity_apply(G, F, C)
    F(C) = C
    C $subset G
    F(C) $subset G

prop is_left_coset_carrier_map(G set, mul fn(x, y G) G, H power_set(G), L fn(x G) power_set(G)):
    forall x G:
        L(x) = \left_coset<G, mul>(H, x)

thm left_coset_carrier_map_apply:
    ? forall G set, mul fn(x, y G) G, H power_set(G), L fn(x G) power_set(G), x G:
        $is_left_coset_carrier_map(G, mul, H, L)
        =>:
            L(x) = \left_coset<G, mul>(H, x)
    $is_left_coset_carrier_map(G, mul, H, L)
    L(x) = \left_coset<G, mul>(H, x)

thm left_coset_carrier_has_representative:
    ? forall G set, mul fn(x, y G) G, H power_set(G), T finite_set, L fn(x G) power_set(G), C power_set(G):
        T = fn_range(L)
        C $in T
        $is_left_coset_carrier_map(G, mul, H, L)
        =>:
            exist x G st {C = \left_coset<G, mul>(H, x)}
    T = fn_range(L)
    C $in fn_range(L)
    have by preimage x from C $in fn_range(L)
    by thm left_coset_carrier_map_apply(G, mul, H, L, x)
    L(x) = \left_coset<G, mul>(H, x)
    witness exist x0 G st {C = \left_coset<G, mul>(H, x0)} from x:
        C = L(x) = \left_coset<G, mul>(H, x)

thm equal_left_coset_carriers_from_shared_member:
    ? forall G set, mul fn(x, y G) G, one G, H power_set(G), T finite_set, F fn(C power_set(G)) power_set(G), L fn(x G) power_set(G), g G, C1, C2 T:
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $is_power_set_identity(G, F)
        T = fn_range(L)
        $is_left_coset_carrier_map(G, mul, H, L)
        T $subset power_set(G)
        g $in F(C1)
        g $in F(C2)
        =>:
            C1 = C2
    fn_range(L) $subset power_set(G)
    T = fn_range(L)
    T $subset power_set(G)
    C1 $in power_set(G)
    C2 $in power_set(G)
    by thm left_coset_carrier_has_representative(G, mul, H, T, L, C1)
    obtain x from exist x0 G st {C1 = \left_coset<G, mul>(H, x0)}
    by thm left_coset_carrier_has_representative(G, mul, H, T, L, C2)
    obtain y from exist y0 G st {C2 = \left_coset<G, mul>(H, y0)}
    by thm power_set_identity_apply(G, F, C1)
    F(C1) = C1
    by thm power_set_identity_apply(G, F, C2)
    F(C2) = C2
    g $in C1
    g $in C2
    witness exist z G st {z $in \left_coset<G, mul>(H, x), z $in \left_coset<G, mul>(H, y)} from g:
        C1 = \left_coset<G, mul>(H, x)
        C2 = \left_coset<G, mul>(H, y)
        g $in C1
        g $in C2
    by thm left_cosets_overlap_implies_equal(G, mul, one, x, y, H)
    \left_coset<G, mul>(H, x) = \left_coset<G, mul>(H, y)
    C1 = C2

thm left_coset_carriers_form_unique_cover:
    ? forall G set, mul fn(x, y G) G, one G, H power_set(G), T finite_set, F fn(C power_set(G)) power_set(G), L fn(x G) power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $is_finite_set(G)
        $is_power_set_identity(G, F)
        $is_left_coset_carrier_map(G, mul, H, L)
        T = fn_range(L)
        =>:
            $fixed_unique_cover_of(G, power_set(G), G, T, F)
    claim:
        ? forall C fn_range(L):
            C $in power_set(G)
        have by preimage x from C $in fn_range(L)
        C = L(x) = \left_coset<G, mul>(H, x)
        C $in power_set(G)
    fn_range(L) $subset power_set(G)
    G $subset G
    T = fn_range(L)
    T $subset power_set(G)
    claim:
        ? forall C T:
            F(C) $subset G
        by thm power_set_identity_maps_to_subsets(G, T, F, C)
    by thm fixed_indexed_subfamily_intro(G, power_set(G), G, T, F)
    claim:
        ? forall g G:
            exist! C T st {g $in F(C)}
        L(g) $in fn_range(L)
        T = fn_range(L)
        L(g) $in T
        by thm left_coset_carrier_map_apply(G, mul, H, L, g)
        L(g) = \left_coset<G, mul>(H, g)
        \left_coset<G, mul>(H, g) $in T
        have C0 T = \left_coset<G, mul>(H, g)
        C0 $in T
        C0 = \left_coset<G, mul>(H, g)
        one $in H
        mul(g, one) = g
        witness exist C T st {g $in F(C)} from C0:
            C0 = \left_coset<G, mul>(H, g)
            F(C0) = C0
            witness exist h G st {h $in H, g = mul(g, h)} from one:
                one $in H
                g = mul(g, one)
            by def $left_coset_member(G, mul, H, g, g)
            g $in \left_coset<G, mul>(H, g)
            g $in C0
            g $in F(C0)
            claim:
                ? forall C1, C2 T:
                    g $in F(C1)
                    g $in F(C2)
                    =>:
                        C1 = C2
                by thm equal_left_coset_carriers_from_shared_member(G, mul, one, H, T, F, L, g, C1, C2)
    claim:
        ? $fixed_unique_cover_of(G, power_set(G), G, T, F)
        $fixed_indexed_subfamily(G, power_set(G), G, T, F)
        forall g G:
            exist! C T st {g $in F(C)}
    by def $fixed_unique_cover_of(G, power_set(G), G, T, F)

prop subgroup_order_divides_group_order(G set, mul fn(x, y G) G, one G, H power_set(G)):
    $section7::is_group(G, mul, one)
    $section7::is_subgroup(G, mul, one, H)
    $is_finite_set(G)
    $is_finite_set(H)
    $section1::divides_Z(finite_set_size(H), finite_set_size(G))

# Definition.  The order of x is the least positive exponent returning to the
# unit.  The relation is concrete; selecting a generic value for an arbitrary
# carrier is a separate function-family gap in the current Litex surface.
prop has_element_order(G set, mul fn(x, y G) G, one G, x G, n N_pos):
    $section7::has_group_power(G, mul, one, x, n, one)
    forall k N_pos:
        $section7::has_group_power(G, mul, one, x, k, one)
        =>:
            n <= k

prop euler_theorem_conclusion(m N_pos, a Z):
    $section3::relatively_prime_Z(a, m)
    $section5::congruent_mod(m, a ^ section6::euler_phi(m), 1)

# Theorem VIII.2 instantiates the checked finite coset partition/counting
# package. Euler's corollary below still awaits its separate unit-group order
# argument.
thm theorem_VIII_Lagrange:
    ? forall G set, mul fn(x, y G) G, one G, H power_set(G):
        $section7::is_group(G, mul, one)
        $section7::is_subgroup(G, mul, one, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $subgroup_order_divides_group_order(G, mul, one, H)
    have fn F(C power_set(G)) power_set(G) = C
    have fn L(x G) power_set(G) = \left_coset<G, mul>(H, x)
    claim:
        ? $is_power_set_identity(G, F)
        forall C power_set(G):
            F(C) = C
        by def $is_power_set_identity(G, F)
    claim:
        ? $is_left_coset_carrier_map(G, mul, H, L)
        forall x G:
            L(x) = \left_coset<G, mul>(H, x)
        by def $is_left_coset_carrier_map(G, mul, H, L)
    $is_finite_set(fn_range(L))
    have T finite_set = fn_range(L)
    by thm left_coset_carriers_form_unique_cover(G, mul, one, H, T, F, L)
    $fixed_unique_cover_of(G, power_set(G), G, T, F)
    fn_range(L) $subset power_set(G)
    T = fn_range(L)
    T $subset power_set(G)
    claim:
        ? forall C T:
            $is_finite_set(F(C))
        by thm left_coset_carrier_has_representative(G, mul, H, T, L, C)
        obtain x from exist x0 G st {C = \left_coset<G, mul>(H, x0)}
        by thm power_set_identity_apply(G, F, C)
        F(C) = C = \left_coset<G, mul>(H, x)
        by thm left_coset_has_subgroup_cardinality(G, mul, one, x, H)
        $is_finite_set(\left_coset<G, mul>(H, x))
        $is_finite_set(F(C))
    by thm finite_set_size_over_fixed_unique_cover(G, power_set(G), G, T, F)
    finite_set_size(G) = finite_set_sum(T, fn(C T) N {finite_set_size(F(C))})
    claim:
        ? forall C T:
            finite_set_size(F(C)) = finite_set_size(H)
        by thm left_coset_carrier_has_representative(G, mul, H, T, L, C)
        obtain x from exist x0 G st {C = \left_coset<G, mul>(H, x0)}
        by thm power_set_identity_apply(G, F, C)
        F(C) = C = \left_coset<G, mul>(H, x)
        by thm left_coset_has_subgroup_cardinality(G, mul, one, x, H)
        finite_set_size(\left_coset<G, mul>(H, x)) = finite_set_size(H)
        finite_set_size(F(C)) = finite_set_size(H)
    finite_set_sum(T, fn(C T) N {finite_set_size(F(C))}) = finite_set_sum(T, fn(C T) N {finite_set_size(H)})
    finite_set_sum(T, fn(C T) N {finite_set_size(H)}) = finite_set_size(T) * finite_set_size(H)
    finite_set_size(G) = finite_set_size(H) * finite_set_size(T)
    witness exist q Z st {finite_set_size(G) = finite_set_size(H) * q} from finite_set_size(T):
        finite_set_size(G) = finite_set_size(H) * finite_set_size(T)
    by def $subgroup_order_divides_group_order(G, mul, one, H)

thm integer_is_congruent_to_its_remainder_mod:
    ? forall m N_pos, t Z:
        $section5::congruent_mod(m, t, t % m)
    t = m * section2::integer_quotient(t, m) + t % m
    t - (t % m) = m * section2::integer_quotient(t, m)
    witness exist k Z st {t - (t % m) = m * k} from section2::integer_quotient(t, m)
    $section5::congruent_mod(m, t, t % m)

thm congruent_representative_of_coprime_is_coprime:
    ? forall m N_pos, t, u Z:
        $section5::congruent_mod(m, t, u)
        $section3::relatively_prime_Z(t, m)
        =>:
            $section3::relatively_prime_Z(u, m)
    by thm section5::residue_class_eq_of_congruent(m, t, u)
    section5::residue_class_mod(m, t) = section5::residue_class_mod(m, u)
    by def $section6::residue_class_prime_to_mod(m, t)
    by thm section6::residue_class_prime_to_mod_is_representative_independent(m, t, u)
    $section6::residue_class_prime_to_mod(m, u)
    $section3::relatively_prime_Z(u, m)

# Euler's representative map is integer multiplication followed by the
# standard remainder. These source-facing closure theorems supply its checked
# codomain proof before the later finite-product argument.
thm reduced_residue_multiplication_closes:
    ? forall m N_pos, a, r Z:
        $section3::relatively_prime_Z(a, m)
        $section3::relatively_prime_Z(r, m)
        =>:
            a * r % m $in section6::coprime_remainders_mod(m)
    by thm section6::prime_to_residue_classes_closed_under_multiplication(m, a, r)
    $section3::relatively_prime_Z(a * r, m)
    by thm integer_is_congruent_to_its_remainder_mod(m, a * r)
    $section5::congruent_mod(m, a * r, a * r % m)
    by thm congruent_representative_of_coprime_is_coprime(m, a * r, a * r % m)
    $section3::relatively_prime_Z(a * r % m, m)
    0 <= a * r % m < m
    $section6::coprime_remainder_mod(m, a * r % m)
    by thm section6::coprime_remainder_is_member_of_coprime_remainders_mod(m, a * r % m)
    a * r % m $in section6::coprime_remainders_mod(m)

thm multiplication_by_coprime_preserves_coprime_remainders:
    ? forall m N_pos, a, r Z:
        r $in section6::coprime_remainders_mod(m)
        $section3::relatively_prime_Z(a, m)
        =>:
            a * r % m $in section6::coprime_remainders_mod(m)
    by thm section6::member_of_coprime_remainders_mod_is_coprime_remainder(m, r)
    $section6::coprime_remainder_mod(m, r)
    $section3::relatively_prime_Z(r, m)
    by thm reduced_residue_multiplication_closes(m, a, r)
    a * r % m $in section6::coprime_remainders_mod(m)

thm theorem_VIII_Euler:
    ? forall m N_pos, a Z:
        $section3::relatively_prime_Z(a, m)
        =>:
            $euler_theorem_conclusion(m, a)
    # Trust: Section VI already supplies the finite reduced-residue group and
    # its phi cardinality. What remains is the generic finite-group
    # power-at-cardinality theorem and the bridge from group powers to integer
    # powers of residue classes.
    trust $euler_theorem_conclusion(m, a)
