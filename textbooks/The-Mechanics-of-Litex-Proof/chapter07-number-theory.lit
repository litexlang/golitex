
# Chapter 7 — Number Theory

# > _Mathematics is the queen of sciences and number theory is the queen of mathematics._
# >
# > _– Carl Friedrich Gauss_

# This chapter has a different flavor from the earlier chapters. The theorems here
# are classical results, and their proofs often depend on a one-time clever idea
# rather than a reusable template. The question for Litex is simple: once the
# mathematical idea is clear, can the formal proof still look like the proof one
# would write on paper?

# 7.1 Infinitely Many Primes

# The first example in Macbeth's chapter is Euclid's theorem: there are infinitely
# many primes. In Litex, the proof can be written in the same forward order as the
# mathematical idea. Take the factorial-like product
# `product(1, a, fn(x N+) N+ {x})`, then take a prime factor `k` of this product plus
# one. If `k <= a`, then `k` divides the product. But `k` also divides the product
# plus one, so the same remainder would have to be both `0` and `1`, a
# contradiction. Therefore `k > a`.

# The point is not that Litex hides the mathematics. The point is that the proof
# script is mostly the mathematics. The user writes the facts in order: an
# inequality chain, an existential extraction, a case split, a contradiction, and
# then the witness for the final existential statement.

# Before the main proof, we prove three ordinary supporting facts: every positive
# integer `k <= a` divides `1 * 2 * ... * a`; every positive integer at least
# `2` has a prime factor; and `a <= 1 * 2 * ... * a`. These checked derivations
# keep the final Euclid proof focused on its contradiction argument.

claim:
    ? forall a N+:
        product(1, a, fn(x N+) N+ {x}) % a = 0 and a <= product(1, a, fn(x N+) N+ {x})

    by induc a from 1:
        ? product(1, a, fn(x N+) N+ {x}) % a = 0 and a <= product(1, a, fn(x N+) N+ {x})

        product(1, 1, fn(x N+) N+ {x}) = 1
        1 <= product(1, 1, fn(x N+) N+ {x})

        claim:
            ? forall k Z:
                k >= 1
                product(1, k, fn(x N+) N+ {x}) % k = 0 and k <= product(1, k, fn(x N+) N+ {x})
                =>:
                    product(1, k + 1, fn(x N+) N+ {x}) % (k + 1) = 0 and k + 1 <= product(1, k + 1, fn(x N+) N+ {x})

            have prefix_product N+ = product(1, k, fn(x N+) N+ {x})
            have next_product N+ = product(1, k + 1, fn(x N+) N+ {x})
            k + 1 $in N+
            witness exist quotient Z st {next_product = (k + 1) * quotient + 0} from prefix_product:
                next_product = product(1, k + 1, fn(x N+) N+ {x}) = product(1, k, fn(x N+) N+ {x}) * (k + 1) = prefix_product * (k + 1) = (k + 1) * prefix_product = (k + 1) * prefix_product + 0
            obtain quotient_value from exist quotient Z st {next_product = (k + 1) * quotient + 0}
            next_product = (k + 1) * quotient_value + 0
            next_product % (k + 1) = 0
            product(1, k + 1, fn(x N+) N+ {x}) % (k + 1) = next_product % (k + 1) = 0
            prefix_product >= 1
            next_product = product(1, k + 1, fn(x N+) N+ {x}) = product(1, k, fn(x N+) N+ {x}) * (k + 1) = prefix_product * (k + 1) = (k + 1) * prefix_product
            k + 1 = (k + 1) * 1 <= (k + 1) * prefix_product = next_product = product(1, k + 1, fn(x N+) N+ {x})

claim:
    ? forall a, k N+:
        k <= a
        =>:
            product(1, a, fn(x N+) N+ {x}) % k = 0

    by cases:
        ? product(1, a, fn(x N+) N+ {x}) % k = 0
        case k = a:
            product(1, a, fn(x N+) N+ {x}) % a = 0
            product(1, a, fn(x N+) N+ {x}) % k = product(1, a, fn(x N+) N+ {x}) % a = 0
        case k < a:
            k + 1 <= a
            product(1, a, fn(x N+) N+ {x}) = product(1, k, fn(x N+) N+ {x}) * product(k + 1, a, fn(x N+) N+ {x})
            have prefix_product Z = product(1, k, fn(x N+) N+ {x})
            have suffix_product Z = product(k + 1, a, fn(x N+) N+ {x})
            have whole_product N+ = product(1, a, fn(x N+) N+ {x})
            prefix_product % k = product(1, k, fn(x N+) N+ {x}) % k = 0
            witness exist q Z st {prefix_product = k * q + prefix_product % k} from basics::integer_quotient(prefix_product, k):
                prefix_product = k * basics::integer_quotient(prefix_product, k) + prefix_product % k
            obtain r from exist q Z st {prefix_product = k * q + prefix_product % k}
            prefix_product = k * r + prefix_product % k = k * r = r * k
            witness exist t Z st {whole_product = t * k} from r * suffix_product:
                whole_product = product(1, a, fn(x N+) N+ {x}) = prefix_product * suffix_product = (r * k) * suffix_product = (r * suffix_product) * k
            obtain whole_quotient from exist t Z st {whole_product = t * k}
            whole_product = whole_quotient * k = k * whole_quotient = k * whole_quotient + 0
            whole_product % k = 0
            product(1, a, fn(x N+) N+ {x}) % k = whole_product % k = 0

claim:
    ? forall a N+:
        a <= product(1, a, fn(x N+) N+ {x})

    product(1, a, fn(x N+) N+ {x}) % a = 0 and a <= product(1, a, fn(x N+) N+ {x})

claim:
    ? forall a N+:
        2 <= a
        =>:
            exist k N+ st {$prime(k), a % k = 0}

    by strong_induc x from 2:
        ? exist k N+ st {$prime(k), x % k = 0}

        claim:
            ? forall b N+:
                2 <= b < 2
                =>:
                    2 % b != 0
            by contra 2 % b != 0:
                impossible b < 2
        $prime(2)

        witness exist t Z st {2 = t * 2} from 1
        0 < 2
        2 = 2 * 1 + 0
        2 % 2 = 0
        witness exist k N+ st {$prime(k), 2 % k = 0} from 2

        claim:
            ? forall n Z:
                n >= 2
                forall m Z:
                    2 <= m
                    m <= n
                    =>:
                        exist k N+ st {$prime(k), m % k = 0}
                =>:
                    exist k N+ st {$prime(k), (n + 1) % k = 0}

            by cases exist k N+ st {$prime(k), (n + 1) % k = 0}:
                case $prime(n+1):
                    witness exist t Z st {n + 1 = t * (n + 1)} from 1
                    0 < n + 1
                    n + 1 $in N+
                    n + 1 = (n + 1) * 1 + 0
                    (n + 1) % (n + 1) = 0
                    witness exist k N+ st {$prime(k), (n + 1) % k = 0} from n+1
                case not $prime(n+1):
                    by contra:
                        ? not forall b N+:
                            2 <= b < n + 1
                            =>:
                                (n + 1) % b != 0
                        2 <= n + 1
                        by def $prime(n + 1)
                        impossible $prime(n+1)

                    obtain c from exist b N+ st {2 <= b < n+1, not (n + 1) % b != 0}

                    2 <= c < n+1

                    (n+1) % c = 0
                    c <= n or c >= n + 1
                    by cases:
                        ? c <= n
                        case c <= n:
                            do_nothing
                        case c >= n + 1:
                            impossible c < n + 1

                    obtain d from exist k N+ st {$prime(k), c % k = 0}

                    witness exist q Z st {n + 1 = c * q + (n + 1) % c} from basics::integer_quotient(n + 1, c):
                        n + 1 = c * basics::integer_quotient(n + 1, c) + (n + 1) % c
                    obtain e1 from exist q Z st {n + 1 = c * q + (n + 1) % c}
                    n + 1 = c * e1 + (n + 1) % c = c * e1 = e1 * c

                    witness exist q Z st {c = d * q + c % d} from basics::integer_quotient(c, d):
                        c = d * basics::integer_quotient(c, d) + c % d
                    obtain f from exist r Z st {c = d * r + c % d}
                    c = d * f + c % d = d * f = f * d

                    witness exist t Z st {e1 * f * d = t * d} from e1 * f
                    0 < d
                    e1 * f * d = d * (e1 * f) + 0
                    (e1 * f * d) % d = 0

                    n + 1 = e1 * c = e1 * (f * d) = (e1 * f) * d
                    0 < d
                    n + 1 = d * (e1 * f) + 0
                    (n + 1) % d = 0
                    witness exist k N+ st {$prime(k), (n + 1) % k = 0} from d:
                        (n + 1) % d = 0

# With these facts in the context, the whole proof body is the following 11 lines:

claim forall! a N+: 2 <= a => {exist k N+ st {k > a, $prime(k)}}:
    2 <= a <= product(1, a, fn(x N+) N+ {x}) <= product(1, a, fn(x N+) N+ {x}) + 1
    obtain k from exist k N+ st {$prime(k), (product(1, a, fn(x N+) N+ {x}) + 1) % k = 0}
    by cases k > a:
        case k <= a:
            product(1, a, fn(x N+) N+ {x}) % k = 0
            2 <= k
            (product(1, a, fn(x N+) N+ {x}) + 1) % k = (product(1, a, fn(x N+) N+ {x}) % k + 1 % k) % k
            1 % k = 1
            (0 + 1) % k = 1 % k = 1
            (product(1, a, fn(x N+) N+ {x}) + 1) % k = (product(1, a, fn(x N+) N+ {x}) % k + 1 % k) % k = (0 + 1) % k = 1
            0 = (product(1, a, fn(x N+) N+ {x}) + 1) % k = 1
            impossible 0 = 1
        case k > a:
            do_nothing
    witness exist prime_larger N+ st {prime_larger > a, $prime(prime_larger)} from k

