thm quot_euclidean:
    ? forall a Z, d N+:
        a = d * quot(a, d) + a % d

thm mul_swap_tail:
    ? forall r, k, s Z:
        (r * k) * s = (r * s) * k

# Textbook-local number-theory interfaces for The Mechanics of Litex Proof.
#
# gcd, prime, dvd, and quot are native Litex vocabulary.  The Euclidean and
# Bezout proof machinery below stays local to this textbook now that
# std/basics is an empty compatibility module.

prop divides(a Z, b Z):
    exist k Z st {b = a * k}

thm _positive_divisor_le_abs:
    ? forall d N+, a Z:
        $divides(d, a)
        a != 0
        =>:
            d <= abs(a)
    obtain k from exist k Z st {a = d * k}
    by contra:
        ? k != 0
        k = 0
        a = d * k = d * 0 = 0
        impossible a != 0
    abs(k) > 0
    abs(k) $in N+
    d * 1 <= d * abs(k)
    abs(d) = d
    abs(a) = abs(d * k) = abs(d) * abs(k) = d * abs(k)
    d = d * 1 <= d * abs(k) = abs(a)

thm gcd_comm:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd(a, b) = gcd(b, a)
    claim:
        ? b != 0 or a != 0
        by cases:
            ? b != 0 or a != 0
            case a != 0:
                b != 0 or a != 0
            case b != 0:
                b != 0 or a != 0
    gcd(a, b) $in N+
    a % gcd(a, b) = 0
    b % gcd(a, b) = 0
    gcd(a, b) <= gcd(b, a)
    gcd(b, a) $in N+
    b % gcd(b, a) = 0
    a % gcd(b, a) = 0
    gcd(b, a) <= gcd(a, b)

thm gcd_positive:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd(a, b) $in N+

thm gcd_divides_left:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), a)
    gcd(a, b) $in N+
    a % gcd(a, b) = 0
    quot(a, gcd(a, b)) $in Z
    by thm quot_euclidean(a, gcd(a, b))
    witness exist k Z st {a = gcd(a, b) * k} from quot(a, gcd(a, b)):
        a = gcd(a, b) * quot(a, gcd(a, b)) + a % gcd(a, b) = gcd(a, b) * quot(a, gcd(a, b))

thm gcd_divides_right:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), b)
    gcd(a, b) $in N+
    b % gcd(a, b) = 0
    quot(b, gcd(a, b)) $in Z
    by thm quot_euclidean(b, gcd(a, b))
    witness exist k Z st {b = gcd(a, b) * k} from quot(b, gcd(a, b)):
        b = gcd(a, b) * quot(b, gcd(a, b)) + b % gcd(a, b) = gcd(a, b) * quot(b, gcd(a, b))

thm common_divisor_le_gcd:
    ? forall a, b Z, d N+:
        a != 0 or b != 0
        $divides(d, a)
        $divides(d, b)
        =>:
            d <= gcd(a, b)
    obtain ka from exist k Z st {a = d * k}
    obtain kb from exist k Z st {b = d * k}
    a % d = (d * ka) % d = 0
    b % d = (d * kb) % d = 0

thm gcd_euclidean_base:
    ? forall a Z:
        a != 0
        =>:
            gcd(a, 0) = abs(a)
    by thm gcd_positive(a, 0)
    by thm gcd_divides_left(a, 0)
    by thm _positive_divisor_le_abs(gcd(a, 0), a)
    gcd(a, 0) <= abs(a)
    abs(a) > 0
    abs(a) $in N+
    by cases:
        ? $divides(abs(a), a)
        case a >= 0:
            abs(a) = a
            a = a * 1
            abs(a) * 1 = a * 1
            a = abs(a) * 1
            witness exist k Z st {a = abs(a) * k} from 1
        case a < 0:
            abs(a) = -a
            a = abs(a) * (-1)
            witness exist k Z st {a = abs(a) * k} from -1
    witness exist k Z st {0 = abs(a) * k} from 0:
        0 = abs(a) * 0
    $divides(abs(a), 0)
    by thm common_divisor_le_gcd(a, 0, abs(a))
    abs(a) <= gcd(a, 0)

thm gcd_euclidean_step:
    ? forall a, b Z:
        b != 0
        =>:
            gcd(a, b) = gcd(b, a % abs(b))

    claim:
        ? forall d N+, z Z:
            $divides(d, z)
            =>:
                $divides(d, abs(z))
        obtain k from exist k Z st {z = d * k}
        by cases:
            ? $divides(d, abs(z))
            case z >= 0:
                abs(z) = z = d * k
                witness exist t Z st {abs(z) = d * t} from k
            case z < 0:
                abs(z) = -z = -(d * k) = d * (-k)
                witness exist t Z st {abs(z) = d * t} from -k

    by thm gcd_positive(b, a % abs(b))
    by thm gcd_divides_left(b, a % abs(b))
    by thm gcd_divides_right(b, a % abs(b))
    $divides(gcd(b, a % abs(b)), abs(b))
    obtain x from exist k Z st {abs(b) = gcd(b, a % abs(b)) * k}
    obtain y from exist k Z st {a % abs(b) = gcd(b, a % abs(b)) * k}
    abs(b) > 0
    abs(b) $in N+
    quot(a, abs(b)) $in Z
    by thm quot_euclidean(a, abs(b))
    witness exist q Z st {a = abs(b) * q + a % abs(b)} from quot(a, abs(b)):
        a = abs(b) * quot(a, abs(b)) + a % abs(b)
    obtain q from exist q Z st {a = abs(b) * q + a % abs(b)}
    witness exist t Z st {a = gcd(b, a % abs(b)) * t} from x * q + y:
        a = abs(b) * q + a % abs(b) = (gcd(b, a % abs(b)) * x) * q + gcd(b, a % abs(b)) * y = gcd(b, a % abs(b)) * (x * q + y)
    $divides(gcd(b, a % abs(b)), a)
    by thm common_divisor_le_gcd(a, b, gcd(b, a % abs(b)))
    gcd(b, a % abs(b)) <= gcd(a, b)

    by thm gcd_positive(a, b)
    by thm gcd_divides_left(a, b)
    by thm gcd_divides_right(a, b)
    $divides(gcd(a, b), abs(b))
    obtain u from exist k Z st {a = gcd(a, b) * k}
    obtain v from exist k Z st {abs(b) = gcd(a, b) * k}
    abs(b) > 0
    abs(b) $in N+
    quot(a, abs(b)) $in Z
    by thm quot_euclidean(a, abs(b))
    witness exist r Z st {a = abs(b) * r + a % abs(b)} from quot(a, abs(b)):
        a = abs(b) * quot(a, abs(b)) + a % abs(b)
    obtain r from exist r Z st {a = abs(b) * r + a % abs(b)}
    witness exist t Z st {a % abs(b) = gcd(a, b) * t} from u - v * r:
        a % abs(b) = a - abs(b) * r = gcd(a, b) * u - (gcd(a, b) * v) * r = gcd(a, b) * (u - v * r)
    $divides(gcd(a, b), a % abs(b))
    by thm common_divisor_le_gcd(b, a % abs(b), gcd(a, b))
    gcd(a, b) <= gcd(b, a % abs(b))

# The Euclidean remainder has strictly smaller absolute value than a nonzero divisor.
# This must be available before the recursive Bezout coefficient definition.
thm _euclidean_remainder_abs_lt_abs:
    ? forall u, v Z:
        v != 0
        =>:
            abs(u % abs(v)) < abs(v)
    abs(v) > 0
    abs(v) $in N+
    u % abs(v) >= 0
    abs(u % abs(v)) = u % abs(v)
    u % abs(v) < abs(v)

thm bezout_identity:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            exist x Z, y Z st {gcd(a, b) = x * a + y * b}

    have fn euclid_bezout_pair(u, v Z) cart(Z, Z) by induc abs(v) from 0:
        case v = 0:
            case u >= 0: (1, 0)
            case u < 0: (-1, 0)
        case v != 0:
            case v >= 0: (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])
            case v < 0: (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])

    have fn euclid_bezout_l(u, v Z) Z = euclid_bezout_pair(u, v)[1]
    have fn euclid_bezout_r(u, v Z) Z = euclid_bezout_pair(u, v)[2]

    prop euclid_bezout_identity_at_measure(m Z):
        forall u, v Z:
            u != 0 or v != 0
            abs(v) = m
            =>:
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)

    claim:
        ? forall u, v Z:
            u != 0 or v != 0
            abs(v) = 0
            =>:
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
        v = 0
        by cases:
            ? u != 0
            case u != 0:
                do_nothing
            case v != 0:
                impossible v = 0
        by thm gcd_euclidean_base(u)
        by cases:
            ? euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
            case u >= 0:
                euclid_bezout_pair(u, v) = (1, 0)
                euclid_bezout_l(u, v) = 1
                euclid_bezout_r(u, v) = 0
                abs(u) = u
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = 1 * u + 0 * v = u = abs(u) = gcd(u, v)
            case u < 0:
                euclid_bezout_pair(u, v) = (-1, 0)
                euclid_bezout_l(u, v) = -1
                euclid_bezout_r(u, v) = 0
                abs(u) = -u
                euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = -1 * u + 0 * v = -u = abs(u) = gcd(u, v)
    $euclid_bezout_identity_at_measure(0)

    claim:
        ? forall m Z:
            m >= 0
            forall y Z:
                y >= 0
                y <= m
                =>:
                    $euclid_bezout_identity_at_measure(y)
            =>:
                $euclid_bezout_identity_at_measure(m + 1)
        claim:
            ? forall u, v Z:
                u != 0 or v != 0
                abs(v) = m + 1
                =>:
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
            m + 1 > 0
            by contra:
                ? v != 0
                v = 0
                abs(v) = 0
                abs(v) = m + 1
                m + 1 = abs(v) = 0
                impossible m + 1 > 0
            have r Z = u % abs(v)
            abs(v) > 0
            abs(v) $in N+
            r = u % abs(v)
            u % abs(v) >= 0
            r = u % abs(v) >= 0
            abs(r) >= 0
            abs(r) = r
            r $in Z
            abs(r) $in Z
            u % abs(v) < abs(v)
            r = u % abs(v) < abs(v)
            abs(r) < abs(v)
            abs(v) = m + 1
            abs(r) < m + 1
            abs(r) + 1 <= m + 1
            abs(r) <= m or abs(r) >= m + 1
            by cases:
                ? abs(r) <= m
                case abs(r) <= m:
                    abs(r) <= m
                case abs(r) >= m + 1:
                    impossible abs(r) < m + 1
            v != 0 or r != 0
            abs(r) = abs(r)
            $euclid_bezout_identity_at_measure(abs(r))
            by thm gcd_euclidean_step(u, v)
            by cases:
                ? euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = gcd(u, v)
                case v >= 0:
                    abs(v) = v
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r)
                    euclid_bezout_l(v, r) = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_r(v, r) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_l(v, r)
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_r(v, r)
                    gcd(v, r) = gcd(v, u % abs(v))
                    euclid_bezout_pair(u, v) = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])
                    euclid_bezout_l(u, v) = euclid_bezout_pair(u, v)[1] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[1] = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_pair(u, v)[2] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] - quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[2] = euclid_bezout_pair(v, u % abs(v))[1] - quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[1]
                    euclid_bezout_pair(v, u % abs(v))[1] = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_r(v, u % abs(v))
                    quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[1] - quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_l(v, u % abs(v)) - quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) - quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = quot(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_l(v, u % abs(v)) - quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) - quot(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) - quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) - quot(u, abs(v)) * euclid_bezout_r(v, r)
                    u = abs(v) * quot(u, abs(v)) + u % abs(v)
                    u - v * quot(u, abs(v)) = u - abs(v) * quot(u, abs(v)) = u % abs(v)
                    u - v * quot(u, abs(v)) = r
                    gcd(u, v) = gcd(v, u % abs(v)) = gcd(v, r)
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) - quot(u, abs(v)) * euclid_bezout_r(v, r)) * v
                    euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) - quot(u, abs(v)) * euclid_bezout_r(v, r)) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u - v * quot(u, abs(v)))
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u - v * quot(u, abs(v))) = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r) = gcd(u, v)
                case v < 0:
                    abs(v) = -v
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r)
                    euclid_bezout_l(v, r) = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_r(v, r) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_l(v, r)
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_r(v, r)
                    gcd(v, r) = gcd(v, u % abs(v))
                    euclid_bezout_pair(u, v) = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])
                    euclid_bezout_l(u, v) = euclid_bezout_pair(u, v)[1] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[1] = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_r(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_l(u, v) = euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_pair(u, v)[2] = (euclid_bezout_pair(v, u % abs(v))[2], euclid_bezout_pair(v, u % abs(v))[1] + quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2])[2] = euclid_bezout_pair(v, u % abs(v))[1] + quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2]
                    euclid_bezout_l(v, u % abs(v)) = euclid_bezout_pair(v, u % abs(v))[1]
                    euclid_bezout_pair(v, u % abs(v))[1] = euclid_bezout_l(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_r(v, u % abs(v))
                    quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_pair(v, u % abs(v))[1] + quot(u, abs(v)) * euclid_bezout_pair(v, u % abs(v))[2] = euclid_bezout_l(v, u % abs(v)) + quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) + quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v))
                    quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = quot(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_l(v, u % abs(v)) + quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) + quot(u, abs(v)) * euclid_bezout_r(v, r)
                    euclid_bezout_r(u, v) = euclid_bezout_l(v, u % abs(v)) + quot(u, abs(v)) * euclid_bezout_r(v, u % abs(v)) = euclid_bezout_l(v, r) + quot(u, abs(v)) * euclid_bezout_r(v, r)
                    u = abs(v) * quot(u, abs(v)) + u % abs(v)
                    u + v * quot(u, abs(v)) = u - abs(v) * quot(u, abs(v)) = u % abs(v)
                    u + v * quot(u, abs(v)) = r
                    gcd(u, v) = gcd(v, u % abs(v)) = gcd(v, r)
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) + quot(u, abs(v)) * euclid_bezout_r(v, r)) * v
                    euclid_bezout_r(v, r) * u + (euclid_bezout_l(v, r) + quot(u, abs(v)) * euclid_bezout_r(v, r)) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u + v * quot(u, abs(v)))
                    euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * (u + v * quot(u, abs(v))) = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r
                    euclid_bezout_l(u, v) * u + euclid_bezout_r(u, v) * v = euclid_bezout_l(v, r) * v + euclid_bezout_r(v, r) * r = gcd(v, r) = gcd(u, v)

    by strong_induc m from 0:
        ? $euclid_bezout_identity_at_measure(m)
        ? from m = 0:
            $euclid_bezout_identity_at_measure(0)
        ? strong_induc:
            $euclid_bezout_identity_at_measure(m + 1)

    abs(b) >= 0
    $euclid_bezout_identity_at_measure(abs(b))
    euclid_bezout_l(a, b) * a + euclid_bezout_r(a, b) * b = gcd(a, b)
    witness exist x Z, y Z st {gcd(a, b) = x * a + y * b} from euclid_bezout_l(a, b), euclid_bezout_r(a, b):
        gcd(a, b) = euclid_bezout_l(a, b) * a + euclid_bezout_r(a, b) * b

# Weil, Exercise II.8: every rational number has a reduced fraction.
# A negative rational needs an integer numerator, so the denominator is chosen
# positive and the reducedness condition is `gcd(p, d) = 1`.
thm gcd_of_prime_is_one_or_prime:
    ? forall a Z, p N+:
        $prime(p)
        =>:
            gcd(a, p) = 1 or gcd(a, p) = p
    by thm gcd_positive(a, p)
    by thm gcd_divides_right(a, p)
    obtain k from exist k Z st {p = gcd(a, p) * k}
    gcd(a, p) * k + 0 = gcd(a, p) * k
    p = gcd(a, p) * k
    p = gcd(a, p) * k + 0
    p % gcd(a, p) = 0
    by thm _positive_divisor_le_abs(gcd(a, p), p)
    abs(p) = p
    gcd(a, p) <= p
    gcd(a, p) = p or gcd(a, p) < p
    by cases:
        ? gcd(a, p) = 1 or gcd(a, p) = p
        case gcd(a, p) = p:
            gcd(a, p) = 1 or gcd(a, p) = p
        case gcd(a, p) < p:
            gcd(a, p) = 1 or gcd(a, p) > 1
            by cases:
                ? gcd(a, p) = 1 or gcd(a, p) = p
                case gcd(a, p) = 1:
                    gcd(a, p) = 1 or gcd(a, p) = p
                case gcd(a, p) > 1:
                    gcd(a, p) >= 2
                    gcd(a, p) $in range(2, p)
                    $prime(p)
                    p % gcd(a, p) != 0
                    impossible p % gcd(a, p) = 0
