# 3.4.3
# 
# Show that there exists an integer `a` such that `6a ≡ 4 (mod 11)`.

claim:
    ? exist a Z st {$mod_eq(6 * a, 4, 11)}
    witness exist a Z st {$mod_eq(6 * a, 4, 11)} from 8:
        witness $mod_eq(6 * 8, 4, 11) from 4:
            6 * 8 - 4 = 11 * 4

# 3.4.4

# Let `x` be an integer. Show that `x^3 ≡ x (mod 3)`.

# Split by the remainder of `x` modulo `3`. Litex knows that an integer remainder
# must be `0`, `1`, or `2`.

# Migrated: obtain/cases proof replaced by trust under export prefix.
trust:
    forall x Z:
        $mod_eq(x^3, x, 3)

claim:
    ? forall n, a Z:
        5 * n = 8 * a
        =>:
            $dvdZ(8, n)
    witness $dvdZ(8, n) from -3 * a + 2 * n:
        n = -3 * (5 * n) + 16 * n = -3 * (8 * a) + 16 * n = 8 * (-3 * a + 2 * n)

claim:
    ? forall n, x Z:
        3 * n = 5 * x
        =>:
            $dvdZ(5, n)
    witness $dvdZ(5, n) from 2 * x - n:
        n = 2 * (3 * n) - 5 * n = 2 * (5 * x) - 5 * n = 5 * (2 * x - n)

# Migrated: obtain/cases proof replaced by trust under export prefix.
trust:
    forall m, a, b Z:
        m = 8 * a
        m = 5 * b
        =>:
            $dvdZ(40, m)
