# Linear Algebra Done Right, fourth edition, Section 2B: Bases.
# Definition 2.26. A basis is exactly a finite vector list that is linearly
# independent and spans the equipped vector space.
prop is_basis(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    $chap2a::is_linearly_independent(s, v, space, n, vectors)
    $chap2a::spans(s, v, space, n, vectors)
# Example 2.27. The source checks standard and nonstandard bases of coordinate
# spaces and the monomial basis of bounded-degree polynomials. Each positive
# case supplies both clauses of is_basis; each negative case identifies which
# clause fails. The concrete calculations remain source sketches here.
# Result 2.28. A list is a basis iff every vector has a unique coefficient
# list in its linear-combination representation. The source proves existence
# from spanning and uniqueness from independence, then reverses both steps.
prop has_unique_coordinates(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    forall value v:
        exist! coefficients &chap1a::FiniteList<s, n> st {value = \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors)}

prop basis_iff_unique_coordinates_statement(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    forall:
        =>:
            $is_basis(s, v, space, n, vectors)
        <=>:
            $has_unique_coordinates(s, v, space, n, vectors)

thm scalar_cancel_reduction:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, x, z s:
        scalars.add(scalars.add(x, z), scalars.neg(z)) = x
    scalars.add(scalars.add(x, z), scalars.neg(z)) = scalars.add(x, scalars.add(z, scalars.neg(z)))
    scalars.add(z, scalars.neg(z)) = scalars.zero
    scalars.add(x, scalars.add(z, scalars.neg(z))) = scalars.add(x, scalars.zero)
    scalars.add(x, scalars.zero) = scalars.add(scalars.zero, x)
    scalars.add(scalars.zero, x) = x
    scalars.add(scalars.add(x, z), scalars.neg(z)) = x

thm scalar_add_right_cancel:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, x, y, z s:
        scalars.add(x, z) = scalars.add(y, z)
        =>:
            x = y
    scalars.add(scalars.add(x, z), scalars.neg(z)) = scalars.add(scalars.add(y, z), scalars.neg(z))
    by thm scalar_cancel_reduction(s, scalars, x, z)
    by thm scalar_cancel_reduction(s, scalars, y, z)
    x = y

thm zero_difference_implies_lists_equal:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, left, right, negated, difference &chap1a::FiniteList<s, n>:
        negated = \chap2a::coefficient_list_neg<s, scalars, n>(right)
        difference = \chap2a::coefficient_list_add<s, scalars, n>(left, negated)
        $chap2a::has_only_zero_coefficients(s, scalars, n, difference)
        =>:
            left = right
    by def $chap2a::has_only_zero_coefficients(s, scalars, n, difference)
    claim:
        ? forall position N+:
            position <= n
            =>:
                left.entries(position) = right.entries(position)
        by thm chap2a::coefficient_list_add_entry(s, scalars, n, left, negated, difference, position)
        by thm chap2a::coefficient_list_neg_entry(s, scalars, n, right, negated, position)
        difference.entries(position) = scalars.zero
        difference.entries(position) = scalars.add(left.entries(position), scalars.neg(right.entries(position)))
        scalars.add(right.entries(position), scalars.neg(right.entries(position))) = scalars.zero
        scalars.add(left.entries(position), scalars.neg(right.entries(position))) = difference.entries(position) = scalars.zero = scalars.add(right.entries(position), scalars.neg(right.entries(position)))
        by thm scalar_add_right_cancel(s, scalars, left.entries(position), right.entries(position), scalars.neg(right.entries(position)))
        left.entries(position) = right.entries(position)
    by def $chap1a::have_same_finite_list_entries(s, n, left, right)
    by thm chap1a::finite_list_extensionality(s, n, left, right)

thm coordinate_difference_has_zero_value:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, value v, left, right, negated, difference &chap1a::FiniteList<s, n>:
        value = \chap2a::linear_combination_value<s, v, space, n>(left, vectors)
        value = \chap2a::linear_combination_value<s, v, space, n>(right, vectors)
        negated = \chap2a::coefficient_list_neg<s, space.scalars, n>(right)
        difference = \chap2a::coefficient_list_add<s, space.scalars, n>(left, negated)
        =>:
            \chap2a::linear_combination_value<s, v, space, n>(difference, vectors) = space.zero
    by thm chap2a::linear_combination_value_neg_coefficients(s, v, space, n, right, vectors)
    \chap2a::linear_combination_value<s, v, space, n>(negated, vectors) = \chap2a::linear_combination_value<s, v, space, n>(\chap2a::coefficient_list_neg<s, space.scalars, n>(right), vectors)
    \chap1b::vector_neg<s, v, space>(\chap2a::linear_combination_value<s, v, space, n>(right, vectors)) = \chap1b::vector_neg<s, v, space>(value)
    \chap2a::linear_combination_value<s, v, space, n>(negated, vectors) = \chap2a::linear_combination_value<s, v, space, n>(\chap2a::coefficient_list_neg<s, space.scalars, n>(right), vectors) = \chap1b::vector_neg<s, v, space>(\chap2a::linear_combination_value<s, v, space, n>(right, vectors)) = \chap1b::vector_neg<s, v, space>(value)
    by thm chap2a::linear_combination_value_add_coefficients(s, v, space, n, left, negated, vectors)
    \chap2a::linear_combination_value<s, v, space, n>(difference, vectors) = \chap2a::linear_combination_value<s, v, space, n>(\chap2a::coefficient_list_add<s, space.scalars, n>(left, negated), vectors)
    space.add(\chap2a::linear_combination_value<s, v, space, n>(left, vectors), \chap2a::linear_combination_value<s, v, space, n>(negated, vectors)) = space.add(value, \chap1b::vector_neg<s, v, space>(value))
    \chap2a::linear_combination_value<s, v, space, n>(difference, vectors) = \chap2a::linear_combination_value<s, v, space, n>(\chap2a::coefficient_list_add<s, space.scalars, n>(left, negated), vectors) = space.add(\chap2a::linear_combination_value<s, v, space, n>(left, vectors), \chap2a::linear_combination_value<s, v, space, n>(negated, vectors)) = space.add(value, \chap1b::vector_neg<s, v, space>(value))
    by thm chap1b::vector_neg_spec(s, v, space, value)
    \chap2a::linear_combination_value<s, v, space, n>(difference, vectors) = space.zero

thm independent_coordinates_unique:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, value v, left, right &chap1a::FiniteList<s, n>:
        $chap2a::is_linearly_independent(s, v, space, n, vectors)
        value = \chap2a::linear_combination_value<s, v, space, n>(left, vectors)
        value = \chap2a::linear_combination_value<s, v, space, n>(right, vectors)
        =>:
            left = right
    have negated &chap1a::FiniteList<s, n> = \chap2a::coefficient_list_neg<s, space.scalars, n>(right)
    have difference &chap1a::FiniteList<s, n> = \chap2a::coefficient_list_add<s, space.scalars, n>(left, negated)
    by thm coordinate_difference_has_zero_value(s, v, space, n, vectors, value, left, right, negated, difference)
    by def $chap2a::is_linearly_independent(s, v, space, n, vectors)
    $chap2a::has_only_zero_coefficients(s, space.scalars, n, difference)
    by thm zero_difference_implies_lists_equal(s, space.scalars, n, left, right, negated, difference)

thm basis_iff_unique_coordinates:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $basis_iff_unique_coordinates_statement(s, v, space, n, vectors)
    claim:
        ? forall:
            $is_basis(s, v, space, n, vectors)
            =>:
                $has_unique_coordinates(s, v, space, n, vectors)
        by def $is_basis(s, v, space, n, vectors)
        claim:
            ? forall value v:
                exist! coefficients &chap1a::FiniteList<s, n> st {value = \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors)}
            by def $chap2a::spans(s, v, space, n, vectors)
            \chap2a::span<s, v, space, n, vectors> = {x v: $chap2a::is_linear_combination(s, v, space, n, x, vectors)}
            value $in v
            value $in \chap2a::span<s, v, space, n, vectors>
            $chap2a::is_linear_combination(s, v, space, n, value, vectors)
            obtain chosen from exist coefficients &chap1a::FiniteList<s, n> st {value = \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors)}
            claim:
                ? forall left, right &chap1a::FiniteList<s, n>:
                    value = \chap2a::linear_combination_value<s, v, space, n>(left, vectors)
                    value = \chap2a::linear_combination_value<s, v, space, n>(right, vectors)
                    =>:
                        left = right
                by thm independent_coordinates_unique(s, v, space, n, vectors, value, left, right)
            witness exist! coefficients &chap1a::FiniteList<s, n> st {value = \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors)} from chosen
        by def $has_unique_coordinates(s, v, space, n, vectors)
    claim:
        ? forall:
            $has_unique_coordinates(s, v, space, n, vectors)
            =>:
                $is_basis(s, v, space, n, vectors)
        by def $has_unique_coordinates(s, v, space, n, vectors)
        claim:
            ? $chap2a::spans(s, v, space, n, vectors)
            claim:
                ? v $subset \chap2a::span<s, v, space, n, vectors>
                claim:
                    ? forall value v:
                        value $in \chap2a::span<s, v, space, n, vectors>
                    obtain coefficients from exist! coefficients &chap1a::FiniteList<s, n> st {value = \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors)}
                    by def $chap2a::is_linear_combination(s, v, space, n, value, vectors)
                    # A direct set_builder_member replay did not return a
                    # session event after five minutes under the new runtime.
                    value $in {x v: $chap2a::is_linear_combination(s, v, space, n, x, vectors)}
                    \chap2a::span<s, v, space, n, vectors> = {x v: $chap2a::is_linear_combination(s, v, space, n, x, vectors)}
                    value $in \chap2a::span<s, v, space, n, vectors>
                by def v $subset \chap2a::span<s, v, space, n, vectors>
            \chap2a::span<s, v, space, n, vectors> $subset v
            by extension \chap2a::span<s, v, space, n, vectors> = v
            by def $chap2a::spans(s, v, space, n, vectors)
        claim:
            ? $chap2a::is_linearly_independent(s, v, space, n, vectors)
            claim:
                ? forall coefficients &chap1a::FiniteList<s, n>:
                    \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
                    =>:
                        $chap2a::has_only_zero_coefficients(s, space.scalars, n, coefficients)
                have zero_coefficients &chap1a::FiniteList<s, n> = \chap2a::zero_coefficient_list<s, space.scalars, n>
                by thm chap2a::linear_combination_value_zero_coefficients(s, v, space, n, vectors)
                obtain chosen from exist! candidate &chap1a::FiniteList<s, n> st {space.zero = \chap2a::linear_combination_value<s, v, space, n>(candidate, vectors)}
                forall first, second &chap1a::FiniteList<s, n>:
                    space.zero = \chap2a::linear_combination_value<s, v, space, n>(first, vectors)
                    space.zero = \chap2a::linear_combination_value<s, v, space, n>(second, vectors)
                    =>:
                        first = second
                space.zero = \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors)
                space.zero = \chap2a::linear_combination_value<s, v, space, n>(zero_coefficients, vectors)
                coefficients = zero_coefficients
                claim:
                    ? forall idx N+:
                        idx <= n
                        =>:
                            coefficients.entries(idx) = space.scalars.zero
                    by thm chap2a::zero_coefficient_list_entry(s, space.scalars, n, zero_coefficients, idx)
                    coefficients.entries(idx) = zero_coefficients.entries(idx) = space.scalars.zero
                by def $chap2a::has_only_zero_coefficients(s, space.scalars, n, coefficients)
            by def $chap2a::is_linearly_independent(s, v, space, n, vectors)
        by def $is_basis(s, v, space, n, vectors)
    by def $basis_iff_unique_coordinates_statement(s, v, space, n, vectors)
# The reduction and extension theorems need the ordered notion of sublist.
# selected_indices is strictly increasing, so entries are retained in source
# order rather than merely chosen as an unordered subset.
prop is_sublist_index_selection(v nonempty_set, long_length, short_length N, long_list &chap1a::FiniteList<v, long_length>, short_list &chap1a::FiniteList<v, short_length>, selected_indices &chap1a::FiniteList<N+, short_length>):
    forall idx N+:
        idx <= short_length
        =>:
            selected_indices.entries(idx) <= long_length
            short_list.entries(idx) = long_list.entries(selected_indices.entries(idx))
    forall idx, j N+:
        idx < j
        j <= short_length
        =>:
            selected_indices.entries(idx) < selected_indices.entries(j)

prop is_order_preserving_sublist(v nonempty_set, long_length, short_length N, long_list &chap1a::FiniteList<v, long_length>, short_list &chap1a::FiniteList<v, short_length>):
    short_length <= long_length
    exist selected_indices &chap1a::FiniteList<N+, short_length> st {$is_sublist_index_selection(v, long_length, short_length, long_list, short_list, selected_indices)}
# An order-preserving sublist with the same finite length keeps every index.
# The proof first bounds the selected index at position i below and above by i,
# then applies Chapter 1 finite-list extensionality.
thm equal_length_order_preserving_sublist_equal:
    ? forall v nonempty_set, n N, long_list, short_list &chap1a::FiniteList<v, n>:
        $is_order_preserving_sublist(v, n, n, long_list, short_list)
        =>:
            long_list = short_list
    by def $is_order_preserving_sublist(v, n, n, long_list, short_list)
    obtain selected_indices from exist selected_indices &chap1a::FiniteList<N+, n> st {$is_sublist_index_selection(v, n, n, long_list, short_list, selected_indices)}
    by def $is_sublist_index_selection(v, n, n, long_list, short_list, selected_indices)
    claim:
        ? forall idx N+:
            idx <= n
            =>:
                selected_indices.entries(idx) >= idx
        have fn forward_indices(k N+) N+ by cases:
            case k <= n: selected_indices.entries(k)
            case k > n: k
        claim:
            ? forall left_index, right_index N+:
                left_index < right_index
                =>:
                    forward_indices(left_index) < forward_indices(right_index)
            left_index <= n or left_index > n
            right_index <= n or right_index > n
            by cases:
                ? forward_indices(left_index) < forward_indices(right_index)
                case left_index <= n:
                    by cases:
                        ? forward_indices(left_index) < forward_indices(right_index)
                        case right_index <= n:
                            selected_indices.entries(left_index) < selected_indices.entries(right_index)
                            forward_indices(left_index) = selected_indices.entries(left_index)
                            forward_indices(right_index) = selected_indices.entries(right_index)
                            forward_indices(left_index) < forward_indices(right_index)
                        case right_index > n:
                            selected_indices.entries(left_index) <= n
                            forward_indices(left_index) = selected_indices.entries(left_index) <= n < right_index = forward_indices(right_index)
                case left_index > n:
                    right_index > n
                    forward_indices(left_index) = left_index < right_index = forward_indices(right_index)
        claim:
            ? forall k N+:
                forward_indices(k) >= k
            by induc k from 1:
                ? forward_indices(k) >= k
                ? from k = 1:
                    forward_indices(1) $in N+
                    forward_indices(1) >= 1
                ? induc:
                    forward_indices(k) >= k
                    forward_indices(k) < forward_indices(k + 1)
                    forward_indices(k + 1) >= forward_indices(k) + 1 >= k + 1
        forward_indices(idx) = selected_indices.entries(idx)
        forward_indices(idx) >= idx
        selected_indices.entries(idx) >= idx
    claim:
        ? forall idx N+:
            idx <= n
            =>:
                selected_indices.entries(idx) <= idx
        # The constructive reverse-index argument reaches repeated natural
        # subtraction bounds and dependent local-function replay.
        trust selected_indices.entries(idx) <= idx
    claim:
        ? forall idx N+:
            idx <= n
            =>:
                long_list.entries(idx) = short_list.entries(idx)
        selected_indices.entries(idx) >= idx
        selected_indices.entries(idx) <= idx
        selected_indices.entries(idx) = idx
        short_list.entries(idx) = long_list.entries(selected_indices.entries(idx)) = long_list.entries(idx)
        long_list.entries(idx) = short_list.entries(idx)
    by def $chap1a::have_same_finite_list_entries(v, n, long_list, short_list)
    by thm chap1a::finite_list_extensionality(v, n, long_list, short_list)

# The same theorem across propositionally equal dependent length indices.
# This isolates the current dependent-record transport boundary once instead
# of trusting equality separately in Results 2.38 and 2.42.
thm equal_length_order_preserving_sublist_dependent_equal:
    ? forall v nonempty_set, long_length, short_length N, long_list &chap1a::FiniteList<v, long_length>, short_list &chap1a::FiniteList<v, short_length>:
        $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
        long_length = short_length
        =>:
            long_list = short_list
    have transported_short &chap1a::FiniteList<v, long_length> = short_list
    claim:
        ? $is_order_preserving_sublist(v, long_length, long_length, long_list, transported_short)
        by def $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
        obtain selected_indices from exist selected_indices &chap1a::FiniteList<N+, short_length> st {$is_sublist_index_selection(v, long_length, short_length, long_list, short_list, selected_indices)}
        by def $is_sublist_index_selection(v, long_length, short_length, long_list, short_list, selected_indices)
        have transported_indices &chap1a::FiniteList<N+, long_length> = selected_indices
        claim:
            ? $is_sublist_index_selection(v, long_length, long_length, long_list, transported_short, transported_indices)
            claim:
                ? forall idx N+:
                    idx <= long_length
                    =>:
                        transported_indices.entries(idx) <= long_length
                        transported_short.entries(idx) = long_list.entries(transported_indices.entries(idx))
                idx <= short_length
                transported_indices.entries(idx) = selected_indices.entries(idx)
                transported_short.entries(idx) = short_list.entries(idx)
                selected_indices.entries(idx) <= long_length
                short_list.entries(idx) = long_list.entries(selected_indices.entries(idx))
                transported_indices.entries(idx) <= long_length
                transported_short.entries(idx) = long_list.entries(transported_indices.entries(idx))
            claim:
                ? forall idx, j N+:
                    idx < j
                    j <= long_length
                    =>:
                        transported_indices.entries(idx) < transported_indices.entries(j)
                j <= short_length
                idx <= short_length
                transported_indices.entries(idx) = selected_indices.entries(idx)
                transported_indices.entries(j) = selected_indices.entries(j)
                selected_indices.entries(idx) < selected_indices.entries(j)
                transported_indices.entries(idx) < transported_indices.entries(j)
            by def $is_sublist_index_selection(v, long_length, long_length, long_list, transported_short, transported_indices)
        witness exist chosen_indices &chap1a::FiniteList<N+, long_length> st {$is_sublist_index_selection(v, long_length, long_length, long_list, transported_short, chosen_indices)} from transported_indices
        by def $is_order_preserving_sublist(v, long_length, long_length, long_list, transported_short)
    by thm equal_length_order_preserving_sublist_equal(v, long_length, long_list, transported_short)
    long_list = transported_short = short_list
# Unnumbered example before Result 2.30. The spanning list
# (1,2),(3,6),(4,7),(5,9) reduces in source order to (1,2),(4,7) after the
# second and fourth entries are recognized as redundant.
thm removed_entry_of_order_preserving_sublist_is_order_preserving:
    ? forall v nonempty_set, long_length N, short_length N+, long_list &chap1a::FiniteList<v, long_length>, short_list &chap1a::FiniteList<v, short_length>, k N+, reduced &chap1a::FiniteList<v, short_length - 1>:
        $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
        $chap2a::is_list_with_index_removed(v, short_length, short_list, k, reduced)
        =>:
            $is_order_preserving_sublist(v, long_length, short_length - 1, long_list, reduced)
    by def $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
    obtain selected from exist selected_indices &chap1a::FiniteList<N+, short_length> st {$is_sublist_index_selection(v, long_length, short_length, long_list, short_list, selected_indices)}
    by def $is_sublist_index_selection(v, long_length, short_length, long_list, short_list, selected)
    by def $chap2a::is_list_with_index_removed(v, short_length, short_list, k, reduced)
    claim:
        ? forall idx N+:
            idx <= short_length - 1
            =>:
                idx + 1 <= short_length
        by thm chap2a::successor_le_from_le_predecessor(idx, short_length)
    have fn total_selected_index(position N+) N+ by cases:
        case position <= short_length: selected.entries(position)
        case position > short_length: selected.entries(1)
    have fn reduced_index_entries(idx N+: idx <= short_length - 1) N+ by cases:
        case idx < k: selected.entries(idx)
        case idx >= k: total_selected_index(idx + 1)
    have reduced_indices &chap1a::FiniteList<N+, short_length - 1> = (short_length - 1, reduced_index_entries)
    reduced_indices.entries = reduced_index_entries
    claim:
        ? $is_sublist_index_selection(v, long_length, short_length - 1, long_list, reduced, reduced_indices)
        claim:
            ? forall idx N+:
                idx <= short_length - 1
                =>:
                    reduced_indices.entries(idx) <= long_length
            by cases:
                ? reduced_indices.entries(idx) <= long_length
                case idx < k:
                    reduced_index_entries(idx) = selected.entries(idx)
                    reduced_indices.entries(idx) = reduced_index_entries(idx) = selected.entries(idx)
                    selected.entries(idx) <= long_length
                case idx >= k:
                    by thm chap2a::successor_le_from_le_predecessor(idx, short_length)
                    idx <= short_length - 1 < short_length
                    total_selected_index(idx + 1) = selected.entries(idx + 1)
                    reduced_index_entries(idx) = total_selected_index(idx + 1)
                    reduced_indices.entries(idx) = reduced_index_entries(idx) = total_selected_index(idx + 1) = selected.entries(idx + 1)
                    selected.entries(idx + 1) <= long_length
        claim:
            ? forall idx N+:
                idx <= short_length - 1
                =>:
                    reduced.entries(idx) = long_list.entries(reduced_indices.entries(idx))
            by cases:
                ? reduced.entries(idx) = long_list.entries(reduced_indices.entries(idx))
                case idx < k:
                    reduced_index_entries(idx) = selected.entries(idx)
                    reduced_indices.entries(idx) = reduced_index_entries(idx) = selected.entries(idx)
                    reduced.entries(idx) = short_list.entries(idx)
                    short_list.entries(idx) = long_list.entries(selected.entries(idx))
                    reduced.entries(idx) = long_list.entries(reduced_indices.entries(idx))
                case idx >= k:
                    by thm chap2a::successor_le_from_le_predecessor(idx, short_length)
                    idx <= short_length - 1 < short_length
                    total_selected_index(idx + 1) = selected.entries(idx + 1)
                    reduced_index_entries(idx) = total_selected_index(idx + 1)
                    reduced_indices.entries(idx) = reduced_index_entries(idx) = total_selected_index(idx + 1) = selected.entries(idx + 1)
                    reduced.entries(idx) = short_list.entries(idx + 1)
                    short_list.entries(idx + 1) = long_list.entries(selected.entries(idx + 1))
                    reduced.entries(idx) = long_list.entries(reduced_indices.entries(idx))
        claim:
            ? forall idx, j N+:
                idx < j
                j <= short_length - 1
                =>:
                    reduced_indices.entries(idx) < reduced_indices.entries(j)
            by thm chap2a::successor_le_from_le_predecessor(j, short_length)
            by cases:
                ? reduced_indices.entries(idx) < reduced_indices.entries(j)
                case j < k:
                    idx < j < k
                    reduced_index_entries(idx) = selected.entries(idx)
                    reduced_index_entries(j) = selected.entries(j)
                    reduced_indices.entries(idx) = reduced_index_entries(idx) = selected.entries(idx)
                    reduced_indices.entries(j) = reduced_index_entries(j) = selected.entries(j)
                    selected.entries(idx) < selected.entries(j)
                case j >= k:
                    by cases:
                        ? reduced_indices.entries(idx) < reduced_indices.entries(j)
                        case idx < k:
                            idx < j + 1
                            total_selected_index(j + 1) = selected.entries(j + 1)
                            reduced_index_entries(idx) = selected.entries(idx)
                            reduced_index_entries(j) = total_selected_index(j + 1)
                            reduced_indices.entries(idx) = reduced_index_entries(idx) = selected.entries(idx)
                            reduced_indices.entries(j) = reduced_index_entries(j) = total_selected_index(j + 1) = selected.entries(j + 1)
                            selected.entries(idx) < selected.entries(j + 1)
                        case idx >= k:
                            idx + 1 < j + 1
                            by thm chap2a::successor_le_from_le_predecessor(idx, short_length)
                            total_selected_index(idx + 1) = selected.entries(idx + 1)
                            total_selected_index(j + 1) = selected.entries(j + 1)
                            reduced_index_entries(idx) = total_selected_index(idx + 1)
                            reduced_index_entries(j) = total_selected_index(j + 1)
                            reduced_indices.entries(idx) = reduced_index_entries(idx) = total_selected_index(idx + 1) = selected.entries(idx + 1)
                            reduced_indices.entries(j) = reduced_index_entries(j) = total_selected_index(j + 1) = selected.entries(j + 1)
                            selected.entries(idx + 1) < selected.entries(j + 1)
        by def $is_sublist_index_selection(v, long_length, short_length - 1, long_list, reduced, reduced_indices)
    short_length - 1 <= short_length <= long_length
    witness exist chosen_indices &chap1a::FiniteList<N+, short_length - 1> st {$is_sublist_index_selection(v, long_length, short_length - 1, long_list, reduced, chosen_indices)} from reduced_indices
    by def $is_order_preserving_sublist(v, long_length, short_length - 1, long_list, reduced)

# Result 2.30. Every spanning list has an order-preserving sublist that is a
# basis. Rather than encode the source's deletion loop as an algorithm, take
# a shortest spanning order-preserving sublist. If it were dependent, Result
# 2.19 and the preceding deletion/sublist lemma would produce a shorter one.
prop is_spanning_sublist_length(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, m N):
    m <= n
    exist candidate &chap1a::FiniteList<v, m> st {$is_order_preserving_sublist(v, n, m, vectors, candidate), $chap2a::spans(s, v, space, m, candidate)}

thm spanning_list_reduces_to_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $chap2a::spans(s, v, space, n, vectors)
        =>:
            exist m N, basis_vectors &chap1a::FiniteList<v, m> st {$is_order_preserving_sublist(v, n, m, vectors, basis_vectors), $is_basis(s, v, space, m, basis_vectors)}
    have inadmissible_lengths set = {m N: not $is_spanning_sublist_length(s, v, space, n, vectors, m)}
    have admissible_lengths set = set_minus(closed_range(0, n), inadmissible_lengths)
    $is_finite_set(closed_range(0, n))
    $is_finite_set(set_minus(closed_range(0, n), inadmissible_lengths))
    by def closed_range(0, n) $subset N
    set_minus(closed_range(0, n), inadmissible_lengths) $subset N
    by def set_minus(closed_range(0, n), inadmissible_lengths) $subset R
    claim:
        ? n $in admissible_lengths
        claim:
            ? $is_order_preserving_sublist(v, n, n, vectors, vectors)
            have fn identity_indices(idx N+: idx <= n) N+ = idx
            have selected_indices &chap1a::FiniteList<N+, n> = (n, identity_indices)
            selected_indices.entries = identity_indices
            claim:
                ? $is_sublist_index_selection(v, n, n, vectors, vectors, selected_indices)
                claim:
                    ? forall idx N+:
                        idx <= n
                        =>:
                            selected_indices.entries(idx) <= n
                            vectors.entries(idx) = vectors.entries(selected_indices.entries(idx))
                    selected_indices.entries(idx) = identity_indices(idx) = idx
                claim:
                    ? forall idx, j N+:
                        idx < j
                        j <= n
                        =>:
                            selected_indices.entries(idx) < selected_indices.entries(j)
                    selected_indices.entries(idx) = identity_indices(idx) = idx
                    selected_indices.entries(j) = identity_indices(j) = j
                by def $is_sublist_index_selection(v, n, n, vectors, vectors, selected_indices)
            witness exist chosen_indices &chap1a::FiniteList<N+, n> st {$is_sublist_index_selection(v, n, n, vectors, vectors, chosen_indices)} from selected_indices
            by def $is_order_preserving_sublist(v, n, n, vectors, vectors)
        witness exist candidate &chap1a::FiniteList<v, n> st {$is_order_preserving_sublist(v, n, n, vectors, candidate), $chap2a::spans(s, v, space, n, candidate)} from vectors
        n <= n
        by def $is_spanning_sublist_length(s, v, space, n, vectors, n)
        claim:
            ? not n $in inadmissible_lengths
            by contra:
                ? not n $in inadmissible_lengths
                not $is_spanning_sublist_length(s, v, space, n, vectors, n)
                impossible $is_spanning_sublist_length(s, v, space, n, vectors, n)
        n $in set_minus(closed_range(0, n), inadmissible_lengths)
    witness $is_nonempty_set(set_minus(closed_range(0, n), inadmissible_lengths)) from n
    have m N = finite_set_min(set_minus(closed_range(0, n), inadmissible_lengths))
    finite_set_min(set_minus(closed_range(0, n), inadmissible_lengths)) $in set_minus(closed_range(0, n), inadmissible_lengths)
    m $in set_minus(closed_range(0, n), inadmissible_lengths)
    claim:
        ? $is_spanning_sublist_length(s, v, space, n, vectors, m)
        by contra:
            ? $is_spanning_sublist_length(s, v, space, n, vectors, m)
            m $in inadmissible_lengths
            not m $in inadmissible_lengths
            impossible m $in inadmissible_lengths
    by def $is_spanning_sublist_length(s, v, space, n, vectors, m)
    obtain basis_vectors from exist candidate &chap1a::FiniteList<v, m> st {$is_order_preserving_sublist(v, n, m, vectors, candidate), $chap2a::spans(s, v, space, m, candidate)}
    claim:
        ? $chap2a::is_linearly_independent(s, v, space, m, basis_vectors)
        by contra:
            ? $chap2a::is_linearly_independent(s, v, space, m, basis_vectors)
            by def $chap2a::is_linearly_dependent(s, v, space, m, basis_vectors)
            by thm chap2a::linear_dependence_lemma(s, v, space, m, basis_vectors)
            obtain k, predecessors, reduced from exist selected_k N+, selected_predecessors &chap1a::FiniteList<v, selected_k - 1>, selected_reduced &chap1a::FiniteList<v, m - 1> st {selected_k <= m, $chap2a::is_prefix_of_length(v, m, selected_k - 1, basis_vectors, selected_predecessors), basis_vectors.entries(selected_k) $in \chap2a::span_carrier<s, v, space, selected_k - 1, selected_predecessors>, $chap2a::is_list_with_index_removed(v, m, basis_vectors, selected_k, selected_reduced), \chap2a::span_carrier<s, v, space, m - 1, selected_reduced> = \chap2a::span_carrier<s, v, space, m, basis_vectors>}
            by thm removed_entry_of_order_preserving_sublist_is_order_preserving(v, n, m, vectors, basis_vectors, k, reduced)
            by def $chap2a::spans(s, v, space, m, basis_vectors)
            \chap2a::span_carrier<s, v, space, m - 1, reduced> = \chap2a::span_carrier<s, v, space, m, basis_vectors> = v
            by def $chap2a::spans(s, v, space, m - 1, reduced)
            m - 1 <= n
            witness exist candidate &chap1a::FiniteList<v, m - 1> st {$is_order_preserving_sublist(v, n, m - 1, vectors, candidate), $chap2a::spans(s, v, space, m - 1, candidate)} from reduced
            by def $is_spanning_sublist_length(s, v, space, n, vectors, m - 1)
            claim:
                ? not m - 1 $in inadmissible_lengths
                by contra:
                    ? not m - 1 $in inadmissible_lengths
                    not $is_spanning_sublist_length(s, v, space, n, vectors, m - 1)
                    impossible $is_spanning_sublist_length(s, v, space, n, vectors, m - 1)
            m - 1 $in set_minus(closed_range(0, n), inadmissible_lengths)
            m <= m - 1
            m $in N+
            m - 1 < m
            impossible m <= m - 1
    by def $is_basis(s, v, space, m, basis_vectors)
    witness exist selected_length N, selected_basis &chap1a::FiniteList<v, selected_length> st {$is_order_preserving_sublist(v, n, selected_length, vectors, selected_basis), $is_basis(s, v, space, selected_length, selected_basis)} from m, basis_vectors

thm finite_dimensional_has_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>:
        $chap2a::is_finite_dimensional(s, v, space)
        =>:
            exist n N, basis_vectors &chap1a::FiniteList<v, n> st {$is_basis(s, v, space, n, basis_vectors)}

    by def $chap2a::is_finite_dimensional(s, v, space)
    obtain n, vectors from exist n N, vectors &chap1a::FiniteList<v, n> st {$chap2a::spans(s, v, space, n, vectors)}
    by thm spanning_list_reduces_to_basis(s, v, space, n, vectors)
    obtain m, basis_vectors from exist m N, basis_vectors &chap1a::FiniteList<v, m> st {$is_order_preserving_sublist(v, n, m, vectors, basis_vectors), $is_basis(s, v, space, m, basis_vectors)}
    witness exist basis_length N, basis &chap1a::FiniteList<v, basis_length> st {$is_basis(s, v, space, basis_length, basis)} from m, basis_vectors

prop is_concatenation_right_index(left_length, right_length N, idx, shifted N+):
    shifted = idx - left_length
    shifted <= right_length

thm concatenation_right_index_exists_unique:
    ? forall left_length, right_length N, idx N+:
        idx <= left_length + right_length
        idx > left_length
        =>:
            exist! shifted N+ st {$is_concatenation_right_index(left_length, right_length, idx, shifted)}
    idx - left_length >= 1
    idx - left_length $in Z
    idx - left_length $in N+
    left_length + right_length = right_length + left_length
    idx <= right_length + left_length
    idx - left_length <= right_length
    by def $is_concatenation_right_index(left_length, right_length, idx, idx - left_length)
    claim:
        ? forall shifted1, shifted2 N+:
            $is_concatenation_right_index(left_length, right_length, idx, shifted1)
            $is_concatenation_right_index(left_length, right_length, idx, shifted2)
            =>:
                shifted1 = shifted2
        by def $is_concatenation_right_index(left_length, right_length, idx, shifted1)
        by def $is_concatenation_right_index(left_length, right_length, idx, shifted2)
        shifted1 = idx - left_length = shifted2
    have selected_shift N+ = idx - left_length
    witness exist! shifted N+ st {$is_concatenation_right_index(left_length, right_length, idx, shifted)} from selected_shift

thm finite_lists_have_ordered_concatenation:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, left_length, right_length N, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>:
        exist combined &chap1a::FiniteList<v, left_length + right_length> st {$chap2a::is_prefix_of_length(v, left_length + right_length, left_length, combined, left), $is_order_preserving_sublist(v, left_length + right_length, left_length, combined, left), $is_order_preserving_sublist(v, left_length + right_length, right_length, combined, right)}
    have fn right_index by exist!:
        ? forall idx N+:
            idx <= left_length + right_length
            idx > left_length
            =>:
                exist! shifted N+ st {shifted = idx - left_length, shifted <= right_length}
        idx - left_length >= 1
        idx - left_length $in Z
        idx - left_length $in N+
        left_length + right_length = right_length + left_length
        idx <= right_length + left_length
        idx - left_length <= right_length
        claim:
            ? forall shifted1, shifted2 N+:
                shifted1 = idx - left_length
                shifted1 <= right_length
                shifted2 = idx - left_length
                shifted2 <= right_length
                =>:
                    shifted1 = shifted2
            shifted1 = idx - left_length = shifted2
        have selected_shift N+ = idx - left_length
        witness exist! shifted N+ st {shifted = idx - left_length, shifted <= right_length} from selected_shift
    have fn total_right_entry(position N+) v by cases:
        case position <= right_length: right.entries(position)
        case position > right_length: space.zero
    have fn combined_entries(idx N+: idx <= left_length + right_length) v by cases:
        case idx <= left_length: left.entries(idx)
        case idx > left_length: total_right_entry(right_index(idx))
    have combined &chap1a::FiniteList<v, left_length + right_length> = (left_length + right_length, combined_entries)
    combined.entries = combined_entries
    claim:
        ? forall idx N+:
            idx <= left_length
            =>:
                combined.entries(idx) = left.entries(idx)
        combined.entries = combined_entries
        combined_entries(idx) = left.entries(idx)
        combined.entries(idx) = combined_entries(idx) = left.entries(idx)
    claim:
        ? $chap2a::is_prefix_of_length(v, left_length + right_length, left_length, combined, left)
        by def $chap2a::is_prefix_of_length(v, left_length + right_length, left_length, combined, left)
    claim:
        ? forall idx N+:
            idx <= right_length
            =>:
                combined.entries(left_length + idx) = right.entries(idx)
        left_length + idx $in N+
        left_length + idx <= left_length + right_length
        left_length + idx > left_length
        right_index(left_length + idx) = left_length + idx - left_length = idx
        right_index(left_length + idx) <= right_length
        total_right_entry(idx) = right.entries(idx)
        combined.entries = combined_entries
        combined_entries(left_length + idx) = total_right_entry(right_index(left_length + idx)) = total_right_entry(idx) = right.entries(idx)
        combined.entries(left_length + idx) = combined_entries(left_length + idx) = right.entries(idx)
    claim:
        ? $is_order_preserving_sublist(v, left_length + right_length, left_length, combined, left)
        have fn left_indices(idx N+: idx <= left_length) N+ = idx
        have selected &chap1a::FiniteList<N+, left_length> = (left_length, left_indices)
        selected.entries = left_indices
        claim:
            ? $is_sublist_index_selection(v, left_length + right_length, left_length, combined, left, selected)
            claim:
                ? forall idx N+:
                    idx <= left_length
                    =>:
                        selected.entries(idx) <= left_length + right_length
                        left.entries(idx) = combined.entries(selected.entries(idx))
                selected.entries(idx) = left_indices(idx) = idx
                combined.entries(idx) = left.entries(idx)
            claim:
                ? forall idx, j N+:
                    idx < j
                    j <= left_length
                    =>:
                        selected.entries(idx) < selected.entries(j)
                selected.entries(idx) = left_indices(idx) = idx
                selected.entries(j) = left_indices(j) = j
            by def $is_sublist_index_selection(v, left_length + right_length, left_length, combined, left, selected)
        witness exist chosen &chap1a::FiniteList<N+, left_length> st {$is_sublist_index_selection(v, left_length + right_length, left_length, combined, left, chosen)} from selected
        by def $is_order_preserving_sublist(v, left_length + right_length, left_length, combined, left)
    claim:
        ? $is_order_preserving_sublist(v, left_length + right_length, right_length, combined, right)
        have fn right_indices(idx N+: idx <= right_length) N+ = left_length + idx
        have selected &chap1a::FiniteList<N+, right_length> = (right_length, right_indices)
        selected.entries = right_indices
        claim:
            ? $is_sublist_index_selection(v, left_length + right_length, right_length, combined, right, selected)
            claim:
                ? forall idx N+:
                    idx <= right_length
                    =>:
                        selected.entries(idx) <= left_length + right_length
                        right.entries(idx) = combined.entries(selected.entries(idx))
                selected.entries = right_indices
                selected.entries(idx) = right_indices(idx) = left_length + idx
                left_length + idx <= left_length + right_length
                combined.entries(left_length + idx) = right.entries(idx)
            claim:
                ? forall idx, j N+:
                    idx < j
                    j <= right_length
                    =>:
                        selected.entries(idx) < selected.entries(j)
                selected.entries(idx) = right_indices(idx) = left_length + idx
                selected.entries(j) = right_indices(j) = left_length + j
                left_length + idx < left_length + j
            by def $is_sublist_index_selection(v, left_length + right_length, right_length, combined, right, selected)
        witness exist chosen &chap1a::FiniteList<N+, right_length> st {$is_sublist_index_selection(v, left_length + right_length, right_length, combined, right, chosen)} from selected
        by def $is_order_preserving_sublist(v, left_length + right_length, right_length, combined, right)
    witness exist selected &chap1a::FiniteList<v, left_length + right_length> st {$chap2a::is_prefix_of_length(v, left_length + right_length, left_length, selected, left), $is_order_preserving_sublist(v, left_length + right_length, left_length, selected, left), $is_order_preserving_sublist(v, left_length + right_length, right_length, selected, right)} from combined

thm order_preserving_sublist_span_is_contained:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, long_length, short_length N, long_list &chap1a::FiniteList<v, long_length>, short_list &chap1a::FiniteList<v, short_length>:
        $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
        =>:
            \chap2a::span_carrier<s, v, space, short_length, short_list> $subset \chap2a::span_carrier<s, v, space, long_length, long_list>
    by thm chap2a::span_contains_list_entries(s, v, space, long_length, long_list)
    by def $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
    obtain selected_indices from exist indices &chap1a::FiniteList<N+, short_length> st {$is_sublist_index_selection(v, long_length, short_length, long_list, short_list, indices)}
    by def $is_sublist_index_selection(v, long_length, short_length, long_list, short_list, selected_indices)
    claim:
        ? $chap2a::contains_list_entries(v, short_length, short_list, \chap2a::span_carrier<s, v, space, long_length, long_list>)
        claim:
            ? forall idx N+:
                idx <= short_length
                =>:
                    short_list.entries(idx) $in \chap2a::span_carrier<s, v, space, long_length, long_list>
            selected_indices.entries(idx) <= long_length
            long_list.entries(selected_indices.entries(idx)) $in \chap2a::span_carrier<s, v, space, long_length, long_list>
            short_list.entries(idx) = long_list.entries(selected_indices.entries(idx))
            short_list.entries(idx) $in \chap2a::span_carrier<s, v, space, long_length, long_list>
        by def $chap2a::contains_list_entries(v, short_length, short_list, \chap2a::span_carrier<s, v, space, long_length, long_list>)
    by thm chap2a::span_is_subspace(s, v, space, long_length, long_list)
    by thm chap2a::span_is_smallest_subspace(s, v, space, short_length, short_list, \chap2a::span_carrier<s, v, space, long_length, long_list>)

thm mutual_subset_implies_set_equal:
    ? forall A, B set:
        A $subset B
        B $subset A
        =>:
            A = B
    by extension A = B

thm spanning_sublist_makes_long_list_spanning:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, long_length, short_length N, long_list &chap1a::FiniteList<v, long_length>, short_list &chap1a::FiniteList<v, short_length>:
        $is_order_preserving_sublist(v, long_length, short_length, long_list, short_list)
        $chap2a::spans(s, v, space, short_length, short_list)
        =>:
            $chap2a::spans(s, v, space, long_length, long_list)
    by thm order_preserving_sublist_span_is_contained(s, v, space, long_length, short_length, long_list, short_list)
    by def $chap2a::spans(s, v, space, short_length, short_list)
    by thm chap2a::span_carrier_spec(s, v, space, short_length, short_list)
    \chap2a::span_carrier<s, v, space, short_length, short_list> = v
    v $subset \chap2a::span_carrier<s, v, space, long_length, long_list>
    \chap2a::span_carrier<s, v, space, long_length, long_list> $subset v
    by thm mutual_subset_implies_set_equal(\chap2a::span_carrier<s, v, space, long_length, long_list>, v)
    \chap2a::span_carrier<s, v, space, long_length, long_list> = v
    by thm chap2a::span_carrier_spec(s, v, space, long_length, long_list)
    \chap2a::span<s, v, space, long_length, long_list> = v
    by def $chap2a::spans(s, v, space, long_length, long_list)

thm spanning_list_can_be_appended_to_prefix:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, left_length, right_length N, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>:
        $chap2a::spans(s, v, space, right_length, right)
        =>:
            exist combined &chap1a::FiniteList<v, left_length + right_length> st {$chap2a::is_prefix_of_length(v, left_length + right_length, left_length, combined, left), $chap2a::spans(s, v, space, left_length + right_length, combined)}
    by thm finite_lists_have_ordered_concatenation(s, v, space, left_length, right_length, left, right)
    obtain combined from exist selected &chap1a::FiniteList<v, left_length + right_length> st {$chap2a::is_prefix_of_length(v, left_length + right_length, left_length, selected, left), $is_order_preserving_sublist(v, left_length + right_length, left_length, selected, left), $is_order_preserving_sublist(v, left_length + right_length, right_length, selected, right)}
    by thm spanning_sublist_makes_long_list_spanning(s, v, space, left_length + right_length, right_length, combined, right)
    witness exist selected &chap1a::FiniteList<v, left_length + right_length> st {$chap2a::is_prefix_of_length(v, left_length + right_length, left_length, selected, left), $chap2a::spans(s, v, space, left_length + right_length, selected)} from combined

thm independent_entry_not_in_predecessor_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, k N+, predecessors &chap1a::FiniteList<v, k - 1>:
        $chap2a::is_linearly_independent(s, v, space, n, vectors)
        k <= n
        $chap2a::is_prefix_of_length(v, n, k - 1, vectors, predecessors)
        =>:
            not vectors.entries(k) $in \chap2a::span_carrier<s, v, space, k - 1, predecessors>
    by contra:
        ? not vectors.entries(k) $in \chap2a::span_carrier<s, v, space, k - 1, predecessors>
        by thm chap2a::span_carrier_spec(s, v, space, k - 1, predecessors)
        vectors.entries(k) $in \chap2a::span<s, v, space, k - 1, predecessors>
        \chap2a::span<s, v, space, k - 1, predecessors> = {value v: $chap2a::is_linear_combination(s, v, space, k - 1, value, predecessors)}
        $chap2a::is_linear_combination(s, v, space, k - 1, vectors.entries(k), predecessors)
        by def $chap2a::is_linear_combination(s, v, space, k - 1, vectors.entries(k), predecessors)
        obtain predecessor_coefficients from exist coefficients &chap1a::FiniteList<s, k - 1> st {vectors.entries(k) = \chap2a::linear_combination_value<s, v, space, k - 1>(coefficients, predecessors)}
        by thm chap2a::linear_combination_value_satisfies_spec(s, v, space, k - 1, predecessor_coefficients, predecessors)
        obtain predecessor_trace from exist trace fn(j closed_range(0, k - 1)) v st {$chap2a::is_linear_combination_partial_sum_sequence(s, v, space, k - 1, predecessor_coefficients, predecessors, trace), \chap2a::linear_combination_value<s, v, space, k - 1>(predecessor_coefficients, predecessors) = trace(k - 1)}
        predecessor_trace(k - 1) = vectors.entries(k)
        have fn tail_coefficient(idx N+) s by cases:
            case idx = k: space.scalars.neg(space.scalars.one)
            case idx != k: space.scalars.zero
        have fn full_coefficient_entries(idx N+: idx <= n) s by cases:
            case idx < k: predecessor_coefficients.entries(idx)
            case idx >= k: tail_coefficient(idx)
        have coefficients &chap1a::FiniteList<s, n> = (n, full_coefficient_entries)
        coefficients.entries = full_coefficient_entries
        have fn full_trace(j closed_range(0, n)) v by cases:
            case j < k: predecessor_trace(j)
            case j >= k: space.zero
        claim:
            ? $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, full_trace)
            by def $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, k - 1, predecessor_coefficients, predecessors, predecessor_trace)
            by def $chap2a::is_prefix_of_length(v, n, k - 1, vectors, predecessors)
            0 < k
            full_trace(0) = predecessor_trace(0) = space.zero
            claim:
                ? forall j N+:
                    j <= n
                    =>:
                        full_trace(j) = space.add(full_trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j)))
                by cases:
                    ? full_trace(j) = space.add(full_trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j)))
                    case j < k:
                        j <= k - 1
                        j - 1 < k
                        full_trace(j) = predecessor_trace(j)
                        full_trace(j - 1) = predecessor_trace(j - 1)
                        coefficients.entries = full_coefficient_entries
                        full_coefficient_entries(j) = predecessor_coefficients.entries(j)
                        coefficients.entries(j) = full_coefficient_entries(j) = predecessor_coefficients.entries(j)
                        predecessors.entries(j) = vectors.entries(j)
                        predecessor_trace(j) = space.add(predecessor_trace(j - 1), space.smul(predecessor_coefficients.entries(j), predecessors.entries(j)))
                        space.add(full_trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j))) = space.add(predecessor_trace(j - 1), space.smul(predecessor_coefficients.entries(j), predecessors.entries(j))) = predecessor_trace(j) = full_trace(j)
                        full_trace(j) = space.add(full_trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j)))
                    case j = k:
                        j - 1 = k - 1
                        k - 1 < k
                        j - 1 < k
                        full_trace(j - 1) = predecessor_trace(j - 1)
                        predecessor_trace(j - 1) = predecessor_trace(k - 1)
                        full_trace(j - 1) = predecessor_trace(k - 1) = vectors.entries(k) = vectors.entries(j)
                        full_trace(j) = space.zero
                        coefficients.entries = full_coefficient_entries
                        full_coefficient_entries(j) = tail_coefficient(j)
                        tail_coefficient(j) = space.scalars.neg(space.scalars.one)
                        coefficients.entries(j) = full_coefficient_entries(j) = tail_coefficient(j) = space.scalars.neg(space.scalars.one)
                        by thm chap1b::minus_one_times_vector(s, v, space, vectors.entries(j))
                        by thm chap1b::vector_neg_spec(s, v, space, vectors.entries(j))
                        space.add(full_trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j))) = space.add(vectors.entries(j), \chap1b::vector_neg<s, v, space>(vectors.entries(j))) = space.zero = full_trace(j)
                    case j > k:
                        j - 1 >= k
                        full_trace(j) = space.zero
                        full_trace(j - 1) = space.zero
                        coefficients.entries = full_coefficient_entries
                        j != k
                        full_coefficient_entries(j) = tail_coefficient(j)
                        tail_coefficient(j) = space.scalars.zero
                        coefficients.entries(j) = full_coefficient_entries(j) = tail_coefficient(j) = space.scalars.zero
                        by thm chap1b::zero_scalar_times_vector(s, v, space, vectors.entries(j))
                        space.smul(coefficients.entries(j), vectors.entries(j)) = space.zero
                        space.add(full_trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j))) = space.add(space.zero, space.zero) = space.zero = full_trace(j)
            by def $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, full_trace)
        claim:
            ? \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
            claim:
                ? $chap2a::has_linear_combination_value(s, v, space, n, coefficients, vectors, space.zero)
                witness exist trace fn(j closed_range(0, n)) v st {$chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace), space.zero = trace(n)} from full_trace
                by def $chap2a::has_linear_combination_value(s, v, space, n, coefficients, vectors, space.zero)
            by thm chap2a::linear_combination_value_satisfies_spec(s, v, space, n, coefficients, vectors)
            by thm chap2a::linear_combination_value_exists_unique(s, v, space, n, coefficients, vectors)
            obtain chosen_value from exist! value v st {$chap2a::has_linear_combination_value(s, v, space, n, coefficients, vectors, value)}
            \chap2a::linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
        by def $chap2a::is_linearly_independent(s, v, space, n, vectors)
        $chap2a::has_only_zero_coefficients(s, space.scalars, n, coefficients)
        by def $chap2a::has_only_zero_coefficients(s, space.scalars, n, coefficients)
        coefficients.entries(k) = space.scalars.zero
        coefficients.entries = full_coefficient_entries
        full_coefficient_entries(k) = tail_coefficient(k)
        tail_coefficient(k) = space.scalars.neg(space.scalars.one)
        coefficients.entries(k) = full_coefficient_entries(k) = tail_coefficient(k) = space.scalars.neg(space.scalars.one)
        space.scalars.neg(space.scalars.one) = space.scalars.zero
        space.scalars.add(space.scalars.one, space.scalars.neg(space.scalars.one)) = space.scalars.zero
        space.scalars.add(space.scalars.one, space.scalars.zero) = space.scalars.add(space.scalars.zero, space.scalars.one) = space.scalars.one
        space.scalars.zero = space.scalars.one
        impossible space.scalars.zero != space.scalars.one

thm dependent_deletion_after_independent_prefix:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, long_length N+, prefix_length N, long_list &chap1a::FiniteList<v, long_length>, prefix &chap1a::FiniteList<v, prefix_length>, k N+, predecessors &chap1a::FiniteList<v, k - 1>:
        $chap2a::is_linearly_independent(s, v, space, prefix_length, prefix)
        $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
        k <= long_length
        $chap2a::is_prefix_of_length(v, long_length, k - 1, long_list, predecessors)
        long_list.entries(k) $in \chap2a::span_carrier<s, v, space, k - 1, predecessors>
        =>:
            k > prefix_length
    by contra:
        ? k > prefix_length
        k <= prefix_length
        k - 1 <= prefix_length
        claim:
            ? $chap2a::is_prefix_of_length(v, prefix_length, k - 1, prefix, predecessors)
            by def $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
            by def $chap2a::is_prefix_of_length(v, long_length, k - 1, long_list, predecessors)
            claim:
                ? forall idx N+:
                    idx <= k - 1
                    =>:
                        predecessors.entries(idx) = prefix.entries(idx)
                idx <= k - 1 <= prefix_length
                predecessors.entries(idx) = long_list.entries(idx) = prefix.entries(idx)
            by def $chap2a::is_prefix_of_length(v, prefix_length, k - 1, prefix, predecessors)
        by thm independent_entry_not_in_predecessor_span(s, v, space, prefix_length, prefix, k, predecessors)
        not prefix.entries(k) $in \chap2a::span_carrier<s, v, space, k - 1, predecessors>
        by def $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
        long_list.entries(k) = prefix.entries(k)
        prefix.entries(k) $in \chap2a::span_carrier<s, v, space, k - 1, predecessors>
        impossible not prefix.entries(k) $in \chap2a::span_carrier<s, v, space, k - 1, predecessors>

thm deletion_after_prefix_preserves_prefix:
    ? forall v nonempty_set, long_length N+, prefix_length N, long_list &chap1a::FiniteList<v, long_length>, prefix &chap1a::FiniteList<v, prefix_length>, k N+, reduced &chap1a::FiniteList<v, long_length - 1>:
        $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
        $chap2a::is_list_with_index_removed(v, long_length, long_list, k, reduced)
        k > prefix_length
        =>:
            $chap2a::is_prefix_of_length(v, long_length - 1, prefix_length, reduced, prefix)
    by def $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
    by def $chap2a::is_list_with_index_removed(v, long_length, long_list, k, reduced)
    k <= long_length
    prefix_length < k <= long_length
    prefix_length <= long_length - 1
    claim:
        ? forall idx N+:
            idx <= prefix_length
            =>:
                prefix.entries(idx) = reduced.entries(idx)
        idx <= prefix_length < k
        reduced.entries(idx) = long_list.entries(idx)
        prefix.entries(idx) = long_list.entries(idx) = reduced.entries(idx)
    by def $chap2a::is_prefix_of_length(v, long_length - 1, prefix_length, reduced, prefix)

thm prefix_is_order_preserving_sublist:
    ? forall v nonempty_set, long_length, prefix_length N, long_list &chap1a::FiniteList<v, long_length>, prefix &chap1a::FiniteList<v, prefix_length>:
        $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
        =>:
            $is_order_preserving_sublist(v, long_length, prefix_length, long_list, prefix)
    by def $chap2a::is_prefix_of_length(v, long_length, prefix_length, long_list, prefix)
    have fn identity_indices(idx N+: idx <= prefix_length) N+ = idx
    have selected_indices &chap1a::FiniteList<N+, prefix_length> = (prefix_length, identity_indices)
    selected_indices.entries = identity_indices
    claim:
        ? $is_sublist_index_selection(v, long_length, prefix_length, long_list, prefix, selected_indices)
        claim:
            ? forall idx N+:
                idx <= prefix_length
                =>:
                    selected_indices.entries(idx) <= long_length
                    prefix.entries(idx) = long_list.entries(selected_indices.entries(idx))
            selected_indices.entries(idx) = identity_indices(idx) = idx
            idx <= prefix_length <= long_length
            prefix.entries(idx) = long_list.entries(idx) = long_list.entries(selected_indices.entries(idx))
        claim:
            ? forall idx, j N+:
                idx < j
                j <= prefix_length
                =>:
                    selected_indices.entries(idx) < selected_indices.entries(j)
            selected_indices.entries(idx) = identity_indices(idx) = idx
            selected_indices.entries(j) = identity_indices(j) = j
        by def $is_sublist_index_selection(v, long_length, prefix_length, long_list, prefix, selected_indices)
    witness exist chosen_indices &chap1a::FiniteList<N+, prefix_length> st {$is_sublist_index_selection(v, long_length, prefix_length, long_list, prefix, chosen_indices)} from selected_indices
    by def $is_order_preserving_sublist(v, long_length, prefix_length, long_list, prefix)

prop is_spanning_prefix_extension_length(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, prefix_length, maximum_length N, prefix &chap1a::FiniteList<v, prefix_length>, m N):
    prefix_length <= m
    m <= maximum_length
    exist candidate &chap1a::FiniteList<v, m> st {$chap2a::is_prefix_of_length(v, m, prefix_length, candidate, prefix), $chap2a::spans(s, v, space, m, candidate)}

# Result 2.32. Every independent list in a finite-dimensional vector space is
# an order-preserving sublist of some basis. The source appends a spanning list
# and reduces it without deleting an entry from the independent prefix.
# Take a shortest spanning extension that retains the independent prefix.
thm independent_list_extends_to_prefix_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $chap2a::is_finite_dimensional(s, v, space)
        $chap2a::is_linearly_independent(s, v, space, n, vectors)
        =>:
            exist m N, basis_vectors &chap1a::FiniteList<v, m> st {$chap2a::is_prefix_of_length(v, m, n, basis_vectors, vectors), $is_order_preserving_sublist(v, m, n, basis_vectors, vectors), $is_basis(s, v, space, m, basis_vectors)}
    by def $chap2a::is_finite_dimensional(s, v, space)
    obtain spanning_length, spanning_vectors from exist selected_length N, selected_vectors &chap1a::FiniteList<v, selected_length> st {$chap2a::spans(s, v, space, selected_length, selected_vectors)}
    by thm spanning_list_can_be_appended_to_prefix(s, v, space, n, spanning_length, vectors, spanning_vectors)
    obtain initial_extension from exist combined &chap1a::FiniteList<v, n + spanning_length> st {$chap2a::is_prefix_of_length(v, n + spanning_length, n, combined, vectors), $chap2a::spans(s, v, space, n + spanning_length, combined)}
    have maximum_length N = n + spanning_length
    have inadmissible_lengths set = {m N: not $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m)}
    have admissible_lengths set = set_minus(closed_range(0, maximum_length), inadmissible_lengths)
    $is_finite_set(closed_range(0, maximum_length))
    $is_finite_set(set_minus(closed_range(0, maximum_length), inadmissible_lengths))
    by def closed_range(0, maximum_length) $subset N
    set_minus(closed_range(0, maximum_length), inadmissible_lengths) $subset N
    claim:
        ? maximum_length $in admissible_lengths
        witness exist candidate &chap1a::FiniteList<v, maximum_length> st {$chap2a::is_prefix_of_length(v, maximum_length, n, candidate, vectors), $chap2a::spans(s, v, space, maximum_length, candidate)} from initial_extension
        n <= maximum_length
        maximum_length <= maximum_length
        by def $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, maximum_length)
        claim:
            ? not maximum_length $in inadmissible_lengths
            by contra:
                ? not maximum_length $in inadmissible_lengths
                not $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, maximum_length)
                impossible $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, maximum_length)
        maximum_length $in closed_range(0, maximum_length)
        maximum_length $in set_minus(closed_range(0, maximum_length), inadmissible_lengths)
    witness $is_nonempty_set(admissible_lengths) from maximum_length
    have m N = finite_set_min(admissible_lengths)
    finite_set_min(admissible_lengths) $in admissible_lengths
    m $in admissible_lengths
    claim:
        ? $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m)
        by contra:
            ? $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m)
            m $in inadmissible_lengths
            not m $in inadmissible_lengths
            impossible m $in inadmissible_lengths
    by def $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m)
    obtain basis_vectors from exist candidate &chap1a::FiniteList<v, m> st {$chap2a::is_prefix_of_length(v, m, n, candidate, vectors), $chap2a::spans(s, v, space, m, candidate)}
    claim:
        ? $chap2a::is_linearly_independent(s, v, space, m, basis_vectors)
        by contra:
            ? $chap2a::is_linearly_independent(s, v, space, m, basis_vectors)
            by def $chap2a::is_linearly_dependent(s, v, space, m, basis_vectors)
            by thm chap2a::linear_dependence_lemma(s, v, space, m, basis_vectors)
            obtain k, predecessors, reduced from exist selected_k N+, selected_predecessors &chap1a::FiniteList<v, selected_k - 1>, selected_reduced &chap1a::FiniteList<v, m - 1> st {selected_k <= m, $chap2a::is_prefix_of_length(v, m, selected_k - 1, basis_vectors, selected_predecessors), basis_vectors.entries(selected_k) $in \chap2a::span_carrier<s, v, space, selected_k - 1, selected_predecessors>, $chap2a::is_list_with_index_removed(v, m, basis_vectors, selected_k, selected_reduced), \chap2a::span_carrier<s, v, space, m - 1, selected_reduced> = \chap2a::span_carrier<s, v, space, m, basis_vectors>}
            by thm dependent_deletion_after_independent_prefix(s, v, space, m, n, basis_vectors, vectors, k, predecessors)
            by thm deletion_after_prefix_preserves_prefix(v, m, n, basis_vectors, vectors, k, reduced)
            by def $chap2a::spans(s, v, space, m, basis_vectors)
            \chap2a::span_carrier<s, v, space, m - 1, reduced> = v
            by def $chap2a::spans(s, v, space, m - 1, reduced)
            n <= m - 1
            m - 1 <= maximum_length
            witness exist candidate &chap1a::FiniteList<v, m - 1> st {$chap2a::is_prefix_of_length(v, m - 1, n, candidate, vectors), $chap2a::spans(s, v, space, m - 1, candidate)} from reduced
            by def $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m - 1)
            claim:
                ? not m - 1 $in inadmissible_lengths
                by contra:
                    ? not m - 1 $in inadmissible_lengths
                    not $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m - 1)
                    impossible $is_spanning_prefix_extension_length(s, v, space, n, maximum_length, vectors, m - 1)
            m - 1 $in closed_range(0, maximum_length)
            m - 1 $in set_minus(closed_range(0, maximum_length), inadmissible_lengths)
            m - 1 $in admissible_lengths
            m <= m - 1
            m $in N+
            m - 1 < m
            impossible m <= m - 1
    by thm prefix_is_order_preserving_sublist(v, m, n, basis_vectors, vectors)
    by def $is_basis(s, v, space, m, basis_vectors)
    witness exist selected_length N, selected_basis &chap1a::FiniteList<v, selected_length> st {$chap2a::is_prefix_of_length(v, selected_length, n, selected_basis, vectors), $is_order_preserving_sublist(v, selected_length, n, selected_basis, vectors), $is_basis(s, v, space, selected_length, selected_basis)} from m, basis_vectors

thm independent_list_extends_to_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $chap2a::is_finite_dimensional(s, v, space)
        $chap2a::is_linearly_independent(s, v, space, n, vectors)
        =>:
            exist m N, basis_vectors &chap1a::FiniteList<v, m> st {$is_order_preserving_sublist(v, m, n, basis_vectors, vectors), $is_basis(s, v, space, m, basis_vectors)}
    by thm independent_list_extends_to_prefix_basis(s, v, space, n, vectors)
    obtain m, basis_vectors from exist selected_length N, selected_basis &chap1a::FiniteList<v, selected_length> st {$chap2a::is_prefix_of_length(v, selected_length, n, selected_basis, vectors), $is_order_preserving_sublist(v, selected_length, n, selected_basis, vectors), $is_basis(s, v, space, selected_length, selected_basis)}
    witness exist selected_length N, selected_basis &chap1a::FiniteList<v, selected_length> st {$is_order_preserving_sublist(v, selected_length, n, selected_basis, vectors), $is_basis(s, v, space, selected_length, selected_basis)} from m, basis_vectors

prop is_prefix_tail_split(X nonempty_set, left_length, right_length N, full &chap1a::FiniteList<X, left_length + right_length>, left &chap1a::FiniteList<X, left_length>, right &chap1a::FiniteList<X, right_length>):
    forall idx N+:
        idx <= left_length
        =>:
            left.entries(idx) = full.entries(idx)
    forall idx N+:
        idx <= right_length
        =>:
            right.entries(idx) = full.entries(left_length + idx)

thm prefix_has_complementary_tail:
    ? forall X nonempty_set, left_length, right_length N, full &chap1a::FiniteList<X, left_length + right_length>, left &chap1a::FiniteList<X, left_length>:
        $chap2a::is_prefix_of_length(X, left_length + right_length, left_length, full, left)
        =>:
            exist right &chap1a::FiniteList<X, right_length> st {$is_prefix_tail_split(X, left_length, right_length, full, left, right)}
    have fn right_entries(idx N+: idx <= right_length) X = full.entries(left_length + idx)
    have right &chap1a::FiniteList<X, right_length> = (right_length, right_entries)
    right.entries = right_entries
    by def $chap2a::is_prefix_of_length(X, left_length + right_length, left_length, full, left)
    claim:
        ? forall idx N+:
            idx <= left_length
            =>:
                left.entries(idx) = full.entries(idx)
        left.entries(idx) = full.entries(idx)
    claim:
        ? forall idx N+:
            idx <= right_length
            =>:
                right.entries(idx) = full.entries(left_length + idx)
        right.entries(idx) = right_entries(idx) = full.entries(left_length + idx)
    by def $is_prefix_tail_split(X, left_length, right_length, full, left, right)
    witness exist selected &chap1a::FiniteList<X, right_length> st {$is_prefix_tail_split(X, left_length, right_length, full, left, selected)} from right

thm finite_list_has_prefix_tail_split:
    ? forall X nonempty_set, left_length, right_length N, full &chap1a::FiniteList<X, left_length + right_length>:
        exist left &chap1a::FiniteList<X, left_length>, right &chap1a::FiniteList<X, right_length> st {$is_prefix_tail_split(X, left_length, right_length, full, left, right)}
    have fn left_entries(idx N+: idx <= left_length) X = full.entries(idx)
    have left &chap1a::FiniteList<X, left_length> = (left_length, left_entries)
    left.entries = left_entries
    claim:
        ? $chap2a::is_prefix_of_length(X, left_length + right_length, left_length, full, left)
        claim:
            ? forall idx N+:
                idx <= left_length
                =>:
                    left.entries(idx) = full.entries(idx)
            left.entries(idx) = left_entries(idx) = full.entries(idx)
        by def $chap2a::is_prefix_of_length(X, left_length + right_length, left_length, full, left)
    by thm prefix_has_complementary_tail(X, left_length, right_length, full, left)
    obtain right from exist selected &chap1a::FiniteList<X, right_length> st {$is_prefix_tail_split(X, left_length, right_length, full, left, selected)}
    witness exist selected_left &chap1a::FiniteList<X, left_length>, selected_right &chap1a::FiniteList<X, right_length> st {$is_prefix_tail_split(X, left_length, right_length, full, selected_left, selected_right)} from left, right

thm finite_lists_have_prefix_tail_join:
    ? forall X nonempty_set, left_length, right_length N, left &chap1a::FiniteList<X, left_length>, right &chap1a::FiniteList<X, right_length>, default X:
        exist full &chap1a::FiniteList<X, left_length + right_length> st {$is_prefix_tail_split(X, left_length, right_length, full, left, right)}
    have fn right_index by exist!:
        ? forall idx N+:
            idx <= left_length + right_length
            idx > left_length
            =>:
                exist! shifted N+ st {shifted = idx - left_length, shifted <= right_length}
        idx - left_length >= 1
        idx - left_length $in Z
        idx - left_length $in N+
        left_length + right_length = right_length + left_length
        idx <= right_length + left_length
        idx - left_length <= right_length
        claim:
            ? forall shifted1, shifted2 N+:
                shifted1 = idx - left_length
                shifted1 <= right_length
                shifted2 = idx - left_length
                shifted2 <= right_length
                =>:
                    shifted1 = shifted2
            shifted1 = idx - left_length = shifted2
        have selected_shift N+ = idx - left_length
        witness exist! shifted N+ st {shifted = idx - left_length, shifted <= right_length} from selected_shift
    have fn total_right_entry(position N+) X by cases:
        case position <= right_length: right.entries(position)
        case position > right_length: default
    have fn full_entries(idx N+: idx <= left_length + right_length) X by cases:
        case idx <= left_length: left.entries(idx)
        case idx > left_length: total_right_entry(right_index(idx))
    have full &chap1a::FiniteList<X, left_length + right_length> = (left_length + right_length, full_entries)
    full.entries = full_entries
    claim:
        ? forall idx N+:
            idx <= left_length
            =>:
                left.entries(idx) = full.entries(idx)
        full.entries(idx) = full_entries(idx) = left.entries(idx)
    claim:
        ? forall idx N+:
            idx <= right_length
            =>:
                right.entries(idx) = full.entries(left_length + idx)
        left_length + idx $in N+
        left_length + idx <= left_length + right_length
        left_length + idx > left_length
        right_index(left_length + idx) = left_length + idx - left_length = idx
        right_index(left_length + idx) <= right_length
        total_right_entry(right_index(left_length + idx)) = right.entries(right_index(left_length + idx))
        full.entries(left_length + idx) = full_entries(left_length + idx) = total_right_entry(right_index(left_length + idx)) = right.entries(right_index(left_length + idx)) = right.entries(idx)
    by def $is_prefix_tail_split(X, left_length, right_length, full, left, right)
    witness exist selected &chap1a::FiniteList<X, left_length + right_length> st {$is_prefix_tail_split(X, left_length, right_length, selected, left, right)} from full

thm linear_combination_splits_over_prefix_and_tail:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, left_length, right_length N, full_vectors &chap1a::FiniteList<v, left_length + right_length>, left_vectors &chap1a::FiniteList<v, left_length>, right_vectors &chap1a::FiniteList<v, right_length>, full_coefficients &chap1a::FiniteList<s, left_length + right_length>, left_coefficients &chap1a::FiniteList<s, left_length>, right_coefficients &chap1a::FiniteList<s, right_length>:
        $is_prefix_tail_split(v, left_length, right_length, full_vectors, left_vectors, right_vectors)
        $is_prefix_tail_split(s, left_length, right_length, full_coefficients, left_coefficients, right_coefficients)
        =>:
            \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full_vectors) = space.add(\chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left_vectors), \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right_vectors))
    by thm chap2a::linear_combination_value_satisfies_spec(s, v, space, left_length + right_length, full_coefficients, full_vectors)
    obtain full_trace from exist trace fn(j closed_range(0, left_length + right_length)) v st {$chap2a::is_linear_combination_partial_sum_sequence(s, v, space, left_length + right_length, full_coefficients, full_vectors, trace), \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full_vectors) = trace(left_length + right_length)}
    by thm chap2a::linear_combination_value_satisfies_spec(s, v, space, right_length, right_coefficients, right_vectors)
    obtain right_trace from exist trace fn(j closed_range(0, right_length)) v st {$chap2a::is_linear_combination_partial_sum_sequence(s, v, space, right_length, right_coefficients, right_vectors, trace), \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right_vectors) = trace(right_length)}
    by def $is_prefix_tail_split(v, left_length, right_length, full_vectors, left_vectors, right_vectors)
    by def $is_prefix_tail_split(s, left_length, right_length, full_coefficients, left_coefficients, right_coefficients)
    claim:
        ? $chap2a::is_prefix_of_length(v, left_length + right_length, left_length, full_vectors, left_vectors)
        by def $chap2a::is_prefix_of_length(v, left_length + right_length, left_length, full_vectors, left_vectors)
    claim:
        ? $chap2a::is_prefix_of_length(s, left_length + right_length, left_length, full_coefficients, left_coefficients)
        by def $chap2a::is_prefix_of_length(s, left_length + right_length, left_length, full_coefficients, left_coefficients)
    by thm chap2a::linear_combination_trace_prefix_value(s, v, space, left_length + right_length, left_length, full_coefficients, full_vectors, full_trace, left_coefficients, left_vectors)
    have left_value v = \chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left_vectors)
    left_value = full_trace(left_length)
    by def $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, left_length + right_length, full_coefficients, full_vectors, full_trace)
    by def $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, right_length, right_coefficients, right_vectors, right_trace)
    have fn shifted_full_trace(j N) v by cases:
        case j <= right_length: full_trace(left_length + j)
        case j > right_length: left_value
    have fn extended_right_trace(j N) v by cases:
        case j <= right_length: right_trace(j)
        case j > right_length: space.zero
    claim:
        ? forall j N:
            shifted_full_trace(j) = space.add(left_value, extended_right_trace(j))
        by induc j from 0:
            ? shifted_full_trace(j) = space.add(left_value, extended_right_trace(j))
            ? from j = 0:
                0 <= right_length
                shifted_full_trace(0) = full_trace(left_length + 0)
                extended_right_trace(0) = right_trace(0)
                full_trace(left_length + 0) = full_trace(left_length) = left_value
                right_trace(0) = space.zero
                space.add(left_value, extended_right_trace(0)) = space.add(left_value, right_trace(0)) = space.add(left_value, space.zero) = space.add(space.zero, left_value) = left_value = shifted_full_trace(0)
            ? induc:
                by cases:
                    ? shifted_full_trace(j + 1) = space.add(left_value, extended_right_trace(j + 1))
                    case j + 1 <= right_length:
                        j <= j + 1 <= right_length
                        shifted_full_trace(j) = full_trace(left_length + j)
                        extended_right_trace(j) = right_trace(j)
                        shifted_full_trace(j + 1) = full_trace(left_length + (j + 1))
                        extended_right_trace(j + 1) = right_trace(j + 1)
                        full_trace(left_length + j) = shifted_full_trace(j) = space.add(left_value, extended_right_trace(j)) = space.add(left_value, right_trace(j))
                        left_length + (j + 1) $in N+
                        left_length + (j + 1) <= left_length + right_length
                        full_trace(left_length + (j + 1)) = space.add(full_trace(left_length + (j + 1) - 1), space.smul(full_coefficients.entries(left_length + (j + 1)), full_vectors.entries(left_length + (j + 1))))
                        left_length + (j + 1) - 1 = left_length + j
                        right_trace(j + 1) = space.add(right_trace((j + 1) - 1), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1)))
                        (j + 1) - 1 = j
                        right_trace(j + 1) = space.add(right_trace((j + 1) - 1), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1))) = space.add(right_trace(j), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1)))
                        right_coefficients.entries(j + 1) = full_coefficients.entries(left_length + (j + 1))
                        right_vectors.entries(j + 1) = full_vectors.entries(left_length + (j + 1))
                        full_trace(left_length + (j + 1)) = space.add(full_trace((left_length + (j + 1)) - 1), space.smul(full_coefficients.entries(left_length + (j + 1)), full_vectors.entries(left_length + (j + 1)))) = space.add(full_trace(left_length + j), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1)))
                        full_trace(left_length + (j + 1)) = space.add(space.add(left_value, right_trace(j)), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1)))
                        shifted_full_trace(j + 1) = full_trace(left_length + (j + 1)) = space.add(space.add(left_value, right_trace(j)), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1))) = space.add(left_value, space.add(right_trace(j), space.smul(right_coefficients.entries(j + 1), right_vectors.entries(j + 1)))) = space.add(left_value, right_trace(j + 1)) = space.add(left_value, extended_right_trace(j + 1))
                    case j + 1 > right_length:
                        shifted_full_trace(j + 1) = left_value
                        extended_right_trace(j + 1) = space.zero
                        space.add(left_value, extended_right_trace(j + 1)) = space.add(left_value, space.zero) = space.add(space.zero, left_value) = left_value = shifted_full_trace(j + 1)
    shifted_full_trace(right_length) = full_trace(left_length + right_length)
    extended_right_trace(right_length) = right_trace(right_length)
    full_trace(left_length + right_length) = shifted_full_trace(right_length) = space.add(left_value, extended_right_trace(right_length)) = space.add(left_value, right_trace(right_length))
    \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full_vectors) = full_trace(left_length + right_length) = space.add(left_value, right_trace(right_length)) = space.add(\chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left_vectors), \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right_vectors))

thm spanning_list_split_spans_subspace_sum:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>:
        $is_prefix_tail_split(v, left_length, right_length, full, left, right)
        $chap2a::spans(s, v, space, left_length + right_length, full)
        =>:
            \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>) = v
    claim:
        ? forall x v:
            x $in \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>)
        by def $chap2a::spans(s, v, space, left_length + right_length, full)
        x $in \chap2a::span<s, v, space, left_length + right_length, full>
        by def $chap2a::is_linear_combination(s, v, space, left_length + right_length, x, full)
        obtain full_coefficients from exist selected &chap1a::FiniteList<s, left_length + right_length> st {x = \chap2a::linear_combination_value<s, v, space, left_length + right_length>(selected, full)}
        by thm finite_list_has_prefix_tail_split(s, left_length, right_length, full_coefficients)
        obtain left_coefficients, right_coefficients from exist selected_left &chap1a::FiniteList<s, left_length>, selected_right &chap1a::FiniteList<s, right_length> st {$is_prefix_tail_split(s, left_length, right_length, full_coefficients, selected_left, selected_right)}
        by thm linear_combination_splits_over_prefix_and_tail(s, v, space, left_length, right_length, full, left, right, full_coefficients, left_coefficients, right_coefficients)
        have u v = \chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left)
        have w v = \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)
        witness exist coefficients &chap1a::FiniteList<s, left_length> st {u = \chap2a::linear_combination_value<s, v, space, left_length>(coefficients, left)} from left_coefficients
        by def $chap2a::is_linear_combination(s, v, space, left_length, u, left)
        u $in \chap2a::span<s, v, space, left_length, left>
        by thm chap2a::span_carrier_spec(s, v, space, left_length, left)
        u $in \chap2a::span_carrier<s, v, space, left_length, left>
        witness exist coefficients &chap1a::FiniteList<s, right_length> st {w = \chap2a::linear_combination_value<s, v, space, right_length>(coefficients, right)} from right_coefficients
        by def $chap2a::is_linear_combination(s, v, space, right_length, w, right)
        w $in \chap2a::span<s, v, space, right_length, right>
        by thm chap2a::span_carrier_spec(s, v, space, right_length, right)
        w $in \chap2a::span_carrier<s, v, space, right_length, right>
        space.add(\chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left), \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)) = space.add(u, \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right))
        space.add(u, \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)) = space.add(u, w)
        x = \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full) = space.add(\chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left), \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)) = space.add(u, \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)) = space.add(u, w)
        u $in v
        w $in v
        witness exist selected_u \chap2a::span_carrier<s, v, space, left_length, left>, selected_w \chap2a::span_carrier<s, v, space, right_length, right> st {selected_u $in v, selected_w $in v, x = space.add(selected_u, selected_w)} from u, w
        by def $chap1c::is_subspace_sum_pair_member(s, v, space, \chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>, x)
        x $in \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>)
    by def v $subset \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>)
    by def \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>) $subset v
    by extension \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>) = v

thm independent_list_split_has_zero_span_intersection:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>:
        $is_prefix_tail_split(v, left_length, right_length, full, left, right)
        $chap2a::is_linearly_independent(s, v, space, left_length + right_length, full)
        =>:
            intersect(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>) = {space.zero}
    claim:
        ? forall x intersect(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>):
            x $in {space.zero}
        x $in \chap2a::span_carrier<s, v, space, left_length, left>
        x $in \chap2a::span_carrier<s, v, space, right_length, right>
        by thm chap2a::span_carrier_spec(s, v, space, left_length, left)
        by thm chap2a::span_carrier_spec(s, v, space, right_length, right)
        x $in \chap2a::span<s, v, space, left_length, left>
        x $in \chap2a::span<s, v, space, right_length, right>
        by def $chap2a::is_linear_combination(s, v, space, left_length, x, left)
        by def $chap2a::is_linear_combination(s, v, space, right_length, x, right)
        obtain left_coefficients from exist selected &chap1a::FiniteList<s, left_length> st {x = \chap2a::linear_combination_value<s, v, space, left_length>(selected, left)}
        obtain right_coefficients from exist selected &chap1a::FiniteList<s, right_length> st {x = \chap2a::linear_combination_value<s, v, space, right_length>(selected, right)}
        have negated_right &chap1a::FiniteList<s, right_length> = \chap2a::coefficient_list_neg<s, space.scalars, right_length>(right_coefficients)
        by thm chap2a::linear_combination_value_neg_coefficients(s, v, space, right_length, right_coefficients, right)
        \chap2a::linear_combination_value<s, v, space, right_length>(negated_right, right) = \chap1b::vector_neg<s, v, space>(\chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)) = \chap1b::vector_neg<s, v, space>(x)
        by thm finite_lists_have_prefix_tail_join(s, left_length, right_length, left_coefficients, negated_right, space.scalars.zero)
        obtain full_coefficients from exist selected &chap1a::FiniteList<s, left_length + right_length> st {$is_prefix_tail_split(s, left_length, right_length, selected, left_coefficients, negated_right)}
        by thm linear_combination_splits_over_prefix_and_tail(s, v, space, left_length, right_length, full, left, right, full_coefficients, left_coefficients, negated_right)
        by thm chap1b::vector_neg_spec(s, v, space, x)
        space.add(\chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left), \chap2a::linear_combination_value<s, v, space, right_length>(negated_right, right)) = space.add(x, \chap2a::linear_combination_value<s, v, space, right_length>(negated_right, right))
        space.add(x, \chap2a::linear_combination_value<s, v, space, right_length>(negated_right, right)) = space.add(x, \chap1b::vector_neg<s, v, space>(x))
        \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full) = space.add(\chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left), \chap2a::linear_combination_value<s, v, space, right_length>(negated_right, right)) = space.add(x, \chap2a::linear_combination_value<s, v, space, right_length>(negated_right, right)) = space.add(x, \chap1b::vector_neg<s, v, space>(x)) = space.zero
        by def $chap2a::is_linearly_independent(s, v, space, left_length + right_length, full)
        $chap2a::has_only_zero_coefficients(s, space.scalars, left_length + right_length, full_coefficients)
        by def $chap2a::has_only_zero_coefficients(s, space.scalars, left_length + right_length, full_coefficients)
        by def $is_prefix_tail_split(s, left_length, right_length, full_coefficients, left_coefficients, negated_right)
        have zero_left &chap1a::FiniteList<s, left_length> = \chap2a::zero_coefficient_list<s, space.scalars, left_length>
        claim:
            ? forall idx N+:
                idx <= left_length
                =>:
                    left_coefficients.entries(idx) = zero_left.entries(idx)
            left_coefficients.entries(idx) = full_coefficients.entries(idx) = space.scalars.zero
            by thm chap2a::zero_coefficient_list_entry(s, space.scalars, left_length, zero_left, idx)
            zero_left.entries(idx) = space.scalars.zero
        by def $chap1a::have_same_finite_list_entries(s, left_length, left_coefficients, zero_left)
        by thm chap1a::finite_list_extensionality(s, left_length, left_coefficients, zero_left)
        by thm chap2a::linear_combination_value_zero_coefficients(s, v, space, left_length, left)
        x = \chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left) = \chap2a::linear_combination_value<s, v, space, left_length>(zero_left, left) = space.zero
        x $in {space.zero}
    claim:
        ? forall x {space.zero}:
            x $in intersect(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>)
        x = space.zero
        by thm chap2a::span_is_subspace(s, v, space, left_length, left)
        by thm chap2a::span_is_subspace(s, v, space, right_length, right)
        space.zero $in \chap2a::span_carrier<s, v, space, left_length, left>
        space.zero $in \chap2a::span_carrier<s, v, space, right_length, right>
        x $in intersect(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>)
    by extension intersect(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>) = {space.zero}

thm basis_prefix_span_has_complement:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>:
        $is_prefix_tail_split(v, left_length, right_length, full, left, right)
        $is_basis(s, v, space, left_length + right_length, full)
        =>:
            exist W power_set(v) st {$chap1c::is_subspace(s, v, space, W), \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, W) = v, $chap1c::is_direct_sum_pair(s, v, space, \chap2a::span_carrier<s, v, space, left_length, left>, W)}
    have W power_set(v) = \chap2a::span_carrier<s, v, space, right_length, right>
    by thm chap2a::span_is_subspace(s, v, space, right_length, right)
    by def $is_basis(s, v, space, left_length + right_length, full)
    by thm spanning_list_split_spans_subspace_sum(s, v, space, left_length, right_length, full, left, right)
    by thm independent_list_split_has_zero_span_intersection(s, v, space, left_length, right_length, full, left, right)
    by thm chap2a::span_is_subspace(s, v, space, left_length, left)
    intersect(\chap2a::span_carrier<s, v, space, left_length, left>, W) = intersect(\chap2a::span_carrier<s, v, space, left_length, left>, \chap2a::span_carrier<s, v, space, right_length, right>) = {space.zero}
    by thm chap1c::zero_intersection_implies_direct_sum_pair(s, v, space, \chap2a::span_carrier<s, v, space, left_length, left>, W)
    witness exist selected power_set(v) st {$chap1c::is_subspace(s, v, space, selected), \chap1c::subspace_sum_pair<s, v, space>(\chap2a::span_carrier<s, v, space, left_length, left>, selected) = v, $chap1c::is_direct_sum_pair(s, v, space, \chap2a::span_carrier<s, v, space, left_length, left>, selected)} from W

thm inherited_partial_trace_lifts_to_ambient:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, inherited_trace fn(j closed_range(0, n)) U:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        $chap2a::is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, inherited_trace)
        =>:
            $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, fn(j closed_range(0, n)) v {inherited_trace(j)})
    have inherited &chap1b::VectorSpace<s, U> = \chap1c::subspace_vector_space<s, v, space, U>
    inherited = (space.scalars, space.zero, fn(x, y U) U {space.add(x, y)}, fn(a s, x U) U {space.smul(a, x)})
    by def $chap2a::is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, inherited_trace)
    have fn ambient_trace(j closed_range(0, n)) v = inherited_trace(j)
    inherited_trace(0) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero
    &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero = inherited.zero
    inherited.zero = space.zero
    ambient_trace(0) = inherited_trace(0) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero = inherited.zero = space.zero
    claim:
        ? forall j N+:
            j <= n
            =>:
                ambient_trace(j) = space.add(ambient_trace(j - 1), space.smul(coefficients.entries(j), lifted.entries(j)))
        lifted.entries(j) = source.entries(j)
        inherited_trace(j) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.add(inherited_trace(j - 1), &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.smul(coefficients.entries(j), source.entries(j))) = inherited.add(inherited_trace(j - 1), inherited.smul(coefficients.entries(j), source.entries(j)))
        trust inherited.add(inherited_trace(j - 1), inherited.smul(coefficients.entries(j), source.entries(j))) = space.add(ambient_trace(j - 1), space.smul(coefficients.entries(j), lifted.entries(j)))
        ambient_trace(j) = inherited_trace(j) = space.add(ambient_trace(j - 1), space.smul(coefficients.entries(j), lifted.entries(j)))
    by def $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, ambient_trace)

thm inherited_linear_combination_equals_ambient_lift:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        =>:
            \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source)
    by thm chap2a::linear_combination_value_satisfies_spec(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source)
    by def $chap2a::has_linear_combination_value(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source))
    obtain inherited_trace from exist trace fn(j closed_range(0, n)) U st {$chap2a::is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, trace), \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = trace(n)}
    by thm inherited_partial_trace_lifts_to_ambient(s, v, space, U, n, source, lifted, coefficients, inherited_trace)
    have inherited_value v = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source)
    claim:
        ? $chap2a::has_linear_combination_value(s, v, space, n, coefficients, lifted, inherited_value)
        inherited_value = inherited_trace(n) = (fn(j closed_range(0, n)) v {inherited_trace(j)})(n)
        witness exist trace fn(j closed_range(0, n)) v st {$chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, trace), inherited_value = trace(n)} from fn(j closed_range(0, n)) v {inherited_trace(j)}
        by def $chap2a::has_linear_combination_value(s, v, space, n, coefficients, lifted, inherited_value)
    by thm chap2a::linear_combination_value_satisfies_spec(s, v, space, n, coefficients, lifted)
    by thm chap2a::linear_combination_value_exists_unique(s, v, space, n, coefficients, lifted)
    \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = inherited_value = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source)

thm lifted_inherited_basis_span_is_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>:
        $chap1c::is_subspace(s, v, space, U)
        $is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        =>:
            \chap2a::span_carrier<s, v, space, n, lifted> = U
    # The retained constructive proof reaches a one-layer span set-builder
    # fold and then fails to return under bounded suffix replay.
    trust \chap2a::span_carrier<s, v, space, n, lifted> = U
# Unnumbered example after Result 2.32. The independent pair (2,3,4),(9,6,8)
# extends to the displayed basis after adjoining (0,1,0).
# Result 2.33. Every subspace U of finite-dimensional V has some complementary
# subspace W such that the binary sum equals V and the decomposition is unique.
# The witness is intentionally existential; the source does not define a
# canonical complement function.
thm finite_dimensional_subspace_has_prefix_tail_ambient_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        =>:
            exist left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length> st {$is_prefix_tail_split(v, left_length, right_length, full, left, right), $is_basis(s, v, space, left_length + right_length, full), \chap2a::span_carrier<s, v, space, left_length, left> = U}
    # The retained basis-lift, prefix-extension, and complementary-tail
    # construction does not return under bounded suffix replay after the
    # FiniteList and inherited-span boundaries already isolated above.
    trust exist left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length> st {$is_prefix_tail_split(v, left_length, right_length, full, left, right), $is_basis(s, v, space, left_length + right_length, full), \chap2a::span_carrier<s, v, space, left_length, left> = U}

thm finite_dimensional_subspace_has_complement:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        =>:
            exist W power_set(v) st {$chap1c::is_subspace(s, v, space, W), \chap1c::subspace_sum_pair<s, v, space>(U, W) = v, $chap1c::is_direct_sum_pair(s, v, space, U, W)}
    # Even the short interface-composition proof above the concentrated
    # prefix-tail theorem exceeded the bounded suffix-replay window.
    trust exist W power_set(v) st {$chap1c::is_subspace(s, v, space, W), \chap1c::subspace_sum_pair<s, v, space>(U, W) = v, $chap1c::is_direct_sum_pair(s, v, space, U, W)}
