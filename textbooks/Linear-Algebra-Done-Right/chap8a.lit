# Linear Algebra Done Right, fourth edition — Section 8A.
# Generalized Eigenvectors and Nilpotent Operators.
# The null space and range of a power are actual set-valued functions used by
# every stabilization and generalized-eigenspace statement in this chapter.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn power_null_space(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, k N) power_set(VSet) = \chap3b::null_space<s, VSet, VSet, V, V>(\chap5a::operator_power<s, VSet, V>(T, k))

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn power_range(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, k N) power_set(VSet) = \chap3b::range_of<VSet, VSet>(\chap5a::operator_power<s, VSet, V>(T, k))

prop increasing_null_space_sequence_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    \power_null_space<s, VSet, V>(T, 0) = {V.zero}
    forall k N:
        \power_null_space<s, VSet, V>(T, k) $subset \power_null_space<s, VSet, V>(T, k + 1)
# Result 8.1. A vector killed by T^k is killed after one more application of
# T; T^0=I gives the singleton zero null space.
axiom sequence_of_increasing_null_spaces:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $increasing_null_space_sequence_statement(s, VSet, V, T)

prop null_space_equality_propagates_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, m N):
    forall k N:
        m <= k
        =>:
            \power_null_space<s, VSet, V>(T, k) = \power_null_space<s, VSet, V>(T, m)
# Result 8.2. For v killed by T^(m+k+1), the vector T^k v lies in null
# T^(m+1)=null T^m, hence v is already killed by T^(m+k).
axiom equality_in_sequence_of_null_spaces:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, m N:
        \power_null_space<s, VSet, V>(T, m) = \power_null_space<s, VSet, V>(T, m + 1)
        =>:
            $null_space_equality_propagates_statement(s, VSet, V, T, m)

prop null_spaces_stabilize_at_dimension_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    $chap2c::admits_basis_length(s, VSet, V)
    forall k N:
        \chap2c::dimension<s, VSet, V> <= k
        =>:
            \power_null_space<s, VSet, V>(T, k) = \power_null_space<s, VSet, V>(T, \chap2c::dimension<s, VSet, V>)
# Result 8.3. If growth continued past dim VSet, each strict inclusion would
# raise dimension and produce a subspace larger than VSet; then apply Result 8.2.
axiom null_spaces_stop_growing:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $null_spaces_stabilize_at_dimension_statement(s, VSet, V, T)

prop power_null_range_direct_sum_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    $chap2c::admits_basis_length(s, VSet, V)
    $chap1c::is_direct_sum_pair(s, VSet, V, \power_null_space<s, VSet, V>(T, \chap2c::dimension<s, VSet, V>), \power_range<s, VSet, V>(T, \chap2c::dimension<s, VSet, V>))
    \chap1c::subspace_sum_pair<s, VSet, V>(\power_null_space<s, VSet, V>(T, \chap2c::dimension<s, VSet, V>), \power_range<s, VSet, V>(T, \chap2c::dimension<s, VSet, V>)) = VSet
# Result 8.4. Stabilization makes the null/range intersection zero; rank-nullity
# then makes their direct sum have the full dimension of VSet.
axiom domain_is_direct_sum_of_stable_null_space_and_range:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $power_null_range_direct_sum_statement(s, VSet, V, T)
# Example 8.6. The displayed operator has T^3(z1,z2,z3)=(0,0,125z3), so its
# stable null space is the first two axes and its stable range is the third.
sketch:
    forall z1, z2, z3 R:
        [0, 0, 125 * z3] = [0, 0, 5^3 * z3]
    have null_basis_1 finite_seq(R, 3) = [1, 0, 0]
    have null_basis_2 finite_seq(R, 3) = [0, 1, 0]
    have range_basis finite_seq(R, 3) = [0, 0, 1]
    null_basis_1(3) = null_basis_2(3) = 0
    range_basis(1) = range_basis(2) = 0
# Definition 8.8. A generalized eigenvector is nonzero and is killed by some
# positive power of T-lambda I; lambda is explicitly required to be an eigenvalue.
prop is_generalized_eigenvector(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, v VSet):
    $chap5a::is_eigenvalue(s, VSet, V, T, lambda)
    v != V.zero
    exist k N+ st {\chap5a::operator_power<s, VSet, V>(\chap5a::operator_minus_scalar_identity<s, VSet, V>(T, lambda), k)(v) = V.zero}

prop is_generalized_eigenvector_at_dimension(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, v VSet):
    $chap2c::admits_basis_length(s, VSet, V)
    $chap5a::is_eigenvalue(s, VSet, V, T, lambda)
    v != V.zero
    \chap5a::operator_power<s, VSet, V>(\chap5a::operator_minus_scalar_identity<s, VSet, V>(T, lambda), \chap2c::dimension<s, VSet, V>)(v) = V.zero

prop generalized_eigenvector_dimension_criterion_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, v VSet):
    forall:
        =>:
            $is_generalized_eigenvector(s, VSet, V, T, lambda, v)
        <=>:
            $is_generalized_eigenvector_at_dimension(s, VSet, V, T, lambda, v)

axiom generalized_eigenvector_dimension_criterion:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, v VSet:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $generalized_eigenvector_dimension_criterion_statement(s, VSet, V, T, lambda, v)

prop is_generalized_eigenvector_basis(VSet nonempty_set, V &chap1b::CVectorSpace<VSet>, T \chap3a::linear_map_space<C, VSet, VSet, V.general, V.general>, n N+, basis &chap1a::FiniteList<VSet, n>):
    $chap2b::is_basis(C, VSet, V.general, n, basis)
    forall k N+:
        k <= n
        =>:
            exist lambda C st {$is_generalized_eigenvector(C, VSet, V.general, T, lambda, basis.entries(k))}
# Result 8.9. Induct on dimension: split at null/range of a stable shifted
# power, use the induction hypothesis on the invariant range, and adjoin bases.
axiom basis_of_generalized_eigenvectors:
    ? forall VSet nonempty_set, V &chap1b::CVectorSpace<VSet>, T \chap3a::linear_map_space<C, VSet, VSet, V.general, V.general>:
        $chap2a::is_finite_dimensional(C, VSet, V.general)
        $chap2c::admits_basis_length(C, VSet, V.general)
        \chap2c::dimension<C, VSet, V.general> > 0
        =>:
            exist n N+, basis &chap1a::FiniteList<VSet, n> st {$is_generalized_eigenvector_basis(VSet, V, T, n, basis)}
# Example 8.10. The standard basis vectors are generalized eigenvectors for
# the displayed operator: the first two correspond to 0 and the third to 5.
sketch:
    have e1 finite_seq(R, 3) = [1, 0, 0]
    have e2 finite_seq(R, 3) = [0, 1, 0]
    have e3 finite_seq(R, 3) = [0, 0, 1]
    [0, 0, 125 * e1(3)] = [0, 0, 0]
    [0, 0, 125 * e2(3)] = [0, 0, 0]
    e3(3) = 1
# Result 8.11. Choose the least alpha-exponent, expand the lambda-shift by the
# binomial theorem, and apply one fewer alpha-shift; its nonzero value forces
# (alpha-lambda)^n=0.
axiom generalized_eigenvector_has_unique_eigenvalue:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, v VSet, alpha, lambda s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $is_generalized_eigenvector(s, VSet, V, T, alpha, v)
        $is_generalized_eigenvector(s, VSet, V, T, lambda, v)
        =>:
            alpha = lambda

prop is_distinct_generalized_eigenvector_list(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N+, vectors &chap1a::FiniteList<VSet, n>, eigenvalues &chap1a::FiniteList<s, n>):
    $chap5a::has_distinct_entries(s, n, eigenvalues)
    forall k N+:
        k <= n
        =>:
            $is_generalized_eigenvector(s, VSet, V, T, eigenvalues.entries(k), vectors.entries(k))
# Result 8.12. Apply the last shift to a shortest dependent list; Result 8.11
# keeps every earlier transformed vector nonzero with its original eigenvalue,
# contradicting minimality.
axiom generalized_eigenvectors_for_distinct_eigenvalues_are_independent:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N+, vectors &chap1a::FiniteList<VSet, n>, eigenvalues &chap1a::FiniteList<s, n>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $is_distinct_generalized_eigenvector_list(s, VSet, V, T, n, vectors, eigenvalues)
        =>:
            $chap2a::is_linearly_independent(s, VSet, V, n, vectors)
# Definition 8.14. Nilpotence is the existence of a positive zero power.
prop is_nilpotent(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    exist k N+ st {\chap5a::operator_power<s, VSet, V>(T, k) = \chap3a::zero_linear_map<s, VSet, VSet, V, V>}
# Example 8.15. The first displayed map squares to zero; the source's second
# matrix cubes to zero.
sketch:
    forall z1, z2, z3, z4 R:
        [0, 0, ([0, 0, z1, z2])(1), ([0, 0, z1, z2])(2)] = [0, 0, 0, 0]
    have A matrix(R, 3, 3) = [[-3, 9, 0], [-7, 9, 6], [4, 0, -6]]
    A(1, 1) + A(2, 2) + A(3, 3) = 0
# Result 8.16. A zero power makes its null space all of VSet; Results 8.1 and 8.3
# move that equality down to the dimension power.
axiom nilpotent_power_at_dimension_is_zero:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $is_nilpotent(s, VSet, V, T)
        =>:
            \chap5a::operator_power<s, VSet, V>(T, \chap2c::dimension<s, VSet, V>) = \chap3a::zero_linear_map<s, VSet, VSet, V, V>

prop nilpotent_eigenvalue_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    $chap5a::is_eigenvalue(s, VSet, V, T, V.scalars.zero)
    forall lambda s:
        $chap5a::is_eigenvalue(s, VSet, V, T, lambda)
        =>:
            lambda = V.scalars.zero
# Result 8.17. A nilpotent eigenpair gives lambda^m v=0; conversely, over C,
# the minimal polynomial has only zero as a root and is therefore a power of z.
axiom eigenvalues_of_nilpotent_operator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        $is_nilpotent(s, VSet, V, T)
        =>:
            $nilpotent_eigenvalue_statement(s, VSet, V, T)

axiom complex_operator_with_only_zero_eigenvalue_is_nilpotent:
    ? forall VSet nonempty_set, V &chap1b::CVectorSpace<VSet>, T \chap3a::linear_map_space<C, VSet, VSet, V.general, V.general>:
        $chap2a::is_finite_dimensional(C, VSet, V.general)
        $chap2c::admits_basis_length(C, VSet, V.general)
        \chap2c::dimension<C, VSet, V.general> > 0
        forall lambda C:
            $chap5a::is_eigenvalue(C, VSet, V.general, T, lambda)
            =>:
                lambda = 0
        =>:
            $is_nilpotent(C, VSet, V.general, T)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    have fn coordinate_power(z s, m N) s by induc m from 0:
        case m = 0: scalars.one
        case m > 0: scalars.mul(coordinate_power(z, m - 1), z)

prop is_coordinate_power_polynomial(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, m N+):
    forall z s:
        \chap4::polynomial_eval<s, scalars>(p, z) = \coordinate_power<s, scalars>(z, m)

prop minimal_polynomial_is_coordinate_power(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    $chap2a::is_finite_dimensional(s, VSet, V)
    exist m N+ st {$is_coordinate_power_polynomial(s, V.scalars, \chap5b::minimal_polynomial<s, VSet, V>(T), m)}

prop is_strictly_upper_triangular_matrix(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+, A matrix(s, n, n)):
    forall row, column N+:
        row <= n
        column <= n
        column <= row
        =>:
            A(row, column) = scalars.zero

prop has_strictly_upper_triangular_matrix(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    exist n N+, basis &chap1a::FiniteList<VSet, n> st {$chap2b::is_basis(s, VSet, V, n, basis), $is_strictly_upper_triangular_matrix(s, V.scalars, n, \chap5c::matrix_of_operator<s, VSet, V, n>(basis, T))}
# Result 8.18. Nilpotence makes the minimal polynomial divide z^n; a coordinate
# power has only zero roots and triangularizes with zero diagonal; a strictly
# upper-triangular n-by-n matrix has nth power zero.
prop nilpotent_operator_characterizations_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    forall:
        =>:
            $is_nilpotent(s, VSet, V, T)
        <=>:
            $minimal_polynomial_is_coordinate_power(s, VSet, V, T)
    forall:
        =>:
            $minimal_polynomial_is_coordinate_power(s, VSet, V, T)
        <=>:
            $has_strictly_upper_triangular_matrix(s, VSet, V, T)

axiom minimal_polynomial_and_upper_triangular_matrix_of_nilpotent_operator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $nilpotent_operator_characterizations_statement(s, VSet, V, T)
