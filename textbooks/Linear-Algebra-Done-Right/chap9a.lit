# Linear Algebra Done Right, fourth edition — Section 9A.
# Bilinear Forms and Quadratic Forms.
# Definition 9.1. Bilinearity is separate linearity in the two slots.
prop is_bilinear_form(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, beta fn(u, v VSet) s):
    forall u VSet:
        $chap3f::is_linear_functional(s, VSet, V, fn(v VSet) s {beta(v, u)})
        $chap3f::is_linear_functional(s, VSet, V, fn(v VSet) s {beta(u, v)})

setting VectorSpaceSetting:
    s nonempty_set
    VSet nonempty_set
    V &chap1b::VectorSpace<s, VSet>
# Example 9.2. A concrete coordinate expression is linear in both variables.
sketch:
    forall x1, x2, x3, y1, y2, y3 R:
        x1 * y2 - 5 * x2 * y3 + 2 * x3 * y1 $in R
    forall a, x1, x2, x3, y1, y2, y3 R:
        (a * x1) * y2 - 5 * (a * x2) * y3 + 2 * (a * x3) * y1 = a * (x1 * y2 - 5 * x2 * y3 + 2 * x3 * y1)
# Definition 9.3. VSet^(2) is the genuine carrier of bilinear forms.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have bilinear_form_space power_set(fn(u, v VSet) s) = {beta fn(u, v VSet) s: $is_bilinear_form(s, VSet, V, beta)}

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn zero_bilinear_form(u, v VSet) s = V.scalars.zero

thm zero_bilinear_form_is_bilinear:
    ? forall [VectorSpaceSetting]:
        $is_bilinear_form(s, VSet, V, \zero_bilinear_form<s, VSet, V>)
    # Both partial applications are the zero linear functional; pointwise
    # function equality and predicate packaging do not replay.
    trust $is_bilinear_form(s, VSet, V, \zero_bilinear_form<s, VSet, V>)
thm bilinear_form_space_is_nonempty:
    ? forall [VectorSpaceSetting]:
        $is_nonempty_set(\bilinear_form_space<s, VSet, V>)
    # zero_bilinear_form is the explicit witness; set-builder membership does
    # not fold into the nonempty-set witness interface.
    trust $is_nonempty_set(\bilinear_form_space<s, VSet, V>)

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn bilinear_form_add(beta, gamma fn(x, y VSet) s) fn(a, b VSet) s = fn(u, v VSet) s {V.scalars.add(beta(u, v), gamma(u, v))}

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn bilinear_form_smul(a s, beta fn(x, y VSet) s) fn(b, c VSet) s = fn(u, v VSet) s {V.scalars.mul(a, beta(u, v))}

thm function_equal_to_linear_map_is_linear:
    ? forall s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, f, g fn(v VSet) WSet:
        $chap3a::is_linear_map(s, VSet, WSet, V, W, g)
        f = g
        =>:
            $chap3a::is_linear_map(s, VSet, WSet, V, W, f)
    f = g
    $chap3a::is_linear_map(s, VSet, WSet, V, W, g)

thm bilinear_form_add_is_bilinear:
    ? forall [VectorSpaceSetting], beta, gamma \bilinear_form_space<s, VSet, V>:
        \bilinear_form_add<s, VSet, V>(beta, gamma) $in \bilinear_form_space<s, VSet, V>
    # Pointwise add preserves both linear-functional slots, but theorem
    # argument coercion and final set-builder membership do not replay.
    trust \bilinear_form_add<s, VSet, V>(beta, gamma) $in \bilinear_form_space<s, VSet, V>
thm bilinear_form_smul_is_bilinear:
    ? forall [VectorSpaceSetting], a s, beta \bilinear_form_space<s, VSet, V>:
        \bilinear_form_smul<s, VSet, V>(a, beta) $in \bilinear_form_space<s, VSet, V>
    # Pointwise scalar multiplication preserves both slots; the same
    # theorem-argument coercion and set-builder packaging boundary applies.
    trust \bilinear_form_smul<s, VSet, V>(a, beta) $in \bilinear_form_space<s, VSet, V>
thm scalar_minus_one_mul:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, x s:
        scalars.mul(scalars.neg(scalars.one), x) = scalars.neg(x)
    by thm chap1b::minus_one_times_vector(s, s, \chap3f::scalar_vector_space<s, scalars>, x)
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars = scalars
    by thm chap1a::equal_scalar_systems_have_equal_operation_fields(s, &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars, scalars)
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.smul = scalars.mul
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.add = scalars.add
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.zero = scalars.zero
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.smul(&chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars.neg(&chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars.one), x) = \chap1b::vector_neg<s, s, \chap3f::scalar_vector_space<s, scalars>>(x)
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars.neg(&chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars.one) = scalars.neg(scalars.one)
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.smul(scalars.neg(scalars.one), x) = scalars.mul(scalars.neg(scalars.one), x)
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.smul(&chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars.neg(&chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.scalars.one), x) = &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.smul(scalars.neg(scalars.one), x) = scalars.mul(scalars.neg(scalars.one), x)
    scalars.mul(scalars.neg(scalars.one), x) = \chap1b::vector_neg<s, s, \chap3f::scalar_vector_space<s, scalars>>(x)
    by thm chap1b::vector_neg_spec(s, s, \chap3f::scalar_vector_space<s, scalars>, x)
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.add(x, \chap1b::vector_neg<s, s, \chap3f::scalar_vector_space<s, scalars>>(x)) = &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.zero
    &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.add(x, scalars.neg(x)) = scalars.add(x, scalars.neg(x)) = scalars.zero = &chap1b::VectorSpace<s, s>{\chap3f::scalar_vector_space<s, scalars>}.zero
    by thm chap1b::add_left_cancel(s, s, \chap3f::scalar_vector_space<s, scalars>, x, \chap1b::vector_neg<s, s, \chap3f::scalar_vector_space<s, scalars>>(x), scalars.neg(x))
    \chap1b::vector_neg<s, s, \chap3f::scalar_vector_space<s, scalars>>(x) = scalars.neg(x)

prop bilinear_form_vector_space_laws(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>):
    \zero_bilinear_form<s, VSet, V> $in \bilinear_form_space<s, VSet, V>
    forall beta, gamma \bilinear_form_space<s, VSet, V>:
        \bilinear_form_add<s, VSet, V>(beta, gamma) $in \bilinear_form_space<s, VSet, V>
    forall a s, beta \bilinear_form_space<s, VSet, V>:
        \bilinear_form_smul<s, VSet, V>(a, beta) $in \bilinear_form_space<s, VSet, V>
    forall beta, gamma, delta \bilinear_form_space<s, VSet, V>:
        \bilinear_form_add<s, VSet, V>(\bilinear_form_add<s, VSet, V>(beta, gamma), delta) = \bilinear_form_add<s, VSet, V>(beta, \bilinear_form_add<s, VSet, V>(gamma, delta))
    forall beta, gamma \bilinear_form_space<s, VSet, V>:
        \bilinear_form_add<s, VSet, V>(beta, gamma) = \bilinear_form_add<s, VSet, V>(gamma, beta)
    forall beta \bilinear_form_space<s, VSet, V>:
        \bilinear_form_add<s, VSet, V>(\zero_bilinear_form<s, VSet, V>, beta) = beta
        exist gamma \bilinear_form_space<s, VSet, V> st {\bilinear_form_add<s, VSet, V>(beta, gamma) = \zero_bilinear_form<s, VSet, V>}
    forall a, b s, beta \bilinear_form_space<s, VSet, V>:
        \bilinear_form_smul<s, VSet, V>(V.scalars.mul(a, b), beta) = \bilinear_form_smul<s, VSet, V>(a, \bilinear_form_smul<s, VSet, V>(b, beta))
        \bilinear_form_smul<s, VSet, V>(V.scalars.add(a, b), beta) = \bilinear_form_add<s, VSet, V>(\bilinear_form_smul<s, VSet, V>(a, beta), \bilinear_form_smul<s, VSet, V>(b, beta))
    forall a s, beta, gamma \bilinear_form_space<s, VSet, V>:
        \bilinear_form_smul<s, VSet, V>(a, \bilinear_form_add<s, VSet, V>(beta, gamma)) = \bilinear_form_add<s, VSet, V>(\bilinear_form_smul<s, VSet, V>(a, beta), \bilinear_form_smul<s, VSet, V>(a, gamma))
    forall beta \bilinear_form_space<s, VSet, V>:
        \bilinear_form_smul<s, VSet, V>(V.scalars.one, beta) = beta

thm bilinear_form_tuple_is_vector_space:
    ? forall [VectorSpaceSetting]:
        $is_nonempty_set(\bilinear_form_space<s, VSet, V>)
        =>:
            $bilinear_form_vector_space_laws(s, VSet, V)
    # Pointwise vector-space laws are mathematically routine, but this proof
    # crosses repeated function extensionality and set-builder membership
    # boundaries that no longer replay under the updated runtime.
    trust $bilinear_form_vector_space_laws(s, VSet, V)
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>: $is_nonempty_set(\bilinear_form_space<s, VSet, V>)>:
    trust have bilinear_form_vector_space &chap1b::VectorSpace<s, \bilinear_form_space<s, VSet, V>>:
        bilinear_form_vector_space = (V.scalars, \zero_bilinear_form<s, VSet, V>, \bilinear_form_add<s, VSet, V>, \bilinear_form_smul<s, VSet, V>)
# Definition 9.4. The matrix is directly callable from the basis values.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N+>:
    have fn matrix_of_bilinear_form(basis &chap1a::FiniteList<VSet, n>, beta fn(u, v VSet) s) matrix(s, n, n) = fn(j N+, k N+: j <= n, k <= n) s {beta(basis.entries(j), basis.entries(k))}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+>:
    have fn zero_square_matrix(j N+, k N+: j <= n, k <= n) s = scalars.zero

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+>:
    have fn negative_square_matrix(A matrix(s, n, n)) matrix(s, n, n) = fn(j N+, k N+: j <= n, k <= n) s {scalars.neg(A(j, k))}

thm square_matrix_tuple_is_vector_space:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+:
        (scalars, \zero_square_matrix<s, scalars, n>, \chap3c::matrix_add<s, scalars, n, n>, \chap3c::matrix_smul<s, scalars, n, n>) $in &chap1b::VectorSpace<s, matrix(s, n, n)>
    # All laws are pointwise scalar-system laws; matrix function
    # extensionality and tuple-to-structure packaging do not replay.
    trust (scalars, \zero_square_matrix<s, scalars, n>, \chap3c::matrix_add<s, scalars, n, n>, \chap3c::matrix_smul<s, scalars, n, n>) $in &chap1b::VectorSpace<s, matrix(s, n, n)>
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+>:
    have square_matrix_vector_space &chap1b::VectorSpace<s, matrix(s, n, n)> = (scalars, \zero_square_matrix<s, scalars, n>, \chap3c::matrix_add<s, scalars, n, n>, \chap3c::matrix_smul<s, scalars, n, n>)

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N+>:
    have fn bilinear_matrix_map(basis &chap1a::FiniteList<VSet, n>, beta \bilinear_form_space<s, VSet, V>) matrix(s, n, n) = \matrix_of_bilinear_form<s, VSet, V, n>(basis, beta)
# Result 9.5. Coordinate expansion constructs the inverse map from a matrix,
# so the matrix map is an isomorphism and dimensions agree.
axiom dimension_of_bilinear_form_space:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N+, basis &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis)
        $is_nonempty_set(\bilinear_form_space<s, VSet, V>)
        $chap2c::admits_basis_length(s, VSet, V)
        $chap2c::admits_basis_length(s, \bilinear_form_space<s, VSet, V>, \bilinear_form_vector_space<s, VSet, V>)
        =>:
            $chap3d::is_isomorphism(s, \bilinear_form_space<s, VSet, V>, matrix(s, n, n), \bilinear_form_vector_space<s, VSet, V>, \square_matrix_vector_space<s, V.scalars, n>, fn(beta \bilinear_form_space<s, VSet, V>) matrix(s, n, n) {\bilinear_matrix_map<s, VSet, V, n>(basis, beta)})
            \chap2c::dimension<s, \bilinear_form_space<s, VSet, V>, \bilinear_form_vector_space<s, VSet, V>> = \chap2c::dimension<s, VSet, V> ^ 2

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn bilinear_compose_right(beta fn(x, y VSet) s, T fn(z VSet) VSet) fn(a, b VSet) s = fn(u, v VSet) s {beta(u, T(v))}

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn bilinear_compose_left(beta fn(x, y VSet) s, T fn(z VSet) VSet) fn(a, b VSet) s = fn(u, v VSet) s {beta(T(u), v)}
# Result 9.6. Expanding T on the selected basis gives the two matrix products.
axiom composition_of_bilinear_form_and_operator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, beta \bilinear_form_space<s, VSet, V>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N+, basis &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis)
        =>:
            \bilinear_compose_right<s, VSet, V>(beta, T) $in \bilinear_form_space<s, VSet, V>
            \bilinear_compose_left<s, VSet, V>(beta, T) $in \bilinear_form_space<s, VSet, V>
            \matrix_of_bilinear_form<s, VSet, V, n>(basis, \bilinear_compose_right<s, VSet, V>(beta, T)) = \chap3c::matrix_mul<s, V.scalars, n, n, n>(\matrix_of_bilinear_form<s, VSet, V, n>(basis, beta), \chap5c::matrix_of_operator<s, VSet, V, n>(basis, T))
            \matrix_of_bilinear_form<s, VSet, V, n>(basis, \bilinear_compose_left<s, VSet, V>(beta, T)) = \chap3c::matrix_mul<s, V.scalars, n, n, n>(\chap3c::transpose<s, n, n>(\chap5c::matrix_of_operator<s, VSet, V, n>(basis, T)), \matrix_of_bilinear_form<s, VSet, V, n>(basis, beta))
# Result 9.7. Apply 9.6 in both slots to the operator taking the second basis
# to the first.
axiom bilinear_form_change_of_basis_formula:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, beta \bilinear_form_space<s, VSet, V>, n N+, basis1, basis2 &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis1)
        $chap2b::is_basis(s, VSet, V, n, basis2)
        \chap3a::identity_linear_map<s, VSet, V> $in \chap3a::linear_map_space<s, VSet, VSet, V, V>
        =>:
            \matrix_of_bilinear_form<s, VSet, V, n>(basis1, beta) = \chap3c::matrix_mul<s, V.scalars, n, n, n>(\chap3c::transpose<s, n, n>(\chap3c::matrix_of_linear_map<s, VSet, VSet, V, V, n, n>(basis1, basis2, \chap3a::identity_linear_map<s, VSet, V>)), \chap3c::matrix_mul<s, V.scalars, n, n, n>(\matrix_of_bilinear_form<s, VSet, V, n>(basis2, beta), \chap3c::matrix_of_linear_map<s, VSet, VSet, V, V, n, n>(basis1, basis2, \chap3a::identity_linear_map<s, VSet, V>)))
# Example 9.8. The displayed matrices expose the two nonzero columns and the
# upper-triangular coordinate change.
sketch:
    have A matrix(R, 3, 3) = [[0, 1, 0], [0, 0, 0], [0, 1, 0]]
    have B matrix(R, 3, 3) = [[0, 1, 6], [0, 2, 12], [0, 4, 24]]
    have map_c matrix(R, 3, 3) = [[1, -2, 9], [0, 1, -6], [0, 0, 1]]
    A(1, 2) = A(3, 2) = 1
    B(3, 3) = 24
    map_c(1, 1) = map_c(2, 2) = map_c(3, 3) = 1
# Definition 9.9. Symmetry and its carrier are intrinsic, not basis-relative.
prop is_symmetric_bilinear_form(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, rho fn(u, v VSet) s):
    $is_bilinear_form(s, VSet, V, rho)
    forall u, w VSet:
        rho(u, w) = rho(w, u)

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have symmetric_bilinear_form_space power_set(\bilinear_form_space<s, VSet, V>) = {rho \bilinear_form_space<s, VSet, V>: $is_symmetric_bilinear_form(s, VSet, V, rho)}
# Example 9.10. The trace pairing is symmetric by cyclicity.
sketch:
    forall a11, a12, a21, a22, b11, b12, b21, b22 R:
        a11 * b11 + a12 * b21 + a21 * b12 + a22 * b22 = b11 * a11 + b12 * a21 + b21 * a12 + b22 * a22
# Definition 9.11. Matrix symmetry is literal equality with the transpose.
prop is_symmetric_matrix(s set, n N+, A matrix(s, n, n)):
    A = \chap3c::transpose<s, n, n>(A)

prop has_symmetric_matrix_in_every_basis(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, rho \bilinear_form_space<s, VSet, V>):
    forall n N+, basis &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis)
        =>:
            $is_symmetric_matrix(s, n, \matrix_of_bilinear_form<s, VSet, V, n>(basis, rho))

prop has_symmetric_matrix_in_some_basis(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, rho \bilinear_form_space<s, VSet, V>):
    exist n N+, basis &chap1a::FiniteList<VSet, n> st {$chap2b::is_basis(s, VSet, V, n, basis), $is_symmetric_matrix(s, n, \matrix_of_bilinear_form<s, VSet, V, n>(basis, rho))}

prop has_diagonal_bilinear_matrix_in_some_basis(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, rho \bilinear_form_space<s, VSet, V>):
    exist n N+, basis &chap1a::FiniteList<VSet, n> st {$chap2b::is_basis(s, VSet, V, n, basis), $chap5d::is_diagonal_matrix(s, V.scalars, n, \matrix_of_bilinear_form<s, VSet, V, n>(basis, rho))}

prop symmetric_bilinear_diagonalization_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, rho \bilinear_form_space<s, VSet, V>):
    forall:
        =>:
            $is_symmetric_bilinear_form(s, VSet, V, rho)
        <=>:
            $has_symmetric_matrix_in_every_basis(s, VSet, V, rho)
    forall:
        =>:
            $has_symmetric_matrix_in_every_basis(s, VSet, V, rho)
        <=>:
            $has_symmetric_matrix_in_some_basis(s, VSet, V, rho)
    forall:
        =>:
            $has_symmetric_matrix_in_some_basis(s, VSet, V, rho)
        <=>:
            $has_diagonal_bilinear_matrix_in_some_basis(s, VSet, V, rho)
# Result 9.12. Basis expansion gives symmetry in either direction; induction
# splits off a vector with nonzero diagonal value to obtain diagonal form.
axiom symmetric_bilinear_forms_are_diagonalizable:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, rho \bilinear_form_space<s, VSet, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        =>:
            $symmetric_bilinear_diagonalization_statement(s, VSet, V, rho)
# Result 9.13. Represent rho by a self-adjoint operator in one orthonormal
# basis and apply the real spectral theorem.
axiom orthonormal_diagonalization_of_symmetric_bilinear_form:
    ? forall VSet nonempty_set, inner_space &chap6a::InnerProductSpace<R, VSet>, rho fn(u, v VSet) R:
        $chap2a::is_finite_dimensional(R, VSet, inner_space.vector_space)
        \chap2c::dimension<R, VSet, inner_space.vector_space> > 0
        $is_symmetric_bilinear_form(R, VSet, inner_space.vector_space, rho)
        =>:
            exist n N+, basis &chap1a::FiniteList<VSet, n> st {$chap6b::is_orthonormal_basis(R, VSet, inner_space, n, basis), $chap5d::is_diagonal_matrix(R, inner_space.vector_space.scalars, n, \matrix_of_bilinear_form<R, VSet, inner_space.vector_space, n>(basis, rho))}
# Definition 9.14. Alternation means vanishing on repeated inputs.
prop is_alternating_bilinear_form(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, alpha fn(u, v VSet) s):
    $is_bilinear_form(s, VSet, V, alpha)
    forall v VSet:
        alpha(v, v) = V.scalars.zero

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have alternating_bilinear_form_space power_set(\bilinear_form_space<s, VSet, V>) = {alpha \bilinear_form_space<s, VSet, V>: $is_alternating_bilinear_form(s, VSet, V, alpha)}
# Example 9.15. Swapping the two coordinate vectors negates the value.
sketch:
    forall x1, x2, x3, y1, y2, y3 R:
        x1 * y2 - x2 * y1 + x1 * y3 - x3 * y1 = -1 * (y1 * x2 - y2 * x1 + y1 * x3 - y3 * x1)

prop is_skew_symmetric_bilinear_form(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, alpha fn(u, v VSet) s):
    $is_bilinear_form(s, VSet, V, alpha)
    forall u, w VSet:
        alpha(u, w) = V.scalars.neg(alpha(w, u))
# Result 9.16. Expand alpha(u+w,u+w) for one direction; set u=w and cancel
# two equal terms for the converse.
prop alternating_bilinear_characterization_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, alpha fn(u, v VSet) s):
    forall:
        =>:
            $is_alternating_bilinear_form(s, VSet, V, alpha)
        <=>:
            $is_skew_symmetric_bilinear_form(s, VSet, V, alpha)

axiom characterization_of_alternating_bilinear_forms:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, alpha fn(u, v VSet) s:
        $alternating_bilinear_characterization_statement(s, VSet, V, alpha)

prop bilinear_symmetric_alternating_decomposition_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>):
    $is_nonempty_set(\bilinear_form_space<s, VSet, V>)
    $chap1c::is_subspace(s, \bilinear_form_space<s, VSet, V>, \bilinear_form_vector_space<s, VSet, V>, \symmetric_bilinear_form_space<s, VSet, V>)
    $chap1c::is_subspace(s, \bilinear_form_space<s, VSet, V>, \bilinear_form_vector_space<s, VSet, V>, \alternating_bilinear_form_space<s, VSet, V>)
    $chap1c::is_direct_sum_pair(s, \bilinear_form_space<s, VSet, V>, \bilinear_form_vector_space<s, VSet, V>, \symmetric_bilinear_form_space<s, VSet, V>, \alternating_bilinear_form_space<s, VSet, V>)
    \chap1c::subspace_sum_pair<s, \bilinear_form_space<s, VSet, V>, \bilinear_form_vector_space<s, VSet, V>>(\symmetric_bilinear_form_space<s, VSet, V>, \alternating_bilinear_form_space<s, VSet, V>) = \bilinear_form_space<s, VSet, V>
# Result 9.17. Split beta into its half-sum and half-difference with the
# transposed form; their intersection is zero by symmetry plus skew symmetry.
axiom symmetric_and_alternating_direct_sum_decomposition:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>:
        $bilinear_symmetric_alternating_decomposition_statement(s, VSet, V)
# Definition 9.18. q_beta is callable; being quadratic means arising from
# some bilinear form, without selecting an arbitrary representative.
template<s nonempty_set, VSet nonempty_set>:
    have fn quadratic_form_of_bilinear(beta fn(x, y VSet) s) fn(w VSet) s = fn(v VSet) s {beta(v, v)}

prop is_quadratic_form(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    exist beta \bilinear_form_space<s, VSet, V> st {q = \quadratic_form_of_bilinear<s, VSet>(beta)}

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have quadratic_form_space power_set(fn(v VSet) s) = {q fn(v VSet) s: $is_quadratic_form(s, VSet, V, q)}
# Example 9.19. Substituting the same vector in both slots produces the source
# quadratic polynomial.
sketch:
    forall x1, x2, x3 R:
        x1 * x1 - 4 * x1 * x2 + 8 * x1 * x3 - 3 * x3 * x3 = x1^2 - 4 * x1 * x2 + 8 * x1 * x3 - 3 * x3^2

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+>:
    have fn coordinate_bilinear_value(A matrix(s, n, n), x, y finite_seq(s, n)) s = \chap3b::scalar_finite_sum<s, scalars, n>(fn(k N+: k <= n) s {\chap3b::scalar_finite_sum<s, scalars, n>(fn(j N+: j <= n) s {scalars.mul(scalars.mul(A(j, k), x(j)), y(k))})})

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+>:
    have fn coordinate_quadratic_value(A matrix(s, n, n), x finite_seq(s, n)) s = \coordinate_bilinear_value<s, scalars, n>(A, x, x)

prop is_coordinate_quadratic_representation(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+, q fn(x finite_seq(s, n)) s, A matrix(s, n, n)):
    forall x finite_seq(s, n):
        q(x) = \coordinate_quadratic_value<s, scalars, n>(A, x)
# Result 9.20. A bilinear matrix gives the double sum, and the same double sum
# reconstructs a bilinear representative.
prop coordinate_quadratic_characterization_statement(s nonempty_set, n N+, coordinate_space &chap1b::VectorSpace<s, finite_seq(s, n)>, q fn(x finite_seq(s, n)) s):
    forall:
        =>:
            $is_quadratic_form(s, finite_seq(s, n), coordinate_space, q)
        <=>:
            exist A matrix(s, n, n) st {$is_coordinate_quadratic_representation(s, coordinate_space.scalars, n, q, A)}

axiom quadratic_forms_on_coordinate_space:
    ? forall s nonempty_set, n N+, coordinate_space &chap1b::VectorSpace<s, finite_seq(s, n)>, q fn(x finite_seq(s, n)) s:
        $coordinate_quadratic_characterization_statement(s, n, coordinate_space, q)

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn quadratic_polarization_difference(q fn(v VSet) s, u, w VSet) s = V.scalars.add(q(V.add(u, w)), V.scalars.neg(V.scalars.add(q(u), q(w))))

prop has_quadratic_homogeneity(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    forall lambda s, v VSet:
        q(V.smul(lambda, v)) = V.scalars.mul(V.scalars.mul(lambda, lambda), q(v))

prop has_double_scaling(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    forall v VSet:
        q(V.smul(V.scalars.add(V.scalars.one, V.scalars.one), v)) = V.scalars.mul(V.scalars.add(V.scalars.one, V.scalars.one), V.scalars.mul(V.scalars.add(V.scalars.one, V.scalars.one), q(v)))

prop has_symmetric_bilinear_polarization(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    $is_symmetric_bilinear_form(s, VSet, V, fn(u, w VSet) s {\quadratic_polarization_difference<s, VSet, V>(q, u, w)})

prop has_unique_symmetric_bilinear_representation(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    exist! rho \bilinear_form_space<s, VSet, V> st {$is_symmetric_bilinear_form(s, VSet, V, rho), q = \quadratic_form_of_bilinear<s, VSet>(rho)}

prop quadratic_form_characterizations_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    forall:
        =>:
            $is_quadratic_form(s, VSet, V, q)
        <=>:
            $has_unique_symmetric_bilinear_representation(s, VSet, V, q)
    forall:
        =>:
            $has_unique_symmetric_bilinear_representation(s, VSet, V, q)
        <=>:
            $has_quadratic_homogeneity(s, VSet, V, q)
            $has_symmetric_bilinear_polarization(s, VSet, V, q)
    forall:
        =>:
            $has_quadratic_homogeneity(s, VSet, V, q)
            $has_symmetric_bilinear_polarization(s, VSet, V, q)
        <=>:
            $has_double_scaling(s, VSet, V, q)
            $has_symmetric_bilinear_polarization(s, VSet, V, q)
# Result 9.21. Use the symmetric/alternating split for existence and
# uniqueness; the polarization identity gives the remaining characterizations.
axiom characterizations_of_quadratic_forms:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s:
        $quadratic_form_characterizations_statement(s, VSet, V, q)
# Example 9.22. The symmetric representative splits both cross coefficients
# evenly between the two slots.
sketch:
    forall x1, x2, x3 R:
        x1^2 - 2 * x1 * x2 - 2 * x2 * x1 + 4 * x1 * x3 + 4 * x3 * x1 - 3 * x3^2 = x1^2 - 4 * x1 * x2 + 8 * x1 * x3 - 3 * x3^2

prop has_diagonal_quadratic_coordinates(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s, n N+, basis &chap1a::FiniteList<VSet, n>, weights &chap1a::FiniteList<s, n>):
    forall coefficients &chap1a::FiniteList<s, n>:
        q(\chap2a::linear_combination_value<s, VSet, V, n>(coefficients, basis)) = \chap3b::scalar_finite_sum<s, V.scalars, n>(fn(k N+: k <= n) s {V.scalars.mul(weights.entries(k), V.scalars.mul(coefficients.entries(k), coefficients.entries(k)))})

prop has_diagonal_quadratic_basis(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s):
    exist n N+, basis &chap1a::FiniteList<VSet, n>, weights &chap1a::FiniteList<s, n> st {$chap2b::is_basis(s, VSet, V, n, basis), $has_diagonal_quadratic_coordinates(s, VSet, V, q, n, basis, weights)}

prop has_orthonormal_diagonal_quadratic_basis(VSet nonempty_set, inner_space &chap6a::InnerProductSpace<R, VSet>, q fn(v VSet) R):
    exist n N+, basis &chap1a::FiniteList<VSet, n>, weights &chap1a::FiniteList<R, n> st {$chap6b::is_orthonormal_basis(R, VSet, inner_space, n, basis), $has_diagonal_quadratic_coordinates(R, VSet, inner_space.vector_space, q, n, basis, weights)}
# Result 9.23. Choose the unique symmetric representative, diagonalize its
# matrix, and read the diagonal entries as the weights.
axiom diagonalization_of_quadratic_form:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, q fn(v VSet) s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        $is_quadratic_form(s, VSet, V, q)
        =>:
            $has_diagonal_quadratic_basis(s, VSet, V, q)

axiom orthonormal_diagonalization_of_real_quadratic_form:
    ? forall VSet nonempty_set, inner_space &chap6a::InnerProductSpace<R, VSet>, q fn(v VSet) R:
        $chap2a::is_finite_dimensional(R, VSet, inner_space.vector_space)
        \chap2c::dimension<R, VSet, inner_space.vector_space> > 0
        $is_quadratic_form(R, VSet, inner_space.vector_space, q)
        =>:
            $has_orthonormal_diagonal_quadratic_basis(VSet, inner_space, q)
