# Linear Algebra Done Right, fourth edition — Section 7D.
# Isometries, Unitary Operators, and Matrix Factorization.
# Definition 7.44. An isometry is exactly a linear map that preserves the
# norm of every vector.
prop is_isometry(s nonempty_set, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, Winner &chap6a::InnerProductSpace<s, W>, S \chap3a::linear_map_space<s, V, W, Vinner.vector_space, Winner.vector_space>):
    Vinner.scalar_geometry = Winner.scalar_geometry
    forall v V:
        \chap6a::norm<s, W>(Winner, S(v)) = \chap6a::norm<s, V>(Vinner, v)
# Every isometry is injective: S(v)=0 makes ||v||=||S(v)||=0.
# Example 7.45 uses Parseval twice after sending one orthonormal basis to an
# orthonormal list; that calculation is subsumed by Result 7.49 below.
template<V, W set, n N>:
    have fn linear_map_image_list(S fn(v V) W, vectors &chap1a::FiniteList<V, n>) &chap1a::FiniteList<W, n> = (n, fn(k N_pos: k <= n) W {S(vectors.entries(k))})

template<s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos>:
    have fn coordinate_inner_product(x, y finite_seq(s, n)) s = \chap3b::scalar_finite_sum<s, scalar_geometry.scalars, n>(fn(k N_pos: k <= n) s {scalar_geometry.scalars.mul(x(k), scalar_geometry.conjugate(y(k)))})

prop are_matrix_columns_orthonormal(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, m, n N_pos, A matrix(s, m, n)):
    forall j, k N_pos:
        j <= n
        k <= n
        j = k
        =>:
            \coordinate_inner_product<s, scalar_geometry, m>(\chap3c::matrix_column<s, m, n>(A, j), \chap3c::matrix_column<s, m, n>(A, k)) = scalar_geometry.scalars.one
    forall j, k N_pos:
        j <= n
        k <= n
        j != k
        =>:
            \coordinate_inner_product<s, scalar_geometry, m>(\chap3c::matrix_column<s, m, n>(A, j), \chap3c::matrix_column<s, m, n>(A, k)) = scalar_geometry.scalars.zero

prop preserves_inner_products(s nonempty_set, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, Winner &chap6a::InnerProductSpace<s, W>, S \chap3a::linear_map_space<s, V, W, Vinner.vector_space, Winner.vector_space>):
    Vinner.scalar_geometry = Winner.scalar_geometry
    forall u, v V:
        Winner.inner(S(u), S(v)) = Vinner.inner(u, v)
# Result 7.49. The source proof is the cycle: a zero quadratic form gives
# S* S=I; move S through the inner product; inspect one orthonormal basis;
# translate those vectors into matrix columns; then apply Parseval backwards.
prop isometry_characterizations_statement(s nonempty_set, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, Winner &chap6a::InnerProductSpace<s, W>, n, m N_pos, domain_basis &chap1a::FiniteList<V, n>, codomain_basis &chap1a::FiniteList<W, m>, S \chap3a::linear_map_space<s, V, W, Vinner.vector_space, Winner.vector_space>):
    $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
    forall:
        =>:
            $is_isometry(s, V, W, Vinner, Winner, S)
        <=>:
            \chap3a::linear_map_compose<s, V, W, V, Vinner.vector_space, Winner.vector_space, Vinner.vector_space>(\chap7a::adjoint<s, V, W, Vinner, Winner>(S), S) = \chap3a::identity_linear_map<s, V, Vinner.vector_space>
    forall:
        =>:
            \chap3a::linear_map_compose<s, V, W, V, Vinner.vector_space, Winner.vector_space, Vinner.vector_space>(\chap7a::adjoint<s, V, W, Vinner, Winner>(S), S) = \chap3a::identity_linear_map<s, V, Vinner.vector_space>
        <=>:
            $preserves_inner_products(s, V, W, Vinner, Winner, S)
    forall:
        =>:
            $preserves_inner_products(s, V, W, Vinner, Winner, S)
        <=>:
            $chap6b::is_orthonormal(s, W, Winner, n, \linear_map_image_list<V, W, n>(S, domain_basis))
    forall:
        =>:
            $chap6b::is_orthonormal(s, W, Winner, n, \linear_map_image_list<V, W, n>(S, domain_basis))
        <=>:
            $are_matrix_columns_orthonormal(s, Vinner.scalar_geometry, m, n, \chap3c::matrix_of_linear_map<s, V, W, Vinner.vector_space, Winner.vector_space, n, m>(domain_basis, codomain_basis, S))

axiom characterizations_of_isometries:
    ? forall s nonempty_set, V, W nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, Winner &chap6a::InnerProductSpace<s, W>, n, m N_pos, domain_basis &chap1a::FiniteList<V, n>, codomain_basis &chap1a::FiniteList<W, m>, S \chap3a::linear_map_space<s, V, W, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
        $chap2a::is_finite_dimensional(s, W, Winner.vector_space)
        $chap6b::is_orthonormal_basis(s, V, Vinner, n, domain_basis)
        $chap6b::is_orthonormal_basis(s, W, Winner, m, codomain_basis)
        =>:
            $isometry_characterizations_statement(s, V, W, Vinner, Winner, n, m, domain_basis, codomain_basis, S)
# Definition 7.51. The source says invertible isometry, then notes that
# invertibility is redundant in this finite-dimensional chapter. We retain the
# standing finite-dimensional hypothesis and the one substantive condition.
prop is_unitary_operator(s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, S \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>):
    $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
    $is_isometry(s, V, V, Vinner, Vinner, S)
# Example 7.52 is the rotation matrix: its two orthonormal columns make the
# corresponding operator unitary.
prop has_adjoint_two_sided_identity(s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, S \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>):
    $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
    \chap3a::linear_map_compose<s, V, V, V, Vinner.vector_space, Vinner.vector_space, Vinner.vector_space>(\chap7a::adjoint<s, V, V, Vinner, Vinner>(S), S) = \chap3a::identity_linear_map<s, V, Vinner.vector_space>
    \chap3a::linear_map_compose<s, V, V, V, Vinner.vector_space, Vinner.vector_space, Vinner.vector_space>(S, \chap7a::adjoint<s, V, V, Vinner, Vinner>(S)) = \chap3a::identity_linear_map<s, V, Vinner.vector_space>

prop adjoint_is_inverse(s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, S \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>):
    $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
    $chap3d::is_inverse_linear_map(s, V, V, Vinner.vector_space, Vinner.vector_space, S, \chap7a::adjoint<s, V, V, Vinner, Vinner>(S))

prop are_matrix_rows_orthonormal(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, m, n N_pos, A matrix(s, m, n)):
    forall j, k N_pos:
        j <= m
        k <= m
        j = k
        =>:
            \coordinate_inner_product<s, scalar_geometry, n>(\chap3c::matrix_row<s, m, n>(A, j), \chap3c::matrix_row<s, m, n>(A, k)) = scalar_geometry.scalars.one
    forall j, k N_pos:
        j <= m
        k <= m
        j != k
        =>:
            \coordinate_inner_product<s, scalar_geometry, n>(\chap3c::matrix_row<s, m, n>(A, j), \chap3c::matrix_row<s, m, n>(A, k)) = scalar_geometry.scalars.zero
# Result 7.53. Follow the source's six-condition cycle; each adjacent iff is
# one mathematical edge rather than an expanded inverse/associativity proof.
prop unitary_operator_characterizations_statement(s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, n N_pos, basis &chap1a::FiniteList<V, n>, S \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>):
    $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
    forall:
        =>:
            $is_unitary_operator(s, V, Vinner, S)
        <=>:
            $has_adjoint_two_sided_identity(s, V, Vinner, S)
    forall:
        =>:
            $has_adjoint_two_sided_identity(s, V, Vinner, S)
        <=>:
            $adjoint_is_inverse(s, V, Vinner, S)
    forall:
        =>:
            $adjoint_is_inverse(s, V, Vinner, S)
        <=>:
            $chap6b::is_orthonormal_basis(s, V, Vinner, n, \linear_map_image_list<V, V, n>(S, basis))
    forall:
        =>:
            $chap6b::is_orthonormal_basis(s, V, Vinner, n, \linear_map_image_list<V, V, n>(S, basis))
        <=>:
            $are_matrix_rows_orthonormal(s, Vinner.scalar_geometry, n, n, \chap5c::matrix_of_operator<s, V, Vinner.vector_space, n>(basis, S))
    forall:
        =>:
            $are_matrix_rows_orthonormal(s, Vinner.scalar_geometry, n, n, \chap5c::matrix_of_operator<s, V, Vinner.vector_space, n>(basis, S))
        <=>:
            $is_unitary_operator(s, V, Vinner, \chap7a::adjoint<s, V, V, Vinner, Vinner>(S))

axiom characterizations_of_unitary_operators:
    ? forall s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, n N_pos, basis &chap1a::FiniteList<V, n>, S \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>:
        $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
        $chap6b::is_orthonormal_basis(s, V, Vinner, n, basis)
        =>:
            $unitary_operator_characterizations_statement(s, V, Vinner, n, basis, S)
# Result 7.54. For a nonzero eigenvector v, homogeneity and isometry give
# |lambda| ||v|| = ||lambda v|| = ||S v|| = ||v||; cancel ||v||.
thm eigenvalues_of_unitary_operators_have_absolute_value_one:
    ? forall s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, S \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>, lambda s:
        $is_unitary_operator(s, V, Vinner, S)
        $chap5a::is_eigenvalue(s, V, Vinner.vector_space, S, lambda)
        =>:
            Vinner.scalar_geometry.absolute_value(lambda) = 1
    obtain v from exist v V st {v != &chap1b::VectorSpace<s, V>{Vinner.vector_space}.zero, S(v) = &chap1b::VectorSpace<s, V>{Vinner.vector_space}.smul(lambda, v)}
    by thm chap6a::basic_properties_of_the_norm(s, V, Vinner, v)
    \chap6a::norm<s, V>(Vinner, &chap1b::VectorSpace<s, V>{Vinner.vector_space}.smul(lambda, v)) = Vinner.scalar_geometry.absolute_value(lambda) * \chap6a::norm<s, V>(Vinner, v)
    \chap6a::norm<s, V>(Vinner, S(v)) = \chap6a::norm<s, V>(Vinner, v)
    Vinner.scalar_geometry.absolute_value(lambda) * \chap6a::norm<s, V>(Vinner, v) = \chap6a::norm<s, V>(Vinner, v)
    \chap6a::norm<s, V>(Vinner, v) != 0
    Vinner.scalar_geometry.absolute_value(lambda) = \chap6a::norm<s, V>(Vinner, v) / \chap6a::norm<s, V>(Vinner, v) = 1

prop has_only_unit_modulus_entries(n N, eigenvalues &chap1a::FiniteList<&chap1a::Complex, n>):
    forall k N_pos:
        k <= n
        =>:
            chap4::complex_absolute_value(eigenvalues.entries(k)) = 1

prop has_unitary_complex_spectral_data(V nonempty_set, Vinner &chap6a::InnerProductSpace<&chap1a::Complex, V>, S \chap3a::linear_map_space<&chap1a::Complex, V, V, Vinner.vector_space, Vinner.vector_space>):
    exist n N, basis &chap1a::FiniteList<V, n>, eigenvalues &chap1a::FiniteList<&chap1a::Complex, n> st {$chap6b::is_orthonormal_basis(&chap1a::Complex, V, Vinner, n, basis), $chap5a::lists_corresponding_eigenpairs(&chap1a::Complex, V, Vinner.vector_space, S, n, eigenvalues, basis), $has_only_unit_modulus_entries(n, eigenvalues)}
# Result 7.55. Unitary implies normal, so the complex spectral theorem gives
# an orthonormal eigenbasis and 7.54 gives unit-modulus eigenvalues. Conversely,
# those eigenvalues rescale an orthonormal basis without changing it.
prop unitary_complex_spectral_description_statement(V nonempty_set, Vinner &chap6a::InnerProductSpace<&chap1a::Complex, V>, S \chap3a::linear_map_space<&chap1a::Complex, V, V, Vinner.vector_space, Vinner.vector_space>):
    forall:
        =>:
            $is_unitary_operator(&chap1a::Complex, V, Vinner, S)
        <=>:
            $has_unitary_complex_spectral_data(V, Vinner, S)

axiom description_of_unitary_operators_on_complex_inner_product_spaces:
    ? forall V nonempty_set, Vinner &chap6a::InnerProductSpace<&chap1a::Complex, V>, S \chap3a::linear_map_space<&chap1a::Complex, V, V, Vinner.vector_space, Vinner.vector_space>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, V, Vinner.vector_space)
        =>:
            $unitary_complex_spectral_description_statement(V, Vinner, S)
# Definition 7.56. A square matrix is unitary exactly when its columns are
# orthonormal in the coordinate inner product.
prop is_unitary_matrix(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, Qm matrix(s, n, n)):
    $are_matrix_columns_orthonormal(s, scalar_geometry, n, n, Qm)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn matrix_vector_product(A matrix(s, n, n), x finite_seq(s, n)) finite_seq(s, n) = fn(j N_pos: j <= n) s {\chap3b::scalar_finite_sum<s, scalars, n>(fn(k N_pos: k <= n) s {scalars.mul(A(j, k), x(k))})}

template<s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos>:
    have fn coordinate_norm(x finite_seq(s, n)) R = sqrt(scalar_geometry.real_part(\coordinate_inner_product<s, scalar_geometry, n>(x, x)))

prop matrix_preserves_coordinate_norm(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, Qm matrix(s, n, n)):
    forall x finite_seq(s, n):
        \coordinate_norm<s, scalar_geometry, n>(\matrix_vector_product<s, scalar_geometry.scalars, n>(Qm, x)) = \coordinate_norm<s, scalar_geometry, n>(x)

prop has_unitary_matrix_identities(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, Qm matrix(s, n, n)):
    \chap3c::matrix_mul<s, scalar_geometry.scalars, n, n, n>(\chap7a::conjugate_transpose<s, scalar_geometry, n, n>(Qm), Qm) = \chap3d::identity_matrix<s, scalar_geometry.scalars, n>
    \chap3c::matrix_mul<s, scalar_geometry.scalars, n, n, n>(Qm, \chap7a::conjugate_transpose<s, scalar_geometry, n, n>(Qm)) = \chap3d::identity_matrix<s, scalar_geometry.scalars, n>
# Result 7.57. Columns, rows, norm preservation, and the two conjugate-
# transpose identities are four views of the same coordinate isometry.
prop unitary_matrix_characterizations_statement(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, Qm matrix(s, n, n)):
    forall:
        =>:
            $is_unitary_matrix(s, scalar_geometry, n, Qm)
        <=>:
            $are_matrix_rows_orthonormal(s, scalar_geometry, n, n, Qm)
    forall:
        =>:
            $are_matrix_rows_orthonormal(s, scalar_geometry, n, n, Qm)
        <=>:
            $matrix_preserves_coordinate_norm(s, scalar_geometry, n, Qm)
    forall:
        =>:
            $matrix_preserves_coordinate_norm(s, scalar_geometry, n, Qm)
        <=>:
            $has_unitary_matrix_identities(s, scalar_geometry, n, Qm)

axiom characterizations_of_unitary_matrices:
    ? forall s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, Qm matrix(s, n, n):
        $unitary_matrix_characterizations_statement(s, scalar_geometry, n, Qm)

template<s set, n N_pos>:
    have fn matrix_columns(A matrix(s, n, n)) &chap1a::FiniteList<finite_seq(s, n), n> = (n, fn(k N_pos: k <= n) finite_seq(s, n) {\chap3c::matrix_column<s, n, n>(A, k)})

prop has_linearly_independent_columns(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A matrix(s, n, n)):
    $chap2a::is_linearly_independent(s, scalars, finite_seq(s, n), \chap1b::coordinate_space<s, scalars, n>, n, \matrix_columns<s, n>(A))

prop has_positive_real_diagonal(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, Rm matrix(s, n, n)):
    forall k N_pos:
        k <= n
        =>:
            exist r R st {r > 0, Rm(k, k) = scalar_geometry.real_embed(r)}

prop is_qr_factorization(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, A, Qm, Rm matrix(s, n, n)):
    $is_unitary_matrix(s, scalar_geometry, n, Qm)
    $chap5c::is_upper_triangular_matrix(s, scalar_geometry.scalars, n, Rm)
    $has_positive_real_diagonal(s, scalar_geometry, n, Rm)
    A = \chap3c::matrix_mul<s, scalar_geometry.scalars, n, n, n>(Qm, Rm)

prop has_unique_qr_factorization(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, A matrix(s, n, n)):
    exist Qm, Rm matrix(s, n, n) st {$is_qr_factorization(s, scalar_geometry, n, A, Qm, Rm)}
    forall Q1, R1, Q2, R2 matrix(s, n, n):
        $is_qr_factorization(s, scalar_geometry, n, A, Q1, R1)
        $is_qr_factorization(s, scalar_geometry, n, A, Q2, R2)
        =>:
            Q1 = Q2
            R1 = R2
# Result 7.58. Gram-Schmidt on the columns gives Q; the inner-product
# coefficients give the upper-triangular R. Positive diagonal normalization
# makes the Gram-Schmidt list, hence both factors, unique.
axiom qr_factorization:
    ? forall s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, A matrix(s, n, n):
        $has_linearly_independent_columns(s, scalar_geometry.scalars, n, A)
        =>:
            $has_unique_qr_factorization(s, scalar_geometry, n, A)
# Example 7.60 follows that construction for the displayed real 3-by-3
# matrix. Its arithmetic is retained as explanatory source prose.
prop has_strictly_positive_quadratic_form(s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>):
    forall v V:
        v != &chap1b::VectorSpace<s, V>{Vinner.vector_space}.zero
        =>:
            Vinner.scalar_geometry.real_part(Vinner.inner(T(v), v)) > 0

prop positive_invertible_characterization_statement(s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>):
    forall:
        =>:
            $chap7c::is_positive_operator(s, V, Vinner, T)
            $chap3d::is_invertible_linear_map(s, V, V, Vinner.vector_space, Vinner.vector_space, T)
        <=>:
            $has_strictly_positive_quadratic_form(s, V, Vinner, T)
# Result 7.61. Positivity gives nonnegative quadratic values. Invertibility
# rules out zero by 7.43; conversely strict positivity makes the null space
# trivial, hence the finite-dimensional operator invertible.
axiom positive_invertible_operator:
    ? forall s nonempty_set, V nonempty_set, Vinner &chap6a::InnerProductSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vinner.vector_space, Vinner.vector_space>:
        $chap2a::is_finite_dimensional(s, V, Vinner.vector_space)
        $chap7a::is_self_adjoint(s, V, Vinner, T)
        =>:
            $positive_invertible_characterization_statement(s, V, Vinner, T)
# Definition 7.62. Positive definiteness is conjugate symmetry together with
# strict positivity of the quadratic form on every nonzero coordinate vector.
prop is_positive_definite_matrix(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, B matrix(s, n, n)):
    \chap7a::conjugate_transpose<s, scalar_geometry, n, n>(B) = B
    forall x finite_seq(s, n):
        x != \chap1a::coordinate_zero<s, scalar_geometry.scalars, n>
        =>:
            scalar_geometry.real_part(\coordinate_inner_product<s, scalar_geometry, n>(\matrix_vector_product<s, scalar_geometry.scalars, n>(B, x), x)) > 0

prop is_cholesky_factorization(s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, B, Rm matrix(s, n, n)):
    $chap5c::is_upper_triangular_matrix(s, scalar_geometry.scalars, n, Rm)
    $has_positive_real_diagonal(s, scalar_geometry, n, Rm)
    B = \chap3c::matrix_mul<s, scalar_geometry.scalars, n, n, n>(\chap7a::conjugate_transpose<s, scalar_geometry, n, n>(Rm), Rm)
# Result 7.63. Write B=A* A by positivity, take A=QR, and cancel Q*Q to get
# B=R*R. Any second factor gives a second normalized QR factorization of A,
# so QR uniqueness gives equality.
axiom cholesky_factorization:
    ? forall s nonempty_set, scalar_geometry &chap6a::InnerProductScalarGeometry<s>, n N_pos, B matrix(s, n, n):
        $is_positive_definite_matrix(s, scalar_geometry, n, B)
        =>:
            exist! Rm matrix(s, n, n) st {$is_cholesky_factorization(s, scalar_geometry, n, B, Rm)}
