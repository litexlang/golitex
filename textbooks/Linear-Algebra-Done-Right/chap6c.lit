# Linear Algebra Done Right, fourth edition — Section 6C.
# Orthogonal Complements and Minimization Problems.
# Definition 6.46. Orthogonal complement is the actual subset of all vectors
# orthogonal to every member of U.
prop is_orthogonal_to_subspace(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), v VSet):
    forall u U:
        $chap6a::are_orthogonal(s, VSet, inner_space, u, v)

template<s nonempty_set, VSet nonempty_set>:
    have fn orthogonal_complement(inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet)) power_set(VSet) = {v VSet: $is_orthogonal_to_subspace(s, VSet, inner_space, U, v)}
# Example 6.47. The source's lines, planes, coordinate subspaces, and split
# orthonormal basis examples remain explanatory prose.
prop has_orthogonal_complement_properties(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet)):
    $chap1c::is_subspace(s, VSet, inner_space.vector_space, \orthogonal_complement<s, VSet>(inner_space, U))
    \orthogonal_complement<s, VSet>(inner_space, {&chap1b::VectorSpace<s, VSet>{inner_space.vector_space}.zero}) = VSet
    \orthogonal_complement<s, VSet>(inner_space, VSet) = {&chap1b::VectorSpace<s, VSet>{inner_space.vector_space}.zero}
    intersect(U, \orthogonal_complement<s, VSet>(inner_space, U)) $subset {&chap1b::VectorSpace<s, VSet>{inner_space.vector_space}.zero}
    forall G, H power_set(VSet):
        G $subset H
        =>:
            \orthogonal_complement<s, VSet>(inner_space, H) $subset \orthogonal_complement<s, VSet>(inner_space, G)
# Result 6.48. Closure follows from second-slot linearity; the zero, whole-space,
# intersection, and reversed-inclusion clauses follow directly from the set
# definition and definiteness.
axiom properties_of_orthogonal_complement:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet):
        $has_orthogonal_complement_properties(s, VSet, inner_space, U)

prop is_finite_dimensional_subspace(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, U power_set(VSet)):
    $chap1c::is_subspace(s, VSet, V, U)
    $chap2a::is_finite_dimensional(s, U, \chap1c::subspace_vector_space<s, VSet, V, U>)

prop is_orthogonal_direct_decomposition(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet)):
    $chap1c::is_direct_sum_pair(s, VSet, inner_space.vector_space, U, \orthogonal_complement<s, VSet>(inner_space, U))
    \chap1c::subspace_sum_pair<s, VSet, inner_space.vector_space>(U, \orthogonal_complement<s, VSet>(inner_space, U)) = VSet
# Result 6.49. Choose an orthonormal basis of U, split each v into its
# coordinate combination plus orthogonal remainder, and use 6.48(d) for
# directness.
axiom direct_sum_of_subspace_and_orthogonal_complement:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet):
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            $is_orthogonal_direct_decomposition(s, VSet, inner_space, U)
# Result 6.51. Apply the direct-sum dimension formula to 6.49.
axiom dimension_of_orthogonal_complement:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet):
        $chap2a::is_finite_dimensional(s, VSet, inner_space.vector_space)
        $chap1c::is_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            \chap2c::dimension<s, \orthogonal_complement<s, VSet>(inner_space, U), \chap1c::subspace_vector_space<s, VSet, inner_space.vector_space, \orthogonal_complement<s, VSet>(inner_space, U)>> = \chap2c::dimension<s, VSet, inner_space.vector_space> - \chap2c::dimension<s, U, \chap1c::subspace_vector_space<s, VSet, inner_space.vector_space, U>>
# Result 6.52. One inclusion is definitional; decompose a vector in the double
# complement by 6.49 and use the zero intersection for the reverse inclusion.
axiom double_orthogonal_complement:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet):
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            \orthogonal_complement<s, VSet>(inner_space, \orthogonal_complement<s, VSet>(inner_space, U)) = U

prop zero_orthogonal_complement_iff_whole_space_statement(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet)):
    forall:
        =>:
            \orthogonal_complement<s, VSet>(inner_space, U) = {&chap1b::VectorSpace<s, VSet>{inner_space.vector_space}.zero}
        <=>:
            U = VSet
# Result 6.54. Use the double-complement identity and the two zero/whole-space
# clauses of 6.48.
axiom zero_orthogonal_complement_iff_whole_space:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet):
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            $zero_orthogonal_complement_iff_whole_space_statement(s, VSet, inner_space, U)

prop is_orthogonal_projection_value(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), v VSet, u U):
    \chap1b::vector_sub<s, VSet, inner_space.vector_space>(v, u) $in \orthogonal_complement<s, VSet>(inner_space, U)

prop is_orthogonal_projection_of(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), P fn(v VSet) VSet):
    P $in \chap3a::linear_map_space<s, VSet, VSet, inner_space.vector_space, inner_space.vector_space>
    forall v VSet:
        P(v) $in U
        $is_orthogonal_projection_value(s, VSet, inner_space, U, v, P(v))
# Definition 6.55. The decomposition in 6.49 gives one and only one linear map
# satisfying the two component clauses above.
axiom orthogonal_projection_value_exists_unique:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), v VSet:
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            exist! u U st {$is_orthogonal_projection_value(s, VSet, inner_space, U, v, u)}

template<s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet): $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)>:
    have fn orthogonal_projection by exist!:
        ? forall v VSet:
            exist! u U st {$is_orthogonal_projection_value(s, VSet, inner_space, U, v, u)}
        by thm orthogonal_projection_value_exists_unique(s, VSet, inner_space, U, v)

axiom orthogonal_projection_spec:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), v VSet:
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            $is_orthogonal_projection_value(s, VSet, inner_space, U, v, \orthogonal_projection<s, VSet, inner_space, U>(v))

prop is_orthonormal_basis_of_subspace(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), m N, basis &chap1a::FiniteList<VSet, m>):
    $chap6b::is_orthonormal(s, VSet, inner_space, m, basis)
    \chap2a::span<s, VSet, inner_space.vector_space, m>(basis) = U

prop has_orthogonal_projection_properties(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), P fn(v VSet) VSet):
    $is_orthogonal_projection_of(s, VSet, inner_space, U, P)
    forall u U:
        P(u) = u
    forall w \orthogonal_complement<s, VSet>(inner_space, U):
        P(w) = &chap1b::VectorSpace<s, VSet>{inner_space.vector_space}.zero
    \chap3b::range_of<VSet, VSet>(P) = U
    \chap3b::null_space<s, VSet, VSet, inner_space.vector_space, inner_space.vector_space>(P) = \orthogonal_complement<s, VSet>(inner_space, U)
    \chap3a::linear_map_compose<s, VSet, VSet, VSet, inner_space.vector_space, inner_space.vector_space, inner_space.vector_space>(P, P) = P
    forall v VSet:
        \chap1b::vector_sub<s, VSet, inner_space.vector_space>(v, P(v)) $in \orthogonal_complement<s, VSet>(inner_space, U)
        \chap6a::norm<s, VSet>(inner_space, P(v)) <= \chap6a::norm<s, VSet>(inner_space, v)
    forall m N, basis &chap1a::FiniteList<VSet, m>, v VSet:
        $is_orthonormal_basis_of_subspace(s, VSet, inner_space, U, m, basis)
        =>:
            P(v) = \chap2a::linear_combination_value<s, VSet, inner_space.vector_space, m>(\chap6b::inner_product_coordinates<s, VSet, m>(inner_space, v, basis), basis)
# Result 6.57. Read each clause from the unique U plus U-perp decomposition;
# Pythagoras gives the norm bound and orthonormal coordinates give the formula.
axiom properties_of_orthogonal_projection:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet):
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            $has_orthogonal_projection_properties(s, VSet, inner_space, U, fn(v VSet) VSet {\orthogonal_projection<s, VSet, inner_space, U>(v)})

template<s nonempty_set, VSet nonempty_set>:
    have fn riesz_functional(inner_space &chap6a::InnerProductSpace<s, VSet>, v VSet) fn(x VSet) s = fn(u VSet) s {inner_space.inner(u, v)}

prop riesz_correspondence_is_bijection(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>):
    forall v VSet:
        \riesz_functional<s, VSet>(inner_space, v) $in \chap3f::dual_space<s, VSet, inner_space.vector_space>
    forall v1, v2 VSet:
        \riesz_functional<s, VSet>(inner_space, v1) = \riesz_functional<s, VSet>(inner_space, v2)
        =>:
            v1 = v2
    forall phi \chap3f::dual_space<s, VSet, inner_space.vector_space>:
        exist v VSet st {phi = \riesz_functional<s, VSet>(inner_space, v)}
# Result 6.58. Injectivity is definiteness; surjectivity is the Riesz theorem,
# here recovered by choosing a vector in the orthogonal complement of null phi.
axiom riesz_representation_revisited:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>:
        $chap2a::is_finite_dimensional(s, VSet, inner_space.vector_space)
        =>:
            $riesz_correspondence_is_bijection(s, VSet, inner_space)

prop projection_minimizes_distance_statement(s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), v VSet, u U):
    \chap6a::norm<s, VSet>(inner_space, \chap1b::vector_sub<s, VSet, inner_space.vector_space>(v, \orthogonal_projection<s, VSet, inner_space, U>(v))) <= \chap6a::norm<s, VSet>(inner_space, \chap1b::vector_sub<s, VSet, inner_space.vector_space>(v, u))
    forall:
        =>:
            \chap6a::norm<s, VSet>(inner_space, \chap1b::vector_sub<s, VSet, inner_space.vector_space>(v, \orthogonal_projection<s, VSet, inner_space, U>(v))) = \chap6a::norm<s, VSet>(inner_space, \chap1b::vector_sub<s, VSet, inner_space.vector_space>(v, u))
        <=>:
            u = \orthogonal_projection<s, VSet, inner_space, U>(v)
# Result 6.61. Split v-u into its U-perp projection error and its U component;
# Pythagoras gives the inequality and definiteness gives the equality case.
axiom minimizing_distance_to_a_subspace:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, U power_set(VSet), v VSet, u U:
        $is_finite_dimensional_subspace(s, VSet, inner_space.vector_space, U)
        =>:
            $projection_minimizes_distance_statement(s, VSet, inner_space, U, v, u)

prop null_complement_restriction_is_bijection(s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>):
    $chap3b::is_injective(\orthogonal_complement<s, VSet>(Vinner, \chap3b::null_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T)), \chap3b::range_of<VSet, WSet>(T), fn(x \orthogonal_complement<s, VSet>(Vinner, \chap3b::null_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T))) \chap3b::range_of<VSet, WSet>(T) {T(x)})
    $chap3b::is_surjective(\orthogonal_complement<s, VSet>(Vinner, \chap3b::null_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T)), \chap3b::range_of<VSet, WSet>(T), fn(x \orthogonal_complement<s, VSet>(Vinner, \chap3b::null_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T))) \chap3b::range_of<VSet, WSet>(T) {T(x)})
# Result 6.67. The zero intersection proves injectivity; the null-plus-orthogonal
# decomposition proves surjectivity onto range T.
axiom null_complement_restriction_is_bijective_onto_range:
    ? forall s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, VSet, Vinner.vector_space)
        =>:
            $null_complement_restriction_is_bijection(s, VSet, WSet, Vinner, Winner, T)

prop is_pseudoinverse_of(s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>, D \chap3a::linear_map_space<s, WSet, VSet, Winner.vector_space, Vinner.vector_space>):
    forall w WSet:
        D(w) $in \orthogonal_complement<s, VSet>(Vinner, \chap3b::null_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T))
        \chap1b::vector_sub<s, WSet, Winner.vector_space>(w, T(D(w))) $in \orthogonal_complement<s, WSet>(Winner, \chap3b::range_of<VSet, WSet>(T))
# Definition 6.68. Result 6.67 and orthogonal projection give a unique map with
# the two geometric clauses above; select it only after this exist! theorem.
axiom pseudoinverse_exists_unique:
    ? forall s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, VSet, Vinner.vector_space)
        =>:
            exist! D \chap3a::linear_map_space<s, WSet, VSet, Winner.vector_space, Vinner.vector_space> st {$is_pseudoinverse_of(s, VSet, WSet, Vinner, Winner, T, D)}

template<s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>: $chap2a::is_finite_dimensional(s, VSet, Vinner.vector_space)>:
    have fn pseudoinverse by exist!:
        ? forall T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>:
            exist! D \chap3a::linear_map_space<s, WSet, VSet, Winner.vector_space, Vinner.vector_space> st {$is_pseudoinverse_of(s, VSet, WSet, Vinner, Winner, T, D)}
        by thm pseudoinverse_exists_unique(s, VSet, WSet, Vinner, Winner, T)

axiom pseudoinverse_spec:
    ? forall s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, VSet, Vinner.vector_space)
        =>:
            $is_pseudoinverse_of(s, VSet, WSet, Vinner, Winner, T, \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T))

prop has_pseudoinverse_algebraic_properties(s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>):
    forall:
        $chap3d::is_invertible_linear_map(s, VSet, WSet, Vinner.vector_space, Winner.vector_space, T)
        =>:
            \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T) = \chap3d::inverse_linear_map<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T)
    $is_orthogonal_projection_of(s, WSet, Winner, \chap3b::range_of<VSet, WSet>(T), \chap3a::linear_map_compose<s, WSet, VSet, WSet, Winner.vector_space, Vinner.vector_space, Winner.vector_space>(T, \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T)))
    $is_orthogonal_projection_of(s, VSet, Vinner, \orthogonal_complement<s, VSet>(Vinner, \chap3b::null_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>(T)), \chap3a::linear_map_compose<s, VSet, WSet, VSet, Vinner.vector_space, Winner.vector_space, Vinner.vector_space>(\pseudoinverse<s, VSet, WSet, Vinner, Winner>(T), T))
# Result 6.69. Invertibility collapses null/range to 0/WSet. On range and its
# complement, the two composites are exactly the corresponding projections.
axiom algebraic_properties_of_pseudoinverse:
    ? forall s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>:
        $chap2a::is_finite_dimensional(s, VSet, Vinner.vector_space)
        =>:
            $has_pseudoinverse_algebraic_properties(s, VSet, WSet, Vinner, Winner, T)

prop is_pseudoinverse_solution(s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T fn(v VSet) WSet, D fn(w WSet) VSet, w WSet, v VSet):
    exist z \chap3b::null_space<s, VSet, WSet, V, W>(T) st {v = V.add(D(w), z)}

prop pseudoinverse_residual_equality_iff(s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>, w WSet, v VSet):
    forall:
        =>:
            \chap6a::norm<s, WSet>(Winner, \chap1b::vector_sub<s, WSet, Winner.vector_space>(T(\pseudoinverse<s, VSet, WSet, Vinner, Winner>(T)(w)), w)) = \chap6a::norm<s, WSet>(Winner, \chap1b::vector_sub<s, WSet, Winner.vector_space>(T(v), w))
        <=>:
            $is_pseudoinverse_solution(s, VSet, WSet, Vinner.vector_space, Winner.vector_space, T, \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T), w, v)

prop pseudoinverse_norm_equality_iff(s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>, w WSet, v VSet):
    forall:
        =>:
            \chap6a::norm<s, VSet>(Vinner, \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T)(w)) = \chap6a::norm<s, VSet>(Vinner, v)
        <=>:
            v = \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T)(w)

prop has_pseudoinverse_best_solution_properties(s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>, w WSet):
    forall v VSet:
        \chap6a::norm<s, WSet>(Winner, \chap1b::vector_sub<s, WSet, Winner.vector_space>(T(\pseudoinverse<s, VSet, WSet, Vinner, Winner>(T)(w)), w)) <= \chap6a::norm<s, WSet>(Winner, \chap1b::vector_sub<s, WSet, Winner.vector_space>(T(v), w))
        $pseudoinverse_residual_equality_iff(s, VSet, WSet, Vinner, Winner, T, w, v)
    forall v VSet:
        $is_pseudoinverse_solution(s, VSet, WSet, Vinner.vector_space, Winner.vector_space, T, \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T), w, v)
        =>:
            \chap6a::norm<s, VSet>(Vinner, \pseudoinverse<s, VSet, WSet, Vinner, Winner>(T)(w)) <= \chap6a::norm<s, VSet>(Vinner, v)
            $pseudoinverse_norm_equality_iff(s, VSet, WSet, Vinner, Winner, T, w, v)
# Result 6.70. Split the residual into range and range-perpendicular pieces for
# the best fit; split any best-fit solution into null and null-perpendicular
# pieces for the minimum norm. Pythagoras supplies both equality cases.
axiom pseudoinverse_provides_best_solution:
    ? forall s nonempty_set, VSet, WSet nonempty_set, Vinner &chap6a::InnerProductSpace<s, VSet>, Winner &chap6a::InnerProductSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, Vinner.vector_space, Winner.vector_space>, w WSet:
        $chap2a::is_finite_dimensional(s, VSet, Vinner.vector_space)
        =>:
            $has_pseudoinverse_best_solution_properties(s, VSet, WSet, Vinner, Winner, T, w)
