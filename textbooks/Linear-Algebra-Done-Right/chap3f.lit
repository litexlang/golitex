# Linear Algebra Done Right, fourth edition — Section 3F.
# Duality.
# The scalar field is itself a one-dimensional vector space over itself. This
# selected structure lets the general L(VSet,WSet) interface specialize to WSet=F.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have scalar_vector_space &chap1b::VectorSpace<s, s>:
        scalar_vector_space = (scalars, scalars.zero, scalars.add, scalars.mul)
# Definition 3.108. A linear functional is a linear map VSet -> F.
prop is_linear_functional(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, phi fn(v VSet) s):
    $chap3a::is_linear_map(s, VSet, s, V, \scalar_vector_space<s, V.scalars>, phi)
# Example 3.109 is comment-only: coordinate combinations, derivative
# evaluation, and integration give the source's four linear functionals.
# Definition 3.110. VSet' is L(VSet,F), with its pointwise vector-space structure.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have dual_space power_set(fn(v VSet) s) = \chap3a::linear_map_space<s, VSet, s, V, \scalar_vector_space<s, V.scalars>>

thm dual_space_has_zero:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>:
        \chap3a::zero_linear_map<s, VSet, s, V, \scalar_vector_space<s, V.scalars>> $in \dual_space<s, VSet, V>
    &chap1b::VectorSpace<s, VSet>{V}.scalars = &chap1b::VectorSpace<s, s>{\scalar_vector_space<s, V.scalars>}.scalars
    by thm chap3a::zero_linear_map_is_linear(s, VSet, s, V, \scalar_vector_space<s, V.scalars>)
    \dual_space<s, VSet, V> = \chap3a::linear_map_space<s, VSet, s, V, \scalar_vector_space<s, V.scalars>>
    \chap3a::linear_map_space<s, VSet, s, V, \scalar_vector_space<s, V.scalars>> = {T fn(v VSet) s: $chap3a::is_linear_map(s, VSet, s, V, \scalar_vector_space<s, V.scalars>, T)}
    \chap3a::zero_linear_map<s, VSet, s, V, \scalar_vector_space<s, V.scalars>> $in {T fn(v VSet) s: $chap3a::is_linear_map(s, VSet, s, V, \scalar_vector_space<s, V.scalars>, T)}

thm dual_space_is_nonempty:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>:
        $is_nonempty_set(\dual_space<s, VSet, V>)
    by thm dual_space_has_zero(s, VSet, V)
    witness $is_nonempty_set(\dual_space<s, VSet, V>) from \chap3a::zero_linear_map<s, VSet, s, V, \scalar_vector_space<s, V.scalars>>:
        \chap3a::zero_linear_map<s, VSet, s, V, \scalar_vector_space<s, V.scalars>> $in \dual_space<s, VSet, V>

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>: $is_nonempty_set(\dual_space<s, VSet, V>)>:
    trust have dual_vector_space &chap1b::VectorSpace<s, \dual_space<s, VSet, V>>:
        dual_vector_space = \chap3a::linear_map_vector_space<s, VSet, s, V, \scalar_vector_space<s, V.scalars>>
# Result 3.111. A finite-dimensional space and its dual have equal dimension.
# Trust boundary: the two source conclusions are separated so the selected
# dimension is used only after its finite-dimensional domain fact is available.
axiom dual_space_is_finite_dimensional:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $chap2a::is_finite_dimensional(s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>)

axiom dimension_of_dual_space:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $is_nonempty_set(\dual_space<s, VSet, V>)
        $chap2a::is_finite_dimensional(s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>)
        =>:
            \chap2c::dimension<s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>> = \chap2c::dimension<s, VSet, V>
# Definition 3.112. The dual basis consists of coordinate functionals.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N>:
    trust have dual_basis fn(basis &chap1a::FiniteList<VSet, n>) &chap1a::FiniteList<\dual_space<s, VSet, V>, n>

# Trust boundary: Litex does not yet project a member of the function-subset
# carrier through a nested finite-list entry as a callable function.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N>:
    trust have dual_basis_entry_value fn(basis &chap1a::FiniteList<VSet, n>, v VSet, j N_pos: j <= n) s

prop dual_basis_spec_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N, basis &chap1a::FiniteList<VSet, n>):
    forall j, k N_pos:
        j <= n
        k <= n
        j = k
        =>:
            \dual_basis_entry_value<s, VSet, V, n>(basis, basis.entries(k), j) = V.scalars.one
    forall j, k N_pos:
        j <= n
        k <= n
        j != k
        =>:
            \dual_basis_entry_value<s, VSet, V, n>(basis, basis.entries(k), j) = V.scalars.zero

axiom dual_basis_spec:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N, basis &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis)
        =>:
            $dual_basis_spec_statement(s, VSet, V, n, basis)
# Example 3.113 is comment-only: the dual of the standard coordinate basis
# consists of the coordinate projections.
prop are_dual_basis_coefficients(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N, basis &chap1a::FiniteList<VSet, n>, v VSet, coefficients &chap1a::FiniteList<s, n>):
    forall k N_pos:
        k <= n
        =>:
            coefficients.entries(k) = \dual_basis_entry_value<s, VSet, V, n>(basis, v, k)
# Result 3.114. Applying the dual basis recovers all coefficients of v.
axiom dual_basis_gives_coefficients:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N, basis &chap1a::FiniteList<VSet, n>, v VSet:
        $chap2b::is_basis(s, VSet, V, n, basis)
        =>:
            exist coefficients &chap1a::FiniteList<s, n> st {$are_dual_basis_coefficients(s, VSet, V, n, basis, v, coefficients), v = \chap2a::linear_combination_value<s, VSet, V, n>(coefficients, basis)}
# Result 3.116. The dual basis is a basis of VSet'.
axiom dual_basis_is_basis_of_dual_space:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N, basis &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis)
        =>:
            $chap2b::is_basis(s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>, n, \dual_basis<s, VSet, V, n>(basis))
# Definition 3.118. T'(phi)=phi composed with T. The return type records that
# dual_map(T) is itself a linear map WSet' -> VSet'.
template<s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>>:
    trust have dual_map fn(T \chap3a::linear_map_space<s, VSet, WSet, V, W>) \chap3a::linear_map_space<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>

# The specification is kept outside the nested template because storing it in
# the template body currently loses the bound map parameter T.
prop dual_map_spec(s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>):
    forall phi \dual_space<s, WSet, W>, v VSet:
        \dual_map<s, VSet, WSet, V, W>(T)(phi)(v) = phi(T(v))
# Example 3.119 is comment-only: dualizing differentiation turns evaluation
# into derivative evaluation, and turns integration into endpoint difference.
# Result 3.120. Dualization is additive, homogeneous, and reverses products.
axiom algebraic_properties_of_dual_maps:
    ? forall s nonempty_set, VSet, WSet, USet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, U &chap1b::VectorSpace<s, USet>, S, T \chap3a::linear_map_space<s, VSet, WSet, V, W>, Rmap \chap3a::linear_map_space<s, WSet, USet, W, U>, a s:
        \dual_map<s, VSet, WSet, V, W>(\chap3a::linear_map_add<s, VSet, WSet, V, W>(S, T)) = \chap3a::linear_map_add<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(S), \dual_map<s, VSet, WSet, V, W>(T))
        \dual_map<s, VSet, WSet, V, W>(\chap3a::linear_map_smul<s, VSet, WSet, V, W>(a, T)) = \chap3a::linear_map_smul<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>(a, \dual_map<s, VSet, WSet, V, W>(T))
        \dual_map<s, VSet, USet, V, U>(\chap3a::linear_map_compose<s, VSet, WSet, USet, V, W, U>(Rmap, T)) = \chap3a::linear_map_compose<s, \dual_space<s, USet, U>, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, USet, U>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T), \dual_map<s, WSet, USet, W, U>(Rmap))
# Definition 3.121. USet^0 is the set of functionals that vanish on USet.
prop annihilates(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, USet power_set(VSet), phi \dual_space<s, VSet, V>):
    forall u USet:
        phi(u) = V.scalars.zero

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn annihilator(USet power_set(VSet)) power_set(\dual_space<s, VSet, V>) = {phi \dual_space<s, VSet, V>: $annihilates(s, VSet, V, USet, phi)}
# Examples 3.122 and 3.123 are comment-only: derivative-at-zero annihilates
# multiples of x^2, and span(e1,e2)^0=span(phi3,phi4,phi5) in (R^5)'.
# Result 3.124. Every annihilator is a subspace of the dual.
axiom annihilator_is_subspace:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, USet power_set(VSet):
        $chap1c::is_subspace(s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>, \annihilator<s, VSet, V>(USet))
# Result 3.125. dim USet^0 = dim VSet - dim USet.
axiom dimension_of_annihilator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, USet power_set(VSet):
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap1c::is_subspace(s, VSet, V, USet)
        =>:
            \chap2c::dimension<s, \annihilator<s, VSet, V>(USet), \chap1c::subspace_vector_space<s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>, \annihilator<s, VSet, V>(USet)>> = \chap2c::dimension<s, VSet, V> - \chap2c::dimension<s, USet, \chap1c::subspace_vector_space<s, VSet, V, USet>>
# Result 3.127. The two extreme annihilators characterize USet=VSet and USet={0}.
prop zero_annihilator_iff_whole_space_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, USet power_set(VSet)):
    forall:
        =>:
            \annihilator<s, VSet, V>(USet) = {\chap3a::zero_linear_map<s, VSet, s, V, \scalar_vector_space<s, V.scalars>>}
        <=>:
            USet = VSet

prop full_annihilator_iff_zero_subspace_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, USet power_set(VSet)):
    forall:
        =>:
            \annihilator<s, VSet, V>(USet) = \dual_space<s, VSet, V>
        <=>:
            USet = {V.zero}

axiom extreme_annihilators:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, USet power_set(VSet):
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap1c::is_subspace(s, VSet, V, USet)
        =>:
            $zero_annihilator_iff_whole_space_statement(s, VSet, V, USet)
            $full_annihilator_iff_zero_subspace_statement(s, VSet, V, USet)
# Result 3.128. null(T') is the annihilator of range(T), with the displayed
# finite-dimensional nullity formula.
axiom null_space_of_dual_map:
    ? forall s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap2a::is_finite_dimensional(s, WSet, W)
        =>:
            \chap3b::null_space<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T)) = \annihilator<s, WSet, W>(\chap3b::range_of<VSet, WSet>(T))
            \chap2c::dimension<s, \chap3b::null_space<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T)), \chap1c::subspace_vector_space<s, \dual_space<s, WSet, W>, \dual_vector_space<s, WSet, W>, \chap3b::null_space<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T))>> = \chap2c::dimension<s, \chap3b::null_space<s, VSet, WSet, V, W>(T), \chap1c::subspace_vector_space<s, VSet, V, \chap3b::null_space<s, VSet, WSet, V, W>(T)>> + \chap2c::dimension<s, WSet, W> - \chap2c::dimension<s, VSet, V>
# Result 3.129. T is surjective exactly when T' is injective.
prop surjective_iff_dual_injective_statement(s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>):
    forall:
        =>:
            $chap3b::is_surjective(VSet, WSet, T)
        <=>:
            $chap3b::is_injective(\dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_map<s, VSet, WSet, V, W>(T))

axiom surjective_iff_dual_injective:
    ? forall s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap2a::is_finite_dimensional(s, WSet, W)
        =>:
            $surjective_iff_dual_injective_statement(s, VSet, WSet, V, W, T)
# Result 3.130. range(T') has the same dimension as range(T), and it is the
# annihilator of null(T).
axiom range_of_dual_map:
    ? forall s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap2a::is_finite_dimensional(s, WSet, W)
        =>:
            \chap2c::dimension<s, \chap3b::range_of<\dual_space<s, WSet, W>, \dual_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T)), \chap1c::subspace_vector_space<s, \dual_space<s, VSet, V>, \dual_vector_space<s, VSet, V>, \chap3b::range_of<\dual_space<s, WSet, W>, \dual_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T))>> = \chap2c::dimension<s, \chap3b::range_of<VSet, WSet>(T), \chap1c::subspace_vector_space<s, WSet, W, \chap3b::range_of<VSet, WSet>(T)>>
            \chap3b::range_of<\dual_space<s, WSet, W>, \dual_space<s, VSet, V>>(\dual_map<s, VSet, WSet, V, W>(T)) = \annihilator<s, VSet, V>(\chap3b::null_space<s, VSet, WSet, V, W>(T))
# Result 3.131. T is injective exactly when T' is surjective.
prop injective_iff_dual_surjective_statement(s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>):
    forall:
        =>:
            $chap3b::is_injective(VSet, WSet, T)
        <=>:
            $chap3b::is_surjective(\dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_map<s, VSet, WSet, V, W>(T))

axiom injective_iff_dual_surjective:
    ? forall s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap2a::is_finite_dimensional(s, WSet, W)
        =>:
            $injective_iff_dual_surjective_statement(s, VSet, WSet, V, W, T)
# Result 3.132. Relative to a basis and its dual basis, M(T')=M(T)^t.
axiom matrix_of_dual_is_transpose:
    ? forall s nonempty_set, VSet, WSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, W &chap1b::VectorSpace<s, WSet>, n, m N_pos, v &chap1a::FiniteList<VSet, n>, w &chap1a::FiniteList<WSet, m>, T \chap3a::linear_map_space<s, VSet, WSet, V, W>:
        $chap2b::is_basis(s, VSet, V, n, v)
        $chap2b::is_basis(s, WSet, W, m, w)
        =>:
            \chap3c::matrix_of_linear_map<s, \dual_space<s, WSet, W>, \dual_space<s, VSet, V>, \dual_vector_space<s, WSet, W>, \dual_vector_space<s, VSet, V>, m, n>(\dual_basis<s, WSet, W, m>(w), \dual_basis<s, VSet, V, n>(v), \dual_map<s, VSet, WSet, V, W>(T)) = \chap3c::transpose<s, m, n>(\chap3c::matrix_of_linear_map<s, VSet, WSet, V, W, n, m>(v, w, T))
# Result 3.133. Duality gives another proof that column rank equals row rank.
axiom column_rank_equals_row_rank_by_duality:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N_pos, A matrix(s, m, n):
        \chap3c::column_rank<s, scalars, m, n>(A) = \chap3c::row_rank<s, scalars, m, n>(A)
