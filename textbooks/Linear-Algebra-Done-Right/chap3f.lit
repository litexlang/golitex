# Linear Algebra Done Right, fourth edition — Section 3F.
# Duality.


# The scalar field is itself a one-dimensional vector space over itself. This
# selected structure lets the general L(V,W) interface specialize to W=F.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have scalar_vector_space &chap1b::VectorSpace<s, s>:
        scalar_vector_space = (scalars, scalars.zero, scalars.add, scalars.mul)

# Definition 3.108. A linear functional is a linear map V -> F.
prop is_linear_functional(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, phi fn(v V) s):
    $chap3a::is_linear_map(s, V, s, Vspace, \scalar_vector_space<s, Vspace.scalars>, phi)

# Example 3.109 is comment-only: coordinate combinations, derivative
# evaluation, and integration give the source's four linear functionals.

# Definition 3.110. V' is L(V,F), with its pointwise vector-space structure.
template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    have dual_space set = \chap3a::linear_map_space<s, V, s, Vspace, \scalar_vector_space<s, Vspace.scalars>>

template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    trust have dual_vector_space &chap1b::VectorSpace<s, \dual_space<s, V, Vspace>>:
        dual_vector_space = \chap3a::linear_map_vector_space<s, V, s, Vspace, \scalar_vector_space<s, Vspace.scalars>>

# Result 3.111. A finite-dimensional space and its dual have equal dimension.
axiom dimension_of_dual_space:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        =>:
            \chap2c::dimension<s, \dual_space<s, V, Vspace>, \dual_vector_space<s, V, Vspace>> = \chap2c::dimension<s, V, Vspace>

# Definition 3.112. The dual basis consists of coordinate functionals.
template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N>:
    trust have dual_basis fn(basis &chap1a::FiniteList<V, n>) &chap1a::FiniteList<\dual_space<s, V, Vspace>, n>

prop dual_basis_spec_statement(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N, basis &chap1a::FiniteList<V, n>):
    forall j, k N_pos:
        j <= n
        k <= n
        j = k
        =>:
            &chap1a::FiniteList<\dual_space<s, V, Vspace>, n>{\dual_basis<s, V, Vspace, n>(basis)}.entries(j)(basis.entries(k)) = Vspace.scalars.one
    forall j, k N_pos:
        j <= n
        k <= n
        j != k
        =>:
            &chap1a::FiniteList<\dual_space<s, V, Vspace>, n>{\dual_basis<s, V, Vspace, n>(basis)}.entries(j)(basis.entries(k)) = Vspace.scalars.zero

axiom dual_basis_spec:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N, basis &chap1a::FiniteList<V, n>:
        $chap2b::is_basis(s, V, Vspace, n, basis)
        =>:
            $dual_basis_spec_statement(s, V, Vspace, n, basis)

# Example 3.113 is comment-only: the dual of the standard coordinate basis
# consists of the coordinate projections.

prop are_dual_basis_coefficients(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N, basis &chap1a::FiniteList<V, n>, v V, coefficients &chap1a::FiniteList<s, n>):
    forall k N_pos:
        k <= n
        =>:
            coefficients.entries(k) = &chap1a::FiniteList<\dual_space<s, V, Vspace>, n>{\dual_basis<s, V, Vspace, n>(basis)}.entries(k)(v)

# Result 3.114. Applying the dual basis recovers all coefficients of v.
axiom dual_basis_gives_coefficients:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N, basis &chap1a::FiniteList<V, n>, v V:
        $chap2b::is_basis(s, V, Vspace, n, basis)
        =>:
            exist coefficients &chap1a::FiniteList<s, n> st {$are_dual_basis_coefficients(s, V, Vspace, n, basis, v, coefficients), v = \chap2a::linear_combination_value<s, V, Vspace, n>(coefficients, basis)}

# Result 3.116. The dual basis is a basis of V'.
axiom dual_basis_is_basis_of_dual_space:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N, basis &chap1a::FiniteList<V, n>:
        $chap2b::is_basis(s, V, Vspace, n, basis)
        =>:
            $chap2b::is_basis(s, \dual_space<s, V, Vspace>, \dual_vector_space<s, V, Vspace>, n, \dual_basis<s, V, Vspace, n>(basis))

# Definition 3.118. T'(phi)=phi composed with T. The return type records that
# dual_map(T) is itself a linear map W' -> V'.
template<s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>>:
    trust have dual_map fn(T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>) \chap3a::linear_map_space<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>:
        forall phi \dual_space<s, W, Wspace>, v V:
            dual_map(T)(phi)(v) = phi(T(v))

# Example 3.119 is comment-only: dualizing differentiation turns evaluation
# into derivative evaluation, and turns integration into endpoint difference.

# Result 3.120. Dualization is additive, homogeneous, and reverses products.
axiom algebraic_properties_of_dual_maps:
    ? forall s nonempty_set, V, W, U nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, Uspace &chap1b::VectorSpace<s, U>, S, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>, Rmap \chap3a::linear_map_space<s, W, U, Wspace, Uspace>, a s:
        \dual_map<s, V, W, Vspace, Wspace>(\chap3a::linear_map_add<s, V, W, Vspace, Wspace>(S, T)) = \chap3a::linear_map_add<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(S), \dual_map<s, V, W, Vspace, Wspace>(T))
        \dual_map<s, V, W, Vspace, Wspace>(\chap3a::linear_map_smul<s, V, W, Vspace, Wspace>(a, T)) = \chap3a::linear_map_smul<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>(a, \dual_map<s, V, W, Vspace, Wspace>(T))
        \dual_map<s, V, U, Vspace, Uspace>(\chap3a::linear_map_compose<s, V, W, U, Vspace, Wspace, Uspace>(Rmap, T)) = \chap3a::linear_map_compose<s, \dual_space<s, U, Uspace>, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, U, Uspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T), \dual_map<s, W, U, Wspace, Uspace>(Rmap))

# Definition 3.121. U^0 is the set of functionals that vanish on U.
prop annihilates(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, U power_set(V), phi \dual_space<s, V, Vspace>):
    forall u U:
        phi(u) = Vspace.scalars.zero

template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    have fn annihilator(U power_set(V)) power_set(\dual_space<s, V, Vspace>) = {phi \dual_space<s, V, Vspace>: $annihilates(s, V, Vspace, U, phi)}

# Examples 3.122 and 3.123 are comment-only: derivative-at-zero annihilates
# multiples of x^2, and span(e1,e2)^0=span(phi3,phi4,phi5) in (R^5)'.

# Result 3.124. Every annihilator is a subspace of the dual.
axiom annihilator_is_subspace:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, U power_set(V):
        $chap1c::is_subspace(s, \dual_space<s, V, Vspace>, \dual_vector_space<s, V, Vspace>, \annihilator<s, V, Vspace>(U))

# Result 3.125. dim U^0 = dim V - dim U.
axiom dimension_of_annihilator:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, U power_set(V):
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $chap1c::is_subspace(s, V, Vspace, U)
        =>:
            \chap2c::dimension<s, \annihilator<s, V, Vspace>(U), \chap1c::subspace_vector_space<s, \dual_space<s, V, Vspace>, \dual_vector_space<s, V, Vspace>, \annihilator<s, V, Vspace>(U)>> = \chap2c::dimension<s, V, Vspace> - \chap2c::dimension<s, U, \chap1c::subspace_vector_space<s, V, Vspace, U>>

# Result 3.127. The two extreme annihilators characterize U=V and U={0}.
prop zero_annihilator_iff_whole_space_statement(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, U power_set(V)):
    forall:
        =>:
            \annihilator<s, V, Vspace>(U) = {\chap3a::zero_linear_map<s, V, s, Vspace, \scalar_vector_space<s, Vspace.scalars>>}
        <=>:
            U = V

prop full_annihilator_iff_zero_subspace_statement(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, U power_set(V)):
    forall:
        =>:
            \annihilator<s, V, Vspace>(U) = \dual_space<s, V, Vspace>
        <=>:
            U = {Vspace.zero}

axiom extreme_annihilators:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, U power_set(V):
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $chap1c::is_subspace(s, V, Vspace, U)
        =>:
            $zero_annihilator_iff_whole_space_statement(s, V, Vspace, U)
            $full_annihilator_iff_zero_subspace_statement(s, V, Vspace, U)

# Result 3.128. null(T') is the annihilator of range(T), with the displayed
# finite-dimensional nullity formula.
axiom null_space_of_dual_map:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $chap2a::is_finite_dimensional(s, W, Wspace)
        =>:
            \chap3b::null_space<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T)) = \annihilator<s, W, Wspace>(\chap3b::range_of<V, W>(T))
            \chap2c::dimension<s, \chap3b::null_space<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T)), \chap1c::subspace_vector_space<s, \dual_space<s, W, Wspace>, \dual_vector_space<s, W, Wspace>, \chap3b::null_space<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T))>> = \chap2c::dimension<s, \chap3b::null_space<s, V, W, Vspace, Wspace>(T), \chap1c::subspace_vector_space<s, V, Vspace, \chap3b::null_space<s, V, W, Vspace, Wspace>(T)>> + \chap2c::dimension<s, W, Wspace> - \chap2c::dimension<s, V, Vspace>

# Result 3.129. T is surjective exactly when T' is injective.
prop surjective_iff_dual_injective_statement(s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>):
    forall:
        =>:
            $chap3b::is_surjective(V, W, T)
        <=>:
            $chap3b::is_injective(\dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_map<s, V, W, Vspace, Wspace>(T))

axiom surjective_iff_dual_injective:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $chap2a::is_finite_dimensional(s, W, Wspace)
        =>:
            $surjective_iff_dual_injective_statement(s, V, W, Vspace, Wspace, T)

# Result 3.130. range(T') has the same dimension as range(T), and it is the
# annihilator of null(T).
axiom range_of_dual_map:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $chap2a::is_finite_dimensional(s, W, Wspace)
        =>:
            \chap2c::dimension<s, \chap3b::range_of<\dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T)), \chap1c::subspace_vector_space<s, \dual_space<s, V, Vspace>, \dual_vector_space<s, V, Vspace>, \chap3b::range_of<\dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T))>> = \chap2c::dimension<s, \chap3b::range_of<V, W>(T), \chap1c::subspace_vector_space<s, W, Wspace, \chap3b::range_of<V, W>(T)>>
            \chap3b::range_of<\dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>>(\dual_map<s, V, W, Vspace, Wspace>(T)) = \annihilator<s, V, Vspace>(\chap3b::null_space<s, V, W, Vspace, Wspace>(T))

# Result 3.131. T is injective exactly when T' is surjective.
prop injective_iff_dual_surjective_statement(s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>):
    forall:
        =>:
            $chap3b::is_injective(V, W, T)
        <=>:
            $chap3b::is_surjective(\dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_map<s, V, W, Vspace, Wspace>(T))

axiom injective_iff_dual_surjective:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $chap2a::is_finite_dimensional(s, W, Wspace)
        =>:
            $injective_iff_dual_surjective_statement(s, V, W, Vspace, Wspace, T)

# Result 3.132. Relative to a basis and its dual basis, M(T')=M(T)^t.
axiom matrix_of_dual_is_transpose:
    ? forall s nonempty_set, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, V>, Wspace &chap1b::VectorSpace<s, W>, n, m N_pos, v &chap1a::FiniteList<V, n>, w &chap1a::FiniteList<W, m>, T \chap3a::linear_map_space<s, V, W, Vspace, Wspace>:
        $chap2b::is_basis(s, V, Vspace, n, v)
        $chap2b::is_basis(s, W, Wspace, m, w)
        =>:
            \chap3c::matrix_of_linear_map<s, \dual_space<s, W, Wspace>, \dual_space<s, V, Vspace>, \dual_vector_space<s, W, Wspace>, \dual_vector_space<s, V, Vspace>, m, n>(\dual_basis<s, W, Wspace, m>(w), \dual_basis<s, V, Vspace, n>(v), \dual_map<s, V, W, Vspace, Wspace>(T)) = \chap3c::transpose<s, m, n>(\chap3c::matrix_of_linear_map<s, V, W, Vspace, Wspace, n, m>(v, w, T))

# Result 3.133. Duality gives another proof that column rank equals row rank.
axiom column_rank_equals_row_rank_by_duality:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N_pos, A matrix(s, m, n):
        \chap3c::column_rank<s, scalars, m, n>(A) = \chap3c::row_rank<s, scalars, m, n>(A)
