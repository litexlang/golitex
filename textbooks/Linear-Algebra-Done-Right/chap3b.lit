# Linear Algebra Done Right, fourth edition — Section 3B.
# Null Spaces and Ranges.


# Definition 3.11. The null space of T is the set of domain vectors sent to
# the zero vector of the codomain.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>>:
    have fn null_space(T fn(v V) W) power_set(V) = {v V: T(v) = Wspace.zero}

# Result 3.13. The null space of a linear map is a subspace of its domain.
thm null_space_is_subspace:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>:
        $chap1c::is_subspace(s, scalars, V, Vspace, \null_space<s, scalars, V, W, Vspace, Wspace>(T))
    by thm chap3a::linear_maps_take_zero_to_zero(s, scalars, V, W, Vspace, Wspace, T)
    Vspace.zero $in \null_space<s, scalars, V, W, Vspace, Wspace>(T)
    witness $is_nonempty_set(\null_space<s, scalars, V, W, Vspace, Wspace>(T)) from Vspace.zero
    forall x, y \null_space<s, scalars, V, W, Vspace, Wspace>(T):
        T(x) = Wspace.zero
        T(y) = Wspace.zero
        T(Vspace.add(x, y)) = Wspace.add(T(x), T(y))
        Wspace.add(Wspace.zero, Wspace.zero) = Wspace.zero
        T(Vspace.add(x, y)) = Wspace.zero
        Vspace.add(x, y) $in \null_space<s, scalars, V, W, Vspace, Wspace>(T)
    forall a s, x \null_space<s, scalars, V, W, Vspace, Wspace>(T):
        T(x) = Wspace.zero
        T(Vspace.smul(a, x)) = Wspace.smul(a, T(x))
        Wspace.smul(a, Wspace.zero) = Wspace.zero
        T(Vspace.smul(a, x)) = Wspace.zero
        Vspace.smul(a, x) $in \null_space<s, scalars, V, W, Vspace, Wspace>(T)
    by def $chap1c::is_subspace(s, scalars, V, Vspace, \null_space<s, scalars, V, W, Vspace, Wspace>(T))

# Definition 3.14. A map is injective when equal outputs force equal inputs.
prop is_injective(V, W set, T fn(v V) W):
    forall u, v V:
        T(u) = T(v)
        =>:
            u = v

# Result 3.15. A linear map is injective exactly when its null space consists
# only of the zero vector.
prop injective_iff_null_space_is_zero_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>):
    forall:
        =>:
            $is_injective(V, W, T)
        <=>:
            \null_space<s, scalars, V, W, Vspace, Wspace>(T) = {Vspace.zero}

thm injective_iff_null_space_is_zero:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>:
        $injective_iff_null_space_is_zero_statement(s, scalars, V, W, Vspace, Wspace, T)
    by thm chap3a::linear_maps_take_zero_to_zero(s, scalars, V, W, Vspace, Wspace, T)
    Vspace.zero $in \null_space<s, scalars, V, W, Vspace, Wspace>(T)
    claim:
        ? forall:
            $is_injective(V, W, T)
            =>:
                \null_space<s, scalars, V, W, Vspace, Wspace>(T) = {Vspace.zero}
        by extension \null_space<s, scalars, V, W, Vspace, Wspace>(T) = {Vspace.zero}:
            forall x \null_space<s, scalars, V, W, Vspace, Wspace>(T):
                T(x) = Wspace.zero = T(Vspace.zero)
                x = Vspace.zero
                x $in {Vspace.zero}
            forall x {Vspace.zero}:
                x = Vspace.zero
                x $in \null_space<s, scalars, V, W, Vspace, Wspace>(T)
    claim:
        ? forall:
            \null_space<s, scalars, V, W, Vspace, Wspace>(T) = {Vspace.zero}
            =>:
                $is_injective(V, W, T)
        claim:
            ? forall u, v V:
                T(u) = T(v)
                =>:
                    u = v
            by thm chap1b::minus_one_times_vector(s, scalars, V, Vspace, v)
            by thm chap1b::minus_one_times_vector(s, scalars, W, Wspace, T(v))
            T(\chap1b::vector_neg<s, scalars, V, Vspace>(v)) = T(Vspace.smul(scalars.neg(scalars.one), v)) = Wspace.smul(scalars.neg(scalars.one), T(v)) = \chap1b::vector_neg<s, scalars, W, Wspace>(T(v))
            T(Vspace.add(u, \chap1b::vector_neg<s, scalars, V, Vspace>(v))) = Wspace.add(T(u), T(\chap1b::vector_neg<s, scalars, V, Vspace>(v)))
            Wspace.add(T(u), T(\chap1b::vector_neg<s, scalars, V, Vspace>(v))) = Wspace.add(T(v), \chap1b::vector_neg<s, scalars, W, Wspace>(T(v)))
            by thm chap1b::vector_neg_spec(s, scalars, W, Wspace, T(v))
            T(Vspace.add(u, \chap1b::vector_neg<s, scalars, V, Vspace>(v))) = Wspace.zero
            Vspace.add(u, \chap1b::vector_neg<s, scalars, V, Vspace>(v)) $in \null_space<s, scalars, V, W, Vspace, Wspace>(T)
            Vspace.add(u, \chap1b::vector_neg<s, scalars, V, Vspace>(v)) $in {Vspace.zero}
            Vspace.add(u, \chap1b::vector_neg<s, scalars, V, Vspace>(v)) = Vspace.zero
            by thm chap1b::vector_neg_spec(s, scalars, V, Vspace, v)
            Vspace.add(u, \chap1b::vector_neg<s, scalars, V, Vspace>(v)) = Vspace.add(v, \chap1b::vector_neg<s, scalars, V, Vspace>(v))
            by thm chap1b::add_right_cancel(s, scalars, V, Vspace, u, v, \chap1b::vector_neg<s, scalars, V, Vspace>(v))
        by def $is_injective(V, W, T)
    forall:
        =>:
            $is_injective(V, W, T)
        <=>:
            \null_space<s, scalars, V, W, Vspace, Wspace>(T) = {Vspace.zero}
    by def $injective_iff_null_space_is_zero_statement(s, scalars, V, W, Vspace, Wspace, T)

# Definition 3.16. The range of T is the set of all values T(v). The helper
# relation keeps the existential out of the set-builder parser while the
# source-facing range remains a callable set-valued construction.
prop has_preimage(V, W set, T fn(v V) W, w W):
    exist v V st {w = T(v)}

template<V, W set>:
    have fn range_of(T fn(v V) W) power_set(W) = {w W: $has_preimage(V, W, T, w)}

# Result 3.18. The range of a linear map is a subspace of its codomain.
thm range_is_subspace:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>:
        $chap1c::is_subspace(s, scalars, W, Wspace, \range_of<V, W>(T))
    by thm chap3a::linear_maps_take_zero_to_zero(s, scalars, V, W, Vspace, Wspace, T)
    witness exist v V st {Wspace.zero = T(v)} from Vspace.zero
    by def $has_preimage(V, W, T, Wspace.zero)
    Wspace.zero $in \range_of<V, W>(T)
    witness $is_nonempty_set(\range_of<V, W>(T)) from Wspace.zero
    claim:
        ? forall x, y W:
            x $in \range_of<V, W>(T)
            y $in \range_of<V, W>(T)
            =>:
                Wspace.add(x, y) $in \range_of<V, W>(T)
        obtain u from exist v V st {x = T(v)}
        obtain v from exist z V st {y = T(z)}
        Wspace.add(x, y) = Wspace.add(T(u), T(v)) = T(Vspace.add(u, v))
        witness exist z V st {Wspace.add(x, y) = T(z)} from Vspace.add(u, v)
        by def $has_preimage(V, W, T, Wspace.add(x, y))
        Wspace.add(x, y) $in \range_of<V, W>(T)
    claim:
        ? forall a s, x W:
            x $in \range_of<V, W>(T)
            =>:
                Wspace.smul(a, x) $in \range_of<V, W>(T)
        obtain u from exist v V st {x = T(v)}
        Wspace.smul(a, x) = Wspace.smul(a, T(u)) = T(Vspace.smul(a, u))
        witness exist z V st {Wspace.smul(a, x) = T(z)} from Vspace.smul(a, u)
        by def $has_preimage(V, W, T, Wspace.smul(a, x))
        Wspace.smul(a, x) $in \range_of<V, W>(T)
    by def $chap1c::is_subspace(s, scalars, W, Wspace, \range_of<V, W>(T))

# Definition 3.19. A map is surjective when every codomain vector is attained.
prop is_surjective(V, W set, T fn(v V) W):
    forall w W:
        exist v V st {T(v) = w}

# Result 3.21. For finite-dimensional V, its dimension is the sum of the
# dimensions of null T and range T. Axler proves this by extending a basis of
# the null space to a basis of V.
axiom fundamental_theorem_of_linear_maps:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        =>:
            \chap2c::dimension<s, scalars, V, Vspace> = \chap2c::dimension<s, scalars, \null_space<s, scalars, V, W, Vspace, Wspace>(T), \chap1c::subspace_vector_space<s, scalars, V, Vspace, \null_space<s, scalars, V, W, Vspace, Wspace>(T)>> + \chap2c::dimension<s, scalars, \range_of<V, W>(T), \chap1c::subspace_vector_space<s, scalars, W, Wspace, \range_of<V, W>(T)>>

# Result 3.22. A linear map into a lower-dimensional space cannot be injective.
axiom lower_dimensional_codomain_prevents_injectivity:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        $chap2a::is_finite_dimensional(s, scalars, W, Wspace)
        \chap2c::dimension<s, scalars, W, Wspace> < \chap2c::dimension<s, scalars, V, Vspace>
        =>:
            not $is_injective(V, W, T)

# Result 3.24. A linear map into a higher-dimensional space cannot be
# surjective.
axiom higher_dimensional_codomain_prevents_surjectivity:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, W, Vspace, Wspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        $chap2a::is_finite_dimensional(s, scalars, W, Wspace)
        \chap2c::dimension<s, scalars, V, Vspace> < \chap2c::dimension<s, scalars, W, Wspace>
        =>:
            not $is_surjective(V, W, T)

# A finite scalar sum is the book-local bridge used to state linear systems.
# Its recursive implementation is deferred because the operation comes from a
# parameterized scalar structure rather than a builtin numeric carrier.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    trust have scalar_finite_sum fn(a finite_seq(s, n)) s:
        scalar_finite_sum(a) $in s

prop solves_linear_system(s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N_pos, A matrix(s, m, n), b finite_seq(s, m), x finite_seq(s, n)):
    forall j N_pos:
        j <= m
        =>:
            \scalar_finite_sum<s, scalars, n>(fn(k N_pos: k <= n) s {scalars.mul(A(j, k), x(k))}) = b(j)

# Result 3.26. A homogeneous system with more variables than equations has a
# nonzero solution.
axiom homogeneous_system_with_more_variables_has_nonzero_solution:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N_pos, A matrix(s, m, n):
        m < n
        =>:
            exist x finite_seq(s, n) st {$solves_linear_system(s, scalars, m, n, A, fn(j N_pos: j <= m) s {scalars.zero}, x), x != fn(k N_pos: k <= n) s {scalars.zero}}

# Result 3.28. If a system has more equations than variables, some choice of
# right-hand side makes the system unsolvable.
prop is_inconsistent_right_hand_side(s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N_pos, A matrix(s, m, n), b finite_seq(s, m)):
    forall x finite_seq(s, n):
        not $solves_linear_system(s, scalars, m, n, A, b, x)

axiom more_equations_than_variables_can_be_inconsistent:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N_pos, A matrix(s, m, n):
        n < m
        =>:
            exist b finite_seq(s, m) st {$is_inconsistent_right_hand_side(s, scalars, m, n, A, b)}
