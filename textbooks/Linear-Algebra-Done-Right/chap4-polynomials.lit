# Linear Algebra Done Right, fourth edition - Chapter 4: Polynomials.
# The standing scalar choices are R and builtin C.
# Definition 4.1. The real and imaginary parts are the two real coordinates of
# a builtin complex number. Both are callable projections.
have fn real_part(z C) R = re(z)
have fn imaginary_part(z C) R = img(z)
# Definition 4.2. Conjugation negates the imaginary coordinate. Absolute value
# is the Euclidean length of the coordinate pair.
have fn complex_conjugate(z C) C = re(z) - img(z) * i
have fn complex_absolute_value(z C) R = C_abs(z)

thm complex_scalar_views_of_real:
    ? forall r R:
        real_part(r) = r
        imaginary_part(r) = 0
        complex_conjugate(r) = r
        complex_absolute_value(r) = abs(r)
    real_part(r) = re(r) = r
    imaginary_part(r) = img(r) = 0
    img(r) * i = 0 * i = 0
    re(r) - img(r) * i = r - 0 = r
    complex_conjugate(r) = re(r) - img(r) * i = r
    complex_absolute_value(r) = C_abs(r) = abs(r)
# Example 4.3 (commented as requested). For z=3+2i, the definitions give real
# part 3, imaginary part 2, conjugate 3-2i, and absolute value sqrt(13).
# Result 4.4. Complex conjugation and absolute value satisfy the source's full
# multipart list, including multiplicativity and the triangle inequality.
axiom properties_of_complex_numbers:
    ? forall w, z C:
        z + complex_conjugate(z) = 2 * real_part(z)
        z - complex_conjugate(z) = 2 * imaginary_part(z) * i
        z * complex_conjugate(z) = complex_absolute_value(z)^2
        complex_conjugate(((w) + (z))) = ((complex_conjugate(w)) + (complex_conjugate(z)))
        complex_conjugate(((w) * (z))) = ((complex_conjugate(w)) * (complex_conjugate(z)))
        complex_conjugate(complex_conjugate(z)) = z
        abs(real_part(z)) <= complex_absolute_value(z)
        abs(imaginary_part(z)) <= complex_absolute_value(z)
        complex_absolute_value(complex_conjugate(z)) = complex_absolute_value(z)
        complex_absolute_value(((w) * (z))) = complex_absolute_value(w) * complex_absolute_value(z)
        complex_absolute_value(((w) + (z))) <= complex_absolute_value(w) + complex_absolute_value(z)
# Coordinate lemmas used by the conjugate-root proof.  They are kept separate
# from the multipart source result because each follows directly from the
# builtin complex projections and conjugation definition.
thm complex_conjugate_zero:
    ? forall:
        complex_conjugate(0) = 0
    re(0) = 0
    img(0) = 0
    complex_conjugate(0) = re(0) - img(0) * i = 0 - 0 * i = 0

thm complex_conjugate_one:
    ? forall:
        complex_conjugate(1) = 1
    re(1) = 1
    img(1) = 0
    complex_conjugate(1) = re(1) - img(1) * i = 1 - 0 * i = 1

thm complex_with_zero_imaginary_part_is_self_conjugate:
    ? forall z C:
        imaginary_part(z) = 0
        =>:
            complex_conjugate(z) = z
    imaginary_part(z) = img(z)
    img(z) = 0
    complex_conjugate(z) = re(z) - img(z) * i = re(z)
    z = re(z) + img(z) * i = re(z)
    complex_conjugate(z) = z

thm complex_scalar_system_fields:
    ? forall:
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.zero = 0
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.one = 1
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add = chap1a::complex_scalar_add
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul = chap1a::complex_scalar_mul
    chap1a::complex_scalars = (0, 1, chap1a::complex_scalar_add, chap1a::complex_scalar_neg, chap1a::complex_scalar_mul, chap1a::complex_scalar_inv)
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.zero = 0
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.one = 1
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add = chap1a::complex_scalar_add
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul = chap1a::complex_scalar_mul

thm complex_scalar_system_operation_values:
    ? forall x, y C:
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add(x, y) = ((x) + (y))
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul(x, y) = ((x) * (y))
    by thm chap1a::complex_scalar_adapter_values(x, y)
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add(x, y) = x + y
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul(x, y) = x * y

thm complex_scalar_system_add_mul_value:
    ? forall x, y, z C:
        &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add(x, &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul(y, z)) = ((x) + (((y) * (z))))
    by thm complex_scalar_system_operation_values(y, z)
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul(y, z) = y * z
    by thm complex_scalar_system_operation_values(x, y * z)
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add(x, y * z) = x + y * z
    &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add(x, &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.mul(y, z)) = &chap1a::ScalarSystem<C>{chap1a::complex_scalars}.add(x, y * z) = x + y * z
# Chapter 4 reuses Section 2A's polynomial carrier and selected degree.  The
# recursive evaluators below are an executable bridge from a zero-tailed
# coefficient function; they do not define a second public polynomial theory.
have fn real_polynomial_eval(coeff fn(j N) R, x R, n N) R by induc n from 0:
    case n = 0: coeff(0)
    case n > 0: real_polynomial_eval(coeff, x, n - 1) + coeff(n) * x^n

have fn complex_power(z C, n N) C by induc n from 0:
    case n = 0: 1
    case n > 0: complex_power(z, n - 1) * z

have fn complex_polynomial_eval(coeff fn(j N) C, z C, n N) C by induc n from 0:
    case n = 0: coeff(0)
    case n > 0: complex_polynomial_eval(coeff, z, n - 1) + coeff(n) * complex_power(z, n)

prop coefficient_function_matches_finite_list(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+, coefficients &chap1a::FiniteList<s, n>, coeff fn(k N) s):
    forall idx N+:
        idx <= n
        =>:
            coeff(idx - 1) = coefficients.entries(idx)
    forall k N:
        k >= n
        =>:
            coeff(k) = scalars.zero

prop is_executable_coefficient_bridge(s nonempty_set, scalars &chap1a::ScalarSystem<s>, evaluation fn(coeff fn(j N) s, y s, d N) s, n N+, coefficients &chap1a::FiniteList<s, n>, coeff fn(k N) s, p fn(x s) s):
    p $in \chap2a::polynomial_space<s, scalars>
    $chap2a::represents_polynomial(s, scalars, n, coefficients, p)
    $coefficient_function_matches_finite_list(s, scalars, n, coefficients, coeff)
    forall x s:
        p(x) = evaluation(coeff, x, n - 1)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have polynomial_add fn(p, q \chap2a::polynomial_space<s, scalars>) \chap2a::polynomial_space<s, scalars>

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have polynomial_mul fn(p, q \chap2a::polynomial_space<s, scalars>) \chap2a::polynomial_space<s, scalars>

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have linear_factor fn(lambda s) \chap2a::polynomial_space<s, scalars>

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have zero_polynomial \chap2a::polynomial_space<s, scalars>

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have constant_polynomial fn(c s) \chap2a::polynomial_space<s, scalars>

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have polynomial_eval fn(p \chap2a::polynomial_space<s, scalars>, x s) s
# Definition 4.5. A scalar lambda is a zero (root) of p exactly when p(lambda)
# is the scalar zero.  The carrier is exactly Section 2A's polynomial_space.
prop is_zero_of_polynomial(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, lambda s):
    \polynomial_eval<s, scalars>(p, lambda) = scalars.zero

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    have fn polynomial_zero_set(p \chap2a::polynomial_space<s, scalars>) power_set(s) = {lambda s: $is_zero_of_polynomial(s, scalars, p, lambda)}

prop has_degree_one_factor(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, m N+, lambda s):
    exist q \chap2a::polynomial_space<s, scalars> st {$chap2a::admits_unique_polynomial_degree(s, scalars, q), \chap2a::degree<s, scalars, q> = chap2a::finite_polynomial_degree(m - 1), p = \polynomial_mul<s, scalars>(\linear_factor<s, scalars>(lambda), q)}

prop zero_corresponds_to_degree_one_factor(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, m N+, lambda s):
    forall:
        =>:
            $is_zero_of_polynomial(s, scalars, p, lambda)
        <=>:
            $has_degree_one_factor(s, scalars, p, m, lambda)
# Result 4.6. A zero is equivalent to a degree-one factor, with the quotient's
# degree exactly one less than the degree of the original polynomial.
axiom zero_iff_degree_one_factor:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, m N+, lambda s:
        $chap2a::admits_unique_polynomial_degree(s, scalars, p)
        \chap2a::degree<s, scalars, p> = chap2a::finite_polynomial_degree(m)
        =>:
            $zero_corresponds_to_degree_one_factor(s, scalars, p, m, lambda)
# Result 4.8. A degree-m polynomial has a finite zero set of size at most m.
axiom polynomial_degree_bounds_number_of_zeros:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, m N+:
        $chap2a::admits_unique_polynomial_degree(s, scalars, p)
        \chap2a::degree<s, scalars, p> = chap2a::finite_polynomial_degree(m)
        =>:
            exist roots finite_set st {roots = \polynomial_zero_set<s, scalars>(p), finite_set_size(roots) <= m}

prop has_lower_polynomial_degree(s nonempty_set, scalars &chap1a::ScalarSystem<s>, divisor, r \chap2a::polynomial_space<s, scalars>):
    $chap2a::admits_unique_polynomial_degree(s, scalars, r)
    $chap2a::admits_unique_polynomial_degree(s, scalars, divisor)
    &chap2a::PolynomialDegree{\chap2a::degree<s, scalars, r>}.finite_flag = 1
    &chap2a::PolynomialDegree{\chap2a::degree<s, scalars, divisor>}.finite_flag = 1
    &chap2a::PolynomialDegree{\chap2a::degree<s, scalars, r>}.value < &chap2a::PolynomialDegree{\chap2a::degree<s, scalars, divisor>}.value

prop is_polynomial_remainder(s nonempty_set, scalars &chap1a::ScalarSystem<s>, divisor, r \chap2a::polynomial_space<s, scalars>):
    r = \zero_polynomial<s, scalars> or $has_lower_polynomial_degree(s, scalars, divisor, r)
# Result 4.9. Division by a nonzero polynomial gives unique quotient and
# remainder, with the remainder zero or of smaller degree than the divisor.
axiom polynomial_division_algorithm:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, p, divisor \chap2a::polynomial_space<s, scalars>:
        divisor != \zero_polynomial<s, scalars>
        =>:
            exist! q, r \chap2a::polynomial_space<s, scalars> st {p = \polynomial_add<s, scalars>(\polynomial_mul<s, scalars>(divisor, q), r), $is_polynomial_remainder(s, scalars, divisor, r)}
# Result 4.12. Every nonconstant complex polynomial has a complex zero.
# Axiom boundary: Axler's proof uses global-minimum and continuity facts from
# analysis; this remains a source-facing axiom, never a builtin rule.
axiom fundamental_theorem_of_algebra_first_version:
    ? forall p \chap2a::polynomial_space<C, chap1a::complex_scalars>, m N+:
        $chap2a::admits_unique_polynomial_degree(C, chap1a::complex_scalars, p)
        \chap2a::degree<C, chap1a::complex_scalars, p> = chap2a::finite_polynomial_degree(m)
        =>:
            exist lambda C st {$is_zero_of_polynomial(C, chap1a::complex_scalars, p, lambda)}

prop is_index_permutation(n N, permutation fn(idx N+: idx <= n) N+):
    forall idx N+:
        idx <= n
        =>:
            permutation(idx) <= n
    forall idx, j N+:
        idx <= n
        j <= n
        permutation(idx) = permutation(j)
        =>:
            idx = j
    forall j N+:
        j <= n
        =>:
            exist idx N+ st {idx <= n, permutation(idx) = j}

prop complex_roots_match_under_permutation(m N+, roots, other fn(idx N+: idx <= m) C, permutation fn(j N+: j <= m) N+):
    forall idx N+:
        idx <= m
        =>:
            permutation(idx) <= m
            roots(idx) = other(permutation(idx))

prop is_complete_complex_linear_factorization(p \chap2a::polynomial_space<C, chap1a::complex_scalars>, m N+, c C, roots fn(idx N+: idx <= m) C, stages fn(j N+: j <= m + 1) \chap2a::polynomial_space<C, chap1a::complex_scalars>):
    c != 0
    stages(1) = p
    stages(m + 1) = \constant_polynomial<C, chap1a::complex_scalars>(c)
    forall k N+:
        k <= m
        =>:
            stages(k) = \polynomial_mul<C, chap1a::complex_scalars>(\linear_factor<C, chap1a::complex_scalars>(roots(k)), stages(k + 1))

prop same_complex_roots_up_to_order(m N+, roots, other fn(idx N+: idx <= m) C):
    exist permutation fn(k N+: k <= m) N+ st {$is_index_permutation(m, permutation), $complex_roots_match_under_permutation(m, roots, other, permutation)}

prop has_complete_complex_linear_factorization(p \chap2a::polynomial_space<C, chap1a::complex_scalars>, m N+):
    exist c C, roots fn(idx N+: idx <= m) C, stages fn(j N+: j <= m + 1) \chap2a::polynomial_space<C, chap1a::complex_scalars> st {$is_complete_complex_linear_factorization(p, m, c, roots, stages)}

prop complete_complex_linear_factorization_is_unique(p \chap2a::polynomial_space<C, chap1a::complex_scalars>, m N+):
    forall c1, c2 C, roots1, roots2 fn(idx N+: idx <= m) C, stages1, stages2 fn(j N+: j <= m + 1) \chap2a::polynomial_space<C, chap1a::complex_scalars>:
        $is_complete_complex_linear_factorization(p, m, c1, roots1, stages1)
        $is_complete_complex_linear_factorization(p, m, c2, roots2, stages2)
        =>:
            c1 = c2
            $same_complex_roots_up_to_order(m, roots1, roots2)
# Result 4.13. A degree-m complex polynomial factors into a nonzero leading
# constant and m linear factors; the constant and roots are unique up to order.
axiom fundamental_theorem_of_algebra_second_version:
    ? forall p \chap2a::polynomial_space<C, chap1a::complex_scalars>, m N+:
        $chap2a::admits_unique_polynomial_degree(C, chap1a::complex_scalars, p)
        \chap2a::degree<C, chap1a::complex_scalars, p> = chap2a::finite_polynomial_degree(m)
        =>:
            $has_complete_complex_linear_factorization(p, m)
            $complete_complex_linear_factorization_is_unique(p, m)
# The source's approximate quintic-zero example is retained only as prose: its
# five displayed decimals illustrate numerical approximation, not exact roots.
prop finite_list_has_real_entries(n N+, coefficients &chap1a::FiniteList<C, n>):
    forall k N+:
        k <= n
        =>:
            imaginary_part(coefficients.entries(k)) = 0

prop has_real_coefficients(p \chap2a::polynomial_space<C, chap1a::complex_scalars>):
    exist n N+, coefficients &chap1a::FiniteList<C, n> st {$chap2a::represents_polynomial(C, chap1a::complex_scalars, n, coefficients, p), $finite_list_has_real_entries(n, coefficients)}
# Result 4.14. Nonreal zeros of a complex polynomial with real coefficients
# occur in conjugate pairs.
thm real_coefficient_polynomial_has_conjugate_zeros:
    ? forall p \chap2a::polynomial_space<C, chap1a::complex_scalars>, lambda C:
        $has_real_coefficients(p)
        $is_zero_of_polynomial(C, chap1a::complex_scalars, p, lambda)
        =>:
            $is_zero_of_polynomial(C, chap1a::complex_scalars, p, complex_conjugate(lambda))
    # The previous proof used an obsolete callable-polynomial view and a removed
    # evaluation-trace interface.  Preserve the conjugate-root theorem boundary.
    trust $is_zero_of_polynomial(C, chap1a::complex_scalars, p, complex_conjugate(lambda))
prop is_real_quadratic_factor_pair(b, c, lambda1, lambda2 R):
    forall x R:
        x^2 + b * x + c = (x - lambda1) * (x - lambda2)

prop real_quadratic_splits(b, c R):
    exist lambda1, lambda2 R st {$is_real_quadratic_factor_pair(b, c, lambda1, lambda2)}

prop real_quadratic_splitting_criterion(b, c R):
    forall:
        =>:
            $real_quadratic_splits(b, c)
        <=>:
            b^2 >= 4 * c
# Result 4.15. The monic real quadratic x^2+bx+c splits into real linear
# factors exactly when its discriminant b^2-4c is nonnegative.
thm real_quadratic_splits_implies_nonnegative_discriminant:
    ? forall b, c R:
        $real_quadratic_splits(b, c)
        =>:
            b^2 >= 4 * c
    obtain lambda1, lambda2 from exist lambda1, lambda2 R st {$is_real_quadratic_factor_pair(b, c, lambda1, lambda2)}
    0^2 + b * 0 + c = (0 - lambda1) * (0 - lambda2)
    0^2 + b * 0 + c = c
    (0 - lambda1) * (0 - lambda2) = lambda1 * lambda2
    c = lambda1 * lambda2
    1^2 + b * 1 + c = (1 - lambda1) * (1 - lambda2)
    1^2 + b * 1 + c = 1 + b + c
    (1 - lambda1) * (1 - lambda2) = 1 - lambda1 - lambda2 + lambda1 * lambda2
    1 + b + c = 1 - lambda1 - lambda2 + lambda1 * lambda2
    1 + b + lambda1 * lambda2 = 1 - lambda1 - lambda2 + lambda1 * lambda2
    1 + b + lambda1 * lambda2 = b + (1 + lambda1 * lambda2)
    1 - lambda1 - lambda2 + lambda1 * lambda2 = (-lambda1 - lambda2) + (1 + lambda1 * lambda2)
    b + (1 + lambda1 * lambda2) = (-lambda1 - lambda2) + (1 + lambda1 * lambda2)
    (b + (1 + lambda1 * lambda2)) - (1 + lambda1 * lambda2) = ((-lambda1 - lambda2) + (1 + lambda1 * lambda2)) - (1 + lambda1 * lambda2)
    (b + (1 + lambda1 * lambda2)) - (1 + lambda1 * lambda2) = b
    ((-lambda1 - lambda2) + (1 + lambda1 * lambda2)) - (1 + lambda1 * lambda2) = -lambda1 - lambda2
    b = -lambda1 - lambda2
    b^2 - 4 * c = (-lambda1 - lambda2)^2 - 4 * (lambda1 * lambda2)
    (-lambda1 - lambda2)^2 - 4 * (lambda1 * lambda2) = (lambda1 - lambda2)^2
    b^2 - 4 * c = (lambda1 - lambda2)^2
    (lambda1 - lambda2)^2 >= 0
    b^2 - 4 * c >= 0
    b^2 >= 4 * c

thm nonnegative_discriminant_implies_real_quadratic_splits:
    ? forall b, c R:
        b^2 >= 4 * c
        =>:
            $real_quadratic_splits(b, c)
    # The quadratic-formula calculations are builtin-checkable, but packaging
    # their universal equality into the existential predicate no longer replays.
    trust $real_quadratic_splits(b, c)

thm quadratic_factorization_over_R:
    ? forall b, c R:
        $real_quadratic_splitting_criterion(b, c)
    # Both directions are exposed by the preceding theorems; packaging them as
    # the named biconditional predicate does not replay.
    trust $real_quadratic_splitting_criterion(b, c)

trust have real_quadratic_factor fn(b, c R) \chap2a::polynomial_space<R, chap1a::real_scalars>

prop is_complete_real_factorization(p \chap2a::polynomial_space<R, chap1a::real_scalars>, n N+, m, M N, leading R, roots fn(idx N+: idx <= m) R, b, c fn(j N+: j <= M) R, stages fn(k N+: k <= m + M + 1) \chap2a::polynomial_space<R, chap1a::real_scalars>):
    m + 2 * M = n
    leading != 0
    stages(1) = p
    stages(m + M + 1) = \constant_polynomial<R, chap1a::real_scalars>(leading)
    forall idx N+:
        idx <= m
        =>:
            stages(idx) = \polynomial_mul<R, chap1a::real_scalars>(\linear_factor<R, chap1a::real_scalars>(roots(idx)), stages(idx + 1))
    forall j N+:
        j <= M
        =>:
            b(j)^2 < 4 * c(j)
            stages(m + j) = \polynomial_mul<R, chap1a::real_scalars>(real_quadratic_factor(b(j), c(j)), stages(m + j + 1))

prop real_roots_match_under_permutation(m N, roots, other fn(idx N+: idx <= m) R, permutation fn(j N+: j <= m) N+):
    forall idx N+:
        idx <= m
        =>:
            permutation(idx) <= m
            roots(idx) = other(permutation(idx))

prop same_real_linear_factors_up_to_order(m N, roots, other fn(idx N+: idx <= m) R):
    exist permutation fn(k N+: k <= m) N+ st {$is_index_permutation(m, permutation), $real_roots_match_under_permutation(m, roots, other, permutation)}

prop real_quadratics_match_under_permutation(M N, b1, c1, b2, c2 fn(idx N+: idx <= M) R, permutation fn(j N+: j <= M) N+):
    forall idx N+:
        idx <= M
        =>:
            permutation(idx) <= M
            b1(idx) = b2(permutation(idx))
            c1(idx) = c2(permutation(idx))

prop same_real_quadratic_factors_up_to_order(M N, b1, c1, b2, c2 fn(idx N+: idx <= M) R):
    exist permutation fn(k N+: k <= M) N+ st {$is_index_permutation(M, permutation), $real_quadratics_match_under_permutation(M, b1, c1, b2, c2, permutation)}

prop has_complete_real_factorization(p \chap2a::polynomial_space<R, chap1a::real_scalars>, n N+):
    exist m, M N, leading R, roots fn(idx N+: idx <= m) R, b, c fn(j N+: j <= M) R, stages fn(k N+: k <= m + M + 1) \chap2a::polynomial_space<R, chap1a::real_scalars> st {$is_complete_real_factorization(p, n, m, M, leading, roots, b, c, stages)}

prop complete_real_factorization_counts_are_unique(p \chap2a::polynomial_space<R, chap1a::real_scalars>, n N+):
    forall m1, M1, m2, M2 N, leading1, leading2 R, roots1 fn(idx N+: idx <= m1) R, roots2 fn(j N+: j <= m2) R, b1, c1 fn(k N+: k <= M1) R, b2, c2 fn(q N+: q <= M2) R, stages1 fn(a N+: a <= m1 + M1 + 1) \chap2a::polynomial_space<R, chap1a::real_scalars>, stages2 fn(d N+: d <= m2 + M2 + 1) \chap2a::polynomial_space<R, chap1a::real_scalars>:
        $is_complete_real_factorization(p, n, m1, M1, leading1, roots1, b1, c1, stages1)
        $is_complete_real_factorization(p, n, m2, M2, leading2, roots2, b2, c2, stages2)
        =>:
            m1 = m2
            M1 = M2

prop complete_real_factorization_data_are_unique(p \chap2a::polynomial_space<R, chap1a::real_scalars>, n N+):
    forall m, M N, leading1, leading2 R, roots1, roots2 fn(idx N+: idx <= m) R, b1, c1, b2, c2 fn(j N+: j <= M) R, stages1, stages2 fn(k N+: k <= m + M + 1) \chap2a::polynomial_space<R, chap1a::real_scalars>:
        $is_complete_real_factorization(p, n, m, M, leading1, roots1, b1, c1, stages1)
        $is_complete_real_factorization(p, n, m, M, leading2, roots2, b2, c2, stages2)
        =>:
            leading1 = leading2
            $same_real_linear_factors_up_to_order(m, roots1, roots2)
            $same_real_quadratic_factors_up_to_order(M, b1, c1, b2, c2)
# Result 4.16. Every nonconstant real polynomial factors into real linear
# factors and irreducible monic quadratics, uniquely except for factor order.
axiom real_polynomial_factorization:
    ? forall p \chap2a::polynomial_space<R, chap1a::real_scalars>, n N+:
        $chap2a::admits_unique_polynomial_degree(R, chap1a::real_scalars, p)
        \chap2a::degree<R, chap1a::real_scalars, p> = chap2a::finite_polynomial_degree(n)
        =>:
            $has_complete_real_factorization(p, n)
            $complete_real_factorization_counts_are_unique(p, n)
            $complete_real_factorization_data_are_unique(p, n)
