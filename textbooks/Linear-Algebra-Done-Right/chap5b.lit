# Linear Algebra Done Right, fourth edition — Section 5B.
# The Minimal Polynomial.
# Result 5.19. Proof spine: choose a nonzero v and a shortest nonzero
# polynomial p with p(T)v=0; factor p at a complex zero lambda; minimality makes
# q(T)v nonzero and (T-lambda I)q(T)v=0 supplies the eigenvector.
axiom complex_operator_has_an_eigenvalue:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            exist lambda &chap1a::Complex st {$chap5a::is_eigenvalue(&chap1a::Complex, VSet, V, T, lambda)}
# Example 5.20. Multiplication by z on P(C) has no eigenvalues because it
# raises the degree of every nonzero polynomial; finite dimensionality in 5.19
# is therefore essential.
# Definition 5.21. A monic degree-m polynomial has selected degree m and a
# coefficient representation whose highest coefficient is one.
prop is_monic_polynomial_of_degree(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p \chap2a::polynomial_space<s, scalars>, m N):
    \chap2a::degree<s, scalars, p> = chap2a::finite_polynomial_degree(m)
    exist coefficients &chap1a::FiniteList<s, m + 1> st {$chap2a::represents_polynomial(s, scalars, m + 1, coefficients, p), coefficients.entries(m + 1) = scalars.one}

prop annihilates_operator(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    \chap5a::polynomial_at_operator<s, VSet, V>(p, T) = \chap3a::zero_linear_map<s, VSet, VSet, V, V>
# A candidate is monic, annihilates T, and has no larger degree than any other
# monic annihilator. Epistemic status is deliberately not folded into this
# mathematical relation.
prop is_least_monic_annihilator_degree(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, m N):
    forall q \chap2a::polynomial_space<s, V.scalars>, n N:
        $is_monic_polynomial_of_degree(s, V.scalars, q, n)
        $annihilates_operator(s, VSet, V, q, T)
        =>:
            m <= n

prop is_minimal_polynomial_of(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, p \chap2a::polynomial_space<s, V.scalars>):
    exist m N st {$is_monic_polynomial_of_degree(s, V.scalars, p, m), $annihilates_operator(s, VSet, V, p, T), $is_least_monic_annihilator_degree(s, VSet, V, T, m)}

prop minimal_polynomial_degree_is_bounded(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    forall p \chap2a::polynomial_space<s, V.scalars>:
        $is_minimal_polynomial_of(s, VSet, V, T, p)
        =>:
            exist m N st {$is_monic_polynomial_of_degree(s, V.scalars, p, m), m <= \chap2c::dimension<s, VSet, V>}
# Result 5.22. Proof spine: construct a bounded-degree monic annihilator by
# induction on dim VSet; choose one of least degree; subtract two least-degree
# monic annihilators to prove uniqueness.
axiom minimal_polynomial_exists_unique_and_has_bounded_degree:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            exist! p \chap2a::polynomial_space<s, V.scalars> st {$is_minimal_polynomial_of(s, VSet, V, T, p)}
            $minimal_polynomial_degree_is_bounded(s, VSet, V, T)
# Definition 5.24. Selection occurs only after Result 5.22's unique-existence
# interface; later theorems consume the exact candidate relation.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>: $chap2a::is_finite_dimensional(s, VSet, V)>:
    have fn minimal_polynomial by exist!:
        ? forall T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
            exist! p \chap2a::polynomial_space<s, V.scalars> st {$is_minimal_polynomial_of(s, VSet, V, T, p)}
        by thm minimal_polynomial_exists_unique_and_has_bounded_degree(s, VSet, V, T)
# Kernel boundary: expose the selected value's defining relation after the
# parameterized unique-existence construction.
axiom minimal_polynomial_satisfies_spec:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $is_minimal_polynomial_of(s, VSet, V, T, \minimal_polynomial<s, VSet, V>(T))
# Example 5.26. For the displayed companion-type operator on F^5, the orbit of
# e1 is the standard basis through T^4e1 and T^5e1=-3e1+6e2, giving minimal
# polynomial 3-6z+z^5.
prop has_monic_complex_linear_factorization(p \chap2a::polynomial_space<&chap1a::Complex, chap1a::complex_scalars>, m N_pos):
    exist roots fn(idx N_pos: idx <= m) &chap1a::Complex, stages fn(j N_pos: j <= m + 1) fn(t &chap1a::Complex) &chap1a::Complex st {$chap4::is_complete_complex_linear_factorization(p, m, chap1a::complex_one, roots, stages)}
# Result 5.27(a). Proof spine: a zero lambda factors p=(z-lambda)q and
# minimality makes q(T) nonzero somewhere; conversely an eigenvector turns
# p(T)v=0 into p(lambda)v=0.
prop minimal_polynomial_zero_iff_eigenvalue_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s):
    forall:
        =>:
            $chap4::is_zero_of_polynomial(s, V.scalars, \minimal_polynomial<s, VSet, V>(T), lambda)
        <=>:
            $chap5a::is_eigenvalue(s, VSet, V, T, lambda)

axiom eigenvalues_are_zeros_of_minimal_polynomial:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $minimal_polynomial_zero_iff_eigenvalue_statement(s, VSet, V, T, lambda)
# Result 5.27(b). Apply 5.27(a) to the second version of the fundamental
# theorem of algebra; monicity makes the leading constant one.
axiom complex_minimal_polynomial_factors_by_eigenvalues:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            exist m N_pos st {$has_monic_complex_linear_factorization(\minimal_polynomial<&chap1a::Complex, VSet, V>(T), m)}
# Example 5.28. The source's companion operator on C^5 has minimal polynomial
# 3-6z+z^5; its five eigenvalues are therefore exactly that polynomial's five
# zeros, which are recorded numerically only as explanatory prose.
prop is_polynomial_multiple(s nonempty_set, scalars &chap1a::ScalarSystem<s>, multiple, divisor \chap2a::polynomial_space<s, scalars>):
    exist factor \chap2a::polynomial_space<s, scalars> st {multiple = \chap5a::polynomial_product<s, scalars>(divisor, factor)}

prop annihilator_iff_minimal_polynomial_multiple_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, q \chap2a::polynomial_space<s, V.scalars>):
    forall:
        =>:
            $annihilates_operator(s, VSet, V, q, T)
        <=>:
            $is_polynomial_multiple(s, V.scalars, q, \minimal_polynomial<s, VSet, V>(T))
# Result 5.29. Proof spine: divide q by the minimal polynomial; q(T)=0 forces
# the lower-degree remainder to vanish; the converse is one use of
# multiplicativity and p(T)=0.
axiom annihilating_polynomials_are_exactly_minimal_polynomial_multiples:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, q \chap2a::polynomial_space<s, V.scalars>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $annihilator_iff_minimal_polynomial_multiple_statement(s, VSet, V, T, q)
# Restriction to an invariant subspace is callable and pointwise identical to
# T. The remaining trust is only the dependent codomain and inherited-linearity
# packaging.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, U power_set(VSet): $chap5a::is_invariant_subspace(s, VSet, V, T, U)>:
    trust have restricted_operator \chap3a::linear_map_space<s, U, U, \chap1c::subspace_vector_space<s, VSet, V, U>, \chap1c::subspace_vector_space<s, VSet, V, U>>:
        forall u U:
            restricted_operator(u) = T(u)
# Result 5.31. Restricting p(T)=0 to U gives p(T|U)=0; Result 5.29 for the
# restricted operator supplies divisibility.
axiom minimal_polynomial_of_restriction_divides_ambient_minimal_polynomial:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, U power_set(VSet):
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap5a::is_invariant_subspace(s, VSet, V, T, U)
        =>:
            $is_polynomial_multiple(s, V.scalars, \minimal_polynomial<s, VSet, V>(T), \minimal_polynomial<s, U, \chap1c::subspace_vector_space<s, VSet, V, U>>(\restricted_operator<s, VSet, V, T, U>))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    have fn polynomial_constant_term(p \chap2a::polynomial_space<s, scalars>) s = p(scalars.zero)

prop noninvertible_iff_minimal_constant_zero_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    forall:
        =>:
            not $chap3d::is_invertible_linear_map(s, VSet, VSet, V, V, T)
        <=>:
            \polynomial_constant_term<s, V.scalars>(\minimal_polynomial<s, VSet, V>(T)) = V.scalars.zero
# Result 5.32. Proof spine: T is noninvertible iff zero is an eigenvalue; by
# 5.27 this is equivalent to p(0)=0; p(0) is the constant term.
axiom noninvertible_iff_minimal_polynomial_constant_term_is_zero:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $noninvertible_iff_minimal_constant_zero_statement(s, VSet, V, T)

template<VSet nonempty_set, V &chap1b::VectorSpace<R, VSet>>:
    have fn real_quadratic_at_operator(T \chap3a::linear_map_space<R, VSet, VSet, V, V>, b, c R) \chap3a::linear_map_space<R, VSet, VSet, V, V> = \chap3a::linear_map_add<R, VSet, VSet, V, V>(\chap3a::linear_map_add<R, VSet, VSet, V, V>(\chap5a::operator_power<R, VSet, V>(T, 2), \chap3a::linear_map_smul<R, VSet, VSet, V, V>(b, T)), \chap3a::linear_map_smul<R, VSet, VSet, V, V>(c, \chap3a::identity_linear_map<R, VSet, V>))
# Result 5.33. Proof spine: restrict T to the invariant quadratic null space;
# the positive real quadratic forbids eigenvectors; enlarge a maximal
# even-dimensional invariant subspace by span(w,Tw), a two-dimensional block.
axiom real_irreducible_quadratic_has_even_dimensional_null_space:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<R, VSet>, T \chap3a::linear_map_space<R, VSet, VSet, V, V>, b, c R:
        $chap2a::is_finite_dimensional(R, VSet, V)
        b^2 < 4 * c
        =>:
            exist k N st {\chap2c::dimension<R, chap1a::real_scalars, \chap3b::null_space<R, VSet, VSet, V, V>(\real_quadratic_at_operator<VSet, V>(T, b, c)), \chap1c::subspace_vector_space<R, VSet, V, \chap3b::null_space<R, VSet, VSet, V, V>(\real_quadratic_at_operator<VSet, V>(T, b, c))>> = 2 * k}
# Result 5.34. Proof spine: factor the real minimal polynomial; a linear factor
# gives an eigenvalue, while an irreducible quadratic produces a proper
# invariant odd-dimensional range and closes induction in steps of two.
axiom real_operator_on_odd_dimensional_space_has_an_eigenvalue:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<R, VSet>, T \chap3a::linear_map_space<R, VSet, VSet, V, V>, k N:
        $chap2a::is_finite_dimensional(R, VSet, V)
        \chap2c::dimension<R, VSet, V> = 2 * k + 1
        =>:
            exist lambda R st {$chap5a::is_eigenvalue(R, VSet, V, T, lambda)}
