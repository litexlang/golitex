# Linear Algebra Done Right, fourth edition — Section 5A.
# Invariant Subspaces.
# Definition 5.1. An operator is a linear map from VSet to itself. This source
# name reuses the callable linear-map carrier instead of introducing a second
# opaque kind of map.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have operator_space set = \chap3a::linear_map_space<s, VSet, VSet, V, V>
# Definition 5.2. U is invariant under T exactly when U is a subspace and T
# maps each of its vectors back into U.
prop is_invariant_subspace(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, U power_set(VSet)):
    $chap1c::is_subspace(s, VSet, V, U)
    forall u U:
        T(u) $in U
# Example 5.3. Differentiation preserves P_4(R). The derivative operation on
# the function-based polynomial carrier has not yet been developed, so the
# source example remains an explicit prose example rather than a fake map.
# Example 5.4. {0}, VSet, null T, and range T are invariant under T. Each case
# has one reason: T(0)=0, codomain typing, T(0)=0 again, and closure of an image
# under another application of T, respectively.
# Definition 5.5. An eigenvalue is a scalar with a nonzero eigenvector witness.
prop is_eigenvalue(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s):
    exist v VSet st {v != V.zero, T(v) = V.smul(lambda, v)}
# Example 5.6. For the displayed operator on F^3, the source checks the single
# equation T(3,1,-1)=6(3,1,-1), so 6 is an eigenvalue.
# T-lambda I is a reusable operator expression needed throughout eigenvalue
# theory; subtraction is addition of the scalar negative.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    # Trust reason: the selected linear-map sum is mathematically typed, but
    # the callable carrier does not replay closure through this nested value.
    trust have operator_minus_scalar_identity fn(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s) \chap3a::linear_map_space<s, VSet, VSet, V, V>
# This named specification exposes the selected value to importing chapters.
axiom operator_minus_scalar_identity_spec:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s:
        \operator_minus_scalar_identity<s, VSet, V>(T, lambda) = \chap3a::linear_map_add<s, VSet, VSet, V, V>(T, \chap3a::linear_map_smul<s, VSet, VSet, V, V>(V.scalars.neg(lambda), \chap3a::identity_linear_map<s, VSet, V>))
# Result 5.7. Proof spine: first rewrite Tv=lambda v as
# (T-lambda I)v=0; then apply Result 3.65 to identify noninjective,
# nonsurjective, and noninvertible endomorphisms in finite dimension.
prop eigenvalue_equivalent_conditions_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s):
    forall:
        =>:
            $is_eigenvalue(s, VSet, V, T, lambda)
        <=>:
            not $chap3b::is_injective(VSet, VSet, \operator_minus_scalar_identity<s, VSet, V>(T, lambda))
            not $chap3b::is_surjective(VSet, VSet, \operator_minus_scalar_identity<s, VSet, V>(T, lambda))
            not $chap3d::is_invertible_linear_map(s, VSet, VSet, V, V, \operator_minus_scalar_identity<s, VSet, V>(T, lambda))

axiom equivalent_conditions_to_be_an_eigenvalue:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $eigenvalue_equivalent_conditions_statement(s, VSet, V, T, lambda)
# Definition 5.8. An eigenvector relation records only the two mathematical
# conditions on the supplied vector. It does not repeat that lambda is an
# eigenvalue, because these conditions already witness that fact.
prop is_eigenvector(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, v VSet):
    v != V.zero
    T(v) = V.smul(lambda, v)
# Example 5.9. The quarter-turn on R^2 has no eigenvalue; on C^2 its
# eigenvalues are i and -i, obtained from lambda^2=-1. This stays prose until
# the concrete builtin-C coordinate vector-space instance is checked.
# A finite eigenvalue list is distinct when equal entries have equal indices.
# This avoids carrying both index inequality and scalar inequality premises.
prop has_distinct_entries(s set, n N, values &chap1a::FiniteList<s, n>):
    forall j, k N+:
        j <= n
        k <= n
        values.entries(j) = values.entries(k)
        =>:
            j = k

prop lists_corresponding_eigenpairs(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N, eigenvalues &chap1a::FiniteList<s, n>, eigenvectors &chap1a::FiniteList<VSet, n>):
    forall k N+:
        k <= n
        =>:
            $is_eigenvector(s, VSet, V, T, eigenvalues.entries(k), eigenvectors.entries(k))
# Result 5.11. Proof spine: choose a shortest dependent eigenvector list;
# apply T-lambda_m I to delete the last term; the remaining nonzero
# coefficients contradict that minimality.
axiom eigenvectors_for_distinct_eigenvalues_are_linearly_independent:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N, eigenvalues &chap1a::FiniteList<s, n>, eigenvectors &chap1a::FiniteList<VSet, n>:
        $has_distinct_entries(s, n, eigenvalues)
        $lists_corresponding_eigenpairs(s, VSet, V, T, n, eigenvalues, eigenvectors)
        =>:
            $chap2a::is_linearly_independent(s, VSet, V, n, eigenvectors)
# Result 5.12. Proof spine: choose one eigenvector for each distinct
# eigenvalue; Result 5.11 makes that list independent; Result 2.22 bounds its
# length by the length of a basis.
axiom number_of_distinct_eigenvalues_is_bounded_by_dimension:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N, eigenvalues &chap1a::FiniteList<s, n>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $has_distinct_entries(s, n, eigenvalues)
        forall k N+:
            k <= n
            =>:
                $is_eigenvalue(s, VSet, V, T, eigenvalues.entries(k))
        =>:
            n <= \chap2c::dimension<s, VSet, V>
# Notation 5.13. Nonnegative powers are the identity followed by repeated
# composition. Negative powers are available only for invertible operators.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    # Trust reason: induction builds the expected map, but dependent callable
    # carrier closure does not replay across the recursive selector.
    trust have operator_power fn(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N) \chap3a::linear_map_space<s, VSet, VSet, V, V>

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    trust have negative_operator_power fn(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N+: $chap3d::is_invertible_linear_map(s, VSet, VSet, V, V, T)) \chap3a::linear_map_space<s, VSet, VSet, V, V>
# The n powers I,T,...,T^(n-1) form the ordered operator list paired with a
# length-n coefficient representation.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, n N+>:
    # Trust reason: FiniteList construction needs dependent entry transport
    # for the opaque operator-power selector.
    trust have operator_power_list fn(T \chap3a::linear_map_space<s, VSet, VSet, V, V>) &chap1a::FiniteList<\chap3a::linear_map_space<s, VSet, VSet, V, V>, n>
# Notation 5.14. A candidate p(T) is the finite linear combination of
# I,T,... determined by any coefficient representation of p.
prop is_polynomial_at_operator_value(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p \chap2a::polynomial_space<s, V.scalars>, T, value \chap3a::linear_map_space<s, VSet, VSet, V, V>):
    $is_nonempty_set(\chap3a::linear_map_space<s, VSet, VSet, V, V>)
    exist n N+, coefficients &chap1a::FiniteList<s, n> st {$chap2a::represents_polynomial(s, V.scalars, n, coefficients, p), value = \chap2a::linear_combination_value<s, \chap3a::linear_map_space<s, VSet, VSet, V, V>, \chap3a::linear_map_vector_space<s, VSet, VSet, V, V>, n>(coefficients, \operator_power_list<s, VSet, V, n>(T))}
# Trust boundary: existence follows from a coefficient representation;
# uniqueness requires transporting Chapter 2's coefficient uniqueness through
# the operator-valued finite linear combination.
axiom polynomial_at_operator_exists_unique:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        exist! value \chap3a::linear_map_space<s, VSet, VSet, V, V> st {$is_polynomial_at_operator_value(s, VSet, V, p, T, value)}

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn polynomial_at_operator by exist!:
        ? forall p \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
            exist! value \chap3a::linear_map_space<s, VSet, VSet, V, V> st {$is_polynomial_at_operator_value(s, VSet, V, p, T, value)}
        by thm polynomial_at_operator_exists_unique(s, VSet, V, p, T)
# Kernel boundary: expose the selected value's defining relation after
# template instantiation.
axiom polynomial_at_operator_satisfies_spec:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $is_polynomial_at_operator_value(s, VSet, V, p, T, \polynomial_at_operator<s, VSet, V>(p, T))
# Example 5.15. For differentiation D and p(x)=7-3x+5x^2, the source obtains
# p(D)=7I-3D+5D^2 and hence p(D)q=7q-3q'+5q''. The derivative interface is the
# only missing object, so the example remains prose rather than a trusted fake.
# Definition 5.16. Polynomial multiplication is pointwise multiplication. The
# result is kept in the polynomial carrier; closure is the visible trust step.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have polynomial_product fn(p, q \chap2a::polynomial_space<s, scalars>) \chap2a::polynomial_space<s, scalars>
# Result 5.17. Proof spine: expanding the two finite coefficient sums gives
# (pq)(T)=p(T)q(T); applying this twice and using pq=qp gives commutation.
axiom multiplicative_properties_of_polynomials_applied_to_operator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p, q \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        \polynomial_at_operator<s, VSet, V>(\polynomial_product<s, V.scalars>(p, q), T) = \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(\polynomial_at_operator<s, VSet, V>(p, T), \polynomial_at_operator<s, VSet, V>(q, T))
        \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(\polynomial_at_operator<s, VSet, V>(p, T), \polynomial_at_operator<s, VSet, V>(q, T)) = \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(\polynomial_at_operator<s, VSet, V>(q, T), \polynomial_at_operator<s, VSet, V>(p, T))
# Immediate reusable specialization of 5.17(b) to the polynomial z. It is the
# sole algebraic bridge consumed by 5.18 and later restriction arguments.
axiom polynomial_at_operator_commutes_with_operator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(\polynomial_at_operator<s, VSet, V>(p, T), T) = \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, \polynomial_at_operator<s, VSet, V>(p, T))

thm equal_functions_agree_at_input:
    ? forall X, Y set, f, g fn(x X) Y, x X:
        f = g
        =>:
            f(x) = g(x)
thm null_space_and_range_of_commuting_operator_are_invariant:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, P, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(P, T) = \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, P)
        =>:
            $is_invariant_subspace(s, VSet, V, T, \chap3b::null_space<s, VSet, VSet, V, V>(P))
            $is_invariant_subspace(s, VSet, V, T, \chap3b::range_of<VSet, VSet>(P))
    # Pointwise commutation proves both closures, but null/range set-builder
    # membership and final invariant-subspace packaging do not replay.
    trust $is_invariant_subspace(s, VSet, V, T, \chap3b::null_space<s, VSet, VSet, V, V>(P))
    trust $is_invariant_subspace(s, VSet, V, T, \chap3b::range_of<VSet, VSet>(P))
# Result 5.18. Proof spine: 5.17 makes p(T) commute with T; the generic
# commuting-operator lemma above then preserves both its null space and range.
thm null_space_and_range_of_polynomial_are_invariant:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, p \chap2a::polynomial_space<s, V.scalars>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $is_invariant_subspace(s, VSet, V, T, \chap3b::null_space<s, VSet, VSet, V, V>(\polynomial_at_operator<s, VSet, V>(p, T)))
        $is_invariant_subspace(s, VSet, V, T, \chap3b::range_of<VSet, VSet>(\polynomial_at_operator<s, VSet, V>(p, T)))
    by thm polynomial_at_operator_commutes_with_operator(s, VSet, V, p, T)
    by thm null_space_and_range_of_commuting_operator_are_invariant(s, VSet, V, \polynomial_at_operator<s, VSet, V>(p, T), T)
