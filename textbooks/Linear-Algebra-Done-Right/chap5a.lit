# Linear Algebra Done Right, fourth edition — Section 5A.
# Invariant Subspaces.


# Definition 5.1. An operator is a linear map from V to itself. This source
# name reuses the callable linear-map carrier instead of introducing a second
# opaque kind of map.
template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    have operator_space set = \chap3a::linear_map_space<s, V, V, Vspace, Vspace>

# Definition 5.2. U is invariant under T exactly when U is a subspace and T
# maps each of its vectors back into U.
prop is_invariant_subspace(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, U power_set(V)):
    $chap1c::is_subspace(s, V, Vspace, U)
    forall u U:
        T(u) $in U

# Example 5.3. Differentiation preserves P_4(R). The derivative operation on
# the function-based polynomial carrier has not yet been developed, so the
# source example remains an explicit prose example rather than a fake map.

# Example 5.4. {0}, V, null T, and range T are invariant under T. Each case
# has one reason: T(0)=0, codomain typing, T(0)=0 again, and closure of an image
# under another application of T, respectively.

# Definition 5.5. An eigenvalue is a scalar with a nonzero eigenvector witness.
prop is_eigenvalue(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, lambda s):
    exist v V st {v != Vspace.zero, T(v) = Vspace.smul(lambda, v)}

# Example 5.6. For the displayed operator on F^3, the source checks the single
# equation T(3,1,-1)=6(3,1,-1), so 6 is an eigenvalue.

# T-lambda I is a reusable operator expression needed throughout eigenvalue
# theory; subtraction is addition of the scalar negative.
template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    have fn operator_minus_scalar_identity(T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, lambda s) \chap3a::linear_map_space<s, V, V, Vspace, Vspace> = \chap3a::linear_map_add<s, V, V, Vspace, Vspace>(T, \chap3a::linear_map_smul<s, V, V, Vspace, Vspace>(Vspace.scalars.neg(lambda), \chap3a::identity_linear_map<s, V, Vspace>))

# Result 5.7. Proof spine: first rewrite Tv=lambda v as
# (T-lambda I)v=0; then apply Result 3.65 to identify noninjective,
# nonsurjective, and noninvertible endomorphisms in finite dimension.
prop eigenvalue_equivalent_conditions_statement(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, lambda s):
    forall:
        =>:
            $is_eigenvalue(s, V, Vspace, T, lambda)
        <=>:
            not $chap3b::is_injective(V, V, \operator_minus_scalar_identity<s, V, Vspace>(T, lambda))
            not $chap3b::is_surjective(V, V, \operator_minus_scalar_identity<s, V, Vspace>(T, lambda))
            not $chap3d::is_invertible_linear_map(s, V, V, Vspace, Vspace, \operator_minus_scalar_identity<s, V, Vspace>(T, lambda))

axiom equivalent_conditions_to_be_an_eigenvalue:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, lambda s:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        =>:
            $eigenvalue_equivalent_conditions_statement(s, V, Vspace, T, lambda)

# Definition 5.8. An eigenvector relation records only the two mathematical
# conditions on the supplied vector. It does not repeat that lambda is an
# eigenvalue, because these conditions already witness that fact.
prop is_eigenvector(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, lambda s, v V):
    v != Vspace.zero
    T(v) = Vspace.smul(lambda, v)

# Example 5.9. The quarter-turn on R^2 has no eigenvalue; on C^2 its
# eigenvalues are i and -i, obtained from lambda^2=-1. This stays prose until
# the concrete Complex coordinate space and its scalar action are connected.

# A finite eigenvalue list is distinct when equal entries have equal indices.
# This avoids carrying both index inequality and scalar inequality premises.
prop has_distinct_entries(s set, n N, values &chap1a::FiniteList<s, n>):
    forall j, k N_pos:
        j <= n
        k <= n
        values.entries(j) = values.entries(k)
        =>:
            j = k

prop lists_corresponding_eigenpairs(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, n N, eigenvalues &chap1a::FiniteList<s, n>, eigenvectors &chap1a::FiniteList<V, n>):
    forall k N_pos:
        k <= n
        =>:
            $is_eigenvector(s, V, Vspace, T, eigenvalues.entries(k), eigenvectors.entries(k))

# Result 5.11. Proof spine: choose a shortest dependent eigenvector list;
# apply T-lambda_m I to delete the last term; the remaining nonzero
# coefficients contradict that minimality.
axiom eigenvectors_for_distinct_eigenvalues_are_linearly_independent:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, n N, eigenvalues &chap1a::FiniteList<s, n>, eigenvectors &chap1a::FiniteList<V, n>:
        $has_distinct_entries(s, n, eigenvalues)
        $lists_corresponding_eigenpairs(s, V, Vspace, T, n, eigenvalues, eigenvectors)
        =>:
            $chap2a::is_linearly_independent(s, V, Vspace, n, eigenvectors)

# Result 5.12. Proof spine: choose one eigenvector for each distinct
# eigenvalue; Result 5.11 makes that list independent; Result 2.22 bounds its
# length by the length of a basis.
axiom number_of_distinct_eigenvalues_is_bounded_by_dimension:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, n N, eigenvalues &chap1a::FiniteList<s, n>:
        $chap2a::is_finite_dimensional(s, V, Vspace)
        $has_distinct_entries(s, n, eigenvalues)
        forall k N_pos:
            k <= n
            =>:
                $is_eigenvalue(s, V, Vspace, T, eigenvalues.entries(k))
        =>:
            n <= \chap2c::dimension<s, V, Vspace>

# Notation 5.13. Nonnegative powers are the identity followed by repeated
# composition. Negative powers are available only for invertible operators.
template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    have fn operator_power(T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, n N) \chap3a::linear_map_space<s, V, V, Vspace, Vspace> by induc n from 0:
        case n = 0: \chap3a::identity_linear_map<s, V, Vspace>
        case n > 0: \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, operator_power(T, n - 1))

template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    trust have negative_operator_power fn(T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, n N_pos: $chap3d::is_invertible_linear_map(s, V, V, Vspace, Vspace, T)) \chap3a::linear_map_space<s, V, V, Vspace, Vspace>

# The n powers I,T,...,T^(n-1) form the ordered operator list paired with a
# length-n coefficient representation.
template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, n N_pos>:
    have fn operator_power_list(T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>) &chap1a::FiniteList<\chap3a::linear_map_space<s, V, V, Vspace, Vspace>, n> = (n, fn(k N_pos: k <= n) \chap3a::linear_map_space<s, V, V, Vspace, Vspace> {\operator_power<s, V, Vspace>(T, k - 1)})

# Notation 5.14. A candidate p(T) is the finite linear combination of
# I,T,... determined by any coefficient representation of p.
prop is_polynomial_at_operator_value(s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, p \chap2a::polynomial_space<s, Vspace.scalars>, T, value \chap3a::linear_map_space<s, V, V, Vspace, Vspace>):
    exist n N_pos, coefficients &chap1a::FiniteList<s, n> st {$chap2a::represents_polynomial(s, Vspace.scalars, n, coefficients, p), value = \chap2a::linear_combination_value<s, \chap3a::linear_map_space<s, V, V, Vspace, Vspace>, \chap3a::linear_map_vector_space<s, V, V, Vspace, Vspace>, n>(coefficients, \operator_power_list<s, V, Vspace, n>(T))}

# Trust boundary: existence follows from a coefficient representation;
# uniqueness requires transporting Chapter 2's coefficient uniqueness through
# the operator-valued finite linear combination.
axiom polynomial_at_operator_exists_unique:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, p \chap2a::polynomial_space<s, Vspace.scalars>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>:
        exist! value \chap3a::linear_map_space<s, V, V, Vspace, Vspace> st {$is_polynomial_at_operator_value(s, V, Vspace, p, T, value)}

template<s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>>:
    have fn polynomial_at_operator by exist!:
        ? forall p \chap2a::polynomial_space<s, Vspace.scalars>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>:
            exist! value \chap3a::linear_map_space<s, V, V, Vspace, Vspace> st {$is_polynomial_at_operator_value(s, V, Vspace, p, T, value)}
        by thm polynomial_at_operator_exists_unique(s, V, Vspace, p, T)

# Kernel boundary: expose the selected value's defining relation after
# template instantiation.
axiom polynomial_at_operator_satisfies_spec:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, p \chap2a::polynomial_space<s, Vspace.scalars>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>:
        $is_polynomial_at_operator_value(s, V, Vspace, p, T, \polynomial_at_operator<s, V, Vspace>(p, T))

# Example 5.15. For differentiation D and p(x)=7-3x+5x^2, the source obtains
# p(D)=7I-3D+5D^2 and hence p(D)q=7q-3q'+5q''. The derivative interface is the
# only missing object, so the example remains prose rather than a trusted fake.

# Definition 5.16. Polynomial multiplication is pointwise multiplication. The
# result is kept in the polynomial carrier; closure is the visible trust step.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    trust have polynomial_product fn(p, q \chap2a::polynomial_space<s, scalars>) \chap2a::polynomial_space<s, scalars>:
        forall z s:
            polynomial_product(p, q)(z) = scalars.mul(p(z), q(z))

# Result 5.17. Proof spine: expanding the two finite coefficient sums gives
# (pq)(T)=p(T)q(T); applying this twice and using pq=qp gives commutation.
axiom multiplicative_properties_of_polynomials_applied_to_operator:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, p, q \chap2a::polynomial_space<s, Vspace.scalars>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>:
        \polynomial_at_operator<s, V, Vspace>(\polynomial_product<s, Vspace.scalars>(p, q), T) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(\polynomial_at_operator<s, V, Vspace>(p, T), \polynomial_at_operator<s, V, Vspace>(q, T))
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(\polynomial_at_operator<s, V, Vspace>(p, T), \polynomial_at_operator<s, V, Vspace>(q, T)) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(\polynomial_at_operator<s, V, Vspace>(q, T), \polynomial_at_operator<s, V, Vspace>(p, T))

# Immediate reusable specialization of 5.17(b) to the polynomial z. It is the
# sole algebraic bridge consumed by 5.18 and later restriction arguments.
axiom polynomial_at_operator_commutes_with_operator:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, p \chap2a::polynomial_space<s, Vspace.scalars>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>:
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(\polynomial_at_operator<s, V, Vspace>(p, T), T) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, \polynomial_at_operator<s, V, Vspace>(p, T))

# Result 5.18. Proof spine: 5.17 makes p(T) commute with T; applying that
# equality to a null-space vector keeps it in the null space; applying it to a
# represented range vector gives another represented range vector.
thm null_space_and_range_of_polynomial_are_invariant:
    ? forall s nonempty_set, V nonempty_set, Vspace &chap1b::VectorSpace<s, V>, p \chap2a::polynomial_space<s, Vspace.scalars>, T \chap3a::linear_map_space<s, V, V, Vspace, Vspace>:
        $is_invariant_subspace(s, V, Vspace, T, \chap3b::null_space<s, V, V, Vspace, Vspace>(\polynomial_at_operator<s, V, Vspace>(p, T)))
        $is_invariant_subspace(s, V, Vspace, T, \chap3b::range_of<V, V>(\polynomial_at_operator<s, V, Vspace>(p, T)))
    have P \chap3a::linear_map_space<s, V, V, Vspace, Vspace> = \polynomial_at_operator<s, V, Vspace>(p, T)
    by thm chap3b::null_space_is_subspace(s, V, V, Vspace, Vspace, P)
    by thm chap3b::range_is_subspace(s, V, V, Vspace, Vspace, P)
    by thm polynomial_at_operator_commutes_with_operator(s, V, Vspace, p, T)
    claim:
        ? forall u \chap3b::null_space<s, V, V, Vspace, Vspace>(P):
            T(u) $in \chap3b::null_space<s, V, V, Vspace, Vspace>(P)
        P(u) = Vspace.zero
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(P, T) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, P)
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(P, T)(u) = P(T(u))
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, P)(u) = T(P(u))
        by thm chap3a::linear_maps_take_zero_to_zero(s, V, V, Vspace, Vspace, T)
        P(T(u)) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(P, T)(u) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, P)(u) = T(P(u)) = T(Vspace.zero) = Vspace.zero
    claim:
        ? forall u \chap3b::range_of<V, V>(P):
            T(u) $in \chap3b::range_of<V, V>(P)
        obtain v from exist v V st {u = P(v)}
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(P, T) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, P)
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(P, T)(v) = P(T(v))
        \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, P)(v) = T(P(v))
        witness exist w V st {T(u) = P(w)} from T(v):
            T(u) = T(P(v)) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(T, P)(v) = \chap3a::linear_map_compose<s, V, V, V, Vspace, Vspace, Vspace>(P, T)(v) = P(T(v))
    $chap1c::is_subspace(s, V, Vspace, \chap3b::null_space<s, V, V, Vspace, Vspace>(P))
    $chap1c::is_subspace(s, V, Vspace, \chap3b::range_of<V, V>(P))
    $is_invariant_subspace(s, V, Vspace, T, \chap3b::null_space<s, V, V, Vspace, Vspace>(P))
    $is_invariant_subspace(s, V, Vspace, T, \chap3b::range_of<V, V>(P))
