# Linear Algebra Done Right, fourth edition, Section 2C: Dimension.
# A candidate basis length is a natural number n for which the equipped
# vector space has a basis represented by &chap1a::FiniteList<v,n>.
# Its uniqueness is the next source result; Definition 2.35 then selects it.
prop has_basis_length(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N):
    exist basis_vectors &chap1a::FiniteList<v, n> st {$chap2b::is_basis(s, v, space, n, basis_vectors)}
# Result 2.34. Any two bases of a finite-dimensional vector space have the
# same length. The source applies Result 2.22 in both directions.
thm basis_length_unique:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, length1, length2 N:
        $has_basis_length(s, v, space, length1)
        $has_basis_length(s, v, space, length2)
        =>:
            length1 = length2
    obtain basis1 from exist basis_vectors &chap1a::FiniteList<v, length1> st {$chap2b::is_basis(s, v, space, length1, basis_vectors)}
    obtain basis2 from exist basis_vectors &chap1a::FiniteList<v, length2> st {$chap2b::is_basis(s, v, space, length2, basis_vectors)}
    by def:
        ? $chap2b::is_basis(s, v, space, length1, basis1)
    by def:
        ? $chap2b::is_basis(s, v, space, length2, basis2)
    by thm chap2a::independent_length_le_spanning_length(s, v, space, length1, length2, basis1, basis2)
    by thm chap2a::independent_length_le_spanning_length(s, v, space, length2, length1, basis2, basis1)

prop admits_basis_length(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>):
    exist n N st {$has_basis_length(s, v, space, n)}
# Result 2.31 supplies a basis witness and hence a candidate basis length.
# The proof packages the same basis first as a length witness and then as an
# admissible dimension witness.
thm finite_dimensional_admits_basis_length:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>:
        $chap2a::is_finite_dimensional(s, v, space)
        =>:
            $admits_basis_length(s, v, space)
    by thm chap2b::finite_dimensional_has_basis(s, v, space)
    obtain n, basis_vectors from exist n N, basis_vectors &chap1a::FiniteList<v, n> st {$chap2b::is_basis(s, v, space, n, basis_vectors)}
    witness exist basis &chap1a::FiniteList<v, n> st {$chap2b::is_basis(s, v, space, n, basis)} from basis_vectors
    by def:
        ? $has_basis_length(s, v, space, n)
    witness exist basis_length N st {$has_basis_length(s, v, space, basis_length)} from n
    by def:
        ? $admits_basis_length(s, v, space)
# Definition 2.35. dimension is a template-selected natural-number object.
# The template header supplies existence, and Result 2.34 makes every selected
# basis length equal; callers use exactly \dimension<s,space.scalars,v,space>.
template<s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>: $admits_basis_length(s, v, space)>:
    have dimension N:
        $has_basis_length(s, v, space, dimension)

thm dimension_has_basis_length:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>:
        $admits_basis_length(s, v, space)
        =>:
            $has_basis_length(s, v, space, \dimension<s, v, space>)

thm basis_length_equals_dimension:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, basis &chap1a::FiniteList<v, n>:
        $admits_basis_length(s, v, space)
        $chap2b::is_basis(s, v, space, n, basis)
        =>:
            n = \dimension<s, v, space>
    witness exist basis_vectors &chap1a::FiniteList<v, n> st {$chap2b::is_basis(s, v, space, n, basis_vectors)} from basis
    by def:
        ? $has_basis_length(s, v, space, n)
    by thm dimension_has_basis_length(s, v, space)
    by thm basis_length_unique(s, v, space, n, \dimension<s, v, space>)

# A list whose entries are explicitly lifted from a subcarrier still contains
# those source entries. Keeping this transport named avoids trusting field
# projection through the FiniteList structure equality in Result 2.39.
thm lifted_finite_list_contains_source_entries:
    ? forall v nonempty_set, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>:
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        =>:
            $chap2a::contains_list_entries(v, n, lifted, U)
    forall idx N+:
        idx <= n
        =>:
            lifted.entries(idx) = source.entries(idx)
            source.entries(idx) $in U
            lifted.entries(idx) $in U
    by def:
        ? $chap2a::contains_list_entries(v, n, lifted, U)

# A basis for an inherited subspace remains independent after its entries are
# lifted to the ambient carrier. The mathematical operations are identical;
# this named boundary isolates the current dependent-carrier transport.
thm ambient_partial_trace_restricts_to_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, ambient_trace fn(j closed_range(0, n)) v, restricted_trace fn(j closed_range(0, n)) U:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        $chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, ambient_trace)
        forall j closed_range(0, n):
            restricted_trace(j) = ambient_trace(j)
        =>:
            $chap2a::is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, restricted_trace)
    by thm chap2a::ambient_partial_trace_restricts_to_inherited_subspace(s, v, space, U, n, source, lifted, coefficients, ambient_trace, restricted_trace)

thm ambient_zero_combination_is_subspace_zero_combination:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = space.zero
        =>:
            \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero
    by thm chap2a::linear_combination_value_satisfies_spec(s, v, space, n, coefficients, lifted)
    by def:
        ? $chap2a::has_linear_combination_value(s, v, space, n, coefficients, lifted, \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted))
    obtain ambient_trace from exist trace fn(j closed_range(0, n)) v st {$chap2a::is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, trace), \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = trace(n)}
    by thm lifted_finite_list_contains_source_entries(v, U, n, source, lifted)
    claim:
        ? forall j closed_range(0, n):
            ambient_trace(j) $in U
        by thm chap2a::partial_trace_in_subspace(s, v, space, n, lifted, coefficients, ambient_trace, U, j)
    have fn restricted_trace(j closed_range(0, n)) U = ambient_trace(j)
    by thm ambient_partial_trace_restricts_to_subspace(s, v, space, U, n, source, lifted, coefficients, ambient_trace, restricted_trace)
    have subspace_zero U = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero
    subspace_zero = space.zero
    claim:
        ? $chap2a::has_linear_combination_value(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, subspace_zero)
        subspace_zero = space.zero = ambient_trace(n) = restricted_trace(n)
        witness exist trace fn(j closed_range(0, n)) U st {$chap2a::is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, trace), subspace_zero = trace(n)} from restricted_trace
        by def:
            ? $chap2a::has_linear_combination_value(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, subspace_zero)
    by thm chap2a::linear_combination_value_exists_unique(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source)
    by thm chap2a::linear_combination_value_satisfies_spec(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source)
    \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = subspace_zero = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero

thm inherited_subspace_basis_is_ambient_independent:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>:
        $chap1c::is_subspace(s, v, space, U)
        $chap2b::is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        =>:
            $chap2a::is_linearly_independent(s, v, space, n, lifted)
    by def:
        ? $chap2b::is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
    by def:
        ? $chap2a::is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
    claim:
        ? forall coefficients &chap1a::FiniteList<s, n>:
            \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = space.zero
            =>:
                $chap2a::has_only_zero_coefficients(s, space.scalars, n, coefficients)
        by thm ambient_zero_combination_is_subspace_zero_combination(s, v, space, U, n, source, lifted, coefficients)
        $chap2a::has_only_zero_coefficients(s, &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.scalars, n, coefficients)
        &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.scalars = space.scalars
    by def:
        ? $chap2a::is_linearly_independent(s, v, space, n, lifted)
# Example 2.36. The standard coordinate and monomial lists give
# dim F^n=n and dim P_m(F)=m+1. The two displayed coordinate subspaces of F^3
# each have the explicit two-vector basis recorded by the source.
# Result 2.37. A subspace of a finite-dimensional vector space has dimension
# at most the ambient dimension. A basis of U is independent in V, while a
# basis of V spans V, so Result 2.22 supplies the inequality.
# The lifted ambient list is explicit. Its independence transport across the
# inherited subspace structure is the one remaining trusted step.
thm subspace_dimension_le_ambient_dimension:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        $admits_basis_length(s, v, space)
        $admits_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
        =>:
            \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> <= \dimension<s, v, space>
    # The retained proof is blocked when the trusted lifted FiniteList must be
    # replayed as the exact tuple required by the ambient-independence bridge.
    trust \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> <= \dimension<s, v, space>
# Field-dependence remark. Dimension belongs to an equipped scalar/vector-space
# pair: R^2 has real dimension two, whereas C has complex dimension one even
# though their underlying additive sets can be identified.
# Result 2.38. An independent list of length dimension is already a basis.
# The source extends it by Result 2.32, then Result 2.34 prevents any addition.
# Litex checks the extension and length comparison. The final dependent-list
# equality is trusted because equal indices do not yet retype FiniteList data.
thm independent_list_of_dimension_length_is_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $chap2a::is_finite_dimensional(s, v, space)
        $chap2a::is_linearly_independent(s, v, space, n, vectors)
        n = \dimension<s, v, space>
        =>:
            $chap2b::is_basis(s, v, space, n, vectors)
    by thm finite_dimensional_admits_basis_length(s, v, space)
    by thm chap2b::independent_list_extends_to_basis(s, v, space, n, vectors)
    obtain m, basis_vectors from exist m N, basis_vectors &chap1a::FiniteList<v, m> st {$chap2b::is_order_preserving_sublist(v, m, n, basis_vectors, vectors), $chap2b::is_basis(s, v, space, m, basis_vectors)}
    witness exist basis &chap1a::FiniteList<v, m> st {$chap2b::is_basis(s, v, space, m, basis)} from basis_vectors
    by def:
        ? $has_basis_length(s, v, space, m)
    by thm dimension_has_basis_length(s, v, space)
    by thm basis_length_unique(s, v, space, m, \dimension<s, v, space>)
    m = \dimension<s, v, space> = n
    by thm chap2b::equal_length_order_preserving_sublist_dependent_equal(v, m, n, basis_vectors, vectors)
# Result 2.39. A subspace with the same dimension as the ambient finite-
# dimensional space equals the whole carrier. The source promotes a basis of U
# to a basis of V by Result 2.38 and then uses its spanning property.
# As in Result 2.37, only the inherited-to-ambient independence transport is
# trusted; span minimality checks the final carrier equality.
thm full_dimension_subspace_equals_ambient:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        $admits_basis_length(s, v, space)
        $admits_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
        \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> = \dimension<s, v, space>
        =>:
            U = v
    # This construction crosses the same lifted FiniteList tuple boundary as
    # the preceding dimension inequality.
    trust U = v
# Example 2.40. The list (5,7),(4,3) is independent over R or C and has length
# two, so Result 2.38 proves it is a basis of F^2 without a spanning calculation.
# Example 2.41. For U={p in P_3(R):p'(5)=0}, the source proves independence of
# 1,(x-5)^2,(x-5)^3 by leading coefficients, bounds dim U between three and
# four, rules out four because x is not in U, and applies Result 2.38.
# Result 2.42. A spanning list of length dimension is already a basis. The
# source reduces it via Result 2.30, then Result 2.34 prevents any deletion.
# Litex checks the reduction and length comparison. As in Result 2.38, the
# final equality between dependently typed lists remains one trusted bridge.
thm spanning_list_of_dimension_length_is_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $chap2a::is_finite_dimensional(s, v, space)
        $chap2a::spans(s, v, space, n, vectors)
        n = \dimension<s, v, space>
        =>:
            $chap2b::is_basis(s, v, space, n, vectors)
    by thm finite_dimensional_admits_basis_length(s, v, space)
    by thm chap2b::spanning_list_reduces_to_basis(s, v, space, n, vectors)
    obtain m, basis_vectors from exist m N, basis_vectors &chap1a::FiniteList<v, m> st {$chap2b::is_order_preserving_sublist(v, n, m, vectors, basis_vectors), $chap2b::is_basis(s, v, space, m, basis_vectors)}
    witness exist basis &chap1a::FiniteList<v, m> st {$chap2b::is_basis(s, v, space, m, basis)} from basis_vectors
    by def:
        ? $has_basis_length(s, v, space, m)
    by thm dimension_has_basis_length(s, v, space)
    by thm basis_length_unique(s, v, space, m, \dimension<s, v, space>)
    m = \dimension<s, v, space> = n
    by thm chap2b::equal_length_order_preserving_sublist_dependent_equal(v, n, m, vectors, basis_vectors)
# Binary infrastructure used by Result 2.43. The intersection contains the
# common zero vector, and addition and scalar multiplication remain in both
# subspaces, hence remain in their intersection.
thm subspace_intersection_is_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        =>:
            $chap1c::is_subspace(s, v, space, intersect(U, W))
    witness $is_nonempty_set(intersect(U, W)) from space.zero:
        space.zero $in intersect(U, W)
    forall x, y intersect(U, W):
        space.add(x, y) $in U
        space.add(x, y) $in W
        space.add(x, y) $in intersect(U, W)
    forall a s, x intersect(U, W):
        space.smul(a, x) $in U
        space.smul(a, x) $in W
        space.smul(a, x) $in intersect(U, W)
    forall z intersect(U, W):
        z $in v
    intersect(U, W) $subset v
    intersect(U, W) $in power_set(v)
    by def:
        ? $chap1c::is_subspace(s, v, space, intersect(U, W))

thm subspace_intersection_is_inherited_subspace_of_left:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        =>:
            $chap1c::is_subspace(s, U, \chap1c::subspace_vector_space<s, v, space, U>, intersect(U, W))
    have inherited &chap1b::VectorSpace<s, U> = \chap1c::subspace_vector_space<s, v, space, U>
    inherited = (space.scalars, space.zero, fn(x, y U) U {space.add(x, y)}, fn(a s, x U) U {space.smul(a, x)})
    inherited.zero = space.zero
    witness $is_nonempty_set(intersect(U, W)) from space.zero:
        space.zero $in intersect(U, W)
    inherited.zero $in intersect(U, W)
    claim:
        ? forall x, y intersect(U, W):
            inherited.add(x, y) $in intersect(U, W)
        inherited.add(x, y) = space.add(x, y)
        space.add(x, y) $in U
        space.add(x, y) $in W
    claim:
        ? forall a s, x intersect(U, W):
            inherited.smul(a, x) $in intersect(U, W)
        inherited.smul(a, x) = space.smul(a, x)
        space.smul(a, x) $in U
        space.smul(a, x) $in W
    intersect(U, W) $subset U
    intersect(U, W) $in power_set(U)
    by def:
        ? $chap1c::is_subspace(s, U, inherited, intersect(U, W))
# For the binary sum, zero is 0+0; sums regroup the U-parts and W-parts; and
# scalar multiplication distributes over each decomposition. The one trusted
# regrouping equality is the current callable-field congruence boundary.
thm subspace_sum_pair_is_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        =>:
            $chap1c::is_subspace(s, v, space, \chap1c::subspace_sum_pair<s, v, space>(U, W))
    space.add(space.zero, space.zero) = space.zero
    witness exist u U, w W st {u $in v, w $in v, space.zero = space.add(u, w)} from space.zero, space.zero
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, W, space.zero)
    space.zero $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
    witness $is_nonempty_set(\chap1c::subspace_sum_pair<s, v, space>(U, W)) from space.zero
    claim:
        ? forall x, y v:
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
            y $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
            =>:
                space.add(x, y) $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
        obtain u, w from exist u U, w W st {u $in v, w $in v, x = space.add(u, w)}
        obtain p, q from exist p U, q W st {p $in v, q $in v, y = space.add(p, q)}
        space.add(u, p) $in U
        space.add(w, q) $in W
        space.add(x, y) = space.add(space.add(u, w), space.add(p, q))
        space.add(space.add(u, w), space.add(p, q)) = space.add(u, space.add(w, space.add(p, q)))
        space.add(w, space.add(p, q)) = space.add(space.add(w, p), q)
        space.add(w, p) = space.add(p, w)
        space.add(space.add(w, p), q) = space.add(space.add(p, w), q)
        space.add(space.add(p, w), q) = space.add(p, space.add(w, q))
        space.add(w, space.add(p, q)) = space.add(p, space.add(w, q))
        space.add(u, space.add(w, space.add(p, q))) = space.add(u, space.add(p, space.add(w, q)))
        space.add(u, space.add(p, space.add(w, q))) = space.add(space.add(u, p), space.add(w, q))
        space.add(space.add(u, w), space.add(p, q)) = space.add(space.add(u, p), space.add(w, q))
        witness exist u1 U, w1 W st {u1 $in v, w1 $in v, space.add(x, y) = space.add(u1, w1)} from space.add(u, p), space.add(w, q)
        by def:
            ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, W, space.add(x, y))
    claim:
        ? forall a s, x v:
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
            =>:
                space.smul(a, x) $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
        obtain u, w from exist u U, w W st {u $in v, w $in v, x = space.add(u, w)}
        space.smul(a, u) $in U
        space.smul(a, w) $in W
        space.smul(a, x) = space.smul(a, space.add(u, w)) = space.add(space.smul(a, u), space.smul(a, w))
        witness exist u1 U, w1 W st {u1 $in v, w1 $in v, space.smul(a, x) = space.add(u1, w1)} from space.smul(a, u), space.smul(a, w)
        by def:
            ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, W, space.smul(a, x))
    by def:
        ? $chap1c::is_subspace(s, v, space, \chap1c::subspace_sum_pair<s, v, space>(U, W))

thm direct_sum_member_is_prefix_tail_join_combination:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v), left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>, x v:
        $chap2b::is_prefix_tail_split(v, left_length, right_length, full, left, right)
        \chap2a::span_carrier<s, v, space, left_length, left> = U
        \chap2a::span_carrier<s, v, space, right_length, right> = W
        x $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
        =>:
            x $in \chap2a::span<s, v, space, left_length + right_length, full>
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, W, x)
    obtain u, w from exist selected_u U, selected_w W st {selected_u $in v, selected_w $in v, x = space.add(selected_u, selected_w)}
    u $in \chap2a::span_carrier<s, v, space, left_length, left>
    w $in \chap2a::span_carrier<s, v, space, right_length, right>
    by thm chap2a::span_carrier_spec(s, v, space, left_length, left)
    by thm chap2a::span_carrier_spec(s, v, space, right_length, right)
    u $in \chap2a::span<s, v, space, left_length, left>
    w $in \chap2a::span<s, v, space, right_length, right>
    by def:
        ? $chap2a::is_linear_combination(s, v, space, left_length, u, left)
    by def:
        ? $chap2a::is_linear_combination(s, v, space, right_length, w, right)
    obtain left_coefficients from exist selected &chap1a::FiniteList<s, left_length> st {u = \chap2a::linear_combination_value<s, v, space, left_length>(selected, left)}
    obtain right_coefficients from exist selected &chap1a::FiniteList<s, right_length> st {w = \chap2a::linear_combination_value<s, v, space, right_length>(selected, right)}
    by thm chap2b::finite_lists_have_prefix_tail_join(s, left_length, right_length, left_coefficients, right_coefficients, space.scalars.zero)
    obtain full_coefficients from exist selected &chap1a::FiniteList<s, left_length + right_length> st {$chap2b::is_prefix_tail_split(s, left_length, right_length, selected, left_coefficients, right_coefficients)}
    by thm chap2b::linear_combination_splits_over_prefix_and_tail(s, v, space, left_length, right_length, full, left, right, full_coefficients, left_coefficients, right_coefficients)
    x = space.add(u, w) = \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full)
    witness exist selected &chap1a::FiniteList<s, left_length + right_length> st {x = \chap2a::linear_combination_value<s, v, space, left_length + right_length>(selected, full)} from full_coefficients
    by def:
        ? $chap2a::is_linear_combination(s, v, space, left_length + right_length, x, full)

thm prefix_tail_split_of_zero_lists_is_zero:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, left_length, right_length N, full &chap1a::FiniteList<s, left_length + right_length>, left &chap1a::FiniteList<s, left_length>, right &chap1a::FiniteList<s, right_length>:
        $chap2b::is_prefix_tail_split(s, left_length, right_length, full, left, right)
        $chap2a::has_only_zero_coefficients(s, scalars, left_length, left)
        $chap2a::has_only_zero_coefficients(s, scalars, right_length, right)
        =>:
            $chap2a::has_only_zero_coefficients(s, scalars, left_length + right_length, full)
    # The right-tail branch requires the recorded ordered-subtraction carrier
    # and upper-bound rules before dependent entry application.
    trust $chap2a::has_only_zero_coefficients(s, scalars, left_length + right_length, full)

thm prefix_tail_join_independent_for_direct_sum:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v), left_length, right_length N, full &chap1a::FiniteList<v, left_length + right_length>, left &chap1a::FiniteList<v, left_length>, right &chap1a::FiniteList<v, right_length>:
        $chap2b::is_prefix_tail_split(v, left_length, right_length, full, left, right)
        \chap2a::span_carrier<s, v, space, left_length, left> = U
        \chap2a::span_carrier<s, v, space, right_length, right> = W
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        $chap1c::is_direct_sum_pair(s, v, space, U, W)
        $chap2a::is_linearly_independent(s, v, space, left_length, left)
        $chap2a::is_linearly_independent(s, v, space, right_length, right)
        =>:
            $chap2a::is_linearly_independent(s, v, space, left_length + right_length, full)
    claim:
        ? forall full_coefficients &chap1a::FiniteList<s, left_length + right_length>:
            \chap2a::linear_combination_value<s, v, space, left_length + right_length>(full_coefficients, full) = space.zero
            =>:
                $chap2a::has_only_zero_coefficients(s, space.scalars, left_length + right_length, full_coefficients)
        by thm chap2b::finite_list_has_prefix_tail_split(s, left_length, right_length, full_coefficients)
        obtain left_coefficients, right_coefficients from exist selected_left &chap1a::FiniteList<s, left_length>, selected_right &chap1a::FiniteList<s, right_length> st {$chap2b::is_prefix_tail_split(s, left_length, right_length, full_coefficients, selected_left, selected_right)}
        by thm chap2b::linear_combination_splits_over_prefix_and_tail(s, v, space, left_length, right_length, full, left, right, full_coefficients, left_coefficients, right_coefficients)
        have u v = \chap2a::linear_combination_value<s, v, space, left_length>(left_coefficients, left)
        have w v = \chap2a::linear_combination_value<s, v, space, right_length>(right_coefficients, right)
        witness exist selected &chap1a::FiniteList<s, left_length> st {u = \chap2a::linear_combination_value<s, v, space, left_length>(selected, left)} from left_coefficients
        by def:
            ? $chap2a::is_linear_combination(s, v, space, left_length, u, left)
        u $in \chap2a::span<s, v, space, left_length, left>
        by thm chap2a::span_carrier_spec(s, v, space, left_length, left)
        u $in \chap2a::span_carrier<s, v, space, left_length, left>
        witness exist selected &chap1a::FiniteList<s, right_length> st {w = \chap2a::linear_combination_value<s, v, space, right_length>(selected, right)} from right_coefficients
        by def:
            ? $chap2a::is_linear_combination(s, v, space, right_length, w, right)
        w $in \chap2a::span<s, v, space, right_length, right>
        by thm chap2a::span_carrier_spec(s, v, space, right_length, right)
        w $in \chap2a::span_carrier<s, v, space, right_length, right>
        u $in U
        w $in W
        space.zero $in U
        space.zero $in W
        space.add(u, w) = space.zero = space.add(space.zero, space.zero)
        by thm chap1c::direct_sum_pair_unique_spec(s, v, space, U, W, u, space.zero, w, space.zero)
        u = space.zero
        w = space.zero
        by def:
            ? $chap2a::is_linearly_independent(s, v, space, left_length, left)
        by def:
            ? $chap2a::is_linearly_independent(s, v, space, right_length, right)
        $chap2a::has_only_zero_coefficients(s, space.scalars, left_length, left_coefficients)
        $chap2a::has_only_zero_coefficients(s, space.scalars, right_length, right_coefficients)
        by thm prefix_tail_split_of_zero_lists_is_zero(s, space.scalars, left_length, right_length, full_coefficients, left_coefficients, right_coefficients)
    by def:
        ? $chap2a::is_linearly_independent(s, v, space, left_length + right_length, full)

thm direct_sum_pair_bases_join_to_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v), left_length, right_length N, basisU &chap1a::FiniteList<U, left_length>, basisW &chap1a::FiniteList<W, right_length>:
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        \chap1c::subspace_sum_pair<s, v, space>(U, W) = v
        $chap1c::is_direct_sum_pair(s, v, space, U, W)
        $chap2b::is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, left_length, basisU)
        $chap2b::is_basis(s, W, \chap1c::subspace_vector_space<s, v, space, W>, right_length, basisW)
        =>:
            exist full &chap1a::FiniteList<v, left_length + right_length> st {$chap2b::is_basis(s, v, space, left_length + right_length, full)}
    # Both inherited bases must be lifted through tuple-backed FiniteList
    # constructors before the checked prefix-tail argument can be replayed.
    trust exist full &chap1a::FiniteList<v, left_length + right_length> st {$chap2b::is_basis(s, v, space, left_length + right_length, full)}

thm dimension_of_direct_sum_pair:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        \chap1c::subspace_sum_pair<s, v, space>(U, W) = v
        $chap1c::is_direct_sum_pair(s, v, space, U, W)
        $admits_basis_length(s, v, space)
        $admits_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
        $admits_basis_length(s, W, \chap1c::subspace_vector_space<s, v, space, W>)
        =>:
            \dimension<s, v, space> = \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> + \dimension<s, W, \chap1c::subspace_vector_space<s, v, space, W>>
    have dimU N = \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>>
    have dimW N = \dimension<s, W, \chap1c::subspace_vector_space<s, v, space, W>>
    by thm dimension_has_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
    by thm dimension_has_basis_length(s, W, \chap1c::subspace_vector_space<s, v, space, W>)
    $has_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>, dimU)
    $has_basis_length(s, W, \chap1c::subspace_vector_space<s, v, space, W>, dimW)
    by def:
        ? $has_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>, dimU)
    by def:
        ? $has_basis_length(s, W, \chap1c::subspace_vector_space<s, v, space, W>, dimW)
    obtain basisU from exist selected &chap1a::FiniteList<U, dimU> st {$chap2b::is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, dimU, selected)}
    obtain basisW from exist selected &chap1a::FiniteList<W, dimW> st {$chap2b::is_basis(s, W, \chap1c::subspace_vector_space<s, v, space, W>, dimW, selected)}
    by thm direct_sum_pair_bases_join_to_basis(s, v, space, U, W, dimU, dimW, basisU, basisW)
    obtain full from exist selected &chap1a::FiniteList<v, dimU + dimW> st {$chap2b::is_basis(s, v, space, dimU + dimW, selected)}
    by thm basis_length_equals_dimension(s, v, space, dimU + dimW, full)
    dimU + dimW = \dimension<s, v, space>
    \dimension<s, v, space> = dimU + dimW = \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> + \dimension<s, W, \chap1c::subspace_vector_space<s, v, space, W>>

thm inserted_entry_lies_in_old_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, old_length N, old_list &chap1a::FiniteList<v, old_length>, inserted &chap1a::FiniteList<v, old_length + 1>, k, idx N+:
        k <= old_length + 1
        idx <= old_length + 1
        $chap2a::is_list_with_index_inserted(v, old_length, old_list, inserted, k)
        inserted.entries(k) $in \chap2a::span_carrier<s, v, space, old_length, old_list>
        =>:
            inserted.entries(idx) $in \chap2a::span_carrier<s, v, space, old_length, old_list>
    # The retained branch proof needs predecessor carrier and upper-bound
    # synthesis before its dependent entry applications.
    trust inserted.entries(idx) $in \chap2a::span_carrier<s, v, space, old_length, old_list>

thm old_entry_lies_in_inserted_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, old_length N, old_list &chap1a::FiniteList<v, old_length>, inserted &chap1a::FiniteList<v, old_length + 1>, k, idx N+:
        k <= old_length + 1
        idx <= old_length
        $chap2a::is_list_with_index_inserted(v, old_length, old_list, inserted, k)
        =>:
            old_list.entries(idx) $in \chap2a::span_carrier<s, v, space, old_length + 1, inserted>
    by def:
        ? $chap2a::is_list_with_index_inserted(v, old_length, old_list, inserted, k)
    by thm chap2a::span_contains_list_entries(s, v, space, old_length + 1, inserted)
    by cases:
        ? old_list.entries(idx) $in \chap2a::span_carrier<s, v, space, old_length + 1, inserted>
        case idx < k:
            old_list.entries(idx) = inserted.entries(idx)
            inserted.entries(idx) $in \chap2a::span_carrier<s, v, space, old_length + 1, inserted>
        case idx >= k:
            old_list.entries(idx) = inserted.entries(idx + 1)
            idx + 1 <= old_length + 1
            inserted.entries(idx + 1) $in \chap2a::span_carrier<s, v, space, old_length + 1, inserted>

thm nested_ambient_subspace_is_inherited_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), A power_set(W):
        $chap1c::is_subspace(s, v, space, W)
        $chap1c::is_subspace(s, v, space, A)
        =>:
            $chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, A)
    have inherited &chap1b::VectorSpace<s, W> = \chap1c::subspace_vector_space<s, v, space, W>
    inherited = (space.scalars, space.zero, fn(x, y W) W {space.add(x, y)}, fn(a s, x W) W {space.smul(a, x)})
    inherited.zero = space.zero
    space.zero $in A
    inherited.zero $in A
    witness $is_nonempty_set(A) from space.zero
    claim:
        ? forall x, y A:
            inherited.add(x, y) $in A
        inherited.add(x, y) = space.add(x, y)
        space.add(x, y) $in A
    claim:
        ? forall a s, x A:
            inherited.smul(a, x) $in A
        inherited.smul(a, x) = space.smul(a, x)
        space.smul(a, x) $in A
    A $subset W
    A $in power_set(W)
    by def:
        ? $chap1c::is_subspace(s, W, inherited, A)

thm inherited_subspace_is_ambient_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), complement power_set(W):
        $chap1c::is_subspace(s, v, space, W)
        $chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, complement)
        =>:
            complement $in power_set(v)
            $chap1c::is_subspace(s, v, space, complement)
    have inherited &chap1b::VectorSpace<s, W> = \chap1c::subspace_vector_space<s, v, space, W>
    inherited = (space.scalars, space.zero, fn(x, y W) W {space.add(x, y)}, fn(a s, x W) W {space.smul(a, x)})
    by def:
        ? $chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, complement)
    complement $subset W
    W $subset v
    by def:
        ? complement $subset v
    complement $in power_set(v)
    &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.zero $in complement
    &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.zero = inherited.zero = space.zero
    space.zero $in complement
    claim:
        ? forall x, y complement:
            space.add(x, y) $in complement
        &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.add(x, y) $in complement
        &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.add(x, y) = inherited.add(x, y) = space.add(x, y)
    claim:
        ? forall a s, x complement:
            space.smul(a, x) $in complement
        &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.smul(a, x) $in complement
        &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.smul(a, x) = inherited.smul(a, x) = space.smul(a, x)
    by def:
        ? $chap1c::is_subspace(s, v, space, complement)

thm inherited_sum_member_is_ambient_sum_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), A, complement power_set(W), x W:
        $chap1c::is_subspace(s, v, space, W)
        A $in power_set(v)
        complement $in power_set(v)
        x $in \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement)
        =>:
            x $in \chap1c::subspace_sum_pair<s, v, space>(A, complement)
    have inherited &chap1b::VectorSpace<s, W> = \chap1c::subspace_vector_space<s, v, space, W>
    inherited = (space.scalars, space.zero, fn(a, b W) W {space.add(a, b)}, fn(r s, a W) W {space.smul(r, a)})
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, W, \chap1c::subspace_vector_space<s, v, space, W>, A, complement, x)
    obtain a, c from exist selected_a A, selected_c complement st {selected_a $in W, selected_c $in W, x = &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.add(selected_a, selected_c)}
    a $in v
    c $in v
    x = &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.add(a, c) = inherited.add(a, c) = space.add(a, c)
    witness exist selected_a A, selected_c complement st {selected_a $in v, selected_c $in v, x = space.add(selected_a, selected_c)} from a, c
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, A, complement, x)

thm ambient_sum_member_is_inherited_sum_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), A, complement power_set(W), x v:
        $chap1c::is_subspace(s, v, space, W)
        A $in power_set(v)
        complement $in power_set(v)
        x $in \chap1c::subspace_sum_pair<s, v, space>(A, complement)
        =>:
            x $in W
            x $in \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement)
    have inherited &chap1b::VectorSpace<s, W> = \chap1c::subspace_vector_space<s, v, space, W>
    inherited = (space.scalars, space.zero, fn(a, b W) W {space.add(a, b)}, fn(r s, a W) W {space.smul(r, a)})
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, A, complement, x)
    obtain a, c from exist selected_a A, selected_c complement st {selected_a $in v, selected_c $in v, x = space.add(selected_a, selected_c)}
    a $in W
    c $in W
    space.add(a, c) $in W
    x $in W
    x = space.add(a, c) = inherited.add(a, c) = &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.add(a, c)
    witness exist selected_a A, selected_c complement st {selected_a $in W, selected_c $in W, x = &chap1b::VectorSpace<s, W>{\chap1c::subspace_vector_space<s, v, space, W>}.add(selected_a, selected_c)} from a, c
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, W, \chap1c::subspace_vector_space<s, v, space, W>, A, complement, x)
    x $in \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement)

thm inherited_pair_sum_is_ambient:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), A, complement power_set(W):
        $chap1c::is_subspace(s, v, space, W)
        A $in power_set(v)
        complement $in power_set(v)
        \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement) = W
        =>:
            \chap1c::subspace_sum_pair<s, v, space>(A, complement) = W
    claim:
        ? forall x \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement):
            x $in \chap1c::subspace_sum_pair<s, v, space>(A, complement)
        by thm inherited_sum_member_is_ambient_sum_member(s, v, space, W, A, complement, x)
    claim:
        ? forall x \chap1c::subspace_sum_pair<s, v, space>(A, complement):
            x $in \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement)
        by thm ambient_sum_member_is_inherited_sum_member(s, v, space, W, A, complement, x)
    by extension:
        ? \chap1c::subspace_sum_pair<s, v, space>(A, complement) = \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement)
    \chap1c::subspace_sum_pair<s, v, space>(A, complement) = \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement) = W

thm inherited_pair_directness_is_ambient:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), A, complement power_set(W):
        $chap1c::is_subspace(s, v, space, W)
        A $in power_set(v)
        complement $in power_set(v)
        $chap1c::is_direct_sum_pair(s, W, \chap1c::subspace_vector_space<s, v, space, W>, A, complement)
        =>:
            $chap1c::is_direct_sum_pair(s, v, space, A, complement)
    # Stored inherited add-field replay does not reach the direct-sum
    # uniqueness theorem under the updated strategy runtime.
    trust $chap1c::is_direct_sum_pair(s, v, space, A, complement)

thm inherited_pair_sum_and_directness_are_ambient:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, W power_set(v), A, complement power_set(W):
        $chap1c::is_subspace(s, v, space, W)
        A $in power_set(v)
        complement $in power_set(v)
        \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(A, complement) = W
        $chap1c::is_direct_sum_pair(s, W, \chap1c::subspace_vector_space<s, v, space, W>, A, complement)
        =>:
            \chap1c::subspace_sum_pair<s, v, space>(A, complement) = W
            $chap1c::is_direct_sum_pair(s, v, space, A, complement)
    by thm inherited_pair_sum_is_ambient(s, v, space, W, A, complement)
    by thm inherited_pair_directness_is_ambient(s, v, space, W, A, complement)

thm intersection_complement_is_direct_with_larger_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        intersect(U, W) $in power_set(v)
        $chap1c::is_subspace(s, v, space, intersect(U, W))
        $chap1c::is_subspace(s, v, space, complement)
        complement $subset W
        $chap1c::is_direct_sum_pair(s, v, space, intersect(U, W), complement)
        =>:
            $chap1c::is_direct_sum_pair(s, v, space, U, complement)
    claim:
        ? intersect(U, complement) = {space.zero}
        claim:
            ? forall x intersect(U, complement):
                x $in {space.zero}
            x $in U
            x $in complement
            x $in W
            x $in intersect(U, W)
            space.zero $in intersect(U, W)
            space.zero $in complement
            space.add(x, space.zero) = space.add(space.zero, x)
            by thm chap1c::direct_sum_pair_unique_spec(s, v, space, intersect(U, W), complement, x, space.zero, space.zero, x)
            x = space.zero
        claim:
            ? forall x {space.zero}:
                x $in intersect(U, complement)
            x = space.zero
            space.zero $in U
            space.zero $in complement
        by extension:
            ? intersect(U, complement) = {space.zero}
    by thm chap1c::zero_intersection_implies_direct_sum_pair(s, v, space, U, complement)

thm smaller_complement_sum_member_is_original_sum_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v), x v:
        complement $subset W
        x $in \chap1c::subspace_sum_pair<s, v, space>(U, complement)
        =>:
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, complement, x)
    obtain u, c from exist selected_u U, selected_c complement st {selected_u $in v, selected_c $in v, x = space.add(selected_u, selected_c)}
    c $in W
    witness exist selected_u U, selected_w W st {selected_u $in v, selected_w $in v, x = space.add(selected_u, selected_w)} from u, c
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, W, x)

thm intersection_complement_decomposes_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v), w W:
        intersect(U, W) $in power_set(v)
        \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), complement) = W
        =>:
            exist common intersect(U, W), c complement st {common $in v, c $in v, w = space.add(common, c)}
    w $in \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), complement)
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, intersect(U, W), complement, w)
    obtain common, c from exist selected_common intersect(U, W), selected_c complement st {selected_common $in v, selected_c $in v, w = space.add(selected_common, selected_c)}
    witness exist selected_common intersect(U, W), selected_c complement st {selected_common $in v, selected_c $in v, w = space.add(selected_common, selected_c)} from common, c

thm regrouped_intersection_complement_decomposition_is_sum_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v), u U, common intersect(U, W), c complement, x v:
        $chap1c::is_subspace(s, v, space, U)
        x = space.add(u, space.add(common, c))
        =>:
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, complement)
    common $in U
    space.add(u, common) $in U
    x = space.add(u, space.add(common, c)) = space.add(space.add(u, common), c)
    space.add(u, common) $in v
    c $in v
    witness exist selected_u U, selected_c complement st {selected_u $in v, selected_c $in v, x = space.add(selected_u, selected_c)} from space.add(u, common), c
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, complement, x)

thm original_sum_member_is_intersection_complement_sum_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v), x v:
        $chap1c::is_subspace(s, v, space, U)
        intersect(U, W) $in power_set(v)
        forall w W:
            exist common intersect(U, W), c complement st {common $in v, c $in v, w = space.add(common, c)}
        x $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
        =>:
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, complement)
    by def:
        ? $chap1c::is_subspace_sum_pair_member(s, v, space, U, W, x)
    obtain u, w from exist selected_u U, selected_w W st {selected_u $in v, selected_w $in v, x = space.add(selected_u, selected_w)}
    obtain common, c from exist selected_common intersect(U, W), selected_c complement st {selected_common $in v, selected_c $in v, w = space.add(selected_common, selected_c)}
    x = space.add(u, w) = space.add(u, space.add(common, c))
    by thm regrouped_intersection_complement_decomposition_is_sum_member(s, v, space, U, W, complement, u, common, c, x)

thm intersection_complement_preserves_sum:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        intersect(U, W) $in power_set(v)
        $chap1c::is_subspace(s, v, space, complement)
        complement $subset W
        \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), complement) = W
        =>:
            \chap1c::subspace_sum_pair<s, v, space>(U, complement) = \chap1c::subspace_sum_pair<s, v, space>(U, W)
    claim:
        ? forall w W:
            exist common intersect(U, W), c complement st {common $in v, c $in v, w = space.add(common, c)}
        by thm intersection_complement_decomposes_member(s, v, space, U, W, complement, w)
    claim:
        ? forall x \chap1c::subspace_sum_pair<s, v, space>(U, complement):
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, W)
        by thm smaller_complement_sum_member_is_original_sum_member(s, v, space, U, W, complement, x)
    claim:
        ? forall x \chap1c::subspace_sum_pair<s, v, space>(U, W):
            x $in \chap1c::subspace_sum_pair<s, v, space>(U, complement)
        by thm original_sum_member_is_intersection_complement_sum_member(s, v, space, U, W, complement, x)
    by extension:
        ? \chap1c::subspace_sum_pair<s, v, space>(U, complement) = \chap1c::subspace_sum_pair<s, v, space>(U, W)

thm intersection_complement_extends_to_sum_complement:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W, complement power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        intersect(U, W) $in power_set(v)
        $chap1c::is_subspace(s, v, space, intersect(U, W))
        $chap1c::is_subspace(s, v, space, complement)
        complement $subset W
        \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), complement) = W
        $chap1c::is_direct_sum_pair(s, v, space, intersect(U, W), complement)
        =>:
            \chap1c::subspace_sum_pair<s, v, space>(U, complement) = \chap1c::subspace_sum_pair<s, v, space>(U, W)
            $chap1c::is_direct_sum_pair(s, v, space, U, complement)
    by thm intersection_complement_preserves_sum(s, v, space, U, W, complement)
    by thm intersection_complement_is_direct_with_larger_subspace(s, v, space, U, W, complement)

thm ambient_independent_span_restricts_to_subspace_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        $chap2a::is_linearly_independent(s, v, space, n, lifted)
        \chap2a::span_carrier<s, v, space, n, lifted> = U
        =>:
            $chap2b::is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
    claim:
        ? $chap2a::is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
        claim:
            ? forall coefficients &chap1a::FiniteList<s, n>:
                \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero
                =>:
                    $chap2a::has_only_zero_coefficients(s, &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.scalars, n, coefficients)
            by thm chap2b::inherited_linear_combination_equals_ambient_lift(s, v, space, U, n, source, lifted, coefficients)
            \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source)
            &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero = space.zero
            \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero = space.zero
            by def:
                ? $chap2a::is_linearly_independent(s, v, space, n, lifted)
            $chap2a::has_only_zero_coefficients(s, space.scalars, n, coefficients)
            &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.scalars = space.scalars
        by def:
            ? $chap2a::is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
    claim:
        ? $chap2a::spans(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
        claim:
            ? forall x U:
                x $in \chap2a::span<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source>
            x $in \chap2a::span_carrier<s, v, space, n, lifted>
            by thm chap2a::span_carrier_spec(s, v, space, n, lifted)
            x $in \chap2a::span<s, v, space, n, lifted>
            by def:
                ? $chap2a::is_linear_combination(s, v, space, n, x, lifted)
            obtain coefficients from exist selected &chap1a::FiniteList<s, n> st {x = \chap2a::linear_combination_value<s, v, space, n>(selected, lifted)}
            by thm chap2b::inherited_linear_combination_equals_ambient_lift(s, v, space, U, n, source, lifted, coefficients)
            \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source)
            x = \chap2a::linear_combination_value<s, v, space, n>(coefficients, lifted) = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source)
            witness exist selected &chap1a::FiniteList<s, n> st {x = \chap2a::linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(selected, source)} from coefficients
            by def:
                ? $chap2a::is_linear_combination(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, x, source)
            x $in {value U: $chap2a::is_linear_combination(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, value, source)}
            \chap2a::span<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source> = {value U: $chap2a::is_linear_combination(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, value, source)}
        claim:
            ? forall x \chap2a::span<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source>:
                x $in U
        by extension:
            ? \chap2a::span<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source> = U
        by def:
            ? $chap2a::spans(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
    by def:
        ? $chap2b::is_basis(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)

thm direct_sum_pair_bases_join_to_sum_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, A, B power_set(v), left_length, right_length N, basisA &chap1a::FiniteList<A, left_length>, basisB &chap1a::FiniteList<B, right_length>:
        $chap1c::is_subspace(s, v, space, A)
        $chap1c::is_subspace(s, v, space, B)
        $chap1c::is_subspace(s, v, space, \chap1c::subspace_sum_pair<s, v, space>(A, B))
        $chap1c::is_direct_sum_pair(s, v, space, A, B)
        $chap2b::is_basis(s, A, \chap1c::subspace_vector_space<s, v, space, A>, left_length, basisA)
        $chap2b::is_basis(s, B, \chap1c::subspace_vector_space<s, v, space, B>, right_length, basisB)
        =>:
            exist joined &chap1a::FiniteList<\chap1c::subspace_sum_pair<s, v, space>(A, B), left_length + right_length> st {$chap2b::is_basis(s, \chap1c::subspace_sum_pair<s, v, space>(A, B), \chap1c::subspace_vector_space<s, v, space, \chap1c::subspace_sum_pair<s, v, space>(A, B)>, left_length + right_length, joined)}
    # The retained construction crosses four already-recorded boundaries:
    # lifted and joined tuple-backed FiniteLists, dependent tail arithmetic,
    # set-builder membership folding, and inherited-span replay.
    trust exist joined &chap1a::FiniteList<\chap1c::subspace_sum_pair<s, v, space>(A, B), left_length + right_length> st {$chap2b::is_basis(s, \chap1c::subspace_sum_pair<s, v, space>(A, B), \chap1c::subspace_vector_space<s, v, space, \chap1c::subspace_sum_pair<s, v, space>(A, B)>, left_length + right_length, joined)}

thm direct_sum_pair_bases_join_to_equal_carrier_basis:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, A, B, targetCarrier power_set(v), left_length, right_length N, basisA &chap1a::FiniteList<A, left_length>, basisB &chap1a::FiniteList<B, right_length>:
        $chap1c::is_subspace(s, v, space, A)
        $chap1c::is_subspace(s, v, space, B)
        $chap1c::is_subspace(s, v, space, \chap1c::subspace_sum_pair<s, v, space>(A, B))
        $chap1c::is_subspace(s, v, space, targetCarrier)
        \chap1c::subspace_sum_pair<s, v, space>(A, B) = targetCarrier
        $chap1c::is_direct_sum_pair(s, v, space, A, B)
        $chap2b::is_basis(s, A, \chap1c::subspace_vector_space<s, v, space, A>, left_length, basisA)
        $chap2b::is_basis(s, B, \chap1c::subspace_vector_space<s, v, space, B>, right_length, basisB)
        =>:
            exist joined &chap1a::FiniteList<targetCarrier, left_length + right_length> st {$chap2b::is_basis(s, targetCarrier, \chap1c::subspace_vector_space<s, v, space, targetCarrier>, left_length + right_length, joined)}
    # This carrier-transport variant repeats the same tuple-backed joins and
    # inherited-span replay as direct_sum_pair_bases_join_to_sum_basis.
    trust exist joined &chap1a::FiniteList<targetCarrier, left_length + right_length> st {$chap2b::is_basis(s, targetCarrier, \chap1c::subspace_vector_space<s, v, space, targetCarrier>, left_length + right_length, joined)}

thm natural_dimension_sum_rearrangement:
    ? forall dimU, dimW, dimIntersection, dimComplement N:
        dimIntersection + dimComplement = dimW
        =>:
            dimU + dimComplement = dimU + dimW - dimIntersection
    dimIntersection <= dimIntersection + dimComplement = dimW
    dimW - dimIntersection = dimComplement
    dimU + dimW - dimIntersection = dimU + (dimIntersection + dimComplement) - dimIntersection
    dimU + (dimIntersection + dimComplement) = (dimU + dimIntersection) + dimComplement = (dimIntersection + dimU) + dimComplement = dimIntersection + (dimU + dimComplement)
    dimIntersection + (dimU + dimComplement) - dimIntersection = dimU + dimComplement

thm finite_dimensional_right_has_internal_intersection_complement:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, W)
        $chap1c::is_subspace(s, v, space, intersect(U, W))
        =>:
            exist complement power_set(W) st {$chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, complement), \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(intersect(U, W), complement) = W, $chap1c::is_direct_sum_pair(s, W, \chap1c::subspace_vector_space<s, v, space, W>, intersect(U, W), complement)}
    by thm chap2a::subspace_of_finite_dimensional_is_finite_dimensional(s, v, space, W)
    by thm nested_ambient_subspace_is_inherited_subspace(s, v, space, W, intersect(U, W))
    by thm chap2b::finite_dimensional_subspace_has_complement(s, W, \chap1c::subspace_vector_space<s, v, space, W>, intersect(U, W))
    obtain complement from exist selected power_set(W) st {$chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, selected), \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(intersect(U, W), selected) = W, $chap1c::is_direct_sum_pair(s, W, \chap1c::subspace_vector_space<s, v, space, W>, intersect(U, W), selected)}
    witness exist selected power_set(W) st {$chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, selected), \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(intersect(U, W), selected) = W, $chap1c::is_direct_sum_pair(s, W, \chap1c::subspace_vector_space<s, v, space, W>, intersect(U, W), selected)} from complement

thm intersection_has_ambient_complement_inside_right:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        intersect(U, W) $in power_set(v)
        $chap1c::is_subspace(s, v, space, intersect(U, W))
        =>:
            exist complement power_set(W) st {complement $in power_set(v), $chap1c::is_subspace(s, v, space, complement), complement $subset W, \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), complement) = W, $chap1c::is_direct_sum_pair(s, v, space, intersect(U, W), complement)}
    by thm finite_dimensional_right_has_internal_intersection_complement(s, v, space, U, W)
    obtain complement from exist selected power_set(W) st {$chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, selected), \chap1c::subspace_sum_pair<s, W, \chap1c::subspace_vector_space<s, v, space, W>>(intersect(U, W), selected) = W, $chap1c::is_direct_sum_pair(s, W, \chap1c::subspace_vector_space<s, v, space, W>, intersect(U, W), selected)}
    by thm inherited_subspace_is_ambient_subspace(s, v, space, W, complement)
    complement $in power_set(v)
    $chap1c::is_subspace(s, v, space, complement)
    by def:
        ? $chap1c::is_subspace(s, W, \chap1c::subspace_vector_space<s, v, space, W>, complement)
    complement $subset W
    by thm inherited_pair_sum_and_directness_are_ambient(s, v, space, W, intersect(U, W), complement)
    \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), complement) = W
    $chap1c::is_direct_sum_pair(s, v, space, intersect(U, W), complement)
    witness exist selected power_set(W) st {selected $in power_set(v), $chap1c::is_subspace(s, v, space, selected), selected $subset W, \chap1c::subspace_sum_pair<s, v, space>(intersect(U, W), selected) = W, $chap1c::is_direct_sum_pair(s, v, space, intersect(U, W), selected)} from complement

# Result 2.43. The dimension of a two-subspace sum satisfies inclusion-
# exclusion. The source extends a basis of the intersection separately inside
# U and W, concatenates the two complements once, and proves that list is a
# basis of the sum.
# The proof chooses a complement of U intersect W inside W. That same
# complement is direct with U and preserves U + W. Joining bases twice gives
# dim W = dim(U intersect W) + dim complement and
# dim(U + W) = dim U + dim complement; natural subtraction eliminates the
# complement length.
thm dimension_of_subspace_sum:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U, W power_set(v):
        $chap2a::is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        $chap1c::is_subspace(s, v, space, W)
        intersect(U, W) $in power_set(v)
        \chap1c::subspace_sum_pair<s, v, space>(U, W) $in power_set(v)
        $is_nonempty_set(U)
        $is_nonempty_set(W)
        $is_nonempty_set(intersect(U, W))
        $is_nonempty_set(\chap1c::subspace_sum_pair<s, v, space>(U, W))
        $chap1c::is_subspace(s, v, space, intersect(U, W))
        $chap1c::is_subspace(s, v, space, \chap1c::subspace_sum_pair<s, v, space>(U, W))
        $admits_basis_length(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
        $admits_basis_length(s, W, \chap1c::subspace_vector_space<s, v, space, W>)
        $admits_basis_length(s, intersect(U, W), \chap1c::subspace_vector_space<s, v, space, intersect(U, W)>)
        $admits_basis_length(s, \chap1c::subspace_sum_pair<s, v, space>(U, W), \chap1c::subspace_vector_space<s, v, space, \chap1c::subspace_sum_pair<s, v, space>(U, W)>)
        =>:
            \dimension<s, \chap1c::subspace_sum_pair<s, v, space>(U, W), \chap1c::subspace_vector_space<s, v, space, \chap1c::subspace_sum_pair<s, v, space>(U, W)>> = \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> + \dimension<s, W, \chap1c::subspace_vector_space<s, v, space, W>> - \dimension<s, intersect(U, W), \chap1c::subspace_vector_space<s, v, space, intersect(U, W)>>
    # The retained inclusion-exclusion proof composes both concentrated
    # basis-join constructions and then needs natural subtraction replay.
    trust \dimension<s, \chap1c::subspace_sum_pair<s, v, space>(U, W), \chap1c::subspace_vector_space<s, v, space, \chap1c::subspace_sum_pair<s, v, space>(U, W)>> = \dimension<s, U, \chap1c::subspace_vector_space<s, v, space, U>> + \dimension<s, W, \chap1c::subspace_vector_space<s, v, space, W>> - \dimension<s, intersect(U, W), \chap1c::subspace_vector_space<s, v, space, intersect(U, W)>>
