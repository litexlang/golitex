# Linear Algebra Done Right, fourth edition — Section 8D.
# Trace: A Connection Between Matrices and Operators.
# Definition 8.47. Matrix trace is the finite scalar sum of diagonal entries.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+>:
    have fn matrix_trace(A matrix(s, n, n)) s = \chap3b::scalar_finite_sum<s, scalars, n>(fn(k N+: k <= n) s {A(k, k)})
# Example 8.48. The displayed diagonal entries sum to 5.
sketch:
    have A matrix(R, 3, 3) = [[3, -1, -2], [5, 2, -3], [1, 6, 0]]
    A(1, 1) + A(2, 2) + A(3, 3) = 3 + 2 + 0 = 5
# Result 8.49. Expand both traces as the same finite double sum and exchange
# the two summation indices.
axiom trace_of_matrix_products_is_cyclic:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, m, n N+, A matrix(s, m, n), B matrix(s, n, m):
        \matrix_trace<s, scalars, m>(\chap3c::matrix_mul<s, scalars, m, n, m>(A, B)) = \matrix_trace<s, scalars, n>(\chap3c::matrix_mul<s, scalars, n, m, n>(B, A))
# Result 8.50. Change of basis writes the two matrices as C^-1 B C; apply
# Result 8.49 once and cancel the inverse pair.
axiom trace_of_operator_matrix_is_basis_independent:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, n N+, basis1, basis2 &chap1a::FiniteList<VSet, n>:
        $chap2b::is_basis(s, VSet, V, n, basis1)
        $chap2b::is_basis(s, VSet, V, n, basis2)
        =>:
            \matrix_trace<s, V.scalars, n>(\chap5c::matrix_of_operator<s, VSet, V, n>(basis1, T)) = \matrix_trace<s, V.scalars, n>(\chap5c::matrix_of_operator<s, VSet, V, n>(basis2, T))

prop is_operator_trace_value(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, value s):
    exist n N+, basis &chap1a::FiniteList<VSet, n> st {$chap2b::is_basis(s, VSet, V, n, basis), value = \matrix_trace<s, V.scalars, n>(\chap5c::matrix_of_operator<s, VSet, V, n>(basis, T))}

axiom operator_trace_exists_unique:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        =>:
            exist! value s st {$is_operator_trace_value(s, VSet, V, T, value)}
# Definition 8.51. Basis independence turns the unique matrix-trace value into
# a callable scalar-valued function on operators.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>: $chap2a::is_finite_dimensional(s, VSet, V), \chap2c::dimension<s, VSet, V> > 0>:
    have fn operator_trace by exist!:
        ? forall T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
            exist! value s st {$is_operator_trace_value(s, VSet, V, T, value)}
        by thm operator_trace_exists_unique(s, VSet, V, T)

axiom operator_trace_spec:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        =>:
            $is_operator_trace_value(s, VSet, V, T, \operator_trace<s, VSet, V>(T))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    have fn scalar_natural_multiple(x s, d N) s by induc d from 0:
        case d = 0: scalars.zero
        case d > 0: scalars.add(scalar_natural_multiple(x, d - 1), x)

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, m N+: $chap2a::is_finite_dimensional(s, VSet, V)>:
    have fn eigenvalue_sum_with_multiplicity(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, eigenvalues &chap1a::FiniteList<s, m>) s = \chap3b::scalar_finite_sum<s, V.scalars, m>(fn(k N+: k <= m) s {\scalar_natural_multiple<s, V.scalars>(eigenvalues.entries(k), \chap8b::eigenvalue_multiplicity<s, VSet, V>(T, eigenvalues.entries(k)))})
# Result 8.52. Choose the upper-triangular basis from 8.37; its diagonal lists
# every eigenvalue exactly as many times as its multiplicity.
axiom complex_operator_trace_equals_eigenvalue_sum:
    ? forall VSet nonempty_set, V &chap1b::CVectorSpace<VSet>, T \chap3a::linear_map_space<C, VSet, VSet, V.general, V.general>, m N+, eigenvalues &chap1a::FiniteList<C, m>:
        $chap2a::is_finite_dimensional(C, VSet, V.general)
        $chap2c::admits_basis_length(C, VSet, V.general)
        \chap2c::dimension<C, VSet, V.general> > 0
        $chap5d::lists_all_distinct_eigenvalues(C, VSet, V.general, T, m, eigenvalues)
        =>:
            \operator_trace<C, VSet, V.general>(T) = \eigenvalue_sum_with_multiplicity<C, VSet, V.general, m>(T, eigenvalues)
# Example 8.53. The diagonal calculation gives trace 5; the three listed
# eigenvalues also sum to the same scalar.
sketch:
    have A matrix(R, 3, 3) = [[3, -1, -2], [3, 2, -3], [1, 2, 0]]
    A(1, 1) + A(2, 2) + A(3, 3) = 5
    1 + 2 + 2 = 5
    3 + -1 * 3 = 0
# Result 8.54. In a coefficient list of length n+1, entry n multiplies
# z^(n-1); expansion of the eigenvalue product makes it minus the trace.
axiom trace_is_negative_next_to_leading_characteristic_coefficient:
    ? forall VSet nonempty_set, V &chap1b::CVectorSpace<VSet>, T \chap3a::linear_map_space<C, VSet, VSet, V.general, V.general>, n N+, coefficients &chap1a::FiniteList<C, n + 1>:
        $chap2a::is_finite_dimensional(C, VSet, V.general)
        $chap2c::admits_basis_length(C, VSet, V.general)
        n = \chap2c::dimension<C, VSet, V.general>
        $chap2a::represents_polynomial(C, V.general.scalars, n + 1, coefficients, \chap8b::characteristic_polynomial<VSet, V>(T))
        =>:
            \operator_trace<C, VSet, V.general>(T) = V.general.scalars.neg(coefficients.entries(n))

template<s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, n N+>:
    have fn orthonormal_diagonal_sum(T \chap3a::linear_map_space<s, VSet, VSet, inner_space.vector_space, inner_space.vector_space>, basis &chap1a::FiniteList<VSet, n>) s = \chap3b::scalar_finite_sum<s, inner_space.scalar_geometry.scalars, n>(fn(k N+: k <= n) s {inner_space.inner(T(basis.entries(k)), basis.entries(k))})
# Result 8.55. Each diagonal matrix entry in an orthonormal basis is the inner
# product of T e_k with e_k.
axiom trace_on_inner_product_space:
    ? forall s nonempty_set, VSet nonempty_set, inner_space &chap6a::InnerProductSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, inner_space.vector_space, inner_space.vector_space>, n N+, basis &chap1a::FiniteList<VSet, n>:
        $chap2a::is_finite_dimensional(s, VSet, inner_space.vector_space)
        $chap2c::admits_basis_length(s, VSet, inner_space.vector_space)
        $chap6b::is_orthonormal_basis(s, VSet, inner_space, n, basis)
        =>:
            \chap2c::dimension<s, VSet, inner_space.vector_space> > 0
            \operator_trace<s, VSet, inner_space.vector_space>(T) = \orthonormal_diagonal_sum<s, VSet, inner_space, n>(T, basis)

prop operator_trace_linearity_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>):
    $chap2a::is_finite_dimensional(s, VSet, V)
    $chap2c::admits_basis_length(s, VSet, V)
    \chap2c::dimension<s, VSet, V> > 0
    $is_nonempty_set(\chap3a::linear_map_space<s, VSet, VSet, V, V>)
    $chap3f::is_linear_functional(s, \chap3a::linear_map_space<s, VSet, VSet, V, V>, \chap3a::linear_map_vector_space<s, VSet, VSet, V, V>, \operator_trace<s, VSet, V>)
    forall S, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(S, T) $in \chap3a::linear_map_space<s, VSet, VSet, V, V>
        \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, S) $in \chap3a::linear_map_space<s, VSet, VSet, V, V>
        \operator_trace<s, VSet, V>(\chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(S, T)) = \operator_trace<s, VSet, V>(\chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, S))
# Result 8.56. Matrix formation preserves addition, scalar multiplication, and
# composition; apply matrix-trace linearity and Result 8.49.
axiom trace_is_linear_and_cyclic:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        =>:
            $operator_trace_linearity_statement(s, VSet, V)
# Result 8.57. Every commutator has trace zero by 8.56, whereas the identity
# has trace dim VSet, which is nonzero in positive dimension.
axiom identity_operator_is_not_a_commutator:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, S, T \chap3a::linear_map_space<s, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        \chap2c::dimension<s, VSet, V> > 0
        =>:
            \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(S, T) $in \chap3a::linear_map_space<s, VSet, VSet, V, V>
            \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, S) $in \chap3a::linear_map_space<s, VSet, VSet, V, V>
            \chap7f::linear_map_difference<s, VSet, VSet, V, V>(\chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(S, T), \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, S)) $in \chap3a::linear_map_space<s, VSet, VSet, V, V>
            \chap7f::linear_map_difference<s, VSet, VSet, V, V>(\chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(S, T), \chap3a::linear_map_compose<s, VSet, VSet, VSet, V, V, V>(T, S)) != \chap3a::identity_linear_map<s, VSet, V>
