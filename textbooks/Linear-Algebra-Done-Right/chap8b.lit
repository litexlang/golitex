# Linear Algebra Done Right, fourth edition — Section 8B.
# Generalized Eigenspace Decomposition.
prop belongs_to_generalized_eigenspace(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, v VSet):
    exist k N_pos st {\chap5a::operator_power<s, VSet, V>(\chap5a::operator_minus_scalar_identity<s, VSet, V>(T, lambda), k)(v) = V.zero}
# Definition 8.19. The generalized eigenspace is a genuine set-valued
# function; unlike generalized eigenvectors it also contains zero.
template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    have fn generalized_eigenspace(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s) power_set(VSet) = {v VSet: $belongs_to_generalized_eigenspace(s, VSet, V, T, lambda, v)}
# Result 8.20. The dimension power is one admissible exponent; conversely
# Results 8.1 and 8.3 move every admissible exponent to dim VSet.
axiom description_of_generalized_eigenspaces:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            \generalized_eigenspace<s, VSet, V>(T, lambda) = \chap8a::power_null_space<s, VSet, V>(\chap5a::operator_minus_scalar_identity<s, VSet, V>(T, lambda), \chap2c::dimension<s, VSet, V>)
            $chap1c::is_subspace(s, VSet, V, \generalized_eigenspace<s, VSet, V>(T, lambda))
# Example 8.21. The two generalized eigenspaces are the coordinate plane and
# the third axis, whose coordinate split is direct.
sketch:
    have plane_1 finite_seq(R, 3) = [1, 0, 0]
    have plane_2 finite_seq(R, 3) = [0, 1, 0]
    have axis_3 finite_seq(R, 3) = [0, 0, 1]
    plane_1(3) = plane_2(3) = 0
    axis_3(1) = axis_3(2) = 0
    forall z1, z2, z3 R:
        [z1, z2, z3] = [z1, z2, 0] + [0, 0, z3]

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, m N_pos>:
    have fn generalized_eigenspace_family(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, eigenvalues &chap1a::FiniteList<s, m>) finite_seq(power_set(VSet), m) = fn(k N_pos: k <= m) power_set(VSet) {\generalized_eigenspace<s, VSet, V>(T, eigenvalues.entries(k))}

prop shifted_power_vanishes_on_generalized_eigenspace(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, r N_pos):
    forall v \generalized_eigenspace<s, VSet, V>(T, lambda):
        \chap5a::operator_power<s, VSet, V>(\chap5a::operator_minus_scalar_identity<s, VSet, V>(T, lambda), r)(v) = V.zero

prop shifted_operator_is_nilpotent_on_generalized_eigenspace(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s):
    exist r N_pos st {$shifted_power_vanishes_on_generalized_eigenspace(s, VSet, V, T, lambda, r)}

prop generalized_eigenspace_decomposition_statement(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, m N_pos, eigenvalues &chap1a::FiniteList<s, m>):
    forall k N_pos:
        k <= m
        =>:
            $chap5a::is_invariant_subspace(s, VSet, V, T, \generalized_eigenspace<s, VSet, V>(T, eigenvalues.entries(k)))
            $shifted_operator_is_nilpotent_on_generalized_eigenspace(s, VSet, V, T, eigenvalues.entries(k))
    $chap1c::is_direct_sum(s, VSet, V, m, \generalized_eigenspace_family<s, VSet, V, m>(T, eigenvalues))
    \chap1c::subspace_sum<s, VSet, V, m>(\generalized_eigenspace_family<s, VSet, V, m>(T, eigenvalues)) = VSet
# Result 8.22. Description 8.20 gives invariance and nilpotence; Result 8.12
# gives directness, and the generalized-eigenvector basis makes the sum all VSet.
axiom generalized_eigenspace_decomposition:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, m N_pos, eigenvalues &chap1a::FiniteList<s, m>:
        $chap2a::is_finite_dimensional(s, VSet, V)
        $chap5d::lists_all_distinct_eigenvalues(s, VSet, V, T, m, eigenvalues)
        =>:
            $generalized_eigenspace_decomposition_statement(s, VSet, V, T, m, eigenvalues)
# Definition 8.23. Multiplicity is the dimension of the callable generalized
# eigenspace. Exact unique existence is recorded before the selected N-value.
prop is_eigenvalue_multiplicity_value(s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s, d N):
    $chap1c::is_subspace(s, VSet, V, \generalized_eigenspace<s, VSet, V>(T, lambda))
    d = \chap2c::dimension<s, \generalized_eigenspace<s, VSet, V>(T, lambda), \chap1c::subspace_vector_space<s, VSet, V, \generalized_eigenspace<s, VSet, V>(T, lambda)>>

axiom eigenvalue_multiplicity_exists_unique:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            exist! d N st {$is_eigenvalue_multiplicity_value(s, VSet, V, T, lambda, d)}

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>>:
    # Selection from the exact dimension relation remains explicit proof debt.
    trust have eigenvalue_multiplicity fn(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s) N

axiom eigenvalue_multiplicity_spec:
    ? forall s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, T \chap3a::linear_map_space<s, VSet, VSet, V, V>, lambda s:
        $chap2a::is_finite_dimensional(s, VSet, V)
        =>:
            $is_eigenvalue_multiplicity_value(s, VSet, V, T, lambda, \eigenvalue_multiplicity<s, VSet, V>(T, lambda))
# Example 8.24. The upper-triangular operator has generalized eigenspace
# dimensions 2 for 6 and 1 for 7.
sketch:
    have A matrix(R, 3, 3) = [[6, 3, 4], [0, 6, 2], [0, 0, 7]]
    have g6_1 finite_seq(R, 3) = [1, 0, 0]
    have g6_2 finite_seq(R, 3) = [0, 1, 0]
    have g7 finite_seq(R, 3) = [10, 2, 1]
    A(1, 1) = A(2, 2) = 6
    A(3, 3) = 7
    2 + 1 = 3

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, m N_pos>:
    have fn eigenvalue_multiplicity_sum(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, eigenvalues &chap1a::FiniteList<s, m>) N = sum(1, m, fn(k N_pos: k <= m) N {\eigenvalue_multiplicity<s, VSet, V>(T, eigenvalues.entries(k))})
# Result 8.25. Take dimensions in the generalized eigenspace direct sum.
axiom sum_of_multiplicities_equals_dimension:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        $chap5d::lists_all_distinct_eigenvalues(&chap1a::Complex, VSet, V, T, m, eigenvalues)
        =>:
            \eigenvalue_multiplicity_sum<&chap1a::Complex, VSet, V, m>(T, eigenvalues) = \chap2c::dimension<&chap1a::Complex, VSet, V>

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    have fn finite_scalar_power(x s, k N) s by induc k from 0:
        case k = 0: scalars.one
        case k > 0: scalars.mul(finite_scalar_power(x, k - 1), x)

template<s nonempty_set, VSet nonempty_set, V &chap1b::VectorSpace<s, VSet>, m N_pos>:
    have fn characteristic_factor_product(T \chap3a::linear_map_space<s, VSet, VSet, V, V>, eigenvalues &chap1a::FiniteList<s, m>, k closed_range(0, m), z s) s by induc k from 0:
        case k = 0: V.scalars.one
        case k > 0: V.scalars.mul(characteristic_factor_product(T, eigenvalues, k - 1, z), \finite_scalar_power<s, V.scalars>(V.scalars.add(z, V.scalars.neg(eigenvalues.entries(k))), \eigenvalue_multiplicity<s, VSet, V>(T, eigenvalues.entries(k))))

prop has_characteristic_factor_values(VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>, q \chap2a::polynomial_space<&chap1a::Complex, chap1a::complex_scalars>):
    forall z &chap1a::Complex:
        q(z) = \characteristic_factor_product<&chap1a::Complex, VSet, V, m>(T, eigenvalues, m, z)

prop is_characteristic_polynomial_of(VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, q \chap2a::polynomial_space<&chap1a::Complex, chap1a::complex_scalars>):
    exist m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m> st {$chap5d::lists_all_distinct_eigenvalues(&chap1a::Complex, VSet, V, T, m, eigenvalues), $has_characteristic_factor_values(VSet, V, T, m, eigenvalues, q)}
# Definition 8.26. The characteristic polynomial is selected only after the
# multiplicity factorization relation has exact unique existence.
axiom characteristic_polynomial_exists_unique:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            exist! q \chap2a::polynomial_space<&chap1a::Complex, chap1a::complex_scalars> st {$is_characteristic_polynomial_of(VSet, V, T, q)}

template<VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>>:
    # The factorization is canonical, but its parameterized selection remains.
    trust have characteristic_polynomial fn(T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>) \chap2a::polynomial_space<&chap1a::Complex, chap1a::complex_scalars>

axiom characteristic_polynomial_spec:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            $is_characteristic_polynomial_of(VSet, V, T, \characteristic_polynomial<VSet, V>(T))
# Example 8.27. Multiplicities 2 and 1 give (z-6)^2(z-7).
sketch:
    forall z R:
        (z - 6)^2 * (z - 7) = (z^2 - 12 * z + 36) * (z - 7)

prop characteristic_polynomial_degree_and_zeros_statement(VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>):
    \chap2a::degree<&chap1a::Complex, chap1a::complex_scalars, \characteristic_polynomial<VSet, V>(T)> = chap2a::finite_polynomial_degree(\chap2c::dimension<&chap1a::Complex, VSet, V>)
    forall lambda &chap1a::Complex:
        =>:
            $chap4::is_zero_of_polynomial(&chap1a::Complex, chap1a::complex_scalars, \characteristic_polynomial<VSet, V>(T), lambda)
        <=>:
            $chap5a::is_eigenvalue(&chap1a::Complex, VSet, V, T, lambda)
# Result 8.28. Sum the multiplicities for the degree; the defining product
# makes its zeros exactly the listed distinct eigenvalues.
axiom degree_and_zeros_of_characteristic_polynomial:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            $characteristic_polynomial_degree_and_zeros_statement(VSet, V, T)
# Result 8.29. Each generalized eigenspace is killed by its corresponding
# factor; commute that factor to the right and use the direct-sum decomposition.
axiom cayley_hamilton_theorem:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            \chap5a::polynomial_at_operator<&chap1a::Complex, VSet, V>(\characteristic_polynomial<VSet, V>(T), T) = \chap3a::zero_linear_map<&chap1a::Complex, VSet, VSet, V, V>
# Result 8.30. Cayley-Hamilton plus Result 5.29 gives divisibility by the
# minimal polynomial in one mathematical step.
axiom characteristic_polynomial_is_multiple_of_minimal_polynomial:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        \chap2c::dimension<&chap1a::Complex, VSet, V> > 0
        =>:
            $chap5b::is_polynomial_multiple(&chap1a::Complex, chap1a::complex_scalars, \characteristic_polynomial<VSet, V>(T), \chap5b::minimal_polynomial<&chap1a::Complex, VSet, V>(T))
# Result 8.31. Apply rank-nullity to shifted powers to bound multiplicity by
# diagonal occurrences; both totals are dim VSet, so every bound is equality.
axiom multiplicity_equals_number_of_diagonal_occurrences:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, n N_pos, basis &chap1a::FiniteList<VSet, n>, lambda &chap1a::Complex:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        $chap2b::is_basis(&chap1a::Complex, VSet, V, n, basis)
        $chap5c::is_upper_triangular_matrix(&chap1a::Complex, chap1a::complex_scalars, n, \chap5c::matrix_of_operator<&chap1a::Complex, VSet, V, n>(basis, T))
        $chap5a::is_eigenvalue(&chap1a::Complex, VSet, V, T, lambda)
        =>:
            $chap7e::finite_list_value_has_multiplicity(&chap1a::Complex, n, \chap5c::matrix_diagonal<&chap1a::Complex, n>(\chap5c::matrix_of_operator<&chap1a::Complex, VSet, V, n>(basis, T)), lambda, \eigenvalue_multiplicity<&chap1a::Complex, VSet, V>(T, lambda))

prop is_block_partition(n, m N_pos, block_of fn(idx N_pos: idx <= n) N_pos):
    forall idx N_pos:
        idx <= n
        =>:
            block_of(idx) <= m
    forall idx, j N_pos:
        idx <= j
        j <= n
        =>:
            block_of(idx) <= block_of(j)
    forall k N_pos:
        k <= m
        =>:
            exist idx N_pos st {idx <= n, block_of(idx) = k}

prop has_zero_cross_block_entries(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A matrix(s, n, n), block_of fn(idx N_pos: idx <= n) N_pos):
    forall row, column N_pos:
        row <= n
        column <= n
        block_of(row) != block_of(column)
        =>:
            A(row, column) = scalars.zero

prop is_block_diagonal_matrix_with_partition(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n, m N_pos, A matrix(s, n, n), block_of fn(idx N_pos: idx <= n) N_pos):
    $is_block_partition(n, m, block_of)
    $has_zero_cross_block_entries(s, scalars, n, A, block_of)
# Definition 8.35. A matrix is block diagonal when a consecutive partition of
# its indices makes every entry between different blocks zero.
prop is_block_diagonal_matrix(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n, m N_pos, A matrix(s, n, n)):
    exist block_of fn(idx N_pos: idx <= n) N_pos st {$is_block_diagonal_matrix_with_partition(s, scalars, n, m, A, block_of)}
# Example 8.36. The displayed 5-by-5 example has consecutive block sizes
# 1,2,2 and all cross-block entries zero.
sketch:
    have A matrix(R, 5, 5) = [[4, 0, 0, 0, 0], [0, 2, -3, 0, 0], [0, 0, 2, 0, 0], [0, 0, 0, 1, 7], [0, 0, 0, 0, 1]]
    A(1, 2) = A(2, 1) = 0
    A(3, 4) = A(4, 3) = 0
    A(5, 3) = 0

prop block_diagonal_entries_are_eigenvalues(VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, n, m N_pos, basis &chap1a::FiniteList<VSet, n>, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>, block_of fn(idx N_pos: idx <= n) N_pos):
    forall idx N_pos:
        idx <= n
        =>:
            \chap5c::matrix_of_operator<&chap1a::Complex, VSet, V, n>(basis, T)(idx, idx) = eigenvalues.entries(block_of(idx))

prop block_labels_match_partition(n N_pos, block_of fn(idx N_pos: idx <= n) N_pos, labels &chap1a::FiniteList<N_pos, n>):
    forall idx N_pos:
        idx <= n
        =>:
            labels.entries(idx) = block_of(idx)

prop block_sizes_match_eigenvalue_multiplicities(VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, n, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>, labels &chap1a::FiniteList<N_pos, n>):
    forall k N_pos:
        k <= m
        =>:
            $chap7e::finite_list_value_has_multiplicity(N_pos, n, labels, k, \eigenvalue_multiplicity<&chap1a::Complex, VSet, V>(T, eigenvalues.entries(k)))

prop has_generalized_eigenvalue_block_form(VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>):
    exist n N_pos, basis &chap1a::FiniteList<VSet, n>, block_of fn(idx N_pos: idx <= n) N_pos, labels &chap1a::FiniteList<N_pos, n> st {$chap2b::is_basis(&chap1a::Complex, VSet, V, n, basis), $is_block_diagonal_matrix_with_partition(&chap1a::Complex, chap1a::complex_scalars, n, m, \chap5c::matrix_of_operator<&chap1a::Complex, VSet, V, n>(basis, T), block_of), $chap5c::is_upper_triangular_matrix(&chap1a::Complex, chap1a::complex_scalars, n, \chap5c::matrix_of_operator<&chap1a::Complex, VSet, V, n>(basis, T)), $block_diagonal_entries_are_eigenvalues(VSet, V, T, n, m, basis, eigenvalues, block_of), $block_labels_match_partition(n, block_of, labels), $block_sizes_match_eigenvalue_multiplicities(VSet, V, T, n, m, eigenvalues, labels)}
# Result 8.37. Choose a nilpotent upper-triangular basis in each generalized
# eigenspace and concatenate them; adding lambda_k I makes each diagonal block
# upper triangular with constant diagonal lambda_k.
axiom block_diagonal_form_with_upper_triangular_blocks:
    ? forall VSet nonempty_set, V &chap1b::VectorSpace<&chap1a::Complex, VSet>, T \chap3a::linear_map_space<&chap1a::Complex, VSet, VSet, V, V>, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, VSet, V)
        $chap5d::lists_all_distinct_eigenvalues(&chap1a::Complex, VSet, V, T, m, eigenvalues)
        =>:
            $has_generalized_eigenvalue_block_form(VSet, V, T, m, eigenvalues)
# Example 8.38. The generalized-eigenvector basis turns the source matrix into
# a 2-by-2 block for 6 and a 1-by-1 block for 7.
sketch:
    have A matrix(R, 3, 3) = [[6, 3, 0], [0, 6, 0], [0, 0, 7]]
    A(1, 1) = A(2, 2) = 6
    A(3, 3) = 7
    A(1, 3) = A(2, 3) = A(3, 1) = A(3, 2) = 0
