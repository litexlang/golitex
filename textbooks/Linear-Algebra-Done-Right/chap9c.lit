# Linear Algebra Done Right, fourth edition — Section 9C.
# Determinants.


# Definition 9.40. Apply T simultaneously in every slot of alpha.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    have fn alternating_form_transformed_by_operator(alpha \chap9b::alternating_multilinear_form_space<s, scalars, V, Vspace, m>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>) fn(input finite_seq(V, m)) s = fn(arguments finite_seq(V, m)) s {alpha(fn(k N_pos: k <= m) V {T(arguments(k))})}

axiom transformed_alternating_form_is_alternating:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha \chap9b::alternating_multilinear_form_space<s, scalars, V, Vspace, m>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        \alternating_form_transformed_by_operator<s, scalars, V, Vspace, m>(alpha, T) $in \chap9b::alternating_multilinear_form_space<s, scalars, V, Vspace, m>

prop scales_full_alternating_forms(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, n N_pos, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, value s):
    forall alpha \chap9b::alternating_multilinear_form_space<s, scalars, V, Vspace, n>:
        \alternating_form_transformed_by_operator<s, scalars, V, Vspace, n>(alpha, T) = \chap9b::multilinear_form_smul<s, scalars, V, Vspace, n>(value, alpha)

prop is_operator_determinant_value(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, value s):
    exist n N_pos st {\chap2c::dimension<s, scalars, V, Vspace> = n, $scales_full_alternating_forms(s, scalars, V, Vspace, n, T, value)}

# Definition 9.41. One-dimensionality of the full alternating-form space gives
# the unique scalar by which alpha -> alpha_T acts.
axiom operator_determinant_exists_unique:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            exist! value s st {$is_operator_determinant_value(s, scalars, V, Vspace, T, value)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>>:
    trust have operator_determinant fn(T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>) s

axiom operator_determinant_spec:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            $is_operator_determinant_value(s, scalars, V, Vspace, T, \operator_determinant<s, scalars, V, Vspace>(T))

# Example 9.42. Identity and scalar identity expose the normalization and
# degree-n homogeneity expected from the definition.
sketch:
    1^2 = 1
    forall lambda R:
        lambda^2 * 1 = lambda^2

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    trust have coordinate_operator_from_matrix fn(A matrix(s, n, n)) \chap3a::linear_map_space<s, scalars, finite_seq(s, n), finite_seq(s, n), \chap1b::coordinate_space<s, scalars, n>, \chap1b::coordinate_space<s, scalars, n>>:
        forall x finite_seq(s, n):
            coordinate_operator_from_matrix(A)(x) = \chap7d::matrix_vector_product<s, scalars, n>(A, x)

# Definition 9.43. The determinant of a matrix is the determinant of its
# standard-coordinate operator.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn matrix_determinant(A matrix(s, n, n)) s = \operator_determinant<s, scalars, finite_seq(s, n), \chap1b::coordinate_space<s, scalars, n>>(\coordinate_operator_from_matrix<s, scalars, n>(A))

# Example 9.44. The diagonal products are the two displayed determinants.
sketch:
    have I2 matrix(R, 2, 2) = [[1, 0], [0, 1]]
    have D2 matrix(R, 2, 2) = [[3, 0], [0, 5]]
    I2(1, 1) * I2(2, 2) = 1
    D2(1, 1) * D2(2, 2) = 15

template<s nonempty_set, n N_pos>:
    have fn matrix_columns_as_sequence(A matrix(s, n, n)) finite_seq(finite_seq(s, n), n) = fn(k N_pos: k <= n) finite_seq(s, n) {\chap3c::matrix_column<s, n, n>(A, k)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn determinant_on_column_sequence(columns finite_seq(finite_seq(s, n), n)) s = \matrix_determinant<s, scalars, n>(fn(j N_pos, k N_pos: j <= n, k <= n) s {columns(k)(j)})

# Result 9.45. This is the normalized full alternating form on coordinate
# space obtained in the proof of the matrix definition.
axiom determinant_is_alternating_multilinear_in_columns:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos:
        $chap9b::is_alternating_multilinear_form(s, scalars, finite_seq(s, n), \chap1b::coordinate_space<s, scalars, n>, n, \determinant_on_column_sequence<s, scalars, n>)

# Result 9.46. Apply the full-dimensional alternating-form formula to the
# standard basis and the columns of A.
axiom permutation_formula_for_matrix_determinant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A matrix(s, n, n):
        \matrix_determinant<s, scalars, n>(A) = \chap9b::signed_permutation_coordinate_sum<s, scalars, n>(A)

# Example 9.47. The two- and three-dimensional formulas are concrete uses of
# the signed permutation expansion.
sketch:
    forall a11, a12, a21, a22 R:
        a11 * a22 - a21 * a12 $in R
    forall a11, a12, a13, a21, a22, a23, a31, a32, a33 R:
        a11 * a22 * a33 - a21 * a12 * a33 - a31 * a22 * a13 - a11 * a32 * a23 + a31 * a12 * a23 + a21 * a32 * a13 $in R

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn matrix_diagonal_product(A matrix(s, n, n), k closed_range(0, n)) s by induc k from 0:
        case k = 0: scalars.one
        case k > 0: scalars.mul(matrix_diagonal_product(A, k - 1), A(k, k))

# Result 9.48. Every nonidentity permutation selects a below-diagonal zero.
axiom determinant_of_upper_triangular_matrix:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A matrix(s, n, n):
        $chap5c::is_upper_triangular_matrix(s, scalars, n, A)
        =>:
            \matrix_determinant<s, scalars, n>(A) = \matrix_diagonal_product<s, scalars, n>(A, n)

# Result 9.49. Transforming by ST is transforming first by T and then by S.
axiom determinant_is_multiplicative:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, S, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, n N_pos:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> = n
        =>:
            \operator_determinant<s, scalars, V, Vspace>(\chap3a::linear_map_compose<s, scalars, V, V, V, Vspace, Vspace, Vspace>(S, T)) = scalars.mul(\operator_determinant<s, scalars, V, Vspace>(S), \operator_determinant<s, scalars, V, Vspace>(T))

axiom matrix_determinant_is_multiplicative:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A, B matrix(s, n, n):
        \matrix_determinant<s, scalars, n>(\chap3c::matrix_mul<s, scalars, n, n, n>(A, B)) = scalars.mul(\matrix_determinant<s, scalars, n>(A), \matrix_determinant<s, scalars, n>(B))

prop determinant_detects_invertibility_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>):
    forall:
        =>:
            $chap3d::is_invertible_linear_map(s, scalars, V, V, Vspace, Vspace, T)
        <=>:
            \operator_determinant<s, scalars, V, Vspace>(T) != scalars.zero

# Result 9.50. Multiplicativity proves the forward direction and inverse
# formula; a nonzero determinant makes T injective via Result 9.39.
axiom invertible_iff_nonzero_determinant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, n N_pos:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> = n
        =>:
            $determinant_detects_invertibility_statement(s, scalars, V, Vspace, T)

axiom determinant_of_inverse:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap3d::is_invertible_linear_map(s, scalars, V, V, Vspace, Vspace, T)
        =>:
            \operator_determinant<s, scalars, V, Vspace>(\chap3d::inverse_linear_map<s, scalars, V, V, Vspace, Vspace>(T)) = scalars.inv(\operator_determinant<s, scalars, V, Vspace>(T))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>>:
    have fn scalar_identity_minus_operator(lambda s, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>) \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace> = \chap3a::linear_map_add<s, scalars, V, V, Vspace, Vspace>(\chap3a::linear_map_smul<s, scalars, V, V, Vspace, Vspace>(lambda, \chap3a::identity_linear_map<s, scalars, V, Vspace>), \chap3a::linear_map_smul<s, scalars, V, V, Vspace, Vspace>(scalars.neg(scalars.one), T))

prop determinant_eigenvalue_characterization_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, lambda s):
    forall:
        =>:
            $chap5a::is_eigenvalue(s, scalars, V, Vspace, T, lambda)
        <=>:
            \operator_determinant<s, scalars, V, Vspace>(\scalar_identity_minus_operator<s, scalars, V, Vspace>(lambda, T)) = scalars.zero

# Result 9.51. lambda is an eigenvalue exactly when lambda I-T is not
# invertible; Result 9.50 converts this to a zero determinant.
axiom eigenvalues_are_zeros_of_determinant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, lambda s:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            $determinant_eigenvalue_characterization_statement(s, scalars, V, Vspace, T, lambda)

# Result 9.52. Transport an alternating form through S^{-1}; this handles
# similarity between genuinely different vector-space carriers.
axiom determinant_is_similarity_invariant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V, W nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, Wspace &chap1b::VectorSpace<s, scalars, W>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, S \chap3a::linear_map_space<s, scalars, W, V, Wspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        $chap3d::is_invertible_linear_map(s, scalars, W, V, Wspace, Vspace, S)
        =>:
            \operator_determinant<s, scalars, W, Wspace>(\chap3a::linear_map_compose<s, scalars, W, V, W, Wspace, Vspace, Wspace>(\chap3d::inverse_linear_map<s, scalars, W, V, Wspace, Vspace>(S), \chap3a::linear_map_compose<s, scalars, W, V, V, Wspace, Vspace, Vspace>(T, S))) = \operator_determinant<s, scalars, V, Vspace>(T)

# Result 9.53. Coordinate identification is a similarity, so every operator
# matrix has the same determinant as the operator.
axiom operator_determinant_equals_matrix_determinant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, n N_pos, basis &chap1a::FiniteList<V, n>:
        $chap2b::is_basis(s, scalars, V, Vspace, n, basis)
        =>:
            \operator_determinant<s, scalars, V, Vspace>(T) = \matrix_determinant<s, scalars, n>(\chap5c::matrix_of_operator<s, scalars, V, Vspace, n>(basis, T))

template<V nonempty_set, Vspace &chap1b::VectorSpace<&chap1a::Complex, chap1a::complex_scalars, V>, m N_pos>:
    have fn complex_eigenvalue_product_with_multiplicity(T \chap3a::linear_map_space<&chap1a::Complex, chap1a::complex_scalars, V, V, Vspace, Vspace>, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>, k closed_range(0, m)) &chap1a::Complex by induc k from 0:
        case k = 0: &chap1a::ScalarSystem<&chap1a::Complex>{chap1a::complex_scalars}.one
        case k > 0: &chap1a::ScalarSystem<&chap1a::Complex>{chap1a::complex_scalars}.mul(complex_eigenvalue_product_with_multiplicity(T, eigenvalues, k - 1), \chap8b::finite_scalar_power<&chap1a::Complex, chap1a::complex_scalars>(eigenvalues.entries(k), \chap8b::eigenvalue_multiplicity<&chap1a::Complex, chap1a::complex_scalars, V, Vspace>(T, eigenvalues.entries(k))))

# Result 9.55. In an upper-triangular basis the diagonal contains every
# eigenvalue according to its generalized-eigenspace multiplicity.
axiom complex_determinant_equals_eigenvalue_product:
    ? forall V nonempty_set, Vspace &chap1b::VectorSpace<&chap1a::Complex, chap1a::complex_scalars, V>, T \chap3a::linear_map_space<&chap1a::Complex, chap1a::complex_scalars, V, V, Vspace, Vspace>, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, chap1a::complex_scalars, V, Vspace)
        $chap5d::lists_all_distinct_eigenvalues(&chap1a::Complex, chap1a::complex_scalars, V, Vspace, T, m, eigenvalues)
        =>:
            \operator_determinant<&chap1a::Complex, chap1a::complex_scalars, V, Vspace>(T) = \complex_eigenvalue_product_with_multiplicity<V, Vspace, m>(T, eigenvalues, m)

# Result 9.56. Transpose preserves the permutation formula; dual matrices are
# transposes, and adjoint matrices are conjugate transposes.
axiom determinant_of_transpose:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A matrix(s, n, n):
        \matrix_determinant<s, scalars, n>(\chap3c::transpose<s, n, n>(A)) = \matrix_determinant<s, scalars, n>(A)

axiom determinant_of_dual_operator:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            \operator_determinant<s, scalars, \chap3f::dual_space<s, scalars, V, Vspace>, \chap3f::dual_vector_space<s, scalars, V, Vspace>>(\chap3f::dual_map<s, scalars, V, V, Vspace, Vspace>(T)) = \operator_determinant<s, scalars, V, Vspace>(T)

axiom determinant_of_adjoint:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, inner_space.vector_space, inner_space.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, inner_space.vector_space)
        \chap2c::dimension<s, scalars, V, inner_space.vector_space> > 0
        =>:
            \operator_determinant<s, scalars, V, inner_space.vector_space>(\chap7a::adjoint<s, scalars, scalar_geometry, V, V, inner_space, inner_space>(T)) = scalar_geometry.conjugate(\operator_determinant<s, scalars, V, inner_space.vector_space>(T))

prop have_equal_matrix_columns(s set, n N_pos, A matrix(s, n, n), j, k N_pos):
    j <= n
    k <= n
    j != k
    \chap3c::matrix_column<s, n, n>(A, j) = \chap3c::matrix_column<s, n, n>(A, k)

prop have_equal_matrix_rows(s set, n N_pos, A matrix(s, n, n), j, k N_pos):
    j <= n
    k <= n
    j != k
    \chap3c::matrix_row<s, n, n>(A, j) = \chap3c::matrix_row<s, n, n>(A, k)

prop is_matrix_column_swap(s set, n N_pos, A, B matrix(s, n, n), j, k N_pos):
    j <= n
    k <= n
    j != k
    forall r N_pos:
        r <= n
        =>:
            B(r, j) = A(r, k)
            B(r, k) = A(r, j)
    forall r, c N_pos:
        r <= n
        c <= n
        c != j
        c != k
        =>:
            B(r, c) = A(r, c)

prop is_matrix_row_swap(s set, n N_pos, A, B matrix(s, n, n), j, k N_pos):
    $is_matrix_column_swap(s, n, \chap3c::transpose<s, n, n>(A), \chap3c::transpose<s, n, n>(B), j, k)

prop is_matrix_column_scale(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A, B matrix(s, n, n), column N_pos, a s):
    column <= n
    forall r N_pos:
        r <= n
        =>:
            B(r, column) = scalars.mul(a, A(r, column))
    forall r, c N_pos:
        r <= n
        c <= n
        c != column
        =>:
            B(r, c) = A(r, c)

prop is_matrix_row_scale(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A, B matrix(s, n, n), row N_pos, a s):
    $is_matrix_column_scale(s, scalars, n, \chap3c::transpose<s, n, n>(A), \chap3c::transpose<s, n, n>(B), row, a)

prop is_matrix_column_addition(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A, B matrix(s, n, n), target, source N_pos, a s):
    target <= n
    source <= n
    target != source
    forall r N_pos:
        r <= n
        =>:
            B(r, target) = scalars.add(A(r, target), scalars.mul(a, A(r, source)))
    forall r, c N_pos:
        r <= n
        c <= n
        c != target
        =>:
            B(r, c) = A(r, c)

prop is_matrix_row_addition(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, A, B matrix(s, n, n), target, source N_pos, a s):
    $is_matrix_column_addition(s, scalars, n, \chap3c::transpose<s, n, n>(A), \chap3c::transpose<s, n, n>(B), target, source, a)

prop determinant_evaluation_rules_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos):
    forall A matrix(s, n, n), j, k N_pos:
        $have_equal_matrix_columns(s, n, A, j, k) or $have_equal_matrix_rows(s, n, A, j, k)
        =>:
            \matrix_determinant<s, scalars, n>(A) = scalars.zero
    forall A, B matrix(s, n, n), j, k N_pos:
        $is_matrix_column_swap(s, n, A, B, j, k) or $is_matrix_row_swap(s, n, A, B, j, k)
        =>:
            \matrix_determinant<s, scalars, n>(B) = scalars.neg(\matrix_determinant<s, scalars, n>(A))
    forall A, B matrix(s, n, n), index N_pos, a s:
        $is_matrix_column_scale(s, scalars, n, A, B, index, a) or $is_matrix_row_scale(s, scalars, n, A, B, index, a)
        =>:
            \matrix_determinant<s, scalars, n>(B) = scalars.mul(a, \matrix_determinant<s, scalars, n>(A))
    forall A, B matrix(s, n, n), target, source N_pos, a s:
        $is_matrix_column_addition(s, scalars, n, A, B, target, source, a) or $is_matrix_row_addition(s, scalars, n, A, B, target, source, a)
        =>:
            \matrix_determinant<s, scalars, n>(B) = \matrix_determinant<s, scalars, n>(A)

# Result 9.57. These are direct consequences of alternating multilinearity in
# columns, together with transpose invariance for the row versions.
axiom helpful_determinant_evaluation_rules:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos:
        $determinant_evaluation_rules_statement(s, scalars, n)

# Result 9.58. S* S=I, multiplicativity, and the adjoint determinant formula
# give |det S|^2=1.
axiom unitary_operator_has_unit_absolute_determinant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, S \chap3a::linear_map_space<s, scalars, V, V, inner_space.vector_space, inner_space.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, inner_space.vector_space)
        \chap2c::dimension<s, scalars, V, inner_space.vector_space> > 0
        $chap7d::is_unitary_operator(s, scalars, scalar_geometry, V, inner_space, S)
        =>:
            scalar_geometry.absolute_value(\operator_determinant<s, scalars, V, inner_space.vector_space>(S)) = 1

# Result 9.59. A spectral basis makes the determinant a product of
# nonnegative real eigenvalues.
axiom positive_operator_has_nonnegative_determinant:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, inner_space.vector_space, inner_space.vector_space>:
        $chap2a::is_finite_dimensional(s, scalars, V, inner_space.vector_space)
        \chap2c::dimension<s, scalars, V, inner_space.vector_space> > 0
        $chap7c::is_positive_operator(s, scalars, scalar_geometry, V, inner_space, T)
        =>:
            \operator_determinant<s, scalars, V, inner_space.vector_space>(T) = scalar_geometry.real_embed(scalar_geometry.real_part(\operator_determinant<s, scalars, V, inner_space.vector_space>(T)))
            scalar_geometry.real_part(\operator_determinant<s, scalars, V, inner_space.vector_space>(T)) >= 0

# Result 9.60. Apply multiplicativity to T* T, then use its spectral basis.
axiom absolute_determinant_is_product_of_singular_values:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, V nonempty_set, inner_space &chap6a::InnerProductSpace<s, scalars, scalar_geometry, V>, T \chap3a::linear_map_space<s, scalars, V, V, inner_space.vector_space, inner_space.vector_space>, n N_pos, values &chap1a::FiniteList<R, n>:
        $chap2a::is_finite_dimensional(s, scalars, V, inner_space.vector_space)
        \chap2c::dimension<s, scalars, V, inner_space.vector_space> = n
        $chap7e::is_singular_value_list(s, scalars, scalar_geometry, V, V, inner_space, inner_space, T, n, values)
        =>:
            scalar_geometry.absolute_value(\operator_determinant<s, scalars, V, inner_space.vector_space>(T)) = \chap7f::finite_real_product<n>(values, n)

template<n N_pos>:
    trust have real_coordinate_inner_product_space &chap6a::InnerProductSpace<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, finite_seq(R, n)>:
        real_coordinate_inner_product_space.vector_space = \chap1b::coordinate_space<R, chap1a::real_scalars, n>
        forall x, y finite_seq(R, n):
            real_coordinate_inner_product_space.inner(x, y) = \chap7d::coordinate_inner_product<R, chap1a::real_scalars, chap6a::real_inner_product_scalar_geometry, n>(x, y)

# Result 9.61. Combine Result 7.111 with Result 9.60.
axiom determinant_is_volume_scaling_factor:
    ? forall n N_pos, T \chap3a::linear_map_space<R, chap1a::real_scalars, finite_seq(R, n), finite_seq(R, n), \chap1b::coordinate_space<R, chap1a::real_scalars, n>, \chap1b::coordinate_space<R, chap1a::real_scalars, n>>, Omega power_set(finite_seq(R, n)):
        \chap7f::volume<finite_seq(R, n), \real_coordinate_inner_product_space<n>>(\chap7f::image_of_set<finite_seq(R, n), finite_seq(R, n)>(T, Omega)) = abs(\operator_determinant<R, chap1a::real_scalars, finite_seq(R, n), \chap1b::coordinate_space<R, chap1a::real_scalars, n>>(T)) * \chap7f::volume<finite_seq(R, n), \real_coordinate_inner_product_space<n>>(Omega)

# Result 9.62. The 8B eigenvalue-factor definition and det(zI-T) agree.
axiom complex_characteristic_polynomial_is_determinant_polynomial:
    ? forall V nonempty_set, Vspace &chap1b::VectorSpace<&chap1a::Complex, chap1a::complex_scalars, V>, T \chap3a::linear_map_space<&chap1a::Complex, chap1a::complex_scalars, V, V, Vspace, Vspace>, m N_pos, eigenvalues &chap1a::FiniteList<&chap1a::Complex, m>, z &chap1a::Complex:
        $chap2a::is_finite_dimensional(&chap1a::Complex, chap1a::complex_scalars, V, Vspace)
        $chap5d::lists_all_distinct_eigenvalues(&chap1a::Complex, chap1a::complex_scalars, V, Vspace, T, m, eigenvalues)
        =>:
            \operator_determinant<&chap1a::Complex, chap1a::complex_scalars, V, Vspace>(\scalar_identity_minus_operator<&chap1a::Complex, chap1a::complex_scalars, V, Vspace>(z, T)) = \chap8b::characteristic_factor_product<&chap1a::Complex, chap1a::complex_scalars, V, Vspace, m>(T, eigenvalues, m, z)

# Definition 9.63. This relation preserves polynomial typing while fixing all
# values to det(zI-T).
prop is_determinant_characteristic_polynomial(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, q \chap2a::polynomial_space<s, scalars>):
    forall z s:
        q(z) = \operator_determinant<s, scalars, V, Vspace>(\scalar_identity_minus_operator<s, scalars, V, Vspace>(z, T))

axiom determinant_characteristic_polynomial_exists_unique:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            exist! q \chap2a::polynomial_space<s, scalars> st {$is_determinant_characteristic_polynomial(s, scalars, V, Vspace, T, q)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>>:
    trust have determinant_characteristic_polynomial fn(T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>) \chap2a::polynomial_space<s, scalars>

axiom determinant_characteristic_polynomial_spec:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            $is_determinant_characteristic_polynomial(s, scalars, V, Vspace, T, \determinant_characteristic_polynomial<s, scalars, V, Vspace>(T))

axiom complex_characteristic_polynomial_definitions_agree:
    ? forall V nonempty_set, Vspace &chap1b::VectorSpace<&chap1a::Complex, chap1a::complex_scalars, V>, T \chap3a::linear_map_space<&chap1a::Complex, chap1a::complex_scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(&chap1a::Complex, chap1a::complex_scalars, V, Vspace)
        \chap2c::dimension<&chap1a::Complex, chap1a::complex_scalars, V, Vspace> > 0
        =>:
            \determinant_characteristic_polynomial<&chap1a::Complex, chap1a::complex_scalars, V, Vspace>(T) = \chap8b::characteristic_polynomial<V, Vspace>(T)

# Result 9.64. The complex case is Result 8.29; the real case uses the same
# matrix over C and transports the polynomial identity back.
axiom cayley_hamilton_theorem_for_real_and_complex_spaces:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> > 0
        =>:
            \chap5a::polynomial_at_operator<s, scalars, V, Vspace>(\determinant_characteristic_polynomial<s, scalars, V, Vspace>(T), T) = \chap3a::zero_linear_map<s, scalars, V, V, Vspace, Vspace>

# Result 9.65. The identity permutation supplies the two leading terms; z=0
# supplies the signed determinant constant term.
axiom characteristic_polynomial_trace_and_determinant_coefficients:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, T \chap3a::linear_map_space<s, scalars, V, V, Vspace, Vspace>, n N_pos, coefficients &chap1a::FiniteList<s, n + 1>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> = n
        $chap2a::represents_polynomial(s, scalars, n + 1, coefficients, \determinant_characteristic_polynomial<s, scalars, V, Vspace>(T))
        =>:
            coefficients.entries(n + 1) = scalars.one
            coefficients.entries(n) = scalars.neg(\chap8d::operator_trace<s, scalars, V, Vspace>(T))
            coefficients.entries(1) = scalars.mul(\chap8b::finite_scalar_power<s, scalars>(scalars.neg(scalars.one), n), \operator_determinant<s, scalars, V, Vspace>(T))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, n N_pos>:
    have fn matrix_column_norms(A matrix(s, n, n)) &chap1a::FiniteList<R, n> = (n, fn(k N_pos: k <= n) R {\chap7d::coordinate_norm<s, scalars, scalar_geometry, n>(\chap3c::matrix_column<s, n, n>(A, k))})

# Result 9.66. QR factorization reduces the determinant to the diagonal of R;
# every diagonal entry is bounded by its column norm.
axiom hadamard_inequality:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, scalar_geometry &chap6a::InnerProductScalarGeometry<s, scalars>, n N_pos, A matrix(s, n, n):
        scalar_geometry.absolute_value(\matrix_determinant<s, scalars, n>(A)) <= \chap7f::finite_real_product<n>(\matrix_column_norms<s, scalars, scalar_geometry, n>(A), n)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn vandermonde_matrix(beta finite_seq(s, n)) matrix(s, n, n) = fn(j N_pos, k N_pos: j <= n, k <= n) s {\chap8b::finite_scalar_power<s, scalars>(beta(j), k - 1)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn vandermonde_row_factor(beta finite_seq(s, n), k N_pos, j closed_range(0, k - 1): k <= n) s by induc j from 0:
        case j = 0: scalars.one
        case j > 0: scalars.mul(vandermonde_row_factor(beta, k, j - 1), scalars.add(beta(k), scalars.neg(beta(j))))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn vandermonde_difference_product(beta finite_seq(s, n), k closed_range(0, n)) s by induc k from 0:
        case k = 0: scalars.one
        case k > 0: scalars.mul(vandermonde_difference_product(beta, k - 1), \vandermonde_row_factor<s, scalars, n>(beta, k, k - 1))

# Result 9.67. Change the polynomial basis to successive products
# (z-beta_1)...(z-beta_k); the evaluation matrix becomes triangular.
axiom determinant_of_vandermonde_matrix:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos, beta finite_seq(s, n):
        n > 1
        =>:
            \matrix_determinant<s, scalars, n>(\vandermonde_matrix<s, scalars, n>(beta)) = \vandermonde_difference_product<s, scalars, n>(beta, n)
