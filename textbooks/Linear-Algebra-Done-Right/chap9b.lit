# Linear Algebra Done Right, fourth edition — Section 9B.
# Alternating Multilinear Forms.


# Definition 9.24. V^m is represented by the native finite-sequence carrier.
template<V nonempty_set, m N_pos>:
    have vector_power set = finite_seq(V, m)

# Replacing one slot is a relation. This avoids selecting a special sequence
# constructor merely to state separate linearity in that slot.
prop is_slot_replacement(V nonempty_set, m N_pos, original, changed finite_seq(V, m), k N_pos, value V):
    k <= m
    changed(k) = value
    forall j N_pos:
        j <= m
        j != k
        =>:
            changed(j) = original(j)

prop agrees_with_form_in_slot(s nonempty_set, V nonempty_set, m N_pos, alpha fn(values finite_seq(V, m)) s, original finite_seq(V, m), k N_pos, ell fn(v V) s):
    forall value V, changed finite_seq(V, m):
        $is_slot_replacement(V, m, original, changed, k, value)
        =>:
            ell(value) = alpha(changed)

prop is_linear_in_slot(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha fn(values finite_seq(V, m)) s, original finite_seq(V, m), k N_pos):
    k <= m
    exist ell fn(v V) s st {$chap3f::is_linear_functional(s, scalars, V, Vspace, ell), $agrees_with_form_in_slot(s, V, m, alpha, original, k, ell)}

# Definition 9.25. An m-linear form is linear in every slot with all other
# entries fixed; V^(m) is its genuine function carrier.
prop is_multilinear_form(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha fn(values finite_seq(V, m)) s):
    forall original finite_seq(V, m), k N_pos:
        k <= m
        =>:
            $is_linear_in_slot(s, scalars, V, Vspace, m, alpha, original, k)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    have multilinear_form_space power_set(fn(values finite_seq(V, m)) s) = {alpha fn(values finite_seq(V, m)) s: $is_multilinear_form(s, scalars, V, Vspace, m, alpha)}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    have fn zero_multilinear_form(values finite_seq(V, m)) s = scalars.zero

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    have fn multilinear_form_add(alpha, beta fn(values finite_seq(V, m)) s) fn(input finite_seq(V, m)) s = fn(values finite_seq(V, m)) s {scalars.add(alpha(values), beta(values))}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    have fn multilinear_form_smul(a s, alpha fn(values finite_seq(V, m)) s) fn(input finite_seq(V, m)) s = fn(values finite_seq(V, m)) s {scalars.mul(a, alpha(values))}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    trust have multilinear_form_vector_space &chap1b::VectorSpace<s, scalars, \multilinear_form_space<s, scalars, V, Vspace, m>>:
        multilinear_form_vector_space = (\zero_multilinear_form<s, scalars, V, Vspace, m>, \multilinear_form_add<s, scalars, V, Vspace, m>, \multilinear_form_smul<s, scalars, V, Vspace, m>)

# Example 9.26. The product of two displayed bilinear values gives a concrete
# four-variable scalar expression.
sketch:
    forall v1, v2, v3, v4 R:
        (v1 * v2) * (v3 - v4) $in R
    forall a, v1, v2, v3, v4 R:
        ((a * v1) * v2) * (v3 - v4) = a * ((v1 * v2) * (v3 - v4))

# Definition 9.27. Repeated entries characterize alternating forms.
prop is_alternating_multilinear_form(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha fn(values finite_seq(V, m)) s):
    $is_multilinear_form(s, scalars, V, Vspace, m, alpha)
    forall values finite_seq(V, m), j, k N_pos:
        j <= m
        k <= m
        j != k
        values(j) = values(k)
        =>:
            alpha(values) = scalars.zero

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    have alternating_multilinear_form_space power_set(\multilinear_form_space<s, scalars, V, Vspace, m>) = {alpha \multilinear_form_space<s, scalars, V, Vspace, m>: $is_alternating_multilinear_form(s, scalars, V, Vspace, m, alpha)}

axiom alternating_multilinear_forms_form_subspace:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos:
        $chap1c::is_subspace(s, scalars, \multilinear_form_space<s, scalars, V, Vspace, m>, \multilinear_form_vector_space<s, scalars, V, Vspace, m>, \alternating_multilinear_form_space<s, scalars, V, Vspace, m>)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos>:
    trust have alternating_multilinear_form_vector_space &chap1b::VectorSpace<s, scalars, \alternating_multilinear_form_space<s, scalars, V, Vspace, m>>

# Result 9.28. Expand one dependent vector as a combination of earlier ones;
# every resulting term repeats an entry and vanishes.
axiom alternating_form_vanishes_on_linearly_dependent_list:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, m>, vectors &chap1a::FiniteList<V, m>:
        $chap2a::is_linearly_dependent(s, scalars, V, Vspace, m, vectors)
        =>:
            alpha(vectors.entries) = scalars.zero

# Result 9.29. A list longer than dim V is dependent, so Result 9.28 makes
# every value zero.
axiom no_nonzero_alternating_forms_above_dimension:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, m>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        m > \chap2c::dimension<s, scalars, V, Vspace>
        =>:
            alpha = \zero_multilinear_form<s, scalars, V, Vspace, m>

prop is_sequence_entry_swap(V nonempty_set, m N_pos, original, swapped finite_seq(V, m), j, k N_pos):
    j <= m
    k <= m
    j != k
    swapped(j) = original(k)
    swapped(k) = original(j)
    forall r N_pos:
        r <= m
        r != j
        r != k
        =>:
            swapped(r) = original(r)

# Result 9.30. Insert v_j+v_k in both slots, expand the zero value, and cancel
# the two terms that still repeat an entry.
axiom swapping_inputs_negates_alternating_form:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, m>, original, swapped finite_seq(V, m), j, k N_pos:
        $is_sequence_entry_swap(V, m, original, swapped, j, k)
        =>:
            alpha(swapped) = scalars.neg(alpha(original))

# Definition 9.31. A permutation is a bijective rearrangement of 1,...,m.
prop is_permutation(m N_pos, permutation fn(i N_pos: i <= m) closed_range(1, m)):
    forall i, j N_pos:
        i <= m
        j <= m
        permutation(i) = permutation(j)
        =>:
            i = j
    forall j N_pos:
        j <= m
        =>:
            exist i N_pos st {i <= m, permutation(i) = j}

template<m N_pos>:
    trust have permutation_set finite_set:
        permutation_set = {permutation fn(i N_pos: i <= m) closed_range(1, m): $is_permutation(m, permutation)}

prop is_permutation_inversion_pair(m N_pos, permutation \permutation_set<m>, pair cart(N_pos, N_pos)):
    pair[1] <= m
    pair[2] <= m
    pair[1] < pair[2]
    permutation(pair[1]) > permutation(pair[2])

template<m N_pos, permutation \permutation_set<m>>:
    trust have permutation_inversion_pairs finite_set:
        permutation_inversion_pairs = {pair cart(N_pos, N_pos): $is_permutation_inversion_pair(m, permutation, pair)}

# Definition 9.32. The sign is (-1) to the inversion count.
template<m N_pos>:
    have fn permutation_sign(permutation \permutation_set<m>) Z = (-1) ^ finite_set_size(\permutation_inversion_pairs<m, permutation>)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, m N_pos>:
    have fn scalar_permutation_sign(permutation \permutation_set<m>) s = \chap8b::finite_scalar_power<s, scalars>(scalars.neg(scalars.one), finite_set_size(\permutation_inversion_pairs<m, permutation>))

# Example 9.33. These concrete lists display the identity, one transposition,
# and the cyclic shift used in the source.
sketch:
    have identity_permutation finite_seq(N_pos, 4) = [1, 2, 3, 4]
    have transposition finite_seq(N_pos, 4) = [2, 1, 3, 4]
    identity_permutation(1) = 1
    transposition(1) = 2
    transposition(2) = 1
    (-1)^0 = 1
    (-1)^1 = -1

prop is_permutation_entry_swap(m N_pos, first, second \permutation_set<m>, j, k N_pos):
    $is_sequence_entry_swap(closed_range(1, m), m, first, second, j, k)

# Result 9.34. Exactly one swapped pair changes order; every intermediate
# entry changes the inversion count by an even amount.
axiom swapping_permutation_entries_negates_sign:
    ? forall m N_pos, first, second \permutation_set<m>, j, k N_pos:
        $is_permutation_entry_swap(m, first, second, j, k)
        =>:
            \permutation_sign<m>(second) = -1 * \permutation_sign<m>(first)

template<V nonempty_set, m N_pos>:
    have fn permute_vector_sequence(values finite_seq(V, m), permutation \permutation_set<m>) finite_seq(V, m) = fn(k N_pos: k <= m) V {values(permutation(k))}

# Result 9.35. Reduce a permutation to the identity by swaps; each swap changes
# both the form value and the sign.
axiom permutations_act_by_their_sign_on_alternating_forms:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, m N_pos, alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, m>, values finite_seq(V, m), permutation \permutation_set<m>:
        alpha(\permute_vector_sequence<V, m>(values, permutation)) = scalars.mul(\scalar_permutation_sign<s, scalars, m>(permutation), alpha(values))

template<n N>:
    have fn natural_factorial(k closed_range(0, n)) N_pos by induc k from 0:
        case k = 0: 1
        case k > 0: k * natural_factorial(k - 1)

prop is_permutation_enumeration(m N_pos, enumeration &chap1a::FiniteList<\permutation_set<m>, \natural_factorial<m>(m)>):
    forall permutation \permutation_set<m>:
        exist! r N_pos st {r <= \natural_factorial<m>(m), enumeration.entries(r) = permutation}

template<m N_pos>:
    trust have permutation_enumeration &chap1a::FiniteList<\permutation_set<m>, \natural_factorial<m>(m)>

axiom permutation_enumeration_spec:
    ? forall m N_pos:
        $is_permutation_enumeration(m, \permutation_enumeration<m>)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn permutation_coordinate_product(A matrix(s, n, n), permutation \permutation_set<n>, k closed_range(0, n)) s by induc k from 0:
        case k = 0: scalars.one
        case k > 0: scalars.mul(permutation_coordinate_product(A, permutation, k - 1), A(permutation(k), k))

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn signed_permutation_coordinate_terms(A matrix(s, n, n)) finite_seq(s, \natural_factorial<n>(n)) = fn(r N_pos: r <= \natural_factorial<n>(n)) s {scalars.mul(\scalar_permutation_sign<s, scalars, n>(&chap1a::FiniteList<\permutation_set<n>, \natural_factorial<n>(n)>{\permutation_enumeration<n>}.entries(r)), \permutation_coordinate_product<s, scalars, n>(A, &chap1a::FiniteList<\permutation_set<n>, \natural_factorial<n>(n)>{\permutation_enumeration<n>}.entries(r), n))}

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N_pos>:
    have fn signed_permutation_coordinate_sum(A matrix(s, n, n)) s = \chap3b::scalar_finite_sum<s, scalars, \natural_factorial<n>(n)>(\signed_permutation_coordinate_terms<s, scalars, n>(A))

prop is_coordinate_matrix_for_vector_list(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, n N_pos, basis &chap1a::FiniteList<V, n>, vectors finite_seq(V, n), A matrix(s, n, n)):
    forall k N_pos:
        k <= n
        =>:
            $chap1c::is_finite_vector_sum(s, scalars, V, Vspace, n, fn(j N_pos: j <= n) V {Vspace.smul(A(j, k), basis.entries(j))}, vectors(k))

# Result 9.36. Expand each vector in the basis. Terms with repeated basis
# indices vanish; the remaining permutation terms differ only by their sign.
axiom full_dimension_alternating_form_formula:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, n N_pos, basis &chap1a::FiniteList<V, n>, vectors finite_seq(V, n), A matrix(s, n, n), alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, n>:
        $chap2b::is_basis(s, scalars, V, Vspace, n, basis)
        $is_coordinate_matrix_for_vector_list(s, scalars, V, Vspace, n, basis, vectors, A)
        =>:
            alpha(vectors) = scalars.mul(alpha(basis.entries), \signed_permutation_coordinate_sum<s, scalars, n>(A))

# Result 9.37. Formula 9.36 makes every nonzero alternating n-form span the
# space; the signed coordinate construction supplies such a form.
axiom full_dimension_alternating_form_space_has_dimension_one:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, n N_pos:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> = n
        =>:
            \chap2c::dimension<s, scalars, \alternating_multilinear_form_space<s, scalars, V, Vspace, n>, \alternating_multilinear_form_vector_space<s, scalars, V, Vspace, n>> = 1

prop full_alternating_value_detects_independence_statement(s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, n N_pos, alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, n>, vectors &chap1a::FiniteList<V, n>):
    forall:
        =>:
            alpha(vectors.entries) != scalars.zero
        <=>:
            $chap2a::is_linearly_independent(s, scalars, V, Vspace, n, vectors)

# Result 9.39. Dependence gives zero by 9.28; independence makes the list a
# basis, so 9.36 transfers a nonzero value to it.
axiom nonzero_full_alternating_form_detects_linear_independence:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, V nonempty_set, Vspace &chap1b::VectorSpace<s, scalars, V>, n N_pos, alpha \alternating_multilinear_form_space<s, scalars, V, Vspace, n>, vectors &chap1a::FiniteList<V, n>:
        $chap2a::is_finite_dimensional(s, scalars, V, Vspace)
        \chap2c::dimension<s, scalars, V, Vspace> = n
        alpha != \zero_multilinear_form<s, scalars, V, Vspace, n>
        =>:
            $full_alternating_value_detects_independence_statement(s, scalars, V, Vspace, n, alpha, vectors)
