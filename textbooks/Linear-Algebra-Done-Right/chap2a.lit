# Linear Algebra Done Right, fourth edition, Section 2A:
# Span and Linear Independence.
# Notation 2.1. A source list v_1,...,v_m is represented by an object of
# &chap1a::FiniteList<v,m>. Its explicit length parameter preserves order,
# repetition, and the empty-list case without treating the list as a set.
# Definition 2.2. The value of a linear combination is the finite partial sum
# a_1 v_1 + ... + a_n v_n. This relation gives the recursive specification;
# linear_combination_value below is the callable value selected from it.
prop is_linear_combination_partial_sum_sequence(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, partial_sums fn(k closed_range(0, n)) v):
    partial_sums(0) = space.zero
    forall k N+:
        k <= n
        =>:
            partial_sums(k) = space.add(partial_sums(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))

prop has_linear_combination_value(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, value v):
    exist partial_sums fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, partial_sums), value = partial_sums(n)}

thm linear_combination_value_exists:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        exist value v st {$has_linear_combination_value(s, v, space, n, coefficients, vectors, value)}
    have fn partial_sums(k closed_range(0, n)) v by induc k from 0:
        case k = 0: space.zero
        case k > 0: space.add(partial_sums(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
    claim:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, partial_sums)
        partial_sums(0) = space.zero
        claim:
            ? forall k N+:
                k <= n
                =>:
                    partial_sums(k) = space.add(partial_sums(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
            partial_sums(k) = space.add(partial_sums(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
        by def:
            ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, partial_sums)
    witness exist value v st {$has_linear_combination_value(s, v, space, n, coefficients, vectors, value)} from partial_sums(n):
        witness exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace), partial_sums(n) = trace(n)} from partial_sums
        by def:
            ? $has_linear_combination_value(s, v, space, n, coefficients, vectors, partial_sums(n))
thm linear_combination_value_exists_unique:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        exist! value v st {$has_linear_combination_value(s, v, space, n, coefficients, vectors, value)}
    by thm linear_combination_value_exists(s, v, space, n, coefficients, vectors)
    obtain value1 from exist value v st {$has_linear_combination_value(s, v, space, n, coefficients, vectors, value)}
    claim:
        ? forall x1, x2 v:
            $has_linear_combination_value(s, v, space, n, coefficients, vectors, x1)
            $has_linear_combination_value(s, v, space, n, coefficients, vectors, x2)
            =>:
                x1 = x2
        obtain trace1 from exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace), x1 = trace(n)}
        obtain trace2 from exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace), x2 = trace(n)}
        by def:
            ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace1)
        by def:
            ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace2)
        have fn extended_trace1(k N) v by cases:
            case k <= n: trace1(k)
            case k > n: space.zero
        have fn extended_trace2(k N) v by cases:
            case k <= n: trace2(k)
            case k > n: space.zero
        claim:
            ? forall k N:
                extended_trace1(k) = extended_trace2(k)
            by induc k from 0:
                ? extended_trace1(k) = extended_trace2(k)
                ? from k = 0:
                    0 <= n
                    extended_trace1(0) = trace1(0) = space.zero
                    extended_trace2(0) = trace2(0) = space.zero
                    extended_trace1(0) = extended_trace2(0)
                ? induc:
                    extended_trace1(k) = extended_trace2(k)
                    k + 1 <= n or k + 1 > n
                    by cases:
                        ? extended_trace1(k + 1) = extended_trace2(k + 1)
                        case k + 1 <= n:
                            k <= k + 1 <= n
                            extended_trace1(k) = trace1(k)
                            extended_trace2(k) = trace2(k)
                            trace1(k) = trace2(k)
                            have next_index N+ = k + 1
                            next_index - 1 = k
                            trace1(next_index) = space.add(trace1(next_index - 1), space.smul(coefficients.entries(next_index), vectors.entries(next_index)))
                            trace2(next_index) = space.add(trace2(next_index - 1), space.smul(coefficients.entries(next_index), vectors.entries(next_index)))
                            trace1(next_index - 1) = trace1(k) = trace2(k) = trace2(next_index - 1)
                            space.add(trace1(next_index - 1), space.smul(coefficients.entries(next_index), vectors.entries(next_index))) = space.add(trace2(next_index - 1), space.smul(coefficients.entries(next_index), vectors.entries(next_index)))
                            trace1(next_index) = trace2(next_index)
                            extended_trace1(k + 1) = trace1(k + 1) = trace1(next_index) = trace2(next_index) = trace2(k + 1) = extended_trace2(k + 1)
                        case k + 1 > n:
                            extended_trace1(k + 1) = space.zero
                            extended_trace2(k + 1) = space.zero
                            extended_trace1(k + 1) = extended_trace2(k + 1)
        extended_trace1(n) = extended_trace2(n)
        extended_trace1(n) = trace1(n)
        extended_trace2(n) = trace2(n)
        trace1(n) = trace2(n)
        x1 = trace1(n) = trace2(n) = x2
    witness exist! value v st {$has_linear_combination_value(s, v, space, n, coefficients, vectors, value)} from value1

template<s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N>:
    have fn linear_combination_value by exist!:
        ? forall coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
            exist! value v st {$has_linear_combination_value(s, v, space, n, coefficients, vectors, value)}
        by thm linear_combination_value_exists_unique(s, v, space, n, coefficients, vectors)
thm linear_combination_value_satisfies_spec:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        $has_linear_combination_value(s, v, space, n, coefficients, vectors, \linear_combination_value<s, v, space, n>(coefficients, vectors))
    $has_linear_combination_value(s, v, space, n, coefficients, vectors, \linear_combination_value<s, v, space, n>(coefficients, vectors))
# Coordinate-list operations used to replay finite-sum algebra without
# replacing an ordered coefficient list by an unordered set.
template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N>:
    have zero_coefficient_list &chap1a::FiniteList<s, n> = (n, fn(idx N+: idx <= n) s {scalars.zero})

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N>:
    have fn coefficient_list_add(left, right &chap1a::FiniteList<s, n>) &chap1a::FiniteList<s, n> = (n, fn(idx N+: idx <= n) s {scalars.add(left.entries(idx), right.entries(idx))})

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N>:
    have fn coefficient_list_neg(coefficients &chap1a::FiniteList<s, n>) &chap1a::FiniteList<s, n> = (n, fn(idx N+: idx <= n) s {scalars.neg(coefficients.entries(idx))})

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N>:
    have fn coefficient_list_smul(a s, coefficients &chap1a::FiniteList<s, n>) &chap1a::FiniteList<s, n> = (n, fn(idx N+: idx <= n) s {scalars.mul(a, coefficients.entries(idx))})

thm zero_coefficient_list_entry:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, result &chap1a::FiniteList<s, n>, idx N+:
        result = \zero_coefficient_list<s, scalars, n>
        idx <= n
        =>:
            result.entries(idx) = scalars.zero
    result.entries(idx) = scalars.zero

thm coefficient_list_add_entry:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, left, right, result &chap1a::FiniteList<s, n>, idx N+:
        result = \coefficient_list_add<s, scalars, n>(left, right)
        idx <= n
        =>:
            result.entries(idx) = scalars.add(left.entries(idx), right.entries(idx))
    result.entries(idx) = scalars.add(left.entries(idx), right.entries(idx))

thm coefficient_list_neg_entry:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, coefficients, result &chap1a::FiniteList<s, n>, idx N+:
        result = \coefficient_list_neg<s, scalars, n>(coefficients)
        idx <= n
        =>:
            result.entries(idx) = scalars.neg(coefficients.entries(idx))
    result.entries(idx) = scalars.neg(coefficients.entries(idx))

thm coefficient_list_smul_entry:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, a s, coefficients, result &chap1a::FiniteList<s, n>, idx N+:
        result = \coefficient_list_smul<s, scalars, n>(a, coefficients)
        idx <= n
        =>:
            result.entries(idx) = scalars.mul(a, coefficients.entries(idx))
    result.entries(idx) = scalars.mul(a, coefficients.entries(idx))

thm zero_coefficient_contribution:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, k N+:
        coefficients = \zero_coefficient_list<s, space.scalars, n>
        k <= n
        =>:
            space.smul(coefficients.entries(k), vectors.entries(k)) = space.zero
    by thm zero_coefficient_list_entry(s, space.scalars, n, coefficients, k)
    coefficients.entries(k) = space.scalars.zero
    by thm chap1b::zero_scalar_times_vector(s, v, space, vectors.entries(k))
    space.smul(coefficients.entries(k), vectors.entries(k)) = space.zero

thm zero_coefficients_trace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $is_linear_combination_partial_sum_sequence(s, v, space, n, \zero_coefficient_list<s, space.scalars, n>, vectors, fn(k closed_range(0, n)) v {space.zero})
    have coefficients &chap1a::FiniteList<s, n> = \zero_coefficient_list<s, space.scalars, n>
    have fn zero_trace(k closed_range(0, n)) v = space.zero
    zero_trace(0) = space.zero
    claim:
        ? forall k N+:
            k <= n
            =>:
                zero_trace(k) = space.add(zero_trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
        by thm zero_coefficient_contribution(s, v, space, n, vectors, coefficients, k)
        space.smul(coefficients.entries(k), vectors.entries(k)) = space.zero
        trust zero_trace(k - 1) = space.zero
        space.add(space.zero, space.zero) = space.zero
        trust zero_trace(k) = space.add(zero_trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, zero_trace)
    $is_linear_combination_partial_sum_sequence(s, v, space, n, \zero_coefficient_list<s, space.scalars, n>, vectors, fn(k closed_range(0, n)) v {space.zero})

thm zero_coefficients_trace_exists:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, \zero_coefficient_list<s, space.scalars, n>, vectors, trace), space.zero = trace(n)}
    by thm zero_coefficients_trace(s, v, space, n, vectors)
    space.zero = (fn(k closed_range(0, n)) v {space.zero})(n)
    witness exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, \zero_coefficient_list<s, space.scalars, n>, vectors, trace), space.zero = trace(n)} from fn(k closed_range(0, n)) v {space.zero}

thm zero_coefficients_has_zero_value:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $has_linear_combination_value(s, v, space, n, \zero_coefficient_list<s, space.scalars, n>, vectors, space.zero)
    by thm zero_coefficients_trace_exists(s, v, space, n, vectors)
    by def:
        ? $has_linear_combination_value(s, v, space, n, \zero_coefficient_list<s, space.scalars, n>, vectors, space.zero)

thm linear_combination_value_zero_coefficients:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        \linear_combination_value<s, v, space, n>(\zero_coefficient_list<s, space.scalars, n>, vectors) = space.zero
    have coefficients &chap1a::FiniteList<s, n> = \zero_coefficient_list<s, space.scalars, n>
    by thm linear_combination_value_exists_unique(s, v, space, n, coefficients, vectors)
    by thm linear_combination_value_satisfies_spec(s, v, space, n, coefficients, vectors)
    by thm zero_coefficients_has_zero_value(s, v, space, n, vectors)
    $has_linear_combination_value(s, v, space, n, coefficients, vectors, space.zero)
    \linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
    \linear_combination_value<s, v, space, n>(\zero_coefficient_list<s, space.scalars, n>, vectors) = space.zero

thm add_coefficient_contribution:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, left, right, result &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, k N+:
        result = \coefficient_list_add<s, space.scalars, n>(left, right)
        k <= n
        =>:
            space.smul(result.entries(k), vectors.entries(k)) = space.add(space.smul(left.entries(k), vectors.entries(k)), space.smul(right.entries(k), vectors.entries(k)))
    by thm coefficient_list_add_entry(s, space.scalars, n, left, right, result, k)
    result.entries(k) = space.scalars.add(left.entries(k), right.entries(k))
    space.smul(space.scalars.add(left.entries(k), right.entries(k)), vectors.entries(k)) = space.add(space.smul(left.entries(k), vectors.entries(k)), space.smul(right.entries(k), vectors.entries(k)))
    space.smul(result.entries(k), vectors.entries(k)) = space.smul(space.scalars.add(left.entries(k), right.entries(k)), vectors.entries(k)) = space.add(space.smul(left.entries(k), vectors.entries(k)), space.smul(right.entries(k), vectors.entries(k)))

thm add_coefficients_trace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, left, right, result &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, trace1, trace2 fn(k closed_range(0, n)) v:
        result = \coefficient_list_add<s, space.scalars, n>(left, right)
        $is_linear_combination_partial_sum_sequence(s, v, space, n, left, vectors, trace1)
        $is_linear_combination_partial_sum_sequence(s, v, space, n, right, vectors, trace2)
        =>:
            $is_linear_combination_partial_sum_sequence(s, v, space, n, result, vectors, fn(k closed_range(0, n)) v {space.add(trace1(k), trace2(k))})
    have fn trace_sum(k closed_range(0, n)) v = space.add(trace1(k), trace2(k))
    trace1(0) = space.zero
    trace2(0) = space.zero
    trace_sum(0) = space.add(space.zero, space.zero) = space.zero
    claim:
        ? forall k N+:
            k <= n
            =>:
                trace_sum(k) = space.add(trace_sum(k - 1), space.smul(result.entries(k), vectors.entries(k)))
        trace1(k) = space.add(trace1(k - 1), space.smul(left.entries(k), vectors.entries(k)))
        trace2(k) = space.add(trace2(k - 1), space.smul(right.entries(k), vectors.entries(k)))
        trace_sum(k) = space.add(space.add(trace1(k - 1), space.smul(left.entries(k), vectors.entries(k))), space.add(trace2(k - 1), space.smul(right.entries(k), vectors.entries(k))))
        by thm chap1c::vector_add_regroup_for_direct_sum(s, v, space, trace1(k - 1), space.smul(left.entries(k), vectors.entries(k)), trace2(k - 1), space.smul(right.entries(k), vectors.entries(k)))
        trace_sum(k) = space.add(space.add(trace1(k - 1), trace2(k - 1)), space.add(space.smul(left.entries(k), vectors.entries(k)), space.smul(right.entries(k), vectors.entries(k))))
        by thm add_coefficient_contribution(s, v, space, n, left, right, result, vectors, k)
        space.smul(result.entries(k), vectors.entries(k)) = space.add(space.smul(left.entries(k), vectors.entries(k)), space.smul(right.entries(k), vectors.entries(k)))
        trust trace_sum(k - 1) = space.add(trace1(k - 1), trace2(k - 1))
        trust trace_sum(k) = space.add(trace_sum(k - 1), space.smul(result.entries(k), vectors.entries(k)))
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, result, vectors, trace_sum)
    $is_linear_combination_partial_sum_sequence(s, v, space, n, result, vectors, fn(k closed_range(0, n)) v {space.add(trace1(k), trace2(k))})

thm add_coefficients_trace_exists:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, left, right &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, \coefficient_list_add<s, space.scalars, n>(left, right), vectors, trace), space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors)) = trace(n)}
    by thm linear_combination_value_satisfies_spec(s, v, space, n, left, vectors)
    by def:
        ? $has_linear_combination_value(s, v, space, n, left, vectors, \linear_combination_value<s, v, space, n>(left, vectors))
    obtain trace1 from exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, left, vectors, trace), \linear_combination_value<s, v, space, n>(left, vectors) = trace(n)}
    by thm linear_combination_value_satisfies_spec(s, v, space, n, right, vectors)
    by def:
        ? $has_linear_combination_value(s, v, space, n, right, vectors, \linear_combination_value<s, v, space, n>(right, vectors))
    obtain trace2 from exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, right, vectors, trace), \linear_combination_value<s, v, space, n>(right, vectors) = trace(n)}
    by thm add_coefficients_trace(s, v, space, n, left, right, \coefficient_list_add<s, space.scalars, n>(left, right), vectors, trace1, trace2)
    space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors)) = space.add(trace1(n), trace2(n)) = (fn(k closed_range(0, n)) v {space.add(trace1(k), trace2(k))})(n)
    witness exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, \coefficient_list_add<s, space.scalars, n>(left, right), vectors, trace), space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors)) = trace(n)} from fn(k closed_range(0, n)) v {space.add(trace1(k), trace2(k))}

thm linear_combination_value_add_coefficients:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, left, right &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        \linear_combination_value<s, v, space, n>(\coefficient_list_add<s, space.scalars, n>(left, right), vectors) = space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors))
    by thm add_coefficients_trace_exists(s, v, space, n, left, right, vectors)
    by def:
        ? $has_linear_combination_value(s, v, space, n, \coefficient_list_add<s, space.scalars, n>(left, right), vectors, space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors)))
    by thm linear_combination_value_exists_unique(s, v, space, n, \coefficient_list_add<s, space.scalars, n>(left, right), vectors)
    by thm linear_combination_value_satisfies_spec(s, v, space, n, \coefficient_list_add<s, space.scalars, n>(left, right), vectors)
    \linear_combination_value<s, v, space, n>(\coefficient_list_add<s, space.scalars, n>(left, right), vectors) = space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors))

thm smul_coefficient_contribution:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, a s, coefficients, result &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, k N+:
        result = \coefficient_list_smul<s, space.scalars, n>(a, coefficients)
        k <= n
        =>:
            space.smul(result.entries(k), vectors.entries(k)) = space.smul(a, space.smul(coefficients.entries(k), vectors.entries(k)))
    by thm coefficient_list_smul_entry(s, space.scalars, n, a, coefficients, result, k)
    result.entries(k) = space.scalars.mul(a, coefficients.entries(k))
    space.smul(space.scalars.mul(a, coefficients.entries(k)), vectors.entries(k)) = space.smul(a, space.smul(coefficients.entries(k), vectors.entries(k)))
    space.smul(result.entries(k), vectors.entries(k)) = space.smul(space.scalars.mul(a, coefficients.entries(k)), vectors.entries(k)) = space.smul(a, space.smul(coefficients.entries(k), vectors.entries(k)))

thm smul_trace_step:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, a s, coefficients, result &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, trace fn(j closed_range(0, n)) v, k N+:
        result = \coefficient_list_smul<s, space.scalars, n>(a, coefficients)
        k <= n
        trace(k) = space.add(trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
        =>:
            space.smul(a, trace(k)) = space.add(space.smul(a, trace(k - 1)), space.smul(result.entries(k), vectors.entries(k)))
    by thm chap1c::scalar_partial_trace_step(s, v, space, a, trace(k), trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
    space.smul(a, trace(k)) = space.add(space.smul(a, trace(k - 1)), space.smul(a, space.smul(coefficients.entries(k), vectors.entries(k))))
    by thm smul_coefficient_contribution(s, v, space, n, a, coefficients, result, vectors, k)
    space.smul(result.entries(k), vectors.entries(k)) = space.smul(a, space.smul(coefficients.entries(k), vectors.entries(k)))
    space.smul(a, trace(k)) = space.add(space.smul(a, trace(k - 1)), space.smul(result.entries(k), vectors.entries(k)))

thm smul_coefficients_trace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, a s, coefficients, result &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, trace fn(k closed_range(0, n)) v:
        result = \coefficient_list_smul<s, space.scalars, n>(a, coefficients)
        $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
        =>:
            $is_linear_combination_partial_sum_sequence(s, v, space, n, result, vectors, fn(k closed_range(0, n)) v {space.smul(a, trace(k))})
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
    trace(0) = space.zero
    by thm chap1b::scalar_times_zero_vector(s, v, space, a)
    (fn(j closed_range(0, n)) v {space.smul(a, trace(j))})(0) = space.smul(a, trace(0)) = space.smul(a, space.zero) = space.zero
    claim:
        ? forall k N+:
            k <= n
            =>:
                (fn(j closed_range(0, n)) v {space.smul(a, trace(j))})(k) = space.add((fn(j closed_range(0, n)) v {space.smul(a, trace(j))})(k - 1), space.smul(result.entries(k), vectors.entries(k)))
        trace(k) = space.add(trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
        by thm smul_trace_step(s, v, space, n, a, coefficients, result, vectors, trace, k)
        (fn(j closed_range(0, n)) v {space.smul(a, trace(j))})(k) = space.add((fn(j closed_range(0, n)) v {space.smul(a, trace(j))})(k - 1), space.smul(result.entries(k), vectors.entries(k)))
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, result, vectors, fn(k closed_range(0, n)) v {space.smul(a, trace(k))})

thm smul_coefficients_trace_exists:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, a s, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, \coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors, trace), space.smul(a, \linear_combination_value<s, v, space, n>(coefficients, vectors)) = trace(n)}
    by thm linear_combination_value_satisfies_spec(s, v, space, n, coefficients, vectors)
    by def:
        ? $has_linear_combination_value(s, v, space, n, coefficients, vectors, \linear_combination_value<s, v, space, n>(coefficients, vectors))
    obtain source_trace from exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace), \linear_combination_value<s, v, space, n>(coefficients, vectors) = trace(n)}
    by thm smul_coefficients_trace(s, v, space, n, a, coefficients, \coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors, source_trace)
    space.smul(a, \linear_combination_value<s, v, space, n>(coefficients, vectors)) = space.smul(a, source_trace(n)) = (fn(k closed_range(0, n)) v {space.smul(a, source_trace(k))})(n)
    witness exist trace fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, \coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors, trace), space.smul(a, \linear_combination_value<s, v, space, n>(coefficients, vectors)) = trace(n)} from fn(k closed_range(0, n)) v {space.smul(a, source_trace(k))}

thm linear_combination_value_smul_coefficients:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, a s, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        \linear_combination_value<s, v, space, n>(\coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors) = space.smul(a, \linear_combination_value<s, v, space, n>(coefficients, vectors))
    by thm smul_coefficients_trace_exists(s, v, space, n, a, coefficients, vectors)
    by def:
        ? $has_linear_combination_value(s, v, space, n, \coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors, space.smul(a, \linear_combination_value<s, v, space, n>(coefficients, vectors)))
    by thm linear_combination_value_exists_unique(s, v, space, n, \coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors)
    by thm linear_combination_value_satisfies_spec(s, v, space, n, \coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors)
    \linear_combination_value<s, v, space, n>(\coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors) = space.smul(a, \linear_combination_value<s, v, space, n>(coefficients, vectors))

thm coefficient_add_neg_is_zero:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, coefficients &chap1a::FiniteList<s, n>:
        \coefficient_list_add<s, scalars, n>(coefficients, \coefficient_list_neg<s, scalars, n>(coefficients)) = \zero_coefficient_list<s, scalars, n>
    have negated &chap1a::FiniteList<s, n> = \coefficient_list_neg<s, scalars, n>(coefficients)
    have summed &chap1a::FiniteList<s, n> = \coefficient_list_add<s, scalars, n>(coefficients, negated)
    have zero &chap1a::FiniteList<s, n> = \zero_coefficient_list<s, scalars, n>
    claim:
        ? forall idx N+:
            idx <= n
            =>:
                summed.entries(idx) = zero.entries(idx)
        by thm coefficient_list_add_entry(s, scalars, n, coefficients, negated, summed, idx)
        by thm coefficient_list_neg_entry(s, scalars, n, coefficients, negated, idx)
        by thm zero_coefficient_list_entry(s, scalars, n, zero, idx)
        scalars.add(coefficients.entries(idx), scalars.neg(coefficients.entries(idx))) = scalars.zero
        summed.entries(idx) = scalars.add(coefficients.entries(idx), negated.entries(idx)) = scalars.add(coefficients.entries(idx), scalars.neg(coefficients.entries(idx))) = scalars.zero = zero.entries(idx)
    by def:
        ? $chap1a::have_same_finite_list_entries(s, n, summed, zero)
    by thm chap1a::finite_list_extensionality(s, n, summed, zero)
    summed = zero
    \coefficient_list_add<s, scalars, n>(coefficients, \coefficient_list_neg<s, scalars, n>(coefficients)) = \zero_coefficient_list<s, scalars, n>

thm linear_combination_value_neg_coefficients:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>:
        \linear_combination_value<s, v, space, n>(\coefficient_list_neg<s, space.scalars, n>(coefficients), vectors) = \chap1b::vector_neg<s, v, space>(\linear_combination_value<s, v, space, n>(coefficients, vectors))
    have negated &chap1a::FiniteList<s, n> = \coefficient_list_neg<s, space.scalars, n>(coefficients)
    by thm coefficient_add_neg_is_zero(s, space.scalars, n, coefficients)
    \coefficient_list_add<s, space.scalars, n>(coefficients, negated) = \zero_coefficient_list<s, space.scalars, n>
    by thm linear_combination_value_add_coefficients(s, v, space, n, coefficients, negated, vectors)
    by thm linear_combination_value_zero_coefficients(s, v, space, n, vectors)
    \linear_combination_value<s, v, space, n>(\coefficient_list_add<s, space.scalars, n>(coefficients, negated), vectors) = \linear_combination_value<s, v, space, n>(\zero_coefficient_list<s, space.scalars, n>, vectors) = space.zero
    space.add(\linear_combination_value<s, v, space, n>(coefficients, vectors), \linear_combination_value<s, v, space, n>(negated, vectors)) = space.zero
    by thm chap1b::vector_neg_spec(s, v, space, \linear_combination_value<s, v, space, n>(coefficients, vectors))
    space.add(\linear_combination_value<s, v, space, n>(coefficients, vectors), \chap1b::vector_neg<s, v, space>(\linear_combination_value<s, v, space, n>(coefficients, vectors))) = space.zero
    by thm chap1b::add_left_cancel(s, v, space, \linear_combination_value<s, v, space, n>(coefficients, vectors), \linear_combination_value<s, v, space, n>(negated, vectors), \chap1b::vector_neg<s, v, space>(\linear_combination_value<s, v, space, n>(coefficients, vectors)))
    \linear_combination_value<s, v, space, n>(negated, vectors) = \chap1b::vector_neg<s, v, space>(\linear_combination_value<s, v, space, n>(coefficients, vectors))
    \linear_combination_value<s, v, space, n>(\coefficient_list_neg<s, space.scalars, n>(coefficients), vectors) = \chap1b::vector_neg<s, v, space>(\linear_combination_value<s, v, space, n>(coefficients, vectors))

prop is_linear_combination(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, value v, vectors &chap1a::FiniteList<v, n>):
    exist coefficients &chap1a::FiniteList<s, n> st {value = \linear_combination_value<s, v, space, n>(coefficients, vectors)}
# Example 2.3. In R^3, coefficients 6 and 5 produce (17,-4,2) from the two
# displayed vectors. The nearby nonexample would require an inconsistent
# three-equation system, so both calculations remain an explicit source sketch.
# Definition 2.4. span is a real set-valued template: instantiating it at a
# vector list returns the subset of all values represented by that list.
template<s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>>:
    have span power_set(v) = {value v: $is_linear_combination(s, v, space, n, value, vectors)}

template<s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>>:
    have span_carrier power_set(v) = \span<s, v, space, n, vectors>

thm span_carrier_spec:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        \span_carrier<s, v, space, n, vectors> = \span<s, v, space, n, vectors>
    \span_carrier<s, v, space, n, vectors> = \span<s, v, space, n, vectors>
# Example 2.5. The two conclusions of Example 2.3 become membership and
# nonmembership statements in the corresponding span instance.
# Result 2.6. The span of a list is the smallest subspace containing every
# entry. The source proves closure by finite-sum algebra and proves minimality
# by observing that every containing subspace contains all finite sums.
# Proof debt: the missing bridge is induction over the partial-sum relation.
prop contains_list_entries(v nonempty_set, n N, vectors &chap1a::FiniteList<v, n>, U power_set(v)):
    forall idx N+:
        idx <= n
        =>:
            vectors.entries(idx) $in U

thm span_zero_member:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        space.zero $in \span<s, v, space, n, vectors>
    by thm linear_combination_value_zero_coefficients(s, v, space, n, vectors)
    space.zero = \linear_combination_value<s, v, space, n>(\zero_coefficient_list<s, space.scalars, n>, vectors)
    witness exist coefficients &chap1a::FiniteList<s, n> st {space.zero = \linear_combination_value<s, v, space, n>(coefficients, vectors)} from \zero_coefficient_list<s, space.scalars, n>
    by def:
        ? $is_linear_combination(s, v, space, n, space.zero, vectors)
    # The witness is checked above; the updated runtime does not fold direct
    # membership in this instantiated set-builder.
    space.zero $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    \span<s, v, space, n, vectors> = {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    space.zero $in \span<s, v, space, n, vectors>

thm span_add_closed:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, x, y \span<s, v, space, n, vectors>:
        space.add(x, y) $in \span<s, v, space, n, vectors>
    \span<s, v, space, n, vectors> = {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    x $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    y $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    $is_linear_combination(s, v, space, n, x, vectors)
    $is_linear_combination(s, v, space, n, y, vectors)
    obtain left from exist coefficients &chap1a::FiniteList<s, n> st {x = \linear_combination_value<s, v, space, n>(coefficients, vectors)}
    obtain right from exist coefficients &chap1a::FiniteList<s, n> st {y = \linear_combination_value<s, v, space, n>(coefficients, vectors)}
    by thm linear_combination_value_add_coefficients(s, v, space, n, left, right, vectors)
    space.add(x, y) = space.add(\linear_combination_value<s, v, space, n>(left, vectors), y)
    space.add(\linear_combination_value<s, v, space, n>(left, vectors), y) = space.add(\linear_combination_value<s, v, space, n>(left, vectors), \linear_combination_value<s, v, space, n>(right, vectors))
    space.add(x, y) = \linear_combination_value<s, v, space, n>(\coefficient_list_add<s, space.scalars, n>(left, right), vectors)
    witness exist coefficients &chap1a::FiniteList<s, n> st {space.add(x, y) = \linear_combination_value<s, v, space, n>(coefficients, vectors)} from \coefficient_list_add<s, space.scalars, n>(left, right)
    by def:
        ? $is_linear_combination(s, v, space, n, space.add(x, y), vectors)
    # Keep the checked coefficient witness; trust only the unsupported
    # one-layer set-builder membership fold.
    space.add(x, y) $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    space.add(x, y) $in \span<s, v, space, n, vectors>

thm span_smul_closed:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, a s, x \span<s, v, space, n, vectors>:
        space.smul(a, x) $in \span<s, v, space, n, vectors>
    \span<s, v, space, n, vectors> = {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    x $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    $is_linear_combination(s, v, space, n, x, vectors)
    obtain coefficients from exist coefficients &chap1a::FiniteList<s, n> st {x = \linear_combination_value<s, v, space, n>(coefficients, vectors)}
    by thm linear_combination_value_smul_coefficients(s, v, space, n, a, coefficients, vectors)
    space.smul(a, x) = \linear_combination_value<s, v, space, n>(\coefficient_list_smul<s, space.scalars, n>(a, coefficients), vectors)
    witness exist result &chap1a::FiniteList<s, n> st {space.smul(a, x) = \linear_combination_value<s, v, space, n>(result, vectors)} from \coefficient_list_smul<s, space.scalars, n>(a, coefficients)
    by def:
        ? $is_linear_combination(s, v, space, n, space.smul(a, x), vectors)
    # Keep the checked coefficient witness; trust only the unsupported
    # one-layer set-builder membership fold.
    space.smul(a, x) $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
    space.smul(a, x) $in \span<s, v, space, n, vectors>

thm span_is_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $chap1c::is_subspace(s, v, space, \span_carrier<s, v, space, n, vectors>)
    by thm span_carrier_spec(s, v, space, n, vectors)
    \span_carrier<s, v, space, n, vectors> = \span<s, v, space, n, vectors>
    by thm span_zero_member(s, v, space, n, vectors)
    space.zero $in \span<s, v, space, n, vectors>
    space.zero $in \span_carrier<s, v, space, n, vectors>
    witness $is_nonempty_set(\span_carrier<s, v, space, n, vectors>) from space.zero
    claim:
        ? forall x, y \span_carrier<s, v, space, n, vectors>:
            space.add(x, y) $in \span_carrier<s, v, space, n, vectors>
        x $in \span<s, v, space, n, vectors>
        y $in \span<s, v, space, n, vectors>
        by thm span_add_closed(s, v, space, n, vectors, x, y)
        space.add(x, y) $in \span<s, v, space, n, vectors>
        space.add(x, y) $in \span_carrier<s, v, space, n, vectors>
    claim:
        ? forall a s, x \span_carrier<s, v, space, n, vectors>:
            space.smul(a, x) $in \span_carrier<s, v, space, n, vectors>
        x $in \span<s, v, space, n, vectors>
        by thm span_smul_closed(s, v, space, n, vectors, a, x)
        space.smul(a, x) $in \span<s, v, space, n, vectors>
        space.smul(a, x) $in \span_carrier<s, v, space, n, vectors>
    by def:
        ? $chap1c::is_subspace(s, v, space, \span_carrier<s, v, space, n, vectors>)

thm list_entry_is_linear_combination:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, idx N+:
        idx <= n
        =>:
            $is_linear_combination(s, v, space, n, vectors.entries(idx), vectors)
    # The retained source proof simultaneously needs tuple-backed FiniteList
    # construction, function-application replay, and predecessor comparison
    # support from the updated runtime.
    trust $is_linear_combination(s, v, space, n, vectors.entries(idx), vectors)

thm span_contains_list_entries:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $contains_list_entries(v, n, vectors, \span_carrier<s, v, space, n, vectors>)
    by thm span_carrier_spec(s, v, space, n, vectors)
    claim:
        ? forall idx N+:
            idx <= n
            =>:
                vectors.entries(idx) $in \span_carrier<s, v, space, n, vectors>
        by thm list_entry_is_linear_combination(s, v, space, n, vectors, idx)
        # The predicate instance is checked by the theorem above; fold only
        # the unsupported direct set-builder membership through trust.
        vectors.entries(idx) $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
        \span<s, v, space, n, vectors> = {value v: $is_linear_combination(s, v, space, n, value, vectors)}
        vectors.entries(idx) $in \span<s, v, space, n, vectors>
        vectors.entries(idx) $in \span_carrier<s, v, space, n, vectors>
    by def:
        ? $contains_list_entries(v, n, vectors, \span_carrier<s, v, space, n, vectors>)

thm partial_trace_step_in_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, trace fn(j closed_range(0, n)) v, U power_set(v), k N+:
        $chap1c::is_subspace(s, v, space, U)
        $contains_list_entries(v, n, vectors, U)
        k <= n
        trace(k - 1) $in U
        trace(k) = space.add(trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k)))
        =>:
            trace(k) $in U
    by def:
        ? $chap1c::is_subspace(s, v, space, U)
    by def:
        ? $contains_list_entries(v, n, vectors, U)
    vectors.entries(k) $in U
    space.smul(coefficients.entries(k), vectors.entries(k)) $in U
    space.add(trace(k - 1), space.smul(coefficients.entries(k), vectors.entries(k))) $in U
    trace(k) $in U

thm partial_trace_in_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, trace fn(j closed_range(0, n)) v, U power_set(v), k closed_range(0, n):
        $chap1c::is_subspace(s, v, space, U)
        $contains_list_entries(v, n, vectors, U)
        $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
        =>:
            trace(k) $in U
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
    by def:
        ? $chap1c::is_subspace(s, v, space, U)
    space.zero $in U
    have fn extended_trace(j N) v by cases:
        case j <= n: trace(j)
        case j > n: space.zero
    claim:
        ? forall j N:
            extended_trace(j) $in U
        by induc j from 0:
            ? extended_trace(j) $in U
            ? from j = 0:
                0 <= n
                extended_trace(0) = trace(0)
                trace(0) = space.zero
                extended_trace(0) $in U
            ? induc:
                extended_trace(j) $in U
                j + 1 <= n or j + 1 > n
                by cases:
                    ? extended_trace(j + 1) $in U
                    case j + 1 <= n:
                        j <= j + 1 <= n
                        extended_trace(j) = trace(j)
                        trace(j) $in U
                        have next_index N+ = j + 1
                        next_index - 1 = j
                        trace(next_index - 1) = trace(j)
                        trace(next_index - 1) $in U
                        by thm partial_trace_step_in_subspace(s, v, space, n, vectors, coefficients, trace, U, next_index)
                        trace(next_index) $in U
                        extended_trace(j + 1) = trace(j + 1)
                        extended_trace(j + 1) $in U
                    case j + 1 > n:
                        extended_trace(j + 1) = space.zero
                        extended_trace(j + 1) $in U
    k <= n
    extended_trace(k) = trace(k)
    extended_trace(k) $in U
    trace(k) $in U

thm span_is_smallest_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, U power_set(v):
        $chap1c::is_subspace(s, v, space, U)
        $contains_list_entries(v, n, vectors, U)
        =>:
            \span_carrier<s, v, space, n, vectors> $subset U
    claim:
        ? forall x \span_carrier<s, v, space, n, vectors>:
            x $in U
        by thm span_carrier_spec(s, v, space, n, vectors)
        x $in \span<s, v, space, n, vectors>
        \span<s, v, space, n, vectors> = {value v: $is_linear_combination(s, v, space, n, value, vectors)}
        x $in {value v: $is_linear_combination(s, v, space, n, value, vectors)}
        $is_linear_combination(s, v, space, n, x, vectors)
        obtain coefficients from exist coefficients &chap1a::FiniteList<s, n> st {x = \linear_combination_value<s, v, space, n>(coefficients, vectors)}
        by thm linear_combination_value_satisfies_spec(s, v, space, n, coefficients, vectors)
        by def:
            ? $has_linear_combination_value(s, v, space, n, coefficients, vectors, \linear_combination_value<s, v, space, n>(coefficients, vectors))
        obtain trace from exist partial_sums fn(k closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, partial_sums), \linear_combination_value<s, v, space, n>(coefficients, vectors) = partial_sums(n)}
        by thm partial_trace_in_subspace(s, v, space, n, vectors, coefficients, trace, U, n)
        trace(n) $in U
        x = \linear_combination_value<s, v, space, n>(coefficients, vectors) = trace(n)
        x $in U
    by def:
        ? \span_carrier<s, v, space, n, vectors> $subset U
# Definition 2.7. A list spans its ambient vector space precisely when its
# span carrier is the whole vector carrier.
prop spans(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    \span<s, v, space, n, vectors> = v
# Example 2.8. The standard coordinate vectors span F^n: the kth coefficient
# of a vector is its kth coordinate. The symbolic standard-list constructor is
# left as a source sketch until Chapter 1's positive-length list bridge is
# extended to a finite family of coordinate vectors.
# Definition 2.9. Finite dimensionality is the existence of one finite list
# that spans the equipped vector space.
prop is_finite_dimensional(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>):
    exist n N, vectors &chap1a::FiniteList<v, n> st {$spans(s, v, space, n, vectors)}
# Definitions 2.10-2.11. A polynomial is formal coefficient data, not merely
# its evaluation function. This distinction is essential over finite fields:
# distinct formal polynomials can induce the same scalar-valued function.
# PolynomialDegree is the executable carrier N union {-inf}.
# finite_flag=0 denotes -inf and forces value=0; finite_flag=1 with value m
# denotes the ordinary nonnegative degree m.
struct PolynomialDegree:
    finite_flag N
    value N
    <=>:
        finite_flag = 0 or finite_flag = 1
        finite_flag * value = value

by thm struct_member((0, 0), &PolynomialDegree)
have minus_infinity_degree &PolynomialDegree = (0, 0)
claim:
    ? forall m N:
        (1, m) $in &PolynomialDegree
    by thm struct_member((1, m), &PolynomialDegree)
have fn finite_polynomial_degree(m N) &PolynomialDegree = (1, m)

# A formal polynomial owns its coefficient function and its normalized degree.
# The structure invariant says either every coefficient is zero and the degree
# is -infinity, or the recorded leading coefficient is nonzero and every
# coefficient above it is zero.
prop has_only_zero_formal_coefficients(s nonempty_set, scalars &chap1a::ScalarSystem<s>, coefficients fn(k N) s):
    forall k N:
        coefficients(k) = scalars.zero

prop has_formal_polynomial_leading_degree(s nonempty_set, scalars &chap1a::ScalarSystem<s>, coefficients fn(k N) s, m N):
    coefficients(m) != scalars.zero
    forall k N:
        k > m
        =>:
            coefficients(k) = scalars.zero

prop is_formal_polynomial_data(s nonempty_set, scalars &chap1a::ScalarSystem<s>, coefficients fn(k N) s, degree &PolynomialDegree):
    forall:
        degree = minus_infinity_degree
        =>:
            $has_only_zero_formal_coefficients(s, scalars, coefficients)
    forall:
        $has_only_zero_formal_coefficients(s, scalars, coefficients)
        =>:
            degree = minus_infinity_degree
    forall m N:
        degree = finite_polynomial_degree(m)
        =>:
            $has_formal_polynomial_leading_degree(s, scalars, coefficients, m)

struct Polynomial<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    coefficients fn(k N) s
    degree &PolynomialDegree
    <=>:
        $is_formal_polynomial_data(s, scalars, coefficients, degree)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>>:
    have polynomial_space set = &Polynomial<s, scalars>

prop is_polynomial(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p &Polynomial<s, scalars>):
    p $in &Polynomial<s, scalars>

# A positive-length coefficient list represents the same formal coefficient
# sequence when its kth entry is coefficient k-1 and all later coefficients
# vanish. Leading zero entries are allowed, so a polynomial may have many
# padded representations without compromising its intrinsic degree.
prop represents_polynomial(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+, coefficients &chap1a::FiniteList<s, n>, p &Polynomial<s, scalars>):
    forall k N+:
        k <= n
        =>:
            coefficients.entries(k) = p.coefficients(k - 1)
    forall k N:
        k >= n
        =>:
            p.coefficients(k) = scalars.zero

prop is_zero_polynomial(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p &Polynomial<s, scalars>):
    forall k N:
        p.coefficients(k) = scalars.zero

prop has_polynomial_degree(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p &Polynomial<s, scalars>, degree &PolynomialDegree):
    degree = p.degree

prop admits_unique_polynomial_degree(s nonempty_set, scalars &chap1a::ScalarSystem<s>, p &Polynomial<s, scalars>):
    exist! degree &PolynomialDegree st {$has_polynomial_degree(s, scalars, p, degree)}

thm polynomial_degree_exists_unique:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, p &Polynomial<s, scalars>:
        $is_polynomial(s, scalars, p)
        =>:
            $admits_unique_polynomial_degree(s, scalars, p)
    claim:
        ? forall degree1, degree2 &PolynomialDegree:
            $has_polynomial_degree(s, scalars, p, degree1)
            $has_polynomial_degree(s, scalars, p, degree2)
            =>:
                degree1 = degree2
        by def:
            ? $has_polynomial_degree(s, scalars, p, degree1)
        by def:
            ? $has_polynomial_degree(s, scalars, p, degree2)
        degree1 = p.degree = degree2
    by def:
        ? $has_polynomial_degree(s, scalars, p, p.degree)
    witness exist! degree &PolynomialDegree st {$has_polynomial_degree(s, scalars, p, degree)} from p.degree
    by def:
        ? $admits_unique_polynomial_degree(s, scalars, p)

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, p &Polynomial<s, scalars>>:
    have degree &PolynomialDegree = p.degree
# Notation 2.12. P_m(F) is the genuine carrier of polynomials whose selected
# degree is at most m; the -inf flag includes the zero polynomial automatically.
prop polynomial_degree_at_most(candidate_degree &PolynomialDegree, m N):
    candidate_degree.finite_flag = 0 or candidate_degree.value <= m

template<s nonempty_set, scalars &chap1a::ScalarSystem<s>, m N>:
    have polynomial_space_at_most power_set(\polynomial_space<s, scalars>) = {p \polynomial_space<s, scalars>: $polynomial_degree_at_most(\degree<s, scalars, p>, m)}
# Definition 2.13. Infinite dimensional means exactly not finite dimensional.
prop is_infinite_dimensional(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>):
    not $is_finite_dimensional(s, v, space)
# Example 2.14. P(F) is infinite-dimensional because any finite polynomial
# list has bounded degree while the next monomial lies outside its span. The
# maximum-degree and degree-of-sum infrastructure remains a source sketch.
# Definition 2.15. A list is linearly independent when a zero-valued linear
# combination forces every coefficient in the indexed list to be scalar zero.
# At n=0 the universal coefficient conclusion is vacuous, as in the source.
prop has_only_zero_coefficients(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N, coefficients &chap1a::FiniteList<s, n>):
    forall idx N+:
        idx <= n
        =>:
            coefficients.entries(idx) = scalars.zero

prop is_largest_nonzero_coefficient_index(s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+, coefficients &chap1a::FiniteList<s, n>, k N+):
    k <= n
    coefficients.entries(k) != scalars.zero
    forall j N+:
        j <= n
        j > k
        =>:
            coefficients.entries(j) = scalars.zero

thm nonzero_coefficients_have_largest_index:
    ? forall s nonempty_set, scalars &chap1a::ScalarSystem<s>, n N+, coefficients &chap1a::FiniteList<s, n>:
        not $has_only_zero_coefficients(s, scalars, n, coefficients)
        =>:
            exist k N+ st {$is_largest_nonzero_coefficient_index(s, scalars, n, coefficients, k)}
    have zero_indices set = {j N+: j <= n, coefficients.entries(j) = scalars.zero}
    have support set = set_minus(closed_range(1, n), zero_indices)
    claim:
        ? $is_nonempty_set(support)
        by contra:
            ? $is_nonempty_set(support)
            claim:
                ? forall j N+:
                    j <= n
                    =>:
                        coefficients.entries(j) = scalars.zero
                by cases:
                    ? coefficients.entries(j) = scalars.zero
                    case coefficients.entries(j) = scalars.zero:
                        coefficients.entries(j) = scalars.zero
                    case coefficients.entries(j) != scalars.zero:
                        j $in closed_range(1, n)
                        by contra:
                            ? not j $in zero_indices
                            coefficients.entries(j) = scalars.zero
                            impossible coefficients.entries(j) != scalars.zero
                        j $in set_minus(closed_range(1, n), zero_indices)
                        support = set_minus(closed_range(1, n), zero_indices)
                        j $in support
                        witness $is_nonempty_set(support) from j
                        impossible $is_nonempty_set(support)
            by def:
                ? $has_only_zero_coefficients(s, scalars, n, coefficients)
            impossible $has_only_zero_coefficients(s, scalars, n, coefficients)
    $is_finite_set(closed_range(1, n))
    $is_finite_set(set_minus(closed_range(1, n), zero_indices))
    $is_finite_set(support)
    $is_nonempty_set(support)
    claim:
        ? support $subset R
        forall j support:
            j $in closed_range(1, n)
            j $in Z
            j $in R
        by def:
            ? support $subset R
    have maximum R = finite_set_max(support)
    finite_set_max(support) $in support
    maximum $in support
    maximum $in closed_range(1, n)
    maximum $in N+
    have k N+ = maximum
    k $in support
    k $in closed_range(1, n)
    k <= n
    not k $in zero_indices
    by contra:
        ? coefficients.entries(k) != scalars.zero
        # Trust reason: zero_indices is a local named set-builder alias. Global
        # automatic lookup for every named carrier is too broad for this case.
        k $in zero_indices
        impossible not k $in zero_indices
    claim:
        ? forall j N+:
            j <= n
            j > k
            =>:
                coefficients.entries(j) = scalars.zero
        by cases:
            ? coefficients.entries(j) = scalars.zero
            case coefficients.entries(j) = scalars.zero:
                coefficients.entries(j) = scalars.zero
            case coefficients.entries(j) != scalars.zero:
                j $in closed_range(1, n)
                by contra:
                    ? not j $in zero_indices
                    coefficients.entries(j) = scalars.zero
                    impossible coefficients.entries(j) != scalars.zero
                j $in set_minus(closed_range(1, n), zero_indices)
                support = set_minus(closed_range(1, n), zero_indices)
                j $in support
                j <= finite_set_max(support) = k
                impossible j > k
    by def:
        ? $is_largest_nonzero_coefficient_index(s, scalars, n, coefficients, k)
    witness exist selected N+ st {$is_largest_nonzero_coefficient_index(s, scalars, n, coefficients, selected)} from k

prop is_linearly_independent(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    forall coefficients &chap1a::FiniteList<s, n>:
        \linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
        =>:
            $has_only_zero_coefficients(s, space.scalars, n, coefficients)
# Example 2.16. Coordinate comparison proves independence of the displayed
# standard vectors; coefficient uniqueness proves independence of monomials;
# one- and two-vector cases reduce to zero and scalar-multiple criteria.
# Definition 2.17. Linear dependence is the logical negation of independence.
prop is_linearly_dependent(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    not $is_linearly_independent(s, v, space, n, vectors)

prop has_nontrivial_dependence_coefficients(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>):
    exist coefficients &chap1a::FiniteList<s, n> st {\linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero, not $has_only_zero_coefficients(s, space.scalars, n, coefficients)}
# Example 2.18. The source supplies explicit nonzero coefficient witnesses for
# its dependent lists, including the parameter value c=8 and the zero-entry and
# redundant-vector patterns.
# The following two relations preserve the ordered-list content needed by
# the next source result without pretending that prefix or removal is an
# unordered set.
prop is_prefix_of_length(v nonempty_set, n, k N, vectors &chap1a::FiniteList<v, n>, prefix &chap1a::FiniteList<v, k>):
    k <= n
    forall idx N+:
        idx <= k
        =>:
            prefix.entries(idx) = vectors.entries(idx)

prop is_list_with_index_removed(v nonempty_set, n N+, vectors &chap1a::FiniteList<v, n>, k N+, reduced &chap1a::FiniteList<v, n - 1>):
    k <= n
    forall idx N+:
        idx < k
        idx <= n - 1
        =>:
            reduced.entries(idx) = vectors.entries(idx)
    forall idx N+:
        k <= idx
        idx < n
        idx <= n - 1
        =>:
            reduced.entries(idx) = vectors.entries(idx + 1)

thm successor_le_from_le_predecessor:
    ? forall idx, n N+:
        idx <= n - 1
        =>:
            idx + 1 <= n
    n - 1 + 1 = n
    idx + 1 <= n - 1 + 1 = n

thm linear_combination_trace_constant_after_zero_tail:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N+, k N+, coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, trace fn(j closed_range(0, n)) v:
        k <= n
        $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
        forall j N+:
            j <= n
            j > k
            =>:
                coefficients.entries(j) = space.scalars.zero
        =>:
            trace(n) = trace(k)
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
    have fn capped_trace(j N) v by cases:
        case j <= n: trace(j)
        case j > n: trace(n)
    have fn extended_trace(j N) v by cases:
        case j < k: trace(k)
        case j >= k: capped_trace(j)
    claim:
        ? forall j N+:
            extended_trace(j) = trace(k)
        by induc j from 1:
            ? extended_trace(j) = trace(k)
            ? from j = 1:
                by cases:
                    ? extended_trace(1) = trace(k)
                    case 1 < k:
                        extended_trace(1) = trace(k)
                    case 1 >= k:
                        k >= 1
                        k = 1
                        1 <= n
                        capped_trace(1) = trace(1)
                        extended_trace(1) = capped_trace(1) = trace(1) = trace(k)
            ? induc:
                by cases:
                    ? extended_trace(j + 1) = trace(k)
                    case j + 1 < k:
                        extended_trace(j + 1) = trace(k)
                    case j + 1 >= k:
                        by cases:
                            ? extended_trace(j + 1) = trace(k)
                            case j < k:
                                j + 1 <= k
                                j + 1 = k
                                k <= n
                                capped_trace(k) = trace(k)
                                extended_trace(j + 1) = extended_trace(k) = capped_trace(k) = trace(k)
                            case j >= k:
                                by cases:
                                    ? extended_trace(j + 1) = trace(k)
                                    case j + 1 <= n:
                                        j <= j + 1 <= n
                                        capped_trace(j) = trace(j)
                                        extended_trace(j) = capped_trace(j) = trace(j)
                                        trace(j) = trace(k)
                                        have next_index N+ = j + 1
                                        j + 1 > j >= k
                                        next_index > k
                                        coefficients.entries(next_index) = space.scalars.zero
                                        trace(next_index) = space.add(trace(next_index - 1), space.smul(coefficients.entries(next_index), vectors.entries(next_index)))
                                        next_index - 1 = j
                                        by thm chap1b::zero_scalar_times_vector(s, v, space, vectors.entries(next_index))
                                        trace(next_index - 1) = trace(j)
                                        space.smul(coefficients.entries(next_index), vectors.entries(next_index)) = space.smul(space.scalars.zero, vectors.entries(next_index)) = space.zero
                                        space.add(trace(j), space.zero) = space.add(space.zero, trace(j)) = trace(j)
                                        trace(next_index) = space.add(trace(next_index - 1), space.smul(coefficients.entries(next_index), vectors.entries(next_index))) = space.add(trace(j), space.zero) = trace(j)
                                        capped_trace(j + 1) = trace(j + 1)
                                        extended_trace(j + 1) = capped_trace(j + 1) = trace(j + 1) = trace(next_index) = trace(j) = trace(k)
                                    case j + 1 > n:
                                        capped_trace(j + 1) = trace(n)
                                        extended_trace(j + 1) = capped_trace(j + 1) = trace(n)
                                        by cases:
                                            ? trace(n) = trace(k)
                                            case j < n:
                                                j + 1 > n
                                                j + 1 <= n
                                                impossible j + 1 > n
                                            case j >= n:
                                                by cases:
                                                    ? extended_trace(j) = trace(n)
                                                    case j <= n:
                                                        j = n
                                                        capped_trace(j) = trace(j)
                                                        extended_trace(j) = capped_trace(j) = trace(j) = trace(n)
                                                    case j > n:
                                                        capped_trace(j) = trace(n)
                                                        extended_trace(j) = capped_trace(j) = trace(n)
                                                trace(n) = extended_trace(j) = trace(k)
                                        extended_trace(j + 1) = trace(k)
    n >= k
    capped_trace(n) = trace(n)
    extended_trace(n) = capped_trace(n) = trace(n)
    extended_trace(n) = trace(k)
    trace(n) = trace(k)

thm linear_combination_trace_prefix_value:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, m closed_range(0, n), coefficients &chap1a::FiniteList<s, n>, vectors &chap1a::FiniteList<v, n>, trace fn(j closed_range(0, n)) v, prefix_coefficients &chap1a::FiniteList<s, m>, prefix_vectors &chap1a::FiniteList<v, m>:
        $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
        $is_prefix_of_length(s, n, m, coefficients, prefix_coefficients)
        $is_prefix_of_length(v, n, m, vectors, prefix_vectors)
        =>:
            \linear_combination_value<s, v, space, m>(prefix_coefficients, prefix_vectors) = trace(m)
    by def:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, vectors, trace)
    by def:
        ? $is_prefix_of_length(s, n, m, coefficients, prefix_coefficients)
    by def:
        ? $is_prefix_of_length(v, n, m, vectors, prefix_vectors)
    have fn prefix_trace(j closed_range(0, m)) v = trace(j)
    claim:
        ? $is_linear_combination_partial_sum_sequence(s, v, space, m, prefix_coefficients, prefix_vectors, prefix_trace)
        prefix_trace(0) = trace(0) = space.zero
        claim:
            ? forall j N+:
                j <= m
                =>:
                    prefix_trace(j) = space.add(prefix_trace(j - 1), space.smul(prefix_coefficients.entries(j), prefix_vectors.entries(j)))
            j <= m <= n
            prefix_coefficients.entries(j) = coefficients.entries(j)
            prefix_vectors.entries(j) = vectors.entries(j)
            prefix_trace(j) = trace(j)
            j - 1 <= j <= m
            trust prefix_trace(j - 1) = trace(j - 1)
            trace(j) = space.add(trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j)))
            prefix_trace(j) = trace(j) = space.add(trace(j - 1), space.smul(coefficients.entries(j), vectors.entries(j))) = space.add(prefix_trace(j - 1), space.smul(prefix_coefficients.entries(j), prefix_vectors.entries(j)))
        by def:
            ? $is_linear_combination_partial_sum_sequence(s, v, space, m, prefix_coefficients, prefix_vectors, prefix_trace)
    claim:
        ? $has_linear_combination_value(s, v, space, m, prefix_coefficients, prefix_vectors, trace(m))
        trace(m) = prefix_trace(m)
        witness exist selected_trace fn(j closed_range(0, m)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, m, prefix_coefficients, prefix_vectors, selected_trace), trace(m) = selected_trace(m)} from prefix_trace
        by def:
            ? $has_linear_combination_value(s, v, space, m, prefix_coefficients, prefix_vectors, trace(m))
    by thm linear_combination_value_exists_unique(s, v, space, m, prefix_coefficients, prefix_vectors)
    by thm linear_combination_value_satisfies_spec(s, v, space, m, prefix_coefficients, prefix_vectors)
    \linear_combination_value<s, v, space, m>(prefix_coefficients, prefix_vectors) = trace(m)
# Result 2.19. A dependent ordered list has an entry in the span of its
# predecessors, and deleting that entry preserves the span. The source solves
# for the largest nonzero coefficient and substitutes into every combination.
# Proof debt: the final finite-list deletion/substitution preservation step is
# isolated as a named axiom below.
# span_carrier_spec identifies each displayed selected carrier with the source
# span; this avoids re-expanding the recursive linear-combination selector.
thm solve_nonzero_coefficient_into_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, m N, vectors &chap1a::FiniteList<v, m>, coefficients &chap1a::FiniteList<s, m>, coefficient s, x v:
        coefficient != space.scalars.zero
        space.add(\linear_combination_value<s, v, space, m>(coefficients, vectors), space.smul(coefficient, x)) = space.zero
        =>:
            x $in \span_carrier<s, v, space, m, vectors>
    have prefix_value v = \linear_combination_value<s, v, space, m>(coefficients, vectors)
    by thm chap1b::vector_neg_spec(s, v, space, prefix_value)
    space.add(prefix_value, \chap1b::vector_neg<s, v, space>(prefix_value)) = space.zero
    by thm chap1b::add_left_cancel(s, v, space, prefix_value, space.smul(coefficient, x), \chap1b::vector_neg<s, v, space>(prefix_value))
    space.smul(coefficient, x) = \chap1b::vector_neg<s, v, space>(prefix_value)
    have inverse_coefficient s = space.scalars.inv(coefficient)
    space.scalars.mul(coefficient, inverse_coefficient) = space.scalars.mul(coefficient, space.scalars.inv(coefficient)) = space.scalars.one
    space.scalars.mul(inverse_coefficient, coefficient) = space.scalars.mul(space.scalars.inv(coefficient), coefficient) = space.scalars.mul(coefficient, space.scalars.inv(coefficient)) = space.scalars.one
    space.smul(inverse_coefficient, space.smul(coefficient, x)) = space.smul(space.scalars.mul(inverse_coefficient, coefficient), x) = space.smul(space.scalars.one, x) = x
    x = space.smul(inverse_coefficient, \chap1b::vector_neg<s, v, space>(prefix_value))
    by thm linear_combination_value_neg_coefficients(s, v, space, m, coefficients, vectors)
    \linear_combination_value<s, v, space, m>(\coefficient_list_neg<s, space.scalars, m>(coefficients), vectors) = \chap1b::vector_neg<s, v, space>(\linear_combination_value<s, v, space, m>(coefficients, vectors)) = \chap1b::vector_neg<s, v, space>(prefix_value)
    have solution &chap1a::FiniteList<s, m> = \coefficient_list_smul<s, space.scalars, m>(inverse_coefficient, \coefficient_list_neg<s, space.scalars, m>(coefficients))
    by thm linear_combination_value_smul_coefficients(s, v, space, m, inverse_coefficient, \coefficient_list_neg<s, space.scalars, m>(coefficients), vectors)
    \linear_combination_value<s, v, space, m>(solution, vectors) = \linear_combination_value<s, v, space, m>(\coefficient_list_smul<s, space.scalars, m>(inverse_coefficient, \coefficient_list_neg<s, space.scalars, m>(coefficients)), vectors) = space.smul(inverse_coefficient, \linear_combination_value<s, v, space, m>(\coefficient_list_neg<s, space.scalars, m>(coefficients), vectors)) = space.smul(inverse_coefficient, \chap1b::vector_neg<s, v, space>(prefix_value)) = x
    witness exist selected &chap1a::FiniteList<s, m> st {x = \linear_combination_value<s, v, space, m>(selected, vectors)} from solution
    by def:
        ? $is_linear_combination(s, v, space, m, x, vectors)
    x $in {value v: $is_linear_combination(s, v, space, m, value, vectors)}
    \span<s, v, space, m, vectors> = {value v: $is_linear_combination(s, v, space, m, value, vectors)}
    x $in \span<s, v, space, m, vectors>
    by thm span_carrier_spec(s, v, space, m, vectors)
    x $in \span_carrier<s, v, space, m, vectors>

thm largest_nonzero_coefficient_entry_in_predecessor_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N+, vectors &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, k N+, predecessors &chap1a::FiniteList<v, k - 1>:
        k <= n
        \linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
        $is_largest_nonzero_coefficient_index(s, space.scalars, n, coefficients, k)
        $is_prefix_of_length(v, n, k - 1, vectors, predecessors)
        =>:
            vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
    # The retained prefix proof is blocked by tuple-backed FiniteList
    # construction and later-use field replay.
    trust vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>

thm largest_nonzero_coefficient_deletion_preserves_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N+, vectors &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, k N+, predecessors &chap1a::FiniteList<v, k - 1>, reduced &chap1a::FiniteList<v, n - 1>:
        k <= n
        \linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
        $is_largest_nonzero_coefficient_index(s, space.scalars, n, coefficients, k)
        $is_prefix_of_length(v, n, k - 1, vectors, predecessors)
        $is_list_with_index_removed(v, n, vectors, k, reduced)
        =>:
            vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
            \span_carrier<s, v, space, n - 1, reduced> = \span_carrier<s, v, space, n, vectors>
    by thm largest_nonzero_coefficient_entry_in_predecessor_span(s, v, space, n, vectors, coefficients, k, predecessors)
    by def:
        ? $is_list_with_index_removed(v, n, vectors, k, reduced)
    by thm span_is_subspace(s, v, space, n, vectors)
    by thm span_is_subspace(s, v, space, n - 1, reduced)
    by thm span_contains_list_entries(s, v, space, n, vectors)
    by thm span_contains_list_entries(s, v, space, n - 1, reduced)
    claim:
        ? $contains_list_entries(v, n - 1, reduced, \span_carrier<s, v, space, n, vectors>)
        claim:
            ? forall idx N+:
                idx <= n - 1
                =>:
                    reduced.entries(idx) $in \span_carrier<s, v, space, n, vectors>
            by cases:
                ? reduced.entries(idx) $in \span_carrier<s, v, space, n, vectors>
                case idx < k:
                    reduced.entries(idx) = vectors.entries(idx)
                    idx <= n
                    by def:
                        ? $contains_list_entries(v, n, vectors, \span_carrier<s, v, space, n, vectors>)
                    vectors.entries(idx) $in \span_carrier<s, v, space, n, vectors>
                case idx >= k:
                    n - 1 < n
                    idx <= n - 1 < n
                    idx < n
                    reduced.entries(idx) = vectors.entries(idx + 1)
                    idx + 1 <= n
                    by def:
                        ? $contains_list_entries(v, n, vectors, \span_carrier<s, v, space, n, vectors>)
                    vectors.entries(idx + 1) $in \span_carrier<s, v, space, n, vectors>
        by def:
            ? $contains_list_entries(v, n - 1, reduced, \span_carrier<s, v, space, n, vectors>)
    by thm span_is_smallest_subspace(s, v, space, n - 1, reduced, \span_carrier<s, v, space, n, vectors>)
    \span_carrier<s, v, space, n - 1, reduced> $subset \span_carrier<s, v, space, n, vectors>
    claim:
        ? $contains_list_entries(v, k - 1, predecessors, \span_carrier<s, v, space, n - 1, reduced>)
        claim:
            ? forall idx N+:
                idx <= k - 1
                =>:
                    predecessors.entries(idx) $in \span_carrier<s, v, space, n - 1, reduced>
            by def:
                ? $is_prefix_of_length(v, n, k - 1, vectors, predecessors)
            k - 1 < k
            idx <= k - 1 < k
            idx < k
            k - 1 <= n - 1
            idx <= k - 1 <= n - 1
            idx <= n - 1
            reduced.entries(idx) = vectors.entries(idx) = predecessors.entries(idx)
            by def:
                ? $contains_list_entries(v, n - 1, reduced, \span_carrier<s, v, space, n - 1, reduced>)
            reduced.entries(idx) $in \span_carrier<s, v, space, n - 1, reduced>
        by def:
            ? $contains_list_entries(v, k - 1, predecessors, \span_carrier<s, v, space, n - 1, reduced>)
    by thm span_is_smallest_subspace(s, v, space, k - 1, predecessors, \span_carrier<s, v, space, n - 1, reduced>)
    \span_carrier<s, v, space, k - 1, predecessors> $subset \span_carrier<s, v, space, n - 1, reduced>
    vectors.entries(k) $in \span_carrier<s, v, space, n - 1, reduced>
    claim:
        ? $contains_list_entries(v, n, vectors, \span_carrier<s, v, space, n - 1, reduced>)
        claim:
            ? forall idx N+:
                idx <= n
                =>:
                    vectors.entries(idx) $in \span_carrier<s, v, space, n - 1, reduced>
            by cases:
                ? vectors.entries(idx) $in \span_carrier<s, v, space, n - 1, reduced>
                case idx < k:
                    idx < n
                    idx <= n - 1
                    reduced.entries(idx) = vectors.entries(idx)
                    by def:
                        ? $contains_list_entries(v, n - 1, reduced, \span_carrier<s, v, space, n - 1, reduced>)
                    reduced.entries(idx) $in \span_carrier<s, v, space, n - 1, reduced>
                case idx >= k:
                    by cases:
                        ? vectors.entries(idx) $in \span_carrier<s, v, space, n - 1, reduced>
                        case idx = k:
                            vectors.entries(idx) = vectors.entries(k)
                        case idx > k:
                            k >= 1
                            k + 1 >= 1 + 1 = 2
                            idx >= k + 1
                            idx >= k + 1 >= 2
                            idx - 1 >= 1
                            idx - 1 $in N+
                            have previous_index N+ = idx - 1
                            k <= idx - 1
                            k <= idx - 1 = previous_index
                            k <= previous_index
                            idx - 1 < idx
                            previous_index = idx - 1 < idx <= n
                            previous_index < n
                            previous_index <= n - 1
                            reduced.entries(previous_index) = vectors.entries(previous_index + 1)
                            (idx - 1) + 1 = idx
                            previous_index + 1 = (idx - 1) + 1 = idx
                            previous_index + 1 = idx
                            reduced.entries(previous_index) = vectors.entries(idx)
                            by def:
                                ? $contains_list_entries(v, n - 1, reduced, \span_carrier<s, v, space, n - 1, reduced>)
                            reduced.entries(previous_index) $in \span_carrier<s, v, space, n - 1, reduced>
        by def:
            ? $contains_list_entries(v, n, vectors, \span_carrier<s, v, space, n - 1, reduced>)
    by thm span_is_smallest_subspace(s, v, space, n, vectors, \span_carrier<s, v, space, n - 1, reduced>)
    \span_carrier<s, v, space, n, vectors> $subset \span_carrier<s, v, space, n - 1, reduced>
    by extension:
        ? \span_carrier<s, v, space, n - 1, reduced> = \span_carrier<s, v, space, n, vectors>

thm linear_dependence_lemma:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $is_linearly_dependent(s, v, space, n, vectors)
        =>:
            n $in N+
            exist k N+, predecessors &chap1a::FiniteList<v, k - 1>, reduced &chap1a::FiniteList<v, n - 1> st {k <= n, $is_prefix_of_length(v, n, k - 1, vectors, predecessors), vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>, $is_list_with_index_removed(v, n, vectors, k, reduced), \span_carrier<s, v, space, n - 1, reduced> = \span_carrier<s, v, space, n, vectors>}
    # The retained construction needs two tuple-backed FiniteList values plus
    # the already-classified predecessor interfaces.
    trust n $in N+
    trust exist k N+, predecessors &chap1a::FiniteList<v, k - 1>, reduced &chap1a::FiniteList<v, n - 1> st {k <= n, $is_prefix_of_length(v, n, k - 1, vectors, predecessors), vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>, $is_list_with_index_removed(v, n, vectors, k, reduced), \span_carrier<s, v, space, n - 1, reduced> = \span_carrier<s, v, space, n, vectors>}
# Boundary remark following Result 2.19. If k=1, the predecessor has length
# zero and its span contains only the VectorSpace zero selected by the empty
# partial-sum definition.
# Example 2.21. In the source's four-vector list in R^3, the minimum possible
# witness is k=3 because the first two vectors are independent and the third is
# three times the first plus two times the second.

prop agrees_on_initial_segment(v nonempty_set, source_length, current_length N, source &chap1a::FiniteList<v, source_length>, current &chap1a::FiniteList<v, current_length>, prefix_length N):
    prefix_length <= source_length
    prefix_length <= current_length
    forall idx N+:
        idx <= prefix_length
        =>:
            current.entries(idx) = source.entries(idx)

prop is_list_with_index_inserted(v nonempty_set, old_length N, old_list &chap1a::FiniteList<v, old_length>, inserted &chap1a::FiniteList<v, old_length + 1>, k N+):
    k <= old_length + 1
    forall idx N+:
        idx < k
        idx <= old_length
        =>:
            old_list.entries(idx) = inserted.entries(idx)
    forall idx N+:
        k <= idx
        idx <= old_length
        =>:
            old_list.entries(idx) = inserted.entries(idx + 1)

thm insert_next_entry_after_shared_prefix:
    ? forall v nonempty_set, source_length N, source &chap1a::FiniteList<v, source_length>, current_length N, current &chap1a::FiniteList<v, current_length>, prefix_length N:
        prefix_length <= current_length
        prefix_length + 1 <= source_length
        $agrees_on_initial_segment(v, source_length, current_length, source, current, prefix_length)
        =>:
            exist augmented &chap1a::FiniteList<v, current_length + 1> st {$agrees_on_initial_segment(v, source_length, current_length + 1, source, augmented, prefix_length + 1), $is_list_with_index_inserted(v, current_length, current, augmented, prefix_length + 1)}
    # The retained construction reaches the already-classified predecessor
    # and tuple-backed FiniteList boundaries.
    trust exist augmented &chap1a::FiniteList<v, current_length + 1> st {$agrees_on_initial_segment(v, source_length, current_length + 1, source, augmented, prefix_length + 1), $is_list_with_index_inserted(v, current_length, current, augmented, prefix_length + 1)}

thm inserting_into_spanning_list_preserves_spanning:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, old_length N, old_list &chap1a::FiniteList<v, old_length>, inserted &chap1a::FiniteList<v, old_length + 1>, k N+:
        $spans(s, v, space, old_length, old_list)
        $is_list_with_index_inserted(v, old_length, old_list, inserted, k)
        =>:
            $spans(s, v, space, old_length + 1, inserted)
    by thm span_contains_list_entries(s, v, space, old_length + 1, inserted)
    by def:
        ? $is_list_with_index_inserted(v, old_length, old_list, inserted, k)
    claim:
        ? $contains_list_entries(v, old_length, old_list, \span_carrier<s, v, space, old_length + 1, inserted>)
        claim:
            ? forall idx N+:
                idx <= old_length
                =>:
                    old_list.entries(idx) $in \span_carrier<s, v, space, old_length + 1, inserted>
            by cases:
                ? old_list.entries(idx) $in \span_carrier<s, v, space, old_length + 1, inserted>
                case idx < k:
                    old_list.entries(idx) = inserted.entries(idx)
                    inserted.entries(idx) $in \span_carrier<s, v, space, old_length + 1, inserted>
                case idx >= k:
                    idx + 1 <= old_length + 1
                    old_list.entries(idx) = inserted.entries(idx + 1)
                    inserted.entries(idx + 1) $in \span_carrier<s, v, space, old_length + 1, inserted>
        by def:
            ? $contains_list_entries(v, old_length, old_list, \span_carrier<s, v, space, old_length + 1, inserted>)
    by thm span_is_subspace(s, v, space, old_length + 1, inserted)
    by thm span_is_smallest_subspace(s, v, space, old_length, old_list, \span_carrier<s, v, space, old_length + 1, inserted>)
    by def:
        ? $spans(s, v, space, old_length, old_list)
    by thm span_carrier_spec(s, v, space, old_length, old_list)
    v $subset \span_carrier<s, v, space, old_length + 1, inserted>
    \span_carrier<s, v, space, old_length + 1, inserted> $subset v
    by extension:
        ? \span_carrier<s, v, space, old_length + 1, inserted> = v
    by thm span_carrier_spec(s, v, space, old_length + 1, inserted)
    \span<s, v, space, old_length + 1, inserted> = v
    by def:
        ? $spans(s, v, space, old_length + 1, inserted)

thm inserting_vector_from_old_span_has_nontrivial_dependence:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, old_length N, old_list &chap1a::FiniteList<v, old_length>, inserted &chap1a::FiniteList<v, old_length + 1>, k N+:
        k <= old_length + 1
        $is_list_with_index_inserted(v, old_length, old_list, inserted, k)
        inserted.entries(k) $in \span_carrier<s, v, space, old_length, old_list>
        =>:
            $has_nontrivial_dependence_coefficients(s, v, space, old_length + 1, inserted)
    # The retained coefficient construction needs predecessor
    # carriers and a tuple-backed FiniteList return value.
    trust $has_nontrivial_dependence_coefficients(s, v, space, old_length + 1, inserted)
thm inserting_vector_from_old_span_makes_dependence:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, old_length N, old_list &chap1a::FiniteList<v, old_length>, inserted &chap1a::FiniteList<v, old_length + 1>, k N+:
        k <= old_length + 1
        $is_list_with_index_inserted(v, old_length, old_list, inserted, k)
        inserted.entries(k) $in \span_carrier<s, v, space, old_length, old_list>
        =>:
            $is_linearly_dependent(s, v, space, old_length + 1, inserted)
    by thm inserting_vector_from_old_span_has_nontrivial_dependence(s, v, space, old_length, old_list, inserted, k)
    by def:
        ? $has_nontrivial_dependence_coefficients(s, v, space, old_length + 1, inserted)
    obtain coefficients from exist selected &chap1a::FiniteList<s, old_length + 1> st {\linear_combination_value<s, v, space, old_length + 1>(selected, inserted) = space.zero, not $has_only_zero_coefficients(s, space.scalars, old_length + 1, selected)}
    claim:
        ? not $is_linearly_independent(s, v, space, old_length + 1, inserted)
        by contra:
            ? not $is_linearly_independent(s, v, space, old_length + 1, inserted)
            by def:
                ? $is_linearly_independent(s, v, space, old_length + 1, inserted)
            $has_only_zero_coefficients(s, space.scalars, old_length + 1, coefficients)
            impossible not $has_only_zero_coefficients(s, space.scalars, old_length + 1, coefficients)
    by def:
        ? $is_linearly_dependent(s, v, space, old_length + 1, inserted)

thm linearly_dependent_has_nontrivial_coefficients:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>:
        $is_linearly_dependent(s, v, space, n, vectors)
        =>:
            $has_nontrivial_dependence_coefficients(s, v, space, n, vectors)
    by def:
        ? $is_linearly_dependent(s, v, space, n, vectors)
    by contra:
        ? $has_nontrivial_dependence_coefficients(s, v, space, n, vectors)
        claim:
            ? forall coefficients &chap1a::FiniteList<s, n>:
                \linear_combination_value<s, v, space, n>(coefficients, vectors) = space.zero
                =>:
                    $has_only_zero_coefficients(s, space.scalars, n, coefficients)
            by contra:
                ? $has_only_zero_coefficients(s, space.scalars, n, coefficients)
                witness exist selected &chap1a::FiniteList<s, n> st {\linear_combination_value<s, v, space, n>(selected, vectors) = space.zero, not $has_only_zero_coefficients(s, space.scalars, n, selected)} from coefficients
                by def:
                    ? $has_nontrivial_dependence_coefficients(s, v, space, n, vectors)
                impossible $has_nontrivial_dependence_coefficients(s, v, space, n, vectors)
        by def:
            ? $is_linearly_independent(s, v, space, n, vectors)
        impossible $is_linearly_independent(s, v, space, n, vectors)

thm dependent_prefix_has_nontrivial_coefficients_in_full_list:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, full_length, prefix_length N, full_list &chap1a::FiniteList<v, full_length>, prefix &chap1a::FiniteList<v, prefix_length>:
        $is_prefix_of_length(v, full_length, prefix_length, full_list, prefix)
        $is_linearly_dependent(s, v, space, prefix_length, prefix)
        =>:
            $has_nontrivial_dependence_coefficients(s, v, space, full_length, full_list)
    # Extending the prefix coefficients reaches tuple-backed
    # FiniteList construction before the retained trace proof.
    trust $has_nontrivial_dependence_coefficients(s, v, space, full_length, full_list)
thm dependent_prefix_makes_full_list_dependent:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, full_length, prefix_length N, full_list &chap1a::FiniteList<v, full_length>, prefix &chap1a::FiniteList<v, prefix_length>:
        $is_prefix_of_length(v, full_length, prefix_length, full_list, prefix)
        $is_linearly_dependent(s, v, space, prefix_length, prefix)
        =>:
            $is_linearly_dependent(s, v, space, full_length, full_list)
    by thm dependent_prefix_has_nontrivial_coefficients_in_full_list(s, v, space, full_length, prefix_length, full_list, prefix)
    by def:
        ? $has_nontrivial_dependence_coefficients(s, v, space, full_length, full_list)
    obtain coefficients from exist selected &chap1a::FiniteList<s, full_length> st {\linear_combination_value<s, v, space, full_length>(selected, full_list) = space.zero, not $has_only_zero_coefficients(s, space.scalars, full_length, selected)}
    claim:
        ? not $is_linearly_independent(s, v, space, full_length, full_list)
        by contra:
            ? not $is_linearly_independent(s, v, space, full_length, full_list)
            by def:
                ? $is_linearly_independent(s, v, space, full_length, full_list)
            $has_only_zero_coefficients(s, space.scalars, full_length, coefficients)
            impossible not $has_only_zero_coefficients(s, space.scalars, full_length, coefficients)
    by def:
        ? $is_linearly_dependent(s, v, space, full_length, full_list)

thm independent_entry_not_in_predecessor_span:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, k N+, predecessors &chap1a::FiniteList<v, k - 1>:
        $is_linearly_independent(s, v, space, n, vectors)
        k <= n
        $is_prefix_of_length(v, n, k - 1, vectors, predecessors)
        =>:
            not vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
    # Building the length-k prefix reaches tuple-backed
    # FiniteList construction inside the contradiction proof.
    trust not vectors.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
thm dependence_deletion_index_follows_shared_independent_prefix:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, source_length, long_length N, source &chap1a::FiniteList<v, source_length>, long_list &chap1a::FiniteList<v, long_length>, prefix_length N, k N+, predecessors &chap1a::FiniteList<v, k - 1>:
        $is_linearly_independent(s, v, space, source_length, source)
        $agrees_on_initial_segment(v, source_length, long_length, source, long_list, prefix_length)
        k <= long_length
        $is_prefix_of_length(v, long_length, k - 1, long_list, predecessors)
        long_list.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
        =>:
            k > prefix_length
    by contra:
        ? k > prefix_length
        k <= prefix_length
        k <= source_length
        k - 1 <= prefix_length
        claim:
            ? $is_prefix_of_length(v, source_length, k - 1, source, predecessors)
            k - 1 <= k <= source_length
            by def:
                ? $agrees_on_initial_segment(v, source_length, long_length, source, long_list, prefix_length)
            by def:
                ? $is_prefix_of_length(v, long_length, k - 1, long_list, predecessors)
            claim:
                ? forall idx N+:
                    idx <= k - 1
                    =>:
                        predecessors.entries(idx) = source.entries(idx)
                idx <= k - 1 <= prefix_length
                predecessors.entries(idx) = long_list.entries(idx)
                long_list.entries(idx) = source.entries(idx)
                predecessors.entries(idx) = source.entries(idx)
            by def:
                ? $is_prefix_of_length(v, source_length, k - 1, source, predecessors)
        by thm independent_entry_not_in_predecessor_span(s, v, space, source_length, source, k, predecessors)
        not source.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
        by def:
            ? $agrees_on_initial_segment(v, source_length, long_length, source, long_list, prefix_length)
        long_list.entries(k) = source.entries(k)
        source.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>
        impossible not source.entries(k) $in \span_carrier<s, v, space, k - 1, predecessors>

thm deletion_after_shared_prefix_preserves_initial_agreement:
    ? forall v nonempty_set, source_length N, source &chap1a::FiniteList<v, source_length>, long_length N+, long_list &chap1a::FiniteList<v, long_length>, prefix_length N, k N+, reduced &chap1a::FiniteList<v, long_length - 1>:
        $agrees_on_initial_segment(v, source_length, long_length, source, long_list, prefix_length)
        $is_list_with_index_removed(v, long_length, long_list, k, reduced)
        k > prefix_length
        =>:
            $agrees_on_initial_segment(v, source_length, long_length - 1, source, reduced, prefix_length)
    by def:
        ? $agrees_on_initial_segment(v, source_length, long_length, source, long_list, prefix_length)
    by def:
        ? $is_list_with_index_removed(v, long_length, long_list, k, reduced)
    prefix_length < k <= long_length
    prefix_length <= long_length - 1
    claim:
        ? forall idx N+:
            idx <= prefix_length
            =>:
                reduced.entries(idx) = source.entries(idx)
        idx <= prefix_length < k
        reduced.entries(idx) = long_list.entries(idx)
        long_list.entries(idx) = source.entries(idx)
        reduced.entries(idx) = source.entries(idx)
    by def:
        ? $agrees_on_initial_segment(v, source_length, long_length - 1, source, reduced, prefix_length)

thm spanning_replacement_adds_next_independent_entry:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, source_length, current_length N, source &chap1a::FiniteList<v, source_length>, current &chap1a::FiniteList<v, current_length>, prefix_length N:
        $is_linearly_independent(s, v, space, source_length, source)
        $spans(s, v, space, current_length, current)
        $agrees_on_initial_segment(v, source_length, current_length, source, current, prefix_length)
        prefix_length + 1 <= source_length
        prefix_length < current_length
        =>:
            exist next_list &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, next_list), $agrees_on_initial_segment(v, source_length, current_length, source, next_list, prefix_length + 1)}
    by thm insert_next_entry_after_shared_prefix(v, source_length, source, current_length, current, prefix_length)
    obtain augmented from exist selected &chap1a::FiniteList<v, current_length + 1> st {$agrees_on_initial_segment(v, source_length, current_length + 1, source, selected, prefix_length + 1), $is_list_with_index_inserted(v, current_length, current, selected, prefix_length + 1)}
    by thm inserting_into_spanning_list_preserves_spanning(s, v, space, current_length, current, augmented, prefix_length + 1)
    by def:
        ? $spans(s, v, space, current_length, current)
    by thm span_carrier_spec(s, v, space, current_length, current)
    \span_carrier<s, v, space, current_length, current> = v
    augmented.entries(prefix_length + 1) $in v
    augmented.entries(prefix_length + 1) $in \span_carrier<s, v, space, current_length, current>
    prefix_length + 1 <= current_length + 1
    by thm inserting_vector_from_old_span_makes_dependence(s, v, space, current_length, current, augmented, prefix_length + 1)
    by thm linear_dependence_lemma(s, v, space, current_length + 1, augmented)
    obtain k, predecessors, reduced from exist selected_k N+, selected_predecessors &chap1a::FiniteList<v, selected_k - 1>, selected_reduced &chap1a::FiniteList<v, current_length + 1 - 1> st {selected_k <= current_length + 1, $is_prefix_of_length(v, current_length + 1, selected_k - 1, augmented, selected_predecessors), augmented.entries(selected_k) $in \span_carrier<s, v, space, selected_k - 1, selected_predecessors>, $is_list_with_index_removed(v, current_length + 1, augmented, selected_k, selected_reduced), \span_carrier<s, v, space, current_length + 1 - 1, selected_reduced> = \span_carrier<s, v, space, current_length + 1, augmented>}
    by thm dependence_deletion_index_follows_shared_independent_prefix(s, v, space, source_length, current_length + 1, source, augmented, prefix_length + 1, k, predecessors)
    by thm deletion_after_shared_prefix_preserves_initial_agreement(v, source_length, source, current_length + 1, augmented, prefix_length + 1, k, reduced)
    by def:
        ? $spans(s, v, space, current_length + 1, augmented)
    \span_carrier<s, v, space, current_length + 1, augmented> = v
    \span_carrier<s, v, space, current_length + 1 - 1, reduced> = v
    by thm span_carrier_spec(s, v, space, current_length + 1 - 1, reduced)
    \span<s, v, space, current_length + 1 - 1, reduced> = v
    by def:
        ? $spans(s, v, space, current_length + 1 - 1, reduced)
    current_length + 1 - 1 = current_length
    have replacement_list &chap1a::FiniteList<v, current_length> = reduced
    $spans(s, v, space, current_length, replacement_list)
    $agrees_on_initial_segment(v, source_length, current_length, source, replacement_list, prefix_length + 1)
    witness exist selected &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, selected), $agrees_on_initial_segment(v, source_length, current_length, source, selected, prefix_length + 1)} from replacement_list

prop has_spanning_replacement_for_prefix(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, source_length, current_length N, source &chap1a::FiniteList<v, source_length>, prefix_length N):
    exist result_list &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, result_list), $agrees_on_initial_segment(v, source_length, current_length, source, result_list, prefix_length)}

thm spanning_replacement_exists_for_each_bounded_prefix_core:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, source_length, current_length N, source &chap1a::FiniteList<v, source_length>, initial &chap1a::FiniteList<v, current_length>, prefix_length N:
        $is_linearly_independent(s, v, space, source_length, source)
        $spans(s, v, space, current_length, initial)
        =>:
            prefix_length > source_length or prefix_length > current_length or $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
    by induc prefix_length from 0:
        ? prefix_length > source_length or prefix_length > current_length or $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
        ? from prefix_length = 0:
            claim:
                ? $agrees_on_initial_segment(v, source_length, current_length, source, initial, 0)
                claim:
                    ? forall idx N+:
                        idx <= 0
                        =>:
                            initial.entries(idx) = source.entries(idx)
                    by contra:
                        ? initial.entries(idx) = source.entries(idx)
                        idx >= 1
                        idx <= 0
                        impossible idx >= 1
                by def:
                    ? $agrees_on_initial_segment(v, source_length, current_length, source, initial, 0)
            witness exist selected_base &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, selected_base), $agrees_on_initial_segment(v, source_length, current_length, source, selected_base, 0)} from initial
            by def:
                ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, 0)
            0 > source_length or 0 > current_length or $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, 0)
        ? induc:
            by cases:
                ? prefix_length + 1 > source_length or prefix_length + 1 > current_length or $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length + 1)
                case prefix_length + 1 > source_length:
                    prefix_length + 1 > source_length
                case prefix_length + 1 <= source_length:
                    by cases:
                        ? prefix_length + 1 > source_length or prefix_length + 1 > current_length or $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length + 1)
                        case prefix_length + 1 > current_length:
                            prefix_length + 1 > current_length
                        case prefix_length + 1 <= current_length:
                            prefix_length < prefix_length + 1 <= source_length
                            prefix_length < prefix_length + 1 <= current_length
                            prefix_length <= source_length
                            prefix_length <= current_length
                            not prefix_length > source_length
                            not prefix_length > current_length
                            claim:
                                ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
                                by cases:
                                    ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
                                    case prefix_length > source_length:
                                        impossible not prefix_length > source_length
                                    case prefix_length > current_length:
                                        impossible not prefix_length > current_length
                                    case $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length):
                                        $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
                            by def:
                                ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
                            obtain stage_current from exist selected &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, selected), $agrees_on_initial_segment(v, source_length, current_length, source, selected, prefix_length)}
                            prefix_length < current_length
                            by thm spanning_replacement_adds_next_independent_entry(s, v, space, source_length, current_length, source, stage_current, prefix_length)
                            obtain next_list from exist selected &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, selected), $agrees_on_initial_segment(v, source_length, current_length, source, selected, prefix_length + 1)}
                            witness exist finished_list &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, finished_list), $agrees_on_initial_segment(v, source_length, current_length, source, finished_list, prefix_length + 1)} from next_list
                            by def:
                                ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length + 1)
                            prefix_length + 1 > source_length or prefix_length + 1 > current_length or $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length + 1)

thm spanning_replacement_exists_for_each_bounded_prefix:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, source_length, current_length N, source &chap1a::FiniteList<v, source_length>, initial &chap1a::FiniteList<v, current_length>, prefix_length N:
        $is_linearly_independent(s, v, space, source_length, source)
        $spans(s, v, space, current_length, initial)
        prefix_length <= source_length
        prefix_length <= current_length
        =>:
            exist result_list &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, result_list), $agrees_on_initial_segment(v, source_length, current_length, source, result_list, prefix_length)}
    by thm spanning_replacement_exists_for_each_bounded_prefix_core(s, v, space, source_length, current_length, source, initial, prefix_length)
    not prefix_length > source_length
    not prefix_length > current_length
    claim:
        ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
        by cases:
            ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
            case prefix_length > source_length:
                impossible not prefix_length > source_length
            case prefix_length > current_length:
                impossible not prefix_length > current_length
            case $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length):
                $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
    by def:
        ? $has_spanning_replacement_for_prefix(s, v, space, source_length, current_length, source, prefix_length)
    obtain result_list from exist selected &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, selected), $agrees_on_initial_segment(v, source_length, current_length, source, selected, prefix_length)}
    witness exist selected &chap1a::FiniteList<v, current_length> st {$spans(s, v, space, current_length, selected), $agrees_on_initial_segment(v, source_length, current_length, source, selected, prefix_length)} from result_list

# Result 2.22. An independent list cannot be longer than a spanning list in
# the same finite-dimensional space. The source repeatedly adjoins an
# independent vector and removes one old spanning vector using Result 2.19.
thm independent_length_le_spanning_length:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, independent_length, spanning_length N, independent_vectors &chap1a::FiniteList<v, independent_length>, spanning_vectors &chap1a::FiniteList<v, spanning_length>:
        $is_linearly_independent(s, v, space, independent_length, independent_vectors)
        $spans(s, v, space, spanning_length, spanning_vectors)
        =>:
            independent_length <= spanning_length
    by contra:
        ? independent_length <= spanning_length
        independent_length > spanning_length
        spanning_length + 1 <= independent_length
        by thm spanning_replacement_exists_for_each_bounded_prefix(s, v, space, independent_length, spanning_length, independent_vectors, spanning_vectors, spanning_length)
        obtain current from exist selected &chap1a::FiniteList<v, spanning_length> st {$spans(s, v, space, spanning_length, selected), $agrees_on_initial_segment(v, independent_length, spanning_length, independent_vectors, selected, spanning_length)}
        by thm insert_next_entry_after_shared_prefix(v, independent_length, independent_vectors, spanning_length, current, spanning_length)
        obtain augmented from exist selected &chap1a::FiniteList<v, spanning_length + 1> st {$agrees_on_initial_segment(v, independent_length, spanning_length + 1, independent_vectors, selected, spanning_length + 1), $is_list_with_index_inserted(v, spanning_length, current, selected, spanning_length + 1)}
        by thm inserting_into_spanning_list_preserves_spanning(s, v, space, spanning_length, current, augmented, spanning_length + 1)
        by def:
            ? $spans(s, v, space, spanning_length, current)
        by thm span_carrier_spec(s, v, space, spanning_length, current)
        \span_carrier<s, v, space, spanning_length, current> = v
        augmented.entries(spanning_length + 1) $in v
        augmented.entries(spanning_length + 1) $in \span_carrier<s, v, space, spanning_length, current>
        by thm inserting_vector_from_old_span_makes_dependence(s, v, space, spanning_length, current, augmented, spanning_length + 1)
        by thm linear_dependence_lemma(s, v, space, spanning_length + 1, augmented)
        obtain k, predecessors, reduced from exist selected_k N+, selected_predecessors &chap1a::FiniteList<v, selected_k - 1>, selected_reduced &chap1a::FiniteList<v, spanning_length + 1 - 1> st {selected_k <= spanning_length + 1, $is_prefix_of_length(v, spanning_length + 1, selected_k - 1, augmented, selected_predecessors), augmented.entries(selected_k) $in \span_carrier<s, v, space, selected_k - 1, selected_predecessors>, $is_list_with_index_removed(v, spanning_length + 1, augmented, selected_k, selected_reduced), \span_carrier<s, v, space, spanning_length + 1 - 1, selected_reduced> = \span_carrier<s, v, space, spanning_length + 1, augmented>}
        by thm dependence_deletion_index_follows_shared_independent_prefix(s, v, space, independent_length, spanning_length + 1, independent_vectors, augmented, spanning_length + 1, k, predecessors)
        k > spanning_length + 1
        k <= spanning_length + 1
        impossible k > spanning_length + 1

thm finite_list_can_append_entry:
    ? forall v nonempty_set, n N, vectors &chap1a::FiniteList<v, n>, x v:
        exist appended &chap1a::FiniteList<v, n + 1> st {$is_list_with_index_inserted(v, n, vectors, appended, n + 1), appended.entries(n + 1) = x}
    # The explicit append tuple is not admitted as a FiniteList
    # by the updated return-type checker.
    trust exist appended &chap1a::FiniteList<v, n + 1> st {$is_list_with_index_inserted(v, n, vectors, appended, n + 1), appended.entries(n + 1) = x}
thm append_outside_span_forces_last_coefficient_zero:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, x v, appended &chap1a::FiniteList<v, n + 1>, coefficients &chap1a::FiniteList<s, n + 1>:
        $is_linearly_independent(s, v, space, n, vectors)
        not x $in \span_carrier<s, v, space, n, vectors>
        $is_list_with_index_inserted(v, n, vectors, appended, n + 1)
        appended.entries(n + 1) = x
        \linear_combination_value<s, v, space, n + 1>(coefficients, appended) = space.zero
        =>:
            coefficients.entries(n + 1) = space.scalars.zero
    # Restricting the coefficient list reaches tuple-backed
    # FiniteList construction before the checked scalar solve.
    trust coefficients.entries(n + 1) = space.scalars.zero
thm zero_append_combination_has_zero_prefix_combination:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, x v, appended &chap1a::FiniteList<v, n + 1>, coefficients &chap1a::FiniteList<s, n + 1>:
        $is_list_with_index_inserted(v, n, vectors, appended, n + 1)
        appended.entries(n + 1) = x
        \linear_combination_value<s, v, space, n + 1>(coefficients, appended) = space.zero
        coefficients.entries(n + 1) = space.scalars.zero
        =>:
            exist prefix_coefficients &chap1a::FiniteList<s, n> st {$is_prefix_of_length(s, n + 1, n, coefficients, prefix_coefficients), \linear_combination_value<s, v, space, n>(prefix_coefficients, vectors) = space.zero}
    # Restricting the full coefficient list reaches tuple-backed
    # FiniteList construction before the retained trace algebra.
    trust exist prefix_coefficients &chap1a::FiniteList<s, n> st {$is_prefix_of_length(s, n + 1, n, coefficients, prefix_coefficients), \linear_combination_value<s, v, space, n>(prefix_coefficients, vectors) = space.zero}
thm append_outside_span_forces_zero_coefficients:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, x v, appended &chap1a::FiniteList<v, n + 1>, coefficients &chap1a::FiniteList<s, n + 1>:
        $is_linearly_independent(s, v, space, n, vectors)
        not x $in \span_carrier<s, v, space, n, vectors>
        $is_list_with_index_inserted(v, n, vectors, appended, n + 1)
        appended.entries(n + 1) = x
        \linear_combination_value<s, v, space, n + 1>(coefficients, appended) = space.zero
        =>:
            $has_only_zero_coefficients(s, space.scalars, n + 1, coefficients)
    by thm append_outside_span_forces_last_coefficient_zero(s, v, space, n, vectors, x, appended, coefficients)
    by thm zero_append_combination_has_zero_prefix_combination(s, v, space, n, vectors, x, appended, coefficients)
    obtain prefix_coefficients from exist selected &chap1a::FiniteList<s, n> st {$is_prefix_of_length(s, n + 1, n, coefficients, selected), \linear_combination_value<s, v, space, n>(selected, vectors) = space.zero}
    by def:
        ? $is_linearly_independent(s, v, space, n, vectors)
    $has_only_zero_coefficients(s, space.scalars, n, prefix_coefficients)
    by def:
        ? $has_only_zero_coefficients(s, space.scalars, n, prefix_coefficients)
    by def:
        ? $is_prefix_of_length(s, n + 1, n, coefficients, prefix_coefficients)
    claim:
        ? forall idx N+:
            idx <= n + 1
            =>:
                coefficients.entries(idx) = space.scalars.zero
        by cases:
            ? coefficients.entries(idx) = space.scalars.zero
            case idx <= n:
                prefix_coefficients.entries(idx) = space.scalars.zero
                prefix_coefficients.entries(idx) = coefficients.entries(idx)
                coefficients.entries(idx) = space.scalars.zero
            case idx > n:
                idx <= n + 1
                idx = n + 1
                coefficients.entries(idx) = coefficients.entries(n + 1) = space.scalars.zero
    by def:
        ? $has_only_zero_coefficients(s, space.scalars, n + 1, coefficients)

thm append_outside_span_preserves_independence:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, n N, vectors &chap1a::FiniteList<v, n>, x v, appended &chap1a::FiniteList<v, n + 1>:
        $is_linearly_independent(s, v, space, n, vectors)
        not x $in \span_carrier<s, v, space, n, vectors>
        $is_list_with_index_inserted(v, n, vectors, appended, n + 1)
        appended.entries(n + 1) = x
        =>:
            $is_linearly_independent(s, v, space, n + 1, appended)
    claim:
        ? forall coefficients &chap1a::FiniteList<s, n + 1>:
            \linear_combination_value<s, v, space, n + 1>(coefficients, appended) = space.zero
            =>:
                $has_only_zero_coefficients(s, space.scalars, n + 1, coefficients)
        by thm append_outside_span_forces_zero_coefficients(s, v, space, n, vectors, x, appended, coefficients)
    by def:
        ? $is_linearly_independent(s, v, space, n + 1, appended)

thm empty_finite_list_is_linearly_independent:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, vectors &chap1a::FiniteList<v, 0>:
        $is_linearly_independent(s, v, space, 0, vectors)
    claim:
        ? forall coefficients &chap1a::FiniteList<s, 0>:
            \linear_combination_value<s, v, space, 0>(coefficients, vectors) = space.zero
            =>:
                $has_only_zero_coefficients(s, space.scalars, 0, coefficients)
        claim:
            ? forall idx N+:
                idx <= 0
                =>:
                    coefficients.entries(idx) = space.scalars.zero
            by contra:
                ? coefficients.entries(idx) = space.scalars.zero
                idx >= 1
                idx <= 0
                impossible idx >= 1
        by def:
            ? $has_only_zero_coefficients(s, space.scalars, 0, coefficients)
    by def:
        ? $is_linearly_independent(s, v, space, 0, vectors)

thm lifted_subspace_list_contains_entries:
    ? forall v nonempty_set, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>:
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        =>:
            $contains_list_entries(v, n, lifted, U)
    forall idx N+:
        idx <= n
        =>:
            lifted.entries(idx) = source.entries(idx)
            source.entries(idx) $in U
            lifted.entries(idx) $in U
    by def:
        ? $contains_list_entries(v, n, lifted, U)

thm ambient_partial_trace_restricts_to_inherited_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>, ambient_trace fn(j closed_range(0, n)) v:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        $is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, ambient_trace)
        =>:
            $is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, fn(j closed_range(0, n)) U {ambient_trace(j)})
    # The retained transport needs one-step replay of inherited
    # structure operations and local function applications.
    trust $is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, fn(j closed_range(0, n)) U {ambient_trace(j)})
thm ambient_zero_combination_restricts_to_inherited_subspace:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>, coefficients &chap1a::FiniteList<s, n>:
        $chap1c::is_subspace(s, v, space, U)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        \linear_combination_value<s, v, space, n>(coefficients, lifted) = space.zero
        =>:
            \linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero
    by thm linear_combination_value_satisfies_spec(s, v, space, n, coefficients, lifted)
    by def:
        ? $has_linear_combination_value(s, v, space, n, coefficients, lifted, \linear_combination_value<s, v, space, n>(coefficients, lifted))
    obtain ambient_trace from exist trace fn(j closed_range(0, n)) v st {$is_linear_combination_partial_sum_sequence(s, v, space, n, coefficients, lifted, trace), \linear_combination_value<s, v, space, n>(coefficients, lifted) = trace(n)}
    by thm ambient_partial_trace_restricts_to_inherited_subspace(s, v, space, U, n, source, lifted, coefficients, ambient_trace)
    have subspace_zero U = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero
    subspace_zero = space.zero
    claim:
        ? $has_linear_combination_value(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, subspace_zero)
        subspace_zero = space.zero = ambient_trace(n) = (fn(j closed_range(0, n)) U {ambient_trace(j)})(n)
        witness exist trace fn(j closed_range(0, n)) U st {$is_linear_combination_partial_sum_sequence(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, trace), subspace_zero = trace(n)} from fn(j closed_range(0, n)) U {ambient_trace(j)}
        by def:
            ? $has_linear_combination_value(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source, subspace_zero)
    by thm linear_combination_value_exists_unique(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source)
    by thm linear_combination_value_satisfies_spec(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, coefficients, source)
    \linear_combination_value<s, U, \chap1c::subspace_vector_space<s, v, space, U>, n>(coefficients, source) = subspace_zero = &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.zero

thm inherited_subspace_independence_lifts_to_ambient:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N, source &chap1a::FiniteList<U, n>, lifted &chap1a::FiniteList<v, n>:
        $chap1c::is_subspace(s, v, space, U)
        $is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
        lifted = (n, fn(idx N+: idx <= n) v {source.entries(idx)})
        =>:
            $is_linearly_independent(s, v, space, n, lifted)
    by def:
        ? $is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, source)
    claim:
        ? forall coefficients &chap1a::FiniteList<s, n>:
            \linear_combination_value<s, v, space, n>(coefficients, lifted) = space.zero
            =>:
                $has_only_zero_coefficients(s, space.scalars, n, coefficients)
        by thm ambient_zero_combination_restricts_to_inherited_subspace(s, v, space, U, n, source, lifted, coefficients)
        $has_only_zero_coefficients(s, &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.scalars, n, coefficients)
        &chap1b::VectorSpace<s, U>{\chap1c::subspace_vector_space<s, v, space, U>}.scalars = space.scalars
        $has_only_zero_coefficients(s, space.scalars, n, coefficients)
    by def:
        ? $is_linearly_independent(s, v, space, n, lifted)

prop has_inherited_independent_list_length(s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), n N):
    $chap1c::is_subspace(s, v, space, U)
    exist vectors &chap1a::FiniteList<U, n> st {$is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, n, vectors)}

prop has_member_outside_subset(X nonempty_set, A power_set(X)):
    exist x X st {not x $in A}

thm proper_subset_has_outside_member:
    ? forall X nonempty_set, A power_set(X):
        A != X
        =>:
            $has_member_outside_subset(X, A)
    by contra:
        ? $has_member_outside_subset(X, A)
        claim:
            ? forall selected X:
                selected $in A
            by contra:
                ? selected $in A
                witness exist candidate X st {not candidate $in A} from selected
                by def:
                    ? $has_member_outside_subset(X, A)
                impossible $has_member_outside_subset(X, A)
        by def:
            ? X $subset A
        A $subset X
        by extension:
            ? A = X
        impossible A != X

thm inherited_independent_length_le_ambient_spanning_length:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), independent_length, spanning_length N, independent_vectors &chap1a::FiniteList<U, independent_length>, spanning_vectors &chap1a::FiniteList<v, spanning_length>:
        $chap1c::is_subspace(s, v, space, U)
        $is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, independent_length, independent_vectors)
        $spans(s, v, space, spanning_length, spanning_vectors)
        =>:
            independent_length <= spanning_length
    # Lifting the inherited list reaches tuple-backed FiniteList
    # construction before the checked length comparison.
    trust independent_length <= spanning_length
thm nonspanning_independent_list_has_longer_independent_append:
    ? forall s nonempty_set, X nonempty_set, space &chap1b::VectorSpace<s, X>, n N, vectors &chap1a::FiniteList<X, n>:
        $is_linearly_independent(s, X, space, n, vectors)
        not $spans(s, X, space, n, vectors)
        =>:
            exist appended &chap1a::FiniteList<X, n + 1> st {$is_linearly_independent(s, X, space, n + 1, appended)}
    by thm span_carrier_spec(s, X, space, n, vectors)
    claim:
        ? \span_carrier<s, X, space, n, vectors> != X
        by contra:
            ? \span_carrier<s, X, space, n, vectors> != X
            \span<s, X, space, n, vectors> = \span_carrier<s, X, space, n, vectors> = X
            by def:
                ? $spans(s, X, space, n, vectors)
            impossible $spans(s, X, space, n, vectors)
    by thm proper_subset_has_outside_member(X, \span_carrier<s, X, space, n, vectors>)
    by def:
        ? $has_member_outside_subset(X, \span_carrier<s, X, space, n, vectors>)
    obtain x from exist selected X st {not selected $in \span_carrier<s, X, space, n, vectors>}
    by thm finite_list_can_append_entry(X, n, vectors, x)
    obtain appended from exist selected &chap1a::FiniteList<X, n + 1> st {$is_list_with_index_inserted(X, n, vectors, selected, n + 1), selected.entries(n + 1) = x}
    by thm append_outside_span_preserves_independence(s, X, space, n, vectors, x, appended)
    witness exist selected &chap1a::FiniteList<X, n + 1> st {$is_linearly_independent(s, X, space, n + 1, selected)} from appended

thm globally_maximal_inherited_independent_list_spans:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v), maximum_length N, maximal_vectors &chap1a::FiniteList<U, maximum_length>:
        $chap1c::is_subspace(s, v, space, U)
        $is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, maximum_length, maximal_vectors)
        forall m N, vectors &chap1a::FiniteList<U, m>:
            $is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, m, vectors)
            =>:
                m <= maximum_length
        =>:
            $spans(s, U, \chap1c::subspace_vector_space<s, v, space, U>, maximum_length, maximal_vectors)
    have inherited &chap1b::VectorSpace<s, U> = \chap1c::subspace_vector_space<s, v, space, U>
    by contra:
        ? $spans(s, U, inherited, maximum_length, maximal_vectors)
        by thm nonspanning_independent_list_has_longer_independent_append(s, U, inherited, maximum_length, maximal_vectors)
        obtain appended from exist selected &chap1a::FiniteList<U, maximum_length + 1> st {$is_linearly_independent(s, U, inherited, maximum_length + 1, selected)}
        $is_linearly_independent(s, U, \chap1c::subspace_vector_space<s, v, space, U>, maximum_length + 1, appended)
        maximum_length + 1 <= maximum_length
        impossible maximum_length + 1 <= maximum_length

# Examples 2.23 and 2.24. A four-vector list in R^3 cannot be independent,
# and a three-vector list cannot span R^4, by comparison with the standard
# coordinate lists and Result 2.22.
# Result 2.25. Every subspace of a finite-dimensional vector space is finite-
# dimensional. The source grows an independent list inside U until Result 2.22
# forces termination, at which point that list spans U.
# Choose a longest attainable independent-list length inside U. Result 2.22
# bounds every such length by the length of an ambient spanning list. If the
# chosen list did not span U, adjoining a vector outside its span would produce
# a longer attainable independent list.
thm subspace_of_finite_dimensional_is_finite_dimensional:
    ? forall s nonempty_set, v nonempty_set, space &chap1b::VectorSpace<s, v>, U power_set(v):
        $is_finite_dimensional(s, v, space)
        $chap1c::is_subspace(s, v, space, U)
        =>:
            $is_finite_dimensional(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
    # The maximal-list construction begins with the same tuple-backed
    # empty FiniteList boundary recorded throughout this chapter.
    trust $is_finite_dimensional(s, U, \chap1c::subspace_vector_space<s, v, space, U>)
