# Tracer: define and call native unary functions through exact membership and
# retained source-domain proofs.
#
# Before (Litex verified, but compiler emission stopped):
# have fn inc(x R) R = x + 1
# inc(1) = 1 + 1
# have fn reciprocal(x R: x != 0) R = 1 / x
# Former behavior: the emitter accepted only an identity body and rejected
# every source-domain clause.
#
# Now (verified and compiled):
have fn id(x R) R = x
id(1) = 1

have fn inc(x R) R = x + 1
inc(1) = 1 + 1

have fn reciprocal(x R: x != 0) R = 1 / x
forall a R:
    a != 0
    =>:
        reciprocal(a) = 1 / a
# The archived compiler also supported a predicate-defined return carrier.
have fn into_builder(x R) {z R: z = z} = x
into_builder(1) = 1
# Current behavior: unary signatures use `Litex.Fn`/`Litex.FnWhere`; dependent
# or non-base return carriers use the exact `Litex.FnTelescope`. Construction
# selects the return carrier with the verifier's retained membership proof,
# and reduction follows that same representative through `Litex.In.same_rep`.
# Every application consumes its function membership, argument membership,
# and (for reciprocal) exact nonzero FactId.
#
# Boundary: a body not verified in its declared return set remains fail-closed.
# Evidence: target/release/litex -strict -graph -f lean/examples/12_NamedFunction.lit
# and cargo test --release --test stmt_result_to_lean_compiler_tracers
