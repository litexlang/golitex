# Transfer a right limit through abs, retaining the complete function domains.
thm right_abs_limit:
    ? forall f,g fn(x R) R, p,L R:
        $has_limit_right(f,p,L)
        forall x R:
            g(x)=abs(f(x))
        =>:
            $has_limit_right(g,p,abs(L))
    by thm fn_limit_right_abs(f,g,p,L) => $has_limit_right(g,p,abs(L))
