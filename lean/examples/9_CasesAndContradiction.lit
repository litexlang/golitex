# Tracer: verifier-owned case and contradiction scopes
#
# Before: `by cases` and `by contra` had structured IR but no native-carrier
# proof adapter.
#
# Now: each case assumption and reverse assumption is installed only in its
# cloned Lean proof context, and every conclusion replays exact FactId evidence.
#
# The same tracer also covers structured conjunction assumptions, a negated
# order goal introduced by classical double negation, nested case/contra
# blocks, and branch-local WD replay for a checked function application.
#
# Evidence:
# target/release/litex -compact -strict -runner -f lean/examples/9_CasesAndContradiction.lit
# cd lean && ./stmt_result_to_lean_compiler.sh compile examples/9_CasesAndContradiction.lit
# cd lean && ./stmt_result_to_lean_compiler.sh check examples

thm cases_and_contra:
    ? forall:
        2 = 2
    by cases:
        ? 1 = 1
        case 1 = 1:
            by contra:
                ? 2 = 2
                impossible 2 != 2

by cases:
    ? 2 = 2
    case 1 = 1 and 2 = 2:
        1 = 1

by contra:
    ? not 2 < 1
    impossible 2 < 1

have fn branch_identity(x R) R = x

by cases:
    ? branch_identity(1) = branch_identity(1)
    case 1 = 1:
        by contra:
            ? 2 = 2
            impossible 2 != 2
        1 $in R

by contra:
    ? 3 = 3
    by cases:
        ? 4 = 4
        case 4 = 4:
            5 = 5
    impossible 3 != 3
