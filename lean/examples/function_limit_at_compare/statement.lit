# A local weak comparison passes to the two at limit values.
thm at_limits_compare:
    ? forall f,g fn(x R) R, p,a,b R, r R+:
        $has_limit_at(f,p,a)
        $has_limit_at(g,p,b)
        forall x {t R:0<(abs(t-p)) and (abs(t-p))<r}:
            f(x)<=g(x)
        =>:
            a<=b
    by thm fn_limit_at_compare(f,g,p,a,b,r) => a<=b
