# Transfer two right limits through multiply on the same complete domain.
thm right_multiply_limits:
    ? forall f,g,s fn(x R) R, p,a,b R:
        $has_limit_right(f,p,a)
        $has_limit_right(g,p,b)
        forall x R:
            s(x)=f(x)*g(x)
        =>:
            $has_limit_right(s,p,a*b)
    by thm fn_limit_right_multiply(f,g,s,p,a,b) => $has_limit_right(s,p,a*b)
