# Transfer a left limit through scale with its original parameter evidence.
thm left_scale_limit:
    ? forall f,g fn(x R) R, p,L,c R:
        $has_limit_left(f,p,L)
        forall x R:
            g(x)=c*f(x)
        =>:
            $has_limit_left(g,p,c*L)
    by thm fn_limit_left_scale(f,g,p,L,c) => $has_limit_left(g,p,c*L)
