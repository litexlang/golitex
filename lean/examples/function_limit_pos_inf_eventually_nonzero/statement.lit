# A nonzero limit gives nonzero values on a sufficiently small pos_inf neighborhood.
thm pos_inf_eventually_nonzero:
    ? forall f fn(x R) R, L R:
        $has_limit_pos_inf(f,L)
        L!=0
        =>:
            exist delta R st {{x R:delta<x} $subset preimage_set(f,R*)}
    release thm fn_limit_pos_inf_eventually_nonzero(f,L)
