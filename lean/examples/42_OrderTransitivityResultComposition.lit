# Tracer: typed order-transitivity Result composition.
#
# The verifier owns carrier checks followed by two ordered comparison Results.
# StmtResultToLeanCompiler reads those children in their retained order while
# the enclosing forall environment exposes the three local premise FactIds.
forall a, b, c R:
    a <= b
    b <= c
    =>:
        a <= c

forall a, b, c R:
    a < b
    b <= c
    =>:
        a < c

forall a, b, c R:
    a <= b
    b < c
    =>:
        a < c

# Boundary: reversing the two comparison children breaks the retained path
# a -> b -> c and is rejected before a Lean term is emitted.
