# Minimum and maximum bound their operands and preserve coordinatewise weak order.
forall a, b R:
    min(a, b) <= a
    min(a, b) <= b
    a <= max(a, b)
    b <= max(a, b)

forall a, b, c, d R:
    a <= c
    b <= d
    =>:
        min(a, b) <= min(c, d)
        max(a, b) <= max(c, d)

forall a, b, c R:
    a <= b
    =>:
        min(a, c) <= min(b, c)
        max(c, a) <= max(c, b)
