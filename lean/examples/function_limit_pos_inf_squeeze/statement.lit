# A local two-sided bound transfers a common infinite-approach limit.
thm pos_inf_squeezed_limit:
    ? forall f,g,h fn(x R) R, L,r R:
        $has_limit_pos_inf(f,L)
        $has_limit_pos_inf(h,L)
        forall x {t R:r<t}:
            f(x)<=g(x)<=h(x)
        =>:
            $has_limit_pos_inf(g,L)
    release thm fn_limit_pos_inf_squeeze(f,g,h,L,r)
