# Registered local builtins are compiled from stable rule evidence and their
# ordered recursive child Results. No diagnostic label or Runtime lookup
# selects these Lean proofs.

forall u, v R:
    v <= u
    =>:
        0 <= u - v

forall u, v R:
    v < u
    =>:
        0 < u - v

forall a, b R:
    a > b
    =>:
        a >= b
