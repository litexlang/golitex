# Evaluate empty sums/products and exact rational aggregates over finite sets.
eval finite_set_sum({}, fn(x Z) Z {x})
finite_set_sum({}, fn(x Z) Z {x}) = 0
eval finite_set_product({}, fn(x Z) Z {x})
finite_set_product({}, fn(x Z) Z {x}) = 1
eval finite_set_sum({1 / 3, 1 / 2}, fn(x Q) Q {x})
finite_set_sum({1 / 3, 1 / 2}, fn(x Q) Q {x}) = 5 / 6
eval finite_set_product({1 / 3, 1 / 2}, fn(x Q) Q {x})
finite_set_product({1 / 3, 1 / 2}, fn(x Q) Q {x}) = 1 / 6
