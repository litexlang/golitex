# Derive and cite inclusion and distinctness from proper inclusion.
by def {1,2} $proper_subset {1,2,3}
by def {1,2,3} $proper_superset {1,2}
R $superset N

thm phase12_set_transfer:
    ? forall A, B set:
        A $proper_subset B
        =>:
            A $subset B
            A != B

by thm phase12_set_transfer({1,2}, {1,2,3}) => {1,2} $subset {1,2,3}

forall A, B set:
    A $proper_superset B
    =>:
        B $subset A
        A != B
