# Evaluate a rounding function and a two-argument real expression.
have fn evaluated_real_round(x R) Z = floor(x)
eval evaluated_real_round(-7/3)
evaluated_real_round(-7/3) = -3
have fn evaluated_real_clip(x R,y R) R = max(abs(x),min(y,2))
eval evaluated_real_clip(-3/2,5/2)
evaluated_real_clip(-3/2,5/2) = 2
eval floor(evaluated_real_clip(-3/2,5/2) + 1/3)
floor(evaluated_real_clip(-3/2,5/2) + 1/3) = 2
