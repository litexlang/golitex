# Tracer: named theorem, claim, and example proof scopes
#
# Before (unsupported by the native-carrier emitter):
# thm one_eq_one:
#     ? forall:
#         1 = 1
#
# Now: zero-binder and standard-set-binder theorem Results, ordinary claim,
# and ordinary example Results are read recursively. Parameter FactIds live
# only in the theorem compiler environment; proof-step Results become local
# Lean `have` declarations; and `by thm` cites the theorem's exact outer
# FactId before publishing its instantiated conclusion FactId.
#
# Boundary: forall examples, dependent/refined theorem binders, non-atomic
# theorem conclusions, theorem domain premises/projections, and unreviewed
# local statement kinds still use an explicit compatibility path or fail
# closed.
#
# Evidence:
# target/release/litex -compact -strict -runner -f lean/examples/8_ProofScopes.lit
# cd lean && ./stmt_result_to_lean_compiler.sh compile examples/8_ProofScopes.lit
# cd lean && ./stmt_result_to_lean_compiler.sh check examples

thm one_eq_one:
    ? forall:
        1 = 1

thm local_reflexivity:
    ? forall x R:
        x = x
    x = x

by thm local_reflexivity(1)

claim:
    ? 2 = 2
    2 = 2

example:
    ? 3 = 3
    3 = 3
