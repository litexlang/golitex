# A local weak comparison passes to the two right limit values.
thm right_limits_compare:
    ? forall f,g fn(x R) R, p,a,b R, r R+:
        $has_limit_right(f,p,a)
        $has_limit_right(g,p,b)
        forall x {t R:0<(t-p) and (t-p)<r}:
            f(x)<=g(x)
        =>:
            a<=b
    by thm fn_limit_right_compare(f,g,p,a,b,r) => a<=b
