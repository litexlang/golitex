# Extract the right limit control certificate on the original real domain.
thm explicit_right_control:
    ? forall f fn(x R) R, p R, L R, epsilon R+:
        $has_limit_right(f,p,L)
        =>:
            exist threshold R+ st {{x R:0<(x-p) and (x-p)<threshold} $subset preimage_set(f,{v R:abs(v-L)<epsilon})}
    release thm fn_limit_right_control(f,p,L,epsilon)
