# Tracer: native real-arithmetic closure replays exact verifier evidence.
#
# Before (Litex verified, but compiler emission stopped):
# forall a, b R:
#     a * b $in R
# Former compiler behavior: fail closed at
# `RealArithmeticMembershipClosure(Mul)`.
#
# Now `+`, `-`, `*`, and `/` closure each call a proved native-carrier rule;
# division retains its source denominator well-definedness separately.
forall a, b R:
    a + b $in R

forall a, b R:
    a - b $in R

forall a, b R:
    a * b $in R

forall a, b R:
    b != 0
    =>:
        a / b $in R

forall a, b, c, d R:
    a > 0
    b >= 0
    c >= 0
    d >= 0
    =>:
        (a + b) + (c + d) > 0

# The symmetric right-strict route retains both its direct builtin certificate
# and the registered inner-sum rule selected by the recursive strategy.
forall a, b, c, d R:
    a >= 0
    b >= 0
    c >= 0
    d > 0
    =>:
        (a + b) + (c + d) > 0

# Before (Litex verified, but compiler emission stopped):
# forall a, b R:
#     a >= 0
#     b >= 0
#     =>:
#         a * b >= 0
# Former compiler behavior: fail closed at `MulNonnegative` because `0 <= x`
# selected an unrelated real representative for source zero.
#
# Now zero-ended comparisons lower to `Litex.Positive` / `Litex.Nonnegative`.
# Their zero is Mathlib's canonical real zero, while the source value retains
# one explicit `AsReal` witness. Direct and registered multiplication/division
# certificates therefore replay through proved Mathlib sign theorems without
# `RealCoherence` or a project axiom.
forall a, b R:
    a >= 0
    b >= 0
    =>:
        a * b >= 0

forall a, b R:
    a > 0
    b > 0
    =>:
        a * b > 0

forall a, b R:
    a >= 0
    b > 0
    =>:
        a / b >= 0

forall a, b R:
    a > 0
    b > 0
    =>:
        a / b > 0

# Boundary (Litex verifies; compiler remains fail-closed):
# forall a, b R:
#     a <= b
#     =>:
#         b - a >= 0
# `SubNonnegativeFromLessEqual` is a separate certificate family and remains
# executable as the nearest negative Rust regression until its adapter lands.
# Evidence: target/release/litex -compact -strict -runner -f lean/examples/15_BuiltinStrategy.lit
# and cargo test --release --test stmt_result_to_lean_compiler_tracers
