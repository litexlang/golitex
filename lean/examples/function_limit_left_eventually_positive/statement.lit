# A positive limit gives positive values on a sufficiently small left neighborhood.
thm left_eventually_positive:
    ? forall f fn(x R) R, p,L R:
        $has_limit_left(f,p,L)
        0<L
        =>:
            exist delta R+ st {{x R:0<(p-x) and (p-x)<delta} $subset preimage_set(f,R+)}
    release thm fn_limit_left_eventually_positive(f,p,L)
