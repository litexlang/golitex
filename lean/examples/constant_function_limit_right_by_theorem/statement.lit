# A constant function has the stated right limit on an accumulating domain.
claim:
    ? forall f fn(x R) R, p R, L R:
        forall r R+:
            exist x R st {0 < (x-p) and (x-p) < r}
        forall x R:
            f(x)=L
        =>:
            $has_limit_right(f,p,L)
    by thm fn_limit_right_constant(f,p,L) => $has_limit_right(f,p,L)
