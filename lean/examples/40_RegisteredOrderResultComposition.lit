# Tracer: registered additive-order Result composition
#
# Before: Litex verification succeeded, but StmtResultToLeanCompiler delegated
# these registered order certificates to the mirrored compatibility proof IR.
#
# Now: the compiler enters each forall-owned child environment and consumes
# the exact RuleId, semantic fingerprint, parameter-check Results, and ordered
# comparison-child Results directly from SuccessStmtResult.
forall a, b, c, d R:
    a <= b
    c <= d
    =>:
        a + c <= b + d

forall u, a, b R:
    a <= b
    =>:
        u + a <= u + b

forall a, b, c, d R:
    a < b
    c < d
    =>:
        a + c < b + d

forall u, a, b R:
    a < b
    =>:
        u + a < u + b

forall a, b, c, d R:
    a < b
    c <= d
    =>:
        a + c < b + d

forall a, b, c, d R:
    a <= b
    c < d
    =>:
        a + c < b + d

# Boundary: swapping the two semantic child Results or changing the retained
# registry fingerprint fails before any Lean source is published.
