# Tracer: `clear` is an ordinary definition name.
#
# Before: Litex and StmtResultToLeanCompiler treated `clear` as an environment
# command with a dedicated Result and target namespace transition.
#
# Now: the spelling is not reserved. It follows the ordinary object-definition
# and fact-compilation path without any compiler-environment side effect.
have clear R = 1
clear = 1

# Boundary: a bare `clear` source line is an ordinary fact-shaped statement and
# fails when no such fact is known; it never resets either environment.
