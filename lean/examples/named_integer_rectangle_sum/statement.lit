# Prove a finite integer sum bound by local enumeration and reuse it.
thm rectangle_sum_checked:
    ? forall x range(0, 3), y range(1, 3):
        x + y <= 4
    by for:
        ? forall u range(0, 3), v range(1, 3):
            u + v <= 4
        u + v <= 4

by thm rectangle_sum_checked(2, 2) => 2 + 2 <= 4
