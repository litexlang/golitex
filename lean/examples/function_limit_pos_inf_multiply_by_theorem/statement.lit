# Transfer two pos_inf limits through multiply on the same complete domain.
thm pos_inf_multiply_limits:
    ? forall f,g,s fn(x R) R, a,b R:
        $has_limit_pos_inf(f,a)
        $has_limit_pos_inf(g,b)
        forall x R:
            s(x)=f(x)*g(x)
        =>:
            $has_limit_pos_inf(s,a*b)
    by thm fn_limit_pos_inf_multiply(f,g,s,a,b) => $has_limit_pos_inf(s,a*b)
