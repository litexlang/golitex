# Directional unboundedness and epsilon control prove a limit at positive infinity.
thm checked_pos_infinite_limit_intro:
    ? forall f fn(x R:x != 0) R, L R:
        forall T R:
            exist x {s R:s != 0} st {T < x}
        forall epsilon R+:
            exist T R st {{x {s R:s != 0}: T < x} $subset preimage_set(f,{v R: abs(v-L) < epsilon})}
        =>:
            $has_limit_pos_inf(f,L)
    by def $has_limit_pos_inf(f,L)
