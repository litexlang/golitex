# A local two-sided bound transfers a common finite-approach limit.
thm at_squeezed_limit:
    ? forall f,g,h fn(x R) R, p,L R, r R+:
        $has_limit_at(f,p,L)
        $has_limit_at(h,p,L)
        forall x {t R:0<(abs(t-p)) and (abs(t-p))<r}:
            f(x)<=g(x)<=h(x)
        =>:
            $has_limit_at(g,p,L)
    release thm fn_limit_at_squeeze(f,g,h,p,L,r)
