# Transfer two at limits through add on the same complete domain.
thm at_add_limits:
    ? forall f,g,s fn(x R) R, p,a,b R:
        $has_limit_at(f,p,a)
        $has_limit_at(g,p,b)
        forall x R:
            s(x)=f(x)+g(x)
        =>:
            $has_limit_at(s,p,a+b)
    by thm fn_limit_at_add(f,g,s,p,a,b) => $has_limit_at(s,p,a+b)
