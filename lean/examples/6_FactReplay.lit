# Tracer: compiler FactId replay
#
# Before (not in the persistent compiler ledger):
# forall a, b, c set:
#     a = b
#     b = c
#     =>:
#         a = c
# Former limitation: exact known-equality paths, negated-equality symmetry,
# and alpha-equivalent forall citation were covered only by Rust tests and
# disposable probes, not by a generated same-name .lit/.lean pair.
#
# Now: execution first emits the complete recursive
# SuccessStmtResult::Fact(SuccessFactStmtResult::ForallFact { .. }) sequence; the
# compiler then replays verifier-owned FactIds through Litex.Same.symm/trans,
# Litex.Rules.notSameSymm, and an exact previously emitted forall theorem.
#
# Boundary: a closed semantic inequality such as `1 != 0`, proof evidence
# without a replay adapter, and an unavailable or retargeted FactId remain
# fail-closed; unsupported evidence now fails while the compiler consumes the
# recursive statement Result.
#
# Evidence:
# target/release/litex -compact -strict -graph -f lean/examples/6_FactReplay.lit
# target/release/litex -isolated -f lean/examples/6_FactReplay.lit -lean lean/examples/6_FactReplay.lean
# cd lean && ./stmt_result_to_lean_compiler.sh check examples

forall a, b set:
    a = b
    =>:
        b = a

forall a, b, c set:
    a = b
    b = c
    =>:
        a = c

forall a, b set:
    a != b
    =>:
        b != a

forall x, y set:
    x = y
    =>:
        y = x
