# Combine three real bounds in two steps and reuse the resulting theorem.
thm sum_three_bounds:
    ? forall tri_a, tri_b, tri_c, tri_d, tri_e, tri_f R:
        tri_a <= tri_b
        tri_c <= tri_d
        tri_e < tri_f
        =>:
            (tri_a + tri_c) + tri_e < (tri_b + tri_d) + tri_f
    tri_a + tri_c <= tri_b + tri_d
    (tri_a + tri_c) + tri_e < (tri_b + tri_d) + tri_f

by thm sum_three_bounds(1, 2, 3, 4, 5, 6) => (1 + 3) + 5 < (2 + 4) + 6
