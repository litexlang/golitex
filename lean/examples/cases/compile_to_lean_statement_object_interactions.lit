# Before: each basis feature worked independently; their three scope/ownership
# interactions had no shared executable tracer.
# Now: witness-as-argument, cases-in-theorem, and set-builder-return compose.
have fn id(x R) R = x
witness exist x R st {x = 1} from 1:
    1 = 1
obtain y from exist x R st {x = 1}
id(y) = y

thm one_eq_one_by_cases:
    ? forall:
        1 = 1
    by cases:
        ? 1 = 1
        case 1 = 1

have fn into_builder(x R) {z R: z = z} = x
into_builder(1) = 1
# Boundary: these interactions reuse the basis interfaces; no special
# witness-function, theorem-case, or function-builder escape hatch exists.
