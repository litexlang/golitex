# Tracer: one-witness existential introduction and elimination
#
# Before (retired universal-object shape):
# # `x` and every obtained witness were forced through `Litex.Object`.
# witness exist x R st {x = 1} from 1:
#     1 = 1
#
# Now: `SuccessWitnessExistFactResult` is read directly. Its proof steps,
# parameter check, body check, and outer FactId are combined in one inherited
# StmtResult-to-Lean compiler environment. An existential over a standard
# numeric set uses a native `x : C` term plus explicit `Litex.In x R`. For an
# arbitrary source set S, both the input `a` and the existential witness retain
# independent Lean carriers; membership, not Lean typing, is the authority.
# Elimination selects the native witness and projects its membership/body facts
# from the cited existential FactId. Explicit `obtain`, `have ...:` with an
# existential body, concrete-predicate-backed `obtain`, and theorem-backed
# `obtain` are four adapters around the same recursive elimination Result. The
# concrete predicate source additionally retains its exact
# DefinitionProjection child proof. The theorem source retains a nested
# SuccessByThmStmtResult whose local conclusion proof is consumed by `obtain`
# without publishing that temporary FactId into the parent compiler scope.
#
# Boundary: one positive witness with one body fact is supported. `exist!`,
# `not exist`, multiple witnesses, and inverse transport remain fail-closed.
#
# Evidence:
# target/release/litex -compact -strict -runner -f lean/examples/10_ExistentialWitness.lit
# cd lean && ./stmt_result_to_lean_compiler.sh compile examples/10_ExistentialWitness.lit
# cd lean && ./stmt_result_to_lean_compiler.sh check examples

thm member_has_witness:
    ? forall S set, a S:
        exist x S st {x = a}
    witness exist x S st {x = a} from a:
        a = a

witness exist x R st {x = 1} from 1:
    1 = 1
obtain y from exist x R st {x = 1}

have selected R:
    selected = 1

prop has_copy(a R):
    exist x R st {x = a}

witness exist x R st {x = 2} from 2:
    2 = 2
by def $has_copy(2)
obtain copy from $has_copy(2)

thm self_exists:
    ? forall a R:
        exist x R st {x = a}
    witness exist x R st {x = a} from a:
        a = a

obtain theorem_copy from thm self_exists(3)
