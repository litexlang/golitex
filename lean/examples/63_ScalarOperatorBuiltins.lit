# Tracer: exact abs/min/max object representations and typed rules.
#
# These variable statements exercise stable Rust rule IDs, not closed numeric
# normalization. Their Lean proofs replay ordered semantic-premise
# Results into Mathlib norm and real-lattice theorems.
forall x, y R:
    abs(x * y) = abs(x) * abs(y)
    abs(x + y) <= abs(x) + abs(y)
    abs(x - y) <= abs(x) + abs(y)
    abs(x) - abs(y) <= abs(x + y)
    abs(x) - abs(y) <= abs(x - y)

forall x R:
    0 <= abs(x)
    -abs(x) <= x
    -x <= abs(x)
    x <= abs(x)

forall a, b R:
    min(a, b) <= a
    min(a, b) <= b
    a <= max(a, b)
    b <= max(a, b)
    min(a, b) = min(b, a)
    max(a, b) = max(b, a)
    min(a, max(a, b)) = a
    max(a, min(a, b)) = a

forall a R:
    min(a, a) = a
    max(a, a) = a

forall a, b, c R:
    min(min(a, b), c) = min(a, min(b, c))
    max(max(a, b), c) = max(a, max(b, c))

forall a, b R:
    a <= b
    =>:
        min(a, b) = a
        max(a, b) = b

forall a, b, c, d R:
    a <= c
    b <= d
    =>:
        min(a, b) <= min(c, d)
        max(a, b) <= max(c, d)

forall x R:
    0 <= x
    =>:
        abs(x) = x

forall x R:
    x <= 0
    =>:
        abs(x) = -x

forall x R:
    x != 0
    =>:
        0 < abs(x)

forall a, b R:
    0 <= b
    =>:
        a <= a + b

forall a, b, c R:
    a <= b
    0 <= c
    =>:
        a - c <= b
