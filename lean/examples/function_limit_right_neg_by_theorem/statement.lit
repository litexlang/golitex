# Transfer a right limit through neg, retaining the complete function domains.
thm right_neg_limit:
    ? forall f,g fn(x R) R, p,L R:
        $has_limit_right(f,p,L)
        forall x R:
            g(x)=-f(x)
        =>:
            $has_limit_right(g,p,-L)
    by thm fn_limit_right_neg(f,g,p,L) => $has_limit_right(g,p,-L)
