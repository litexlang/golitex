# An epsilon-tail inclusion supplies the claimed real limit of a sequence.
thm checked_sequence_limit_intro:
    ? forall a seq(R), L R:
        forall epsilon R+:
            exist cutoff N+ st {{n N+:n>=cutoff} $subset preimage_set(a,{v R:abs(v-L)<epsilon})}
        =>:
            $has_seq_limit(a,L)
    by def $has_seq_limit(a,L)
