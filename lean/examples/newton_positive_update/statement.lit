# Newton's update preserves positive real inputs and makes every division legal.
claim:
    ? forall x R+:
        (x + 2 / x) / 2 $in R+
    x > 0
    x != 0
    2 / x > 0
    x + 2 / x > 0
    (x + 2 / x) / 2 > 0

have fn newton_sqrt_two(x R+) R+ = (x + 2 / x) / 2

forall x R+:
    newton_sqrt_two(x) $in R+

newton_sqrt_two(1) $in R+
newton_sqrt_two(1) = 3 / 2
