# Transfer a left limit through power with its original parameter evidence.
thm left_power_limit:
    ? forall f,g fn(x R) R, p,L R:
        $has_limit_left(f,p,L)
        forall x R:
            g(x)=f(x)^2
        =>:
            $has_limit_left(g,p,L^2)
    by thm fn_limit_left_power(f,g,p,L,2) => $has_limit_left(g,p,L^2)
