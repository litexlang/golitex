# Cancel a certified nonzero common factor in each operand position and in nested rational products.

forall a,b,k R:
    k!=0
    a*k=b*k
    =>:
        a=b

forall a,b,k C:
    k!=0
    a*k=k*b
    =>:
        a=b

forall a,b,k C:
    k!=0
    k*a=b*k
    =>:
        a=b

forall a,b,k R:
    k!=0
    k*a=k*b
    =>:
        a=b

forall a,b,x,y Q:
    x!=0
    y!=0
    (a*x)*y=(b*x)*y
    =>:
        a*x=b*x
        a=b
