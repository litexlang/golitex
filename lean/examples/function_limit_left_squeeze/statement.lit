# A local two-sided bound transfers a common finite-approach limit.
thm left_squeezed_limit:
    ? forall f,g,h fn(x R) R, p,L R, r R+:
        $has_limit_left(f,p,L)
        $has_limit_left(h,p,L)
        forall x {t R:0<p-t and p-t<r}:
            f(x)<=g(x)<=h(x)
        =>:
            $has_limit_left(g,p,L)
    release thm fn_limit_left_squeeze(f,g,h,p,L,r)
