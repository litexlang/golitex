# Tracer: compiler set membership transport
#
# Before: named-set statements were first copied into a mirrored statement IR
# and only then translated by a separate output stage.
#
# Now: `StmtResultToLeanCompiler` reads the recursive statement Result. The
# `have A set = R` and `have B set = C` parent Results install A and B in the
# compiler environment; the equality rewrite Result is the only proof source
# for the paired theorem.
#
# Boundary: this first named-set route supports checked aliases of R/C. A bare
# `have A set` still has no verifier-backed inhabitant choice, and richer set
# constructors remain fail-closed until they receive their own numbered pair.
#
# Evidence:
# target/release/litex -strict -graph -f lean/examples/1_SetSystem.lit
# cd lean && ./stmt_result_to_lean_compiler.sh check examples && lake env lean examples/1_SetSystem.lean

sketch:
    have A set = R
    have B set = C
    forall a A, b B:
        a = b
        =>:
            b $in A
            a $in B
1 = 1
