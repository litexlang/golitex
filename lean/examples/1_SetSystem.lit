# Tracer: compiler set membership transport
#
# Before (retired interface):
# ./compiler2.sh compile examples/1_SetSystem.lit
# The active Rust module was named `litex_to_lean_compiler2`, while the older
# universal-object emitter still supplied shared IR capture and the main CLI.
#
# Now: `./compiler.sh` and both main CLI Lean commands use the sole active
# `litex_to_lean_compiler`. The generic verifier-owned builder lives in
# `litex_to_lean_ir`; A and B are verified Litex definitions, and the equality
# rewrite is the only source for the paired 1_SetSystem.lean theorem.
#
# Boundary: this first named-set route supports checked aliases of R/C. A bare
# `have A set` still has no verifier-backed inhabitant choice, and richer set
# constructors remain fail-closed until they receive their own numbered pair.
#
# Evidence:
# target/release/litex -compact -strict -runner -f lean/examples/1_SetSystem.lit
# cd lean && ./compiler.sh check examples && lake env lean examples/1_SetSystem.lean

sketch:
    have A set = R
    have B set = C
    forall a A, b B:
        a = b
        =>:
            b $in A
            a $in B
1 = 1
