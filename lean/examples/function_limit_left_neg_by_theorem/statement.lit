# Transfer a left limit through neg, retaining the complete function domains.
thm left_neg_limit:
    ? forall f,g fn(x R) R, p,L R:
        $has_limit_left(f,p,L)
        forall x R:
            g(x)=-f(x)
        =>:
            $has_limit_left(g,p,-L)
    by thm fn_limit_left_neg(f,g,p,L) => $has_limit_left(g,p,-L)
