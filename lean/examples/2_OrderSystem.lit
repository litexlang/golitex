# Tracer: compiler canonical real-order view
#
# Before: general Lt/Le selected two arbitrary AsReal witnesses. Transitivity
# therefore asked for RealCoherence, even though the source middle term was
# already one and the same compiled numeric object.
#
# Now: Litex.Lt and Litex.Le are custom relations on the compiler's numeric
# carrier, and both reduce through the one canonical Complex.re observation to
# Mathlib real order. The registered less-to-less-equal certificate and the
# direct order-transitivity certificate replay those native theorems.
#
# Boundary: comparison of C-only binders remains rejected by the verifier with
# "ordered comparison requires both operands to belong to R". A changed rule
# ID, fingerprint, or proof-certificate shape also remains fail-closed.
#
# Evidence:
# target/release/litex -compact -strict -runner -f lean/examples/2_OrderSystem.lit
# cd lean && ./compiler.sh check examples && lake env lean examples/2_OrderSystem.lean

sketch:
    forall a, b R:
        a < b
        =>:
            a <= b

    forall a, b, c R:
        a < b
        b < c
        =>:
            a < c
