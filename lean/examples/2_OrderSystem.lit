# Tracer: compiler canonical real-order view
#
# Before: general Lt/Le selected two arbitrary AsReal witnesses. Transitivity
# therefore asked for RealCoherence, even though the source middle term was
# already one and the same compiled numeric object.
#
# Now: Litex.Lt and Litex.Le are custom relations on the compiler's numeric
# carrier, and both reduce through the one canonical Complex.re observation to
# Mathlib real order. The reviewed strict-to-weak certificate replays that
# native theorem directly from typed Rust evidence.
#
# Boundary: comparison of C-only binders remains rejected by the verifier with
# "ordered comparison requires both operands to belong to R". Order
# transitivity is typed as `order.transitivity`, but because it was not in the
# former catalog ToLean rejects it by that exact ID.
#
# Evidence:
# target/release/litex -compact -strict -graph -f lean/examples/2_OrderSystem.lit
# cd lean && ./stmt_result_to_lean_compiler.sh check examples && lake env lean examples/2_OrderSystem.lean

sketch:
    forall a, b R:
        a < b
        =>:
            a <= b

# Former non-catalog compiler route, now exercised as a Rust negative test:
# sketch:
#     forall a, b, c R:
#         a < b
#         b < c
#         =>:
#             a < c
