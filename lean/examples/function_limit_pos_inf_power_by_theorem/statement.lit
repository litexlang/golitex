# Transfer a pos_inf limit through power with its original parameter evidence.
thm pos_inf_power_limit:
    ? forall f,g fn(x R) R, L R:
        $has_limit_pos_inf(f,L)
        forall x R:
            g(x)=f(x)^2
        =>:
            $has_limit_pos_inf(g,L^2)
    by thm fn_limit_pos_inf_power(f,g,L,2) => $has_limit_pos_inf(g,L^2)
