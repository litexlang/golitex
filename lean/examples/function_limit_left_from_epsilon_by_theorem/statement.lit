# Invoke the explicit epsilon-definition theorem for a left real function limit.
thm explicit_left_left_function_limit_intro:
    ? forall f fn(x R) R, x0 R, L R:
        forall r R+:
            exist x R st {0 < (x0-x) and (x0-x) < r}
        forall epsilon R+:
            exist delta R+ st {{x R: 0 < (x0-x) and (x0-x) < delta} $subset preimage_set(f,{v R: abs(v-L) < epsilon})}
        =>:
            $has_limit_left(f,x0,L)
    by thm fn_limit_left_from_epsilon(f,x0,L) => $has_limit_left(f,x0,L)
