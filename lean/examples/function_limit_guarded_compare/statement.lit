# Compare relative limits using a local inequality on the nonzero input domain.
thm guarded_limits_compare:
    ? forall f,g fn(x {s R:s!=0}) R, p,a,b R, r R+:
        $has_limit_at(f,p,a)
        $has_limit_at(g,p,b)
        forall x {t {s R:s!=0}:0<abs(t-p) and abs(t-p)<r}:
            f(x)<=g(x)
        =>:
            a<=b
    by thm fn_limit_at_compare(f,g,p,a,b,r) => a<=b
