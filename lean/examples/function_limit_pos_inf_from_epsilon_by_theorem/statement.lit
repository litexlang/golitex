# Invoke the explicit epsilon-definition theorem for a pos_inf real function limit.
thm explicit_pos_inf_pos_infinite_limit_intro:
    ? forall f fn(x R) R, L R:
        forall T R:
            exist x R st {T < x}
        forall epsilon R+:
            exist T R st {{x R: T < x} $subset preimage_set(f,{v R: abs(v-L) < epsilon})}
        =>:
            $has_limit_pos_inf(f,L)
    by thm fn_limit_pos_inf_from_epsilon(f,L) => $has_limit_pos_inf(f,L)
