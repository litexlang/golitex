# Transfer a right limit through power with its original parameter evidence.
thm right_power_limit:
    ? forall f,g fn(x R) R, p,L R:
        $has_limit_right(f,p,L)
        forall x R:
            g(x)=f(x)^2
        =>:
            $has_limit_right(g,p,L^2)
    by thm fn_limit_right_power(f,g,p,L,2) => $has_limit_right(g,p,L^2)
