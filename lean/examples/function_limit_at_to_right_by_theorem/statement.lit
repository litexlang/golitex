# Restrict a two-sided limit only when the selected side accumulates in the domain.
thm limit_at_to_right:
    ? forall f fn(x R) R, p,L R:
        $has_limit_at(f,p,L)
        forall r R+:
            exist x R st {0<(x-p) and (x-p)<r}
        =>:
            $has_limit_right(f,p,L)
    by thm fn_limit_at_to_right(f,p,L) => $has_limit_right(f,p,L)
