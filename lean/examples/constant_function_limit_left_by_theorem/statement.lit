# A constant function has the stated left limit on an accumulating domain.
claim:
    ? forall f fn(x R) R, p R, L R:
        forall r R+:
            exist x R st {0 < (p-x) and (p-x) < r}
        forall x R:
            f(x)=L
        =>:
            $has_limit_left(f,p,L)
    by thm fn_limit_left_constant(f,p,L) => $has_limit_left(f,p,L)
