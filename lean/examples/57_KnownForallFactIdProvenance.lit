# Before: the known-forall index kept only parameters, domains, and a matched
# leaf. A multi-conclusion source was reconstructed as a synthetic one-clause
# forall, so its stored FactId could not be recovered.
#
# Now: each indexed conclusion retains the complete source forall, its exact
# FactId, and its structural conclusion location. Each conjunction target is
# checked through the complete source theorem before its atomic children are
# considered, so the Result-to-Lean compiler projects the exact outer branch.
#
# Boundary: a missing FactId, a retargeted source proposition, or an invalid
# conclusion location is rejected; compiler diagnostics never rediscover a
# source theorem by rendered proposition text.

prop first_left(x R):
    x = x

prop first_right(x R):
    x = x

prop second_left(x R):
    x = x

prop second_right(x R):
    x = x

thm paired_source:
    ? forall x R:
        $first_left(x) and $first_right(x)
        $second_left(x) and $second_right(x)
    by def $first_left(x)
    by def $first_right(x)
    by def $second_left(x)
    by def $second_right(x)

$first_left(2) and $first_right(2)
$second_left(2) and $second_right(2)

# Evidence:
# target/release/litex -strict -isolated -graph -f lean/examples/57_KnownForallFactIdProvenance.lit
# cargo test --release --test stmt_result_to_lean_compiler_tracers known_forall_multi_conclusion_fact_id_provenance_compiles_both_exact_projections -- --nocapture
