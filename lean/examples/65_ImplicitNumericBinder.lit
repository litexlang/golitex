# Tracer: ordinary numeric forall binders use implicit Lean host carriers.
#
# Before (source verified, generated ABI was too narrow):
# prop nested_natural_reflexivity(anchor R):
#     forall n N:
#         n = n
# Former generated shape: the inner binder was fixed to `n : ℂ`, so a
# downstream theorem could not instantiate it directly with `n : ℕ`.
#
# Now (verified and generated with an implicit carrier):
prop nested_natural_reflexivity(anchor R):
    forall n N:
        n = n

by def $nested_natural_reflexivity(0)

forall r R:
    r = r

# Boundary: the compiler's reviewed exact-carrier binders remain exact.
forall z Z:
    z = z

forall epsilon R+:
    epsilon = epsilon

# Evidence:
# target/release/litex -strict -isolated -graph -f lean/examples/65_ImplicitNumericBinder.lit
# target/release/stmt_result_to_lean_compiler check lean/examples
