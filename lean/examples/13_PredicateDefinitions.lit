# Tracer: recursive concrete-predicate definition reduction
#
# Before: `by def` copied `SuccessVerifyByDefinitionResult` into a mirrored
# compiler-only statement node before Lean proof construction.
#
# Now: StmtResultToLeanCompiler reads the parameter checks, instantiated clause
# facts, clause-check Results, target store, and inferred FactIds directly. It
# folds the ordered child proofs into the predicate target, then publishes each
# newly inferred component under the exact FactId retained by execution.
prop is_unit_pair(x R, y R):
    x = 1
    y = 1

1 = 1
by def $is_unit_pair(1, 1)

# Boundary: bodyless and abstract predicates remain unsupported because they
# would introduce an unchecked Lean proposition.
