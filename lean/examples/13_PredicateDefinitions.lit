# Concrete predicates keep their parameter-membership requirements together
# with their defining clauses. Both direct use and `by def` replay the exact
# verifier-selected definition components.
prop is_unit_pair(x R, y R):
    x = 1
    y = 1

1 = 1
by def $is_unit_pair(1, 1)

# Boundary: bodyless and abstract predicates remain unsupported because they
# would introduce an unchecked Lean proposition.
