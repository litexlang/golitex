# Complete finite integer cases define a row function without a separate enumeration lemma.
forall row 1...3:
    row=1 or row=2 or row=3
forall row range(1,4):
    3=row or row=1 or 2=row or row=0 or row=2
forall row closed_range(-1,1):
    row=-1 or row=0 or row=1
have indices set = 1...3
forall row indices:
    row=1 or row=2 or row=3
have fn row_value(row 1...3) R by cases:
    case row=1:10
    case row=2:20
    case row=3:30
row_value(2)=20
