# Tracer: exact nonzero numeric carriers and constructive widening
#
# Before (Litex verified, but compiler emission stopped):
# forall z Z:
#     z != 0
#     =>:
#         z $in Z*
# Former compiler behavior: verifier IR retained the exact base-membership and
# nonzero premises, but refined numeric membership had no Lean replay adapter.
#
# Now: each nonzero standard set is an exact certified complex-source subtype.
# A base membership plus the source `!= 0` premise constructs that carrier;
# membership projects both the base-set certificate and the retained semantic
# nonzero certificate, and widens along `Z* -> Q* -> R* -> C*` without adding a
# global coherence premise. Closed evaluation also records why `0` is excluded
# from an exact nonzero carrier, so that leaf now compiles without a label
# lookup or target-side membership search.
not 0 $in C*

forall z Z:
    z != 0
    =>:
        z $in Z*

forall q Q:
    q != 0
    =>:
        q $in Q*

forall r R:
    r != 0
    =>:
        r $in R*

forall c C:
    c != 0
    =>:
        c $in C*

forall z Z*:
    z != 0
    z $in Z
    z $in Q
    z $in R
    z $in C
    z $in Q*
    z $in R*
    z $in C*

forall q Q*:
    q != 0
    q $in Q
    q $in R
    q $in C
    q $in R*
    q $in C*

forall r R*:
    r != 0
    r $in R
    r $in C
    r $in C*

forall c C*:
    c != 0
    c $in C

# Boundary (Litex verifies; compiler remains fail-closed):
# 1 $in Z*
# Star construction, elimination, and closed zero exclusion are replayed, but
# standalone closed positive star construction still depends on a broader
# closed nonzero certificate adapter.
#
# Evidence:
# target/release/litex -compact -strict -graph -f lean/examples/22_NonzeroNumericCarriers.lit
# cargo test --release --test stmt_result_to_lean_compiler_tracers nonzero_numeric
# cd lean && ./stmt_result_to_lean_compiler.sh check examples
