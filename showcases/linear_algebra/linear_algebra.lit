# 线性代数讲稿：从平面运算到基与维数
#
# 这是参考 LADR 核心概念编写的课程，不追求原书逐条覆盖。
# 两章共用一个例子：R² 的两个坐标方向。先计算、再抽象、再证明，最后回到例子。
# 有限列表一律使用原生 finite_seq，空间固定共同的标量域，公理直接写在结构中。
# 维数的一般定义需要基存在与基长度唯一；未证明的内容明确留待后续。
#
# 第一章：什么是一个向量空间？
# 1.1 从看得见的计算开始（参考 LADR 1A）
# 平面向量直接采用长度为2的原生有限序列，两个位置是两个实坐标。
# 加法与数乘各自在两个坐标上进行。
# 长度2的原生序列与它的两个坐标一致；这是之后坐标计算所用的表示事实。
claim:
    ? forall x finite_seq(R, 2):
        x = (x(1), x(2))
    have coordinates finite_seq(R, 2) = (x(1), x(2))
    claim:
        ? forall k N+:
            k <= 2
            =>:
                x(k) = coordinates(k)
        k $in closed_range(1, 2)
        expand: k $in closed_range(1, 2)
        k $in closed_range(1, 2)
        expand: k $in closed_range(1, 2)
        k = 1 or k = 2
        by cases:
            ? x(k) = coordinates(k)
            case k = 1:
                coordinates(1) = x(1)
                x(k) = x(1) = coordinates(1) = coordinates(k)
            case k = 2:
                coordinates(2) = x(2)
                x(k) = x(2) = coordinates(2) = coordinates(k)
    by fn_extension x = coordinates
    x = coordinates = (x(1), x(2))

have fn plane_add(u, v finite_seq(R, 2)) finite_seq(R, 2) = (u(1) + v(1), u(2) + v(2))

have fn plane_smul(a R, v finite_seq(R, 2)) finite_seq(R, 2) = (a * v(1), a * v(2))

# 第一次先看坐标算式。后面构造空间并用通用变量实际验证运算。
(1 + 3, 2 + 4) = (4, 6)

(3 * 1, 3 * 2) = (3, 6)

(3 * 1 + 4 * 0, 3 * 0 + 4 * 1) = (3, 4)

# 暂时记住最后一行：我们已经用两个方向表示了 (3,4)。第二章会把它叫做线性组合。
# 向量列表保留顺序与重复。下列两个位置是相同向量；空列表也使用同一原生接口。
have e1 finite_seq(R, 2) = (1, 0)

have e2 finite_seq(R, 2) = (0, 1)

have repeated_directions finite_seq(finite_seq(R, 2), 2) = (e1, e1)

repeated_directions(1) = repeated_directions(2)

have empty_directions finite_seq(finite_seq(R, 2), 0) = ()

# 1.2 标量为什么能这样计算？（参考 LADR 1.3、1.6）
# 域同时给出标量运算和它们满足的公理。函数 inv 的零值不受逆元公理约束。
struct Field<K nonempty_set>:
    zero K
    one K
    add fn(x, y K) K
    neg fn(x K) K
    mul fn(x, y K) K
    inv fn(x K) K
    <=>:
        zero != one
        forall x, y, z K:
            add(add(x, y), z) = add(x, add(y, z))
            mul(mul(x, y), z) = mul(x, mul(y, z))
            mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
        forall x, y K:
            add(x, y) = add(y, x)
            mul(x, y) = mul(y, x)
        forall x K:
            add(zero, x) = x
            add(x, neg(x)) = zero
            mul(one, x) = x
        forall x K:
            x != zero
            =>:
                mul(x, inv(x)) = one

# 下面把实数的 builtin 运算组成一个实际的域对象。各个 claim 检查构造所需的域公理。
have fn real_inv(x R) R by cases:
    case x = 0: 0
    case x != 0: 1 / x

have fn real_add(x, y R) R = x + y

have fn real_neg(x R) R = -x

have fn real_mul(x, y R) R = x * y

# 非零标量的逆元公理：倒数与原数相乘得到1。
claim:
    ? forall x R:
        x != 0
        =>:
            real_mul(x, real_inv(x)) = 1
    real_inv(x) = 1 / x
    real_mul(x, real_inv(x)) = x * real_inv(x) = x * (1 / x) = 1

# 实数运算的结合律与分配律直接来自 builtin 算术。
claim:
    ? forall x, y, z R:
        real_add(real_add(x, y), z) = real_add(x, real_add(y, z))
        real_mul(real_mul(x, y), z) = real_mul(x, real_mul(y, z))
        real_mul(x, real_add(y, z)) = real_add(real_mul(x, y), real_mul(x, z))
    real_add(x, y) = x + y
    real_add(y, z) = y + z
    real_add(real_add(x, y), z) = real_add(x, y) + z = (x + y) + z = x + (y + z) = x + real_add(y, z) = real_add(x, real_add(y, z))
    real_mul(x, y) = x * y
    real_mul(x, z) = x * z
    real_mul(y, z) = y * z
    real_mul(real_mul(x, y), z) = real_mul(x, y) * z = (x * y) * z = x * (y * z) = x * real_mul(y, z) = real_mul(x, real_mul(y, z))
    real_mul(x, real_add(y, z)) = x * real_add(y, z) = x * (y + z) = x * y + x * z
    real_add(real_mul(x, y), real_mul(x, z)) = real_mul(x, y) + real_mul(x, z) = x * y + x * z
    real_mul(x, real_add(y, z)) = real_add(real_mul(x, y), real_mul(x, z))

# 实数加法与乘法的交换律。
claim:
    ? forall x, y R:
        real_add(x, y) = real_add(y, x)
        real_mul(x, y) = real_mul(y, x)
    real_add(x, y) = x + y = y + x = real_add(y, x)
    real_mul(x, y) = x * y = y * x = real_mul(y, x)

# 零、单位元和取负怎样满足标量公理。
claim:
    ? forall x R:
        real_add(0, x) = x
        real_add(x, real_neg(x)) = 0
        real_mul(1, x) = x
    real_add(0, x) = 0 + x = x
    real_neg(x) = -x
    real_add(x, real_neg(x)) = x + real_neg(x) = x + (-x) = 0
    real_mul(1, x) = 1 * x = x

release thm struct_member((0, 1, real_add, real_neg, real_mul, real_inv), &Field<R>)

(0, 1, real_add, real_neg, real_mul, real_inv) $in &Field<R>

have real_field &Field<R> = (0, 1, real_add, real_neg, real_mul, real_inv)

# 后面使用 real_field 的实际运算值，而不仅是抽象域公理。
thm real_field_adapter_values:
    ? forall x, y R:
        real_field.zero = 0
        real_field.one = 1
        real_field.add = real_add
        real_field.neg = real_neg
        real_field.mul = real_mul
        real_field.add(x, y) = x + y
        real_field.mul(x, y) = x * y
    real_field = (0, 1, real_add, real_neg, real_mul, real_inv)
    real_field.zero = 0
    real_field.one = 1
    real_field.add = real_add
    real_field.neg = real_neg
    real_field.mul = real_mul
    real_field.add(x, y) = real_add(x, y) = x + y
    real_field.mul(x, y) = real_mul(x, y) = x * y

# 1.3 把平面的规律抽象成向量空间（参考 LADR 1.19--1.20）
# field 是固定的数学背景；记录只存向量零、加法、标量作用。
# 以后证明“任意向量空间”的定理，就可以同时用于坐标、函数等不同对象。
struct VectorSpace<K nonempty_set, field &Field<K>, V nonempty_set>:
    zero V
    add fn(x, y V) V
    smul fn(a K, x V) V
    <=>:
        forall x, y, z V:
            add(add(x, y), z) = add(x, add(y, z))
        forall x, y V:
            add(x, y) = add(y, x)
        forall x V:
            add(zero, x) = x
            exist y V st {add(x, y) = zero}
        forall a, b K, x V:
            smul(field.mul(a, b), x) = smul(a, smul(b, x))
            smul(field.add(a, b), x) = add(smul(a, x), smul(b, x))
        forall a K, x, y V:
            smul(a, add(x, y)) = add(smul(a, x), smul(a, y))
        forall x V:
            smul(field.one, x) = x

#
# 回到最初的平面运算：逐项检查公理，才得到 real_plane，不能只假定它是空间。
# 检查向量加法结合律：分别比较两个坐标。
claim:
    ? forall x, y, z finite_seq(R, 2):
        plane_add(plane_add(x, y), z) = plane_add(x, plane_add(y, z))
    plane_add(x, y) = (x(1) + y(1), x(2) + y(2))
    plane_add(x, y)(1) = x(1) + y(1)
    plane_add(x, y)(2) = x(2) + y(2)
    plane_add(plane_add(x, y), z) = (plane_add(x, y)(1) + z(1), plane_add(x, y)(2) + z(2)) = ((x(1) + y(1)) + z(1), (x(2) + y(2)) + z(2))
    plane_add(y, z) = (y(1) + z(1), y(2) + z(2))
    plane_add(y, z)(1) = y(1) + z(1)
    plane_add(y, z)(2) = y(2) + z(2)
    plane_add(x, plane_add(y, z)) = (x(1) + plane_add(y, z)(1), x(2) + plane_add(y, z)(2)) = (x(1) + (y(1) + z(1)), x(2) + (y(2) + z(2)))
    plane_add(plane_add(x, y), z) = ((x(1) + y(1)) + z(1), (x(2) + y(2)) + z(2)) = (x(1) + (y(1) + z(1)), x(2) + (y(2) + z(2))) = plane_add(x, plane_add(y, z))

# 加法交换律同样逐坐标验证。
claim:
    ? forall x, y finite_seq(R, 2):
        plane_add(x, y) = plane_add(y, x)
    plane_add(x, y) = (x(1) + y(1), x(2) + y(2)) = (y(1) + x(1), y(2) + x(2)) = plane_add(y, x)

# (0,0) 是零元；把两个坐标取负就构造出了向量逆元。
claim:
    ? forall x finite_seq(R, 2):
        plane_add((0, 0), x) = x
        exist inverse_x finite_seq(R, 2) st {plane_add(x, inverse_x) = (0, 0)}
    x = (x(1), x(2))
    (0, 0)(1) = 0
    (0, 0)(2) = 0
    plane_add((0, 0), x) = ((0, 0)(1) + x(1), (0, 0)(2) + x(2))
    x(1) $in R
    x(2) $in R
    (0, 0)(1) + x(1) = 0 + x(1) = x(1)
    (0, 0)(2) + x(2) = 0 + x(2) = x(2)
    ((0, 0)(1) + x(1), (0, 0)(2) + x(2)) = (x(1), x(2))
    plane_add((0, 0), x) = (x(1), x(2)) = x
    have inverse_x finite_seq(R, 2) = (0 - x(1), 0 - x(2))
    inverse_x(1) = 0 - x(1)
    inverse_x(2) = 0 - x(2)
    x(1) + inverse_x(1) = x(1) + (0 - x(1)) = 0
    x(2) + inverse_x(2) = x(2) + (0 - x(2)) = 0
    plane_add(x, inverse_x) = (x(1) + inverse_x(1), x(2) + inverse_x(2)) = (0, 0)
    witness exist inverse_x2 finite_seq(R, 2) st {plane_add(x, inverse_x2) = (0, 0)} from inverse_x

# 数乘分别与标量的乘法、加法相容。
claim:
    ? forall a, b R, x finite_seq(R, 2):
        plane_smul(real_field.mul(a, b), x) = plane_smul(a, plane_smul(b, x))
        plane_smul(real_field.add(a, b), x) = plane_add(plane_smul(a, x), plane_smul(b, x))
    release thm real_field_adapter_values(a, b)
    plane_smul(b, x) = (b * x(1), b * x(2))
    plane_smul(b, x)(1) = b * x(1)
    plane_smul(b, x)(2) = b * x(2)
    plane_smul(a, plane_smul(b, x)) = (a * plane_smul(b, x)(1), a * plane_smul(b, x)(2)) = (a * (b * x(1)), a * (b * x(2)))
    plane_smul(real_field.mul(a, b), x) = plane_smul(a * b, x)
    plane_smul(a * b, x) = ((a * b) * x(1), (a * b) * x(2))
    plane_smul(real_field.mul(a, b), x) = ((a * b) * x(1), (a * b) * x(2)) = (a * (b * x(1)), a * (b * x(2))) = plane_smul(a, plane_smul(b, x))
    plane_smul(a, x) = (a * x(1), a * x(2))
    plane_smul(a, x)(1) = a * x(1)
    plane_smul(a, x)(2) = a * x(2)
    plane_smul(b, x) = (b * x(1), b * x(2))
    plane_add(plane_smul(a, x), plane_smul(b, x)) = (plane_smul(a, x)(1) + plane_smul(b, x)(1), plane_smul(a, x)(2) + plane_smul(b, x)(2)) = (a * x(1) + b * x(1), a * x(2) + b * x(2))
    plane_smul(real_field.add(a, b), x) = plane_smul(a + b, x)
    plane_smul(a + b, x) = ((a + b) * x(1), (a + b) * x(2))
    plane_smul(real_field.add(a, b), x) = ((a + b) * x(1), (a + b) * x(2)) = (a * x(1) + b * x(1), a * x(2) + b * x(2)) = plane_add(plane_smul(a, x), plane_smul(b, x))

# 数乘对向量加法的分配律。
claim:
    ? forall a R, x, y finite_seq(R, 2):
        plane_smul(a, plane_add(x, y)) = plane_add(plane_smul(a, x), plane_smul(a, y))
    plane_add(x, y) = (x(1) + y(1), x(2) + y(2))
    plane_add(x, y)(1) = x(1) + y(1)
    plane_add(x, y)(2) = x(2) + y(2)
    plane_smul(a, plane_add(x, y)) = (a * plane_add(x, y)(1), a * plane_add(x, y)(2)) = (a * (x(1) + y(1)), a * (x(2) + y(2)))
    plane_smul(a, x) = (a * x(1), a * x(2))
    plane_smul(a, y) = (a * y(1), a * y(2))
    plane_smul(a, x)(1) = a * x(1)
    plane_smul(a, x)(2) = a * x(2)
    plane_smul(a, y)(1) = a * y(1)
    plane_smul(a, y)(2) = a * y(2)
    plane_add(plane_smul(a, x), plane_smul(a, y)) = (plane_smul(a, x)(1) + plane_smul(a, y)(1), plane_smul(a, x)(2) + plane_smul(a, y)(2))
    plane_smul(a, x)(1) + plane_smul(a, y)(1) = a * x(1) + a * y(1)
    plane_smul(a, x)(2) + plane_smul(a, y)(2) = a * x(2) + a * y(2)
    (plane_smul(a, x)(1) + plane_smul(a, y)(1), plane_smul(a, x)(2) + plane_smul(a, y)(2)) = (a * x(1) + a * y(1), a * x(2) + a * y(2))
    plane_add(plane_smul(a, x), plane_smul(a, y)) = (a * x(1) + a * y(1), a * x(2) + a * y(2))
    plane_smul(a, plane_add(x, y)) = (a * (x(1) + y(1)), a * (x(2) + y(2))) = (a * x(1) + a * y(1), a * x(2) + a * y(2)) = plane_add(plane_smul(a, x), plane_smul(a, y))

# 标量单位元作用于向量后得到原向量。
claim:
    ? forall x finite_seq(R, 2):
        plane_smul(real_field.one, x) = x
    release thm real_field_adapter_values(0, 0)
    x = (x(1), x(2))
    plane_smul(real_field.one, x) = plane_smul(1, x)
    plane_smul(1, x) = (1 * x(1), 1 * x(2)) = (x(1), x(2))
    plane_smul(real_field.one, x) = (x(1), x(2)) = x

(0, 0) $in finite_seq(R, 2)

release thm struct_member(((0, 0), plane_add, plane_smul), &VectorSpace<R, real_field, finite_seq(R, 2)>)

have real_plane &VectorSpace<R, real_field, finite_seq(R, 2)> = ((0, 0), plane_add, plane_smul)

# 公理与定理的区别：结构给了一个零元，但它的唯一性是可以证明的数学结果。
thm additive_identity_unique:
    ? forall K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, identity_candidate V:
        forall x V:
            space.add(identity_candidate, x) = x
        =>:
            identity_candidate = space.zero
    space.add(identity_candidate, space.zero) = space.zero
    space.add(identity_candidate, space.zero) = space.add(space.zero, identity_candidate) = identity_candidate

# 逆元存在来自空间公理；结合律和交换律进一步给出逆元唯一性。
thm additive_inverse_exists_unique:
    ? forall K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, x V:
        exist! y V st {space.add(x, y) = space.zero}
    obtain y from exist y V st {space.add(x, y) = space.zero}
    forall y1, y2 V:
        space.add(x, y1) = space.zero
        space.add(x, y2) = space.zero
        =>:
            space.add(y2, x) = space.add(x, y2) = space.zero
            y1 = space.add(space.zero, y1) = space.add(space.add(y2, x), y1) = space.add(y2, space.add(x, y1)) = space.add(y2, space.zero) = space.add(space.zero, y2) = y2
            y1 = y2
    witness exist! y2 V st {space.add(x, y2) = space.zero} from y

# 1.4 向量也可以是函数（参考 LADR 1.24--1.25）
# 定义点运算后，先做实际计算。完整函数空间公理证明可以作为后续讲次扩展。
have fn pointwise_add(f, g fn(t R) R) fn(t R) R = fn(t R) R {f(t) + g(t)}

have fn pointwise_smul(a R, f fn(t R) R) fn(t R) R = fn(t R) R {a * f(t)}

have fn square(t R) R = t * t

pointwise_add(square, square)(3) = 18

pointwise_smul(2, square)(3) = 18

# 1.5 在一个空间里寻找小空间（参考 LADR 1.33--1.34）
# 子空间沿用环境空间的运算，因此是已有子集的性质：包含零、对运算封闭。
prop is_subspace(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, U power_set(V)):
    space.zero $in U
    forall u, v V:
        u $in U
        v $in U
        =>:
            space.add(u, v) $in U
    forall a K, v V:
        v $in U
        =>:
            space.smul(a, v) $in U

#
have x_axis power_set(finite_seq(R, 2)) = {p finite_seq(R, 2): p(2) = 0}

have y_axis power_set(finite_seq(R, 2)) = {p finite_seq(R, 2): p(1) = 0}

e1 $in x_axis

e2 $in y_axis

# 若 (1,1) 在 x 轴上，它的第二坐标就同时是 0 和 1。
by contra:
    ? not (1, 1) $in x_axis
    (1, 1) $in x_axis
    (1, 1)(2) = 0
    (1, 1)(2) = 1
    impossible 1 = 0

claim:
    ? $is_subspace(R, real_field, finite_seq(R, 2), real_plane, x_axis)
    real_plane.zero = (0, 0)
    real_plane.add = plane_add
    real_plane.smul = plane_smul
    have zero_point finite_seq(R, 2) = real_plane.zero
    zero_point = (0, 0)
    zero_point(2) = 0
    zero_point $in x_axis
    real_plane.zero $in x_axis
    claim:
        ? forall u, v finite_seq(R, 2):
            u $in x_axis
            v $in x_axis
            =>:
                real_plane.add(u, v) $in x_axis
        u(2) = 0
        v(2) = 0
        real_plane.add(u, v) = plane_add(u, v)
        plane_add(u, v) = (u(1) + v(1), u(2) + v(2))
        u(2) + v(2) = 0 + 0 = 0
        real_plane.add(u, v) = plane_add(u, v) = (u(1) + v(1), u(2) + v(2)) = (u(1) + v(1), 0)
        have combined finite_seq(R, 2) = real_plane.add(u, v)
        combined = (u(1) + v(1), 0)
        combined(2) = 0
        combined $in x_axis
        real_plane.add(u, v) $in x_axis
    claim:
        ? forall a R, v finite_seq(R, 2):
            v $in x_axis
            =>:
                real_plane.smul(a, v) $in x_axis
        v(2) = 0
        real_plane.smul(a, v) = plane_smul(a, v)
        plane_smul(a, v) = (a * v(1), a * v(2))
        a * v(2) = a * 0 = 0
        real_plane.smul(a, v) = plane_smul(a, v) = (a * v(1), a * v(2)) = (a * v(1), 0)
        have scaled finite_seq(R, 2) = real_plane.smul(a, v)
        scaled = (a * v(1), 0)
        scaled(2) = 0
        scaled $in x_axis
        real_plane.smul(a, v) $in x_axis
    by def $is_subspace(R, real_field, finite_seq(R, 2), real_plane, x_axis)

claim:
    ? $is_subspace(R, real_field, finite_seq(R, 2), real_plane, y_axis)
    real_plane.zero = (0, 0)
    real_plane.add = plane_add
    real_plane.smul = plane_smul
    have zero_point finite_seq(R, 2) = real_plane.zero
    zero_point = (0, 0)
    zero_point(1) = 0
    zero_point $in y_axis
    real_plane.zero $in y_axis
    claim:
        ? forall u, v finite_seq(R, 2):
            u $in y_axis
            v $in y_axis
            =>:
                real_plane.add(u, v) $in y_axis
        u(1) = 0
        v(1) = 0
        real_plane.add(u, v) = plane_add(u, v)
        plane_add(u, v) = (u(1) + v(1), u(2) + v(2))
        u(1) + v(1) = 0 + 0 = 0
        real_plane.add(u, v) = plane_add(u, v) = (u(1) + v(1), u(2) + v(2)) = (0, u(2) + v(2))
        have combined finite_seq(R, 2) = real_plane.add(u, v)
        combined = (0, u(2) + v(2))
        combined(1) = 0
        combined $in y_axis
        real_plane.add(u, v) $in y_axis
    claim:
        ? forall a R, v finite_seq(R, 2):
            v $in y_axis
            =>:
                real_plane.smul(a, v) $in y_axis
        v(1) = 0
        real_plane.smul(a, v) = plane_smul(a, v)
        plane_smul(a, v) = (a * v(1), a * v(2))
        a * v(1) = a * 0 = 0
        real_plane.smul(a, v) = plane_smul(a, v) = (a * v(1), a * v(2)) = (0, a * v(2))
        have scaled finite_seq(R, 2) = real_plane.smul(a, v)
        scaled = (0, a * v(2))
        scaled(1) = 0
        scaled $in y_axis
        real_plane.smul(a, v) $in y_axis
    by def $is_subspace(R, real_field, finite_seq(R, 2), real_plane, y_axis)

# 同样是一条直线，平移后就不是子空间：它连零向量都不包含。
have shifted_line power_set(finite_seq(R, 2)) = {p finite_seq(R, 2): p(2) = 1}

# 原点的第二坐标是0，因此不在第二坐标为1的平移直线上。
by contra:
    ? not (0, 0) $in shifted_line
    (0, 0) $in shifted_line
    (0, 0)(2) = 1
    (0, 0)(2) = 0
    impossible 0 = 1

by contra:
    ? not $is_subspace(R, real_field, finite_seq(R, 2), real_plane, shifted_line)
    $is_subspace(R, real_field, finite_seq(R, 2), real_plane, shifted_line)
    real_plane.zero $in shifted_line
    real_plane.zero = (0, 0)
    impossible (0, 0) $in shifted_line

# 任意平面向量都能分成两个坐标轴上的向量。
claim:
    ? forall p finite_seq(R, 2):
        exist horizontal, vertical finite_seq(R, 2) st {horizontal $in x_axis, vertical $in y_axis, p = plane_add(horizontal, vertical)}
    have horizontal finite_seq(R, 2) = (p(1), 0)
    have vertical finite_seq(R, 2) = (0, p(2))
    horizontal(2) = 0
    vertical(1) = 0
    horizontal $in x_axis
    vertical $in y_axis
    horizontal(1) = p(1)
    vertical(2) = p(2)
    p = (p(1), p(2))
    horizontal(1) + vertical(1) = p(1) + 0 = p(1)
    horizontal(2) + vertical(2) = 0 + p(2) = p(2)
    plane_add(horizontal, vertical) = (horizontal(1) + vertical(1), horizontal(2) + vertical(2)) = (p(1), p(2)) = p
    witness exist h, v finite_seq(R, 2) st {h $in x_axis, v $in y_axis, p = plane_add(h, v)} from horizontal, vertical

# 两个轴上的分量若合成同一向量，各个分量必相同：这就是本例的直和性质。
thm axis_decomposition_unique:
    ? forall left, right, left_again, right_again finite_seq(R, 2):
        left $in x_axis
        left_again $in x_axis
        right $in y_axis
        right_again $in y_axis
        plane_add(left, right) = plane_add(left_again, right_again)
        =>:
            left = left_again
            right = right_again
    left(2) = 0
    left_again(2) = 0
    right(1) = 0
    right_again(1) = 0
    plane_add(left, right) = (left(1) + right(1), left(2) + right(2))
    left(1) + right(1) = left(1)
    left(2) + right(2) = right(2)
    plane_add(left, right) = (left(1), right(2))
    plane_add(left_again, right_again) = (left_again(1) + right_again(1), left_again(2) + right_again(2))
    left_again(1) + right_again(1) = left_again(1)
    left_again(2) + right_again(2) = right_again(2)
    plane_add(left_again, right_again) = (left_again(1), right_again(2))
    (left(1), right(2)) = plane_add(left, right) = plane_add(left_again, right_again) = (left_again(1), right_again(2))
    have first_sum finite_seq(R, 2) = plane_add(left, right)
    have second_sum finite_seq(R, 2) = plane_add(left_again, right_again)
    first_sum = (left(1), right(2))
    second_sum = (left_again(1), right_again(2))
    first_sum = second_sum
    first_sum(1) = second_sum(1)
    first_sum(2) = second_sum(2)
    left(1) = first_sum(1) = second_sum(1) = left_again(1)
    right(2) = first_sum(2) = second_sum(2) = right_again(2)
    left = (left(1), left(2))
    left_again = (left_again(1), left_again(2))
    right = (right(1), right(2))
    right_again = (right_again(1), right_again(2))
    left = (left(1), 0) = (left_again(1), 0) = left_again
    right = (0, right(2)) = (0, right_again(2)) = right_again

# 第二章：用一组向量描述整个空间
# 2.1 从两项相加到有限线性组合（参考 LADR 2.2）
# 同长度的系数与向量列表相配。trace 从零开始，每次加上一项；终点是和值。
prop is_linear_combination_partial_sum_sequence(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, coefficients finite_seq(K, n), vectors finite_seq(V, n), trace fn(k closed_range(0, n)) V):
    trace(0) = space.zero
    forall k N+:
        k <= n
        =>:
            trace(k) = space.add(trace(k - 1), space.smul(coefficients(k), vectors(k)))

# 给定系数和向量列表，value 是该有限和的结果。
# n=0 时 trace 的唯一位置是 0，所以结果应当是 space.zero。
prop has_linear_combination_value(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, coefficients finite_seq(K, n), vectors finite_seq(V, n), value V):
    exist trace fn(k closed_range(0, n)) V st {$is_linear_combination_partial_sum_sequence(K, field, V, space, n, coefficients, vectors, trace), value = trace(n)}

# x 是列表的某个线性组合，当且仅当存在一组系数使有限和等于 x。
# 先定义一般关系。本讲实际证明两项求和；任意长度的选择函数作为后续扩展。
prop is_linear_combination(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, x V, vectors finite_seq(V, n)):
    exist coefficients finite_seq(K, n) st {$has_linear_combination_value(K, field, V, space, n, coefficients, vectors, x)}

# 两项求和只有0、1、2这三个阶段；先明确这个有限索引事实。
claim:
    ? forall k closed_range(0, 2):
        k = 0 or k = 1 or k = 2
    expand: k $in closed_range(0, 2)

have fn two_term_partial_sum(coefficients finite_seq(R, 2), vectors finite_seq(finite_seq(R, 2), 2), k closed_range(0, 2)) finite_seq(R, 2) by cases:
    case k = 0: (0, 0)
    case k = 1: plane_smul(coefficients(1), vectors(1))
    case k = 2: plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2)))

thm two_term_combination_exists:
    ? forall coefficients finite_seq(R, 2), vectors finite_seq(finite_seq(R, 2), 2):
        $has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2))))
    release struct def real_plane
    real_plane.add = plane_add
    real_plane.smul = plane_smul
    have first_term finite_seq(R, 2) = plane_smul(coefficients(1), vectors(1))
    real_plane.smul(coefficients(1), vectors(1)) = first_term
    real_plane.add(real_plane.zero, first_term) = first_term
    have second_term finite_seq(R, 2) = plane_smul(coefficients(2), vectors(2))
    real_plane.smul(coefficients(2), vectors(2)) = second_term
    have fn trace(k closed_range(0, 2)) finite_seq(R, 2) = two_term_partial_sum(coefficients, vectors, k)
    trace(1) = two_term_partial_sum(coefficients, vectors, 1)
    two_term_partial_sum(coefficients, vectors, 1) = plane_smul(coefficients(1), vectors(1))
    trace(1) = plane_smul(coefficients(1), vectors(1))
    trace(2) = two_term_partial_sum(coefficients, vectors, 2)
    two_term_partial_sum(coefficients, vectors, 2) = plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2)))
    trace(2) = plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2)))
    trace(0) = two_term_partial_sum(coefficients, vectors, 0)
    two_term_partial_sum(coefficients, vectors, 0) = (0, 0)
    real_plane.zero = (0, 0)
    trace(0) = (0, 0) = real_plane.zero
    claim:
        ? forall k N+:
            k <= 2
            =>:
                trace(k) = real_plane.add(trace(k - 1), real_plane.smul(coefficients(k), vectors(k)))
        k $in closed_range(1, 2)
        expand: k $in closed_range(1, 2)
        k = 1 or k = 2
        by cases:
            ? trace(k) = real_plane.add(trace(k - 1), real_plane.smul(coefficients(k), vectors(k)))
            case k = 1:
                k - 1 = 0
                trace(k) = trace(1) = plane_smul(coefficients(1), vectors(1))
                trace(k - 1) = trace(0) = real_plane.zero
                real_plane.smul(coefficients(k), vectors(k)) = real_plane.smul(coefficients(1), vectors(1)) = first_term
                real_plane.add(trace(k - 1), real_plane.smul(coefficients(k), vectors(k))) = real_plane.add(real_plane.zero, first_term) = first_term = plane_smul(coefficients(1), vectors(1))
            case k = 2:
                k - 1 = 1
                trace(1) = plane_smul(coefficients(1), vectors(1))
                trace(k - 1) = trace(1) = first_term
                real_plane.smul(coefficients(k), vectors(k)) = real_plane.smul(coefficients(2), vectors(2)) = second_term
                plane_add(first_term, second_term) = real_plane.add(first_term, second_term)
                trace(k) = trace(2) = plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2))) = plane_add(first_term, second_term) = real_plane.add(first_term, second_term) = real_plane.add(trace(k - 1), real_plane.smul(coefficients(k), vectors(k)))
    by def $is_linear_combination_partial_sum_sequence(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, trace)
    trace(2) = plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2)))
    witness exist partial fn(k closed_range(0, 2)) finite_seq(R, 2) st {$is_linear_combination_partial_sum_sequence(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, partial), plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2))) = partial(2)} from trace
    by def $has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2))))

# 任何满足上述过程的两项和值，都等于熟悉的 a*u+b*v；不是只检查了一个特殊 trace。
thm two_term_combination_value:
    ? forall coefficients finite_seq(R, 2), vectors finite_seq(finite_seq(R, 2), 2), value finite_seq(R, 2):
        $has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, value)
        =>:
            value = plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2)))
    release struct def real_plane
    real_plane.add = plane_add
    real_plane.smul = plane_smul
    obtain trace from $has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, value)
    by def $is_linear_combination_partial_sum_sequence(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, vectors, trace)
    trace(0) = real_plane.zero
    trace(1) = real_plane.add(trace(0), real_plane.smul(coefficients(1), vectors(1))) = real_plane.smul(coefficients(1), vectors(1))
    have first_term finite_seq(R, 2) = real_plane.smul(coefficients(1), vectors(1))
    have second_term finite_seq(R, 2) = real_plane.smul(coefficients(2), vectors(2))
    trace(1) = first_term
    first_term = plane_smul(coefficients(1), vectors(1))
    second_term = plane_smul(coefficients(2), vectors(2))
    trace(2) = real_plane.add(trace(1), real_plane.smul(coefficients(2), vectors(2)))
    real_plane.add(first_term, second_term) = plane_add(first_term, second_term)
    trace(2) = real_plane.add(trace(1), real_plane.smul(coefficients(2), vectors(2))) = real_plane.add(first_term, second_term) = plane_add(first_term, second_term)
    value = trace(2) = real_plane.add(trace(1), real_plane.smul(coefficients(2), vectors(2))) = plane_add(plane_smul(coefficients(1), vectors(1)), plane_smul(coefficients(2), vectors(2)))

# 2.2 张成是一个真正的集合（参考 LADR 2.4、2.7）
# 用给定方向和任意系数能得到的全部向量，组成 span。
template<K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, vectors finite_seq(V, n)>:
    have span power_set(V) = {x V: $is_linear_combination(K, field, V, space, n, x, vectors)}

# 使用方式：x $in \span<K, field, V, space, n, vectors>。
prop spans(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, vectors finite_seq(V, n)):
    \span<K, field, V, space, n, vectors> = V

# 标准方向列表：长度在类型中，取第 k 项直接写 standard_basis(k)。
have standard_basis finite_seq(finite_seq(R, 2), 2) = (e1, e2)

standard_basis(1) = (1, 0)

standard_basis(2) = (0, 1)

claim:
    ? forall v finite_seq(R, 2):
        v $in \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis>
    have current_span power_set(finite_seq(R, 2)) = {x finite_seq(R, 2): $is_linear_combination(R, real_field, finite_seq(R, 2), real_plane, 2, x, standard_basis)}
    release obj def current_span
    current_span = {x finite_seq(R, 2): $is_linear_combination(R, real_field, finite_seq(R, 2), real_plane, 2, x, standard_basis)}
    \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis> = {x finite_seq(R, 2): $is_linear_combination(R, real_field, finite_seq(R, 2), real_plane, 2, x, standard_basis)}
    \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis> = {x finite_seq(R, 2): $is_linear_combination(R, real_field, finite_seq(R, 2), real_plane, 2, x, standard_basis)} = current_span
    have coefficients finite_seq(R, 2) = (v(1), v(2))
    v = (v(1), v(2))
    coefficients(1) = v(1)
    coefficients(2) = v(2)
    standard_basis(1) = e1
    standard_basis(2) = e2
    e1(1) = 1
    e1(2) = 0
    e2(1) = 0
    e2(2) = 1
    have first_term finite_seq(R, 2) = plane_smul(coefficients(1), standard_basis(1))
    have second_term finite_seq(R, 2) = plane_smul(coefficients(2), standard_basis(2))
    plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2))
    plane_smul(coefficients(2), e2) = (coefficients(2) * e2(1), coefficients(2) * e2(2))
    coefficients(1) * e1(1) = coefficients(1) * 1 = coefficients(1) = v(1)
    coefficients(1) * e1(2) = coefficients(1) * 0 = 0
    first_term = plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2)) = (v(1), 0)
    coefficients(2) * e2(1) = coefficients(2) * 0 = 0
    coefficients(2) * e2(2) = coefficients(2) * 1 = coefficients(2) = v(2)
    second_term = plane_smul(coefficients(2), e2) = (coefficients(2) * e2(1), coefficients(2) * e2(2)) = (0, v(2))
    first_term(1) = v(1)
    first_term(2) = 0
    second_term(1) = 0
    second_term(2) = v(2)
    first_term(1) + second_term(1) = v(1) + 0 = v(1)
    first_term(2) + second_term(2) = 0 + v(2) = v(2)
    plane_add(first_term, second_term) = (first_term(1) + second_term(1), first_term(2) + second_term(2)) = (v(1), v(2))
    plane_add(plane_smul(coefficients(1), standard_basis(1)), plane_smul(coefficients(2), standard_basis(2))) = plane_add(first_term, second_term) = (v(1), v(2)) = v
    release thm two_term_combination_exists(coefficients, standard_basis)
    witness exist scalars finite_seq(R, 2) st {$has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, scalars, standard_basis, v)} from coefficients
    by def $is_linear_combination(R, real_field, finite_seq(R, 2), real_plane, 2, v, standard_basis)
    v $in current_span
    v $in \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis>

\span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis> $subset finite_seq(R, 2)

by def finite_seq(R, 2) $subset \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis>

# 两个包含关系给出集合相等：标准方向的张成就是整个平面。
by extension:
    ? \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis> = finite_seq(R, 2)
    forall v \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis>:
        v $in finite_seq(R, 2)
    forall v finite_seq(R, 2):
        v $in \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis>

by def $spans(R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis)

(3, 4) $in \span<R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis>

# 2.3 能描述整个空间，还要没有多余方向（参考 LADR 2.15）
# 线性无关：只有全部系数为零，才能组合出零向量。
prop has_only_zero_coefficients(K nonempty_set, field &Field<K>, n N, coefficients finite_seq(K, n)):
    forall k N+:
        k <= n
        =>:
            coefficients(k) = field.zero

prop is_linearly_independent(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, vectors finite_seq(V, n)):
    forall coefficients finite_seq(K, n):
        $has_linear_combination_value(K, field, V, space, n, coefficients, vectors, space.zero)
        =>:
            $has_only_zero_coefficients(K, field, n, coefficients)

#
claim:
    ? $is_linearly_independent(R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis)
    claim:
        ? forall coefficients finite_seq(R, 2):
            $has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, standard_basis, real_plane.zero)
            =>:
                $has_only_zero_coefficients(R, real_field, 2, coefficients)
        release thm two_term_combination_value(coefficients, standard_basis, real_plane.zero)
        standard_basis(1) = e1
        standard_basis(2) = e2
        e1(1) = 1
        e1(2) = 0
        e2(1) = 0
        e2(2) = 1
        have first_term finite_seq(R, 2) = plane_smul(coefficients(1), standard_basis(1))
        have second_term finite_seq(R, 2) = plane_smul(coefficients(2), standard_basis(2))
        plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2))
        plane_smul(coefficients(2), e2) = (coefficients(2) * e2(1), coefficients(2) * e2(2))
        coefficients(1) * e1(1) = coefficients(1) * 1 = coefficients(1) = coefficients(1)
        coefficients(1) * e1(2) = coefficients(1) * 0 = 0
        first_term = plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2)) = (coefficients(1), 0)
        coefficients(2) * e2(1) = coefficients(2) * 0 = 0
        coefficients(2) * e2(2) = coefficients(2) * 1 = coefficients(2) = coefficients(2)
        second_term = plane_smul(coefficients(2), e2) = (coefficients(2) * e2(1), coefficients(2) * e2(2)) = (0, coefficients(2))
        first_term(1) = coefficients(1)
        first_term(2) = 0
        second_term(1) = 0
        second_term(2) = coefficients(2)
        first_term(1) + second_term(1) = coefficients(1) + 0 = coefficients(1)
        first_term(2) + second_term(2) = 0 + coefficients(2) = coefficients(2)
        plane_add(first_term, second_term) = (first_term(1) + second_term(1), first_term(2) + second_term(2)) = (coefficients(1), coefficients(2))
        plane_add(plane_smul(coefficients(1), standard_basis(1)), plane_smul(coefficients(2), standard_basis(2))) = plane_add(first_term, second_term) = (coefficients(1), coefficients(2)) = coefficients
        real_plane.zero = (0, 0)
        coefficients = plane_add(plane_smul(coefficients(1), standard_basis(1)), plane_smul(coefficients(2), standard_basis(2))) = real_plane.zero = (0, 0)
        coefficients(1) = 0
        coefficients(2) = 0
        claim:
            ? forall k N+:
                k <= 2
                =>:
                    coefficients(k) = real_field.zero
            k $in closed_range(1, 2)
            expand: k $in closed_range(1, 2)
            k = 1 or k = 2
            by cases:
                ? coefficients(k) = real_field.zero
                case k = 1:
                    coefficients(k) = coefficients(1) = 0 = real_field.zero
                case k = 2:
                    coefficients(k) = coefficients(2) = 0 = real_field.zero
        by def $has_only_zero_coefficients(R, real_field, 2, coefficients)
    by def $is_linearly_independent(R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis)

# 重复一个方向会产生非零的零组合，因此这个列表不是线性无关的。
by contra:
    ? not $is_linearly_independent(R, real_field, finite_seq(R, 2), real_plane, 2, repeated_directions)
    $is_linearly_independent(R, real_field, finite_seq(R, 2), real_plane, 2, repeated_directions)
    have coefficients finite_seq(R, 2) = (1, -1)
    coefficients(1) = 1
    coefficients(2) = -1
    repeated_directions(1) = e1
    repeated_directions(2) = e1
    e1(1) = 1
    e1(2) = 0
    have first_term finite_seq(R, 2) = plane_smul(coefficients(1), e1)
    have second_term finite_seq(R, 2) = plane_smul(coefficients(2), e1)
    plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2))
    plane_smul(coefficients(2), e1) = (coefficients(2) * e1(1), coefficients(2) * e1(2))
    coefficients(1) * e1(1) = 1
    coefficients(1) * e1(2) = 0
    coefficients(2) * e1(1) = -1
    coefficients(2) * e1(2) = 0
    first_term = (1, 0)
    second_term = (-1, 0)
    first_term(1) = 1
    first_term(2) = 0
    second_term(1) = -1
    second_term(2) = 0
    first_term(1) + second_term(1) = 1 + (-1) = 0
    first_term(2) + second_term(2) = 0
    plane_add(first_term, second_term) = (first_term(1) + second_term(1), first_term(2) + second_term(2)) = (0, 0) = real_plane.zero
    plane_smul(coefficients(1), repeated_directions(1)) = plane_smul(coefficients(1), e1) = first_term
    plane_smul(coefficients(2), repeated_directions(2)) = plane_smul(coefficients(2), e1) = second_term
    real_plane.zero = (0, 0)
    plane_add(plane_smul(coefficients(1), repeated_directions(1)), plane_smul(coefficients(2), repeated_directions(2))) = plane_add(first_term, second_term) = real_plane.zero
    release thm two_term_combination_exists(coefficients, repeated_directions)
    $has_linear_combination_value(R, real_field, finite_seq(R, 2), real_plane, 2, coefficients, repeated_directions, real_plane.zero)
    $has_only_zero_coefficients(R, real_field, 2, coefficients)
    coefficients(1) = real_field.zero = 0
    impossible 1 = 0

# 2.4 基与唯一坐标（参考 LADR 2.26、2.28）
prop is_basis(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N, vectors finite_seq(V, n)):
    $is_linearly_independent(K, field, V, space, n, vectors)
    $spans(K, field, V, space, n, vectors)

#
by def $is_basis(R, real_field, finite_seq(R, 2), real_plane, 2, standard_basis)

# 标准坐标确实给出向量本身，接着证明它们也是唯一可能的系数。
claim:
    ? forall v finite_seq(R, 2):
        plane_add(plane_smul(v(1), standard_basis(1)), plane_smul(v(2), standard_basis(2))) = v
    have coefficients finite_seq(R, 2) = (v(1), v(2))
    v = (v(1), v(2))
    coefficients(1) = v(1)
    coefficients(2) = v(2)
    standard_basis(1) = e1
    standard_basis(2) = e2
    e1(1) = 1
    e1(2) = 0
    e2(1) = 0
    e2(2) = 1
    have first_term finite_seq(R, 2) = plane_smul(coefficients(1), standard_basis(1))
    have second_term finite_seq(R, 2) = plane_smul(coefficients(2), standard_basis(2))
    plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2))
    plane_smul(coefficients(2), e2) = (coefficients(2) * e2(1), coefficients(2) * e2(2))
    coefficients(1) * e1(1) = coefficients(1) * 1 = coefficients(1) = v(1)
    coefficients(1) * e1(2) = coefficients(1) * 0 = 0
    first_term = plane_smul(coefficients(1), e1) = (coefficients(1) * e1(1), coefficients(1) * e1(2)) = (v(1), 0)
    coefficients(2) * e2(1) = coefficients(2) * 0 = 0
    coefficients(2) * e2(2) = coefficients(2) * 1 = coefficients(2) = v(2)
    second_term = plane_smul(coefficients(2), e2) = (coefficients(2) * e2(1), coefficients(2) * e2(2)) = (0, v(2))
    first_term(1) = v(1)
    first_term(2) = 0
    second_term(1) = 0
    second_term(2) = v(2)
    first_term(1) + second_term(1) = v(1) + 0 = v(1)
    first_term(2) + second_term(2) = 0 + v(2) = v(2)
    plane_add(first_term, second_term) = (first_term(1) + second_term(1), first_term(2) + second_term(2)) = (v(1), v(2))
    plane_add(plane_smul(coefficients(1), standard_basis(1)), plane_smul(coefficients(2), standard_basis(2))) = plane_add(first_term, second_term) = (v(1), v(2)) = v
    plane_smul(v(1), standard_basis(1)) = plane_smul(coefficients(1), standard_basis(1))
    plane_smul(v(2), standard_basis(2)) = plane_smul(coefficients(2), standard_basis(2))
    plane_add(plane_smul(v(1), standard_basis(1)), plane_smul(v(2), standard_basis(2))) = plane_add(plane_smul(coefficients(1), standard_basis(1)), plane_smul(coefficients(2), standard_basis(2))) = v

# 一个系数对本身就是平面向量。刚证明的标准展开把它还原出来，因此系数唯一。
thm standard_coordinates_unique:
    ? forall v finite_seq(R, 2), a, b R:
        v = plane_add(plane_smul(a, standard_basis(1)), plane_smul(b, standard_basis(2)))
        =>:
            a = v(1)
            b = v(2)
    have coordinates finite_seq(R, 2) = (a, b)
    coordinates(1) = a
    coordinates(2) = b
    plane_add(plane_smul(coordinates(1), standard_basis(1)), plane_smul(coordinates(2), standard_basis(2))) = coordinates
    plane_smul(coordinates(1), standard_basis(1)) = plane_smul(a, standard_basis(1))
    plane_smul(coordinates(2), standard_basis(2)) = plane_smul(b, standard_basis(2))
    coordinates = plane_add(plane_smul(coordinates(1), standard_basis(1)), plane_smul(coordinates(2), standard_basis(2))) = plane_add(plane_smul(a, standard_basis(1)), plane_smul(b, standard_basis(2))) = v
    a = coordinates(1) = v(1)
    b = coordinates(2) = v(2)

# 2.5 有限维与维数的含义（参考 LADR 2.9、2.34--2.35）
prop is_finite_dimensional(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>):
    exist n N, vectors finite_seq(V, n) st {$spans(K, field, V, space, n, vectors)}

witness exist n N, vectors finite_seq(finite_seq(R, 2), n) st {$spans(R, real_field, finite_seq(R, 2), real_plane, n, vectors)} from 2, standard_basis

by def $is_finite_dimensional(R, real_field, finite_seq(R, 2), real_plane)

prop has_basis_length(K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>, n N):
    exist vectors finite_seq(V, n) st {$is_basis(K, field, V, space, n, vectors)}

# 下一步必须实际证明：有限维空间存在基；任意两个基的长度相同。
# 在这两件事完成前，不声明已验证的 dimension 值。
# 一般维数的目标接口（计划，未执行）：
# template<K nonempty_set, field &Field<K>, V nonempty_set, space &VectorSpace<K, field, V>: $is_finite_dimensional(K, field, V, space)>:
#     have dimension N:
#         $has_basis_length(K, field, V, space, dimension)
#
witness exist vectors finite_seq(finite_seq(R, 2), 2) st {$is_basis(R, real_field, finite_seq(R, 2), real_plane, 2, vectors)} from standard_basis

by def $has_basis_length(R, real_field, finite_seq(R, 2), real_plane, 2)
# 本讲已证明：标准方向构成基，每个平面向量有唯一的两个实坐标，这个基长度为2。
# 这解释了“平面是二维”的直观含义。要让 dimension 不依赖所选基，还要证明
# 任意两个基长度相同，再定义一般 dimension。这里没有假定或伪造该一般定理。
# 下一讲可集中讲基的删减/扩张与基长度唯一性；完整多项式体系、一般函数空间
# 公理和维数加法长证明作为按需扩展，不是这份讲稿的完成门槛。
