        case n = 1: 2
        case n = 2: 4
        case n = 3: 6
    $is_finite_set(fn_range(double_on_three))
    forall X, Y nonempty_set:
        $is_finite_set(X)
        $is_finite_set(Y)
        =>:
            $is_finite_set(cart(X, Y))
    forall X, Y nonempty_set:
        $is_finite_set(X)
        $is_finite_set(Y)
        =>:
            finite_set_size(cart(X, Y)) = finite_set_size(X) * finite_set_size(Y)
    finite_set_size(cart({1, 2}, {3, 4, 5})) = finite_set_size({1, 2}) * finite_set_size({3, 4, 5}) = 6
    finite_set_size(cart({3, 4, 5}, {1, 2})) = finite_set_size({3, 4, 5}) * finite_set_size({1, 2}) = 6
