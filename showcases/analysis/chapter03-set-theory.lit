        witness $has_equal_cardinality(X, X) from id_X
prop has_cardinality(X set, n N):
    $has_equal_cardinality(X, range(0, n))
sketch:
    have fn shift_zero_to_one(i_index {0, 1, 2, 3}) {1, 2, 3, 4} by cases:
        case i_index = 0: 1
        case i_index = 1: 2
        case i_index = 2: 3
        case i_index = 3: 4
    by enumerate finite_set:
        ? forall x {0, 1, 2, 3}:
            x $in N
            shift_zero_to_one(x) = x + 1
        x $in N
        shift_zero_to_one(x) = x + 1
    claim:
        ? forall x1, x2 {0, 1, 2, 3}:
            shift_zero_to_one(x1) = shift_zero_to_one(x2)
            =>:
                x1 = x2
        x1 $in N
        x2 $in N
        x1 + 1 = shift_zero_to_one(x1) = shift_zero_to_one(x2) = x2 + 1
        x1 = x1 + 1 - 1 = x2 + 1 - 1 = x2
    by def $is_injective_fn({0, 1, 2, 3}, {1, 2, 3, 4}, shift_zero_to_one)
    claim:
        ? forall y {1, 2, 3, 4}:
            exist x {0, 1, 2, 3} st {y = shift_zero_to_one(x)}
        by cases:
            ? exist x {0, 1, 2, 3} st {y = shift_zero_to_one(x)}
            case y = 1:
                witness exist x {0, 1, 2, 3} st {y = shift_zero_to_one(x)} from 0:
                    y = 1 = shift_zero_to_one(0)
            case y = 2:
                witness exist x {0, 1, 2, 3} st {y = shift_zero_to_one(x)} from 1:
                    y = 2 = shift_zero_to_one(1)
            case y = 3:
                witness exist x {0, 1, 2, 3} st {y = shift_zero_to_one(x)} from 2:
                    y = 3 = shift_zero_to_one(2)
            case y = 4:
                witness exist x {0, 1, 2, 3} st {y = shift_zero_to_one(x)} from 3:
                    y = 4 = shift_zero_to_one(3)
    by def $is_surjective_fn({0, 1, 2, 3}, {1, 2, 3, 4}, shift_zero_to_one)
    by def $is_bijective_fn({0, 1, 2, 3}, {1, 2, 3, 4}, shift_zero_to_one)
    witness $has_equal_cardinality({0, 1, 2, 3}, {1, 2, 3, 4}) from shift_zero_to_one
