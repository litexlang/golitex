prop is_universal_set(U set):
    forall x set:
        x $in U
claim:
    ? forall U set:
        not $is_universal_set(U)
    by contra:
        ? not $is_universal_set(U)
        U $in U
        U $in {U}
        release regularity_axiom({U})
        obtain x from exist x {U} st {intersect(x, {U}) = {}}
        x = U
        intersect(U, {U}) = intersect(x, {U}) = {}
        U $in intersect(U, {U})
        U $in {}
        impossible not U $in {}
