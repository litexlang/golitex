    exist f fn(x S) T st {$is_bijective_fn(S, T, f)}
sketch:
    have fn shift_0_to_3(n {0, 1, 2}) {3, 4, 5} by cases:
        case n = 0: 3
        case n = 1: 4
        case n = 2: 5
    by enumerate finite_set:
        ? forall x {0, 1, 2}:
            x $in N
            shift_0_to_3(x) = x + 3
        x $in N
        shift_0_to_3(x) = x + 3
    claim:
        ? forall x1, x2 {0, 1, 2}:
            shift_0_to_3(x1) = shift_0_to_3(x2)
            =>:
                x1 = x2
        x1 $in N
        x2 $in N
        shift_0_to_3(x1) = x1 + 3
        shift_0_to_3(x2) = x2 + 3
        x1 + 3 = x2 + 3
        x1 = x1 + 3 - 3 = x2 + 3 - 3 = x2
    by def $is_injective_fn({0, 1, 2}, {3, 4, 5}, shift_0_to_3)
    claim:
        ? forall y {3, 4, 5}:
            exist x {0, 1, 2} st {y = shift_0_to_3(x)}
        by cases:
            ? exist x {0, 1, 2} st {y = shift_0_to_3(x)}
            case y = 3:
                witness exist x {0, 1, 2} st {y = shift_0_to_3(x)} from 0:
                    y = 3 = shift_0_to_3(0)
            case y = 4:
                witness exist x {0, 1, 2} st {y = shift_0_to_3(x)} from 1:
                    y = 4 = shift_0_to_3(1)
            case y = 5:
                witness exist x {0, 1, 2} st {y = shift_0_to_3(x)} from 2:
                    y = 5 = shift_0_to_3(2)
    by def $is_surjective_fn({0, 1, 2}, {3, 4, 5}, shift_0_to_3)
    by def $is_bijective_fn({0, 1, 2}, {3, 4, 5}, shift_0_to_3)
    witness $has_equal_cardinality({0, 1, 2}, {3, 4, 5}) from shift_0_to_3
prop is_even_nat(m N):
    exist k N st {m = 2 * k}
sketch:
    have even_N set = {m N: $is_even_nat(m)}
    claim:
        ? forall n N:
            2 * n $in even_N
        witness $is_even_nat(2 * n) from n
        release thm set_builder_member(2 * n, {m N: $is_even_nat(m)})
    have fn double_to_even(n N) even_N = 2 * n
    forall n N:
        double_to_even(n) = 2 * n
    claim:
        ? forall x1, x2 N:
            double_to_even(x1) = double_to_even(x2)
            =>:
                x1 = x2
        2 * x1 = double_to_even(x1) = double_to_even(x2) = 2 * x2
        x1 = (2 * x1) / 2 = (2 * x2) / 2 = x2
    by def $is_injective_fn(N, even_N, double_to_even)
    claim:
        ? forall y even_N:
            exist x N st {y = double_to_even(x)}
        y $in {m N: $is_even_nat(m)}
        $is_even_nat(y)
        obtain k from exist k N st {y = 2 * k}
        witness exist x N st {y = double_to_even(x)} from k:
            y = 2 * k = double_to_even(k)
    by def $is_surjective_fn(N, even_N, double_to_even)
    by def $is_bijective_fn(N, even_N, double_to_even)
    witness $has_equal_cardinality(N, even_N) from double_to_even
    by contra:
        ? not 1 $in even_N
        1 $in even_N
        1 $in {m N: $is_even_nat(m)}
        $is_even_nat(1)
        obtain k from exist k N st {1 = 2 * k}
        k = (2 * k) / 2 = 1 / 2
        impossible not 1 / 2 $in N
