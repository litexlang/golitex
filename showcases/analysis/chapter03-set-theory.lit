    by contra:
        ? not $is_finite_set(N)
        have k N = finite_set_size(N)
        $is_finite_set(0...k)
        by def 0...k $subset N
        finite_set_size(0...k) = k - 0 + 1 = k + 1
        finite_set_size(0...k) <= finite_set_size(N)
        k + 1 = finite_set_size(0...k) <= finite_set_size(N) = k < k + 1
        impossible k + 1 = k + 1
thm finite_subset_is_finite_by_double_difference:
    ? forall A set, B finite_set:
        A $subset B
        =>:
            $is_finite_set(A)
    A = set_minus(B, set_minus(B, A))
    $is_finite_set(set_minus(B, set_minus(B, A)))
sketch:
    forall X, Y finite_set:
        $is_finite_set(union(X, Y))
        finite_set_size(union(X, Y)) <= finite_set_size(X) + finite_set_size(Y)
    forall X, Y finite_set:
        intersect(X, Y) = {}
        =>:
            finite_set_size(intersect(X, Y)) = finite_set_size({}) = 0
            finite_set_size(union(X, Y)) = finite_set_size(X) + finite_set_size(Y) - finite_set_size(intersect(X, Y)) = finite_set_size(X) + finite_set_size(Y)
    by extension:
        ? intersect({1, 2}, {3}) = {}
        claim:
            ? forall x intersect({1, 2}, {3}):
                x $in {}
            x $in {1, 2}
            x $in {3}
            x = 1 or x = 2
            x = 3
            by cases:
                ? x $in {}
                case x = 1:
                    impossible 1 = 3
                case x = 2:
                    impossible 2 = 3
        forall y {}:
            y $in intersect({1, 2}, {3})
    finite_set_size(intersect({1, 2}, {3})) = finite_set_size({}) = 0
    finite_set_size(union({1, 2}, {3})) = finite_set_size({1, 2}) + finite_set_size({3}) - finite_set_size(intersect({1, 2}, {3})) = 2 + 1 - 0 = 3
    claim:
        ? forall X finite_set, Y set:
            Y $subset X
            =>:
                $is_finite_set(Y)
                finite_set_size(Y) <= finite_set_size(X)
        release thm subset_of_finite_set_is_finite(Y, X)
