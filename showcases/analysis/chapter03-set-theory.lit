        impossible 5 < 4
    by contra:
        ? not 5 $in {n N: n + 1 < 5}
        impossible 5 + 1 < 5
sketch:
    have X_example set = {1, 2, 3}
    have Y_example set = {1, 2, 3}
    prop P_example(x X_example, y Y_example):
        y = x
    claim:
        ? forall x X_example:
            exist! y Y_example st {$P_example(x, y)}
        witness exist! y Y_example st {$P_example(x, y)} from x:
            by def $P_example(x, x)
            forall y1, y2 Y_example:
                $P_example(x, y1)
                $P_example(x, y2)
                =>:
                    y1 = y2
    have fn f_from_relation by exist!:
        ? forall x X_example:
            exist! y Y_example st {$P_example(x, y)}
sketch:
    claim:
        ? forall x N:
            exist! y N st {y = x + 1}
        witness exist! y N st {y = x + 1} from x + 1
    have fn increment_from_relation by exist!:
        ? forall x N:
            exist! y N st {y = x + 1}
    increment_from_relation(4) = 5
    forall n N:
        increment_from_relation(2 * n + 3) = (2 * n + 3) + 1 = 2 * n + 4
    have fn increment_N(n N) N = n + 1
    have fn succ(n N) N+ = n + 1
    increment_N(4) = 5
    increment_N(2 * 3 + 3) = 10
    succ(0) = 1
    claim:
        ? forall a N+:
            exist! b N st {b + 1 = a}
        claim:
            ? forall b1 N, b2 N:
                b1 + 1 = a
                b2 + 1 = a
                =>:
                    b1 = b2
            b1 = (b1 + 1) - 1 = a - 1 = (b2 + 1) - 1 = b2
        witness exist! b N st {b + 1 = a} from a - 1
    have fn pred_pos_from_relation by exist!:
        ? forall a N+:
            exist! b N st {b + 1 = a}
    have fn pred_pos(n N+) N = n - 1
    pred_pos(1) = 0
    pred_pos(4) = 3
    succ(pred_pos(4)) = 4
