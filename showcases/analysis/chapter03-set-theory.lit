    by contra:
        ? not $is_universal_set({1, 2})
        3 $in {1, 2}
        impossible not 3 $in {1, 2}
    release thm set_builder_member(2, {n N: n < 4})
    release thm set_builder_member(2, {n N: n + 1 < 5})
