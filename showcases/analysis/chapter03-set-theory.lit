sketch:
    have fn poly1(x R) R = x^2 + 2 * x + 1
    have fn poly2(x R) R = (x + 1)^2
    by fn_extension:
        ? poly1 = poly2
        forall x R:
            poly1(x) = x^2 + 2 * x + 1 = (x + 1)^2 = poly2(x)
sketch:
    have fn id_on_positive_naturals(x N+) R = x
    have fn abs_on_positive_naturals(x N+) R = abs(x)
    forall x N+:
        abs_on_positive_naturals(x) = abs(x) = x = id_on_positive_naturals(x)
    by fn_extension id_on_positive_naturals = abs_on_positive_naturals
    have fn id_R(x R) R = x
    have fn abs_R(x R) R = abs(x)
    id_R(-2) = (-2)
    abs_R(-2) = 2
    id_R(-2) != abs_R(-2)
sketch:
    have fn empty_to_N(x {}) N = 0
    have fn empty_to_N_alt(x {}) N = 1
    forall x {}:
        empty_to_N(x) = empty_to_N_alt(x)
    by fn_extension empty_to_N = empty_to_N_alt
sketch:
    have fn double_nat(n N) N = 2 * n
    have fn add3_nat(n N) N = n + 3
    have fn add3_after_double(n N) N = add3_nat(double_nat(n))
    have fn double_after_add3(n N) N = double_nat(add3_nat(n))
    add3_after_double(1) = add3_nat(double_nat(1)) = add3_nat(2) = 5
    double_after_add3(1) = double_nat(add3_nat(1)) = double_nat(4) = 8
    add3_after_double(1) != double_after_add3(1)
sketch:
    claim:
        ? forall X0, Y0, Z0, W0 set, f fn(z Z0) W0, g fn(y Y0) Z0, h fn(x X0) Y0:
            fn(t X0) W0 {f(g(h(t)))} = fn(t X0) W0 {fn(u Y0) W0 {f(g(u))}(h(t))}
        by fn_extension fn(t X0) W0 {f(g(h(t)))} = fn(t X0) W0 {fn(u Y0) W0 {f(g(u))}(h(t))}
    claim:
        ? forall X0, Y0, Z0, W0 set, f fn(z Z0) W0, g fn(y Y0) Z0, h fn(x X0) Y0:
            fn(t X0) W0 {f(g(h(t)))} = fn(t X0) W0 {f(fn(u X0) Z0 {g(h(u))}(t))}
        by fn_extension fn(t X0) W0 {f(g(h(t)))} = fn(t X0) W0 {f(fn(u X0) Z0 {g(h(u))}(t))}
prop is_injective_fn(S, T set, f fn(x S) T):
    forall x1, x2 S:
        f(x1) = f(x2)
        =>:
            x1 = x2
sketch:
    have fn square_Z(z Z) Z = z^2
    square_Z(1) = 1
    square_Z(-1) = 1
    1 != (-1)
    by contra:
        ? not $is_injective_fn(Z, Z, square_Z)
        impossible 1 = (-1)
    have fn square_N(n N) Z = n^2
    claim:
        ? forall x1, x2 N:
            square_N(x1) = square_N(x2)
            =>:
                x1 = x2
        x1^2 = square_N(x1) = square_N(x2) = x2^2
        x1 = sqrt(x1^2) = sqrt(x2^2) = x2
    by def $is_injective_fn(N, Z, square_N)
prop is_surjective_fn(S, T set, f fn(x S) T):
    forall y T:
        exist x S st {y = f(x)}
sketch:
    have fn square_Z(z Z) Z = z^2
    by contra:
        ? not exist n Z st {square_Z(n) = (-1)}
        obtain k from exist n Z st {square_Z(n) = (-1)}
        square_Z(k) = k^2
        k^2 = square_Z(k) = (-1)
        k^2 >= 0
        (-1) >= 0
        impossible -1 >= 0
    by contra:
        ? not $is_surjective_fn(Z, Z, square_Z)
        obtain k2 from exist n Z st {(-1) = square_Z(n)}
        impossible square_Z(k2) = (-1)
prop is_bijective_fn(S, T set, f fn(x S) T):
    $is_injective_fn(S, T, f)
    $is_surjective_fn(S, T, f)
sketch:
    have fn finite_not_injective(x {0, 1, 2}) {3, 4} by cases:
        case x = 0: 3
        case x = 1: 3
        case x = 2: 4
    finite_not_injective(0) = 3
    finite_not_injective(1) = 3
    0 != 1
    by contra:
        ? not $is_injective_fn({0, 1, 2}, {3, 4}, finite_not_injective)
        impossible 0 = 1
    have fn finite_not_surjective(x {0, 1}) {2, 3, 4} by cases:
        case x = 0: 2
        case x = 1: 3
    finite_not_surjective(0) = 2
    finite_not_surjective(1) = 3
    not 4 $in {2, 3}
    by contra:
        ? not $is_surjective_fn({0, 1}, {2, 3, 4}, finite_not_surjective)
        obtain a from exist x {0, 1} st {4 = finite_not_surjective(x)}
        a = 0 or a = 1
        by cases:
            ? finite_not_surjective(a) $in {2, 3}
            case a = 0:
                finite_not_surjective(a) = finite_not_surjective(0) = 2
                finite_not_surjective(a) $in {2, 3}
            case a = 1:
                finite_not_surjective(a) = finite_not_surjective(1) = 3
                finite_not_surjective(a) $in {2, 3}
        impossible 4 $in {2, 3}
    have fn finite_bijection(x {0, 1, 2}) {3, 4, 5} by cases:
        case x = 0: 3
        case x = 1: 4
        case x = 2: 5
    finite_bijection(0) = 3
    finite_bijection(1) = 4
    finite_bijection(2) = 5
    by enumerate finite_set:
        ? forall x1, x2 {0, 1, 2}:
            finite_bijection(x1) = finite_bijection(x2)
            =>:
                x1 = x2
        x1 = x2
    by def $is_injective_fn({0, 1, 2}, {3, 4, 5}, finite_bijection)
    claim:
        ? forall y {3, 4, 5}:
            exist x {0, 1, 2} st {y = finite_bijection(x)}
        by cases:
            ? exist x {0, 1, 2} st {y = finite_bijection(x)}
            case y = 3:
                witness exist x {0, 1, 2} st {y = finite_bijection(x)} from 0
            case y = 4:
                witness exist x {0, 1, 2} st {y = finite_bijection(x)} from 1
            case y = 5:
                witness exist x {0, 1, 2} st {y = finite_bijection(x)} from 2
    by def $is_surjective_fn({0, 1, 2}, {3, 4, 5}, finite_bijection)
    by def $is_bijective_fn({0, 1, 2}, {3, 4, 5}, finite_bijection)
sketch:
    have fn succ_bijection(n N) N+ = n + 1
    forall n N:
        succ_bijection(n) = n + 1
    claim:
        ? forall x1, x2 N:
            succ_bijection(x1) = succ_bijection(x2)
            =>:
                x1 = x2
        x1 + 1 = succ_bijection(x1) = succ_bijection(x2) = x2 + 1
        x1 = (x1 + 1) - 1 = (x2 + 1) - 1 = x2
    by def $is_injective_fn(N, N+, succ_bijection)
    claim:
        ? forall y N+:
            exist x N st {y = succ_bijection(x)}
        witness exist x N st {y = succ_bijection(x)} from y - 1:
            y = (y - 1) + 1 = succ_bijection(y - 1)
    by def $is_surjective_fn(N, N+, succ_bijection)
    by def $is_bijective_fn(N, N+, succ_bijection)
    have fn succ_to_N(n N) N = n + 1
    0 $in N
    not 0 $in N+
    by contra:
        ? not exist x N st {succ_to_N(x) = 0}
        obtain k from exist x N st {succ_to_N(x) = 0}
        k + 1 $in N+
        0 = succ_to_N(k) = k + 1
        impossible 0 $in N+
    by contra:
        ? not $is_surjective_fn(N, N, succ_to_N)
        obtain k2 from exist x N st {0 = succ_to_N(x)}
        impossible succ_to_N(k2) = 0
prop has_preimage_in_subset(X, Y set, A power_set(X), f fn(z X) Y, y Y):
    exist x A st {x $in X, y = f(x)}
template<X set, Y set, f fn(x X) Y, A power_set(X)>:
    have restricted_image set = {y Y: $has_preimage_in_subset(X, Y, A, f, y)}
thm injective_fn_has_unique_preimage_in_range:
    ? forall X, Y set, f fn(z X) Y, y fn_range(f):
        $is_injective_fn(X, Y, f)
        =>:
            exist! x X st {y = f(x)}
    have by fn_preimage: chosen_preimage from y $in fn_range(f)
    witness exist! x X st {y = f(x)} from chosen_preimage:
        forall x1, x2 X:
            y = f(x1)
            y = f(x2)
            =>:
                x1 = x2
prop is_forward_image_of(S, T set, f fn(x S) T, A, B set):
    A $subset S
    B $subset T
    forall x A:
        f(x) $in B
    forall y B:
        exist x A st {y = f(x)}
sketch:
    have fn double_nat(n N) N = 2 * n
    have fn double_on_three(n {1, 2, 3}) {2, 4, 6} by cases:
        case n = 1: 2
        case n = 2: 4
        case n = 3: 6
    double_on_three(1) = 2
    double_on_three(2) = 4
    double_on_three(3) = 6
    claim:
        ? forall y {2, 4, 6}:
            exist x {1, 2, 3} st {y = double_on_three(x)}
        by cases:
            ? exist x {1, 2, 3} st {y = double_on_three(x)}
            case y = 2:
                witness exist x {1, 2, 3} st {y = double_on_three(x)} from 1
            case y = 4:
                witness exist x {1, 2, 3} st {y = double_on_three(x)} from 2
            case y = 6:
                witness exist x {1, 2, 3} st {y = double_on_three(x)} from 3
    by def $is_forward_image_of({1, 2, 3}, {2, 4, 6}, double_on_three, {1, 2, 3}, {2, 4, 6})
    witness $has_preimage_in_subset(N, N, {1, 2, 3}, double_nat, double_nat(1)) from 1
    \restricted_image<N, N, double_nat, {1, 2, 3}> = {y N: $has_preimage_in_subset(N, N, {1, 2, 3}, double_nat, y)}
    release thm set_builder_member(double_nat(1), {y N: $has_preimage_in_subset(N, N, {1, 2, 3}, double_nat, y)})
    double_nat(1) $in \restricted_image<N, N, double_nat, {1, 2, 3}>
    claim:
        ? forall y {2, 4, 6}:
            y $in fn_range(double_on_three)
        obtain x from exist x {1, 2, 3} st {y = double_on_three(x)}
        double_on_three(x) $in fn_range(double_on_three)
    by extension:
        ? fn_range(double_on_three) = {2, 4, 6}
        forall extension_member_left fn_range(double_on_three):
            extension_member_left $in {2, 4, 6}
        forall extension_member_right {2, 4, 6}:
            extension_member_right $in fn_range(double_on_three)
    finite_set_size(fn_range(double_on_three)) = finite_set_size({2, 4, 6}) = 3
sketch:
    have fn square_Z(z Z) Z = z^2
    have fn square_on_example(z {(-1), 0, 1, 2}) {0, 1, 4} by cases:
        case z = (-1): 1
        case z = 0: 0
        case z = 1: 1
        case z = 2: 4
    square_on_example(-1) = 1
    square_on_example(0) = 0
    square_on_example(1) = 1
    square_on_example(2) = 4
    claim:
        ? forall y {0, 1, 4}:
            exist z {(-1), 0, 1, 2} st {y = square_on_example(z)}
        by cases:
            ? exist z {(-1), 0, 1, 2} st {y = square_on_example(z)}
            case y = 0:
                witness exist z {(-1), 0, 1, 2} st {y = square_on_example(z)} from 0
            case y = 1:
                witness exist z {(-1), 0, 1, 2} st {y = square_on_example(z)} from (-1)
            case y = 4:
                witness exist z {(-1), 0, 1, 2} st {y = square_on_example(z)} from 2
    by def $is_forward_image_of({(-1), 0, 1, 2}, {0, 1, 4}, square_on_example, {(-1), 0, 1, 2}, {0, 1, 4})
    claim:
        ? forall y {0, 1, 4}:
            y $in fn_range(square_on_example)
        obtain z from exist z {(-1), 0, 1, 2} st {y = square_on_example(z)}
        square_on_example(z) $in fn_range(square_on_example)
    by extension:
        ? fn_range(square_on_example) = {0, 1, 4}
        forall extension_member_left fn_range(square_on_example):
            extension_member_left $in {0, 1, 4}
        forall extension_member_right {0, 1, 4}:
            extension_member_right $in fn_range(square_on_example)
    finite_set_size(fn_range(square_on_example)) = finite_set_size({0, 1, 4}) = 3
    finite_set_size({(-1), 0, 1, 2}) = 4
    square_Z(-1) = 1
    square_Z(1) = 1
    (-1) != 1
    square_Z(-2) = 4
    not (-2) $in {(-1), 0, 1, 2}
prop is_inverse_image_of(S, T set, f fn(x S) T, U, A set):
    U $subset T
    A $subset S
    forall x A:
        f(x) $in U
    forall x S:
        f(x) $in U
        =>:
            x $in A
sketch:
    have fn double_nat(n N) N = 2 * n
    have fn double_on_one(n {1}) {2} by cases:
        case n = 1: 2
    double_nat(1) = 2
    2 $in {1, 2, 3}
    double_nat(2) = 4
    not 4 $in {1, 2, 3}
    by enumerate finite_set:
        ? forall u {1, 2, 3}:
            u $in N
        u $in N
    by enumerate finite_set:
        ? forall a {1}:
            a $in N
        a $in N
    by enumerate finite_set:
        ? forall x {1}:
            double_nat(x) $in {1, 2, 3}
        x = 1
        double_nat(x) = double_nat(1) = 2
        double_nat(x) $in {1, 2, 3}
    claim:
        ? forall x N:
            double_nat(x) $in {1, 2, 3}
            =>:
                x $in {1}
        double_nat(x) = 1 or double_nat(x) = 2 or double_nat(x) = 3
        by cases:
            ? x $in {1}
            case double_nat(x) = 1:
                2 * x = double_nat(x) = 1
                x = (2 * x) / 2 = 1 / 2
                impossible not 1 / 2 $in N
            case double_nat(x) = 2:
                2 * x = double_nat(x) = 2
                x = (2 * x) / 2 = 2 / 2 = 1
                x $in {1}
            case double_nat(x) = 3:
                2 * x = double_nat(x) = 3
                x = (2 * x) / 2 = 3 / 2
                impossible not 3 / 2 $in N
    by def $is_inverse_image_of(N, N, double_nat, {1, 2, 3}, {1})
    double_on_one(1) = 2
    {2} != {1, 2, 3}
sketch:
    have fn square_Z(z Z) Z = z^2
    square_Z(-1) = 1
    square_Z(1) = 1
    (-1) != 1
    by enumerate finite_set:
        ? forall u {0, 1, 4}:
            u $in Z
        u $in Z
    by enumerate finite_set:
        ? forall z {(-2), (-1), 0, 1, 2}:
            z $in Z
        z $in Z
    claim:
        ? forall z Z:
            square_Z(z) $in {0, 1, 4}
            =>:
                z $in {(-2), (-1), 0, 1, 2}
        square_Z(z) = 0 or square_Z(z) = 1 or square_Z(z) = 4
        by cases:
            ? z $in {(-2), (-1), 0, 1, 2}
            case square_Z(z) = 0:
                z^2 = square_Z(z) = 0
                z = 0
                z $in {(-2), (-1), 0, 1, 2}
            case square_Z(z) = 1:
                z^2 = square_Z(z) = 1
                (z - 1) * (z + 1) = z^2 - 1 = square_Z(z) - 1 = 0
                z - 1 = 0 or z + 1 = 0
                by cases:
                    ? z $in {(-2), (-1), 0, 1, 2}
                    case z - 1 = 0:
                        z = 1
                        z $in {(-2), (-1), 0, 1, 2}
                    case z + 1 = 0:
                        z = (-1)
                        z $in {(-2), (-1), 0, 1, 2}
            case square_Z(z) = 4:
                z^2 = square_Z(z) = 4
                (z - 2) * (z + 2) = z^2 - 4 = square_Z(z) - 4 = 0
                z - 2 = 0 or z + 2 = 0
                by cases:
                    ? z $in {(-2), (-1), 0, 1, 2}
                    case z - 2 = 0:
                        z = 2
                        z $in {(-2), (-1), 0, 1, 2}
                    case z + 2 = 0:
                        z = (-2)
                        z $in {(-2), (-1), 0, 1, 2}
    claim:
        ? forall z {(-2), (-1), 0, 1, 2}:
            square_Z(z) $in {0, 1, 4}
        by cases:
            ? square_Z(z) $in {0, 1, 4}
            case z = (-2):
                square_Z(z) = square_Z((-2)) = 4
                square_Z(z) $in {0, 1, 4}
            case z = (-1):
                square_Z(z) = square_Z((-1)) = 1
                square_Z(z) $in {0, 1, 4}
            case z = 0:
                square_Z(z) = square_Z(0) = 0
                square_Z(z) $in {0, 1, 4}
            case z = 1:
                square_Z(z) = square_Z(1) = 1
                square_Z(z) $in {0, 1, 4}
            case z = 2:
                square_Z(z) = square_Z(2) = 4
                square_Z(z) $in {0, 1, 4}
    by def $is_inverse_image_of(Z, Z, square_Z, {0, 1, 4}, {(-2), (-1), 0, 1, 2})
    (-2) $in {(-2), (-1), 0, 1, 2}
    not (-2) $in {(-1), 0, 1, 2}
sketch:
    claim:
        ? forall S, T set, f fn(x S) T, A, B set:
            A $subset S
            $is_injective_fn(S, T, f)
            $is_forward_image_of(S, T, f, A, B)
            =>:
                $is_inverse_image_of(S, T, f, B, A)
        claim:
            ? forall x S:
                f(x) $in B
                =>:
                    x $in A
            obtain a from exist a A st {f(x) = f(a)}
            a $in S
            x = a
        by def $is_inverse_image_of(S, T, f, B, A)
