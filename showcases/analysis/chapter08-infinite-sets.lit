                    p $in upper_natural_triangle
release thm union_of_two_countable_sets_is_countable(natural_triangle, upper_natural_triangle)
thm product_of_countable_sets_is_countable:
    ? forall X, Y set:
        $is_countably_infinite(X)
        $is_countably_infinite(Y)
        =>:
            $is_countably_infinite(cart(X, Y))
    $chap3::has_equal_cardinality(N, X)
    $chap3::has_equal_cardinality(N, Y)
    obtain enumX from exist enumX fn(x N) X st {$chap3::is_bijective_fn(N, X, enumX)}
    obtain enumY from exist enumY fn(x N) Y st {$chap3::is_bijective_fn(N, Y, enumY)}
    $chap3::is_injective_fn(N, X, enumX)
    $chap3::is_surjective_fn(N, X, enumX)
    $chap3::is_surjective_fn(N, Y, enumY)
    have fn product_map(p cart(N, N)) cart(X, Y) = (enumX(p(1)), enumY(p(2)))
    release thm countable_image_is_at_most_countable(cart(N, N), cart(X, Y), product_map)
    claim:
        ? cart(X, Y) $subset fn_range(product_map)
        claim:
            ? forall q cart(X, Y):
                q $in fn_range(product_map)
            exist nx N st {q(1) = enumX(nx)}
            exist ny N st {q(2) = enumY(ny)}
            obtain nx from exist nx N st {q(1) = enumX(nx)}
            obtain ny from exist ny N st {q(2) = enumY(ny)}
            (nx, ny) $in cart(N, N)
            (nx, ny)(1) = nx
            (nx, ny)(2) = ny
            product_map((nx, ny)) = (enumX((nx, ny)(1)), enumY((nx, ny)(2))) = (enumX(nx), enumY(ny)) = (q(1), q(2)) = q
            product_map((nx, ny)) $in fn_range(product_map)
    release thm subset_of_at_most_countable_is_at_most_countable(fn_range(product_map), cart(X, Y))
    have fn embed_N_into_cart(n N) cart(X, Y) = (enumX(n), enumY(0))
    claim:
        ? $chap3::is_injective_fn(N, cart(X, Y), embed_N_into_cart)
        claim:
            ? forall n1, n2 N:
                embed_N_into_cart(n1) = embed_N_into_cart(n2)
                =>:
                    n1 = n2
            (enumX(n1), enumY(0)) = embed_N_into_cart(n1) = embed_N_into_cart(n2) = (enumX(n2), enumY(0))
            enumX(n1) = (enumX(n1), enumY(0))(1) = (enumX(n2), enumY(0))(1) = enumX(n2)
            n1 = n2
        by def $chap3::is_injective_fn(N, cart(X, Y), embed_N_into_cart)
    witness $embeds_into(N, cart(X, Y)) from embed_N_into_cart
    release thm at_most_countable_with_N_embedding_is_countably_infinite(cart(X, Y))
forall n N:
    n + 1 $in N+
    -(n + 1) $in Z-
have fn negative_integer_enum(n N) Z- = -(n + 1)
forall n N:
    negative_integer_enum(n) = -(n + 1)
claim:
    ? $chap3::is_injective_fn(N, Z-, negative_integer_enum)
    claim:
        ? forall x1, x2 N:
            negative_integer_enum(x1) = negative_integer_enum(x2)
            =>:
                x1 = x2
        -(x1 + 1) = negative_integer_enum(x1) = negative_integer_enum(x2) = -(x2 + 1)
        x1 + 1 = -(-(x1 + 1)) = -(-(x2 + 1)) = x2 + 1
        x1 = (x1 + 1) - 1 = (x2 + 1) - 1 = x2
    by def $chap3::is_injective_fn(N, Z-, negative_integer_enum)
claim:
    ? $chap3::is_surjective_fn(N, Z-, negative_integer_enum)
    claim:
        ? forall y Z-:
            exist n N st {y = negative_integer_enum(n)}
        abs(y) $in N+
        abs(y) - 1 $in N
        y < 0
        abs(y) = -y
        -abs(y) = -(-y) = y
        negative_integer_enum(abs(y) - 1) = -((abs(y) - 1) + 1) = (-abs(y)) = y
        y = negative_integer_enum(abs(y) - 1)
        witness exist n N st {y = negative_integer_enum(n)} from abs(y) - 1
    by def $chap3::is_surjective_fn(N, Z-, negative_integer_enum)
by def $chap3::is_bijective_fn(N, Z-, negative_integer_enum)
witness $chap3::has_equal_cardinality(N, Z-) from negative_integer_enum
by def $is_countably_infinite(Z-)
claim:
    ? union(N+, Z-) = Z*
    by extension:
        ? union(N+, Z-) = Z*
        claim:
            ? forall x union(N+, Z-):
                x $in Z*
            by cases:
                ? x $in Z*
                case x $in N+:
                    x $in Z*
                case x $in Z-:
                    x $in Z*
        claim:
            ? forall x Z*:
                x $in union(N+, Z-)
            by cases:
                ? x $in union(N+, Z-)
                case x > 0:
                    x $in N+
                case x <= 0:
                    by cases:
                        ? x $in union(N+, Z-)
                        case x < 0:
                            x $in Z-
                        case x >= 0:
                            impossible x != 0
release thm union_of_two_countable_sets_is_countable(N+, Z-)
forall p cart(Z, Z*):
    p(1) / p(2) $in Q
have fn rational_quotient(p cart(Z, Z*)) Q = p(1) / p(2)
claim:
