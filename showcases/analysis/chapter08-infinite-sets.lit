prop has_infinite_cartesian_product_member(I set, U set, X fn(alpha I) power_set(U)):
    exist c fn(alpha I) U st {$is_in_infinite_cartesian_product(I, U, X, c)}
thm union_of_singleton_family:
    ? forall X set:
        family_union({X}) = X
    by extension:
        ? family_union({X}) = X
        claim:
            ? forall x family_union({X}):
                x $in X
            obtain A from exist A {X} st {x $in A}
            A = X
        claim:
            ? forall x X:
                x $in family_union({X})
            X $in {X}
thm constant_choice_function_product_is_function_space:
    ? forall I, X set, F fn(index I) {X}:
        \index_cart_product<I, {X}, F> = fn(t I) X
    release thm union_of_singleton_family(X)
    \index_cart_product<I, {X}, F> = {c fn(t I) family_union({X}): $is_choice_function_for(I, {X}, F, c)}
    by extension:
        ? \index_cart_product<I, {X}, F> = fn(t I) X
        claim:
            ? forall c \index_cart_product<I, {X}, F>:
                c $in fn(t I) X
            c $in {g fn(t I) family_union({X}): $is_choice_function_for(I, {X}, F, g)}
            c $in fn(t I) family_union({X})
            release thm fn_set_member(c, fn(t I) X)
        claim:
            ? forall c fn(t I) X:
                c $in \index_cart_product<I, {X}, F>
            release thm fn_set_member(c, fn(t I) family_union({X}))
            claim:
                ? forall index I:
                    c(index) $in F(index)
                F(index) $in {X}
                F(index) = X
                c(index) $in X
            by def $is_choice_function_for(I, {X}, F, c)
            release thm set_builder_member(c, {g fn(t I) family_union({X}): $is_choice_function_for(I, {X}, F, g)})
thm constant_index_cart_product_members_are_in_function_space:
    ? forall I nonempty_set, X set, F fn(alpha I) {X}, f index_cart(I, {X}, F):
        f $in fn(alpha I) X
    f $in index_cart(I, {X}, F)
    forall alpha I:
        f(alpha) $in F(alpha)
    forall alpha I:
        F(alpha) $in {X}
        F(alpha) = X
        f(alpha) $in F(alpha)
        f(alpha) $in X
    release thm fn_set_member(f, fn(alpha I) X)
prop is_constant_index_cart_product_candidate(I set, X set, F fn(alpha I) {X}, f fn(alpha I) X):
    forall alpha I:
        f(alpha) $in F(alpha)
thm function_space_members_satisfy_constant_product_conditions:
    ? forall I set, X set, F fn(alpha I) {X}, f fn(alpha I) X:
        $is_constant_index_cart_product_candidate(I, X, F, f)
    forall alpha I:
        X $in {X}
        F(alpha) $in {X}
        F(alpha) = X
        f(alpha) $in X
        f(alpha) $in F(alpha)
    by def $is_constant_index_cart_product_candidate(I, X, F, f)
thm constant_index_cart_product_is_function_space:
    ? forall I nonempty_set, X set, F fn(alpha I) {X}:
        index_cart(I, {X}, F) = fn(alpha I) X
    release thm union_of_singleton_family(X)
    by extension:
        ? index_cart(I, {X}, F) = fn(alpha I) X
