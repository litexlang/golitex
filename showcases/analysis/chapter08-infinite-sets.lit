release thm at_most_countable_with_N_embedding_is_countably_infinite(Q)
prop is_injective_code_graph(J, V set, F fn(i_index J) power_set(V), i_index J, G power_set(cart(V, N))):
    forall x F(i_index):
        exist! n N st {(x, n) $in G}
    forall x1, x2 F(i_index), n N:
        (x1, n) $in G
        (x2, n) $in G
        =>:
            x1 = x2
prop is_owner_code(J, V set, F fn(i_index J) power_set(V), element_e fn(i_index J) N, x V, n N):
    exist i_index J st {x $in F(i_index), n = element_e(i_index)}
thm countable_union_of_at_most_countable_sets:
    ? forall I, U set, A fn(i_index I) power_set(U):
        $is_at_most_countable(I)
        forall i_index I:
            $is_at_most_countable(A(i_index))
        =>:
            $is_at_most_countable(family_union(fn_range(A)))
    thm equal_values_of_injection_have_equal_inputs:
        ? forall source_set, target_set set, injection fn(member source_set) target_set, first, second source_set:
            $chap3::is_injective_fn(source_set, target_set, injection)
            injection(first) = injection(second)
            =>:
                first = second
    thm equal_natural_pairs_have_equal_coordinates:
        ? forall left_first, left_second, right_first, right_second N:
            (left_first, left_second) = (right_first, right_second)
            =>:
                left_first = right_first
                left_second = right_second
        have left_pair cart(N, N) = (left_first, left_second)
        have right_pair cart(N, N) = (right_first, right_second)
        release tuple def left_pair
        release tuple def right_pair
        left_pair = right_pair
        left_first = left_pair(1) = right_pair(1) = right_first
        left_second = left_pair(2) = right_pair(2) = right_second
    thm transfer_set_membership:
        ? forall source_set, target_set set, element source_set:
            source_set = target_set
            =>:
                element $in target_set
    forall index I:
        A(index) $in power_set(U)
        A(index) $subset U
    claim:
        ? forall index I, member A(index):
            member $in U
        A(index) $in power_set(U)
        A(index) $subset U
        member $in A(index)
        member $in U
    prop is_fiber_code(index I, code fn(x U) N):
        forall first, second A(index):
            code(first) = code(second)
            =>:
                first = second
    claim:
        ? forall index I:
            {code fn(x U) N: $is_fiber_code(index, code)} $subset fn(x U) N
        forall member {code fn(x U) N: $is_fiber_code(index, code)}:
            member $in fn(x U) N
        by def {code fn(x U) N: $is_fiber_code(index, code)} $subset fn(x U) N
    claim:
        ? forall index I:
            {code fn(x U) N: $is_fiber_code(index, code)} $in power_set(fn(x U) N)
        {code fn(x U) N: $is_fiber_code(index, code)} $subset fn(x U) N
    have fn code_family(index I) power_set(fn(x U) N) = {code fn(x U) N: $is_fiber_code(index, code)}
    claim:
        ? forall index I:
            $is_nonempty_set(code_family(index))
        $is_at_most_countable(A(index))
        $embeds_into(A(index), N)
        obtain encode from $embeds_into(A(index), N)
        have fn total_code(x U) N by cases:
            case x $in A(index): encode(x)
            case not x $in A(index): 0
        claim:
            ? forall first, second A(index):
                total_code(first) = total_code(second)
                =>:
                    first = second
            first $in U
            second $in U
            encode(first) = total_code(first) = total_code(second) = encode(second)
            first = second
        by def $is_fiber_code(index, total_code)
        total_code $in {code fn(x U) N: $is_fiber_code(index, code)}
        total_code $in code_family(index)
        witness $is_nonempty_set(code_family(index)) from total_code
    claim:
        ? forall codes fn_range(code_family):
            $is_nonempty_set(codes)
        have by fn_preimage: index from codes $in fn_range(code_family)
        codes = code_family(index)
        $is_nonempty_set(codes)
    release axiom_of_choice: set fn_range(code_family):
        forall codes fn_range(code_family):
            $is_nonempty_set(codes)
    obtain chosen from exist chosen fn(codes fn_range(code_family)) family_union(fn_range(code_family)) st {$is_choice_function_for(fn_range(code_family), fn_range(code_family), fn(codes fn_range(code_family)) fn_range(code_family) {codes}, chosen)}
    by def $is_choice_function_for(fn_range(code_family), fn_range(code_family), fn(codes fn_range(code_family)) fn_range(code_family) {codes}, chosen)
    claim:
        ? forall index I:
            chosen(code_family(index)) $in fn(x U) N
            $is_fiber_code(index, chosen(code_family(index)))
        code_family(index) $in fn_range(code_family)
        chosen(code_family(index)) $in fn(codes fn_range(code_family)) fn_range(code_family) {codes}(code_family(index))
        fn(codes fn_range(code_family)) fn_range(code_family) {codes}(code_family(index)) = code_family(index)
        chosen(code_family(index)) $in code_family(index)
        code_family(index) = {code fn(x U) N: $is_fiber_code(index, code)}
        release thm transfer_set_membership(code_family(index), {code fn(x U) N: $is_fiber_code(index, code)}, chosen(code_family(index)))
        chosen(code_family(index)) $in {code fn(x U) N: $is_fiber_code(index, code)}
    have fn fiber_code(index I) fn(x U) N = chosen(code_family(index))
    obtain index_code from $embeds_into(I, N)
    have union_set set = family_union(fn_range(A))
    claim:
        ? forall x union_set:
            x $in U
        release thm transfer_set_membership(union_set, family_union(fn_range(A)), x)
        obtain member_set from exist member_set fn_range(A) st {x $in member_set}
        have by fn_preimage: index from member_set $in fn_range(A)
        x $in A(index)
        x $in U
    have fn owners(x union_set) power_set(N) = {n N: $is_owner_code(I, U, A, index_code, x, n)}
    claim:
        ? forall x union_set:
            $is_nonempty_set(owners(x))
        release thm transfer_set_membership(union_set, family_union(fn_range(A)), x)
        obtain member_set from exist member_set fn_range(A) st {x $in member_set}
        have by fn_preimage: index from member_set $in fn_range(A)
        x $in A(index)
        witness exist chosen_index I st {x $in A(chosen_index), index_code(index) = index_code(chosen_index)} from index
        by def $is_owner_code(I, U, A, index_code, x, index_code(index))
        index_code(index) $in owners(x)
        witness $is_nonempty_set(owners(x)) from index_code(index)
    claim:
        ? forall x union_set:
            exist! index I st {x $in A(index), index_code(index) = min_of_N_subset(owners(x))}
        release thm transfer_set_membership(union_set, family_union(fn_range(A)), x)
        obtain member_set from exist member_set fn_range(A) st {x $in member_set}
        have by fn_preimage: index from member_set $in fn_range(A)
        x $in A(index)
        witness exist chosen_index I st {x $in A(chosen_index), index_code(index) = index_code(chosen_index)} from index
        by def $is_owner_code(I, U, A, index_code, x, index_code(index))
        index_code(index) $in owners(x)
        witness $is_nonempty_set(owners(x)) from index_code(index)
        $is_minimum_of_natural_subset(owners(x), min_of_N_subset(owners(x)))
        min_of_N_subset(owners(x)) $in owners(x)
        owners(x) = {n N: $is_owner_code(I, U, A, index_code, x, n)}
        release thm transfer_set_membership(owners(x), {n N: $is_owner_code(I, U, A, index_code, x, n)}, min_of_N_subset(owners(x)))
        min_of_N_subset(owners(x)) $in {n N: $is_owner_code(I, U, A, index_code, x, n)}
        obtain selected from $is_owner_code(I, U, A, index_code, x, min_of_N_subset(owners(x)))
        witness exist! selected_index I st {x $in A(selected_index), index_code(selected_index) = min_of_N_subset(owners(x))} from selected:
            claim:
                ? forall first, second I:
                    x $in A(first)
                    index_code(first) = min_of_N_subset(owners(x))
                    x $in A(second)
                    index_code(second) = min_of_N_subset(owners(x))
                    =>:
                        first = second
                index_code(first) = min_of_N_subset(owners(x)) = index_code(second)
                first = second
    have fn owner by exist!:
        ? forall x union_set:
            exist! index I st {x $in A(index), index_code(index) = min_of_N_subset(owners(x))}
    release thm product_of_countable_sets_is_countable(N, N)
    release thm countably_infinite_is_at_most_countable(cart(N, N))
    obtain pair_code from $embeds_into(cart(N, N), N)
    claim:
        ? forall x union_set:
            (index_code(owner(x)), fiber_code(owner(x))(x)) $in cart(N, N)
        x $in U
        index_code(owner(x)) $in N
        fiber_code(owner(x))(x) $in N
        (index_code(owner(x)), fiber_code(owner(x))(x)) $in cart(N, N)
    have fn union_code(x union_set) N = pair_code((index_code(owner(x)), fiber_code(owner(x))(x)))
    forall union_member union_set:
        union_code(union_member) = pair_code((index_code(owner(union_member)), fiber_code(owner(union_member))(union_member)))
    claim:
        ? $chap3::is_injective_fn(union_set, N, union_code)
        claim:
            ? forall first, second union_set:
                union_code(first) = union_code(second)
                =>:
                    first = second
            pair_code((index_code(owner(first)), fiber_code(owner(first))(first))) = union_code(first) = union_code(second) = pair_code((index_code(owner(second)), fiber_code(owner(second))(second)))
            release thm equal_values_of_injection_have_equal_inputs(cart(N, N), N, pair_code, (index_code(owner(first)), fiber_code(owner(first))(first)), (index_code(owner(second)), fiber_code(owner(second))(second)))
            (index_code(owner(first)), fiber_code(owner(first))(first)) = (index_code(owner(second)), fiber_code(owner(second))(second))
            release thm equal_natural_pairs_have_equal_coordinates(index_code(owner(first)), fiber_code(owner(first))(first), index_code(owner(second)), fiber_code(owner(second))(second))
            index_code(owner(first)) = index_code(owner(second))
            owner(first) = owner(second)
            fiber_code(owner(first))(first) = fiber_code(owner(second))(second) = fiber_code(owner(first))(second)
            first $in A(owner(first))
            second $in A(owner(second))
            A(owner(second)) = A(owner(first))
            release thm transfer_set_membership(A(owner(second)), A(owner(first)), second)
            second $in A(owner(first))
            $is_fiber_code(owner(first), fiber_code(owner(first)))
            first = second
        by def $chap3::is_injective_fn(union_set, N, union_code)
    witness $embeds_into(union_set, N) from union_code
    by def $is_at_most_countable(union_set)
thm union_of_two_at_most_countable_sets_is_at_most_countable:
    ? forall X, Y set:
        $is_at_most_countable(X)
        $is_at_most_countable(Y)
        =>:
            $is_at_most_countable(union(X, Y))
    X $subset union(X, Y)
    Y $subset union(X, Y)
    release thm finite_set_has_cardinality_count({0, 1})
    witness $chap3::has_finite_cardinality({0, 1}) from finite_set_size({0, 1})
    release thm finite_cardinality_gives_at_most_countable({0, 1})
    have fn family(i_index {0, 1}) power_set(union(X, Y)) by cases:
        case i_index = 0: X
        case i_index = 1: Y
    claim:
        ? forall i_index {0, 1}:
            $is_at_most_countable(family(i_index))
        i_index = 0 or i_index = 1
        by cases:
            ? $is_at_most_countable(family(i_index))
            case i_index = 0:
                family(i_index) = X
            case i_index = 1:
                family(i_index) = Y
    release thm countable_union_of_at_most_countable_sets({0, 1}, union(X, Y), family)
    claim:
        ? family_union(fn_range(family)) = union(X, Y)
        by extension:
            ? family_union(fn_range(family)) = union(X, Y)
            claim:
                ? forall z family_union(fn_range(family)):
                    z $in union(X, Y)
                obtain S from exist S fn_range(family) st {z $in S}
                have by fn_preimage: i_index from S $in fn_range(family)
                i_index = 0 or i_index = 1
                by cases:
                    ? z $in union(X, Y)
                    case i_index = 0:
                        S = family(i_index) = X
                        z $in X
                    case i_index = 1:
                        S = family(i_index) = Y
                        z $in Y
            claim:
                ? forall z union(X, Y):
                    z $in family_union(fn_range(family))
                by cases:
                    ? z $in family_union(fn_range(family))
                    case z $in X:
                        family(0) = X
                        family(0) $in fn_range(family)
                        X $in fn_range(family)
                        z $in X
                        z $in family_union(fn_range(family))
                    case z $in Y:
                        family(1) = Y
                        family(1) $in fn_range(family)
                        Y $in fn_range(family)
                        z $in Y
                        z $in family_union(fn_range(family))
    $is_at_most_countable(family_union(fn_range(family)))
template<X set, f fn(x X) power_set(X)>:
    have cantor_diagonal_set power_set(X) = {x X: not x $in f(x)}
thm cantor_theorem:
    ? forall X set:
        not $chap3::has_equal_cardinality(X, power_set(X))
    by contra:
        ? not $chap3::has_equal_cardinality(X, power_set(X))
        $chap3::has_equal_cardinality(X, power_set(X))
        obtain f from exist f fn(x X) power_set(X) st {$chap3::is_bijective_fn(X, power_set(X), f)}
        $chap3::is_surjective_fn(X, power_set(X), f)
        have diagonal power_set(X) = {x X: not x $in f(x)}
        obtain y from exist y X st {diagonal = f(y)}
        claim:
            ? not y $in diagonal
            by contra:
                ? not y $in diagonal
                y $in diagonal
                not y $in f(y)
                y $in f(y)
                impossible y $in f(y)
        claim:
            ? y $in f(y)
            by contra:
                ? y $in f(y)
                not y $in f(y)
                y $in {x X: not x $in f(x)}
                y $in diagonal
                impossible y $in diagonal
        diagonal = f(y)
        y $in diagonal
        impossible y $in diagonal
have fn singleton_subset_of_N(n N) power_set(N) = {n}
claim:
    ? $chap3::is_injective_fn(N, power_set(N), singleton_subset_of_N)
    forall x1, x2 N:
        singleton_subset_of_N(x1) = singleton_subset_of_N(x2)
        =>:
            {x1} = singleton_subset_of_N(x1) = singleton_subset_of_N(x2) = {x2}
            x1 $in {x1}
            x1 $in {x2}
            x1 = x2
    by def $chap3::is_injective_fn(N, power_set(N), singleton_subset_of_N)
witness $embeds_into(N, power_set(N)) from singleton_subset_of_N
claim:
    ? $is_uncountable(power_set(N))
    release thm cantor_theorem(N)
    by contra:
        ? not $is_countably_infinite(power_set(N))
        impossible not $chap3::has_equal_cardinality(N, power_set(N))
    release thm proposition_3_6_14_N_embedding_implies_infinite(power_set(N))
    by def $is_uncountable(power_set(N))
template<I set, S nonempty_set, X fn(alpha I) S>:
