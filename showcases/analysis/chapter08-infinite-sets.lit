            ? forall f index_cart(I, {X}, F):
                f $in fn(alpha I) X
            release thm constant_index_cart_product_members_are_in_function_space(I, X, F, f)
        claim:
            ? forall f fn(alpha I) X:
                f $in index_cart(I, {X}, F)
            release thm function_space_members_satisfy_constant_product_conditions(I, X, F, f)
            $is_constant_index_cart_product_candidate(I, X, F, f)
            forall alpha I:
                f(alpha) $in F(alpha)
            family_union({X}) = X
            claim:
                ? forall alpha I:
                    f(alpha) $in family_union({X})
                f(alpha) $in X
                X $in {X}
            f $in fn(alpha I) family_union({X})
            release thm fn_set_member(f, fn(alpha I) family_union({X}))
            by def $is_choice_function_for(I, {X}, F, f)
            release thm index_cart_member(f, index_cart(I, {X}, F))
prop has_coordinate_values_in_family(n N+, U set, X fn(i_index closed_range(1, n)) power_set(U), f fn(i_index closed_range(1, n)) U):
    forall i_index closed_range(1, n):
        f(i_index) $in X(i_index)
thm finite_cartesian_product_choice_function_representation:
    ? forall n N+, U set, X fn(i_index closed_range(1, n)) power_set(U), set_C, P set:
        set_C = {finite_candidate finite_seq(U, n): $has_coordinate_values_in_family(n, U, X, finite_candidate)}
        P = {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)}
        =>:
            $chap3::has_equal_cardinality(set_C, P)
    finite_seq(U, n) = fn(j_index closed_range(1, n)) U
    by extension:
        ? set_C = P
        claim:
            ? forall chosen_left set_C:
                chosen_left $in P
            chosen_left $in {finite_candidate finite_seq(U, n): $has_coordinate_values_in_family(n, U, X, finite_candidate)}
            release thm set_builder_member(chosen_left, {finite_candidate finite_seq(U, n): $has_coordinate_values_in_family(n, U, X, finite_candidate)})
            chosen_left $in finite_seq(U, n)
            chosen_left $in fn(j_index closed_range(1, n)) U
            release thm set_builder_member(chosen_left, {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)})
            chosen_left $in P
        claim:
            ? forall chosen_right P:
                chosen_right $in set_C
            chosen_right $in {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)}
            release thm set_builder_member(chosen_right, {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)})
            chosen_right $in finite_seq(U, n)
            release thm set_builder_member(chosen_right, {finite_candidate finite_seq(U, n): $has_coordinate_values_in_family(n, U, X, finite_candidate)})
            chosen_right $in set_C
    have fn choice_identity(chosen_point set_C) P = chosen_point
    claim:
        ? forall left_point, right_point set_C:
            choice_identity(left_point) = choice_identity(right_point)
            =>:
                left_point = right_point
        choice_identity(left_point) = left_point
        choice_identity(right_point) = right_point
        left_point = choice_identity(left_point) = choice_identity(right_point) = right_point
    by def $chap3::is_injective_fn(set_C, P, choice_identity)
    claim:
        ? forall target_point P:
            exist source_point set_C st {target_point = choice_identity(source_point)}
        target_point $in set_C
        witness exist source_point set_C st {target_point = choice_identity(source_point)} from target_point:
            choice_identity(target_point) = target_point
            target_point = choice_identity(target_point)
    by def $chap3::is_surjective_fn(set_C, P, choice_identity)
    by def $chap3::is_bijective_fn(set_C, P, choice_identity)
    witness exist chosen_map fn(source_point set_C) P st {$chap3::is_bijective_fn(set_C, P, chosen_map)} from choice_identity
    by def $chap3::has_equal_cardinality(set_C, P)
prop is_finite_cartesian_product_for_family(n N+, U set, X fn(i_index closed_range(1, n)) power_set(U), set_C set):
    set_C = {finite_candidate finite_seq(U, n): $has_coordinate_values_in_family(n, U, X, finite_candidate)}
thm finite_index_product_agrees_with_chapter3_cartesian_product:
    ? forall n N+, U set, X fn(i_index closed_range(1, n)) power_set(U), set_C, P set:
        $is_finite_cartesian_product_for_family(n, U, X, set_C)
        P = {function_candidate fn(j_index closed_range(1, n)) U: $is_in_infinite_cartesian_product(closed_range(1, n), U, X, function_candidate)}
        =>:
            $chap3::has_equal_cardinality(set_C, P)
    finite_seq(U, n) = fn(j_index closed_range(1, n)) U
    set_C = {finite_candidate finite_seq(U, n): $has_coordinate_values_in_family(n, U, X, finite_candidate)}
    by extension:
        ? P = {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)}
        claim:
            ? forall chosen_infinite P:
                chosen_infinite $in {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)}
            chosen_infinite $in {function_candidate fn(j_index closed_range(1, n)) U: $is_in_infinite_cartesian_product(closed_range(1, n), U, X, function_candidate)}
            release thm set_builder_member(chosen_infinite, {function_candidate fn(j_index closed_range(1, n)) U: $is_in_infinite_cartesian_product(closed_range(1, n), U, X, function_candidate)})
            $is_in_infinite_cartesian_product(closed_range(1, n), U, X, chosen_infinite)
            by def $has_coordinate_values_in_family(n, U, X, chosen_infinite)
            release thm set_builder_member(chosen_infinite, {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)})
        claim:
            ? forall chosen_finite {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)}:
                chosen_finite $in P
            release thm set_builder_member(chosen_finite, {function_candidate fn(j_index closed_range(1, n)) U: $has_coordinate_values_in_family(n, U, X, function_candidate)})
            $has_coordinate_values_in_family(n, U, X, chosen_finite)
            by def $is_in_infinite_cartesian_product(closed_range(1, n), U, X, chosen_finite)
            release thm set_builder_member(chosen_finite, {function_candidate fn(j_index closed_range(1, n)) U: $is_in_infinite_cartesian_product(closed_range(1, n), U, X, function_candidate)})
            chosen_finite $in P
    by thm finite_cartesian_product_choice_function_representation(n, U, X, set_C, P)
thm binary_cartesian_product_choice_function_representation:
    ? forall A, B, U, P set:
        A $subset U
        B $subset U
        P = {f fn(i_index closed_range(1, 2)) U: f(1) $in A and f(2) $in B}
        =>:
            $chap3::has_equal_cardinality(cart(A, B), P)
    thm local_binary_cartesian_coordinate_equality:
        ? forall left_factor, right_factor, ambient_set set:
            left_factor $subset ambient_set
            right_factor $subset ambient_set
            =>:
                cart(left_factor, right_factor) = {candidate finite_seq(ambient_set, 2): candidate(1) $in left_factor and candidate(2) $in right_factor}
        release cart def cart(left_factor, right_factor)
        claim:
            ? union(left_factor, right_factor) $subset ambient_set
            claim:
                ? forall x union(left_factor, right_factor):
                    x $in ambient_set
                x $in left_factor or x $in right_factor
                by cases:
                    ? x $in ambient_set
                    case x $in left_factor:
                        x $in ambient_set
                    case x $in right_factor:
                        x $in ambient_set
            by def union(left_factor, right_factor) $subset ambient_set
        by extension:
            ? cart(left_factor, right_factor) = {candidate finite_seq(ambient_set, 2): candidate(1) $in left_factor and candidate(2) $in right_factor}
            claim:
                ? forall p cart(left_factor, right_factor):
                    p $in {candidate finite_seq(ambient_set, 2): candidate(1) $in left_factor and candidate(2) $in right_factor}
                p(1) $in left_factor
                p(2) $in right_factor
                release thm fn_set_member(p, finite_seq(ambient_set, 2))
                release thm set_builder_member(p, {candidate finite_seq(ambient_set, 2): candidate(1) $in left_factor and candidate(2) $in right_factor})
            claim:
                ? forall f {candidate finite_seq(ambient_set, 2): candidate(1) $in left_factor and candidate(2) $in right_factor}:
                    f $in cart(left_factor, right_factor)
                release thm set_builder_member(f, {candidate finite_seq(ambient_set, 2): candidate(1) $in left_factor and candidate(2) $in right_factor})
                f $in finite_seq(ambient_set, 2)
                f(1) $in left_factor
                f(2) $in right_factor
                release thm cart_member_from_coordinates(f, cart(left_factor, right_factor))
    release thm local_binary_cartesian_coordinate_equality(A, B, U)
    finite_seq(U, 2) = fn(i_index closed_range(1, 2)) U
    claim:
        ? {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B} = P
        by extension:
            ? {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B} = P
            claim:
                ? forall left {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B}:
                    left $in P
                release thm set_builder_member(left, {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B})
                left $in finite_seq(U, 2)
                left $in fn(i_index closed_range(1, 2)) U
                release thm set_builder_member(left, {candidate fn(i_index closed_range(1, 2)) U: candidate(1) $in A and candidate(2) $in B})
                left $in P
            claim:
                ? forall right P:
                    right $in {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B}
                right $in {candidate fn(i_index closed_range(1, 2)) U: candidate(1) $in A and candidate(2) $in B}
                release thm set_builder_member(right, {candidate fn(i_index closed_range(1, 2)) U: candidate(1) $in A and candidate(2) $in B})
                right $in finite_seq(U, 2)
                release thm set_builder_member(right, {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B})
    cart(A, B) = {candidate finite_seq(U, 2): candidate(1) $in A and candidate(2) $in B} = P
    have fn choice_identity(p cart(A, B)) P = p
    claim:
        ? forall left, right cart(A, B):
            choice_identity(left) = choice_identity(right)
            =>:
                left = right
        left = choice_identity(left) = choice_identity(right) = right
    by def $chap3::is_injective_fn(cart(A, B), P, choice_identity)
    claim:
        ? forall target P:
            exist source cart(A, B) st {target = choice_identity(source)}
        target $in cart(A, B)
        witness exist source cart(A, B) st {target = choice_identity(source)} from target:
            choice_identity(target) = target
            target = choice_identity(target)
    by def $chap3::is_surjective_fn(cart(A, B), P, choice_identity)
    by def $chap3::is_bijective_fn(cart(A, B), P, choice_identity)
    witness $chap3::has_equal_cardinality(cart(A, B), P) from choice_identity
thm two_factor_finite_index_product_representation:
    ? forall A, B, U, P set:
        A $subset U
        B $subset U
        P = {f fn(i_index closed_range(1, 2)) U: f(1) $in A and f(2) $in B}
        =>:
            $chap3::has_equal_cardinality(cart(A, B), P)
    release thm binary_cartesian_product_choice_function_representation(A, B, U, P)
thm ternary_cartesian_product_choice_function_representation:
    ? forall A, B, set_C, U, P set:
        A $subset U
        B $subset U
        set_C $subset U
        P = {f fn(i_index closed_range(1, 3)) U: f(1) $in A and f(2) $in B and f(3) $in set_C}
        =>:
            $chap3::has_equal_cardinality(cart(A, B, set_C), P)
    thm local_ternary_cartesian_coordinate_equality:
        ? forall left_factor, right_factor, third_factor, ambient_set set:
            left_factor $subset ambient_set
            right_factor $subset ambient_set
            third_factor $subset ambient_set
            =>:
                cart(left_factor, right_factor, third_factor) = {candidate finite_seq(ambient_set, 3): candidate(1) $in left_factor and candidate(2) $in right_factor and candidate(3) $in third_factor}
        release cart def cart(left_factor, right_factor, third_factor)
        claim:
            ? union(union(left_factor, right_factor), third_factor) $subset ambient_set
            claim:
                ? forall x union(union(left_factor, right_factor), third_factor):
                    x $in ambient_set
                x $in union(left_factor, right_factor) or x $in third_factor
                by cases:
                    ? x $in ambient_set
                    case x $in union(left_factor, right_factor):
                        x $in left_factor or x $in right_factor
                        by cases:
                            ? x $in ambient_set
                            case x $in left_factor:
                                x $in ambient_set
                            case x $in right_factor:
                                x $in ambient_set
                    case x $in third_factor:
                        x $in ambient_set
            by def union(union(left_factor, right_factor), third_factor) $subset ambient_set
        by extension:
            ? cart(left_factor, right_factor, third_factor) = {candidate finite_seq(ambient_set, 3): candidate(1) $in left_factor and candidate(2) $in right_factor and candidate(3) $in third_factor}
            claim:
                ? forall p cart(left_factor, right_factor, third_factor):
                    p $in {candidate finite_seq(ambient_set, 3): candidate(1) $in left_factor and candidate(2) $in right_factor and candidate(3) $in third_factor}
                p(1) $in left_factor
                p(2) $in right_factor
                p(3) $in third_factor
                release thm fn_set_member(p, finite_seq(ambient_set, 3))
                release thm set_builder_member(p, {candidate finite_seq(ambient_set, 3): candidate(1) $in left_factor and candidate(2) $in right_factor and candidate(3) $in third_factor})
            claim:
                ? forall f {candidate finite_seq(ambient_set, 3): candidate(1) $in left_factor and candidate(2) $in right_factor and candidate(3) $in third_factor}:
                    f $in cart(left_factor, right_factor, third_factor)
                release thm set_builder_member(f, {candidate finite_seq(ambient_set, 3): candidate(1) $in left_factor and candidate(2) $in right_factor and candidate(3) $in third_factor})
                f $in finite_seq(ambient_set, 3)
                f(1) $in left_factor
                f(2) $in right_factor
                f(3) $in third_factor
                release thm cart_member_from_coordinates(f, cart(left_factor, right_factor, third_factor))
    release thm local_ternary_cartesian_coordinate_equality(A, B, set_C, U)
    finite_seq(U, 3) = fn(i_index closed_range(1, 3)) U
    claim:
        ? {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C} = P
        by extension:
            ? {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C} = P
            claim:
                ? forall left {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C}:
                    left $in P
                release thm set_builder_member(left, {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C})
                left $in finite_seq(U, 3)
                left $in fn(i_index closed_range(1, 3)) U
                release thm set_builder_member(left, {candidate fn(i_index closed_range(1, 3)) U: candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C})
                left $in P
            claim:
                ? forall right P:
                    right $in {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C}
                right $in {candidate fn(i_index closed_range(1, 3)) U: candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C}
                release thm set_builder_member(right, {candidate fn(i_index closed_range(1, 3)) U: candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C})
                right $in finite_seq(U, 3)
                release thm set_builder_member(right, {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C})
    cart(A, B, set_C) = {candidate finite_seq(U, 3): candidate(1) $in A and candidate(2) $in B and candidate(3) $in set_C} = P
    have fn choice_identity(p cart(A, B, set_C)) P = p
    claim:
        ? forall left, right cart(A, B, set_C):
            choice_identity(left) = choice_identity(right)
            =>:
                left = right
        left = choice_identity(left) = choice_identity(right) = right
    by def $chap3::is_injective_fn(cart(A, B, set_C), P, choice_identity)
    claim:
        ? forall target P:
            exist source cart(A, B, set_C) st {target = choice_identity(source)}
        target $in cart(A, B, set_C)
        witness exist source cart(A, B, set_C) st {target = choice_identity(source)} from target:
            choice_identity(target) = target
            target = choice_identity(target)
    by def $chap3::is_surjective_fn(cart(A, B, set_C), P, choice_identity)
    by def $chap3::is_bijective_fn(cart(A, B, set_C), P, choice_identity)
    witness $chap3::has_equal_cardinality(cart(A, B, set_C), P) from choice_identity
thm three_factor_finite_index_product_representation:
    ? forall A, B, set_C, U, P set:
        A $subset U
        B $subset U
        set_C $subset U
        P = {f fn(i_index closed_range(1, 3)) U: f(1) $in A and f(2) $in B and f(3) $in set_C}
        =>:
            $chap3::has_equal_cardinality(cart(A, B, set_C), P)
    release thm ternary_cartesian_product_choice_function_representation(A, B, set_C, U, P)
axiom axiom_of_choice_for_index_cart:
    ? forall I nonempty_set, S nonempty_set, X fn(alpha I) S:
        forall A S:
            $is_nonempty_set(A)
        =>:
            $is_nonempty_set(index_cart(I, S, X))
prop is_nonempty_family(I set, U set, X fn(alpha I) power_set(U)):
    forall alpha I:
        $is_nonempty_set(X(alpha))
axiom axiom_of_choice_for_subsets:
    ? forall I, U set, X fn(alpha I) power_set(U):
        $is_nonempty_family(I, U, X)
        =>:
            $has_infinite_cartesian_product_member(I, U, X)
prop is_upper_bound_of_real_set(E power_set(R), M R):
    forall x E:
        x <= M
prop is_least_upper_bound_of_real_set(E power_set(R), M R):
    $is_upper_bound_of_real_set(E, M)
    forall B R:
        $is_upper_bound_of_real_set(E, B)
        =>:
            M <= B
thm least_upper_bound_of_real_set_member_above:
    ? forall E power_set(R), M R, epsilon R+:
        $is_least_upper_bound_of_real_set(E, M)
        =>:
            exist x E st {M - epsilon < x}
    have b0 R = M - epsilon
    prop has_member_above():
        exist x E st {b0 < x}
    claim:
        ? $has_member_above()
        by contra:
            ? $has_member_above()
            claim:
                ? $is_upper_bound_of_real_set(E, b0)
                claim:
                    ? forall x E:
                        x <= b0
                    by contra:
                        ? x <= b0
                        x > b0
                        claim:
                            ? $has_member_above()
                            witness $has_member_above() from x:
                                x > b0
                        impossible $has_member_above()
                forall x E:
                    x <= b0
                by def $is_upper_bound_of_real_set(E, b0)
                $is_upper_bound_of_real_set(E, b0)
            M <= b0 = M - epsilon
            epsilon > 0
            -epsilon < 0
            M + (-epsilon) < M + 0
            M - epsilon = M + (-epsilon) < M + 0 = M
            M - epsilon < M
            impossible M <= M - epsilon
    by def $has_member_above()
    obtain x from exist x E st {b0 < x}
    witness exist y E st {M - epsilon < y} from x:
        M - epsilon = b0 < x
prop is_supremum_window_member(E power_set(R), M R, n N+, x R):
    x $in E
    M - 1 / n <= x <= M
template<E power_set(R), M R, n N+>:
    have supremum_window power_set(R) = {x R: $is_supremum_window_member(E, M, n, x)}
thm supremum_window_nonempty:
    ? forall E power_set(R), M R, n N+:
        $is_least_upper_bound_of_real_set(E, M)
        =>:
            $is_nonempty_set(\supremum_window<E, M, n>)
    release thm least_upper_bound_of_real_set_member_above(E, M, 1 / n)
    obtain x from exist x E st {M - 1 / n < x}
    claim:
        ? x $in \supremum_window<E, M, n>
        M - 1 / n < x
        M - 1 / n <= x
        $is_upper_bound_of_real_set(E, M)
        forall y E:
            y <= M
        x <= M
        by def $is_supremum_window_member(E, M, n, x)
        $is_supremum_window_member(E, M, n, x)
        \supremum_window<E, M, n> = {y R: $is_supremum_window_member(E, M, n, y)}
        release thm set_builder_member(x, {y R: $is_supremum_window_member(E, M, n, y)})
        x $in {y R: $is_supremum_window_member(E, M, n, y)}
        x $in \supremum_window<E, M, n>
    witness $is_nonempty_set(\supremum_window<E, M, n>) from x:
        x $in \supremum_window<E, M, n>
prop is_sequence_in_real_set(a seq(R), E power_set(R)):
    forall n N+:
        a(n) $in E
prop is_supremum_window_choice_sequence(E power_set(R), M R, a seq(R)):
    forall n N+:
        a(n) $in \supremum_window<E, M, n>
thm supremum_window_choice_sequence_exists:
    ? forall E power_set(R), M R:
        $is_least_upper_bound_of_real_set(E, M)
        =>:
            exist a seq(R) st {$is_supremum_window_choice_sequence(E, M, a)}
    have fn window_family(alpha N+) power_set(R) = \supremum_window<E, M, alpha>
    claim:
        ? forall n N+:
            $is_nonempty_set(window_family(n))
        release thm supremum_window_nonempty(E, M, n)
        window_family(n) = \supremum_window<E, M, n>
    by def $is_nonempty_family(N+, R, window_family)
    $is_nonempty_family(N+, R, window_family)
    release thm axiom_of_choice_for_subsets(N+, R, window_family)
    obtain c from exist c fn(alpha N+) R st {$is_in_infinite_cartesian_product(N+, R, window_family, c)}
    forall n N+:
        window_family(n) = \supremum_window<E, M, n>
        c(n) $in window_family(n)
        c(n) $in \supremum_window<E, M, n>
    by def $is_supremum_window_choice_sequence(E, M, c)
    $is_supremum_window_choice_sequence(E, M, c)
    witness exist a seq(R) st {$is_supremum_window_choice_sequence(E, M, a)} from c
thm supremum_window_member_has_predicate:
    ? forall E power_set(R), M R, n N+, value R:
        value $in \supremum_window<E, M, n>
        =>:
            $is_supremum_window_member(E, M, n, value)
thm supremum_window_choice_sequence_lies_in_real_set:
    ? forall E power_set(R), M R, a seq(R):
        $is_supremum_window_choice_sequence(E, M, a)
        =>:
            $is_sequence_in_real_set(a, E)
    claim:
        ? forall n N+:
            a(n) $in E
        a(n) $in \supremum_window<E, M, n>
        \supremum_window<E, M, n> = {x R: $is_supremum_window_member(E, M, n, x)}
        release thm supremum_window_member_has_predicate(E, M, n, a(n))
        a(n) $in E
    by def $is_sequence_in_real_set(a, E)
prop is_squeezed_by_supremum_windows(M R, a seq(R)):
    forall n N+:
        M - 1 / n <= a(n) <= M
thm supremum_window_choice_sequence_has_window_bounds:
    ? forall E power_set(R), M R, a seq(R):
        $is_supremum_window_choice_sequence(E, M, a)
        =>:
            $is_squeezed_by_supremum_windows(M, a)
    claim:
        ? forall n N+:
            M - 1 / n <= a(n) <= M
        a(n) $in \supremum_window<E, M, n>
        release thm supremum_window_member_has_predicate(E, M, n, a(n))
        M - 1 / n <= a(n) <= M
    by def $is_squeezed_by_supremum_windows(M, a)
thm sequence_between_supremum_windows_converges:
    ? forall M R, a seq(R):
        $is_squeezed_by_supremum_windows(M, a)
        =>:
            $chap7::has_limit(a, M)
    claim:
        ? forall epsilon R+:
            exist N0 N+ st {$chap7::is_tail_close_to(a, M, epsilon, N0)}
        release thm chap5::archimedean_property(epsilon)
        obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
        witness exist N0 N+ st {$chap7::is_tail_close_to(a, M, epsilon, N0)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(a(n) - M) <= epsilon
                M - 1 / n <= a(n) <= M
                a(n) - M <= 0
                abs(a(n) - M) = -(a(n) - M)
                -(a(n) - M) = M - a(n)
                abs(a(n) - M) = -(a(n) - M) = M - a(n)
                M = M - 1 / n + 1 / n <= a(n) + 1 / n
                n > 0
                n0 > 0
                n0 * n > 0
                n0 / (n0 * n) <= n / (n0 * n)
                abs(a(n) - M) = M - a(n) <= a(n) + 1 / n - a(n) = 1 / n = n0 / (n0 * n) <= n / (n0 * n) = 1 / n0 < epsilon
            by def $chap7::is_tail_close_to(a, M, epsilon, n0)
    by def $chap7::has_limit(a, M)
thm bounded_real_set_has_supremum_approaching_sequence:
    ? forall E power_set(R), M R:
        $is_nonempty_set(E)
        $is_least_upper_bound_of_real_set(E, M)
        =>:
            exist a seq(R) st {$is_sequence_in_real_set(a, E), $chap7::has_limit(a, M)}
    release thm supremum_window_choice_sequence_exists(E, M)
    obtain a from exist a seq(R) st {$is_supremum_window_choice_sequence(E, M, a)}
    release thm supremum_window_choice_sequence_lies_in_real_set(E, M, a)
    release thm supremum_window_choice_sequence_has_window_bounds(E, M, a)
    release thm sequence_between_supremum_windows_converges(M, a)
    witness exist a0 seq(R) st {$is_sequence_in_real_set(a0, E), $chap7::has_limit(a0, M)} from a
abstract_prop choice_property(x, y)
prop is_choice_function_for_property(X, Y set, f fn(x X) Y):
    forall x X:
        $choice_property(x, f(x))
thm choice_function_from_pointwise_existence:
    ? forall X, Y set:
        forall x X:
            exist y Y st {$choice_property(x, y)}
        =>:
            exist f fn(x X) Y st {$is_choice_function_for_property(X, Y, f)}
    have fn fiber_family(alpha X) power_set(Y) = {y Y: $choice_property(alpha, y)}
    claim:
        ? forall x X:
            $is_nonempty_set(fiber_family(x))
        obtain y from exist y Y st {$choice_property(x, y)}
        y $in {z Y: $choice_property(x, z)}
        y $in fiber_family(x)
        witness $is_nonempty_set(fiber_family(x)) from y
    by def $is_nonempty_family(X, Y, fiber_family)
    $is_nonempty_family(X, Y, fiber_family)
    release thm axiom_of_choice_for_subsets(X, Y, fiber_family)
    obtain c from exist c fn(alpha X) Y st {$is_in_infinite_cartesian_product(X, Y, fiber_family, c)}
    claim:
        ? $is_choice_function_for_property(X, Y, c)
        forall x X:
            fiber_family(x) = {y Y: $choice_property(x, y)}
            c(x) $in fiber_family(x)
            c(x) $in {y Y: $choice_property(x, y)}
            $choice_property(x, c(x))
        by def $is_choice_function_for_property(X, Y, c)
        $is_choice_function_for_property(X, Y, c)
    witness exist f fn(x X) Y st {$is_choice_function_for_property(X, Y, f)} from c
thm axiom_of_choice_implies_pointwise_choice_formulation:
    ? forall X, Y set:
        forall x X:
            exist y Y st {$choice_property(x, y)}
        =>:
            exist f fn(x X) Y st {$is_choice_function_for_property(X, Y, f)}
    release thm choice_function_from_pointwise_existence(X, Y)
thm pointwise_choice_formulation_implies_axiom_of_choice_for_subsets:
    ? forall I, U set, X fn(alpha I) power_set(U):
        $is_nonempty_family(I, U, X)
        =>:
            $has_infinite_cartesian_product_member(I, U, X)
    release thm axiom_of_choice_for_subsets(I, U, X)
prop is_pairwise_disjoint_family(I set, U set, X fn(alpha I) power_set(U)):
    forall alpha, beta I:
        alpha != beta
        =>:
            intersect(X(alpha), X(beta)) = {}
prop is_single_intersection_selector(I set, U set, X fn(alpha I) power_set(U), Y power_set(U)):
    forall alpha I:
        exist! y U st {y $in Y, y $in X(alpha)}
thm choice_gives_selector_for_pairwise_disjoint_family:
    ? forall I, U set, X fn(alpha I) power_set(U):
        $is_nonempty_family(I, U, X)
        $is_pairwise_disjoint_family(I, U, X)
        =>:
            exist Y power_set(U) st {$is_single_intersection_selector(I, U, X, Y)}
    release thm axiom_of_choice_for_subsets(I, U, X)
    obtain c from exist c fn(alpha I) U st {$is_in_infinite_cartesian_product(I, U, X, c)}
    fn_range(c) $subset U
    have Y power_set(U) = fn_range(c)
    claim:
        ? forall alpha I, y U:
            y $in Y
            y $in X(alpha)
            =>:
                y = c(alpha)
        y $in fn_range(c)
        have by fn_preimage: beta from y $in fn_range(c)
        y = c(beta)
        c(beta) $in X(beta)
        by cases:
            ? y = c(alpha)
            case beta = alpha:
                y = c(beta) = c(alpha)
            case beta != alpha:
                claim:
                    ? alpha != beta
                    by contra:
                        ? alpha != beta
                        alpha = beta
                        beta = alpha
                        impossible beta != alpha
                intersect(X(alpha), X(beta)) = {}
                y $in X(beta)
                y $in intersect(X(alpha), X(beta))
                impossible y $in {}
    claim:
        ? forall alpha I:
            exist! y U st {y $in Y, y $in X(alpha)}
        c(alpha) $in fn_range(c)
        c(alpha) $in Y
        c(alpha) $in X(alpha)
        witness exist! y U st {y $in Y, y $in X(alpha)} from c(alpha):
            claim:
                ? forall y1, y2 U:
                    y1 $in Y
                    y1 $in X(alpha)
                    y2 $in Y
                    y2 $in X(alpha)
                    =>:
                        y1 = y2
                y1 = c(alpha)
                c(alpha) = y2
    by def $is_single_intersection_selector(I, U, X, Y)
    $is_single_intersection_selector(I, U, X, Y)
    witness exist Y0 power_set(U) st {$is_single_intersection_selector(I, U, X, Y0)} from Y
thm selector_for_disjointized_families_gives_axiom_of_choice:
    ? forall I, U set, X fn(alpha I) power_set(U):
        $is_nonempty_family(I, U, X)
        =>:
            $has_infinite_cartesian_product_member(I, U, X)
    release thm axiom_of_choice_for_subsets(I, U, X)
prop is_right_inverse_of_surjection(A, B set, g fn(b B) A, f fn(a A) B):
    forall a A:
        g(f(a)) = a
thm surjection_has_injective_right_inverse_from_choice:
    ? forall A, B set, g fn(b B) A:
        $chap3::is_surjective_fn(B, A, g)
        =>:
            exist f fn(a A) B st {$chap3::is_injective_fn(A, B, f), $is_right_inverse_of_surjection(A, B, g, f)}
    have fn fiber_family(alpha A) power_set(B) = {b B: g(b) = alpha}
    claim:
        ? forall a A:
            $is_nonempty_set(fiber_family(a))
        obtain b from exist b B st {a = g(b)}
        g(b) = a
        b $in {t B: g(t) = a}
        b $in fiber_family(a)
        witness $is_nonempty_set(fiber_family(a)) from b
    by def $is_nonempty_family(A, B, fiber_family)
    $is_nonempty_family(A, B, fiber_family)
    release thm axiom_of_choice_for_subsets(A, B, fiber_family)
    obtain f from exist c fn(alpha A) B st {$is_in_infinite_cartesian_product(A, B, fiber_family, c)}
    claim:
        ? forall a A:
            f(a) $in fiber_family(a)
        f(a) $in fiber_family(a)
    claim:
        ? forall a A:
            f(a) $in {b B: g(b) = a}
        fiber_family(a) = {t B: g(t) = a}
        f(a) $in fiber_family(a)
        f(a) $in {t B: g(t) = a}
    thm fiber_member_maps_to_index:
        ? forall target A, fiber_element B:
            fiber_element $in {t B: g(t) = target}
            =>:
                g(fiber_element) = target
    claim:
        ? forall a A:
            g(f(a)) = a
        release thm fiber_member_maps_to_index(a, f(a))
    by def $is_right_inverse_of_surjection(A, B, g, f)
    claim:
        ? $chap3::is_injective_fn(A, B, f)
        claim:
            ? forall a1, a2 A:
                f(a1) = f(a2)
                =>:
                    a1 = a2
            a1 = g(f(a1)) = g(f(a2)) = a2
        by def $chap3::is_injective_fn(A, B, f)
    witness exist f0 fn(a A) B st {$chap3::is_injective_fn(A, B, f0), $is_right_inverse_of_surjection(A, B, g, f0)} from f
thm right_inverse_principle_implies_axiom_of_choice:
    ? forall I, U set, X fn(alpha I) power_set(U):
        $is_nonempty_family(I, U, X)
        =>:
            $has_infinite_cartesian_product_member(I, U, X)
    release thm axiom_of_choice_for_subsets(I, U, X)
