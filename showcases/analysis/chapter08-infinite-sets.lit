            =>:
                y1 = y2
        y1 = diagonal_index(triangle_unrank(y1)) = diagonal_index(triangle_unrank(y2)) = y2
    by def $chap3::is_injective_fn(N, natural_triangle, triangle_unrank)
claim:
    ? $chap3::is_surjective_fn(N, natural_triangle, triangle_unrank)
