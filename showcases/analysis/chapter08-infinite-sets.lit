# Chapter 08 infinite sets
# Selected Analysis I development; scope and assumptions: STATUS.md.

prop embeds_into(S, T set):
    exist f fn(x S) T st {$chap3::is_injective_fn(S, T, f)}
prop is_countably_infinite(X set):
    $chap3::has_equal_cardinality(N, X)
prop is_at_most_countable(X set):
    $embeds_into(X, N)
prop is_uncountable(X set):
    $chap3::has_infinite_cardinality(X)
    not $is_countably_infinite(X)
thm countably_infinite_is_at_most_countable:
    ? forall X set:
        $is_countably_infinite(X)
        =>:
            $is_at_most_countable(X)
    $chap3::has_equal_cardinality(N, X)
    obtain f from exist f fn(n N) X st {$chap3::is_bijective_fn(N, X, f)}
    $chap3::is_injective_fn(N, X, f)
    $chap3::is_surjective_fn(N, X, f)
    claim:
        ? forall x X:
            exist! n N st {f(n) = x}
        obtain n from exist n N st {x = f(n)}
        claim:
            ? forall n1, n2 N:
                f(n1) = x
                f(n2) = x
                =>:
                    n1 = n2
            f(n1) = x = f(n2)
            n1 = n2
        witness exist! k N st {f(k) = x} from n:
            f(n) = x
    have fn inverse_f by exist!:
        ? forall x X:
            exist! n N st {f(n) = x}
    claim:
        ? $chap3::is_injective_fn(X, N, inverse_f)
        claim:
            ? forall x1, x2 X:
                inverse_f(x1) = inverse_f(x2)
                =>:
                    x1 = x2
            f(inverse_f(x1)) = x1
            f(inverse_f(x2)) = x2
            x1 = f(inverse_f(x1)) = f(inverse_f(x2)) = x2
        by def $chap3::is_injective_fn(X, N, inverse_f)
    witness $embeds_into(X, N) from inverse_f
    by def $is_at_most_countable(X)
thm finite_cardinality_gives_at_most_countable:
    ? forall X set:
        $chap3::has_finite_cardinality(X)
        =>:
            $is_at_most_countable(X)
    obtain n from exist n N st {$chap3::has_cardinality(X, n)}
    $chap3::has_equal_cardinality(X, range(0, n))
    obtain f from exist f fn(x X) range(0, n) st {$chap3::is_bijective_fn(X, range(0, n), f)}
    $chap3::is_injective_fn(X, range(0, n), f)
    by def range(0, n) $subset N
    forall x X:
        f(x) $in range(0, n)
        f(x) $in N
    have fn encode_X(x X) N = f(x)
    claim:
        ? $chap3::is_injective_fn(X, N, encode_X)
        forall x1, x2 X:
            encode_X(x1) = encode_X(x2)
            =>:
                encode_X(x1) = f(x1)
                encode_X(x2) = f(x2)
                f(x1) = f(x2)
                x1 = x2
        by def $chap3::is_injective_fn(X, N, encode_X)
        $chap3::is_injective_fn(X, N, encode_X)
    witness $embeds_into(X, N) from encode_X
    $embeds_into(X, N)
    by def $is_at_most_countable(X)
thm injection_into_at_most_countable_gives_at_most_countable:
    ? forall X, Y set, phi fn(x X) Y:
        $is_at_most_countable(Y)
        $chap3::is_injective_fn(X, Y, phi)
        =>:
            $is_at_most_countable(X)
    $embeds_into(Y, N)
    obtain encode_Y from exist encode_Y fn(y Y) N st {$chap3::is_injective_fn(Y, N, encode_Y)}
    forall x X:
        phi(x) $in Y
        encode_Y(phi(x)) $in N
    have fn encode_X(x X) N = encode_Y(phi(x))
    claim:
        ? $chap3::is_injective_fn(X, N, encode_X)
        forall x1, x2 X:
            encode_X(x1) = encode_X(x2)
            =>:
                encode_X(x1) = encode_Y(phi(x1))
                encode_X(x2) = encode_Y(phi(x2))
                encode_Y(phi(x1)) = encode_Y(phi(x2))
                phi(x1) = phi(x2)
                x1 = x2
        by def $chap3::is_injective_fn(X, N, encode_X)
        $chap3::is_injective_fn(X, N, encode_X)
    witness $embeds_into(X, N) from encode_X
    $embeds_into(X, N)
    by def $is_at_most_countable(X)
prop is_even_natural_number(n N):
    exist k N st {n = 2 * k}
have even_natural_numbers set = {m N: $is_even_natural_number(m)}
even_natural_numbers = {m N: $is_even_natural_number(m)}
claim:
    ? $is_countably_infinite(N)
    have fn id_N(x N) N = x
    claim:
        ? $chap3::is_injective_fn(N, N, id_N)
        claim:
            ? forall x1, x2 N:
                id_N(x1) = id_N(x2)
                =>:
                    x1 = x2
            x1 = id_N(x1) = id_N(x2) = x2
        by def $chap3::is_injective_fn(N, N, id_N)
        $chap3::is_injective_fn(N, N, id_N)
    claim:
        ? $chap3::is_surjective_fn(N, N, id_N)
        claim:
            ? forall y N:
                exist x N st {y = id_N(x)}
            witness exist x N st {y = id_N(x)} from y:
                id_N(y) = y
                y = id_N(y)
        by def $chap3::is_surjective_fn(N, N, id_N)
        $chap3::is_surjective_fn(N, N, id_N)
    by def $chap3::is_bijective_fn(N, N, id_N)
    $chap3::is_bijective_fn(N, N, id_N)
    witness $chap3::has_equal_cardinality(N, N) from id_N
    by def $is_countably_infinite(N)
claim:
    ? $is_countably_infinite(N+)
    have fn succ_N(n N) N+ = n + 1
    claim:
        ? $chap3::is_injective_fn(N, N+, succ_N)
        claim:
            ? forall x1, x2 N:
                succ_N(x1) = succ_N(x2)
                =>:
                    x1 = x2
            x1 + 1 = succ_N(x1) = succ_N(x2) = x2 + 1
            x1 = (x1 + 1) - 1 = (x2 + 1) - 1 = x2
        by def $chap3::is_injective_fn(N, N+, succ_N)
        $chap3::is_injective_fn(N, N+, succ_N)
    claim:
        ? $chap3::is_surjective_fn(N, N+, succ_N)
        claim:
            ? forall y N+:
                exist x N st {y = succ_N(x)}
            y - 1 $in N
            succ_N(y - 1) = (y - 1) + 1 = y
            y = succ_N(y - 1)
            witness exist x N st {y = succ_N(x)} from y - 1
        by def $chap3::is_surjective_fn(N, N+, succ_N)
        $chap3::is_surjective_fn(N, N+, succ_N)
    by def $chap3::is_bijective_fn(N, N+, succ_N)
    witness $chap3::has_equal_cardinality(N, N+) from succ_N
    by def $is_countably_infinite(N+)
claim:
    ? $is_countably_infinite(even_natural_numbers)
    claim:
        ? forall n N:
            2 * n $in even_natural_numbers
        witness exist k N st {2 * n = 2 * k} from n
        by def $is_even_natural_number(2 * n)
        2 * n $in {m N: $is_even_natural_number(m)}
    have fn double_to_even(n N) even_natural_numbers = 2 * n
    claim:
        ? $chap3::is_injective_fn(N, even_natural_numbers, double_to_even)
        claim:
            ? forall x1, x2 N:
                double_to_even(x1) = double_to_even(x2)
                =>:
                    x1 = x2
            2 * x1 = double_to_even(x1) = double_to_even(x2) = 2 * x2
            x1 = (2 * x1) / 2 = (2 * x2) / 2 = x2
        by def $chap3::is_injective_fn(N, even_natural_numbers, double_to_even)
    claim:
        ? $chap3::is_surjective_fn(N, even_natural_numbers, double_to_even)
        claim:
            ? forall y even_natural_numbers:
                exist x N st {y = double_to_even(x)}
            y $in even_natural_numbers
            y $in {n N: $is_even_natural_number(n)}
            $is_even_natural_number(y)
            obtain k from $is_even_natural_number(y)
            double_to_even(k) = 2 * k
            y = double_to_even(k)
            witness exist x N st {y = double_to_even(x)} from k
        by def $chap3::is_surjective_fn(N, even_natural_numbers, double_to_even)
    witness exist f fn(x N) even_natural_numbers st {$chap3::is_bijective_fn(N, even_natural_numbers, f)} from double_to_even
    by def $is_countably_infinite(even_natural_numbers)
prop is_minimum_of_natural_subset(X power_set(N), n N):
    n $in X
    forall m X:
        n <= m
thm natural_subset_has_unique_minimum:
    ? forall X power_set(N):
        $is_nonempty_set(X)
        =>:
            exist! n N st {$is_minimum_of_natural_subset(X, n)}
    thm negated_weak_bound_is_strict_reverse:
        ? forall left, right R:
            not left <= right
            =>:
                right < left
    have a X
    a $in N
    a $in R
    have S set = {n X: n <= a}
    claim:
        ? $is_finite_set(S)
        claim:
            ? forall n S:
                n $in closed_range(0, a)
            n $in S
            n $in N
            n <= a
            n >= 0
        S $subset closed_range(0, a)
        release thm subset_of_finite_set_is_finite(S, closed_range(0, a))
    claim:
        ? $is_nonempty_set(S)
        witness $is_nonempty_set(S) from a:
            S = {n X: n <= a}
            a <= a
            a $in {n X: n <= a}
            a $in S
    $is_finite_set(S)
    $is_nonempty_set(S)
    claim:
        ? forall n S:
            n $in R
        n $in N
        n $in R
    S $subset R
    S = {n X: n <= a}
    a <= a
    a $in {n X: n <= a}
    a $in S
    finite_set_min(S) $in S
    finite_set_min(S) <= a
    claim:
        ? forall m X:
            finite_set_min(S) <= m
        m $in N
        m $in R
        by cases:
            ? finite_set_min(S) <= m
            case m <= a:
                S = {n X: n <= a}
                m $in X
                m <= a
                m $in {n X: n <= a}
                m $in S
                finite_set_min(S) <= m
            case not m <= a:
                release thm negated_weak_bound_is_strict_reverse(m, a)
                finite_set_min(S) <= a
                a < m
                finite_set_min(S) < m
                finite_set_min(S) <= m
    claim:
        ? forall n1, n2 N:
            $is_minimum_of_natural_subset(X, n1)
            $is_minimum_of_natural_subset(X, n2)
            =>:
                n1 = n2
        n1 <= n2
        n2 <= n1
    witness exist! n N st {$is_minimum_of_natural_subset(X, n)} from finite_set_min(S):
        finite_set_min(S) $in X
        forall m X:
            finite_set_min(S) <= m
        $is_minimum_of_natural_subset(X, finite_set_min(S))
claim:
    ? forall X power_set(N):
        $is_nonempty_set(X)
        =>:
            exist! n N st {$is_minimum_of_natural_subset(X, n)}
    release thm natural_subset_has_unique_minimum(X)
have fn min_of_N_subset by exist!:
    ? forall X power_set(N):
        $is_nonempty_set(X)
        =>:
            exist! n N st {$is_minimum_of_natural_subset(X, n)}
prop is_least_natural_element_above_in_subset(X power_set(N), a N, y N):
    y $in X
    a < y
    forall z X:
        a < z
        =>:
            y <= z
thm empty_set_has_equal_cardinality_self:
    ? forall:
        $chap3::has_equal_cardinality({}, {})
    have fn empty_to_empty(x {}) {} = x
    claim:
        ? $chap3::is_injective_fn({}, {}, empty_to_empty)
        forall x1, x2 {}:
            empty_to_empty(x1) = empty_to_empty(x2)
            =>:
                x1 = x2
        by def $chap3::is_injective_fn({}, {}, empty_to_empty)
        $chap3::is_injective_fn({}, {}, empty_to_empty)
    claim:
        ? $chap3::is_surjective_fn({}, {}, empty_to_empty)
        claim:
            ? forall y {}:
                exist x {} st {y = empty_to_empty(x)}
            by contra:
                ? exist x {} st {y = empty_to_empty(x)}
                not $is_nonempty_set({})
                witness $is_nonempty_set({}) from y:
                    y $in {}
                impossible $is_nonempty_set({})
        by def $chap3::is_surjective_fn({}, {}, empty_to_empty)
        $chap3::is_surjective_fn({}, {}, empty_to_empty)
    by def $chap3::is_bijective_fn({}, {}, empty_to_empty)
    witness $chap3::has_equal_cardinality({}, {}) from empty_to_empty
thm empty_set_has_cardinality_zero:
    ? forall:
        $chap3::has_cardinality({}, 0)
    release thm empty_set_has_equal_cardinality_self()
    range(0, 0) = {}
    by def $chap3::has_cardinality({}, 0)
thm empty_set_has_finite_cardinality:
    ? forall:
        $chap3::has_finite_cardinality({})
    release thm empty_set_has_cardinality_zero()
    witness $chap3::has_finite_cardinality({}) from 0
thm positive_count_finite_set_has_cardinality:
    ? forall s finite_set:
        finite_set_size(s) >= 1
        =>:
            $chap3::has_cardinality(s, finite_set_size(s))
    release thm finite_set_has_bijective_index(s)
    obtain idx from exist idx finite_seq(s, finite_set_size(s)) st {$bijective(closed_range(1, finite_set_size(s)), s, idx)}
    claim:
        ? forall t range(0, finite_set_size(s)):
            exist! j closed_range(1, finite_set_size(s)) st {j = t + 1}
        t >= 0
        t < finite_set_size(s)
        t $in N
        t + 1 >= 1
        t + 1 <= finite_set_size(s)
        t + 1 $in closed_range(1, finite_set_size(s))
        witness exist! j closed_range(1, finite_set_size(s)) st {j = t + 1} from t + 1
        forall j1, j2 closed_range(1, finite_set_size(s)):
            j1 = t + 1
            j2 = t + 1
            =>:
                j1 = j2
    have fn shift_up by exist!:
        ? forall t range(0, finite_set_size(s)):
            exist! j closed_range(1, finite_set_size(s)) st {j = t + 1}
    claim:
        ? forall x s:
            exist! t range(0, finite_set_size(s)) st {idx(shift_up(t)) = x}
        exist! j closed_range(1, finite_set_size(s)) st {idx(j) = x}
        obtain j from exist j closed_range(1, finite_set_size(s)) st {idx(j) = x}
        j >= 1
        j <= finite_set_size(s)
        j - 1 >= 0
        j - 1 < j <= finite_set_size(s)
        j - 1 $in range(0, finite_set_size(s))
        claim:
            ? forall t1, t2 range(0, finite_set_size(s)):
                idx(shift_up(t1)) = x
                idx(shift_up(t2)) = x
                =>:
                    t1 = t2
            shift_up(t1) = t1 + 1
            shift_up(t2) = t2 + 1
            shift_up(t1) = shift_up(t2)
            t1 + 1 = t2 + 1
            t1 = (t1 + 1) - 1 = (t2 + 1) - 1 = t2
        witness exist! t range(0, finite_set_size(s)) st {idx(shift_up(t)) = x} from j - 1:
            shift_up(j - 1) = (j - 1) + 1 = j
            idx(shift_up(j - 1)) = idx(j) = x
    have fn zero_index_of_s by exist!:
        ? forall x s:
            exist! t range(0, finite_set_size(s)) st {idx(shift_up(t)) = x}
    claim:
        ? $chap3::is_injective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
        claim:
            ? forall x1, x2 s:
                zero_index_of_s(x1) = zero_index_of_s(x2)
                =>:
                    x1 = x2
            idx(shift_up(zero_index_of_s(x1))) = x1
            idx(shift_up(zero_index_of_s(x2))) = x2
            shift_up(zero_index_of_s(x1)) = shift_up(zero_index_of_s(x2))
            idx(shift_up(zero_index_of_s(x1))) = idx(shift_up(zero_index_of_s(x2)))
            x1 = x2
        by def $chap3::is_injective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
        $chap3::is_injective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
    claim:
        ? $chap3::is_surjective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
        claim:
            ? forall t range(0, finite_set_size(s)):
                exist x s st {t = zero_index_of_s(x)}
            have x s = idx(shift_up(t))
            idx(shift_up(zero_index_of_s(x))) = x = idx(shift_up(t))
            exist! j closed_range(1, finite_set_size(s)) st {idx(j) = x}
            shift_up(zero_index_of_s(x)) = shift_up(t)
            zero_index_of_s(x) = t
            witness exist x0 s st {t = zero_index_of_s(x0)} from x
        by def $chap3::is_surjective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
        $chap3::is_surjective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
    by def $chap3::is_bijective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
    $chap3::is_bijective_fn(s, range(0, finite_set_size(s)), zero_index_of_s)
    witness $chap3::has_equal_cardinality(s, range(0, finite_set_size(s))) from zero_index_of_s
    by def $chap3::has_cardinality(s, finite_set_size(s))
thm finite_set_has_cardinality_count:
    ? forall s finite_set:
        $chap3::has_cardinality(s, finite_set_size(s))
    thm nonzero_natural_is_at_least_one:
        ? forall count N:
            count != 0
            =>:
                count >= 1
        count >= 0
        by contra:
            ? count > 0
            count <= 0
            count = 0
            impossible count != 0
        count $in N+
        count >= 1
    finite_set_size(s) = 0 or finite_set_size(s) != 0
    by cases:
        ? $chap3::has_cardinality(s, finite_set_size(s))
        case finite_set_size(s) = 0:
            s = {}
            release thm empty_set_has_cardinality_zero()
            $chap3::has_cardinality({}, 0)
            $chap3::has_cardinality(s, finite_set_size(s))
        case finite_set_size(s) != 0:
            release thm nonzero_natural_is_at_least_one(finite_set_size(s))
            finite_set_size(s) >= 1
            release thm positive_count_finite_set_has_cardinality(s)
            $chap3::has_cardinality(s, finite_set_size(s))
thm finite_cardinality_gives_finite_set:
    ? forall X set:
        $chap3::has_finite_cardinality(X)
        =>:
            $is_finite_set(X)
    obtain n from exist n N st {$chap3::has_cardinality(X, n)}
    $chap3::has_equal_cardinality(X, range(0, n))
    obtain f from exist f fn(x X) range(0, n) st {$chap3::is_bijective_fn(X, range(0, n), f)}
    $chap3::is_injective_fn(X, range(0, n), f)
    $chap3::is_surjective_fn(X, range(0, n), f)
    claim:
        ? forall y range(0, n):
            exist! x X st {f(x) = y}
        obtain x from exist x X st {y = f(x)}
        claim:
            ? forall x1, x2 X:
                f(x1) = y
                f(x2) = y
                =>:
                    x1 = x2
            f(x1) = y = f(x2)
            x1 = x2
        witness exist! z X st {f(z) = y} from x:
            f(x) = y
    have fn inverse_f by exist!:
        ? forall y range(0, n):
            exist! x X st {f(x) = y}
    claim:
        ? X = fn_range(inverse_f)
        by extension:
            ? X = fn_range(inverse_f)
            claim:
                ? forall x X:
                    x $in fn_range(inverse_f)
                f(x) $in range(0, n)
                inverse_f(f(x)) = x
                inverse_f(f(x)) $in fn_range(inverse_f)
            claim:
                ? forall x fn_range(inverse_f):
                    x $in X
                obtain y from exist y range(0, n) st {x = inverse_f(y)}
                inverse_f(y) $in X
    $is_finite_set(range(0, n))
    release thm fn_set_member(inverse_f, fn(y range(0, n)) X)
    $is_finite_set(fn_range(inverse_f))
thm infinite_natural_subset_is_nonempty:
    ? forall X power_set(N):
        $chap3::has_infinite_cardinality(X)
        =>:
            $is_nonempty_set(X)
    by contra:
        ? $is_nonempty_set(X)
        X = {}
        release thm empty_set_has_finite_cardinality()
        impossible not $chap3::has_finite_cardinality(X)
thm infinite_natural_subset_has_tail_above:
    ? forall X power_set(N), a N:
        $chap3::has_infinite_cardinality(X)
        =>:
            $is_nonempty_set({y N: y $in X and a < y})
    claim:
        ? not $is_finite_set(X)
        by contra:
            ? not $is_finite_set(X)
            release thm finite_set_has_cardinality_count(X)
            witness exist n N st {$chap3::has_cardinality(X, n)} from finite_set_size(X)
            impossible not $chap3::has_finite_cardinality(X)
    $is_finite_set(closed_range(0, a))
    not $is_finite_set(set_minus(X, closed_range(0, a)))
    claim:
        ? $is_nonempty_set(set_minus(X, closed_range(0, a)))
        by contra:
            ? $is_nonempty_set(set_minus(X, closed_range(0, a)))
            set_minus(X, closed_range(0, a)) = {}
            impossible not $is_finite_set({})
    have x set_minus(X, closed_range(0, a))
    x $in N
    by cases:
        ? $is_nonempty_set({y N: y $in X and a < y})
        case x <= a:
            x >= 0
            x $in closed_range(0, a)
            impossible not x $in closed_range(0, a)
        case x > a:
            witness $is_nonempty_set({y N: y $in X and a < y}) from x
thm least_natural_element_above_exists_unique:
    ? forall X power_set(N), a N:
        $is_nonempty_set({x N: x $in X and a < x})
        =>:
            exist! y N st {$is_least_natural_element_above_in_subset(X, a, y)}
    have T power_set(N) = {x N: x $in X and a < x}
    have b {x N: x $in X and a < x}
    witness $is_nonempty_set(T) from b:
        b $in {x N: x $in X and a < x}
        b $in T
    release thm natural_subset_has_unique_minimum(T)
    obtain y from exist y N st {$is_minimum_of_natural_subset(T, y)}
    claim:
        ? forall y1, y2 N:
            $is_least_natural_element_above_in_subset(X, a, y1)
            $is_least_natural_element_above_in_subset(X, a, y2)
            =>:
                y1 = y2
        y1 <= y2
        y2 <= y1
    witness exist! z N st {$is_least_natural_element_above_in_subset(X, a, z)} from y:
        y $in T
        y $in X
        a < y
        forall m T:
            y <= m
        forall m X:
            a < m
            =>:
                T = {x N: x $in X and a < x}
                m $in {x N: x $in X and a < x}
                m $in T
                y <= m
        by def $is_least_natural_element_above_in_subset(X, a, y)
claim:
    ? forall X power_set(N):
        $chap3::has_infinite_cardinality(X)
        =>:
            exist! y N st {$is_minimum_of_natural_subset(X, y)}
    release thm infinite_natural_subset_is_nonempty(X)
    release thm natural_subset_has_unique_minimum(X)
have fn first_in_infinite_N_subset_value by exist!:
    ? forall X power_set(N):
        $chap3::has_infinite_cardinality(X)
        =>:
            exist! y N st {$is_minimum_of_natural_subset(X, y)}
claim:
    ? forall X power_set(N), a N:
        $chap3::has_infinite_cardinality(X)
        =>:
            exist! y N st {$is_least_natural_element_above_in_subset(X, a, y)}
    release thm infinite_natural_subset_has_tail_above(X, a)
    release thm least_natural_element_above_exists_unique(X, a)
have fn next_in_infinite_N_subset_value by exist!:
    ? forall X power_set(N), a N:
        $chap3::has_infinite_cardinality(X)
        =>:
            exist! y N st {$is_least_natural_element_above_in_subset(X, a, y)}
have fn increasing_N_subset_enum_value(X power_set(N), n Z: n >= 0, $chap3::has_infinite_cardinality(X)) N by induc n from 0:
    case n = 0: first_in_infinite_N_subset_value(X)
    case n > 0: next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n - 1))
thm increasing_enum_value_lies_in_subset:
    ? forall X power_set(N), n N:
        $chap3::has_infinite_cardinality(X)
        =>:
            increasing_N_subset_enum_value(X, n) $in X
    n >= 0
    by cases:
        ? increasing_N_subset_enum_value(X, n) $in X
        case n = 0:
            increasing_N_subset_enum_value(X, n) = first_in_infinite_N_subset_value(X)
            $is_minimum_of_natural_subset(X, first_in_infinite_N_subset_value(X))
            first_in_infinite_N_subset_value(X) $in X
        case n != 0:
            by contra:
                ? n > 0
                n <= 0
                n = 0
                impossible n != 0
            n $in N+
            n - 1 $in N
            increasing_N_subset_enum_value(X, n) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n - 1))
            $is_least_natural_element_above_in_subset(X, increasing_N_subset_enum_value(X, n - 1), next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n - 1)))
            next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n - 1)) $in X
prop is_recursive_min_enumeration_from_N_to_subset(X power_set(N), f fn(n N) X):
    $chap3::has_infinite_cardinality(X)
    forall n N:
        f(n) = increasing_N_subset_enum_value(X, n)
thm infinite_subset_has_recursive_min_enumeration:
    ? forall X power_set(N):
        $chap3::has_infinite_cardinality(X)
        =>:
            exist f fn(n N) X st {$is_recursive_min_enumeration_from_N_to_subset(X, f)}
    forall n N:
        increasing_N_subset_enum_value(X, n) $in X
    have fn recursive_enum_to_subset(n N) X = increasing_N_subset_enum_value(X, n)
    by def $is_recursive_min_enumeration_from_N_to_subset(X, recursive_enum_to_subset)
    witness exist f fn(n N) X st {$is_recursive_min_enumeration_from_N_to_subset(X, f)} from recursive_enum_to_subset
claim:
    ? forall natural_subset power_set(N), mapping fn(arg N) natural_subset, index N:
        mapping(index) $in N
        mapping(index) $in R
    natural_subset $subset N
    N $subset R
    mapping(index) $in natural_subset
    mapping(index) $in N
    mapping(index) $in R
thm recursive_min_enumeration_step_is_increasing:
    ? forall X power_set(N), f fn(n N) X, n N:
        f(n + 1) $in R
        f(n) $in R
        $chap3::has_infinite_cardinality(X)
        $is_recursive_min_enumeration_from_N_to_subset(X, f)
        =>:
            f(n + 1) > f(n)
    forall k N:
        f(k) = increasing_N_subset_enum_value(X, k)
    n >= 0
    n + 1 >= 1
    n + 1 > 0
    (n + 1) - 1 = n
    increasing_N_subset_enum_value(X, n + 1) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, (n + 1) - 1)) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n))
    $is_least_natural_element_above_in_subset(X, increasing_N_subset_enum_value(X, n), next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n)))
    f(n) = increasing_N_subset_enum_value(X, n) < next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n)) = increasing_N_subset_enum_value(X, n + 1) = f(n + 1)
thm recursive_min_enumeration_strictly_increases_after_steps:
    ? forall X power_set(N), f fn(n N) X, n, k N:
        f $in fn(index N) R
        $chap3::has_infinite_cardinality(X)
        $is_recursive_min_enumeration_from_N_to_subset(X, f)
        =>:
            f(n) < f(n + k + 1)
    by induc k from 0:
        ? f(n) < f(n + k + 1)
        ? from k = 0:
            release thm recursive_min_enumeration_step_is_increasing(X, f, n)
            f(n) < f(n + 1)
            n + 0 + 1 = n + 1
            f(n + 0 + 1) = f(n + 1)
            f(n) < f(n + 1) = f(n + 0 + 1)
        ? induc:
            f(n) < f(n + k + 1)
            release thm recursive_min_enumeration_step_is_increasing(X, f, n + k + 1)
            f(n + k + 1) < f(n + k + 1 + 1)
            n + (k + 1) + 1 = n + k + 1 + 1
            f(n + (k + 1) + 1) = f(n + k + 1 + 1)
            f(n) < f(n + k + 1) < f(n + k + 1 + 1) = f(n + (k + 1) + 1)
claim:
    ? forall natural_subset power_set(N), mapping fn(arg N) natural_subset:
        mapping $in fn(index N) R
    natural_subset $subset N
    N $subset R
    natural_subset $subset R
    claim:
        ? forall index N:
            mapping(index) $in R
        mapping(index) $in natural_subset
        mapping(index) $in N
        mapping(index) $in R
    release thm fn_set_member(mapping, fn(index N) R)
thm recursive_min_enumeration_value_at_least_index:
    ? forall X power_set(N), f fn(n N) X, n N:
        f $in fn(index N) R
        $chap3::has_infinite_cardinality(X)
        $is_recursive_min_enumeration_from_N_to_subset(X, f)
        =>:
            f(n) >= n
    by induc n from 0:
        ? f(n) >= n
        ? from n = 0:
            f(0) $in N
            f(0) >= 0
        ? induc:
            f(n) >= n
            release thm recursive_min_enumeration_step_is_increasing(X, f, n)
            f(n + 1) > f(n)
            f(n) $in N
            f(n + 1) $in N
            f(n + 1) >= f(n) + 1
            f(n) + 1 >= n + 1
            f(n + 1) >= f(n) + 1 >= n + 1
            f(n + 1) >= n + 1
thm successor_strict_increase_has_strict_growth:
    ? forall X power_set(N), f fn(n N) X, n, k N:
        f $in fn(index N) R
        forall m N:
            f(m + 1) > f(m)
        =>:
            f(n) < f(n + k + 1)
    by induc k from 0:
        ? f(n) < f(n + k + 1)
        ? from k = 0:
            f(n + 1) > f(n)
            f(n) < f(n + 1)
            n + 0 + 1 = n + 1
            f(n + 0 + 1) = f(n + 1)
            f(n) < f(n + 1) = f(n + 0 + 1)
        ? induc:
            f(n) < f(n + k + 1)
            f(n + k + 1 + 1) > f(n + k + 1)
            f(n + k + 1) < f(n + k + 1 + 1)
            n + (k + 1) + 1 = n + k + 1 + 1
            f(n + (k + 1) + 1) = f(n + k + 1 + 1)
            f(n) < f(n + k + 1) < f(n + k + 1 + 1) = f(n + (k + 1) + 1)
prop is_increasing_bijection_from_N_to_subset(X power_set(N), f fn(n N) X):
    f $in fn(index N) R
    $chap3::is_bijective_fn(N, X, f)
    forall n N:
        f(n + 1) > f(n)
thm recursive_min_enumeration_is_surjective:
    ? forall X power_set(N), f fn(n N) X:
        $chap3::has_infinite_cardinality(X)
        $is_recursive_min_enumeration_from_N_to_subset(X, f)
        =>:
            $chap3::is_surjective_fn(N, X, f)
    X $subset N
    N $subset R
    X $subset R
    release thm fn_set_member(f, fn(index N) R)
    claim:
        ? forall x X:
            exist n N st {x = f(n)}
        x $in N
        x + 1 $in N
        release thm recursive_min_enumeration_value_at_least_index(X, f, x + 1)
        f(x + 1) >= x + 1
        x + 1 > x
        f(x + 1) >= x + 1 > x
        f(x + 1) > x
        have K power_set(N) = {n N: f(n) > x}
        x + 1 $in {n N: f(n) > x}
        x + 1 $in K
        witness $is_nonempty_set(K) from x + 1:
            x + 1 $in K
        $is_minimum_of_natural_subset(K, min_of_N_subset(K))
        have k N = min_of_N_subset(K)
        k $in K
        f(k) > x
        claim:
            ? k > 0
            by contra:
                ? k > 0
                k <= 0
                k >= 0
                k = 0
                f(k) = f(0)
                f(0) > x
                f(0) = increasing_N_subset_enum_value(X, 0) = first_in_infinite_N_subset_value(X)
                $is_minimum_of_natural_subset(X, first_in_infinite_N_subset_value(X))
                first_in_infinite_N_subset_value(X) <= x
                f(0) <= x
                impossible f(0) > x
        k - 1 $in N
        k = (k - 1) + 1
        k - 1 < k
        claim:
            ? f(k - 1) <= x
            f(k - 1) <= x or f(k - 1) > x
            by cases:
                ? f(k - 1) <= x
                case f(k - 1) <= x:
                    f(k - 1) <= x
                case f(k - 1) > x:
                    k - 1 $in {n N: f(n) > x}
                    k - 1 $in K
                    min_of_N_subset(K) <= k - 1
                    k = min_of_N_subset(K)
                    k <= k - 1
                    impossible k <= k - 1
        f(k - 1) < x or f(k - 1) >= x
        by cases:
            ? exist n N st {x = f(n)}
            case f(k - 1) < x:
                forall t N:
                    f(t) = increasing_N_subset_enum_value(X, t)
                f(k - 1) = increasing_N_subset_enum_value(X, k - 1)
                f(k) = f((k - 1) + 1) = increasing_N_subset_enum_value(X, (k - 1) + 1)
                increasing_N_subset_enum_value(X, (k - 1) + 1) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, ((k - 1) + 1) - 1))
                ((k - 1) + 1) - 1 = k - 1
                increasing_N_subset_enum_value(X, ((k - 1) + 1) - 1) = increasing_N_subset_enum_value(X, k - 1)
                f(k) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, k - 1))
                $is_least_natural_element_above_in_subset(X, increasing_N_subset_enum_value(X, k - 1), next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, k - 1)))
                $is_least_natural_element_above_in_subset(X, f(k - 1), f(k))
                f(k) <= x
                impossible f(k) > x
            case f(k - 1) >= x:
                f(k - 1) = x
                x = f(k - 1)
                witness exist n N st {x = f(n)} from k - 1:
                    x = f(k - 1)
    by def $chap3::is_surjective_fn(N, X, f)
thm recursive_min_enumeration_is_bijective:
    ? forall X power_set(N), f fn(n N) X:
        $chap3::has_infinite_cardinality(X)
        $is_recursive_min_enumeration_from_N_to_subset(X, f)
        =>:
            $chap3::is_bijective_fn(N, X, f)
    X $subset N
    N $subset R
    X $subset R
    release thm fn_set_member(f, fn(index N) R)
    claim:
        ? $chap3::is_injective_fn(N, X, f)
        claim:
            ? forall n1, n2 N:
                f(n1) = f(n2)
                =>:
                    n1 = n2
            n1 < n2 or n1 >= n2
            by cases:
                ? n1 = n2
                case n1 < n2:
                    n1 <= n2
                    n2 - n1 >= 1
                    n2 - n1 - 1 $in N
                    release thm recursive_min_enumeration_strictly_increases_after_steps(X, f, n1, n2 - n1 - 1)
                    f(n1) < f(n1 + (n2 - n1 - 1) + 1)
                    n1 + (n2 - n1 - 1) + 1 = n2
                    f(n1 + (n2 - n1 - 1) + 1) = f(n2)
                    f(n1) < f(n2)
                    impossible f(n1) = f(n2)
                case n1 >= n2:
                    n2 < n1 or n2 >= n1
                    by cases:
                        ? n1 = n2
                        case n2 < n1:
                            n2 <= n1
                            n1 - n2 >= 1
                            n1 - n2 - 1 $in N
                            release thm recursive_min_enumeration_strictly_increases_after_steps(X, f, n2, n1 - n2 - 1)
                            f(n2) < f(n2 + (n1 - n2 - 1) + 1)
                            n2 + (n1 - n2 - 1) + 1 = n1
                            f(n2 + (n1 - n2 - 1) + 1) = f(n1)
                            f(n2) < f(n1)
                            impossible f(n1) = f(n2)
                        case n2 >= n1:
                            n1 = n2
        by def $chap3::is_injective_fn(N, X, f)
    release thm recursive_min_enumeration_is_surjective(X, f)
    $chap3::is_surjective_fn(N, X, f)
    by def $chap3::is_bijective_fn(N, X, f)
thm increasing_bijection_zero_is_minimum:
    ? forall X power_set(N), f fn(n N) X:
        $is_increasing_bijection_from_N_to_subset(X, f)
        =>:
            $is_minimum_of_natural_subset(X, f(0))
    $chap3::is_bijective_fn(N, X, f)
    $chap3::is_surjective_fn(N, X, f)
    f(0) $in X
    claim:
        ? forall z X:
            f(0) <= z
        exist m N st {z = f(m)}
        obtain m from exist m N st {z = f(m)}
        m <= 0 or m > 0
        by cases:
            ? f(0) <= z
            case m <= 0:
                m >= 0
                m = 0
                z = f(m) = f(0)
                f(0) <= z
            case m > 0:
                m - 1 $in N
                release thm successor_strict_increase_has_strict_growth(X, f, 0, m - 1)
                f(0) < f(0 + (m - 1) + 1)
                0 + (m - 1) + 1 = m
                f(0 + (m - 1) + 1) = f(m) = z
                f(0) < z
                f(0) <= z
    by def $is_minimum_of_natural_subset(X, f(0))
thm increasing_bijection_successor_is_least_above:
    ? forall X power_set(N), f fn(n N) X, n N:
        $is_increasing_bijection_from_N_to_subset(X, f)
        =>:
            $is_least_natural_element_above_in_subset(X, f(n), f(n + 1))
    thm strict_integer_gap_is_at_least_one:
        ? forall upper, lower Z:
            upper > lower
            =>:
                upper - lower >= 1
        upper >= lower + 1
        upper - lower >= (lower + 1) - lower = 1
    $chap3::is_bijective_fn(N, X, f)
    $chap3::is_surjective_fn(N, X, f)
    f(n + 1) $in X
    f(n + 1) > f(n)
    claim:
        ? forall z X:
            f(n) < z
            =>:
                f(n + 1) <= z
        exist m N st {z = f(m)}
        obtain m from exist m N st {z = f(m)}
        m < n + 1 or m >= n + 1
        by cases:
            ? f(n + 1) <= z
            case m < n + 1:
                m <= n + 1 - 1
                m <= n + 1 - 1 = n
                m < n or m >= n
                by cases:
                    ? f(n + 1) <= z
                    case m < n:
                        n - m >= 1
                        n - m - 1 $in N
                        release thm successor_strict_increase_has_strict_growth(X, f, m, n - m - 1)
                        f(m) < f(m + (n - m - 1) + 1)
                        m + (n - m - 1) + 1 = n
                        f(m + (n - m - 1) + 1) = f(n)
                        f(m) < f(n)
                        z = f(m) < f(n)
                        f(n) < z < f(n)
                        f(n) $in N
                        f(n) + 1 <= f(n)
                        f(n) + 1 > f(n)
                        impossible f(n) + 1 > f(n)
                    case m >= n:
                        m = n
                        z = f(m) = f(n)
                        f(n) < z = f(n)
                        f(n) $in N
                        f(n) + 1 <= f(n)
                        f(n) + 1 > f(n)
                        impossible f(n) + 1 > f(n)
            case m >= n + 1:
                m <= n + 1 or m > n + 1
                by cases:
                    ? f(n + 1) <= z
                    case m <= n + 1:
                        m = n + 1
                        z = f(m) = f(n + 1)
                        f(n + 1) <= z
                    case m > n + 1:
                        m $in Z
                        n + 1 $in Z
                        release thm strict_integer_gap_is_at_least_one(m, n + 1)
                        m - (n + 1) >= 1
                        m - (n + 1) - 1 $in N
                        release thm successor_strict_increase_has_strict_growth(X, f, n + 1, m - (n + 1) - 1)
                        f(n + 1) < f(n + 1 + (m - (n + 1) - 1) + 1)
                        n + 1 + (m - (n + 1) - 1) + 1 = m
                        f(n + 1 + (m - (n + 1) - 1) + 1) = f(m) = z
                        f(n + 1) < z
                        f(n + 1) <= z
    by def $is_least_natural_element_above_in_subset(X, f(n), f(n + 1))
thm increasing_bijection_from_N_to_subset_is_recursive_min_enumeration:
    ? forall X power_set(N), f fn(n N) X:
        $chap3::has_infinite_cardinality(X)
        $is_increasing_bijection_from_N_to_subset(X, f)
        =>:
            $is_recursive_min_enumeration_from_N_to_subset(X, f)
    claim:
        ? forall n N:
            f(n) = increasing_N_subset_enum_value(X, n)
        by induc n from 0:
            ? f(n) = increasing_N_subset_enum_value(X, n)
            ? from n = 0:
                release thm increasing_bijection_zero_is_minimum(X, f)
                $is_minimum_of_natural_subset(X, f(0))
                $is_minimum_of_natural_subset(X, first_in_infinite_N_subset_value(X))
                exist! y N st {$is_minimum_of_natural_subset(X, y)}
                f(0) = first_in_infinite_N_subset_value(X)
                increasing_N_subset_enum_value(X, 0) = first_in_infinite_N_subset_value(X)
                f(0) = increasing_N_subset_enum_value(X, 0)
            ? induc:
                f(n) = increasing_N_subset_enum_value(X, n)
                release thm increasing_bijection_successor_is_least_above(X, f, n)
                $is_least_natural_element_above_in_subset(X, f(n), f(n + 1))
                $is_least_natural_element_above_in_subset(X, increasing_N_subset_enum_value(X, n), f(n + 1))
                $is_least_natural_element_above_in_subset(X, increasing_N_subset_enum_value(X, n), next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n)))
                exist! y N st {$is_least_natural_element_above_in_subset(X, increasing_N_subset_enum_value(X, n), y)}
                f(n + 1) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n))
                n >= 0
                n + 1 >= 1
                n + 1 > 0
                increasing_N_subset_enum_value(X, n + 1) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, (n + 1) - 1))
                (n + 1) - 1 = n
                increasing_N_subset_enum_value(X, (n + 1) - 1) = increasing_N_subset_enum_value(X, n)
                increasing_N_subset_enum_value(X, n + 1) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, (n + 1) - 1)) = next_in_infinite_N_subset_value(X, increasing_N_subset_enum_value(X, n))
                f(n + 1) = increasing_N_subset_enum_value(X, n + 1)
    by def $is_recursive_min_enumeration_from_N_to_subset(X, f)
thm infinite_subset_of_N_has_unique_increasing_enumeration:
    ? forall X power_set(N):
        $chap3::has_infinite_cardinality(X)
        =>:
            exist! f fn(n N) X st {$is_increasing_bijection_from_N_to_subset(X, f)}
            $is_countably_infinite(X)
    release thm infinite_subset_has_recursive_min_enumeration(X)
    obtain f from exist f fn(n N) X st {$is_recursive_min_enumeration_from_N_to_subset(X, f)}
    X $subset N
    N $subset R
    X $subset R
    release thm fn_set_member(f, fn(index N) R)
    release thm recursive_min_enumeration_is_bijective(X, f)
    claim:
        ? forall n N:
            f(n + 1) > f(n)
        release thm recursive_min_enumeration_step_is_increasing(X, f, n)
    by def $is_increasing_bijection_from_N_to_subset(X, f)
    claim:
        ? forall f1, f2 fn(n N) X:
            $is_increasing_bijection_from_N_to_subset(X, f1)
            $is_increasing_bijection_from_N_to_subset(X, f2)
            =>:
                f1 = f2
        release thm increasing_bijection_from_N_to_subset_is_recursive_min_enumeration(X, f1)
        release thm increasing_bijection_from_N_to_subset_is_recursive_min_enumeration(X, f2)
        claim:
            ? forall n N:
                f1(n) = f2(n)
            f1(n) = increasing_N_subset_enum_value(X, n) = f2(n)
        by fn_extension f1 = f2
    witness exist! f0 fn(n N) X st {$is_increasing_bijection_from_N_to_subset(X, f0)} from f
    witness $chap3::has_equal_cardinality(N, X) from f
    by def $is_countably_infinite(X)
thm infinite_at_most_countable_is_countably_infinite:
    ? forall X set:
        $chap3::has_infinite_cardinality(X)
        $is_at_most_countable(X)
        =>:
            $is_countably_infinite(X)
    $embeds_into(X, N)
    obtain f from $embeds_into(X, N)
    claim:
        ? forall y fn_range(f):
            exist! x X st {y = f(x)}
        release thm chap3::injective_fn_has_unique_preimage_in_range(X, N, f, y)
    have fn inverse_f by exist!:
        ? forall y fn_range(f):
            exist! x X st {y = f(x)}
    claim:
        ? $chap3::has_infinite_cardinality(fn_range(f))
        by contra:
            ? $chap3::has_infinite_cardinality(fn_range(f))
            claim:
                ? $chap3::has_finite_cardinality(fn_range(f))
                by contra:
                    ? $chap3::has_finite_cardinality(fn_range(f))
                    by def $chap3::has_infinite_cardinality(fn_range(f))
                    impossible $chap3::has_infinite_cardinality(fn_range(f))
            release thm finite_cardinality_gives_finite_set(fn_range(f))
            claim:
                ? $surjective(fn_range(f), X, inverse_f)
                claim:
                    ? forall x X:
                        exist y fn_range(f) st {x = inverse_f(y)}
                    f(x) $in fn_range(f)
                    inverse_f(f(x)) = x
                    witness exist y fn_range(f) st {x = inverse_f(y)} from f(x)
                by def $surjective(fn_range(f), X, inverse_f)
            $is_finite_set(X)
            release thm finite_set_has_cardinality_count(X)
            witness $chap3::has_finite_cardinality(X) from finite_set_size(X)
            by def $chap3::has_infinite_cardinality(X)
            impossible $chap3::has_finite_cardinality(X)
    fn_range(f) $subset N
    fn_range(f) $in power_set(N)
    release thm infinite_subset_of_N_has_unique_increasing_enumeration(fn_range(f))
    $chap3::has_equal_cardinality(N, fn_range(f))
    obtain enum from exist enum fn(n N) fn_range(f) st {$chap3::is_bijective_fn(N, fn_range(f), enum)}
    $chap3::is_injective_fn(N, fn_range(f), enum)
    $chap3::is_surjective_fn(N, fn_range(f), enum)
    have fn enumerate_X(n N) X = inverse_f(enum(n))
    thm equal_functions_have_equal_values:
        ? forall left, right fn(index N) X, input N:
            left = right
            =>:
                left(input) = right(input)
    enumerate_X = fn(index N) X {inverse_f(enum(index))}
    claim:
        ? $chap3::is_injective_fn(N, X, enumerate_X)
        claim:
            ? forall n1, n2 N:
                enumerate_X(n1) = enumerate_X(n2)
                =>:
                    n1 = n2
            release thm equal_functions_have_equal_values(enumerate_X, fn(index N) X {inverse_f(enum(index))}, n1)
            fn(index N) X {inverse_f(enum(index))}(n1) = inverse_f(enum(n1))
            enumerate_X(n1) = inverse_f(enum(n1))
            release thm equal_functions_have_equal_values(enumerate_X, fn(index N) X {inverse_f(enum(index))}, n2)
            fn(index N) X {inverse_f(enum(index))}(n2) = inverse_f(enum(n2))
            enumerate_X(n2) = inverse_f(enum(n2))
            inverse_f(enum(n1)) = enumerate_X(n1) = enumerate_X(n2) = inverse_f(enum(n2))
            f(inverse_f(enum(n1))) = f(inverse_f(enum(n2)))
            enum(n1) $in fn_range(f)
            enum(n1) = f(inverse_f(enum(n1)))
            f(inverse_f(enum(n1))) = enum(n1)
            enum(n2) $in fn_range(f)
            enum(n2) = f(inverse_f(enum(n2)))
            f(inverse_f(enum(n2))) = enum(n2)
            enum(n1) = enum(n2)
            n1 = n2
        by def $chap3::is_injective_fn(N, X, enumerate_X)
    claim:
        ? $chap3::is_surjective_fn(N, X, enumerate_X)
        claim:
            ? forall x X:
                exist n N st {x = enumerate_X(n)}
            f(x) $in fn_range(f)
            obtain n from exist n N st {f(x) = enum(n)}
            inverse_f(f(x)) = x
            inverse_f(enum(n)) = enumerate_X(n)
            x = enumerate_X(n)
            witness exist n0 N st {x = enumerate_X(n0)} from n
        by def $chap3::is_surjective_fn(N, X, enumerate_X)
    witness exist g fn(n N) X st {$chap3::is_bijective_fn(N, X, g)} from enumerate_X:
        $chap3::is_injective_fn(N, X, enumerate_X)
        $chap3::is_surjective_fn(N, X, enumerate_X)
    by def $is_countably_infinite(X)
thm proposition_3_6_14_N_embedding_implies_infinite:
    ? forall X set:
        $embeds_into(N, X)
        =>:
            $chap3::has_infinite_cardinality(X)
    obtain f from exist f fn(n N) X st {$chap3::is_injective_fn(N, X, f)}
    claim:
        ? not $chap3::has_finite_cardinality(X)
        by contra:
            ? not $chap3::has_finite_cardinality(X)
            obtain n from exist n N st {$chap3::has_cardinality(X, n)}
            $chap3::has_equal_cardinality(X, range(0, n))
            obtain b from exist b fn(x X) range(0, n) st {$chap3::is_bijective_fn(X, range(0, n), b)}
            $chap3::is_injective_fn(X, range(0, n), b)
            have fn c(k closed_range(0, n)) range(0, n) = b(f(k))
            claim:
                ? $injective(closed_range(0, n), range(0, n), c)
                forall k1, k2 closed_range(0, n):
                    c(k1) = c(k2)
                    =>:
                        k1 $in N
                        k2 $in N
                        b(f(k1)) = c(k1) = c(k2) = b(f(k2))
                        f(k1) = f(k2)
                        k1 = k2
                by def $injective(closed_range(0, n), range(0, n), c)
            $is_finite_set(closed_range(0, n))
            finite_set_size(fn_range(c)) = finite_set_size(closed_range(0, n))
            finite_set_size(closed_range(0, n)) = n - 0 + 1 = n + 1
            by def fn_range(c) $subset range(0, n)
            release thm subset_of_finite_set_is_finite(fn_range(c), range(0, n))
            $is_finite_set(fn_range(c))
            $is_finite_set(range(0, n))
            finite_set_size(fn_range(c)) <= finite_set_size(range(0, n))
            finite_set_size(range(0, n)) = n - 0 = n
            n + 1 > n
            impossible n + 1 <= n
    by def $chap3::has_infinite_cardinality(X)
thm at_most_countable_with_N_embedding_is_countably_infinite:
    ? forall X set:
        $is_at_most_countable(X)
        $embeds_into(N, X)
        =>:
            $is_countably_infinite(X)
    release thm proposition_3_6_14_N_embedding_implies_infinite(X)
    release thm infinite_at_most_countable_is_countably_infinite(X)
thm uncountable_is_not_at_most_countable:
    ? forall X set:
        $is_uncountable(X)
        =>:
            not $is_at_most_countable(X)
    by contra:
        ? not $is_at_most_countable(X)
        release thm infinite_at_most_countable_is_countably_infinite(X)
        impossible not $is_countably_infinite(X)
thm natural_subset_is_at_most_countable:
    ? forall X power_set(N):
        $is_at_most_countable(X)
    have fn include_in_N(x X) N = x
    claim:
        ? $chap3::is_injective_fn(X, N, include_in_N)
        claim:
            ? forall x1, x2 X:
                include_in_N(x1) = include_in_N(x2)
                =>:
                    x1 = x2
            x1 = include_in_N(x1) = include_in_N(x2) = x2
        by def $chap3::is_injective_fn(X, N, include_in_N)
    witness $embeds_into(X, N) from include_in_N
    by def $is_at_most_countable(X)
thm subset_of_at_most_countable_is_at_most_countable:
    ? forall X, Y set:
        $is_at_most_countable(X)
        Y $subset X
        =>:
            $is_at_most_countable(Y)
    forall y Y:
        y $in X
    have fn include_Y(y Y) X = y
    claim:
        ? $chap3::is_injective_fn(Y, X, include_Y)
        claim:
            ? forall y1, y2 Y:
                include_Y(y1) = include_Y(y2)
                =>:
                    y1 = y2
            y1 = include_Y(y1) = include_Y(y2) = y2
        by def $chap3::is_injective_fn(Y, X, include_Y)
    release thm injection_into_at_most_countable_gives_at_most_countable(Y, X, include_Y)
thm natural_image_is_at_most_countable:
    ? forall Y set, f fn(n N) Y:
        $is_at_most_countable(fn_range(f))
    claim:
        ? forall y fn_range(f):
            exist! n N st {$is_minimum_of_natural_subset({m N: y = f(m)}, n)}
        have by fn_preimage: p from y $in fn_range(f)
        p $in {m N: y = f(m)}
        witness $is_nonempty_set({m N: y = f(m)}) from p
        release thm natural_subset_has_unique_minimum({m N: y = f(m)})
    have fn first_index by exist!:
        ? forall y fn_range(f):
            exist! n N st {$is_minimum_of_natural_subset({m N: y = f(m)}, n)}
    claim:
        ? $chap3::is_injective_fn(fn_range(f), N, first_index)
        claim:
            ? forall y1, y2 fn_range(f):
                first_index(y1) = first_index(y2)
                =>:
                    y1 = y2
            $is_minimum_of_natural_subset({m N: y1 = f(m)}, first_index(y1))
            $is_minimum_of_natural_subset({m N: y2 = f(m)}, first_index(y2))
            first_index(y1) $in {m N: y1 = f(m)}
            first_index(y2) $in {m N: y2 = f(m)}
            y1 = f(first_index(y1)) = f(first_index(y2)) = y2
        by def $chap3::is_injective_fn(fn_range(f), N, first_index)
    witness $embeds_into(fn_range(f), N) from first_index
    by def $is_at_most_countable(fn_range(f))
thm countable_image_is_at_most_countable:
    ? forall X, Y set, f fn(x X) Y:
        $is_countably_infinite(X)
        =>:
            $is_at_most_countable(fn_range(f))
    $chap3::has_equal_cardinality(N, X)
    obtain enum from exist enum fn(x N) X st {$chap3::is_bijective_fn(N, X, enum)}
    $chap3::is_surjective_fn(N, X, enum)
    have fn composed_image(n N) Y = f(enum(n))
    release thm natural_image_is_at_most_countable(Y, composed_image)
    claim:
        ? fn_range(f) $subset fn_range(composed_image)
        claim:
            ? forall y fn_range(f):
                y $in fn_range(composed_image)
            have by fn_preimage: x from y $in fn_range(f)
            exist n N st {x = enum(n)}
            obtain n from exist n N st {x = enum(n)}
            composed_image(n) = f(enum(n)) = f(x) = y
            composed_image(n) $in fn_range(composed_image)
        by def fn_range(f) $subset fn_range(composed_image)
    release thm subset_of_at_most_countable_is_at_most_countable(fn_range(composed_image), fn_range(f))
thm union_of_two_countable_sets_is_countable:
    ? forall X, Y set:
        $is_countably_infinite(X)
        $is_countably_infinite(Y)
        =>:
            $is_countably_infinite(union(X, Y))
    thm odd_natural_code_has_remainder_one:
        ? forall code N:
            (2 * code + 1) % 2 = 1
        (2 * code) % 2 = 0
        (2 * code + 1) % 2 = ((2 * code) % 2 + 1 % 2) % 2 = (0 + 1) % 2 = 1
    $chap3::has_equal_cardinality(N, X)
    obtain enumX from exist enumX fn(x N) X st {$chap3::is_bijective_fn(N, X, enumX)}
    $chap3::is_injective_fn(N, X, enumX)
    release thm countably_infinite_is_at_most_countable(X)
    release thm countably_infinite_is_at_most_countable(Y)
    $embeds_into(X, N)
    $embeds_into(Y, N)
    obtain codeX from $embeds_into(X, N)
    obtain codeY from exist codeY fn(y Y) N st {$chap3::is_injective_fn(Y, N, codeY)}
    have fn extended_codeY(z union(X, Y)) N by cases:
        case z $in Y: codeY(z)
        case not z $in Y: 0
    have fn union_code(z union(X, Y)) N by cases:
        case z $in X: 2 * codeX(z)
        case not z $in X: 2 * extended_codeY(z) + 1
    claim:
        ? $chap3::is_injective_fn(union(X, Y), N, union_code)
        claim:
            ? forall z1, z2 union(X, Y):
                union_code(z1) = union_code(z2)
                =>:
                    z1 = z2
            z1 $in X or not z1 $in X
            by cases:
                ? z1 = z2
                case z1 $in X:
                    z2 $in X or not z2 $in X
                    by cases:
                        ? z1 = z2
                        case z2 $in X:
                            union_code(z1) = 2 * codeX(z1)
                            union_code(z2) = 2 * codeX(z2)
                            2 * codeX(z1) = 2 * codeX(z2)
                            codeX(z1) = (2 * codeX(z1)) / 2 = (2 * codeX(z2)) / 2 = codeX(z2)
                            z1 = z2
                        case not z2 $in X:
                            z2 $in X or z2 $in Y
                            by cases:
                                ? z2 $in Y
                                case z2 $in X:
                                    impossible z2 $in X
                                case z2 $in Y:
                                    z2 $in Y
                            extended_codeY(z2) = codeY(z2)
                            union_code(z1) = 2 * codeX(z1)
                            union_code(z2) = 2 * extended_codeY(z2) + 1 = 2 * codeY(z2) + 1
                            2 * codeX(z1) = 2 * codeY(z2) + 1
                            (2 * codeX(z1)) % 2 = 0
                            release thm odd_natural_code_has_remainder_one(codeY(z2))
                            (2 * codeY(z2) + 1) % 2 = 1
                            impossible 0 = 1
                case not z1 $in X:
                    z1 $in X or z1 $in Y
                    by cases:
                        ? z1 $in Y
                        case z1 $in X:
                            impossible z1 $in X
                        case z1 $in Y:
                            z1 $in Y
                    extended_codeY(z1) = codeY(z1)
                    z2 $in X or not z2 $in X
                    by cases:
                        ? z1 = z2
                        case z2 $in X:
                            union_code(z1) = 2 * extended_codeY(z1) + 1 = 2 * codeY(z1) + 1
                            union_code(z2) = 2 * codeX(z2)
                            2 * codeY(z1) + 1 = 2 * codeX(z2)
                            release thm odd_natural_code_has_remainder_one(codeY(z1))
                            (2 * codeY(z1) + 1) % 2 = 1
                            (2 * codeX(z2)) % 2 = 0
                            impossible 1 = 0
                        case not z2 $in X:
                            z2 $in X or z2 $in Y
                            by cases:
                                ? z2 $in Y
                                case z2 $in X:
                                    impossible z2 $in X
                                case z2 $in Y:
                                    z2 $in Y
                            extended_codeY(z2) = codeY(z2)
                            union_code(z1) = 2 * extended_codeY(z1) + 1 = 2 * codeY(z1) + 1
                            union_code(z2) = 2 * extended_codeY(z2) + 1 = 2 * codeY(z2) + 1
                            2 * codeY(z1) + 1 = 2 * codeY(z2) + 1
                            2 * codeY(z1) = (2 * codeY(z1) + 1) - 1 = (2 * codeY(z2) + 1) - 1 = 2 * codeY(z2)
                            codeY(z1) = (2 * codeY(z1)) / 2 = (2 * codeY(z2)) / 2 = codeY(z2)
                            z1 = z2
        by def $chap3::is_injective_fn(union(X, Y), N, union_code)
    witness $embeds_into(union(X, Y), N) from union_code
    by def $is_at_most_countable(union(X, Y))
    have fn embed_N(n N) union(X, Y) = enumX(n)
    claim:
        ? $chap3::is_injective_fn(N, union(X, Y), embed_N)
        forall n1, n2 N:
            embed_N(n1) = embed_N(n2)
            =>:
                embed_N(n1) = enumX(n1)
                embed_N(n2) = enumX(n2)
                enumX(n1) = enumX(n2)
                n1 = n2
        by def $chap3::is_injective_fn(N, union(X, Y), embed_N)
    witness $embeds_into(N, union(X, Y)) from embed_N
    release thm at_most_countable_with_N_embedding_is_countably_infinite(union(X, Y))
thm integers_are_countable:
    ? forall:
        $is_countably_infinite(Z)
    have fn negate_natural(n N) Z = (-n)
    have negative_natural_part set = fn_range(negate_natural)
    forall n N:
        negate_natural(n) = (-n)
        negate_natural(n) $in fn_range(negate_natural)
        (-n) $in negative_natural_part
    have fn enumerate_negative_naturals(n N) negative_natural_part = (-n)
    claim:
        ? $chap3::is_injective_fn(N, negative_natural_part, enumerate_negative_naturals)
        claim:
            ? forall n1, n2 N:
                enumerate_negative_naturals(n1) = enumerate_negative_naturals(n2)
                =>:
                    n1 = n2
            (-n1) = enumerate_negative_naturals(n1) = enumerate_negative_naturals(n2) = (-n2)
            n1 = -(-n1) = -(-n2) = n2
        by def $chap3::is_injective_fn(N, negative_natural_part, enumerate_negative_naturals)
    claim:
        ? $chap3::is_surjective_fn(N, negative_natural_part, enumerate_negative_naturals)
        claim:
            ? forall z negative_natural_part:
                exist n N st {z = enumerate_negative_naturals(n)}
            have by fn_preimage: n from z $in fn_range(negate_natural)
            z = negate_natural(n) = (-n) = enumerate_negative_naturals(n)
            witness exist k N st {z = enumerate_negative_naturals(k)} from n
        by def $chap3::is_surjective_fn(N, negative_natural_part, enumerate_negative_naturals)
    by def $chap3::is_bijective_fn(N, negative_natural_part, enumerate_negative_naturals)
    witness $chap3::has_equal_cardinality(N, negative_natural_part) from enumerate_negative_naturals
    by def $is_countably_infinite(negative_natural_part)
    fn_range(negate_natural) $subset Z
    negative_natural_part $subset Z
    claim:
        ? union(N, negative_natural_part) = Z
        by extension:
            ? union(N, negative_natural_part) = Z
            claim:
                ? forall x union(N, negative_natural_part):
                    x $in Z
                by cases:
                    ? x $in Z
                    case x $in N:
                        x $in Z
                    case x $in negative_natural_part:
                        x $in Z
            claim:
                ? forall z Z:
                    z $in union(N, negative_natural_part)
                by cases:
                    ? z $in union(N, negative_natural_part)
                    case z >= 0:
                        z $in N
                    case z < 0:
                        abs(z) $in N
                        abs(z) = -z
                        -abs(z) = -(-z) = z
                        negate_natural(abs(z)) = (-abs(z)) = z
                        negate_natural(abs(z)) $in fn_range(negate_natural)
                        z $in negative_natural_part
    release thm union_of_two_countable_sets_is_countable(N, negative_natural_part)
have natural_triangle set = {p cart(N, N): p(2) <= p(1)}
natural_triangle = {p cart(N, N): p(2) <= p(1)}
forall p natural_triangle:
    p $in natural_triangle
    p $in {q cart(N, N): q(2) <= q(1)}
    p $in cart(N, N)
release obj def chap4::integer_quotient
thm consecutive_product_is_even:
    ? forall n N:
        exist r N st {n * (n + 1) = 2 * r}
    n % 2 = 0 or n % 2 = 1
    by cases:
        ? exist r N st {n * (n + 1) = 2 * r}
        case n % 2 = 0:
            have m Z = chap4::integer_quotient(n, 2)
            n = 2 * chap4::integer_quotient(n, 2) + n % 2 = 2 * m + n % 2 = 2 * m
            claim:
                ? m >= 0
                by contra:
                    ? m >= 0
                    m < 0
                    2 * m < 0
                    n < 0
                    impossible n >= 0
            m $in N
            witness exist r N st {n * (n + 1) = 2 * r} from m * (n + 1):
                m * (n + 1) $in N
                n * (n + 1) = (2 * m) * (n + 1) = 2 * (m * (n + 1))
        case n % 2 = 1:
            (n + 1) % 2 = ((n % 2) + (1 % 2)) % 2 = (1 + 1) % 2 = 0
            have m Z = chap4::integer_quotient(n + 1, 2)
            n + 1 = 2 * chap4::integer_quotient(n + 1, 2) + (n + 1) % 2 = 2 * m + (n + 1) % 2 = 2 * m
            claim:
                ? m >= 0
                by contra:
                    ? m >= 0
                    m < 0
                    2 * m < 0
                    n + 1 < 0
                    impossible n + 1 >= 0
            m $in N
            witness exist r N st {n * (n + 1) = 2 * r} from n * m:
                n * m $in N
                n * (n + 1) = n * (2 * m) = 2 * (n * m)
claim:
    ? forall n N:
        exist! y N st {2 * y = n * (n + 1)}
    release thm consecutive_product_is_even(n)
    obtain r from exist r N st {n * (n + 1) = 2 * r}
    claim:
        ? forall y1, y2 N:
            2 * y1 = n * (n + 1)
            2 * y2 = n * (n + 1)
            =>:
                y1 = y2
        y1 = n * (n + 1) / 2 = y2
    witness exist! y N st {2 * y = n * (n + 1)} from r
have fn tri by exist!:
    ? forall n N:
        exist! y N st {2 * y = n * (n + 1)}
2 * tri(0) = 0 * (0 + 1)
tri(0) = (2 * tri(0)) / 2 = (0 * (0 + 1)) / 2 = 0
forall n N:
    2 * tri(n + 1) = (n + 1) * ((n + 1) + 1) = (n + 1) * (n + 2)
    2 * tri(n) = n * (n + 1)
    2 * (tri(n) + n + 1) = 2 * tri(n) + 2 * n + 2 = n * (n + 1) + 2 * n + 2 = (n + 1) * (n + 2)
    tri(n + 1) = (2 * tri(n + 1)) / 2 = ((n + 1) * (n + 2)) / 2 = (2 * (tri(n) + n + 1)) / 2 = tri(n) + n + 1
prop triangular_interval(n, s N):
    tri(s) <= n < tri(s + 1)
have fn diagonal_index(u natural_triangle) N = tri(u(1)) + u(2)
forall u natural_triangle:
    diagonal_index(u) = tri(u(1)) + u(2)
claim:
    ? forall n, m N:
        m <= n
        =>:
            (n, m) $in natural_triangle
    (n, m) $in cart(N, N)
    (n, m)(2) = m
    (n, m)(1) = n
    release thm set_builder_member((n, m), {p cart(N, N): p(2) <= p(1)})
release obj def tri
claim:
    ? forall u natural_triangle:
        tri(u(1)) <= diagonal_index(u) < tri(u(1) + 1)
    u(1) $in N
    u(2) $in N
    u(2) >= 0
    u(2) <= u(1)
    2 * tri(u(1) + 1) = (u(1) + 1) * ((u(1) + 1) + 1) = (u(1) + 1) * (u(1) + 2)
    2 * tri(u(1)) = u(1) * (u(1) + 1)
    2 * (tri(u(1)) + u(1) + 1) = 2 * tri(u(1)) + 2 * u(1) + 2 = u(1) * (u(1) + 1) + 2 * u(1) + 2 = (u(1) + 1) * (u(1) + 2)
    tri(u(1) + 1) = (2 * tri(u(1) + 1)) / 2 = (2 * (tri(u(1)) + u(1) + 1)) / 2 = tri(u(1)) + u(1) + 1
    tri(u(1)) <= tri(u(1)) + u(2) = diagonal_index(u) <= tri(u(1)) + u(1) < tri(u(1)) + u(1) + 1 = tri(u(1) + 1)
claim:
    ? forall a, b N:
        a < b
        =>:
            tri(a + 1) <= tri(b)
    a + 1 <= b
    a + 1 >= 0
    b >= 0
    a + 1 + 1 <= b + 1
    a + 1 + 1 >= 0
    (a + 1) * (a + 1 + 1) <= b * (a + 1 + 1) <= b * (b + 1)
    2 * tri(a + 1) = (a + 1) * ((a + 1) + 1) <= b * (b + 1) = 2 * tri(b)
    tri(a + 1) = (2 * tri(a + 1)) / 2 <= (2 * tri(b)) / 2 = tri(b)
claim:
    ? forall u, v natural_triangle:
        u(1) < v(1)
        =>:
            diagonal_index(u) < diagonal_index(v)
    u(1) $in N
    v(1) $in N
    tri(u(1)) <= diagonal_index(u) < tri(u(1) + 1)
    tri(v(1)) <= diagonal_index(v) < tri(v(1) + 1)
    tri(u(1) + 1) <= tri(v(1))
    diagonal_index(u) < tri(u(1) + 1) <= tri(v(1)) <= diagonal_index(v)
claim:
    ? forall u, v natural_triangle:
        diagonal_index(u) = diagonal_index(v)
        =>:
            u(1) = v(1)
    u(1) $in R
    v(1) $in R
    by contra:
        ? not u(1) < v(1)
        diagonal_index(u) < diagonal_index(v)
        impossible diagonal_index(u) = diagonal_index(v)
    by contra:
        ? not v(1) < u(1)
        diagonal_index(v) < diagonal_index(u)
        impossible diagonal_index(u) = diagonal_index(v)
    u(1) >= v(1)
    v(1) >= u(1)
claim:
    ? forall u, v natural_triangle:
        u(1) = v(1)
        diagonal_index(u) = diagonal_index(v)
        =>:
            u(2) = v(2)
    diagonal_index(u) = tri(u(1)) + u(2)
    diagonal_index(v) = tri(v(1)) + v(2)
    tri(u(1)) = tri(v(1))
    u(2) = (tri(u(1)) + u(2)) - tri(u(1)) = diagonal_index(u) - tri(u(1)) = diagonal_index(v) - tri(v(1)) = (tri(v(1)) + v(2)) - tri(v(1)) = v(2)
claim:
    ? $chap3::is_injective_fn(natural_triangle, N, diagonal_index)
    claim:
        ? forall x1, x2 natural_triangle:
            diagonal_index(x1) = diagonal_index(x2)
            =>:
                x1 = x2
        x1(1) = x2(1)
        x1(2) = x2(2)
        x1 = (x1(1), x1(2)) = (x2(1), x2(2)) = x2
    by def $chap3::is_injective_fn(natural_triangle, N, diagonal_index)
claim:
    ? forall k N:
        tri(k + 1) = tri(k) + k + 1
    2 * tri(k + 1) = (k + 1) * ((k + 1) + 1)
    2 * tri(k) = k * (k + 1)
    2 * (tri(k) + k + 1) = 2 * tri(k) + 2 * k + 2 = k * (k + 1) + 2 * k + 2 = (k + 1) * (k + 2)
    2 * tri(k + 1) = (k + 1) * ((k + 1) + 1) = (k + 1) * (k + 2) = 2 * (tri(k) + k + 1)
    tri(k + 1) = (2 * tri(k + 1)) / 2 = (2 * (tri(k) + k + 1)) / 2 = tri(k) + k + 1
claim:
    ? forall n, s N:
        $triangular_interval(n, s)
        =>:
            n - tri(s) <= s
    tri(s + 1) = tri(s) + s + 1
    n - tri(s) < (tri(s) + s + 1) - tri(s) = s + 1
    n - tri(s) $in N
    n - tri(s) <= s or n - tri(s) > s
    by cases:
        ? n - tri(s) <= s
        case n - tri(s) <= s:
            n - tri(s) <= s
        case n - tri(s) > s:
            n - tri(s) >= s + 1
            impossible n - tri(s) < s + 1
claim:
    ? forall n N:
        exist s N st {$triangular_interval(n, s)}
    by induc n from 0:
        ? exist s N st {$triangular_interval(n, s)}
        ? from n = 0:
            tri(0) = 0
            tri(1) = tri(0 + 1) = tri(0) + 0 + 1 = 1
            by def $triangular_interval(0, 0)
            witness exist s N st {$triangular_interval(0, s)} from 0:
                tri(0) = 0
                0 < 1 = tri(1)
        ? induc:
            obtain s from exist s N st {$triangular_interval(n, s)}
            tri(s) <= n < tri(s + 1)
            n + 1 <= tri(s + 1)
            by cases:
                ? exist t N st {$triangular_interval(n + 1, t)}
                case n + 1 < tri(s + 1):
                    by def $triangular_interval(n + 1, s)
                    witness exist t N st {$triangular_interval(n + 1, t)} from s:
                        tri(s) <= n <= n + 1
                        n + 1 < tri(s + 1)
                case n + 1 >= tri(s + 1):
                    n + 1 = tri(s + 1)
                    tri((s + 1) + 1) = tri(s + 1) + (s + 1) + 1
                    s >= 0
                    (s + 1) + 1 > 0
                    tri(s + 1) < tri(s + 1) + ((s + 1) + 1) = tri(s + 1) + (s + 1) + 1 = tri((s + 1) + 1)
                    by def $triangular_interval(n + 1, s + 1)
                    witness exist t N st {$triangular_interval(n + 1, t)} from s + 1:
                        tri(s + 1) = n + 1
                        n + 1 < tri((s + 1) + 1)
claim:
    ? $chap3::is_surjective_fn(natural_triangle, N, diagonal_index)
    claim:
        ? forall y N:
            exist x natural_triangle st {y = diagonal_index(x)}
        obtain s from exist s N st {$triangular_interval(y, s)}
        tri(s) <= y
        y - tri(s) $in N
        have b N = y - tri(s)
        b = y - tri(s) <= s
        (s, b) $in natural_triangle
        diagonal_index((s, b)) = tri(s) + b = tri(s) + (y - tri(s)) = y
        witness exist x natural_triangle st {y = diagonal_index(x)} from (s, b)
    by def $chap3::is_surjective_fn(natural_triangle, N, diagonal_index)
claim:
    ? forall y N:
        exist! x natural_triangle st {y = diagonal_index(x)}
    obtain chosen from exist x natural_triangle st {y = diagonal_index(x)}
    claim:
        ? forall x1, x2 natural_triangle:
            y = diagonal_index(x1)
            y = diagonal_index(x2)
            =>:
                x1 = x2
        diagonal_index(x1) = y = diagonal_index(x2)
        x1 = x2
    witness exist! x natural_triangle st {y = diagonal_index(x)} from chosen
