thm builtin_index_cart_member_has_function_type:
    ? forall I nonempty_set, S nonempty_set, X fn(alpha I) S, c index_cart(I, S, X):
        c $in fn(t I)family_union(S)
thm builtin_index_cart_member_has_factor_values:
