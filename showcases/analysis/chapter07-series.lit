prop is_eventually_below(a seq(R), x R, n0 N+):
    forall n N+:
        n >= n0
        =>:
            a(n) < x
prop has_late_term_above(a seq(R), x R, n0 N+):
    exist n N+ st {n >= n0 and a(n) > x}
prop exceeds_infinitely_often(a seq(R), x R):
    forall n0 N+:
        $has_late_term_above(a, x, n0)
prop has_finite_limit_superior(a seq(R), L R):
    forall x R:
        x > L
        =>:
            exist n0 N+ st {$is_eventually_below(a, x, n0)}
    forall x R:
        x < L
        =>:
            $exceeds_infinitely_often(a, x)
have fn root_test_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {abs(a(j))^(1 / j)}
thm chapter7_nth_root_nonnegative:
    ? forall x R, n N+:
        x >= 0
        =>:
            x^(1 / n) >= 0
    release thm chap5::nth_root_nonnegative(x, n)
thm chapter7_nth_root_power_identity_nonnegative:
    ? forall x R, n N+:
        x >= 0
        =>:
            (x^(1 / n))^n = x
    release thm chap5::nth_root_power_identity_nonnegative(x, n)
thm chapter7_nth_root_le_one:
    ? forall x R, n N+:
        x >= 0
        x <= 1
        =>:
            x^(1 / n) <= 1
    thm negated_upper_bound_is_strict_lower_bound:
        ? forall value R:
            not value <= 1
            =>:
                value > 1
    by contra:
        ? x^(1 / n) <= 1
        release thm negated_upper_bound_is_strict_lower_bound(x^(1 / n))
        x^(1 / n) > 1
        release thm chapter7_nth_root_nonnegative(x, n)
        0 <= x^(1 / n)
        x^(1 / n) $in R+
        (x^(1 / n))^n $in R
        (x^(1 / n))^n > 1^n
        release thm chapter7_nth_root_power_identity_nonnegative(x, n)
        1^n = 1
        x > 1
        impossible x <= 1
thm positive_number_between_below_one:
    ? forall alpha R:
        alpha < 1
        =>:
            exist r R+ st {alpha < r and r < 1}
    alpha < 1 / 2 or alpha >= 1 / 2
    by cases:
        ? exist r R+ st {alpha < r and r < 1}
        case alpha < 1 / 2:
            witness exist r R+ st {alpha < r and r < 1} from 1 / 2:
                1 / 2 > 0
                alpha < 1 / 2
                1 / 2 < 1
        case alpha >= 1 / 2:
            alpha + 1 >= 1 / 2 + 1
            1 / 2 + 1 > 0
            alpha + 1 > 0
            2 > 0
            (alpha + 1) / 2 > 0
            witness exist r R+ st {alpha < r and r < 1} from (alpha + 1) / 2:
                (alpha + 1) / 2 > 0
                (alpha + 1) / 2 - alpha = (1 - alpha) / 2
                1 - alpha > 0
                2 > 0
                (1 - alpha) / 2 > 0
                alpha < (alpha + 1) / 2
                1 - (alpha + 1) / 2 = (1 - alpha) / 2
                1 - (alpha + 1) / 2 > 0
                (alpha + 1) / 2 < 1
thm root_test_tail_bound_by_geometric:
    ? forall a seq(R), r R+, n0 N+:
        $is_eventually_below(root_test_terms(a), r, n0)
        =>:
            $is_eventually_abs_bounded_by(a, geometric_series_terms_from_one(r), n0)
    claim:
        ? forall n N+:
            n >= n0
            =>:
                abs(a(n)) <= geometric_series_terms_from_one(r)(n)
        root_test_terms(a)(n) < r
        root_test_terms(a)(n) = abs(a(n))^(1 / n)
        abs(a(n))^(1 / n) < r
        abs(a(n)) >= 0
        release thm chapter7_nth_root_nonnegative(abs(a(n)), n)
        0 <= abs(a(n))^(1 / n)
        release thm chapter7_nth_root_power_identity_nonnegative(abs(a(n)), n)
        (abs(a(n))^(1 / n))^n $in R
        (abs(a(n))^(1 / n))^n < r^n
        abs(a(n)) <= r^n
        geometric_series_terms_from_one(r)(n) = r^n
    by def $is_eventually_abs_bounded_by(a, geometric_series_terms_from_one(r), n0)
thm root_test_absolute_convergence:
    ? forall a seq(R), alpha R:
        $has_finite_limit_superior(root_test_terms(a), alpha)
        alpha < 1
        =>:
            $is_absolutely_convergent_series(a)
    release thm positive_number_between_below_one(alpha)
    obtain r from exist r R+ st {alpha < r and r < 1}
    obtain n0 from exist n0 N+ st {$is_eventually_below(root_test_terms(a), r, n0)}
    release thm root_test_tail_bound_by_geometric(a, r, n0)
    abs(r) = r
    abs(r) < 1
    1 - r > 0
    1 - r != 0
    release thm geometric_series_from_one_formula(r)
    witness $is_convergent_series(geometric_series_terms_from_one(r)) from r / (1 - r):
        $has_series_sum(geometric_series_terms_from_one(r), r / (1 - r))
    $is_convergent_series(geometric_series_terms_from_one(r))
    release thm eventual_comparison_test_for_series(a, geometric_series_terms_from_one(r), n0)
thm root_test_divergence:
    ? forall a seq(R), alpha R:
        $has_finite_limit_superior(root_test_terms(a), alpha)
        alpha > 1
        =>:
            not $is_convergent_series(a)
    by contra:
        ? not $is_convergent_series(a)
        $is_convergent_series(a)
        release thm series_zero_test(a)
        1 < alpha
        $exceeds_infinitely_often(root_test_terms(a), 1)
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, 1, n0)}
        $has_late_term_above(root_test_terms(a), 1, n0)
        obtain n from $has_late_term_above(root_test_terms(a), 1, n0)
        abs(a(n) - 0) <= 1
        root_test_terms(a)(n) = abs(a(n))^(1 / n)
        abs(a(n) - 0) = abs(a(n))
        abs(a(n)) <= 1
        abs(a(n)) >= 0
        release thm chapter7_nth_root_le_one(abs(a(n)), n)
        root_test_terms(a)(n) <= 1
        impossible root_test_terms(a)(n) > 1
prop is_eventually_above(a seq(R), y R, n0 N+):
    forall n N+:
        n >= n0
        =>:
            a(n) > y
prop has_late_term_below(a seq(R), y R, n0 N+):
    exist n N+ st {n >= n0 and a(n) < y}
prop falls_infinitely_often(a seq(R), y R):
    forall n0 N+:
        $has_late_term_below(a, y, n0)
prop has_finite_limit_inferior(a seq(R), L R):
    forall y R:
        y < L
        =>:
            exist n0 N+ st {$is_eventually_above(a, y, n0)}
    forall y R:
        y > L
        =>:
            $falls_infinitely_often(a, y)
prop pointwise_equal_sequences(a, b seq(R)):
    forall n N+:
        a(n) = b(n)
thm finite_limsup_extensional:
    ? forall a, b seq(R), L R:
        $pointwise_equal_sequences(a, b)
        $has_finite_limit_superior(a, L)
        =>:
            $has_finite_limit_superior(b, L)
    claim:
        ? forall x R:
            x > L
            =>:
                exist n0 N+ st {$is_eventually_below(b, x, n0)}
        obtain n0 from exist n0 N+ st {$is_eventually_below(a, x, n0)}
        witness exist n1 N+ st {$is_eventually_below(b, x, n1)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        b(n) < x
                a(n) < x
                a(n) = b(n)
            by def $is_eventually_below(b, x, n0)
            $is_eventually_below(b, x, n0)
    claim:
        ? forall x R:
            x < L
            =>:
                $exceeds_infinitely_often(b, x)
        $exceeds_infinitely_often(a, x)
        claim:
            ? forall n0 N+:
                $has_late_term_above(b, x, n0)
            $has_late_term_above(a, x, n0)
            obtain n from $has_late_term_above(a, x, n0)
            witness $has_late_term_above(b, x, n0) from n:
                n >= n0 and a(n) > x
                n >= n0
                a(n) > x
                a(n) = b(n)
                b(n) > x
                n >= n0 and b(n) > x
        by def $exceeds_infinitely_often(b, x)
    by def $has_finite_limit_superior(b, L)
thm finite_liminf_extensional:
    ? forall a, b seq(R), L R:
        $pointwise_equal_sequences(a, b)
        $has_finite_limit_inferior(a, L)
        =>:
            $has_finite_limit_inferior(b, L)
    claim:
        ? forall y R:
            y < L
            =>:
                exist n0 N+ st {$is_eventually_above(b, y, n0)}
        obtain n0 from exist n0 N+ st {$is_eventually_above(a, y, n0)}
        witness exist n1 N+ st {$is_eventually_above(b, y, n1)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        b(n) > y
                a(n) > y
                a(n) = b(n)
            by def $is_eventually_above(b, y, n0)
            $is_eventually_above(b, y, n0)
    claim:
        ? forall y R:
            y > L
            =>:
                $falls_infinitely_often(b, y)
        $falls_infinitely_often(a, y)
        claim:
            ? forall n0 N+:
                $has_late_term_below(b, y, n0)
            $has_late_term_below(a, y, n0)
            obtain n from $has_late_term_below(a, y, n0)
            witness $has_late_term_below(b, y, n0) from n:
                n >= n0 and a(n) < y
                n >= n0
                a(n) < y
                a(n) = b(n)
                b(n) < y
                n >= n0 and b(n) < y
        by def $falls_infinitely_often(b, y)
    by def $has_finite_limit_inferior(b, L)
thm pointwise_equal_sequences_symmetric:
    ? forall a, b seq(R):
        $pointwise_equal_sequences(a, b)
        =>:
            $pointwise_equal_sequences(b, a)
    forall n N+:
        a(n) = b(n)
        b(n) = a(n)
    by def $pointwise_equal_sequences(b, a)
thm has_limit_extensional:
    ? forall a, b seq(R), L R:
        $pointwise_equal_sequences(a, b)
        $has_limit(a, L)
        =>:
            $has_limit(b, L)
    release thm closed_limit_implies_strict_limit(a, L)
    release thm strict_limit_extensional(a, b, L)
    release thm strict_limit_implies_closed_limit(b, L)
prop is_positive_sequence(c seq(R)):
    forall n N+:
        c(n) > 0
claim:
    ? forall c seq(R), k N+:
        $is_positive_sequence(c)
        =>:
            c(k) != 0
            k + 1 $in N+
    c(k) > 0
    c(k) != 0
    k + 1 $in N+
have fn ratio_terms(c seq(R): $is_positive_sequence(c)) fn(i_index N+) R = fn(k N+) R {c(k + 1) / c(k)}
thm ratio_terms_apply:
    ? forall c seq(R), k N+:
        $is_positive_sequence(c)
        =>:
            ratio_terms(c)(k) = c(k + 1) / c(k)
    c(k) > 0
    c(k) != 0
    k + 1 $in N+
thm eventual_ratio_upper_product_bound:
    ? forall c seq(R), r R+, n0 N+, h N:
        n0 + h $in N+
        $is_positive_sequence(c)
        $is_eventually_below(ratio_terms(c), r, n0)
        =>:
            c(n0 + h) <= c(n0) * r^h
    by induc h from 0:
        ? c(n0 + h) <= c(n0) * r^h
        ? from h = 0:
            n0 + 0 = n0
            r^0 = 1
            c(n0 + 0) = c(n0) = c(n0) * 1 = c(n0) * r^0
        ? induc:
            n0 + h $in N+
            n0 + h >= n0
            n0 + h + 1 $in N+
            ratio_terms(c)(n0 + h) < r
            c(n0 + h) > 0
            c(n0 + h) != 0
            by thm ratio_terms_apply(c, n0 + h) => ratio_terms(c)(n0 + h) = c(n0 + h + 1) / c(n0 + h)
            c(n0 + h + 1) / c(n0 + h) < r
            c(n0 + h + 1) = (c(n0 + h + 1) / c(n0 + h)) * c(n0 + h) < r * c(n0 + h)
            r > 0
            n0 + (h + 1) = n0 + h + 1
            c(n0 + (h + 1)) = c(n0 + h + 1) < r * c(n0 + h) <= r * (c(n0) * r^h) = c(n0) * (r^h * r) = c(n0) * r^(h + 1)
thm eventual_ratio_lower_product_bound:
    ? forall c seq(R), r R+, n0 N+, h N:
        n0 + h $in N+
        $is_positive_sequence(c)
        $is_eventually_above(ratio_terms(c), r, n0)
        =>:
            c(n0 + h) >= c(n0) * r^h
    by induc h from 0:
        ? c(n0 + h) >= c(n0) * r^h
        ? from h = 0:
            n0 + 0 = n0
            r^0 = 1
            c(n0 + 0) = c(n0) = c(n0) * 1 = c(n0) * r^0
        ? induc:
            n0 + h $in N+
            n0 + h >= n0
            n0 + h + 1 $in N+
            ratio_terms(c)(n0 + h) > r
            c(n0 + h) > 0
            c(n0 + h) != 0
            by thm ratio_terms_apply(c, n0 + h) => ratio_terms(c)(n0 + h) = c(n0 + h + 1) / c(n0 + h)
            c(n0 + h + 1) / c(n0 + h) > r
            c(n0 + h + 1) = (c(n0 + h + 1) / c(n0 + h)) * c(n0 + h) > r * c(n0 + h)
            r > 0
            n0 + (h + 1) = n0 + h + 1
            c(n0 + (h + 1)) = c(n0 + h + 1) > r * c(n0 + h) >= r * (c(n0) * r^h) = c(n0) * (r^h * r) = c(n0) * r^(h + 1)
release obj def chap6::geom_seq
thm positive_root_test_term_nonnegative:
    ? forall c seq(R), n N+:
        $is_positive_sequence(c)
        =>:
            root_test_terms(c)(n) >= 0
    c(n) > 0
    c(n) $in R+
    abs(c(n)) = c(n)
    root_test_terms(c)(n) = abs(c(n))^(1 / n) = c(n)^(1 / n)
    c(n)^(1 / n) > 0
    root_test_terms(c)(n) > 0
thm eventual_ratio_upper_bound_gives_eventual_root_upper_bound:
    ? forall c seq(R), r, s R+, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_below(ratio_terms(c), r, n0)
        r < s
        =>:
            exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)}
    r > 0
    s^n0 > 0
    s^n0 != 0
    have y R = s / r
    r / r < s / r
    y = s / r > r / r = 1
    y > 1
    have B R = c(n0) / s^n0
    release thm chap6::geometric_base_gt_one_eventually_exceeds_threshold(y, B)
    obtain H from exist H N+ st {$chap6::is_eventually_above_threshold(chap6::geom_seq(y), B, H)}
    witness exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)} from n0 + H:
        claim:
            ? forall n N+:
                n >= n0 + H
                =>:
                    root_test_terms(c)(n) < s
            n - n0 >= (n0 + H) - n0 = H > 0
            n - n0 $in N+
            have h N+ = n - n0
            h = n - n0
            n0 + h = n0 + (n - n0) = n
            h = n - n0 >= H
            chap6::geom_seq(y)(h) > B
            by thm chap6::geom_seq_value(y, h) => chap6::geom_seq(y)(h) = y^h
            y^h > B
            r != 0
            r^h > 0
            r^h != 0
            1 / r = r^(-1)
            s / r = s * r^(-1)
            y^h = (s / r)^h = (s * r^(-1))^h = s^h * (r^(-1))^h
            (r^(-1))^h = r^((-1) * h) = r^(-h) = 1 / r^h
            y^h = s^h * (1 / r^h) = s^h / r^h
            r^h > 0
            s^n0 > 0
            s^h / r^h > B
            (s^h / r^h) * s^n0 > B * s^n0
            ((s^h / r^h) * s^n0) * r^h > (B * s^n0) * r^h
            B = c(n0) / s^n0
            s^n0 * s^h = ((s^h / r^h) * s^n0) * r^h > (B * s^n0) * r^h = ((c(n0) / s^n0) * s^n0) * r^h = c(n0) * r^h
            c(n0) * r^h < s^n0 * s^h
            s^n0 * s^h = s^(n0 + h) = s^n
            n0 + h $in N+
            release thm eventual_ratio_upper_product_bound(c, r, n0, h)
            c(n) = c(n0 + h) <= c(n0) * r^h < s^n0 * s^h = s^(n0 + h) = s^n
            c(n) > 0
            c(n) $in R+
            abs(c(n)) = c(n)
            root_test_terms(c)(n) = abs(c(n))^(1 / n) = c(n)^(1 / n)
            by thm chap5::positive_real_power_power_law(c(n), 1 / n, n) => (c(n)^(1 / n))^n = c(n)^((1 / n) * n)
            (1 / n) * n = 1
            (root_test_terms(c)(n))^n = (c(n)^(1 / n))^n = c(n)^((1 / n) * n) = c(n)^1 = c(n)
            root_test_terms(c)(n) >= 0
            release thm chap6::nonnegative_power_lt_implies_lt(root_test_terms(c)(n), s, n)
        by def $is_eventually_below(root_test_terms(c), s, n0 + H)
thm eventual_ratio_lower_bound_gives_eventual_root_lower_bound:
    ? forall c seq(R), r, s R+, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_above(ratio_terms(c), r, n0)
        s < r
        =>:
            exist n1 N+ st {$is_eventually_above(root_test_terms(c), s, n1)}
    s > 0
    c(n0) > 0
    c(n0) != 0
    have y R = r / s
    s / s < r / s
    y = r / s > s / s = 1
    y > 1
    have B R = s^n0 / c(n0)
    release thm chap6::geometric_base_gt_one_eventually_exceeds_threshold(y, B)
    obtain H from exist H N+ st {$chap6::is_eventually_above_threshold(chap6::geom_seq(y), B, H)}
    witness exist n1 N+ st {$is_eventually_above(root_test_terms(c), s, n1)} from n0 + H:
        claim:
            ? forall n N+:
                n >= n0 + H
                =>:
                    root_test_terms(c)(n) > s
            n - n0 >= (n0 + H) - n0 = H > 0
            n - n0 $in N+
            have h N+ = n - n0
            h = n - n0
            n0 + h = n0 + (n - n0) = n
            h = n - n0 >= H
            chap6::geom_seq(y)(h) > B
            by thm chap6::geom_seq_value(y, h) => chap6::geom_seq(y)(h) = y^h
            y^h > B
            s != 0
            s^h > 0
            s^h != 0
            1 / s = s^(-1)
            r / s = r * s^(-1)
            y^h = (r / s)^h = (r * s^(-1))^h = r^h * (s^(-1))^h
            (s^(-1))^h = s^((-1) * h) = s^(-h) = 1 / s^h
            y^h = r^h * (1 / s^h) = r^h / s^h
            r^h / s^h > B
            (r^h / s^h) * c(n0) > B * c(n0)
            ((r^h / s^h) * c(n0)) * s^h > (B * c(n0)) * s^h
            B = s^n0 / c(n0)
            c(n0) * r^h = ((r^h / s^h) * c(n0)) * s^h > (B * c(n0)) * s^h = ((s^n0 / c(n0)) * c(n0)) * s^h = s^n0 * s^h
            s^n0 * s^h = s^(n0 + h) = s^n
            n0 + h $in N+
            release thm eventual_ratio_lower_product_bound(c, r, n0, h)
            c(n) = c(n0 + h) >= c(n0) * r^h > s^n0 * s^h = s^(n0 + h) = s^n
            c(n) > 0
            c(n) $in R+
            abs(c(n)) = c(n)
            root_test_terms(c)(n) = abs(c(n))^(1 / n) = c(n)^(1 / n)
            by thm chap5::positive_real_power_power_law(c(n), 1 / n, n) => (c(n)^(1 / n))^n = c(n)^((1 / n) * n)
            (1 / n) * n = 1
            (root_test_terms(c)(n))^n = (c(n)^(1 / n))^n = c(n)^((1 / n) * n) = c(n)^1 = c(n)
            root_test_terms(c)(n) >= 0
            s >= 0
            s^n < (root_test_terms(c)(n))^n
            release thm chap6::nonnegative_power_lt_implies_lt(s, root_test_terms(c)(n), n)
        by def $is_eventually_above(root_test_terms(c), s, n0 + H)
thm eventual_ratio_upper_bound_gives_root_limsup_bound:
    ? forall c seq(R), r, A R, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_below(ratio_terms(c), r, n0)
        $has_finite_limit_superior(root_test_terms(c), A)
        =>:
            A <= r
    n0 + 1 $in N+
    c(n0) > 0
    c(n0 + 1) > 0
    c(n0) != 0
    by thm ratio_terms_apply(c, n0) => ratio_terms(c)(n0) = c(n0 + 1) / c(n0)
    0 = 0 / c(n0) < c(n0 + 1) / c(n0) = ratio_terms(c)(n0) < r
    r $in R+
    by contra:
        ? A <= r
        A > r
        have s R = (A + r) / 2
        A / 2 > r / 2
        A / 2 + r / 2 > r / 2 + r / 2 = r
        s = (A + r) / 2 = A / 2 + r / 2 > r
        A = A / 2 + A / 2 > A / 2 + r / 2 = s
        s > r > 0
        s $in R+
        release thm eventual_ratio_upper_bound_gives_eventual_root_upper_bound(c, r, s, n0)
        obtain n1 from exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)}
        $exceeds_infinitely_often(root_test_terms(c), s)
        $has_late_term_above(root_test_terms(c), s, n1)
        obtain n from exist n N+ st {n >= n1 and root_test_terms(c)(n) > s}
        root_test_terms(c)(n) < s
        impossible root_test_terms(c)(n) > s
thm eventual_ratio_lower_bound_gives_root_liminf_bound:
    ? forall c seq(R), r, A R, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_above(ratio_terms(c), r, n0)
        $has_finite_limit_inferior(root_test_terms(c), A)
        =>:
            r <= A
    claim:
        ? A >= 0
        by contra:
            ? A >= 0
            A < 0
            have z R = A / 2
            A / 2 < 0
            z = A / 2
            A = A / 2 + A / 2 < 0 + A / 2 = A / 2 = z
            z = A / 2 < 0
            $falls_infinitely_often(root_test_terms(c), z)
            $has_late_term_below(root_test_terms(c), z, 1)
            obtain n from exist n N+ st {n >= 1 and root_test_terms(c)(n) < z}
            release thm positive_root_test_term_nonnegative(c, n)
            root_test_terms(c)(n) < z < 0
            impossible root_test_terms(c)(n) >= 0
    by contra:
        ? r <= A
        r > A
        r > A >= 0
        r $in R+
        have s R = (r + A) / 2
        r / 2 > A / 2
        r / 2 + A / 2 > A / 2 + A / 2 = A
        s = (r + A) / 2 = r / 2 + A / 2 > A
        r = r / 2 + r / 2 > r / 2 + A / 2 = s
        s > A >= 0
        s $in R+
        release thm eventual_ratio_lower_bound_gives_eventual_root_lower_bound(c, r, s, n0)
        obtain n1 from exist n1 N+ st {$is_eventually_above(root_test_terms(c), s, n1)}
        $falls_infinitely_often(root_test_terms(c), s)
        $has_late_term_below(root_test_terms(c), s, n1)
        obtain n from exist n N+ st {n >= n1 and root_test_terms(c)(n) < s}
        root_test_terms(c)(n) > s
        impossible root_test_terms(c)(n) < s
thm eventually_upper_bounded_positive_root_terms_are_bounded:
    ? forall c seq(R), s R+, n0 N+:
        $is_positive_sequence(c)
        $is_eventually_below(root_test_terms(c), s, n0)
        =>:
            $chap6::is_bounded_sequence(root_test_terms(c))
    release obj def chap6::prefix_bound
    root_test_terms(c) $in seq(R)
    n0 $in N
    chap6::prefix_bound(root_test_terms(c), n0) $in R
    have P R = chap6::prefix_bound(root_test_terms(c), n0)
    have M R = abs(P) + s
    abs(P) >= 0
    s > 0
    M = abs(P) + s > 0
    P <= abs(P)
    abs(P) <= abs(P) + s = M
    s <= abs(P) + s = M
    release thm chap6::finite_prefix_bound_specification(root_test_terms(c), n0)
    claim:
        ? forall n N+:
            abs(root_test_terms(c)(n)) <= M
        c(n) > 0
        abs(c(n)) = c(n)
        root_test_terms(c)(n) = c(n)^(1 / n)
        c(n)^(1 / n) > 0
        root_test_terms(c)(n) > 0
        abs(root_test_terms(c)(n)) = root_test_terms(c)(n)
        n <= n0 or n > n0
        by cases:
            ? abs(root_test_terms(c)(n)) <= M
            case n <= n0:
                abs(root_test_terms(c)(n)) <= P
                abs(root_test_terms(c)(n)) <= P <= abs(P) <= M
            case n > n0:
                n >= n0
                root_test_terms(c)(n) < s
                abs(root_test_terms(c)(n)) = root_test_terms(c)(n) < s <= M
    by def $chap6::is_bounded_by(root_test_terms(c), M)
    witness $chap6::is_bounded_sequence(root_test_terms(c)) from M
thm chapter6_finite_limsup_gives_chapter7_finite_limsup:
    ? forall a seq(R), L R:
        $chap6::has_finite_limit_superior(a, L)
        =>:
            $has_finite_limit_superior(a, L)
    $chap6::is_eventually_below_every_threshold_above(a, L)
    $chap6::exceeds_every_threshold_below_arbitrarily_late(a, L)
    claim:
        ? forall x R:
            x > L
            =>:
                exist n0 N+ st {$is_eventually_below(a, x, n0)}
        obtain cutoff from exist cutoff N+ st {$chap6::is_eventually_below_threshold(a, x, cutoff)}
        by def $chap6::is_eventually_below_threshold(a, x, cutoff)
        claim:
            ? forall n N+:
                n >= cutoff
                =>:
                    a(n) < x
            a(n) < x
        by def $is_eventually_below(a, x, cutoff)
        witness exist chosen N+ st {$is_eventually_below(a, x, chosen)} from cutoff
    claim:
        ? forall x R:
            x < L
            =>:
                $exceeds_infinitely_often(a, x)
        $chap6::exceeds_threshold_arbitrarily_late(a, x)
        by def $chap6::exceeds_threshold_arbitrarily_late(a, x)
        claim:
            ? forall cutoff N+:
                $has_late_term_above(a, x, cutoff)
            obtain index from exist index N+ st {index >= cutoff and x < a(index)}
            a(index) > x
            witness exist chosen N+ st {chosen >= cutoff and a(chosen) > x} from index
            by def $has_late_term_above(a, x, cutoff)
        by def $exceeds_infinitely_often(a, x)
    by def $has_finite_limit_superior(a, L)
thm bounded_sequence_has_chapter7_finite_limsup:
    ? forall a seq(R):
        $chap6::is_bounded_sequence(a)
        =>:
            exist L R st {$has_finite_limit_superior(a, L)}
    release thm chap6::bounded_sequence_has_finite_limsup(a)
    obtain L from exist L R st {$chap6::has_finite_limit_superior(a, L)}
    release thm chapter6_finite_limsup_gives_chapter7_finite_limsup(a, L)
    witness exist L0 R st {$has_finite_limit_superior(a, L0)} from L
thm ratio_limsup_bounds_root_limsup:
    ? forall c seq(R), L, A R:
        $is_positive_sequence(c)
        $has_finite_limit_superior(ratio_terms(c), L)
        $has_finite_limit_superior(root_test_terms(c), A)
        =>:
            A <= L
    by contra:
        ? A <= L
        A > L
        have mid R = (A + L) / 2
        mid - L = (A + L) / 2 - L
        (A + L) / 2 - L = (A - L) / 2
        A - L > 0
        2 > 0
        (A - L) / 2 > 0
        L < mid
        A - mid = A - (A + L) / 2
        A - (A + L) / 2 = (A - L) / 2
        A - mid > 0
        mid < A
        mid > L
        obtain n0 from exist n0 N+ st {$is_eventually_below(ratio_terms(c), mid, n0)}
        release thm eventual_ratio_upper_bound_gives_root_limsup_bound(c, mid, A, n0)
        impossible mid < A
thm ratio_liminf_bounds_root_liminf:
    ? forall c seq(R), L, A R:
        $is_positive_sequence(c)
        $has_finite_limit_inferior(ratio_terms(c), L)
        $has_finite_limit_inferior(root_test_terms(c), A)
        =>:
            L <= A
    by contra:
        ? L <= A
        L > A
        have mid R = (L + A) / 2
        mid - A = (L + A) / 2 - A
        (L + A) / 2 - A = (L - A) / 2
        L - A > 0
        2 > 0
        (L - A) / 2 > 0
        A < mid
        L - mid = L - (L + A) / 2
        L - (L + A) / 2 = (L - A) / 2
        L - mid > 0
        mid < L
        obtain n0 from exist n0 N+ st {$is_eventually_above(ratio_terms(c), mid, n0)}
        release thm eventual_ratio_lower_bound_gives_root_liminf_bound(c, mid, A, n0)
        impossible A < mid
thm ratio_limsup_less_than_one_gives_root_limsup_below_one:
    ? forall c seq(R), alpha R:
        $is_positive_sequence(c)
        $has_finite_limit_superior(ratio_terms(c), alpha)
        alpha < 1
        =>:
            exist gamma R st {$has_finite_limit_superior(root_test_terms(c), gamma) and gamma < 1}
    release thm positive_number_between_below_one(alpha)
    obtain r from exist r R+ st {alpha < r and r < 1}
    obtain n0 from exist n0 N+ st {$is_eventually_below(ratio_terms(c), r, n0)}
    release thm positive_number_between_below_one(r)
    obtain s from exist s R+ st {r < s and s < 1}
    release thm eventual_ratio_upper_bound_gives_eventual_root_upper_bound(c, r, s, n0)
    obtain n1 from exist n1 N+ st {$is_eventually_below(root_test_terms(c), s, n1)}
    release thm eventually_upper_bounded_positive_root_terms_are_bounded(c, s, n1)
    release thm bounded_sequence_has_chapter7_finite_limsup(root_test_terms(c))
    obtain gamma from exist gamma R st {$has_finite_limit_superior(root_test_terms(c), gamma)}
    release thm eventual_ratio_upper_bound_gives_root_limsup_bound(c, r, gamma, n0)
    gamma <= r < 1
    witness exist gamma0 R st {$has_finite_limit_superior(root_test_terms(c), gamma0) and gamma0 < 1} from gamma
thm ratio_liminf_greater_than_one_gives_failure_of_zero_limit:
    ? forall c seq(R), beta R:
        $is_positive_sequence(c)
        $has_finite_limit_inferior(ratio_terms(c), beta)
        beta > 1
        =>:
            not $has_limit(c, 0)
    have r R = (beta + 1) / 2
    beta / 2 > 1 / 2
    r = (beta + 1) / 2 = beta / 2 + 1 / 2 > 1 / 2 + 1 / 2 = 1
    beta = beta / 2 + beta / 2 > beta / 2 + 1 / 2 = r
    r > 1 > 0
    r $in R+
    obtain n0 from exist n0 N+ st {$is_eventually_above(ratio_terms(c), r, n0)}
    have s R = (r + 1) / 2
    r / 2 > 1 / 2
    s = (r + 1) / 2 = r / 2 + 1 / 2 > 1 / 2 + 1 / 2 = 1
    r = r / 2 + r / 2 > r / 2 + 1 / 2 = s
    s > 1 > 0
    s $in R+
    release thm eventual_ratio_lower_bound_gives_eventual_root_lower_bound(c, r, s, n0)
    obtain n1 from exist n1 N+ st {$is_eventually_above(root_test_terms(c), s, n1)}
    by contra:
        ? not $has_limit(c, 0)
        $has_limit(c, 0)
        obtain N0 from exist N0 N+ st {$is_tail_close_to(c, 0, 1, N0)}
        have n N+ = N0 + n1
        n >= N0
        n >= n1
        root_test_terms(c)(n) > s > 1
        c(n) > 0
        c(n) $in R+
        abs(c(n)) = c(n)
        root_test_terms(c)(n) = abs(c(n))^(1 / n) = c(n)^(1 / n)
        by thm chap5::positive_real_power_power_law(c(n), 1 / n, n) => (c(n)^(1 / n))^n = c(n)^((1 / n) * n)
        (1 / n) * n = 1
        (root_test_terms(c)(n))^n = (c(n)^(1 / n))^n = c(n)^((1 / n) * n) = c(n)^1 = c(n)
        release thm chap6::positive_power_gt_one(root_test_terms(c)(n), n)
        c(n) = (root_test_terms(c)(n))^n > 1
        abs(c(n) - 0) <= 1
        abs(c(n) - 0) = abs(c(n)) = c(n) > 1
        impossible abs(c(n) - 0) <= 1
prop has_no_zero_terms(a seq(R)):
    forall n N+:
        a(n) != 0
prop is_absolute_ratio_sequence(a, b seq(R)):
    forall n N+:
        a(n) != 0
        =>:
            b(n) = abs(a(n + 1)) / abs(a(n))
have fn absolute_value_sequence(a seq(R)) fn(i_index N+) R = fn(j N+) R {abs(a(j))}
thm abs_sequence_positive_from_no_zero_terms:
    ? forall a seq(R):
        $has_no_zero_terms(a)
        =>:
            $is_positive_sequence(absolute_value_sequence(a))
    claim:
        ? forall n N+:
            absolute_value_sequence(a)(n) > 0
        a(n) != 0
        abs(a(n)) > 0
        absolute_value_sequence(a)(n) = abs(a(n))
        absolute_value_sequence(a)(n) > 0
    by def $is_positive_sequence(absolute_value_sequence(a))
thm absolute_value_sequence_has_zero_limit:
    ? forall a seq(R):
        $has_limit(a, 0)
        =>:
            $has_limit(absolute_value_sequence(a), 0)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n1)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(absolute_value_sequence(a)(n) - 0) <= epsilon
                absolute_value_sequence(a)(n) = abs(a(n))
                abs(a(n)) >= 0
                abs(abs(a(n))) = abs(a(n))
                absolute_value_sequence(a)(n) - 0 = abs(a(n)) - 0
                abs(a(n)) - 0 = abs(a(n))
                absolute_value_sequence(a)(n) - 0 = abs(a(n))
                abs(absolute_value_sequence(a)(n) - 0) = abs(abs(a(n)))
                a(n) - 0 = a(n)
                abs(a(n) - 0) = abs(a(n))
                abs(absolute_value_sequence(a)(n) - 0) = abs(abs(a(n))) = abs(a(n)) = abs(a(n) - 0) <= epsilon
            by def $is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n0)
            $is_tail_close_to(absolute_value_sequence(a), 0, epsilon, n0)
    by def $has_limit(absolute_value_sequence(a), 0)
thm root_test_terms_match_absolute_value_sequence:
    ? forall a seq(R):
        $pointwise_equal_sequences(root_test_terms(a), root_test_terms(absolute_value_sequence(a)))
    claim:
        ? forall n N+:
            root_test_terms(a)(n) = root_test_terms(absolute_value_sequence(a))(n)
        root_test_terms(a)(n) = abs(a(n))^(1 / n)
        root_test_terms(absolute_value_sequence(a))(n) = abs(absolute_value_sequence(a)(n))^(1 / n)
        absolute_value_sequence(a)(n) = abs(a(n))
        abs(absolute_value_sequence(a)(n)) = abs(abs(a(n)))
        abs(a(n)) >= 0
        abs(abs(a(n))) = abs(a(n))
        abs(abs(a(n)))^(1 / n) = abs(a(n))^(1 / n)
        root_test_terms(absolute_value_sequence(a))(n) = abs(absolute_value_sequence(a)(n))^(1 / n) = abs(abs(a(n)))^(1 / n) = abs(a(n))^(1 / n)
        root_test_terms(absolute_value_sequence(a))(n) = abs(a(n))^(1 / n)
    by def $pointwise_equal_sequences(root_test_terms(a), root_test_terms(absolute_value_sequence(a)))
thm ratio_test_absolute_convergence:
    ? forall a, rho seq(R), alpha R:
        $has_no_zero_terms(a)
        $is_absolute_ratio_sequence(a, rho)
        $has_finite_limit_superior(rho, alpha)
        alpha < 1
        =>:
            $is_absolutely_convergent_series(a)
    release obj def ratio_terms
    release obj def absolute_value_sequence
    release obj def root_test_terms
    release thm abs_sequence_positive_from_no_zero_terms(a)
    release thm fn_set_member(absolute_value_sequence(a), seq(R))
    release thm fn_set_member(ratio_terms(absolute_value_sequence(a)), seq(R))
    claim:
        ? $pointwise_equal_sequences(rho, ratio_terms(absolute_value_sequence(a)))
        claim:
            ? forall n N+:
                rho(n) = ratio_terms(absolute_value_sequence(a))(n)
            a(n) != 0
            abs(a(n)) > 0
            abs(a(n)) != 0
            n + 1 $in N+
            absolute_value_sequence(a)(n) = abs(a(n))
            absolute_value_sequence(a)(n + 1) = abs(a(n + 1))
            absolute_value_sequence(a)(n) > 0
            absolute_value_sequence(a)(n) != 0
            rho(n) = abs(a(n + 1)) / abs(a(n))
            by thm ratio_terms_apply(absolute_value_sequence(a), n) => ratio_terms(absolute_value_sequence(a))(n) = absolute_value_sequence(a)(n + 1) / absolute_value_sequence(a)(n)
            rho(n) = abs(a(n + 1)) / abs(a(n)) = absolute_value_sequence(a)(n + 1) / absolute_value_sequence(a)(n) = ratio_terms(absolute_value_sequence(a))(n)
        by def $pointwise_equal_sequences(rho, ratio_terms(absolute_value_sequence(a)))
    release thm finite_limsup_extensional(rho, ratio_terms(absolute_value_sequence(a)), alpha)
    release thm ratio_limsup_less_than_one_gives_root_limsup_below_one(absolute_value_sequence(a), alpha)
    obtain gamma from exist gamma R st {$has_finite_limit_superior(root_test_terms(absolute_value_sequence(a)), gamma) and gamma < 1}
    release thm root_test_terms_match_absolute_value_sequence(a)
    release thm pointwise_equal_sequences_symmetric(root_test_terms(a), root_test_terms(absolute_value_sequence(a)))
    release thm finite_limsup_extensional(root_test_terms(absolute_value_sequence(a)), root_test_terms(a), gamma)
    release thm root_test_absolute_convergence(a, gamma)
thm ratio_test_divergence:
    ? forall a, rho seq(R), beta R:
        $has_no_zero_terms(a)
        $is_absolute_ratio_sequence(a, rho)
        $has_finite_limit_inferior(rho, beta)
        beta > 1
        =>:
            not $is_convergent_series(a)
    have c seq(R) = fn(k N+) R {abs(a(k))}
    claim:
        ? $is_positive_sequence(c)
        claim:
            ? forall n N+:
                c(n) > 0
            a(n) != 0
            abs(a(n)) > 0
            c(n) = (fn(k N+) R {abs(a(k))})(n) = abs(a(n)) > 0
        by def $is_positive_sequence(c)
    claim:
        ? $pointwise_equal_sequences(rho, ratio_terms(c))
        claim:
            ? forall n N+:
                rho(n) = ratio_terms(c)(n)
            a(n) != 0
            n + 1 $in N+
            c(n) = (fn(k N+) R {abs(a(k))})(n) = abs(a(n))
            c(n + 1) = (fn(k N+) R {abs(a(k))})(n + 1) = abs(a(n + 1))
            c(n) > 0
            c(n) != 0
            abs(a(n)) > 0
            abs(a(n)) != 0
            rho(n) = abs(a(n + 1)) / abs(a(n))
            by thm ratio_terms_apply(c, n) => ratio_terms(c)(n) = c(n + 1) / c(n)
            rho(n) = abs(a(n + 1)) / abs(a(n)) = c(n + 1) / c(n) = ratio_terms(c)(n)
        by def $pointwise_equal_sequences(rho, ratio_terms(c))
    release thm finite_liminf_extensional(rho, ratio_terms(c), beta)
    release thm ratio_liminf_greater_than_one_gives_failure_of_zero_limit(c, beta)
    by contra:
        ? not $is_convergent_series(a)
        $is_convergent_series(a)
        release thm series_zero_test(a)
        claim:
            ? $has_limit(c, 0)
            claim:
                ? forall epsilon R+:
                    exist n0 N+ st {$is_tail_close_to(c, 0, epsilon, n0)}
                obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
                witness exist n1 N+ st {$is_tail_close_to(c, 0, epsilon, n1)} from n0:
                    claim:
                        ? forall n N+:
                            n >= n0
                            =>:
                                abs(c(n) - 0) <= epsilon
                        c(n) = (fn(k N+) R {abs(a(k))})(n) = abs(a(n))
                        c(n) > 0
                        c(n) - 0 = c(n) > 0
                        a(n) - 0 = a(n)
                        abs(a(n) - 0) = abs(a(n))
                        abs(c(n) - 0) = c(n) - 0 = c(n) = abs(a(n)) = abs(a(n) - 0) <= epsilon
                    by def $is_tail_close_to(c, 0, epsilon, n0)
            by def $has_limit(c, 0)
        impossible not $has_limit(c, 0)
