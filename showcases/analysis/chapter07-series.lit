# Chapter 07 series
# Selected Analysis I development; scope and assumptions: STATUS.md.

sketch:
    have a fn(i_index Z) R
    have m Z
    have fn recursive_finite_series(f fn(i_index Z) R, start Z, length N) R by induc length from 0:
        case length = 0: 0
        case length >= 1: recursive_finite_series(f, start, length - 1) + f(start + length - 1)
    recursive_finite_series(a, m, 0) = 0
    recursive_finite_series(a, m, 1) = recursive_finite_series(a, m, 0) + a(m + 1 - 1)
    m + 1 - 1 = m
    a(m + 1 - 1) = a(m)
    recursive_finite_series(a, m, 0) + a(m + 1 - 1) = 0 + a(m + 1 - 1)
    0 + a(m + 1 - 1) = 0 + a(m)
    recursive_finite_series(a, m, 1) = recursive_finite_series(a, m, 0) + a(m + 1 - 1) = 0 + a(m + 1 - 1) = 0 + a(m)
    recursive_finite_series(a, m, 1) = 0 + a(m)
    0 + a(m) = a(m)
    recursive_finite_series(a, m, 1) = 0 + a(m) = a(m)
    recursive_finite_series(a, m, 2) = recursive_finite_series(a, m, 1) + a(m + 2 - 1)
    m + 2 - 1 = m + 1
    a(m + 2 - 1) = a(m + 1)
    recursive_finite_series(a, m, 1) + a(m + 2 - 1) = a(m) + a(m + 2 - 1)
    a(m) + a(m + 2 - 1) = a(m) + a(m + 1)
    recursive_finite_series(a, m, 2) = recursive_finite_series(a, m, 1) + a(m + 2 - 1) = a(m) + a(m + 2 - 1) = a(m) + a(m + 1)
    recursive_finite_series(a, m, 2) = a(m) + a(m + 1)
thm finite_series_basic_cases:
    ? forall a fn(i_index Z) R, m Z:
        sum(m, m, fn(i_index Z) R {a(i_index)}) = a(m)
        sum(m, m + 1, fn(i_index Z) R {a(i_index)}) = a(m) + a(m + 1)
    thm addition_respects_equal_real_arguments:
        ? forall left, right, left_value, right_value R:
            left = left_value
            right = right_value
            =>:
                left + right = left_value + right_value
    sum(m, m, fn(i_index Z) R {a(i_index)}) = fn(i_index Z) R {a(i_index)}(m) = a(m)
    sum(m, m + 1, fn(i_index Z) R {a(i_index)}) = sum(m, m, fn(i_index Z) R {a(i_index)}) + fn(i_index Z) R {a(i_index)}(m + 1)
    fn(i_index Z) R {a(i_index)}(m + 1) = a(m + 1)
    release thm addition_respects_equal_real_arguments(sum(m, m, fn(i_index Z) R {a(i_index)}), fn(i_index Z) R {a(i_index)}(m + 1), a(m), a(m + 1))
thm finite_series_dummy_index:
    ? forall a fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) = sum(m, n, fn(j Z) R {a(j)})
thm finite_series_split_range:
    ? forall a fn(i_index Z) R, m, n, p Z:
        m <= n
        n < p
        m <= p
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) + sum(n + 1, p, fn(i_index Z) R {a(i_index)}) = sum(m, p, fn(i_index Z) R {a(i_index)})
thm finite_series_add:
    ? forall a, b fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index) + b(i_index)}) = sum(m, n, fn(i_index Z) R {a(i_index)}) + sum(m, n, fn(i_index Z) R {b(i_index)})
thm finite_series_scalar_mul:
    ? forall a fn(i_index Z) R, c R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {c * a(i_index)}) = c * sum(m, n, fn(i_index Z) R {a(i_index)})
thm finite_series_scalar_mul_positive_range:
    ? forall a fn(i_index N+) R, c R, m, n N+:
        m <= n
        =>:
            sum(m, n, fn(i_index N+) R {c * a(i_index)}) = c * sum(m, n, fn(i_index N+) R {a(i_index)})
    have f fn(index N+) R = fn(i_index N+) R {a(i_index)}
    have g fn(index N+) R = fn(i_index N+) R {c * a(i_index)}
    claim:
        ? forall k N+:
            g(k) = c * f(k)
        f(k) = a(k)
        g(k) = c * a(k) = c * f(k)
    claim:
        ? sum(m, n, g) = c * sum(m, n, f)
        by induc n from m:
            ? sum(m, n, g) = c * sum(m, n, f)
            ? from n = m:
                sum(m, m, g) = g(m) = c * f(m)
                sum(m, m, f) = f(m)
            ? induc:
                n >= m
                n + 1 $in N+
                g(n + 1) = c * f(n + 1)
                sum(m, n + 1, g) = sum(m, n, g) + g(n + 1)
                sum(m, n + 1, f) = sum(m, n, f) + f(n + 1)
                sum(m, n + 1, g) = c * sum(m, n, f) + c * f(n + 1) = c * (sum(m, n, f) + f(n + 1)) = c * sum(m, n + 1, f)
    forall k N+:
        g(k) = c * a(k)
        f(k) = a(k)
    release thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index N+) R {c * a(i_index)}), sum(m, n, g))
    release thm sum_le_sum_from_pointwise(sum(m, n, g), sum(m, n, fn(i_index N+) R {c * a(i_index)}))
    release thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index N+) R {a(i_index)}), sum(m, n, f))
    release thm sum_le_sum_from_pointwise(sum(m, n, f), sum(m, n, fn(i_index N+) R {a(i_index)}))
    sum(m, n, fn(i_index N+) R {c * a(i_index)}) = sum(m, n, g) = c * sum(m, n, f) = c * sum(m, n, fn(i_index N+) R {a(i_index)})
thm finite_series_triangle:
    ? forall a fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            abs(sum(m, n, fn(i_index Z) R {a(i_index)})) <= sum(m, n, fn(i_index Z) R {abs(a(i_index))})
    thm abs_of_equal_real_values:
        ? forall left_value, right_value R:
            left_value = right_value
            =>:
                abs(left_value) = abs(right_value)
    have fn restricted(index m...n) R = a(index)
    claim:
        ? forall index m...n:
            fn(i_index Z) R {a(i_index)}(index) = restricted(index)
        fn(i_index Z) R {a(i_index)}(index) = a(index) = restricted(index)
    claim:
        ? forall index m...n:
            fn(i_index Z) R {abs(a(i_index))}(index) = fn(i_index m...n) R {abs(restricted(i_index))}(index)
        a(index) = restricted(index)
        release thm abs_of_equal_real_values(a(index), restricted(index))
        fn(i_index Z) R {abs(a(i_index))}(index) = abs(a(index)) = abs(restricted(index)) = fn(i_index m...n) R {abs(restricted(i_index))}(index)
    claim:
        ? forall index m...n:
            abs(a(index)) = abs(restricted(index))
        a(index) = restricted(index)
        release thm abs_of_equal_real_values(a(index), restricted(index))
    release thm finite_set_sum_substitution(finite_set_sum(m...n, fn(i_index Z) R {a(i_index)}), finite_set_sum(m...n, restricted))
    release thm finite_set_sum_substitution(finite_set_sum(m...n, fn(i_index Z) R {abs(a(i_index))}), finite_set_sum(m...n, fn(i_index m...n) R {abs(restricted(i_index))}))
    sum(m, n, fn(i_index Z) R {a(i_index)}) = finite_set_sum(m...n, fn(i_index Z) R {a(i_index)}) = finite_set_sum(m...n, restricted)
    sum(m, n, fn(i_index Z) R {abs(a(i_index))}) = finite_set_sum(m...n, fn(i_index Z) R {abs(a(i_index))}) = finite_set_sum(m...n, fn(i_index m...n) R {abs(restricted(i_index))})
    abs(finite_set_sum(m...n, restricted)) <= finite_set_sum(m...n, fn(i_index m...n) R {abs(restricted(i_index))})
    release thm abs_of_equal_real_values(sum(m, n, fn(i_index Z) R {a(i_index)}), finite_set_sum(m...n, restricted))
    abs(sum(m, n, fn(i_index Z) R {a(i_index)})) = abs(finite_set_sum(m...n, restricted)) <= finite_set_sum(m...n, fn(i_index m...n) R {abs(restricted(i_index))}) = sum(m, n, fn(i_index Z) R {abs(a(i_index))})
thm finite_series_comparison:
    ? forall a, b fn(i_index Z) R, m, n Z:
        m <= n
        forall i_index Z:
            m <= i_index <= n
            =>:
                a(i_index) <= b(i_index)
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) <= sum(m, n, fn(i_index Z) R {b(i_index)})
    release thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index Z) R {a(i_index)}), sum(m, n, fn(i_index Z) R {b(i_index)}))
prop is_bijection_from_index_range_to_finite_set(X finite_set, g fn(i_index closed_range(1, finite_set_size(X))) X):
    forall x X:
        exist! i_index closed_range(1, finite_set_size(X)) st {g(i_index) = x}
prop finite_set_size_has_index(n N+):
    forall s finite_set:
        $is_finite_set(s)
        finite_set_size(s) = n
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
thm intersect_with_singleton:
    ? forall s set, a set:
        a $in s
        =>:
            intersect(s, {a}) = {a}
    by extension:
        ? intersect(s, {a}) = {a}
        forall z intersect(s, {a}):
            z $in s
            z $in {a}
            z = a
        forall z {a}:
            z = a
            a $in s
            z $in s
            z $in {a}
thm remove_singleton_from_singleton_sized_set_is_empty:
    ? forall s finite_set, a set:
        $is_finite_set(s)
        finite_set_size(s) = 1
        a $in s
        =>:
            set_minus(s, {a}) = {}
    release thm intersect_with_singleton(s, a)
    $is_finite_set({a})
    $is_finite_set(intersect(s, {a}))
    finite_set_size({a}) = 1
    finite_set_size(intersect(s, {a})) = finite_set_size({a}) = 1
    $is_finite_set(set_minus(s, {a}))
    finite_set_size(set_minus(s, {a})) = finite_set_size(s) - finite_set_size(intersect(s, {a}))
    finite_set_size(s) - finite_set_size(intersect(s, {a})) = 1 - 1 = 0
    finite_set_size(set_minus(s, {a})) = 0
    by extension:
        ? set_minus(s, {a}) = {}
        claim:
            ? forall x set_minus(s, {a}):
                x $in {}
            by contra:
                ? x $in {}
                witness $is_nonempty_set(set_minus(s, {a})) from x
                finite_set_size(set_minus(s, {a})) >= 1
                impossible finite_set_size(set_minus(s, {a})) = 0
        claim:
            ? forall x {}:
                x $in set_minus(s, {a})
            by contra:
                ? x $in set_minus(s, {a})
                impossible x $in {}
thm index_function_for_singleton:
    ? forall s finite_set:
        $is_finite_set(s)
        finite_set_size(s) = 1
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
    finite_set_size(s) >= 1
    by contra:
        ? $is_nonempty_set(s)
        s = {}
        finite_set_size(s) = finite_set_size({}) = 0
        1 = finite_set_size(s) = 0
        impossible 1 = 0
    $is_nonempty_set(s)
    have a s
    release thm remove_singleton_from_singleton_sized_set_is_empty(s, a)
    have fn idx(i_index closed_range(1, finite_set_size(s))) s = a
    witness exist idx0 fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx0)} from idx:
        claim:
            ? forall y s:
                exist! i_index closed_range(1, finite_set_size(s)) st {idx0(i_index) = y}
            by contra:
                ? y = a
                y != a
                y $in set_minus(s, {a})
                witness $is_nonempty_set(set_minus(s, {a})) from y:
                    y $in set_minus(s, {a})
                impossible $is_nonempty_set(set_minus(s, {a}))
            idx0(1) = idx(1) = a
            witness exist! i_index closed_range(1, finite_set_size(s)) st {idx0(i_index) = y} from 1:
                1 <= finite_set_size(s)
                idx0(1) = y
                claim:
                    ? forall i1, i2 closed_range(1, finite_set_size(s)):
                        idx0(i1) = y
                        idx0(i2) = y
                        =>:
                            i1 = i2
                    i1 >= 1
                    i1 <= finite_set_size(s)
                    i1 <= 1
                    i1 = 1
                    i2 >= 1
                    i2 <= finite_set_size(s)
                    i2 <= 1
                    i2 = 1
        by def $is_bijection_from_index_range_to_finite_set(s, idx0)
        $is_bijection_from_index_range_to_finite_set(s, idx0)
thm index_function_step:
    ? forall n N+, s finite_set:
        $is_finite_set(s)
        finite_set_size(s) = n + 1
        $finite_set_size_has_index(n)
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
    finite_set_size(s) = n + 1 >= 1
    0 < n
    by contra:
        ? $is_nonempty_set(s)
        s = {}
        finite_set_size(s) = finite_set_size({}) = 0
        n + 1 = finite_set_size(s) = 0
        n = (n + 1) - 1 = 0 - 1 = -1
        n <= 0
        impossible 0 < n
    $is_nonempty_set(s)
    have a s
    release thm intersect_with_singleton(s, a)
    $is_finite_set({a})
    $is_finite_set(intersect(s, {a}))
    finite_set_size({a}) = 1
    finite_set_size(intersect(s, {a})) = finite_set_size({a}) = 1
    $is_finite_set(set_minus(s, {a}))
    finite_set_size(set_minus(s, {a})) = finite_set_size(s) - finite_set_size(intersect(s, {a}))
    finite_set_size(s) - finite_set_size(intersect(s, {a})) = (n + 1) - 1 = n
    finite_set_size(set_minus(s, {a})) = n
    $finite_set_size_has_index(n)
    exist prev fn(i_index closed_range(1, finite_set_size(set_minus(s, {a})))) set_minus(s, {a}) st {$is_bijection_from_index_range_to_finite_set(set_minus(s, {a}), prev)}
    obtain prev from exist prev fn(i_index closed_range(1, finite_set_size(set_minus(s, {a})))) set_minus(s, {a}) st {$is_bijection_from_index_range_to_finite_set(set_minus(s, {a}), prev)}
    set_minus(s, {a}) $subset s
    claim:
        ? forall predecessor_index closed_range(1, finite_set_size(s)):
            predecessor_index <= n
            =>:
                prev(predecessor_index) $in s
        1 <= predecessor_index
        predecessor_index <= n = finite_set_size(set_minus(s, {a}))
        predecessor_index $in closed_range(1, finite_set_size(set_minus(s, {a})))
        prev(predecessor_index) $in set_minus(s, {a})
        prev(predecessor_index) $in s
    have fn idx(i_index closed_range(1, finite_set_size(s))) s by cases:
        case i_index <= n: prev(i_index)
        case i_index > n: a
    claim:
        ? forall i_index closed_range(1, finite_set_size(s)):
            idx(i_index) = a
            =>:
                i_index = n + 1
        i_index <= n or i_index > n
        by cases:
            ? i_index = n + 1
            case i_index <= n:
                i_index >= 1
                i_index <= n = finite_set_size(set_minus(s, {a}))
                i_index $in closed_range(1, finite_set_size(set_minus(s, {a})))
                idx(i_index) = prev(i_index)
                prev(i_index) $in set_minus(s, {a})
                idx(i_index) $in set_minus(s, {a})
                claim:
                    ? not a $in set_minus(s, {a})
                    by contra:
                        ? not a $in set_minus(s, {a})
                        a $in set_minus(s, {a})
                        not a $in {a}
                        a $in {a}
                        impossible not a $in {a}
                a $in set_minus(s, {a})
                impossible not a $in set_minus(s, {a})
            case i_index > n:
                i_index <= finite_set_size(s) = n + 1
                i_index >= n + 1
                i_index = n + 1
    claim:
        ? forall i1, i2 closed_range(1, finite_set_size(s)):
            idx(i1) = idx(i2)
            =>:
                i1 = i2
        i1 <= n or i1 > n
        by cases:
            ? i1 = i2
            case i1 <= n:
                i2 <= n or i2 > n
                by cases:
                    ? i1 = i2
                    case i2 <= n:
                        i1 >= 1
                        i2 >= 1
                        i1 <= n = finite_set_size(set_minus(s, {a}))
                        i2 <= n = finite_set_size(set_minus(s, {a}))
                        i1 $in closed_range(1, finite_set_size(set_minus(s, {a})))
                        i2 $in closed_range(1, finite_set_size(set_minus(s, {a})))
                        idx(i1) = prev(i1)
                        idx(i2) = prev(i2)
                        prev(i1) = prev(i2)
                        exist! j closed_range(1, finite_set_size(set_minus(s, {a}))) st {prev(j) = prev(i1)}
                        i1 = i2
                    case i2 > n:
                        i2 <= finite_set_size(s) = n + 1
                        i2 >= n + 1
                        i2 = n + 1
                        idx(i2) = a
                        idx(i1) = idx(i2) = a
                        i1 = n + 1
                        impossible i1 <= n
            case i1 > n:
                i1 <= finite_set_size(s) = n + 1
                i1 >= n + 1
                i1 = n + 1
                idx(i1) = a
                idx(i2) = idx(i1) = a
                i2 = n + 1
                i1 = i2
    claim:
        ? forall y s:
            exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)}
        y = a or y != a
        by cases:
            ? exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)}
            case y = a:
                n + 1 <= finite_set_size(s)
                1 <= n + 1
                n + 1 $in closed_range(1, finite_set_size(s))
                n < n + 1
                n + 1 > n
                idx(n + 1) = a
                y = a = idx(n + 1)
                witness exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)} from n + 1:
                    n + 1 <= finite_set_size(s)
                    y = idx(n + 1)
            case y != a:
                y $in set_minus(s, {a})
                obtain j from exist i_index closed_range(1, finite_set_size(set_minus(s, {a}))) st {prev(i_index) = y}
                j <= finite_set_size(set_minus(s, {a}))
                j <= n
                n <= n + 1
                j <= n <= n + 1 = finite_set_size(s)
                y = prev(j) = idx(j)
                witness exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)} from j:
                    j <= finite_set_size(s)
                    y = idx(j)
    witness exist idx0 fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx0)} from idx:
        claim:
            ? forall y s:
                exist! i_index closed_range(1, finite_set_size(s)) st {idx0(i_index) = y}
            obtain i_index from exist i_index closed_range(1, finite_set_size(s)) st {y = idx(i_index)}
            witness exist! i0 closed_range(1, finite_set_size(s)) st {idx0(i0) = y} from i_index:
                idx0(i_index) = idx(i_index) = y
                forall i1, i2 closed_range(1, finite_set_size(s)):
                    idx0(i1) = y
                    idx0(i2) = y
                    =>:
                        idx(i1) = idx0(i1) = y = idx0(i2) = idx(i2)
                        i1 = i2
        by def $is_bijection_from_index_range_to_finite_set(s, idx0)
        $is_bijection_from_index_range_to_finite_set(s, idx0)
thm finite_set_size_has_index_for_all:
    ? forall n N+:
        $finite_set_size_has_index(n)
    by induc n from 1:
        ? $finite_set_size_has_index(n)
        ? from n = 1:
            claim:
                ? forall s finite_set:
                    $is_finite_set(s)
                    finite_set_size(s) = 1
                    =>:
                        exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
                release thm index_function_for_singleton(s)
            by def $finite_set_size_has_index(1)
            $finite_set_size_has_index(1)
            $finite_set_size_has_index(n)
        ? induc:
            $finite_set_size_has_index(n)
            claim:
                ? forall s finite_set:
                    $is_finite_set(s)
                    finite_set_size(s) = n + 1
                    =>:
                        exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
                release thm index_function_step(n, s)
            by def $finite_set_size_has_index(n + 1)
            $finite_set_size_has_index(n + 1)
thm finite_set_index_exists_by_induction:
    ? forall s finite_set:
        finite_set_size(s) >= 1
        =>:
            exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
    release thm finite_set_size_has_index_for_all(finite_set_size(s))
    $is_finite_set(s)
    finite_set_size(s) $in N+
    $finite_set_size_has_index(finite_set_size(s))
    exist idx fn(i_index closed_range(1, finite_set_size(s))) s st {$is_bijection_from_index_range_to_finite_set(s, idx)}
forall X finite_set, f fn(x X) R:
    finite_set_sum(X, f) $in R
sketch:
    have fn example_7_1_7_f(x Z) R = ((-9) * x^2 + 33 * x - 20) / 2
    example_7_1_7_f(1) = 2
    example_7_1_7_f(2) = 5
    example_7_1_7_f(3) = (-1)
    finite_set_sum({1, 2, 3}, example_7_1_7_f) = 2 + 5 + (-1)
    finite_set_sum({1, 2, 3}, example_7_1_7_f) = 6
    finite_set_sum({3, 2, 1}, example_7_1_7_f) = (-1) + 5 + 2
    finite_set_sum({3, 2, 1}, example_7_1_7_f) = 6
    finite_set_sum({1, 2, 3}, example_7_1_7_f) = finite_set_sum({3, 2, 1}, example_7_1_7_f)
thm finite_set_sum_enumeration_well_defined:
    ? forall X finite_set, f fn(x X) R, g finite_seq(X, finite_set_size(X)), h finite_seq(X, finite_set_size(X)):
        finite_set_size(X) >= 1
        $bijective(closed_range(1, finite_set_size(X)), X, g)
        $bijective(closed_range(1, finite_set_size(X)), X, h)
        =>:
            sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(h(i_index))})
    release thm sum_over_bijective_finite_set_enumerations(sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}), sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(h(i_index))}))
prop is_finite_set_sum(X finite_set, f fn(x X) R, l R):
    X $subset R
    finite_set_size(X) >= 1
    forall g finite_seq(X, finite_set_size(X)):
        $bijective(closed_range(1, finite_set_size(X)), X, g)
        =>:
            sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l
thm finite_set_sum_matches_bijective_enumeration:
    ? forall X finite_set, f fn(x X) R, g finite_seq(X, finite_set_size(X)):
        finite_set_size(X) >= 1
        $bijective(closed_range(1, finite_set_size(X)), X, g)
        =>:
            sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = finite_set_sum(X, f)
    release thm finite_set_sum_substitution(finite_set_sum(X, f), finite_set_sum(closed_range(1, finite_set_size(X)), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}))
    finite_set_sum(X, f) = finite_set_sum(closed_range(1, finite_set_size(X)), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))})
    finite_set_sum(closed_range(1, finite_set_size(X)), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))})
thm finite_set_sum_satisfies_self_definition:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            $is_finite_set_sum(X, f, finite_set_sum(X, f))
    claim:
        ? forall g finite_seq(X, finite_set_size(X)):
            $bijective(closed_range(1, finite_set_size(X)), X, g)
            =>:
                sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = finite_set_sum(X, f)
        release thm finite_set_sum_matches_bijective_enumeration(X, f, g)
    by def $is_finite_set_sum(X, f, finite_set_sum(X, f))
prop has_finite_set_sum(X finite_set, f fn(x X) R):
    exist l R st {$is_finite_set_sum(X, f, l)}
thm finite_set_sum_exists:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            $has_finite_set_sum(X, f)
    release thm finite_set_sum_satisfies_self_definition(X, f)
    witness $has_finite_set_sum(X, f) from finite_set_sum(X, f)
template<X finite_set, f fn(x X) R: X $subset R, finite_set_size(X) >= 1, $has_finite_set_sum(X, f)>:
    obtain self_finite_set_sum from $has_finite_set_sum(X, f)
thm self_finite_set_sum_satisfies_definition:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            $is_finite_set_sum(X, f, \self_finite_set_sum<X, f>)
    release thm finite_set_sum_exists(X, f)
thm finite_set_sum_value_unique:
    ? forall X finite_set, f fn(x X) R, l1, l2 R:
        $is_finite_set_sum(X, f, l1)
        $is_finite_set_sum(X, f, l2)
        =>:
            l1 = l2
    finite_set_size(X) >= 1
    release thm finite_set_has_bijective_index(X)
    obtain g from exist g finite_seq(X, finite_set_size(X)) st {$bijective(closed_range(1, finite_set_size(X)), X, g)}
    sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l1
    sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l2
    l1 = sum(1, finite_set_size(X), fn(i_index closed_range(1, finite_set_size(X))) R {f(g(i_index))}) = l2
thm self_finite_set_sum_matches_builtin:
    ? forall X finite_set, f fn(x X) R:
        X $subset R
        finite_set_size(X) >= 1
        =>:
            \self_finite_set_sum<X, f> = finite_set_sum(X, f)
    release thm self_finite_set_sum_satisfies_definition(X, f)
    release thm finite_set_sum_satisfies_self_definition(X, f)
    release thm finite_set_sum_value_unique(X, f, \self_finite_set_sum<X, f>, finite_set_sum(X, f))
thm finite_set_sum_well_defined_under_permutation:
    ? forall X finite_set, f fn(x X) R, g fn(x X) X:
        forall y X:
            exist! x X st {g(x) = y}
        =>:
            finite_set_sum(X, fn(x X) R {f(g(x))}) = finite_set_sum(X, f)
    claim:
        ? forall u, v X:
            g(u) = g(v)
            =>:
                u = v
        obtain chosen from exist! x X st {g(x) = g(u)}
        u = chosen
        v = chosen
    by def $injective(X, X, g)
    claim:
        ? forall y X:
            exist x X st {y = g(x)}
        obtain chosen from exist! x X st {g(x) = y}
        witness exist x X st {y = g(x)} from chosen
    by def $surjective(X, X, g)
    by def $bijective(X, X, g)
    release thm finite_set_sum_substitution(finite_set_sum(X, fn(x X) R {f(g(x))}), finite_set_sum(X, f))
thm finite_set_sum_empty:
    ? forall f fn(x {}) R:
        finite_set_sum({}, f) = 0
thm finite_set_sum_singleton:
    ? forall x0 R, f fn(x {x0}) R:
        finite_set_sum({x0}, f) = f(x0)
    f(x0) = f(x0)
thm finite_set_sum_reindex:
    ? forall X, Y finite_set, f fn(x X) R, g fn(y Y) X:
        forall x X:
            exist! y Y st {g(y) = x}
        =>:
            finite_set_sum(X, f) = finite_set_sum(Y, fn(y Y) R {f(g(y))})
    claim:
        ? forall u, v Y:
            g(u) = g(v)
            =>:
                u = v
        exist! y Y st {g(y) = g(u)}
    by def $injective(Y, X, g)
    claim:
        ? forall x X:
            exist y Y st {x = g(y)}
        obtain chosen from exist! y Y st {g(y) = x}
        witness exist y Y st {x = g(y)} from chosen
    by def $surjective(Y, X, g)
    by def $bijective(Y, X, g)
    release thm finite_set_sum_substitution(finite_set_sum(X, f), finite_set_sum(Y, fn(y Y) R {f(g(y))}))
thm finite_set_sum_range_matches_series:
    ? forall a fn(i_index Z) R, m, n Z:
        m <= n
        =>:
            sum(m, n, fn(i_index Z) R {a(i_index)}) = finite_set_sum(m...n, fn(i_index m...n) R {a(i_index)})
    release thm finite_set_sum_substitution(finite_set_sum(m...n, fn(i_index Z) R {a(i_index)}), finite_set_sum(m...n, fn(i_index m...n) R {a(i_index)}))
    sum(m, n, fn(i_index Z) R {a(i_index)}) = finite_set_sum(m...n, fn(i_index Z) R {a(i_index)}) = finite_set_sum(m...n, fn(i_index m...n) R {a(i_index)})
thm finite_set_sum_disjoint_union:
    ? forall X, Y finite_set, f fn(z union(X, Y)) R:
        intersect(X, Y) = {}
        =>:
            finite_set_sum(union(X, Y), f) = finite_set_sum(X, fn(x X) R {f(x)}) + finite_set_sum(Y, fn(y Y) R {f(y)})
thm finite_set_sum_add:
    ? forall X finite_set, f, g fn(x X) R:
        finite_set_sum(X, fn(x X) R {f(x) + g(x)}) = finite_set_sum(X, f) + finite_set_sum(X, g)
thm finite_set_sum_scalar_mul:
    ? forall X finite_set, f fn(x X) R, c R:
        finite_set_sum(X, fn(x X) R {c * f(x)}) = c * finite_set_sum(X, f)
thm finite_set_sum_monotone:
    ? forall X finite_set, f, g fn(x X) R:
        forall x X:
            f(x) <= g(x)
        =>:
            finite_set_sum(X, f) <= finite_set_sum(X, g)
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(X, f), finite_set_sum(X, g))
thm finite_set_sum_triangle:
    ? forall X finite_set, f fn(x X) R:
        abs(finite_set_sum(X, f)) <= finite_set_sum(X, fn(x X) R {abs(f(x))})
thm finite_set_sum_subset_le_for_nonnegative_terms:
    ? forall S, T finite_set, f fn(x S) R:
        T $subset S
        forall member T:
            member $in S
        forall x S:
            f(x) >= 0
        =>:
            finite_set_sum(T, fn(x T: x $in S) R {f(x)}) <= finite_set_sum(S, f)
    have R0 finite_set = set_minus(S, T)
    set_minus(S, T) $subset S
    R0 $subset S
    claim:
        ? S = union(T, R0)
        by extension:
            ? S = union(T, R0)
            claim:
                ? forall x S:
                    x $in union(T, R0)
                x $in T or not x $in T
                by cases:
                    ? x $in union(T, R0)
                    case x $in T:
                        x $in union(T, R0)
                    case not x $in T:
                        x $in set_minus(S, T)
                        x $in R0
                        x $in union(T, R0)
            claim:
                ? forall x union(T, R0):
                    x $in S
                x $in T or x $in R0
                by cases:
                    ? x $in S
                    case x $in T:
                        T $subset S
                        x $in S
                    case x $in R0:
                        R0 $subset S
                        x $in S
    claim:
        ? intersect(T, R0) = {}
        by extension:
            ? intersect(T, R0) = {}
            claim:
                ? forall x intersect(T, R0):
                    x $in {}
                x $in T
                x $in set_minus(S, T)
                not x $in T
                by contra:
                    ? x $in {}
                    impossible not x $in T
            claim:
                ? forall x {}:
                    x $in intersect(T, R0)
                by contra:
                    ? x $in intersect(T, R0)
                    impossible x $in {}
    have fn union_term(x union(T, R0)) R = f(x)
    release thm finite_set_sum_disjoint_union(T, R0, union_term)
    claim:
        ? forall member R0:
            member $in S
        member $in set_minus(S, T)
        member $in S
    have fn zero_term(x R0) R = 0
    have fn remainder_term(x R0) R = f(x)
    claim:
        ? 0 <= finite_set_sum(R0, fn(x R0: x $in S) R {f(x)})
        claim:
            ? forall x R0:
                zero_term(x) <= remainder_term(x)
            x $in S
            remainder_term(x) = f(x) >= 0
            zero_term(x) = 0
        release thm finite_set_sum_monotone(R0, zero_term, remainder_term)
        release thm finite_set_sum_scalar_mul(R0, fn(y R0) R {1}, 0)
        finite_set_sum(R0, fn(y R0) R {0 * 1}) = 0 * finite_set_sum(R0, fn(y R0) R {1}) = 0
        finite_set_sum(R0, zero_term) = finite_set_sum(R0, fn(y R0) R {0}) = finite_set_sum(R0, fn(y R0) R {0 * 1}) = 0
        release thm finite_set_sum_substitution(finite_set_sum(R0, fn(y R0: y $in S) R {f(y)}), finite_set_sum(R0, remainder_term))
        finite_set_sum(R0, fn(y R0: y $in S) R {f(y)}) = finite_set_sum(R0, remainder_term) >= 0
    have partial R = finite_set_sum(T, fn(x T: x $in S) R {f(x)})
    have rest R = finite_set_sum(R0, fn(x R0: x $in S) R {f(x)})
    0 <= rest
    thm addition_of_equal_real_values:
        ? forall left, right, left_value, right_value R:
            left = left_value
            right = right_value
            =>:
                left + right = left_value + right_value
    claim:
        ? forall member T:
            union_term(member) = f(member)
        member $in S
        union_term(member) = f(member)
    claim:
        ? forall member R0:
            union_term(member) = f(member)
        member $in S
        union_term(member) = f(member)
    claim:
        ? forall member S:
            f(member) = union_term(member)
        member $in union(T, R0)
        union_term(member) = f(member)
    release thm finite_set_sum_substitution(finite_set_sum(T, fn(x T) R {union_term(x)}), finite_set_sum(T, fn(x T: x $in S) R {f(x)}))
    release thm finite_set_sum_substitution(finite_set_sum(R0, fn(x R0) R {union_term(x)}), finite_set_sum(R0, fn(x R0: x $in S) R {f(x)}))
    release thm finite_set_sum_substitution(finite_set_sum(S, f), finite_set_sum(union(T, R0), union_term))
    finite_set_sum(T, fn(x T) R {union_term(x)}) = finite_set_sum(T, fn(x T: x $in S) R {f(x)}) = partial
    finite_set_sum(R0, fn(x R0) R {union_term(x)}) = finite_set_sum(R0, fn(x R0: x $in S) R {f(x)}) = rest
    release thm addition_of_equal_real_values(finite_set_sum(T, fn(x T) R {union_term(x)}), finite_set_sum(R0, fn(x R0) R {union_term(x)}), partial, rest)
    finite_set_sum(union(T, R0), union_term) = finite_set_sum(T, fn(x T) R {union_term(x)}) + finite_set_sum(R0, fn(x R0) R {union_term(x)}) = partial + rest
    partial + rest = finite_set_sum(union(T, R0), union_term) = finite_set_sum(S, f)
    finite_set_sum(T, fn(x T: x $in S) R {f(x)}) = partial <= partial + rest = finite_set_sum(S, f)
thm finite_double_sum_over_cartesian_product:
    ? forall X, Y finite_set, f fn(z cart(X, Y)) R:
        finite_set_sum(X, fn(x X) R {finite_set_sum(Y, fn(y Y) R {f((x, y))})}) = finite_set_sum(cart(X, Y), f)
thm finite_fubini:
    ? forall X, Y finite_set, f fn(z cart(X, Y)) R:
        finite_set_sum(X, fn(x X) R {finite_set_sum(Y, fn(y Y) R {f((x, y))})}) = finite_set_sum(Y, fn(y Y) R {finite_set_sum(X, fn(x X) R {f((x, y))})})
claim:
    ? forall index N:
        index = 0 or index >= 1 and index $in N+
    index = 0 or index >= 1
    by cases:
        ? index = 0 or index >= 1 and index $in N+
        case index = 0:
            index = 0
        case index >= 1:
            0 < index
            index $in N+
have fn partial_sum(a seq(R), k N) R by induc k from 0:
    case k = 0: 0
    case k >= 1 and k $in N+: partial_sum(a, k - 1) + a(k)
thm partial_sum_successor:
    ? forall a seq(R), k N+:
        partial_sum(a, k) = partial_sum(a, k - 1) + a(k)
thm partial_sum_matches_finite_sum:
    ? forall a seq(R), k N+:
        partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
    thm addition_of_equal_real_values:
        ? forall left, right, left_value, right_value R:
            left = left_value
            right = right_value
            =>:
                left + right = left_value + right_value
    by induc k from 1:
        ? partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
        ? from k = 1:
            fn(i_index N+) R {a(i_index)}(1) = a(1)
            partial_sum(a, 0) = 0
            partial_sum(a, 1) = partial_sum(a, 0) + a(1) = 0 + a(1) = a(1) = sum(1, 1, fn(i_index N+) R {a(i_index)})
        ? induc:
            k + 1 $in N+
            release thm partial_sum_successor(a, k + 1)
            (k + 1) - 1 = k
            partial_sum(a, (k + 1) - 1) = partial_sum(a, k)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
            sum(1, k + 1, fn(i_index N+) R {a(i_index)}) = sum(1, k, fn(i_index N+) R {a(i_index)}) + fn(i_index N+) R {a(i_index)}(k + 1)
            fn(i_index N+) R {a(i_index)}(k + 1) = a(k + 1)
            release thm addition_of_equal_real_values(partial_sum(a, k), a(k + 1), sum(1, k, fn(i_index N+) R {a(i_index)}), fn(i_index N+) R {a(i_index)}(k + 1))
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1) = sum(1, k, fn(i_index N+) R {a(i_index)}) + fn(i_index N+) R {a(i_index)}(k + 1) = sum(1, k + 1, fn(i_index N+) R {a(i_index)})
thm partial_sum_split_after:
    ? forall a seq(R), m, n N+:
        m < n
        =>:
            partial_sum(a, n) = partial_sum(a, m) + sum(m + 1, n, fn(i_index N+) R {a(i_index)})
    thm addition_preserves_equality:
        ? forall left, right, extra R:
            left = right
            =>:
                left + extra = right + extra
    release thm partial_sum_matches_finite_sum(a, n)
    release thm partial_sum_matches_finite_sum(a, m)
    release thm addition_preserves_equality(sum(1, m, fn(i_index N+) R {a(i_index)}), partial_sum(a, m), sum(m + 1, n, fn(i_index N+) R {a(i_index)}))
    partial_sum(a, n) = sum(1, n, fn(i_index N+) R {a(i_index)}) = sum(1, m, fn(i_index N+) R {a(i_index)}) + sum(m + 1, n, fn(i_index N+) R {a(i_index)}) = partial_sum(a, m) + sum(m + 1, n, fn(i_index N+) R {a(i_index)})
prop is_tail_close_to(a seq(R), L R, epsilon R+, N0 N+):
    forall n N+:
        n >= N0
        =>:
            abs(a(n) - L) <= epsilon
prop has_limit(a seq(R), L R):
    forall epsilon R+:
        exist N0 N+ st {$is_tail_close_to(a, L, epsilon, N0)}
thm strict_eventual_closeness_implies_closed_tail:
    ? forall a seq(R), L R, epsilon R+:
        $chap6::has_eventual_closeness_to(a, L, epsilon)
        =>:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
    obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(a, L, epsilon, n0)}
    witness exist n1 N+ st {$is_tail_close_to(a, L, epsilon, n1)} from n0:
        forall n N+:
            n >= n0
            =>:
                abs(a(n) - L) < epsilon
                abs(a(n) - L) <= epsilon
        by def $is_tail_close_to(a, L, epsilon, n0)
thm strict_limit_implies_closed_limit:
    ? forall a seq(R), L R:
        $chap6::has_limit(a, L)
        =>:
            $has_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        release thm chap6::has_limit_gives_eventual_closeness(a, L, epsilon)
        release thm strict_eventual_closeness_implies_closed_tail(a, L, epsilon)
    by def $has_limit(a, L)
thm closed_limit_implies_strict_limit:
    ? forall a seq(R), L R:
        $has_limit(a, L)
        =>:
            $chap6::has_limit(a, L)
    claim:
        ? forall epsilon R+:
            $chap6::has_eventual_closeness_to(a, L, epsilon)
        epsilon / 2 $in R+
        epsilon / 2 < epsilon
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon / 2, n0)}
        witness $chap6::has_eventual_closeness_to(a, L, epsilon) from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(a(n) - L) <= epsilon / 2 < epsilon
                    abs(a(n) - L) < epsilon
            by def $chap6::is_tail_close_to(a, L, epsilon, n0)
    by def $chap6::has_limit(a, L)
thm strict_limit_extensional:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $chap6::has_limit(a, L)
        =>:
            $chap6::has_limit(b, L)
    claim:
        ? forall epsilon R+:
            $chap6::has_eventual_closeness_to(b, L, epsilon)
        release thm chap6::has_limit_gives_eventual_closeness(a, L, epsilon)
        obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(a, L, epsilon, n0)}
        witness $chap6::has_eventual_closeness_to(b, L, epsilon) from n0:
            forall n N+:
                n >= n0
                =>:
                    a(n) = b(n)
                    abs(b(n) - L) = abs(a(n) - L)
                    abs(a(n) - L) < epsilon
                    abs(b(n) - L) < epsilon
            by def $chap6::is_tail_close_to(b, L, epsilon, n0)
    by def $chap6::has_limit(b, L)
have fn constant_sequence(c R) fn(k N+) R = fn(i_index N+) R {c}
thm constant_sequence_has_strict_limit:
    ? forall c R:
        $chap6::has_limit(constant_sequence(c), c)
    claim:
        ? forall epsilon R+:
            $chap6::has_eventual_closeness_to(constant_sequence(c), c, epsilon)
        witness $chap6::has_eventual_closeness_to(constant_sequence(c), c, epsilon) from 1:
            forall k N+:
                k >= 1
                =>:
                    constant_sequence(c)(k) = c
                    constant_sequence(c)(k) - c = c - c = 0
                    abs(constant_sequence(c)(k) - c) = abs(0) = 0
                    0 < epsilon
                    abs(constant_sequence(c)(k) - c) < epsilon
            by def $chap6::is_tail_close_to(constant_sequence(c), c, epsilon, 1)
    by def $chap6::has_limit(constant_sequence(c), c)
prop has_series_sum(a seq(R), L R):
    $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
prop is_convergent_series(a seq(R)):
    exist L R st {$has_series_sum(a, L)}
thm partial_sum_extensional:
    ? forall a, b seq(R), k N:
        forall n N+:
            a(n) = b(n)
        =>:
            partial_sum(a, k) = partial_sum(b, k)
    by induc k from 0:
        ? partial_sum(a, k) = partial_sum(b, k)
        ? from k = 0:
            partial_sum(a, 0) = 0 = partial_sum(b, 0)
        ? induc:
            k + 1 $in N+
            release thm partial_sum_successor(a, k + 1)
            release thm partial_sum_successor(b, k + 1)
            (k + 1) - 1 = k
            partial_sum(a, k + 1) = partial_sum(a, (k + 1) - 1) + a(k + 1)
            partial_sum(a, (k + 1) - 1) = partial_sum(a, k)
            partial_sum(a, (k + 1) - 1) + a(k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(b, k + 1) = partial_sum(b, (k + 1) - 1) + b(k + 1)
            partial_sum(b, (k + 1) - 1) = partial_sum(b, k)
            partial_sum(b, (k + 1) - 1) + b(k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(b, k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k) = partial_sum(b, k)
            a(k + 1) = b(k + 1)
            partial_sum(a, k) + a(k + 1) = partial_sum(b, k) + a(k + 1)
            partial_sum(b, k) + a(k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1) = partial_sum(b, k) + a(k + 1) = partial_sum(b, k) + b(k + 1) = partial_sum(b, k + 1)
thm series_sum_extensional:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $has_series_sum(a, L)
        =>:
            $has_series_sum(b, L)
    claim:
        ? forall k N+:
            partial_sum(a, k) = partial_sum(b, k)
        release thm partial_sum_extensional(a, b, k)
    claim:
        ? forall n N+:
            fn(k N+) R {partial_sum(a, k)}(n) = fn(k N+) R {partial_sum(b, k)}(n)
        release thm partial_sum_extensional(a, b, n)
        fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n) = partial_sum(b, n) = fn(k N+) R {partial_sum(b, k)}(n)
    release thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, L)
    release thm strict_limit_extensional(fn(k N+) R {partial_sum(a, k)}, fn(k N+) R {partial_sum(b, k)}, L)
    release thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(b, k)}, L)
    by def $has_series_sum(b, L)
thm series_convergence_extensional:
    ? forall a, b seq(R):
        forall n N+:
            a(n) = b(n)
        $is_convergent_series(a)
        =>:
            $is_convergent_series(b)
    obtain L from $is_convergent_series(a)
    release thm series_sum_extensional(a, b, L)
    witness $is_convergent_series(b) from L
have fn geometric_series_terms_from_one(x R) fn(i_index N+) R = fn(j N+) R {x^j}
thm geometric_series_from_one_partial_sum:
    ? forall x R, k N+:
        1 - x != 0
        =>:
            partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
    thm addition_preserves_two_equalities:
        ? forall left1, right1, left2, right2 R:
            left1 = right1
            left2 = right2
            =>:
                left1 + left2 = right1 + right2
    by induc k from 1:
        ? partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
        ? from k = 1:
            partial_sum(geometric_series_terms_from_one(x), 0) = 0
            release thm partial_sum_successor(geometric_series_terms_from_one(x), 1)
            1 - 1 = 0
            geometric_series_terms_from_one(x)(1) = x^1
            x^1 = x
            partial_sum(geometric_series_terms_from_one(x), 1 - 1) = partial_sum(geometric_series_terms_from_one(x), 0) = 0
            geometric_series_terms_from_one(x)(1) = x
            release thm addition_preserves_two_equalities(partial_sum(geometric_series_terms_from_one(x), 1 - 1), 0, geometric_series_terms_from_one(x)(1), x)
            partial_sum(geometric_series_terms_from_one(x), 1 - 1) + geometric_series_terms_from_one(x)(1) = 0 + x = x
            partial_sum(geometric_series_terms_from_one(x), 1) = x
            x^(1 + 1) = x^2
            x - x^(1 + 1) = x - x^2 = x * (1 - x)
            x = (x - x^(1 + 1)) / (1 - x)
        ? induc:
            partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
            k + 1 $in N+
            release thm partial_sum_successor(geometric_series_terms_from_one(x), k + 1)
            (k + 1) - 1 = k
            partial_sum(geometric_series_terms_from_one(x), (k + 1) - 1) = partial_sum(geometric_series_terms_from_one(x), k)
            partial_sum(geometric_series_terms_from_one(x), (k + 1) - 1) + geometric_series_terms_from_one(x)(k + 1) = partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = partial_sum(geometric_series_terms_from_one(x), (k + 1) - 1) + geometric_series_terms_from_one(x)(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1)
            geometric_series_terms_from_one(x)(k + 1) = x^(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + geometric_series_terms_from_one(x)(k + 1)
            (x - x^(k + 1)) / (1 - x) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + x^(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = partial_sum(geometric_series_terms_from_one(x), k) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + geometric_series_terms_from_one(x)(k + 1) = (x - x^(k + 1)) / (1 - x) + x^(k + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = (x - x^(k + 1)) / (1 - x) + x^(k + 1)
            (x - x^(k + 1)) / (1 - x) + x^(k + 1) = (x - x^(k + 1) + x^(k + 1) * (1 - x)) / (1 - x)
            x - x^(k + 1) + x^(k + 1) * (1 - x) = x - x^(k + 1) * x
            x = x^1
            x^(k + 1) * x = x^(k + 1) * x^1
            x^(k + 1) * x^1 = x^((k + 1) + 1)
            x - x^(k + 1) * x = x - x^((k + 1) + 1)
            x - x^(k + 1) + x^(k + 1) * (1 - x) = x - x^((k + 1) + 1)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = (x - x^(k + 1) + x^(k + 1) * (1 - x)) / (1 - x)
            (x - x^(k + 1) + x^(k + 1) * (1 - x)) / (1 - x) = (x - x^((k + 1) + 1)) / (1 - x)
            partial_sum(geometric_series_terms_from_one(x), k + 1) = (x - x^((k + 1) + 1)) / (1 - x)
have fn geometric_series_from_one_tail(x R) fn(k N+) R = fn(n N+) R {x^(n + 1)}
release obj def chap6::geom_seq
release obj def chap6::seq_shift
thm geometric_series_from_one_tail_has_strict_limit_zero:
    ? forall x R:
        abs(x) < 1
        =>:
            $chap6::has_limit(geometric_series_from_one_tail(x), 0)
    release thm chap6::geometric_abs_lt_one_converges_to_zero(x)
    release thm chap6::seq_shift_has_limit(chap6::geom_seq(x), 0)
    claim:
        ? forall n N+:
            chap6::seq_shift(chap6::geom_seq(x))(n) = geometric_series_from_one_tail(x)(n)
        claim:
            ? chap6::seq_shift(chap6::geom_seq(x))(n) = chap6::geom_seq(x)(n + 1)
            release thm chap6::seq_shift_value(chap6::geom_seq(x), n)
        claim:
            ? chap6::geom_seq(x)(n + 1) = x^(n + 1)
            release thm chap6::geom_seq_value(x, n + 1)
        geometric_series_from_one_tail(x)(n) = x^(n + 1)
        chap6::seq_shift(chap6::geom_seq(x))(n) = x^(n + 1)
    release thm strict_limit_extensional(chap6::seq_shift(chap6::geom_seq(x)), geometric_series_from_one_tail(x), 0)
thm geometric_series_from_one_tail_has_limit_zero:
    ? forall x R:
        abs(x) < 1
        =>:
            $has_limit(geometric_series_from_one_tail(x), 0)
    release thm geometric_series_from_one_tail_has_strict_limit_zero(x)
    release thm strict_limit_implies_closed_limit(geometric_series_from_one_tail(x), 0)
thm geometric_series_from_one_formula:
    ? forall x R:
        abs(x) < 1
        1 - x != 0
        =>:
            $has_series_sum(geometric_series_terms_from_one(x), x / (1 - x))
    geometric_series_terms_from_one(x) $in seq(R)
    have tail seq(R) = geometric_series_from_one_tail(x)
    release thm geometric_series_from_one_tail_has_strict_limit_zero(x)
    have numerator seq(R) = fn(k N+) R {x - tail(k)}
    release thm constant_sequence_has_strict_limit(x)
    release thm chap6::seq_sub_converges_to(constant_sequence(x), tail, x, 0)
    claim:
        ? forall k N+:
            constant_sequence(x)(k) - tail(k) = numerator(k)
        fn(i_index N+) R {constant_sequence(x)(i_index) - tail(i_index)}(k) = constant_sequence(x)(k) - tail(k)
        constant_sequence(x)(k) = x
        numerator(k) = x - tail(k)
        constant_sequence(x)(k) - tail(k) = x - tail(k) = numerator(k)
        fn(i_index N+) R {constant_sequence(x)(i_index) - tail(i_index)}(k) = x - tail(k) = numerator(k)
    release thm strict_limit_extensional(fn(i_index N+) R {constant_sequence(x)(i_index) - tail(i_index)}, numerator, x - 0)
    have scaled seq(R) = fn(k N+) R {(1 / (1 - x)) * numerator(k)}
    release thm chap6::seq_const_mul_converges_to(1 / (1 - x), numerator, x - 0)
    claim:
        ? forall k N+:
            (1 / (1 - x)) * numerator(k) = scaled(k)
        fn(i_index N+) R {(1 / (1 - x)) * numerator(i_index)}(k) = (1 / (1 - x)) * numerator(k)
        scaled(k) = (1 / (1 - x)) * numerator(k)
        (1 / (1 - x)) * numerator(k) = scaled(k)
        fn(i_index N+) R {(1 / (1 - x)) * numerator(i_index)}(k) = scaled(k)
    release thm strict_limit_extensional(fn(i_index N+) R {(1 / (1 - x)) * numerator(i_index)}, scaled, (1 / (1 - x)) * (x - 0))
    (1 / (1 - x)) * (x - 0) = x / (1 - x)
    claim:
        ? forall k N+:
            scaled(k) = partial_sum(geometric_series_terms_from_one(x), k)
        tail(k) = geometric_series_from_one_tail(x)(k)
        geometric_series_from_one_tail(x)(k) = x^(k + 1)
        tail(k) = x^(k + 1)
        numerator(k) = x - tail(k) = x - x^(k + 1)
        scaled(k) = (1 / (1 - x)) * numerator(k)
        (1 / (1 - x)) * numerator(k) = (1 / (1 - x)) * (x - x^(k + 1))
        (1 / (1 - x)) * (x - x^(k + 1)) = (x - x^(k + 1)) / (1 - x)
        scaled(k) = (x - x^(k + 1)) / (1 - x)
        release thm geometric_series_from_one_partial_sum(x, k)
        partial_sum(geometric_series_terms_from_one(x), k) = (x - x^(k + 1)) / (1 - x)
    claim:
        ? forall n N+:
            scaled(n) = fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n)
        scaled(n) = partial_sum(geometric_series_terms_from_one(x), n) = fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n)
    release thm strict_limit_extensional(scaled, fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, x / (1 - x))
    release thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, x / (1 - x))
    by def $has_series_sum(geometric_series_terms_from_one(x), x / (1 - x))
thm real_power_at_least_one:
    ? forall y R, n N+:
        y >= 1
        =>:
            y^n >= 1
    by induc n from 1:
        ? y^n >= 1
        ? from n = 1:
            y^1 = y
            y^1 >= 1
        ? induc:
            y^n >= 1
            y^(n + 1) = y^n * y
            y^n * y >= 1 * 1
            1 * 1 = 1
            y^(n + 1) >= 1
thm geometric_series_from_one_diverges_when_abs_ge_one:
    ? forall x R:
        abs(x) >= 1
        =>:
            not $is_convergent_series(geometric_series_terms_from_one(x))
    thm equal_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    by contra:
        ? not $is_convergent_series(geometric_series_terms_from_one(x))
        $is_convergent_series(geometric_series_terms_from_one(x))
        obtain L from $is_convergent_series(geometric_series_terms_from_one(x))
        $has_limit(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, L)
        1 / 3 $in R+
        obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}, L, 1 / 3, n0)}
        n0 + 1 $in N+
        n0 >= n0
        n0 + 1 >= n0
        abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0) - L) <= 1 / 3
        abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1) - L) <= 1 / 3
        fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0) = partial_sum(geometric_series_terms_from_one(x), n0)
        fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0 + 1)
        release thm equal_values_have_equal_distance(partial_sum(geometric_series_terms_from_one(x), n0), fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0), L)
        release thm equal_values_have_equal_distance(partial_sum(geometric_series_terms_from_one(x), n0 + 1), fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1), L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) = abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) = abs(fn(k N+) R {partial_sum(geometric_series_terms_from_one(x), k)}(n0 + 1) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) <= 1 / 3
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) <= 1 / 3
        (n0 + 1) - 1 = n0
        partial_sum(geometric_series_terms_from_one(x), (n0 + 1) - 1) = partial_sum(geometric_series_terms_from_one(x), n0)
        release thm partial_sum_successor(geometric_series_terms_from_one(x), n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) = partial_sum(geometric_series_terms_from_one(x), (n0 + 1) - 1) + geometric_series_terms_from_one(x)(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), (n0 + 1) - 1) + geometric_series_terms_from_one(x)(n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + geometric_series_terms_from_one(x)(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + geometric_series_terms_from_one(x)(n0 + 1)
        geometric_series_terms_from_one(x)(n0 + 1) = x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0) + geometric_series_terms_from_one(x)(n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) = partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0) = (partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)) - partial_sum(geometric_series_terms_from_one(x), n0)
        (partial_sum(geometric_series_terms_from_one(x), n0) + x^(n0 + 1)) - partial_sum(geometric_series_terms_from_one(x), n0) = x^(n0 + 1)
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0) = x^(n0 + 1)
        claim:
            ? forall exponent N:
                abs(x^exponent) = abs(x)^exponent
            by induc exponent from 0:
                ? abs(x^exponent) = abs(x)^exponent
                ? from exponent = 0:
                    x^0 = 1
                    abs(x^0) = abs(1) = 1 = abs(x)^0
                ? induc:
                    x^(exponent + 1) = x^exponent * x
                    x^exponent $in R
                    abs(x^(exponent + 1)) = abs(x^exponent * x) = abs(x^exponent) * abs(x)
                    abs(x)^(exponent + 1) = abs(x)^exponent * abs(x)
        n0 + 1 $in N
        abs(x^(n0 + 1)) = abs(x)^(n0 + 1)
        release thm real_power_at_least_one(abs(x), n0 + 1)
        abs(x^(n0 + 1)) >= 1
        partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0) = (partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) = abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L))
        abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) <= 1 / 3 + 1 / 3
        1 / 3 + 1 / 3 = 2 / 3
        2 / 3 < 1
        1 / 3 + 1 / 3 < 1
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L))
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs((partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) - (partial_sum(geometric_series_terms_from_one(x), n0) - L)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L)
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - L) + abs(partial_sum(geometric_series_terms_from_one(x), n0) - L) <= 1 / 3 + 1 / 3
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= 1 / 3 + 1 / 3
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) <= 1 / 3 + 1 / 3 < 1
        abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0)) < 1
        abs(x^(n0 + 1)) = abs(partial_sum(geometric_series_terms_from_one(x), n0 + 1) - partial_sum(geometric_series_terms_from_one(x), n0))
        abs(x^(n0 + 1)) < 1
        1 <= abs(x^(n0 + 1))
        1 < 1
        impossible 1 = 1
thm sequence_limit_unique_cite_from_chap6:
    ? forall b seq(R), M1, M2 R:
        $has_limit(b, M1)
        $has_limit(b, M2)
        =>:
            M1 = M2
    release thm closed_limit_implies_strict_limit(b, M1)
    release thm closed_limit_implies_strict_limit(b, M2)
    release thm chap6::sequence_limit_unique(b, M1, M2)
thm series_sum_unique:
    ? forall a seq(R), L1, L2 R:
        $has_series_sum(a, L1)
        $has_series_sum(a, L2)
        =>:
            L1 = L2
    release thm sequence_limit_unique_cite_from_chap6(fn(k N+) R {partial_sum(a, k)}, L1, L2)
sketch:
    have half_power_terms seq(R) = geometric_series_terms_from_one(1 / 2)
    have two_power_terms seq(R) = geometric_series_terms_from_one(2)
    claim:
        ? forall k N+:
            half_power_terms(k) = 2^(-k)
            two_power_terms(k) = 2^k
        half_power_terms(k) = geometric_series_terms_from_one(1 / 2)(k)
        geometric_series_terms_from_one(1 / 2)(k) = (1 / 2)^k
        2^(-1) = 1 / 2^1
        2^1 = 2
        1 / 2^1 = 1 / 2
        2^(-1) = 1 / 2
        1 / 2 = 2^(-1)
        (1 / 2)^k = (2^(-1))^k
        (2^(-1))^k = 2^((-1) * k)
        (-1) * k = (-k)
        2^((-1) * k) = 2^(-k)
        (1 / 2)^k = 2^(-k)
        half_power_terms(k) = 2^(-k)
        two_power_terms(k) = geometric_series_terms_from_one(2)(k)
        geometric_series_terms_from_one(2)(k) = 2^k
    abs(1 / 2) < 1
    1 - 1 / 2 != 0
    release thm geometric_series_from_one_formula(1 / 2)
    (1 / 2) / (1 - 1 / 2) = 1
    $has_series_sum(geometric_series_terms_from_one(1 / 2), 1)
    $has_series_sum(half_power_terms, 1)
    claim:
        ? not $is_convergent_series(two_power_terms)
        abs(2) >= 1
        release thm geometric_series_from_one_diverges_when_abs_ge_one(2)
        not $is_convergent_series(two_power_terms)
have fn finite_tail_sum(a seq(R), p, q N+) R by cases:
    case q < p: 0
    case q >= p: partial_sum(a, q) - partial_sum(a, p - 1)
prop has_small_tail_sums_after(a seq(R), epsilon R+, n0 N+):
    forall p, q N+:
        p >= n0
        q >= n0
        =>:
            abs(finite_tail_sum(a, p, q)) <= epsilon
prop has_cauchy_series_tails(a seq(R)):
    forall epsilon R+:
        exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
thm series_cauchy_criterion_forward:
    ? forall a seq(R):
        $is_convergent_series(a)
        =>:
            $has_cauchy_series_tails(a)
    thm equal_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    obtain L from $is_convergent_series(a)
    $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        obtain N0 from exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon / 2, N0)}
        witness exist n1 N+ st {$has_small_tail_sums_after(a, epsilon, n1)} from N0 + 1:
            claim:
                ? forall p, q N+:
                    p >= N0 + 1
                    q >= N0 + 1
                    =>:
                        abs(finite_tail_sum(a, p, q)) <= epsilon
                by cases:
                    ? abs(finite_tail_sum(a, p, q)) <= epsilon
                    case q < p:
                        finite_tail_sum(a, p, q) = 0
                    case q >= p:
                        q >= N0 + 1 > N0
                        p - 1 >= (N0 + 1) - 1 = N0 > 0
                        p - 1 > 0
                        p - 1 >= 0
                        p - 1 $in N
                        p - 1 != 0
                        have positive_predecessor N = p - 1
                        positive_predecessor = p - 1
                        positive_predecessor $in N+
                        p - 1 $in N+
                        abs(fn(k N+) R {partial_sum(a, k)}(q) - L) <= epsilon / 2
                        abs(fn(k N+) R {partial_sum(a, k)}(p - 1) - L) <= epsilon / 2
                        fn(k N+) R {partial_sum(a, k)}(q) = partial_sum(a, q)
                        fn(k N+) R {partial_sum(a, k)}(p - 1) = partial_sum(a, p - 1)
                        release thm equal_values_have_equal_distance(partial_sum(a, q), fn(k N+) R {partial_sum(a, k)}(q), L)
                        release thm equal_values_have_equal_distance(partial_sum(a, p - 1), fn(k N+) R {partial_sum(a, k)}(p - 1), L)
                        abs(partial_sum(a, q) - L) = abs(fn(k N+) R {partial_sum(a, k)}(q) - L)
                        abs(partial_sum(a, p - 1) - L) = abs(fn(k N+) R {partial_sum(a, k)}(p - 1) - L)
                        abs(partial_sum(a, q) - L) <= epsilon / 2
                        abs(partial_sum(a, p - 1) - L) <= epsilon / 2
                        finite_tail_sum(a, p, q) = partial_sum(a, q) - partial_sum(a, p - 1)
                        partial_sum(a, q) - partial_sum(a, p - 1) = (partial_sum(a, q) - L) + (L - partial_sum(a, p - 1))
                        abs(finite_tail_sum(a, p, q)) = abs((partial_sum(a, q) - L) + (L - partial_sum(a, p - 1)))
                        abs((partial_sum(a, q) - L) + (L - partial_sum(a, p - 1))) <= abs(partial_sum(a, q) - L) + abs(L - partial_sum(a, p - 1))
                        abs(L - partial_sum(a, p - 1)) = abs(partial_sum(a, p - 1) - L)
                        abs(finite_tail_sum(a, p, q)) <= abs(partial_sum(a, q) - L) + abs(L - partial_sum(a, p - 1))
                        abs(L - partial_sum(a, p - 1)) <= epsilon / 2
                        abs(partial_sum(a, q) - L) + abs(L - partial_sum(a, p - 1)) <= epsilon / 2 + epsilon / 2
                        abs(finite_tail_sum(a, p, q)) <= epsilon / 2 + epsilon / 2 = epsilon
            by def $has_small_tail_sums_after(a, epsilon, N0 + 1)
    by def $has_cauchy_series_tails(a)
release obj def chap5::dist_R
thm real_closeness_is_symmetric:
    ? forall epsilon R+, x, y R:
        $chap5::is_close_in_R(epsilon, x, y)
        =>:
            $chap5::is_close_in_R(epsilon, y, x)
    chap5::dist_R(x, y) = abs(x - y)
    x - y = -(y - x)
    abs(x - y) = abs(-(y - x))
    abs(-(y - x)) = abs(y - x)
    chap5::dist_R(y, x) = abs(y - x)
    chap5::dist_R(y, x) = chap5::dist_R(x, y)
    chap5::dist_R(y, x) <= epsilon
    by def $chap5::is_close_in_R(epsilon, y, x)
thm partial_sums_close_when_first_index_before_second:
    ? forall a seq(R), epsilon R+, n0, j, k N+:
        $has_small_tail_sums_after(a, epsilon, n0)
        j >= n0
        k >= n0
        j < k
        =>:
            $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
    j + 1 $in N+
    j + 1 >= n0
    k >= j + 1
    abs(finite_tail_sum(a, j + 1, k)) <= epsilon
    finite_tail_sum(a, j + 1, k) = partial_sum(a, k) - partial_sum(a, (j + 1) - 1)
    (j + 1) - 1 = j
    partial_sum(a, (j + 1) - 1) = partial_sum(a, j)
    partial_sum(a, k) - partial_sum(a, (j + 1) - 1) = partial_sum(a, k) - partial_sum(a, j)
    finite_tail_sum(a, j + 1, k) = partial_sum(a, k) - partial_sum(a, (j + 1) - 1) = partial_sum(a, k) - partial_sum(a, j)
    finite_tail_sum(a, j + 1, k) = partial_sum(a, k) - partial_sum(a, j)
    abs(finite_tail_sum(a, j + 1, k)) = abs(partial_sum(a, k) - partial_sum(a, j))
    abs(partial_sum(a, k) - partial_sum(a, j)) <= epsilon
    abs(partial_sum(a, j) - partial_sum(a, k)) = abs(-(partial_sum(a, k) - partial_sum(a, j)))
    abs(-(partial_sum(a, k) - partial_sum(a, j))) = abs(partial_sum(a, k) - partial_sum(a, j))
    abs(partial_sum(a, j) - partial_sum(a, k)) <= epsilon
    chap5::dist_R(partial_sum(a, j), partial_sum(a, k)) = abs(partial_sum(a, j) - partial_sum(a, k))
    chap5::dist_R(partial_sum(a, j), partial_sum(a, k)) <= epsilon
    by def $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
thm partial_sums_are_close_after_small_series_tail:
    ? forall a seq(R), epsilon R+, n0, j, k N+:
        $has_small_tail_sums_after(a, epsilon, n0)
        j >= n0
        k >= n0
        =>:
            $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
    by cases:
        ? $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
        case j < k:
            release thm partial_sums_close_when_first_index_before_second(a, epsilon, n0, j, k)
            fn(n N+) R {partial_sum(a, n)}(j) = partial_sum(a, j)
            fn(n N+) R {partial_sum(a, n)}(k) = partial_sum(a, k)
            $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
            $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
        case j >= k:
            k < j or k >= j
            by cases:
                ? $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
                case k < j:
                    release thm partial_sums_close_when_first_index_before_second(a, epsilon, n0, k, j)
                    release thm real_closeness_is_symmetric(epsilon, partial_sum(a, k), partial_sum(a, j))
                    fn(n N+) R {partial_sum(a, n)}(j) = partial_sum(a, j)
                    fn(n N+) R {partial_sum(a, n)}(k) = partial_sum(a, k)
                    $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
                    $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
                case k >= j:
                    j = k
                    fn(n N+) R {partial_sum(a, n)}(j) = partial_sum(a, j)
                    fn(n N+) R {partial_sum(a, n)}(k) = partial_sum(a, k)
                    partial_sum(a, j) = partial_sum(a, k)
                    partial_sum(a, j) - partial_sum(a, j) = 0
                    abs(partial_sum(a, j) - partial_sum(a, j)) = abs(0) = 0
                    chap5::dist_R(partial_sum(a, j), partial_sum(a, j)) = abs(partial_sum(a, j) - partial_sum(a, j)) = 0
                    chap5::dist_R(partial_sum(a, j), partial_sum(a, k)) = chap5::dist_R(partial_sum(a, j), partial_sum(a, j)) = 0
                    0 <= epsilon
                    by def $chap5::is_close_in_R(epsilon, partial_sum(a, j), partial_sum(a, k))
                    $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
thm small_series_tail_gives_partial_sum_cauchy_tail:
    ? forall a seq(R), epsilon R+, n0 N+:
        $has_small_tail_sums_after(a, epsilon, n0)
        =>:
            $chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n0)
    claim:
        ? forall j, k N+:
            j >= n0
            k >= n0
            =>:
                $chap5::is_close_in_R(epsilon, fn(n N+) R {partial_sum(a, n)}(j), fn(n N+) R {partial_sum(a, n)}(k))
        release thm partial_sums_are_close_after_small_series_tail(a, epsilon, n0, j, k)
    by def $chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n0)
thm cauchy_series_tails_make_partial_sums_cauchy_in_R:
    ? forall a seq(R):
        $has_cauchy_series_tails(a)
        =>:
            $chap5::is_cauchy_sequence_in_R(fn(k N+) R {partial_sum(a, k)})
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        release thm small_series_tail_gives_partial_sum_cauchy_tail(a, epsilon, n0)
        witness exist n1 N+ st {$chap5::is_cauchy_tail_in_R(fn(n N+) R {partial_sum(a, n)}, epsilon, n1)} from n0
    by def $chap5::is_cauchy_sequence_in_R(fn(n N+) R {partial_sum(a, n)})
thm nonstrict_real_limit_gives_series_limit:
    ? forall a seq(R), L R:
        $chap5::has_limit_in_R(a, L)
        =>:
            $has_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        epsilon / 2 $in R+
        epsilon / 2 < epsilon
        obtain n0 from exist n0 N+ st {$chap5::is_tail_close_to_in_R(a, L, epsilon / 2, n0)}
        witness exist n1 N+ st {$is_tail_close_to(a, L, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    $chap5::is_close_in_R(epsilon / 2, a(n), L)
                    chap5::dist_R(a(n), L) = abs(a(n) - L)
                    abs(a(n) - L) <= epsilon / 2 < epsilon
                    abs(a(n) - L) < epsilon
                    abs(a(n) - L) <= epsilon
            by def $is_tail_close_to(a, L, epsilon, n0)
    by def $has_limit(a, L)
thm series_cauchy_criterion_reverse:
    ? forall a seq(R):
        $has_cauchy_series_tails(a)
        =>:
            $is_convergent_series(a)
    release thm cauchy_series_tails_make_partial_sums_cauchy_in_R(a)
    release thm chap5::real_cauchy_sequence_has_limit_in_R(fn(k N+) R {partial_sum(a, k)})
    obtain L from exist L R st {$chap5::has_limit_in_R(fn(k N+) R {partial_sum(a, k)}, L)}
    release thm nonstrict_real_limit_gives_series_limit(fn(k N+) R {partial_sum(a, k)}, L)
    witness $is_convergent_series(a) from L:
        $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
        by def $has_series_sum(a, L)
        $has_series_sum(a, L)
thm series_zero_test:
    ? forall a seq(R):
        $is_convergent_series(a)
        =>:
            $has_limit(a, 0)
    release thm series_cauchy_criterion_forward(a)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(a, 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(finite_tail_sum(a, n, n)) <= epsilon
                    finite_tail_sum(a, n, n) = partial_sum(a, n) - partial_sum(a, n - 1)
                    partial_sum(a, n) = partial_sum(a, n - 1) + a(n)
                    partial_sum(a, n) - partial_sum(a, n - 1) = a(n)
                    finite_tail_sum(a, n, n) = a(n)
                    a(n) - 0 = a(n)
                    abs(a(n) - 0) = abs(a(n))
                    abs(finite_tail_sum(a, n, n)) = abs(a(n))
                    abs(a(n) - 0) = abs(finite_tail_sum(a, n, n))
                    abs(a(n) - 0) <= epsilon
            by def $is_tail_close_to(a, 0, epsilon, n0)
            $is_tail_close_to(a, 0, epsilon, n0)
    by def $has_limit(a, 0)
sketch:
    have fn ones_series_terms(k N+) R = 1
    have fn alternating_ones_terms(k N+) R = (-1)^k
    claim:
        ? not $has_limit(ones_series_terms, 0)
        by contra:
            ? not $has_limit(ones_series_terms, 0)
            $has_limit(ones_series_terms, 0)
            1 / 2 $in R+
            obtain n0 from exist n0 N+ st {$is_tail_close_to(ones_series_terms, 0, 1 / 2, n0)}
            n0 >= n0
            abs(ones_series_terms(n0) - 0) <= 1 / 2
            ones_series_terms(n0) = fn(k N+) R {1}(n0)
            fn(k N+) R {1}(n0) = 1
            ones_series_terms(n0) = 1
            ones_series_terms(n0) - 0 = ones_series_terms(n0) = 1
            abs(ones_series_terms(n0) - 0) = abs(1)
            abs(1) = 1
            1 <= 1 / 2
            impossible 1 <= 1 / 2
    claim:
        ? not $is_convergent_series(ones_series_terms)
        by contra:
            ? not $is_convergent_series(ones_series_terms)
            $is_convergent_series(ones_series_terms)
            release thm series_zero_test(ones_series_terms)
            impossible not $has_limit(ones_series_terms, 0)
    claim:
        ? not $has_limit(alternating_ones_terms, 0)
        by contra:
            ? not $has_limit(alternating_ones_terms, 0)
            $has_limit(alternating_ones_terms, 0)
            1 / 2 $in R+
            obtain n0 from exist n0 N+ st {$is_tail_close_to(alternating_ones_terms, 0, 1 / 2, n0)}
            2 * n0 $in N+
            2 * n0 >= n0
            abs(alternating_ones_terms(2 * n0) - 0) <= 1 / 2
            alternating_ones_terms(2 * n0) = fn(k N+) R {(-1)^k}(2 * n0)
            fn(k N+) R {(-1)^k}(2 * n0) = (-1)^(2 * n0)
            (-1)^2 = 1
            ((-1)^2)^n0 = 1^n0
            1^n0 = 1
            ((-1)^2)^n0 = (-1)^(2 * n0)
            (-1)^(2 * n0) = 1
            alternating_ones_terms(2 * n0) = 1
            alternating_ones_terms(2 * n0) - 0 = 1
            abs(alternating_ones_terms(2 * n0) - 0) = abs(1)
            abs(1) = 1
            1 <= 1 / 2
            impossible 1 <= 1 / 2
    claim:
        ? not $is_convergent_series(alternating_ones_terms)
        by contra:
            ? not $is_convergent_series(alternating_ones_terms)
            $is_convergent_series(alternating_ones_terms)
            release thm series_zero_test(alternating_ones_terms)
            impossible not $has_limit(alternating_ones_terms, 0)
prop is_absolutely_convergent_series(a seq(R)):
    $is_convergent_series(fn(j N+) R {abs(a(j))})
thm partial_sum_abs_matches_finite_sum:
    ? forall a seq(R), k N+:
        partial_sum(fn(j N+) R {abs(a(j))}, k) = sum(1, k, fn(i_index N+) R {abs(a(i_index))})
    release thm partial_sum_matches_finite_sum(fn(j N+) R {abs(a(j))}, k)
    release thm sum_le_sum_from_pointwise(sum(1, k, fn(index N+) R {fn(j N+) R {abs(a(j))}(index)}), sum(1, k, fn(index N+) R {abs(a(index))}))
    release thm sum_le_sum_from_pointwise(sum(1, k, fn(index N+) R {abs(a(index))}), sum(1, k, fn(index N+) R {fn(j N+) R {abs(a(j))}(index)}))
    sum(1, k, fn(index N+) R {fn(j N+) R {abs(a(j))}(index)}) = sum(1, k, fn(index N+) R {abs(a(index))})
    partial_sum(fn(j N+) R {abs(a(j))}, k) = sum(1, k, fn(index N+) R {fn(j N+) R {abs(a(j))}(index)}) = sum(1, k, fn(index N+) R {abs(a(index))})
thm finite_sum_abs_nonnegative:
    ? forall a seq(R), p, q N+:
        p <= q
        =>:
            sum(p, q, fn(i_index N+) R {abs(a(i_index))}) >= 0
    forall i_index N+:
        p <= i_index <= q
        =>:
            0 <= abs(a(i_index))
    release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {0}), sum(p, q, fn(i_index N+) R {abs(a(i_index))}))
    sum(p, q, fn(i_index N+) R {0}) <= sum(p, q, fn(i_index N+) R {abs(a(i_index))})
    forall i_index N+:
        p <= i_index <= q
        =>:
            0 = 0 * 1
            0 <= 0 * 1
            0 * 1 <= 0
    release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {0}), sum(p, q, fn(i_index N+) R {0 * 1}))
    release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {0 * 1}), sum(p, q, fn(i_index N+) R {0}))
    sum(p, q, fn(i_index N+) R {0}) <= sum(p, q, fn(i_index N+) R {0 * 1})
    sum(p, q, fn(i_index N+) R {0 * 1}) <= sum(p, q, fn(i_index N+) R {0})
    sum(p, q, fn(i_index N+) R {0}) = sum(p, q, fn(i_index N+) R {0 * 1})
    release thm finite_series_scalar_mul_positive_range(fn(i_index N+) R {1}, 0, p, q)
    sum(p, q, fn(i_index N+) R {0 * 1}) = 0 * sum(p, q, fn(i_index N+) R {1}) = 0
    sum(p, q, fn(i_index N+) R {0}) = sum(p, q, fn(i_index N+) R {0 * 1}) = 0
    0 <= sum(p, q, fn(i_index N+) R {abs(a(i_index))})
thm finite_tail_matches_finite_sum:
    ? forall a seq(R), p, q N+:
        p <= q
        =>:
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
    thm subtract_addend_from_total:
        ? forall total, part, tail R:
            total = part + tail
            =>:
                total - part = tail
    p >= 1
    by cases:
        ? finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
        case p = 1:
            p - 1 = 0
            partial_sum(a, 0) = 0
            finite_tail_sum(a, p, q) = partial_sum(a, q) - partial_sum(a, p - 1)
            partial_sum(a, p - 1) = 0
            partial_sum(a, q) - partial_sum(a, p - 1) = partial_sum(a, q) - 0
            partial_sum(a, q) - 0 = partial_sum(a, q)
            finite_tail_sum(a, p, q) = partial_sum(a, q)
            release thm partial_sum_matches_finite_sum(a, q)
            partial_sum(a, q) = sum(1, q, fn(i_index N+) R {a(i_index)})
            release thm sum_le_sum_from_pointwise(sum(1, q, fn(i_index N+) R {a(i_index)}), sum(p, q, fn(i_index N+) R {a(i_index)}))
            release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {a(i_index)}), sum(1, q, fn(i_index N+) R {a(i_index)}))
            sum(1, q, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(a, p, q) = partial_sum(a, q) = sum(1, q, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
        case p > 1:
            finite_tail_sum(a, p, q) = partial_sum(a, q) - partial_sum(a, p - 1)
            p - 1 >= 1 > 0
            p - 1 >= 0
            p - 1 $in N
            p - 1 != 0
            p - 1 $in N+
            p - 1 < p <= q
            p - 1 < q
            release thm partial_sum_split_after(a, p - 1, q)
            (p - 1) + 1 = p
            partial_sum(a, q) = partial_sum(a, p - 1) + sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)})
            release thm sum_le_sum_from_pointwise(sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}), sum(p, q, fn(i_index N+) R {a(i_index)}))
            release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {a(i_index)}), sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}))
            sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, p - 1) + sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}) = partial_sum(a, p - 1) + sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, q) = partial_sum(a, p - 1) + sum((p - 1) + 1, q, fn(i_index N+) R {a(i_index)}) = partial_sum(a, p - 1) + sum(p, q, fn(i_index N+) R {a(i_index)})
            partial_sum(a, q) = partial_sum(a, p - 1) + sum(p, q, fn(i_index N+) R {a(i_index)})
            release thm subtract_addend_from_total(partial_sum(a, q), partial_sum(a, p - 1), sum(p, q, fn(i_index N+) R {a(i_index)}))
            partial_sum(a, q) - partial_sum(a, p - 1) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
thm finite_tail_abs_nonnegative:
    ? forall a seq(R), p, q N+:
        fn(j N+) R {abs(a(j))} $in seq(R)
        =>:
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) >= 0
    thm equality_preserves_nonnegative:
        ? forall left, right R:
            left = right
            right >= 0
            =>:
                left >= 0
    by cases:
        ? finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) >= 0
        case q < p:
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = 0
            release thm equality_preserves_nonnegative(finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q), 0)
        case q >= p:
            release thm finite_tail_matches_finite_sum(fn(j N+) R {abs(a(j))}, p, q)
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)})
            release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}), sum(p, q, fn(i_index N+) R {abs(a(i_index))}))
            release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {abs(a(i_index))}), sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}))
            sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            release thm finite_sum_abs_nonnegative(a, p, q)
            release thm equality_preserves_nonnegative(finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q), sum(p, q, fn(i_index N+) R {abs(a(i_index))}))
thm finite_tail_abs_bound:
    ? forall a seq(R), p, q N+:
        fn(j N+) R {abs(a(j))} $in seq(R)
        =>:
            abs(finite_tail_sum(a, p, q)) <= finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q)
    thm triangle_bound_by_equal_values:
        ? forall left, right, upper, bound R:
            left = right
            abs(right) <= upper
            upper = bound
            =>:
                abs(left) <= bound
        abs(left) = abs(right)
        abs(left) = abs(right) <= upper = bound
    thm positive_range_triangle:
        ? forall mapping seq(R), lower, upper N+:
            lower <= upper
            =>:
                abs(sum(lower, upper, fn(i_index N+) R {mapping(i_index)})) <= sum(lower, upper, fn(i_index N+) R {abs(mapping(i_index))})
        thm abs_of_equal_real_values:
            ? forall left_value, right_value R:
                left_value = right_value
                =>:
                    abs(left_value) = abs(right_value)
        claim:
            ? forall index lower...upper:
                index $in N+
            index $in Z
            lower <= index
            1 <= lower <= index
            0 < 1 <= index
            0 < index
            index $in N+
        have fn restricted(index lower...upper) R = mapping(index)
        claim:
            ? forall index lower...upper:
                fn(i_index N+) R {mapping(i_index)}(index) = restricted(index)
            fn(i_index N+) R {mapping(i_index)}(index) = mapping(index) = restricted(index)
        claim:
            ? forall index lower...upper:
                fn(i_index N+) R {abs(mapping(i_index))}(index) = fn(i_index lower...upper) R {abs(restricted(i_index))}(index)
            mapping(index) = restricted(index)
            release thm abs_of_equal_real_values(mapping(index), restricted(index))
            fn(i_index N+) R {abs(mapping(i_index))}(index) = abs(mapping(index)) = abs(restricted(index)) = fn(i_index lower...upper) R {abs(restricted(i_index))}(index)
        claim:
            ? forall index lower...upper:
                abs(mapping(index)) = abs(restricted(index))
            mapping(index) = restricted(index)
            release thm abs_of_equal_real_values(mapping(index), restricted(index))
        release thm finite_set_sum_substitution(finite_set_sum(lower...upper, fn(i_index N+) R {mapping(i_index)}), finite_set_sum(lower...upper, restricted))
        release thm finite_set_sum_substitution(finite_set_sum(lower...upper, fn(i_index N+) R {abs(mapping(i_index))}), finite_set_sum(lower...upper, fn(i_index lower...upper) R {abs(restricted(i_index))}))
        sum(lower, upper, fn(i_index N+) R {mapping(i_index)}) = finite_set_sum(lower...upper, fn(i_index N+) R {mapping(i_index)}) = finite_set_sum(lower...upper, restricted)
        sum(lower, upper, fn(i_index N+) R {abs(mapping(i_index))}) = finite_set_sum(lower...upper, fn(i_index N+) R {abs(mapping(i_index))}) = finite_set_sum(lower...upper, fn(i_index lower...upper) R {abs(restricted(i_index))})
        abs(finite_set_sum(lower...upper, restricted)) <= finite_set_sum(lower...upper, fn(i_index lower...upper) R {abs(restricted(i_index))})
        release thm abs_of_equal_real_values(sum(lower, upper, fn(i_index N+) R {mapping(i_index)}), finite_set_sum(lower...upper, restricted))
        abs(sum(lower, upper, fn(i_index N+) R {mapping(i_index)})) = abs(finite_set_sum(lower...upper, restricted)) <= finite_set_sum(lower...upper, fn(i_index lower...upper) R {abs(restricted(i_index))}) = sum(lower, upper, fn(i_index N+) R {abs(mapping(i_index))})
    by cases:
        ? abs(finite_tail_sum(a, p, q)) <= finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q)
        case q < p:
            finite_tail_sum(a, p, q) = 0
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = 0
            release thm triangle_bound_by_equal_values(finite_tail_sum(a, p, q), 0, 0, finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q))
        case q >= p:
            release thm finite_tail_matches_finite_sum(a, p, q)
            release thm finite_tail_matches_finite_sum(fn(j N+) R {abs(a(j))}, p, q)
            finite_tail_sum(a, p, q) = sum(p, q, fn(i_index N+) R {a(i_index)})
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)})
            release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}), sum(p, q, fn(i_index N+) R {abs(a(i_index))}))
            release thm sum_le_sum_from_pointwise(sum(p, q, fn(i_index N+) R {abs(a(i_index))}), sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}))
            sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) = sum(p, q, fn(i_index N+) R {fn(j N+) R {abs(a(j))}(i_index)}) = sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            release thm positive_range_triangle(a, p, q)
            abs(sum(p, q, fn(i_index N+) R {a(i_index)})) <= sum(p, q, fn(i_index N+) R {abs(a(i_index))})
            release thm triangle_bound_by_equal_values(finite_tail_sum(a, p, q), sum(p, q, fn(i_index N+) R {a(i_index)}), sum(p, q, fn(i_index N+) R {abs(a(i_index))}), finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q))
thm absolute_tail_control:
    ? forall a seq(R), epsilon R+, n0 N+:
        $has_small_tail_sums_after(fn(j N+) R {abs(a(j))}, epsilon, n0)
        =>:
            $has_small_tail_sums_after(a, epsilon, n0)
    release thm fn_set_member(fn(j N+) R {abs(a(j))}, fn(index N+) R)
    thm real_value_below_its_absolute_value:
        ? forall value R:
            value <= abs(value)
        by cases:
            ? value <= abs(value)
            case value >= 0:
                abs(value) = value
                value <= abs(value)
            case value < 0:
                -value > 0
                abs(value) = -value
                value < 0 < -value = abs(value)
    claim:
        ? forall p, q N+:
            p >= n0
            q >= n0
            =>:
                abs(finite_tail_sum(a, p, q)) <= epsilon
        abs(finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q)) <= epsilon
        release thm finite_tail_abs_bound(a, p, q)
        release thm real_value_below_its_absolute_value(finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q))
        abs(finite_tail_sum(a, p, q)) <= finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q) <= abs(finite_tail_sum(fn(j N+) R {abs(a(j))}, p, q)) <= epsilon
    by def $has_small_tail_sums_after(a, epsilon, n0)
thm absolute_convergence_test:
    ? forall a seq(R):
        $is_absolutely_convergent_series(a)
        =>:
            $is_convergent_series(a)
    $is_convergent_series(fn(j N+) R {abs(a(j))})
    release thm series_cauchy_criterion_forward(fn(j N+) R {abs(a(j))})
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$has_small_tail_sums_after(a, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$has_small_tail_sums_after(fn(j N+) R {abs(a(j))}, epsilon, n0)}
        release thm absolute_tail_control(a, epsilon, n0)
        witness exist n1 N+ st {$has_small_tail_sums_after(a, epsilon, n1)} from n0:
            $has_small_tail_sums_after(a, epsilon, n0)
    by def $has_cauchy_series_tails(a)
    $has_cauchy_series_tails(a)
    release thm series_cauchy_criterion_reverse(a)
thm partial_sum_triangle_bound:
    ? forall a seq(R), n N+:
        fn(j N+) R {abs(a(j))} $in seq(R)
        =>:
            abs(partial_sum(a, n)) <= partial_sum(fn(j N+) R {abs(a(j))}, n)
    thm triangle_bound_by_equal_values:
        ? forall left, right, upper, bound R:
            left = right
            abs(right) <= upper
            upper = bound
            =>:
                abs(left) <= bound
        abs(left) = abs(right)
        abs(left) = abs(right) <= upper = bound
    thm subtract_zero_value:
        ? forall total, zero R:
            zero = 0
            =>:
                total - zero = total
    1 <= n
    release thm finite_tail_abs_bound(a, 1, n)
    partial_sum(a, 0) = 0
    finite_tail_sum(a, 1, n) = partial_sum(a, n) - partial_sum(a, 1 - 1) = partial_sum(a, n) - partial_sum(a, 0) = partial_sum(a, n) - 0 = partial_sum(a, n)
    partial_sum(fn(j N+) R {abs(a(j))}, 1 - 1) = 0
    release thm subtract_zero_value(partial_sum(fn(j N+) R {abs(a(j))}, n), partial_sum(fn(j N+) R {abs(a(j))}, 1 - 1))
    finite_tail_sum(fn(j N+) R {abs(a(j))}, 1, n) = partial_sum(fn(j N+) R {abs(a(j))}, n) - partial_sum(fn(j N+) R {abs(a(j))}, 1 - 1) = partial_sum(fn(j N+) R {abs(a(j))}, n)
    release thm triangle_bound_by_equal_values(partial_sum(a, n), finite_tail_sum(a, 1, n), finite_tail_sum(fn(j N+) R {abs(a(j))}, 1, n), partial_sum(fn(j N+) R {abs(a(j))}, n))
thm absolute_convergence_triangle_bound:
    ? forall a seq(R), L, A R:
        $has_series_sum(a, L)
        $has_series_sum(fn(j N+) R {abs(a(j))}, A)
        =>:
            abs(L) <= A
    thm absolute_limit_comparison:
        ? forall lower_terms, upper_terms seq(R), lower_limit, upper_limit R:
            $chap6::has_limit(lower_terms, lower_limit)
            $chap6::has_limit(upper_terms, upper_limit)
            forall n N+:
                abs(lower_terms(n)) <= upper_terms(n)
            =>:
                abs(lower_limit) <= upper_limit
        by contra:
            ? abs(lower_limit) <= upper_limit
            abs(lower_limit) > upper_limit
            abs(lower_limit) - upper_limit > 0
            have gap R+ = abs(lower_limit) - upper_limit
            0 < gap / 4
            gap / 4 $in R+
            obtain n1 from $chap6::has_eventual_closeness_to(lower_terms, lower_limit, gap / 4)
            obtain n2 from $chap6::has_eventual_closeness_to(upper_terms, upper_limit, gap / 4)
            have n N+ = n1 + n2
            n >= n1
            n >= n2
            abs(lower_terms(n) - lower_limit) < gap / 4
            abs(upper_terms(n) - upper_limit) < gap / 4
            lower_limit - lower_terms(n) = -(lower_terms(n) - lower_limit)
            abs(lower_limit - lower_terms(n)) = abs(-(lower_terms(n) - lower_limit)) = abs(lower_terms(n) - lower_limit)
            abs(lower_terms(n)) <= upper_terms(n)
            upper_terms(n) - upper_limit <= abs(upper_terms(n) - upper_limit)
            upper_terms(n) = (upper_terms(n) - upper_limit) + upper_limit <= abs(upper_terms(n) - upper_limit) + upper_limit = upper_limit + abs(upper_terms(n) - upper_limit)
            lower_limit = (lower_limit - lower_terms(n)) + lower_terms(n)
            abs(lower_limit) = abs((lower_limit - lower_terms(n)) + lower_terms(n)) <= abs(lower_limit - lower_terms(n)) + abs(lower_terms(n))
            abs(lower_limit) <= abs(lower_limit - lower_terms(n)) + abs(lower_terms(n)) <= abs(lower_limit - lower_terms(n)) + upper_terms(n) <= abs(lower_limit - lower_terms(n)) + (upper_limit + abs(upper_terms(n) - upper_limit)) = abs(lower_limit - lower_terms(n)) + upper_limit + abs(upper_terms(n) - upper_limit)
            abs(lower_limit - lower_terms(n)) + upper_limit + abs(upper_terms(n) - upper_limit) < gap / 4 + upper_limit + gap / 4 = upper_limit + gap / 2
            abs(lower_limit) < upper_limit + gap / 2
            gap = abs(lower_limit) - upper_limit
            upper_limit + gap = upper_limit + (abs(lower_limit) - upper_limit) = abs(lower_limit)
            abs(lower_limit) = upper_limit + gap
            upper_limit + gap < upper_limit + gap / 2
            gap = (upper_limit + gap) - upper_limit < (upper_limit + gap / 2) - upper_limit = gap / 2
            gap / 2 = gap - gap / 2 < gap / 2 - gap / 2 = 0
            0 < gap / 2
            impossible 0 < gap / 2
    have partials seq(R) = fn(k N+) R {partial_sum(a, k)}
    have absolute_partials seq(R) = fn(k N+) R {partial_sum(fn(j N+) R {abs(a(j))}, k)}
    $has_limit(partials, L)
    $has_limit(absolute_partials, A)
    release thm closed_limit_implies_strict_limit(partials, L)
    release thm closed_limit_implies_strict_limit(absolute_partials, A)
    claim:
        ? forall n N+:
            abs(partials(n)) <= absolute_partials(n)
        partials(n) = partial_sum(a, n)
        absolute_partials(n) = partial_sum(fn(j N+) R {abs(a(j))}, n)
        release thm partial_sum_triangle_bound(a, n)
        abs(partials(n)) = abs(partial_sum(a, n))
        abs(partials(n)) = abs(partial_sum(a, n)) <= partial_sum(fn(j N+) R {abs(a(j))}, n) = absolute_partials(n)
    by thm absolute_limit_comparison(partials, absolute_partials, L, A) => abs(L) <= A
prop is_only_conditionally_convergent_series(a seq(R)):
    $is_convergent_series(a)
    not $is_absolutely_convergent_series(a)
prop is_nonnegative_sequence(a seq(R)):
    forall n N+:
        a(n) >= 0
prop is_decreasing_sequence(a seq(R)):
    forall n N+:
        n + 1 $in N+
        =>:
            a(n + 1) <= a(n)
thm decreasing_seq_le_add:
    ? forall a seq(R), h N, n N+:
        n + h $in N+
        $is_decreasing_sequence(a)
        =>:
            a(n + h) <= a(n)
    by induc h from 0:
        ? a(n + h) <= a(n)
        ? from h = 0:
            n + 0 = n
            a(n + 0) = a(n)
            a(n + 0) <= a(n)
        ? induc:
            n >= 1
            h >= 0
            n + h >= 1
            n + h $in N+
            n + h + 1 >= 1
            n + h + 1 $in N+
            a(n + h + 1) <= a(n + h) <= a(n)
            n + (h + 1) = n + h + 1
            a(n + (h + 1)) = a(n + h + 1) <= a(n)
thm decreasing_seq_le_of_le:
    ? forall a seq(R), m, n N+:
        $is_decreasing_sequence(a)
        m <= n
        =>:
            a(n) <= a(m)
    n - m $in N
    m + (n - m) = n
    release thm decreasing_seq_le_add(a, n - m, m)
    a(n) = a(m + (n - m))
thm decreasing_finite_block_upper_by_left_endpoint:
    ? forall a seq(R), m, n N+:
        $is_decreasing_sequence(a)
        m <= n
        =>:
            sum(m, n, fn(i_index N+) R {a(i_index)}) <= sum(m, n, fn(i_index N+) R {a(m)})
    forall i_index N+:
        m <= i_index <= n
        =>:
            a(i_index) <= a(m)
    release thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index N+) R {a(i_index)}), sum(m, n, fn(i_index N+) R {a(m)}))
thm decreasing_finite_block_lower_by_right_endpoint:
    ? forall a seq(R), m, n N+:
        $is_decreasing_sequence(a)
        m <= n
        =>:
            sum(m, n, fn(i_index N+) R {a(n)}) <= sum(m, n, fn(i_index N+) R {a(i_index)})
    forall i_index N+:
        m <= i_index <= n
        =>:
            a(n) <= a(i_index)
    release thm sum_le_sum_from_pointwise(sum(m, n, fn(i_index N+) R {a(n)}), sum(m, n, fn(i_index N+) R {a(i_index)}))
thm nonnegative_partial_sum_le_add:
    ? forall a seq(R), h N, n N+:
        $is_nonnegative_sequence(a)
        =>:
            partial_sum(a, n) <= partial_sum(a, n + h)
    thm addition_preserves_equality:
        ? forall left, right, extra R:
            left = right
            =>:
                left + extra = right + extra
    by induc h from 0:
        ? partial_sum(a, n) <= partial_sum(a, n + h)
        ? from h = 0:
            n + 0 = n
            partial_sum(a, n + 0) = partial_sum(a, n)
            partial_sum(a, n) <= partial_sum(a, n + 0)
        ? induc:
            partial_sum(a, n) <= partial_sum(a, n + h)
            n + h $in N+
            n + h + 1 $in N+
            (n + h + 1) - 1 = n + h
            partial_sum(a, (n + h + 1) - 1) = partial_sum(a, n + h)
            release thm addition_preserves_equality(partial_sum(a, (n + h + 1) - 1), partial_sum(a, n + h), a(n + h + 1))
            release thm partial_sum_successor(a, n + h + 1)
            partial_sum(a, n + h + 1) = partial_sum(a, n + h) + a(n + h + 1)
            a(n + h + 1) >= 0
            partial_sum(a, n + h) <= partial_sum(a, n + h) + a(n + h + 1)
            partial_sum(a, n) <= partial_sum(a, n + h) <= partial_sum(a, n + h + 1)
            n + (h + 1) = n + h + 1
            partial_sum(a, n + (h + 1)) = partial_sum(a, n + h + 1)
            partial_sum(a, n) <= partial_sum(a, n + (h + 1))
thm nonnegative_partial_sum_le_of_le:
    ? forall a seq(R), m, n N+:
        $is_nonnegative_sequence(a)
        m <= n
        =>:
            partial_sum(a, m) <= partial_sum(a, n)
    n - m $in N
    m + (n - m) = n
    release thm nonnegative_partial_sum_le_add(a, n - m, m)
    partial_sum(a, m + (n - m)) = partial_sum(a, n)
have fn harmonic_terms(k N+) R = 1 / k
thm harmonic_term_nonnegative:
    ? forall n N+:
        harmonic_terms(n) = 1 / n
        1 / n > 0
        =>:
            harmonic_terms(n) >= 0
    harmonic_terms(n) = 1 / n
    1 / n > 0
thm harmonic_term_decreases:
    ? forall n N+:
        n + 1 $in N+
        harmonic_terms(n + 1) = 1 / (n + 1)
        harmonic_terms(n) = 1 / n
        =>:
            harmonic_terms(n + 1) <= harmonic_terms(n)
    harmonic_terms(n + 1) = 1 / (n + 1)
    harmonic_terms(n) = 1 / n
    n * (n + 1) > 0
    1 / (n + 1) = n / (n * (n + 1))
    1 / n = (n + 1) / (n * (n + 1))
    n <= n + 1
    n / (n * (n + 1)) <= (n + 1) / (n * (n + 1))
claim:
    ? $is_nonnegative_sequence(harmonic_terms)
    forall n N+:
        harmonic_terms(n) = 1 / n
        1 / n > 0
        harmonic_terms(n) >= 0
    by def $is_nonnegative_sequence(harmonic_terms)
claim:
    ? $is_decreasing_sequence(harmonic_terms)
    claim:
        ? forall n N+:
            n + 1 $in N+
            =>:
                harmonic_terms(n + 1) <= harmonic_terms(n)
        release thm harmonic_term_decreases(n)
    by def $is_decreasing_sequence(harmonic_terms)
thm two_power_at_least_index:
    ? forall K N+:
        2^K >= K
    by induc K from 1:
        ? 2^K >= K
        ? from K = 1:
            2^1 = 2 >= 1
        ? induc:
            2^K >= K
            2^(K + 1) = 2^K * 2
            2^K * 2 = 2^K + 2^K
            2^K >= 1
            2^K + 2^K >= K + 1
            2^(K + 1) >= K + 1
thm harmonic_dyadic_partial_sum_lower_bound:
    ? forall K N+:
        partial_sum(harmonic_terms, 2^K) >= 1 + K / 2
    thm combine_two_lower_bounds:
        ? forall total, prefix, block, lower_prefix_bound R:
            total = prefix + block
            prefix >= lower_prefix_bound
            block >= 1 / 2
            =>:
                total >= lower_prefix_bound + 1 / 2
        prefix + block >= lower_prefix_bound + 1 / 2
    thm quotient_equal_denominator:
        ? forall numerator, left, right R:
            left = right
            left != 0
            right != 0
            =>:
                numerator / left = numerator / right
    by induc K from 1:
        ? partial_sum(harmonic_terms, 2^K) >= 1 + K / 2
        ? from K = 1:
            2^1 = 2
            harmonic_terms(1) = 1 / 1 = 1
            harmonic_terms(2) = 1 / 2
            partial_sum(harmonic_terms, 0) = 0
            release thm partial_sum_successor(harmonic_terms, 1)
            partial_sum(harmonic_terms, 1) = partial_sum(harmonic_terms, 0) + harmonic_terms(1) = 0 + 1 = 1
            release thm partial_sum_successor(harmonic_terms, 2)
            partial_sum(harmonic_terms, 2) = partial_sum(harmonic_terms, 1) + harmonic_terms(2) = 1 + 1 / 2
            partial_sum(harmonic_terms, 2^1) = partial_sum(harmonic_terms, 2) = 1 + 1 / 2
        ? induc:
            2^K $in N+
            2^(K + 1) $in N+
            2^K + 1 $in N+
            2^K >= 1
            2^K > 0
            2^(K + 1) = 2^K * 2 = 2^K + 2^K > 2^K + 0 = 2^K
            2^(K + 1) = 2^K + 2^K >= 2^K + 1
            have c R = 1 / 2^(K + 1)
            claim:
                ? forall i_index N+:
                    2^K + 1 <= i_index <= 2^(K + 1)
                    =>:
                        c <= harmonic_terms(i_index)
                i_index > 0
                2^(K + 1) > 0
                2^(K + 1) * i_index > 0
                1 / 2^(K + 1) = i_index / (2^(K + 1) * i_index)
                1 / i_index = 2^(K + 1) / (2^(K + 1) * i_index)
                i_index / (2^(K + 1) * i_index) <= 2^(K + 1) / (2^(K + 1) * i_index)
                c = 1 / 2^(K + 1) <= 1 / i_index = harmonic_terms(i_index)
            release thm sum_le_sum_from_pointwise(sum(2^K + 1, 2^(K + 1), fn(i_index N+) R {c}), sum(2^K + 1, 2^(K + 1), fn(i_index N+) R {harmonic_terms(i_index)}))
            sum(2^K + 1, 2^(K + 1), fn(i_index N+) R {c}) = (2^(K + 1) - (2^K + 1) + 1) * c
            2^(K + 1) - (2^K + 1) + 1 = (2^K + 2^K) - (2^K + 1) + 1 = 2^K
            c = 1 / 2^(K + 1)
            2^(K + 1) > 0
            2^(K + 1) != 0
            2^K * 2 > 0
            2^K * 2 != 0
            release thm quotient_equal_denominator(2^K, 2^(K + 1), 2^K * 2)
            2^K * c = 2^K * (1 / 2^(K + 1)) = 2^K / 2^(K + 1) = 2^K / (2^K * 2) = 1 / 2
            sum(2^K + 1, 2^(K + 1), fn(i_index N+) R {c}) = 1 / 2
            sum(2^K + 1, 2^(K + 1), fn(i_index N+) R {harmonic_terms(i_index)}) >= 1 / 2
            release thm partial_sum_split_after(harmonic_terms, 2^K, 2^(K + 1))
            release thm combine_two_lower_bounds(partial_sum(harmonic_terms, 2^(K + 1)), partial_sum(harmonic_terms, 2^K), sum(2^K + 1, 2^(K + 1), fn(i_index N+) R {harmonic_terms(i_index)}), 1 + K / 2)
            (1 + K / 2) + 1 / 2 = 1 + (K + 1) / 2
            partial_sum(harmonic_terms, 2^(K + 1)) >= 1 + (K + 1) / 2
claim:
    ? not $is_convergent_series(harmonic_terms)
    thm value_below_absolute_value:
        ? forall value R:
            value <= abs(value)
        by cases:
            ? value <= abs(value)
            case value >= 0:
                abs(value) = value
            case value < 0:
                -value > 0
                abs(value) = -value
                value < 0 < -value = abs(value)
    thm addition_preserves_upper_bound:
        ? forall left, right, extra R:
            left <= right
            =>:
                extra + left <= extra + right
    thm addition_preserves_strict_lower_bound:
        ? forall left, right, extra R:
            left > right
            =>:
                extra + left > extra + right
    thm closed_unit_closeness_bounds_value:
        ? forall value, limit R:
            abs(value - limit) <= 1
            =>:
                value <= limit + 1
        release thm value_below_absolute_value(value - limit)
        release thm addition_preserves_upper_bound(value - limit, abs(value - limit), limit)
        release thm addition_preserves_upper_bound(abs(value - limit), 1, limit)
        value = limit + (value - limit) <= limit + abs(value - limit) <= limit + 1
    by contra:
        ? not $is_convergent_series(harmonic_terms)
        obtain L from exist L R st {$has_series_sum(harmonic_terms, L)}
        $has_limit(fn(k N+) R {partial_sum(harmonic_terms, k)}, L)
        obtain cutoff from exist cutoff N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(harmonic_terms, k)}, L, 1, cutoff)}
        release thm real_archimedean_natural_upper_bound(cutoff + 2 * abs(L) + 4)
        obtain K from exist K N+ st {cutoff + 2 * abs(L) + 4 < K}
        abs(L) >= 0
        cutoff >= 1
        2 * abs(L) >= 0
        2 * abs(L) + 4 >= 0
        release thm addition_preserves_upper_bound(0, 2 * abs(L) + 4, cutoff)
        cutoff + 2 * abs(L) + 4 = cutoff + (2 * abs(L) + 4) >= cutoff + 0 = cutoff
        K > cutoff + 2 * abs(L) + 4 >= cutoff
        K >= cutoff
        release thm two_power_at_least_index(K)
        2^K $in N+
        2^K >= K >= cutoff
        abs(fn(k N+) R {partial_sum(harmonic_terms, k)}(2^K) - L) <= 1
        release thm closed_unit_closeness_bounds_value(fn(k N+) R {partial_sum(harmonic_terms, k)}(2^K), L)
        partial_sum(harmonic_terms, 2^K) = fn(k N+) R {partial_sum(harmonic_terms, k)}(2^K) <= L + 1
        release thm harmonic_dyadic_partial_sum_lower_bound(K)
        0 <= cutoff
        release thm addition_preserves_upper_bound(0, cutoff, 2 * abs(L) + 4)
        cutoff + 2 * abs(L) + 4 = (2 * abs(L) + 4) + cutoff >= (2 * abs(L) + 4) + 0 = 2 * abs(L) + 4
        K > 2 * abs(L) + 4
        K / 2 > (2 * abs(L) + 4) / 2 = abs(L) + 2
        release thm value_below_absolute_value(L)
        release thm addition_preserves_strict_lower_bound(K / 2, abs(L) + 2, 1)
        release thm addition_preserves_upper_bound(L, abs(L), 3)
        release thm addition_preserves_strict_lower_bound(3, 1, L)
        1 + K / 2 > 1 + (abs(L) + 2) = abs(L) + 3 = 3 + abs(L) >= 3 + L = L + 3 > L + 1
        partial_sum(harmonic_terms, 2^K) >= 1 + K / 2 > L + 1
        impossible partial_sum(harmonic_terms, 2^K) > L + 1
have fn alternating_series_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {(-1)^j * a(j)}
thm alternating_sign_abs_one:
    ? forall n N+:
        abs((-1)^n) = 1
    by induc n from 1:
        ? abs((-1)^n) = 1
        ? from n = 1:
            (-1)^1 = (-1)
            abs((-1)^1) = abs(-1)
            abs(-1) = 1
        ? induc:
            abs((-1)^n) = 1
            (-1)^(n + 1) = (-1)^n * (-1)
            abs((-1)^(n + 1)) = abs((-1)^n * (-1))
            abs((-1)^n * (-1)) = abs((-1)^n) * abs(-1)
            abs(-1) = 1
            abs((-1)^n) * abs(-1) = 1 * 1
            1 * 1 = 1
            abs((-1)^(n + 1)) = 1
thm alternating_sign_value_cases:
    ? forall h N:
        (-1)^h = 1 or (-1)^h = (-1)
    by induc h from 0:
        ? (-1)^h = 1 or (-1)^h = (-1)
        ? from h = 0:
            (-1)^0 = 1
        ? induc:
            (-1)^h = 1 or (-1)^h = (-1)
            (-1)^(h + 1) = (-1)^h * (-1)
            by cases:
                ? (-1)^(h + 1) = 1 or (-1)^(h + 1) = (-1)
                case (-1)^h = 1:
                    (-1)^h * (-1) = 1 * (-1)
                    1 * (-1) = (-1)
                    (-1)^(h + 1) = (-1)
                case (-1)^h = (-1):
                    (-1)^h * (-1) = (-1) * (-1)
                    (-1) * (-1) = 1
                    (-1)^(h + 1) = 1
thm alternating_sign_square_one:
    ? forall p N:
        (-1)^p * (-1)^p = 1
    release thm alternating_sign_value_cases(p)
    by cases:
        ? (-1)^p * (-1)^p = 1
        case (-1)^p = 1:
            (-1)^p * (-1)^p = 1 * 1 = 1
        case (-1)^p = (-1):
            (-1)^p * (-1)^p = (-1) * (-1) = 1
thm normalized_alternating_term:
    ? forall a seq(R), p N+, h N:
        (-1)^p * alternating_series_terms(a)(p + h + 1) = (-1)^(h + 1) * a(p + h + 1)
    thm multiplication_preserves_equal_real_values:
        ? forall factor, left_value, right_value R:
            left_value = right_value
            =>:
                factor * left_value = factor * right_value
    p + h + 1 $in N+
    h + 1 $in N+
    p + h + 1 = p + (h + 1)
    (-1)^(p + h + 1) = (-1)^(p + (h + 1)) = (-1)^p * (-1)^(h + 1)
    alternating_series_terms(a)(p + h + 1) = (-1)^(p + h + 1) * a(p + h + 1)
    release thm multiplication_preserves_equal_real_values(a(p + h + 1), (-1)^(p + h + 1), (-1)^p * (-1)^(h + 1))
    (-1)^(p + h + 1) * a(p + h + 1) = ((-1)^p * (-1)^(h + 1)) * a(p + h + 1)
    alternating_series_terms(a)(p + h + 1) = ((-1)^p * (-1)^(h + 1)) * a(p + h + 1)
    release thm multiplication_preserves_equal_real_values((-1)^p, alternating_series_terms(a)(p + h + 1), ((-1)^p * (-1)^(h + 1)) * a(p + h + 1))
    release thm alternating_sign_square_one(p)
    (-1)^p * alternating_series_terms(a)(p + h + 1) = (-1)^p * (((-1)^p * (-1)^(h + 1)) * a(p + h + 1)) = ((-1)^p * (-1)^p) * (-1)^(h + 1) * a(p + h + 1) = (-1)^(h + 1) * a(p + h + 1)
thm finite_tail_sum_singleton:
    ? forall a seq(R), p N+:
        finite_tail_sum(a, p, p) = a(p)
    release thm finite_tail_matches_finite_sum(a, p, p)
    sum(p, p, fn(i_index N+) R {a(i_index)}) = fn(i_index N+) R {a(i_index)}(p) = a(p)
    finite_tail_sum(a, p, p) = sum(p, p, fn(i_index N+) R {a(i_index)}) = a(p)
thm finite_tail_sum_successor:
    ? forall a seq(R), p, q N+:
        p <= q
        =>:
            finite_tail_sum(a, p, q + 1) = finite_tail_sum(a, p, q) + a(q + 1)
    thm addition_preserves_equal_real_values:
        ? forall left, right, left_value, right_value R:
            left = left_value
            right = right_value
            =>:
                left + right = left_value + right_value
    q + 1 $in N+
    p <= q < q + 1
    release thm finite_tail_matches_finite_sum(a, p, q)
    release thm finite_tail_matches_finite_sum(a, p, q + 1)
    sum(p, q + 1, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)}) + fn(i_index N+) R {a(i_index)}(q + 1)
    fn(i_index N+) R {a(i_index)}(q + 1) = a(q + 1)
    release thm addition_preserves_equal_real_values(sum(p, q, fn(i_index N+) R {a(i_index)}), fn(i_index N+) R {a(i_index)}(q + 1), finite_tail_sum(a, p, q), a(q + 1))
    finite_tail_sum(a, p, q + 1) = sum(p, q + 1, fn(i_index N+) R {a(i_index)}) = sum(p, q, fn(i_index N+) R {a(i_index)}) + fn(i_index N+) R {a(i_index)}(q + 1) = finite_tail_sum(a, p, q) + a(q + 1)
prop alternating_tail_pair_state(a seq(R), p N+, k N):
    alternating_series_terms(a) $in seq(R)
    p + 2 * k $in N+
    p + 2 * k + 1 $in N+
    0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k)
    (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k) <= a(p)
    a(p + 2 * k) <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k)
    0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k + 1)
    (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k + 1) <= a(p) - a(p + 2 * k + 1)
thm alternating_tail_pair_induction:
    ? forall a seq(R), p N+, k N:
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        =>:
            $alternating_tail_pair_state(a, p, k)
    thm review_even_alternating_sign:
        ? forall h_even N:
            (-1)^(2 * h_even) = 1
        by induc h_even from 0:
            ? (-1)^(2 * h_even) = 1
            ? from h_even = 0:
                2 * 0 = 0
                (-1)^(2 * 0) = (-1)^0 = 1
            ? induc:
                2 * (h_even + 1) = 2 * h_even + 2
                (-1)^2 = 1
                (-1)^(2 * (h_even + 1)) = (-1)^(2 * h_even + 2) = (-1)^(2 * h_even) * (-1)^2 = 1 * 1 = 1
    thm addition_preserves_equal_real_values:
        ? forall left, right, left_value, right_value R:
            left = left_value
            right = right_value
            =>:
                left + right = left_value + right_value
    thm multiplication_preserves_equal_real_values:
        ? forall factor, left_value, right_value R:
            left_value = right_value
            =>:
                factor * left_value = factor * right_value
    thm equal_indices_have_equal_scaled_terms:
        ? forall b seq(R), left_index, right_index N+, factor R:
            left_index = right_index
            =>:
                factor * b(left_index) = factor * b(right_index)
    thm equal_indices_have_equal_sequence_values:
        ? forall b seq(R), left_index, right_index N+:
            left_index = right_index
            =>:
                b(left_index) = b(right_index)
    thm equal_endpoints_have_equal_scaled_tails:
        ? forall b seq(R), start, left_end, right_end N+, factor R:
            left_end = right_end
            =>:
                factor * finite_tail_sum(b, start, left_end) = factor * finite_tail_sum(b, start, right_end)
    thm equal_difference_bounds:
        ? forall observed, first_term, second_term, replacement R:
            observed = first_term - second_term
            second_term = replacement
            =>:
                observed <= first_term - replacement
        first_term - second_term = first_term - replacement
        observed = first_term - second_term = first_term - replacement
    thm upper_difference_at_equal_term:
        ? forall observed, first_term, second_term, replacement R:
            observed <= first_term - second_term
            second_term = replacement
            =>:
                observed <= first_term - replacement
        first_term - second_term = first_term - replacement
    thm sum_with_negative_is_difference:
        ? forall total, left_value, right_value R:
            total = left_value + (-right_value)
            =>:
                total = left_value - right_value
        left_value + (-right_value) = left_value - right_value
    thm replacing_by_smaller_term_does_not_exceed_bound:
        ? forall bound, larger, smaller R:
            smaller <= larger
            =>:
                bound - larger + smaller <= bound
        bound - larger + smaller <= bound - larger + larger = bound
    thm normalized_tail_successor:
        ? forall b seq(R), start, end N+, factor R:
            start <= end
            end + 1 $in N+
            =>:
                factor * finite_tail_sum(b, start, end + 1) = factor * finite_tail_sum(b, start, end) + factor * b(end + 1)
        release thm finite_tail_sum_successor(b, start, end)
        release thm multiplication_preserves_equal_real_values(factor, finite_tail_sum(b, start, end + 1), finite_tail_sum(b, start, end) + b(end + 1))
        factor * finite_tail_sum(b, start, end + 1) = factor * (finite_tail_sum(b, start, end) + b(end + 1)) = factor * finite_tail_sum(b, start, end) + factor * b(end + 1)
    release thm fn_set_member(alternating_series_terms(a), seq(R))
    by induc k from 0:
        ? $alternating_tail_pair_state(a, p, k)
        ? from k = 0:
            release thm finite_tail_sum_singleton(alternating_series_terms(a), p)
            release thm alternating_sign_square_one(p)
            alternating_series_terms(a)(p) = (-1)^p * a(p)
            release thm multiplication_preserves_equal_real_values((-1)^p, finite_tail_sum(alternating_series_terms(a), p, p), alternating_series_terms(a)(p))
            release thm multiplication_preserves_equal_real_values((-1)^p, alternating_series_terms(a)(p), (-1)^p * a(p))
            (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p) = (-1)^p * alternating_series_terms(a)(p) = (-1)^p * ((-1)^p * a(p)) = ((-1)^p * (-1)^p) * a(p) = 1 * a(p) = a(p)
            p + 0 + 1 = p + 1
            p + 0 + 1 $in N+
            (-1)^(0 + 1) = (-1)^1 = (-1)
            release thm equal_indices_have_equal_scaled_terms(alternating_series_terms(a), p + 1, p + 0 + 1, (-1)^p)
            release thm equal_indices_have_equal_scaled_terms(a, p + 0 + 1, p + 1, (-1))
            release thm normalized_alternating_term(a, p, 0)
            (-1)^p * alternating_series_terms(a)(p + 1) = (-1)^p * alternating_series_terms(a)(p + 0 + 1) = (-1)^(0 + 1) * a(p + 0 + 1) = (-1)^1 * a(p + 1) = -a(p + 1)
            p + 1 $in N+
            release thm normalized_tail_successor(alternating_series_terms(a), p, p, (-1)^p)
            release thm addition_preserves_equal_real_values((-1)^p * finite_tail_sum(alternating_series_terms(a), p, p), (-1)^p * alternating_series_terms(a)(p + 1), a(p), -a(p + 1))
            (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 1) = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p) + (-1)^p * alternating_series_terms(a)(p + 1) = a(p) - a(p + 1)
            a(p) >= 0
            a(p + 1) >= 0
            a(p + 1) <= a(p)
            2 * 0 = 0
            p + 2 * 0 = p
            p + 2 * 0 + 1 = p + 1
            release thm equal_endpoints_have_equal_scaled_tails(alternating_series_terms(a), p, p + 2 * 0, p, (-1)^p)
            release thm equal_endpoints_have_equal_scaled_tails(alternating_series_terms(a), p, p + 2 * 0 + 1, p + 1, (-1)^p)
            release thm equal_indices_have_equal_sequence_values(a, p + 2 * 0 + 1, p + 1)
            0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * 0)
            (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * 0) <= a(p)
            a(p + 2 * 0) <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * 0)
            0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * 0 + 1)
            release thm equal_difference_bounds((-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * 0 + 1), a(p), a(p + 1), a(p + 2 * 0 + 1))
            (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * 0 + 1) <= a(p) - a(p + 2 * 0 + 1)
            by def $alternating_tail_pair_state(a, p, 0)
        ? induc:
            have r N+ = p + 2 * k + 1
            r + 1 $in N+
            r + 2 $in N+
            r = p + 2 * k + 1
            k >= 0
            2 * k >= 0
            p <= p + 2 * k <= p + 2 * k + 1 = r
            p <= r + 1
            release thm normalized_tail_successor(alternating_series_terms(a), p, r, (-1)^p)
            release thm normalized_tail_successor(alternating_series_terms(a), p, r + 1, (-1)^p)
            release thm normalized_alternating_term(a, p, 2 * k + 1)
            release thm normalized_alternating_term(a, p, 2 * k + 2)
            release thm review_even_alternating_sign(k + 1)
            2 * (k + 1) = 2 * k + 2
            (-1)^(2 * k + 2) = (-1)^(2 * (k + 1)) = 1
            2 * k + 2 $in N
            2 * k + 3 = (2 * k + 2) + 1
            (-1)^(2 * k + 3) = (-1)^((2 * k + 2) + 1) = (-1)^(2 * k + 2) * (-1)^1 = 1 * (-1) = (-1)
            release thm addition_preserves_equal_real_values(r, 1, p + 2 * k + 1, 1)
            r + 1 = p + 2 * k + 2
            release thm addition_preserves_equal_real_values(r, 2, p + 2 * k + 1, 2)
            r + 2 = p + 2 * k + 3
            r + 1 = p + (2 * k + 1) + 1
            r + 2 = p + (2 * k + 2) + 1
            release thm equal_indices_have_equal_scaled_terms(alternating_series_terms(a), r + 1, p + (2 * k + 1) + 1, (-1)^p)
            release thm equal_indices_have_equal_sequence_values(a, p + (2 * k + 1) + 1, r + 1)
            release thm equal_indices_have_equal_scaled_terms(alternating_series_terms(a), r + 2, p + (2 * k + 2) + 1, (-1)^p)
            release thm equal_indices_have_equal_sequence_values(a, p + (2 * k + 2) + 1, r + 2)
            (2 * k + 1) + 1 = 2 * k + 2
            (-1)^((2 * k + 1) + 1) = (-1)^(2 * k + 2)
            release thm multiplication_preserves_equal_real_values((-1)^((2 * k + 1) + 1), a(p + (2 * k + 1) + 1), a(r + 1))
            release thm multiplication_preserves_equal_real_values(a(r + 1), (-1)^((2 * k + 1) + 1), (-1)^(2 * k + 2))
            (-1)^p * alternating_series_terms(a)(r + 1) = (-1)^p * alternating_series_terms(a)(p + (2 * k + 1) + 1) = (-1)^((2 * k + 1) + 1) * a(p + (2 * k + 1) + 1) = (-1)^((2 * k + 1) + 1) * a(r + 1) = (-1)^(2 * k + 2) * a(r + 1) = a(r + 1)
            (2 * k + 2) + 1 = 2 * k + 3
            (-1)^((2 * k + 2) + 1) = (-1)^(2 * k + 3)
            release thm multiplication_preserves_equal_real_values((-1)^((2 * k + 2) + 1), a(p + (2 * k + 2) + 1), a(r + 2))
            release thm multiplication_preserves_equal_real_values(a(r + 2), (-1)^((2 * k + 2) + 1), (-1)^(2 * k + 3))
            (-1)^p * alternating_series_terms(a)(r + 2) = (-1)^p * alternating_series_terms(a)(p + (2 * k + 2) + 1) = (-1)^((2 * k + 2) + 1) * a(p + (2 * k + 2) + 1) = (-1)^((2 * k + 2) + 1) * a(r + 2) = (-1)^(2 * k + 3) * a(r + 2) = -a(r + 2)
            have old_odd R = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, r)
            have new_even R = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, r + 1)
            have new_odd R = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, r + 2)
            old_odd = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k + 1)
            0 <= old_odd
            release thm equal_indices_have_equal_sequence_values(a, p + 2 * k + 1, r)
            release thm upper_difference_at_equal_term(old_odd, a(p), a(p + 2 * k + 1), a(r))
            old_odd <= a(p) - a(r)
            a(r + 1) <= a(r)
            a(r + 2) <= a(r + 1)
            new_even = old_odd + a(r + 1)
            release thm addition_preserves_equal_real_values((-1)^p * finite_tail_sum(alternating_series_terms(a), p, r + 1), (-1)^p * alternating_series_terms(a)(r + 2), new_even, -a(r + 2))
            r + 2 = (r + 1) + 1
            release thm equal_endpoints_have_equal_scaled_tails(alternating_series_terms(a), p, r + 2, (r + 1) + 1, (-1)^p)
            release thm equal_indices_have_equal_scaled_terms(alternating_series_terms(a), (r + 1) + 1, r + 2, (-1)^p)
            new_odd = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, r + 1) + (-1)^p * alternating_series_terms(a)(r + 2) = new_even + (-a(r + 2))
            release thm sum_with_negative_is_difference(new_odd, new_even, a(r + 2))
            new_odd = new_even - a(r + 2)
            a(r + 1) >= 0
            0 <= a(r + 1) <= new_even
            release thm replacing_by_smaller_term_does_not_exceed_bound(a(p), a(r), a(r + 1))
            new_even <= a(p) - a(r) + a(r + 1) <= a(p)
            0 <= new_odd
            new_odd <= a(p) - a(r + 2)
            p + 2 * (k + 1) = r + 1
            p + 2 * (k + 1) + 1 = r + 2
            release thm equal_endpoints_have_equal_scaled_tails(alternating_series_terms(a), p, p + 2 * (k + 1), r + 1, (-1)^p)
            release thm equal_endpoints_have_equal_scaled_tails(alternating_series_terms(a), p, p + 2 * (k + 1) + 1, r + 2, (-1)^p)
            release thm equal_indices_have_equal_sequence_values(a, p + 2 * (k + 1), r + 1)
            release thm equal_indices_have_equal_sequence_values(a, p + 2 * (k + 1) + 1, r + 2)
            0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * (k + 1))
            (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * (k + 1)) <= a(p)
            a(p + 2 * (k + 1)) <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * (k + 1))
            0 <= (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * (k + 1) + 1)
            (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * (k + 1) + 1) <= a(p) - a(p + 2 * (k + 1) + 1)
            by def $alternating_tail_pair_state(a, p, k + 1)
thm alternating_terms_distance_from_zero:
    ? forall a seq(R), n N+:
        abs(alternating_series_terms(a)(n) - 0) = abs(a(n) - 0)
    alternating_series_terms(a)(n) = (-1)^n * a(n)
    alternating_series_terms(a)(n) - 0 = ((-1)^n * a(n)) - 0
    ((-1)^n * a(n)) - 0 = (-1)^n * a(n)
    alternating_series_terms(a)(n) - 0 = ((-1)^n * a(n)) - 0 = (-1)^n * a(n)
    alternating_series_terms(a)(n) - 0 = (-1)^n * a(n)
    abs(alternating_series_terms(a)(n) - 0) = abs((-1)^n * a(n))
    abs((-1)^n * a(n)) = abs((-1)^n) * abs(a(n))
    release thm alternating_sign_abs_one(n)
    abs((-1)^n) * abs(a(n)) = 1 * abs(a(n))
    1 * abs(a(n)) = abs(a(n))
    abs(alternating_series_terms(a)(n) - 0) = abs(a(n))
    a(n) - 0 = a(n)
    abs(a(n) - 0) = abs(a(n))
thm alternating_terms_abs_value:
    ? forall a seq(R), n N+:
        abs(alternating_series_terms(a)(n)) = abs(a(n))
    alternating_series_terms(a)(n) = (-1)^n * a(n)
    abs(alternating_series_terms(a)(n)) = abs((-1)^n * a(n))
    abs((-1)^n * a(n)) = abs((-1)^n) * abs(a(n))
    release thm alternating_sign_abs_one(n)
    abs((-1)^n) * abs(a(n)) = 1 * abs(a(n))
    1 * abs(a(n)) = abs(a(n))
thm alternating_series_tail_bound:
    ? forall a seq(R), n0, p, q N+:
        alternating_series_terms(a) $in seq(R)
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        p >= n0
        q >= n0
        =>:
            abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0)
    thm tail_length_even_or_odd:
        ? forall h N:
            exist k N st {h = 2 * k or h = 2 * k + 1}
        by induc h from 0:
            ? exist k N st {h = 2 * k or h = 2 * k + 1}
            ? from h = 0:
                witness exist k N st {0 = 2 * k or 0 = 2 * k + 1} from 0
            ? induc:
                obtain k from exist k N st {h = 2 * k or h = 2 * k + 1}
                by cases:
                    ? exist j N st {h + 1 = 2 * j or h + 1 = 2 * j + 1}
                    case h = 2 * k:
                        h + 1 = 2 * k + 1
                        witness exist j N st {h + 1 = 2 * j or h + 1 = 2 * j + 1} from k
                    case h = 2 * k + 1:
                        k + 1 $in N
                        h + 1 = (2 * k + 1) + 1 = 2 * (k + 1)
                        witness exist j N st {h + 1 = 2 * j or h + 1 = 2 * j + 1} from k + 1
    thm equal_tail_endpoints:
        ? forall b seq(R), start, left, right N+, factor R:
            left = right
            =>:
                factor * finite_tail_sum(b, start, left) = factor * finite_tail_sum(b, start, right)
    thm add_equal_real_values:
        ? forall extra, left, right R:
            left = right
            =>:
                extra + left = extra + right
    q < p or q >= p
    by cases:
        ? abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0)
        case q < p:
            finite_tail_sum(alternating_series_terms(a), p, q) = 0
            abs(finite_tail_sum(alternating_series_terms(a), p, q)) = abs(0) = 0 <= a(n0)
        case q >= p:
            q - p $in N
            release thm tail_length_even_or_odd(q - p)
            obtain k from exist k N st {q - p = 2 * k or q - p = 2 * k + 1}
            release thm alternating_tail_pair_induction(a, p, k)
            p - n0 $in N
            n0 + (p - n0) = p
            release thm decreasing_seq_le_add(a, p - n0, n0)
            a(p) = a(n0 + (p - n0)) <= a(n0)
            have value R = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, q)
            by cases:
                ? 0 <= value and value <= a(p)
                case q - p = 2 * k:
                    q = p + (q - p) = p + 2 * k
                    release thm equal_tail_endpoints(alternating_series_terms(a), p, q, p + 2 * k, (-1)^p)
                    value = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, q) = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k)
                    0 <= value
                    value <= a(p)
                case q - p = 2 * k + 1:
                    release thm add_equal_real_values(p, q - p, 2 * k + 1)
                    p + (q - p) = p + (2 * k + 1)
                    p + (2 * k + 1) = p + 2 * k + 1
                    q = p + (q - p) = p + (2 * k + 1) = p + 2 * k + 1
                    release thm equal_tail_endpoints(alternating_series_terms(a), p, q, p + 2 * k + 1, (-1)^p)
                    value = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, q) = (-1)^p * finite_tail_sum(alternating_series_terms(a), p, p + 2 * k + 1)
                    0 <= value
                    a(p + 2 * k + 1) >= 0
                    value <= a(p) - a(p + 2 * k + 1) <= a(p)
            value >= 0
            value <= a(p)
            abs(value) = value
            release thm alternating_sign_abs_one(p)
            abs(value) = abs((-1)^p * finite_tail_sum(alternating_series_terms(a), p, q)) = abs((-1)^p) * abs(finite_tail_sum(alternating_series_terms(a), p, q)) = 1 * abs(finite_tail_sum(alternating_series_terms(a), p, q)) = abs(finite_tail_sum(alternating_series_terms(a), p, q))
            abs(finite_tail_sum(alternating_series_terms(a), p, q)) = abs(value) = value <= a(p) <= a(n0)
thm alternating_series_test:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        $has_limit(a, 0)
        =>:
            $is_convergent_series(alternating_series_terms(a))
    release thm fn_set_member(alternating_series_terms(a), fn(index N+) R)
    alternating_series_terms(a) $in seq(R)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$has_small_tail_sums_after(alternating_series_terms(a), epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        witness exist n1 N+ st {$has_small_tail_sums_after(alternating_series_terms(a), epsilon, n1)} from n0:
            forall p, q N+:
                p >= n0
                q >= n0
                =>:
                    abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0)
                    n0 >= n0
                    abs(a(n0) - 0) <= epsilon
                    a(n0) >= 0
                    a(n0) - 0 = a(n0)
                    abs(a(n0) - 0) = abs(a(n0))
                    abs(a(n0)) = a(n0)
                    a(n0) <= epsilon
                    abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= a(n0) <= epsilon
                    abs(finite_tail_sum(alternating_series_terms(a), p, q)) <= epsilon
            by def $has_small_tail_sums_after(alternating_series_terms(a), epsilon, n0)
            $has_small_tail_sums_after(alternating_series_terms(a), epsilon, n0)
    by def $has_cauchy_series_tails(alternating_series_terms(a))
    $has_cauchy_series_tails(alternating_series_terms(a))
    release thm series_cauchy_criterion_reverse(alternating_series_terms(a))
thm alternating_series_test_reverse:
    ? forall a seq(R):
        $is_convergent_series(alternating_series_terms(a))
        =>:
            $has_limit(a, 0)
    release thm series_zero_test(alternating_series_terms(a))
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(alternating_series_terms(a), 0, epsilon, n0)}
        witness exist n1 N+ st {$is_tail_close_to(a, 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(alternating_series_terms(a)(n) - 0) <= epsilon
                    abs(alternating_series_terms(a)(n) - 0) = abs(a(n) - 0)
                    abs(a(n) - 0) <= epsilon
            by def $is_tail_close_to(a, 0, epsilon, n0)
            $is_tail_close_to(a, 0, epsilon, n0)
    by def $has_limit(a, 0)
sketch:
    have alternating_harmonic_terms seq(R) = alternating_series_terms(harmonic_terms)
    claim:
        ? forall k N+:
            alternating_harmonic_terms(k) = (-1)^k / k
        alternating_harmonic_terms(k) = alternating_series_terms(harmonic_terms)(k)
        alternating_series_terms(harmonic_terms)(k) = (-1)^k * harmonic_terms(k)
        harmonic_terms(k) = 1 / k
        (-1)^k * harmonic_terms(k) = (-1)^k * (1 / k)
        (-1)^k * (1 / k) = (-1)^k / k
    $is_nonnegative_sequence(harmonic_terms)
    $is_decreasing_sequence(harmonic_terms)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(harmonic_terms, 0, epsilon, n0)}
        release thm chap5::archimedean_property(epsilon)
        obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
        witness exist n1 N+ st {$is_tail_close_to(harmonic_terms, 0, epsilon, n1)} from n0:
            forall n N+:
                n >= n0
                =>:
                    harmonic_terms(n) = 1 / n
                    n0 <= n
                    n0 * n > 0
                    1 / n = n0 / (n0 * n)
                    n0 / (n0 * n) <= n / (n0 * n)
                    n / (n0 * n) = 1 / n0
                    1 / n <= 1 / n0
                    1 / n <= 1 / n0 < epsilon
                    1 / n < epsilon
                    1 / n > 0
                    1 / n - 0 = 1 / n
                    1 / n - 0 >= 0
                    abs(1 / n - 0) = 1 / n - 0
                    abs(1 / n - 0) = 1 / n
                    abs(harmonic_terms(n) - 0) = abs(1 / n - 0)
                    abs(harmonic_terms(n) - 0) < epsilon
                    abs(harmonic_terms(n) - 0) <= epsilon
            by def $is_tail_close_to(harmonic_terms, 0, epsilon, n0)
            $is_tail_close_to(harmonic_terms, 0, epsilon, n0)
    by def $has_limit(harmonic_terms, 0)
    release thm alternating_series_test(harmonic_terms)
    $is_convergent_series(alternating_harmonic_terms)
    claim:
        ? not $is_convergent_series(harmonic_terms)
        not $is_convergent_series(harmonic_terms)
    $is_convergent_series(alternating_harmonic_terms)
    claim:
        ? not $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
        by contra:
            ? not $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
            $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
            claim:
                ? forall n N+:
                    abs(alternating_harmonic_terms(n)) = harmonic_terms(n)
                alternating_harmonic_terms(n) = alternating_series_terms(harmonic_terms)(n)
                abs(alternating_harmonic_terms(n)) = abs(alternating_series_terms(harmonic_terms)(n))
                release thm alternating_terms_abs_value(harmonic_terms, n)
                harmonic_terms(n) = 1 / n
                1 / n > 0
                abs(harmonic_terms(n)) = harmonic_terms(n)
            claim:
                ? forall n N+:
                    fn(j N+) R {abs(alternating_harmonic_terms(j))}(n) = harmonic_terms(n)
                fn(j N+) R {abs(alternating_harmonic_terms(j))}(n) = abs(alternating_harmonic_terms(n)) = harmonic_terms(n)
            release thm series_convergence_extensional(fn(j N+) R {abs(alternating_harmonic_terms(j))}, harmonic_terms)
            impossible not $is_convergent_series(harmonic_terms)
    claim:
        ? not $is_absolutely_convergent_series(alternating_harmonic_terms)
        by contra:
            ? not $is_absolutely_convergent_series(alternating_harmonic_terms)
            $is_absolutely_convergent_series(alternating_harmonic_terms)
            $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
            impossible not $is_convergent_series(fn(j N+) R {abs(alternating_harmonic_terms(j))})
    not $is_absolutely_convergent_series(alternating_harmonic_terms)
    by def $is_only_conditionally_convergent_series(alternating_harmonic_terms)
have fn series_add(a, b seq(R)) fn(i_index N+) R = fn(j N+) R {a(j) + b(j)}
have fn series_scalar_mul(c R, a seq(R)) fn(i_index N+) R = fn(j N+) R {c * a(j)}
have fn series_shift(a seq(R), h N) fn(i_index N+) R = fn(j N+) R {a(j + h)}
thm series_add_apply:
    ? forall a, b seq(R), n N+:
        series_add(a, b)(n) = a(n) + b(n)
thm series_scalar_mul_apply:
    ? forall c R, a seq(R), n N+:
        series_scalar_mul(c, a)(n) = c * a(n)
thm series_shift_apply:
    ? forall a seq(R), h N, n N+:
        series_shift(a, h)(n) = a(n + h)
thm partial_sum_series_add:
    ? forall a, b seq(R), k N+:
        partial_sum(series_add(a, b), k) = partial_sum(a, k) + partial_sum(b, k)
    release thm fn_set_member(series_add(a, b), fn(index N+) R)
    series_add(a, b) $in seq(R)
    thm addition_preserves_equality:
        ? forall left, right, extra R:
            left = right
            =>:
                left + extra = right + extra
    claim:
        ? forall n N:
            partial_sum(series_add(a, b), n) = partial_sum(a, n) + partial_sum(b, n)
        by induc n from 0:
            ? partial_sum(series_add(a, b), n) = partial_sum(a, n) + partial_sum(b, n)
            ? from n = 0:
                partial_sum(series_add(a, b), 0) = 0
                partial_sum(a, 0) = 0
                partial_sum(b, 0) = 0
            ? induc:
                n + 1 $in N+
                (n + 1) - 1 = n
                partial_sum(series_add(a, b), (n + 1) - 1) = partial_sum(series_add(a, b), n)
                release thm addition_preserves_equality(partial_sum(series_add(a, b), (n + 1) - 1), partial_sum(series_add(a, b), n), series_add(a, b)(n + 1))
                partial_sum(a, (n + 1) - 1) = partial_sum(a, n)
                release thm addition_preserves_equality(partial_sum(a, (n + 1) - 1), partial_sum(a, n), a(n + 1))
                partial_sum(b, (n + 1) - 1) = partial_sum(b, n)
                release thm addition_preserves_equality(partial_sum(b, (n + 1) - 1), partial_sum(b, n), b(n + 1))
                release thm partial_sum_successor(series_add(a, b), n + 1)
                release thm partial_sum_successor(a, n + 1)
                release thm partial_sum_successor(b, n + 1)
                series_add(a, b)(n + 1) = a(n + 1) + b(n + 1)
                partial_sum(series_add(a, b), n + 1) = partial_sum(series_add(a, b), n) + series_add(a, b)(n + 1)
                partial_sum(series_add(a, b), n) + series_add(a, b)(n + 1) = (partial_sum(a, n) + partial_sum(b, n)) + (a(n + 1) + b(n + 1))
                (partial_sum(a, n) + partial_sum(b, n)) + (a(n + 1) + b(n + 1)) = (partial_sum(a, n) + a(n + 1)) + (partial_sum(b, n) + b(n + 1))
                partial_sum(a, n + 1) = partial_sum(a, n) + a(n + 1)
                partial_sum(b, n + 1) = partial_sum(b, n) + b(n + 1)
                partial_sum(series_add(a, b), n + 1) = partial_sum(a, n + 1) + partial_sum(b, n + 1)
thm partial_sum_series_scalar_mul:
    ? forall a seq(R), c R, k N+:
        partial_sum(series_scalar_mul(c, a), k) = c * partial_sum(a, k)
    thm multiplication_preserves_equality:
        ? forall left, right, factor R:
            left = right
            =>:
                factor * left = factor * right
    release thm partial_sum_matches_finite_sum(series_scalar_mul(c, a), k)
    release thm partial_sum_matches_finite_sum(a, k)
    partial_sum(series_scalar_mul(c, a), k) = sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)})
    partial_sum(a, k) = sum(1, k, fn(i_index N+) R {a(i_index)})
    forall i_index N+:
        series_scalar_mul(c, a)(i_index) = c * a(i_index)
    forall i_index N+:
        1 <= i_index <= k
        =>:
            series_scalar_mul(c, a)(i_index) = c * a(i_index)
            series_scalar_mul(c, a)(i_index) <= c * a(i_index)
            c * a(i_index) <= series_scalar_mul(c, a)(i_index)
    release thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}), sum(1, k, fn(i_index N+) R {c * a(i_index)}))
    release thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {c * a(i_index)}), sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}))
    sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}) = sum(1, k, fn(i_index N+) R {c * a(i_index)})
    release thm finite_series_scalar_mul_positive_range(a, c, 1, k)
    sum(1, k, fn(i_index N+) R {c * a(i_index)}) = c * sum(1, k, fn(i_index N+) R {a(i_index)})
    release thm multiplication_preserves_equality(sum(1, k, fn(i_index N+) R {a(i_index)}), partial_sum(a, k), c)
    partial_sum(series_scalar_mul(c, a), k) = sum(1, k, fn(i_index N+) R {series_scalar_mul(c, a)(i_index)}) = sum(1, k, fn(i_index N+) R {c * a(i_index)}) = c * sum(1, k, fn(i_index N+) R {a(i_index)}) = c * partial_sum(a, k)
thm series_laws_add:
    ? forall a, b seq(R), x, y R:
        $has_series_sum(a, x)
        $has_series_sum(b, y)
        =>:
            $has_series_sum(series_add(a, b), x + y)
    thm addition_of_equal_values:
        ? forall left, right, left_value, right_value R:
            left = left_value
            right = right_value
            =>:
                left + right = left_value + right_value
    release thm fn_set_member(series_add(a, b), fn(index N+) R)
    series_add(a, b) $in seq(R)
    release thm fn_set_member(fn(k N+) R {partial_sum(series_add(a, b), k)}, fn(index N+) R)
    fn(k N+) R {partial_sum(series_add(a, b), k)} $in seq(R)
    release thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, x)
    release thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(b, k)}, y)
    release thm chap6::seq_add_converges_to(fn(k N+) R {partial_sum(a, k)}, fn(k N+) R {partial_sum(b, k)}, x, y)
    release thm fn_set_member(fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}, fn(index N+) R)
    claim:
        ? forall n N+:
            fn(index N+) R {fn(k N+) R {partial_sum(a, k)}(index) + fn(k N+) R {partial_sum(b, k)}(index)}(n) = fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}(n)
        fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n)
        fn(k N+) R {partial_sum(b, k)}(n) = partial_sum(b, n)
        release thm addition_of_equal_values(fn(k N+) R {partial_sum(a, k)}(n), fn(k N+) R {partial_sum(b, k)}(n), partial_sum(a, n), partial_sum(b, n))
        fn(index N+) R {fn(k N+) R {partial_sum(a, k)}(index) + fn(k N+) R {partial_sum(b, k)}(index)}(n) = fn(k N+) R {partial_sum(a, k)}(n) + fn(k N+) R {partial_sum(b, k)}(n) = partial_sum(a, n) + partial_sum(b, n) = fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}(n)
    release thm strict_limit_extensional(fn(index N+) R {fn(k N+) R {partial_sum(a, k)}(index) + fn(k N+) R {partial_sum(b, k)}(index)}, fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}, x + y)
    claim:
        ? forall n N+:
            fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}(n) = fn(k N+) R {partial_sum(series_add(a, b), k)}(n)
        release thm partial_sum_series_add(a, b, n)
    release thm strict_limit_extensional(fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}, fn(k N+) R {partial_sum(series_add(a, b), k)}, x + y)
    release thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(series_add(a, b), k)}, x + y)
    by def $has_series_sum(series_add(a, b), x + y)
thm series_laws_add_pointwise:
    ? forall a, b seq(R), x, y R:
        $has_series_sum(a, x)
        $has_series_sum(b, y)
        =>:
            $has_series_sum(fn(n N+) R {a(n) + b(n)}, x + y)
    release thm series_laws_add(a, b, x, y)
    claim:
        ? forall n N+:
            series_add(a, b)(n) = fn(j N+) R {a(j) + b(j)}(n)
        series_add(a, b)(n) = a(n) + b(n)
    release thm series_sum_extensional(series_add(a, b), fn(n N+) R {a(n) + b(n)}, x + y)
thm series_laws_scalar_mul:
    ? forall a seq(R), c, x R:
        $has_series_sum(a, x)
        =>:
            $has_series_sum(series_scalar_mul(c, a), c * x)
    thm multiplication_preserves_equality:
        ? forall left, right, factor R:
            left = right
            =>:
                factor * left = factor * right
    release thm fn_set_member(series_scalar_mul(c, a), fn(index N+) R)
    series_scalar_mul(c, a) $in seq(R)
    release thm fn_set_member(fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}, fn(index N+) R)
    fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)} $in seq(R)
    release thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, x)
    release thm chap6::seq_const_mul_converges_to(c, fn(k N+) R {partial_sum(a, k)}, x)
    release thm fn_set_member(fn(k N+) R {c * partial_sum(a, k)}, fn(index N+) R)
    claim:
        ? forall n N+:
            fn(index N+) R {c * fn(k N+) R {partial_sum(a, k)}(index)}(n) = fn(k N+) R {c * partial_sum(a, k)}(n)
        fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n)
        release thm multiplication_preserves_equality(fn(k N+) R {partial_sum(a, k)}(n), partial_sum(a, n), c)
        fn(index N+) R {c * fn(k N+) R {partial_sum(a, k)}(index)}(n) = c * fn(k N+) R {partial_sum(a, k)}(n) = c * partial_sum(a, n) = fn(k N+) R {c * partial_sum(a, k)}(n)
    release thm strict_limit_extensional(fn(index N+) R {c * fn(k N+) R {partial_sum(a, k)}(index)}, fn(k N+) R {c * partial_sum(a, k)}, c * x)
    claim:
        ? forall n N+:
            fn(k N+) R {c * partial_sum(a, k)}(n) = fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}(n)
        release thm partial_sum_series_scalar_mul(a, c, n)
    release thm strict_limit_extensional(fn(k N+) R {c * partial_sum(a, k)}, fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}, c * x)
    release thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(series_scalar_mul(c, a), k)}, c * x)
    by def $has_series_sum(series_scalar_mul(c, a), c * x)
thm partial_sum_series_shift_plus_prefix:
    ? forall a seq(R), h N, k N+:
        partial_sum(series_shift(a, h), k) + partial_sum(a, h) = partial_sum(a, k + h)
    by induc k from 1:
        ? partial_sum(series_shift(a, h), k) + partial_sum(a, h) = partial_sum(a, k + h)
        ? from k = 1:
            1 - 1 = 0
            partial_sum(series_shift(a, h), 1 - 1) = partial_sum(series_shift(a, h), 0)
            partial_sum(series_shift(a, h), 0) = 0
            series_shift(a, h)(1) = a(1 + h)
            release thm partial_sum_successor(series_shift(a, h), 1)
            partial_sum(series_shift(a, h), 1) = partial_sum(series_shift(a, h), 1 - 1) + series_shift(a, h)(1)
            partial_sum(series_shift(a, h), 1 - 1) + series_shift(a, h)(1) = partial_sum(series_shift(a, h), 0) + series_shift(a, h)(1)
            partial_sum(series_shift(a, h), 0) + series_shift(a, h)(1) = 0 + series_shift(a, h)(1)
            0 + series_shift(a, h)(1) = 0 + a(1 + h)
            partial_sum(series_shift(a, h), 1) = partial_sum(series_shift(a, h), 1 - 1) + series_shift(a, h)(1) = partial_sum(series_shift(a, h), 0) + series_shift(a, h)(1) = 0 + series_shift(a, h)(1) = 0 + a(1 + h)
            partial_sum(series_shift(a, h), 1) = 0 + a(1 + h)
            0 + a(1 + h) = a(1 + h)
            1 + h $in N+
            (1 + h) - 1 = h
            partial_sum(a, (1 + h) - 1) = partial_sum(a, h)
            release thm partial_sum_successor(a, 1 + h)
            partial_sum(a, 1 + h) = partial_sum(a, (1 + h) - 1) + a(1 + h)
            partial_sum(a, (1 + h) - 1) + a(1 + h) = partial_sum(a, h) + a(1 + h)
            partial_sum(a, 1 + h) = partial_sum(a, h) + a(1 + h)
            a(1 + h) + partial_sum(a, h) = partial_sum(a, h) + a(1 + h)
            partial_sum(series_shift(a, h), 1) + partial_sum(a, h) = a(1 + h) + partial_sum(a, h)
            partial_sum(series_shift(a, h), 1) + partial_sum(a, h) = partial_sum(a, h) + a(1 + h)
            partial_sum(series_shift(a, h), 1) + partial_sum(a, h) = partial_sum(a, 1 + h)
        ? induc:
            partial_sum(series_shift(a, h), k) + partial_sum(a, h) = partial_sum(a, k + h)
            k + 1 $in N+
            (k + 1) - 1 = k
            partial_sum(series_shift(a, h), (k + 1) - 1) = partial_sum(series_shift(a, h), k)
            series_shift(a, h)(k + 1) = a(k + 1 + h)
            release thm partial_sum_successor(series_shift(a, h), k + 1)
            partial_sum(series_shift(a, h), k + 1) = partial_sum(series_shift(a, h), (k + 1) - 1) + series_shift(a, h)(k + 1)
            partial_sum(series_shift(a, h), (k + 1) - 1) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + series_shift(a, h)(k + 1)
            partial_sum(series_shift(a, h), k) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) = partial_sum(series_shift(a, h), (k + 1) - 1) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + series_shift(a, h)(k + 1) = partial_sum(series_shift(a, h), k) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) = partial_sum(series_shift(a, h), k) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + a(k + 1 + h)) + partial_sum(a, h)
            (partial_sum(series_shift(a, h), k) + a(k + 1 + h)) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + partial_sum(a, h)) + a(k + 1 + h)
            (partial_sum(series_shift(a, h), k) + partial_sum(a, h)) + a(k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + a(k + 1 + h)) + partial_sum(a, h) = (partial_sum(series_shift(a, h), k) + partial_sum(a, h)) + a(k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = partial_sum(a, k + h) + a(k + 1 + h)
            k + 1 + h $in N+
            (k + 1 + h) - 1 = k + h
            partial_sum(a, (k + 1 + h) - 1) = partial_sum(a, k + h)
            release thm partial_sum_successor(a, k + 1 + h)
            partial_sum(a, k + 1 + h) = partial_sum(a, (k + 1 + h) - 1) + a(k + 1 + h)
            partial_sum(a, (k + 1 + h) - 1) + a(k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(a, k + 1 + h) = partial_sum(a, k + h) + a(k + 1 + h)
            partial_sum(series_shift(a, h), k + 1) + partial_sum(a, h) = partial_sum(a, k + 1 + h)
thm series_laws_tail_convergence:
    ? forall a seq(R), h N:
        $is_convergent_series(a)
        =>:
            $is_convergent_series(series_shift(a, h))
    thm equal_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    thm equality_transports_strict_bound:
        ? forall left, right, bound R:
            left = right
            right < bound
            =>:
                left < bound
    release thm fn_set_member(series_shift(a, h), fn(index N+) R)
    series_shift(a, h) $in seq(R)
    release thm fn_set_member(fn(k N+) R {partial_sum(series_shift(a, h), k)}, fn(index N+) R)
    fn(k N+) R {partial_sum(series_shift(a, h), k)} $in seq(R)
    thm subtraction_preserves_left_equality:
        ? forall left, right, extra R:
            left = right
            =>:
                left - extra = right - extra
    obtain L from $is_convergent_series(a)
    release thm closed_limit_implies_strict_limit(fn(k N+) R {partial_sum(a, k)}, L)
    claim:
        ? $chap6::has_limit(fn(n N+) R {partial_sum(a, n + h)}, L)
        claim:
            ? forall epsilon R+:
                $chap6::has_eventual_closeness_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon)
            release thm chap6::has_limit_gives_eventual_closeness(fn(k N+) R {partial_sum(a, k)}, L, epsilon)
            obtain n0 from exist n0 N+ st {$chap6::is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, n0)}
            witness $chap6::has_eventual_closeness_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon) from n0:
                claim:
                    ? forall n N+:
                        n >= n0
                        =>:
                            abs(fn(j N+) R {partial_sum(a, j + h)}(n) - L) < epsilon
                    n + h $in N+
                    n + h >= n >= n0
                    abs(fn(k N+) R {partial_sum(a, k)}(n + h) - L) < epsilon
                    fn(j N+) R {partial_sum(a, j + h)}(n) = fn(k N+) R {partial_sum(a, k)}(n + h)
                    release thm equal_values_have_equal_distance(fn(j N+) R {partial_sum(a, j + h)}(n), fn(k N+) R {partial_sum(a, k)}(n + h), L)
                    release thm equality_transports_strict_bound(abs(fn(j N+) R {partial_sum(a, j + h)}(n) - L), abs(fn(k N+) R {partial_sum(a, k)}(n + h) - L), epsilon)
                by def $chap6::is_tail_close_to(fn(n N+) R {partial_sum(a, n + h)}, L, epsilon, n0)
        by def $chap6::has_limit(fn(n N+) R {partial_sum(a, n + h)}, L)
        $chap6::has_limit(fn(n N+) R {partial_sum(a, n + h)}, L)
    release thm constant_sequence_has_strict_limit(partial_sum(a, h))
    release thm chap6::seq_sub_converges_to(fn(n N+) R {partial_sum(a, n + h)}, constant_sequence(partial_sum(a, h)), L, partial_sum(a, h))
    claim:
        ? forall n N+:
            partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(series_shift(a, h), n)
        release thm partial_sum_series_shift_plus_prefix(a, h, n)
        constant_sequence(partial_sum(a, h))(n) = partial_sum(a, h)
        partial_sum(series_shift(a, h), n) + partial_sum(a, h) = partial_sum(a, n + h)
        partial_sum(a, n + h) - partial_sum(a, h) = partial_sum(series_shift(a, h), n)
        partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(a, n + h) - partial_sum(a, h)
        partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(a, n + h) - partial_sum(a, h) = partial_sum(series_shift(a, h), n)
    claim:
        ? forall n N+:
            fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}(n) = fn(k N+) R {partial_sum(series_shift(a, h), k)}(n)
        fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}(n) = partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = partial_sum(series_shift(a, h), n) = fn(k N+) R {partial_sum(series_shift(a, h), k)}(n)
    release thm fn_set_member(fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}, fn(index N+) R)
    claim:
        ? forall n N+:
            fn(index N+) R {fn(inner_index N+) R {partial_sum(a, inner_index + h)}(index) - constant_sequence(partial_sum(a, h))(index)}(n) = fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}(n)
        fn(index N+) R {partial_sum(a, index + h)}(n) = partial_sum(a, n + h)
        release thm subtraction_preserves_left_equality(fn(index N+) R {partial_sum(a, index + h)}(n), partial_sum(a, n + h), constant_sequence(partial_sum(a, h))(n))
        fn(index N+) R {fn(inner_index N+) R {partial_sum(a, inner_index + h)}(index) - constant_sequence(partial_sum(a, h))(index)}(n) = fn(index N+) R {partial_sum(a, index + h)}(n) - constant_sequence(partial_sum(a, h))(n) = partial_sum(a, n + h) - constant_sequence(partial_sum(a, h))(n) = fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}(n)
    release thm strict_limit_extensional(fn(index N+) R {fn(inner_index N+) R {partial_sum(a, inner_index + h)}(index) - constant_sequence(partial_sum(a, h))(index)}, fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}, L - partial_sum(a, h))
    release thm strict_limit_extensional(fn(i_index N+) R {partial_sum(a, i_index + h) - constant_sequence(partial_sum(a, h))(i_index)}, fn(k N+) R {partial_sum(series_shift(a, h), k)}, L - partial_sum(a, h))
    release thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(series_shift(a, h), k)}, L - partial_sum(a, h))
    by def $has_series_sum(series_shift(a, h), L - partial_sum(a, h))
    witness $is_convergent_series(series_shift(a, h)) from L - partial_sum(a, h)
thm series_laws_index_shift:
    ? forall a seq(R), k N, x R:
        $has_series_sum(a, x)
        =>:
            $is_convergent_series(series_shift(a, k))
    witness $is_convergent_series(a) from x:
        $has_series_sum(a, x)
    $is_convergent_series(a)
    release thm series_laws_tail_convergence(a, k)
thm series_laws_tail_sum_reverse_one_bound:
    ? forall a seq(R), T R, epsilon R+, n0, m, n N+:
        series_shift(a, 1) $in seq(R)
        $is_tail_close_to(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T, epsilon, n0)
        m = n - 1
        m >= n0
        =>:
            abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon
    thm equal_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    thm prefix_translation_distance:
        ? forall total, tail, prefix, center R:
            total = tail + prefix
            =>:
                abs(total - (prefix + center)) = abs(tail - center)
        total - (prefix + center) = (tail + prefix) - (prefix + center) = tail - center
        abs(total - (prefix + center)) = abs(tail - center)
    thm equality_transports_weak_bound:
        ? forall left, right, bound R:
            left = right
            right <= bound
            =>:
                left <= bound
    abs(fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) - T) <= epsilon
    fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) = partial_sum(series_shift(a, 1), m)
    fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n)
    release thm partial_sum_series_shift_plus_prefix(a, 1, m)
    m + 1 = (n - 1) + 1 = n
    partial_sum(a, m + 1) = partial_sum(a, n)
    partial_sum(series_shift(a, 1), m) + partial_sum(a, 1) = partial_sum(a, n)
    release thm equal_values_have_equal_distance(fn(k N+) R {partial_sum(a, k)}(n), partial_sum(a, n), partial_sum(a, 1) + T)
    release thm prefix_translation_distance(partial_sum(a, n), partial_sum(series_shift(a, 1), m), partial_sum(a, 1), T)
    release thm equal_values_have_equal_distance(partial_sum(series_shift(a, 1), m), fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m), T)
    abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) = abs(partial_sum(a, n) - (partial_sum(a, 1) + T)) = abs(partial_sum(series_shift(a, 1), m) - T) = abs(fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) - T)
    release thm equality_transports_weak_bound(abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)), abs(fn(k N+) R {partial_sum(series_shift(a, 1), k)}(m) - T), epsilon)
thm series_laws_tail_sum_reverse_one_bound_direct:
    ? forall a seq(R), T R, epsilon R+, n0, n N+:
        $is_tail_close_to(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T, epsilon, n0)
        n >= n0 + 1
        =>:
            abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon
    n0 >= 1
    n0 + 1 >= 1 + 1
    1 + 1 = 2
    n0 + 1 >= 2
    n >= n0 + 1 >= 2
    n >= 2
    n - 1 $in N
    n - 1 >= 1
    n - 1 >= 1 > 0
    n - 1 $in N+
    have m N+ = n - 1
    n - 1 >= (n0 + 1) - 1 = n0
    m = n - 1 >= n0
    release thm series_laws_tail_sum_reverse_one_bound(a, T, epsilon, n0, m, n)
thm series_laws_tail_sum_reverse_one:
    ? forall a seq(R), T R:
        $has_series_sum(series_shift(a, 1), T)
        =>:
            $has_series_sum(a, partial_sum(a, 1) + T)
    $has_limit(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T)
    claim:
        ? forall epsilon R+:
            exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, N0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(series_shift(a, 1), k)}, T, epsilon, n0)}
        n0 + 1 $in N+
        witness exist N1 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, N1)} from n0 + 1:
            claim:
                ? forall n N+:
                    n >= n0 + 1
                    =>:
                        abs(fn(k N+) R {partial_sum(a, k)}(n) - (partial_sum(a, 1) + T)) <= epsilon
                release thm series_laws_tail_sum_reverse_one_bound_direct(a, T, epsilon, n0, n)
            by def $is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, n0 + 1)
            $is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T, epsilon, n0 + 1)
    by def $has_limit(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T)
    $has_limit(fn(k N+) R {partial_sum(a, k)}, partial_sum(a, 1) + T)
    by def $has_series_sum(a, partial_sum(a, 1) + T)
have fn telescoping_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {a(j) - a(j + 1)}
thm telescoping_partial_sum_identity:
    ? forall a seq(R), k N+:
        partial_sum(telescoping_terms(a), k) = a(1) - a(k + 1)
    thm equal_functions_have_equal_values:
        ? forall left, right fn(index N+) R, input N+:
            left = right
            =>:
                left(input) = right(input)
    telescoping_terms(a) = fn(j N+) R {a(j) - a(j + 1)}
    have b seq(R) = telescoping_terms(a)
    claim:
        ? forall r N+:
            partial_sum(b, r) = a(1) - a(r + 1)
        by induc r from 1:
            ? partial_sum(b, r) = a(1) - a(r + 1)
            ? from r = 1:
                partial_sum(b, 1) = partial_sum(b, 0) + b(1)
                partial_sum(b, 0) = 0
                b(1) = telescoping_terms(a)(1)
                release thm equal_functions_have_equal_values(telescoping_terms(a), fn(j N+) R {a(j) - a(j + 1)}, 1)
                telescoping_terms(a)(1) = fn(j N+) R {a(j) - a(j + 1)}(1) = a(1) - a(1 + 1)
                partial_sum(b, 0) + b(1) = 0 + b(1)
                0 + b(1) = b(1)
                b(1) = telescoping_terms(a)(1) = a(1) - a(1 + 1)
                partial_sum(b, 1) = partial_sum(b, 0) + b(1) = 0 + b(1) = b(1) = telescoping_terms(a)(1) = a(1) - a(1 + 1)
                partial_sum(b, 1) = a(1) - a(1 + 1)
            ? induc:
                partial_sum(b, r) = a(1) - a(r + 1)
                r + 1 > 0
                r + 1 $in N+
                r + 1 + 1 $in N+
                release thm equal_functions_have_equal_values(telescoping_terms(a), fn(j N+) R {a(j) - a(j + 1)}, r + 1)
                partial_sum(b, r + 1) = partial_sum(b, (r + 1) - 1) + b(r + 1)
                (r + 1) - 1 = r
                partial_sum(b, (r + 1) - 1) = partial_sum(b, r)
                partial_sum(b, (r + 1) - 1) + b(r + 1) = partial_sum(b, r) + b(r + 1)
                partial_sum(b, r + 1) = partial_sum(b, r) + b(r + 1)
                b(r + 1) = telescoping_terms(a)(r + 1)
                telescoping_terms(a)(r + 1) = fn(j N+) R {a(j) - a(j + 1)}(r + 1) = a(r + 1) - a((r + 1) + 1)
                partial_sum(b, r) + b(r + 1) = (a(1) - a(r + 1)) + b(r + 1)
                (a(1) - a(r + 1)) + b(r + 1) = (a(1) - a(r + 1)) + telescoping_terms(a)(r + 1)
                (a(1) - a(r + 1)) + telescoping_terms(a)(r + 1) = (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1))
                partial_sum(b, r + 1) = partial_sum(b, r) + b(r + 1) = (a(1) - a(r + 1)) + b(r + 1) = (a(1) - a(r + 1)) + telescoping_terms(a)(r + 1) = (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1))
                partial_sum(b, r + 1) = (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1))
                (a(1) - a(r + 1)) + (a(r + 1) - a((r + 1) + 1)) = a(1) - a((r + 1) + 1)
    partial_sum(telescoping_terms(a), k) = partial_sum(b, k)
    partial_sum(b, k) = a(1) - a(k + 1)
thm telescoping_series_sum:
    ? forall a seq(R):
        $has_limit(a, 0)
        =>:
            $has_series_sum(telescoping_terms(a), a(1))
    thm telescoping_error_bound:
        ? forall observed, prefix, last, bound R:
            observed = prefix - last
            abs(last - 0) <= bound
            =>:
                abs(observed - prefix) <= bound
        abs(observed - prefix) = abs((prefix - last) - prefix) = abs(-last) = abs(last) = abs(last - 0)
        abs(observed - prefix) <= bound
    release thm fn_set_member(telescoping_terms(a), fn(index N+) R)
    telescoping_terms(a) $in seq(R)
    release thm fn_set_member(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, fn(index N+) R)
    fn(k N+) R {partial_sum(telescoping_terms(a), k)} $in seq(R)
    claim:
        ? forall epsilon R+:
            exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, N0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, 0, epsilon, n0)}
        witness exist N1 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, N1)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) - a(1)) <= epsilon
                n + 1 $in N+
                n + 1 >= n0
                abs(a(n + 1) - 0) <= epsilon
                release thm telescoping_partial_sum_identity(a, n)
                fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n) = partial_sum(telescoping_terms(a), n) = a(1) - a(n + 1)
                release thm telescoping_error_bound(fn(k N+) R {partial_sum(telescoping_terms(a), k)}(n), a(1), a(n + 1), epsilon)
            by def $is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, n0)
            $is_tail_close_to(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1), epsilon, n0)
    by def $has_limit(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1))
    $has_limit(fn(k N+) R {partial_sum(telescoping_terms(a), k)}, a(1))
    by def $has_series_sum(telescoping_terms(a), a(1))
prop is_partial_sum_bound(a seq(R), M R):
    forall k N+:
        partial_sum(a, k) <= M
prop has_bounded_partial_sums(a seq(R)):
    exist M R st {$is_partial_sum_bound(a, M)}
thm nonnegative_series_convergent_has_bounded_partial_sums:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_convergent_series(a)
        =>:
            $has_bounded_partial_sums(a)
    thm upper_bound_from_absolute_distance:
        ? forall observed, value, center, bound R:
            observed = value
            abs(observed - center) <= bound
            =>:
                value <= center + bound
        abs(value - center) = abs(observed - center)
        value - center <= abs(value - center) <= bound
        value = (value - center) + center <= bound + center = center + bound
    obtain L from $is_convergent_series(a)
    $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
    1 $in R+
    obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, 1, n0)}
    have M R = max(partial_sum(a, n0), L + 1)
    claim:
        ? forall k N+:
            partial_sum(a, k) <= M
        k <= n0 or k > n0
        by cases:
            ? partial_sum(a, k) <= M
            case k <= n0:
                release thm nonnegative_partial_sum_le_of_le(a, k, n0)
                partial_sum(a, n0) <= max(partial_sum(a, n0), L + 1)
                max(partial_sum(a, n0), L + 1) = M
                partial_sum(a, k) <= partial_sum(a, n0) <= max(partial_sum(a, n0), L + 1) = M
                partial_sum(a, k) <= M
            case k > n0:
                k >= n0
                abs(fn(j N+) R {partial_sum(a, j)}(k) - L) <= 1
                fn(j N+) R {partial_sum(a, j)}(k) = partial_sum(a, k)
                release thm upper_bound_from_absolute_distance(fn(j N+) R {partial_sum(a, j)}(k), partial_sum(a, k), L, 1)
                L + 1 <= max(partial_sum(a, n0), L + 1)
                max(partial_sum(a, n0), L + 1) = M
                partial_sum(a, k) <= L + 1 <= max(partial_sum(a, n0), L + 1) = M
                partial_sum(a, k) <= M
    witness $has_bounded_partial_sums(a) from M:
        forall k N+:
            partial_sum(a, k) <= M
        by def $is_partial_sum_bound(a, M)
        $is_partial_sum_bound(a, M)
thm nonnegative_series_bounded_partial_sums_converge:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $has_bounded_partial_sums(a)
        =>:
            $is_convergent_series(a)
    obtain M from $has_bounded_partial_sums(a)
    have partial_sums seq(R) = fn(k N+) R {partial_sum(a, k)}
    claim:
        ? forall k N+:
            k + 1 $in N+
            =>:
                partial_sums(k) <= partial_sums(k + 1)
        release thm nonnegative_partial_sum_le_of_le(a, k, k + 1)
        partial_sums(k) = partial_sum(a, k)
        partial_sums(k + 1) = partial_sum(a, k + 1)
    by def $chap6::is_increasing_sequence(partial_sums)
    claim:
        ? forall n N+:
            partial_sums(n) <= M
        partial_sums = fn(k N+) R {partial_sum(a, k)}
        partial_sums(n) = fn(k N+) R {partial_sum(a, k)}(n)
        fn(k N+) R {partial_sum(a, k)}(n) = partial_sum(a, n)
        partial_sums(n) = partial_sum(a, n)
        partial_sum(a, n) <= M
    by def $chap6::is_sequence_upper_bound(partial_sums, M)
    witness $chap6::is_bounded_above_sequence(partial_sums) from M
    release thm chap6::bounded_increasing_sequence_converges(partial_sums)
    release thm chap6::convergent_sequence_has_limit(partial_sums)
    obtain L from exist L R st {$chap6::has_limit(partial_sums, L)}
    release thm fn_set_member(fn(k N+) R {partial_sum(a, k)}, fn(index N+) R)
    claim:
        ? forall n N+:
            partial_sums(n) = fn(k N+) R {partial_sum(a, k)}(n)
        partial_sums(n) = partial_sum(a, n) = fn(k N+) R {partial_sum(a, k)}(n)
    release thm strict_limit_extensional(partial_sums, fn(k N+) R {partial_sum(a, k)}, L)
    release thm strict_limit_implies_closed_limit(fn(k N+) R {partial_sum(a, k)}, L)
    by def $has_series_sum(a, L)
    witness $is_convergent_series(a) from L
thm comparison_test_for_series:
    ? forall a, b seq(R):
        $is_convergent_series(b)
        forall n N+:
            abs(a(n)) <= b(n)
        =>:
            $is_absolutely_convergent_series(a)
    thm bound_via_equal_values:
        ? forall left, right, first, second, cap R:
            left = first
            right = second
            first <= second
            right <= cap
            =>:
                left <= cap
        left = first <= second = right <= cap
    release thm fn_set_member(fn(j N+) R {abs(a(j))}, fn(index N+) R)
    fn(j N+) R {abs(a(j))} $in seq(R)
    forall n N+:
        abs(a(n)) <= b(n)
        abs(a(n)) >= 0
        b(n) >= abs(a(n)) >= 0
        b(n) >= 0
    by def $is_nonnegative_sequence(b)
    release thm nonnegative_series_convergent_has_bounded_partial_sums(b)
    obtain M from exist M R st {$is_partial_sum_bound(b, M)}
    claim:
        ? forall k N+:
            sum(1, k, fn(i_index N+) R {abs(a(i_index))}) <= sum(1, k, fn(i_index N+) R {b(i_index)})
        release thm sum_le_sum_from_pointwise(sum(1, k, fn(i_index N+) R {abs(a(i_index))}), sum(1, k, fn(i_index N+) R {b(i_index)}))
    witness $has_bounded_partial_sums(fn(j N+) R {abs(a(j))}) from M:
        claim:
            ? forall k N+:
                partial_sum(fn(j N+) R {abs(a(j))}, k) <= M
            release thm partial_sum_abs_matches_finite_sum(a, k)
            release thm partial_sum_matches_finite_sum(b, k)
            release thm bound_via_equal_values(partial_sum(fn(j N+) R {abs(a(j))}, k), partial_sum(b, k), sum(1, k, fn(i_index N+) R {abs(a(i_index))}), sum(1, k, fn(i_index N+) R {b(i_index)}), M)
        by def $is_partial_sum_bound(fn(j N+) R {abs(a(j))}, M)
    forall n N+:
        fn(j N+) R {abs(a(j))}(n) = abs(a(n))
        abs(a(n)) >= 0
        fn(j N+) R {abs(a(j))}(n) >= 0
    by def $is_nonnegative_sequence(fn(j N+) R {abs(a(j))})
    release thm nonnegative_series_bounded_partial_sums_converge(fn(j N+) R {abs(a(j))})
    by def $is_absolutely_convergent_series(a)
thm absolute_shift_abs_terms_match:
    ? forall a seq(R), k N, n N+:
        fn(j N+) R {abs(series_shift(a, k)(j))}(n) = series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n)
    fn(j N+) R {abs(series_shift(a, k)(j))}(n) = abs(series_shift(a, k)(n))
    release thm series_shift_apply(a, k, n)
    abs(series_shift(a, k)(n)) = abs(a(n + k))
    fn(j N+) R {abs(series_shift(a, k)(j))}(n) = abs(a(n + k))
    release thm series_shift_apply(fn(i_index N+) R {abs(a(i_index))}, k, n)
    fn(i_index N+) R {abs(a(i_index))}(n + k) = abs(a(n + k))
    fn(j N+) R {abs(series_shift(a, k)(j))}(n) = abs(a(n + k)) = fn(i_index N+) R {abs(a(i_index))}(n + k) = series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n)
thm absolute_sequence_nonnegative:
    ? forall a seq(R):
        $is_nonnegative_sequence(fn(i_index N+) R {abs(a(i_index))})
    forall n N+:
        fn(i_index N+) R {abs(a(i_index))}(n) = abs(a(n))
        abs(a(n)) >= 0
        fn(i_index N+) R {abs(a(i_index))}(n) >= 0
    by def $is_nonnegative_sequence(fn(i_index N+) R {abs(a(i_index))})
thm real_add_abs_nonnegative:
    ? forall M R:
        M + abs(M) >= 0
    M >= 0 or M < 0
    by cases:
        ? M + abs(M) >= 0
        case M >= 0:
            abs(M) = M
            M + abs(M) = M + M
            M + M = 2 * M
            2 * M >= 0
            M + abs(M) >= 0
        case M < 0:
            abs(M) = (-M)
            M + abs(M) = M + (-M)
            M + (-M) = 0
            M + abs(M) >= 0
thm partial_sum_bound_at:
    ? forall a seq(R), M R, t N+:
        $is_partial_sum_bound(a, M)
        =>:
            partial_sum(a, t) <= M
thm shifted_abs_partial_sum_bound_extends_to_original:
    ? forall a seq(R), k N, M R:
        $is_partial_sum_bound(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), M)
        =>:
            $is_partial_sum_bound(fn(i_index N+) R {abs(a(i_index))}, partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M))
    thm equal_indices_have_equal_partial_sums:
        ? forall sequence seq(R), first, second N:
            first = second
            =>:
                partial_sum(sequence, first) = partial_sum(sequence, second)
    thm tail_prefix_absolute_bound:
        ? forall tail_value, prefix_value, bound R:
            tail_value <= bound
            =>:
                tail_value + prefix_value <= prefix_value + bound + abs(bound)
        abs(bound) >= 0
        tail_value + prefix_value <= bound + prefix_value = prefix_value + bound <= prefix_value + bound + abs(bound)
    thm absolute_padding_increases_value:
        ? forall value, offset R:
            value <= value + offset + abs(offset)
        offset >= 0 or offset < 0
        by cases:
            ? value <= value + offset + abs(offset)
            case offset >= 0:
                abs(offset) = offset
                value + offset + abs(offset) = value + offset + offset >= value
            case offset < 0:
                abs(offset) = -offset
                value + offset + abs(offset) = value + offset + (-offset) = value
    claim:
        ? $is_nonnegative_sequence(fn(i_index N+) R {abs(a(i_index))})
        forall n N+:
            abs(a(n)) >= 0
        by def $is_nonnegative_sequence(fn(i_index N+) R {abs(a(i_index))})
    claim:
        ? forall m N+:
            partial_sum(fn(i_index N+) R {abs(a(i_index))}, m) <= partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M)
        abs(M) >= 0
        m <= k or m > k
        by cases:
            ? partial_sum(fn(i_index N+) R {abs(a(i_index))}, m) <= partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M)
            case m <= k:
                k >= m > 0
                k $in N+
                release thm nonnegative_partial_sum_le_of_le(fn(i_index N+) R {abs(a(i_index))}, m, k)
                release thm absolute_padding_increases_value(partial_sum(fn(i_index N+) R {abs(a(i_index))}, k), M)
                partial_sum(fn(i_index N+) R {abs(a(i_index))}, m) <= partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) <= partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M)
            case m > k:
                m - k > 0
                m - k $in N+
                (m - k) + k = m
                release thm equal_indices_have_equal_partial_sums(fn(i_index N+) R {abs(a(i_index))}, m, (m - k) + k)
                release thm partial_sum_series_shift_plus_prefix(fn(i_index N+) R {abs(a(i_index))}, k, m - k)
                partial_sum(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), m - k) <= M
                release thm tail_prefix_absolute_bound(partial_sum(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), m - k), partial_sum(fn(i_index N+) R {abs(a(i_index))}, k), M)
                partial_sum(fn(i_index N+) R {abs(a(i_index))}, m) = partial_sum(fn(i_index N+) R {abs(a(i_index))}, (m - k) + k) = partial_sum(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), m - k) + partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) <= partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M)
    by def $is_partial_sum_bound(fn(i_index N+) R {abs(a(i_index))}, partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M))
thm absolute_series_laws_tail_convergence_reverse:
    ? forall a seq(R), k N:
        $is_absolutely_convergent_series(series_shift(a, k))
        =>:
            $is_absolutely_convergent_series(a)
    thm equality_preserves_nonnegative:
        ? forall value, nonnegative R:
            value = nonnegative
            nonnegative >= 0
            =>:
                value >= 0
    release thm fn_set_member(fn(i_index N+) R {abs(a(i_index))}, fn(index N+) R)
    fn(i_index N+) R {abs(a(i_index))} $in seq(R)
    release thm fn_set_member(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), fn(index N+) R)
    series_shift(fn(i_index N+) R {abs(a(i_index))}, k) $in seq(R)
    $is_convergent_series(fn(j N+) R {abs(series_shift(a, k)(j))})
    claim:
        ? forall n N+:
            abs(series_shift(a, k)(n)) = series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n)
        release thm absolute_shift_abs_terms_match(a, k, n)
        fn(j N+) R {abs(series_shift(a, k)(j))}(n) = abs(series_shift(a, k)(n))
        abs(series_shift(a, k)(n)) = fn(j N+) R {abs(series_shift(a, k)(j))}(n) = series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n)
    release thm series_convergence_extensional(fn(j N+) R {abs(series_shift(a, k)(j))}, series_shift(fn(i_index N+) R {abs(a(i_index))}, k))
    claim:
        ? forall n N+:
            series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n) >= 0
        series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n) = fn(i_index N+) R {abs(a(i_index))}(n + k)
        fn(i_index N+) R {abs(a(i_index))}(n + k) = abs(a(n + k))
        abs(a(n + k)) >= 0
        series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n) = fn(i_index N+) R {abs(a(i_index))}(n + k) = abs(a(n + k))
        release thm equality_preserves_nonnegative(series_shift(fn(i_index N+) R {abs(a(i_index))}, k)(n), abs(a(n + k)))
    by def $is_nonnegative_sequence(series_shift(fn(i_index N+) R {abs(a(i_index))}, k))
    release thm nonnegative_series_convergent_has_bounded_partial_sums(series_shift(fn(i_index N+) R {abs(a(i_index))}, k))
    obtain M from exist M R st {$is_partial_sum_bound(series_shift(fn(i_index N+) R {abs(a(i_index))}, k), M)}
    release thm shifted_abs_partial_sum_bound_extends_to_original(a, k, M)
    witness $has_bounded_partial_sums(fn(i_index N+) R {abs(a(i_index))}) from partial_sum(fn(i_index N+) R {abs(a(i_index))}, k) + M + abs(M)
    release thm absolute_sequence_nonnegative(a)
    release thm nonnegative_series_bounded_partial_sums_converge(fn(i_index N+) R {abs(a(i_index))})
    release thm series_convergence_extensional(fn(i_index N+) R {abs(a(i_index))}, fn(j N+) R {abs(a(j))})
    by def $is_absolutely_convergent_series(a)
prop is_eventually_abs_bounded_by(a, b seq(R), n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n)) <= b(n)
thm eventual_comparison_test_for_series:
    ? forall a, b seq(R), n0 N+:
        $is_convergent_series(b)
        $is_eventually_abs_bounded_by(a, b, n0)
        =>:
            $is_absolutely_convergent_series(a)
    have h N = n0 - 1
    release thm fn_set_member(series_shift(a, h), fn(index N+) R)
    series_shift(a, h) $in seq(R)
    release thm fn_set_member(series_shift(b, h), fn(index N+) R)
    series_shift(b, h) $in seq(R)
    release thm series_laws_tail_convergence(b, h)
    claim:
        ? forall n N+:
            abs(series_shift(a, h)(n)) <= series_shift(b, h)(n)
        n + h $in N+
        n >= 1
        n - 1 >= 0
        n + h = n + (n0 - 1)
        n + (n0 - 1) = n0 + (n - 1)
        n0 + (n - 1) >= n0
        n + h >= n0
        abs(a(n + h)) <= b(n + h)
        series_shift(a, h)(n) = a(n + h)
        series_shift(b, h)(n) = b(n + h)
        abs(series_shift(a, h)(n)) = abs(a(n + h))
    release thm comparison_test_for_series(series_shift(a, h), series_shift(b, h))
    release thm absolute_series_laws_tail_convergence_reverse(a, h)
have fn geometric_series_terms(x R) fn(i_index N+) R = fn(j N+) R {x^(j - 1)}
thm geometric_series_formula:
    ? forall x R:
        abs(x) < 1
        1 - x != 0
        =>:
            $has_series_sum(geometric_series_terms(x), 1 / (1 - x))
    thm equal_functions_have_equal_values:
        ? forall left, right fn(index N+) R, input N+:
            left = right
            =>:
                left(input) = right(input)
    geometric_series_terms(x) = fn(index N+) R {x^(index - 1)}
    release thm fn_set_member(geometric_series_terms(x), fn(index N+) R)
    geometric_series_terms(x) $in seq(R)
    release thm fn_set_member(series_shift(geometric_series_terms(x), 1), fn(index N+) R)
    series_shift(geometric_series_terms(x), 1) $in seq(R)
    release thm geometric_series_from_one_formula(x)
    claim:
        ? forall n N+:
            geometric_series_terms_from_one(x)(n) = series_shift(geometric_series_terms(x), 1)(n)
        geometric_series_terms_from_one(x)(n) = x^n
        series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms(x)(n + 1)
        n + 1 $in N+
        release thm equal_functions_have_equal_values(geometric_series_terms(x), fn(index N+) R {x^(index - 1)}, n + 1)
        geometric_series_terms(x)(n + 1) = fn(index N+) R {x^(index - 1)}(n + 1) = x^((n + 1) - 1)
        (n + 1) - 1 = n
        x^((n + 1) - 1) = x^n
        series_shift(geometric_series_terms(x), 1)(n) = x^n
    release thm series_sum_extensional(geometric_series_terms_from_one(x), series_shift(geometric_series_terms(x), 1), x / (1 - x))
    release thm series_laws_tail_sum_reverse_one(geometric_series_terms(x), x / (1 - x))
    1 - 1 = 0
    partial_sum(geometric_series_terms(x), 1 - 1) = partial_sum(geometric_series_terms(x), 0)
    partial_sum(geometric_series_terms(x), 0) = 0
    release thm equal_functions_have_equal_values(geometric_series_terms(x), fn(index N+) R {x^(index - 1)}, 1)
    geometric_series_terms(x)(1) = fn(index N+) R {x^(index - 1)}(1) = x^(1 - 1)
    x^(1 - 1) = x^0
    x^0 = 1
    geometric_series_terms(x)(1) = 1
    release thm partial_sum_successor(geometric_series_terms(x), 1)
    partial_sum(geometric_series_terms(x), 1) = partial_sum(geometric_series_terms(x), 1 - 1) + geometric_series_terms(x)(1)
    partial_sum(geometric_series_terms(x), 1 - 1) + geometric_series_terms(x)(1) = partial_sum(geometric_series_terms(x), 0) + geometric_series_terms(x)(1)
    partial_sum(geometric_series_terms(x), 0) + geometric_series_terms(x)(1) = 0 + geometric_series_terms(x)(1)
    0 + geometric_series_terms(x)(1) = 0 + 1
    partial_sum(geometric_series_terms(x), 1) = partial_sum(geometric_series_terms(x), 1 - 1) + geometric_series_terms(x)(1) = partial_sum(geometric_series_terms(x), 0) + geometric_series_terms(x)(1) = 0 + geometric_series_terms(x)(1) = 0 + 1
    partial_sum(geometric_series_terms(x), 1) = 0 + 1
    0 + 1 = 1
    partial_sum(geometric_series_terms(x), 1) + x / (1 - x) = 1 + x / (1 - x)
    1 + x / (1 - x) = 1 / (1 - x)
thm geometric_series_diverges_when_abs_ge_one:
    ? forall x R:
        abs(x) >= 1
        =>:
            not $is_convergent_series(geometric_series_terms(x))
    thm equal_functions_have_equal_values:
        ? forall left, right fn(index N+) R, input N+:
            left = right
            =>:
                left(input) = right(input)
    geometric_series_terms(x) = fn(index N+) R {x^(index - 1)}
    release thm fn_set_member(geometric_series_terms(x), fn(index N+) R)
    geometric_series_terms(x) $in seq(R)
    release thm fn_set_member(series_shift(geometric_series_terms(x), 1), fn(index N+) R)
    series_shift(geometric_series_terms(x), 1) $in seq(R)
    by contra:
        ? not $is_convergent_series(geometric_series_terms(x))
        $is_convergent_series(geometric_series_terms(x))
        release thm series_laws_tail_convergence(geometric_series_terms(x), 1)
        claim:
            ? forall n N+:
                series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms_from_one(x)(n)
            series_shift(geometric_series_terms(x), 1)(n) = geometric_series_terms(x)(n + 1)
            n + 1 $in N+
            release thm equal_functions_have_equal_values(geometric_series_terms(x), fn(index N+) R {x^(index - 1)}, n + 1)
            geometric_series_terms(x)(n + 1) = fn(index N+) R {x^(index - 1)}(n + 1) = x^((n + 1) - 1)
            (n + 1) - 1 = n
            x^((n + 1) - 1) = x^n
            geometric_series_terms_from_one(x)(n) = x^n
            series_shift(geometric_series_terms(x), 1)(n) = x^n
        release thm series_convergence_extensional(series_shift(geometric_series_terms(x), 1), geometric_series_terms_from_one(x))
        release thm geometric_series_from_one_diverges_when_abs_ge_one(x)
        impossible not $is_convergent_series(geometric_series_terms_from_one(x))
claim:
    ? forall j N+:
        2^(j - 1) $in N+
    j - 1 $in N
    2^(j - 1) $in N
    2^(j - 1) > 0
    2^(j - 1) $in N+
have fn condensed_terms(a seq(R)) fn(i_index N+) R = fn(j N+) R {2^(j - 1) * a(2^(j - 1))}
thm condensed_terms_first_value:
    ? forall a seq(R):
        condensed_terms(a)(1) = a(1)
    1 - 1 = 0
    2^0 = 1
    2^(1 - 1) = 2^0 = 1
    2^(1 - 1) $in N+
    condensed_terms(a)(1) = 2^(1 - 1) * a(2^(1 - 1))
    a(2^(1 - 1)) = a(1)
    2^(1 - 1) * a(2^(1 - 1)) = 1 * a(1) = a(1)
thm condensed_partial_sum_successor:
    ? forall a seq(R), K N+:
        partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
    (K + 1) - 1 = K
    partial_sum(condensed_terms(a), (K + 1) - 1) = partial_sum(condensed_terms(a), K)
    release thm partial_sum_successor(condensed_terms(a), K + 1)
    condensed_terms(a)(K + 1) = 2^((K + 1) - 1) * a(2^((K + 1) - 1))
    (K + 1) - 1 = K
    2^((K + 1) - 1) = 2^K
    a(2^((K + 1) - 1)) = a(2^K)
    2^((K + 1) - 1) * a(2^((K + 1) - 1)) = 2^K * a(2^((K + 1) - 1))
    2^K * a(2^((K + 1) - 1)) = 2^K * a(2^K)
    condensed_terms(a)(K + 1) = 2^((K + 1) - 1) * a(2^((K + 1) - 1)) = 2^K * a(2^((K + 1) - 1)) = 2^K * a(2^K)
    condensed_terms(a)(K + 1) = 2^K * a(2^K)
    partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), (K + 1) - 1) + condensed_terms(a)(K + 1)
    partial_sum(condensed_terms(a), (K + 1) - 1) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + condensed_terms(a)(K + 1)
    partial_sum(condensed_terms(a), K) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
    partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), (K + 1) - 1) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + condensed_terms(a)(K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
thm condensed_terms_nonnegative:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        =>:
            $is_nonnegative_sequence(condensed_terms(a))
    forall j N+:
        2^(j - 1) $in N+
        a(2^(j - 1)) >= 0
        2^(j - 1) >= 0
        2^(j - 1) * a(2^(j - 1)) >= 0
        condensed_terms(a)(j) = 2^(j - 1) * a(2^(j - 1))
        condensed_terms(a)(j) >= 0
    by def $is_nonnegative_sequence(condensed_terms(a))
prop has_monotone_partial_sums_up_to(a seq(R), q N):
    forall p N:
        p <= q
        =>:
            partial_sum(a, p) <= partial_sum(a, q)
thm nonnegative_partial_sums_monotone:
    ? forall a seq(R), p, q N:
        $is_nonnegative_sequence(a)
        p <= q
        =>:
            partial_sum(a, p) <= partial_sum(a, q)
    claim:
        ? forall r N:
            $has_monotone_partial_sums_up_to(a, r)
        by induc r from 0:
            ? $has_monotone_partial_sums_up_to(a, r)
            ? from r = 0:
                forall p0 N:
                    p0 <= 0
                    =>:
                        p0 = 0
                        partial_sum(a, p0) = partial_sum(a, 0)
                        partial_sum(a, p0) <= partial_sum(a, 0)
                by def $has_monotone_partial_sums_up_to(a, 0)
                $has_monotone_partial_sums_up_to(a, 0)
            ? induc:
                claim:
                    ? forall p0 N:
                        p0 <= r + 1
                        =>:
                            partial_sum(a, p0) <= partial_sum(a, r + 1)
                    by cases:
                        ? partial_sum(a, p0) <= partial_sum(a, r + 1)
                        case p0 <= r:
                            partial_sum(a, p0) <= partial_sum(a, r)
                            r + 1 $in N+
                            a(r + 1) >= 0
                            (r + 1) - 1 = r
                            partial_sum(a, (r + 1) - 1) = partial_sum(a, r)
                            partial_sum(a, (r + 1) - 1) + a(r + 1) = partial_sum(a, r) + a(r + 1)
                            release thm partial_sum_successor(a, r + 1)
                            partial_sum(a, r + 1) = partial_sum(a, r) + a(r + 1)
                            partial_sum(a, r) <= partial_sum(a, r) + a(r + 1)
                            partial_sum(a, p0) <= partial_sum(a, r) <= partial_sum(a, r + 1)
                            partial_sum(a, p0) <= partial_sum(a, r + 1)
                        case p0 > r:
                            p0 <= r + 1
                            p0 >= r + 1
                            p0 = r + 1
                            partial_sum(a, p0) = partial_sum(a, r + 1)
                            partial_sum(a, p0) <= partial_sum(a, r + 1)
                by def $has_monotone_partial_sums_up_to(a, r + 1)
                $has_monotone_partial_sums_up_to(a, r + 1)
    $has_monotone_partial_sums_up_to(a, q)
thm two_power_ge_successor:
    ? forall n N:
        2^n >= n + 1
    by induc n from 0:
        ? 2^n >= n + 1
        ? from n = 0:
            2^0 = 1 >= 0 + 1
        ? induc:
            2^n >= n + 1
            2^n * 2^1 >= (n + 1) * 2
            2 ^ (n + 1) = 2^n * 2^1 >= (n + 1) * 2 = (n + 1) + (n + 1) >= n + 1 + 1
thm dyadic_endpoint_covers_index:
    ? forall n N+:
        exist K N+ st {n <= 2^K - 1}
    release thm two_power_ge_successor(n)
    2^n - 1 >= (n + 1) - 1 = n
    n <= 2^n - 1
    witness exist K N+ st {n <= 2^K - 1} from n:
        n <= 2^n - 1
thm dyadic_block_upper_by_left_endpoint:
    ? forall a seq(R), K N+:
        2^K $in N+
        $is_decreasing_sequence(a)
        2^(K + 1) - 1 $in N+
        2^K <= 2^(K + 1) - 1
        =>:
            sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) <= 2^K * a(2^K)
    2^K $in N+
    2^(K + 1) - 1 $in N+
    release thm decreasing_finite_block_upper_by_left_endpoint(a, 2^K, 2^(K + 1) - 1)
    have c R = a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c}) = ((2^(K + 1) - 1 - 2^K) + 1) * c
    claim:
        ? forall i_index N+:
            2^K <= i_index <= 2^(K + 1) - 1
            =>:
                a(2^K) <= c
                c <= a(2^K)
        a(2^K) = c
    release thm sum_le_sum_from_pointwise(sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}), sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c}))
    release thm sum_le_sum_from_pointwise(sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c}), sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}))
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}) = sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {c})
    ((2^(K + 1) - 1 - 2^K) + 1) * c = ((2^(K + 1) - 1 - 2^K) + 1) * a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}) = ((2^(K + 1) - 1 - 2^K) + 1) * a(2^K)
    2^(K + 1) = 2^K * 2^1
    2^1 = 2
    2^(K + 1) = 2^K * 2
    ((2^(K + 1) - 1 - 2^K) + 1) = ((2^K * 2 - 1 - 2^K) + 1)
    ((2^K * 2 - 1 - 2^K) + 1) = 2^K
    ((2^(K + 1) - 1 - 2^K) + 1) * a(2^K) = 2^K * a(2^K)
    sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(2^K)}) = 2^K * a(2^K)
thm dyadic_block_lower_by_right_endpoint:
    ? forall a seq(R), K N+:
        2^(K - 1) + 1 $in N+
        2^K $in N+
        $is_decreasing_sequence(a)
        2^(K - 1) + 1 <= 2^K
        =>:
            2^(K - 1) * a(2^K) <= sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(i_index)})
    2^(K - 1) $in N+
    2^(K - 1) + 1 $in N+
    2^K $in N+
    release thm decreasing_finite_block_lower_by_right_endpoint(a, 2^(K - 1) + 1, 2^K)
    have c R = a(2^K)
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c}) = ((2^K - (2^(K - 1) + 1)) + 1) * c
    claim:
        ? forall i_index N+:
            2^(K - 1) + 1 <= i_index <= 2^K
            =>:
                a(2^K) <= c
                c <= a(2^K)
        a(2^K) = c
    release thm sum_le_sum_from_pointwise(sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}), sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c}))
    release thm sum_le_sum_from_pointwise(sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c}), sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}))
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}) = sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {c})
    ((2^K - (2^(K - 1) + 1)) + 1) * c = ((2^K - (2^(K - 1) + 1)) + 1) * a(2^K)
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}) = ((2^K - (2^(K - 1) + 1)) + 1) * a(2^K)
    K - 1 $in N
    2^K = 2^((K - 1) + 1)
    2^((K - 1) + 1) = 2^(K - 1) * 2^1
    2^1 = 2
    2^K = 2^(K - 1) * 2
    ((2^K - (2^(K - 1) + 1)) + 1) = ((2^(K - 1) * 2 - (2^(K - 1) + 1)) + 1)
    ((2^(K - 1) * 2 - (2^(K - 1) + 1)) + 1) = 2^(K - 1)
    ((2^K - (2^(K - 1) + 1)) + 1) * a(2^K) = 2^(K - 1) * a(2^K)
    sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(2^K)}) = 2^(K - 1) * a(2^K)
prop has_cauchy_condensation_lower_bound_at(a seq(R), K N+):
    condensed_terms(a) $in seq(R)
    2^K - 1 $in N
    partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
thm cauchy_condensation_partial_sum_lower_bound:
    ? forall a seq(R), K N+:
        condensed_terms(a) $in seq(R)
        $is_decreasing_sequence(a)
        2^K - 1 $in N
        =>:
            partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
    by induc K from 1:
        ? $has_cauchy_condensation_lower_bound_at(a, K)
        ? from K = 1:
            2^1 = 2
            2^1 - 1 = 1
            partial_sum(a, 2^1 - 1) = partial_sum(a, 1)
            1 - 1 = 0
            partial_sum(a, 1 - 1) = partial_sum(a, 0)
            partial_sum(a, 0) = 0
            partial_sum(a, 1 - 1) + a(1) = partial_sum(a, 0) + a(1)
            partial_sum(a, 0) + a(1) = 0 + a(1)
            release thm partial_sum_successor(a, 1)
            partial_sum(a, 1) = 0 + a(1)
            0 + a(1) = a(1)
            release thm condensed_terms_first_value(a)
            partial_sum(condensed_terms(a), 1 - 1) = partial_sum(condensed_terms(a), 0)
            partial_sum(condensed_terms(a), 0) = 0
            partial_sum(condensed_terms(a), 1 - 1) + condensed_terms(a)(1) = partial_sum(condensed_terms(a), 0) + condensed_terms(a)(1)
            partial_sum(condensed_terms(a), 0) + condensed_terms(a)(1) = 0 + condensed_terms(a)(1)
            release thm partial_sum_successor(condensed_terms(a), 1)
            partial_sum(condensed_terms(a), 1) = 0 + condensed_terms(a)(1)
            0 + condensed_terms(a)(1) = condensed_terms(a)(1)
            partial_sum(condensed_terms(a), 1) = a(1)
            partial_sum(a, 2^1 - 1) <= partial_sum(condensed_terms(a), 1)
            2^1 - 1 $in N
            by def $has_cauchy_condensation_lower_bound_at(a, 1)
        ? induc:
            by def $has_cauchy_condensation_lower_bound_at(a, K)
            partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
            2^K $in N+
            release thm two_power_ge_successor(K)
            K >= 1
            K + 1 >= 1 + 1
            1 + 1 = 2
            K + 1 >= 2
            2^K >= K + 1 >= 2
            2^K >= 2
            2^K - 1 >= 1
            2^K - 1 $in N
            2^K - 1 >= 1 > 0
            2^K - 1 $in N+
            release thm two_power_ge_successor(K + 1)
            K >= 1
            K + 1 >= 2
            (K + 1) + 1 >= K + 1
            (K + 1) + 1 >= K + 1 >= 2
            (K + 1) + 1 >= 2
            2^(K + 1) >= (K + 1) + 1 >= 2
            2^(K + 1) >= 2
            2^(K + 1) - 1 >= 1
            2^(K + 1) - 1 $in N
            2^(K + 1) - 1 >= 1 > 0
            2^(K + 1) - 1 $in N+
            2^(K + 1) = 2^K * 2^1
            2^1 = 2
            2^(K + 1) = 2^K * 2
            2^K * 2 = 2^K + 2^K
            2^K + 2^K > 2^K
            2^K * 2 > 2^K
            2^(K + 1) > 2^K
            2^(K + 1) - 1 - 2^K = 2^K * 2 - 1 - 2^K
            2^K * 2 - 1 - 2^K = 2^K - 1
            2^K - 1 >= 0
            2^(K + 1) - 1 - 2^K >= 0
            2^K <= 2^(K + 1) - 1
            2^K - 1 < 2^(K + 1) - 1
            release thm partial_sum_split_after(a, 2^K - 1, 2^(K + 1) - 1)
            (2^K - 1) + 1 = 2^K
            release thm sum_le_sum_from_pointwise(sum((2^K - 1) + 1, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}), sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}))
            release thm sum_le_sum_from_pointwise(sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}), sum((2^K - 1) + 1, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}))
            sum((2^K - 1) + 1, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) = sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)})
            partial_sum(a, 2^K - 1) $in R
            sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) $in R
            partial_sum(a, 2^K - 1) + sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) $in R
            partial_sum(a, 2^(K + 1) - 1) = partial_sum(a, 2^K - 1) + sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)})
            release thm dyadic_block_upper_by_left_endpoint(a, K)
            partial_sum(a, 2^K - 1) + sum(2^K, 2^(K + 1) - 1, fn(i_index N+) R {a(i_index)}) <= partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
            partial_sum(a, 2^(K + 1) - 1) <= partial_sum(condensed_terms(a), K) + 2^K * a(2^K)
            release thm condensed_partial_sum_successor(a, K)
            partial_sum(a, 2^(K + 1) - 1) <= partial_sum(condensed_terms(a), K + 1)
            by def $has_cauchy_condensation_lower_bound_at(a, K + 1)
    $has_cauchy_condensation_lower_bound_at(a, K)
    by def $has_cauchy_condensation_lower_bound_at(a, K)
thm cauchy_condensation_partial_sum_upper_strong:
    ? forall a seq(R), K N+:
        condensed_terms(a) $in seq(R)
        2^(K - 1) $in N
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        =>:
            partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^(K - 1))
    thm equal_factors_preserve_product:
        ? forall left, right, factor R:
            left = right
            =>:
                left * factor = right * factor
    thm twice_a_sum:
        ? forall left, right R:
            2 * left + 2 * right = 2 * (left + right)
    thm twice_equal_real_values:
        ? forall left, right R:
            left = right
            =>:
                2 * left = 2 * right
    thm equal_endpoints_have_equal_doubled_partial_sums:
        ? forall b seq(R), left, right N:
            left = right
            =>:
                2 * partial_sum(b, left) = 2 * partial_sum(b, right)
    by induc K from 1:
        ? partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^(K - 1))
        ? from K = 1:
            release thm condensed_terms_first_value(a)
            release thm partial_sum_successor(condensed_terms(a), 1)
            release thm partial_sum_successor(a, 1)
            partial_sum(condensed_terms(a), 0) = 0
            partial_sum(a, 0) = 0
            partial_sum(condensed_terms(a), 1) = partial_sum(condensed_terms(a), 1 - 1) + condensed_terms(a)(1)
            partial_sum(condensed_terms(a), 1 - 1) = partial_sum(condensed_terms(a), 0) = 0
            partial_sum(condensed_terms(a), 1 - 1) + condensed_terms(a)(1) = 0 + condensed_terms(a)(1) = condensed_terms(a)(1) = a(1)
            partial_sum(condensed_terms(a), 1) = a(1)
            partial_sum(a, 1) = partial_sum(a, 1 - 1) + a(1)
            partial_sum(a, 1 - 1) = partial_sum(a, 0) = 0
            partial_sum(a, 1 - 1) + a(1) = 0 + a(1) = a(1)
            partial_sum(a, 1) = a(1)
            a(1) >= 0
            2^(1 - 1) = 2^0 = 1
            partial_sum(condensed_terms(a), 1) = a(1) <= 2 * a(1) = 2 * partial_sum(a, 1) = 2 * partial_sum(a, 2^(1 - 1))
        ? induc:
            2^(K - 1) $in N+
            2^K $in N+
            2^K = 2^((K - 1) + 1) = 2^(K - 1) * 2 = (2^(K - 1)) * 2 = 2 * (2^(K - 1))
            (2^(K - 1)) >= 1
            (2^(K - 1)) + 1 <= (2^(K - 1)) + (2^(K - 1)) = 2 * (2^(K - 1)) = 2^K
            (2^(K - 1)) < (2^(K - 1)) + 1 <= 2^K
            2^(K - 1) + 1 $in N+
            claim:
                ? forall interval_index Z:
                    2^(K - 1) + 1 <= interval_index
                    interval_index <= 2^K
                    =>:
                        interval_index $in N+
                1 <= (2^(K - 1)) < (2^(K - 1)) + 1 = 2^(K - 1) + 1 <= interval_index
                interval_index >= 1
                interval_index > 0
                interval_index $in N+
            (2^(K - 1)) + 1 $in N+
            claim:
                ? forall interval_index Z:
                    (2^(K - 1)) + 1 <= interval_index
                    interval_index <= 2^K
                    =>:
                        interval_index $in N+
                1 <= (2^(K - 1)) < (2^(K - 1)) + 1 <= interval_index
                interval_index > 0
                interval_index $in N+
            release thm dyadic_block_lower_by_right_endpoint(a, K)
            release thm condensed_partial_sum_successor(a, K)
            release thm partial_sum_split_after(a, (2^(K - 1)), 2^K)
            release thm equal_factors_preserve_product(2^K, 2 * (2^(K - 1)), a(2^K))
            sum((2^(K - 1)) + 1, 2^K, fn(i_index N+) R {a(i_index)}) $in R
            2 * sum((2^(K - 1)) + 1, 2^K, fn(i_index N+) R {a(i_index)}) $in R
            2^K * a(2^K) = 2 * ((2^(K - 1)) * a(2^K)) <= 2 * sum((2^(K - 1)) + 1, 2^K, fn(i_index N+) R {a(i_index)})
            partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, (2^(K - 1)))
            release thm twice_a_sum(partial_sum(a, 2^(K - 1)), sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(i_index)}))
            release thm twice_equal_real_values(partial_sum(a, 2^(K - 1)) + sum(2^(K - 1) + 1, 2^K, fn(i_index N+) R {a(i_index)}), partial_sum(a, 2^K))
            partial_sum(condensed_terms(a), K + 1) = partial_sum(condensed_terms(a), K) + 2^K * a(2^K) <= 2 * partial_sum(a, (2^(K - 1))) + 2 * sum((2^(K - 1)) + 1, 2^K, fn(i_index N+) R {a(i_index)}) = 2 * (partial_sum(a, (2^(K - 1))) + sum((2^(K - 1)) + 1, 2^K, fn(i_index N+) R {a(i_index)})) = 2 * partial_sum(a, 2^K)
            (K + 1) - 1 = K
            2^((K + 1) - 1) = 2^K
            release thm equal_endpoints_have_equal_doubled_partial_sums(a, 2^K, 2^((K + 1) - 1))
            partial_sum(condensed_terms(a), K + 1) <= 2 * partial_sum(a, 2^((K + 1) - 1))
thm cauchy_condensation_partial_sum_bounds:
    ? forall a seq(R), K N+:
        condensed_terms(a) $in seq(R)
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        2^K - 1 $in N
        =>:
            partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K)
            partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^K)
    K - 1 $in N
    2^(K - 1) $in N+
    2^(K - 1) $in N
    release thm cauchy_condensation_partial_sum_lower_bound(a, K)
    release thm cauchy_condensation_partial_sum_upper_strong(a, K)
    K >= 1
    K - 1 $in N
    2^(K - 1) $in N+
    2^K $in N+
    2^K = 2^((K - 1) + 1)
    2^((K - 1) + 1) = 2^(K - 1) * 2^1
    2^1 = 2
    2^K = 2^(K - 1) * 2
    2^(K - 1) * 2 = 2^(K - 1) + 2^(K - 1)
    2^(K - 1) >= 0
    2^(K - 1) + 2^(K - 1) >= 2^(K - 1)
    2^K >= 2^(K - 1)
    2^(K - 1) <= 2^K
    release thm nonnegative_partial_sums_monotone(a, 2^(K - 1), 2^K)
    2 >= 0
    2 * partial_sum(a, 2^(K - 1)) <= 2 * partial_sum(a, 2^K)
    partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^(K - 1)) <= 2 * partial_sum(a, 2^K)
thm cauchy_condensation_test_forward:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        $is_convergent_series(a)
        =>:
            $is_convergent_series(condensed_terms(a))
    release thm fn_set_member(condensed_terms(a), fn(index N+) R)
    condensed_terms(a) $in seq(R)
    release thm nonnegative_series_convergent_has_bounded_partial_sums(a)
    obtain M from exist M R st {$is_partial_sum_bound(a, M)}
    have B R = 2 * M
    claim:
        ? forall K N+:
            partial_sum(condensed_terms(a), K) <= B
        2^K $in N+
        2^K >= 1
        2^K - 1 $in N
        release thm cauchy_condensation_partial_sum_bounds(a, K)
        partial_sum(a, 2^K) <= M
        2 >= 0
        2 * partial_sum(a, 2^K) <= 2 * M
        partial_sum(condensed_terms(a), K) <= 2 * partial_sum(a, 2^K) <= 2 * M
        2 * M = B
    by def $is_partial_sum_bound(condensed_terms(a), B)
    witness $has_bounded_partial_sums(condensed_terms(a)) from B
    release thm condensed_terms_nonnegative(a)
    release thm nonnegative_series_bounded_partial_sums_converge(condensed_terms(a))
thm cauchy_condensation_test_reverse:
    ? forall a seq(R):
        $is_nonnegative_sequence(a)
        $is_decreasing_sequence(a)
        $is_convergent_series(condensed_terms(a))
        =>:
            $is_convergent_series(a)
    release thm condensed_terms_nonnegative(a)
    release thm nonnegative_series_convergent_has_bounded_partial_sums(condensed_terms(a))
    obtain M from exist M R st {$is_partial_sum_bound(condensed_terms(a), M)}
    claim:
        ? forall k N+:
            partial_sum(a, k) <= M
        release thm dyadic_endpoint_covers_index(k)
        obtain K from exist K N+ st {k <= 2^K - 1}
        2^K $in N+
        2^K >= 1
        2^K - 1 $in N
        release thm nonnegative_partial_sums_monotone(a, k, 2^K - 1)
        release thm cauchy_condensation_partial_sum_bounds(a, K)
        partial_sum(condensed_terms(a), K) <= M
        partial_sum(a, k) <= partial_sum(a, 2^K - 1) <= partial_sum(condensed_terms(a), K) <= M
    by def $is_partial_sum_bound(a, M)
    witness $has_bounded_partial_sums(a) from M
    release thm nonnegative_series_bounded_partial_sums_converge(a)
prop is_p_series_term_value(q R+, n N+, value R):
    n^q != 0
    value = 1 / n^q
thm p_series_term_value_exists_unique:
    ? forall q R+, n N+:
        exist! value R st {$is_p_series_term_value(q, n, value)}
    n $in R+
    release thm chap6::real_power_positive(n, q)
    n^q > 0
    n^q != 0
    witness exist value R st {$is_p_series_term_value(q, n, value)} from 1 / n^q:
        n^q != 0
        1 / n^q = 1 / n^q
        by def $is_p_series_term_value(q, n, 1 / n^q)
    obtain chosen from exist value R st {$is_p_series_term_value(q, n, value)}
    claim:
        ? forall value1, value2 R:
            $is_p_series_term_value(q, n, value1)
            $is_p_series_term_value(q, n, value2)
            =>:
                value1 = value2
        by def $is_p_series_term_value(q, n, value1)
        by def $is_p_series_term_value(q, n, value2)
        value1 = 1 / n^q = value2
    witness exist! value R st {$is_p_series_term_value(q, n, value)} from chosen
claim:
    ? forall q R+, n N+:
        exist! value R st {$is_p_series_term_value(q, n, value)}
    release thm p_series_term_value_exists_unique(q, n)
have fn p_series_term by exist!:
    ? forall q R+, n N+:
        exist! value R st {$is_p_series_term_value(q, n, value)}
thm p_series_term_apply:
    ? forall q R+, n N+:
        n^q != 0
        =>:
            p_series_term(q, n) = 1 / n^q
    $is_p_series_term_value(q, n, p_series_term(q, n))
    by def $is_p_series_term_value(q, n, p_series_term(q, n))
have fn p_series_terms(q R+) fn(i_index N+) R = fn(j N+) R {p_series_term(q, j)}
thm p_series_terms_apply:
    ? forall q R+, n N+:
        n^q != 0
        =>:
            p_series_terms(q)(n) = 1 / n^q
    p_series_terms(q)(n) = p_series_term(q, n)
    release thm p_series_term_apply(q, n)
thm p_series_terms_nonnegative:
    ? forall q R+:
        $is_nonnegative_sequence(p_series_terms(q))
    claim:
        ? forall n N+:
            p_series_terms(q)(n) >= 0
        n $in R+
        release thm chap6::real_power_positive(n, q)
        n^q > 0
        1 / n^q > 0
        release thm p_series_terms_apply(q, n)
        p_series_terms(q)(n) = 1 / n^q >= 0
    by def $is_nonnegative_sequence(p_series_terms(q))
thm p_series_terms_decreasing:
    ? forall q R+:
        $is_decreasing_sequence(p_series_terms(q))
    thm reciprocal_reverses_positive_order:
        ? forall small, large R+:
            small <= large
            =>:
                1 / large <= 1 / small
        small * large > 0
        1 / large = small / (small * large)
        small / (small * large) <= large / (small * large)
        large / (small * large) = 1 / small
        1 / large = small / (small * large) <= large / (small * large) = 1 / small
    claim:
        ? forall n N+:
            n + 1 $in N+
            =>:
                p_series_terms(q)(n + 1) <= p_series_terms(q)(n)
        n $in R+
        n + 1 $in R+
        n + 1 > n
        release thm chap6::real_power_positive(n, q)
        release thm chap6::real_power_positive(n + 1, q)
        release thm chap6::real_power_base_strict_mono(n + 1, n, q)
        n^q <= (n + 1)^q
        release thm reciprocal_reverses_positive_order(n^q, (n + 1)^q)
        release thm p_series_terms_apply(q, n)
        release thm p_series_terms_apply(q, n + 1)
        p_series_terms(q)(n + 1) = 1 / (n + 1)^q <= 1 / n^q = p_series_terms(q)(n)
        p_series_terms(q)(n + 1) <= p_series_terms(q)(n)
    by def $is_decreasing_sequence(p_series_terms(q))
thm condensed_p_series_is_geometric:
    ? forall q R+, j N+:
        condensed_terms(p_series_terms(q))(j) = geometric_series_terms(2^(1 - q))(j)
    release obj def condensed_terms
    release obj def geometric_series_terms
    j - 1 $in N
    2^(j - 1) $in N+
    2^(j - 1) $in R+
    release thm chap6::real_power_positive(2^(j - 1), q)
    release thm p_series_terms_apply(q, 2^(j - 1))
    condensed_terms(p_series_terms(q))(j) = 2^(j - 1) * p_series_terms(q)(2^(j - 1))
    p_series_terms(q)(2^(j - 1)) = 1 / (2^(j - 1))^q
    release thm chap6::real_power_power_law(2, j - 1, q)
    release thm chap6::real_power_power_law(2, 1 - q, j - 1)
    release thm chap6::real_power_add_law(2, (j - 1) * q, (1 - q) * (j - 1))
    (j - 1) * q + (1 - q) * (j - 1) = j - 1
    2^((j - 1) * q) * 2^((1 - q) * (j - 1)) = 2^((j - 1) * q + (1 - q) * (j - 1)) = 2^(j - 1)
    (2^(j - 1))^q * (2^(1 - q))^(j - 1) = 2^((j - 1) * q) * 2^((1 - q) * (j - 1)) = 2^(j - 1)
    (2^(1 - q))^(j - 1) = 2^(j - 1) / (2^(j - 1))^q
    2^(j - 1) * (1 / (2^(j - 1))^q) = 2^(j - 1) / (2^(j - 1))^q
    condensed_terms(p_series_terms(q))(j) = 2^(j - 1) * p_series_terms(q)(2^(j - 1)) = 2^(j - 1) * (1 / (2^(j - 1))^q) = 2^(j - 1) / (2^(j - 1))^q = (2^(1 - q))^(j - 1)
    geometric_series_terms(2^(1 - q))(j) = (2^(1 - q))^(j - 1)
    condensed_terms(p_series_terms(q))(j) = geometric_series_terms(2^(1 - q))(j)
thm p_series_converges_when_exponent_gt_one:
    ? forall q R+:
        q > 1
        =>:
            $is_convergent_series(p_series_terms(q))
    1 - q < 0
    release thm chap6::real_power_positive(2, 1 - q)
    release thm chap6::real_power_exponent_strict_mono_above_one(2, 0, 1 - q)
    2^0 = 1
    2^(1 - q) < 1
    abs(2^(1 - q)) = 2^(1 - q) < 1
    1 - 2^(1 - q) > 0
    release thm geometric_series_formula(2^(1 - q))
    witness $is_convergent_series(geometric_series_terms(2^(1 - q))) from 1 / (1 - 2^(1 - q))
    release thm fn_set_member(condensed_terms(p_series_terms(q)), seq(R))
    release thm fn_set_member(geometric_series_terms(2^(1 - q)), seq(R))
    claim:
        ? forall index N+:
            geometric_series_terms(2^(1 - q))(index) = condensed_terms(p_series_terms(q))(index)
        release thm condensed_p_series_is_geometric(q, index)
    release thm series_convergence_extensional(geometric_series_terms(2^(1 - q)), condensed_terms(p_series_terms(q)))
    release thm p_series_terms_nonnegative(q)
    release thm p_series_terms_decreasing(q)
    release thm cauchy_condensation_test_reverse(p_series_terms(q))
thm p_series_diverges_when_exponent_le_one:
    ? forall q R+:
        q <= 1
        =>:
            not $is_convergent_series(p_series_terms(q))
    have r R+ = 2^(1 - q)
    claim:
        ? r >= 1
        q = 1 or q < 1
        by cases:
            ? r >= 1
            case q = 1:
                1 - q = 0
                r = 2^0 = 1
            case q < 1:
                1 - q > 0
                release thm chap6::real_power_exponent_strict_mono_above_one(2, 1 - q, 0)
                2^(1 - q) > 2^0 = 1
                r > 1
    r > 0
    abs(r) = r >= 1
    release thm geometric_series_diverges_when_abs_ge_one(r)
    by contra:
        ? not $is_convergent_series(p_series_terms(q))
        $is_convergent_series(p_series_terms(q))
        release thm p_series_terms_nonnegative(q)
        release thm p_series_terms_decreasing(q)
        release thm cauchy_condensation_test_forward(p_series_terms(q))
        claim:
            ? forall j N+:
                condensed_terms(p_series_terms(q))(j) = geometric_series_terms(r)(j)
            release thm condensed_p_series_is_geometric(q, j)
            condensed_terms(p_series_terms(q))(j) = geometric_series_terms(2^(1 - q))(j)
            2^(1 - q) = r
            geometric_series_terms(2^(1 - q))(j) = geometric_series_terms(r)(j)
        release thm series_convergence_extensional(condensed_terms(p_series_terms(q)), geometric_series_terms(r))
        impossible not $is_convergent_series(geometric_series_terms(r))
prop is_permutation_of_positive_integers(phi fn(i_index N+) N+):
    forall y N+:
        exist! x N+ st {phi(x) = y}
have fn rearranged_series(a seq(R), phi fn(i_index N+) N+) fn(i_index N+) R = fn(j N+) R {a(phi(j))}
thm rearranged_series_apply:
    ? forall a seq(R), phi fn(i_index N+) N+, n N+:
        rearranged_series(a, phi)(n) = a(phi(n))
prop has_mutually_cofinal_partial_sums(a, b seq(R)):
    forall n N+:
        exist m N+ st {partial_sum(a, n) <= partial_sum(b, m)}
    forall n N+:
        exist m N+ st {partial_sum(b, n) <= partial_sum(a, m)}
prop has_bounded_prefix_image(phi fn(i_index N+) N+, n N+, M N+):
    forall j N+:
        j <= n
        =>:
            phi(j) <= M
prop has_bounded_prefix_preimage(phi fn(i_index N+) N+, n N+, M N+):
    forall j N+:
        j <= n
        =>:
            exist t N+ st {t <= M, phi(t) = j}
have fn positive_nat_max(left, right N+) N+ by cases:
    case left >= right: left
    case left < right: right
thm positive_nat_max_left_bound:
    ? forall left, right N+:
        left <= positive_nat_max(left, right)
    left >= right or left < right
    by cases:
        ? left <= positive_nat_max(left, right)
        case left >= right:
            positive_nat_max(left, right) = left
        case left < right:
            positive_nat_max(left, right) = right
            left <= right
thm positive_nat_max_right_bound:
    ? forall left, right N+:
        right <= positive_nat_max(left, right)
    left >= right or left < right
    by cases:
        ? right <= positive_nat_max(left, right)
        case left >= right:
            positive_nat_max(left, right) = left
            right <= left
        case left < right:
            positive_nat_max(left, right) = right
have fn prefix_image_bound(phi fn(i_index N+) N+, n Z: n >= 1) N+ by induc n from 1:
    case n = 1: phi(1)
    case n > 1: positive_nat_max(prefix_image_bound(phi, n - 1), phi(n))
prop prefix_image_bound_bounds_up_to(phi fn(i_index N+) N+, n N+):
    forall j N+:
        j <= n
        =>:
            phi(j) <= prefix_image_bound(phi, n)
thm prefix_image_bound_bounds:
    ? forall phi fn(i_index N+) N+, n N+:
        $prefix_image_bound_bounds_up_to(phi, n)
    by induc n from 1:
        ? $prefix_image_bound_bounds_up_to(phi, n)
        ? from n = 1:
            claim:
                ? forall j N+:
                    j <= 1
                    =>:
                        phi(j) <= prefix_image_bound(phi, 1)
                j >= 1
                j = 1
                phi(j) = phi(1)
                prefix_image_bound(phi, 1) = phi(1)
            by def $prefix_image_bound_bounds_up_to(phi, 1)
            $prefix_image_bound_bounds_up_to(phi, 1)
        ? induc:
            n + 1 > 1
            n + 1 - 1 = n
            prefix_image_bound(phi, n + 1) = positive_nat_max(prefix_image_bound(phi, n + 1 - 1), phi(n + 1))
            prefix_image_bound(phi, n + 1 - 1) = prefix_image_bound(phi, n)
            release thm positive_nat_max_left_bound(prefix_image_bound(phi, n + 1 - 1), phi(n + 1))
            prefix_image_bound(phi, n) = prefix_image_bound(phi, n + 1 - 1) <= positive_nat_max(prefix_image_bound(phi, n + 1 - 1), phi(n + 1)) = prefix_image_bound(phi, n + 1)
            prefix_image_bound(phi, n) <= prefix_image_bound(phi, n + 1)
            release thm positive_nat_max_right_bound(prefix_image_bound(phi, n + 1 - 1), phi(n + 1))
            phi(n + 1) <= positive_nat_max(prefix_image_bound(phi, n + 1 - 1), phi(n + 1)) = prefix_image_bound(phi, n + 1)
            phi(n + 1) <= prefix_image_bound(phi, n + 1)
            claim:
                ? forall j N+:
                    j <= n + 1
                    =>:
                        phi(j) <= prefix_image_bound(phi, n + 1)
                by cases:
                    ? phi(j) <= prefix_image_bound(phi, n + 1)
                    case j <= n:
                        phi(j) <= prefix_image_bound(phi, n)
                        phi(j) <= prefix_image_bound(phi, n) <= prefix_image_bound(phi, n + 1)
                        phi(j) <= prefix_image_bound(phi, n + 1)
                    case j > n:
                        j >= n + 1
                        j = n + 1
                        phi(j) = phi(n + 1)
                        phi(j) <= prefix_image_bound(phi, n + 1)
            by def $prefix_image_bound_bounds_up_to(phi, n + 1)
            $prefix_image_bound_bounds_up_to(phi, n + 1)
thm rearranged_series_nonnegative:
    ? forall a seq(R), phi fn(i_index N+) N+:
        $is_nonnegative_sequence(a)
        =>:
            $is_nonnegative_sequence(rearranged_series(a, phi))
    forall n N+:
        rearranged_series(a, phi)(n) = a(phi(n))
        phi(n) $in N+
        a(phi(n)) >= 0
        rearranged_series(a, phi)(n) >= 0
    by def $is_nonnegative_sequence(rearranged_series(a, phi))
thm permutation_prefix_image_has_bound:
    ? forall phi fn(i_index N+) N+, n N+:
        $is_permutation_of_positive_integers(phi)
        =>:
            exist M N+ st {$has_bounded_prefix_image(phi, n, M)}
    have M N+ = prefix_image_bound(phi, n)
    release thm prefix_image_bound_bounds(phi, n)
    forall j N+:
        j <= n
        =>:
            phi(j) <= prefix_image_bound(phi, n)
            prefix_image_bound(phi, n) = M
            phi(j) <= M
    by def $has_bounded_prefix_image(phi, n, M)
    witness exist M0 N+ st {$has_bounded_prefix_image(phi, n, M0)} from M:
        $has_bounded_prefix_image(phi, n, M)
thm bounded_preimage_witness_from_function:
    ? forall phi fn(i_index N+) N+, h fn(i_index N+) N+, j, M N+:
        h(j) <= M
        phi(h(j)) = j
        =>:
            exist t N+ st {t <= M, phi(t) = j}
    witness exist t N+ st {t <= M, phi(t) = j} from h(j):
        h(j) <= M
        phi(h(j)) = j
thm prefix_preimage_bound_from_right_inverse:
    ? forall phi fn(i_index N+) N+, h fn(i_index N+) N+, n, M N+:
        $prefix_image_bound_bounds_up_to(h, n)
        M = prefix_image_bound(h, n)
        forall j N+:
            phi(h(j)) = j
        =>:
            $has_bounded_prefix_preimage(phi, n, M)
    claim:
        ? forall j N+:
            j <= n
            =>:
                exist t N+ st {t <= M, phi(t) = j}
        h(j) <= prefix_image_bound(h, n)
        prefix_image_bound(h, n) = M
        h(j) <= M
        phi(h(j)) = j
        release thm bounded_preimage_witness_from_function(phi, h, j, M)
    by def $has_bounded_prefix_preimage(phi, n, M)
thm permutation_prefix_preimage_has_bound:
    ? forall phi fn(i_index N+) N+, n N+:
        $is_permutation_of_positive_integers(phi)
        =>:
            exist M N+ st {$has_bounded_prefix_preimage(phi, n, M)}
    claim:
        ? forall y N+:
            exist! x N+ st {phi(x) = y}
        exist! x N+ st {phi(x) = y}
    have fn preimage_func by exist!:
        ? forall y N+:
            exist! x N+ st {phi(x) = y}
    have M N+ = prefix_image_bound(preimage_func, n)
    release thm prefix_image_bound_bounds(preimage_func, n)
    claim:
        ? forall j N+:
            phi(preimage_func(j)) = j
        j = phi(preimage_func(j))
    release thm prefix_preimage_bound_from_right_inverse(phi, preimage_func, n, M)
    witness exist M0 N+ st {$has_bounded_prefix_preimage(phi, n, M0)} from M:
        $has_bounded_prefix_preimage(phi, n, M)
thm rearranged_partial_sum_le_original_at_bounded_prefix:
    ? forall a seq(R), phi fn(i_index N+) N+, n, M N+:
        rearranged_series(a, phi) $in seq(R)
        $is_nonnegative_sequence(a)
        $is_permutation_of_positive_integers(phi)
        $has_bounded_prefix_image(phi, n, M)
        =>:
            partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, M)
    claim:
        ? forall member closed_range(1, n):
            member $in N+
        member $in closed_range(1, n)
        member $in Z
        1 <= member
        member $in N+
    claim:
        ? forall member N+:
            member $in closed_range(1, n)
            =>:
                member <= n
        member $in closed_range(1, n)
        member <= n
    claim:
        ? forall member closed_range(1, M):
            member $in N+
        member $in closed_range(1, M)
        member $in Z
        1 <= member
        member $in N+
    have fn raw_image(index_i closed_range(1, n)) N+ = phi(index_i)
    $is_finite_set(closed_range(1, n))
    $is_finite_set(closed_range(1, M))
    have T finite_set = fn_range(raw_image)
    have fn image_index(index_i closed_range(1, n)) T = raw_image(index_i)
    claim:
        ? forall y T:
            y $in closed_range(1, M)
            y $in N+
        y $in fn_range(raw_image)
        have by fn_preimage: index_i from y $in fn_range(raw_image)
        index_i $in N+
        index_i <= n
        phi(index_i) <= M
        y = raw_image(index_i) = phi(index_i)
        y $in N+
        y >= 1
        y <= M
        y $in closed_range(1, M)
        y $in N+
    by def T $subset closed_range(1, M)
    claim:
        ? forall y T:
            exist! index_i closed_range(1, n) st {image_index(index_i) = y}
        have by fn_preimage: index_i from y $in fn_range(raw_image)
        witness exist! j closed_range(1, n) st {image_index(j) = y} from index_i:
            image_index(index_i) = raw_image(index_i) = y
            claim:
                ? forall i1, i2 closed_range(1, n):
                    image_index(i1) = y
                    image_index(i2) = y
                    =>:
                        i1 = i2
                i1 $in N+
                i2 $in N+
                image_index(i1) = raw_image(i1) = phi(i1)
                image_index(i2) = raw_image(i2) = phi(i2)
                phi(i1) = y
                phi(i2) = y
                y $in N+
                exist! x N+ st {phi(x) = y}
                i1 = i2
    release thm finite_set_sum_reindex(T, closed_range(1, n), fn(y T) R {a(y)}, image_index)
    claim:
        ? forall member closed_range(1, n):
            a(image_index(member)) = (fn(y T) R {a(y)})(image_index(member))
        (fn(y T) R {a(y)})(image_index(member)) = a(image_index(member))
    release thm finite_set_sum_substitution(finite_set_sum(closed_range(1, n), fn(member closed_range(1, n)) R {a(image_index(member))}), finite_set_sum(closed_range(1, n), fn(member closed_range(1, n)) R {(fn(y T) R {a(y)})(image_index(member))}))
    release thm partial_sum_matches_finite_sum(rearranged_series(a, phi), n)
    sum(1, n, fn(i_index N+) R {rearranged_series(a, phi)(i_index)}) = finite_set_sum(closed_range(1, n), fn(i_index N+) R {rearranged_series(a, phi)(i_index)})
    sum(1, n, fn(i_index N+) R {rearranged_series(a, phi)(i_index)}) = finite_set_sum(closed_range(1, n), fn(i_index N+) R {rearranged_series(a, phi)(i_index)})
    claim:
        ? forall index_i closed_range(1, n):
            rearranged_series(a, phi)(index_i) = a(image_index(index_i))
        index_i $in N+
        release thm rearranged_series_apply(a, phi, index_i)
        image_index(index_i) = raw_image(index_i) = phi(index_i)
        rearranged_series(a, phi)(index_i) = a(phi(index_i)) = a(image_index(index_i))
    release thm finite_set_sum_substitution(finite_set_sum(closed_range(1, n), fn(i_index N+) R {rearranged_series(a, phi)(i_index)}), finite_set_sum(closed_range(1, n), fn(i_index closed_range(1, n)) R {a(image_index(i_index))}))
    partial_sum(rearranged_series(a, phi), n) = sum(1, n, fn(i_index N+) R {rearranged_series(a, phi)(i_index)}) = finite_set_sum(closed_range(1, n), fn(i_index N+) R {rearranged_series(a, phi)(i_index)}) = finite_set_sum(closed_range(1, n), fn(i_index closed_range(1, n)) R {a(image_index(i_index))}) = finite_set_sum(closed_range(1, n), fn(member closed_range(1, n)) R {(fn(y T) R {a(y)})(image_index(member))}) = finite_set_sum(T, fn(y T) R {a(y)})
    have fn original_term(x closed_range(1, M)) R = a(x)
    claim:
        ? forall x closed_range(1, M):
            original_term(x) >= 0
        x $in N+
        original_term(x) = a(x) >= 0
    release thm finite_set_sum_subset_le_for_nonnegative_terms(closed_range(1, M), T, original_term)
    claim:
        ? forall x T:
            original_term(x) = a(x)
        x $in closed_range(1, M)
        original_term(x) = a(x)
    release thm finite_set_sum_substitution(finite_set_sum(T, fn(x T) R {a(x)}), finite_set_sum(T, fn(x T: x $in closed_range(1, M)) R {original_term(x)}))
    release thm partial_sum_matches_finite_sum(a, M)
    sum(1, M, fn(i_index N+) R {a(i_index)}) = finite_set_sum(closed_range(1, M), fn(i_index N+) R {a(i_index)})
    release thm finite_set_sum_substitution(finite_set_sum(closed_range(1, M), fn(i_index N+) R {a(i_index)}), finite_set_sum(closed_range(1, M), fn(i_index N+) R {a(i_index)}))
    sum(1, M, fn(i_index N+) R {a(i_index)}) = finite_set_sum(closed_range(1, M), fn(i_index N+) R {a(i_index)})
    claim:
        ? forall x closed_range(1, M):
            a(x) = original_term(x)
        original_term(x) = a(x)
    release thm finite_set_sum_substitution(finite_set_sum(closed_range(1, M), fn(i_index N+) R {a(i_index)}), finite_set_sum(closed_range(1, M), original_term))
    partial_sum(a, M) = sum(1, M, fn(i_index N+) R {a(i_index)}) = finite_set_sum(closed_range(1, M), fn(i_index N+) R {a(i_index)}) = finite_set_sum(closed_range(1, M), original_term)
    partial_sum(rearranged_series(a, phi), n) = finite_set_sum(T, fn(y T) R {a(y)}) = finite_set_sum(T, fn(x T: x $in closed_range(1, M)) R {original_term(x)}) <= finite_set_sum(closed_range(1, M), original_term) = partial_sum(a, M)
thm original_partial_sum_le_rearranged_at_bounded_preimage:
    ? forall a seq(R), phi fn(i_index N+) N+, n, M N+:
        rearranged_series(a, phi) $in seq(R)
        $is_nonnegative_sequence(a)
        $is_permutation_of_positive_integers(phi)
        $has_bounded_prefix_preimage(phi, n, M)
        =>:
            partial_sum(a, n) <= partial_sum(rearranged_series(a, phi), M)
    have fn inverse_index by exist!:
        ? forall y N+:
            exist! x N+ st {phi(x) = y}
    claim:
        ? $is_permutation_of_positive_integers(inverse_index)
        claim:
            ? forall y N+:
                exist! x N+ st {inverse_index(x) = y}
            phi(inverse_index(phi(y))) = phi(y)
            inverse_index(phi(y)) = y
            claim:
                ? forall left, right N+:
                    inverse_index(left) = y
                    inverse_index(right) = y
                    =>:
                        left = right
                phi(inverse_index(left)) = left
                phi(inverse_index(right)) = right
                left = phi(y) = right
            witness exist! chosen N+ st {inverse_index(chosen) = y} from phi(y)
        by def $is_permutation_of_positive_integers(inverse_index)
    claim:
        ? $has_bounded_prefix_image(inverse_index, n, M)
        claim:
            ? forall index N+:
                index <= n
                =>:
                    inverse_index(index) <= M
            obtain input_witness from exist input_witness N+ st {input_witness <= M, phi(input_witness) = index}
            phi(inverse_index(index)) = index = phi(input_witness)
            inverse_index(index) = input_witness <= M
        by def $has_bounded_prefix_image(inverse_index, n, M)
    release thm rearranged_series_nonnegative(a, phi)
    release thm fn_set_member(rearranged_series(rearranged_series(a, phi), inverse_index), seq(R))
    release thm rearranged_partial_sum_le_original_at_bounded_prefix(rearranged_series(a, phi), inverse_index, n, M)
    claim:
        ? forall index N+:
            rearranged_series(rearranged_series(a, phi), inverse_index)(index) = a(index)
        release thm rearranged_series_apply(rearranged_series(a, phi), inverse_index, index)
        release thm rearranged_series_apply(a, phi, inverse_index(index))
        phi(inverse_index(index)) = index
        rearranged_series(rearranged_series(a, phi), inverse_index)(index) = rearranged_series(a, phi)(inverse_index(index)) = a(phi(inverse_index(index))) = a(index)
    release thm partial_sum_extensional(rearranged_series(rearranged_series(a, phi), inverse_index), a, n)
    partial_sum(a, n) = partial_sum(rearranged_series(rearranged_series(a, phi), inverse_index), n) <= partial_sum(rearranged_series(a, phi), M)
thm rearranged_series_partial_sums_cofinal:
    ? forall a seq(R), phi fn(i_index N+) N+:
        $is_nonnegative_sequence(a)
        $is_permutation_of_positive_integers(phi)
        =>:
            $has_mutually_cofinal_partial_sums(a, rearranged_series(a, phi))
    release thm fn_set_member(rearranged_series(a, phi), fn(index N+) R)
    rearranged_series(a, phi) $in seq(R)
    claim:
        ? forall n N+:
            exist m N+ st {partial_sum(a, n) <= partial_sum(rearranged_series(a, phi), m)}
        release thm permutation_prefix_preimage_has_bound(phi, n)
        exist M N+ st {$has_bounded_prefix_preimage(phi, n, M)}
        obtain M from exist M N+ st {$has_bounded_prefix_preimage(phi, n, M)}
        release thm original_partial_sum_le_rearranged_at_bounded_preimage(a, phi, n, M)
        partial_sum(a, n) <= partial_sum(rearranged_series(a, phi), M)
        witness exist m N+ st {partial_sum(a, n) <= partial_sum(rearranged_series(a, phi), m)} from M:
            partial_sum(a, n) <= partial_sum(rearranged_series(a, phi), M)
    claim:
        ? forall n N+:
            exist m N+ st {partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, m)}
        release thm permutation_prefix_image_has_bound(phi, n)
        obtain M from exist M N+ st {$has_bounded_prefix_image(phi, n, M)}
        release thm rearranged_partial_sum_le_original_at_bounded_prefix(a, phi, n, M)
        witness exist m N+ st {partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, m)} from M:
            partial_sum(rearranged_series(a, phi), n) <= partial_sum(a, M)
    by def $has_mutually_cofinal_partial_sums(a, rearranged_series(a, phi))
thm nonnegative_partial_sum_below_series_sum:
    ? forall a seq(R), L R, n N+:
        $is_nonnegative_sequence(a)
        $has_series_sum(a, L)
        =>:
            partial_sum(a, n) <= L
    thm equal_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    by contra:
        ? partial_sum(a, n) <= L
        partial_sum(a, n) > L
        have gap R = partial_sum(a, n) - L
        gap > 0
        have epsilon R = gap / 2
        epsilon > 0
        epsilon $in R+
        $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
        obtain N0 from exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, N0)}
        have m N+ = N0 + n
        m = N0 + n >= N0
        m = N0 + n >= n
        release thm nonnegative_partial_sum_le_of_le(a, n, m)
        partial_sum(a, m) >= partial_sum(a, n) > L
        abs((fn(k N+) R {partial_sum(a, k)})(m) - L) <= epsilon
        (fn(k N+) R {partial_sum(a, k)})(m) = partial_sum(a, m)
        release thm equal_values_have_equal_distance(partial_sum(a, m), (fn(k N+) R {partial_sum(a, k)})(m), L)
        abs(partial_sum(a, m) - L) = abs((fn(k N+) R {partial_sum(a, k)})(m) - L) <= epsilon
        partial_sum(a, m) - L > 0
        abs(partial_sum(a, m) - L) = partial_sum(a, m) - L >= partial_sum(a, n) - L = gap
        epsilon = gap / 2
        gap = gap / 2 + gap / 2 = epsilon + epsilon > epsilon + 0 = epsilon
        abs(partial_sum(a, m) - L) >= gap > epsilon
        impossible abs(partial_sum(a, m) - L) <= epsilon
thm series_sum_below_common_partial_sum_upper_bound:
    ? forall a seq(R), L, M R:
        $has_series_sum(a, L)
        forall n N+:
            partial_sum(a, n) <= M
        =>:
            L <= M
    thm equal_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    by contra:
        ? L <= M
        L > M
        have epsilon R = (L - M) / 2
        L - M > 0
        epsilon = (L - M) / 2 > 0
        epsilon $in R+
        $has_limit(fn(k N+) R {partial_sum(a, k)}, L)
        obtain N0 from exist N0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, N0)}
        abs((fn(k N+) R {partial_sum(a, k)})(N0) - L) <= epsilon
        (fn(k N+) R {partial_sum(a, k)})(N0) = partial_sum(a, N0)
        release thm equal_values_have_equal_distance(partial_sum(a, N0), (fn(k N+) R {partial_sum(a, k)})(N0), L)
        abs(partial_sum(a, N0) - L) = abs((fn(k N+) R {partial_sum(a, k)})(N0) - L) <= epsilon
        partial_sum(a, N0) <= M < L
        partial_sum(a, N0) - L < 0
        abs(partial_sum(a, N0) - L) = -(partial_sum(a, N0) - L) = L - partial_sum(a, N0)
        L - partial_sum(a, N0) >= L - M
        epsilon = (L - M) / 2
        epsilon + epsilon = (L - M) / 2 + (L - M) / 2 = L - M
        L - M = epsilon + epsilon > epsilon + 0 = epsilon
        abs(partial_sum(a, N0) - L) = L - partial_sum(a, N0) >= L - M > epsilon
        impossible abs(partial_sum(a, N0) - L) <= epsilon
thm nonnegative_series_same_sum_from_cofinal_partial_sums:
    ? forall a, b seq(R), L R:
        $is_nonnegative_sequence(a)
        $is_nonnegative_sequence(b)
        $has_series_sum(a, L)
        $has_mutually_cofinal_partial_sums(a, b)
        =>:
            $has_series_sum(b, L)
    claim:
        ? forall n N+:
            partial_sum(b, n) <= L
        obtain m from exist m N+ st {partial_sum(b, n) <= partial_sum(a, m)}
        release thm nonnegative_partial_sum_below_series_sum(a, L, m)
        partial_sum(b, n) <= partial_sum(a, m) <= L
    witness $has_bounded_partial_sums(b) from L:
        forall n N+:
            partial_sum(b, n) <= L
        by def $is_partial_sum_bound(b, L)
        $is_partial_sum_bound(b, L)
    release thm nonnegative_series_bounded_partial_sums_converge(b)
    obtain M from exist M R st {$has_series_sum(b, M)}
    claim:
        ? L <= M
        claim:
            ? forall n N+:
                partial_sum(a, n) <= M
            obtain m from exist m N+ st {partial_sum(a, n) <= partial_sum(b, m)}
            release thm nonnegative_partial_sum_below_series_sum(b, M, m)
            partial_sum(a, n) <= partial_sum(b, m) <= M
        release thm series_sum_below_common_partial_sum_upper_bound(a, L, M)
    claim:
        ? M <= L
        release thm series_sum_below_common_partial_sum_upper_bound(b, M, L)
    L = M
    $has_series_sum(b, M)
thm nonnegative_rearrangement:
    ? forall a seq(R), phi fn(i_index N+) N+, L R:
        $is_nonnegative_sequence(a)
        $has_series_sum(a, L)
        $is_permutation_of_positive_integers(phi)
        =>:
            $has_series_sum(rearranged_series(a, phi), L)
    release thm rearranged_series_nonnegative(a, phi)
    release thm rearranged_series_partial_sums_cofinal(a, phi)
    release thm nonnegative_series_same_sum_from_cofinal_partial_sums(a, rearranged_series(a, phi), L)
have square_reciprocal_terms seq(R) = p_series_terms(2)
thm square_reciprocal_terms_formula:
    ? forall k N+:
        k^2 != 0
        =>:
            square_reciprocal_terms(k) = 1 / k^2
    square_reciprocal_terms(k) = p_series_terms(2)(k)
    release thm p_series_terms_apply(2, k)
thm positive_even_gt_one:
    ? forall i_index N+:
        i_index % 2 = 0
        =>:
            i_index > 1
thm positive_predecessor_exists_unique:
    ? forall i_index Z:
        i_index > 1
        =>:
            exist! value N+ st {value = i_index - 1}
    i_index - 1 > 0
    i_index - 1 >= 0
    i_index - 1 $in N
    i_index - 1 >= 1
    have positive_predecessor_candidate N = i_index - 1
    positive_predecessor_candidate = i_index - 1
    positive_predecessor_candidate $in N+
    i_index - 1 $in N+
    witness exist! value N+ st {value = i_index - 1} from i_index - 1:
        i_index - 1 = i_index - 1
        claim:
            ? forall value1, value2 N+:
                value1 = i_index - 1
                value2 = i_index - 1
                =>:
                    value1 = value2
            value1 = i_index - 1 = value2
claim:
    ? forall i_index Z:
        i_index > 1
        =>:
            exist! value N+ st {value = i_index - 1}
    release thm positive_predecessor_exists_unique(i_index)
have fn positive_predecessor by exist!:
    ? forall i_index Z:
        i_index > 1
        =>:
            exist! value N+ st {value = i_index - 1}
thm positive_predecessor_apply:
    ? forall i_index Z:
        i_index > 1
        =>:
            positive_predecessor(i_index) = i_index - 1
have fn adjacent_pair_swap_after_one(i_index Z: i_index > 1) N+ by cases:
    case i_index % 2 = 1: i_index + 1
    case i_index % 2 = 0: positive_predecessor(i_index)
claim:
    ? forall index N+:
        index = 1 or index > 1
    index >= 1
    by cases:
        ? index = 1 or index > 1
        case index <= 1:
            index = 1
        case index > 1:
            index > 1
have fn adjacent_pair_swap(i_index N+) N+ by cases:
    case i_index = 1: 2
    case i_index > 1: adjacent_pair_swap_after_one(i_index)
thm adjacent_pair_swap_odd:
    ? forall i_index N+:
        i_index % 2 = 1
        =>:
            adjacent_pair_swap(i_index) = i_index + 1
    i_index = 1 or i_index > 1
    by cases:
        ? adjacent_pair_swap(i_index) = i_index + 1
        case i_index = 1:
            adjacent_pair_swap(i_index) = 2 = i_index + 1
        case i_index > 1:
            adjacent_pair_swap(i_index) = adjacent_pair_swap_after_one(i_index)
            adjacent_pair_swap_after_one(i_index) = i_index + 1
thm adjacent_pair_swap_even:
    ? forall i_index N+:
        i_index % 2 = 0
        =>:
            adjacent_pair_swap(i_index) = i_index - 1
    release thm positive_even_gt_one(i_index)
    adjacent_pair_swap(i_index) = adjacent_pair_swap_after_one(i_index)
    adjacent_pair_swap_after_one(i_index) = positive_predecessor(i_index)
    release thm positive_predecessor_apply(i_index)
thm odd_successor_even:
    ? forall y N+:
        y % 2 = 1
        =>:
            (y + 1) % 2 = 0
    (y + 1) % 2 = (y % 2 + 1) % 2
    (y % 2 + 1) % 2 = (1 + 1) % 2
    (1 + 1) % 2 = 0
thm even_predecessor_odd:
    ? forall y N+:
        y % 2 = 0
        y > 1
        =>:
            (y - 1) % 2 = 1
    (y - 1) % 2 = (y % 2 - 1) % 2
    (y % 2 - 1) % 2 = (0 - 1) % 2
    (0 - 1) % 2 = 1
thm adjacent_pair_swap_is_involution:
    ? forall x N+:
        adjacent_pair_swap(adjacent_pair_swap(x)) = x
    x % 2 = 0 or x % 2 = 1
    by cases:
        ? adjacent_pair_swap(adjacent_pair_swap(x)) = x
        case x % 2 = 1:
            x + 1 $in N+
            release thm odd_successor_even(x)
            release thm adjacent_pair_swap_odd(x)
            release thm adjacent_pair_swap_even(x + 1)
            (x + 1) - 1 = x
            adjacent_pair_swap(adjacent_pair_swap(x)) = adjacent_pair_swap(x + 1) = (x + 1) - 1 = x
        case x % 2 = 0:
            release thm positive_even_gt_one(x)
            x - 1 > 0
            x - 1 >= 0
            x - 1 $in N
            x - 1 >= 1
            x - 1 $in N+
            release thm even_predecessor_odd(x)
            release thm adjacent_pair_swap_even(x)
            release thm adjacent_pair_swap_odd(x - 1)
            (x - 1) + 1 = x
            adjacent_pair_swap(adjacent_pair_swap(x)) = adjacent_pair_swap(x - 1) = (x - 1) + 1 = x
thm adjacent_pair_swap_is_injective:
    ? forall x1, x2 N+:
        adjacent_pair_swap(x1) = adjacent_pair_swap(x2)
        =>:
            x1 = x2
    adjacent_pair_swap(adjacent_pair_swap(x1)) = adjacent_pair_swap(adjacent_pair_swap(x2))
    release thm adjacent_pair_swap_is_involution(x1)
    release thm adjacent_pair_swap_is_involution(x2)
thm adjacent_pair_swap_has_unique_preimages:
    ? forall y N+:
        exist! x N+ st {adjacent_pair_swap(x) = y}
    y % 2 = 0 or y % 2 = 1
    by cases:
        ? exist! x N+ st {adjacent_pair_swap(x) = y}
        case y % 2 = 1:
            y + 1 $in N+
            release thm odd_successor_even(y)
            release thm adjacent_pair_swap_even(y + 1)
            (y + 1) - 1 = y
            witness exist! x N+ st {adjacent_pair_swap(x) = y} from y + 1:
                adjacent_pair_swap(y + 1) = y
                claim:
                    ? forall x1, x2 N+:
                        adjacent_pair_swap(x1) = y
                        adjacent_pair_swap(x2) = y
                        =>:
                            x1 = x2
                    adjacent_pair_swap(x1) = adjacent_pair_swap(x2)
                    release thm adjacent_pair_swap_is_injective(x1, x2)
        case y % 2 = 0:
            release thm positive_even_gt_one(y)
            y - 1 > 0
            y - 1 >= 0
            y - 1 $in N
            y - 1 >= 1
            y - 1 $in N+
            release thm even_predecessor_odd(y)
            release thm adjacent_pair_swap_odd(y - 1)
            (y - 1) + 1 = y
            witness exist! x N+ st {adjacent_pair_swap(x) = y} from y - 1:
                adjacent_pair_swap(y - 1) = y
                claim:
                    ? forall x1, x2 N+:
                        adjacent_pair_swap(x1) = y
                        adjacent_pair_swap(x2) = y
                        =>:
                            x1 = x2
                    adjacent_pair_swap(x1) = adjacent_pair_swap(x2)
                    release thm adjacent_pair_swap_is_injective(x1, x2)
forall y N+:
    exist! x N+ st {adjacent_pair_swap(x) = y}
by def $is_permutation_of_positive_integers(adjacent_pair_swap)
thm square_reciprocal_terms_nonnegative_terms:
    ? forall n N+:
        square_reciprocal_terms(n) >= 0
    n^2 > 0
    n^2 != 0
    release thm square_reciprocal_terms_formula(n)
    1 / n^2 > 0
forall n N+:
    square_reciprocal_terms(n) >= 0
by def $is_nonnegative_sequence(square_reciprocal_terms)
2 $in R+
2 > 1
release thm p_series_converges_when_exponent_gt_one(2)
thm square_reciprocal_pair_swap_preserves_sum:
    ? forall L R:
        $has_series_sum(square_reciprocal_terms, L)
        =>:
            $has_series_sum(rearranged_series(square_reciprocal_terms, adjacent_pair_swap), L)
    $is_nonnegative_sequence(square_reciprocal_terms)
    $is_permutation_of_positive_integers(adjacent_pair_swap)
    release thm nonnegative_rearrangement(square_reciprocal_terms, adjacent_pair_swap, L)
$is_convergent_series(square_reciprocal_terms)
obtain square_sum from $is_convergent_series(square_reciprocal_terms)
$has_series_sum(rearranged_series(square_reciprocal_terms, adjacent_pair_swap), square_sum)
witness $is_convergent_series(rearranged_series(square_reciprocal_terms, adjacent_pair_swap)) from square_sum
thm rearranged_absolute_value_terms_pointwise:
    ? forall a seq(R), phi fn(i_index N+) N+, n N+:
        rearranged_series(fn(j N+) R {abs(a(j))}, phi)(n) = fn(j N+) R {abs(rearranged_series(a, phi)(j))}(n)
    rearranged_series(fn(j N+) R {abs(a(j))}, phi)(n) = fn(j N+) R {abs(a(j))}(phi(n))
    fn(j N+) R {abs(a(j))}(phi(n)) = abs(a(phi(n)))
    rearranged_series(a, phi)(n) = a(phi(n))
    fn(j N+) R {abs(rearranged_series(a, phi)(j))}(n) = abs(rearranged_series(a, phi)(n))
    abs(rearranged_series(a, phi)(n)) = abs(a(phi(n)))
    rearranged_series(fn(j N+) R {abs(a(j))}, phi)(n) = fn(j N+) R {abs(a(j))}(phi(n)) = abs(a(phi(n))) = abs(rearranged_series(a, phi)(n)) = fn(j N+) R {abs(rearranged_series(a, phi)(j))}(n)
thm rearranged_series_absolutely_convergent:
    ? forall a seq(R), phi fn(i_index N+) N+:
        $is_absolutely_convergent_series(a)
        $is_permutation_of_positive_integers(phi)
        =>:
            $is_absolutely_convergent_series(rearranged_series(a, phi))
    $is_convergent_series(fn(j N+) R {abs(a(j))})
    obtain A from $is_convergent_series(fn(j N+) R {abs(a(j))})
    forall n N+:
        fn(j N+) R {abs(a(j))}(n) = abs(a(n))
        abs(a(n)) >= 0
        fn(j N+) R {abs(a(j))}(n) >= 0
    by def $is_nonnegative_sequence(fn(j N+) R {abs(a(j))})
    release thm nonnegative_rearrangement(fn(j N+) R {abs(a(j))}, phi, A)
    claim:
        ? forall n N+:
            rearranged_series(fn(j N+) R {abs(a(j))}, phi)(n) = abs(rearranged_series(a, phi)(n))
        release thm rearranged_absolute_value_terms_pointwise(a, phi, n)
        fn(j N+) R {abs(rearranged_series(a, phi)(j))}(n) = abs(rearranged_series(a, phi)(n))
        rearranged_series(fn(j N+) R {abs(a(j))}, phi)(n) = fn(j N+) R {abs(rearranged_series(a, phi)(j))}(n) = abs(rearranged_series(a, phi)(n))
    release thm series_sum_extensional(rearranged_series(fn(j N+) R {abs(a(j))}, phi), fn(j N+) R {abs(rearranged_series(a, phi)(j))}, A)
    witness $is_convergent_series(fn(j N+) R {abs(rearranged_series(a, phi)(j))}) from A:
        $has_series_sum(fn(j N+) R {abs(rearranged_series(a, phi)(j))}, A)
    $is_convergent_series(fn(j N+) R {abs(rearranged_series(a, phi)(j))})
    by def $is_absolutely_convergent_series(rearranged_series(a, phi))
have fn positive_part_series(a seq(R)) fn(i_index N+) R = fn(j N+) R {(abs(a(j)) + a(j)) / 2}
have fn negative_part_series(a seq(R)) fn(i_index N+) R = fn(j N+) R {(abs(a(j)) - a(j)) / 2}
thm positive_part_series_apply:
    ? forall a seq(R), n N+:
        positive_part_series(a)(n) = (abs(a(n)) + a(n)) / 2
thm negative_part_series_apply:
    ? forall a seq(R), n N+:
        negative_part_series(a)(n) = (abs(a(n)) - a(n)) / 2
thm positive_part_value_nonnegative:
    ? forall x R:
        (abs(x) + x) / 2 >= 0
    by cases:
        ? (abs(x) + x) / 2 >= 0
        case x > 0:
            abs(x) = x
            (abs(x) + x) / 2 = (x + x) / 2
            (x + x) / 2 = x
            x >= 0
            (abs(x) + x) / 2 >= 0
        case x = 0:
            abs(x) = 0
            (abs(x) + x) / 2 = 0
            (abs(x) + x) / 2 >= 0
        case x < 0:
            abs(x) = (-x)
            (abs(x) + x) / 2 = ((-x) + x) / 2
            ((-x) + x) / 2 = 0
            (abs(x) + x) / 2 >= 0
thm negative_part_value_nonnegative:
    ? forall x R:
        (abs(x) - x) / 2 >= 0
    by cases:
        ? (abs(x) - x) / 2 >= 0
        case x > 0:
            abs(x) = x
            (abs(x) - x) / 2 = (x - x) / 2
            (x - x) / 2 = 0
            (abs(x) - x) / 2 >= 0
        case x = 0:
            abs(x) = 0
            (abs(x) - x) / 2 = 0
            (abs(x) - x) / 2 >= 0
        case x < 0:
            abs(x) = (-x)
            (abs(x) - x) / 2 = ((-x) - x) / 2
            ((-x) - x) / 2 = (-x)
            (-x) > 0
            (-x) >= 0
            (abs(x) - x) / 2 >= 0
thm positive_part_value_le_abs:
    ? forall x R:
        (abs(x) + x) / 2 <= abs(x)
    by cases:
        ? (abs(x) + x) / 2 <= abs(x)
        case x > 0:
            abs(x) = x
            (abs(x) + x) / 2 = (x + x) / 2
            (x + x) / 2 = x
            (abs(x) + x) / 2 <= abs(x)
        case x = 0:
            abs(x) = 0
            (abs(x) + x) / 2 = 0
            (abs(x) + x) / 2 <= abs(x)
        case x < 0:
            abs(x) = (-x)
            (abs(x) + x) / 2 = ((-x) + x) / 2
            ((-x) + x) / 2 = 0
            (-x) > 0
            0 <= (-x)
            (abs(x) + x) / 2 <= abs(x)
thm negative_part_value_le_abs:
    ? forall x R:
        (abs(x) - x) / 2 <= abs(x)
    by cases:
        ? (abs(x) - x) / 2 <= abs(x)
        case x > 0:
            abs(x) = x
            (abs(x) - x) / 2 = (x - x) / 2
            (x - x) / 2 = 0
            0 <= x
            (abs(x) - x) / 2 <= abs(x)
        case x = 0:
            abs(x) = 0
            (abs(x) - x) / 2 = 0
            (abs(x) - x) / 2 <= abs(x)
        case x < 0:
            abs(x) = (-x)
            (abs(x) - x) / 2 = ((-x) - x) / 2
            ((-x) - x) / 2 = (-x)
            (abs(x) - x) / 2 <= abs(x)
thm positive_part_series_nonnegative:
    ? forall a seq(R):
        $is_nonnegative_sequence(positive_part_series(a))
    claim:
        ? forall n N+:
            positive_part_series(a)(n) >= 0
        positive_part_series(a)(n) = (abs(a(n)) + a(n)) / 2
        release thm positive_part_value_nonnegative(a(n))
    by def $is_nonnegative_sequence(positive_part_series(a))
thm negative_part_series_nonnegative:
    ? forall a seq(R):
        $is_nonnegative_sequence(negative_part_series(a))
    claim:
        ? forall n N+:
            negative_part_series(a)(n) >= 0
        negative_part_series(a)(n) = (abs(a(n)) - a(n)) / 2
        release thm negative_part_value_nonnegative(a(n))
    by def $is_nonnegative_sequence(negative_part_series(a))
thm positive_part_convergent_from_absolute:
    ? forall a seq(R):
        $is_absolutely_convergent_series(a)
        =>:
            $is_convergent_series(positive_part_series(a))
    $is_convergent_series(fn(j N+) R {abs(a(j))})
    claim:
        ? forall n N+:
            abs(positive_part_series(a)(n)) <= abs(a(n))
        positive_part_series(a)(n) = (abs(a(n)) + a(n)) / 2
        release thm positive_part_value_nonnegative(a(n))
        positive_part_series(a)(n) >= 0
        abs(positive_part_series(a)(n)) = positive_part_series(a)(n)
        release thm positive_part_value_le_abs(a(n))
        positive_part_series(a)(n) <= abs(a(n))
    release thm comparison_test_for_series(positive_part_series(a), fn(j N+) R {abs(a(j))})
    release thm absolute_convergence_test(positive_part_series(a))
thm negative_part_convergent_from_absolute:
    ? forall a seq(R):
        $is_absolutely_convergent_series(a)
        =>:
            $is_convergent_series(negative_part_series(a))
    $is_convergent_series(fn(j N+) R {abs(a(j))})
    claim:
        ? forall n N+:
            abs(negative_part_series(a)(n)) <= abs(a(n))
        negative_part_series(a)(n) = (abs(a(n)) - a(n)) / 2
        release thm negative_part_value_nonnegative(a(n))
        negative_part_series(a)(n) >= 0
        abs(negative_part_series(a)(n)) = negative_part_series(a)(n)
        release thm negative_part_value_le_abs(a(n))
        negative_part_series(a)(n) <= abs(a(n))
    release thm comparison_test_for_series(negative_part_series(a), fn(j N+) R {abs(a(j))})
    release thm absolute_convergence_test(negative_part_series(a))
thm positive_negative_parts_reconstruct_series_sum:
    ? forall a seq(R), P, Qsum R:
        $has_series_sum(positive_part_series(a), P)
        $has_series_sum(negative_part_series(a), Qsum)
        =>:
            $has_series_sum(a, P - Qsum)
    release thm series_laws_scalar_mul(negative_part_series(a), -1, Qsum)
    release thm series_laws_add(positive_part_series(a), series_scalar_mul(-1, negative_part_series(a)), P, -1 * Qsum)
    P + ((-1) * Qsum) = P - Qsum
    $has_series_sum(series_add(positive_part_series(a), series_scalar_mul(-1, negative_part_series(a))), P - Qsum)
    claim:
        ? forall n N+:
            series_add(positive_part_series(a), series_scalar_mul(-1, negative_part_series(a)))(n) = a(n)
        series_add(positive_part_series(a), series_scalar_mul(-1, negative_part_series(a)))(n) = positive_part_series(a)(n) + series_scalar_mul(-1, negative_part_series(a))(n)
        positive_part_series(a)(n) = (abs(a(n)) + a(n)) / 2
        negative_part_series(a)(n) = (abs(a(n)) - a(n)) / 2
        series_scalar_mul(-1, negative_part_series(a))(n) = (-1) * negative_part_series(a)(n)
        (-1) * negative_part_series(a)(n) = (-1) * ((abs(a(n)) - a(n)) / 2)
        positive_part_series(a)(n) + series_scalar_mul(-1, negative_part_series(a))(n) = (abs(a(n)) + a(n)) / 2 + ((-1) * ((abs(a(n)) - a(n)) / 2))
        (abs(a(n)) + a(n)) / 2 + ((-1) * ((abs(a(n)) - a(n)) / 2)) = a(n)
    release thm series_sum_extensional(series_add(positive_part_series(a), series_scalar_mul(-1, negative_part_series(a))), a, P - Qsum)
thm rearranged_positive_negative_parts_reconstruct_series_sum:
    ? forall a seq(R), phi fn(i_index N+) N+, P, Qsum R:
        $has_series_sum(rearranged_series(positive_part_series(a), phi), P)
        $has_series_sum(rearranged_series(negative_part_series(a), phi), Qsum)
        =>:
            $has_series_sum(rearranged_series(a, phi), P - Qsum)
    release thm series_laws_scalar_mul(rearranged_series(negative_part_series(a), phi), -1, Qsum)
    release thm series_laws_add(rearranged_series(positive_part_series(a), phi), series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi)), P, -1 * Qsum)
    P + ((-1) * Qsum) = P - Qsum
    $has_series_sum(series_add(rearranged_series(positive_part_series(a), phi), series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi))), P - Qsum)
    claim:
        ? forall n N+:
            series_add(rearranged_series(positive_part_series(a), phi), series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi)))(n) = rearranged_series(a, phi)(n)
        series_add(rearranged_series(positive_part_series(a), phi), series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi)))(n) = rearranged_series(positive_part_series(a), phi)(n) + series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi))(n)
        release thm rearranged_series_apply(positive_part_series(a), phi, n)
        release thm positive_part_series_apply(a, phi(n))
        release thm rearranged_series_apply(negative_part_series(a), phi, n)
        release thm negative_part_series_apply(a, phi(n))
        rearranged_series(positive_part_series(a), phi)(n) = positive_part_series(a)(phi(n))
        positive_part_series(a)(phi(n)) = (abs(a(phi(n))) + a(phi(n))) / 2
        rearranged_series(negative_part_series(a), phi)(n) = negative_part_series(a)(phi(n))
        negative_part_series(a)(phi(n)) = (abs(a(phi(n))) - a(phi(n))) / 2
        series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi))(n) = (-1) * rearranged_series(negative_part_series(a), phi)(n)
        (-1) * rearranged_series(negative_part_series(a), phi)(n) = (-1) * ((abs(a(phi(n))) - a(phi(n))) / 2)
        rearranged_series(positive_part_series(a), phi)(n) + series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi))(n) = (abs(a(phi(n))) + a(phi(n))) / 2 + ((-1) * ((abs(a(phi(n))) - a(phi(n))) / 2))
        (abs(a(phi(n))) + a(phi(n))) / 2 + ((-1) * ((abs(a(phi(n))) - a(phi(n))) / 2)) = a(phi(n))
        rearranged_series(a, phi)(n) = a(phi(n))
    release thm series_sum_extensional(series_add(rearranged_series(positive_part_series(a), phi), series_scalar_mul(-1, rearranged_series(negative_part_series(a), phi))), rearranged_series(a, phi), P - Qsum)
thm absolute_rearrangement:
    ? forall a seq(R), phi fn(i_index N+) N+, L R:
        $is_absolutely_convergent_series(a)
        $has_series_sum(a, L)
        $is_permutation_of_positive_integers(phi)
        =>:
            $has_series_sum(rearranged_series(a, phi), L)
            $is_absolutely_convergent_series(rearranged_series(a, phi))
    release thm rearranged_series_absolutely_convergent(a, phi)
    release thm positive_part_convergent_from_absolute(a)
    obtain P from exist P R st {$has_series_sum(positive_part_series(a), P)}
    release thm negative_part_convergent_from_absolute(a)
    obtain Qsum from exist Qsum R st {$has_series_sum(negative_part_series(a), Qsum)}
    release thm positive_negative_parts_reconstruct_series_sum(a, P, Qsum)
    release thm series_sum_unique(a, L, P - Qsum)
    release thm positive_part_series_nonnegative(a)
    release thm nonnegative_rearrangement(positive_part_series(a), phi, P)
    release thm negative_part_series_nonnegative(a)
    release thm nonnegative_rearrangement(negative_part_series(a), phi, Qsum)
    release thm rearranged_positive_negative_parts_reconstruct_series_sum(a, phi, P, Qsum)
have fn checked_reciprocal(value R) R by cases:
    case value = 0: 0
    case value != 0: 1 / value
thm checked_reciprocal_nonzero_apply:
    ? forall value R:
        value != 0
        =>:
            checked_reciprocal(value) = 1 / value
have fn example_7_4_4_original_pair_terms(n N+) R = checked_reciprocal(2*n + 1) - checked_reciprocal(2*n + 2)
have fn example_7_4_4_rearranged_block_terms(n N+) R = checked_reciprocal(2*n + 1) - checked_reciprocal(4*n) - checked_reciprocal(4*n + 2)
thm example_7_4_4_original_pair_terms_apply:
    ? forall n N+:
        2*n + 1 != 0
        2*n + 2 != 0
        =>:
            example_7_4_4_original_pair_terms(n) = 1 / (2*n + 1) - 1 / (2*n + 2)
    release thm checked_reciprocal_nonzero_apply(2*n + 1)
    release thm checked_reciprocal_nonzero_apply(2*n + 2)
    example_7_4_4_original_pair_terms(n) = checked_reciprocal(2*n + 1) - checked_reciprocal(2*n + 2)
thm example_7_4_4_rearranged_block_terms_apply:
    ? forall n N+:
        2*n + 1 != 0
        4*n != 0
        4*n + 2 != 0
        =>:
            example_7_4_4_rearranged_block_terms(n) = 1 / (2*n + 1) - 1 / (4*n) - 1 / (4*n + 2)
    release thm checked_reciprocal_nonzero_apply(2*n + 1)
    release thm checked_reciprocal_nonzero_apply(4*n)
    release thm checked_reciprocal_nonzero_apply(4*n + 2)
    example_7_4_4_rearranged_block_terms(n) = checked_reciprocal(2*n + 1) - checked_reciprocal(4*n) - checked_reciprocal(4*n + 2)
    checked_reciprocal(2*n + 1) - checked_reciprocal(4*n) - checked_reciprocal(4*n + 2) = 1 / (2*n + 1) - 1 / (4*n) - 1 / (4*n + 2)
thm example_7_4_4_original_pair_positive:
    ? forall n N+:
        example_7_4_4_original_pair_terms(n) > 0
    2*n + 1 > 0
    2*n + 2 > 0
    2*n + 1 != 0
    2*n + 2 != 0
    release thm example_7_4_4_original_pair_terms_apply(n)
    (2*n + 1)*(2*n + 2) > 0
    1 / (2*n + 1) - 1 / (2*n + 2) = (2*n + 2) / ((2*n + 1)*(2*n + 2)) - (2*n + 1) / ((2*n + 1)*(2*n + 2))
    (2*n + 2) / ((2*n + 1)*(2*n + 2)) - (2*n + 1) / ((2*n + 1)*(2*n + 2)) = ((2*n + 2) - (2*n + 1)) / ((2*n + 1)*(2*n + 2))
    ((2*n + 2) - (2*n + 1)) / ((2*n + 1)*(2*n + 2)) = 1 / ((2*n + 1)*(2*n + 2))
    1 / ((2*n + 1)*(2*n + 2)) > 0
release thm fn_set_member(example_7_4_4_original_pair_terms, fn(index N+) R)
example_7_4_4_original_pair_terms $in seq(R)
thm example_7_4_4_original_grouped_partial_sums_positive:
    ? forall k N+:
        partial_sum(example_7_4_4_original_pair_terms, k) > 0
    by induc k from 1:
        ? partial_sum(example_7_4_4_original_pair_terms, k) > 0
        ? from k = 1:
            partial_sum(example_7_4_4_original_pair_terms, 1 - 1) = partial_sum(example_7_4_4_original_pair_terms, 0)
            partial_sum(example_7_4_4_original_pair_terms, 0) = 0
            partial_sum(example_7_4_4_original_pair_terms, 1 - 1) + example_7_4_4_original_pair_terms(1) = partial_sum(example_7_4_4_original_pair_terms, 0) + example_7_4_4_original_pair_terms(1)
            partial_sum(example_7_4_4_original_pair_terms, 0) + example_7_4_4_original_pair_terms(1) = 0 + example_7_4_4_original_pair_terms(1)
