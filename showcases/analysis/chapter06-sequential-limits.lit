        have natural_late_start N+ = n_tail + n0
        natural_late_start >= n_tail
        natural_late_start >= n0
        natural_as_real_seq(natural_late_start) = natural_late_start
        x < n0 <= natural_late_start = natural_as_real_seq(natural_late_start)
        witness exist n N+ st {n >= n_tail and x < natural_as_real_seq(n)} from natural_late_start
    by def $exceeds_threshold_arbitrarily_late(natural_as_real_seq, x)
by def $has_limit_superior_pos_infinity(natural_as_real_seq)
claim:
    ? forall y R:
        exist n_tail N+ st {$is_eventually_above_threshold(natural_as_real_seq, y, n_tail)}
    release thm exists_nat_above_real(y)
    obtain n0 from exist n0 N+ st {y < n0}
