# Chapter 06 sequential limits
# Selected Analysis I development; scope and assumptions: STATUS.md.

release obj def chap5::dist_R
forall x, y R:
    chap5::dist_R(x, y) = abs(x - y)
prop is_epsilon_close_in_R(epsilon R+, x, y R):
    chap5::dist_R(x, y) <= epsilon
thm epsilon_closeness_is_reflexive:
    ? forall epsilon R+, x R:
        $is_epsilon_close_in_R(epsilon, x, x)
    chap5::dist_R(x, x) = abs(x - x)
    x - x = 0
    abs(x - x) = abs(0) = 0
    chap5::dist_R(x, x) = abs(x - x) = 0
    0 <= epsilon
    by def $is_epsilon_close_in_R(epsilon, x, x)
prop is_tail_epsilon_steady(a seq(R), epsilon R+, n0 N+):
    forall j, k N+:
        j >= n0
        k >= n0
        =>:
            abs(a(j) - a(k)) < epsilon
prop has_eventual_epsilon_steadiness(a seq(R), epsilon R+):
    exist n0 N+ st {$is_tail_epsilon_steady(a, epsilon, n0)}
prop is_cauchy_sequence(a seq(R)):
    forall epsilon R+:
        $has_eventual_epsilon_steadiness(a, epsilon)
prop is_cauchy_sequence_with_rational_epsilon(a seq(R)):
    forall epsilon Q+:
        $has_eventual_epsilon_steadiness(a, epsilon)
prop is_rational_epsilon_below(delta Q+, epsilon R+):
    delta < epsilon
thm Archimedean_density_bridge:
    ? forall epsilon R+:
        exist delta Q+ st {$is_rational_epsilon_below(delta, epsilon)}
    release thm chap5::archimedean_property(epsilon)
    obtain m from exist m N+ st {1 / m < epsilon}
    0 < m
    1 / m $in Q
    0 = 0 / m < 1 / m
    by def $is_rational_epsilon_below(1 / m, epsilon)
    witness exist eta Q+ st {$is_rational_epsilon_below(eta, epsilon)} from 1 / m
thm cauchy_rational_epsilon_implies_cauchy:
    ? forall a seq(R):
        $is_cauchy_sequence_with_rational_epsilon(a)
        =>:
            $is_cauchy_sequence(a)
    claim:
        ? forall epsilon R+:
            $has_eventual_epsilon_steadiness(a, epsilon)
        release thm Archimedean_density_bridge(epsilon)
        obtain delta from exist delta Q+ st {$is_rational_epsilon_below(delta, epsilon)}
        $has_eventual_epsilon_steadiness(a, delta)
        obtain n0 from $has_eventual_epsilon_steadiness(a, delta)
        witness $has_eventual_epsilon_steadiness(a, epsilon) from n0:
            claim:
                ? forall j, k N+:
                    j >= n0
                    k >= n0
                    =>:
                        abs(a(j) - a(k)) < epsilon
                abs(a(j) - a(k)) < delta < epsilon
            by def $is_tail_epsilon_steady(a, epsilon, n0)
    by def $is_cauchy_sequence(a)
thm cauchy_implies_cauchy_with_rational_epsilon:
    ? forall a seq(R):
        $is_cauchy_sequence(a)
        =>:
            $is_cauchy_sequence_with_rational_epsilon(a)
    by def $is_cauchy_sequence_with_rational_epsilon(a)
prop is_tail_close_to(a seq(R), L R, epsilon R+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n) - L) < epsilon
prop has_eventual_closeness_to(a seq(R), L R, epsilon R+):
    exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
prop has_limit(a seq(R), L R):
    forall epsilon R+:
        $has_eventual_closeness_to(a, L, epsilon)
thm limit_extensional:
    ? forall a, b seq(R), L R:
        a = b
        $has_limit(a, L)
        =>:
            $has_limit(b, L)
    by def $has_limit(b, L)
thm has_limit_gives_eventual_closeness:
    ? forall a seq(R), L R, epsilon R+:
        $has_limit(a, L)
        =>:
            $has_eventual_closeness_to(a, L, epsilon)
prop is_convergent_sequence(a seq(R)):
    exist L R st {$has_limit(a, L)}
prop is_divergent_sequence(a seq(R)):
    not $is_convergent_sequence(a)
thm convergent_sequence_has_limit:
    ? forall a seq(R):
        $is_convergent_sequence(a)
        =>:
            exist L R st {$has_limit(a, L)}
    by def $is_convergent_sequence(a)
thm constant_sequence_has_limit:
    ? forall c R:
        $has_limit(fn(n N+) R {c}, c)
    have constant seq(R) = fn(n N+) R {c}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(constant, c, epsilon)
        witness $has_eventual_closeness_to(constant, c, epsilon) from 1:
            claim:
                ? forall n N+:
                    n >= 1
                    =>:
                        abs(constant(n) - c) < epsilon
                constant(n) = c
                constant(n) - c = c - c = 0
                abs(constant(n) - c) = abs(0) = 0 < epsilon
            by def $is_tail_close_to(constant, c, epsilon, 1)
    by def $has_limit(constant, c)
    constant = fn(n N+) R {c}
    by thm limit_extensional(constant, fn(n N+) R {c}, c) => $has_limit(fn(n N+) R {c}, c)
thm sequence_limit_unique:
    ? forall a seq(R), L1, L2 R:
        $has_limit(a, L1)
        $has_limit(a, L2)
        =>:
            L1 = L2
    by contra:
        ? L1 = L2
        L1 - L2 != 0
        abs(L1 - L2) != 0
        have distance R = abs(L1 - L2)
        distance != 0
        0 <= distance
        claim:
            ? distance > 0
            by contra:
                ? distance > 0
                distance <= 0
                0 <= distance <= 0
                distance = 0
                impossible distance != 0
        distance / 3 > 0
        distance / 3 $in R+
        $has_eventual_closeness_to(a, L1, distance / 3)
        $has_eventual_closeness_to(a, L2, distance / 3)
        obtain n1 from $has_eventual_closeness_to(a, L1, distance / 3)
        obtain n2 from $has_eventual_closeness_to(a, L2, distance / 3)
        have n0 N+ = n1 + n2
        n0 >= n1
        n0 >= n2
        abs(a(n0) - L1) < distance / 3
        abs(a(n0) - L2) < distance / 3
        L1 - a(n0) = -(a(n0) - L1)
        abs(L1 - a(n0)) = abs(-(a(n0) - L1)) = abs(a(n0) - L1)
        L1 - L2 = (L1 - a(n0)) + (a(n0) - L2)
        distance = abs((L1 - a(n0)) + (a(n0) - L2)) <= abs(L1 - a(n0)) + abs(a(n0) - L2)
        2 * distance < 3 * distance
        distance / 3 + distance / 3 = 2 * distance / 3 < 3 * distance / 3 = distance
        abs(L1 - a(n0)) + abs(a(n0) - L2) = abs(a(n0) - L1) + abs(a(n0) - L2) < distance / 3 + distance / 3 < distance
        distance <= abs(L1 - a(n0)) + abs(a(n0) - L2) < distance
        impossible distance = distance
claim:
    ? forall a seq(R):
        $is_convergent_sequence(a)
        =>:
            exist! L R st {$has_limit(a, L)}
    obtain L from $is_convergent_sequence(a)
    witness exist! chosen_limit R st {$has_limit(a, chosen_limit)} from L
have fn sequence_limit_value by exist!:
    ? forall a seq(R):
        $is_convergent_sequence(a)
        =>:
            exist! L R st {$has_limit(a, L)}
seq(R) = fn(index N+) R
forall left_index, right_index N+:
    left_index + right_index $in N+
thm shifted_sequence_has_limit:
    ? forall a seq(R), L R, m N+:
        $has_limit(a, L)
        =>:
            $has_limit(fn(n N+) R {a(n + m)}, L)
    have shifted seq(R) = fn(n N+) R {a(n + m)}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(shifted, L, epsilon)
        obtain n0 from $has_eventual_closeness_to(a, L, epsilon)
        witness $has_eventual_closeness_to(shifted, L, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(shifted(n) - L) < epsilon
                n + m $in N+
                n + m >= n >= n0
                abs(a(n + m) - L) < epsilon
                shifted(n) = a(n + m)
                shifted(n) - L = a(n + m) - L
                abs(shifted(n) - L) = abs(a(n + m) - L) < epsilon
            by def $is_tail_close_to(shifted, L, epsilon, n0)
    by def $has_limit(shifted, L)
    by thm limit_extensional(shifted, fn(n N+) R {a(n + m)}, L) => $has_limit(fn(n N+) R {a(n + m)}, L)
have fn reciprocal_nat_seq(n N+) R = 1 / n
forall n N+:
    reciprocal_nat_seq(n) = 1 / n
thm reciprocal_nat_order_reversing:
    ? forall n0, n N+:
        n >= n0
        =>:
            1 / n <= 1 / n0
    n0 * n > 0
    1 / n = n0 / (n0 * n)
    n0 / (n0 * n) <= n / (n0 * n)
    n / (n0 * n) = 1 / n0
claim:
    ? forall epsilon R+:
        $has_eventual_closeness_to(reciprocal_nat_seq, 0, epsilon)
    release thm chap5::archimedean_property(epsilon)
    obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
    witness $has_eventual_closeness_to(reciprocal_nat_seq, 0, epsilon) from n0:
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    abs(reciprocal_nat_seq(n) - 0) < epsilon
            0 < n
            0 = 0 / n < 1 / n
            0 <= 1 / n
            reciprocal_nat_seq(n) = 1 / n
            reciprocal_nat_seq(n) - 0 = 1 / n
            abs(reciprocal_nat_seq(n) - 0) = abs(1 / n) = 1 / n
            release thm reciprocal_nat_order_reversing(n0, n)
            abs(reciprocal_nat_seq(n) - 0) = 1 / n <= 1 / n0 < epsilon
        by def $is_tail_close_to(reciprocal_nat_seq, 0, epsilon, n0)
by def $has_limit(reciprocal_nat_seq, 0)
thm has_limit_implies_cauchy:
    ? forall a seq(R), L R:
        $has_limit(a, L)
        =>:
            $is_cauchy_sequence(a)
    claim:
        ? forall epsilon R+:
            $has_eventual_epsilon_steadiness(a, epsilon)
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in R+
        $has_eventual_closeness_to(a, L, epsilon / 2)
        obtain n0 from $has_eventual_closeness_to(a, L, epsilon / 2)
        witness $has_eventual_epsilon_steadiness(a, epsilon) from n0:
            claim:
                ? forall j, k N+:
                    j >= n0
                    k >= n0
                    =>:
                        abs(a(j) - a(k)) < epsilon
                abs(a(j) - L) < epsilon / 2 and abs(a(k) - L) < epsilon / 2
                a(j) - a(k) = (a(j) - L) + (L - a(k))
                L - a(k) = -(a(k) - L)
                abs(L - a(k)) = abs(-(a(k) - L)) = abs(a(k) - L)
                abs(a(j) - a(k)) = abs((a(j) - L) + (L - a(k))) <= abs(a(j) - L) + abs(L - a(k))
                abs(a(j) - L) + abs(L - a(k)) = abs(a(j) - L) + abs(a(k) - L) < epsilon / 2 + epsilon / 2 = epsilon
                abs(a(j) - a(k)) <= abs(a(j) - L) + abs(L - a(k)) < epsilon
            by def $is_tail_epsilon_steady(a, epsilon, n0)
    by def $is_cauchy_sequence(a)
thm convergent_sequence_is_cauchy:
    ? forall a seq(R):
        $is_convergent_sequence(a)
        =>:
            $is_cauchy_sequence(a)
    obtain L from $is_convergent_sequence(a)
    release thm has_limit_implies_cauchy(a, L)
have fn alternating_one_seq(n N+) R = (-1)^n
forall n N+:
    alternating_one_seq(n) = (-1)^n
claim:
    ? forall n N+:
        (-1)^n <= 1
        (-1) <= (-1)^n
    by induc n from 1:
        ? (-1)^n <= 1
        ? -1 <= (-1)^n
        ? from n = 1:
            (-1) = (-1)^1 <= 1
        ? induc:
            (-1)^n * (-1) >= 1 * (-1) = (-1)
            (-1)^n * (-1) <= (-1) * (-1) = 1
            (-1)^(n + 1) = (-1)^n * (-1)
            (-1) <= (-1)^(n + 1) <= 1
claim:
    ? not $is_cauchy_sequence(alternating_one_seq)
    by contra:
        ? not $is_cauchy_sequence(alternating_one_seq)
        $is_cauchy_sequence(alternating_one_seq)
        1 $in R+
        $has_eventual_epsilon_steadiness(alternating_one_seq, 1)
        obtain n0 from $has_eventual_epsilon_steadiness(alternating_one_seq, 1)
        2 * n0 $in N+
        2 * n0 + 1 $in N+
        2 * n0 >= n0
        2 * n0 + 1 >= n0
        abs(alternating_one_seq(2 * n0) - alternating_one_seq(2 * n0 + 1)) < 1
        alternating_one_seq(2 * n0) = (-1)^(2 * n0)
        (-1)^(2 * n0) = ((-1)^2)^n0 = 1^n0 = 1
        alternating_one_seq(2 * n0) = 1
        alternating_one_seq(2 * n0 + 1) = (-1)^(2 * n0 + 1)
        1 $in N+
        (-1)^(2 * n0 + 1) = (-1)^(2 * n0) * (-1)^1
        (-1)^(2 * n0) * (-1)^1 = 1 * (-1) = (-1)
        alternating_one_seq(2 * n0 + 1) = (-1)
        abs(alternating_one_seq(2 * n0) - alternating_one_seq(2 * n0 + 1)) = 2
        impossible 2 < 1
claim:
    ? not $is_convergent_sequence(alternating_one_seq)
    by contra:
        ? not $is_convergent_sequence(alternating_one_seq)
        $is_convergent_sequence(alternating_one_seq)
        release thm convergent_sequence_is_cauchy(alternating_one_seq)
        impossible not $is_cauchy_sequence(alternating_one_seq)
by def $is_divergent_sequence(alternating_one_seq)
prop is_finite_prefix_bounded(a seq(R), n N+, M R):
    M >= 0
    forall i_index N+:
        i_index <= n
        =>:
            abs(a(i_index)) <= M
prop is_bounded_by(a seq(R), M R):
    M >= 0
    forall i_index N+:
        abs(a(i_index)) <= M
prop is_bounded_sequence(a seq(R)):
    exist M R st {$is_bounded_by(a, M)}
claim:
    ? forall n N:
        n = 0 or n >= 1 and n $in N+
    by cases:
        ? n = 0 or n >= 1 and n $in N+
        case n < 0:
            impossible n < 0
        case n = 0:
            n = 0 or n >= 1 and n $in N+
        case n > 0:
            n $in N+
            n >= 1
have fn prefix_bound(a seq(R), n N) R by induc n from 0:
    case n = 0: abs(a(1))
    case n >= 1 and n $in N+: max(prefix_bound(a, n - 1), abs(a(n)))
thm finite_prefix_bound_specification:
    ? forall a seq(R), n N+:
        $is_finite_prefix_bounded(a, n, prefix_bound(a, n))
    by induc n from 1:
        ? $is_finite_prefix_bounded(a, n, prefix_bound(a, n))
        ? from n = 1:
            prefix_bound(a, 0) = abs(a(1))
            prefix_bound(a, 1) = max(prefix_bound(a, 0), abs(a(1)))
            max(prefix_bound(a, 0), abs(a(1))) = max(abs(a(1)), abs(a(1))) = abs(a(1))
            prefix_bound(a, 1) = abs(a(1))
            0 <= prefix_bound(a, 1)
            claim:
                ? forall i_index N+:
                    i_index <= 1
                    =>:
                        abs(a(i_index)) <= prefix_bound(a, 1)
                i_index >= 1
                i_index = 1
                abs(a(i_index)) = abs(a(1)) = prefix_bound(a, 1)
            by def $is_finite_prefix_bounded(a, 1, prefix_bound(a, 1))
        ? induc:
            n + 1 $in N+
            n + 1 >= 1
            n + 1 - 1 = n
            prefix_bound(a, n + 1 - 1) = prefix_bound(a, n)
            prefix_bound(a, n + 1) = max(prefix_bound(a, n + 1 - 1), abs(a(n + 1))) = max(prefix_bound(a, n), abs(a(n + 1)))
            prefix_bound(a, n) <= max(prefix_bound(a, n), abs(a(n + 1))) = prefix_bound(a, n + 1)
            abs(a(n + 1)) <= max(prefix_bound(a, n), abs(a(n + 1))) = prefix_bound(a, n + 1)
            0 <= prefix_bound(a, n) <= prefix_bound(a, n + 1)
            claim:
                ? forall i_index N+:
                    i_index <= n + 1
                    =>:
                        abs(a(i_index)) <= prefix_bound(a, n + 1)
                i_index <= n or i_index >= n + 1
                by cases:
                    ? abs(a(i_index)) <= prefix_bound(a, n + 1)
                    case i_index <= n:
                        abs(a(i_index)) <= prefix_bound(a, n) <= prefix_bound(a, n + 1)
                    case i_index >= n + 1:
                        i_index = n + 1
                        abs(a(i_index)) = abs(a(n + 1)) <= prefix_bound(a, n + 1)
            by def $is_finite_prefix_bounded(a, n + 1, prefix_bound(a, n + 1))
thm cauchy_sequence_is_bounded:
    ? forall a seq(R):
        $is_cauchy_sequence(a)
        =>:
            $is_bounded_sequence(a)
    $has_eventual_epsilon_steadiness(a, 1)
    obtain n0 from $has_eventual_epsilon_steadiness(a, 1)
    release thm finite_prefix_bound_specification(a, n0)
    0 <= prefix_bound(a, n0)
    0 <= abs(a(n0))
    prefix_bound(a, n0) $in R
    abs(a(n0)) $in R
    prefix_bound(a, n0) + abs(a(n0)) $in R
    prefix_bound(a, n0) + abs(a(n0)) + 1 $in R
    claim:
        ? forall i_index N+:
            abs(a(i_index)) <= prefix_bound(a, n0) + abs(a(n0)) + 1
        i_index <= n0 or i_index >= n0 + 1
        by cases:
            ? abs(a(i_index)) <= prefix_bound(a, n0) + abs(a(n0)) + 1
            case i_index <= n0:
                abs(a(i_index)) <= prefix_bound(a, n0) <= prefix_bound(a, n0) + abs(a(n0)) + 1
            case i_index >= n0 + 1:
                i_index >= n0 + 1 > n0
                i_index >= n0
                n0 >= n0
                abs(a(i_index) - a(n0)) < 1
                a(i_index) = (a(i_index) - a(n0)) + a(n0)
                abs(a(i_index)) = abs((a(i_index) - a(n0)) + a(n0)) <= abs(a(i_index) - a(n0)) + abs(a(n0))
                abs(a(i_index) - a(n0)) + abs(a(n0)) < 1 + abs(a(n0))
                abs(a(n0)) + 1 = 0 + abs(a(n0)) + 1 <= prefix_bound(a, n0) + abs(a(n0)) + 1
                1 + abs(a(n0)) = abs(a(n0)) + 1
                1 + abs(a(n0)) <= prefix_bound(a, n0) + abs(a(n0)) + 1
                abs(a(i_index)) <= abs(a(i_index) - a(n0)) + abs(a(n0)) < 1 + abs(a(n0)) <= prefix_bound(a, n0) + abs(a(n0)) + 1
    by def $is_bounded_by(a, prefix_bound(a, n0) + abs(a(n0)) + 1)
    witness $is_bounded_sequence(a) from prefix_bound(a, n0) + abs(a(n0)) + 1
thm convergent_sequence_is_bounded:
    ? forall a seq(R):
        $is_convergent_sequence(a)
        =>:
            $is_bounded_sequence(a)
    obtain L from $is_convergent_sequence(a)
    release thm has_limit_implies_cauchy(a, L)
    release thm cauchy_sequence_is_bounded(a)
claim:
    ? forall a seq(R), L R:
        $has_limit(a, L)
        =>:
            $is_bounded_sequence(a)
    release thm has_limit_implies_cauchy(a, L)
    release thm cauchy_sequence_is_bounded(a)
have fn natural_as_real_seq(n N+) R = n
forall n N+:
    natural_as_real_seq(n) = n
claim:
    ? not $is_bounded_sequence(natural_as_real_seq)
    by contra:
        ? not $is_bounded_sequence(natural_as_real_seq)
        $is_bounded_sequence(natural_as_real_seq)
        obtain M from $is_bounded_sequence(natural_as_real_seq)
        release thm real_archimedean_natural_upper_bound(M)
        obtain n0 from exist n0 N+ st {M < n0}
        0 <= n0
        abs(n0) = n0
        natural_as_real_seq(n0) = n0
        abs(natural_as_real_seq(n0)) = abs(n0) = n0
        abs(natural_as_real_seq(n0)) > M
        abs(natural_as_real_seq(n0)) <= M
        impossible abs(natural_as_real_seq(n0)) <= M
claim:
    ? not $is_convergent_sequence(natural_as_real_seq)
    by contra:
        ? not $is_convergent_sequence(natural_as_real_seq)
        $is_convergent_sequence(natural_as_real_seq)
        release thm convergent_sequence_is_bounded(natural_as_real_seq)
        impossible not $is_bounded_sequence(natural_as_real_seq)
by def $is_divergent_sequence(natural_as_real_seq)
prop is_nonzero_sequence(a seq(R)):
    forall n N+:
        a(n) != 0
prop is_pointwise_le(a, b seq(R)):
    forall n N+:
        a(n) <= b(n)
prop is_pointwise_between(a, b, c seq(R)):
    forall n N+:
        a(n) <= b(n)
        b(n) <= c(n)
thm seq_add_converges_to:
    ? forall a, b seq(R), x, y R:
        $has_limit(a, x)
        $has_limit(b, y)
        =>:
            $has_limit(fn(i_index N+) R {a(i_index) + b(i_index)}, x + y)
    have sum_sequence seq(R) = fn(i_index N+) R {a(i_index) + b(i_index)}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(sum_sequence, x + y, epsilon)
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in R+
        $has_eventual_closeness_to(a, x, epsilon / 2)
        $has_eventual_closeness_to(b, y, epsilon / 2)
        obtain n1 from $has_eventual_closeness_to(a, x, epsilon / 2)
        obtain n2 from $has_eventual_closeness_to(b, y, epsilon / 2)
        have sum_tail_start N+ = n1 + n2
        sum_tail_start >= n1
        sum_tail_start >= n2
        witness $has_eventual_closeness_to(sum_sequence, x + y, epsilon) from sum_tail_start:
            claim:
                ? forall n N+:
                    n >= sum_tail_start
                    =>:
                        abs(sum_sequence(n) - (x + y)) < epsilon
                n1 <= sum_tail_start <= n
                n2 <= sum_tail_start <= n
                n >= n1
                n >= n2
                abs(a(n) - x) < epsilon / 2
                abs(b(n) - y) < epsilon / 2
                sum_sequence(n) = a(n) + b(n)
                sum_sequence(n) - (x + y) = (a(n) + b(n)) - (x + y)
                (a(n) + b(n)) - (x + y) = (a(n) - x) + (b(n) - y)
                sum_sequence(n) - (x + y) = (a(n) - x) + (b(n) - y)
                abs(a(n) - x) + abs(b(n) - y) < epsilon / 2 + epsilon / 2 = epsilon
                abs(sum_sequence(n) - (x + y)) = abs((a(n) - x) + (b(n) - y)) <= abs(a(n) - x) + abs(b(n) - y) < epsilon
            by def $is_tail_close_to(sum_sequence, x + y, epsilon, sum_tail_start)
    by def $has_limit(sum_sequence, x + y)
    by thm limit_extensional(sum_sequence, fn(i_index N+) R {a(i_index) + b(i_index)}, x + y) => $has_limit(fn(i_index N+) R {a(i_index) + b(i_index)}, x + y)
thm seq_sub_converges_to:
    ? forall a, b seq(R), x, y R:
        $has_limit(a, x)
        $has_limit(b, y)
        =>:
            $has_limit(fn(i_index N+) R {a(i_index) - b(i_index)}, x - y)
    have difference_sequence seq(R) = fn(i_index N+) R {a(i_index) - b(i_index)}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(difference_sequence, x - y, epsilon)
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in R+
        obtain n1 from $has_eventual_closeness_to(a, x, epsilon / 2)
        obtain n2 from $has_eventual_closeness_to(b, y, epsilon / 2)
        have sub_tail_start N+ = n1 + n2
        sub_tail_start >= n1
        sub_tail_start >= n2
        witness $has_eventual_closeness_to(difference_sequence, x - y, epsilon) from sub_tail_start:
            claim:
                ? forall n N+:
                    n >= sub_tail_start
                    =>:
                        abs(difference_sequence(n) - (x - y)) < epsilon
                n1 <= sub_tail_start <= n
                n2 <= sub_tail_start <= n
                n >= n1
                n >= n2
                abs(a(n) - x) < epsilon / 2
                abs(b(n) - y) < epsilon / 2
                y - b(n) = -(b(n) - y)
                abs(y - b(n)) = abs(-(b(n) - y)) = abs(b(n) - y)
                difference_sequence(n) = a(n) - b(n)
                difference_sequence(n) - (x - y) = (a(n) - b(n)) - (x - y)
                (a(n) - b(n)) - (x - y) = (a(n) - x) + (y - b(n))
                difference_sequence(n) - (x - y) = (a(n) - x) + (y - b(n))
                abs(a(n) - x) + abs(b(n) - y) < epsilon / 2 + epsilon / 2 = epsilon
                abs(difference_sequence(n) - (x - y)) = abs((a(n) - x) + (y - b(n))) <= abs(a(n) - x) + abs(y - b(n)) = abs(a(n) - x) + abs(b(n) - y) < epsilon
            by def $is_tail_close_to(difference_sequence, x - y, epsilon, sub_tail_start)
    by def $has_limit(difference_sequence, x - y)
    by thm limit_extensional(difference_sequence, fn(i_index N+) R {a(i_index) - b(i_index)}, x - y) => $has_limit(fn(i_index N+) R {a(i_index) - b(i_index)}, x - y)
thm seq_const_mul_converges_to:
    ? forall c R, a seq(R), x R:
        $has_limit(a, x)
        =>:
            $has_limit(fn(i_index N+) R {c * a(i_index)}, c * x)
    have scaled_sequence seq(R) = fn(i_index N+) R {c * a(i_index)}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(scaled_sequence, c * x, epsilon)
        0 <= abs(c)
        abs(c) + 1 > 0
        0 < epsilon
        0 = 0 / (abs(c) + 1) < epsilon / (abs(c) + 1)
        have delta R+ = epsilon / (abs(c) + 1)
        obtain n0 from $has_eventual_closeness_to(a, x, delta)
        witness $has_eventual_closeness_to(scaled_sequence, c * x, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(scaled_sequence(n) - c * x) < epsilon
                abs(a(n) - x) < delta
                0 <= abs(c)
                0 < delta
                abs(c) < abs(c) + 1
                abs(c) * abs(a(n) - x) <= abs(c) * delta < (abs(c) + 1) * delta
                (abs(c) + 1) * delta = (abs(c) + 1) * (epsilon / (abs(c) + 1)) = epsilon
                scaled_sequence(n) = c * a(n)
                scaled_sequence(n) - c * x = c * a(n) - c * x
                c * a(n) - c * x = c * (a(n) - x)
                scaled_sequence(n) - c * x = c * (a(n) - x)
                abs(scaled_sequence(n) - c * x) = abs(c * (a(n) - x)) = abs(c) * abs(a(n) - x) < epsilon
            by def $is_tail_close_to(scaled_sequence, c * x, epsilon, n0)
    by def $has_limit(scaled_sequence, c * x)
    by thm limit_extensional(scaled_sequence, fn(i_index N+) R {c * a(i_index)}, c * x) => $has_limit(fn(i_index N+) R {c * a(i_index)}, c * x)
thm seq_mul_converges_to:
    ? forall a, b seq(R), x, y R:
        $has_limit(a, x)
        $has_limit(b, y)
        =>:
            $has_limit(fn(i_index N+) R {a(i_index) * b(i_index)}, x * y)
    have product_sequence seq(R) = fn(i_index N+) R {a(i_index) * b(i_index)}
    0 <= abs(x)
    0 <= abs(y)
    0 < abs(x) + 1
    0 < abs(y) + 1
    have upper_a R+ = abs(x) + 1
    have upper_y R+ = abs(y) + 1
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(product_sequence, x * y, epsilon)
        0 < upper_a + upper_y
        0 < epsilon
        0 = 0 / (upper_a + upper_y) < epsilon / (upper_a + upper_y)
        have delta R+ = epsilon / (upper_a + upper_y)
        obtain n_bound from $has_eventual_closeness_to(a, x, 1)
        obtain n1 from $has_eventual_closeness_to(a, x, delta)
        obtain n2 from $has_eventual_closeness_to(b, y, delta)
        have product_tail_start N+ = n_bound + n1 + n2
        product_tail_start >= n_bound
        product_tail_start >= n1
        product_tail_start >= n2
        witness $has_eventual_closeness_to(product_sequence, x * y, epsilon) from product_tail_start:
            claim:
                ? forall n N+:
                    n >= product_tail_start
                    =>:
                        abs(product_sequence(n) - x * y) < epsilon
                n_bound <= product_tail_start <= n
                n1 <= product_tail_start <= n
                n2 <= product_tail_start <= n
                n >= n_bound
                n >= n1
                n >= n2
                abs(a(n) - x) < 1
                abs(a(n) - x) < delta
                abs(b(n) - y) < delta
                a(n) = (a(n) - x) + x
                abs(a(n)) = abs((a(n) - x) + x) <= abs(a(n) - x) + abs(x) < 1 + abs(x) = upper_a
                0 <= abs(a(n))
                0 <= abs(y)
                0 < delta
                abs(y) < upper_y
                abs(a(n)) * abs(b(n) - y) <= abs(a(n)) * delta < upper_a * delta
                abs(y) * abs(a(n) - x) <= abs(y) * delta < upper_y * delta
                abs(a(n)) * abs(b(n) - y) + abs(y) * abs(a(n) - x) < upper_a * delta + upper_y * delta
                upper_a * delta + upper_y * delta = (upper_a + upper_y) * delta = (upper_a + upper_y) * (epsilon / (upper_a + upper_y)) = epsilon
                product_sequence(n) = a(n) * b(n)
                product_sequence(n) - x * y = a(n) * b(n) - x * y
                a(n) * b(n) - x * y = a(n) * (b(n) - y) + y * (a(n) - x)
                product_sequence(n) - x * y = a(n) * (b(n) - y) + y * (a(n) - x)
                abs(product_sequence(n) - x * y) = abs(a(n) * (b(n) - y) + y * (a(n) - x)) <= abs(a(n) * (b(n) - y)) + abs(y * (a(n) - x)) = abs(a(n)) * abs(b(n) - y) + abs(y) * abs(a(n) - x) < epsilon
            by def $is_tail_close_to(product_sequence, x * y, epsilon, product_tail_start)
    by def $has_limit(product_sequence, x * y)
    by thm limit_extensional(product_sequence, fn(i_index N+) R {a(i_index) * b(i_index)}, x * y) => $has_limit(fn(i_index N+) R {a(i_index) * b(i_index)}, x * y)
forall first, second R:
    $is_finite_set(union({first}, {second}))
    union({first}, {second}) $subset R
    $is_nonempty_set(union({first}, {second}))
thm two_point_max_stability:
    ? forall epsilon R+, u, v, x, y R:
        abs(u - x) < epsilon
        abs(v - y) < epsilon
        $is_finite_set(union({u}, {v}))
        $is_nonempty_set(union({u}, {v}))
        union({u}, {v}) $subset R
        $is_finite_set(union({x}, {y}))
        $is_nonempty_set(union({x}, {y}))
        union({x}, {y}) $subset R
        =>:
            abs(finite_set_max(union({u}, { v})) - finite_set_max(union({x}, { y}))) <= epsilon
thm two_point_min_stability:
    ? forall epsilon R+, u, v, x, y R:
        abs(u - x) < epsilon
        abs(v - y) < epsilon
        $is_finite_set(union({u}, {v}))
        $is_nonempty_set(union({u}, {v}))
        union({u}, {v}) $subset R
        $is_finite_set(union({x}, {y}))
        $is_nonempty_set(union({x}, {y}))
        union({x}, {y}) $subset R
        =>:
            abs(finite_set_min(union({u}, { v})) - finite_set_min(union({x}, { y}))) <= epsilon
thm seq_max_converges_to:
    ? forall a, b seq(R), x, y R:
        $has_limit(a, x)
        $has_limit(b, y)
        =>:
            $has_limit(fn(i_index N+) R {finite_set_max(union({a(i_index)}, {b(i_index)}))}, finite_set_max(union({x}, {y})))
    $is_finite_set(union({x}, {y}))
    union({x}, {y}) $subset R
    $is_nonempty_set(union({x}, {y}))
    have maximum_limit R = finite_set_max(union({x}, {y}))
    have maximum_sequence seq(R) = fn(i_index N+) R {finite_set_max(union({a(i_index)}, {b(i_index)}))}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(maximum_sequence, maximum_limit, epsilon)
        0 < epsilon / 2
        epsilon / 2 $in R+
        $has_eventual_closeness_to(a, x, epsilon / 2)
        $has_eventual_closeness_to(b, y, epsilon / 2)
        obtain n1 from $has_eventual_closeness_to(a, x, epsilon / 2)
        obtain n2 from $has_eventual_closeness_to(b, y, epsilon / 2)
        have max_tail_start N+ = n1 + n2
        max_tail_start >= n1
        max_tail_start >= n2
        witness $has_eventual_closeness_to(maximum_sequence, maximum_limit, epsilon) from max_tail_start:
            claim:
                ? forall n N+:
                    n >= max_tail_start
                    =>:
                        abs(maximum_sequence(n) - maximum_limit) < epsilon
                n1 <= max_tail_start <= n
                n2 <= max_tail_start <= n
                abs(a(n) - x) < epsilon / 2
                abs(b(n) - y) < epsilon / 2
                $is_finite_set(union({a(n)}, {b(n)}))
                union({a(n)}, {b(n)}) $subset R
                $is_nonempty_set(union({a(n)}, {b(n)}))
                release thm two_point_max_stability(epsilon / 2, a(n), b(n), x, y)
                maximum_sequence(n) = finite_set_max(union({a(n)}, {b(n)}))
                maximum_sequence(n) - maximum_limit = finite_set_max(union({a(n)}, {b(n)})) - finite_set_max(union({x}, {y}))
                abs(maximum_sequence(n) - maximum_limit) = abs(finite_set_max(union({a(n)}, {b(n)})) - finite_set_max(union({x}, {y}))) <= epsilon / 2 < epsilon
            by def $is_tail_close_to(maximum_sequence, maximum_limit, epsilon, max_tail_start)
    by def $has_limit(maximum_sequence, maximum_limit)
    by thm limit_extensional(maximum_sequence, fn(i_index N+) R {finite_set_max(union({a(i_index)}, {b(i_index)}))}, finite_set_max(union({x}, {y}))) => $has_limit(fn(i_index N+) R {finite_set_max(union({a(i_index)}, {b(i_index)}))}, finite_set_max(union({x}, {y})))
thm seq_min_converges_to:
    ? forall a, b seq(R), x, y R:
        $has_limit(a, x)
        $has_limit(b, y)
        =>:
            $has_limit(fn(i_index N+) R {finite_set_min(union({a(i_index)}, {b(i_index)}))}, finite_set_min(union({x}, {y})))
    $is_finite_set(union({x}, {y}))
    union({x}, {y}) $subset R
    $is_nonempty_set(union({x}, {y}))
    have minimum_limit R = finite_set_min(union({x}, {y}))
    have minimum_sequence seq(R) = fn(i_index N+) R {finite_set_min(union({a(i_index)}, {b(i_index)}))}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(minimum_sequence, minimum_limit, epsilon)
        0 < epsilon / 2
        epsilon / 2 $in R+
        $has_eventual_closeness_to(a, x, epsilon / 2)
        $has_eventual_closeness_to(b, y, epsilon / 2)
        obtain n1 from $has_eventual_closeness_to(a, x, epsilon / 2)
        obtain n2 from $has_eventual_closeness_to(b, y, epsilon / 2)
        have min_tail_start N+ = n1 + n2
        min_tail_start >= n1
        min_tail_start >= n2
        witness $has_eventual_closeness_to(minimum_sequence, minimum_limit, epsilon) from min_tail_start:
            claim:
                ? forall n N+:
                    n >= min_tail_start
                    =>:
                        abs(minimum_sequence(n) - minimum_limit) < epsilon
                n1 <= min_tail_start <= n
                n2 <= min_tail_start <= n
                abs(a(n) - x) < epsilon / 2
                abs(b(n) - y) < epsilon / 2
                $is_finite_set(union({a(n)}, {b(n)}))
                union({a(n)}, {b(n)}) $subset R
                $is_nonempty_set(union({a(n)}, {b(n)}))
                release thm two_point_min_stability(epsilon / 2, a(n), b(n), x, y)
                minimum_sequence(n) = finite_set_min(union({a(n)}, {b(n)}))
                minimum_sequence(n) - minimum_limit = finite_set_min(union({a(n)}, {b(n)})) - finite_set_min(union({x}, {y}))
                abs(minimum_sequence(n) - minimum_limit) = abs(finite_set_min(union({a(n)}, {b(n)})) - finite_set_min(union({x}, {y}))) <= epsilon / 2 < epsilon
            by def $is_tail_close_to(minimum_sequence, minimum_limit, epsilon, min_tail_start)
    by def $has_limit(minimum_sequence, minimum_limit)
    by thm limit_extensional(minimum_sequence, fn(i_index N+) R {finite_set_min(union({a(i_index)}, {b(i_index)}))}, finite_set_min(union({x}, {y}))) => $has_limit(fn(i_index N+) R {finite_set_min(union({a(i_index)}, {b(i_index)}))}, finite_set_min(union({x}, {y})))
thm near_nonzero_abs_lower:
    ? forall z, y R:
        y != 0
        abs(z - y) <= abs(y) / 2
        =>:
            abs(z) >= abs(y) / 2
    y - z = -(z - y)
    abs(y - z) = abs(-(z - y)) = abs(z - y)
    abs(y) = abs((y - z) + z) <= abs(y - z) + abs(z) = abs(z - y) + abs(z) <= abs(y) / 2 + abs(z)
    abs(z) >= abs(y) / 2 or abs(z) < abs(y) / 2
    by cases:
        ? abs(z) >= abs(y) / 2
        case abs(z) >= abs(y) / 2:
            abs(z) >= abs(y) / 2
        case abs(z) < abs(y) / 2:
            abs(y) / 2 + abs(z) < abs(y) / 2 + abs(y) / 2 = abs(y)
            impossible abs(y) <= abs(y) / 2 + abs(z)
thm reciprocal_abs_diff_bound:
    ? forall x, y R, c, epsilon R+:
        x != 0
        y != 0
        abs(x) >= c
        abs(y) >= c
        abs(x - y) <= c^2 * epsilon
        =>:
            abs(1 / x - 1 / y) <= epsilon
    abs(x) >= c > 0
    abs(y) >= c > 0
    abs(x * y) = abs(x) * abs(y) >= c * abs(y) >= c * c = c^2
    abs(1 / x - 1 / y) >= 0
    (1 / x - 1 / y) * (x * y) = (1 / x) * (x * y) - (1 / y) * (x * y) = y - x
    y - x = -(x - y)
    abs(y - x) = abs(-(x - y)) = abs(x - y)
    abs(1 / x - 1 / y) * c^2 <= abs(1 / x - 1 / y) * abs(x * y) = abs((1 / x - 1 / y) * (x * y)) = abs(x - y) <= c^2 * epsilon
    c^2 > 0
    abs(1 / x - 1 / y) <= (c^2 * epsilon) / c^2 = epsilon
prop is_tail_upper_bound(a seq(R), m N+, M R):
    forall n N+:
        n >= m
        =>:
            a(n) <= M
prop is_tail_lower_bound(a seq(R), m N+, M R):
    forall n N+:
        n >= m
        =>:
            M <= a(n)
prop is_tail_supremum(a seq(R), m N+, L R):
    $is_tail_upper_bound(a, m, L)
    forall M R:
        $is_tail_upper_bound(a, m, M)
        =>:
            L <= M
prop has_tail_supremum(a seq(R), m N+):
    exist L R st {$is_tail_supremum(a, m, L)}
prop is_tail_value(a seq(R), m N+, x R):
    exist n N+ st {n >= m and x = a(n)}
thm tail_value_at_or_after_start:
    ? forall a seq(R), m, n N+:
        n >= m
        =>:
            $is_tail_value(a, m, a(n))
    witness $is_tail_value(a, m, a(n)) from n
prop is_tail_infimum(a seq(R), m N+, L R):
    $is_tail_lower_bound(a, m, L)
    forall M R:
        $is_tail_lower_bound(a, m, M)
        =>:
            M <= L
prop has_tail_infimum(a seq(R), m N+):
    exist L R st {$is_tail_infimum(a, m, L)}
thm tail_supremum_unique:
    ? forall a seq(R), m N+, L1, L2 R:
        $is_tail_supremum(a, m, L1)
        $is_tail_supremum(a, m, L2)
        =>:
            L1 = L2
    L1 <= L2
    L2 <= L1
thm tail_infimum_unique:
    ? forall a seq(R), m N+, L1, L2 R:
        $is_tail_infimum(a, m, L1)
        $is_tail_infimum(a, m, L2)
        =>:
            L1 = L2
    L1 <= L2
    L2 <= L1
claim:
    ? forall a seq(R), m N+:
        $has_tail_supremum(a, m)
        =>:
            exist! L R st {$is_tail_supremum(a, m, L)}
    obtain L from $has_tail_supremum(a, m)
    witness exist! chosen_supremum R st {$is_tail_supremum(a, m, chosen_supremum)} from L
have fn tail_sup by exist!:
    ? forall a seq(R), m N+:
        $has_tail_supremum(a, m)
        =>:
            exist! L R st {$is_tail_supremum(a, m, L)}
claim:
    ? forall a seq(R), m N+:
        $has_tail_infimum(a, m)
        =>:
            exist! L R st {$is_tail_infimum(a, m, L)}
    obtain L from $has_tail_infimum(a, m)
    witness exist! chosen_infimum R st {$is_tail_infimum(a, m, chosen_infimum)} from L
have fn tail_inf by exist!:
    ? forall a seq(R), m N+:
        $has_tail_infimum(a, m)
        =>:
            exist! L R st {$is_tail_infimum(a, m, L)}
thm tail_sup_apply:
    ? forall a seq(R), m N+:
        $has_tail_supremum(a, m)
        =>:
            $is_tail_supremum(a, m, tail_sup(a, m))
thm bounded_sequence_has_tail_supremum:
    ? forall a seq(R), m N+:
        $is_bounded_sequence(a)
        =>:
            $has_tail_supremum(a, m)
    have tail_range power_set(R) = {x R: $is_tail_value(a, m, x)}
    obtain B from $is_bounded_sequence(a)
    claim:
        ? $is_nonempty_set(tail_range)
        release thm tail_value_at_or_after_start(a, m, m)
        release thm set_builder_member(a(m), {x R: $is_tail_value(a, m, x)})
        a(m) $in {x R: $is_tail_value(a, m, x)}
        witness $is_nonempty_set(tail_range) from a(m)
    claim:
        ? forall x tail_range:
            x <= B
        obtain n from $is_tail_value(a, m, x)
        x = a(n) <= abs(a(n)) <= B
    by def $chap5::is_upper_bound(tail_range, B)
    witness exist bound_witness R st {$chap5::is_upper_bound(tail_range, bound_witness)} from B
    by def $chap5::has_upper_bound(tail_range)
    release thm chap5::least_upper_bound_existence(tail_range)
    obtain L from exist L R st {$chap5::is_least_upper_bound(tail_range, L)}
    $chap5::is_upper_bound(tail_range, L)
    claim:
        ? forall n N+:
            n >= m
            =>:
                a(n) <= L
        $is_tail_value(a, m, a(n))
        release thm set_builder_member(a(n), {x R: $is_tail_value(a, m, x)})
        a(n) $in {x R: $is_tail_value(a, m, x)}
        a(n) $in tail_range
        a(n) <= L
    by def $is_tail_upper_bound(a, m, L)
    claim:
        ? forall M R:
            $is_tail_upper_bound(a, m, M)
            =>:
                L <= M
        claim:
            ? forall x tail_range:
                x <= M
            obtain n from $is_tail_value(a, m, x)
            x = a(n) <= M
        by def $chap5::is_upper_bound(tail_range, M)
    by def $is_tail_supremum(a, m, L)
    witness $has_tail_supremum(a, m) from L
forall n N+:
    n >= 1
    =>:
        alternating_one_seq(n) = (-1)^n <= 1
by def $is_tail_upper_bound(alternating_one_seq, 1, 1)
claim:
    ? forall M R:
        $is_tail_upper_bound(alternating_one_seq, 1, M)
        =>:
            1 <= M
    2 >= 1
    alternating_one_seq(2) <= M
    alternating_one_seq(2) = (-1)^2 = 1
by def $is_tail_supremum(alternating_one_seq, 1, 1)
forall n N+:
    n >= 1
    =>:
        (-1) <= (-1)^n = alternating_one_seq(n)
        (-1) <= alternating_one_seq(n)
by def $is_tail_lower_bound(alternating_one_seq, 1, (-1))
claim:
