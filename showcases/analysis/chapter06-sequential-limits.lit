by def $is_tail_infimum(alternating_one_seq, 1, (-1))
witness $has_tail_supremum(alternating_one_seq, 1) from 1
witness $has_tail_infimum(alternating_one_seq, 1) from (-1)
$is_tail_supremum(alternating_one_seq, 1, tail_sup(alternating_one_seq, 1))
release thm tail_supremum_unique(alternating_one_seq, 1, tail_sup(alternating_one_seq, 1), 1)
$is_tail_infimum(alternating_one_seq, 1, tail_inf(alternating_one_seq, 1))
release thm tail_infimum_unique(alternating_one_seq, 1, tail_inf(alternating_one_seq, 1), -1)
