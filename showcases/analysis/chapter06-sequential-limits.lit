witness $has_tail_supremum(reciprocal_nat_seq, 1) from 1
witness $has_tail_infimum(reciprocal_nat_seq, 1) from 0
$is_tail_supremum(reciprocal_nat_seq, 1, tail_sup(reciprocal_nat_seq, 1))
release thm tail_supremum_unique(reciprocal_nat_seq, 1, tail_sup(reciprocal_nat_seq, 1), 1)
