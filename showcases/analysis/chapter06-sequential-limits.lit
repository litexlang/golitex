        by def $is_eventually_above_threshold(natural_as_real_seq, y, n0)
by def $has_limit_inferior_pos_infinity(natural_as_real_seq)
claim:
    ? forall bounded_sequence seq(R), positive_index N+:
        $is_bounded_sequence(bounded_sequence)
        positive_index + 1 $in N+
        =>:
            $has_tail_supremum(bounded_sequence, positive_index)
            $has_tail_supremum(bounded_sequence, positive_index + 1)
    release thm bounded_sequence_has_tail_supremum(bounded_sequence, positive_index)
    release thm bounded_sequence_has_tail_supremum(bounded_sequence, positive_index + 1)
thm bounded_sequence_tail_sup_values_decrease:
    ? forall a seq(R), n N+:
        $is_bounded_sequence(a)
        n + 1 $in N+
        $has_tail_supremum(a, n)
        $has_tail_supremum(a, n + 1)
        =>:
            tail_sup(a, n + 1) <= tail_sup(a, n)
    $is_tail_supremum(a, n, tail_sup(a, n))
    $is_tail_supremum(a, n + 1, tail_sup(a, n + 1))
    release thm tail_supremum_is_upper_bound(a, n, tail_sup(a, n))
    release thm tail_upper_bound_on_later_tail(a, n, n + 1, tail_sup(a, n))
    release thm tail_supremum_le_every_upper_bound(a, n + 1, tail_sup(a, n + 1), tail_sup(a, n))
thm bounded_sequence_tail_sup_sequence_decreasing:
    ? forall a, b seq(R):
        forall m N+:
            $has_tail_supremum(a, m)
        forall m N+:
            $has_tail_supremum(a, m)
            =>:
                b(m) = tail_sup(a, m)
        $is_bounded_sequence(a)
        =>:
            $is_decreasing_sequence(b)
    claim:
        ? forall n N+:
            n + 1 $in N+
            =>:
                b(n + 1) <= b(n)
        $has_tail_supremum(a, n)
        $has_tail_supremum(a, n + 1)
        b(n + 1) = tail_sup(a, n + 1)
        b(n) = tail_sup(a, n)
        release thm bounded_sequence_tail_sup_values_decrease(a, n)
        b(n + 1) = tail_sup(a, n + 1) <= tail_sup(a, n) = b(n)
    by def $is_decreasing_sequence(b)
claim:
    ? forall bounded_sequence seq(R), tail_index N+:
        $is_bounded_sequence(bounded_sequence)
        =>:
            $has_tail_supremum(bounded_sequence, tail_index)
    release thm bounded_sequence_has_tail_supremum(bounded_sequence, tail_index)
thm bounded_sequence_tail_sup_value_lower_bound:
    ? forall a seq(R), B R, m N+:
        $is_bounded_sequence(a)
        $is_bounded_by(a, B)
        $has_tail_supremum(a, m)
        =>:
            (-B) <= tail_sup(a, m)
    $is_tail_supremum(a, m, tail_sup(a, m))
    release thm tail_supremum_is_upper_bound(a, m, tail_sup(a, m))
    m >= m
    a(m) <= tail_sup(a, m)
    abs(a(m)) <= B
    (-a(m)) <= abs(-a(m)) = abs(a(m))
    -abs(a(m)) = -a(m) + (a(m) - abs(a(m))) <= abs(a(m)) + (a(m) - abs(a(m))) = a(m)
    -B = abs(a(m)) + (-B - abs(a(m))) <= B + (-B - abs(a(m))) = -abs(a(m))
    (-B) <= a(m) <= tail_sup(a, m)
thm bounded_sequence_tail_sup_sequence_bounded_below:
    ? forall a, b seq(R):
        forall m N+:
            $has_tail_supremum(a, m)
        forall m N+:
            $has_tail_supremum(a, m)
            =>:
                b(m) = tail_sup(a, m)
        $is_bounded_sequence(a)
        =>:
            $is_bounded_below_sequence(b)
    obtain B from $is_bounded_sequence(a)
    claim:
        ? forall m N+:
            (-B) <= b(m)
        $has_tail_supremum(a, m)
        release thm bounded_sequence_tail_sup_value_lower_bound(a, B, m)
        b(m) = tail_sup(a, m)
        (-B) <= tail_sup(a, m) = b(m)
    by def $is_sequence_lower_bound(b, (-B))
    witness $is_bounded_below_sequence(b) from (-B)
thm bounded_sequence_tail_sup_sequence_converges:
    ? forall a, b seq(R):
        forall m N+:
            $has_tail_supremum(a, m)
        forall m N+:
            $has_tail_supremum(a, m)
            =>:
                b(m) = tail_sup(a, m)
        $is_bounded_sequence(a)
        =>:
            $is_convergent_sequence(b)
    release thm bounded_sequence_tail_sup_sequence_decreasing(a, b)
    release thm bounded_sequence_tail_sup_sequence_bounded_below(a, b)
    release thm bounded_decreasing_sequence_converges(b)
thm tail_sup_limit_is_finite_limsup:
    ? forall a, b seq(R), L R:
        forall m N+:
            $has_tail_supremum(a, m)
        forall m N+:
            $has_tail_supremum(a, m)
            =>:
                b(m) = tail_sup(a, m)
        $has_limit(b, L)
        =>:
            $has_finite_limit_superior(a, L)
    claim:
        ? forall x R:
            x > L
            =>:
                exist n_tail N+ st {$is_eventually_below_threshold(a, x, n_tail)}
        0 = L - L < x - L
        x - L $in R+
        $has_eventual_closeness_to(b, L, x - L)
        obtain n0 from $has_eventual_closeness_to(b, L, x - L)
        $has_tail_supremum(a, n0)
        b(n0) = tail_sup(a, n0)
        abs(b(n0) - L) < x - L
        b(n0) - L <= abs(b(n0) - L) < x - L
        b(n0) = (b(n0) - L) + L < (x - L) + L = x
        release thm tail_sup_apply(a, n0)
        release thm tail_supremum_is_upper_bound(a, n0, tail_sup(a, n0))
        witness exist n_tail N+ st {$is_eventually_below_threshold(a, x, n_tail)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        a(n) < x
                a(n) <= tail_sup(a, n0) = b(n0) < x
            by def $is_eventually_below_threshold(a, x, n0)
    by def $is_eventually_below_every_threshold_above(a, L)
    claim:
        ? forall x R:
            x < L
            =>:
                $exceeds_threshold_arbitrarily_late(a, x)
        0 = x - x < L - x
        L - x $in R+
        $has_eventual_closeness_to(b, L, L - x)
        obtain n0 from $has_eventual_closeness_to(b, L, L - x)
        claim:
            ? forall n_tail N+:
                exist n N+ st {n >= n_tail and x < a(n)}
            have m0 N+ = n_tail + n0
            m0 >= n_tail
            m0 >= n0
            $has_tail_supremum(a, m0)
            b(m0) = tail_sup(a, m0)
            abs(b(m0) - L) < L - x
            L - b(m0) = -(b(m0) - L)
            abs(L - b(m0)) = abs(-(b(m0) - L)) = abs(b(m0) - L)
            L - b(m0) <= abs(L - b(m0)) = abs(b(m0) - L) < L - x
            x = (L - b(m0)) + (x - L + b(m0)) < (L - x) + (x - L + b(m0)) = b(m0) = tail_sup(a, m0)
            release thm tail_sup_apply(a, m0)
            release thm tail_supremum_crosses_every_lower_threshold(a, m0, tail_sup(a, m0), x)
            obtain n1 from exist n1 N+ st {n1 >= m0 and x < a(n1)}
            n_tail <= m0 <= n1
            witness exist n N+ st {n >= n_tail and x < a(n)} from n1
        by def $exceeds_threshold_arbitrarily_late(a, x)
    by def $exceeds_every_threshold_below_arbitrarily_late(a, L)
    by def $has_finite_limit_superior(a, L)
thm bounded_sequence_has_finite_limsup:
    ? forall a seq(R):
        $is_bounded_sequence(a)
        =>:
            exist Lplus R st {$has_finite_limit_superior(a, Lplus)}
    forall m N+:
        $has_tail_supremum(a, m)
    have b seq(R) = fn(m N+) R {tail_sup(a, m)}
    claim:
        ? forall m N+:
            b(m) = tail_sup(a, m)
        b(m) = tail_sup(a, m)
    release thm bounded_sequence_tail_sup_sequence_converges(a, b)
    obtain Lplus from exist Lplus R st {$has_limit(b, Lplus)}
    release thm tail_sup_limit_is_finite_limsup(a, b, Lplus)
    witness exist L0 R st {$has_finite_limit_superior(a, L0)} from Lplus
thm finite_limsup_le_tail_supremum:
    ? forall a seq(R), Lplus, S R:
        $has_finite_limit_superior(a, Lplus)
        $is_tail_supremum(a, 1, S)
        =>:
            Lplus <= S
    by contra:
        ? Lplus <= S
        not Lplus <= S
        S < Lplus
        $exceeds_every_threshold_below_arbitrarily_late(a, Lplus)
        $exceeds_threshold_arbitrarily_late(a, S)
        obtain n from exist n N+ st {n >= 1 and S < a(n)}
        release thm tail_supremum_is_upper_bound(a, 1, S)
        S < a(n) <= S
        impossible S = S
thm tail_infimum_le_finite_liminf:
    ? forall a seq(R), Lminus, I R:
        $has_finite_limit_inferior(a, Lminus)
        $is_tail_infimum(a, 1, I)
        =>:
            I <= Lminus
    by contra:
        ? I <= Lminus
        not I <= Lminus
        Lminus < I
        $falls_below_every_threshold_above_arbitrarily_late(a, Lminus)
        $falls_below_threshold_arbitrarily_late(a, I)
        obtain n from exist n N+ st {n >= 1 and a(n) < I}
        release thm tail_infimum_is_lower_bound(a, 1, I)
        I <= a(n) < I
        impossible I = I
thm finite_liminf_le_finite_limsup:
    ? forall a seq(R), Lminus, Lplus R:
        $has_finite_limit_inferior(a, Lminus)
        $has_finite_limit_superior(a, Lplus)
        =>:
            Lminus <= Lplus
    by contra:
        ? Lminus <= Lplus
        Lplus < Lminus
        have mid R = (Lplus + Lminus) / 2
        Lminus - Lplus > 0
        (Lminus - Lplus) / 2 > 0
        mid - Lplus = (Lplus + Lminus) / 2 - Lplus = (Lminus - Lplus) / 2
        Lminus - mid = Lminus - (Lplus + Lminus) / 2 = (Lminus - Lplus) / 2
        Lplus < mid < Lminus
        $is_eventually_below_every_threshold_above(a, Lplus)
        obtain n_upper from exist n_upper N+ st {$is_eventually_below_threshold(a, mid, n_upper)}
        $is_eventually_above_every_threshold_below(a, Lminus)
        obtain n_lower from exist n_lower N+ st {$is_eventually_above_threshold(a, mid, n_lower)}
        have contradiction_start N+ = n_upper + n_lower
        contradiction_start >= n_upper
        contradiction_start >= n_lower
        mid < a(contradiction_start) < mid
        impossible mid = mid
thm finite_lims_between_tail_bounds:
    ? forall a seq(R), I, Lminus, Lplus, S R:
        $is_tail_infimum(a, 1, I)
        $has_finite_limit_inferior(a, Lminus)
        $has_finite_limit_superior(a, Lplus)
        $is_tail_supremum(a, 1, S)
        =>:
            I <= Lminus
            Lminus <= Lplus
            Lplus <= S
    release thm tail_infimum_le_finite_liminf(a, Lminus, I)
    release thm finite_liminf_le_finite_limsup(a, Lminus, Lplus)
    release thm finite_limsup_le_tail_supremum(a, Lplus, S)
thm finite_limsup_bounds_limit_point:
    ? forall a seq(R), c, Lplus R:
        $is_limit_point(a, c)
        $has_finite_limit_superior(a, Lplus)
        =>:
            c <= Lplus
    by contra:
        ? c <= Lplus
        Lplus < c
        have x R = (Lplus + c) / 2
        c - Lplus > 0
        (c - Lplus) / 2 > 0
        x - Lplus = (Lplus + c) / 2 - Lplus = (c - Lplus) / 2
        c - x = c - (Lplus + c) / 2 = (c - Lplus) / 2
        Lplus < x < c
        $is_eventually_below_every_threshold_above(a, Lplus)
        obtain n0 from exist n0 N+ st {$is_eventually_below_threshold(a, x, n0)}
        0 < c - x
        c - x $in R+
        $is_epsilon_adherent_to_sequence(a, c, c - x, n0)
        obtain n from $is_epsilon_adherent_to_sequence(a, c, c - x, n0)
        a(n) < x
        c - x = a(n) + (c - x - a(n)) < x + (c - x - a(n)) = c - a(n)
        c - a(n) = -(a(n) - c)
        abs(c - a(n)) = abs(-(a(n) - c)) = abs(a(n) - c)
        c - a(n) <= abs(c - a(n)) = abs(a(n) - c) < c - x < c - a(n)
        impossible c - a(n) = c - a(n)
thm finite_liminf_bounds_limit_point:
    ? forall a seq(R), c, Lminus R:
        $is_limit_point(a, c)
        $has_finite_limit_inferior(a, Lminus)
        =>:
            Lminus <= c
    by contra:
        ? Lminus <= c
        c < Lminus
        have y R = (c + Lminus) / 2
        Lminus - c > 0
        (Lminus - c) / 2 > 0
        y - c = (c + Lminus) / 2 - c = (Lminus - c) / 2
        Lminus - y = Lminus - (c + Lminus) / 2 = (Lminus - c) / 2
        c < y < Lminus
        $is_eventually_above_every_threshold_below(a, Lminus)
        obtain n0 from exist n0 N+ st {$is_eventually_above_threshold(a, y, n0)}
        0 < y - c
        y - c $in R+
        $is_epsilon_adherent_to_sequence(a, c, y - c, n0)
        obtain n from $is_epsilon_adherent_to_sequence(a, c, y - c, n0)
        y < a(n)
        a(n) - c <= abs(a(n) - c) < y - c < a(n) - c
        impossible a(n) - c = a(n) - c
thm finite_lims_bound_limit_points:
    ? forall a seq(R), c, Lminus, Lplus R:
        $is_limit_point(a, c)
        $has_finite_limit_inferior(a, Lminus)
        $has_finite_limit_superior(a, Lplus)
        =>:
            Lminus <= c
            c <= Lplus
    release thm finite_liminf_bounds_limit_point(a, c, Lminus)
    release thm finite_limsup_bounds_limit_point(a, c, Lplus)
thm finite_limsup_is_limit_point:
    ? forall a seq(R), Lplus R:
        $has_finite_limit_superior(a, Lplus)
        =>:
            $is_limit_point(a, Lplus)
    claim:
        ? forall epsilon R+, n_tail N+:
            $is_epsilon_adherent_to_sequence(a, Lplus, epsilon, n_tail)
        Lplus + epsilon > Lplus
        $is_eventually_below_every_threshold_above(a, Lplus)
        obtain n_upper from exist n_upper N+ st {$is_eventually_below_threshold(a, Lplus + epsilon, n_upper)}
        0 < epsilon
        Lplus - epsilon = (Lplus - epsilon) + 0 < (Lplus - epsilon) + epsilon = Lplus
        $exceeds_every_threshold_below_arbitrarily_late(a, Lplus)
        $exceeds_threshold_arbitrarily_late(a, Lplus - epsilon)
        have limsup_hit_start N+ = n_tail + n_upper
        limsup_hit_start >= n_tail
        limsup_hit_start >= n_upper
        obtain n from exist n N+ st {n >= limsup_hit_start and Lplus - epsilon < a(n)}
        witness $is_epsilon_adherent_to_sequence(a, Lplus, epsilon, n_tail) from n:
            n_tail <= limsup_hit_start <= n
            n_upper <= limsup_hit_start <= n
            Lplus - epsilon < a(n) < Lplus + epsilon
            (-epsilon) = (Lplus - epsilon) - Lplus < a(n) - Lplus < (Lplus + epsilon) - Lplus = epsilon
            Lplus - a(n) < Lplus - (Lplus - epsilon) = epsilon
            -(a(n) - Lplus) = Lplus - a(n) < epsilon
            a(n) - Lplus $in R
            a(n) - Lplus >= 0 or a(n) - Lplus < 0
            by cases:
                ? abs(a(n) - Lplus) < epsilon
                case a(n) - Lplus >= 0:
                    0 <= a(n) - Lplus
                    abs(a(n) - Lplus) = a(n) - Lplus < epsilon
                case a(n) - Lplus < 0:
                    a(n) - Lplus <= 0
                    abs(a(n) - Lplus) = -(a(n) - Lplus) = Lplus - a(n) < epsilon
    by def $is_limit_point(a, Lplus)
thm finite_liminf_is_limit_point:
    ? forall a seq(R), Lminus R:
        $has_finite_limit_inferior(a, Lminus)
        =>:
            $is_limit_point(a, Lminus)
    claim:
        ? forall epsilon R+, n_tail N+:
            $is_epsilon_adherent_to_sequence(a, Lminus, epsilon, n_tail)
        0 < epsilon
        Lminus - epsilon = (Lminus - epsilon) + 0 < (Lminus - epsilon) + epsilon = Lminus
        $is_eventually_above_every_threshold_below(a, Lminus)
        obtain n_lower from exist n_lower N+ st {$is_eventually_above_threshold(a, Lminus - epsilon, n_lower)}
        Lminus + epsilon > Lminus
        $falls_below_every_threshold_above_arbitrarily_late(a, Lminus)
        $falls_below_threshold_arbitrarily_late(a, Lminus + epsilon)
        have liminf_hit_start N+ = n_tail + n_lower
        liminf_hit_start >= n_tail
        liminf_hit_start >= n_lower
        obtain n from exist n N+ st {n >= liminf_hit_start and a(n) < Lminus + epsilon}
        witness $is_epsilon_adherent_to_sequence(a, Lminus, epsilon, n_tail) from n:
            n_tail <= liminf_hit_start <= n
            n_lower <= liminf_hit_start <= n
            Lminus - epsilon < a(n) < Lminus + epsilon
            (-epsilon) = (Lminus - epsilon) - Lminus < a(n) - Lminus < (Lminus + epsilon) - Lminus = epsilon
            Lminus - a(n) < Lminus - (Lminus - epsilon) = epsilon
            -(a(n) - Lminus) = Lminus - a(n) < epsilon
            a(n) - Lminus $in R
            a(n) - Lminus >= 0 or a(n) - Lminus < 0
            by cases:
                ? abs(a(n) - Lminus) < epsilon
                case a(n) - Lminus >= 0:
                    0 <= a(n) - Lminus
                    abs(a(n) - Lminus) = a(n) - Lminus < epsilon
                case a(n) - Lminus < 0:
                    a(n) - Lminus <= 0
                    abs(a(n) - Lminus) = -(a(n) - Lminus) = Lminus - a(n) < epsilon
    by def $is_limit_point(a, Lminus)
thm convergent_sequence_has_finite_lims:
    ? forall a seq(R), c R:
        $has_limit(a, c)
        =>:
            $has_finite_limit_superior(a, c)
            $has_finite_limit_inferior(a, c)
    by thm convergent_sequence_limit_is_limit_point(a, c) => $is_limit_point(a, c)
    claim:
        ? forall x R:
            x > c
            =>:
                exist n_tail N+ st {$is_eventually_below_threshold(a, x, n_tail)}
        0 = c - c < x - c
        x - c $in R+
        $has_eventual_closeness_to(a, c, x - c)
        obtain n0 from $has_eventual_closeness_to(a, c, x - c)
        witness exist n_tail N+ st {$is_eventually_below_threshold(a, x, n_tail)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        a(n) < x
                a(n) - c <= abs(a(n) - c) < x - c
                a(n) = (a(n) - c) + c < (x - c) + c = x
            by def $is_eventually_below_threshold(a, x, n0)
    by def $is_eventually_below_every_threshold_above(a, c)
    claim:
        ? forall x R:
            x < c
            =>:
                $exceeds_threshold_arbitrarily_late(a, x)
        0 = x - x < c - x
        c - x $in R+
        claim:
            ? forall n_tail N+:
                exist n N+ st {n >= n_tail and x < a(n)}
            $is_epsilon_adherent_to_sequence(a, c, c - x, n_tail)
            obtain n from $is_epsilon_adherent_to_sequence(a, c, c - x, n_tail)
            c - a(n) = -(a(n) - c)
            abs(c - a(n)) = abs(-(a(n) - c)) = abs(a(n) - c)
            c - a(n) <= abs(c - a(n)) = abs(a(n) - c) < c - x
            x = (c - a(n)) + (x - c + a(n)) < (c - x) + (x - c + a(n)) = a(n)
            witness exist selected N+ st {selected >= n_tail and x < a(selected)} from n
        by def $exceeds_threshold_arbitrarily_late(a, x)
    by def $exceeds_every_threshold_below_arbitrarily_late(a, c)
    by def $has_finite_limit_superior(a, c)
    claim:
        ? forall y R:
            y < c
            =>:
                exist n_tail N+ st {$is_eventually_above_threshold(a, y, n_tail)}
        0 = y - y < c - y
        c - y $in R+
        $has_eventual_closeness_to(a, c, c - y)
        obtain n0 from $has_eventual_closeness_to(a, c, c - y)
        witness exist n_tail N+ st {$is_eventually_above_threshold(a, y, n_tail)} from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        y < a(n)
                c - a(n) = -(a(n) - c)
                abs(c - a(n)) = abs(-(a(n) - c)) = abs(a(n) - c)
                c - a(n) <= abs(c - a(n)) = abs(a(n) - c) < c - y
                y = (c - a(n)) + (y - c + a(n)) < (c - y) + (y - c + a(n)) = a(n)
            by def $is_eventually_above_threshold(a, y, n0)
    by def $is_eventually_above_every_threshold_below(a, c)
    claim:
        ? forall y R:
            y > c
            =>:
                $falls_below_threshold_arbitrarily_late(a, y)
        0 = c - c < y - c
        y - c $in R+
        claim:
            ? forall n_tail N+:
                exist n N+ st {n >= n_tail and a(n) < y}
            $is_epsilon_adherent_to_sequence(a, c, y - c, n_tail)
            obtain n from $is_epsilon_adherent_to_sequence(a, c, y - c, n_tail)
            a(n) - c <= abs(a(n) - c) < y - c
            a(n) = (a(n) - c) + c < (y - c) + c = y
            witness exist selected N+ st {selected >= n_tail and a(selected) < y} from n
        by def $falls_below_threshold_arbitrarily_late(a, y)
    by def $falls_below_every_threshold_above_arbitrarily_late(a, c)
    by def $has_finite_limit_inferior(a, c)
thm equal_finite_lims_converge:
    ? forall a seq(R), c R:
        $has_finite_limit_superior(a, c)
        $has_finite_limit_inferior(a, c)
        =>:
            $has_limit(a, c)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(a, c, epsilon)
        c + epsilon > c
        $is_eventually_below_every_threshold_above(a, c)
        obtain n_upper from exist n_upper N+ st {$is_eventually_below_threshold(a, c + epsilon, n_upper)}
        0 < epsilon
        c - epsilon = (c - epsilon) + 0 < (c - epsilon) + epsilon = c
        $is_eventually_above_every_threshold_below(a, c)
        obtain n_lower from exist n_lower N+ st {$is_eventually_above_threshold(a, c - epsilon, n_lower)}
        have equal_lims_start N+ = n_upper + n_lower
        equal_lims_start >= n_upper
        equal_lims_start >= n_lower
        witness $has_eventual_closeness_to(a, c, epsilon) from equal_lims_start:
            claim:
                ? forall n N+:
                    n >= equal_lims_start
                    =>:
                        abs(a(n) - c) < epsilon
                n_upper <= equal_lims_start <= n
                n_lower <= equal_lims_start <= n
                c - epsilon < a(n) < c + epsilon
                a(n) - c < (c + epsilon) - c = epsilon
                c - a(n) < c - (c - epsilon) = epsilon
                a(n) - c $in R
                a(n) - c >= 0 or a(n) - c < 0
                by cases:
                    ? abs(a(n) - c) < epsilon
                    case a(n) - c >= 0:
                        0 <= a(n) - c
                        abs(a(n) - c) = a(n) - c < epsilon
                    case a(n) - c < 0:
                        a(n) - c <= 0
                        abs(a(n) - c) = -(a(n) - c) = c - a(n) < epsilon
            by def $is_tail_close_to(a, c, epsilon, equal_lims_start)
    by def $has_limit(a, c)
thm finite_limsup_comparison:
    ? forall a, b seq(R), La, Lb R:
        $is_pointwise_le(a, b)
        $has_finite_limit_superior(a, La)
        $has_finite_limit_superior(b, Lb)
        =>:
            La <= Lb
    by contra:
        ? La <= Lb
        not La <= Lb
        Lb < La
        have mid R = (La + Lb) / 2
        La - Lb > 0
        (La - Lb) / 2 > 0
        mid - Lb = (La + Lb) / 2 - Lb = (La - Lb) / 2
        La - mid = La - (La + Lb) / 2 = (La - Lb) / 2
        Lb < mid < La
        $is_eventually_below_every_threshold_above(b, Lb)
        exist n0 N+ st {$is_eventually_below_threshold(b, mid, n0)}
        obtain n_tail from exist n_tail N+ st {$is_eventually_below_threshold(b, mid, n_tail)}
        $exceeds_every_threshold_below_arbitrarily_late(a, La)
        $exceeds_threshold_arbitrarily_late(a, mid)
        obtain n from exist n N+ st {n >= n_tail and mid < a(n)}
        mid < a(n) <= b(n) < mid
        impossible mid = mid
thm finite_liminf_comparison:
    ? forall a, b seq(R), La, Lb R:
        $is_pointwise_le(a, b)
        $has_finite_limit_inferior(a, La)
        $has_finite_limit_inferior(b, Lb)
        =>:
            La <= Lb
    by contra:
        ? La <= Lb
        not La <= Lb
        Lb < La
        have mid R = (La + Lb) / 2
        La - Lb > 0
        (La - Lb) / 2 > 0
        mid - Lb = (La + Lb) / 2 - Lb = (La - Lb) / 2
        La - mid = La - (La + Lb) / 2 = (La - Lb) / 2
        Lb < mid < La
        $is_eventually_above_every_threshold_below(a, La)
        exist n0 N+ st {$is_eventually_above_threshold(a, mid, n0)}
        obtain n_tail from exist n_tail N+ st {$is_eventually_above_threshold(a, mid, n_tail)}
        $falls_below_every_threshold_above_arbitrarily_late(b, Lb)
        $falls_below_threshold_arbitrarily_late(b, mid)
        obtain n from exist n N+ st {n >= n_tail and b(n) < mid}
        mid < a(n) <= b(n) < mid
        impossible mid = mid
thm squeeze_converges_to:
    ? forall a, b, c seq(R), L R:
        $is_pointwise_between(a, b, c)
        $has_limit(a, L)
        $has_limit(c, L)
        =>:
            $has_limit(b, L)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(b, L, epsilon)
        $has_eventual_closeness_to(a, L, epsilon)
        $has_eventual_closeness_to(c, L, epsilon)
        obtain n_lower from $has_eventual_closeness_to(a, L, epsilon)
        obtain n_upper from $has_eventual_closeness_to(c, L, epsilon)
        have squeeze_start N+ = n_lower + n_upper
        squeeze_start >= n_lower
        squeeze_start >= n_upper
        witness $has_eventual_closeness_to(b, L, epsilon) from squeeze_start:
            claim:
                ? forall n N+:
                    n >= squeeze_start
                    =>:
                        abs(b(n) - L) < epsilon
                n_lower <= squeeze_start <= n
                n_upper <= squeeze_start <= n
                abs(a(n) - L) < epsilon
                abs(c(n) - L) < epsilon
                a(n) <= b(n) <= c(n)
                b(n) - L = b(n) + (-L) <= c(n) + (-L) = c(n) - L
                c(n) - L <= abs(c(n) - L) < epsilon
                L - b(n) = a(n) + (L - b(n) - a(n)) <= b(n) + (L - b(n) - a(n)) = L - a(n)
                L - a(n) = -(a(n) - L)
                abs(L - a(n)) = abs(-(a(n) - L)) = abs(a(n) - L)
                L - b(n) <= L - a(n) <= abs(L - a(n)) = abs(a(n) - L) < epsilon
                b(n) - L $in R
                b(n) - L >= 0 or b(n) - L < 0
                by cases:
                    ? abs(b(n) - L) < epsilon
                    case b(n) - L >= 0:
                        0 <= b(n) - L
                        abs(b(n) - L) = b(n) - L < epsilon
                    case b(n) - L < 0:
                        b(n) - L <= 0
                        abs(b(n) - L) = -(b(n) - L) = L - b(n) < epsilon
            by def $is_tail_close_to(b, L, epsilon, squeeze_start)
    by def $has_limit(b, L)
have fn two_over_nat_seq(n N+) R = 2 / n
have fn neg_two_over_nat_seq(n N+) R = (-2) / n
release thm seq_const_mul_converges_to(2, reciprocal_nat_seq, 0)
forall n N+:
    reciprocal_nat_seq(n) = 1 / n
    2 * reciprocal_nat_seq(n) = 2 * (1 / n) = 2 / n
    two_over_nat_seq(n) = 2 / n = 2 * reciprocal_nat_seq(n)
two_over_nat_seq = fn(n N+) R {2 / n}
claim:
    ? forall positive_index N+:
        fn(n N+) R {2 / n}(positive_index) = fn(n N+) R {2 * reciprocal_nat_seq(n)}(positive_index)
    reciprocal_nat_seq(positive_index) = 1 / positive_index
    2 * reciprocal_nat_seq(positive_index) = 2 * (1 / positive_index) = 2 / positive_index
    fn(n N+) R {2 / n}(positive_index) = 2 / positive_index
    fn(n N+) R {2 * reciprocal_nat_seq(n)}(positive_index) = 2 * reciprocal_nat_seq(positive_index)
by fn_extension fn(n N+) R {2 / n} = fn(n N+) R {2 * reciprocal_nat_seq(n)}
claim:
    ? forall positive_index N+:
        two_over_nat_seq(positive_index) = fn(n N+) R {2 * reciprocal_nat_seq(n)}(positive_index)
    reciprocal_nat_seq(positive_index) = 1 / positive_index
    two_over_nat_seq(positive_index) = 2 / positive_index = 2 * reciprocal_nat_seq(positive_index)
    fn(n N+) R {2 * reciprocal_nat_seq(n)}(positive_index) = 2 * reciprocal_nat_seq(positive_index)
by fn_extension two_over_nat_seq = fn(n N+) R {2 * reciprocal_nat_seq(n)}
$has_limit(two_over_nat_seq, 0)
release thm seq_const_mul_converges_to(-2, reciprocal_nat_seq, 0)
forall n N+:
    reciprocal_nat_seq(n) = 1 / n
    (-2) * reciprocal_nat_seq(n) = (-2) * (1 / n) = (-2) / n
    neg_two_over_nat_seq(n) = (-2) / n = (-2) * reciprocal_nat_seq(n)
neg_two_over_nat_seq = fn(n N+) R {(-2) / n}
claim:
    ? forall positive_index N+:
        fn(n N+) R {(-2) / n}(positive_index) = fn(n N+) R {(-2) * reciprocal_nat_seq(n)}(positive_index)
    reciprocal_nat_seq(positive_index) = 1 / positive_index
    (-2) * reciprocal_nat_seq(positive_index) = (-2) * (1 / positive_index) = (-2) / positive_index
    fn(n N+) R {(-2) / n}(positive_index) = (-2) / positive_index
    fn(n N+) R {(-2) * reciprocal_nat_seq(n)}(positive_index) = (-2) * reciprocal_nat_seq(positive_index)
by fn_extension fn(n N+) R {(-2) / n} = fn(n N+) R {(-2) * reciprocal_nat_seq(n)}
claim:
    ? forall positive_index N+:
        neg_two_over_nat_seq(positive_index) = fn(n N+) R {(-2) * reciprocal_nat_seq(n)}(positive_index)
    reciprocal_nat_seq(positive_index) = 1 / positive_index
    neg_two_over_nat_seq(positive_index) = (-2) / positive_index = (-2) * reciprocal_nat_seq(positive_index)
    fn(n N+) R {(-2) * reciprocal_nat_seq(n)}(positive_index) = (-2) * reciprocal_nat_seq(positive_index)
by fn_extension neg_two_over_nat_seq = fn(n N+) R {(-2) * reciprocal_nat_seq(n)}
$has_limit(neg_two_over_nat_seq, 0)
thm squeeze_between_two_over_nat_converges_to_zero:
    ? forall b seq(R):
        $is_pointwise_between(neg_two_over_nat_seq, b, two_over_nat_seq)
        =>:
            $has_limit(b, 0)
    release thm squeeze_converges_to(neg_two_over_nat_seq, b, two_over_nat_seq, 0)
have fn seq_abs(a seq(R)) fn(k N+) R = fn(n N+) R {abs(a(n))}
thm sequence_abs_converges_to_zero:
    ? forall a seq(R):
        $has_limit(a, 0)
        =>:
            $has_limit(seq_abs(a), 0)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(seq_abs(a), 0, epsilon)
        $has_eventual_closeness_to(a, 0, epsilon)
        obtain n0 from $has_eventual_closeness_to(a, 0, epsilon)
        witness $has_eventual_closeness_to(seq_abs(a), 0, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(seq_abs(a)(n) - 0) < epsilon
                abs(a(n) - 0) < epsilon
                seq_abs(a)(n) = abs(a(n))
                0 <= seq_abs(a)(n)
                abs(seq_abs(a)(n) - 0) = abs(seq_abs(a)(n)) = seq_abs(a)(n) = abs(a(n)) = abs(a(n) - 0) < epsilon
            by def $is_tail_close_to(seq_abs(a), 0, epsilon, n0)
    by def $has_limit(seq_abs(a), 0)
thm sequence_abs_zero_limit_reflects:
    ? forall a seq(R):
        $has_limit(seq_abs(a), 0)
        =>:
            $has_limit(a, 0)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(a, 0, epsilon)
        $has_eventual_closeness_to(seq_abs(a), 0, epsilon)
        obtain n0 from $has_eventual_closeness_to(seq_abs(a), 0, epsilon)
        witness $has_eventual_closeness_to(a, 0, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(a(n) - 0) < epsilon
                abs(seq_abs(a)(n) - 0) < epsilon
                seq_abs(a)(n) = abs(a(n))
                0 <= seq_abs(a)(n)
                abs(seq_abs(a)(n)) = seq_abs(a)(n)
                abs(a(n) - 0) = abs(a(n)) = seq_abs(a)(n) = abs(seq_abs(a)(n)) = abs(seq_abs(a)(n) - 0) < epsilon
            by def $is_tail_close_to(a, 0, epsilon, n0)
    by def $has_limit(a, 0)
prop has_eventual_lower_bound(a seq(R), B R):
    exist n1 N+ st {$is_tail_lower_bound(a, n1, B)}
thm cauchy_sequence_converges:
    ? forall a seq(R):
        $is_cauchy_sequence(a)
        =>:
            $is_convergent_sequence(a)
    $has_eventual_epsilon_steadiness(a, 1)
    have E power_set(R) = {x R: $has_eventual_lower_bound(a, x)}
    claim:
        ? $is_nonempty_set(E)
        obtain n0 from $has_eventual_epsilon_steadiness(a, 1)
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    a(n0) - 1 <= a(n)
            abs(a(n0) - a(n)) < 1
            a(n0) - a(n) <= abs(a(n0) - a(n)) < 1
            a(n0) - 1 = (a(n0) - a(n)) + (a(n) - 1) < 1 + (a(n) - 1) = a(n)
        by def $is_tail_lower_bound(a, n0, a(n0) - 1)
        witness $has_eventual_lower_bound(a, a(n0) - 1) from n0
        a(n0) - 1 $in E
        witness $is_nonempty_set(E) from a(n0) - 1
    obtain upper_n0 from $has_eventual_epsilon_steadiness(a, 1)
    claim:
        ? forall x E:
            x <= a(upper_n0) + 1
        obtain n1 from $has_eventual_lower_bound(a, x)
        have upper_bound_start N+ = upper_n0 + n1
        upper_bound_start >= upper_n0
        upper_bound_start >= n1
        abs(a(upper_bound_start) - a(upper_n0)) < 1
        a(upper_bound_start) - a(upper_n0) <= abs(a(upper_bound_start) - a(upper_n0)) < 1
        a(upper_bound_start) = (a(upper_bound_start) - a(upper_n0)) + a(upper_n0) < 1 + a(upper_n0) = a(upper_n0) + 1
        a(upper_bound_start) <= a(upper_n0) + 1
        x <= a(upper_bound_start) <= a(upper_n0) + 1
    by def $chap5::is_upper_bound(E, a(upper_n0) + 1)
    witness exist bound_witness R st {$chap5::is_upper_bound(E, bound_witness)} from a(upper_n0) + 1
    by def $chap5::has_upper_bound(E)
    release thm chap5::least_upper_bound_existence(E)
    obtain L from exist L R st {$chap5::is_least_upper_bound(E, L)}
    $chap5::is_upper_bound(E, L)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(a, L, epsilon)
        0 < epsilon / 2
        epsilon / 2 $in R+
        $has_eventual_epsilon_steadiness(a, epsilon / 2)
        obtain n0 from $has_eventual_epsilon_steadiness(a, epsilon / 2)
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    abs(a(n) - L) < epsilon
            claim:
                ? a(n) - epsilon / 2 <= L
                claim:
                    ? forall k N+:
                        k >= n0
                        =>:
                            a(n) - epsilon / 2 <= a(k)
                    abs(a(n) - a(k)) < epsilon / 2
                    a(n) - a(k) <= abs(a(n) - a(k)) < epsilon / 2
                    a(n) - epsilon / 2 = (a(n) - a(k)) + (a(k) - epsilon / 2) < epsilon / 2 + (a(k) - epsilon / 2) = a(k)
                by def $is_tail_lower_bound(a, n0, a(n) - epsilon / 2)
                witness $has_eventual_lower_bound(a, a(n) - epsilon / 2) from n0
                a(n) - epsilon / 2 $in E
                a(n) - epsilon / 2 <= L
            claim:
                ? L <= a(n) + epsilon / 2
                claim:
                    ? forall x E:
                        x <= a(n) + epsilon / 2
                    obtain n1 from $has_eventual_lower_bound(a, x)
                    have epsilon_upper_start N+ = n0 + n1
                    epsilon_upper_start >= n0
                    epsilon_upper_start >= n1
                    abs(a(epsilon_upper_start) - a(n)) < epsilon / 2
                    a(epsilon_upper_start) - a(n) <= abs(a(epsilon_upper_start) - a(n)) < epsilon / 2
                    a(epsilon_upper_start) = (a(epsilon_upper_start) - a(n)) + a(n) < epsilon / 2 + a(n) = a(n) + epsilon / 2
                    a(epsilon_upper_start) <= a(n) + epsilon / 2
                    x <= a(epsilon_upper_start) <= a(n) + epsilon / 2
                by def $chap5::is_upper_bound(E, a(n) + epsilon / 2)
                L <= a(n) + epsilon / 2
            a(n) - epsilon / 2 <= L <= a(n) + epsilon / 2
            a(n) - L = (a(n) - epsilon / 2) + (epsilon / 2 - L) <= L + (epsilon / 2 - L) = epsilon / 2
            L - a(n) = L + (-a(n)) <= (a(n) + epsilon / 2) + (-a(n)) = epsilon / 2
            a(n) - L $in R
            a(n) - L >= 0 or a(n) - L < 0
            by cases:
                ? abs(a(n) - L) < epsilon
                case a(n) - L >= 0:
                    0 <= a(n) - L
                    abs(a(n) - L) = a(n) - L <= epsilon / 2 < epsilon
                case a(n) - L < 0:
                    a(n) - L <= 0
                    abs(a(n) - L) = -(a(n) - L) = L - a(n) <= epsilon / 2 < epsilon
        by def $is_tail_close_to(a, L, epsilon, n0)
        witness $has_eventual_closeness_to(a, L, epsilon) from n0
    by def $has_limit(a, L)
    witness $is_convergent_sequence(a) from L
thm convergent_sequence_is_cauchy_for_completeness_theorem:
    ? forall a seq(R):
        $is_convergent_sequence(a)
        =>:
            $is_cauchy_sequence(a)
    release thm convergent_sequence_is_cauchy(a)
thm real_sequence_cauchy_implies_convergent_for_completeness_theorem:
    ? forall a seq(R):
        $is_cauchy_sequence(a)
        =>:
            $is_convergent_sequence(a)
    release thm cauchy_sequence_converges(a)
prop is_reciprocal_kth_root_sequence(k N+, a seq(R)):
    forall n N+:
        a(n) >= 0
        (a(n))^k = 1 / n
thm nonnegative_power_lt_implies_lt:
    ? forall x R, y R+, k N+:
        x >= 0
        x^k < y^k
        =>:
            x < y
    by contra:
        ? x < y
        not x < y
        x >= y
        y >= 0
        x^k >= y^k
        y^k <= x^k < y^k
        impossible y^k = y^k
thm reciprocal_kth_root_pointwise_small:
    ? forall k N+, a seq(R), epsilon R+, n0, n N+:
        $is_reciprocal_kth_root_sequence(k, a)
        1 / n0 < epsilon^k
        n >= n0
        =>:
            abs(a(n) - 0) < epsilon
    by thm reciprocal_nat_order_reversing(n0, n) => 1 / n <= 1 / n0
    1 / n <= 1 / n0 < epsilon^k
    0 <= a(n)
    (a(n))^k = 1 / n
    (a(n))^k < epsilon^k
    release thm nonnegative_power_lt_implies_lt(a(n), epsilon, k)
    a(n) < epsilon
    abs(a(n) - 0) = abs(a(n))
    abs(a(n)) = a(n)
thm reciprocal_kth_root_sequence_converges_to_zero:
    ? forall k N+, a seq(R):
        $is_reciprocal_kth_root_sequence(k, a)
        =>:
            $has_limit(a, 0)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(a, 0, epsilon)
        epsilon^k $in R+
        release thm chap5::archimedean_property(epsilon^k)
        obtain n0 from exist n0 N+ st {1 / n0 < epsilon^k}
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    abs(a(n) - 0) < epsilon
            release thm reciprocal_kth_root_pointwise_small(k, a, epsilon, n0, n)
        witness $has_eventual_closeness_to(a, 0, epsilon) from n0:
            forall n N+:
                n >= n0
                =>:
                    abs(a(n) - 0) < epsilon
            by def $is_tail_close_to(a, 0, epsilon, n0)
    by def $has_limit(a, 0)
thm geometric_abs_lt_one_converges_to_zero:
    ? forall x R:
        abs(x) < 1
        =>:
            $has_limit(geom_seq(x), 0)
    abs(x) >= 0
    release thm geometric_nonnegative_lt_one_converges_to_zero(abs(x))
    release thm seq_const_mul_converges_to(-1, geom_seq(abs(x)), 0)
    claim:
        ? forall positive_index N+:
            seq_const_mul(-1, geom_seq(abs(x)))(positive_index) = fn(i_index N+) R {-1 * geom_seq(abs(x))(i_index)}(positive_index)
        seq_const_mul(-1, geom_seq(abs(x)))(positive_index) = (-1) * geom_seq(abs(x))(positive_index)
        fn(i_index N+) R {-1 * geom_seq(abs(x))(i_index)}(positive_index) = (-1) * geom_seq(abs(x))(positive_index)
    by fn_extension seq_const_mul(-1, geom_seq(abs(x))) = fn(i_index N+) R {-1 * geom_seq(abs(x))(i_index)}
    $has_limit(seq_const_mul(-1, geom_seq(abs(x))), 0)
    claim:
        ? forall exponent N:
            abs(x^exponent) = abs(x)^exponent
        by induc exponent from 0:
            ? abs(x^exponent) = abs(x)^exponent
            ? from exponent = 0:
                x^0 = 1
                abs(x^0) = abs(1) = 1 = abs(x)^0
            ? induc:
                x^(exponent + 1) = x^exponent * x
                x^exponent $in R
                abs(x^(exponent + 1)) = abs(x^exponent * x) = abs(x^exponent) * abs(x)
                abs(x)^(exponent + 1) = abs(x)^exponent * abs(x)
    claim:
        ? forall n N+:
            seq_const_mul(-1, geom_seq(abs(x)))(n) <= geom_seq(x)(n)
            geom_seq(x)(n) <= geom_seq(abs(x))(n)
        n $in N
        geom_seq(abs(x))(n) = abs(x)^n
        geom_seq(x)(n) = x^n
        abs(x^n) = abs(x)^n
        -x^n <= abs(-x^n) = abs(x^n)
        -abs(x^n) = -x^n + (x^n - abs(x^n)) <= abs(x^n) + (x^n - abs(x^n)) = x^n
        x^n <= abs(x^n)
        seq_const_mul(-1, geom_seq(abs(x)))(n) = (-1) * geom_seq(abs(x))(n)
        (-1) * geom_seq(abs(x))(n) = -geom_seq(abs(x))(n)
        -geom_seq(abs(x))(n) = -abs(x)^n = -abs(x^n) <= x^n = geom_seq(x)(n)
        geom_seq(x)(n) = x^n <= abs(x^n) = abs(x)^n = geom_seq(abs(x))(n)
    by def $is_pointwise_between(seq_const_mul(-1, geom_seq(abs(x))), geom_seq(x), geom_seq(abs(x)))
    release thm squeeze_converges_to(seq_const_mul(-1, geom_seq(abs(x))), geom_seq(x), geom_seq(abs(x)), 0)
thm geometric_one_converges_to_one:
    ? forall x R:
        x = 1
        =>:
            $has_limit(geom_seq(x), 1)
    release thm constant_sequence_has_limit(1)
    claim:
        ? forall n N+:
            geom_seq(x)(n) = fn(k N+) R {1}(n)
        geom_seq(x)(n) = x^n
        x^n = 1^n = 1
        fn(k N+) R {1}(n) = 1
    by fn_extension geom_seq(x) = fn(n N+) R {1}
thm geometric_minus_one_diverges:
    ? forall x R:
        x = (-1)
        =>:
            $is_divergent_sequence(geom_seq(x))
    claim:
        ? forall n N+:
            geom_seq(x)(n) = alternating_one_seq(n)
        geom_seq(x)(n) = x^n
        x^n = (-1)^n
        alternating_one_seq(n) = (-1)^n
    by fn_extension geom_seq(x) = alternating_one_seq
    $is_divergent_sequence(alternating_one_seq)
thm not_divergent_sequence_is_convergent:
    ? forall a seq(R):
        not $is_divergent_sequence(a)
        =>:
            $is_convergent_sequence(a)
    by contra:
        ? $is_convergent_sequence(a)
        not $is_convergent_sequence(a)
        by def $is_divergent_sequence(a)
        $is_divergent_sequence(a)
        impossible not $is_divergent_sequence(a)
thm positive_power_gt_one:
    ? forall u R, n N+:
        u > 1
        =>:
            u^n > 1
    by induc n from 1:
        ? u^n > 1
        ? from n = 1:
            u^1 = u > 1
        ? induc:
            u^(n + 1) = u^n * u
            0 < u
            u = 1 * u < u^n * u
            u^n * u > u > 1
thm geometric_abs_gt_one_diverges:
    ? forall x R:
        abs(x) > 1
        =>:
            $is_divergent_sequence(geom_seq(x))
    by contra:
        ? $is_divergent_sequence(geom_seq(x))
        release thm not_divergent_sequence_is_convergent(geom_seq(x))
        obtain L from exist L R st {$has_limit(geom_seq(x), L)}
        release thm seq_shift_has_limit(geom_seq(x), L)
        release thm shifted_geometric_sequence_has_scaled_limit(x, L)
        release thm sequence_limit_unique(seq_shift(geom_seq(x)), L, x * L)
        L = x * L
        (1 - x) * L = L - x * L = 0
        by contra:
            ? x != 1
            x = 1
            abs(x) = abs(1) = 1
            impossible abs(x) > 1
        by contra:
            ? 1 - x != 0
            1 - x = 0
            x = 1 - (1 - x) = 1
            impossible x = 1
        L = ((1 - x) * L) / (1 - x)
        ((1 - x) * L) / (1 - x) = 0 / (1 - x) = 0
        L = 0
        $has_limit(geom_seq(x), 0)
        1 $in R+
        $has_eventual_closeness_to(geom_seq(x), 0, 1)
        obtain n0 from $has_eventual_closeness_to(geom_seq(x), 0, 1)
        abs(geom_seq(x)(n0) - 0) < 1
        release thm positive_power_gt_one(abs(x), n0)
        abs(x)^n0 > 1
        geom_seq(x)(n0) = x^n0
        geom_seq(x)(n0) - 0 = x^n0 - 0
        x^n0 - 0 = x^n0
        geom_seq(x)(n0) - 0 = x^n0
        abs(geom_seq(x)(n0) - 0) = abs(x^n0)
        claim:
            ? forall exponent N:
                abs(x^exponent) = abs(x)^exponent
            by induc exponent from 0:
                ? abs(x^exponent) = abs(x)^exponent
                ? from exponent = 0:
                    x^0 = 1
                    abs(x^0) = abs(1) = 1 = abs(x)^0
                ? induc:
                    x^(exponent + 1) = x^exponent * x
                    x^exponent $in R
                    abs(x^(exponent + 1)) = abs(x^exponent * x) = abs(x^exponent) * abs(x)
                    abs(x)^(exponent + 1) = abs(x)^exponent * abs(x)
        n0 $in N
        abs(x^n0) = abs(x)^n0
        abs(geom_seq(x)(n0) - 0) = abs(x^n0) = abs(x)^n0 > 1
        impossible 1 < abs(geom_seq(x)(n0) - 0) < 1
prop is_nth_root_sequence_for(x R+, a seq(R)):
    forall n N+:
        a(n) >= 0
        (a(n))^n = x
thm geometric_base_gt_one_is_increasing:
    ? forall y R:
        y > 1
        =>:
            $is_increasing_sequence(geom_seq(y))
    claim:
        ? forall n N+:
            n + 1 $in N+
            =>:
                geom_seq(y)(n) <= geom_seq(y)(n + 1)
        release thm positive_power_gt_one(y, n)
        y^n > 1 > 0
        y^n * y > y^n * 1 = y^n
        geom_seq(y)(n + 1) = y^(n + 1)
        y^(n + 1) = y^n * y
        geom_seq(y)(n + 1) = y^n * y
        geom_seq(y)(n) = y^n
        geom_seq(y)(n + 1) > geom_seq(y)(n)
    by def $is_increasing_sequence(geom_seq(y))
thm geometric_base_gt_one_exceeds_threshold:
    ? forall y, B R:
        y > 1
        =>:
            exist n0 N+ st {geom_seq(y)(n0) > B}
    by contra:
        ? exist n0 N+ st {geom_seq(y)(n0) > B}
        claim:
            ? forall n N+:
                geom_seq(y)(n) <= B
            not geom_seq(y)(n) > B
        by def $is_sequence_upper_bound(geom_seq(y), B)
        witness $is_bounded_above_sequence(geom_seq(y)) from B
        release thm geometric_base_gt_one_is_increasing(y)
        release thm bounded_increasing_sequence_converges(geom_seq(y))
        y > 1 > 0
        0 <= y
        abs(y) = y > 1
        release thm geometric_abs_gt_one_diverges(y)
        impossible $is_convergent_sequence(geom_seq(y))
thm geometric_base_gt_one_eventually_exceeds_threshold:
    ? forall y, B R:
        y > 1
        =>:
            exist n0 N+ st {$is_eventually_above_threshold(geom_seq(y), B, n0)}
    release thm geometric_base_gt_one_exceeds_threshold(y, B)
    obtain n0 from exist n0 N+ st {geom_seq(y)(n0) > B}
    release thm geometric_base_gt_one_is_increasing(y)
    claim:
        ? forall n N+:
            n >= n0
            =>:
                B < geom_seq(y)(n)
        release thm increasing_seq_le_of_le(geom_seq(y), n0, n)
        B < geom_seq(y)(n0) <= geom_seq(y)(n)
    by def $is_eventually_above_threshold(geom_seq(y), B, n0)
    witness exist n1 N+ st {$is_eventually_above_threshold(geom_seq(y), B, n1)} from n0
thm nth_root_sequence_term_positive:
    ? forall x R+, a seq(R), n N+:
        $is_nth_root_sequence_for(x, a)
        =>:
            a(n) > 0
    a(n) >= 0
    (a(n))^n = x
    by contra:
        ? a(n) > 0
        not a(n) > 0
        a(n) <= 0
        a(n) >= 0
        a(n) = 0
        (a(n))^n = 0^n
        0^n = 0
        x = 0
        x > 0
        impossible 0 = 0
thm nth_root_sequence_eventually_below_one_plus_epsilon:
    ? forall x R+, a seq(R), epsilon R+:
        $is_nth_root_sequence_for(x, a)
        =>:
            exist n0 N+ st {$is_eventually_below_threshold(a, 1 + epsilon, n0)}
    1 + epsilon > 1
    release thm geometric_base_gt_one_eventually_exceeds_threshold(1 + epsilon, x)
    obtain n0 from exist n0 N+ st {$is_eventually_above_threshold(geom_seq(1 + epsilon), x, n0)}
    claim:
        ? forall n N+:
            n >= n0
            =>:
                a(n) < 1 + epsilon
        x < geom_seq(1 + epsilon)(n)
        (a(n))^n = x < geom_seq(1 + epsilon)(n) = (1 + epsilon)^n
        release thm nonnegative_power_lt_implies_lt(a(n), 1 + epsilon, n)
    by def $is_eventually_below_threshold(a, 1 + epsilon, n0)
    witness exist n1 N+ st {$is_eventually_below_threshold(a, 1 + epsilon, n1)} from n0
thm nth_root_sequence_eventually_above_one_minus_small_epsilon:
    ? forall x R+, a seq(R), epsilon R+:
        $is_nth_root_sequence_for(x, a)
        epsilon < 1
        =>:
            exist n0 N+ st {$is_eventually_above_threshold(a, 1 - epsilon, n0)}
    1 - epsilon > 0
    0 < epsilon
    1 - epsilon = (1 - epsilon) + 0 < (1 - epsilon) + epsilon = 1
    0 <= 1 - epsilon
    abs(1 - epsilon) = 1 - epsilon
    abs(1 - epsilon) < 1
    release thm geometric_abs_lt_one_converges_to_zero(1 - epsilon)
    release thm has_limit_gives_eventual_closeness(geom_seq(1 - epsilon), 0, x)
    obtain n0 from exist n0 N+ st {$is_tail_close_to(geom_seq(1 - epsilon), 0, x, n0)}
    claim:
        ? forall n N+:
            n >= n0
            =>:
                1 - epsilon < a(n)
        abs(geom_seq(1 - epsilon)(n) - 0) < x
        geom_seq(1 - epsilon)(n) = (1 - epsilon)^n
        (1 - epsilon)^n > 0
        geom_seq(1 - epsilon)(n) - 0 = (1 - epsilon)^n - 0
        (1 - epsilon)^n - 0 = (1 - epsilon)^n
        geom_seq(1 - epsilon)(n) - 0 = (1 - epsilon)^n
        abs(geom_seq(1 - epsilon)(n) - 0) = abs((1 - epsilon)^n)
        0 <= (1 - epsilon)^n
        abs((1 - epsilon)^n) = (1 - epsilon)^n
        abs(geom_seq(1 - epsilon)(n) - 0) = abs((1 - epsilon)^n) = (1 - epsilon)^n
        (1 - epsilon)^n = abs(geom_seq(1 - epsilon)(n) - 0) < x
        (1 - epsilon)^n < x = (a(n))^n
        release thm nth_root_sequence_term_positive(x, a, n)
        release thm nonnegative_power_lt_implies_lt(1 - epsilon, a(n), n)
    by def $is_eventually_above_threshold(a, 1 - epsilon, n0)
    witness exist n1 N+ st {$is_eventually_above_threshold(a, 1 - epsilon, n1)} from n0
thm nth_root_sequence_converges_to_one:
    ? forall x R+, a seq(R):
        $is_nth_root_sequence_for(x, a)
        =>:
            $has_limit(a, 1)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(a, 1, epsilon)
        release thm nth_root_sequence_eventually_below_one_plus_epsilon(x, a, epsilon)
        obtain n_upper from exist n_upper N+ st {$is_eventually_below_threshold(a, 1 + epsilon, n_upper)}
        epsilon < 1 or epsilon >= 1
        by cases:
            ? $has_eventual_closeness_to(a, 1, epsilon)
            case epsilon < 1:
                release thm nth_root_sequence_eventually_above_one_minus_small_epsilon(x, a, epsilon)
                obtain n_lower from exist n_lower N+ st {$is_eventually_above_threshold(a, 1 - epsilon, n_lower)}
                have root_tail_start N+ = n_upper + n_lower
                root_tail_start >= n_upper
                root_tail_start >= n_lower
                witness $has_eventual_closeness_to(a, 1, epsilon) from root_tail_start:
                    claim:
                        ? forall n N+:
                            n >= root_tail_start
                            =>:
                                abs(a(n) - 1) < epsilon
                        n_upper <= root_tail_start <= n
                        n_lower <= root_tail_start <= n
                        1 - epsilon < a(n) < 1 + epsilon
                        1 - a(n) < 1 - (1 - epsilon) = epsilon
                        a(n) - 1 < (1 + epsilon) - 1 = epsilon
                        a(n) - 1 $in R
                        a(n) - 1 >= 0 or a(n) - 1 < 0
                        by cases:
                            ? abs(a(n) - 1) < epsilon
                            case a(n) - 1 >= 0:
                                0 <= a(n) - 1
                                abs(a(n) - 1) = a(n) - 1 < epsilon
                            case a(n) - 1 < 0:
                                a(n) - 1 <= 0
                                abs(a(n) - 1) = -(a(n) - 1) = 1 - a(n) < epsilon
                    by def $is_tail_close_to(a, 1, epsilon, root_tail_start)
            case epsilon >= 1:
                witness $has_eventual_closeness_to(a, 1, epsilon) from n_upper:
                    claim:
                        ? forall n N+:
                            n >= n_upper
                            =>:
                                abs(a(n) - 1) < epsilon
                        by thm nth_root_sequence_term_positive(x, a, n) => a(n) > 0
                        a(n) < 1 + epsilon
                        1 - a(n) = 0 + (1 - a(n)) < a(n) + (1 - a(n)) = 1 <= epsilon
                        a(n) - 1 < (1 + epsilon) - 1 = epsilon
                        a(n) - 1 $in R
                        a(n) - 1 >= 0 or a(n) - 1 < 0
                        by cases:
                            ? abs(a(n) - 1) < epsilon
                            case a(n) - 1 >= 0:
                                0 <= a(n) - 1
                                abs(a(n) - 1) = a(n) - 1 < epsilon
                            case a(n) - 1 < 0:
                                a(n) - 1 <= 0
                                abs(a(n) - 1) = -(a(n) - 1) = 1 - a(n) < epsilon
                    by def $is_tail_close_to(a, 1, epsilon, n_upper)
    by def $has_limit(a, 1)
prop is_subsequence_index(phi fn(k N+) N+):
    forall k N+:
        k + 1 $in N+
        =>:
            phi(k) < phi(k + 1)
prop is_subsequence_along(a, b seq(R), phi fn(k N+) N+):
    $is_subsequence_index(phi)
    forall k N+:
        b(k) = a(phi(k))
prop has_subsequence(a, b seq(R)):
    exist phi fn(k N+) N+ st {$is_subsequence_along(a, b, phi)}
thm subsequence_witness_exists:
    ? forall a, b seq(R):
        $has_subsequence(a, b)
        =>:
            exist phi fn(k N+) N+ st {$is_subsequence_along(a, b, phi)}
    by def $has_subsequence(a, b)
have fn subsequence_even_index(k N+) N+ = 2 * k
claim:
    ? forall k N+:
        k + 1 $in N+
        =>:
            subsequence_even_index(k) < subsequence_even_index(k + 1)
    k < k + 1
    subsequence_even_index(k) = 2 * k
    subsequence_even_index(k + 1) = 2 * (k + 1)
    subsequence_even_index(k) = 2 * k < 2 * (k + 1) = subsequence_even_index(k + 1)
by def $is_subsequence_index(subsequence_even_index)
claim:
    ? forall positive_index N+:
        2 * (positive_index - 1) + 1 $in N+
    positive_index >= 1
    0 = 1 - 1 <= positive_index - 1
    positive_index - 1 $in N
    2 * (positive_index - 1) $in N
    2 * (positive_index - 1) + 1 $in N+
have fn subsequence_odd_index(k N+) N+ = 2 * (k - 1) + 1
forall k N+:
    k - 1 < k
    2 * (k - 1) + 1 < 2 * k + 1
    subsequence_odd_index(k) = 2 * (k - 1) + 1 < 2 * k + 1 = 2 * ((k + 1) - 1) + 1 = subsequence_odd_index(k + 1)
    subsequence_odd_index(k) < subsequence_odd_index(k + 1)
by def $is_subsequence_index(subsequence_odd_index)
have fn subsequence_even_terms(a seq(R)) fn(k N+) R = fn(i_index N+) R {a(subsequence_even_index(i_index))}
have fn subsequence_odd_terms(a seq(R)) fn(k N+) R = fn(i_index N+) R {a(subsequence_odd_index(i_index))}
thm even_terms_form_subsequence:
    ? forall a seq(R):
        $has_subsequence(a, subsequence_even_terms(a))
    by def $is_subsequence_along(a, subsequence_even_terms(a), subsequence_even_index)
    witness $has_subsequence(a, subsequence_even_terms(a)) from subsequence_even_index
thm odd_terms_form_subsequence:
    ? forall a seq(R):
        $has_subsequence(a, subsequence_odd_terms(a))
    by def $is_subsequence_along(a, subsequence_odd_terms(a), subsequence_odd_index)
    witness $has_subsequence(a, subsequence_odd_terms(a)) from subsequence_odd_index
have fn subsequence_identity_index(k N+) N+ = k
forall k N+:
    subsequence_identity_index(k) = k < k + 1 = subsequence_identity_index(k + 1)
    subsequence_identity_index(k) < subsequence_identity_index(k + 1)
by def $is_subsequence_index(subsequence_identity_index)
thm sequence_is_subsequence_of_itself:
    ? forall a seq(R):
        $has_subsequence(a, a)
    forall k N+:
        subsequence_identity_index(k) = k
        a(k) = a(subsequence_identity_index(k))
    by def $is_subsequence_along(a, a, subsequence_identity_index)
    witness $has_subsequence(a, a) from subsequence_identity_index
thm subsequence_index_strict_mono_add:
    ? forall phi fn(k N+) N+, i_index, h N+:
        $is_subsequence_index(phi)
        i_index + h $in N+
        =>:
            phi(i_index) < phi(i_index + h)
    by induc h from 1:
        ? phi(i_index) < phi(i_index + h)
        ? from h = 1:
            i_index + 1 $in N+
            phi(i_index) < phi(i_index + 1)
        ? induc:
            i_index + h $in N+
            i_index + h + 1 $in N+
            i_index + (h + 1) $in N+
            i_index + h + 1 = i_index + (h + 1)
            phi(i_index) < phi(i_index + h) < phi(i_index + h + 1) = phi(i_index + (h + 1))
thm subsequence_index_strict_mono:
    ? forall phi fn(k N+) N+, i_index, j N+:
        $is_subsequence_index(phi)
        i_index < j
        =>:
            phi(i_index) < phi(j)
    0 = i_index - i_index < j - i_index
    j - i_index $in N+
    have h N+ = j - i_index
    i_index + (j - i_index) = j
    i_index + h = i_index + (j - i_index) = j
    phi(i_index + h) = phi(j)
    release thm subsequence_index_strict_mono_add(phi, i_index, h)
thm subsequence_transitive:
    ? forall a, b, c seq(R):
        $has_subsequence(a, b)
        $has_subsequence(b, c)
        =>:
            $has_subsequence(a, c)
    obtain phi from $has_subsequence(a, b)
    obtain psi from $has_subsequence(b, c)
    have fn theta(k N+) N+ = phi(psi(k))
    claim:
        ? forall k N+:
            k + 1 $in N+
            =>:
                theta(k) < theta(k + 1)
        psi(k) < psi(k + 1)
        psi(k) $in N+
        psi(k + 1) $in N+
        by thm subsequence_index_strict_mono(phi, psi(k), psi(k + 1)) => phi(psi(k)) < phi(psi(k + 1))
        theta(k) = phi(psi(k))
        theta(k + 1) = phi(psi(k + 1))
        theta(k) = phi(psi(k)) < phi(psi(k + 1)) = theta(k + 1)
    by def $is_subsequence_index(theta)
    claim:
        ? forall k N+:
            c(k) = a(theta(k))
        theta(k) = phi(psi(k))
        a(theta(k)) = a(phi(psi(k)))
        c(k) = b(psi(k)) = a(phi(psi(k))) = a(theta(k))
    by def $is_subsequence_along(a, c, theta)
    witness $has_subsequence(a, c) from theta
thm subsequence_index_at_least_identity:
    ? forall phi fn(k N+) N+, k N+:
        $is_subsequence_index(phi)
        =>:
            phi(k) >= k
    by induc k from 1:
        ? phi(k) >= k
        ? from k = 1:
            phi(1) $in N+
            phi(1) >= 1
        ? induc:
            k + 1 $in N+
            phi(k) $in N+
            phi(k + 1) $in N+
            phi(k) >= k
            phi(k) < phi(k + 1)
            k + 1 <= phi(k) + 1 <= phi(k + 1)
thm subsequence_along_preserves_limit:
    ? forall a, b seq(R), phi fn(k N+) N+, L R:
        $is_subsequence_along(a, b, phi)
        $has_limit(a, L)
        =>:
            $has_limit(b, L)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(b, L, epsilon)
        $has_eventual_closeness_to(a, L, epsilon)
        obtain n0 from $has_eventual_closeness_to(a, L, epsilon)
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    abs(b(n) - L) < epsilon
            release thm subsequence_index_at_least_identity(phi, n)
            n0 <= n <= phi(n)
            abs(a(phi(n)) - L) < epsilon
            b(n) = a(phi(n))
            b(n) - L = a(phi(n)) - L
            abs(b(n) - L) = abs(a(phi(n)) - L)
        by def $is_tail_close_to(b, L, epsilon, n0)
        witness $has_eventual_closeness_to(b, L, epsilon) from n0
    by def $has_limit(b, L)
thm every_subsequence_of_convergent_sequence_converges:
    ? forall a seq(R), L R, b seq(R):
        $has_limit(a, L)
        $has_subsequence(a, b)
        =>:
            $has_limit(b, L)
    obtain phi from $has_subsequence(a, b)
    release thm subsequence_along_preserves_limit(a, b, phi, L)
thm sequence_converges_if_every_subsequence_converges:
    ? forall a seq(R), L R:
        forall b seq(R):
            $has_subsequence(a, b)
            =>:
                $has_limit(b, L)
        =>:
            $has_limit(a, L)
    release thm sequence_is_subsequence_of_itself(a)
thm convergent_subsequence_limit_is_limit_point:
    ? forall a, b seq(R), phi fn(k N+) N+, L R:
        $is_subsequence_along(a, b, phi)
        $has_limit(b, L)
        =>:
            $is_limit_point(a, L)
    claim:
        ? forall epsilon R+, n_tail N+:
            $is_epsilon_adherent_to_sequence(a, L, epsilon, n_tail)
        $has_eventual_closeness_to(b, L, epsilon)
        obtain k0 from $has_eventual_closeness_to(b, L, epsilon)
        have common_tail_index N+ = k0 + n_tail
        k0 <= common_tail_index
        n_tail <= common_tail_index
        release thm subsequence_index_at_least_identity(phi, common_tail_index)
        n_tail <= common_tail_index <= phi(common_tail_index)
        abs(b(common_tail_index) - L) < epsilon
        b(common_tail_index) = a(phi(common_tail_index))
        a(phi(common_tail_index)) - L = b(common_tail_index) - L
        abs(a(phi(common_tail_index)) - L) = abs(b(common_tail_index) - L) < epsilon
        witness $is_epsilon_adherent_to_sequence(a, L, epsilon, n_tail) from phi(common_tail_index)
    by def $is_limit_point(a, L)
thm limit_point_has_convergent_subsequence:
    ? forall a seq(R), L R:
        $is_limit_point(a, L)
        =>:
            exist b seq(R) st {$has_subsequence(a, b), $has_limit(b, L)}
    thm equal_set_member:
        ? forall A, B set, x A:
            A = B
            =>:
                x $in B
    have fn F(k N+, s N+) power_set(N+) = {n N+: n >= s and abs(a(n) - L) < 1 / k}
    release axiom_of_choice: set fn_range(F):
        claim:
            ? forall A fn_range(F):
                $is_nonempty_set(A)
            have by fn_preimage: k, s from A $in fn_range(F)
            A = F(k, s)
            0 < k
            0 = 0 / k < 1 / k
            1 / k $in R+
            $is_epsilon_adherent_to_sequence(a, L, 1 / k, s)
            obtain n from $is_epsilon_adherent_to_sequence(a, L, 1 / k, s)
            F(k, s) = {m N+: m >= s and abs(a(m) - L) < 1 / k}
            release thm set_builder_member(n, {m N+: m >= s and abs(a(m) - L) < 1 / k})
            n $in F(k, s)
            n $in A
            witness $is_nonempty_set(A) from n
    obtain choice_index from exist f fn(A fn_range(F)) family_union(fn_range(F)) st {$is_choice_function_for(fn_range(F), fn_range(F), fn(A fn_range(F)) fn_range(F) {A}, f)}
    claim:
        ? forall A fn_range(F):
            choice_index(A) $in A
            A $subset N+
            choice_index(A) $in N+
        fn(selected_set fn_range(F)) fn_range(F) {selected_set}(A) = A
        choice_index(A) $in fn(selected_set fn_range(F)) fn_range(F) {selected_set}(A)
        have by fn_preimage: k, s from A $in fn_range(F)
        A = F(k, s)
        F(k, s) $subset N+
        A $subset N+
        choice_index(A) $in A
        choice_index(A) $in N+
    have fn next_index(k N+, s N+) N+ = choice_index(F(k, s))
    claim:
        ? forall k N+, s N+:
            next_index(k, s) >= s
            abs(a(next_index(k, s)) - L) < 1 / k
        choice_index(F(k, s)) $in F(k, s)
        next_index(k, s) = choice_index(F(k, s))
        next_index(k, s) $in F(k, s)
        F(k, s) = {m N+: m >= s and abs(a(m) - L) < 1 / k}
        by thm equal_set_member(F(k, s), {m N+: m >= s and abs(a(m) - L) < 1 / k}, next_index(k, s)) => next_index(k, s) $in {m N+: m >= s and abs(a(m) - L) < 1 / k}
    claim:
        ? forall positive_index N+:
            positive_index = 1 or positive_index > 1
        by contra:
            ? positive_index = 1 or positive_index > 1
            positive_index != 1
            positive_index <= 1
            1 <= positive_index
            positive_index = 1
            impossible positive_index = 1
    claim:
        ? forall positive_index N+:
            positive_index > 1
            =>:
                positive_index - 1 $in N+
        0 = 1 - 1 < positive_index - 1
        positive_index - 1 $in Z
        positive_index - 1 $in N+
    have fn positive_successor(value N+) N+ = value + 1
    have fn phi(k N+) N+ by induc k from 1:
        case k = 1: next_index(1, 1)
        case k > 1: next_index(k, positive_successor(phi(k - 1)))
    have fn b(k N+) R = a(phi(k))
    claim:
        ? forall k N+:
            k + 1 $in N+
            =>:
                phi(k) < phi(k + 1)
        k + 1 > 1
        (k + 1) - 1 = k
        positive_successor(phi(k)) = phi(k) + 1
        phi(k + 1) = next_index(k + 1, positive_successor(phi((k + 1) - 1)))
        phi((k + 1) - 1) = phi(k)
        phi(k + 1) = next_index(k + 1, positive_successor(phi(k)))
        next_index(k + 1, positive_successor(phi(k))) >= positive_successor(phi(k))
        phi(k) < phi(k) + 1 = positive_successor(phi(k)) <= phi(k + 1)
    by def $is_subsequence_index(phi)
    by def $is_subsequence_along(a, b, phi)
    witness $has_subsequence(a, b) from phi
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(b, L, epsilon)
        release thm chap5::archimedean_property(epsilon)
        obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
        n0 >= 1
        n0 + 1 >= 1 + 1 = 2
        claim:
            ? $is_tail_close_to(b, L, epsilon, n0 + 1)
            claim:
                ? forall n N+:
                    n >= n0 + 1
                    =>:
                        abs(b(n) - L) < epsilon
                n >= n0 + 1 >= 2 > 1
                phi(n) = next_index(n, positive_successor(phi(n - 1)))
                positive_successor(phi(n - 1)) $in N+
                abs(a(next_index(n, positive_successor(phi(n - 1)))) - L) < 1 / n
                a(phi(n)) - L = a(next_index(n, positive_successor(phi(n - 1)))) - L
                abs(a(phi(n)) - L) = abs(a(next_index(n, positive_successor(phi(n - 1)))) - L) < 1 / n
                n0 <= n0 + 1 <= n
                release thm reciprocal_nat_order_reversing(n0, n)
                b(n) = a(phi(n))
                b(n) - L = a(phi(n)) - L
                abs(b(n) - L) = abs(a(phi(n)) - L) < 1 / n <= 1 / n0 < epsilon
            by def $is_tail_close_to(b, L, epsilon, n0 + 1)
        witness $has_eventual_closeness_to(b, L, epsilon) from n0 + 1
    by def $has_limit(b, L)
    witness exist b0 seq(R) st {$has_subsequence(a, b0), $has_limit(b0, L)} from b
thm convergent_subsequence_gives_limit_point:
    ? forall a, b seq(R), L R:
        $has_subsequence(a, b)
        $has_limit(b, L)
        =>:
            $is_limit_point(a, L)
    obtain phi from $has_subsequence(a, b)
    release thm convergent_subsequence_limit_is_limit_point(a, b, phi, L)
thm bolzano_weierstrass_convergent_subsequence:
    ? forall a seq(R):
        $is_bounded_sequence(a)
        =>:
            exist b seq(R) st {$has_subsequence(a, b), $is_convergent_sequence(b)}
    release thm bounded_sequence_has_finite_limsup(a)
    obtain Lplus from exist Lplus R st {$has_finite_limit_superior(a, Lplus)}
    release thm finite_limsup_is_limit_point(a, Lplus)
    release thm limit_point_has_convergent_subsequence(a, Lplus)
    obtain b from exist b seq(R) st {$has_subsequence(a, b), $has_limit(b, Lplus)}
    witness $is_convergent_sequence(b) from Lplus
    witness exist b0 seq(R) st {$has_subsequence(a, b0), $is_convergent_sequence(b0)} from b
have fn rational_power_approx_seq(x R+, q seq(R)) fn(k N+) R = fn(n N+) R {x^(q(n))}
prop is_rational_approximation_sequence(q seq(R), alpha R):
    forall n N+:
        q(n) $in Q
    $has_limit(q, alpha)
thm real_power_positive:
    ? forall x R+, q R:
        x^q $in R+
        x^q > 0
thm real_power_add_law:
    ? forall x R+, q, r R:
        x^(q + r) = x^q * x^r
    x = 1 or x != 1
    by cases:
        ? x^(q + r) = x^q * x^r
        case x = 1:
            x^(q + r) = 1^(q + r) = 1
            x^q = 1^q = 1
            x^r = 1^r = 1
            x^q * x^r = 1 * 1 = 1 = x^(q + r)
        case x != 1:
            0 < x
            x^q $in R+
            x^r $in R+
            0 < x^q * x^r
            x^q * x^r $in R+
            log(x, x^q) = q
            log(x, x^r) = r
            log(x, x^q * x^r) = log(x, x^q) + log(x, x^r) = q + r
            x^(q + r) = x^(log(x, x^q * x^r)) = x^q * x^r
thm real_power_power_law:
    ? forall x R+, q, r R:
        (x^q)^r = x^(q * r)
    x = 1 or x != 1
    by cases:
        ? (x^q)^r = x^(q * r)
        case x = 1:
            x^q = 1^q = 1
            x^(q * r) = 1^(q * r) = 1
            (x^q)^r = 1^r = 1 = x^(q * r)
        case x != 1:
            0 < x
            x^q $in R+
            (x^q)^r $in R+
            log(x, x^q) = q
            log(x, (x^q)^r) = r * log(x, x^q) = r * q = q * r
            x^(q * r) = x^(log(x, (x^q)^r)) = (x^q)^r
thm real_power_neg_law:
    ? forall x R+, q R:
        x^q != 0
        =>:
            x^(-q) = 1 / x^q
    release thm real_power_positive(x, q)
    x^q * x^(-q) = x^(q + (-q)) = x^0 = 1
thm real_power_base_strict_mono:
    ? forall x, y R+, q R:
        q > 0
        x > y
        =>:
            x^q > y^q
    0 < x
    0 < y
    release thm real_power_positive(x, q)
    release thm real_power_positive(y, q)
    0 < x^q
    0 < y^q
    1 < 2
    y < x
    log(2, y) < log(2, x)
    q * log(2, y) < q * log(2, x)
    log(2, y^q) = q * log(2, y)
    log(2, x^q) = q * log(2, x)
    log(2, y^q) < log(2, x^q)
    by contra:
        ? x^q > y^q
        x^q <= y^q
        log(2, x^q) <= log(2, y^q)
        impossible log(2, y^q) < log(2, x^q)
thm real_positive_base_power_above_one:
    ? forall x R+, s R:
        x > 1
        s > 0
        =>:
            x^s > 1
    release thm real_power_base_strict_mono(x, 1, s)
    1^s = 1
thm real_positive_base_power_below_one:
    ? forall x R+, s R:
        x < 1
        s > 0
        =>:
            x^s < 1
    release thm real_power_base_strict_mono(1, x, s)
    1^s = 1
thm real_power_exponent_strict_mono_above_one:
    ? forall x R+, q, r R:
        x > 1
        q > r
        =>:
            x^q > x^r
    release thm real_positive_base_power_above_one(x, q - r)
    release thm real_power_positive(x, r)
    release thm real_power_positive(x, q - r)
    0 < x^r
    1 < x^(q - r)
    x^r * x^(q - r) > x^r * 1 = x^r
    q = r + (q - r)
    x^q = x^(r + (q - r)) = x^r * x^(q - r) > x^r
thm real_power_exponent_strict_antimono_below_one:
    ? forall x R+, q, r R:
        x < 1
        q > r
        =>:
            x^q < x^r
    release thm real_positive_base_power_below_one(x, q - r)
    release thm real_power_positive(x, r)
    release thm real_power_positive(x, q - r)
    0 < x^r
    x^r * x^(q - r) < x^r * 1 = x^r
    q = r + (q - r)
    x^q = x^(r + (q - r)) = x^r * x^(q - r) < x^r
thm positive_increment_bernoulli:
    ? forall u R+, n N:
        (1 + u)^n >= 1 + n * u
    by induc n from 0:
        ? (1 + u)^n >= 1 + n * u
        ? from n = 0:
            (1 + u)^0 = 1 = 1 + 0 * u
        ? induc:
            1 + u > 0
            n >= 0
            n * u >= 0
            u^2 >= 0
            n * u^2 >= 0
            (1 + u)^(n + 1) = (1 + u)^n * (1 + u)
            (1 + u)^n * (1 + u) >= (1 + n * u) * (1 + u) = 1 + (n + 1) * u + n * u^2 >= 1 + (n + 1) * u
thm positive_base_small_root_upper_bound:
    ? forall x R+, eta R+, N0 N+:
        x + 1 != 0
        1 / N0 < eta / (x + 1)
        =>:
            x^(1 / N0) < 1 + eta
    thm multiply_strict_real_bound:
        ? forall left, right R, factor R+:
            left < right
            =>:
                left * factor < right * factor
    N0 > 0
    x + 1 > 0
    x + 1 $in R+
    release thm multiply_strict_real_bound(1 / N0, eta / (x + 1), x + 1)
    (1 / N0) * (x + 1) < (eta / (x + 1)) * (x + 1) = eta
    release thm multiply_strict_real_bound((1 / N0) * (x + 1), eta, N0)
    ((1 / N0) * (x + 1)) * N0 = x + 1
    eta * N0 = N0 * eta
    x + 1 < N0 * eta
    x < x + 1 < N0 * eta < N0 * eta + 1 = 1 + N0 * eta
    release thm positive_increment_bernoulli(eta, N0)
    (1 + eta)^N0 >= 1 + N0 * eta > x
    release thm real_power_power_law(x, 1 / N0, N0)
    (1 / N0) * N0 = 1
    (x^(1 / N0))^N0 = x^((1 / N0) * N0) = x^1 = x
    x^(1 / N0) >= 0
    x = (x^(1 / N0))^N0
    (x^(1 / N0))^N0 < (1 + eta)^N0
    release thm nonnegative_power_lt_implies_lt(x^(1 / N0), 1 + eta, N0)
thm positive_base_small_exponent_envelope:
    ? forall x R+, eta R+, N0 N+, t R:
        x > 1
        x^(1 / N0) < 1 + eta
        abs(t) < 1 / N0
        =>:
            1 - eta < x^t
            x^t < 1 + eta
    thm negate_weak_real_bound:
        ? forall left, right R:
            left <= right
            =>:
                -right <= -left
    thm negate_strict_real_bound:
        ? forall left, right R:
            left < right
            =>:
                -right < -left
    thm reciprocal_strict_real_order:
        ? forall left, right R+:
            left < right
            =>:
                1 / right < 1 / left
        right - left > 0
        left * right > 0
        (right - left) / (left * right) > 0
        1 / left - 1 / right = (right - left) / (left * right) > 0
        1 / right < 1 / right + (1 / left - 1 / right) = 1 / left
    thm divide_strict_real_bound:
        ? forall lower, upper R, factor R+:
            lower * factor < upper
            =>:
                lower < upper / factor
        upper - lower * factor > 0
        (upper - lower * factor) / factor > 0
        upper / factor - lower = (upper - lower * factor) / factor > 0
        lower < lower + (upper / factor - lower) = upper / factor
    thm subtract_positive_real_increment:
        ? forall value R, increment R+:
            value - increment < value
        increment > 0
        value - increment + increment = value
        value - increment < value - increment + increment = value
    1 / N0 > 0
    t <= abs(t)
    -t <= abs(-t) = abs(t)
    release thm negate_weak_real_bound(-t, abs(t))
    -abs(t) <= -(-t) = t
    release thm negate_strict_real_bound(abs(t), 1 / N0)
    -(1 / N0) < -abs(t) <= t
    t <= abs(t) < 1 / N0
    release thm real_power_exponent_strict_mono_above_one(x, 1 / N0, t)
    x^t < x^(1 / N0) < 1 + eta
    release thm real_power_exponent_strict_mono_above_one(x, t, -(1 / N0))
    x^(1 / N0) $in R+
    x^(1 / N0) > 0
    x^(1 / N0) != 0
    release thm real_power_neg_law(x, 1 / N0)
    1 + eta > 0
    1 + eta != 0
    1 + eta $in R+
    release thm reciprocal_strict_real_order(x^(1 / N0), 1 + eta)
    1 / (1 + eta) < 1 / x^(1 / N0)
    eta^2 > 0
    eta^2 $in R+
    release thm subtract_positive_real_increment(1, eta^2)
    (1 - eta) * (1 + eta) = 1 - eta^2 < 1
    release thm divide_strict_real_bound(1 - eta, 1, 1 + eta)
    1 - eta < 1 / (1 + eta)
    1 - eta < 1 / (1 + eta) < 1 / x^(1 / N0) = x^(-(1 / N0)) < x^t
thm strict_unit_interval_controls_distance:
    ? forall value R, eta R+:
        1 - eta < value
        value < 1 + eta
        =>:
            abs(value - 1) < eta
    value >= 1 or value < 1
    by cases:
        ? abs(value - 1) < eta
        case value >= 1:
            value - 1 >= 0
            abs(value - 1) = value - 1
            value - 1 < (1 + eta) - 1 = eta
        case value < 1:
            value - 1 < 0
            abs(value - 1) = -(value - 1) = 1 - value
            1 - value < 1 - (1 - eta) = eta
thm positive_base_small_root_index_exists:
    ? forall x R+, eta R+:
        exist N0 N+ st {x^(1 / N0) < 1 + eta}
    x + 1 > 0
    x + 1 != 0
    x + 1 $in R+
    eta / (x + 1) $in R+
    exist N0 N+ st {1 / N0 < eta / (x + 1)}
    obtain N0 from exist N0 N+ st {1 / N0 < eta / (x + 1)}
    release thm positive_base_small_root_upper_bound(x, eta, N0)
    witness exist N1 N+ st {x^(1 / N1) < 1 + eta} from N0
thm positive_base_power_difference_factor:
    ? forall x R+, q, r R:
        x^q - x^r = x^r * (x^(q - r) - 1)
    release thm real_power_add_law(x, r, q - r)
    r + (q - r) = q
    x^q = x^(r + (q - r)) = x^r * x^(q - r)
    x^q - x^r = x^r * x^(q - r) - x^r = x^r * (x^(q - r) - 1)
thm positive_factor_controls_error:
    ? forall factor R+, error R, eta R+, epsilon R+:
        abs(error) < eta
        factor * eta < epsilon
        =>:
            abs(factor * error) < epsilon
    factor > 0
    abs(factor) = factor
    abs(factor * error) = abs(factor) * abs(error) = factor * abs(error)
    factor * abs(error) < factor * eta < epsilon
thm above_one_power_preserves_sequence_limit:
    ? forall x R+, a seq(R), L R:
        x > 1
        $has_limit(a, L)
        =>:
            $has_limit(fn(n N+) R {x^(a(n))}, x^L)
    thm equal_real_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(fn(n N+) R {x^(a(n))}, x^L, epsilon)
        release thm real_power_positive(x, L)
        x^L > 0
        2 * x^L > 0
        2 * x^L != 0
        have eta R+ = epsilon / (2 * x^L)
        eta = epsilon / (2 * x^L)
        x^L * eta = x^L * (epsilon / (2 * x^L)) = epsilon / 2
        epsilon / 2 < epsilon
        x^L * eta < epsilon
        release thm positive_base_small_root_index_exists(x, eta)
        obtain N0 from exist N0 N+ st {x^(1 / N0) < 1 + eta}
        1 / N0 > 0
        1 / N0 $in R+
        $has_eventual_closeness_to(a, L, 1 / N0)
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, 1 / N0, n0)}
        witness $has_eventual_closeness_to(fn(n N+) R {x^(a(n))}, x^L, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs((fn(j N+) R {x^(a(j))})(n) - x^L) < epsilon
                abs(a(n) - L) < 1 / N0
                release thm positive_base_small_exponent_envelope(x, eta, N0, a(n) - L)
                release thm strict_unit_interval_controls_distance(x^(a(n) - L), eta)
                release thm positive_base_power_difference_factor(x, a(n), L)
                release thm positive_factor_controls_error(x^L, x^(a(n) - L) - 1, eta, epsilon)
                abs(x^(a(n)) - x^L) = abs(x^L * (x^(a(n) - L) - 1)) < epsilon
                (fn(j N+) R {x^(a(j))})(n) = x^(a(n))
                release thm equal_real_values_have_equal_distance((fn(j N+) R {x^(a(j))})(n), x^(a(n)), x^L)
                abs((fn(j N+) R {x^(a(j))})(n) - x^L) = abs(x^(a(n)) - x^L) < epsilon
            by def $is_tail_close_to(fn(n N+) R {x^(a(n))}, x^L, epsilon, n0)
    by def $has_limit(fn(n N+) R {x^(a(n))}, x^L)
thm reciprocal_base_negated_exponent_power:
    ? forall x R+, t R:
        (1 / x)^(-t) = x^t
    x > 0
    x != 0
    1 / x $in R+
    x^(-1) = 1 / x
    release thm real_power_power_law(x, -1, -t)
    (-1) * (-t) = t
    (1 / x)^(-t) = (x^(-1))^(-t) = x^((-1) * (-t)) = x^t
thm positive_reciprocal_strict_order:
    ? forall left, right R+:
        left < right
        =>:
            1 / right < 1 / left
    right - left > 0
    left * right > 0
    (right - left) / (left * right) > 0
    1 / left - 1 / right = (right - left) / (left * right) > 0
    1 / right < 1 / right + (1 / left - 1 / right) = 1 / left
thm below_one_power_preserves_sequence_limit:
    ? forall x R+, a seq(R), L R:
        x < 1
        $has_limit(a, L)
        =>:
            $has_limit(fn(n N+) R {x^(a(n))}, x^L)
    x > 0
    x != 0
    1 / x $in R+
    release thm positive_reciprocal_strict_order(x, 1)
    1 = 1 / 1 < 1 / x
    1 / x > 1
    thm equal_real_values_have_equal_distance:
        ? forall left, right, center R:
            left = right
            =>:
                abs(left - center) = abs(right - center)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(fn(n N+) R {x^(a(n))}, x^L, epsilon)
        release thm real_power_positive(x, L)
        x^L > 0
        2 * x^L > 0
        2 * x^L != 0
        have eta R+ = epsilon / (2 * x^L)
        eta = epsilon / (2 * x^L)
        x^L * eta = x^L * (epsilon / (2 * x^L)) = epsilon / 2
        epsilon / 2 < epsilon
        x^L * eta < epsilon
        release thm positive_base_small_root_index_exists(1 / x, eta)
        obtain N0 from exist N0 N+ st {(1 / x)^(1 / N0) < 1 + eta}
        1 / N0 > 0
        1 / N0 $in R+
        $has_eventual_closeness_to(a, L, 1 / N0)
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, 1 / N0, n0)}
        witness $has_eventual_closeness_to(fn(n N+) R {x^(a(n))}, x^L, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs((fn(j N+) R {x^(a(j))})(n) - x^L) < epsilon
                abs(a(n) - L) < 1 / N0
                abs(L - a(n)) = abs(-(a(n) - L)) = abs(a(n) - L) < 1 / N0
                release thm positive_base_small_exponent_envelope(1 / x, eta, N0, L - a(n))
                release thm reciprocal_base_negated_exponent_power(x, a(n) - L)
                L - a(n) = -(a(n) - L)
                (1 / x)^(L - a(n)) = (1 / x)^(-(a(n) - L)) = x^(a(n) - L)
                release thm strict_unit_interval_controls_distance((1 / x)^(L - a(n)), eta)
                release thm equal_real_values_have_equal_distance((1 / x)^(L - a(n)), x^(a(n) - L), 1)
                abs(x^(a(n) - L) - 1) = abs((1 / x)^(L - a(n)) - 1) < eta
                release thm positive_base_power_difference_factor(x, a(n), L)
                release thm positive_factor_controls_error(x^L, x^(a(n) - L) - 1, eta, epsilon)
                abs(x^(a(n)) - x^L) = abs(x^L * (x^(a(n) - L) - 1)) < epsilon
                (fn(j N+) R {x^(a(j))})(n) = x^(a(n))
                release thm equal_real_values_have_equal_distance((fn(j N+) R {x^(a(j))})(n), x^(a(n)), x^L)
                abs((fn(j N+) R {x^(a(j))})(n) - x^L) = abs(x^(a(n)) - x^L) < epsilon
            by def $is_tail_close_to(fn(n N+) R {x^(a(n))}, x^L, epsilon, n0)
    by def $has_limit(fn(n N+) R {x^(a(n))}, x^L)
thm pointwise_constant_sequence_has_limit:
    ? forall b seq(R), c R:
        forall n N+:
            b(n) = c
        =>:
            $has_limit(b, c)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(b, c, epsilon)
        witness $has_eventual_closeness_to(b, c, epsilon) from 1:
            claim:
                ? forall n N+:
                    n >= 1
                    =>:
                        abs(b(n) - c) < epsilon
                b(n) = c
                b(n) - c = 0
                abs(b(n) - c) = abs(0) = 0 < epsilon
            by def $is_tail_close_to(b, c, epsilon, 1)
    by def $has_limit(b, c)
thm positive_base_power_preserves_sequence_limit:
    ? forall x R+, a seq(R), L R:
        $has_limit(a, L)
        =>:
            $has_limit(fn(n N+) R {x^(a(n))}, x^L)
    x < 1 or x = 1 or x > 1
    by cases:
        ? $has_limit(fn(n N+) R {x^(a(n))}, x^L)
        case x < 1:
            release thm below_one_power_preserves_sequence_limit(x, a, L)
        case x = 1:
            x^L = 1^L = 1
            claim:
                ? forall n N+:
                    (fn(j N+) R {x^(a(j))})(n) = x^L
                (fn(j N+) R {x^(a(j))})(n) = x^(a(n)) = 1^(a(n)) = 1 = x^L
            release thm pointwise_constant_sequence_has_limit(fn(n N+) R {x^(a(n))}, x^L)
        case x > 1:
            release thm above_one_power_preserves_sequence_limit(x, a, L)
thm rational_power_approx_seq_has_limit:
    ? forall x R+, alpha R, q seq(R):
        $is_rational_approximation_sequence(q, alpha)
        =>:
            $has_limit(rational_power_approx_seq(x, q), x^alpha)
    release thm positive_base_power_preserves_sequence_limit(x, q, alpha)
    rational_power_approx_seq(x, q) = fn(n N+) R {x^(q(n))}
thm rational_approximation_power_limits_agree:
    ? forall x R+, alpha R, q, r seq(R), Lq, Lr R:
        $is_rational_approximation_sequence(q, alpha)
        $is_rational_approximation_sequence(r, alpha)
        $has_limit(rational_power_approx_seq(x, q), Lq)
        $has_limit(rational_power_approx_seq(x, r), Lr)
        =>:
            Lq = Lr
    release thm rational_power_approx_seq_has_limit(x, alpha, q)
    release thm rational_power_approx_seq_has_limit(x, alpha, r)
    release thm sequence_limit_unique(rational_power_approx_seq(x, q), Lq, x^alpha)
    release thm sequence_limit_unique(rational_power_approx_seq(x, r), Lr, x^alpha)
thm rational_approximation_sequence_exists:
    ? forall alpha R:
        exist q seq(R) st {$is_rational_approximation_sequence(q, alpha)}
    release thm chap5::cauchy_sequence_representative_in_Q_exists(alpha)
    obtain a from exist a seq(Q) st {$chap5::is_cauchy_sequence_in_Q(a), $chap5::has_formal_limit_in_Q(a, alpha)}
    have fn q(n N+) R = a(n)
    claim:
        ? forall n N+:
            q(n) $in Q
        q(n) = a(n)
        a(n) $in Q
        q(n) $in Q
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(q, alpha, epsilon)
        $chap5::has_rational_sequence_limit_in_R(a, alpha)
        obtain n0 from exist n0 N+ st {$chap5::is_rational_sequence_tail_close_to_real(a, alpha, epsilon, n0)}
        claim:
            ? $is_tail_close_to(q, alpha, epsilon, n0)
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        abs(q(n) - alpha) < epsilon
                q(n) = a(n)
                q(n) - alpha = a(n) - alpha
                abs(q(n) - alpha) = abs(a(n) - alpha) < epsilon
            by def $is_tail_close_to(q, alpha, epsilon, n0)
        witness $has_eventual_closeness_to(q, alpha, epsilon) from n0
    by def $has_limit(q, alpha)
    by def $is_rational_approximation_sequence(q, alpha)
    witness exist q0 seq(R) st {$is_rational_approximation_sequence(q0, alpha)} from q
thm real_power_is_rational_approximation_limit:
    ? forall x R+, alpha R, q seq(R):
        $is_rational_approximation_sequence(q, alpha)
        =>:
            $has_limit(rational_power_approx_seq(x, q), x^alpha)
    release thm rational_power_approx_seq_has_limit(x, alpha, q)
thm real_power_agrees_with_rational_power:
    ? forall x R+, q Q:
        $has_limit(rational_power_approx_seq(x, fn(n N+) R {q}), x^q)
    release thm constant_sequence_has_limit(q)
    by def $is_rational_approximation_sequence(fn(n N+) R {q}, q)
    release thm rational_power_approx_seq_has_limit(x, q, fn(n N+) R {q})
