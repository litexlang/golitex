thm positive_real_power_add_law:
    ? forall x R+, q, r R:
        x^(q + r) = x^q * x^r
    x = 1 or x != 1
    by cases:
        ? x^(q + r) = x^q * x^r
        case x = 1:
            x^(q + r) = 1^(q + r) = 1
            x^q = 1^q = 1
            x^r = 1^r = 1
            x^q * x^r = 1 * 1 = 1 = x^(q + r)
        case x != 1:
            0 < x
            x^q $in R+
            x^r $in R+
            0 < x^q * x^r
            x^q * x^r $in R+
            log(x, x^q) = q
            log(x, x^r) = r
            log(x, x^q * x^r) = log(x, x^q) + log(x, x^r) = q + r
            x^(q + r) = x^(log(x, x^q * x^r)) = x^q * x^r
thm positive_real_power_power_law:
    ? forall x R+, q, r R:
        (x^q)^r = x^(q * r)
    x = 1 or x != 1
    by cases:
        ? (x^q)^r = x^(q * r)
        case x = 1:
            x^q = 1^q = 1
            x^(q * r) = 1^(q * r) = 1
            (x^q)^r = 1^r = 1 = x^(q * r)
        case x != 1:
            x^q $in R+
            (x^q)^r $in R+
            log(x, x^q) = q
            log(x, (x^q)^r) = r * log(x, x^q) = r * q = q * r
            x^(q * r) = x^(log(x, (x^q)^r)) = (x^q)^r
