# Chapter 05 real numbers
# Selected Analysis I development; scope and assumptions: STATUS.md.

forall s set:
    seq(s) = fn(x N+) s
forall a seq(Q), n N+:
    a(n) $in Q
forall a seq(R), n N+:
    a(n) $in R
sketch:
    have fn reciprocal_rational_sequence(n N+) Q = 1 / n
    have fn square_real_sequence(n N+) R = n^2
    have fn constant_rational_sequence(n N+) Q = 3
    reciprocal_rational_sequence(1) = 1
    square_real_sequence(2) = 4
    constant_rational_sequence(1) = 3
    constant_rational_sequence(2) = 3
    reciprocal_rational_sequence $in seq(Q)
    square_real_sequence $in seq(R)
    constant_rational_sequence $in seq(Q)
sketch:
    have fn squares_from_zero(n N: n >= 0) N = n^2
    have fn constant_three_from_zero(n N: n >= 0) N = 3
    squares_from_zero(0) = 0
    squares_from_zero(1) = 1
    squares_from_zero(2) = 4
    constant_three_from_zero(0) = 3
    constant_three_from_zero(2) = 3
    have fn squares_from_three(n N+: n >= 3) N = n^2
    squares_from_three(3) = 9
    4 >= 3
    squares_from_three(4) = 16
    5 >= 3
    squares_from_three(5) = 25
    squares_from_three $in fn(x N+: x >= 3) N
template<s set, m N+>:
    have seq_starting_at set = fn(x N+: x >= m) s
sketch:
    have fn square_from_3_again(n N+: n >= 3) N = n^2
    square_from_3_again(3) = 9
    \seq_starting_at<N, 3> = fn(x N+: x >= 3) N
    square_from_3_again $in fn(x N+: x >= 3) N
prop is_epsilon_steady_in_Q(a seq(Q), epsilon Q+):
    forall j, k N+:
        $chap4::is_close_in_Q(epsilon, a(j), a(k))
release obj def chap4::dist_Q
sketch:
    claim:
        ? forall c Q, epsilon Q+:
            $is_epsilon_steady_in_Q(fn(n N+) Q {c}, epsilon)
        claim:
            ? forall j, k N+:
                $chap4::is_close_in_Q(epsilon, fn(n N+) Q {c}(j), fn(n N+) Q {c}(k))
            fn(n N+) Q {c}(j) = c
            fn(n N+) Q {c}(k) = c
            c - c = 0
            chap4::dist_Q(c, c) = abs(c - c) = abs(0) = 0 <= epsilon
            by def $chap4::is_close_in_Q(epsilon, c, c)
        by def $is_epsilon_steady_in_Q(fn(n N+) Q {c}, epsilon)
prop is_tail_epsilon_steady_in_Q(a seq(Q), epsilon Q+, n0 N+):
    forall j, k N+:
        j >= n0
        k >= n0
        =>:
            $chap4::is_close_in_Q(epsilon, a(j), a(k))
prop has_eventual_epsilon_steadiness_in_Q(a seq(Q), epsilon Q+):
    exist n0 N+ st {$is_tail_epsilon_steady_in_Q(a, epsilon, n0)}
prop is_cauchy_sequence_in_Q(a seq(Q)):
    forall epsilon Q+:
        $has_eventual_epsilon_steadiness_in_Q(a, epsilon)
thm archimedean_property:
    ? forall epsilon R+:
        exist n N+ st {1 / n < epsilon}
thm reciprocal_rational_sequence_tail_terms_are_close:
    ? forall epsilon Q+, n0, j, k N+:
        1 / n0 < epsilon / 2
        j >= n0
        k >= n0
        =>:
            $chap4::is_close_in_Q(epsilon, fn(n N+) Q {1 / n}(j), fn(n N+) Q {1 / n}(k))
    n0 <= j
    n0 <= k
    0 < n0 * j
    0 < n0 * k
    1 / j = n0 / (n0 * j) <= j / (n0 * j) = 1 / n0 < epsilon / 2
    1 / k = n0 / (n0 * k) <= k / (n0 * k) = 1 / n0 < epsilon / 2
    1 / j <= epsilon / 2
    1 / k <= epsilon / 2
    0 <= 1 / j
    0 <= 1 / k
    abs(1 / j) = 1 / j
    abs(-(1 / k)) = abs(1 / k) = 1 / k
    1 / j - 1 / k = 1 / j + (-(1 / k))
    abs(1 / j - 1 / k) = abs(1 / j + (-(1 / k))) <= abs(1 / j) + abs(-(1 / k)) = 1 / j + 1 / k <= epsilon / 2 + epsilon / 2 = epsilon
    fn(n N+) Q {1 / n}(j) = 1 / j
    fn(n N+) Q {1 / n}(k) = 1 / k
    chap4::dist_Q(1 / j, 1 / k) = abs(1 / j - 1 / k) <= epsilon
    by def $chap4::is_close_in_Q(epsilon, 1 / j, 1 / k)
claim:
    ? forall epsilon Q+:
        $has_eventual_epsilon_steadiness_in_Q(fn(n N+) Q {1 / n}, epsilon)
    0 < epsilon
    0 = 0 / 2 < epsilon / 2
    epsilon / 2 $in R+
    release thm archimedean_property(epsilon / 2)
    obtain n0 from exist n0 N+ st {1 / n0 < epsilon / 2}
    witness $has_eventual_epsilon_steadiness_in_Q(fn(n N+) Q {1 / n}, epsilon) from n0:
        forall j, k N+:
            j >= n0
            k >= n0
            =>:
                $chap4::is_close_in_Q(epsilon, fn(n N+) Q {1 / n}(j), fn(n N+) Q {1 / n}(k))
        by def $is_tail_epsilon_steady_in_Q(fn(n N+) Q {1 / n}, epsilon, n0)
by def $is_cauchy_sequence_in_Q(fn(n N+) Q {1 / n})
prop is_bounded_by_in_Q(a seq(Q), M Q):
    M >= 0
    forall i_index N+:
        abs(a(i_index)) <= M
prop is_bounded_sequence_in_Q(a seq(Q)):
    exist M Q st {$is_bounded_by_in_Q(a, M)}
prop is_finite_prefix_bounded_in_Q(a seq(Q), n N+, M Q):
    M >= 0
    forall i_index N+:
        i_index <= n
        =>:
            abs(a(i_index)) <= M
claim:
    ? forall n N:
        n = 0 or n >= 1 and n $in N+
    by cases:
        ? n = 0 or n >= 1 and n $in N+
        case n < 0:
            impossible n < 0
        case n = 0:
            n = 0 or n >= 1 and n $in N+
        case n > 0:
            n $in N+
            n >= 1
have fn prefix_bound_Q(a seq(Q), n N) Q by induc n from 0:
    case n = 0: abs(a(1))
    case n >= 1 and n $in N+:
        case prefix_bound_Q(a, n - 1) >= abs(a(n)): prefix_bound_Q(a, n - 1)
        case prefix_bound_Q(a, n - 1) < abs(a(n)): abs(a(n))
claim:
    ? forall a seq(Q), n N+:
        $is_finite_prefix_bounded_in_Q(a, n, prefix_bound_Q(a, n))
    by induc n from 1:
        ? $is_finite_prefix_bounded_in_Q(a, n, prefix_bound_Q(a, n))
        ? from n = 1:
            prefix_bound_Q(a, 0) = abs(a(1))
            prefix_bound_Q(a, 0) >= abs(a(1))
            1 >= 1
            1 $in N+
            1 - 1 = 0
            prefix_bound_Q(a, 1 - 1) = prefix_bound_Q(a, 0)
            prefix_bound_Q(a, 1 - 1) >= abs(a(1))
            prefix_bound_Q(a, 1) = prefix_bound_Q(a, 1 - 1) = prefix_bound_Q(a, 0) = abs(a(1))
            forall i_index N+:
                i_index <= 1
                =>:
                    i_index >= 1
                    i_index = 1
                    abs(a(i_index)) = abs(a(1)) = prefix_bound_Q(a, 1)
                    abs(a(i_index)) <= prefix_bound_Q(a, 1)
            0 <= abs(a(1)) = prefix_bound_Q(a, 1)
            prefix_bound_Q(a, 1) >= 0
            by def $is_finite_prefix_bounded_in_Q(a, 1, prefix_bound_Q(a, 1))
        ? induc:
            n + 1 >= 1
            n + 1 $in N+
            n + 1 - 1 = n
            prefix_bound_Q(a, n + 1 - 1) = prefix_bound_Q(a, n)
            by cases:
                ? prefix_bound_Q(a, n) <= prefix_bound_Q(a, n + 1) and abs(a(n + 1)) <= prefix_bound_Q(a, n + 1)
                case prefix_bound_Q(a, n) >= abs(a(n + 1)):
                    prefix_bound_Q(a, n + 1 - 1) >= abs(a(n + 1))
                    prefix_bound_Q(a, n + 1) = prefix_bound_Q(a, n + 1 - 1) = prefix_bound_Q(a, n)
                case prefix_bound_Q(a, n) < abs(a(n + 1)):
                    prefix_bound_Q(a, n + 1 - 1) < abs(a(n + 1))
                    prefix_bound_Q(a, n + 1) = abs(a(n + 1))
            0 <= prefix_bound_Q(a, n) <= prefix_bound_Q(a, n + 1)
            claim:
                ? forall i_index N+:
                    i_index <= n + 1
                    =>:
                        abs(a(i_index)) <= prefix_bound_Q(a, n + 1)
                i_index <= n or i_index >= n + 1
                by cases:
                    ? abs(a(i_index)) <= prefix_bound_Q(a, n + 1)
                    case i_index <= n:
                        abs(a(i_index)) <= prefix_bound_Q(a, n) <= prefix_bound_Q(a, n + 1)
                    case i_index >= n + 1:
                        i_index = n + 1
                        abs(a(i_index)) = abs(a(n + 1)) <= prefix_bound_Q(a, n + 1)
            by def $is_finite_prefix_bounded_in_Q(a, n + 1, prefix_bound_Q(a, n + 1))
claim:
    ? forall a seq(Q):
        $is_cauchy_sequence_in_Q(a)
        =>:
            $is_bounded_sequence_in_Q(a)
    $has_eventual_epsilon_steadiness_in_Q(a, 1)
    obtain n0 from $has_eventual_epsilon_steadiness_in_Q(a, 1)
    $is_finite_prefix_bounded_in_Q(a, n0, prefix_bound_Q(a, n0))
    0 <= abs(a(n0))
    0 <= prefix_bound_Q(a, n0)
    0 <= abs(a(n0)) + 1
    claim:
        ? forall i_index N+:
            abs(a(i_index)) <= prefix_bound_Q(a, n0) + abs(a(n0)) + 1
        i_index <= n0 or i_index >= n0 + 1
        by cases:
            ? abs(a(i_index)) <= prefix_bound_Q(a, n0) + abs(a(n0)) + 1
            case i_index <= n0:
                abs(a(i_index)) <= prefix_bound_Q(a, n0) <= prefix_bound_Q(a, n0) + abs(a(n0)) + 1
            case i_index >= n0 + 1:
                i_index >= n0 + 1 > n0
                i_index >= n0
                n0 >= n0
                $chap4::is_close_in_Q(1, a(i_index), a(n0))
                chap4::dist_Q(a(i_index), a(n0)) <= 1
                release thm chap4::rational_distance_formula(a(i_index), a(n0))
                chap4::dist_Q(a(i_index), a(n0)) = abs(a(i_index) - a(n0)) <= 1
                a(i_index) = (a(i_index) - a(n0)) + a(n0)
                abs(a(i_index)) = abs((a(i_index) - a(n0)) + a(n0)) <= abs(a(i_index) - a(n0)) + abs(a(n0))
                abs(a(i_index) - a(n0)) + abs(a(n0)) <= 1 + abs(a(n0))
                1 + abs(a(n0)) <= prefix_bound_Q(a, n0) + (1 + abs(a(n0))) = prefix_bound_Q(a, n0) + abs(a(n0)) + 1
                abs(a(i_index)) <= abs(a(i_index) - a(n0)) + abs(a(n0)) <= 1 + abs(a(n0)) <= prefix_bound_Q(a, n0) + abs(a(n0)) + 1
    a(n0) $in Q
    abs(a(n0)) $in Q
    prefix_bound_Q(a, n0) $in Q
    prefix_bound_Q(a, n0) + abs(a(n0)) $in Q
    prefix_bound_Q(a, n0) + abs(a(n0)) + 1 $in Q
    witness $is_bounded_sequence_in_Q(a) from prefix_bound_Q(a, n0) + abs(a(n0)) + 1:
        prefix_bound_Q(a, n0) >= 0
        abs(a(n0)) >= 0
        prefix_bound_Q(a, n0) + abs(a(n0)) + 1 >= 0
        by def $is_bounded_by_in_Q(a, prefix_bound_Q(a, n0) + abs(a(n0)) + 1)
prop is_sequence_close_in_Q(a, b seq(Q), epsilon Q+):
    forall n N+:
        $chap4::is_close_in_Q(epsilon, a(n), b(n))
sketch:
    have fn alternating_one(n N+) Q by cases:
        case n % 2 = 1: 1
        case n % 2 = 0: (-1)
    have fn alternating_one_point_one(n N+) Q by cases:
        case n % 2 = 1: 1.1
        case n % 2 = 0: (-1.1)
    claim:
        ? forall n N+:
            n % 2 = 1
            =>:
                $chap4::is_close_in_Q(0.1, alternating_one(n), alternating_one_point_one(n))
        alternating_one(n) = 1
        alternating_one_point_one(n) = 1.1
        release thm chap4::rational_distance_formula(alternating_one(n), alternating_one_point_one(n))
        chap4::dist_Q(alternating_one(n), alternating_one_point_one(n)) = abs(alternating_one(n) - alternating_one_point_one(n)) = abs(1 - 1.1) = abs(1 - 1.1) = abs(-0.1) = 0.1
        by def $chap4::is_close_in_Q(0.1, alternating_one(n), alternating_one_point_one(n))
    claim:
        ? forall n N+:
            n % 2 = 0
            =>:
                $chap4::is_close_in_Q(0.1, alternating_one(n), alternating_one_point_one(n))
        alternating_one(n) = (-1)
        alternating_one_point_one(n) = (-1.1)
        release thm chap4::rational_distance_formula(alternating_one(n), alternating_one_point_one(n))
        chap4::dist_Q(alternating_one(n), alternating_one_point_one(n)) = abs(alternating_one(n) - alternating_one_point_one(n)) = abs((-1) - (-1.1)) = abs((-1) - (-1.1)) = abs(0.1) = 0.1
        by def $chap4::is_close_in_Q(0.1, alternating_one(n), alternating_one_point_one(n))
    alternating_one(1) = 1
    alternating_one(2) = (-1)
    release thm chap4::rational_distance_formula(alternating_one(1), alternating_one(2))
    chap4::dist_Q(alternating_one(1), alternating_one(2)) = abs(alternating_one(1) - alternating_one(2)) = abs(1 - (-1)) = 2
    2 > 0.1
    alternating_one_point_one(1) = 1.1
    alternating_one_point_one(2) = (-1.1)
    release thm chap4::rational_distance_formula(alternating_one_point_one(1), alternating_one_point_one(2))
    chap4::dist_Q(alternating_one_point_one(1), alternating_one_point_one(2)) = abs(alternating_one_point_one(1) - alternating_one_point_one(2)) = abs(1.1 - (-1.1)) = 2.2
    2.2 > 0.1
prop is_tail_close_in_Q(a, b seq(Q), epsilon Q+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            $chap4::is_close_in_Q(epsilon, a(n), b(n))
prop has_eventual_closeness_in_Q(a, b seq(Q), epsilon Q+):
    exist n0 N+ st {$is_tail_close_in_Q(a, b, epsilon, n0)}
prop is_equivalent_cauchy_sequence_in_Q(a, b seq(Q)):
    forall epsilon Q+:
        $has_eventual_closeness_in_Q(a, b, epsilon)
claim:
    ? forall a seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(a, a)
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(a, a, epsilon)
        witness $has_eventual_closeness_in_Q(a, a, epsilon) from 1:
            claim:
                ? forall n N+:
                    n >= 1
                    =>:
                        $chap4::is_close_in_Q(epsilon, a(n), a(n))
                a(n) - a(n) = 0
                chap4::dist_Q(a(n), a(n)) = abs(a(n) - a(n)) = abs(0) = 0
                0 <= epsilon
                by def $chap4::is_close_in_Q(epsilon, a(n), a(n))
            by def $is_tail_close_in_Q(a, a, epsilon, 1)
    by def $is_equivalent_cauchy_sequence_in_Q(a, a)
claim:
    ? forall a, b seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(a, b)
        =>:
            $is_equivalent_cauchy_sequence_in_Q(b, a)
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(b, a, epsilon)
        $has_eventual_closeness_in_Q(a, b, epsilon)
        obtain n0 from $has_eventual_closeness_in_Q(a, b, epsilon)
        witness $has_eventual_closeness_in_Q(b, a, epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        $chap4::is_close_in_Q(epsilon, b(n), a(n))
                $chap4::is_close_in_Q(epsilon, a(n), b(n))
                release thm chap4::rational_closeness_is_symmetric(epsilon, a(n), b(n))
            by def $is_tail_close_in_Q(b, a, epsilon, n0)
    by def $is_equivalent_cauchy_sequence_in_Q(b, a)
claim:
    ? forall a, b, c seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(a, b)
        $is_equivalent_cauchy_sequence_in_Q(b, c)
        =>:
            $is_equivalent_cauchy_sequence_in_Q(a, c)
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(a, c, epsilon)
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in Q
        epsilon / 2 $in Q+
        $has_eventual_closeness_in_Q(a, b, epsilon / 2)
        $has_eventual_closeness_in_Q(b, c, epsilon / 2)
        obtain n1 from $has_eventual_closeness_in_Q(a, b, epsilon / 2)
        obtain n2 from exist n2 N+ st {$is_tail_close_in_Q(b, c, epsilon / 2, n2)}
        have tail_start N+ = n1 + n2
        n1 <= tail_start
        n2 <= tail_start
        witness $has_eventual_closeness_in_Q(a, c, epsilon) from tail_start:
            claim:
                ? forall n N+:
                    n >= tail_start
                    =>:
                        $chap4::is_close_in_Q(epsilon, a(n), c(n))
                n >= tail_start >= n1
                n >= tail_start >= n2
                $chap4::is_close_in_Q(epsilon / 2, a(n), b(n))
                $chap4::is_close_in_Q(epsilon / 2, b(n), c(n))
                release thm chap4::rational_closeness_is_transitive(epsilon / 2, epsilon / 2, a(n), b(n), c(n))
                epsilon / 2 + epsilon / 2 = epsilon
                $chap4::is_close_in_Q(epsilon, a(n), c(n))
            by def $is_tail_close_in_Q(a, c, epsilon, tail_start)
    by def $is_equivalent_cauchy_sequence_in_Q(a, c)
claim:
    ? forall n N+:
        n <= 10^n
    by induc n from 1:
        ? n <= 10^n
        ? from n = 1:
            10^1 = 10
            1 <= 10
        ? induc:
            n <= 10^n
            n >= 1
            9 * n >= 9 * 1 = 9 >= 1
            n * 10 = n + 9 * n >= n + 1
            n * 10 >= n + 1
            10^n * 10 >= n * 10 >= n + 1
            10^(n + 1) = 10^n * 10^1 = 10^n * 10
            n + 1 <= 10^(n + 1)
have fn decimal_above(n N+) Q = 1 + 1 / 10^n
have fn decimal_below(n N+) Q = 1 - 1 / 10^n
claim:
    ? forall epsilon Q+:
        $has_eventual_closeness_in_Q(decimal_above, decimal_below, epsilon)
    0 < epsilon
    0 = 0 / 2 < epsilon / 2
    epsilon / 2 $in R+
    release thm archimedean_property(epsilon / 2)
    obtain n0 from exist n0 N+ st {1 / n0 < epsilon / 2}
    witness $has_eventual_closeness_in_Q(decimal_above, decimal_below, epsilon) from n0:
        claim:
            ? forall i_index N+:
                i_index >= n0
                =>:
                    $chap4::is_close_in_Q(epsilon, decimal_above(i_index), decimal_below(i_index))
            i_index <= 10^i_index
            n0 <= i_index <= 10^i_index
            n0 > 0
            10^i_index > 0
            n0 * 10^i_index > 0
            n0 * 10^i_index != 0
            1 / 10^i_index = n0 / (n0 * 10^i_index) <= 10^i_index / (n0 * 10^i_index) = 1 / n0 < epsilon / 2
            2 / 10^i_index = 2 * (1 / 10^i_index) < 2 * (epsilon / 2) = epsilon
            decimal_above(i_index) = 1 + 1 / 10^i_index
            decimal_below(i_index) = 1 - 1 / 10^i_index
            (1 + 1 / 10^i_index) - (1 - 1 / 10^i_index) = 2 / 10^i_index > 0
            (1 + 1 / 10^i_index) - (1 - 1 / 10^i_index) > 0
            0 <= (1 + 1 / 10^i_index) - (1 - 1 / 10^i_index)
            abs((1 + 1 / 10^i_index) - (1 - 1 / 10^i_index)) = (1 + 1 / 10^i_index) - (1 - 1 / 10^i_index) = 2 / 10^i_index
            chap4::dist_Q(decimal_above(i_index), decimal_below(i_index)) = abs(decimal_above(i_index) - decimal_below(i_index)) = abs((1 + 1 / 10^i_index) - (1 - 1 / 10^i_index))
            by def $chap4::is_close_in_Q(epsilon, decimal_above(i_index), decimal_below(i_index))
        by def $is_tail_close_in_Q(decimal_above, decimal_below, epsilon, n0)
by def $is_equivalent_cauchy_sequence_in_Q(decimal_above, decimal_below)
have fn constant_one_Q(n N+) Q = 1
claim:
    ? forall epsilon Q+:
        $has_eventual_closeness_in_Q(constant_one_Q, decimal_below, epsilon)
    epsilon $in R+
    release thm archimedean_property(epsilon)
    obtain n0 from exist n0 N+ st {1 / n0 < epsilon}
    witness $has_eventual_closeness_in_Q(constant_one_Q, decimal_below, epsilon) from n0:
        claim:
            ? forall i_index N+:
                i_index >= n0
                =>:
                    $chap4::is_close_in_Q(epsilon, constant_one_Q(i_index), decimal_below(i_index))
            i_index <= 10^i_index
            n0 <= i_index <= 10^i_index
            n0 > 0
            10^i_index > 0
            n0 * 10^i_index > 0
            n0 * 10^i_index != 0
            1 / 10^i_index = n0 / (n0 * 10^i_index) <= 10^i_index / (n0 * 10^i_index) = 1 / n0 < epsilon
            constant_one_Q(i_index) = 1
            decimal_below(i_index) = 1 - 1 / 10^i_index
            1 - (1 - 1 / 10^i_index) = 1 / 10^i_index > 0
            1 - (1 - 1 / 10^i_index) > 0
            0 <= 1 - (1 - 1 / 10^i_index)
            abs(1 - (1 - 1 / 10^i_index)) = 1 - (1 - 1 / 10^i_index) = 1 / 10^i_index
            chap4::dist_Q(constant_one_Q(i_index), decimal_below(i_index)) = abs(constant_one_Q(i_index) - decimal_below(i_index)) = abs(1 - (1 - 1 / 10^i_index))
            by def $chap4::is_close_in_Q(epsilon, constant_one_Q(i_index), decimal_below(i_index))
        by def $is_tail_close_in_Q(constant_one_Q, decimal_below, epsilon, n0)
by def $is_equivalent_cauchy_sequence_in_Q(constant_one_Q, decimal_below)
have fn dist_R(x, y R) R = abs(x - y)
prop is_close_in_R(epsilon R+, x, y R):
    dist_R(x, y) <= epsilon
prop is_tail_close_to_in_R(a seq(R), L R, epsilon R+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            $is_close_in_R(epsilon, a(n), L)
prop has_limit_in_R(a seq(R), L R):
    forall epsilon R+:
        exist n0 N+ st {$is_tail_close_to_in_R(a, L, epsilon, n0)}
prop is_rational_sequence_tail_close_to_real(a seq(Q), x R, epsilon R+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n) - x) < epsilon
prop has_rational_sequence_limit_in_R(a seq(Q), x R):
    forall epsilon R+:
        exist n0 N+ st {$is_rational_sequence_tail_close_to_real(a, x, epsilon, n0)}
prop has_formal_limit_in_Q(a seq(Q), x R):
    $has_rational_sequence_limit_in_R(a, x)
prop has_cauchy_sequence_representative_in_Q(x R):
    exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x)}
axiom cauchy_sequence_representative_in_Q_exists:
    ? forall x R:
        $has_cauchy_sequence_representative_in_Q(x)
thm has_rational_between:
    ? forall x, y R:
        x < y
        =>:
            exist q Q st {x < q < y}
    release thm rational_between_reals(x, y)
    obtain q from exist q Q st {x < q and q < y}
    witness exist rational_point Q st {x < rational_point < y} from q
thm equivalent_cauchy_sequence_preserves_formal_limit_in_Q:
    ? forall a, b seq(Q), x R:
        $has_formal_limit_in_Q(a, x)
        $is_equivalent_cauchy_sequence_in_Q(a, b)
        =>:
            $has_formal_limit_in_Q(b, x)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_rational_sequence_tail_close_to_real(b, x, epsilon, n0)}
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in R+
        release thm has_rational_between(0, epsilon / 2)
        obtain eta from exist eta Q st {0 < eta < epsilon / 2}
        $has_rational_sequence_limit_in_R(a, x)
        obtain n1 from exist n1 N+ st {$is_rational_sequence_tail_close_to_real(a, x, epsilon / 2, n1)}
        eta $in Q+
        $has_eventual_closeness_in_Q(a, b, eta)
        obtain n2 from $has_eventual_closeness_in_Q(a, b, eta)
        have tail_start N+ = n1 + n2
        n1 <= tail_start
        n2 <= tail_start
        witness exist n3 N+ st {$is_rational_sequence_tail_close_to_real(b, x, epsilon, n3)} from tail_start:
            claim:
                ? forall n N+:
                    n >= tail_start
                    =>:
                        abs(b(n) - x) < epsilon
                n1 <= tail_start
                n2 <= tail_start
                n >= tail_start >= n1
                n >= tail_start >= n2
                n >= n1
                n >= n2
                abs(a(n) - x) < epsilon / 2
                $chap4::is_close_in_Q(eta, a(n), b(n))
                release thm chap4::rational_distance_formula(a(n), b(n))
                abs(a(n) - b(n)) <= eta
                abs(a(n) - b(n)) <= eta < epsilon / 2
                b(n) - x = (b(n) - a(n)) + (a(n) - x)
                abs(b(n) - x) = abs((b(n) - a(n)) + (a(n) - x)) <= abs(b(n) - a(n)) + abs(a(n) - x)
                b(n) - a(n) = -(a(n) - b(n))
                abs(b(n) - a(n)) = abs(-(a(n) - b(n))) = abs(a(n) - b(n))
                abs(b(n) - a(n)) + abs(a(n) - x) = abs(a(n) - b(n)) + abs(a(n) - x) < epsilon / 2 + epsilon / 2 = epsilon
                abs(b(n) - x) <= abs(b(n) - a(n)) + abs(a(n) - x) < epsilon
            by def $is_rational_sequence_tail_close_to_real(b, x, epsilon, tail_start)
    by def $has_rational_sequence_limit_in_R(b, x)
    by def $has_formal_limit_in_Q(b, x)
thm formal_limit_in_Q_unique:
    ? forall a seq(Q), x, y R:
        $has_formal_limit_in_Q(a, x)
        $has_formal_limit_in_Q(a, y)
        =>:
            x = y
    by contra:
        ? x = y
        x != y
        x - y != 0
        x - y $in R
        abs(x - y) != 0
        0 <= abs(x - y)
        by cases:
            ? 0 < abs(x - y)
            case abs(x - y) < 0:
                impossible abs(x - y) < 0
            case abs(x - y) = 0:
                impossible abs(x - y) = 0
            case abs(x - y) > 0:
                0 < abs(x - y)
        abs(x - y) > 0
        0 = 0 / 3 < abs(x - y) / 3
        abs(x - y) / 3 $in R+
        $has_rational_sequence_limit_in_R(a, x)
        $has_rational_sequence_limit_in_R(a, y)
        obtain n1 from exist n1 N+ st {$is_rational_sequence_tail_close_to_real(a, x, abs(x - y) / 3, n1)}
        obtain n2 from exist n2 N+ st {$is_rational_sequence_tail_close_to_real(a, y, abs(x - y) / 3, n2)}
        have tail_start N+ = n1 + n2
        n1 <= tail_start
        n2 <= tail_start
        abs(a(tail_start) - x) < abs(x - y) / 3
        abs(a(tail_start) - y) < abs(x - y) / 3
        x - a(tail_start) = -(a(tail_start) - x)
        abs(x - a(tail_start)) = abs(-(a(tail_start) - x)) = abs(a(tail_start) - x)
        x - y = (x - a(tail_start)) + (a(tail_start) - y)
        abs(x - y) = abs((x - a(tail_start)) + (a(tail_start) - y)) <= abs(x - a(tail_start)) + abs(a(tail_start) - y)
        2 * abs(x - y) < 3 * abs(x - y)
        abs(x - y) / 3 + abs(x - y) / 3 = 2 * abs(x - y) / 3 < 3 * abs(x - y) / 3 = abs(x - y)
        abs(x - a(tail_start)) + abs(a(tail_start) - y) = abs(a(tail_start) - x) + abs(a(tail_start) - y) < abs(x - y) / 3 + abs(x - y) / 3 < abs(x - y)
        abs(x - y) <= abs(x - a(tail_start)) + abs(a(tail_start) - y) < abs(x - y)
        impossible abs(x - y) = abs(x - y)
thm equivalent_cauchy_sequences_have_same_formal_limit_in_Q:
    ? forall a, b seq(Q), x, y R:
        $has_formal_limit_in_Q(a, x)
        $has_formal_limit_in_Q(b, y)
        $is_equivalent_cauchy_sequence_in_Q(a, b)
        =>:
            x = y
    release thm equivalent_cauchy_sequence_preserves_formal_limit_in_Q(a, b, x)
    release thm formal_limit_in_Q_unique(b, x, y)
have fn seq_add_Q(a, b seq(Q)) fn(k N+) Q = fn(n N+) Q {a(n) + b(n)}
thm rational_closeness_absolute_difference_bound:
    ? forall epsilon Q+, x, y Q:
        $chap4::is_close_in_Q(epsilon, x, y)
        =>:
            abs(x - y) <= epsilon
    release thm chap4::rational_distance_formula(x, y)
    chap4::dist_Q(x, y) <= epsilon
    abs(x - y) = chap4::dist_Q(x, y) <= epsilon
thm absolute_difference_bound_gives_rational_closeness:
    ? forall epsilon Q+, x, y Q:
        abs(x - y) <= epsilon
        =>:
            $chap4::is_close_in_Q(epsilon, x, y)
    release thm chap4::rational_distance_formula(x, y)
    chap4::dist_Q(x, y) = abs(x - y) <= epsilon
    by def $chap4::is_close_in_Q(epsilon, x, y)
thm equal_rationals_are_close:
    ? forall epsilon Q+, x, y Q:
        x = y
        =>:
            $chap4::is_close_in_Q(epsilon, x, y)
    release thm chap4::rational_closeness_is_reflexive(epsilon, x)
    $chap4::is_close_in_Q(epsilon, x, x)
thm seq_add_Q_preserves_termwise_closeness:
    ? forall a, b seq(Q), epsilon Q+, j, k N+:
        $chap4::is_close_in_Q(epsilon / 2, a(j), a(k))
        $chap4::is_close_in_Q(epsilon / 2, b(j), b(k))
        =>:
            $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(j), seq_add_Q(a, b)(k))
    seq_add_Q(a, b)(j) = a(j) + b(j)
    seq_add_Q(a, b)(k) = a(k) + b(k)
    release thm chap4::rational_closeness_preserved_by_addition_and_subtraction(epsilon / 2, epsilon / 2, a(j), a(k), b(j), b(k))
    epsilon / 2 + epsilon / 2 = epsilon
    $chap4::is_close_in_Q(epsilon, a(j) + b(j), a(k) + b(k))
thm seq_add_Q_same_right_distance:
    ? forall a, a_prime, b seq(Q), n N+:
        chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n)) = chap4::dist_Q(a(n), a_prime(n))
    seq_add_Q(a, b)(n) = a(n) + b(n)
    seq_add_Q(a_prime, b)(n) = a_prime(n) + b(n)
    release thm chap4::rational_distance_formula(seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n))
    release thm chap4::rational_distance_formula(a(n), a_prime(n))
    (a(n) + b(n)) - (a_prime(n) + b(n)) = a(n) - a_prime(n)
    seq_add_Q(a, b)(n) - seq_add_Q(a_prime, b)(n) = (a(n) + b(n)) - (a_prime(n) + b(n))
    seq_add_Q(a, b)(n) - seq_add_Q(a_prime, b)(n) = a(n) - a_prime(n)
    abs(seq_add_Q(a, b)(n) - seq_add_Q(a_prime, b)(n)) = abs(a(n) - a_prime(n))
    chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n)) = abs(seq_add_Q(a, b)(n) - seq_add_Q(a_prime, b)(n)) = abs(a(n) - a_prime(n))
    abs(a(n) - a_prime(n)) = chap4::dist_Q(a(n), a_prime(n))
thm seq_add_Q_same_left_distance:
    ? forall a, b, b_prime seq(Q), n N+:
        chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n)) = chap4::dist_Q(b(n), b_prime(n))
    seq_add_Q(a, b)(n) = a(n) + b(n)
    seq_add_Q(a, b_prime)(n) = a(n) + b_prime(n)
    release thm chap4::rational_distance_formula(seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n))
    release thm chap4::rational_distance_formula(b(n), b_prime(n))
    (a(n) + b(n)) - (a(n) + b_prime(n)) = b(n) - b_prime(n)
    seq_add_Q(a, b)(n) - seq_add_Q(a, b_prime)(n) = (a(n) + b(n)) - (a(n) + b_prime(n))
    seq_add_Q(a, b)(n) - seq_add_Q(a, b_prime)(n) = b(n) - b_prime(n)
    abs(seq_add_Q(a, b)(n) - seq_add_Q(a, b_prime)(n)) = abs(b(n) - b_prime(n))
    chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n)) = abs(seq_add_Q(a, b)(n) - seq_add_Q(a, b_prime)(n)) = abs(b(n) - b_prime(n))
    abs(b(n) - b_prime(n)) = chap4::dist_Q(b(n), b_prime(n))
claim:
    ? forall a, b seq(Q):
        $is_cauchy_sequence_in_Q(a)
        $is_cauchy_sequence_in_Q(b)
        =>:
            $is_cauchy_sequence_in_Q(seq_add_Q(a, b))
    claim:
        ? forall epsilon Q+:
            $has_eventual_epsilon_steadiness_in_Q(seq_add_Q(a, b), epsilon)
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in Q
        epsilon / 2 $in Q+
        $has_eventual_epsilon_steadiness_in_Q(a, epsilon / 2)
        $has_eventual_epsilon_steadiness_in_Q(b, epsilon / 2)
        obtain n1 from $has_eventual_epsilon_steadiness_in_Q(a, epsilon / 2)
        obtain n2 from $has_eventual_epsilon_steadiness_in_Q(b, epsilon / 2)
        have tail_start N+ = n1 + n2
        n1 <= tail_start
        n2 <= tail_start
        witness $has_eventual_epsilon_steadiness_in_Q(seq_add_Q(a, b), epsilon) from tail_start:
            claim:
                ? forall j, k N+:
                    j >= tail_start
                    k >= tail_start
                    =>:
                        $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(j), seq_add_Q(a, b)(k))
                j >= tail_start >= n1
                k >= tail_start >= n1
                j >= tail_start >= n2
                k >= tail_start >= n2
                $chap4::is_close_in_Q(epsilon / 2, a(j), a(k))
                $chap4::is_close_in_Q(epsilon / 2, b(j), b(k))
                release thm seq_add_Q_preserves_termwise_closeness(a, b, epsilon, j, k)
                epsilon / 2 + epsilon / 2 = epsilon
                $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(j), seq_add_Q(a, b)(k))
            by def $is_tail_epsilon_steady_in_Q(seq_add_Q(a, b), epsilon, tail_start)
    by def $is_cauchy_sequence_in_Q(seq_add_Q(a, b))
claim:
    ? forall a, a_prime, b seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(a, a_prime)
        =>:
            $is_equivalent_cauchy_sequence_in_Q(seq_add_Q(a, b), seq_add_Q(a_prime, b))
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(seq_add_Q(a, b), seq_add_Q(a_prime, b), epsilon)
        $has_eventual_closeness_in_Q(a, a_prime, epsilon)
        obtain n0 from $has_eventual_closeness_in_Q(a, a_prime, epsilon)
        witness $has_eventual_closeness_in_Q(seq_add_Q(a, b), seq_add_Q(a_prime, b), epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n))
                $chap4::is_close_in_Q(epsilon, a(n), a_prime(n))
                chap4::dist_Q(a(n), a_prime(n)) <= epsilon
                chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n)) = chap4::dist_Q(a(n), a_prime(n))
                chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n)) <= epsilon
                by def $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(n), seq_add_Q(a_prime, b)(n))
            by def $is_tail_close_in_Q(seq_add_Q(a, b), seq_add_Q(a_prime, b), epsilon, n0)
    by def $is_equivalent_cauchy_sequence_in_Q(seq_add_Q(a, b), seq_add_Q(a_prime, b))
claim:
    ? forall a, b, b_prime seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(b, b_prime)
        =>:
            $is_equivalent_cauchy_sequence_in_Q(seq_add_Q(a, b), seq_add_Q(a, b_prime))
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(seq_add_Q(a, b), seq_add_Q(a, b_prime), epsilon)
        $has_eventual_closeness_in_Q(b, b_prime, epsilon)
        obtain n0 from exist n0 N+ st {$is_tail_close_in_Q(b, b_prime, epsilon, n0)}
        witness $has_eventual_closeness_in_Q(seq_add_Q(a, b), seq_add_Q(a, b_prime), epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n))
                $chap4::is_close_in_Q(epsilon, b(n), b_prime(n))
                chap4::dist_Q(b(n), b_prime(n)) <= epsilon
                chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n)) = chap4::dist_Q(b(n), b_prime(n))
                chap4::dist_Q(seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n)) <= epsilon
                by def $chap4::is_close_in_Q(epsilon, seq_add_Q(a, b)(n), seq_add_Q(a, b_prime)(n))
            by def $is_tail_close_in_Q(seq_add_Q(a, b), seq_add_Q(a, b_prime), epsilon, n0)
    by def $is_equivalent_cauchy_sequence_in_Q(seq_add_Q(a, b), seq_add_Q(a, b_prime))
have fn seq_mul_Q(a, b seq(Q)) fn(k N+) Q = fn(n N+) Q {a(n) * b(n)}
thm seq_mul_Q_same_right_absolute_difference:
    ? forall a, a_prime, b seq(Q), n N+:
        abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n)) = abs(a(n) - a_prime(n)) * abs(b(n))
    seq_mul_Q(a, b)(n) = a(n) * b(n)
    seq_mul_Q(a_prime, b)(n) = a_prime(n) * b(n)
    a(n) * b(n) - a_prime(n) * b(n) = (a(n) - a_prime(n)) * b(n)
    seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n) = a(n) * b(n) - a_prime(n) * b(n)
    seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n) = (a(n) - a_prime(n)) * b(n)
    abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n)) = abs((a(n) - a_prime(n)) * b(n))
    abs((a(n) - a_prime(n)) * b(n)) = abs(a(n) - a_prime(n)) * abs(b(n))
    abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n)) = abs((a(n) - a_prime(n)) * b(n)) = abs(a(n) - a_prime(n)) * abs(b(n))
thm seq_mul_Q_same_left_absolute_difference:
    ? forall a, b, b_prime seq(Q), n N+:
        abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a, b_prime)(n)) = abs(a(n)) * abs(b(n) - b_prime(n))
    seq_mul_Q(a, b)(n) = a(n) * b(n)
    seq_mul_Q(a, b_prime)(n) = a(n) * b_prime(n)
    a(n) * b(n) - a(n) * b_prime(n) = a(n) * (b(n) - b_prime(n))
    seq_mul_Q(a, b)(n) - seq_mul_Q(a, b_prime)(n) = a(n) * b(n) - a(n) * b_prime(n)
    seq_mul_Q(a, b)(n) - seq_mul_Q(a, b_prime)(n) = a(n) * (b(n) - b_prime(n))
    abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a, b_prime)(n)) = abs(a(n) * (b(n) - b_prime(n)))
    abs(a(n) * (b(n) - b_prime(n))) = abs(a(n)) * abs(b(n) - b_prime(n))
    abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a, b_prime)(n)) = abs(a(n) * (b(n) - b_prime(n))) = abs(a(n)) * abs(b(n) - b_prime(n))
claim:
    ? forall a, b seq(Q):
        $is_cauchy_sequence_in_Q(a)
        $is_cauchy_sequence_in_Q(b)
        =>:
            $is_cauchy_sequence_in_Q(seq_mul_Q(a, b))
    $is_bounded_sequence_in_Q(a)
    $is_bounded_sequence_in_Q(b)
    obtain M_a from $is_bounded_sequence_in_Q(a)
    obtain M_b from $is_bounded_sequence_in_Q(b)
    M_a + 1 > 0
    M_b + 1 > 0
    M_a + 1 != 0
    M_b + 1 != 0
    2 * (M_a + 1) > 0
    2 * (M_b + 1) > 0
    2 * (M_a + 1) != 0
    2 * (M_b + 1) != 0
    claim:
        ? forall epsilon Q+:
            $has_eventual_epsilon_steadiness_in_Q(seq_mul_Q(a, b), epsilon)
        0 < epsilon
        M_b + 1 $in Q
        2 * (M_b + 1) $in Q
        0 < 2 * (M_b + 1)
        0 = 0 / (2 * (M_b + 1)) < epsilon / (2 * (M_b + 1))
        epsilon / (2 * (M_b + 1)) $in Q
        epsilon / (2 * (M_b + 1)) $in Q+
        M_a + 1 $in Q
        2 * (M_a + 1) $in Q
        0 < 2 * (M_a + 1)
        0 = 0 / (2 * (M_a + 1)) < epsilon / (2 * (M_a + 1))
        epsilon / (2 * (M_a + 1)) $in Q
        epsilon / (2 * (M_a + 1)) $in Q+
        $has_eventual_epsilon_steadiness_in_Q(a, epsilon / (2 * (M_b + 1)))
        $has_eventual_epsilon_steadiness_in_Q(b, epsilon / (2 * (M_a + 1)))
        obtain n1 from $has_eventual_epsilon_steadiness_in_Q(a, epsilon / (2 * (M_b + 1)))
        obtain n2 from $has_eventual_epsilon_steadiness_in_Q(b, epsilon / (2 * (M_a + 1)))
        have tail_start N+ = n1 + n2
        n1 <= tail_start
        n2 <= tail_start
        witness $has_eventual_epsilon_steadiness_in_Q(seq_mul_Q(a, b), epsilon) from tail_start:
            claim:
                ? forall j, k N+:
                    j >= tail_start
                    k >= tail_start
                    =>:
                        $chap4::is_close_in_Q(epsilon, seq_mul_Q(a, b)(j), seq_mul_Q(a, b)(k))
                n1 <= tail_start
                n2 <= tail_start
                j >= tail_start >= n1
                k >= tail_start >= n1
                j >= tail_start >= n2
                k >= tail_start >= n2
                j >= n1
                k >= n1
                j >= n2
                k >= n2
                $chap4::is_close_in_Q(epsilon / (2 * (M_b + 1)), a(j), a(k))
                $chap4::is_close_in_Q(epsilon / (2 * (M_a + 1)), b(j), b(k))
                abs(a(j) - a(k)) <= epsilon / (2 * (M_b + 1))
                abs(b(j) - b(k)) <= epsilon / (2 * (M_a + 1))
                abs(b(j)) <= M_b
                abs(a(k)) <= M_a
                abs(b(j)) <= M_b + 1
                abs(a(k)) <= M_a + 1
                abs((a(j) - a(k)) * b(j)) = abs(a(j) - a(k)) * abs(b(j))
                abs(a(k) * (b(j) - b(k))) = abs(a(k)) * abs(b(j) - b(k))
                abs(a(j) - a(k)) * abs(b(j)) <= (epsilon / (2 * (M_b + 1))) * (M_b + 1) = epsilon / 2
                abs((a(j) - a(k)) * b(j)) <= epsilon / 2
                abs(a(k)) * abs(b(j) - b(k)) <= (M_a + 1) * (epsilon / (2 * (M_a + 1))) = epsilon / 2
                abs(a(k) * (b(j) - b(k))) <= epsilon / 2
                abs((a(j) - a(k)) * b(j)) + abs(a(k) * (b(j) - b(k))) <= epsilon / 2 + epsilon / 2 = epsilon
                seq_mul_Q(a, b)(j) = a(j) * b(j)
                seq_mul_Q(a, b)(k) = a(k) * b(k)
                a(j) * b(j) - a(k) * b(k) = (a(j) - a(k)) * b(j) + a(k) * (b(j) - b(k))
                seq_mul_Q(a, b)(j) - seq_mul_Q(a, b)(k) = a(j) * b(j) - a(k) * b(k)
                seq_mul_Q(a, b)(j) - seq_mul_Q(a, b)(k) = (a(j) - a(k)) * b(j) + a(k) * (b(j) - b(k))
                abs(seq_mul_Q(a, b)(j) - seq_mul_Q(a, b)(k)) = abs((a(j) - a(k)) * b(j) + a(k) * (b(j) - b(k)))
                abs(seq_mul_Q(a, b)(j) - seq_mul_Q(a, b)(k)) = abs((a(j) - a(k)) * b(j) + a(k) * (b(j) - b(k))) <= abs((a(j) - a(k)) * b(j)) + abs(a(k) * (b(j) - b(k)))
                abs(seq_mul_Q(a, b)(j) - seq_mul_Q(a, b)(k)) <= abs((a(j) - a(k)) * b(j)) + abs(a(k) * (b(j) - b(k))) <= epsilon
                by def $chap4::is_close_in_Q(epsilon, seq_mul_Q(a, b)(j), seq_mul_Q(a, b)(k))
            by def $is_tail_epsilon_steady_in_Q(seq_mul_Q(a, b), epsilon, tail_start)
    by def $is_cauchy_sequence_in_Q(seq_mul_Q(a, b))
thm seq_mul_Q_respects_equivalent_left_factor:
    ? forall a, a_prime, b seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(a, a_prime)
        $is_cauchy_sequence_in_Q(b)
        =>:
            $is_equivalent_cauchy_sequence_in_Q(seq_mul_Q(a, b), seq_mul_Q(a_prime, b))
    $is_bounded_sequence_in_Q(b)
    obtain M_b from $is_bounded_sequence_in_Q(b)
    M_b + 1 > 0
    M_b + 1 != 0
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(seq_mul_Q(a, b), seq_mul_Q(a_prime, b), epsilon)
        0 < epsilon
        M_b + 1 $in Q
        0 < M_b + 1
        0 = 0 / (M_b + 1) < epsilon / (M_b + 1)
        epsilon / (M_b + 1) $in Q
        epsilon / (M_b + 1) $in Q+
        $has_eventual_closeness_in_Q(a, a_prime, epsilon / (M_b + 1))
        obtain n0 from $has_eventual_closeness_in_Q(a, a_prime, epsilon / (M_b + 1))
        witness $has_eventual_closeness_in_Q(seq_mul_Q(a, b), seq_mul_Q(a_prime, b), epsilon) from n0:
            claim:
                ? forall n N+:
                    n >= n0
                    =>:
                        $chap4::is_close_in_Q(epsilon, seq_mul_Q(a, b)(n), seq_mul_Q(a_prime, b)(n))
                $chap4::is_close_in_Q(epsilon / (M_b + 1), a(n), a_prime(n))
                abs(a(n) - a_prime(n)) <= epsilon / (M_b + 1)
                abs(b(n)) <= M_b
                abs(b(n)) <= M_b + 1
                abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n)) = abs(a(n) - a_prime(n)) * abs(b(n))
                abs(a(n) - a_prime(n)) * abs(b(n)) <= (epsilon / (M_b + 1)) * (M_b + 1) = epsilon
                abs(seq_mul_Q(a, b)(n) - seq_mul_Q(a_prime, b)(n)) <= epsilon
                by def $chap4::is_close_in_Q(epsilon, seq_mul_Q(a, b)(n), seq_mul_Q(a_prime, b)(n))
            by def $is_tail_close_in_Q(seq_mul_Q(a, b), seq_mul_Q(a_prime, b), epsilon, n0)
    by def $is_equivalent_cauchy_sequence_in_Q(seq_mul_Q(a, b), seq_mul_Q(a_prime, b))
thm seq_mul_Q_commutative:
    ? forall a, b seq(Q):
        seq_mul_Q(a, b) = seq_mul_Q(b, a)
    by fn_extension:
        ? seq_mul_Q(a, b) = seq_mul_Q(b, a)
        claim:
            ? forall n N+:
                seq_mul_Q(a, b)(n) = seq_mul_Q(b, a)(n)
            seq_mul_Q(a, b)(n) = a(n) * b(n)
            seq_mul_Q(b, a)(n) = b(n) * a(n)
            a(n) * b(n) = b(n) * a(n)
claim:
    ? forall a, b, b_prime seq(Q):
        $is_cauchy_sequence_in_Q(a)
        $is_equivalent_cauchy_sequence_in_Q(b, b_prime)
        =>:
            $is_equivalent_cauchy_sequence_in_Q(seq_mul_Q(a, b), seq_mul_Q(a, b_prime))
    release thm seq_mul_Q_respects_equivalent_left_factor(b, b_prime, a)
    release thm seq_mul_Q_commutative(a, b)
    release thm seq_mul_Q_commutative(a, b_prime)
thm seq_mul_Q_distributes_over_seq_add_Q_term:
    ? forall a, b, c seq(Q), n N+:
        seq_mul_Q(a, seq_add_Q(b, c))(n) = seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c))(n)
    seq_add_Q(b, c)(n) = b(n) + c(n)
    seq_mul_Q(a, seq_add_Q(b, c))(n) = a(n) * seq_add_Q(b, c)(n) = a(n) * (b(n) + c(n))
    seq_mul_Q(a, b)(n) = a(n) * b(n)
    seq_mul_Q(a, c)(n) = a(n) * c(n)
    seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c))(n) = seq_mul_Q(a, b)(n) + seq_mul_Q(a, c)(n) = a(n) * b(n) + a(n) * c(n)
    a(n) * (b(n) + c(n)) = a(n) * b(n) + a(n) * c(n)
claim:
    ? forall a, b, c seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(seq_mul_Q(a, seq_add_Q(b, c)), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c)))
    seq_add_Q(b, c) $in seq(Q)
    seq_mul_Q(a, seq_add_Q(b, c)) $in seq(Q)
    seq_mul_Q(a, b) $in seq(Q)
    seq_mul_Q(a, c) $in seq(Q)
    seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c)) $in seq(Q)
    claim:
        ? forall epsilon Q+:
            $has_eventual_closeness_in_Q(seq_mul_Q(a, seq_add_Q(b, c)), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c)), epsilon)
        witness $has_eventual_closeness_in_Q(seq_mul_Q(a, seq_add_Q(b, c)), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c)), epsilon) from 1:
            claim:
                ? forall n N+:
                    n >= 1
                    =>:
                        $chap4::is_close_in_Q(epsilon, seq_mul_Q(a, seq_add_Q(b, c))(n), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c))(n))
                release thm seq_mul_Q_distributes_over_seq_add_Q_term(a, b, c, n)
                release thm equal_rationals_are_close(epsilon, seq_mul_Q(a, seq_add_Q(b, c))(n), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c))(n))
            by def $is_tail_close_in_Q(seq_mul_Q(a, seq_add_Q(b, c)), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c)), epsilon, 1)
    by def $is_equivalent_cauchy_sequence_in_Q(seq_mul_Q(a, seq_add_Q(b, c)), seq_add_Q(seq_mul_Q(a, b), seq_mul_Q(a, c)))
forall x, y, z R:
    x + y = y + x
    (x + y) + z = x + (y + z)
    x * y = y * x
    (x * y) * z = x * (y * z)
    x * (y + z) = x * y + x * z
forall x R:
    x + 0 = x
    x * 1 = x
    x + (-x) = 0
forall x R*:
    x * (1 / x) = 1
prop is_bounded_away_from_zero_by_in_Q(a seq(Q), c Q+):
    forall n N+:
        abs(a(n)) >= c
prop is_bounded_away_from_zero_in_Q(a seq(Q)):
    exist c Q+ st {$is_bounded_away_from_zero_by_in_Q(a, c)}
sketch:
    have fn decimal_tail_Q(n N+) Q = 1 / 10^n
    have fn geometric_ten_Q(n N+) Q = 10^n
    have fn alternating_sign_Q(n N+) Q by cases:
        case n % 2 = 1: 1
        case n % 2 = 0: (-1)
    witness $is_bounded_away_from_zero_in_Q(alternating_sign_Q) from 1:
        1 $in Q+
        claim:
            ? forall n N+:
                abs(alternating_sign_Q(n)) >= 1
            n % 2 = 1 or n % 2 = 0
            by cases:
                ? abs(alternating_sign_Q(n)) >= 1
                case n % 2 = 1:
                    alternating_sign_Q(n) = 1
                    abs(alternating_sign_Q(n)) = abs(1) = 1
                    abs(alternating_sign_Q(n)) >= 1
                case n % 2 = 0:
                    alternating_sign_Q(n) = (-1)
                    abs(alternating_sign_Q(n)) = abs(-1) = 1
                    abs(alternating_sign_Q(n)) >= 1
        by def $is_bounded_away_from_zero_by_in_Q(alternating_sign_Q, 1)
        $is_bounded_away_from_zero_by_in_Q(alternating_sign_Q, 1)
    claim:
        ? not $is_bounded_away_from_zero_in_Q(decimal_tail_Q)
        by contra:
            ? not $is_bounded_away_from_zero_in_Q(decimal_tail_Q)
            $is_bounded_away_from_zero_in_Q(decimal_tail_Q)
            obtain c from $is_bounded_away_from_zero_in_Q(decimal_tail_Q)
            release thm archimedean_property(c)
            obtain n0 from exist n0 N+ st {1 / n0 < c}
            n0 <= 10^n0
            10^n0 > 0
            n0 * 10^n0 > 0
            1 / 10^n0 = n0 / (n0 * 10^n0)
            n0 / (n0 * 10^n0) <= 10^n0 / (n0 * 10^n0)
            10^n0 / (n0 * 10^n0) = 1 / n0
            1 / 10^n0 <= 1 / n0
            1 / 10^n0 <= 1 / n0 < c
            1 / 10^n0 < c
            1 / 10^n0 > 0
            0 <= 1 / 10^n0
            abs(1 / 10^n0) = 1 / 10^n0
            decimal_tail_Q(n0) = 1 / 10^n0
            abs(decimal_tail_Q(n0)) = abs(1 / 10^n0) = 1 / 10^n0
            abs(decimal_tail_Q(n0)) < c
            abs(decimal_tail_Q(n0)) >= c
            impossible abs(decimal_tail_Q(n0)) >= c
    claim:
        ? forall n N+:
            n = 1 or n > 1
        n >= 1
        by cases:
            ? n = 1 or n > 1
            case n < 1:
                impossible n < 1
            case n = 1:
                n = 1 or n > 1
            case n > 1:
                n = 1 or n > 1
    have fn zero_then_decimal_nines_Q(n N+) Q by cases:
        case n = 1: 0
        case n > 1: 1 - 10 / 10^n
    claim:
        ? not $is_bounded_away_from_zero_in_Q(zero_then_decimal_nines_Q)
        by contra:
            ? not $is_bounded_away_from_zero_in_Q(zero_then_decimal_nines_Q)
            $is_bounded_away_from_zero_in_Q(zero_then_decimal_nines_Q)
            obtain c from $is_bounded_away_from_zero_in_Q(zero_then_decimal_nines_Q)
            zero_then_decimal_nines_Q(1) = 0
            abs(zero_then_decimal_nines_Q(1)) = abs(0) = 0
            abs(zero_then_decimal_nines_Q(1)) >= c
            impossible 0 >= c
    witness $is_bounded_away_from_zero_in_Q(geometric_ten_Q) from 1:
        1 $in Q+
        forall i_index N+:
            i_index >= 1
            i_index <= 10^i_index
            1 <= i_index <= 10^i_index
            10^i_index >= 0
            0 <= 10^i_index
            abs(10^i_index) = 10^i_index
            geometric_ten_Q(i_index) = 10^i_index
            abs(geometric_ten_Q(i_index)) = abs(10^i_index) = 10^i_index
            abs(geometric_ten_Q(i_index)) >= 1
        by def $is_bounded_away_from_zero_by_in_Q(geometric_ten_Q, 1)
        $is_bounded_away_from_zero_by_in_Q(geometric_ten_Q, 1)
    claim:
        ? not $is_bounded_sequence_in_Q(geometric_ten_Q)
        by contra:
            ? not $is_bounded_sequence_in_Q(geometric_ten_Q)
            $is_bounded_sequence_in_Q(geometric_ten_Q)
            obtain M from $is_bounded_sequence_in_Q(geometric_ten_Q)
            M + 1 > 0
            M + 1 $in R+
            0 < M + 1
            0 = 0 / (M + 1) < 1 / (M + 1)
            1 / (M + 1) $in R+
            release thm archimedean_property(1 / (M + 1))
            obtain n0 from exist n0 N+ st {1 / n0 < 1 / (M + 1)}
            n0 * (M + 1) > 0
            (1 / n0) * (n0 * (M + 1)) < (1 / (M + 1)) * (n0 * (M + 1))
            (1 / n0) * (n0 * (M + 1)) = M + 1
            (1 / (M + 1)) * (n0 * (M + 1)) = n0
            M + 1 < n0
            M < M + 1 < n0
            M < n0
            n0 <= 10^n0
            M < n0 <= 10^n0
            M < 10^n0
            10^n0 >= 0
            0 <= 10^n0
            abs(10^n0) = 10^n0
            geometric_ten_Q(n0) = 10^n0
            abs(geometric_ten_Q(n0)) = abs(10^n0) = 10^n0
            abs(geometric_ten_Q(n0)) > M
            abs(geometric_ten_Q(n0)) <= M
            impossible abs(geometric_ten_Q(n0)) <= M
thm finite_prefix_replacement_preserves_cauchy_and_formal_limit_in_Q:
    ? forall a, b seq(Q), x R, n0 N+:
        $is_cauchy_sequence_in_Q(a)
        $has_formal_limit_in_Q(a, x)
        forall n N+:
            n >= n0
            =>:
                b(n) = a(n)
        =>:
            $is_cauchy_sequence_in_Q(b)
            $has_formal_limit_in_Q(b, x)
    claim:
        ? forall epsilon Q+:
            $has_eventual_epsilon_steadiness_in_Q(b, epsilon)
        $has_eventual_epsilon_steadiness_in_Q(a, epsilon)
        obtain n1 from $has_eventual_epsilon_steadiness_in_Q(a, epsilon)
        have tail_start N+ = n0 + n1
        n0 <= tail_start
        n1 <= tail_start
        witness $has_eventual_epsilon_steadiness_in_Q(b, epsilon) from tail_start:
            claim:
                ? forall j, k N+:
                    j >= tail_start
                    k >= tail_start
                    =>:
                        $chap4::is_close_in_Q(epsilon, b(j), b(k))
                n0 <= tail_start <= j
                b(j) = a(j)
                n0 <= tail_start <= k
                b(k) = a(k)
                n1 <= tail_start <= j
                n1 <= tail_start <= k
                $chap4::is_close_in_Q(epsilon, a(j), a(k))
                chap4::dist_Q(b(j), b(k)) = chap4::dist_Q(a(j), a(k))
                by def $chap4::is_close_in_Q(epsilon, b(j), b(k))
            by def $is_tail_epsilon_steady_in_Q(b, epsilon, tail_start)
    by def $is_cauchy_sequence_in_Q(b)
    claim:
        ? forall epsilon R+:
            exist n2 N+ st {$is_rational_sequence_tail_close_to_real(b, x, epsilon, n2)}
        $has_rational_sequence_limit_in_R(a, x)
        obtain n1 from exist n1 N+ st {$is_rational_sequence_tail_close_to_real(a, x, epsilon, n1)}
        have limit_tail_start N+ = n0 + n1
        n0 <= limit_tail_start
        n1 <= limit_tail_start
        witness exist n2 N+ st {$is_rational_sequence_tail_close_to_real(b, x, epsilon, n2)} from limit_tail_start:
            forall n N+:
                n >= limit_tail_start
                =>:
                    n0 <= limit_tail_start <= n
                    b(n) = a(n)
                    n1 <= limit_tail_start <= n
                    abs(a(n) - x) < epsilon
                    abs(b(n) - x) = abs(a(n) - x)
                    abs(b(n) - x) < epsilon
            by def $is_rational_sequence_tail_close_to_real(b, x, epsilon, limit_tail_start)
    by def $has_rational_sequence_limit_in_R(b, x)
    by def $has_formal_limit_in_Q(b, x)
thm nonzero_real_has_bounded_away_rational_representative:
    ? forall x R*:
        exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x), $is_bounded_away_from_zero_in_Q(a)}
    abs(x) != 0
    0 <= abs(x)
    by cases:
        ? 0 < abs(x)
        case abs(x) < 0:
            impossible abs(x) < 0
        case abs(x) = 0:
            impossible abs(x) = 0
        case abs(x) > 0:
            0 < abs(x)
    abs(x) > 0
    0 = 0 / 4 < abs(x) / 4
    abs(x) / 4 $in R+
    release thm has_rational_between(0, abs(x) / 4)
    obtain c from exist c Q st {0 < c < abs(x) / 4}
    c > 0
    c $in Q+
    c $in R+
    0 <= c
    2 * c < 4 * c
    4 * c < 4 * (abs(x) / 4) = abs(x)
    2 * c < 4 * c < abs(x)
    release thm cauchy_sequence_representative_in_Q_exists(x)
    obtain a from exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x)}
    $has_rational_sequence_limit_in_R(a, x)
    obtain n0 from exist n0 N+ st {$is_rational_sequence_tail_close_to_real(a, x, c, n0)}
    have fn b(n N+) Q by cases:
        case n < n0: c
        case n >= n0: a(n)
    forall n N+:
        n >= n0
        =>:
            b(n) = a(n)
    release thm finite_prefix_replacement_preserves_cauchy_and_formal_limit_in_Q(a, b, x, n0)
    claim:
        ? forall n N+:
            abs(b(n)) >= c
        n < n0 or n >= n0
        by cases:
            ? abs(b(n)) >= c
            case n < n0:
                b(n) = c
                abs(b(n)) = abs(c) = c
            case n >= n0:
                b(n) = a(n)
                abs(a(n) - x) < c
                x - a(n) = -(a(n) - x)
                abs(x - a(n)) = abs(-(a(n) - x)) = abs(a(n) - x)
                x = (x - a(n)) + a(n)
                abs(x) = abs((x - a(n)) + a(n)) <= abs(x - a(n)) + abs(a(n))
                abs(x - a(n)) + abs(a(n)) = abs(a(n) - x) + abs(a(n)) < c + abs(a(n))
                abs(x) <= abs(x - a(n)) + abs(a(n)) < c + abs(a(n))
                2 * c < abs(x) < c + abs(a(n))
                2 * c - c < c + abs(a(n)) - c
                2 * c - c = c
                c + abs(a(n)) - c = abs(a(n))
                c < abs(a(n))
                abs(b(n)) = abs(a(n)) >= c
    by def $is_bounded_away_from_zero_by_in_Q(b, c)
    witness $is_bounded_away_from_zero_in_Q(b) from c
    witness exist b0 seq(Q) st {$is_cauchy_sequence_in_Q(b0), $has_formal_limit_in_Q(b0, x), $is_bounded_away_from_zero_in_Q(b0)} from b
thm reciprocal_abs_diff_bound_Q:
    ? forall x, y Q, c_x, c_y, epsilon Q+:
        x != 0
        y != 0
        abs(x) >= c_x
        abs(y) >= c_y
        abs(x - y) <= c_x * c_y * epsilon
        =>:
            abs(1 / x - 1 / y) <= epsilon
    c_x * c_y > 0
    abs(x * y) = abs(x) * abs(y) >= c_x * c_y
    abs(1 / x - 1 / y) * (c_x * c_y) <= abs(1 / x - 1 / y) * abs(x * y)
    (1 / x - 1 / y) * (x * y) = y - x
    y - x = -(x - y)
    abs(y - x) = abs(-(x - y)) = abs(x - y)
    abs(1 / x - 1 / y) * abs(x * y) = abs((1 / x - 1 / y) * (x * y)) = abs(y - x) = abs(x - y)
    abs(1 / x - 1 / y) * (c_x * c_y) <= abs(x - y) <= c_x * c_y * epsilon
    abs(1 / x - 1 / y) * (c_x * c_y) / (c_x * c_y) <= (c_x * c_y * epsilon) / (c_x * c_y)
    abs(1 / x - 1 / y) * (c_x * c_y) / (c_x * c_y) = abs(1 / x - 1 / y)
    (c_x * c_y * epsilon) / (c_x * c_y) = epsilon
prop is_nonzero_sequence_in_Q(a seq(Q)):
    forall n N+:
        a(n) != 0
claim:
    ? forall x Q:
        abs(x) > 0
        =>:
            x != 0
    by contra:
        ? x != 0
        x = 0
        abs(x) = abs(0) = 0
        impossible abs(x) > 0
claim:
    ? forall a seq(Q):
        $is_bounded_away_from_zero_in_Q(a)
        =>:
            $is_nonzero_sequence_in_Q(a)
    obtain c from $is_bounded_away_from_zero_in_Q(a)
    claim:
        ? forall n N+:
            a(n) != 0
        abs(a(n)) >= c > 0
        by contra:
            ? a(n) != 0
            a(n) = 0
            abs(a(n)) = abs(0) = 0
            impossible abs(a(n)) > 0
    by def $is_nonzero_sequence_in_Q(a)
have fn seq_recip_Q(a seq(Q): $is_nonzero_sequence_in_Q(a)) fn(k N+) Q = fn(n N+) Q {1 / a(n)}
thm seq_recip_Q_values_are_close:
    ? forall a, b seq(Q), c_a, c_b, epsilon Q+, j, k N+:
        $is_nonzero_sequence_in_Q(a)
        $is_nonzero_sequence_in_Q(b)
        abs(a(j)) >= c_a
        abs(b(k)) >= c_b
        abs(a(j) - b(k)) <= c_a * c_b * epsilon
        =>:
            $chap4::is_close_in_Q(epsilon, seq_recip_Q(a)(j), seq_recip_Q(b)(k))
    a(j) != 0
    b(k) != 0
    release thm reciprocal_abs_diff_bound_Q(a(j), b(k), c_a, c_b, epsilon)
    seq_recip_Q(a)(j) = 1 / a(j)
    seq_recip_Q(b)(k) = 1 / b(k)
    abs(seq_recip_Q(a)(j) - seq_recip_Q(b)(k)) = abs(1 / a(j) - 1 / b(k)) <= epsilon
claim:
    ? forall a seq(Q):
        $is_cauchy_sequence_in_Q(a)
        $is_bounded_away_from_zero_in_Q(a)
        $is_nonzero_sequence_in_Q(a)
