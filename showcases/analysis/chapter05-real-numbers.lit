claim:
    ? forall a, b seq(Q):
        $is_equivalent_cauchy_sequence_in_Q(a, b)
        $is_bounded_away_from_zero_in_Q(a)
        $is_bounded_away_from_zero_in_Q(b)
        $is_nonzero_sequence_in_Q(a)
        $is_nonzero_sequence_in_Q(b)
