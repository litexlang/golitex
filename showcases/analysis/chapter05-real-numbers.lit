        ? not $has_upper_bound(positive_reals_R)
        by contra:
            ? not $has_upper_bound(positive_reals_R)
            $has_upper_bound(positive_reals_R)
            obtain M from exist M R st {$is_upper_bound(positive_reals_R, M)}
            M <= abs(M)
            abs(M) < abs(M) + 1
            M <= abs(M) < abs(M) + 1
            M < abs(M) + 1
