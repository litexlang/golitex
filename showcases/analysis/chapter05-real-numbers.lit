prop is_positively_bounded_away_from_zero_by_in_Q(a seq(Q), c Q+):
    forall n N+:
        a(n) >= c
prop is_positively_bounded_away_from_zero_in_Q(a seq(Q)):
    exist c Q+ st {$is_positively_bounded_away_from_zero_by_in_Q(a, c)}
prop is_negatively_bounded_away_from_zero_by_in_Q(a seq(Q), c Q+):
    forall n N+:
        a(n) <= (-c)
prop is_negatively_bounded_away_from_zero_in_Q(a seq(Q)):
    exist c Q+ st {$is_negatively_bounded_away_from_zero_by_in_Q(a, c)}
claim:
    ? forall a seq(Q):
        $is_positively_bounded_away_from_zero_in_Q(a)
        =>:
            $is_bounded_away_from_zero_in_Q(a)
    obtain c from $is_positively_bounded_away_from_zero_in_Q(a)
    witness $is_bounded_away_from_zero_in_Q(a) from c:
        claim:
            ? forall n N+:
                abs(a(n)) >= c
            0 < c <= a(n)
            0 <= a(n)
            abs(a(n)) = a(n) >= c
        by def $is_bounded_away_from_zero_by_in_Q(a, c)
claim:
    ? forall a seq(Q):
        $is_negatively_bounded_away_from_zero_in_Q(a)
        =>:
            $is_bounded_away_from_zero_in_Q(a)
    obtain c from $is_negatively_bounded_away_from_zero_in_Q(a)
    witness $is_bounded_away_from_zero_in_Q(a) from c:
        claim:
            ? forall n N+:
                abs(a(n)) >= c
            a(n) <= (-c) < 0
            a(n) <= 0
            abs(a(n)) = -a(n) = 0 - a(n) >= 0 - (-c) = c
        by def $is_bounded_away_from_zero_by_in_Q(a, c)
sketch:
    have fn decimal_above_one_Q(n N+) Q = 1 + 1 / 10^n
    have fn negative_decimal_below_minus_one_Q(n N+) Q = -(1 + 1 / 10^n)
    have fn alternating_sign_Q(n N+) Q by cases:
        case n % 2 = 1: 1
        case n % 2 = 0: (-1)
    decimal_above_one_Q $in seq(Q)
    claim:
        ? forall n N+:
            decimal_above_one_Q(n) >= 1
        10^n > 0
        1 / 10^n > 0
        1 / 10^n $in Q
        0 <= 1 / 10^n
        1 = 1 + 0 <= 1 + 1 / 10^n
        1 + 1 / 10^n >= 1
        decimal_above_one_Q(n) = 1 + 1 / 10^n
        decimal_above_one_Q(n) >= 1
    by def $is_positively_bounded_away_from_zero_by_in_Q(decimal_above_one_Q, 1)
    witness $is_positively_bounded_away_from_zero_in_Q(decimal_above_one_Q) from 1
    by def $is_positively_bounded_away_from_zero_in_Q(decimal_above_one_Q)
    negative_decimal_below_minus_one_Q $in seq(Q)
    claim:
        ? forall n N+:
            negative_decimal_below_minus_one_Q(n) <= (-1)
        10^n > 0
        1 / 10^n > 0
        1 / 10^n $in Q
        0 <= 1 / 10^n
        1 = 1 + 0 <= 1 + 1 / 10^n
        1 + 1 / 10^n >= 1
        -(1 + 1 / 10^n) = 0 - (1 + 1 / 10^n) <= 0 - 1 = (-1)
        negative_decimal_below_minus_one_Q(n) = -(1 + 1 / 10^n)
        negative_decimal_below_minus_one_Q(n) <= (-1)
    by def $is_negatively_bounded_away_from_zero_by_in_Q(negative_decimal_below_minus_one_Q, 1)
    witness $is_negatively_bounded_away_from_zero_in_Q(negative_decimal_below_minus_one_Q) from 1
    by def $is_negatively_bounded_away_from_zero_in_Q(negative_decimal_below_minus_one_Q)
    claim:
        ? not $is_positively_bounded_away_from_zero_in_Q(alternating_sign_Q)
        by contra:
            ? not $is_positively_bounded_away_from_zero_in_Q(alternating_sign_Q)
            $is_positively_bounded_away_from_zero_in_Q(alternating_sign_Q)
            obtain c from $is_positively_bounded_away_from_zero_in_Q(alternating_sign_Q)
            alternating_sign_Q(2) = (-1)
            alternating_sign_Q(2) >= c
            (-1) >= c
            (-1) < 0 < c
            (-1) < c
            impossible -1 >= c
    claim:
        ? not $is_negatively_bounded_away_from_zero_in_Q(alternating_sign_Q)
        by contra:
            ? not $is_negatively_bounded_away_from_zero_in_Q(alternating_sign_Q)
            $is_negatively_bounded_away_from_zero_in_Q(alternating_sign_Q)
            obtain c from $is_negatively_bounded_away_from_zero_in_Q(alternating_sign_Q)
            (-c) < 0
            alternating_sign_Q(1) = 1
            alternating_sign_Q(1) <= (-c)
            1 <= (-c)
            (-c) < 0 < 1
            (-c) < 1
            impossible 1 <= (-c)
prop is_positive_real_by_cauchy_sequence(x R):
    exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x), $is_positively_bounded_away_from_zero_in_Q(a)}
prop is_negative_real_by_cauchy_sequence(x R):
    exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x), $is_negatively_bounded_away_from_zero_in_Q(a)}
forall x R:
    x > 0 or x = 0 or x < 0
forall x R:
    x > 0
    =>:
        x != 0
        not x = 0
        not x < 0
forall x R:
    x = 0
    =>:
        not x > 0
        not x < 0
forall x R:
    x < 0
    =>:
        x != 0
        not x = 0
        not x > 0
forall x R:
    x < 0
    =>:
        (-x) > 0
forall x R:
    (-x) > 0
    =>:
        -(-x) < 0
        -(-x) = x
        x < 0
forall x, y R:
    x > 0
    y > 0
    =>:
        x + y > 0
        x * y > 0
forall x R+:
    x > 0
    x != 0
claim:
    ? forall x R+:
        1 / x $in R+
        1 / x > 0
    0 < x
    0 = 0 / x < 1 / x
claim:
    ? forall x, y R+:
        x > y
        =>:
            1 / x < 1 / y
    y < x
    x * y > 0
    y / (x * y) < x / (x * y)
    y / (x * y) = 1 / x
    x / (x * y) = 1 / y
claim:
    ? forall x R:
        x > 0
        =>:
            abs(x) = x
    0 <= x
claim:
    ? forall x R:
        x < 0
        =>:
            abs(x) = (-x)
    x <= 0
forall x R:
    x = 0
    =>:
        abs(x) = 0
forall x R:
    abs(x) >= 0
forall x R:
    abs(x) = 0
    =>:
        x = 0
forall x, y R:
    abs(x + y) <= abs(x) + abs(y)
forall x, y R:
    x > y
    =>:
        x - y > 0
forall x, y R:
    x - y > 0
    =>:
        x > y
forall x, y R:
    x < y
    =>:
        x - y < 0
forall x, y R:
    x - y < 0
    =>:
        x < y
forall x, y R:
    x >= y
    =>:
        x > y or x = y
forall x, y R:
    x > y
    =>:
        x >= y
forall x, y R:
    x = y
    =>:
        x >= y
forall x, y R:
    x <= y
    =>:
        x < y or x = y
forall x, y R:
    x < y
    =>:
        x <= y
forall x, y R:
    x = y
    =>:
        x <= y
forall x, y R:
    dist_R(x, y) = abs(x - y)
    abs(x - y) >= 0
    dist_R(x, y) >= 0
forall x, y R:
    dist_R(x, y) = abs(x - y)
    dist_R(y, x) = abs(y - x)
    x - y = -(y - x)
    abs(x - y) = abs(-(y - x)) = abs(y - x)
    dist_R(x, y) = abs(x - y) = abs(y - x) = dist_R(y, x)
claim:
    ? forall a seq(Q), x R:
        $is_cauchy_sequence_in_Q(a)
        $has_formal_limit_in_Q(a, x)
        forall n N+:
            a(n) >= 0
        =>:
            x >= 0
    by contra:
        ? x >= 0
        not x >= 0
        x < 0
        (-x) > 0
        0 < (-x)
        0 = 0 / 2 < (-x) / 2
        (-x) / 2 $in R+
        $has_rational_sequence_limit_in_R(a, x)
        obtain n0 from exist n0 N+ st {$is_rational_sequence_tail_close_to_real(a, x, (-x) / 2, n0)}
        abs(a(n0) - x) < (-x) / 2
        a(n0) >= 0
        a(n0) - x >= 0 - x = (-x)
        a(n0) - x <= abs(a(n0) - x)
        abs(a(n0) - x) >= a(n0) - x >= (-x)
        (-x) > (-x) / 2
        abs(a(n0) - x) >= (-x) > (-x) / 2
        abs(a(n0) - x) > (-x) / 2
        (-x) / 2 < abs(a(n0) - x) < (-x) / 2
        impossible -x / 2 < (-x) / 2
thm pointwise_order_passes_to_formal_limits_in_Q:
    ? forall a, b seq(Q), x, y R:
        $is_cauchy_sequence_in_Q(a)
        $is_cauchy_sequence_in_Q(b)
        $has_formal_limit_in_Q(a, x)
        $has_formal_limit_in_Q(b, y)
        forall n N+:
            a(n) >= b(n)
        =>:
            x >= y
    by contra:
        ? x >= y
        not x >= y
        x < y
        y - x > 0
        0 < y - x
        0 = 0 / 3 < (y - x) / 3
        (y - x) / 3 $in R+
        $has_rational_sequence_limit_in_R(a, x)
        $has_rational_sequence_limit_in_R(b, y)
        obtain n1 from exist n1 N+ st {$is_rational_sequence_tail_close_to_real(a, x, (y - x) / 3, n1)}
        obtain n2 from exist n2 N+ st {$is_rational_sequence_tail_close_to_real(b, y, (y - x) / 3, n2)}
        have order_tail_start N+ = n1 + n2
        n1 <= order_tail_start
        n2 <= order_tail_start
        abs(a(order_tail_start) - x) < (y - x) / 3
        abs(b(order_tail_start) - y) < (y - x) / 3
        a(order_tail_start) - x <= abs(a(order_tail_start) - x) < (y - x) / 3
        a(order_tail_start) - x < (y - x) / 3
        a(order_tail_start) - x + x < (y - x) / 3 + x
        a(order_tail_start) - x + x = a(order_tail_start)
        (y - x) / 3 + x = x + (y - x) / 3
        a(order_tail_start) < x + (y - x) / 3
        y - b(order_tail_start) = -(b(order_tail_start) - y)
        abs(y - b(order_tail_start)) = abs(-(b(order_tail_start) - y)) = abs(b(order_tail_start) - y)
        y - b(order_tail_start) <= abs(y - b(order_tail_start)) = abs(b(order_tail_start) - y) < (y - x) / 3
        y - b(order_tail_start) < (y - x) / 3
        y - b(order_tail_start) + b(order_tail_start) < (y - x) / 3 + b(order_tail_start)
        y - b(order_tail_start) + b(order_tail_start) = y
        y < (y - x) / 3 + b(order_tail_start)
        y - (y - x) / 3 < (y - x) / 3 + b(order_tail_start) - (y - x) / 3 = b(order_tail_start)
        y - (y - x) / 3 < b(order_tail_start)
        a(order_tail_start) >= b(order_tail_start)
        y - (y - x) / 3 < b(order_tail_start) <= a(order_tail_start) < x + (y - x) / 3
        y - (y - x) / 3 < x + (y - x) / 3
        (y - x) / 3 = (y - x) / 3 + 0 < (y - x) / 3 + (y - x) / 3 = 2 * (y - x) / 3
        x + (y - x) / 3 < x + 2 * (y - x) / 3 = y - (y - x) / 3
        x + (y - x) / 3 < y - (y - x) / 3
        y - (y - x) / 3 < x + (y - x) / 3 < y - (y - x) / 3
        impossible y - (y - x) / 3 < y - (y - x) / 3
have fn one_plus_reciprocal_Q(k N+) Q = 1 + 1 / k
have fn one_minus_reciprocal_Q(k N+) Q = 1 - 1 / k
claim:
    ? forall i_index N+:
        one_plus_reciprocal_Q(i_index) > one_minus_reciprocal_Q(i_index)
    1 / i_index > 0
    2 / i_index > 0
    one_plus_reciprocal_Q(i_index) = 1 + 1 / i_index
    one_minus_reciprocal_Q(i_index) = 1 - 1 / i_index
    (1 + 1 / i_index) - (1 - 1 / i_index) = 2 / i_index
    1 + 1 / i_index > 1 - 1 / i_index
claim:
    ? forall epsilon Q+:
        $has_eventual_closeness_in_Q(one_plus_reciprocal_Q, one_minus_reciprocal_Q, epsilon)
    0 < epsilon
    0 = 0 / 2 < epsilon / 2
    epsilon / 2 $in R+
    release thm archimedean_property(epsilon / 2)
    obtain n0 from exist n0 N+ st {1 / n0 < epsilon / 2}
    witness $has_eventual_closeness_in_Q(one_plus_reciprocal_Q, one_minus_reciprocal_Q, epsilon) from n0:
        claim:
            ? forall n N+:
                n >= n0
                =>:
                    $chap4::is_close_in_Q(epsilon, one_plus_reciprocal_Q(n), one_minus_reciprocal_Q(n))
            n0 <= n
            n0 * n > 0
            n0 * n != 0
            1 / n = n0 / (n0 * n) <= n / (n0 * n) = 1 / n0 < epsilon / 2
            2 / n = 2 * (1 / n) < 2 * (epsilon / 2) = epsilon
            one_plus_reciprocal_Q(n) = 1 + 1 / n
            one_minus_reciprocal_Q(n) = 1 - 1 / n
            (1 + 1 / n) - (1 - 1 / n) = 2 / n
            one_plus_reciprocal_Q(n) - one_minus_reciprocal_Q(n) = (1 + 1 / n) - (1 - 1 / n) = 2 / n > 0
            0 <= one_plus_reciprocal_Q(n) - one_minus_reciprocal_Q(n)
            abs(one_plus_reciprocal_Q(n) - one_minus_reciprocal_Q(n)) = one_plus_reciprocal_Q(n) - one_minus_reciprocal_Q(n) = 2 / n
            abs(one_plus_reciprocal_Q(n) - one_minus_reciprocal_Q(n)) = 2 / n < epsilon
            chap4::dist_Q(one_plus_reciprocal_Q(n), one_minus_reciprocal_Q(n)) = abs(one_plus_reciprocal_Q(n) - one_minus_reciprocal_Q(n)) = 2 / n <= epsilon
            by def $chap4::is_close_in_Q(epsilon, one_plus_reciprocal_Q(n), one_minus_reciprocal_Q(n))
        by def $is_tail_close_in_Q(one_plus_reciprocal_Q, one_minus_reciprocal_Q, epsilon, n0)
by def $is_equivalent_cauchy_sequence_in_Q(one_plus_reciprocal_Q, one_minus_reciprocal_Q)
thm positive_builtin_real_has_positive_rational_representative:
    ? forall x R+:
        exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x), $is_positively_bounded_away_from_zero_in_Q(a)}
    release thm cauchy_sequence_representative_in_Q_exists(x)
    obtain a from exist a seq(Q) st {$is_cauchy_sequence_in_Q(a), $has_formal_limit_in_Q(a, x)}
    0 < x
    0 = 0 / 2 < x / 2
    x / 2 $in R+
    release thm archimedean_property(x / 2)
    obtain m from exist m N+ st {1 / m < x / 2}
    1 / m $in Q
    0 = 0 / m < 1 / m
    have c Q+ = 1 / m
    x / 2 = x / 2 + 0 < x / 2 + x / 2 = x
    c < x / 2 < x
    0 = c - c < x - c
    x - c $in R+
    $has_rational_sequence_limit_in_R(a, x)
    obtain n0 from exist n0 N+ st {$is_rational_sequence_tail_close_to_real(a, x, x - c, n0)}
    have fn b(n N+) Q by cases:
        case n < n0: c
        case n >= n0: a(n)
    forall n N+:
        n >= n0
        =>:
            b(n) = a(n)
    release thm finite_prefix_replacement_preserves_cauchy_and_formal_limit_in_Q(a, b, x, n0)
    claim:
        ? forall n N+:
            b(n) >= c
        n < n0 or n >= n0
        by cases:
            ? b(n) >= c
            case n < n0:
                b(n) = c
                b(n) >= c
            case n >= n0:
                b(n) = a(n)
                abs(a(n) - x) < x - c
                x - a(n) = -(a(n) - x)
                x - a(n) <= abs(x - a(n)) = abs(-(a(n) - x)) = abs(a(n) - x)
                x - a(n) <= abs(a(n) - x) < x - c
                x - a(n) < x - c
                (x - c) - (x - a(n)) > 0
                (x - c) - (x - a(n)) = a(n) - c
                a(n) - c > 0
                a(n) > c
                a(n) >= c
                b(n) >= c
    witness $is_positively_bounded_away_from_zero_in_Q(b) from c:
        by def $is_positively_bounded_away_from_zero_by_in_Q(b, c)
    witness exist b0 seq(Q) st {$is_cauchy_sequence_in_Q(b0), $has_formal_limit_in_Q(b0, x), $is_positively_bounded_away_from_zero_in_Q(b0)} from b
claim:
    ? forall x R+:
        $is_positive_real_by_cauchy_sequence(x)
    release thm positive_builtin_real_has_positive_rational_representative(x)
    by def $is_positive_real_by_cauchy_sequence(x)
claim:
    ? forall q Q:
        $is_cauchy_sequence_in_Q(fn(n N+) Q {q})
    claim:
        ? forall epsilon Q+:
            $has_eventual_epsilon_steadiness_in_Q(fn(n N+) Q {q}, epsilon)
        witness $has_eventual_epsilon_steadiness_in_Q(fn(n N+) Q {q}, epsilon) from 1:
            forall j, k N+:
                j >= 1
                k >= 1
                =>:
                    $chap4::is_close_in_Q(epsilon, fn(n N+) Q {q}(j), fn(n N+) Q {q}(k))
            by def $is_tail_epsilon_steady_in_Q(fn(n N+) Q {q}, epsilon, 1)
    by def $is_cauchy_sequence_in_Q(fn(n N+) Q {q})
have fn constant_sequence_Q(q Q) seq(Q) = fn(k N+) Q {q}
claim:
    ? forall q Q:
        $has_formal_limit_in_Q(constant_sequence_Q(q), q)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_rational_sequence_tail_close_to_real(constant_sequence_Q(q), q, epsilon, n0)}
        witness exist n0 N+ st {$is_rational_sequence_tail_close_to_real(constant_sequence_Q(q), q, epsilon, n0)} from 1:
            forall n N+:
                n >= 1
                =>:
                    constant_sequence_Q(q)(n) = q
                    constant_sequence_Q(q)(n) - q = 0
                    abs(constant_sequence_Q(q)(n) - q) = abs(0) = 0
                    0 < epsilon
                    abs(constant_sequence_Q(q)(n) - q) < epsilon
            by def $is_rational_sequence_tail_close_to_real(constant_sequence_Q(q), q, epsilon, 1)
    by def $has_rational_sequence_limit_in_R(constant_sequence_Q(q), q)
    by def $has_formal_limit_in_Q(constant_sequence_Q(q), q)
thm positive_representative_lower_bound_passes_to_limit:
    ? forall a seq(Q), x R, q Q+:
        $is_cauchy_sequence_in_Q(a)
        $has_formal_limit_in_Q(a, x)
        $is_positively_bounded_away_from_zero_by_in_Q(a, q)
        =>:
            q <= x
    $is_cauchy_sequence_in_Q(constant_sequence_Q(q))
    $has_formal_limit_in_Q(constant_sequence_Q(q), q)
    claim:
        ? forall n N+:
            a(n) >= constant_sequence_Q(q)(n)
        constant_sequence_Q(q)(n) = q
        a(n) >= q = constant_sequence_Q(q)(n)
    release thm pointwise_order_passes_to_formal_limits_in_Q(a, constant_sequence_Q(q), x, q)
claim:
    ? forall x R+:
        exist q Q+ st {q <= x}
    $is_positive_real_by_cauchy_sequence(x)
    obtain a from $is_positive_real_by_cauchy_sequence(x)
    obtain q from $is_positively_bounded_away_from_zero_in_Q(a)
    $has_formal_limit_in_Q(a, x)
    $is_positively_bounded_away_from_zero_by_in_Q(a, q)
    release thm positive_representative_lower_bound_passes_to_limit(a, x, q)
    witness exist q0 Q+ st {q0 <= x} from q
claim:
    ? forall x R+:
        exist n_bound N+ st {x <= n_bound}
    1 / x $in R+
    release thm archimedean_property(1 / x)
    obtain n from exist n N+ st {1 / n < 1 / x}
    n * x > 0
    (1 / n) * (n * x) < (1 / x) * (n * x)
    (1 / n) * (n * x) = x
    (1 / x) * (n * x) = n
    x < n
    witness exist n0 N+ st {x <= n0} from n
claim:
    ? forall x, epsilon R+:
        exist M N+ st {M * epsilon > x}
    0 < epsilon
    release thm real_archimedean_natural_upper_bound(x / epsilon)
    obtain n from exist n N+ st {x / epsilon < n}
    x = (x / epsilon) * epsilon < n * epsilon
    witness exist M N+ st {M * epsilon > x} from n
thm rational_density_of_reals:
    ? forall x, y R:
        x < y
        =>:
            exist q Q st {x < q < y}
    release thm has_rational_between(x, y)
prop is_upper_bound(E set, M R):
    E $subset R
    forall x E:
        x <= M
prop has_upper_bound(E set):
    E $subset R
    exist M R st {$is_upper_bound(E, M)}
sketch:
