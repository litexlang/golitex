            impossible y^n = y^n
        case y = candidate_root:
            y = candidate_root = x^(1 / n)
        case y > candidate_root:
            y^n > candidate_root^n = x = y^n
            impossible y^n = y^n
thm nonnegative_root_strict_mono_forward:
    ? forall x, y R, n N+:
        x >= 0
        y >= 0
        x > y
        1 / n $in R+
        =>:
            x^(1 / n) > y^(1 / n)
    release thm nth_root_nonnegative(x, n)
    release thm nth_root_nonnegative(y, n)
    release thm nth_root_power_identity_nonnegative(x, n)
    release thm nth_root_power_identity_nonnegative(y, n)
    have root_x R = x^(1 / n)
    have root_y R = y^(1 / n)
    0 <= root_x
    0 <= root_y
    root_x^n = (x^(1 / n))^n = x
    root_y^n = (y^(1 / n))^n = y
    by cases:
        ? x^(1 / n) > y^(1 / n)
        case root_x <= root_y:
            root_x^n <= root_y^n
            x = root_x^n <= root_y^n = y
            impossible x > y
        case root_x > root_y:
            x^(1 / n) = root_x > root_y = y^(1 / n)
thm nonnegative_root_strict_mono_reverse:
    ? forall x, y R, n N+:
        x >= 0
        y >= 0
        1 / n $in R+
        x^(1 / n) > y^(1 / n)
        =>:
            x > y
    release thm nth_root_nonnegative(y, n)
    release thm nth_root_power_identity_nonnegative(x, n)
    release thm nth_root_power_identity_nonnegative(y, n)
    have root_x R = x^(1 / n)
    have root_y R = y^(1 / n)
    0 <= root_y
    root_x > root_y
    root_x^n $in R
    root_y^n $in R
    root_x^n > root_y^n
    root_x^n = (x^(1 / n))^n = x
    root_y^n = (y^(1 / n))^n = y
    x = root_x^n > root_y^n = y
thm nth_root_product_nonnegative:
    ? forall x, y R, n N+:
        x >= 0
        y >= 0
        =>:
            (x * y)^(1 / n) = x^(1 / n) * y^(1 / n)
    1 / n $in R+
    0 <= x
    0 <= y
    x * y >= 0
    release thm nth_root_nonnegative(x, n)
    release thm nth_root_nonnegative(y, n)
    x^(1 / n) $in R
    y^(1 / n) $in R
    x^(1 / n) * y^(1 / n) $in R
    0 <= x^(1 / n)
    0 <= y^(1 / n)
    x^(1 / n) * y^(1 / n) >= 0
    release thm nth_root_power_identity_nonnegative(x, n)
    release thm nth_root_power_identity_nonnegative(y, n)
    (x^(1 / n) * y^(1 / n))^n = (x^(1 / n))^n * (y^(1 / n))^n = x * y
    release thm nth_root_unique_nonnegative(x * y, x^(1 / n) * y^(1 / n), n)
thm nth_root_nested_positive:
    ? forall x R+, n, m N+:
        (x^(1 / n))^(1 / m) = x^(1 / (n * m))
    n * m > 0
    n * m != 0
    (1 / n) * (1 / m) = 1 / (n * m)
    release thm positive_real_power_power_law(x, 1 / n, 1 / m)
    x^((1 / n) * (1 / m)) = x^(1 / (n * m))
forall k N+:
    1^(1 / k) = 1
thm positive_natural_power_injective:
    ? forall y, z R+, n N+:
        y^n = z^n
        =>:
            y = z
    y >= 0
    z >= 0
    y^n >= 0
    z^n >= 0
    release thm nth_root_unique_nonnegative(y^n, y, n)
    y = (y^n)^(1 / n)
    release thm nth_root_unique_nonnegative(z^n, z, n)
    z = (z^n)^(1 / n)
    y^n = z^n
    (y^n)^(1 / n) = (z^n)^(1 / n)
forall x R+, q Q:
    x^q > 0
claim:
    ? forall x R+, q, r Q:
        x^(q + r) = x^q * x^r
    release thm positive_real_power_add_law(x, q, r)
claim:
    ? forall x R+, q, r Q:
        (x^q)^r = x^(q * r)
    release thm positive_real_power_power_law(x, q, r)
claim:
    ? forall x R+, q Q:
        x^q > 0
        x^q != 0
    0 < x
    0 < x^q
claim:
    ? forall x R+, q Q:
        x^q != 0
        =>:
            x^q * x^(-q) = x^(q + (-q))
            q + (-q) = 0
            x^(q + (-q)) = x^0
            x^0 = 1
            x^q * x^(-q) = 1
            x^(-q) = 1 / x^q
    0 < x
    0 < x^q
    x^q != 0
    x^q * x^(-q) = x^(q + (-q))
    q + (-q) = 0
    x^(q + (-q)) = x^0 = 1
    x^q * x^(-q) = 1
    x^(-q) = (x^q * x^(-q)) / x^q = 1 / x^q
thm rational_power_fraction_representation:
    ? forall x R+, a, a_prime Z, b, b_prime N+:
        a / b = a_prime / b_prime
        =>:
            (x^(1 / b_prime))^a_prime = (x^(1 / b))^a
    (1 / b_prime) * a_prime = a_prime / b_prime
    (1 / b) * a = a / b
    (x^(1 / b_prime))^a_prime = x^((1 / b_prime) * a_prime) = x^(a_prime / b_prime)
    (x^(1 / b))^a = x^((1 / b) * a) = x^(a / b)
    (x^(1 / b_prime))^a_prime = x^(a_prime / b_prime) = x^(a / b) = (x^(1 / b))^a
thm rational_power_strict_mono_forward:
    ? forall x, y R+, q Q:
        q > 0
        x > y
        =>:
            x^q > y^q
    release thm chap4::rational_has_positive_denominator_representation(q)
    obtain a, b from exist a Z, b N+ st {q = a / b}
    0 < b
    0 < q
    0 * b < q * b
    q * b = (a / b) * b = a
    0 < a
    a $in N+
    1 / b $in R+
    0 <= x
    0 <= y
    release thm nonnegative_root_strict_mono_forward(x, y, b)
    have root_x R+ = x^(1 / b)
    have root_y R+ = y^(1 / b)
    root_x > root_y
    root_x^a > root_y^a
    (x^(1 / b))^a = x^((1 / b) * a)
    (y^(1 / b))^a = y^((1 / b) * a)
    (1 / b) * a = a / b = q
    x^q = (x^(1 / b))^a
    y^q = (y^(1 / b))^a
    x^q = (x^(1 / b))^a = root_x^a
    y^q = (y^(1 / b))^a = root_y^a
    x^q = root_x^a > root_y^a = y^q
thm rational_power_strict_mono_reverse:
    ? forall x, y R+, q Q:
        q > 0
        x^q > y^q
        =>:
            x > y
    0 < q
    q != 0
    1 / q $in Q
    0 = 0 / q < 1 / q
    0 < x
    0 < y
    x^q $in R+
    y^q $in R+
    release thm rational_power_strict_mono_forward(x^q, y^q, 1 / q)
    q * (1 / q) = 1
    (x^q)^(1 / q) > (y^q)^(1 / q)
    (x^q)^(1 / q) = x^(q * (1 / q)) = x^1 = x
    (y^q)^(1 / q) = y^(q * (1 / q)) = y^1 = y
thm reciprocal_decreases_on_positive:
    ? forall k, l N+:
        k < l
        =>:
            1 / k > 1 / l
    0 < k
    0 < l
    0 < k * l
    k * l != 0
    k / (k * l) < l / (k * l)
    k / (k * l) = 1 / l
    l / (k * l) = 1 / k
thm positive_base_power_above_one:
    ? forall x R+, s Q:
        x > 1
        s > 0
        =>:
            x^s > 1
    have one R+ = 1
    x^s > one^s = 1^s = 1
thm positive_base_power_below_one:
    ? forall x R+, s Q:
        x < 1
        s > 0
        =>:
            x^s < 1
    have one R+ = 1
    x^s < one^s = 1^s = 1
thm positive_reciprocal_below_one_when_above_one:
    ? forall a R+:
        a > 1
        =>:
            1 / a < 1
    1 / a < a / a
    a / a = 1
thm positive_base_power_at_most_one_for_nonpositive_exp:
    ? forall x R+, s Q:
        x > 1
        s <= 0
        =>:
            x^s <= 1
    s = 0 or s < 0
    by cases:
        ? x^s <= 1
        case s = 0:
            x^s = x^0 = 1
        case s < 0:
            (-s) > 0
            release thm positive_base_power_above_one(x, -s)
            have a R+ = x^(-s)
            release thm positive_reciprocal_below_one_when_above_one(a)
            0 < x
            0 < x^(-s)
            x^(-s) != 0
            x^(-(-s)) = 1 / x^(-s)
            -(-s) = s
            x^s = x^(-(-s)) = 1 / x^(-s)
            x^s = 1 / x^(-s) = 1 / a < 1
thm positive_base_power_at_most_one_below_one_for_nonnegative_exp:
    ? forall x R+, s Q:
        x < 1
        s >= 0
        =>:
            x^s <= 1
    s = 0 or s > 0
    by cases:
        ? x^s <= 1
        case s = 0:
            x^s = x^0 = 1
        case s > 0:
            release thm positive_base_power_below_one(x, s)
thm rational_power_exponent_strict_mono_above_one:
    ? forall x R+, q, r Q:
        x > 1
        q > r
        =>:
            x^q > x^r
    q - r > 0
    release thm positive_base_power_above_one(x, q - r)
    0 < x
    x^r $in R
    x^(q - r) $in R
    x^r * x^(q - r) $in R
    r + (q - r) = q
    x^r $in R+
    x^r > 0
    x^r * x^(q - r) > x^r * 1
    x^r * 1 = x^r
    x^q = x^(r + (q - r)) = x^r * x^(q - r) > x^r * 1 = x^r
thm rational_power_exponent_strict_mono_above_one_reverse:
    ? forall x R+, q, r Q:
        x > 1
        x^q > x^r
        =>:
            q > r
    by contra:
        ? q > r
        q <= r
        q - r <= 0
        release thm positive_base_power_at_most_one_for_nonpositive_exp(x, q - r)
        0 < x
        x^r $in R
        x^(q - r) $in R
        x^r * x^(q - r) $in R
        r + (q - r) = q
        x^r $in R+
        x^r >= 0
        x^r * x^(q - r) <= x^r * 1
        x^r * 1 = x^r
        x^q = x^(r + (q - r)) = x^r * x^(q - r) <= x^r * 1 = x^r
        impossible x^q > x^r
thm rational_power_exponent_strict_antimono_below_one:
    ? forall x R+, q, r Q:
        x < 1
        q > r
        =>:
            x^q < x^r
    q - r > 0
    release thm positive_base_power_below_one(x, q - r)
    0 < x
    x^r $in R
    x^(q - r) $in R
    x^r * x^(q - r) $in R
    r + (q - r) = q
    x^r $in R+
    x^r > 0
    x^r * x^(q - r) < x^r * 1
    x^r * 1 = x^r
    x^q = x^(r + (q - r)) = x^r * x^(q - r) < x^r * 1 = x^r
thm rational_power_exponent_strict_antimono_below_one_reverse:
    ? forall x R+, q, r Q:
        x < 1
        x^q > x^r
        =>:
            q < r
    by contra:
        ? q < r
        q >= r
        q - r >= 0
        release thm positive_base_power_at_most_one_below_one_for_nonnegative_exp(x, q - r)
        0 < x
        x^r $in R
        x^(q - r) $in R
        x^r * x^(q - r) $in R
        r + (q - r) = q
        x^r $in R+
        x^r >= 0
        x^r * x^(q - r) <= x^r * 1
        x^r * 1 = x^r
        x^q = x^(r + (q - r)) = x^r * x^(q - r) <= x^r * 1 = x^r
        impossible x^q > x^r
thm nth_roots_decrease_above_one:
    ? forall x R+, k, l N+:
        x > 1
        k < l
        =>:
            x^(1 / k) > x^(1 / l)
    release thm reciprocal_decreases_on_positive(k, l)
    release thm rational_power_exponent_strict_mono_above_one(x, 1 / k, 1 / l)
thm nth_roots_increase_below_one:
    ? forall x R+, k, l N+:
        x < 1
        k < l
        =>:
            x^(1 / k) < x^(1 / l)
    release thm reciprocal_decreases_on_positive(k, l)
    release thm rational_power_exponent_strict_antimono_below_one(x, 1 / k, 1 / l)
