            have larger_positive_real R = abs(M) + 1
            larger_positive_real = abs(M) + 1
            larger_positive_real $in {x R: x > 0}
            abs(M) + 1 $in {x R: x > 0}
            abs(M) + 1 $in positive_reals_R
            abs(M) + 1 <= M
            impossible abs(M) + 1 <= M
thm empty_set_upper_bound:
    ? forall M R:
        $is_upper_bound({}, M)
    claim:
        ? forall x {}:
            x $in R
        by contra:
            ? x $in R
            not $is_nonempty_set({})
            witness $is_nonempty_set({}) from x
            impossible $is_nonempty_set({})
    by def {} $subset R
    claim:
        ? forall x {}:
            x <= M
        by contra:
            ? x <= M
            not $is_nonempty_set({})
            witness $is_nonempty_set({}) from x
            impossible $is_nonempty_set({})
    forall x {}:
        x <= M
    by def $is_upper_bound({}, M)
prop is_least_upper_bound(E set, M R):
    E $subset R
    $is_upper_bound(E, M)
    forall B R:
        $is_upper_bound(E, B)
        =>:
            M <= B
prop has_least_upper_bound(E set):
    exist M R st {$is_least_upper_bound(E, M)}
prop is_nonempty_subset_of_reals(E set):
    E $subset R
    $is_nonempty_set(E)
prop is_nonempty_bounded_above_subset_of_reals(E set):
    $is_nonempty_subset_of_reals(E)
    $has_upper_bound(E)
sketch:
    have unit_interval_R set = {x R: 0 <= x and x <= 1}
    claim:
        ? unit_interval_R $subset R
        claim:
            ? forall y unit_interval_R:
                y $in R
            unit_interval_R = {x R: 0 <= x and x <= 1}
            y $in {x R: 0 <= x and x <= 1}
        by def unit_interval_R $subset R
    forall x unit_interval_R:
        x <= 1
    by def $is_upper_bound(unit_interval_R, 1)
    unit_interval_R $subset R
    $is_upper_bound(unit_interval_R, 1)
    claim:
        ? forall B R:
            $is_upper_bound(unit_interval_R, B)
            =>:
                1 <= B
        0 <= 1
        0 <= 1 and 1 <= 1
        1 $in {x R: 0 <= x and x <= 1}
        1 $in unit_interval_R
    forall B R:
        $is_upper_bound(unit_interval_R, B)
        =>:
            1 <= B
    by def $is_least_upper_bound(unit_interval_R, 1)
    claim:
