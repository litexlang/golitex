    have positive_reals_R set = {x R: x > 0}
    claim:
        ? positive_reals_R $subset R
        claim:
            ? forall y positive_reals_R:
                y $in R
            positive_reals_R = {x R: x > 0}
            y $in {x R: x > 0}
        by def positive_reals_R $subset R
