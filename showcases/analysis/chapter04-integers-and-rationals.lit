have fn dist_Q(x, y Q) Q = abs(x - y)
thm rational_distance_formula:
    ? forall x, y Q:
        dist_Q(x, y) = abs(x - y)
forall x Q:
    abs(x) >= 0
forall x Q:
    abs(x) = 0
    =>:
        x = 0
claim:
    ? forall x Q:
        x != 0
        =>:
            abs(x) > 0
    by contra:
        ? abs(x) > 0
        abs(x) >= 0
        abs(x) <= 0
        abs(x) = 0
        x = 0
        impossible x = 0
claim:
    ? forall x, y Q:
        (-y) <= x
        x <= y
        =>:
            y >= abs(x)
    by cases:
        ? y >= abs(x)
        case 0 <= x:
            abs(x) = x <= y
        case x < 0:
            x <= 0
            abs(x) = -x = 0 - x <= 0 - (-y) = y
thm rational_abs_upper_bound_gives_two_sided_bound:
    ? forall x, y Q:
        y >= abs(x)
        =>:
            (-y) <= x
            x <= y
    -y = 0 - y <= 0 - abs(x) <= x
    x <= abs(x) <= y
forall x, y Q:
    =>:
        (-y) <= x
        x <= y
    <=>:
        y >= abs(x)
claim:
    ? forall x Q:
        x <= abs(x)
        (-x) <= abs(x)
    -x <= abs(-x) = abs(x)
forall x, y Q:
    abs(x * y) = abs(x) * abs(y)
forall x Q:
    abs(-x) = abs(x)
forall x, y Q:
    abs(x + y) <= abs(x) + abs(y)
thm rational_distance_nonnegative:
    ? forall x, y Q:
        dist_Q(x, y) >= 0
    dist_Q(x, y) = abs(x - y)
    abs(x - y) >= 0
thm equal_rationals_have_zero_distance:
    ? forall x, y Q:
        x = y
        =>:
            dist_Q(x, y) = 0
    dist_Q(x, y) = abs(x - y) = abs(0) = 0
thm zero_rational_distance_gives_equality:
    ? forall x, y Q:
        dist_Q(x, y) = 0
        =>:
            x = y
    dist_Q(x, y) = abs(x - y)
    abs(x - y) = 0
    x - y = 0
    x = x - y + y = y
thm rational_distance_is_symmetric:
    ? forall x, y Q:
        dist_Q(x, y) = dist_Q(y, x)
    dist_Q(x, y) = abs(x - y)
    dist_Q(y, x) = abs(y - x)
    x - y = -(y - x)
    abs(x - y) = abs(-(y - x)) = abs(y - x)
    dist_Q(x, y) = abs(x - y) = abs(y - x) = dist_Q(y, x)
thm rational_distance_triangle_inequality:
    ? forall x, y, z Q:
        dist_Q(x, z) <= dist_Q(x, y) + dist_Q(y, z)
    dist_Q(x, z) = abs(x - z)
    dist_Q(x, y) = abs(x - y)
    dist_Q(y, z) = abs(y - z)
    x - z = (x - y) + (y - z)
    abs(x - z) = abs((x - y) + (y - z))
    abs((x - y) + (y - z)) <= abs(x - y) + abs(y - z)
    dist_Q(x, z) = abs(x - z) <= abs(x - y) + abs(y - z) = dist_Q(x, y) + dist_Q(y, z)
prop is_close_in_Q(epsilon Q+, x, y Q):
    dist_Q(x, y) <= epsilon
sketch:
    dist_Q(0.99, 1.01) = abs(0.99 - 1.01) = abs(-0.02) = 0.02
    0.02 <= 0.1
    by def $is_close_in_Q(0.1, 0.99, 1.01)
    0.02 > 0.01
    claim:
        ? not $is_close_in_Q(0.01, 0.99, 1.01)
        by contra:
            ? not $is_close_in_Q(0.01, 0.99, 1.01)
            impossible 0.02 <= 0.01
    claim:
        ? forall epsilon Q+:
            $is_close_in_Q(epsilon, 2, 2)
        dist_Q(2, 2) = abs(2 - 2) = 0
        0 <= epsilon
        by def $is_close_in_Q(epsilon, 2, 2)
thm rational_closeness_is_reflexive:
    ? forall epsilon Q+, x Q:
        $is_close_in_Q(epsilon, x, x)
    dist_Q(x, x) = abs(x - x) = 0
    0 <= epsilon
    by def $is_close_in_Q(epsilon, x, x)
claim:
    ? forall epsilon, epsilon_prime Q+, x, y Q:
        $is_close_in_Q(epsilon, x, y)
        epsilon_prime > epsilon
        =>:
            $is_close_in_Q(epsilon_prime, x, y)
    dist_Q(x, y) <= epsilon < epsilon_prime
    by def $is_close_in_Q(epsilon_prime, x, y)
claim:
    ? forall x, y Q:
        forall epsilon Q+:
            $is_close_in_Q(epsilon, x, y)
        =>:
            x = y
    by contra:
        ? x = y
