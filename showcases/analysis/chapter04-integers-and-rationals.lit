    (1 / x) * x = 1
forall a, b N+:
    a / b > 0
claim:
    ? forall x Q:
        x > 0
        =>:
            exist a0 N+, b0 N+ st {x = a0 / b0}
    obtain a, b from exist a Z, b Z* st {x = a / b}
    b > 0 or b = 0 or b < 0
    by cases:
        ? exist a0 N+, b0 N+ st {x = a0 / b0}
        case b > 0:
            a / b > 0
            a = a / b * b > 0 * b = 0
            a $in N
            a $in N+
            b $in Z
            b $in N
            b $in N+
            witness exist a0 N+, b0 N+ st {x = a0 / b0} from a,b
        case b = 0:
            impossible b != 0
        case b < 0:
            have b0 Z = (-b)
            b0 = (-b) = 0 - b > 0
            b0 $in N
            b0 $in N+
            have a0 Z = (-a)
            a / b = (-a) / (-b) = a0 / b0
            a0 / b0 > 0
            a0 = a0 / b0 * b0 > 0 * b0 = 0
            a0 $in N
            a0 $in N+
            witness exist a1 N+, b1 N+ st {x = a1 / b1} from a0,b0
