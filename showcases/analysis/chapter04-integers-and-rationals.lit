            abs(x^n) = (abs(x^n) * abs(x^k)) / abs(x^k) = 1 / abs(x^k) = 1 / abs(x)^k = abs(x)^(-k) = abs(x)^n
thm rational_has_positive_denominator_representation:
    ? forall x Q:
        exist a0 Z, b0 N+ st {x = a0 / b0}
    obtain a, b from exist a Z, b Z* st {x = a / b}
    b > 0 or b = 0 or b < 0
    by cases:
        ? exist a0 Z, b0 N+ st {x = a0 / b0}
        case b > 0:
            b $in Z
            b >= 0
            b $in N
            b $in N+
            witness exist a0 Z, b0 N+ st {x = a0 / b0} from a,b
        case b = 0:
            impossible b != 0
        case b < 0:
            0 - b > 0
            0 - b $in Z
            0 - b >= 0
            0 - b $in N
            0 - b $in N+
            (-b) = 0 - b
            (-b) $in N+
            a / b = (-a) / (-b)
            witness exist a0 Z, b0 N+ st {x = a0 / b0} from (-a),(-b)
claim:
    ? forall a Z, d N+:
        exist! q Z st {a = d * q + a % d}
    claim:
        ? forall q1 Z, q2 Z:
            a = d * q1 + a % d
            a = d * q2 + a % d
            =>:
                q1 = q2
        d * q1 = (d * q1 + a % d) - a % d = a - a % d = (d * q2 + a % d) - a % d = d * q2
        d != 0
        q1 = (d * q1) / d = (d * q2) / d = q2
    witness exist! q Z st {a = d * q + a % d} from quot(a, d)
have fn integer_quotient by exist!:
    ? forall a Z, d N+:
        exist! q Z st {a = d * q + a % d}
thm rational_quotient_integer_interval_exists:
    ? forall a Z, b N+:
        exist m Z st {m <= a / b, a / b < m + 1}
    have n Z = integer_quotient(a, b)
    a = b * integer_quotient(a, b) + a % b = b * n + a % b
    0 <= a % b
    a % b < b
    b * n <= b * n + a % b = a
    n <= a / b
    a = b * n + a % b < b * n + b = b * (n + 1)
    a / b < (b * (n + 1)) / b = n + 1
    witness exist m Z st {m <= a / b, a / b < m + 1} from n
thm rational_integer_interval_exists:
    ? forall x Q:
        exist n Z st {n <= x, x < n + 1}
    release thm rational_has_positive_denominator_representation(x)
    obtain a, b from exist a Z, b N+ st {x = a / b}
    release thm rational_quotient_integer_interval_exists(a, b)
    obtain m from exist m Z st {m <= a / b, a / b < m + 1}
    witness exist n Z st {n <= x, x < n + 1} from m
thm rational_integer_interval_is_unique:
    ? forall x Q, n, m Z:
        n <= x
        x < n + 1
        m <= x
        x < m + 1
        =>:
            n = m
    claim:
        ? m <= n
        m <= n or m > n
        by cases:
            ? m <= n
            case m <= n:
                m <= n
            case m > n:
                n < m
                n + 1 <= m
                x < n + 1 <= m
                x < m
                impossible m <= x
    claim:
        ? n <= m
        n <= m or n > m
        by cases:
            ? n <= m
            case n <= m:
                n <= m
            case n > m:
                m < n
                m + 1 <= n
                x < m + 1 <= n
                x < n
                impossible n <= x
thm natural_upper_bound_for_rational:
    ? forall x Q:
        exist n N st {n > x}
    release thm rational_integer_interval_exists(x)
    obtain m from exist m Z st {m <= x, x < m + 1}
    m >= 0 or m < 0
    by cases:
        ? exist n N st {n > x}
        case m >= 0:
            have n N = m + 1
            witness exist k N st {k > x} from n
        case m < 0:
            m + 1 <= 0
            x < m + 1 <= 0 < 1
            witness exist n N st {n > x} from 1
thm rationals_are_dense:
    ? forall x, y Q:
        x < y
        =>:
            exist z Q st {x < z < y}
    2 * x = x + x < x + y
    x + y < y + y = 2 * y
    x = (2 * x) / 2 < (x + y) / 2
    (x + y) / 2 < (2 * y) / 2 = y
    witness exist z Q st {x < z < y} from (x + y) / 2
thm integer_square_multiple_of_two_has_even_base:
    ? forall p, r Z:
        p^2 = 2 * r
        =>:
            p % 2 = 0
    0 < 2
    p^2 $in Z
    2 * r = 2 * r + 0
    p^2 = 2 * r = 2 * r + 0
    p^2 % 2 = 0
    p % 2 = 0 or p % 2 = 1
    by cases:
        ? p % 2 = 0
        case p % 2 = 0:
            p % 2 = 0
        case p % 2 = 1:
            p^2 % 2 = ((p % 2)^2) % 2 = (1^2) % 2 = 1
            impossible p^2 % 2 = 0
thm rational_reduced_fraction_parity_witness:
    ? forall x Q:
        exist p Z, q N+ st {x = p / q, p % 2 != 0 or q % 2 != 0}
    release thm rational_has_unique_reduced_fraction(x)
    obtain p, q from exist! p Z, q N+ st {x = p / q, gcd(p, q) = 1}
    claim:
        ? p % 2 != 0 or q % 2 != 0
        p % 2 = 0 or p % 2 = 1
        by cases:
            ? p % 2 != 0 or q % 2 != 0
            case p % 2 = 0:
                q % 2 = 0 or q % 2 = 1
                by cases:
                    ? p % 2 != 0 or q % 2 != 0
                    case q % 2 = 0:
                        2 <= gcd(p, q) = 1
                        impossible 2 <= 1
                    case q % 2 = 1:
                        q % 2 != 0
            case p % 2 = 1:
                p % 2 != 0
    witness exist p0 Z, q0 N+ st {x = p0 / q0, p0 % 2 != 0 or q0 % 2 != 0} from p, q
thm rational_square_not_two:
    ? forall x Q:
        x^2 != 2
    by contra:
        ? x^2 != 2
        release thm rational_reduced_fraction_parity_witness(x)
        obtain p, q from exist p Z, q N+ st {x = p / q, p % 2 != 0 or q % 2 != 0}
        (p / q)^2 = x^2 = 2
        p^2 / q^2 = (p / q)^2 = 2
        p^2 = (p^2 / q^2) * q^2 = 2 * q^2
        release thm integer_square_multiple_of_two_has_even_base(p, q^2)
        have s Z = integer_quotient(p, 2)
        p = 2 * integer_quotient(p, 2) + p % 2 = 2 * s + p % 2 = 2 * s
        2 * q^2 = p^2 = (2 * s)^2 = 4 * s^2
        q^2 = (2 * q^2) / 2 = (4 * s^2) / 2 = 2 * s^2
        release thm integer_square_multiple_of_two_has_even_base(q, s^2)
        by cases:
            ? q % 2 != 0
            case p % 2 != 0:
                impossible p % 2 = 0
            case q % 2 != 0:
                q % 2 != 0
        impossible q % 2 = 0
prop is_rational_sqrt_two_gap_witness(epsilon Q+, x Q):
    x >= 0
    x^2 < 2
    2 < (x + epsilon)^2
thm rational_sqrt_two_no_gap_step:
    ? forall epsilon Q+, y Q:
        not exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
        y >= 0
        y^2 < 2
        =>:
            (y + epsilon)^2 < 2
    claim:
        ? not 2 < (y + epsilon)^2
        by contra:
            ? not 2 < (y + epsilon)^2
            by def $is_rational_sqrt_two_gap_witness(epsilon, y)
            impossible not $is_rational_sqrt_two_gap_witness(epsilon, y)
    release thm rational_square_not_two(y + epsilon)
    (y + epsilon)^2 != 2
    (y + epsilon)^2 < 2 or (y + epsilon)^2 = 2 or (y + epsilon)^2 > 2
    by cases:
        ? (y + epsilon)^2 < 2
        case (y + epsilon)^2 < 2:
            (y + epsilon)^2 < 2
        case (y + epsilon)^2 = 2:
            impossible (y + epsilon)^2 != 2
        case (y + epsilon)^2 > 2:
            impossible not 2 < (y + epsilon)^2
thm rational_sqrt_two_no_gap_forces_each_multiple_below_two:
    ? forall epsilon Q+, n N:
        not exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
        =>:
            (n * epsilon)^2 < 2
    by induc n from 0:
        ? (n * epsilon)^2 < 2
        ? from n = 0:
            (0 * epsilon)^2 = 0 < 2
        ? induc:
            n * epsilon >= 0
            release thm rational_sqrt_two_no_gap_step(epsilon, n * epsilon)
            (n * epsilon + epsilon)^2 < 2
            (n + 1) * epsilon = n * epsilon + epsilon
            ((n + 1) * epsilon)^2 = (n * epsilon + epsilon)^2 < 2
thm rational_sqrt_two_gap:
    ? forall epsilon Q+:
        exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
    by contra:
        ? exist x Q st {$is_rational_sqrt_two_gap_witness(epsilon, x)}
        release thm natural_upper_bound_for_rational(2 / epsilon)
        obtain n from exist n N st {n > 2 / epsilon}
        release thm rational_sqrt_two_no_gap_forces_each_multiple_below_two(epsilon, n)
        n * epsilon > (2 / epsilon) * epsilon = 2
        (n * epsilon)^2 > 2^2 = 4 > 2
        impossible (n * epsilon)^2 < 2
