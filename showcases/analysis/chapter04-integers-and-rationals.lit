        impossible abs(x - y) / 2 = abs(x - y) / 2
thm rational_closeness_is_symmetric:
    ? forall epsilon Q+, x, y Q:
        $is_close_in_Q(epsilon, x, y)
        =>:
            $is_close_in_Q(epsilon, y, x)
    dist_Q(y, x) = dist_Q(x, y) <= epsilon
    by def $is_close_in_Q(epsilon, y, x)
thm rational_closeness_is_transitive:
    ? forall epsilon, delta Q+, x, y, z Q:
        $is_close_in_Q(epsilon, x, y)
        $is_close_in_Q(delta, y, z)
        =>:
            $is_close_in_Q(epsilon + delta, x, z)
    release thm rational_distance_triangle_inequality(x, y, z)
    dist_Q(x, z) <= dist_Q(x, y) + dist_Q(y, z) <= epsilon + delta
    by def $is_close_in_Q(epsilon + delta, x, z)
thm rational_closeness_preserved_by_addition_and_subtraction:
    ? forall epsilon, delta Q+, x, y, z, w Q:
        $is_close_in_Q(epsilon, x, y)
        $is_close_in_Q(delta, z, w)
        =>:
            $is_close_in_Q(epsilon + delta, x + z, y + w)
            $is_close_in_Q(epsilon + delta, x - z, y - w)
    dist_Q(x, y) = abs(x - y)
    dist_Q(z, w) = abs(z - w)
    abs(w - z) = abs(-(z - w)) = abs(z - w)
    dist_Q(x + z, y + w) = abs((x + z) - (y + w)) = abs((x - y) + (z - w)) <= abs(x - y) + abs(z - w) = dist_Q(x, y) + dist_Q(z, w) <= epsilon + delta
    dist_Q(x - z, y - w) = abs((x - z) - (y - w)) = abs((x - y) + (w - z)) <= abs(x - y) + abs(w - z) = dist_Q(x, y) + dist_Q(z, w) <= epsilon + delta
    by def $is_close_in_Q(epsilon + delta, x + z, y + w)
    by def $is_close_in_Q(epsilon + delta, x - z, y - w)
thm rational_closeness_of_between_points:
    ? forall epsilon Q+, x, y, z, w Q:
        $is_close_in_Q(epsilon, y, x)
        $is_close_in_Q(epsilon, z, x)
        y <= w
        w <= z
        =>:
            $is_close_in_Q(epsilon, w, x)
    dist_Q(y, x) <= epsilon
    abs(y - x) = dist_Q(y, x) <= epsilon
    release thm rational_abs_upper_bound_gives_two_sided_bound(y - x, epsilon)
    (-epsilon) <= y - x
    dist_Q(z, x) <= epsilon
    abs(z - x) = dist_Q(z, x) <= epsilon
    release thm rational_abs_upper_bound_gives_two_sided_bound(z - x, epsilon)
    z - x <= epsilon
    (-epsilon) <= y - x <= w - x
    w - x <= z - x <= epsilon
    dist_Q(w, x) = abs(w - x) <= epsilon
    by def $is_close_in_Q(epsilon, w, x)
thm rational_closeness_of_reverse_between_points:
    ? forall epsilon Q+, x, y, z, w Q:
        $is_close_in_Q(epsilon, y, x)
        $is_close_in_Q(epsilon, z, x)
        z <= w
        w <= y
        =>:
            $is_close_in_Q(epsilon, w, x)
    release thm rational_closeness_of_between_points(epsilon, x, z, y, w)
thm rational_closeness_scaled_by_nonzero_factor:
    ? forall epsilon Q+, x, y, z Q:
        $is_close_in_Q(epsilon, x, y)
        z != 0
        =>:
            $is_close_in_Q(epsilon * abs(z), x * z, y * z)
    dist_Q(x, y) = abs(x - y)
    dist_Q(x * z, y * z) = abs(x * z - y * z) = abs((x - y) * z) = abs(x - y) * abs(z) = dist_Q(x, y) * abs(z) <= epsilon * abs(z)
    abs(z) > 0
    epsilon * abs(z) > 0
    epsilon * abs(z) $in Q+
    by def $is_close_in_Q(epsilon * abs(z), x * z, y * z)
thm rational_closeness_of_products:
    ? forall epsilon, delta Q+, x, y, z, w Q:
        $is_close_in_Q(epsilon, x, y)
        $is_close_in_Q(delta, z, w)
        =>:
            $is_close_in_Q(epsilon * abs(z) + delta * abs(x) + epsilon * delta, x * z, y * w)
    dist_Q(x, y) <= epsilon
    dist_Q(z, w) <= delta
    dist_Q(z, w) = abs(z - w) >= 0
    abs((x - y) * z) = abs(x - y) * abs(z)
    abs(x - y) = dist_Q(x, y)
    abs(x - y) * abs(z) = dist_Q(x, y) * abs(z)
    abs((x - y) * z) = abs(x - y) * abs(z) = dist_Q(x, y) * abs(z) <= epsilon * abs(z)
    abs(x * (z - w)) = abs(x) * abs(z - w)
    abs(z - w) = dist_Q(z, w)
    abs(x) * abs(z - w) = abs(x) * dist_Q(z, w)
    abs(x * (z - w)) = abs(x) * abs(z - w) = abs(x) * dist_Q(z, w) <= abs(x) * delta = delta * abs(x)
    dist_Q(x, y) * dist_Q(z, w) <= epsilon * dist_Q(z, w) <= epsilon * delta
    abs((x - y) * (z - w)) = abs(x - y) * abs(z - w)
    abs(x - y) * abs(z - w) = dist_Q(x, y) * dist_Q(z, w)
    abs((x - y) * (z - w)) = abs(x - y) * abs(z - w) = dist_Q(x, y) * dist_Q(z, w) <= epsilon * delta
    x * z - y * w = (x - y) * z + x * (z - w) - (x - y) * (z - w)
    abs((x - y) * z + x * (z - w)) <= abs((x - y) * z) + abs(x * (z - w))
    abs(-((x - y) * (z - w))) = abs((x - y) * (z - w))
    abs((x - y) * z + x * (z - w) - (x - y) * (z - w)) = abs((x - y) * z + x * (z - w) + (-((x - y) * (z - w)))) <= abs((x - y) * z + x * (z - w)) + abs(-((x - y) * (z - w))) = abs((x - y) * z + x * (z - w)) + abs((x - y) * (z - w))
    abs((x - y) * z + x * (z - w)) + abs((x - y) * (z - w)) <= abs((x - y) * z) + abs(x * (z - w)) + abs((x - y) * (z - w))
    abs((x - y) * z + x * (z - w) - (x - y) * (z - w)) <= abs((x - y) * z + x * (z - w)) + abs((x - y) * (z - w)) <= abs((x - y) * z) + abs(x * (z - w)) + abs((x - y) * (z - w))
    abs((x - y) * z) + abs(x * (z - w)) <= epsilon * abs(z) + abs(x * (z - w)) <= epsilon * abs(z) + delta * abs(x)
    abs((x - y) * z) + abs(x * (z - w)) + abs((x - y) * (z - w)) <= epsilon * abs(z) + delta * abs(x) + epsilon * delta
    dist_Q(x * z, y * w) = abs(x * z - y * w) = abs((x - y) * z + x * (z - w) - (x - y) * (z - w)) <= abs((x - y) * z) + abs(x * (z - w)) + abs((x - y) * (z - w)) <= epsilon * abs(z) + delta * abs(x) + epsilon * delta
    0 <= epsilon
    0 <= delta
    0 <= abs(z)
    0 <= abs(x)
    0 <= epsilon * abs(z)
    0 <= delta * abs(x)
    0 <= epsilon * abs(z) + delta * abs(x)
    0 < epsilon * delta <= epsilon * abs(z) + delta * abs(x) + epsilon * delta
    epsilon * abs(z) + delta * abs(x) + epsilon * delta $in Q+
    by def $is_close_in_Q(epsilon * abs(z) + delta * abs(x) + epsilon * delta, x * z, y * w)
