forall x, y Q:
    x > y or x = y or x < y
thm rational_less_excludes_equal_and_greater:
    ? forall x, y Q:
        x < y
        =>:
            x != y
            not x > y
    x != y
    x - y < 0
    claim:
        ? not x > y
        by contra:
            ? not x > y
            x - y > 0
            impossible x - y < 0
thm equal_rationals_are_not_strictly_ordered:
    ? forall x, y Q:
        x = y
        =>:
            not x < y
            not x > y
    x - y = 0
    claim:
        ? not x < y
        by contra:
            ? not x < y
            x - y < 0
            impossible x - y = 0
    claim:
        ? not x > y
        by contra:
            ? not x > y
            x - y > 0
            impossible x - y = 0
thm rational_greater_excludes_equal_and_less:
    ? forall x, y Q:
        x > y
        =>:
