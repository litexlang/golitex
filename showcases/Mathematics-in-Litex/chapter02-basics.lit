# Adapted from Mathematics in Lean; rewritten in Litex. See NOTICE.md.
# Chapter 2: Basics
# Source: Mathematics in Lean, C02_Basics/S01–S05.
# Follow the source section order. Repeated Lean tactic variants share one proof.
# Historical operation-level APIs are retained in the compatibility appendix.

# 2.1 — Calculating — real numbers first

# S01:first real multiplication example
claim:
    ? forall a, b, c R:
        a * b * c = b * (a * c)
    a * b * c = (a * b) * c = (b * a) * c = b * (a * c)

# S01:reverse factors
forall a, b, c R:
    c * b * a = b * (a * c)

# S01:exchange first two factors
forall a, b, c R:
    a * (b * c) = b * (a * c)

# S01:rotate factors
forall a, b, c R:
    a * b * c = b * c * a

# S01:parenthesized rotated factors
forall a, b, c R:
    a * (b * c) = b * (c * a)

# S01:substitution from two hypotheses
claim:
    ? forall a, b, c, d, u, v R:
        a * b = c * d
        u = v
        =>:
            a * (b * u) = c * (d * v)
    a * (b * u) = a * (b * v) = (a * b) * v = (c * d) * v = c * (d * v)

# S01:substitution inside a four-factor product
claim:
    ? forall a, b, c, d, u, v R:
        b * c = u * v
        =>:
            a * b * c * d = a * u * v * d
    a * b * c * d = a * (b * c) * d = a * (u * v) * d = a * u * v * d

# S01:subtracting equal products
claim:
    ? forall a, b, c, d R:
        c = b * a - d
        d = a * b
        =>:
            c = 0
    c = b * a - d = a * b - a * b = 0

# S01:inspect multiplication laws
forall a, b, c R:
    a * b = b * a
    a * b * c = a * (b * c)

# S01:square of a sum, rw/calc/ring variants share one identity
claim:
    ? forall a, b R:
        (a + b) * (a + b) = a * a + 2 * (a * b) + b * b
    (a + b) * (a + b) = a * a + b * a + (a * b + b * b) = a * a + (b * a + a * b) + b * b = a * a + 2 * (a * b) + b * b

# S01:product of two sums
forall a, b, c, d R:
    (a + b) * (c + d) = a * c + a * d + b * c + b * d

# S01:difference of squares
claim:
    ? forall a, b R:
        (a + b) * (a - b) = a^2 - b^2
    (a + b) * (a - b) = a * a - a * b + b * a - b * b = a^2 - b^2

# S01:rewriting a hypothesis then calculating
claim:
    ? forall a, b, c, d R:
        c = d * a + b
        b = a * d
        =>:
            c = 2 * a * d
    c = d * a + b = d * a + a * d = a * d + a * d = 2 * (a * d) = 2 * a * d

# S01:last example is over N, not generalized to R
claim:
    ? forall a, b, c N:
        a + b = c
        =>:
            (a + b) * (a + b) = a * c + b * c
    (a + b) * (a + b) = (a + b) * c = a * c + b * c

# 2.2 — Proving Identities in Algebraic Structures

# S02:generic Ring operations and laws
prop additive_commutative_group_laws(A set, add fn(x, y A) A, zero A, neg fn(x A) A):
    forall x, y, z A:
        add(add(x, y), z) = add(x, add(y, z))
    forall x A:
        add(zero, x) = x
    forall x A:
        add(neg(x), x) = zero
    forall x, y A:
        add(x, y) = add(y, x)

# S02:generic Ring operations and laws
struct Ring<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    mul fn(x, y s) s
    one s
    <=>:
        $additive_commutative_group_laws(s, add, zero, neg)
        forall x, y, z s:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x, y, z s:
            mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
        forall x, y, z s:
            mul(add(x, y), z) = add(mul(x, z), mul(y, z))
        forall x s:
            mul(one, x) = x
        forall x s:
            mul(x, one) = x

# S02:ring numeral two
template<s nonempty_set, ring &Ring<s>>:
    have ring_two s = ring.add(ring.one, ring.one)

# S02:CommRing specialization
prop is_commutative_ring(s nonempty_set, ring &Ring<s>):
    forall x, y s:
        ring.mul(x, y) = ring.mul(y, x)

# S02:Ring primitive law checks
forall s nonempty_set, ring &Ring<s>, a, b, c s:
    ring.add(ring.add(a, b), c) = ring.add(a, ring.add(b, c))
    ring.add(a, b) = ring.add(b, a)
    ring.add(ring.zero, a) = a
    ring.add(ring.neg(a), a) = ring.zero
    ring.mul(ring.mul(a, b), c) = ring.mul(a, ring.mul(b, c))
    ring.mul(a, ring.one) = a
    ring.mul(ring.one, a) = a
    ring.mul(a, ring.add(b, c)) = ring.add(ring.mul(a, b), ring.mul(a, c))
    ring.mul(ring.add(a, b), c) = ring.add(ring.mul(a, c), ring.mul(b, c))

# S02:CommRing three-factor calculation
claim:
    ? forall s nonempty_set, ring &Ring<s>, a, b, c s:
        $is_commutative_ring(s, ring)
        =>:
            ring.mul(ring.mul(c, b), a) = ring.mul(b, ring.mul(a, c))
    ring.mul(c, b) = ring.mul(b, c)
    ring.mul(c, a) = ring.mul(a, c)
    ring.mul(ring.mul(c, b), a) = ring.mul(ring.mul(b, c), a) = ring.mul(b, ring.mul(c, a)) = ring.mul(b, ring.mul(a, c))

# S02:CommRing square of a sum
claim:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        $is_commutative_ring(s, ring)
        =>:
            ring.mul(ring.add(a, b), ring.add(a, b)) = ring.add(ring.add(ring.mul(a, a), ring.mul(\ring_two<s, ring>, ring.mul(a, b))), ring.mul(b, b))
    ring.mul(b, a) = ring.mul(a, b)
    ring.mul(ring.add(a, b), a) = ring.add(ring.mul(a, a), ring.mul(b, a)) = ring.add(ring.mul(a, a), ring.mul(a, b))
    ring.mul(ring.add(a, b), b) = ring.add(ring.mul(a, b), ring.mul(b, b))
    ring.mul(ring.add(a, b), ring.add(a, b)) = ring.add(ring.mul(ring.add(a, b), a), ring.mul(ring.add(a, b), b)) = ring.add(ring.add(ring.mul(a, a), ring.mul(a, b)), ring.add(ring.mul(a, b), ring.mul(b, b)))
    ring.add(ring.add(ring.mul(a, b), ring.mul(a, b)), ring.mul(b, b)) = ring.add(ring.mul(a, b), ring.add(ring.mul(a, b), ring.mul(b, b)))
    ring.add(ring.add(ring.mul(a, a), ring.add(ring.mul(a, b), ring.mul(a, b))), ring.mul(b, b)) = ring.add(ring.mul(a, a), ring.add(ring.add(ring.mul(a, b), ring.mul(a, b)), ring.mul(b, b)))
    ring.add(ring.add(ring.mul(a, a), ring.mul(a, b)), ring.add(ring.mul(a, b), ring.mul(b, b))) = ring.add(ring.mul(a, a), ring.add(ring.mul(a, b), ring.add(ring.mul(a, b), ring.mul(b, b)))) = ring.add(ring.mul(a, a), ring.add(ring.add(ring.mul(a, b), ring.mul(a, b)), ring.mul(b, b))) = ring.add(ring.add(ring.mul(a, a), ring.add(ring.mul(a, b), ring.mul(a, b))), ring.mul(b, b))
    \ring_two<s, ring> = ring.add(ring.one, ring.one)
    ring.mul(ring.one, ring.mul(a, b)) = ring.mul(a, b)
    ring.mul(\ring_two<s, ring>, ring.mul(a, b)) = ring.mul(ring.add(ring.one, ring.one), ring.mul(a, b)) = ring.add(ring.mul(ring.one, ring.mul(a, b)), ring.mul(ring.one, ring.mul(a, b))) = ring.add(ring.mul(a, b), ring.mul(a, b))
    have fn collect_mixed(mixed s) s = ring.add(ring.add(ring.mul(a, a), mixed), ring.mul(b, b))
    collect_mixed(ring.add(ring.mul(a, b), ring.mul(a, b))) = collect_mixed(ring.mul(\ring_two<s, ring>, ring.mul(a, b)))
    collect_mixed(ring.add(ring.mul(a, b), ring.mul(a, b))) = ring.add(ring.add(ring.mul(a, a), ring.add(ring.mul(a, b), ring.mul(a, b))), ring.mul(b, b))
    collect_mixed(ring.mul(\ring_two<s, ring>, ring.mul(a, b))) = ring.add(ring.add(ring.mul(a, a), ring.mul(\ring_two<s, ring>, ring.mul(a, b))), ring.mul(b, b))
    ring.mul(ring.add(a, b), ring.add(a, b)) = ring.add(ring.add(ring.mul(a, a), ring.add(ring.mul(a, b), ring.mul(a, b))), ring.mul(b, b)) = ring.add(ring.add(ring.mul(a, a), ring.mul(\ring_two<s, ring>, ring.mul(a, b))), ring.mul(b, b))

# S02:CommRing rewrite hypothesis
claim:
    ? forall s nonempty_set, ring &Ring<s>, a, b, c, d s:
        $is_commutative_ring(s, ring)
        c = ring.add(ring.mul(d, a), b)
        b = ring.mul(a, d)
        =>:
            c = ring.mul(ring.mul(\ring_two<s, ring>, a), d)
    ring.mul(d, a) = ring.mul(a, d)
    c = ring.add(ring.mul(d, a), b) = ring.add(ring.mul(a, d), ring.mul(a, d))
    \ring_two<s, ring> = ring.add(ring.one, ring.one)
    ring.mul(ring.one, a) = a
    ring.mul(\ring_two<s, ring>, a) = ring.mul(ring.add(ring.one, ring.one), a) = ring.add(ring.mul(ring.one, a), ring.mul(ring.one, a)) = ring.add(a, a)
    ring.mul(ring.mul(\ring_two<s, ring>, a), d) = ring.mul(ring.add(a, a), d) = ring.add(ring.mul(a, d), ring.mul(a, d)) = c

# S02:generic ring subtraction
template<s nonempty_set, ring &Ring<s>>:
    have fn ring_sub(a, b s) s = ring.add(a, ring.neg(b))

# S02:MyRing.add_zero
thm ring_add_zero:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.add(a, ring.zero) = a
    ring.add(a, ring.zero) = ring.add(ring.zero, a) = a

# S02:MyRing.add_neg_cancel
thm ring_add_neg_cancel:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.add(a, ring.neg(a)) = ring.zero
    ring.add(a, ring.neg(a)) = ring.add(ring.neg(a), a) = ring.zero

# S02:MyRing.neg_add_cancel_left
thm ring_neg_add_cancel_left:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.add(ring.neg(a), ring.add(a, b)) = b
    ring.add(ring.neg(a), a) = ring.zero
    ring.add(ring.neg(a), ring.add(a, b)) = ring.add(ring.add(ring.neg(a), a), b) = ring.add(ring.zero, b) = b

# S02:MyRing.add_neg_cancel_right
thm ring_add_neg_cancel_right:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.add(ring.add(a, b), ring.neg(b)) = a
    release thm ring_add_neg_cancel(s, ring, b)
    release thm ring_add_zero(s, ring, a)
    ring.add(ring.add(a, b), ring.neg(b)) = ring.add(a, ring.add(b, ring.neg(b))) = ring.add(a, ring.zero) = a

# S02:MyRing.add_left_cancel
thm ring_add_left_cancel:
    ? forall s nonempty_set, ring &Ring<s>, a, b, c s:
        ring.add(a, b) = ring.add(a, c)
        =>:
            b = c
    ring.add(ring.neg(a), a) = ring.zero
    b = ring.add(ring.zero, b) = ring.add(ring.add(ring.neg(a), a), b) = ring.add(ring.neg(a), ring.add(a, b)) = ring.add(ring.neg(a), ring.add(a, c)) = ring.add(ring.add(ring.neg(a), a), c) = ring.add(ring.zero, c) = c

# S02:MyRing.add_right_cancel
thm ring_add_right_cancel:
    ? forall s nonempty_set, ring &Ring<s>, a, b, c s:
        ring.add(a, b) = ring.add(c, b)
        =>:
            a = c
    ring.add(b, a) = ring.add(a, b) = ring.add(c, b) = ring.add(b, c)
    release thm ring_add_left_cancel(s, ring, b, a, c)

# S02:MyRing.mul_zero
thm ring_mul_zero:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(a, ring.zero) = ring.zero
    ring.add(ring.zero, ring.zero) = ring.zero
    release thm ring_add_zero(s, ring, ring.mul(a, ring.zero))
    ring.add(ring.mul(a, ring.zero), ring.mul(a, ring.zero)) = ring.mul(a, ring.add(ring.zero, ring.zero)) = ring.mul(a, ring.zero) = ring.add(ring.mul(a, ring.zero), ring.zero)
    release thm ring_add_left_cancel(s, ring, ring.mul(a, ring.zero), ring.mul(a, ring.zero), ring.zero)

# S02:MyRing.zero_mul
thm ring_zero_mul:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(ring.zero, a) = ring.zero
    ring.add(ring.zero, ring.zero) = ring.zero
    release thm ring_add_zero(s, ring, ring.mul(ring.zero, a))
    ring.add(ring.mul(ring.zero, a), ring.mul(ring.zero, a)) = ring.mul(ring.add(ring.zero, ring.zero), a) = ring.mul(ring.zero, a) = ring.add(ring.mul(ring.zero, a), ring.zero)
    release thm ring_add_left_cancel(s, ring, ring.mul(ring.zero, a), ring.mul(ring.zero, a), ring.zero)

# S02:MyRing.neg_eq_of_add_eq_zero
thm ring_neg_eq_of_add_eq_zero:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.add(a, b) = ring.zero
        =>:
            ring.neg(a) = b
    release thm ring_neg_add_cancel_left(s, ring, a, b)
    release thm ring_add_zero(s, ring, ring.neg(a))
    ring.add(ring.neg(a), ring.add(a, b)) = ring.add(ring.neg(a), ring.zero) = ring.neg(a)
    b = ring.add(ring.neg(a), ring.add(a, b)) = ring.neg(a)

# S02:MyRing.eq_neg_of_add_eq_zero
thm ring_eq_neg_of_add_eq_zero:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.add(a, b) = ring.zero
        =>:
            b = ring.neg(a)
    release thm ring_add_neg_cancel(s, ring, a)
    release thm ring_add_left_cancel(s, ring, a, b, ring.neg(a))

# S02:MyRing.neg_zero
thm ring_neg_zero:
    ? forall s nonempty_set, ring &Ring<s>:
        ring.neg(ring.zero) = ring.zero
    release thm ring_neg_eq_of_add_eq_zero(s, ring, ring.zero, ring.zero)

# S02:MyRing.neg_neg
thm ring_neg_neg:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.neg(ring.neg(a)) = a
    release thm ring_neg_eq_of_add_eq_zero(s, ring, ring.neg(a), a)

# S02:MyRing.mul_neg_right
thm ring_mul_neg_right:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.mul(a, ring.neg(b)) = ring.neg(ring.mul(a, b))
    release thm ring_mul_zero(s, ring, a)
    release thm ring_add_neg_cancel(s, ring, b)
    ring.add(ring.mul(a, b), ring.mul(a, ring.neg(b))) = ring.mul(a, ring.add(b, ring.neg(b))) = ring.mul(a, ring.zero) = ring.zero
    release thm ring_eq_neg_of_add_eq_zero(s, ring, ring.mul(a, b), ring.mul(a, ring.neg(b)))

# S02:MyRing.neg_mul_left
thm ring_neg_mul_left:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.mul(ring.neg(a), b) = ring.neg(ring.mul(a, b))
    release thm ring_zero_mul(s, ring, b)
    release thm ring_add_neg_cancel(s, ring, a)
    ring.add(ring.mul(a, b), ring.mul(ring.neg(a), b)) = ring.mul(ring.add(a, ring.neg(a)), b) = ring.mul(ring.zero, b) = ring.zero
    release thm ring_eq_neg_of_add_eq_zero(s, ring, ring.mul(a, b), ring.mul(ring.neg(a), b))

# S02:MyRing.neg_mul_neg
thm ring_neg_mul_neg:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        ring.mul(ring.neg(a), ring.neg(b)) = ring.mul(a, b)
    release thm ring_neg_mul_left(s, ring, a, ring.neg(b))
    release thm ring_mul_neg_right(s, ring, a, b)
    release thm ring_neg_neg(s, ring, ring.mul(a, b))
    ring.mul(ring.neg(a), ring.neg(b)) = ring.neg(ring.mul(a, ring.neg(b))) = ring.neg(ring.neg(ring.mul(a, b))) = ring.mul(a, b)

# S02:sub_eq_add_neg
forall s nonempty_set, ring &Ring<s>, a, b s:
    \ring_sub<s, ring>(a, b) = ring.add(a, ring.neg(b))

# S02:real subtraction is also addition of the inverse
forall a, b R:
    a - b = a + (-b)

# S02:MyRing.self_sub
thm ring_self_sub:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        \ring_sub<s, ring>(a, a) = ring.zero
    \ring_sub<s, ring>(a, a) = ring.add(a, ring.neg(a))
    release thm ring_add_neg_cancel(s, ring, a)

# S02:MyRing.one_add_one_eq_two
thm ring_one_add_one_eq_two:
    ? forall s nonempty_set, ring &Ring<s>:
        ring.add(ring.one, ring.one) = \ring_two<s, ring>
    \ring_two<s, ring> = ring.add(ring.one, ring.one)

# S02:MyRing.two_mul
thm ring_two_mul:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(\ring_two<s, ring>, a) = ring.add(a, a)
    \ring_two<s, ring> = ring.add(ring.one, ring.one)
    ring.mul(ring.one, a) = a
    ring.mul(\ring_two<s, ring>, a) = ring.mul(ring.add(ring.one, ring.one), a) = ring.add(ring.mul(ring.one, a), ring.mul(ring.one, a)) = ring.add(a, a)

# S02:CommRing difference of squares
claim:
    ? forall s nonempty_set, ring &Ring<s>, a, b s:
        $is_commutative_ring(s, ring)
        =>:
            ring.mul(ring.add(a, b), \ring_sub<s, ring>(a, b)) = \ring_sub<s, ring>(ring.mul(a, a), ring.mul(b, b))
    \ring_sub<s, ring>(a, b) = ring.add(a, ring.neg(b))
    release thm ring_mul_neg_right(s, ring, a, b)
    release thm ring_mul_neg_right(s, ring, b, b)
    ring.mul(b, a) = ring.mul(a, b)
    ring.mul(a, ring.add(a, ring.neg(b))) = ring.add(ring.mul(a, a), ring.mul(a, ring.neg(b))) = ring.add(ring.mul(a, a), ring.neg(ring.mul(a, b)))
    ring.mul(b, ring.add(a, ring.neg(b))) = ring.add(ring.mul(b, a), ring.mul(b, ring.neg(b))) = ring.add(ring.mul(a, b), ring.neg(ring.mul(b, b)))
    ring.mul(ring.add(a, b), \ring_sub<s, ring>(a, b)) = ring.mul(ring.add(a, b), ring.add(a, ring.neg(b))) = ring.add(ring.mul(a, ring.add(a, ring.neg(b))), ring.mul(b, ring.add(a, ring.neg(b)))) = ring.add(ring.add(ring.mul(a, a), ring.neg(ring.mul(a, b))), ring.add(ring.mul(a, b), ring.neg(ring.mul(b, b))))
    release thm ring_neg_add_cancel_left(s, ring, ring.mul(a, b), ring.neg(ring.mul(b, b)))
    ring.add(ring.add(ring.mul(a, a), ring.neg(ring.mul(a, b))), ring.add(ring.mul(a, b), ring.neg(ring.mul(b, b)))) = ring.add(ring.mul(a, a), ring.add(ring.neg(ring.mul(a, b)), ring.add(ring.mul(a, b), ring.neg(ring.mul(b, b))))) = ring.add(ring.mul(a, a), ring.neg(ring.mul(b, b)))
    \ring_sub<s, ring>(ring.mul(a, a), ring.mul(b, b)) = ring.add(ring.mul(a, a), ring.neg(ring.mul(b, b)))

# S02:AddGroup primitive laws
struct AdditiveGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
        forall x s:
            add(neg(x), x) = zero

# S02:AddGroup law checks
forall s nonempty_set, group &AdditiveGroup<s>, a, b, c s:
    group.add(group.add(a, b), c) = group.add(a, group.add(b, c))
    group.add(group.zero, a) = a
    group.add(group.neg(a), a) = group.zero

# S02:Group interface and left-cancellation/identity background
struct Group<s nonempty_set>:
    mul fn(x, y s) s
    one s
    inv fn(x s) s
    <=>:
        forall x, y, z s:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x s:
            mul(one, x) = x
        forall x s:
            mul(inv(x), x) = one

# S02:Group interface and left-cancellation/identity background
thm _group_left_cancel_struct:
    ? forall s nonempty_set, group &Group<s>, a, b, c s:
        group.mul(a, b) = group.mul(a, c)
        =>:
            b = c
    group.mul(group.inv(a), group.mul(a, b)) = group.mul(group.inv(a), group.mul(a, c))
    group.mul(group.inv(a), a) = group.one
    group.mul(group.one, b) = b
    group.mul(group.one, c) = c
    group.mul(group.mul(group.inv(a), a), b) = group.mul(group.one, b)
    group.mul(group.mul(group.inv(a), a), c) = group.mul(group.one, c)
    group.mul(group.inv(a), group.mul(a, b)) = group.mul(group.mul(group.inv(a), a), b) = group.mul(group.one, b) = b
    group.mul(group.inv(a), group.mul(a, c)) = group.mul(group.mul(group.inv(a), a), c) = group.mul(group.one, c) = c

# S02:Group interface and left-cancellation/identity background
thm group_mul_one:
    ? forall s nonempty_set, group &Group<s>, a s:
        group.mul(a, group.one) = a
    group.mul(group.inv(a), a) = group.one
    group.mul(group.one, group.one) = group.one
    group.mul(group.mul(group.inv(a), a), group.one) = group.mul(group.one, group.one)
    group.mul(group.inv(a), group.mul(a, group.one)) = group.mul(group.mul(group.inv(a), a), group.one) = group.mul(group.one, group.one) = group.one
    group.mul(group.inv(a), group.mul(a, group.one)) = group.mul(group.inv(a), a)
    release thm _group_left_cancel_struct(s, group, group.inv(a), group.mul(a, group.one), a)

# S02:Group law checks
forall s nonempty_set, group &Group<s>, a, b, c s:
    group.mul(group.mul(a, b), c) = group.mul(a, group.mul(b, c))
    group.mul(group.one, a) = a
    group.mul(group.inv(a), a) = group.one

# S02:MyGroup.mul_inv_cancel
thm group_mul_inv_cancel:
    ? forall s nonempty_set, group &Group<s>, a s:
        group.mul(a, group.inv(a)) = group.one
    release thm group_mul_one(s, group, group.inv(a))
    group.mul(group.inv(a), a) = group.one
    group.mul(group.one, group.inv(a)) = group.inv(a)
    group.mul(group.inv(a), group.mul(a, group.inv(a))) = group.mul(group.mul(group.inv(a), a), group.inv(a)) = group.mul(group.one, group.inv(a)) = group.inv(a) = group.mul(group.inv(a), group.one)
    release thm _group_left_cancel_struct(s, group, group.inv(a), group.mul(a, group.inv(a)), group.one)

# S02:MyGroup.mul_inv_rev
thm group_mul_inv_rev:
    ? forall s nonempty_set, group &Group<s>, a, b s:
        group.inv(group.mul(a, b)) = group.mul(group.inv(b), group.inv(a))
    group.mul(group.inv(a), a) = group.one
    group.mul(group.inv(b), b) = group.one
    group.mul(group.one, b) = b
    group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(a, b)) = group.mul(group.inv(b), group.mul(group.inv(a), group.mul(a, b)))
    group.mul(group.inv(a), group.mul(a, b)) = group.mul(group.mul(group.inv(a), a), b) = group.mul(group.one, b) = b
    group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(a, b)) = group.mul(group.inv(b), b) = group.one
    release thm group_mul_inv_cancel(s, group, group.mul(a, b))
    release thm group_mul_one(s, group, group.mul(group.inv(b), group.inv(a)))
    have fn multiply_inverse(value s) s = group.mul(value, group.inv(group.mul(a, b)))
    multiply_inverse(group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(a, b))) = multiply_inverse(group.one)
    multiply_inverse(group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(a, b))) = group.mul(group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(a, b)), group.inv(group.mul(a, b)))
    multiply_inverse(group.one) = group.mul(group.one, group.inv(group.mul(a, b))) = group.inv(group.mul(a, b))
    group.mul(group.inv(b), group.inv(a)) = group.mul(group.mul(group.inv(b), group.inv(a)), group.one) = group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(group.mul(a, b), group.inv(group.mul(a, b)))) = group.mul(group.mul(group.mul(group.inv(b), group.inv(a)), group.mul(a, b)), group.inv(group.mul(a, b))) = group.mul(group.one, group.inv(group.mul(a, b))) = group.inv(group.mul(a, b))

# 2.3 — Using Theorems and Lemmas — real inequalities

# S03:le_refl and le_trans checks
forall x R:
    x <= x

# S03:three le_trans proof presentations
claim:
    ? forall x, y, z R:
        x <= y
        y <= z
        =>:
            x <= z
    x <= y <= z

# S03:mixed strict and weak order lemmas
forall a, b, c R:
    a <= b
    b < c
    =>:
        a < c

# S03:mixed strict and weak order lemmas, dual
forall a, b, c R:
    a < b
    b <= c
    =>:
        a < c

# S03:lt_trans check
forall a, b, c R:
    a < b
    b < c
    =>:
        a < c

# S03:five-point order chain, direct and linarith variants
claim:
    ? forall a, b, c, d, endpoint R:
        a <= b
        b < c
        c <= d
        d < endpoint
        =>:
            a < endpoint
    a <= b < c <= d < endpoint

# S03:linear bound from two inequalities and a value equation
claim:
    ? forall a, b, d R:
        2 * a <= 3 * b
        1 <= a
        d = 2
        =>:
            d + a <= 5 * b
    2 <= 2 * a <= 3 * b
    b >= 2 / 3 > 0
    d + a = 2 + a <= 2 * a + a = 3 * a
    3 * a = (3 / 2) * (2 * a) <= (3 / 2) * (3 * b) = (9 / 2) * b <= 5 * b

# S03:exp_le_exp forward
forall a, b R:
    a <= b
    =>:
        exp(a) <= exp(b)

# S03:exp_lt_exp forward
forall a, b R:
    a < b
    =>:
        exp(a) < exp(b)

# S03:log_le_log
forall a, b R:
    0 < a
    a <= b
    =>:
        ln(a) <= ln(b)

# S03:log_lt_log
forall a, b R:
    0 < a
    a < b
    =>:
        ln(a) < ln(b)

# S03:addition order and positivity checks
forall a, b, c, d R:
    a <= b
    c <= d
    =>:
        a + c <= b + d

# S03:exp_le_exp reverse
claim:
    ? forall a, b R:
        exp(a) <= exp(b)
        =>:
            a <= b
    by contra:
        ? a <= b
        a > b
        exp(a) > exp(b)
        impossible exp(a) <= exp(b)

# S03:exp_lt_exp reverse
claim:
    ? forall a, b R:
        exp(a) < exp(b)
        =>:
            a < b
    by contra:
        ? a < b
        a >= b
        exp(a) >= exp(b)
        impossible exp(a) < exp(b)

# S03:exp_le_exp iff check
forall a, b R:
    =>:
        exp(a) <= exp(b)
    <=>:
        a <= b

# S03:exp_lt_exp iff check
forall a, b R:
    =>:
        exp(a) < exp(b)
    <=>:
        a < b

# S03:add_le_add_right check
forall a, b, c R:
    a <= b
    =>:
        c + a <= c + b

# S03:add_le_add_left check
forall a, b, c R:
    a <= b
    =>:
        a + c <= b + c

# S03:add_lt_add_of_le_of_lt check
forall a, b, c, d R:
    a <= b
    c < d
    =>:
        a + c < b + d

# S03:add_lt_add_of_lt_of_le check
forall a, b, c, d R:
    a < b
    c <= d
    =>:
        a + c < b + d

# S03:add_lt_add_right check
forall a, b, c R:
    a < b
    =>:
        a + c < b + c

# S03:add_lt_add_left check
forall a, b, c R:
    a < b
    =>:
        c + a < c + b

# S03:add_nonneg check
forall a, b R:
    0 <= a
    0 <= b
    =>:
        0 <= a + b

# S03:add_pos check
forall a, b R:
    0 < a
    0 < b
    =>:
        0 < a + b

# S03:add_pos_of_pos_of_nonneg check
forall a, b R:
    0 < a
    0 <= b
    =>:
        0 < a + b

# S03:exp_pos check
forall a R:
    exp(a) > 0

# S03:bound with an exponential summand
claim:
    ? forall a, b, c R:
        1 <= a
        b <= c
        =>:
            2 + a + exp(b) <= 3 * a + exp(c)
    2 <= 2 * a
    exp(b) <= exp(c)
    2 + a + exp(b) <= 2 * a + a + exp(b) = 3 * a + exp(b) <= 3 * a + exp(c)

# S03:use exp_le_exp
forall a, b R:
    a <= b
    =>:
        exp(a) <= exp(b)

# S03:strict sum bound with exponentials and a common offset
claim:
    ? forall a, b, c, d, offset R:
        a <= b
        c < d
        =>:
            a + exp(c) + offset < b + exp(d) + offset
    exp(c) < exp(d)
    a + exp(c) < b + exp(d)
    a + exp(c) + offset < b + exp(d) + offset

# S03:exp after adding a common input
claim:
    ? forall a, c, d, endpoint R:
        d <= endpoint
        =>:
            c + exp(a + d) <= c + exp(a + endpoint)
    a + d <= a + endpoint
    exp(a + d) <= exp(a + endpoint)
    c + exp(a + d) <= c + exp(a + endpoint)

# S03:positive real one
0 < 1

# S03:positive argument for the logarithm example
thm one_plus_exp_positive:
    ? forall x R:
        1 + exp(x) $in R+
    exp(x) > 0
    1 + exp(x) > 0

# S03:log of one plus exp
claim:
    ? forall a, b R:
        a <= b
        =>:
            ln(1 + exp(a)) <= ln(1 + exp(b))
    exp(a) > 0
    exp(b) > 0
    1 + exp(a) > 0
    1 + exp(b) > 0
    exp(a) <= exp(b)
    1 + exp(a) <= 1 + exp(b)
    ln(1 + exp(a)) <= ln(1 + exp(b))

# S03:sq_nonneg check/example
forall a R:
    0 <= a^2

# S03:subtracting ordered exponentials
claim:
    ? forall a, b, c R:
        a <= b
        =>:
            c - exp(b) <= c - exp(a)
    exp(a) <= exp(b)
    c - exp(b) <= c - exp(a)

# S03:two_mul_le_squares, calc/linarith variants
thm real_two_mul_le_squares:
    ? forall a, b R:
        2 * a * b <= a^2 + b^2
    a^2 - 2 * a * b + b^2 = (a - b)^2 >= 0
    2 * a * b = 2 * a * b + 0 <= 2 * a * b + (a^2 - 2 * a * b + b^2) = a^2 + b^2

# S03:absolute-product bound
claim:
    ? forall a, b R:
        abs(a * b) <= (a^2 + b^2) / 2
    release thm real_two_mul_le_squares(a, b)
    release thm real_two_mul_le_squares(-a, b)
    (-a)^2 = a^2
    2 * (-a) * b = -(2 * a * b)
    a * b <= (a^2 + b^2) / 2
    2 * (-a) * b <= (-a)^2 + b^2 = a^2 + b^2
    (-a) * b <= (a^2 + b^2) / 2
    -(a * b) = (-a) * b <= (a^2 + b^2) / 2
    by cases:
        ? abs(a * b) <= (a^2 + b^2) / 2
        case a * b >= 0:
            abs(a * b) = a * b <= (a^2 + b^2) / 2
        case a * b < 0:
            abs(a * b) = -(a * b) <= (a^2 + b^2) / 2

# 2.4 — More on Order and Divisibility — reals, then naturals

# S04:min projections
forall a, b R:
    min(a, b) <= a
    min(a, b) <= b

# S04:le_min
claim:
    ? forall a, b, c R:
        a <= b
        a <= c
        =>:
            a <= min(b, c)
    by cases:
        ? a <= min(b, c)
        case b <= c:
            min(b, c) = b
            a <= min(b, c)
        case b > c:
            c <= b
            min(b, c) = c
            a <= min(b, c)

# S04:min commutativity, three tactic variants
forall a, b R:
    min(a, b) = min(b, a)

# S04:max commutativity
forall a, b R:
    max(a, b) = max(b, a)

# S04:min associativity
claim:
    ? forall a, b, c R:
        min(min(a, b), c) = min(a, min(b, c))
    by cases:
        ? min(min(a, b), c) = min(a, min(b, c))
        case a <= b:
            min(a, b) = a
            by cases:
                ? min(min(a, b), c) = min(a, min(b, c))
                case b <= c:
                    a <= c
                    min(b, c) = b
                    min(a, b) <= c
                    a <= min(b, c)
                    min(min(a, b), c) = min(a, b) = a
                    min(a, min(b, c)) = a
                case b > c:
                    c <= b
                    min(b, c) = c
                    by cases:
                        ? min(min(a, b), c) = min(a, min(b, c))
                        case a <= c:
                            min(a, b) <= c
                            a <= min(b, c)
                            min(min(a, b), c) = min(a, b) = a
                            min(a, min(b, c)) = a
                        case a > c:
                            c <= a
                            c <= min(a, b)
                            min(b, c) <= a
                            min(min(a, b), c) = c
                            min(a, min(b, c)) = min(b, c) = c
        case a > b:
            b <= a
            min(a, b) = b
            by cases:
                ? min(min(a, b), c) = min(a, min(b, c))
                case b <= c:
                    min(b, c) = b
                    min(a, b) <= c
                    min(b, c) <= a
                    min(min(a, b), c) = min(a, b) = b
                    min(a, min(b, c)) = min(b, c) = b
                case b > c:
                    c <= b <= a
                    min(b, c) = c
                    c <= min(a, b)
                    min(b, c) <= a
                    min(min(a, b), c) = c
                    min(a, min(b, c)) = min(b, c) = c

# S04:min translation auxiliary
claim:
    ? forall a, b, c R:
        min(a, b) + c <= min(a + c, b + c)
    by cases:
        ? min(a, b) + c <= min(a + c, b + c)
        case a <= b:
            a + c <= b + c
            min(a, b) = a
            min(a + c, b + c) = a + c
            min(a, b) + c = a + c = min(a + c, b + c)
        case a > b:
            b <= a
            b + c <= a + c
            min(a, b) = b
            min(a + c, b + c) = b + c
            min(a, b) + c = b + c = min(a + c, b + c)

# S04:min translation equality
claim:
    ? forall a, b, c R:
        min(a, b) + c = min(a + c, b + c)
    by cases:
        ? min(a, b) + c = min(a + c, b + c)
        case a <= b:
            a + c <= b + c
            min(a, b) = a
            min(a + c, b + c) = a + c
            min(a, b) + c = a + c = min(a + c, b + c)
        case a > b:
            b <= a
            b + c <= a + c
            min(a, b) = b
            min(a + c, b + c) = b + c
            min(a, b) + c = b + c = min(a + c, b + c)

# S04:triangle inequality check
forall a, b R:
    abs(a + b) <= abs(a) + abs(b)

# S04:reverse triangle inequality
forall a, b R:
    abs(a) - abs(b) <= abs(a - b)

# S04:total natural divisibility definition
prop nat_divides(divisor N, dividend N):
    exist multiplier N st {dividend = divisor * multiplier}

# S04:natural divisibility transitivity
claim:
    ? forall x, y, z N:
        $nat_divides(x, y)
        $nat_divides(y, z)
        =>:
            $nat_divides(x, z)
    obtain k from exist k N st {y = x * k}
    obtain multiplier from exist multiplier N st {z = y * multiplier}
    z = y * multiplier = (x * k) * multiplier = x * (k * multiplier)
    witness exist witness N st {z = x * witness} from k * multiplier:
        z = x * (k * multiplier)

# S04:natural divisor of product
claim:
    ? forall x, y, z N:
        $nat_divides(x, y * x * z)
    y * x * z = x * (y * z)
    witness exist witness N st {y * x * z = x * witness} from y * z:
        y * x * z = x * (y * z)

# S04:natural divisor of square
claim:
    ? forall x N:
        $nat_divides(x, x^2)
    x^2 = x * x
    witness exist witness N st {x^2 = x * witness} from x:
        x^2 = x * (x)

# S04:natural divisor of mixed sum
claim:
    ? forall w, x, y, z N:
        $nat_divides(x, w)
        =>:
            $nat_divides(x, y * (x * z) + x^2 + w^2)
    obtain k from exist k N st {w = x * k}
    w^2 = (x * k)^2 = x^2 * k^2
    y * (x * z) + x^2 + w^2 = y * (x * z) + x^2 + x^2 * k^2 = x * (y * z + x + x * k^2)
    witness exist witness N st {y * (x * z) + x^2 + w^2 = x * witness} from y * z + x + x * k^2:
        y * (x * z) + x^2 + w^2 = x * (y * z + x + x * k^2)

# S04:Nat.gcd total interface including zero pair
have fn natural_gcd(m, n N) N by cases:
    case m = 0: n
    case m != 0: gcd(m, n)

# S04:Nat.gcd zero right
claim:
    ? forall n N:
        natural_gcd(n, 0) = n
    by cases:
        ? natural_gcd(n, 0) = n
        case n = 0:
            natural_gcd(n, 0) = 0 = n
        case n != 0:
            gcd(n, 0) = abs(n) = n
            natural_gcd(n, 0) = gcd(n, 0) = n

# S04:Nat.gcd zero left
forall n N:
    natural_gcd(0, n) = n

# S04:Nat.lcm zero left/right
forall n N:
    lcm(n, 0) = 0
    lcm(0, n) = 0

# S04:Nat.gcd total symmetry
claim:
    ? forall m, n N:
        natural_gcd(m, n) = natural_gcd(n, m)
    by cases:
        ? natural_gcd(m, n) = natural_gcd(n, m)
        case m = 0:
            natural_gcd(m, n) = n
            by cases:
                ? natural_gcd(m, n) = natural_gcd(n, m)
                case n = 0:
                    natural_gcd(n, m) = m = n
                case n != 0:
                    gcd(n, m) = gcd(n, 0) = abs(n) = n
                    natural_gcd(n, m) = gcd(n, m) = n
        case m != 0:
            by cases:
                ? natural_gcd(m, n) = natural_gcd(n, m)
                case n = 0:
                    gcd(m, n) = gcd(m, 0) = abs(m) = m
                    natural_gcd(m, n) = gcd(m, n) = m
                    natural_gcd(n, m) = m
                case n != 0:
                    gcd(m, n) = gcd(n, m)
                    natural_gcd(m, n) = gcd(m, n) = gcd(n, m) = natural_gcd(n, m)

# 2.5 — Proving Facts about Algebraic Structures

# S05:partial_order_laws
prop partial_order_laws(s set, le_rel power_set(cart(s, s))):
    forall x s:
        (x, x) $in le_rel
    forall x, y, z s:
        (x, y) $in le_rel
        (y, z) $in le_rel
        =>:
            (x, z) $in le_rel
    forall x, y s:
        (x, y) $in le_rel
        (y, x) $in le_rel
        =>:
            x = y

# S05:PartialOrder carrier
template<s set>:
    have PartialOrder set = {le_rel power_set(cart(s, s)): $partial_order_laws(s, le_rel)}

# S05:is_less_than_in_order
prop is_less_than_in_order(A set, order \PartialOrder<A>, x, y A):
    (x, y) $in order
    x != y

# S05:transport_membership
thm transport_membership:
    ? forall A, B set, element A:
        A = B
        =>:
            element $in B

# S05:partial_order_laws_from_member
thm partial_order_laws_from_member:
    ? forall s set, order \PartialOrder<s>:
        $partial_order_laws(s, order)
    \PartialOrder<s> = {le_rel power_set(cart(s, s)): $partial_order_laws(s, le_rel)}
    by thm transport_membership(\PartialOrder<s>, {le_rel power_set(cart(s, s)): $partial_order_laws(s, le_rel)}, order) => order $in {le_rel power_set(cart(s, s)): $partial_order_laws(s, le_rel)}

# S05:partial_order_le_trans
thm partial_order_le_trans:
    ? forall s set, order \PartialOrder<s>, x, y, z s:
        (x, y) $in order
        (y, z) $in order
        =>:
            (x, z) $in order
    release thm partial_order_laws_from_member(s, order)
    by def $partial_order_laws(s, order)
    (x, z) $in order

# S05:partial_order_le_antisymm
thm partial_order_le_antisymm:
    ? forall s set, order \PartialOrder<s>, x, y s:
        (x, y) $in order
        (y, x) $in order
        =>:
            x = y
    release thm partial_order_laws_from_member(s, order)

# S05:partial_order_le_refl
thm partial_order_le_refl:
    ? forall s set, order \PartialOrder<s>, x s:
        (x, x) $in order
    release thm partial_order_laws_from_member(s, order)

# S05:strict order iff
forall A set, order \PartialOrder<A>, x, y A:
    =>:
        $is_less_than_in_order(A, order, x, y)
    <=>:
        (x, y) $in order
        x != y

# S05:strict irreflexivity
claim:
    ? forall s set, order \PartialOrder<s>, x s:
        not $is_less_than_in_order(s, order, x, x)
    by contra:
        ? not $is_less_than_in_order(s, order, x, x)
        x != x
        impossible x = x

# S05:strict transitivity
claim:
    ? forall s set, order \PartialOrder<s>, x, y, z s:
        $is_less_than_in_order(s, order, x, y)
        $is_less_than_in_order(s, order, y, z)
        =>:
            $is_less_than_in_order(s, order, x, z)
    (x, y) $in order
    (y, z) $in order
    release thm partial_order_le_trans(s, order, x, y, z)
    claim:
        ? x != z
        by contra:
            ? x != z
            (y, x) $in order
            release thm partial_order_le_antisymm(s, order, x, y)
            impossible x != y
    by def $is_less_than_in_order(s, order, x, z)

# S05:weak/strict transitivity
claim:
    ? forall s set, order \PartialOrder<s>, x, y, z s:
        (x, y) $in order
        $is_less_than_in_order(s, order, y, z)
        =>:
            $is_less_than_in_order(s, order, x, z)
    (x, y) $in order
    (y, z) $in order
    release thm partial_order_le_trans(s, order, x, y, z)
    claim:
        ? x != z
        by contra:
            ? x != z
            (z, y) = (x, y)
            (z, y) $in order
            release thm partial_order_le_antisymm(s, order, y, z)
            impossible y != z
    by def $is_less_than_in_order(s, order, x, z)

# S05:strict/weak transitivity
claim:
    ? forall s set, order \PartialOrder<s>, x, y, z s:
        $is_less_than_in_order(s, order, x, y)
        (y, z) $in order
        =>:
            $is_less_than_in_order(s, order, x, z)
    (x, y) $in order
    (y, z) $in order
    release thm partial_order_le_trans(s, order, x, y, z)
    claim:
        ? x != z
        by contra:
            ? x != z
            (y, x) = (y, z)
            (y, x) $in order
            release thm partial_order_le_antisymm(s, order, x, y)
            impossible x != y
    by def $is_less_than_in_order(s, order, x, z)

# S05:Lattice
struct Lattice<s nonempty_set>:
    order \PartialOrder<s>
    meet fn(x, y s) s
    join fn(x, y s) s
    <=>:
        forall x, y s:
            (meet(x, y), x) $in order
        forall x, y s:
            (meet(x, y), y) $in order
        forall x, y s:
            (x, join(x, y)) $in order
        forall x, y s:
            (y, join(x, y)) $in order
        forall x, y, z s:
            (z, x) $in order
            (z, y) $in order
            =>:
                (z, meet(x, y)) $in order
        forall x, y, z s:
            (x, z) $in order
            (y, z) $in order
            =>:
                (join(x, y), z) $in order

# S05:lattice_le_trans_structure
thm lattice_le_trans_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y, z s:
        (x, y) $in lattice.order
        (y, z) $in lattice.order
        =>:
            (x, z) $in lattice.order
    release thm partial_order_le_trans(s, lattice.order, x, y, z)

# S05:lattice_meet_comm_structure
thm lattice_meet_comm_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.meet(x, y) = lattice.meet(y, x)
    (lattice.meet(x, y), y) $in lattice.order
    (lattice.meet(x, y), x) $in lattice.order
    (lattice.meet(x, y), lattice.meet(y, x)) $in lattice.order
    (lattice.meet(y, x), x) $in lattice.order
    (lattice.meet(y, x), y) $in lattice.order
    (lattice.meet(y, x), lattice.meet(x, y)) $in lattice.order
    release thm partial_order_le_antisymm(s, lattice.order, lattice.meet(x, y), lattice.meet(y, x))

# S05:lattice_meet_assoc_structure
thm lattice_meet_assoc_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y, z s:
        lattice.meet(lattice.meet(x, y), z) = lattice.meet(x, lattice.meet(y, z))
    (lattice.meet(lattice.meet(x, y), z), lattice.meet(x, y)) $in lattice.order
    (lattice.meet(x, y), x) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, lattice.meet(lattice.meet(x, y), z), lattice.meet(x, y), x)
    (lattice.meet(x, y), y) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, lattice.meet(lattice.meet(x, y), z), lattice.meet(x, y), y)
    (lattice.meet(lattice.meet(x, y), z), z) $in lattice.order
    (lattice.meet(lattice.meet(x, y), z), lattice.meet(y, z)) $in lattice.order
    (lattice.meet(lattice.meet(x, y), z), lattice.meet(x, lattice.meet(y, z))) $in lattice.order
    (lattice.meet(x, lattice.meet(y, z)), x) $in lattice.order
    (lattice.meet(x, lattice.meet(y, z)), lattice.meet(y, z)) $in lattice.order
    (lattice.meet(y, z), y) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, lattice.meet(x, lattice.meet(y, z)), lattice.meet(y, z), y)
    (lattice.meet(y, z), z) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, lattice.meet(x, lattice.meet(y, z)), lattice.meet(y, z), z)
    (lattice.meet(x, lattice.meet(y, z)), lattice.meet(x, y)) $in lattice.order
    (lattice.meet(x, lattice.meet(y, z)), lattice.meet(lattice.meet(x, y), z)) $in lattice.order
    release thm partial_order_le_antisymm(s, lattice.order, lattice.meet(lattice.meet(x, y), z), lattice.meet(x, lattice.meet(y, z)))

# S05:lattice_join_comm_structure
thm lattice_join_comm_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.join(x, y) = lattice.join(y, x)
    (y, lattice.join(x, y)) $in lattice.order
    (x, lattice.join(x, y)) $in lattice.order
    (lattice.join(y, x), lattice.join(x, y)) $in lattice.order
    (x, lattice.join(y, x)) $in lattice.order
    (y, lattice.join(y, x)) $in lattice.order
    (lattice.join(x, y), lattice.join(y, x)) $in lattice.order
    release thm partial_order_le_antisymm(s, lattice.order, lattice.join(x, y), lattice.join(y, x))

# S05:lattice_join_assoc_structure
thm lattice_join_assoc_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y, z s:
        lattice.join(lattice.join(x, y), z) = lattice.join(x, lattice.join(y, z))
    (x, lattice.join(x, y)) $in lattice.order
    (lattice.join(x, y), lattice.join(lattice.join(x, y), z)) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, x, lattice.join(x, y), lattice.join(lattice.join(x, y), z))
    (y, lattice.join(x, y)) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, y, lattice.join(x, y), lattice.join(lattice.join(x, y), z))
    (z, lattice.join(lattice.join(x, y), z)) $in lattice.order
    (lattice.join(y, z), lattice.join(lattice.join(x, y), z)) $in lattice.order
    (lattice.join(x, lattice.join(y, z)), lattice.join(lattice.join(x, y), z)) $in lattice.order
    (x, lattice.join(x, lattice.join(y, z))) $in lattice.order
    (y, lattice.join(y, z)) $in lattice.order
    (lattice.join(y, z), lattice.join(x, lattice.join(y, z))) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, y, lattice.join(y, z), lattice.join(x, lattice.join(y, z)))
    (z, lattice.join(y, z)) $in lattice.order
    release thm lattice_le_trans_structure(s, lattice, z, lattice.join(y, z), lattice.join(x, lattice.join(y, z)))
    (lattice.join(x, y), lattice.join(x, lattice.join(y, z))) $in lattice.order
    (lattice.join(lattice.join(x, y), z), lattice.join(x, lattice.join(y, z))) $in lattice.order
    release thm partial_order_le_antisymm(s, lattice.order, lattice.join(lattice.join(x, y), z), lattice.join(x, lattice.join(y, z)))

# S05:lattice_meet_join_absorb_structure
thm lattice_meet_join_absorb_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.meet(x, lattice.join(x, y)) = x
    (lattice.meet(x, lattice.join(x, y)), x) $in lattice.order
    release thm partial_order_le_refl(s, lattice.order, x)
    (x, lattice.join(x, y)) $in lattice.order
    (x, lattice.meet(x, lattice.join(x, y))) $in lattice.order
    release thm partial_order_le_antisymm(s, lattice.order, lattice.meet(x, lattice.join(x, y)), x)

# S05:lattice_join_meet_absorb_structure
thm lattice_join_meet_absorb_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, x, y s:
        lattice.join(x, lattice.meet(x, y)) = x
    (x, lattice.join(x, lattice.meet(x, y))) $in lattice.order
    release thm partial_order_le_refl(s, lattice.order, x)
    (lattice.meet(x, y), x) $in lattice.order
    (lattice.join(x, lattice.meet(x, y)), x) $in lattice.order
    release thm partial_order_le_antisymm(s, lattice.order, lattice.join(x, lattice.meet(x, y)), x)

# S05:is_distributive_lattice
prop is_distributive_lattice(s nonempty_set, lattice &Lattice<s>):
    forall x, y, z s:
        lattice.meet(x, lattice.join(y, z)) = lattice.join(lattice.meet(x, y), lattice.meet(x, z))
        lattice.meet(lattice.join(x, y), z) = lattice.join(lattice.meet(x, z), lattice.meet(y, z))
        lattice.join(x, lattice.meet(y, z)) = lattice.meet(lattice.join(x, y), lattice.join(x, z))
        lattice.join(lattice.meet(x, y), z) = lattice.meet(lattice.join(x, z), lattice.join(y, z))

# S05:lattice_join_meet_distributive_of_meet_join_distributive_structure
thm lattice_join_meet_distributive_of_meet_join_distributive_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, a, b, c s:
        forall x, y, z s:
            lattice.meet(x, lattice.join(y, z)) = lattice.join(lattice.meet(x, y), lattice.meet(x, z))
        =>:
            lattice.join(a, lattice.meet(b, c)) = lattice.meet(lattice.join(a, b), lattice.join(a, c))
    lattice.meet(lattice.join(a, b), lattice.join(a, c)) = lattice.join(lattice.meet(lattice.join(a, b), a), lattice.meet(lattice.join(a, b), c))
    release thm lattice_meet_comm_structure(s, lattice, lattice.join(a, b), a)
    release thm lattice_meet_join_absorb_structure(s, lattice, a, b)
    release thm lattice_meet_comm_structure(s, lattice, lattice.join(a, b), c)
    lattice.meet(c, lattice.join(a, b)) = lattice.join(lattice.meet(c, a), lattice.meet(c, b))
    release thm lattice_meet_comm_structure(s, lattice, c, a)
    release thm lattice_meet_comm_structure(s, lattice, c, b)
    lattice.meet(lattice.join(a, b), c) = lattice.meet(c, lattice.join(a, b)) = lattice.join(lattice.meet(c, a), lattice.meet(c, b)) = lattice.join(lattice.meet(a, c), lattice.meet(c, b)) = lattice.join(lattice.meet(a, c), lattice.meet(b, c))
    release thm lattice_join_assoc_structure(s, lattice, a, lattice.meet(a, c), lattice.meet(b, c))
    release thm lattice_join_meet_absorb_structure(s, lattice, a, c)
    lattice.meet(lattice.join(a, b), lattice.join(a, c)) = lattice.join(lattice.meet(lattice.join(a, b), a), lattice.meet(lattice.join(a, b), c)) = lattice.join(a, lattice.meet(lattice.join(a, b), c)) = lattice.join(a, lattice.join(lattice.meet(a, c), lattice.meet(b, c))) = lattice.join(lattice.join(a, lattice.meet(a, c)), lattice.meet(b, c)) = lattice.join(a, lattice.meet(b, c))

# S05:lattice_meet_join_distributive_of_join_meet_distributive_structure
thm lattice_meet_join_distributive_of_join_meet_distributive_structure:
    ? forall s nonempty_set, lattice &Lattice<s>, a, b, c s:
        forall x, y, z s:
            lattice.join(x, lattice.meet(y, z)) = lattice.meet(lattice.join(x, y), lattice.join(x, z))
        =>:
            lattice.meet(a, lattice.join(b, c)) = lattice.join(lattice.meet(a, b), lattice.meet(a, c))
    lattice.join(lattice.meet(a, b), lattice.meet(a, c)) = lattice.meet(lattice.join(lattice.meet(a, b), a), lattice.join(lattice.meet(a, b), c))
    release thm lattice_join_comm_structure(s, lattice, lattice.meet(a, b), a)
    release thm lattice_join_meet_absorb_structure(s, lattice, a, b)
    release thm lattice_join_comm_structure(s, lattice, lattice.meet(a, b), c)
    lattice.join(c, lattice.meet(a, b)) = lattice.meet(lattice.join(c, a), lattice.join(c, b))
    release thm lattice_join_comm_structure(s, lattice, c, a)
    release thm lattice_join_comm_structure(s, lattice, c, b)
    lattice.join(lattice.meet(a, b), c) = lattice.join(c, lattice.meet(a, b)) = lattice.meet(lattice.join(c, a), lattice.join(c, b)) = lattice.meet(lattice.join(a, c), lattice.join(c, b)) = lattice.meet(lattice.join(a, c), lattice.join(b, c))
    release thm lattice_meet_assoc_structure(s, lattice, a, lattice.join(a, c), lattice.join(b, c))
    release thm lattice_meet_join_absorb_structure(s, lattice, a, c)
    lattice.join(lattice.meet(a, b), lattice.meet(a, c)) = lattice.meet(lattice.join(lattice.meet(a, b), a), lattice.join(lattice.meet(a, b), c)) = lattice.meet(a, lattice.join(lattice.meet(a, b), c)) = lattice.meet(a, lattice.meet(lattice.join(a, c), lattice.join(b, c))) = lattice.meet(lattice.meet(a, lattice.join(a, c)), lattice.join(b, c)) = lattice.meet(a, lattice.join(b, c))

# S05:is_ordered_ring
prop is_ordered_ring(s nonempty_set, ring &Ring<s>, order \PartialOrder<s>):
    forall a, b, c s:
        (a, b) $in order
        =>:
            (ring.add(c, a), ring.add(c, b)) $in order
    forall a, b s:
        (ring.zero, a) $in order
        (ring.zero, b) $in order
        =>:
            (ring.zero, ring.mul(a, b)) $in order

# S05:strict ordered ring compatibility
prop is_strict_ordered_ring(s nonempty_set, ring &Ring<s>, order \PartialOrder<s>):
    $is_ordered_ring(s, ring, order)
    forall a, b s:
        $is_less_than_in_order(s, order, ring.zero, a)
        $is_less_than_in_order(s, order, ring.zero, b)
        =>:
            $is_less_than_in_order(s, order, ring.zero, ring.mul(a, b))

# S05:nonnegative subtraction forward
thm ring_sub_nonnegative_of_le_structure:
    ? forall s nonempty_set, ring &Ring<s>, order \PartialOrder<s>, a, b s:
        $is_ordered_ring(s, ring, order)
        (a, b) $in order
        =>:
            (ring.zero, ring.add(b, ring.neg(a))) $in order
    (ring.add(ring.neg(a), a), ring.add(ring.neg(a), b)) $in order
    ring.add(ring.neg(a), a) = ring.zero
    ring.add(ring.neg(a), b) = ring.add(b, ring.neg(a))
    (ring.zero, ring.add(b, ring.neg(a))) = (ring.add(ring.neg(a), a), ring.add(ring.neg(a), b))

# S05:nonnegative subtraction reverse
thm ring_le_of_sub_nonnegative_structure:
    ? forall s nonempty_set, ring &Ring<s>, order \PartialOrder<s>, a, b s:
        $is_ordered_ring(s, ring, order)
        (ring.zero, ring.add(b, ring.neg(a))) $in order
        =>:
            (a, b) $in order
    (ring.add(a, ring.zero), ring.add(a, ring.add(b, ring.neg(a)))) $in order
    release thm ring_add_zero(s, ring, a)
    release thm ring_add_neg_cancel(s, ring, a)
    release thm ring_add_zero(s, ring, b)
    ring.add(a, b) = ring.add(b, a)
    ring.add(ring.add(a, b), ring.neg(a)) = ring.add(ring.add(b, a), ring.neg(a))
    ring.add(a, ring.add(b, ring.neg(a))) = ring.add(ring.add(a, b), ring.neg(a)) = ring.add(ring.add(b, a), ring.neg(a)) = ring.add(b, ring.add(a, ring.neg(a))) = ring.add(b, ring.zero) = b
    (a, b) = (ring.add(a, ring.zero), ring.add(a, ring.add(b, ring.neg(a))))

# S05:multiplication preserves weak order
thm ring_mul_le_mul_right_of_nonnegative_structure:
    ? forall s nonempty_set, ring &Ring<s>, order \PartialOrder<s>, a, b, c s:
        $is_ordered_ring(s, ring, order)
        (a, b) $in order
        (ring.zero, c) $in order
        =>:
            (ring.mul(a, c), ring.mul(b, c)) $in order
    release thm ring_sub_nonnegative_of_le_structure(s, ring, order, a, b)
    (ring.zero, ring.mul(ring.add(b, ring.neg(a)), c)) $in order
    release thm ring_neg_mul_left(s, ring, a, c)
    ring.mul(ring.add(b, ring.neg(a)), c) = ring.add(ring.mul(b, c), ring.mul(ring.neg(a), c)) = ring.add(ring.mul(b, c), ring.neg(ring.mul(a, c)))
    (ring.zero, ring.add(ring.mul(b, c), ring.neg(ring.mul(a, c)))) = (ring.zero, ring.mul(ring.add(b, ring.neg(a)), c))
    release thm ring_le_of_sub_nonnegative_structure(s, ring, order, ring.mul(a, c), ring.mul(b, c))

# S05:source metric primitive laws without assumed nonnegativity
prop source_metric_laws(X set, dist fn(x, y X) R):
    forall x, y X:
        dist(x, y) = 0
        =>:
            x = y
    forall x X:
        dist(x, x) = 0
    forall x, y X:
        dist(x, y) = dist(y, x)
    forall x, y, z X:
        dist(x, z) <= dist(x, y) + dist(y, z)

# S05:source MetricSpace carrier
template<X set>:
    have SourceMetricSpace set = {dist fn(x, y X) R: $source_metric_laws(X, dist)}

# S05:metric nonnegativity derived from triangle inequality
thm source_metric_distance_nonnegative:
    ? forall X set, metric fn(u, v X) R, x, y X:
        metric $in \SourceMetricSpace<X>
        =>:
            metric(x, y) >= 0
    \SourceMetricSpace<X> = {dist fn(u, v X) R: $source_metric_laws(X, dist)}
    by thm transport_membership(\SourceMetricSpace<X>, {dist fn(u, v X) R: $source_metric_laws(X, dist)}, metric) => metric $in {dist fn(u, v X) R: $source_metric_laws(X, dist)}
    $source_metric_laws(X, metric)
    by def $source_metric_laws(X, metric)
    metric(x, x) = 0
    metric(y, x) = metric(x, y)
    0 = metric(x, x) <= metric(x, y) + metric(y, x) = metric(x, y) + metric(x, y) = 2 * metric(x, y)
    2 * metric(x, y) >= 0
    metric(x, y) = (2 * metric(x, y)) / 2 >= 0

# Compatibility appendix
# Earlier chapters exposed these operation-level and construction interfaces.
# They remain available to existing consumers; the source narrative is above.

thm add_neg_cancel:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(a, neg(a)) = zero
    add(a, neg(a)) = add(neg(a), a) = zero

thm add_zero:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(a, zero) = a
    add(a, zero) = add(zero, a) = a

thm add_left_cancel_in_additive_commutative_group:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        add(a, b) = add(a, c)
        =>:
            b = c
    add(neg(a), a) = zero
    b = add(zero, b) = add(add(neg(a), a), b) = add(neg(a), add(a, b)) = add(neg(a), add(a, c)) = add(add(neg(a), a), c) = add(zero, c) = c

thm self_sub:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(a, neg(a)) = zero
    release thm add_neg_cancel(A, add, zero, neg, a)

thm one_add_one_eq_two:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(one, one) = add(one, one)

thm two_mul:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            mul(add(one, one), a) = add(a, a)
    mul(one, a) = a
    mul(add(one, one), a) = add(mul(one, a), mul(one, a)) = add(a, a)

thm mul_zero:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            mul(a, zero) = zero
    add(zero, zero) = zero
    release thm add_zero(A, add, zero, neg, mul(a, zero))
    add(mul(a, zero), mul(a, zero)) = mul(a, add(zero, zero)) = mul(a, zero) = add(mul(a, zero), zero)
    release thm add_left_cancel_in_additive_commutative_group(A, add, zero, neg, mul(a, zero), mul(a, zero), zero)

thm zero_mul:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            mul(zero, a) = zero
    add(zero, zero) = zero
    release thm add_zero(A, add, zero, neg, mul(zero, a))
    add(mul(zero, a), mul(zero, a)) = mul(add(zero, zero), a) = mul(zero, a) = add(mul(zero, a), zero)
    release thm add_left_cancel_in_additive_commutative_group(A, add, zero, neg, mul(zero, a), mul(zero, a), zero)

thm neg_add_cancel_left:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(neg(a), add(a, b)) = b
    add(neg(a), a) = zero
    add(neg(a), add(a, b)) = add(add(neg(a), a), b) = add(zero, b) = b

thm add_neg_cancel_right:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(add(a, b), neg(b)) = a
    release thm add_neg_cancel(A, add, zero, neg, b)
    release thm add_zero(A, add, zero, neg, a)
    add(add(a, b), neg(b)) = add(a, add(b, neg(b))) = add(a, zero) = a

thm add_left_cancel:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        add(a, b) = add(a, c)
        =>:
            b = c
    release thm add_left_cancel_in_additive_commutative_group(A, add, zero, neg, a, b, c)

thm add_right_cancel:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        add(a, b) = add(c, b)
        =>:
            a = c
    add(b, a) = add(a, b) = add(c, b) = add(b, c)
    release thm add_left_cancel(A, add, zero, neg, b, a, c)

thm add_reorder_four:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c, d A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
    add(b, c) = add(c, b)
    add(b, add(c, d)) = add(add(b, c), d) = add(add(c, b), d) = add(c, add(b, d))
    add(add(a, b), add(c, d)) = add(a, add(b, add(c, d))) = add(a, add(c, add(b, d))) = add(add(a, c), add(b, d))

thm eq_neg_of_add_eq_zero:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        add(a, b) = zero
        =>:
            b = neg(a)
    release thm add_neg_cancel(A, add, zero, neg, a)
    release thm add_left_cancel(A, add, zero, neg, a, b, neg(a))

thm neg_eq_of_add_eq_zero:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        add(a, b) = zero
        =>:
            neg(a) = b
    release thm eq_neg_of_add_eq_zero(A, add, zero, neg, a, b)

thm neg_zero:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            neg(zero) = zero
    release thm neg_eq_of_add_eq_zero(A, add, zero, neg, zero, zero)

thm neg_neg:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            neg(neg(a)) = a
    release thm neg_eq_of_add_eq_zero(A, add, zero, neg, neg(a), a)

thm mul_neg_right:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            mul(a, neg(b)) = neg(mul(a, b))
    release thm mul_zero(A, add, zero, neg, mul, one, a)
    release thm add_neg_cancel(A, add, zero, neg, b)
    add(mul(a, b), mul(a, neg(b))) = mul(a, add(b, neg(b))) = mul(a, zero) = zero
    release thm eq_neg_of_add_eq_zero(A, add, zero, neg, mul(a, b), mul(a, neg(b)))

thm neg_mul_left:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            mul(neg(a), b) = neg(mul(a, b))
    release thm zero_mul(A, add, zero, neg, mul, one, b)
    release thm add_neg_cancel(A, add, zero, neg, a)
    add(mul(a, b), mul(neg(a), b)) = mul(add(a, neg(a)), b) = mul(zero, b) = zero
    release thm eq_neg_of_add_eq_zero(A, add, zero, neg, mul(a, b), mul(neg(a), b))

thm neg_mul_neg:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u, v A:
            add(u, v) = add(v, u)
        =>:
            mul(neg(a), neg(b)) = mul(a, b)
    release thm neg_mul_left(A, add, zero, neg, mul, one, a, neg(b))
    release thm mul_neg_right(A, add, zero, neg, mul, one, a, b)
    release thm neg_neg(A, add, zero, neg, mul(a, b))
    mul(neg(a), neg(b)) = neg(mul(a, neg(b))) = neg(neg(mul(a, b))) = mul(a, b)

thm commutative_mul_reorder_four:
    ? forall A set, mul fn(x, y A) A, a, b, c, d A:
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v A:
            mul(u, v) = mul(v, u)
        =>:
            mul(mul(a, b), mul(c, d)) = mul(mul(a, c), mul(b, d))
    mul(b, c) = mul(c, b)
    mul(b, mul(c, d)) = mul(mul(b, c), d) = mul(mul(c, b), d) = mul(c, mul(b, d))
    mul(mul(a, b), mul(c, d)) = mul(a, mul(b, mul(c, d))) = mul(a, mul(c, mul(b, d))) = mul(mul(a, c), mul(b, d))

thm _group_left_cancel:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A, a, b, c A:
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(inv(u), u) = one
        mul(a, b) = mul(a, c)
        =>:
            b = c
    mul(inv(a), a) = one
    b = mul(one, b) = mul(mul(inv(a), a), b) = mul(inv(a), mul(a, b)) = mul(inv(a), mul(a, c)) = mul(mul(inv(a), a), c) = mul(one, c) = c

thm _group_mul_one:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(inv(u), u) = one
        =>:
            mul(a, one) = a
    mul(inv(a), a) = one
    mul(inv(a), mul(a, one)) = mul(mul(inv(a), a), one) = mul(one, one) = one = mul(inv(a), a)
    release thm _group_left_cancel(A, mul, one, inv, inv(a), mul(a, one), a)

thm mul_inv_cancel:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(inv(u), u) = one
        =>:
            mul(a, inv(a)) = one
    mul(inv(a), a) = one
    release thm _group_mul_one(A, mul, one, inv, inv(a))
    mul(inv(a), mul(a, inv(a))) = mul(mul(inv(a), a), inv(a)) = mul(one, inv(a)) = inv(a) = mul(inv(a), one)
    release thm _group_left_cancel(A, mul, one, inv, inv(a), mul(a, inv(a)), one)

thm mul_one:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(inv(u), u) = one
        =>:
            mul(a, one) = a
    release thm _group_mul_one(A, mul, one, inv, a)

thm mul_inv_rev:
    ? forall A nonempty_set, mul fn(x, y A) A, one A, inv fn(x A) A, a, b A:
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(inv(u), u) = one
        =>:
            inv(mul(a, b)) = mul(inv(b), inv(a))
    thm multiply_right_equal:
        ? forall u, v, w A:
            u = v
            =>:
                mul(u, w) = mul(v, w)
    mul(inv(a), a) = one
    mul(inv(a), mul(a, b)) = mul(mul(inv(a), a), b) = mul(one, b) = b
    mul(mul(inv(b), inv(a)), mul(a, b)) = mul(inv(b), mul(inv(a), mul(a, b))) = mul(inv(b), b) = one
    release thm mul_inv_cancel(A, mul, one, inv, mul(a, b))
    release thm _group_mul_one(A, mul, one, inv, mul(inv(b), inv(a)))
    by thm multiply_right_equal(mul(mul(inv(b), inv(a)), mul(a, b)), one, inv(mul(a, b))) => mul(mul(mul(inv(b), inv(a)), mul(a, b)), inv(mul(a, b))) = mul(one, inv(mul(a, b)))
    mul(inv(b), inv(a)) = mul(mul(inv(b), inv(a)), one) = mul(mul(inv(b), inv(a)), mul(mul(a, b), inv(mul(a, b)))) = mul(mul(mul(inv(b), inv(a)), mul(a, b)), inv(mul(a, b))) = mul(one, inv(mul(a, b))) = inv(mul(a, b))

thm lattice_le_trans:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y, z A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        (x, y) $in le_rel
        (y, z) $in le_rel
        =>:
            (x, z) $in le_rel

thm lattice_meet_comm:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        =>:
            meet(x, y) = meet(y, x)
    (meet(x, y), y) $in le_rel
    (meet(x, y), x) $in le_rel
    (meet(x, y), meet(y, x)) $in le_rel
    (meet(y, x), x) $in le_rel
    (meet(y, x), y) $in le_rel
    (meet(y, x), meet(x, y)) $in le_rel

thm lattice_meet_assoc:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y, z A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        =>:
            meet(meet(x, y), z) = meet(x, meet(y, z))
    release thm lattice_le_trans(A, le_rel, meet, join, meet(meet(x, y), z), meet(x, y), x)
    release thm lattice_le_trans(A, le_rel, meet, join, meet(meet(x, y), z), meet(x, y), y)
    (meet(meet(x, y), z), z) $in le_rel
    (meet(meet(x, y), z), meet(y, z)) $in le_rel
    (meet(meet(x, y), z), meet(x, meet(y, z))) $in le_rel
    (meet(x, meet(y, z)), x) $in le_rel
    release thm lattice_le_trans(A, le_rel, meet, join, meet(x, meet(y, z)), meet(y, z), y)
    release thm lattice_le_trans(A, le_rel, meet, join, meet(x, meet(y, z)), meet(y, z), z)
    (meet(x, meet(y, z)), meet(x, y)) $in le_rel
    (meet(x, meet(y, z)), meet(meet(x, y), z)) $in le_rel

thm lattice_join_comm:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        =>:
            join(x, y) = join(y, x)
    (y, join(x, y)) $in le_rel
    (x, join(x, y)) $in le_rel
    (join(y, x), join(x, y)) $in le_rel
    (x, join(y, x)) $in le_rel
    (y, join(y, x)) $in le_rel
    (join(x, y), join(y, x)) $in le_rel

thm lattice_join_assoc:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y, z A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        =>:
            join(join(x, y), z) = join(x, join(y, z))
    release thm lattice_le_trans(A, le_rel, meet, join, x, join(x, y), join(join(x, y), z))
    release thm lattice_le_trans(A, le_rel, meet, join, y, join(x, y), join(join(x, y), z))
    (z, join(join(x, y), z)) $in le_rel
    (join(y, z), join(join(x, y), z)) $in le_rel
    (join(x, join(y, z)), join(join(x, y), z)) $in le_rel
    (x, join(x, join(y, z))) $in le_rel
    release thm lattice_le_trans(A, le_rel, meet, join, y, join(y, z), join(x, join(y, z)))
    release thm lattice_le_trans(A, le_rel, meet, join, z, join(y, z), join(x, join(y, z)))
    (join(x, y), join(x, join(y, z))) $in le_rel
    (join(join(x, y), z), join(x, join(y, z))) $in le_rel

thm lattice_meet_join_absorb:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        =>:
            meet(x, join(x, y)) = x
    (meet(x, join(x, y)), x) $in le_rel
    (x, x) $in le_rel
    (x, join(x, y)) $in le_rel
    (x, meet(x, join(x, y))) $in le_rel

thm lattice_join_meet_absorb:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, x, y A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        =>:
            join(x, meet(x, y)) = x
    (x, join(x, meet(x, y))) $in le_rel
    (x, x) $in le_rel
    (meet(x, y), x) $in le_rel
    (join(x, meet(x, y)), x) $in le_rel

thm lattice_join_meet_distributive_of_meet_join_distributive:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, a, b, c A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        forall x, y, z A:
            meet(x, join(y, z)) = join(meet(x, y), meet(x, z))
        =>:
            join(a, meet(b, c)) = meet(join(a, b), join(a, c))
    release thm lattice_meet_comm(A, le_rel, meet, join, join(a, b), a)
    release thm lattice_meet_join_absorb(A, le_rel, meet, join, a, b)
    release thm lattice_meet_comm(A, le_rel, meet, join, join(a, b), c)
    release thm lattice_meet_comm(A, le_rel, meet, join, c, a)
    release thm lattice_meet_comm(A, le_rel, meet, join, c, b)
    meet(join(a, b), c) = meet(c, join(a, b)) = join(meet(c, a), meet(c, b)) = join(meet(a, c), meet(c, b)) = join(meet(a, c), meet(b, c))
    release thm lattice_join_assoc(A, le_rel, meet, join, a, meet(a, c), meet(b, c))
    release thm lattice_join_meet_absorb(A, le_rel, meet, join, a, c)
    meet(join(a, b), join(a, c)) = join(meet(join(a, b), a), meet(join(a, b), c)) = join(a, meet(join(a, b), c)) = join(a, join(meet(a, c), meet(b, c))) = join(join(a, meet(a, c)), meet(b, c)) = join(a, meet(b, c))

thm lattice_meet_join_distributive_of_join_meet_distributive:
    ? forall A nonempty_set, le_rel power_set(cart(A, A)), meet fn(x, y A) A, join fn(x, y A) A, a, b, c A:
        forall u A:
            (u, u) $in le_rel
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v A:
            (meet(u, v), u) $in le_rel
        forall u, v A:
            (meet(u, v), v) $in le_rel
        forall u, v A:
            (u, join(u, v)) $in le_rel
        forall u, v A:
            (v, join(u, v)) $in le_rel
        forall u, v, w A:
            (w, u) $in le_rel
            (w, v) $in le_rel
            =>:
                (w, meet(u, v)) $in le_rel
        forall u, v, w A:
            (u, w) $in le_rel
            (v, w) $in le_rel
            =>:
                (join(u, v), w) $in le_rel
        forall x, y, z A:
            join(x, meet(y, z)) = meet(join(x, y), join(x, z))
        =>:
            meet(a, join(b, c)) = join(meet(a, b), meet(a, c))
    release thm lattice_join_comm(A, le_rel, meet, join, meet(a, b), a)
    release thm lattice_join_meet_absorb(A, le_rel, meet, join, a, b)
    release thm lattice_join_comm(A, le_rel, meet, join, meet(a, b), c)
    release thm lattice_join_comm(A, le_rel, meet, join, c, a)
    release thm lattice_join_comm(A, le_rel, meet, join, c, b)
    join(meet(a, b), c) = join(c, meet(a, b)) = meet(join(c, a), join(c, b)) = meet(join(a, c), join(c, b)) = meet(join(a, c), join(b, c))
    release thm lattice_meet_assoc(A, le_rel, meet, join, a, join(a, c), join(b, c))
    release thm lattice_meet_join_absorb(A, le_rel, meet, join, a, c)
    join(meet(a, b), meet(a, c)) = meet(join(meet(a, b), a), join(meet(a, b), c)) = meet(a, join(meet(a, b), c)) = meet(a, meet(join(a, c), join(b, c))) = meet(meet(a, join(a, c)), join(b, c)) = meet(a, join(b, c))

thm ring_sub_nonnegative_of_le:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, le_rel power_set(cart(A, A)), a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u A:
            (u, u) $in le_rel
        forall u, v A:
            add(u, v) = add(v, u)
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v, w A:
            (u, v) $in le_rel
            =>:
                (add(w, u), add(w, v)) $in le_rel
        forall u, v A:
            (zero, u) $in le_rel
            (zero, v) $in le_rel
            =>:
                (zero, mul(u, v)) $in le_rel
        (a, b) $in le_rel
        =>:
            (zero, add(b, neg(a))) $in le_rel
    (add(neg(a), a), add(neg(a), b)) $in le_rel
    add(neg(a), a) = zero
    add(neg(a), b) = add(b, neg(a))
    (zero, add(b, neg(a))) = (add(neg(a), a), add(neg(a), b))

thm ring_le_of_sub_nonnegative:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, le_rel power_set(cart(A, A)), a, b A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u A:
            (u, u) $in le_rel
        forall u, v A:
            add(u, v) = add(v, u)
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v, w A:
            (u, v) $in le_rel
            =>:
                (add(w, u), add(w, v)) $in le_rel
        forall u, v A:
            (zero, u) $in le_rel
            (zero, v) $in le_rel
            =>:
                (zero, mul(u, v)) $in le_rel
        (zero, add(b, neg(a))) $in le_rel
        =>:
            (a, b) $in le_rel
    (add(a, zero), add(a, add(b, neg(a)))) $in le_rel
    release thm add_zero(A, add, zero, neg, a)
    release thm add_neg_cancel(A, add, zero, neg, a)
    release thm add_zero(A, add, zero, neg, b)
    add(a, b) = add(b, a)
    add(add(a, b), neg(a)) = add(add(b, a), neg(a))
    add(a, add(b, neg(a))) = add(add(a, b), neg(a)) = add(add(b, a), neg(a)) = add(b, add(a, neg(a))) = add(b, zero) = b
    (a, b) = (add(a, zero), add(a, add(b, neg(a))))

thm ring_mul_le_mul_right_of_nonnegative:
    ? forall A nonempty_set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, le_rel power_set(cart(A, A)), a, b, c A:
        forall u, v, w A:
            add(add(u, v), w) = add(u, add(v, w))
        forall u, v, w A:
            mul(mul(u, v), w) = mul(u, mul(v, w))
        forall u, v, w A:
            mul(u, add(v, w)) = add(mul(u, v), mul(u, w))
        forall u, v, w A:
            mul(add(u, v), w) = add(mul(u, w), mul(v, w))
        forall u A:
            add(zero, u) = u
        forall u A:
            add(neg(u), u) = zero
        forall u A:
            mul(one, u) = u
        forall u A:
            mul(u, one) = u
        forall u A:
            (u, u) $in le_rel
        forall u, v A:
            add(u, v) = add(v, u)
        forall u, v, w A:
            (u, v) $in le_rel
            (v, w) $in le_rel
            =>:
                (u, w) $in le_rel
        forall u, v A:
            (u, v) $in le_rel
            (v, u) $in le_rel
            =>:
                u = v
        forall u, v, w A:
            (u, v) $in le_rel
            =>:
                (add(w, u), add(w, v)) $in le_rel
        forall u, v A:
            (zero, u) $in le_rel
            (zero, v) $in le_rel
            =>:
                (zero, mul(u, v)) $in le_rel
        (a, b) $in le_rel
        (zero, c) $in le_rel
        =>:
            (mul(a, c), mul(b, c)) $in le_rel
    release thm ring_sub_nonnegative_of_le(A, add, zero, neg, mul, one, le_rel, a, b)
    (zero, mul(add(b, neg(a)), c)) $in le_rel
    release thm neg_mul_left(A, add, zero, neg, mul, one, a, c)
    mul(add(b, neg(a)), c) = add(mul(b, c), mul(neg(a), c)) = add(mul(b, c), neg(mul(a, c)))
    (zero, add(mul(b, c), neg(mul(a, c)))) = (zero, mul(add(b, neg(a)), c))
    release thm ring_le_of_sub_nonnegative(A, add, zero, neg, mul, one, le_rel, mul(a, c), mul(b, c))

thm metric_distance_nonnegative:
    ? forall X set, dist fn(x, y X) R, x, y X:
        forall u, v X:
            dist(u, v) >= 0
        forall u, v X:
            dist(u, v) = 0
            =>:
                u = v
        forall u, v X:
            u = v
            =>:
                dist(u, v) = 0
        forall u, v X:
            dist(u, v) = dist(v, u)
        forall u, v, w X:
            dist(u, w) <= dist(u, v) + dist(v, w)
        =>:
            dist(x, y) >= 0

thm metric_eq_of_distance_zero:
    ? forall X set, dist fn(x, y X) R, x, y X:
        forall u, v X:
            dist(u, v) >= 0
        forall u, v X:
            dist(u, v) = 0
            =>:
                u = v
        forall u, v X:
            u = v
            =>:
                dist(u, v) = 0
        forall u, v X:
            dist(u, v) = dist(v, u)
        forall u, v, w X:
            dist(u, w) <= dist(u, v) + dist(v, w)
        dist(x, y) = 0
        =>:
            x = y

thm metric_distance_self_zero:
    ? forall X set, dist fn(x, y X) R, x X:
        forall u, v X:
            dist(u, v) >= 0
        forall u, v X:
            dist(u, v) = 0
            =>:
                u = v
        forall u, v X:
            u = v
            =>:
                dist(u, v) = 0
        forall u, v X:
            dist(u, v) = dist(v, u)
        forall u, v, w X:
            dist(u, w) <= dist(u, v) + dist(v, w)
        =>:
            dist(x, x) = 0

prop ring_laws(A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A):
    $additive_commutative_group_laws(A, add, zero, neg)
    forall x, y, z A:
        mul(mul(x, y), z) = mul(x, mul(y, z))
    forall x, y, z A:
        mul(x, add(y, z)) = add(mul(x, y), mul(x, z))
    forall x, y, z A:
        mul(add(x, y), z) = add(mul(x, z), mul(y, z))
    forall x A:
        mul(one, x) = x
    forall x A:
        mul(x, one) = x

prop group_laws(A set, mul fn(x, y A) A, one A, inv fn(x A) A):
    forall x, y, z A:
        mul(mul(x, y), z) = mul(x, mul(y, z))
    forall x A:
        mul(one, x) = x
    forall x A:
        mul(inv(x), x) = one

thm add_zero_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(a, zero) = a
    add(a, zero) = add(zero, a) = a

thm add_neg_cancel_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(a, neg(a)) = zero
    add(a, neg(a)) = add(neg(a), a) = zero

struct AdditiveCommutativeGroup<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    <=>:
        forall x, y, z s:
            add(add(x, y), z) = add(x, add(y, z))
        forall x s:
            add(zero, x) = x
        forall x s:
            add(neg(x), x) = zero
        forall x, y s:
            add(x, y) = add(y, x)

template<s nonempty_set, group &AdditiveCommutativeGroup<s>>:
    have fn additive_sub(x, y s) s = group.add(x, group.neg(y))

thm add_neg_cancel_structure:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a s:
        group.add(a, group.neg(a)) = group.zero
    group.add(a, group.neg(a)) = group.add(group.neg(a), a) = group.zero

thm add_zero_structure:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a s:
        group.add(a, group.zero) = a
    group.add(a, group.zero) = group.add(group.zero, a) = a

thm add_left_cancel_in_additive_commutative_group_structure:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a, b, c s:
        group.add(a, b) = group.add(a, c)
        =>:
            b = c
    group.add(group.neg(a), group.add(a, b)) = group.add(group.neg(a), group.add(a, c))
    group.add(group.neg(a), a) = group.zero
    group.add(group.zero, b) = b
    group.add(group.zero, c) = c
    group.add(group.neg(a), group.add(a, b)) = group.add(group.add(group.neg(a), a), b) = group.add(group.zero, b) = b
    group.add(group.neg(a), group.add(a, c)) = group.add(group.add(group.neg(a), a), c) = group.add(group.zero, c) = c

thm self_sub_structure:
    ? forall s nonempty_set, group &AdditiveCommutativeGroup<s>, a s:
        \additive_sub<s, group>(a, a) = group.zero
    \additive_sub<s, group>(a, a) = group.add(a, group.neg(a))
    release thm add_neg_cancel_structure(s, group, a)

thm one_add_one_eq_two_structure:
    ? forall s nonempty_set, ring &Ring<s>:
        ring.add(ring.one, ring.one) = \ring_two<s, ring>
    \ring_two<s, ring> = ring.add(ring.one, ring.one)

thm two_mul_structure:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(\ring_two<s, ring>, a) = ring.add(a, a)
    \ring_two<s, ring> = ring.add(ring.one, ring.one)
    ring.mul(ring.one, a) = a
    ring.add(ring.mul(ring.one, a), ring.mul(ring.one, a)) = ring.add(a, a)
    ring.mul(\ring_two<s, ring>, a) = ring.mul(ring.add(ring.one, ring.one), a) = ring.add(ring.mul(ring.one, a), ring.mul(ring.one, a)) = ring.add(a, a)

thm mul_zero_structure:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(a, ring.zero) = ring.zero
    by thm mul_zero(s, ring.add, ring.zero, ring.neg, ring.mul, ring.one, a) => ring.mul(a, ring.zero) = ring.zero

thm zero_mul_structure:
    ? forall s nonempty_set, ring &Ring<s>, a s:
        ring.mul(ring.zero, a) = ring.zero
    by thm zero_mul(s, ring.add, ring.zero, ring.neg, ring.mul, ring.one, a) => ring.mul(ring.zero, a) = ring.zero

thm neg_add_cancel_left_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(neg(a), add(a, b)) = b
    add(neg(a), a) = zero
    add(zero, b) = b
    add(add(neg(a), a), b) = add(zero, b)
    add(neg(a), add(a, b)) = add(add(neg(a), a), b) = add(zero, b) = b

thm add_neg_cancel_right_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(add(a, b), neg(b)) = a
    release thm add_neg_cancel_from_laws(A, add, zero, neg, b)
    release thm add_zero_from_laws(A, add, zero, neg, a)
    add(add(a, b), neg(b)) = add(a, add(b, neg(b))) = add(a, zero) = a

thm add_left_cancel_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(a, b) = add(a, c)
        =>:
            b = c
    release thm neg_add_cancel_left_structure(A, add, zero, neg, a, b)
    release thm neg_add_cancel_left_structure(A, add, zero, neg, a, c)
    add(neg(a), add(a, b)) = add(neg(a), add(a, c))
    b = add(neg(a), add(a, b)) = add(neg(a), add(a, c)) = c

thm add_right_cancel_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(a, b) = add(c, b)
        =>:
            a = c
    add(b, a) = add(a, b) = add(c, b) = add(b, c)
    release thm add_left_cancel_structure(A, add, zero, neg, b, a, c)

thm mul_zero_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(a, zero) = zero
    add(zero, zero) = zero
    mul(a, zero) = mul(a, add(zero, zero)) = add(mul(a, zero), mul(a, zero))
    release thm add_zero_from_laws(A, add, zero, neg, mul(a, zero))
    add(mul(a, zero), mul(a, zero)) = mul(a, zero) = add(mul(a, zero), zero)
    release thm add_left_cancel_structure(A, add, zero, neg, mul(a, zero), mul(a, zero), zero)

thm zero_mul_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(zero, a) = zero
    add(zero, zero) = zero
    mul(zero, a) = mul(add(zero, zero), a) = add(mul(zero, a), mul(zero, a))
    release thm add_zero_from_laws(A, add, zero, neg, mul(zero, a))
    add(mul(zero, a), mul(zero, a)) = mul(zero, a) = add(mul(zero, a), zero)
    release thm add_left_cancel_structure(A, add, zero, neg, mul(zero, a), mul(zero, a), zero)

thm self_add_neg_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(a, neg(a)) = zero
    release thm add_neg_cancel_from_laws(A, add, zero, neg, a)

thm ring_two_reflexive_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            add(one, one) = add(one, one)

thm two_mul_from_laws:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, a A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(add(one, one), a) = add(a, a)
    mul(one, a) = a
    add(mul(one, a), mul(one, a)) = add(a, a)
    mul(add(one, one), a) = add(mul(one, a), mul(one, a)) = add(a, a)

thm add_reorder_four_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, a, b, c, d A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            add(add(a, b), add(c, d)) = add(add(a, c), add(b, d))
    add(add(a, b), add(c, d)) = add(a, add(b, add(c, d)))
    add(b, add(c, d)) = add(add(b, c), d)
    add(b, c) = add(c, b)
    add(add(b, c), d) = add(add(c, b), d) = add(c, add(b, d))
    add(a, add(b, add(c, d))) = add(a, add(c, add(b, d)))
    add(a, add(c, add(b, d))) = add(add(a, c), add(b, d))

thm eq_neg_of_add_eq_zero_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, x, y A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(x, y) = zero
        =>:
            y = neg(x)
    release thm add_neg_cancel_from_laws(A, add, zero, neg, x)
    add(x, y) = zero = add(x, neg(x))
    release thm add_left_cancel_structure(A, add, zero, neg, x, y, neg(x))

thm neg_eq_of_add_eq_zero_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, x, y A:
        $additive_commutative_group_laws(A, add, zero, neg)
        add(x, y) = zero
        =>:
            neg(x) = y
    release thm eq_neg_of_add_eq_zero_structure(A, add, zero, neg, x, y)

thm neg_zero_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            neg(zero) = zero
    release thm neg_eq_of_add_eq_zero_structure(A, add, zero, neg, zero, zero)

thm neg_neg_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, x A:
        $additive_commutative_group_laws(A, add, zero, neg)
        =>:
            neg(neg(x)) = x
    add(neg(x), x) = zero
    release thm eq_neg_of_add_eq_zero_structure(A, add, zero, neg, neg(x), x)
    x = neg(neg(x))

thm mul_neg_right_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, x, y A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(x, neg(y)) = neg(mul(x, y))
    release thm mul_zero_from_laws(A, add, zero, neg, mul, one, x)
    release thm add_neg_cancel_from_laws(A, add, zero, neg, y)
    add(mul(x, y), mul(x, neg(y))) = mul(x, add(y, neg(y))) = mul(x, zero) = zero
    release thm eq_neg_of_add_eq_zero_structure(A, add, zero, neg, mul(x, y), mul(x, neg(y)))

thm neg_mul_left_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, x, y A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(neg(x), y) = neg(mul(x, y))
    release thm zero_mul_from_laws(A, add, zero, neg, mul, one, y)
    release thm add_neg_cancel_from_laws(A, add, zero, neg, x)
    add(mul(x, y), mul(neg(x), y)) = mul(add(x, neg(x)), y) = mul(zero, y) = zero
    release thm eq_neg_of_add_eq_zero_structure(A, add, zero, neg, mul(x, y), mul(neg(x), y))

thm neg_mul_neg_structure:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, x, y A:
        $ring_laws(A, add, zero, neg, mul, one)
        =>:
            mul(neg(x), neg(y)) = mul(x, y)
    release thm neg_mul_left_structure(A, add, zero, neg, mul, one, x, neg(y))
    release thm mul_neg_right_structure(A, add, zero, neg, mul, one, x, y)
    release thm neg_neg_structure(A, add, zero, neg, mul(x, y))
    mul(neg(x), neg(y)) = neg(mul(x, neg(y))) = neg(neg(mul(x, y))) = mul(x, y)

thm commutative_mul_reorder_four_structure:
    ? forall A set, mul fn(x, y A) A, a, b, c, d A:
        forall x, y, z A:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x, y A:
            mul(x, y) = mul(y, x)
        =>:
            mul(mul(a, b), mul(c, d)) = mul(mul(a, c), mul(b, d))
    mul(mul(a, b), mul(c, d)) = mul(a, mul(b, mul(c, d)))
    mul(b, mul(c, d)) = mul(mul(b, c), d)
    mul(b, c) = mul(c, b)
    mul(mul(b, c), d) = mul(mul(c, b), d) = mul(c, mul(b, d))
    mul(a, mul(b, mul(c, d))) = mul(a, mul(c, mul(b, d)))
    mul(a, mul(c, mul(b, d))) = mul(mul(a, c), mul(b, d))

thm _group_left_cancel_structure:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a, b, c A:
        $group_laws(A, mul, one, inv)
        mul(a, b) = mul(a, c)
        =>:
            b = c
    mul(inv(a), mul(a, b)) = mul(inv(a), mul(a, c))
    mul(inv(a), a) = one
    mul(one, b) = b
    mul(one, c) = c
    mul(mul(inv(a), a), b) = mul(one, b)
    mul(mul(inv(a), a), c) = mul(one, c)
    mul(inv(a), mul(a, b)) = mul(mul(inv(a), a), b) = mul(one, b) = b
    mul(inv(a), mul(a, c)) = mul(mul(inv(a), a), c) = mul(one, c) = c

thm _group_mul_one_structure:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        $group_laws(A, mul, one, inv)
        =>:
            mul(a, one) = a
    mul(inv(a), a) = one
    mul(one, one) = one
    mul(mul(inv(a), a), one) = mul(one, one)
    mul(inv(a), mul(a, one)) = mul(mul(inv(a), a), one) = mul(one, one) = one
    mul(inv(a), a) = one
    mul(inv(a), mul(a, one)) = mul(inv(a), a)
    release thm _group_left_cancel_structure(A, mul, one, inv, inv(a), mul(a, one), a)

thm mul_inv_cancel_structure:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        $group_laws(A, mul, one, inv)
        =>:
            mul(a, inv(a)) = one
    mul(inv(a), a) = one
    mul(one, inv(a)) = inv(a)
    mul(mul(inv(a), a), inv(a)) = mul(one, inv(a))
    mul(inv(a), mul(a, inv(a))) = mul(mul(inv(a), a), inv(a)) = mul(one, inv(a)) = inv(a)
    release thm _group_mul_one_structure(A, mul, one, inv, inv(a))
    mul(inv(a), one) = inv(a)
    mul(inv(a), mul(a, inv(a))) = mul(inv(a), one)
    release thm _group_left_cancel_structure(A, mul, one, inv, inv(a), mul(a, inv(a)), one)

thm mul_one_structure:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a A:
        $group_laws(A, mul, one, inv)
        =>:
            mul(a, one) = a
    release thm _group_mul_one_structure(A, mul, one, inv, a)

thm mul_inv_rev_structure:
    ? forall A set, mul fn(x, y A) A, one A, inv fn(x A) A, a, b A:
        $group_laws(A, mul, one, inv)
        =>:
            inv(mul(a, b)) = mul(inv(b), inv(a))
    witness $is_nonempty_set(A) from one
    by thm mul_inv_rev(A, mul, one, inv, a, b) => inv(mul(a, b)) = mul(inv(b), inv(a))

prop divides(a Z, b Z):
    exist k Z st {b = a * k}

thm _positive_divisor_le_abs:
    ? forall d N+, a Z:
        $divides(d, a)
        a != 0
        =>:
            d <= abs(a)
    obtain k from exist k Z st {a = d * k}
    by contra:
        ? k != 0
        k = 0
        a = d * k = d * 0 = 0
        impossible a != 0
    by cases:
        ? abs(k) > 0
        case k > 0:
            0 <= k
            abs(k) = k > 0
        case k <= 0:
            by contra:
                ? k < 0
                0 <= k
                k = 0
                impossible k != 0
            0 = k + (-k) < 0 + (-k) = -k
            -k > 0
            abs(k) = -k > 0
    abs(k) $in N+
    1 <= abs(k)
    d * 1 <= d * abs(k)
    abs(d) = d
    abs(a) = abs(d * k) = abs(d) * abs(k) = d * abs(k)
    d = d * 1 <= d * abs(k) = abs(a)

thm _gcd_divisor_set_is_finite_and_nonempty:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $is_finite_set({d N+: $divides(d, a), $divides(d, b)})
            $is_nonempty_set({d N+: $divides(d, a), $divides(d, b)})
    have CarrierC power_set(N+) = {d N+: $divides(d, a), $divides(d, b)}
    claim:
        ? $is_finite_set(CarrierC)
        by cases:
            ? $is_finite_set(CarrierC)
            case a != 0:
                claim:
                    ? forall d CarrierC:
                        d $in closed_range(1, abs(a))
                    d $in CarrierC
                    d $in N+
                    d >= 1
                    $divides(d, a)
                    release thm _positive_divisor_le_abs(d, a)
                    d <= abs(a)
                by def CarrierC $subset closed_range(1, abs(a))
                CarrierC $subset closed_range(1, abs(a))
                CarrierC = set_minus(closed_range(1, abs(a)), set_minus(closed_range(1, abs(a)), CarrierC))
                $is_finite_set(set_minus(closed_range(1, abs(a)), set_minus(closed_range(1, abs(a)), CarrierC)))
                $is_finite_set(CarrierC)
            case b != 0:
                claim:
                    ? forall d CarrierC:
                        d $in closed_range(1, abs(b))
                    d $in CarrierC
                    d $in N+
                    d >= 1
                    $divides(d, b)
                    release thm _positive_divisor_le_abs(d, b)
                    d <= abs(b)
                by def CarrierC $subset closed_range(1, abs(b))
                CarrierC $subset closed_range(1, abs(b))
                CarrierC = set_minus(closed_range(1, abs(b)), set_minus(closed_range(1, abs(b)), CarrierC))
                $is_finite_set(set_minus(closed_range(1, abs(b)), set_minus(closed_range(1, abs(b)), CarrierC)))
                $is_finite_set(CarrierC)
    witness $is_nonempty_set({d N+: $divides(d, a), $divides(d, b)}) from 1:
        1 $in N+
        witness exist k Z st {a = 1 * k} from a:
            a = 1 * a
        by def $divides(1, a)
        $divides(1, a)
        witness exist k Z st {b = 1 * k} from b:
            b = 1 * b
        by def $divides(1, b)
        $divides(1, b)
        release thm set_builder_member(1, {d N+: $divides(d, a), $divides(d, b)})
        1 $in {d N+: $divides(d, a), $divides(d, b)}
        1 $in CarrierC
    {d N+: $divides(d, a), $divides(d, b)} $subset CarrierC
    release thm subset_of_finite_set_is_finite({d N+: $divides(d, a), $divides(d, b)}, CarrierC)
    $is_finite_set({d N+: $divides(d, a), $divides(d, b)})
    $is_nonempty_set({d N+: $divides(d, a), $divides(d, b)})

thm gcd_positive:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            gcd(a, b) $in N+

thm gcd_divides_left:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), a)
    release thm gcd_positive(a, b)
    a % gcd(a, b) = 0
    exist k Z st {a = gcd(a, b) * k}
    by def:
        ? $divides(gcd(a, b), a)

thm gcd_divides_right:
    ? forall a, b Z:
        a != 0 or b != 0
        =>:
            $divides(gcd(a, b), b)
    release thm gcd_positive(a, b)
    b % gcd(a, b) = 0
    exist k Z st {b = gcd(a, b) * k}
    by def:
        ? $divides(gcd(a, b), b)

thm common_divisor_le_gcd:
    ? forall a, b Z, d N+:
        a != 0 or b != 0
        $divides(d, a)
        $divides(d, b)
        =>:
            d <= gcd(a, b)
    release thm gcd_positive(a, b)
    obtain ka from exist ka Z st {a = d * ka}
    obtain kb from exist kb Z st {b = d * kb}
    a = d * ka + 0
    b = d * kb + 0
    a % d = 0
    b % d = 0

thm gcd_euclidean_base:
    ? forall a Z:
        a != 0
        =>:
            gcd(a, 0) = abs(a)
    release thm gcd_positive(a, 0)
    release thm gcd_divides_left(a, 0)
    release thm _positive_divisor_le_abs(gcd(a, 0), a)
    gcd(a, 0) <= abs(a)
    abs(a) > 0
    abs(a) $in N+
    by cases:
        ? $divides(abs(a), a)
        case a >= 0:
            abs(a) = a
            a = a * 1
            abs(a) * 1 = a * 1
            a = abs(a) * 1
            witness exist k Z st {a = abs(a) * k} from 1
            by def $divides(abs(a), a)
        case a < 0:
            a <= 0
            abs(a) = -a
            a = (-a) * (-1) = abs(a) * (-1)
            witness exist k Z st {a = abs(a) * k} from -1
            by def $divides(abs(a), a)
    witness exist k Z st {0 = abs(a) * k} from 0:
        0 = abs(a) * 0
    by def $divides(abs(a), 0)
    $divides(abs(a), 0)
    release thm common_divisor_le_gcd(a, 0, abs(a))
    abs(a) <= gcd(a, 0)

thm gcd_comm:
    ? forall a, b N:
        a != 0 or b != 0
        b != 0 or a != 0
        =>:
            gcd(a, b) = gcd(b, a)
    release thm gcd_positive(a, b)
    release thm gcd_divides_left(a, b)
    release thm gcd_divides_right(a, b)
    release thm common_divisor_le_gcd(b, a, gcd(a, b))
    gcd(a, b) <= gcd(b, a)
    release thm gcd_positive(b, a)
    release thm gcd_divides_left(b, a)
    release thm gcd_divides_right(b, a)
    release thm common_divisor_le_gcd(a, b, gcd(b, a))
    gcd(b, a) <= gcd(a, b)

prop metric_space_laws(X set, dist fn(x, y X) R):
    forall x, y X:
        dist(x, y) >= 0
    forall x, y X:
        dist(x, y) = 0
        =>:
            x = y
    forall x, y X:
        x = y
        =>:
            dist(x, y) = 0
    forall x, y X:
        dist(x, y) = dist(y, x)
    forall x, y, z X:
        dist(x, z) <= dist(x, y) + dist(y, z)

template<X set>:
    have MetricSpace set = {dist fn(x, y X) R: $metric_space_laws(X, dist)}

thm metric_distance_nonnegative_structure:
    ? forall X set, metric fn(u, v X) R, x, y X:
        metric $in \MetricSpace<X>
        =>:
            metric(x, y) >= 0
    \MetricSpace<X> = {dist fn(u, v X) R: $metric_space_laws(X, dist)}
    by thm transport_membership(\MetricSpace<X>, {dist fn(u, v X) R: $metric_space_laws(X, dist)}, metric) => metric $in {dist fn(u, v X) R: $metric_space_laws(X, dist)}
    $metric_space_laws(X, metric)
    by def $metric_space_laws(X, metric)

thm metric_eq_of_distance_zero_structure:
    ? forall X set, metric fn(u, v X) R, x, y X:
        metric $in \MetricSpace<X>
        metric(x, y) = 0
        =>:
            x = y
    \MetricSpace<X> = {dist fn(u, v X) R: $metric_space_laws(X, dist)}
    by thm transport_membership(\MetricSpace<X>, {dist fn(u, v X) R: $metric_space_laws(X, dist)}, metric) => metric $in {dist fn(u, v X) R: $metric_space_laws(X, dist)}
    $metric_space_laws(X, metric)
    by def $metric_space_laws(X, metric)

thm metric_distance_self_zero_structure:
    ? forall X set, metric fn(u, v X) R, x X:
        metric $in \MetricSpace<X>
        =>:
            metric(x, x) = 0
    \MetricSpace<X> = {dist fn(u, v X) R: $metric_space_laws(X, dist)}
    by thm transport_membership(\MetricSpace<X>, {dist fn(u, v X) R: $metric_space_laws(X, dist)}, metric) => metric $in {dist fn(u, v X) R: $metric_space_laws(X, dist)}
    $metric_space_laws(X, metric)
    by def $metric_space_laws(X, metric)

