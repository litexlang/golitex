# Adapted from Mathematics in Lean; rewritten in Litex. See NOTICE.md.
# Chapter 7 — Structures
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter keeps records and their operations callable. Constructor syntax,
# projection syntax, typeclass syntax, and repeated proof styles are collapsed
# when they present the same mathematical object. Non-core alternate examples
# and presentation variants are not part of this source-facing slice.

# 7.1 Defining Structures

struct Point:
    x R
    y R
    z R

# Source definitions myPoint1--myPoint4 are four constructor spellings for the
# same object, so one representative is retained.
(-1) $in R
release thm struct_member((2, (-1), 4), &Point)
have point_example &Point = (2, (-1), 4)

# Source definitions Point.add and Point.add' collapse to one callable map.
thm point_add_closed:
    ? forall a, b &Point:
        (a.x + b.x, a.y + b.y, a.z + b.z) $in &Point
    release thm struct_member((a.x + b.x, a.y + b.y, a.z + b.z), &Point)

have fn point_add(a, b &Point) &Point = (a.x + b.x, a.y + b.y, a.z + b.z)

thm point_add_comm:
    ? forall a, b &Point:
        point_add(a, b) = point_add(b, a)
    point_add(a, b) = (a.x + b.x, a.y + b.y, a.z + b.z)
    point_add(b, a) = (b.x + a.x, b.y + a.y, b.z + a.z)
    point_add(a, b) = (a.x + b.x, a.y + b.y, a.z + b.z) = (b.x + a.x, b.y + a.y, b.z + a.z) = point_add(b, a)

# Source theorem Point.add_x. The explicit result parameter is a projection
# bridge for a function-produced record; the mathematical coordinate equation
# is unchanged.
thm point_add_x:
    ? forall a, b, result &Point:
        result = point_add(a, b)
        =>:
            result.x = a.x + b.x
    point_add(a, b) = (a.x + b.x, a.y + b.y, a.z + b.z)
    result = point_add(a, b) = (a.x + b.x, a.y + b.y, a.z + b.z)
    result.x = result(1) = a.x + b.x

# A structure with proof fields becomes a record-shaped subset whose defining
# conditions are projected automatically.
struct StandardTwoSimplex:
    x R
    y R
    z R
    <=>:
        x >= 0
        y >= 0
        z >= 0
        x + y + z = 1

thm simplex_swap_xy_closed:
    ? forall a &StandardTwoSimplex:
        (a.y, a.x, a.z) $in &StandardTwoSimplex
    a.y >= 0
    a.x >= 0
    a.z >= 0
    a.y + a.x + a.z = a.x + a.y + a.z = 1
    release thm struct_member((a.y, a.x, a.z), &StandardTwoSimplex)

have fn simplex_swap_xy(a &StandardTwoSimplex) &StandardTwoSimplex = (a.y, a.x, a.z)

# Closure is proved before defining the typed midpoint, making the constructor
# obligation explicit and trust-free.
thm standard_two_simplex_midpoint_closed:
    ? forall a, b &StandardTwoSimplex:
        ((a.x + b.x) / 2, (a.y + b.y) / 2, (a.z + b.z) / 2) $in &StandardTwoSimplex
    a.x + b.x >= 0
    a.y + b.y >= 0
    a.z + b.z >= 0
    2 > 0
    (a.x + b.x) / 2 >= 0
    (a.y + b.y) / 2 >= 0
    (a.z + b.z) / 2 >= 0
    (a.x + b.x) / 2 + (a.y + b.y) / 2 + (a.z + b.z) / 2 = ((a.x + a.y + a.z) + (b.x + b.y + b.z)) / 2 = (1 + 1) / 2 = 1
    release thm struct_member(((a.x + b.x) / 2, (a.y + b.y) / 2, (a.z + b.z) / 2), &StandardTwoSimplex)

have fn standard_two_simplex_midpoint(a, b &StandardTwoSimplex) &StandardTwoSimplex = ((a.x + b.x) / 2, (a.y + b.y) / 2, (a.z + b.z) / 2)

# Source structure StandardSimplex(n). It has one data field V and proof fields;
# the faithful Litex object is the subset of coordinate functions satisfying
# the two laws, not a nullary prop pretending to be a record.
prop is_standard_simplex_point(n N, v fn(idx range(0, n)) R):
    forall idx range(0, n):
        v(idx) >= 0
    finite_set_sum(range(0, n), v) = 1

template<n N>:
    have standard_simplex set = {v fn(idx range(0, n)) R: $is_standard_simplex_point(n, v)}
claim:
    ? forall X finite_set, a, b fn(x X) R:
        finite_set_sum(X, fn(x X) R {a(x) + b(x)}) = finite_set_sum(X, a) + finite_set_sum(X, b)

# Source definition StandardSimplex.midpoint. The construction averages each
# coordinate. The proof first preserves coordinatewise nonnegativity, then uses
# finite-sum linearity and the two unit-sum laws to recover total sum one.
claim:
    ? forall X finite_set, f fn(x X) R:
        finite_set_sum(X, fn(x X) R {(1 / 2) * f(x)}) = (1 / 2) * finite_set_sum(X, f)
thm standard_simplex_midpoint_closed:
    ? forall n N, a, b fn(idx range(0, n)) R:
        a $in \standard_simplex<n>
        b $in \standard_simplex<n>
        =>:
            $is_standard_simplex_point(n, fn(idx range(0, n)) R {(a(idx) + b(idx)) / 2})
    \standard_simplex<n> = {v fn(idx range(0, n)) R: $is_standard_simplex_point(n, v)}
    by thm chap2::transport_membership(\standard_simplex<n>, {v fn(idx range(0, n)) R: $is_standard_simplex_point(n, v)}, a) => a $in {v fn(idx range(0, n)) R: $is_standard_simplex_point(n, v)}
    by thm chap2::transport_membership(\standard_simplex<n>, {v fn(idx range(0, n)) R: $is_standard_simplex_point(n, v)}, b) => b $in {v fn(idx range(0, n)) R: $is_standard_simplex_point(n, v)}
    by def $is_standard_simplex_point(n, a)
    by def $is_standard_simplex_point(n, b)
    claim:
        ? forall idx range(0, n):
            (a(idx) + b(idx)) / 2 >= 0
        a(idx) >= 0
        b(idx) >= 0
        a(idx) + b(idx) >= 0
        2 > 0
        (a(idx) + b(idx)) / 2 >= 0
    $is_finite_set(range(0, n))
    have fn combined(idx range(0, n)) R = a(idx) + b(idx)
    claim:
        ? forall idx range(0, n):
            (a(idx) + b(idx)) / 2 = (1 / 2) * combined(idx)
        combined(idx) = a(idx) + b(idx)
        (1 / 2) * combined(idx) = (1 / 2) * (a(idx) + b(idx)) = (a(idx) + b(idx)) / 2
    release thm finite_set_sum_substitution(finite_set_sum(range(0, n), fn(idx range(0, n)) R {(a(idx) + b(idx)) / 2}), finite_set_sum(range(0, n), fn(idx range(0, n)) R {(1 / 2) * combined(idx)}))
    finite_set_sum(range(0, n), fn(idx range(0, n)) R {(a(idx) + b(idx)) / 2}) = finite_set_sum(range(0, n), fn(idx range(0, n)) R {(1 / 2) * combined(idx)})
    finite_set_sum(range(0, n), fn(idx range(0, n)) R {(1 / 2) * combined(idx)}) = (1 / 2) * finite_set_sum(range(0, n), combined)
    finite_set_sum(range(0, n), combined) = finite_set_sum(range(0, n), a) + finite_set_sum(range(0, n), b)
    finite_set_sum(range(0, n), a) = 1
    finite_set_sum(range(0, n), b) = 1
    finite_set_sum(range(0, n), fn(idx range(0, n)) R {(a(idx) + b(idx)) / 2}) = finite_set_sum(range(0, n), fn(idx range(0, n)) R {(1 / 2) * combined(idx)}) = (1 / 2) * finite_set_sum(range(0, n), combined) = (1 / 2) * (finite_set_sum(range(0, n), a) + finite_set_sum(range(0, n), b)) = (1 / 2) * (1 + 1) = 1
    by def $is_standard_simplex_point(n, fn(idx range(0, n)) R {(a(idx) + b(idx)) / 2})

# The midpoint remains a callable function-valued construction. Its checked
# codomain law is the preceding source-facing closure theorem.
template<n N>:
    have fn standard_simplex_midpoint(a, b fn(idx range(0, n)) R: a $in \standard_simplex<n>, b $in \standard_simplex<n>) fn(idx range(0, n)) R = fn(j range(0, n)) R {(a(j) + b(j)) / 2}

# Source structure IsLinear has no independent data field beyond the candidate
# f, so it is correctly modeled as a property of that callable function.
prop is_linear_real(f fn(x R) R):
    forall x, y R:
        f(x + y) = f(x) + f(y)
    forall x, c R:
        f(c * x) = c * f(x)

# The later Point', Point'', IsLinear', PReal, and subtype simplex definitions
# are alternative encodings of Point, is_linear_real, R+, and the two
# simplex carriers above; they do not create new mathematical objects here.
# 7.2 Algebraic Structures
# Equiv is a genuine two-function record. It is usable even for empty carriers,
# so its carrier parameters are sets rather than nonempty sets.
struct Equiv<s, t set>:
    forward fn(x s) t
    inverse fn(y t) s
    <=>:
        forall x s:
            inverse(forward(x)) = x
        forall y t:
            forward(inverse(y)) = y

thm equiv_refl_closed:
    ? forall s set:
        (fn(x s) s {x}, fn(y s) s {y}) $in &Equiv<s, s>
    release thm fn_set_member(fn(x s) s {x}, fn(x s) s)
    release thm fn_set_member(fn(y s) s {y}, fn(y s) s)
    release thm cart_member_from_coordinates((fn(x s) s {x}, fn(y s) s {y}), cart(fn(x s) s, fn(y s) s))
    claim:
        ? forall x s:
            (fn(y s) s {y})((fn(q s) s {q})(x)) = x
    claim:
        ? forall y s:
            (fn(x s) s {x})((fn(q s) s {q})(y)) = y
    release thm struct_member((fn(x s) s {x}, fn(y s) s {y}), &Equiv<s, s>)

template<s set>:
    have equiv_refl &Equiv<s, s> = (fn(x s) s {x}, fn(y s) s {y})

thm equiv_symm_closed:
    ? forall s, t set, endpoint &Equiv<s, t>:
        (endpoint.inverse, endpoint.forward) $in &Equiv<t, s>
    endpoint.inverse $in fn(y t) s
    endpoint.forward $in fn(x s) t
    release thm cart_member_from_coordinates((endpoint.inverse, endpoint.forward), cart(fn(y t) s, fn(x s) t))
    claim:
        ? forall y t:
            endpoint.forward(endpoint.inverse(y)) = y
    claim:
        ? forall x s:
            endpoint.inverse(endpoint.forward(x)) = x
    release thm struct_member((endpoint.inverse, endpoint.forward), &Equiv<t, s>)

template<s, t set>:
    have fn equiv_symm(endpoint &Equiv<s, t>) &Equiv<t, s> = (endpoint.inverse, endpoint.forward)

# Composition is an actual equivalence record. Its two inverse laws follow by
# substituting the component inverse laws; the record-membership conclusion is
# checked directly.
thm equiv_trans_closed:
    ? forall s, t, u set, e1 &Equiv<s, t>, e2 &Equiv<t, u>:
        (fn(x s) u {e2.forward(e1.forward(x))}, fn(z u) s {e1.inverse(e2.inverse(z))}) $in &Equiv<s, u>
    release thm fn_set_member(fn(x s) u {e2.forward(e1.forward(x))}, fn(x s) u)
    release thm fn_set_member(fn(z u) s {e1.inverse(e2.inverse(z))}, fn(z u) s)
    release thm cart_member_from_coordinates((fn(x s) u {e2.forward(e1.forward(x))}, fn(z u) s {e1.inverse(e2.inverse(z))}), cart(fn(x s) u, fn(z u) s))
    thm function_substitution:
        ? forall A, B set, f fn(x A) B, x, y A:
            x = y
            =>:
                f(x) = f(y)
    claim:
        ? forall x s:
            (fn(z u) s {e1.inverse(e2.inverse(z))})((fn(q s) u {e2.forward(e1.forward(q))})(x)) = x
        release thm function_substitution(t, s, e1.inverse, e2.inverse(e2.forward(e1.forward(x))), e1.forward(x))
        (fn(z u) s {e1.inverse(e2.inverse(z))})((fn(q s) u {e2.forward(e1.forward(q))})(x)) = e1.inverse(e2.inverse(e2.forward(e1.forward(x)))) = e1.inverse(e1.forward(x)) = x
    claim:
        ? forall z u:
            (fn(x s) u {e2.forward(e1.forward(x))})((fn(q u) s {e1.inverse(e2.inverse(q))})(z)) = z
        release thm function_substitution(t, u, e2.forward, e1.forward(e1.inverse(e2.inverse(z))), e2.inverse(z))
        (fn(x s) u {e2.forward(e1.forward(x))})((fn(q u) s {e1.inverse(e2.inverse(q))})(z)) = e2.forward(e1.forward(e1.inverse(e2.inverse(z)))) = e2.forward(e2.inverse(z)) = z
    release thm struct_member((fn(x s) u {e2.forward(e1.forward(x))}, fn(z u) s {e1.inverse(e2.inverse(z))}), &Equiv<s, u>)

template<s, t, u set>:
    have fn equiv_trans(e1 &Equiv<s, t>, e2 &Equiv<t, u>) &Equiv<s, u> = (fn(x s) u {e2.forward(e1.forward(x))}, fn(z u) s {e1.inverse(e2.inverse(z))})

thm equiv_space_nonempty:
    ? forall s set:
        $is_nonempty_set(&Equiv<s, s>)
    witness $is_nonempty_set(&Equiv<s, s>) from (fn(x s) s {x}, fn(x s) s {x}):
        release thm equiv_refl_closed(s)
        (fn(x s) s {x}, fn(x s) s {x}) $in &Equiv<s, s>

# Source definition permGroup. These three callable fields are the source's
# `Equiv.trans g f`, identity equivalence, and inverse equivalence.
template<s set>:
    have permutation_one &Equiv<s, s> = \equiv_refl<s>

template<s set>:
    have fn permutation_mul(f, g &Equiv<s, s>) &Equiv<s, s> = \equiv_trans<s, s, s>(g, f)

template<s set>:
    have fn permutation_inv(f &Equiv<s, s>) &Equiv<s, s> = \equiv_symm<s, s>(f)

# The equivalence carrier is nonempty even when s is empty, because it contains
# the identity equivalence. Naming it as nonempty_set makes it usable by Group.
template<s set>:
    have permutation_carrier nonempty_set = &Equiv<s, s>

# Computed Equiv values expose their callable fields through the same
# result-tuple bridge used by the coordinate records later in this chapter.
thm equiv_forward_from_result:
    ? forall s, t set, result &Equiv<s, t>, forward fn(x s) t, inverse fn(y t) s:
        result = (forward, inverse)
        =>:
            result.forward = forward
    result.forward = result(1) = forward

thm equiv_inverse_from_result:
    ? forall s, t set, result &Equiv<s, t>, forward fn(x s) t, inverse fn(y t) s:
        result = (forward, inverse)
        =>:
            result.inverse = inverse
    result.inverse = result(2) = inverse

# Function equality proves equality of the two record coordinates; explicit
# tuple reconstruction then gives extensional equality of equivalences.
thm equiv_extensionality:
    ? forall s, t set, left, right &Equiv<s, t>:
        left.forward = right.forward
        left.inverse = right.inverse
        =>:
            left = right
    release struct def left
    release struct def right
    left(1) = left.forward = right.forward = right(1)
    left(2) = left.inverse = right.inverse = right(2)
    release thm tuple_equal_from_coordinates(left, (left(1), left(2)))
    release thm tuple_equal_from_coordinates(right, (right(1), right(2)))
    (left(1), left(2)) = (right(1), right(2))
    left = (left(1), left(2)) = (right(1), right(2)) = right

template<s, t set>:
    have fn equiv_forward_apply(equivalence &Equiv<s, t>, x s) t = equivalence.forward(x)
thm permutation_mul_forward:
    ? forall s set, f, g &Equiv<s, s>, x s:
        \equiv_forward_apply<s, s>(\permutation_mul<s>(f, g), x) = f.forward(g.forward(x))
    have result &Equiv<s, s> = \permutation_mul<s>(f, g)
    result = \permutation_mul<s>(f, g) = \equiv_trans<s, s, s>(g, f) = (fn(q s) s {f.forward(g.forward(q))}, fn(z s) s {g.inverse(f.inverse(z))})
    release thm equiv_forward_from_result(s, s, result, fn(q s) s {f.forward(g.forward(q))}, fn(z s) s {g.inverse(f.inverse(z))})
    result.forward(x) = (fn(q s) s {f.forward(g.forward(q))})(x) = f.forward(g.forward(x))
    \equiv_forward_apply<s, s>(\permutation_mul<s>(f, g), x) = \equiv_forward_apply<s, s>(result, x) = result.forward(x) = f.forward(g.forward(x))

template<s, t set>:
    have fn equiv_inverse_apply(equivalence &Equiv<s, t>, x t) s = equivalence.inverse(x)
thm permutation_mul_inverse:
    ? forall s set, f, g &Equiv<s, s>, x s:
        \equiv_inverse_apply<s, s>(\permutation_mul<s>(f, g), x) = g.inverse(f.inverse(x))
    have result &Equiv<s, s> = \permutation_mul<s>(f, g)
    result = \permutation_mul<s>(f, g) = \equiv_trans<s, s, s>(g, f) = (fn(q s) s {f.forward(g.forward(q))}, fn(z s) s {g.inverse(f.inverse(z))})
    release thm equiv_inverse_from_result(s, s, result, fn(q s) s {f.forward(g.forward(q))}, fn(z s) s {g.inverse(f.inverse(z))})
    result.inverse(x) = (fn(z s) s {g.inverse(f.inverse(z))})(x) = g.inverse(f.inverse(x))
    \equiv_inverse_apply<s, s>(\permutation_mul<s>(f, g), x) = \equiv_inverse_apply<s, s>(result, x) = result.inverse(x) = g.inverse(f.inverse(x))

thm permutation_one_forward:
    ? forall s set, x s:
        \equiv_forward_apply<s, s>(\permutation_one<s>, x) = x
    have result &Equiv<s, s> = \permutation_one<s>
    result = \permutation_one<s> = \equiv_refl<s> = (fn(q s) s {q}, fn(z s) s {z})
    release thm equiv_forward_from_result(s, s, result, fn(q s) s {q}, fn(z s) s {z})
    result.forward(x) = (fn(q s) s {q})(x) = x
    \equiv_forward_apply<s, s>(\permutation_one<s>, x) = \equiv_forward_apply<s, s>(result, x) = result.forward(x) = x

thm permutation_one_inverse:
    ? forall s set, x s:
        \equiv_inverse_apply<s, s>(\permutation_one<s>, x) = x
    have result &Equiv<s, s> = \permutation_one<s>
    result = \permutation_one<s> = \equiv_refl<s> = (fn(q s) s {q}, fn(z s) s {z})
    release thm equiv_inverse_from_result(s, s, result, fn(q s) s {q}, fn(z s) s {z})
    result.inverse(x) = (fn(z s) s {z})(x) = x
    \equiv_inverse_apply<s, s>(\permutation_one<s>, x) = \equiv_inverse_apply<s, s>(result, x) = result.inverse(x) = x

thm permutation_inv_forward:
    ? forall s set, f &Equiv<s, s>, x s:
        \equiv_forward_apply<s, s>(\permutation_inv<s>(f), x) = f.inverse(x)
    have result &Equiv<s, s> = \permutation_inv<s>(f)
    result = \permutation_inv<s>(f) = \equiv_symm<s, s>(f) = (f.inverse, f.forward)
    release thm equiv_forward_from_result(s, s, result, f.inverse, f.forward)
    result.forward(x) = (f.inverse)(x) = f.inverse(x)
    \equiv_forward_apply<s, s>(\permutation_inv<s>(f), x) = \equiv_forward_apply<s, s>(result, x) = result.forward(x) = f.inverse(x)

thm permutation_inv_inverse:
    ? forall s set, f &Equiv<s, s>, x s:
        \equiv_inverse_apply<s, s>(\permutation_inv<s>(f), x) = f.forward(x)
    have result &Equiv<s, s> = \permutation_inv<s>(f)
    result = \permutation_inv<s>(f) = \equiv_symm<s, s>(f) = (f.inverse, f.forward)
    release thm equiv_inverse_from_result(s, s, result, f.inverse, f.forward)
    result.inverse(x) = (f.forward)(x) = f.forward(x)
    \equiv_inverse_apply<s, s>(\permutation_inv<s>(f), x) = \equiv_inverse_apply<s, s>(result, x) = result.inverse(x) = f.forward(x)

# The three source group laws reduce to pointwise equality of forward and
# inverse functions, followed by Equiv extensionality.
thm permutation_group_closed:
    ? forall s set:
        (\permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>) $in &chap2::Group<\permutation_carrier<s>>
    \permutation_carrier<s> = &Equiv<s, s>
    claim:
        ? forall f, g, h &Equiv<s, s>:
            \permutation_mul<s>(\permutation_mul<s>(f, g), h) = \permutation_mul<s>(f, \permutation_mul<s>(g, h))
        have fg &Equiv<s, s> = \permutation_mul<s>(f, g)
        have gh &Equiv<s, s> = \permutation_mul<s>(g, h)
        have assoc_left &Equiv<s, s> = \permutation_mul<s>(\permutation_mul<s>(f, g), h)
        have assoc_right &Equiv<s, s> = \permutation_mul<s>(f, \permutation_mul<s>(g, h))
        assoc_left = \permutation_mul<s>(fg, h)
        assoc_right = \permutation_mul<s>(f, gh)
        claim:
            ? forall x s:
                assoc_left.forward(x) = assoc_right.forward(x)
            release thm permutation_mul_forward(s, fg, h, x)
            release thm permutation_mul_forward(s, f, g, h.forward(x))
            release thm permutation_mul_forward(s, g, h, x)
            release thm permutation_mul_forward(s, f, gh, x)
            assoc_left.forward(x) = \equiv_forward_apply<s, s>(assoc_left, x) = \equiv_forward_apply<s, s>(\permutation_mul<s>(fg, h), x) = fg.forward(h.forward(x))
            fg.forward(h.forward(x)) = \equiv_forward_apply<s, s>(fg, h.forward(x)) = \equiv_forward_apply<s, s>(\permutation_mul<s>(f, g), h.forward(x)) = f.forward(g.forward(h.forward(x)))
            gh.forward(x) = \equiv_forward_apply<s, s>(gh, x) = \equiv_forward_apply<s, s>(\permutation_mul<s>(g, h), x) = g.forward(h.forward(x))
            assoc_right.forward(x) = \equiv_forward_apply<s, s>(assoc_right, x) = \equiv_forward_apply<s, s>(\permutation_mul<s>(f, gh), x) = f.forward(gh.forward(x)) = f.forward(g.forward(h.forward(x)))
        by fn_extension assoc_left.forward = assoc_right.forward
        claim:
            ? forall x s:
                assoc_left.inverse(x) = assoc_right.inverse(x)
            release thm permutation_mul_inverse(s, fg, h, x)
            release thm permutation_mul_inverse(s, f, g, x)
            release thm permutation_mul_inverse(s, g, h, f.inverse(x))
            release thm permutation_mul_inverse(s, f, gh, x)
            assoc_left.inverse(x) = \equiv_inverse_apply<s, s>(assoc_left, x) = \equiv_inverse_apply<s, s>(\permutation_mul<s>(fg, h), x) = h.inverse(fg.inverse(x))
            fg.inverse(x) = \equiv_inverse_apply<s, s>(fg, x) = \equiv_inverse_apply<s, s>(\permutation_mul<s>(f, g), x) = g.inverse(f.inverse(x))
            gh.inverse(f.inverse(x)) = \equiv_inverse_apply<s, s>(gh, f.inverse(x)) = \equiv_inverse_apply<s, s>(\permutation_mul<s>(g, h), f.inverse(x)) = h.inverse(g.inverse(f.inverse(x)))
            assoc_right.inverse(x) = \equiv_inverse_apply<s, s>(assoc_right, x) = \equiv_inverse_apply<s, s>(\permutation_mul<s>(f, gh), x) = gh.inverse(f.inverse(x)) = h.inverse(g.inverse(f.inverse(x)))
        by fn_extension assoc_left.inverse = assoc_right.inverse
        release thm equiv_extensionality(s, s, assoc_left, assoc_right)
        \permutation_mul<s>(\permutation_mul<s>(f, g), h) = assoc_left = assoc_right = \permutation_mul<s>(f, \permutation_mul<s>(g, h))
    claim:
        ? forall f &Equiv<s, s>:
            \permutation_mul<s>(\permutation_one<s>, f) = f
        have one &Equiv<s, s> = \permutation_one<s>
        have group_product &Equiv<s, s> = \permutation_mul<s>(\permutation_one<s>, f)
        group_product = \permutation_mul<s>(one, f)
        claim:
            ? forall x s:
                group_product.forward(x) = f.forward(x)
            release thm permutation_mul_forward(s, one, f, x)
            release thm permutation_one_forward(s, f.forward(x))
            one.forward(f.forward(x)) = \equiv_forward_apply<s, s>(one, f.forward(x)) = \equiv_forward_apply<s, s>(\permutation_one<s>, f.forward(x)) = f.forward(x)
            group_product.forward(x) = \equiv_forward_apply<s, s>(group_product, x) = \equiv_forward_apply<s, s>(\permutation_mul<s>(one, f), x) = one.forward(f.forward(x)) = f.forward(x)
        claim:
            ? forall x s:
                group_product.inverse(x) = f.inverse(x)
            release thm permutation_mul_inverse(s, one, f, x)
            release thm permutation_one_inverse(s, x)
            one.inverse(x) = \equiv_inverse_apply<s, s>(one, x) = \equiv_inverse_apply<s, s>(\permutation_one<s>, x) = x
            group_product.inverse(x) = \equiv_inverse_apply<s, s>(group_product, x) = \equiv_inverse_apply<s, s>(\permutation_mul<s>(one, f), x) = f.inverse(one.inverse(x)) = f.inverse(x)
        by fn_extension group_product.forward = f.forward
        by fn_extension group_product.inverse = f.inverse
        release thm equiv_extensionality(s, s, group_product, f)
        \permutation_mul<s>(\permutation_one<s>, f) = group_product = f = f
    claim:
        ? forall f &Equiv<s, s>:
            \permutation_mul<s>(\permutation_inv<s>(f), f) = \permutation_one<s>
        have one &Equiv<s, s> = \permutation_one<s>
        have inverted &Equiv<s, s> = \permutation_inv<s>(f)
        have group_product &Equiv<s, s> = \permutation_mul<s>(\permutation_inv<s>(f), f)
        group_product = \permutation_mul<s>(inverted, f)
        claim:
            ? forall x s:
                group_product.forward(x) = one.forward(x)
            release thm permutation_mul_forward(s, inverted, f, x)
            release thm permutation_inv_forward(s, f, f.forward(x))
            inverted.forward(f.forward(x)) = \equiv_forward_apply<s, s>(inverted, f.forward(x)) = \equiv_forward_apply<s, s>(\permutation_inv<s>(f), f.forward(x)) = f.inverse(f.forward(x))
            release thm permutation_one_forward(s, x)
            one.forward(x) = \equiv_forward_apply<s, s>(one, x) = \equiv_forward_apply<s, s>(\permutation_one<s>, x) = x
            group_product.forward(x) = \equiv_forward_apply<s, s>(group_product, x) = \equiv_forward_apply<s, s>(\permutation_mul<s>(inverted, f), x) = inverted.forward(f.forward(x)) = f.inverse(f.forward(x)) = x
        claim:
            ? forall x s:
                group_product.inverse(x) = one.inverse(x)
            release thm permutation_mul_inverse(s, inverted, f, x)
            release thm permutation_inv_inverse(s, f, x)
            inverted.inverse(x) = \equiv_inverse_apply<s, s>(inverted, x) = \equiv_inverse_apply<s, s>(\permutation_inv<s>(f), x) = f.forward(x)
            release thm permutation_one_inverse(s, x)
            one.inverse(x) = \equiv_inverse_apply<s, s>(one, x) = \equiv_inverse_apply<s, s>(\permutation_one<s>, x) = x
            group_product.inverse(x) = \equiv_inverse_apply<s, s>(group_product, x) = \equiv_inverse_apply<s, s>(\permutation_mul<s>(inverted, f), x) = f.inverse(inverted.inverse(x)) = f.inverse(f.forward(x)) = x
        by fn_extension group_product.forward = one.forward
        by fn_extension group_product.inverse = one.inverse
        release thm equiv_extensionality(s, s, group_product, one)
        \permutation_mul<s>(\permutation_inv<s>(f), f) = group_product = one = \permutation_one<s>
    by def $chap2::group_laws(&Equiv<s, s>, \permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>)
    release thm cart_member_from_coordinates((\permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>), cart(fn(f, g &Equiv<s, s>) &Equiv<s, s>, &Equiv<s, s>, fn(f &Equiv<s, s>) &Equiv<s, s>))
    release thm struct_member((\permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>), &chap2::Group<&Equiv<s, s>>)
    &chap2::Group<&Equiv<s, s>> = &chap2::Group<\permutation_carrier<s>>
    by thm chap2::transport_membership(&chap2::Group<&Equiv<s, s>>, &chap2::Group<\permutation_carrier<s>>, (\permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>)) => (\permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>) $in &chap2::Group<\permutation_carrier<s>>

template<s set>:
    have permutation_group &chap2::Group<\permutation_carrier<s>> = (\permutation_mul<s>, \permutation_one<s>, \permutation_inv<s>)

# Source definition mySquare, kept as a callable construction. Group2 is only a
# typeclass presentation of the same Group interface and is collapsed here.
template<s nonempty_set, group &chap2::Group<s>>:
    have fn group_square(x s) s = group.mul(x, x)

# The source's bundled Grp record stores a type universe as a field. Litex uses
# the explicit carrier parameter s instead; no false prop wrapper is introduced.
# 7.3 Building the Gaussian Integers

struct GaussInt:
    real Z
    im Z

release thm struct_member((0, 0), &GaussInt)
have gauss_zero &GaussInt = (0, 0)
release thm struct_member((1, 0), &GaussInt)
have gauss_one &GaussInt = (1, 0)

thm gauss_add_closed:
    ? forall x, y &GaussInt:
        (x.real + y.real, x.im + y.im) $in &GaussInt
    release thm struct_member((x.real + y.real, x.im + y.im), &GaussInt)

have fn gauss_add(x, y &GaussInt) &GaussInt = (x.real + y.real, x.im + y.im)

thm gauss_neg_closed:
    ? forall x &GaussInt:
        (-x.real, (-x.im)) $in &GaussInt
    release thm struct_member((-x.real, (-x.im)), &GaussInt)

have fn gauss_neg(x &GaussInt) &GaussInt = (-x.real, (-x.im))

thm gauss_mul_closed:
    ? forall x, y &GaussInt:
        (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real) $in &GaussInt
    release thm struct_member((x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real), &GaussInt)

have fn gauss_mul(x, y &GaussInt) &GaussInt = (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real)

# The source's zero_def through mul_im lemmas are projection-level consequences
# of these definitions. Representative facts are kept; duplicate simp lemmas
# are collapsed into the callable definitions above.
thm gauss_add_def:
    ? forall x, y &GaussInt:
        gauss_add(x, y) = (x.real + y.real, x.im + y.im)

thm gauss_mul_def:
    ? forall x, y &GaussInt:
        gauss_mul(x, y) = (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real)

thm gauss_add_re_from_result:
    ? forall x, y, result &GaussInt:
        result = gauss_add(x, y)
        =>:
            result.real = x.real + y.real
    gauss_add(x, y) = (x.real + y.real, x.im + y.im)
    result = gauss_add(x, y) = (x.real + y.real, x.im + y.im)
    result.real = result(1) = x.real + y.real
have fn gauss_real_part(value &GaussInt) Z = value.real
have fn gauss_imaginary_part(value &GaussInt) Z = value.im

thm gauss_add_re:
    ? forall x, y &GaussInt:
        gauss_real_part(gauss_add(x, y)) = gauss_real_part(x) + gauss_real_part(y)
    have result &GaussInt = gauss_add(x, y)
    release thm gauss_add_re_from_result(x, y, result)
    gauss_real_part(x) = x.real
    gauss_real_part(y) = y.real
    gauss_real_part(result) = result.real = x.real + y.real = gauss_real_part(x) + gauss_real_part(y)
    gauss_real_part(gauss_add(x, y)) = gauss_real_part(result) = gauss_real_part(result) = gauss_real_part(x) + gauss_real_part(y)

thm gauss_add_im_from_result:
    ? forall x, y, result &GaussInt:
        result = gauss_add(x, y)
        =>:
            gauss_imaginary_part(result) = gauss_imaginary_part(x) + gauss_imaginary_part(y)
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_real_part(y) = y.real
    gauss_imaginary_part(y) = y.im
    gauss_add(x, y) = (x.real + y.real, x.im + y.im)
    result = gauss_add(x, y) = (x.real + y.real, x.im + y.im)
    result.im = result(2) = x.im + y.im
    gauss_imaginary_part(result) = result.im = x.im + y.im = gauss_imaginary_part(x) + gauss_imaginary_part(y)

thm gauss_add_im:
    ? forall x, y &GaussInt:
        gauss_imaginary_part(gauss_add(x, y)) = gauss_imaginary_part(x) + gauss_imaginary_part(y)
    have result &GaussInt = gauss_add(x, y)
    release thm gauss_add_im_from_result(x, y, result)
    gauss_imaginary_part(gauss_add(x, y)) = gauss_imaginary_part(result) = gauss_imaginary_part(result) = gauss_imaginary_part(x) + gauss_imaginary_part(y)

thm gauss_mul_re_from_result:
    ? forall x, y, result &GaussInt:
        result = gauss_mul(x, y)
        =>:
            gauss_real_part(result) = gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_real_part(y) = y.real
    gauss_imaginary_part(y) = y.im
    gauss_mul(x, y) = (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real)
    result = gauss_mul(x, y) = (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real)
    result.real = result(1) = x.real * y.real - x.im * y.im
    gauss_real_part(result) = result.real = x.real * y.real - x.im * y.im = gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)

thm gauss_mul_re:
    ? forall x, y &GaussInt:
        gauss_real_part(gauss_mul(x, y)) = gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)
    have result &GaussInt = gauss_mul(x, y)
    release thm gauss_mul_re_from_result(x, y, result)
    gauss_real_part(gauss_mul(x, y)) = gauss_real_part(result) = gauss_real_part(result) = gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)

thm gauss_mul_im_from_result:
    ? forall x, y, result &GaussInt:
        result = gauss_mul(x, y)
        =>:
            gauss_imaginary_part(result) = gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_real_part(y) = y.real
    gauss_imaginary_part(y) = y.im
    gauss_mul(x, y) = (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real)
    result = gauss_mul(x, y) = (x.real * y.real - x.im * y.im, x.real * y.im + x.im * y.real)
    result.im = result(2) = x.real * y.im + x.im * y.real
    gauss_imaginary_part(result) = result.im = x.real * y.im + x.im * y.real = gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)

thm gauss_mul_im:
    ? forall x, y &GaussInt:
        gauss_imaginary_part(gauss_mul(x, y)) = gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)
    have result &GaussInt = gauss_mul(x, y)
    release thm gauss_mul_im_from_result(x, y, result)
    gauss_imaginary_part(gauss_mul(x, y)) = gauss_imaginary_part(result) = gauss_imaginary_part(result) = gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)

# The distinguished zero already witnesses that the carrier is nonempty.  The
# reusable law predicate therefore needs only `set`, matching `ring_laws`;
# concrete structure values below still use a `nonempty_set` carrier.
prop is_commutative_ring(s set, add fn(x, y s) s, zero s, neg fn(x s) s, mul fn(x, y s) s, one s):
    $chap2::ring_laws(s, add, zero, neg, mul, one)
    forall x, y s:
        mul(x, y) = mul(y, x)

struct CommutativeRing<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    mul fn(x, y s) s
    one s
    <=>:
        $is_commutative_ring(s, add, zero, neg, mul, one)

thm commutative_ring_add_zero:
    ? forall s nonempty_set, ring &CommutativeRing<s>, a s:
        ring.add(a, ring.zero) = a
    ring.add(a, ring.zero) = ring.add(ring.zero, a) = a

# Source instance `instCommRing`. The five Gaussian operations form the
# intended callable commutative-ring object.  Every law is checked through the
# two integer coordinates, so the instance has no hidden library dependency.
thm gauss_extensionality:
    ? forall left, right &GaussInt:
        gauss_real_part(left) = gauss_real_part(right)
        gauss_imaginary_part(left) = gauss_imaginary_part(right)
        =>:
            left = right
    release struct def left
    release struct def right
    left(1) = gauss_real_part(left) = gauss_real_part(right) = right(1)
    left(2) = gauss_imaginary_part(left) = gauss_imaginary_part(right) = right(2)
    release thm tuple_equal_from_coordinates(left, (left(1), left(2)))
    release thm tuple_equal_from_coordinates(right, (right(1), right(2)))
    (left(1), left(2)) = (right(1), right(2))
    left = (left(1), left(2)) = (right(1), right(2)) = right

thm gauss_neg_re_from_result:
    ? forall x, result &GaussInt:
        result = gauss_neg(x)
        =>:
            gauss_real_part(result) = (-gauss_real_part(x))
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_neg(x) = (-x.real, (-x.im))
    result = gauss_neg(x) = (-x.real, (-x.im))
    result.real = result(1) = (-x.real)
    gauss_real_part(result) = result.real = (-x.real) = (-gauss_real_part(x))

thm gauss_neg_re:
    ? forall x &GaussInt:
        gauss_real_part(gauss_neg(x)) = (-gauss_real_part(x))
    have result &GaussInt = gauss_neg(x)
    release thm gauss_neg_re_from_result(x, result)
    gauss_real_part(gauss_neg(x)) = gauss_real_part(result) = gauss_real_part(result) = (-gauss_real_part(x))

thm gauss_neg_im_from_result:
    ? forall x, result &GaussInt:
        result = gauss_neg(x)
        =>:
            gauss_imaginary_part(result) = (-gauss_imaginary_part(x))
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_neg(x) = (-x.real, (-x.im))
    result = gauss_neg(x) = (-x.real, (-x.im))
    result.im = result(2) = (-x.im)
    gauss_imaginary_part(result) = result.im = (-x.im) = (-gauss_imaginary_part(x))

thm gauss_neg_im:
    ? forall x &GaussInt:
        gauss_imaginary_part(gauss_neg(x)) = (-gauss_imaginary_part(x))
    have result &GaussInt = gauss_neg(x)
    release thm gauss_neg_im_from_result(x, result)
    gauss_imaginary_part(gauss_neg(x)) = gauss_imaginary_part(result) = gauss_imaginary_part(result) = (-gauss_imaginary_part(x))

thm gaussian_integer_commutative_ring_laws:
    ? forall gauss_ring_seed &GaussInt:
        $is_commutative_ring(&GaussInt, gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one)
    release struct def gauss_zero
    release struct def gauss_one
    gauss_real_part(gauss_zero) = gauss_zero(1) = 0
    gauss_imaginary_part(gauss_zero) = gauss_zero(2) = 0
    gauss_real_part(gauss_one) = gauss_one(1) = 1
    gauss_imaginary_part(gauss_one) = gauss_one(2) = 0
    claim:
        ? forall x, y, z &GaussInt:
            gauss_add(gauss_add(x, y), z) = gauss_add(x, gauss_add(y, z))
        release thm gauss_add_re(gauss_add(x, y), z)
        release thm gauss_add_re(x, y)
        release thm gauss_add_re(x, gauss_add(y, z))
        release thm gauss_add_re(y, z)
        gauss_real_part(gauss_add(gauss_add(x, y), z)) = gauss_real_part(gauss_add(x, y)) + gauss_real_part(z) = (gauss_real_part(x) + gauss_real_part(y)) + gauss_real_part(z) = gauss_real_part(x) + (gauss_real_part(y) + gauss_real_part(z)) = gauss_real_part(x) + gauss_real_part(gauss_add(y, z)) = gauss_real_part(gauss_add(x, gauss_add(y, z)))
        release thm gauss_add_im(gauss_add(x, y), z)
        release thm gauss_add_im(x, y)
        release thm gauss_add_im(x, gauss_add(y, z))
        release thm gauss_add_im(y, z)
        gauss_imaginary_part(gauss_add(gauss_add(x, y), z)) = gauss_imaginary_part(gauss_add(x, y)) + gauss_imaginary_part(z) = (gauss_imaginary_part(x) + gauss_imaginary_part(y)) + gauss_imaginary_part(z) = gauss_imaginary_part(x) + (gauss_imaginary_part(y) + gauss_imaginary_part(z)) = gauss_imaginary_part(x) + gauss_imaginary_part(gauss_add(y, z)) = gauss_imaginary_part(gauss_add(x, gauss_add(y, z)))
        release thm gauss_extensionality(gauss_add(gauss_add(x, y), z), gauss_add(x, gauss_add(y, z)))
    claim:
        ? forall x &GaussInt:
            gauss_add(gauss_zero, x) = x
        release thm gauss_add_re(gauss_zero, x)
        gauss_real_part(gauss_add(gauss_zero, x)) = gauss_real_part(gauss_zero) + gauss_real_part(x) = 0 + gauss_real_part(x) = gauss_real_part(x)
        release thm gauss_add_im(gauss_zero, x)
        gauss_imaginary_part(gauss_add(gauss_zero, x)) = gauss_imaginary_part(gauss_zero) + gauss_imaginary_part(x) = 0 + gauss_imaginary_part(x) = gauss_imaginary_part(x)
        release thm gauss_extensionality(gauss_add(gauss_zero, x), x)
    claim:
        ? forall x &GaussInt:
            gauss_add(gauss_neg(x), x) = gauss_zero
        release thm gauss_add_re(gauss_neg(x), x)
        release thm gauss_neg_re(x)
        gauss_real_part(gauss_add(gauss_neg(x), x)) = gauss_real_part(gauss_neg(x)) + gauss_real_part(x) = (-gauss_real_part(x)) + gauss_real_part(x) = 0 = gauss_real_part(gauss_zero)
        release thm gauss_add_im(gauss_neg(x), x)
        release thm gauss_neg_im(x)
        gauss_imaginary_part(gauss_add(gauss_neg(x), x)) = gauss_imaginary_part(gauss_neg(x)) + gauss_imaginary_part(x) = (-gauss_imaginary_part(x)) + gauss_imaginary_part(x) = 0 = gauss_imaginary_part(gauss_zero)
        release thm gauss_extensionality(gauss_add(gauss_neg(x), x), gauss_zero)
    claim:
        ? forall x, y &GaussInt:
            gauss_add(x, y) = gauss_add(y, x)
        release thm gauss_add_re(x, y)
        release thm gauss_add_re(y, x)
        gauss_real_part(gauss_add(x, y)) = gauss_real_part(x) + gauss_real_part(y) = gauss_real_part(y) + gauss_real_part(x) = gauss_real_part(gauss_add(y, x))
        release thm gauss_add_im(x, y)
        release thm gauss_add_im(y, x)
        gauss_imaginary_part(gauss_add(x, y)) = gauss_imaginary_part(x) + gauss_imaginary_part(y) = gauss_imaginary_part(y) + gauss_imaginary_part(x) = gauss_imaginary_part(gauss_add(y, x))
        release thm gauss_extensionality(gauss_add(x, y), gauss_add(y, x))
    claim:
        ? forall x, y, z &GaussInt:
            gauss_mul(gauss_mul(x, y), z) = gauss_mul(x, gauss_mul(y, z))
        release thm gauss_mul_re(gauss_mul(x, y), z)
        release thm gauss_mul_im(gauss_mul(x, y), z)
        release thm gauss_mul_re(x, y)
        release thm gauss_mul_im(x, y)
        release thm gauss_mul_re(x, gauss_mul(y, z))
        release thm gauss_mul_im(x, gauss_mul(y, z))
        release thm gauss_mul_re(y, z)
        release thm gauss_mul_im(y, z)
        gauss_real_part(gauss_mul(gauss_mul(x, y), z)) = gauss_real_part(gauss_mul(x, y)) * gauss_real_part(z) - gauss_imaginary_part(gauss_mul(x, y)) * gauss_imaginary_part(z) = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)) * gauss_real_part(z) - gauss_imaginary_part(gauss_mul(x, y)) * gauss_imaginary_part(z) = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)) * gauss_real_part(z) - (gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)) * gauss_imaginary_part(z) = gauss_real_part(x) * (gauss_real_part(y) * gauss_real_part(z) - gauss_imaginary_part(y) * gauss_imaginary_part(z)) - gauss_imaginary_part(x) * (gauss_real_part(y) * gauss_imaginary_part(z) + gauss_imaginary_part(y) * gauss_real_part(z)) = gauss_real_part(x) * gauss_real_part(gauss_mul(y, z)) - gauss_imaginary_part(x) * (gauss_real_part(y) * gauss_imaginary_part(z) + gauss_imaginary_part(y) * gauss_real_part(z)) = gauss_real_part(x) * gauss_real_part(gauss_mul(y, z)) - gauss_imaginary_part(x) * gauss_imaginary_part(gauss_mul(y, z)) = gauss_real_part(gauss_mul(x, gauss_mul(y, z)))
        gauss_imaginary_part(gauss_mul(gauss_mul(x, y), z)) = gauss_real_part(gauss_mul(x, y)) * gauss_imaginary_part(z) + gauss_imaginary_part(gauss_mul(x, y)) * gauss_real_part(z) = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)) * gauss_imaginary_part(z) + gauss_imaginary_part(gauss_mul(x, y)) * gauss_real_part(z) = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)) * gauss_imaginary_part(z) + (gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)) * gauss_real_part(z) = gauss_real_part(x) * (gauss_real_part(y) * gauss_imaginary_part(z) + gauss_imaginary_part(y) * gauss_real_part(z)) + gauss_imaginary_part(x) * (gauss_real_part(y) * gauss_real_part(z) - gauss_imaginary_part(y) * gauss_imaginary_part(z)) = gauss_real_part(x) * (gauss_real_part(y) * gauss_imaginary_part(z) + gauss_imaginary_part(y) * gauss_real_part(z)) + gauss_imaginary_part(x) * gauss_real_part(gauss_mul(y, z)) = gauss_real_part(x) * gauss_imaginary_part(gauss_mul(y, z)) + gauss_imaginary_part(x) * gauss_real_part(gauss_mul(y, z)) = gauss_imaginary_part(gauss_mul(x, gauss_mul(y, z)))
        release thm gauss_extensionality(gauss_mul(gauss_mul(x, y), z), gauss_mul(x, gauss_mul(y, z)))
    claim:
        ? forall x, y, z &GaussInt:
            gauss_mul(x, gauss_add(y, z)) = gauss_add(gauss_mul(x, y), gauss_mul(x, z))
        release thm gauss_mul_re(x, gauss_add(y, z))
        release thm gauss_mul_im(x, gauss_add(y, z))
        release thm gauss_add_re(y, z)
        release thm gauss_add_im(y, z)
        release thm gauss_add_re(gauss_mul(x, y), gauss_mul(x, z))
        release thm gauss_add_im(gauss_mul(x, y), gauss_mul(x, z))
        release thm gauss_mul_re(x, y)
        release thm gauss_mul_im(x, y)
        release thm gauss_mul_re(x, z)
        release thm gauss_mul_im(x, z)
        gauss_real_part(gauss_mul(x, gauss_add(y, z))) = gauss_real_part(x) * gauss_real_part(gauss_add(y, z)) - gauss_imaginary_part(x) * gauss_imaginary_part(gauss_add(y, z)) = gauss_real_part(x) * (gauss_real_part(y) + gauss_real_part(z)) - gauss_imaginary_part(x) * gauss_imaginary_part(gauss_add(y, z)) = gauss_real_part(x) * (gauss_real_part(y) + gauss_real_part(z)) - gauss_imaginary_part(x) * (gauss_imaginary_part(y) + gauss_imaginary_part(z)) = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y)) + (gauss_real_part(x) * gauss_real_part(z) - gauss_imaginary_part(x) * gauss_imaginary_part(z)) = gauss_real_part(gauss_mul(x, y)) + (gauss_real_part(x) * gauss_real_part(z) - gauss_imaginary_part(x) * gauss_imaginary_part(z)) = gauss_real_part(gauss_mul(x, y)) + gauss_real_part(gauss_mul(x, z)) = gauss_real_part(gauss_add(gauss_mul(x, y), gauss_mul(x, z)))
        gauss_imaginary_part(gauss_mul(x, gauss_add(y, z))) = gauss_real_part(x) * gauss_imaginary_part(gauss_add(y, z)) + gauss_imaginary_part(x) * gauss_real_part(gauss_add(y, z)) = gauss_real_part(x) * (gauss_imaginary_part(y) + gauss_imaginary_part(z)) + gauss_imaginary_part(x) * gauss_real_part(gauss_add(y, z)) = gauss_real_part(x) * (gauss_imaginary_part(y) + gauss_imaginary_part(z)) + gauss_imaginary_part(x) * (gauss_real_part(y) + gauss_real_part(z)) = (gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)) + (gauss_real_part(x) * gauss_imaginary_part(z) + gauss_imaginary_part(x) * gauss_real_part(z)) = gauss_imaginary_part(gauss_mul(x, y)) + (gauss_real_part(x) * gauss_imaginary_part(z) + gauss_imaginary_part(x) * gauss_real_part(z)) = gauss_imaginary_part(gauss_mul(x, y)) + gauss_imaginary_part(gauss_mul(x, z)) = gauss_imaginary_part(gauss_add(gauss_mul(x, y), gauss_mul(x, z)))
        release thm gauss_extensionality(gauss_mul(x, gauss_add(y, z)), gauss_add(gauss_mul(x, y), gauss_mul(x, z)))
    claim:
        ? forall x, y, z &GaussInt:
            gauss_mul(gauss_add(x, y), z) = gauss_add(gauss_mul(x, z), gauss_mul(y, z))
        release thm gauss_mul_re(gauss_add(x, y), z)
        release thm gauss_mul_im(gauss_add(x, y), z)
        release thm gauss_add_re(x, y)
        release thm gauss_add_im(x, y)
        release thm gauss_add_re(gauss_mul(x, z), gauss_mul(y, z))
        release thm gauss_add_im(gauss_mul(x, z), gauss_mul(y, z))
        release thm gauss_mul_re(x, z)
        release thm gauss_mul_im(x, z)
        release thm gauss_mul_re(y, z)
        release thm gauss_mul_im(y, z)
        gauss_real_part(gauss_mul(gauss_add(x, y), z)) = gauss_real_part(gauss_add(x, y)) * gauss_real_part(z) - gauss_imaginary_part(gauss_add(x, y)) * gauss_imaginary_part(z) = (gauss_real_part(x) + gauss_real_part(y)) * gauss_real_part(z) - gauss_imaginary_part(gauss_add(x, y)) * gauss_imaginary_part(z) = (gauss_real_part(x) + gauss_real_part(y)) * gauss_real_part(z) - (gauss_imaginary_part(x) + gauss_imaginary_part(y)) * gauss_imaginary_part(z) = (gauss_real_part(x) * gauss_real_part(z) - gauss_imaginary_part(x) * gauss_imaginary_part(z)) + (gauss_real_part(y) * gauss_real_part(z) - gauss_imaginary_part(y) * gauss_imaginary_part(z)) = gauss_real_part(gauss_mul(x, z)) + (gauss_real_part(y) * gauss_real_part(z) - gauss_imaginary_part(y) * gauss_imaginary_part(z)) = gauss_real_part(gauss_mul(x, z)) + gauss_real_part(gauss_mul(y, z)) = gauss_real_part(gauss_add(gauss_mul(x, z), gauss_mul(y, z)))
        gauss_imaginary_part(gauss_mul(gauss_add(x, y), z)) = gauss_real_part(gauss_add(x, y)) * gauss_imaginary_part(z) + gauss_imaginary_part(gauss_add(x, y)) * gauss_real_part(z) = (gauss_real_part(x) + gauss_real_part(y)) * gauss_imaginary_part(z) + gauss_imaginary_part(gauss_add(x, y)) * gauss_real_part(z) = (gauss_real_part(x) + gauss_real_part(y)) * gauss_imaginary_part(z) + (gauss_imaginary_part(x) + gauss_imaginary_part(y)) * gauss_real_part(z) = (gauss_real_part(x) * gauss_imaginary_part(z) + gauss_imaginary_part(x) * gauss_real_part(z)) + (gauss_real_part(y) * gauss_imaginary_part(z) + gauss_imaginary_part(y) * gauss_real_part(z)) = gauss_imaginary_part(gauss_mul(x, z)) + (gauss_real_part(y) * gauss_imaginary_part(z) + gauss_imaginary_part(y) * gauss_real_part(z)) = gauss_imaginary_part(gauss_mul(x, z)) + gauss_imaginary_part(gauss_mul(y, z)) = gauss_imaginary_part(gauss_add(gauss_mul(x, z), gauss_mul(y, z)))
        release thm gauss_extensionality(gauss_mul(gauss_add(x, y), z), gauss_add(gauss_mul(x, z), gauss_mul(y, z)))
    claim:
        ? forall x &GaussInt:
            gauss_mul(gauss_one, x) = x
        release thm gauss_mul_re(gauss_one, x)
        release thm gauss_mul_im(gauss_one, x)
        gauss_real_part(gauss_mul(gauss_one, x)) = gauss_real_part(gauss_one) * gauss_real_part(x) - gauss_imaginary_part(gauss_one) * gauss_imaginary_part(x) = 1 * gauss_real_part(x) - gauss_imaginary_part(gauss_one) * gauss_imaginary_part(x) = 1 * gauss_real_part(x) - 0 * gauss_imaginary_part(x) = gauss_real_part(x)
        gauss_imaginary_part(gauss_mul(gauss_one, x)) = gauss_real_part(gauss_one) * gauss_imaginary_part(x) + gauss_imaginary_part(gauss_one) * gauss_real_part(x) = 1 * gauss_imaginary_part(x) + gauss_imaginary_part(gauss_one) * gauss_real_part(x) = 1 * gauss_imaginary_part(x) + 0 * gauss_real_part(x) = gauss_imaginary_part(x)
        release thm gauss_extensionality(gauss_mul(gauss_one, x), x)
    claim:
        ? forall x &GaussInt:
            gauss_mul(x, gauss_one) = x
        release thm gauss_mul_re(x, gauss_one)
        release thm gauss_mul_im(x, gauss_one)
        gauss_real_part(gauss_mul(x, gauss_one)) = gauss_real_part(x) * gauss_real_part(gauss_one) - gauss_imaginary_part(x) * gauss_imaginary_part(gauss_one) = gauss_real_part(x) * 1 - gauss_imaginary_part(x) * gauss_imaginary_part(gauss_one) = gauss_real_part(x) * 1 - gauss_imaginary_part(x) * 0 = gauss_real_part(x)
        gauss_imaginary_part(gauss_mul(x, gauss_one)) = gauss_real_part(x) * gauss_imaginary_part(gauss_one) + gauss_imaginary_part(x) * gauss_real_part(gauss_one) = gauss_real_part(x) * 0 + gauss_imaginary_part(x) * gauss_real_part(gauss_one) = gauss_real_part(x) * 0 + gauss_imaginary_part(x) * 1 = gauss_imaginary_part(x)
        release thm gauss_extensionality(gauss_mul(x, gauss_one), x)
    claim:
        ? forall x, y &GaussInt:
            gauss_mul(x, y) = gauss_mul(y, x)
        release thm gauss_mul_re(x, y)
        release thm gauss_mul_re(y, x)
        gauss_real_part(gauss_mul(x, y)) = gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y) = gauss_real_part(y) * gauss_real_part(x) - gauss_imaginary_part(y) * gauss_imaginary_part(x) = gauss_real_part(gauss_mul(y, x))
        release thm gauss_mul_im(x, y)
        release thm gauss_mul_im(y, x)
        gauss_imaginary_part(gauss_mul(x, y)) = gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y) = gauss_real_part(y) * gauss_imaginary_part(x) + gauss_imaginary_part(y) * gauss_real_part(x) = gauss_imaginary_part(gauss_mul(y, x))
        release thm gauss_extensionality(gauss_mul(x, y), gauss_mul(y, x))
    by def:
        ? $chap2::ring_laws(&GaussInt, gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one)
    gauss_add $in fn(x, y &GaussInt) &GaussInt
    gauss_zero $in &GaussInt
    gauss_neg $in fn(x &GaussInt) &GaussInt
    gauss_mul $in fn(x, y &GaussInt) &GaussInt
    gauss_one $in &GaussInt
    by def:
        ? $is_commutative_ring(&GaussInt, gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one)

release thm gaussian_integer_commutative_ring_laws(gauss_zero)
witness $is_nonempty_set(&GaussInt) from gauss_zero:
    gauss_zero $in &GaussInt
gauss_add $in fn(x, y &GaussInt) &GaussInt
gauss_zero $in &GaussInt
gauss_neg $in fn(x &GaussInt) &GaussInt
gauss_mul $in fn(x, y &GaussInt) &GaussInt
gauss_one $in &GaussInt
release thm cart_member_from_coordinates((gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one), cart(fn(x, y &GaussInt) &GaussInt, &GaussInt, fn(x &GaussInt) &GaussInt, fn(x, y &GaussInt) &GaussInt, &GaussInt))
release thm struct_member((gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one), &CommutativeRing<&GaussInt>)
have gaussian_integer_commutative_ring &CommutativeRing<&GaussInt> = (gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one)

have fn gauss_sub(x, y &GaussInt) &GaussInt = gauss_add(x, gauss_neg(y))

# Source instance Nontrivial GaussInt, recorded as a fact rather than a prop.
gauss_zero = (0, 0)
gauss_one = (1, 0)
by contra:
    ? gauss_zero != gauss_one
    gauss_zero = (0, 0)
    gauss_one = (1, 0)
    gauss_zero.real = gauss_zero(1) = 0
    gauss_one.real = gauss_one(1) = 1
    0 = gauss_zero.real = gauss_one.real = 1
    impossible 0 = 1

# Lean's total Euclidean integer quotient/remainder are made explicit so the
# centered division definitions below remain callable even at divisor zero.
# The positive denominator is total. For nonzero inputs it reduces to the
# source denominator abs(b); at zero it selects 1, which is only used to make
# the surrounding case-defined functions well-defined before branch replay.
claim:
    ? forall b Z:
        abs(b) > 0 or abs(b) = 0
    abs(b) >= 0
template<marker {0}>:
    have fn positive_abs_denominator_selected(b Z) N+ by cases:
        case abs(b) > 0: abs(b)
        case abs(b) = 0: 1

have fn positive_abs_denominator(b Z) N+ = \positive_abs_denominator_selected<0>(b)

thm positive_abs_denominator_closed:
    ? forall b Z:
        positive_abs_denominator(b) $in N+

thm positive_abs_denominator_of_ne_zero:
    ? forall b Z:
        b != 0
        =>:
            positive_abs_denominator(b) = abs(b)
    abs(b) >= 0
    abs(b) != 0
    by contra:
        ? abs(b) > 0
        abs(b) <= 0
        abs(b) = 0
        impossible abs(b) != 0
    positive_abs_denominator(b) = \positive_abs_denominator_selected<0>(b) = abs(b)

thm positive_abs_denominator_nonzero:
    ? forall b Z:
        positive_abs_denominator(b) != 0
    positive_abs_denominator(b) $in N+
    positive_abs_denominator(b) > 0

claim:
    ? forall b Z:
        b > 0 or b < 0 or b = 0
    b $in R
    b > 0 or b <= 0
    by cases:
        ? b > 0 or b < 0 or b = 0
        case b > 0:
            b > 0
        case b <= 0:
            b < 0 or b >= 0
            by cases:
                ? b > 0 or b < 0 or b = 0
                case b < 0:
                    b < 0
                case b >= 0:
                    b = 0
release obj def chap5::integer_quotient
have fn int_ediv(a, b Z) Z by cases:
    case b > 0: chap5::integer_quotient(a, positive_abs_denominator(b))
    case b < 0: (-chap5::integer_quotient(a, positive_abs_denominator(b)))
    case b = 0: 0

have fn int_emod(a, b Z) Z by cases:
    case b != 0: a % positive_abs_denominator(b)
    case b = 0: a

have fn int_centered_div(a, b Z) Z = int_ediv(a + int_ediv(b, 2), b)

have fn int_centered_mod(a, b Z) Z = int_emod(a + int_ediv(b, 2), b) - int_ediv(b, 2)

# The signed wrapper is reduced explicitly to the positive-denominator
# Euclidean quotient supplied by Chapter 5.
thm int_ediv_add_emod:
    ? forall a, b Z:
        b * int_ediv(a, b) + int_emod(a, b) = a
    by cases:
        ? b * int_ediv(a, b) + int_emod(a, b) = a
        case b > 0:
            b != 0
            release thm positive_abs_denominator_of_ne_zero(b)
            positive_abs_denominator(b) = abs(b) = b
            int_ediv(a, b) = chap5::integer_quotient(a, positive_abs_denominator(b))
            int_emod(a, b) = a % positive_abs_denominator(b)
            a = positive_abs_denominator(b) * chap5::integer_quotient(a, positive_abs_denominator(b)) + a % positive_abs_denominator(b)
            b * int_ediv(a, b) + int_emod(a, b) = b * chap5::integer_quotient(a, positive_abs_denominator(b)) + a % positive_abs_denominator(b) = positive_abs_denominator(b) * chap5::integer_quotient(a, positive_abs_denominator(b)) + a % positive_abs_denominator(b) = a
        case b < 0:
            b != 0
            release thm positive_abs_denominator_of_ne_zero(b)
            positive_abs_denominator(b) = abs(b) = (-b)
            (-b) = positive_abs_denominator(b)
            (-b) * chap5::integer_quotient(a, positive_abs_denominator(b)) = positive_abs_denominator(b) * chap5::integer_quotient(a, positive_abs_denominator(b))
            int_ediv(a, b) = (-chap5::integer_quotient(a, positive_abs_denominator(b)))
            int_emod(a, b) = a % positive_abs_denominator(b)
            a = positive_abs_denominator(b) * chap5::integer_quotient(a, positive_abs_denominator(b)) + a % positive_abs_denominator(b)
            b * int_ediv(a, b) + int_emod(a, b) = b * (-chap5::integer_quotient(a, positive_abs_denominator(b))) + a % positive_abs_denominator(b) = (-b) * chap5::integer_quotient(a, positive_abs_denominator(b)) + a % positive_abs_denominator(b) = positive_abs_denominator(b) * chap5::integer_quotient(a, positive_abs_denominator(b)) + a % positive_abs_denominator(b) = a
        case b = 0:
            int_ediv(a, b) = 0
            int_emod(a, b) = a
            b * int_ediv(a, b) + int_emod(a, b) = 0 * 0 + a = a

thm int_centered_div_add_mod_explicit:
    ? forall a, b Z:
        b * int_centered_div(a, b) + int_centered_mod(a, b) = a
    release thm int_ediv_add_emod(a + int_ediv(b, 2), b)
    int_centered_div(a, b) = int_ediv(a + int_ediv(b, 2), b)
    int_centered_mod(a, b) = int_emod(a + int_ediv(b, 2), b) - int_ediv(b, 2)
    b * int_ediv(a + int_ediv(b, 2), b) + int_emod(a + int_ediv(b, 2), b) = a + int_ediv(b, 2)
    b * int_centered_div(a, b) + int_centered_mod(a, b) = b * int_ediv(a + int_ediv(b, 2), b) + (int_emod(a + int_ediv(b, 2), b) - int_ediv(b, 2)) = (b * int_ediv(a + int_ediv(b, 2), b) + int_emod(a + int_ediv(b, 2), b)) - int_ediv(b, 2) = (a + int_ediv(b, 2)) - int_ediv(b, 2) = a

thm int_centered_div_add_mod:
    ? forall a, b Z:
        b * int_centered_div(a, b) + int_centered_mod(a, b) = a
    release thm int_centered_div_add_mod_explicit(a, b)

thm int_centered_mod_abs_le_explicit:
    ? forall a Z, b Z:
        b > 0
        =>:
            abs(int_centered_mod(a, b)) <= b / 2
    have q Z = chap5::integer_quotient(b, 2)
    have shifted Z = a + int_ediv(b, 2)
    have r Z = shifted % b
    b != 0
    b $in N+
    release thm positive_abs_denominator_of_ne_zero(b)
    positive_abs_denominator(b) = abs(b) = b
    release thm positive_abs_denominator_of_ne_zero(2)
    positive_abs_denominator(2) = abs(2) = 2
    int_ediv(b, 2) = chap5::integer_quotient(b, positive_abs_denominator(2)) = chap5::integer_quotient(b, 2) = q
    int_emod(a + int_ediv(b, 2), b) = (a + int_ediv(b, 2)) % positive_abs_denominator(b)
    shifted = a + int_ediv(b, 2)
    (a + int_ediv(b, 2)) % positive_abs_denominator(b) = shifted % positive_abs_denominator(b) = shifted % b = r
    int_centered_mod(a, b) = int_emod(a + int_ediv(b, 2), b) - int_ediv(b, 2) = r - q
    b = 2 * chap5::integer_quotient(b, 2) + b % 2 = 2 * q + b % 2
    0 <= b % 2
    b % 2 < 2
    0 <= shifted % b
    shifted % b < b
    0 <= r
    r < b
    2 * q <= 2 * q + b % 2 = b
    (2 * q) / 2 <= b / 2
    q = (2 * q) / 2 <= b / 2
    (-q) = 0 - q <= r - q
    claim:
        ? r <= 2 * q
        b % 2 = 0 or b % 2 = 1
        by cases:
            ? r <= 2 * q
            case b % 2 = 0:
                b = 2 * q + b % 2 = 2 * q
                r < b = 2 * q
                r <= 2 * q
            case b % 2 = 1:
                b = 2 * q + b % 2 = 2 * q + 1
                r < b = 2 * q + 1
                r <= 2 * q
    r - q <= 2 * q - q = q
    -(r - q) <= -(-q) = q
    by cases:
        ? abs(int_centered_mod(a, b)) <= b / 2
        case int_centered_mod(a, b) >= 0:
            abs(int_centered_mod(a, b)) = int_centered_mod(a, b) = r - q <= q <= b / 2
        case int_centered_mod(a, b) < 0:
            abs(int_centered_mod(a, b)) = (-int_centered_mod(a, b)) = -(r - q) <= q <= b / 2

thm int_centered_mod_abs_le:
    ? forall a Z, b Z:
        b > 0
        =>:
            abs(int_centered_mod(a, b)) <= b / 2
    release thm int_centered_mod_abs_le_explicit(a, b)

have fn gauss_norm(x &GaussInt) Z = x.real^2 + x.im^2

thm gauss_norm_nonneg:
    ? forall x &GaussInt:
        gauss_norm(x) >= 0
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_norm(x) = x.real^2 + x.im^2 = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2
    gauss_norm(x) = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2 >= 0
claim:
    ? forall x &GaussInt:
        gauss_norm(x) = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_norm(x) = x.real^2 + x.im^2 = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2

# The source states two iff theorems. Litex theorem targets do not admit a
# universal `<=>` conclusion, so each source iff is recorded as its two direct
# implication facts rather than as a proposition wrapper.
thm gauss_norm_eq_zero_forward:
    ? forall x &GaussInt:
        gauss_norm(x) = 0
        =>:
            x = gauss_zero
    gauss_real_part(x)^2 >= 0
    gauss_imaginary_part(x)^2 >= 0
    gauss_real_part(x)^2 <= gauss_real_part(x)^2 + gauss_imaginary_part(x)^2 = gauss_norm(x) = 0
    gauss_imaginary_part(x)^2 <= gauss_real_part(x)^2 + gauss_imaginary_part(x)^2 = gauss_norm(x) = 0
    gauss_real_part(x)^2 = 0
    gauss_imaginary_part(x)^2 = 0
    gauss_real_part(x) = 0
    gauss_imaginary_part(x) = 0
    gauss_real_part(x) = x.real = x(1)
    gauss_imaginary_part(x) = x.im = x(2)
    release thm tuple_equal_from_coordinates(x, (x(1), x(2)))
    x = (x(1), x(2)) = (gauss_real_part(x), gauss_imaginary_part(x)) = (0, 0) = gauss_zero

thm gauss_norm_eq_zero_reverse:
    ? forall x &GaussInt:
        x = gauss_zero
        =>:
            gauss_norm(x) = 0
    x = gauss_zero = (0, 0)
    gauss_real_part(x) = x.real = x(1) = 0
    gauss_imaginary_part(x) = x.im = x(2) = 0
    gauss_norm(x) = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2 = 0^2 + 0^2 = 0

thm gauss_norm_pos_forward:
    ? forall x &GaussInt:
        gauss_norm(x) > 0
        =>:
            x != gauss_zero
    by contra:
        ? x != gauss_zero
        x = gauss_zero
        gauss_norm(x) = 0
        impossible gauss_norm(x) > 0

thm gauss_norm_pos_reverse:
    ? forall x &GaussInt:
        x != gauss_zero
        =>:
            gauss_norm(x) > 0
    gauss_norm(x) >= 0
    by contra:
        ? gauss_norm(x) > 0
        gauss_norm(x) <= 0
        gauss_norm(x) = 0
        release thm gauss_norm_eq_zero_forward(x)
        impossible x != gauss_zero

thm gauss_norm_mul:
    ? forall x, y &GaussInt:
        gauss_norm(gauss_mul(x, y)) = gauss_norm(x) * gauss_norm(y)
    gauss_mul(x, y) $in &GaussInt
    gauss_real_part(gauss_mul(x, y)) $in Z
    gauss_imaginary_part(gauss_mul(x, y)) $in Z
    release thm gauss_mul_re(x, y)
    release thm gauss_mul_im(x, y)
    gauss_norm(gauss_mul(x, y)) = gauss_real_part(gauss_mul(x, y))^2 + gauss_imaginary_part(gauss_mul(x, y))^2
    gauss_real_part(gauss_mul(x, y))^2 + gauss_imaginary_part(gauss_mul(x, y))^2 = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y))^2 + (gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y))^2
    gauss_norm(x) = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2
    gauss_norm(y) = gauss_real_part(y)^2 + gauss_imaginary_part(y)^2
    gauss_norm(gauss_mul(x, y)) = (gauss_real_part(x) * gauss_real_part(y) - gauss_imaginary_part(x) * gauss_imaginary_part(y))^2 + (gauss_real_part(x) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y))^2 = (gauss_real_part(x)^2 + gauss_imaginary_part(x)^2) * (gauss_real_part(y)^2 + gauss_imaginary_part(y)^2) = gauss_norm(x) * gauss_norm(y)

thm gauss_conj_closed:
    ? forall x &GaussInt:
        (gauss_real_part(x), (-gauss_imaginary_part(x))) $in &GaussInt
    gauss_real_part(x) $in Z
    gauss_imaginary_part(x) $in Z
    (-gauss_imaginary_part(x)) $in Z
    release thm struct_member((gauss_real_part(x), (-gauss_imaginary_part(x))), &GaussInt)

have fn gauss_conj(x &GaussInt) &GaussInt = (gauss_real_part(x), (-gauss_imaginary_part(x)))

thm gauss_conj_re_from_result:
    ? forall x, result &GaussInt:
        result = gauss_conj(x)
        =>:
            gauss_real_part(result) = gauss_real_part(x)
    gauss_conj(x) = (gauss_real_part(x), (-gauss_imaginary_part(x)))
    result = gauss_conj(x) = (gauss_real_part(x), (-gauss_imaginary_part(x)))
    gauss_real_part(result) = result(1) = gauss_real_part(x)

thm gauss_conj_re:
    ? forall x &GaussInt:
        gauss_real_part(gauss_conj(x)) = gauss_real_part(x)
    release thm gauss_conj_re_from_result(x, gauss_conj(x))

thm gauss_conj_im_from_result:
    ? forall x, result &GaussInt:
        result = gauss_conj(x)
        =>:
            gauss_imaginary_part(result) = (-gauss_imaginary_part(x))
    gauss_conj(x) = (gauss_real_part(x), (-gauss_imaginary_part(x)))
    result = gauss_conj(x) = (gauss_real_part(x), (-gauss_imaginary_part(x)))
    gauss_imaginary_part(result) = result(2) = (-gauss_imaginary_part(x))

thm gauss_conj_im:
    ? forall x &GaussInt:
        gauss_imaginary_part(gauss_conj(x)) = (-gauss_imaginary_part(x))
    release thm gauss_conj_im_from_result(x, gauss_conj(x))

thm gauss_norm_conj:
    ? forall x &GaussInt:
        gauss_norm(gauss_conj(x)) = gauss_norm(x)
    gauss_conj(x) $in &GaussInt
    gauss_real_part(gauss_conj(x)) $in Z
    gauss_imaginary_part(gauss_conj(x)) $in Z
    release thm gauss_conj_re(x)
    release thm gauss_conj_im(x)
    gauss_norm(gauss_conj(x)) = gauss_real_part(gauss_conj(x))^2 + gauss_imaginary_part(gauss_conj(x))^2
    gauss_real_part(gauss_conj(x))^2 + gauss_imaginary_part(gauss_conj(x))^2 = gauss_real_part(x)^2 + (-gauss_imaginary_part(x))^2
    gauss_norm(gauss_conj(x)) = gauss_real_part(x)^2 + (-gauss_imaginary_part(x))^2 = gauss_real_part(x)^2 + gauss_imaginary_part(x)^2 = gauss_norm(x)

# These coordinate formulas are the real and imaginary parts of x * conj(y).
# Naming them avoids hiding the division construction behind an opaque record.
have fn gauss_mul_conj_re(x, y &GaussInt) Z = x.real * y.real + x.im * y.im

have fn gauss_mul_conj_im(x, y &GaussInt) Z = (-x.real) * y.im + x.im * y.real

thm gauss_div_closed:
    ? forall x, y &GaussInt:
        (int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y))) $in &GaussInt
    release thm struct_member((int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y))), &GaussInt)

have fn gauss_div(x, y &GaussInt) &GaussInt = (int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)))

have fn gauss_mod(x, y &GaussInt) &GaussInt = gauss_sub(x, gauss_mul(y, gauss_div(x, y)))

# Expanding gauss_mod reduces the source identity to additive inverse
# cancellation in the explicit Gaussian commutative-ring interface above.
thm gauss_div_add_mod_explicit:
    ? forall x, y &GaussInt:
        gauss_add(gauss_mul(y, gauss_div(x, y)), gauss_mod(x, y)) = x
    have quotient_product &GaussInt = gauss_mul(y, gauss_div(x, y))
    gauss_mod(x, y) = gauss_sub(x, gauss_mul(y, gauss_div(x, y))) = gauss_add(x, gauss_neg(gauss_mul(y, gauss_div(x, y)))) = gauss_add(x, gauss_neg(quotient_product))
    release thm chap2::add_neg_cancel_from_laws(&GaussInt, gauss_add, gauss_zero, gauss_neg, quotient_product)
    release thm chap2::add_zero_from_laws(&GaussInt, gauss_add, gauss_zero, gauss_neg, x)
    gauss_add(quotient_product, x) = gauss_add(x, quotient_product)
    gauss_add(quotient_product, gauss_add(x, gauss_neg(quotient_product))) = gauss_add(gauss_add(quotient_product, x), gauss_neg(quotient_product)) = gauss_add(gauss_add(x, quotient_product), gauss_neg(quotient_product)) = gauss_add(x, gauss_add(quotient_product, gauss_neg(quotient_product))) = gauss_add(x, gauss_zero) = x
    gauss_add(gauss_mul(y, gauss_div(x, y)), gauss_mod(x, y)) = gauss_add(quotient_product, gauss_add(x, gauss_neg(quotient_product))) = x

thm gauss_div_add_mod:
    ? forall x, y &GaussInt:
        gauss_add(gauss_mul(y, gauss_div(x, y)), gauss_mod(x, y)) = x
    release thm gauss_div_add_mod_explicit(x, y)

thm gauss_norm_is_natural:
    ? forall x &GaussInt:
        gauss_norm(x) $in N
    gauss_norm(x) >= 0

have fn gauss_rank(x &GaussInt) N = gauss_norm(x)

# The source proof hides these projection facts behind simp.  Keeping them as
# named interfaces makes the Gaussian remainder calculation inspectable.
thm gauss_sub_re_explicit:
    ? forall x, y &GaussInt:
        gauss_real_part(gauss_sub(x, y)) = gauss_real_part(x) - gauss_real_part(y)
    release thm gauss_add_re(x, gauss_neg(y))
    release thm gauss_neg_re(y)
    gauss_sub(x, y) = gauss_add(x, gauss_neg(y))
    gauss_real_part(gauss_sub(x, y)) = gauss_real_part(gauss_add(x, gauss_neg(y))) = gauss_real_part(x) + gauss_real_part(gauss_neg(y)) = gauss_real_part(x) + (-gauss_real_part(y)) = gauss_real_part(x) - gauss_real_part(y)

thm gauss_sub_im_explicit:
    ? forall x, y &GaussInt:
        gauss_imaginary_part(gauss_sub(x, y)) = gauss_imaginary_part(x) - gauss_imaginary_part(y)
    release thm gauss_add_im(x, gauss_neg(y))
    release thm gauss_neg_im(y)
    gauss_sub(x, y) = gauss_add(x, gauss_neg(y))
    gauss_imaginary_part(gauss_sub(x, y)) = gauss_imaginary_part(gauss_add(x, gauss_neg(y))) = gauss_imaginary_part(x) + gauss_imaginary_part(gauss_neg(y)) = gauss_imaginary_part(x) + (-gauss_imaginary_part(y)) = gauss_imaginary_part(x) - gauss_imaginary_part(y)

thm gauss_div_re_from_result:
    ? forall x, y, result &GaussInt:
        result = gauss_div(x, y)
        =>:
            gauss_real_part(result) = int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y))
    gauss_div(x, y) = (int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)))
    result = gauss_div(x, y) = (int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)))
    gauss_real_part(result) = result(1) = int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y))

thm gauss_div_re_explicit:
    ? forall x, y &GaussInt:
        gauss_real_part(gauss_div(x, y)) = int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y))
    release thm gauss_div_re_from_result(x, y, gauss_div(x, y))

thm gauss_div_im_from_result:
    ? forall x, y, result &GaussInt:
        result = gauss_div(x, y)
        =>:
            gauss_imaginary_part(result) = int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y))
    gauss_div(x, y) = (int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)))
    result = gauss_div(x, y) = (int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)), int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)))
    gauss_imaginary_part(result) = result(2) = int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y))

thm gauss_div_im_explicit:
    ? forall x, y &GaussInt:
        gauss_imaginary_part(gauss_div(x, y)) = int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y))
    release thm gauss_div_im_from_result(x, y, gauss_div(x, y))

thm gauss_mod_re_explicit:
    ? forall x, y &GaussInt:
        gauss_real_part(gauss_mod(x, y)) = gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))
    release thm gauss_sub_re_explicit(x, gauss_mul(y, gauss_div(x, y)))
    release thm gauss_mul_re(y, gauss_div(x, y))
    gauss_mod(x, y) = gauss_sub(x, gauss_mul(y, gauss_div(x, y)))
    gauss_real_part(gauss_mod(x, y)) = gauss_real_part(gauss_sub(x, gauss_mul(y, gauss_div(x, y)))) = gauss_real_part(x) - gauss_real_part(gauss_mul(y, gauss_div(x, y))) = gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))

thm gauss_mod_im_explicit:
    ? forall x, y &GaussInt:
        gauss_imaginary_part(gauss_mod(x, y)) = gauss_imaginary_part(x) - (gauss_real_part(y) * gauss_imaginary_part(gauss_div(x, y)) + gauss_imaginary_part(y) * gauss_real_part(gauss_div(x, y)))
    release thm gauss_sub_im_explicit(x, gauss_mul(y, gauss_div(x, y)))
    release thm gauss_mul_im(y, gauss_div(x, y))
    gauss_mod(x, y) = gauss_sub(x, gauss_mul(y, gauss_div(x, y)))
    gauss_imaginary_part(gauss_mod(x, y)) = gauss_imaginary_part(gauss_sub(x, gauss_mul(y, gauss_div(x, y)))) = gauss_imaginary_part(x) - gauss_imaginary_part(gauss_mul(y, gauss_div(x, y))) = gauss_imaginary_part(x) - (gauss_real_part(y) * gauss_imaginary_part(gauss_div(x, y)) + gauss_imaginary_part(y) * gauss_real_part(gauss_div(x, y)))

# Multiplication by the conjugate turns the Gaussian remainder into the two
# centered integer remainders used to choose the quotient coordinates.
thm gauss_mod_mul_conj_re_explicit:
    ? forall x, y &GaussInt:
        gauss_real_part(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = int_centered_mod(gauss_mul_conj_re(x, y), gauss_norm(y))
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_real_part(y) = y.real
    gauss_imaginary_part(y) = y.im
    release thm gauss_mul_re(gauss_mod(x, y), gauss_conj(y))
    release thm gauss_conj_re(y)
    release thm gauss_conj_im(y)
    release thm gauss_mod_re_explicit(x, y)
    release thm gauss_mod_im_explicit(x, y)
    release thm gauss_div_re_explicit(x, y)
    gauss_real_part(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = gauss_real_part(gauss_mod(x, y)) * gauss_real_part(gauss_conj(y)) - gauss_imaginary_part(gauss_mod(x, y)) * gauss_imaginary_part(gauss_conj(y)) = gauss_real_part(gauss_mod(x, y)) * gauss_real_part(y) - gauss_imaginary_part(gauss_mod(x, y)) * gauss_imaginary_part(gauss_conj(y)) = gauss_real_part(gauss_mod(x, y)) * gauss_real_part(y) - gauss_imaginary_part(gauss_mod(x, y)) * (-gauss_imaginary_part(y))
    gauss_real_part(gauss_mod(x, y)) * gauss_real_part(y) - gauss_imaginary_part(gauss_mod(x, y)) * (-gauss_imaginary_part(y)) = (gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))) * gauss_real_part(y) - gauss_imaginary_part(gauss_mod(x, y)) * (-gauss_imaginary_part(y)) = (gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))) * gauss_real_part(y) - (gauss_imaginary_part(x) - (gauss_real_part(y) * gauss_imaginary_part(gauss_div(x, y)) + gauss_imaginary_part(y) * gauss_real_part(gauss_div(x, y)))) * (-gauss_imaginary_part(y))
    gauss_mul_conj_re(x, y) = gauss_real_part(x) * gauss_real_part(y) + gauss_imaginary_part(x) * gauss_imaginary_part(y)
    gauss_norm(y) = gauss_real_part(y)^2 + gauss_imaginary_part(y)^2
    (gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))) * gauss_real_part(y) - (gauss_imaginary_part(x) - (gauss_real_part(y) * gauss_imaginary_part(gauss_div(x, y)) + gauss_imaginary_part(y) * gauss_real_part(gauss_div(x, y)))) * (-gauss_imaginary_part(y)) = (gauss_real_part(x) * gauss_real_part(y) + gauss_imaginary_part(x) * gauss_imaginary_part(y)) - (gauss_real_part(y)^2 + gauss_imaginary_part(y)^2) * gauss_real_part(gauss_div(x, y))
    (gauss_real_part(x) * gauss_real_part(y) + gauss_imaginary_part(x) * gauss_imaginary_part(y)) - (gauss_real_part(y)^2 + gauss_imaginary_part(y)^2) * gauss_real_part(gauss_div(x, y)) = gauss_mul_conj_re(x, y) - gauss_norm(y) * gauss_real_part(gauss_div(x, y)) = gauss_mul_conj_re(x, y) - gauss_norm(y) * int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y))
    release thm int_centered_div_add_mod(gauss_mul_conj_re(x, y), gauss_norm(y))
    gauss_mul_conj_re(x, y) = gauss_norm(y) * int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)) + int_centered_mod(gauss_mul_conj_re(x, y), gauss_norm(y))
    gauss_mul_conj_re(x, y) - gauss_norm(y) * int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)) = (gauss_norm(y) * int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)) + int_centered_mod(gauss_mul_conj_re(x, y), gauss_norm(y))) - gauss_norm(y) * int_centered_div(gauss_mul_conj_re(x, y), gauss_norm(y)) = int_centered_mod(gauss_mul_conj_re(x, y), gauss_norm(y))

thm gauss_mod_mul_conj_im_explicit:
    ? forall x, y &GaussInt:
        gauss_imaginary_part(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = int_centered_mod(gauss_mul_conj_im(x, y), gauss_norm(y))
    gauss_real_part(x) = x.real
    gauss_imaginary_part(x) = x.im
    gauss_real_part(y) = y.real
    gauss_imaginary_part(y) = y.im
    release thm gauss_mul_im(gauss_mod(x, y), gauss_conj(y))
    release thm gauss_conj_re(y)
    release thm gauss_conj_im(y)
    release thm gauss_mod_re_explicit(x, y)
    release thm gauss_mod_im_explicit(x, y)
    release thm gauss_div_im_explicit(x, y)
    gauss_imaginary_part(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = gauss_real_part(gauss_mod(x, y)) * gauss_imaginary_part(gauss_conj(y)) + gauss_imaginary_part(gauss_mod(x, y)) * gauss_real_part(gauss_conj(y)) = gauss_real_part(gauss_mod(x, y)) * (-gauss_imaginary_part(y)) + gauss_imaginary_part(gauss_mod(x, y)) * gauss_real_part(gauss_conj(y)) = gauss_real_part(gauss_mod(x, y)) * (-gauss_imaginary_part(y)) + gauss_imaginary_part(gauss_mod(x, y)) * gauss_real_part(y)
    gauss_real_part(gauss_mod(x, y)) * (-gauss_imaginary_part(y)) + gauss_imaginary_part(gauss_mod(x, y)) * gauss_real_part(y) = (gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))) * (-gauss_imaginary_part(y)) + gauss_imaginary_part(gauss_mod(x, y)) * gauss_real_part(y) = (gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))) * (-gauss_imaginary_part(y)) + (gauss_imaginary_part(x) - (gauss_real_part(y) * gauss_imaginary_part(gauss_div(x, y)) + gauss_imaginary_part(y) * gauss_real_part(gauss_div(x, y)))) * gauss_real_part(y)
    gauss_mul_conj_im(x, y) = (-gauss_real_part(x)) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)
    gauss_norm(y) = gauss_real_part(y)^2 + gauss_imaginary_part(y)^2
    (gauss_real_part(x) - (gauss_real_part(y) * gauss_real_part(gauss_div(x, y)) - gauss_imaginary_part(y) * gauss_imaginary_part(gauss_div(x, y)))) * (-gauss_imaginary_part(y)) + (gauss_imaginary_part(x) - (gauss_real_part(y) * gauss_imaginary_part(gauss_div(x, y)) + gauss_imaginary_part(y) * gauss_real_part(gauss_div(x, y)))) * gauss_real_part(y) = ((-gauss_real_part(x)) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)) - (gauss_real_part(y)^2 + gauss_imaginary_part(y)^2) * gauss_imaginary_part(gauss_div(x, y))
    ((-gauss_real_part(x)) * gauss_imaginary_part(y) + gauss_imaginary_part(x) * gauss_real_part(y)) - (gauss_real_part(y)^2 + gauss_imaginary_part(y)^2) * gauss_imaginary_part(gauss_div(x, y)) = gauss_mul_conj_im(x, y) - gauss_norm(y) * gauss_imaginary_part(gauss_div(x, y)) = gauss_mul_conj_im(x, y) - gauss_norm(y) * int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y))
    release thm int_centered_div_add_mod(gauss_mul_conj_im(x, y), gauss_norm(y))
    gauss_mul_conj_im(x, y) = gauss_norm(y) * int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)) + int_centered_mod(gauss_mul_conj_im(x, y), gauss_norm(y))
    gauss_mul_conj_im(x, y) - gauss_norm(y) * int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)) = (gauss_norm(y) * int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)) + int_centered_mod(gauss_mul_conj_im(x, y), gauss_norm(y))) - gauss_norm(y) * int_centered_div(gauss_mul_conj_im(x, y), gauss_norm(y)) = int_centered_mod(gauss_mul_conj_im(x, y), gauss_norm(y))

# Each centered coordinate has size at most half the positive divisor norm.
# The sum of the two coordinate squares is therefore strictly below the square
# of that norm; multiplicativity and positive-factor cancellation finish the
# Euclidean remainder estimate.
thm gauss_norm_mod_lt_explicit:
    ? forall x, y &GaussInt:
        y != gauss_zero
        =>:
            gauss_rank(gauss_mod(x, y)) < gauss_rank(y)
    have norm_y_value Z = gauss_norm(y)
    have real_remainder_value Z = int_centered_mod(gauss_mul_conj_re(x, y), gauss_norm(y))
    have imag_remainder_value Z = int_centered_mod(gauss_mul_conj_im(x, y), gauss_norm(y))
    have scaled_remainder &GaussInt = gauss_mul(gauss_mod(x, y), gauss_conj(y))
    release thm gauss_norm_pos_reverse(y)
    gauss_norm(y) > 0
    norm_y_value = gauss_norm(y) > 0
    release thm int_centered_mod_abs_le(gauss_mul_conj_re(x, y), gauss_norm(y))
    release thm int_centered_mod_abs_le(gauss_mul_conj_im(x, y), gauss_norm(y))
    gauss_norm(y) / 2 = norm_y_value / 2
    abs(real_remainder_value) = abs(int_centered_mod(gauss_mul_conj_re(x, y), gauss_norm(y))) <= gauss_norm(y) / 2 = norm_y_value / 2
    abs(imag_remainder_value) = abs(int_centered_mod(gauss_mul_conj_im(x, y), gauss_norm(y))) <= gauss_norm(y) / 2 = norm_y_value / 2
    0 <= abs(real_remainder_value)
    0 <= abs(imag_remainder_value)
    0 < norm_y_value / 2
    abs(real_remainder_value) * abs(real_remainder_value) <= (norm_y_value / 2) * abs(real_remainder_value) <= (norm_y_value / 2) * (norm_y_value / 2)
    abs(imag_remainder_value) * abs(imag_remainder_value) <= (norm_y_value / 2) * abs(imag_remainder_value) <= (norm_y_value / 2) * (norm_y_value / 2)
    real_remainder_value^2 = abs(real_remainder_value)^2 <= (norm_y_value / 2)^2
    imag_remainder_value^2 = abs(imag_remainder_value)^2 <= (norm_y_value / 2)^2
    release thm gauss_mod_mul_conj_re_explicit(x, y)
    release thm gauss_mod_mul_conj_im_explicit(x, y)
    gauss_real_part(scaled_remainder) = gauss_real_part(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = real_remainder_value
    gauss_imaginary_part(scaled_remainder) = gauss_imaginary_part(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = imag_remainder_value
    gauss_norm(scaled_remainder) = gauss_real_part(scaled_remainder)^2 + gauss_imaginary_part(scaled_remainder)^2 = real_remainder_value^2 + gauss_imaginary_part(scaled_remainder)^2 = real_remainder_value^2 + imag_remainder_value^2 <= (norm_y_value / 2)^2 + (norm_y_value / 2)^2 = norm_y_value^2 / 2
    norm_y_value != 0
    norm_y_value * norm_y_value > 0
    norm_y_value^2 = norm_y_value * norm_y_value > 0
    1 / 2 < 1
    norm_y_value^2 / 2 = norm_y_value^2 * (1 / 2) < norm_y_value^2 * 1 = norm_y_value^2
    release thm gauss_norm_mul(gauss_mod(x, y), gauss_conj(y))
    release thm gauss_norm_conj(y)
    gauss_norm(scaled_remainder) = gauss_norm(gauss_mul(gauss_mod(x, y), gauss_conj(y))) = gauss_norm(gauss_mod(x, y)) * gauss_norm(gauss_conj(y)) = gauss_norm(gauss_mod(x, y)) * gauss_norm(y) = gauss_norm(gauss_mod(x, y)) * norm_y_value
    gauss_norm(scaled_remainder) <= norm_y_value^2 / 2 < norm_y_value^2
    gauss_norm(gauss_mod(x, y)) * norm_y_value = gauss_norm(scaled_remainder) < norm_y_value^2 = norm_y_value * norm_y_value
    (gauss_norm(gauss_mod(x, y)) * norm_y_value) / norm_y_value < (norm_y_value * norm_y_value) / norm_y_value
    gauss_norm(gauss_mod(x, y)) = (gauss_norm(gauss_mod(x, y)) * norm_y_value) / norm_y_value < (norm_y_value * norm_y_value) / norm_y_value = norm_y_value = gauss_norm(y)
    gauss_rank(gauss_mod(x, y)) = gauss_norm(gauss_mod(x, y)) < gauss_norm(y) = gauss_rank(y)

thm gauss_norm_mod_lt:
    ? forall x, y &GaussInt:
        y != gauss_zero
        =>:
            gauss_rank(gauss_mod(x, y)) < gauss_rank(y)
    release thm gauss_norm_mod_lt_explicit(x, y)

thm gauss_mul_left_not_rank_lt:
    ? forall x, y &GaussInt:
        y != gauss_zero
        =>:
            gauss_rank(gauss_mul(x, y)) >= gauss_rank(x)
    gauss_rank(gauss_mul(x, y)) = gauss_norm(gauss_mul(x, y)) = gauss_norm(x) * gauss_norm(y)
    gauss_norm(y) > 0
    gauss_norm(y) >= 1
    gauss_norm(x) >= 0
    gauss_norm(y) - 1 >= 0
    gauss_norm(x) * (gauss_norm(y) - 1) >= 0
    gauss_norm(x) * gauss_norm(y) - gauss_norm(x) = gauss_norm(x) * (gauss_norm(y) - 1) >= 0
    gauss_norm(x) * gauss_norm(y) >= gauss_norm(x)
    gauss_rank(gauss_mul(x, y)) >= gauss_norm(x) = gauss_rank(x)

prop is_euclidean_domain(s nonempty_set, add fn(x, y s) s, zero s, neg fn(x s) s, mul fn(x, y s) s, one s, quotient fn(x, y s) s, remainder fn(x, y s) s, rank fn(x s) N):
    $is_commutative_ring(s, add, zero, neg, mul, one)
    forall x, y s:
        add(mul(y, quotient(x, y)), remainder(x, y)) = x
    forall x, y s:
        y != zero
        =>:
            rank(remainder(x, y)) < rank(y)
            rank(mul(x, y)) >= rank(x)

struct EuclideanDomain<s nonempty_set>:
    add fn(x, y s) s
    zero s
    neg fn(x s) s
    mul fn(x, y s) s
    one s
    quotient fn(x, y s) s
    remainder fn(x, y s) s
    rank fn(x s) N
    <=>:
        $is_euclidean_domain(s, add, zero, neg, mul, one, quotient, remainder, rank)

# The callable source instance is assembled only from the explicit interfaces
# above, so its complete law package remains visible inside this chapter.
thm gaussian_integer_euclidean_domain_laws:
    ? forall gauss_euclidean_seed &GaussInt:
        $is_euclidean_domain(&GaussInt, gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one, gauss_div, gauss_mod, gauss_rank)
    release thm gaussian_integer_commutative_ring_laws(gauss_euclidean_seed)
    claim:
        ? forall x, y &GaussInt:
            gauss_add(gauss_mul(y, gauss_div(x, y)), gauss_mod(x, y)) = x
        release thm gauss_div_add_mod(x, y)
    claim:
        ? forall x, y &GaussInt:
            y != gauss_zero
            =>:
                gauss_rank(gauss_mod(x, y)) < gauss_rank(y)
                gauss_rank(gauss_mul(x, y)) >= gauss_rank(x)
        release thm gauss_norm_mod_lt(x, y)
        release thm gauss_mul_left_not_rank_lt(x, y)
    by def:
        ? $is_euclidean_domain(&GaussInt, gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one, gauss_div, gauss_mod, gauss_rank)

release thm gaussian_integer_euclidean_domain_laws(gauss_zero)
gauss_add $in fn(x, y &GaussInt) &GaussInt
gauss_zero $in &GaussInt
gauss_neg $in fn(x &GaussInt) &GaussInt
gauss_mul $in fn(x, y &GaussInt) &GaussInt
gauss_one $in &GaussInt
gauss_div $in fn(x, y &GaussInt) &GaussInt
gauss_mod $in fn(x, y &GaussInt) &GaussInt
gauss_rank $in fn(x &GaussInt) N
release thm cart_member_from_coordinates((gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one, gauss_div, gauss_mod, gauss_rank), cart(fn(x, y &GaussInt) &GaussInt, &GaussInt, fn(x &GaussInt) &GaussInt, fn(x, y &GaussInt) &GaussInt, &GaussInt, fn(x, y &GaussInt) &GaussInt, fn(x, y &GaussInt) &GaussInt, fn(x &GaussInt) N))
release thm struct_member((gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one, gauss_div, gauss_mod, gauss_rank), &EuclideanDomain<&GaussInt>)
have gaussian_integer_euclidean_domain &EuclideanDomain<&GaussInt> = (gauss_add, gauss_zero, gauss_neg, gauss_mul, gauss_one, gauss_div, gauss_mod, gauss_rank)

# The final irreducible_iff_prime line is an unnamed API demonstration rather
# than a new source definition or theorem, so it is outside this core slice.
