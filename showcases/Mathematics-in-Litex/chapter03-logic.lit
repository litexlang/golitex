# Adapted from Mathematics in Lean; rewritten in Litex. See NOTICE.md.
# Chapter 3 — Logic
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter keeps the mathematical content of the source while collapsing
# repeated Lean elaboration and tactic variants into one Litex proof route.

# 3.1 Implication and the Universal Quantifier

# Source: my_lemma through my_lemma4. If x and y are both smaller than a
# positive epsilon in absolute value, and epsilon is at most one, then their
# product is still smaller than epsilon. The proof multiplies the two bounds
# and uses epsilon^2 <= epsilon.
thm small_product_below_epsilon:
    ? forall x, y R, epsilon R+:
        epsilon <= 1
        abs(x) < epsilon
        abs(y) < epsilon
        =>:
            abs(x * y) < epsilon
    abs(x * y) = abs(x) * abs(y)
    0 <= abs(y)
    abs(x) <= epsilon
    abs(x) * abs(y) <= epsilon * abs(y)
    epsilon * abs(y) < epsilon * epsilon
    epsilon * epsilon <= 1 * epsilon = epsilon
    abs(x * y) = abs(x) * abs(y) <= epsilon * abs(y) < epsilon * epsilon <= 1 * epsilon = epsilon

# Source definition FnUb. A real number a is an upper bound for f when every
# value of f is at most a.
prop is_upper_bound_of_fn(f fn(x R) R, a R):
    forall x R:
        f(x) <= a

# Source definition FnLb. A lower bound is below every value of the function.
prop is_lower_bound_of_fn(f fn(x R) R, a R):
    forall x R:
        a <= f(x)

# Source result fnUb_add. Pointwise addition adds upper bounds.
thm upper_bound_of_fn_add:
    ? forall f, g fn(x R) R, a, b R:
        $is_upper_bound_of_fn(f, a)
        $is_upper_bound_of_fn(g, b)
        =>:
            $is_upper_bound_of_fn(fn(x R) R {f(x) + g(x)}, a + b)
    claim:
        ? forall x R:
            f(x) + g(x) <= a + b
        f(x) <= a
        g(x) <= b
        f(x) + g(x) <= a + b
    by def $is_upper_bound_of_fn(fn(x R) R {f(x) + g(x)}, a + b)

# The dual source example shows that pointwise addition also adds lower bounds.
thm lower_bound_of_fn_add:
    ? forall f, g fn(x R) R, a, b R:
        $is_lower_bound_of_fn(f, a)
        $is_lower_bound_of_fn(g, b)
        =>:
            $is_lower_bound_of_fn(fn(x R) R {f(x) + g(x)}, a + b)
    claim:
        ? forall x R:
            a + b <= f(x) + g(x)
        a <= f(x)
        b <= g(x)
        a + b <= f(x) + g(x)
    by def $is_lower_bound_of_fn(fn(x R) R {f(x) + g(x)}, a + b)

# The source also records the useful nonnegative-product instance.
thm nonnegative_fn_product:
    ? forall f, g fn(x R) R:
        $is_lower_bound_of_fn(f, 0)
        $is_lower_bound_of_fn(g, 0)
        =>:
            $is_lower_bound_of_fn(fn(x R) R {f(x) * g(x)}, 0)
    claim:
        ? forall x R:
            0 <= f(x) * g(x)
        0 <= f(x)
        0 <= g(x)
        0 <= f(x) * g(x)
    by def $is_lower_bound_of_fn(fn(x R) R {f(x) * g(x)}, 0)

# Generic source orders are represented extensionally as sets of ordered
# pairs. This keeps the carrier explicit while making the relation callable in
# facts through membership.
prop order_holds(A set, le_rel power_set(cart(A, A)), x, y A):
    (x, y) $in le_rel

# A preorder relation is reflexive and transitive on its carrier.
prop is_preorder_relation(A set, le_rel power_set(cart(A, A))):
    forall x A:
        $order_holds(A, le_rel, x, x)
    forall x, y, z A:
        $order_holds(A, le_rel, x, y)
        $order_holds(A, le_rel, y, z)
        =>:
            $order_holds(A, le_rel, x, z)

# A partial order adds antisymmetry to the preorder laws.
prop is_partial_order_relation(A set, le_rel power_set(cart(A, A))):
    $is_preorder_relation(A, le_rel)
    forall x, y A:
        $order_holds(A, le_rel, x, y)
        $order_holds(A, le_rel, y, x)
        =>:
            x = y

# The source ConvergesTo' domain is linearly ordered, so its relation also has
# total comparability rather than only the preorder laws.
prop is_linear_order_relation(A set, le_rel power_set(cart(A, A))):
    $is_partial_order_relation(A, le_rel)
    forall x, y A:
        $order_holds(A, le_rel, x, y) or $order_holds(A, le_rel, y, x)

template<A set>:
    have Preorder set = {le_rel power_set(cart(A, A)): $is_preorder_relation(A, le_rel)}

template<A set>:
    have PartialOrder set = {le_rel power_set(cart(A, A)): $is_partial_order_relation(A, le_rel)}

template<A set>:
    have LinearOrder set = {le_rel power_set(cart(A, A)): $is_linear_order_relation(A, le_rel)}

# The generic source theorem fnUb_add uses an additive commutative monoid with
# IsOrderedCancelAddMonoid. Besides monotonicity in both inputs, the latter
# reflects the order after cancelling an equal left or right addend.
prop is_add_comm_monoid(A set, add fn(x, y A) A, zero A):
    forall x, y, z A:
        add(add(x, y), z) = add(x, add(y, z))
    forall x A:
        add(zero, x) = x
        add(x, zero) = x
    forall x, y A:
        add(x, y) = add(y, x)

prop is_ordered_cancel_add_monoid_relation(A set, le_rel \PartialOrder<A>, add fn(x, y A) A):
    forall x1, x2, y1, y2 A:
        $order_holds(A, le_rel, x1, x2)
        $order_holds(A, le_rel, y1, y2)
        =>:
            $order_holds(A, le_rel, add(x1, y1), add(x2, y2))
    forall a, b, c A:
        $order_holds(A, le_rel, add(a, b), add(a, c))
        =>:
            $order_holds(A, le_rel, b, c)
    forall a, b, c A:
        $order_holds(A, le_rel, add(b, a), add(c, a))
        =>:
            $order_holds(A, le_rel, b, c)

# Source definition FnUb'. Its arbitrary domain and partially ordered codomain
# remain carrier-first and relation-explicit.
prop is_upper_bound_of_fn_by_relation(D, A set, le_rel \PartialOrder<A>, f fn(x D) A, a A):
    forall x D:
        $order_holds(A, le_rel, f(x), a)

# Source theorem fnUb_add. The pointwise relation follows directly from the two
# input bounds and compatibility of addition with the explicit order.
thm upper_bound_of_fn_add_by_relation:
    ? forall D, A set, le_rel \PartialOrder<A>, add fn(x, y A) A, zero A, f, g fn(x D) A, a, b A:
        $is_add_comm_monoid(A, add, zero)
        $is_ordered_cancel_add_monoid_relation(A, le_rel, add)
        $is_upper_bound_of_fn_by_relation(D, A, le_rel, f, a)
        $is_upper_bound_of_fn_by_relation(D, A, le_rel, g, b)
        =>:
            $is_upper_bound_of_fn_by_relation(D, A, le_rel, fn(x D) A {add(f(x), g(x))}, add(a, b))
    claim:
        ? forall x D:
            $order_holds(A, le_rel, add(f(x), g(x)), add(a, b))
        $order_holds(A, le_rel, f(x), a)
        $order_holds(A, le_rel, g(x), b)
        $order_holds(A, le_rel, add(f(x), g(x)), add(a, b))
    by def $is_upper_bound_of_fn_by_relation(D, A, le_rel, fn(x D) A {add(f(x), g(x))}, add(a, b))

# Source definitions FnEven and FnOdd describe symmetry under x |-> -x.
prop is_even_fn(f fn(x R) R):
    forall x R:
        f(x) = f(-x)

prop is_odd_fn(f fn(x R) R):
    forall x R:
        f(x) = (-f(-x))

# The sum of two even functions is even.
thm even_fn_add:
    ? forall f, g fn(x R) R:
        $is_even_fn(f)
        $is_even_fn(g)
        =>:
            $is_even_fn(fn(x R) R {f(x) + g(x)})
    claim:
        ? forall x R:
            fn(z R) R {f(z) + g(z)}(x) = fn(z R) R {f(z) + g(z)}(-x)
        f(x) = f(-x)
        g(x) = g(-x)
        fn(z R) R {f(z) + g(z)}(x) = fn(z R) R {f(z) + g(z)}(-x)
    by def $is_even_fn(fn(x R) R {f(x) + g(x)})

# The product of two odd functions is even.
thm odd_fn_mul_odd_fn:
    ? forall f, g fn(x R) R:
        $is_odd_fn(f)
        $is_odd_fn(g)
        =>:
            $is_even_fn(fn(x R) R {f(x) * g(x)})
    claim:
        ? forall x R:
            fn(z R) R {f(z) * g(z)}(x) = fn(z R) R {f(z) * g(z)}(-x)
        f(x) = (-f(-x))
        g(x) = (-g(-x))
        f(x) * g(x) = (-f(-x)) * (-g(-x)) = f(-x) * g(-x)
        fn(z R) R {f(z) * g(z)}(x) = fn(z R) R {f(z) * g(z)}(-x)
    by def $is_even_fn(fn(x R) R {f(x) * g(x)})

# The product of an even and an odd function is odd.
thm even_fn_mul_odd_fn:
    ? forall f, g fn(x R) R:
        $is_even_fn(f)
        $is_odd_fn(g)
        =>:
            $is_odd_fn(fn(x R) R {f(x) * g(x)})
    thm product_is_odd:
        ? forall sequence fn(index R) R:
            sequence = fn(x R) R {f(x) * g(x)}
            =>:
                $is_odd_fn(sequence)
        claim:
            ? forall x R:
                sequence(x) = (-sequence(-x))
            f(x) = f(-x)
            g(x) = (-g(-x))
            sequence(x) = f(x) * g(x)
            sequence(-x) = f(-x) * g(-x)
            thm negate_equal:
                ? forall left, right R:
                    left = right
                    =>:
                        (-left) = (-right)
            by thm negate_equal(sequence(-x), f(-x) * g(-x)) => (-sequence(-x)) = (-(f(-x) * g(-x)))
            sequence(x) = f(x) * g(x) = f(-x) * (-g(-x)) = (-(f(-x) * g(-x))) = (-sequence(-x))
        by def $is_odd_fn(sequence)
    by thm product_is_odd(fn(x R) R {f(x) * g(x)}) => $is_odd_fn(fn(x R) R {f(x) * g(x)})
# Composing an even function with an odd one gives an even function.
thm even_fn_comp_odd_fn:
    ? forall f, g fn(x R) R:
        $is_even_fn(f)
        $is_odd_fn(g)
        =>:
            $is_even_fn(fn(x R) R {f(g(x))})
    claim:
        ? forall x R:
            fn(z R) R {f(g(z))}(x) = fn(z R) R {f(g(z))}(-x)
        f(g(x)) = f(-g(x))
        g(x) = (-g(-x))
        (-g(x)) = -(-g(-x)) = g(-x)
        f(-g(x)) = f(g(-x))
        f(g(x)) = f(-g(x)) = f(g(-x))
        fn(z R) R {f(g(z))}(x) = fn(z R) R {f(g(z))}(-x)
    by def $is_even_fn(fn(x R) R {f(g(x))})

# Source theorems Subset.refl and Subset.trans. Litex has subset as a builtin,
# so both statements follow directly from membership propagation.
thm subset_refl:
    ? forall S set:
        S $subset S

thm subset_trans:
    ? forall R0, S, T set:
        R0 $subset S
        S $subset T
        =>:
            R0 $subset T
    claim:
        ? forall x R0:
            x $in T
        x $in S
        x $in T
    by def R0 $subset T

# Source definition SetUb. The source carrier is an arbitrary partial order, so
# both the carrier and its order relation remain explicit here.
prop is_upper_bound_of_set(A set, le_rel \PartialOrder<A>, S power_set(A), a A):
    forall x S:
        $order_holds(A, le_rel, x, a)

thm upper_bound_of_set_mono:
    ? forall A set, le_rel \PartialOrder<A>, S power_set(A), a, b A:
        $is_upper_bound_of_set(A, le_rel, S, a)
        $order_holds(A, le_rel, a, b)
        =>:
            $is_upper_bound_of_set(A, le_rel, S, b)
    \PartialOrder<A> = {relation power_set(cart(A, A)): $is_partial_order_relation(A, relation)}
    by thm chap2::transport_membership(\PartialOrder<A>, {relation power_set(cart(A, A)): $is_partial_order_relation(A, relation)}, le_rel) => le_rel $in {relation power_set(cart(A, A)): $is_partial_order_relation(A, relation)}
    $is_partial_order_relation(A, le_rel)
    $is_preorder_relation(A, le_rel)
    claim:
        ? forall x S:
            $order_holds(A, le_rel, x, b)
        $order_holds(A, le_rel, x, a)
        $order_holds(A, le_rel, a, b)
        $order_holds(A, le_rel, x, b)
    by def $is_upper_bound_of_set(A, le_rel, S, b)

# 3.2 The Existential Quantifier

# Source definitions FnHasUb and FnHasLb hide the particular bound while
# retaining the upper- or lower-bound property.
prop has_upper_bound(f fn(x R) R):
    exist a R st {$is_upper_bound_of_fn(f, a)}

prop has_lower_bound(f fn(x R) R):
    exist a R st {$is_lower_bound_of_fn(f, a)}

# The repeated source proof variants for bounded sums collapse to one witness
# construction: unpack both bounds and choose their sum.
thm has_upper_bound_add:
    ? forall f, g fn(x R) R:
        $has_upper_bound(f)
        $has_upper_bound(g)
        =>:
            $has_upper_bound(fn(x R) R {f(x) + g(x)})
    obtain a from $has_upper_bound(f)
    obtain b from $has_upper_bound(g)
    release thm upper_bound_of_fn_add(f, g, a, b)
    witness $has_upper_bound(fn(x R) R {f(x) + g(x)}) from a + b

thm has_lower_bound_add:
    ? forall f, g fn(x R) R:
        $has_lower_bound(f)
        $has_lower_bound(g)
        =>:
            $has_lower_bound(fn(x R) R {f(x) + g(x)})
    obtain a from $has_lower_bound(f)
    obtain b from $has_lower_bound(g)
    release thm lower_bound_of_fn_add(f, g, a, b)
    witness $has_lower_bound(fn(x R) R {f(x) + g(x)}) from a + b

# Source definition SumOfSquares. The carrier and its operations are explicit,
# so the definition remains generic instead of silently specializing to R.
prop is_sum_of_two_squares(A set, add fn(x, y A) A, mul fn(x, y A) A, z A):
    exist a, b A st {z = add(mul(a, a), mul(b, b))}

# Source result sumOfSquares_mul (including its duplicate proof variant).
# Unpack the two representations, use the real and imaginary parts of their
# product as witnesses, and verify the generic commutative-ring identity.
thm sum_of_two_squares_mul:
    ? forall A set, add fn(x, y A) A, zero A, neg fn(x A) A, mul fn(x, y A) A, one A, z, w A:
        $chap2::ring_laws(A, add, zero, neg, mul, one)
        forall x, y A:
            mul(x, y) = mul(y, x)
        $is_sum_of_two_squares(A, add, mul, z)
        $is_sum_of_two_squares(A, add, mul, w)
        =>:
            $is_sum_of_two_squares(A, add, mul, mul(z, w))
    $chap2::additive_commutative_group_laws(A, add, zero, neg)
    by def $chap2::additive_commutative_group_laws(A, add, zero, neg)
    obtain a, b from $is_sum_of_two_squares(A, add, mul, z)
    obtain c, d from $is_sum_of_two_squares(A, add, mul, w)
    have ac A = mul(a, c)
    have bd A = mul(b, d)
    have ad A = mul(a, d)
    have bc A = mul(b, c)
    have p A = add(ac, neg(bd))
    have q A = add(ad, bc)
    have cross A = mul(ac, bd)
    release thm chap2::mul_neg_right_structure(A, add, zero, neg, mul, one, ac, bd)
    release thm chap2::neg_mul_left_structure(A, add, zero, neg, mul, one, bd, ac)
    release thm chap2::neg_mul_neg_structure(A, add, zero, neg, mul, one, bd, bd)
    mul(bd, ac) = mul(ac, bd) = cross
    mul(neg(bd), ac) = neg(mul(bd, ac)) = neg(mul(ac, bd)) = neg(cross)
    mul(ac, neg(bd)) = neg(mul(ac, bd)) = neg(cross)
    mul(neg(bd), neg(bd)) = mul(bd, bd)
    release thm chap2::commutative_mul_reorder_four_structure(A, mul, a, c, a, c)
    release thm chap2::commutative_mul_reorder_four_structure(A, mul, a, d, a, d)
    release thm chap2::commutative_mul_reorder_four_structure(A, mul, b, c, b, c)
    release thm chap2::commutative_mul_reorder_four_structure(A, mul, b, d, b, d)
    mul(ac, ac) = mul(mul(a, c), ac) = mul(mul(a, c), mul(a, c)) = mul(mul(a, a), mul(c, c))
    mul(ad, ad) = mul(mul(a, d), ad) = mul(mul(a, d), mul(a, d)) = mul(mul(a, a), mul(d, d))
    mul(bc, bc) = mul(mul(b, c), bc) = mul(mul(b, c), mul(b, c)) = mul(mul(b, b), mul(c, c))
    mul(bd, bd) = mul(mul(b, d), bd) = mul(mul(b, d), mul(b, d)) = mul(mul(b, b), mul(d, d))
    release thm chap2::commutative_mul_reorder_four_structure(A, mul, a, d, b, c)
    release thm chap2::commutative_mul_reorder_four_structure(A, mul, a, c, b, d)
    mul(d, c) = mul(c, d)
    mul(mul(a, b), mul(d, c)) = mul(mul(a, b), mul(c, d))
    mul(mul(a, c), mul(b, d)) = mul(ac, mul(b, d)) = mul(ac, bd) = cross
    mul(ad, bc) = mul(mul(a, d), mul(b, c)) = mul(mul(a, b), mul(d, c)) = mul(mul(a, b), mul(c, d)) = mul(mul(a, c), mul(b, d)) = cross
    mul(bc, ad) = mul(ad, bc) = cross
    mul(add(ac, neg(bd)), ac) = add(mul(ac, ac), mul(neg(bd), ac))
    mul(add(ac, neg(bd)), neg(bd)) = add(mul(ac, neg(bd)), mul(neg(bd), neg(bd)))
    add(mul(ac, ac), mul(neg(bd), ac)) = add(mul(ac, ac), neg(cross))
    add(mul(ac, neg(bd)), mul(neg(bd), neg(bd))) = add(neg(cross), mul(bd, bd))
    add(mul(add(ac, neg(bd)), ac), mul(add(ac, neg(bd)), neg(bd))) = add(add(mul(ac, ac), mul(neg(bd), ac)), mul(add(ac, neg(bd)), neg(bd))) = add(add(mul(ac, ac), mul(neg(bd), ac)), add(mul(ac, neg(bd)), mul(neg(bd), neg(bd)))) = add(add(mul(ac, ac), neg(cross)), add(mul(ac, neg(bd)), mul(neg(bd), neg(bd)))) = add(add(mul(ac, ac), neg(cross)), add(neg(cross), mul(bd, bd)))
    mul(p, p) = mul(add(ac, neg(bd)), add(ac, neg(bd))) = add(mul(add(ac, neg(bd)), ac), mul(add(ac, neg(bd)), neg(bd))) = add(add(mul(ac, ac), neg(cross)), add(neg(cross), mul(bd, bd)))
    mul(add(ad, bc), ad) = add(mul(ad, ad), mul(bc, ad))
    mul(add(ad, bc), bc) = add(mul(ad, bc), mul(bc, bc))
    add(mul(ad, ad), mul(bc, ad)) = add(mul(ad, ad), cross)
    add(mul(ad, bc), mul(bc, bc)) = add(cross, mul(bc, bc))
    add(mul(add(ad, bc), ad), mul(add(ad, bc), bc)) = add(add(mul(ad, ad), mul(bc, ad)), mul(add(ad, bc), bc)) = add(add(mul(ad, ad), mul(bc, ad)), add(mul(ad, bc), mul(bc, bc))) = add(add(mul(ad, ad), cross), add(mul(ad, bc), mul(bc, bc))) = add(add(mul(ad, ad), cross), add(cross, mul(bc, bc)))
    mul(q, q) = mul(add(ad, bc), add(ad, bc)) = add(mul(add(ad, bc), ad), mul(add(ad, bc), bc)) = add(add(mul(ad, ad), cross), add(cross, mul(bc, bc)))
    release thm chap2::add_reorder_four_structure(A, add, zero, neg, add(mul(ac, ac), neg(cross)), add(neg(cross), mul(bd, bd)), add(mul(ad, ad), cross), add(cross, mul(bc, bc)))
    release thm chap2::add_reorder_four_structure(A, add, zero, neg, mul(ac, ac), neg(cross), mul(ad, ad), cross)
    release thm chap2::add_reorder_four_structure(A, add, zero, neg, neg(cross), mul(bd, bd), cross, mul(bc, bc))
    add(neg(cross), cross) = zero
    release thm chap2::add_zero_from_laws(A, add, zero, neg, add(mul(ac, ac), mul(ad, ad)))
    add(add(mul(ac, ac), neg(cross)), add(mul(ad, ad), cross)) = add(add(mul(ac, ac), mul(ad, ad)), add(neg(cross), cross)) = add(add(mul(ac, ac), mul(ad, ad)), zero) = add(mul(ac, ac), mul(ad, ad))
    thm add_equal_first_argument:
        ? forall uu, vv, ww A:
            uu = vv
            =>:
                add(uu, ww) = add(vv, ww)
    by thm add_equal_first_argument(add(neg(cross), cross), zero, add(mul(bd, bd), mul(bc, bc))) => add(add(neg(cross), cross), add(mul(bd, bd), mul(bc, bc))) = add(zero, add(mul(bd, bd), mul(bc, bc)))
    add(add(neg(cross), mul(bd, bd)), add(cross, mul(bc, bc))) = add(add(neg(cross), cross), add(mul(bd, bd), mul(bc, bc))) = add(zero, add(mul(bd, bd), mul(bc, bc))) = add(mul(bd, bd), mul(bc, bc))
    add(mul(p, p), mul(q, q)) = add(add(add(mul(ac, ac), neg(cross)), add(neg(cross), mul(bd, bd))), add(add(mul(ad, ad), cross), add(cross, mul(bc, bc)))) = add(add(add(mul(ac, ac), neg(cross)), add(mul(ad, ad), cross)), add(add(neg(cross), mul(bd, bd)), add(cross, mul(bc, bc)))) = add(add(mul(ac, ac), mul(ad, ad)), add(mul(bd, bd), mul(bc, bc)))
    mul(add(mul(a, a), mul(b, b)), mul(c, c)) = add(mul(mul(a, a), mul(c, c)), mul(mul(b, b), mul(c, c)))
    mul(add(mul(a, a), mul(b, b)), mul(d, d)) = add(mul(mul(a, a), mul(d, d)), mul(mul(b, b), mul(d, d)))
    add(mul(add(mul(a, a), mul(b, b)), mul(c, c)), mul(add(mul(a, a), mul(b, b)), mul(d, d))) = add(add(mul(mul(a, a), mul(c, c)), mul(mul(b, b), mul(c, c))), mul(add(mul(a, a), mul(b, b)), mul(d, d))) = add(add(mul(mul(a, a), mul(c, c)), mul(mul(b, b), mul(c, c))), add(mul(mul(a, a), mul(d, d)), mul(mul(b, b), mul(d, d))))
    mul(z, w) = mul(add(mul(a, a), mul(b, b)), add(mul(c, c), mul(d, d))) = add(mul(add(mul(a, a), mul(b, b)), mul(c, c)), mul(add(mul(a, a), mul(b, b)), mul(d, d))) = add(add(mul(mul(a, a), mul(c, c)), mul(mul(b, b), mul(c, c))), add(mul(mul(a, a), mul(d, d)), mul(mul(b, b), mul(d, d))))
    release thm chap2::add_reorder_four_structure(A, add, zero, neg, mul(mul(a, a), mul(c, c)), mul(mul(b, b), mul(c, c)), mul(mul(a, a), mul(d, d)), mul(mul(b, b), mul(d, d)))
    add(mul(mul(a, a), mul(c, c)), mul(mul(a, a), mul(d, d))) = add(mul(ac, ac), mul(ad, ad))
    add(mul(mul(b, b), mul(c, c)), mul(mul(b, b), mul(d, d))) = add(mul(bc, bc), mul(bd, bd))
    thm add_equal_arguments:
        ? forall xx, yy, zz, tt A:
            xx = zz
            yy = tt
            =>:
                add(xx, yy) = add(zz, tt)
    by thm add_equal_arguments(add(mul(mul(a, a), mul(c, c)), mul(mul(a, a), mul(d, d))), add(mul(mul(b, b), mul(c, c)), mul(mul(b, b), mul(d, d))), add(mul(ac, ac), mul(ad, ad)), add(mul(bc, bc), mul(bd, bd))) => add(add(mul(mul(a, a), mul(c, c)), mul(mul(a, a), mul(d, d))), add(mul(mul(b, b), mul(c, c)), mul(mul(b, b), mul(d, d)))) = add(add(mul(ac, ac), mul(ad, ad)), add(mul(bc, bc), mul(bd, bd)))
    mul(z, w) = add(add(mul(mul(a, a), mul(c, c)), mul(mul(a, a), mul(d, d))), add(mul(mul(b, b), mul(c, c)), mul(mul(b, b), mul(d, d)))) = add(add(mul(ac, ac), mul(ad, ad)), add(mul(bc, bc), mul(bd, bd)))
    add(mul(bc, bc), mul(bd, bd)) = add(mul(bd, bd), mul(bc, bc))
    add(add(mul(ac, ac), mul(ad, ad)), add(mul(bc, bc), mul(bd, bd))) = add(add(mul(ac, ac), mul(ad, ad)), add(mul(bd, bd), mul(bc, bc)))
    mul(z, w) = add(add(mul(ac, ac), mul(ad, ad)), add(mul(bc, bc), mul(bd, bd))) = add(add(mul(ac, ac), mul(ad, ad)), add(mul(bd, bd), mul(bc, bc))) = add(mul(p, p), mul(q, q))
    witness $is_sum_of_two_squares(A, add, mul, mul(z, w)) from p, q
# 3.4 Conjunction and Iff

# Source definition Monotone, made explicit for real functions.
prop is_monotone_fn(f fn(x R) R):
    forall x, y R:
        x <= y
        =>:
            f(x) <= f(y)

# Source theorem not_monotone_iff, represented by its two fact directions
# because Litex theorem goals are implication-shaped rather than top-level iff.
thm not_monotone_iff_forward:
    ? forall f fn(x R) R:
        not $is_monotone_fn(f)
        =>:
            exist x, y R st {x <= y, f(x) > f(y)}
    claim:
        ? forall:
            not $is_monotone_fn(f)
            =>:
                exist x, y R st {x <= y, f(x) > f(y)}
        # The source uses push_neg. Litex performs the same classical argument
        # explicitly: if no counterexample exists, every ordered pair is
        # monotone, contradicting the premise.
        prop _is_monotonicity_counterexample(x, y R):
            x <= y
            f(x) > f(y)
        claim:
            ? exist x, y R st {$_is_monotonicity_counterexample(x, y)}
            by contra:
                ? exist x, y R st {$_is_monotonicity_counterexample(x, y)}
                claim:
                    ? forall x, y R:
                        x <= y
                        =>:
                            f(x) <= f(y)
                    by contra:
                        ? f(x) <= f(y)
                        f(x) > f(y)
                        by def $_is_monotonicity_counterexample(x, y)
                        $_is_monotonicity_counterexample(x, y)
                        impossible $_is_monotonicity_counterexample(x, y)
                by def $is_monotone_fn(f)
                $is_monotone_fn(f)
                impossible not $is_monotone_fn(f)
        obtain x, y from exist x, y R st {$_is_monotonicity_counterexample(x, y)}
        witness exist u, v R st {u <= v, f(u) > f(v)} from x, y:
            x <= y
            f(x) > f(y)
    claim:
        ? forall:
            exist x, y R st {x <= y, f(x) > f(y)}
            =>:
                not $is_monotone_fn(f)
        obtain x, y from exist x, y R st {x <= y, f(x) > f(y)}
        by contra:
            ? not $is_monotone_fn(f)
            $is_monotone_fn(f)
            f(x) <= f(y)
            impossible f(x) > f(y)

thm not_monotone_iff_reverse:
    ? forall f fn(x R) R:
        exist x, y R st {x <= y, f(x) > f(y)}
        =>:
            not $is_monotone_fn(f)
    obtain x, y from exist x, y R st {x <= y, f(x) > f(y)}
    by contra:
        ? not $is_monotone_fn(f)
        $is_monotone_fn(f)
        f(x) <= f(y)
        impossible f(x) > f(y)

# 3.5 Disjunction

# Source namespace MyAbs. These five named results expose the standard absolute
# value inequalities and their two useful logical normal forms.
thm le_abs_self:
    ? forall x R:
        x <= abs(x)

thm neg_le_abs_self:
    ? forall x R:
        (-x) <= abs(x)
    by cases:
        ? (-x) <= abs(x)
        case 0 <= x:
            abs(x) = x
            -x = (-x) + 0 <= (-x) + x = 0
            -x <= 0 <= x
        case 0 > x:
            x <= 0
            abs(x) = -x

thm abs_add_le:
    ? forall x, y R:
        abs(x + y) <= abs(x) + abs(y)

# Source theorem lt_abs, expressed by two direction facts.
thm lt_abs_forward:
    ? forall x, y R:
        x < abs(y)
        =>:
            x < y or x < (-y)
    by cases:
        ? x < y or x < (-y)
        case y >= 0:
            0 <= y
            abs(y) = y
            x < y
        case y < 0:
            y <= 0
            abs(y) = (-y)
            x < (-y)

thm lt_abs_reverse:
    ? forall x, y R:
        x < y or x < (-y)
        =>:
            x < abs(y)
    by cases:
        ? x < abs(y)
        case x < y:
            release thm le_abs_self(y)
            x < y <= abs(y)
        case x < (-y):
            release thm neg_le_abs_self(y)
            x < (-y) <= abs(y)

# Source theorem abs_lt, expressed by two direction facts.
thm abs_lt_forward:
    ? forall x, y R:
        abs(x) < y
        =>:
            (-y) < x and x < y
    by thm le_abs_self(x) => x <= abs(x)
    by thm neg_le_abs_self(x) => (-x) <= abs(x)
    x <= abs(x) < y
    (-x) <= abs(x) < y
    -y = (-x) + (x - y) < y + (x - y) = x

thm abs_lt_reverse:
    ? forall x, y R:
        (-y) < x and x < y
        =>:
            abs(x) < y
    by cases:
        ? abs(x) < y
        case x >= 0:
            0 <= x
            abs(x) = x < y
        case x < 0:
            x <= 0
            -x = (-y) + (y - x) < x + (y - x) = y
            abs(x) = (-x) < y

# 3.6 Sequences and Convergence

# 3.6 Sequences and Convergence

# Private parser-facing helper. The tail beginning at N0 remains within
# epsilon of a. This is not a second public convergence interface.
prop _is_eventually_close(s fn(n N) R, a R, epsilon R+, N0 N):
    forall n N:
        n >= N0
        =>:
            abs(s(n) - a) < epsilon

# Source definition ConvergesTo. The sequence domain is N, including index 0.
prop converges_to(s fn(n N) R, a R):
    forall epsilon R+:
        exist N0 N st {$_is_eventually_close(s, a, epsilon, N0)}

# Pointwise-equal sequences have the same limit. Exposing the inner subtraction
# equality keeps the absolute-value congruence explicit and reusable.
thm converges_to_congr:
    ? forall s, t fn(n N) R, a, b R:
        $converges_to(s, a)
        forall n N:
            s(n) = t(n)
        a = b
        =>:
            $converges_to(t, b)
    claim:
        ? forall epsilon R+:
            exist N0 N st {$_is_eventually_close(t, b, epsilon, N0)}
        obtain N0 from exist K N st {$_is_eventually_close(s, a, epsilon, K)}
        witness exist K N st {$_is_eventually_close(t, b, epsilon, K)} from N0:
            claim:
                ? forall n N:
                    n >= N0
                    =>:
                        abs(t(n) - b) < epsilon
                abs(s(n) - a) < epsilon
                t(n) = s(n)
                b = a
                t(n) - b = s(n) - a
                abs(t(n) - b) = abs(s(n) - a) < epsilon
            by def $_is_eventually_close(t, b, epsilon, N0)
    by def $converges_to(t, b)

# Source theorem convergesTo_const. Choose N0 = 0; every later term differs
# from the constant limit by zero.
thm converges_to_const:
    ? forall a R:
        $converges_to(fn(n N) R {a}, a)
    thm constant_sequence_converges:
        ? forall sequence fn(index N) R:
            sequence = fn(k N) R {a}
            =>:
                $converges_to(sequence, a)
        thm subtract_equal_first:
            ? forall u, v, w R:
                u = v
                =>:
                    u - w = v - w
        claim:
            ? forall epsilon R+:
                exist N0 N st {$_is_eventually_close(sequence, a, epsilon, N0)}
            witness exist N0 N st {$_is_eventually_close(sequence, a, epsilon, N0)} from 0:
                claim:
                    ? forall n N:
                        n >= 0
                        =>:
                            abs(sequence(n) - a) < epsilon
                    sequence(n) = a
                    a - a = 0
                    by thm subtract_equal_first(sequence(n), a, a) => sequence(n) - a = a - a
                    sequence(n) - a = 0
                    0 <= sequence(n) - a
                    thm abs_of_nonnegative:
                        ? forall t R:
                            0 <= t
                            =>:
                                abs(t) = t
                    by thm abs_of_nonnegative(sequence(n) - a) => abs(sequence(n) - a) = sequence(n) - a
                    abs(sequence(n) - a) = sequence(n) - a = 0 < epsilon
                by def $_is_eventually_close(sequence, a, epsilon, 0)
        by def $converges_to(sequence, a)

    by thm constant_sequence_converges(fn(n N) R {a}) => $converges_to(fn(n N) R {a}, a)

# Source theorem convergesTo_add. Use epsilon/2 for each input sequence and the
# maximum of the two tail indices, then apply the triangle inequality.
thm converges_to_add:
    ? forall s, t fn(n N) R, a, b R:
        $converges_to(s, a)
        $converges_to(t, b)
        =>:
            $converges_to(fn(k N) R {s(k) + t(k)}, a + b)
    thm sum_sequence_converges:
        ? forall sequence fn(index N) R:
            sequence = fn(k N) R {s(k) + t(k)}
            =>:
                $converges_to(sequence, a + b)
        claim:
            ? forall epsilon R+:
                exist N0 N st {$_is_eventually_close(sequence, a + b, epsilon, N0)}
            0 < epsilon
            0 = 0 / 2 < epsilon / 2
            epsilon / 2 $in R+
            obtain Ns from exist N0 N st {$_is_eventually_close(s, a, epsilon / 2, N0)}
            obtain Nt from exist N0 N st {$_is_eventually_close(t, b, epsilon / 2, N0)}
            0 <= Ns
            0 <= Nt
            (Ns + Nt) >= Ns
            (Ns + Nt) >= Nt
            witness exist N0 N st {$_is_eventually_close(sequence, a + b, epsilon, N0)} from (Ns + Nt):
                claim:
                    ? forall n N:
                        n >= (Ns + Nt)
                        =>:
                            abs(sequence(n) - (a + b)) < epsilon
                    n >= (Ns + Nt) >= Ns
                    n >= (Ns + Nt) >= Nt
                    abs(s(n) - a) < epsilon / 2
                    abs(t(n) - b) < epsilon / 2
                    sequence(n) = s(n) + t(n)
                    thm subtract_equal_first:
                        ? forall uu, vv, ww R:
                            uu = vv
                            =>:
                                uu - ww = vv - ww
                    by thm subtract_equal_first(sequence(n), s(n) + t(n), a + b) => sequence(n) - (a + b) = (s(n) + t(n)) - (a + b)
                    (s(n) + t(n)) - (a + b) = (s(n) - a) + (t(n) - b)
                    sequence(n) - (a + b) = (s(n) + t(n)) - (a + b) = (s(n) - a) + (t(n) - b)
                    thm abs_equal:
                        ? forall u, v R:
                            u = v
                            =>:
                                abs(u) = abs(v)
                    by thm abs_equal(sequence(n) - (a + b), (s(n) - a) + (t(n) - b)) => abs(sequence(n) - (a + b)) = abs((s(n) - a) + (t(n) - b))
                    abs((s(n) - a) + (t(n) - b)) <= abs(s(n) - a) + abs(t(n) - b) < epsilon / 2 + epsilon / 2 = epsilon
                    abs(sequence(n) - (a + b)) < epsilon
                by def $_is_eventually_close(sequence, a + b, epsilon, (Ns + Nt))
        by def $converges_to(sequence, a + b)

    by thm sum_sequence_converges(fn(k N) R {s(k) + t(k)}) => $converges_to(fn(k N) R {s(k) + t(k)}, a + b)

# Source theorem convergesTo_mul_const. The always-positive scale |c| + 1
# avoids a separate zero case while still providing a sufficiently small tail.
thm converges_to_mul_const:
    ? forall s fn(n N) R, a, c R:
        $converges_to(s, a)
        =>:
            $converges_to(fn(n N) R {c * s(n)}, c * a)
    thm scaled_sequence_converges:
        ? forall sequence fn(index N) R:
            sequence = fn(n N) R {c * s(n)}
            =>:
                $converges_to(sequence, c * a)
        claim:
            ? forall epsilon R+:
                exist N0 N st {$_is_eventually_close(sequence, c * a, epsilon, N0)}
            abs(c) >= 0
            abs(c) + 1 > 0
            0 < epsilon
            0 < abs(c) + 1
            0 = 0 / (abs(c) + 1) < epsilon / (abs(c) + 1)
            epsilon / (abs(c) + 1) $in R+
            obtain N0 from exist K N st {$_is_eventually_close(s, a, epsilon / (abs(c) + 1), K)}
            witness exist K N st {$_is_eventually_close(sequence, c * a, epsilon, K)} from N0:
                claim:
                    ? forall n N:
                        n >= N0
                        =>:
                            abs(sequence(n) - c * a) < epsilon
                    abs(s(n) - a) < epsilon / (abs(c) + 1)
                    thm subtract_equal_first:
                        ? forall uu, vv, ww R:
                            uu = vv
                            =>:
                                uu - ww = vv - ww
                    thm abs_equal:
                        ? forall u, v R:
                            u = v
                            =>:
                                abs(u) = abs(v)
                    sequence(n) = c * s(n)
                    by thm subtract_equal_first(sequence(n), c * s(n), c * a) => sequence(n) - c * a = c * s(n) - c * a
                    c * s(n) - c * a = c * (s(n) - a)
                    sequence(n) - c * a = c * s(n) - c * a = c * (s(n) - a)
                    by thm abs_equal(sequence(n) - c * a, c * (s(n) - a)) => abs(sequence(n) - c * a) = abs(c * (s(n) - a))
                    abs(c * (s(n) - a)) = abs(c) * abs(s(n) - a)
                    abs(c) <= abs(c) + 1
                    abs(s(n) - a) >= 0
                    abs(c) * abs(s(n) - a) <= (abs(c) + 1) * abs(s(n) - a) < (abs(c) + 1) * (epsilon / (abs(c) + 1)) = epsilon
                    abs(sequence(n) - c * a) < epsilon
                by def $_is_eventually_close(sequence, c * a, epsilon, N0)
        by def $converges_to(sequence, c * a)

    by thm scaled_sequence_converges(fn(n N) R {c * s(n)}) => $converges_to(fn(n N) R {c * s(n)}, c * a)

# Source theorem exists_abs_le_of_convergesTo. Convergence at epsilon = 1 gives
# a tail bounded by |a| + 1 via the triangle inequality.
thm exists_abs_bound_of_converges_to:
    ? forall s fn(n N) R, a R:
        $converges_to(s, a)
        =>:
            exist N0 N, B R+ st {$_is_eventually_close(s, 0, B, N0)}
    obtain N0 from exist K N st {$_is_eventually_close(s, a, 1, K)}
    0 <= abs(a)
    0 < abs(a) + 1
    abs(a) + 1 $in R+
    witness exist K N, B R+ st {$_is_eventually_close(s, 0, B, K)} from N0, abs(a) + 1:
        claim:
            ? forall n N:
                n >= N0
                =>:
                    abs(s(n) - 0) < abs(a) + 1
            abs(s(n) - a) < 1
            abs(s(n)) = abs((s(n) - a) + a) <= abs(s(n) - a) + abs(a) < 1 + abs(a) = abs(a) + 1
            abs(s(n) - 0) = abs(s(n)) < abs(a) + 1
        by def $_is_eventually_close(s, 0, abs(a) + 1, N0)

# Source theorems aux and convergesTo_mul. A bounded-factor estimate gives
# the product limit directly; the product-with-zero case is included.
thm converges_to_mul:
    ? forall s, t fn(n N) R, a, b R:
        $converges_to(s, a)
        $converges_to(t, b)
        =>:
            $converges_to(fn(n N) R {s(n) * t(n)}, a * b)
    thm product_sequence_converges:
        ? forall sequence fn(index N) R:
            sequence = fn(n N) R {s(n) * t(n)}
            =>:
                $converges_to(sequence, a * b)
        release thm exists_abs_bound_of_converges_to(s, a)
        obtain Nb, B from exist K N, B R+ st {$_is_eventually_close(s, 0, B, K)}
        claim:
            ? forall epsilon R+:
                exist N0 N st {$_is_eventually_close(sequence, a * b, epsilon, N0)}
            0 <= abs(b)
            0 < B
            0 < B + abs(b) + 1
            0 < epsilon
            0 = 0 / (B + abs(b) + 1) < epsilon / (B + abs(b) + 1)
            have delta R+ = epsilon / (B + abs(b) + 1)
            obtain Ns from exist K N st {$_is_eventually_close(s, a, delta, K)}
            obtain Nt from exist K N st {$_is_eventually_close(t, b, delta, K)}
            witness exist K N st {$_is_eventually_close(sequence, a * b, epsilon, K)} from Nb + Ns + Nt:
                claim:
                    ? forall n N:
                        n >= Nb + Ns + Nt
                        =>:
                            abs(sequence(n) - a * b) < epsilon
                    n >= Nb + Ns + Nt >= Nb
                    n >= Nb + Ns + Nt >= Ns
                    n >= Nb + Ns + Nt >= Nt
                    abs(s(n) - 0) < B
                    abs(s(n)) = abs(s(n) - 0) < B
                    abs(s(n) - a) < delta
                    abs(t(n) - b) < delta
                    sequence(n) = s(n) * t(n)
                    thm subtract_equal:
                        ? forall left, right, value R:
                            left = right
                            =>:
                                left - value = right - value
                    thm abs_equal:
                        ? forall left, right R:
                            left = right
                            =>:
                                abs(left) = abs(right)
                    by thm subtract_equal(sequence(n), s(n) * t(n), a * b) => sequence(n) - a * b = s(n) * t(n) - a * b
                    s(n) * t(n) - a * b = s(n) * (t(n) - b) + b * (s(n) - a)
                    by thm abs_equal(sequence(n) - a * b, s(n) * (t(n) - b) + b * (s(n) - a)) => abs(sequence(n) - a * b) = abs(s(n) * (t(n) - b) + b * (s(n) - a))
                    abs(s(n) * (t(n) - b) + b * (s(n) - a)) <= abs(s(n) * (t(n) - b)) + abs(b * (s(n) - a))
                    abs(s(n) * (t(n) - b)) = abs(s(n)) * abs(t(n) - b)
                    abs(b * (s(n) - a)) = abs(b) * abs(s(n) - a)
                    0 <= abs(t(n) - b)
                    0 <= abs(s(n) - a)
                    abs(s(n)) <= B
                    abs(s(n)) * abs(t(n) - b) <= B * abs(t(n) - b) < B * delta
                    abs(b) * abs(s(n) - a) <= abs(b) * delta
                    0 < delta
                    B + abs(b) < B + abs(b) + 1
                    (B + abs(b)) * delta < (B + abs(b) + 1) * delta
                    B + abs(b) + 1 != 0
                    delta = epsilon / (B + abs(b) + 1)
                    (B + abs(b) + 1) * delta = (B + abs(b) + 1) * (epsilon / (B + abs(b) + 1)) = epsilon
                    abs(sequence(n) - a * b) = abs(s(n) * (t(n) - b) + b * (s(n) - a)) <= abs(s(n) * (t(n) - b)) + abs(b * (s(n) - a)) = abs(s(n)) * abs(t(n) - b) + abs(b) * abs(s(n) - a) < B * delta + abs(b) * delta = (B + abs(b)) * delta < (B + abs(b) + 1) * delta = epsilon
                by def $_is_eventually_close(sequence, a * b, epsilon, Nb + Ns + Nt)
        by def $converges_to(sequence, a * b)
    by thm product_sequence_converges(fn(n N) R {s(n) * t(n)}) => $converges_to(fn(n N) R {s(n) * t(n)}, a * b)
# Source theorem convergesTo_unique. A common cutoff places the same sequence
# value within half of |a-b| of both proposed limits.
thm converges_to_unique:
    ? forall s fn(n N) R, a, b R:
        $converges_to(s, a)
        $converges_to(s, b)
        =>:
            a = b
    thm limits_cannot_be_increasing:
        ? forall sequence fn(n N) R, u, v R:
            $converges_to(sequence, u)
            $converges_to(sequence, v)
            =>:
                not u < v
        by contra:
            ? not u < v
            u < v
            0 = u - u < v - u
            0 = 0 / 2 < (v - u) / 2
            have epsilon R+ = (v - u) / 2
            obtain Nu from exist K N st {$_is_eventually_close(sequence, u, epsilon, K)}
            obtain Nv from exist K N st {$_is_eventually_close(sequence, v, epsilon, K)}
            have cutoff N = Nu + Nv
            0 <= Nu
            0 <= Nv
            cutoff >= Nu
            cutoff >= Nv
            abs(sequence(cutoff) - u) < epsilon
            abs(sequence(cutoff) - v) < epsilon
            release thm abs_lt_forward(sequence(cutoff) - u, epsilon)
            release thm abs_lt_forward(sequence(cutoff) - v, epsilon)
            v - epsilon = (-epsilon) + v < (sequence(cutoff) - v) + v = sequence(cutoff)
            sequence(cutoff) = (sequence(cutoff) - u) + u < epsilon + u = (v - u) / 2 + u = v - (v - u) / 2 = v - epsilon
            v - epsilon < v - epsilon
            v - epsilon != v - epsilon
            impossible v - epsilon != v - epsilon
    release thm limits_cannot_be_increasing(s, a, b)
    release thm limits_cannot_be_increasing(s, b, a)
    by contra:
        ? a = b
        a != b
        by cases:
            ? a = b
            case a < b:
                impossible not a < b
            case a >= b:
                by contra:
                    ? b < a
                    a <= b
                    a = b
                    impossible a != b
                impossible not b < a
        impossible a != b

# Source definition ConvergesTo'. The index carrier is arbitrary, while its
# LinearOrder instance is represented by an explicit linear-order relation.
# The tail condition reads i0 <= idx as membership of (i0,idx) in that relation.
prop _is_eventually_close_by_relation(I set, le_rel power_set(cart(I, I)), s fn(idx I) R, a R, epsilon R+, i0 I):
    forall idx I:
        $order_holds(I, le_rel, i0, idx)
        =>:
            abs(s(idx) - a) < epsilon

prop converges_to_by_relation(I set, le_rel \LinearOrder<I>, s fn(idx I) R, a R):
    forall epsilon R+:
        exist i0 I st {$_is_eventually_close_by_relation(I, le_rel, s, a, epsilon, i0)}
