# Adapted from Mathematics in Lean; rewritten in Litex. See NOTICE.md.
# Chapter 4 — Sets and Functions
# Independent MIL-derived Litex pressure-test corpus; see README for scope,
# attribution, and checked/deferred status.

# This chapter keeps the mathematical interfaces from Mathematics in Lean and
# omits repeated Lean tactic demonstrations. Sets use Litex's builtin carriers
# and set builders; functions keep their domains and codomains explicit.

# ---------------------------------------------------------------------------
# Section 4.1 — Sets
# ---------------------------------------------------------------------------

# Source definition `evens`. A natural number belongs to this set exactly when
# Chapter 1's existential parity relation supplies a factor of two.
have evens power_set(N) = {n N: $chap1::even(n)}

# Source definition `odds`. The source presents this as the complement of the
# even naturals, so the definition retains that logical form.
have odds power_set(N) = {n N: not $chap1::even(n)}

# Litex's native prime predicate uses the same trial-division characterization
# as this chapter's source-facing definition.

# Source definition `primes`. Primality already forces positivity, so the
# carrier is N+.
have primes power_set(N+) = {p N+: $prime(p)}

# ---------------------------------------------------------------------------
# Section 4.2 — Functions
# ---------------------------------------------------------------------------

# Injectivity, surjectivity, and bijectivity use Litex's native
# `$injective`, `$surjective`, and `$bijective` predicates.

# This relation records that a particular target has at least one preimage. It
# is the condition used by the source's total chosen inverse.
prop has_preimage(S, T set, f fn(x S) T, y T):
    exist x S st {f(x) = y}

# A total inverse inverts target values which have a preimage and returns the
# displayed default outside the range.
prop is_total_inverse(S nonempty_set, T set, default S, f fn(x S) T, inverse fn(y T) S):
    forall y T:
        $has_preimage(S, T, f, y)
        =>:
            f(inverse(y)) = y
    forall y T:
        not $has_preimage(S, T, f, y)
        =>:
            inverse(y) = default

# For each target, include its preimages; when there are none, include the
# default. This single set-builder is the choice-with-default fiber.
prop is_default_inverse_fiber_member(S nonempty_set, T set, default S, f fn(x S) T, y T, x S):
    not $has_preimage(S, T, f, y)
    x = default

prop inverse_fiber_member(S nonempty_set, T set, default S, f fn(x S) T, y T, x S):
    f(x) = y or $is_default_inverse_fiber_member(S, T, default, f, y, x)

template<S nonempty_set, T set, default S, f fn(x S) T>:
    have fn inverse_fiber(y T) power_set(S) = {x S: $inverse_fiber_member(S, T, default, f, y, x)}

prop is_inverse_fiber(S nonempty_set, T set, default S, f fn(x S) T, A power_set(S)):
    exist y T st {A = \inverse_fiber<S, T, default, f>(y)}

template<S nonempty_set, T set, default S, f fn(x S) T>:
    have inverse_fiber_family power_set(power_set(S)) = {A power_set(S): $is_inverse_fiber(S, T, default, f, A)}

thm inverse_fiber_nonempty:
    ? forall S nonempty_set, T set, default S, f fn(x S) T, y T:
        $is_nonempty_set(\inverse_fiber<S, T, default, f>(y))
    \inverse_fiber<S, T, default, f> = fn(u T) power_set(S) {{x S: $inverse_fiber_member(S, T, default, f, u, x)}}
    by cases:
        ? $is_nonempty_set(\inverse_fiber<S, T, default, f>(y))
        case $has_preimage(S, T, f, y):
            obtain source_input from $has_preimage(S, T, f, y)
            f(source_input) = y or $is_default_inverse_fiber_member(S, T, default, f, y, source_input)
            by def $inverse_fiber_member(S, T, default, f, y, source_input)
            release thm set_builder_member(source_input, {x S: $inverse_fiber_member(S, T, default, f, y, x)})
            source_input $in {x S: $inverse_fiber_member(S, T, default, f, y, x)}
            \inverse_fiber<S, T, default, f>(y) = {x S: $inverse_fiber_member(S, T, default, f, y, x)}
            source_input $in \inverse_fiber<S, T, default, f>(y)
            witness $is_nonempty_set(\inverse_fiber<S, T, default, f>(y)) from source_input
        case not $has_preimage(S, T, f, y):
            default = default
            by def $is_default_inverse_fiber_member(S, T, default, f, y, default)
            f(default) = y or $is_default_inverse_fiber_member(S, T, default, f, y, default)
            by def $inverse_fiber_member(S, T, default, f, y, default)
            release thm set_builder_member(default, {x S: $inverse_fiber_member(S, T, default, f, y, x)})
            default $in {x S: $inverse_fiber_member(S, T, default, f, y, x)}
            \inverse_fiber<S, T, default, f>(y) = {x S: $inverse_fiber_member(S, T, default, f, y, x)}
            default $in \inverse_fiber<S, T, default, f>(y)
            witness $is_nonempty_set(\inverse_fiber<S, T, default, f>(y)) from default

# Apply choice to the family of nonempty choice-with-default fibers and compose
# the resulting selector with y |-> inverse_fiber(y).
thm total_inverse_exists:
    ? forall S nonempty_set, T set, default S, f fn(x S) T:
        exist inverse fn(y T) S st {$is_total_inverse(S, T, default, f, inverse)}
    \inverse_fiber<S, T, default, f> = fn(u T) power_set(S) {{x S: $inverse_fiber_member(S, T, default, f, u, x)}}
    \inverse_fiber_family<S, T, default, f> = {B power_set(S): $is_inverse_fiber(S, T, default, f, B)}
    claim:
        ? forall A \inverse_fiber_family<S, T, default, f>:
            $is_nonempty_set(A)
        A $in {B power_set(S): $is_inverse_fiber(S, T, default, f, B)}
        by def $is_inverse_fiber(S, T, default, f, A)
        obtain y from $is_inverse_fiber(S, T, default, f, A)
        release thm inverse_fiber_nonempty(S, T, default, f, y)
        $is_nonempty_set(\inverse_fiber<S, T, default, f>(y))
    release axiom_of_choice: set \inverse_fiber_family<S, T, default, f>:
        forall A \inverse_fiber_family<S, T, default, f>:
            $is_nonempty_set(A)
    obtain chooser from exist c fn(A \inverse_fiber_family<S, T, default, f>) family_union(\inverse_fiber_family<S, T, default, f>) st {$is_choice_function_for(\inverse_fiber_family<S, T, default, f>, \inverse_fiber_family<S, T, default, f>, fn(A \inverse_fiber_family<S, T, default, f>) \inverse_fiber_family<S, T, default, f> {A}, c)}
    thm chooser_mem:
        ? forall A \inverse_fiber_family<S, T, default, f>:
            chooser(A) $in A
        chooser(A) $in fn(B \inverse_fiber_family<S, T, default, f>) \inverse_fiber_family<S, T, default, f> {B}(A)
        fn(B \inverse_fiber_family<S, T, default, f>) \inverse_fiber_family<S, T, default, f> {B}(A) = A
    claim:
        ? forall y T:
            \inverse_fiber<S, T, default, f>(y) $in \inverse_fiber_family<S, T, default, f>
        witness $is_inverse_fiber(S, T, default, f, \inverse_fiber<S, T, default, f>(y)) from y
        release thm set_builder_member(\inverse_fiber<S, T, default, f>(y), {A power_set(S): $is_inverse_fiber(S, T, default, f, A)})
        \inverse_fiber<S, T, default, f>(y) $in {A power_set(S): $is_inverse_fiber(S, T, default, f, A)}
        \inverse_fiber_family<S, T, default, f> = {A power_set(S): $is_inverse_fiber(S, T, default, f, A)}
    claim:
        ? forall y T:
            chooser(\inverse_fiber<S, T, default, f>(y)) $in \inverse_fiber<S, T, default, f>(y)
        release thm chooser_mem(\inverse_fiber<S, T, default, f>(y))
    claim:
        ? forall y T:
            chooser(\inverse_fiber<S, T, default, f>(y)) $in S
        chooser(\inverse_fiber<S, T, default, f>(y)) $in \inverse_fiber<S, T, default, f>(y)
        \inverse_fiber<S, T, default, f>(y) = {x S: $inverse_fiber_member(S, T, default, f, y, x)}
        by thm chap2::transport_membership(\inverse_fiber<S, T, default, f>(y), {x S: $inverse_fiber_member(S, T, default, f, y, x)}, chooser(\inverse_fiber<S, T, default, f>(y))) => chooser(\inverse_fiber<S, T, default, f>(y)) $in {x S: $inverse_fiber_member(S, T, default, f, y, x)}
    claim:
        ? forall y T:
            $has_preimage(S, T, f, y)
            =>:
                f(chooser(\inverse_fiber<S, T, default, f>(y))) = y
        chooser(\inverse_fiber<S, T, default, f>(y)) $in \inverse_fiber<S, T, default, f>(y)
        \inverse_fiber<S, T, default, f>(y) = {x S: $inverse_fiber_member(S, T, default, f, y, x)}
        by thm chap2::transport_membership(\inverse_fiber<S, T, default, f>(y), {x S: $inverse_fiber_member(S, T, default, f, y, x)}, chooser(\inverse_fiber<S, T, default, f>(y))) => chooser(\inverse_fiber<S, T, default, f>(y)) $in {x S: $inverse_fiber_member(S, T, default, f, y, x)}
        by def $inverse_fiber_member(S, T, default, f, y, chooser(\inverse_fiber<S, T, default, f>(y)))
        by cases:
            ? f(chooser(\inverse_fiber<S, T, default, f>(y))) = y
            case f(chooser(\inverse_fiber<S, T, default, f>(y))) = y:
                f(chooser(\inverse_fiber<S, T, default, f>(y))) = y
            case $is_default_inverse_fiber_member(S, T, default, f, y, chooser(\inverse_fiber<S, T, default, f>(y))):
                by def $is_default_inverse_fiber_member(S, T, default, f, y, chooser(\inverse_fiber<S, T, default, f>(y)))
                impossible $has_preimage(S, T, f, y)
    claim:
        ? forall y T:
            not $has_preimage(S, T, f, y)
            =>:
                chooser(\inverse_fiber<S, T, default, f>(y)) = default
        chooser(\inverse_fiber<S, T, default, f>(y)) $in \inverse_fiber<S, T, default, f>(y)
        \inverse_fiber<S, T, default, f>(y) = {x S: $inverse_fiber_member(S, T, default, f, y, x)}
        by thm chap2::transport_membership(\inverse_fiber<S, T, default, f>(y), {x S: $inverse_fiber_member(S, T, default, f, y, x)}, chooser(\inverse_fiber<S, T, default, f>(y))) => chooser(\inverse_fiber<S, T, default, f>(y)) $in {x S: $inverse_fiber_member(S, T, default, f, y, x)}
        by def $inverse_fiber_member(S, T, default, f, y, chooser(\inverse_fiber<S, T, default, f>(y)))
        by cases:
            ? chooser(\inverse_fiber<S, T, default, f>(y)) = default
            case f(chooser(\inverse_fiber<S, T, default, f>(y))) = y:
                witness $has_preimage(S, T, f, y) from chooser(\inverse_fiber<S, T, default, f>(y))
                impossible not $has_preimage(S, T, f, y)
            case $is_default_inverse_fiber_member(S, T, default, f, y, chooser(\inverse_fiber<S, T, default, f>(y))):
                by def $is_default_inverse_fiber_member(S, T, default, f, y, chooser(\inverse_fiber<S, T, default, f>(y)))
                chooser(\inverse_fiber<S, T, default, f>(y)) = default
    have fn chosen_inverse(y T) S = chooser(\inverse_fiber<S, T, default, f>(y))
    claim:
        ? $is_total_inverse(S, T, default, f, chosen_inverse)
        claim:
            ? forall y T:
                $has_preimage(S, T, f, y)
                =>:
                    f(chosen_inverse(y)) = y
            chosen_inverse(y) = chooser(\inverse_fiber<S, T, default, f>(y))
            f(chosen_inverse(y)) = f(chooser(\inverse_fiber<S, T, default, f>(y))) = y
        claim:
            ? forall y T:
                not $has_preimage(S, T, f, y)
                =>:
                    chosen_inverse(y) = default
            chosen_inverse(y) = chooser(\inverse_fiber<S, T, default, f>(y)) = default
        by def $is_total_inverse(S, T, default, f, chosen_inverse)
    witness exist inverse fn(y T) S st {$is_total_inverse(S, T, default, f, inverse)} from chosen_inverse

# Package existence as a constraint so the selected inverse can be used as a
# stable callable object in later source theorems.
prop has_total_inverse(S nonempty_set, T set, default S, f fn(x S) T):
    exist inverse fn(y T) S st {$is_total_inverse(S, T, default, f, inverse)}

thm total_inverse_available:
    ? forall S nonempty_set, T set, default S, f fn(x S) T:
        $has_total_inverse(S, T, default, f)
    release thm total_inverse_exists(S, T, default, f)
    by def:
        ? $has_total_inverse(S, T, default, f)

template<S nonempty_set, T set, default S, f fn(x S) T: $has_total_inverse(S, T, default, f)>:
    obtain inverse from $has_total_inverse(S, T, default, f)

thm total_inverse_spec:
    ? forall S nonempty_set, T set, default S, f fn(x S) T, g fn(y T) S, y T:
        $is_total_inverse(S, T, default, f, g)
        $has_preimage(S, T, f, y)
        =>:
            f(g(y)) = y

thm total_inverse_default:
    ? forall S nonempty_set, T set, default S, f fn(x S) T, g fn(y T) S, y T:
        $is_total_inverse(S, T, default, f, g)
        not $has_preimage(S, T, f, y)
        =>:
            g(y) = default

thm inverse_spec:
    ? forall S nonempty_set, T set, default S, f fn(x S) T, y T:
        $has_preimage(S, T, f, y)
        =>:
            f(\inverse<S, T, default, f>(y)) = y
    release thm total_inverse_available(S, T, default, f)
    $has_total_inverse(S, T, default, f)
    $is_total_inverse(S, T, default, f, \inverse<S, T, default, f>)
    release thm total_inverse_spec(S, T, default, f, \inverse<S, T, default, f>, y)

thm inverse_eq_default_of_no_preimage:
    ? forall S nonempty_set, T set, default S, f fn(x S) T, y T:
        not $has_preimage(S, T, f, y)
        =>:
            \inverse<S, T, default, f>(y) = default
    release thm total_inverse_available(S, T, default, f)
    $has_total_inverse(S, T, default, f)
    $is_total_inverse(S, T, default, f, \inverse<S, T, default, f>)
    release thm total_inverse_default(S, T, default, f, \inverse<S, T, default, f>, y)

prop is_left_inverse(S, T set, f fn(x S) T, g fn(y T) S):
    forall x S:
        g(f(x)) = x

prop is_right_inverse(S, T set, f fn(x S) T, g fn(y T) S):
    forall y T:
        f(g(y)) = y

thm inverse_left_of_injective:
    ? forall S nonempty_set, T set, default S, f fn(x S) T:
        $injective(S, T, f)
        =>:
            $is_left_inverse(S, T, f, \inverse<S, T, default, f>)
    release thm total_inverse_available(S, T, default, f)
    claim:
        ? forall x S:
            \inverse<S, T, default, f>(f(x)) = x
        witness $has_preimage(S, T, f, f(x)) from x
        release thm inverse_spec(S, T, default, f, f(x))
        f(\inverse<S, T, default, f>(f(x))) = f(x)
    by def:
        ? $is_left_inverse(S, T, f, \inverse<S, T, default, f>)

thm injective_of_left_inverse:
    ? forall S, T set, f fn(x S) T, g fn(y T) S:
        $is_left_inverse(S, T, f, g)
        =>:
            $injective(S, T, f)
    claim:
        ? forall x1, x2 S:
            f(x1) = f(x2)
            =>:
                x1 = x2
        g(f(x1)) = g(f(x2))
        g(f(x1)) = x1
        g(f(x2)) = x2
    by def:
        ? $injective(S, T, f)

thm inverse_right_of_surjective:
    ? forall S nonempty_set, T set, default S, f fn(x S) T:
        $surjective(S, T, f)
        =>:
            $is_right_inverse(S, T, f, \inverse<S, T, default, f>)
    release thm total_inverse_available(S, T, default, f)
    claim:
        ? forall y T:
            f(\inverse<S, T, default, f>(y)) = y
        obtain x from exist z S st {y = f(z)}
        witness $has_preimage(S, T, f, y) from x
        release thm inverse_spec(S, T, default, f, y)
    by def:
        ? $is_right_inverse(S, T, f, \inverse<S, T, default, f>)

thm surjective_of_right_inverse:
    ? forall S, T set, f fn(x S) T, g fn(y T) S:
        $is_right_inverse(S, T, f, g)
        =>:
            $surjective(S, T, f)
    claim:
        ? forall y T:
            exist x S st {y = f(x)}
        witness exist x S st {y = f(x)} from g(y)
    by def:
        ? $surjective(S, T, f)

thm injective_iff_inverse_left_forward:
    ? forall S nonempty_set, T set, default S, f fn(x S) T:
        $injective(S, T, f)
        =>:
            $is_left_inverse(S, T, f, \inverse<S, T, default, f>)
    release thm inverse_left_of_injective(S, T, default, f)

thm surjective_iff_inverse_right_forward:
    ? forall S nonempty_set, T set, default S, f fn(x S) T:
        $surjective(S, T, f)
        =>:
            $is_right_inverse(S, T, f, \inverse<S, T, default, f>)
    release thm inverse_right_of_surjective(S, T, default, f)

# Restricted images are used throughout the source and in the
# Schröder-Bernstein construction. Litex natively expresses this as the range
# of the function whose domain has been restricted to A.
claim:
    ? forall S, T set, f fn(x S) T, A power_set(S):
        fn_range(fn(x A) T {f(x)}) $in power_set(T)
    claim:
        ? forall y fn_range(fn(x A) T {f(x)}):
            y $in T
        have by fn_preimage: source from y $in fn_range(fn(x A) T {f(x)})
    by def fn_range(fn(x A) T {f(x)}) $subset T
    fn_range(fn(x A) T {f(x)}) $in power_set(T)

template<S, T set, f fn(x S) T, A power_set(S)>:
    have set_image power_set(T) = fn_range(fn(x A) T {f(x)})

template<S, T set, f fn(x S) T>:
    have fn set_preimage(B power_set(T)) power_set(S) = preimage_set(f, B)

# Binary intersection, union, and difference use Litex's native `intersect`,
# `union`, and `set_minus` objects. The source-facing theorems below remain
# explicit because they describe image/preimage mathematics rather than rebuild
# the language's set interface.

prop image_preimage_adjunction(S, T set, f fn(x S) T, A power_set(S), B power_set(T)):
    not \set_image<S, T, f, A> $subset B or A $subset preimage_set(f, B)
    not A $subset preimage_set(f, B) or \set_image<S, T, f, A> $subset B

prop injective_on(S, T set, f fn(x S) T, A power_set(S)):
    forall x1, x2 A:
        f(x1) = f(x2)
        =>:
            x1 = x2

# Indexed unions and intersections are native objects. Their explicit ambient
# set supplies the carrier and fixes the empty-index intersection.

template<I, S, T set, f fn(x S) T, A fn(index I) power_set(S)>:
    have fn indexed_images(index I) power_set(T) = \set_image<S, T, f, A(index)>

# MIL low-prerequisite item: preimages preserve binary intersections.
thm set_preimage_intersection:
    ? forall S, T set, f fn(x S) T, U, V power_set(T):
        preimage_set(f, intersect(U, V)) = intersect(preimage_set(f, U), preimage_set(f, V))
    claim:
        ? forall x preimage_set(f, intersect(U, V)):
            x $in intersect(preimage_set(f, U), preimage_set(f, V))
        f(x) $in intersect(U, V)
        f(x) $in U
        f(x) $in V
        x $in preimage_set(f, U)
        x $in preimage_set(f, V)
    by def preimage_set(f, intersect(U, V)) $subset intersect(preimage_set(f, U), preimage_set(f, V))
    claim:
        ? forall x intersect(preimage_set(f, U), preimage_set(f, V)):
            x $in preimage_set(f, intersect(U, V))
        x $in preimage_set(f, U)
        x $in preimage_set(f, V)
        f(x) $in U
        f(x) $in V
        f(x) $in intersect(U, V)
    by def intersect(preimage_set(f, U), preimage_set(f, V)) $subset preimage_set(f, intersect(U, V))
    by extension preimage_set(f, intersect(U, V)) = intersect(preimage_set(f, U), preimage_set(f, V))

# Images preserve binary unions.
thm set_image_union:
    ? forall S, T set, f fn(x S) T, A, B power_set(S):
        \set_image<S, T, f, union(A, B)> = union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    union(A, B) $subset S
    claim:
        ? \set_image<S, T, f, union(A, B)> $subset union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
        claim:
            ? forall x \set_image<S, T, f, union(A, B)>:
                x $in union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
            \set_image<S, T, f, union(A, B)> = fn_range(fn(z union(A, B)) T {f(z)})
            by thm chap2::transport_membership(\set_image<S, T, f, union(A, B)>, fn_range(fn(z union(A, B)) T {f(z)}), x) => x $in fn_range(fn(z union(A, B)) T {f(z)})
            have by fn_preimage: pre from x $in fn_range(fn(z union(A, B)) T {f(z)})
            fn(z union(A, B)) T {f(z)}(pre) = f(pre)
            f(pre) = x
            pre $in A or pre $in B
            by cases:
                ? x $in union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
                case pre $in A:
                    fn(z A) T {f(z)}(pre) = f(pre) = x
                    fn(z A) T {f(z)}(pre) $in fn_range(fn(z A) T {f(z)})
                    by thm equal_element_member(fn_range(fn(z A) T {f(z)}), T, fn(z A) T {f(z)}(pre), x) => x $in fn_range(fn(z A) T {f(z)})
                    \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
                    by thm chap2::transport_membership(fn_range(fn(z A) T {f(z)}), \set_image<S, T, f, A>, x) => x $in \set_image<S, T, f, A>
                    x $in union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
                case pre $in B:
                    fn(z B) T {f(z)}(pre) = f(pre) = x
                    fn(z B) T {f(z)}(pre) $in fn_range(fn(z B) T {f(z)})
                    by thm equal_element_member(fn_range(fn(z B) T {f(z)}), T, fn(z B) T {f(z)}(pre), x) => x $in fn_range(fn(z B) T {f(z)})
                    \set_image<S, T, f, B> = fn_range(fn(z B) T {f(z)})
                    by thm chap2::transport_membership(fn_range(fn(z B) T {f(z)}), \set_image<S, T, f, B>, x) => x $in \set_image<S, T, f, B>
                    x $in union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
        by def:
            ? \set_image<S, T, f, union(A, B)> $subset union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
    claim:
        ? union(\set_image<S, T, f, A>, \set_image<S, T, f, B>) $subset \set_image<S, T, f, union(A, B)>
        claim:
            ? forall x union(\set_image<S, T, f, A>, \set_image<S, T, f, B>):
                x $in \set_image<S, T, f, union(A, B)>
            x $in \set_image<S, T, f, A> or x $in \set_image<S, T, f, B>
            by cases:
                ? x $in \set_image<S, T, f, union(A, B)>
                case x $in \set_image<S, T, f, A>:
                    \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
                    by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), x) => x $in fn_range(fn(z A) T {f(z)})
                    have by fn_preimage: pre from x $in fn_range(fn(z A) T {f(z)})
                    fn(z A) T {f(z)}(pre) = f(pre)
                    f(pre) = x
                    pre $in union(A, B)
                    fn(z union(A, B)) T {f(z)}(pre) = f(pre) = x
                    fn(z union(A, B)) T {f(z)}(pre) $in fn_range(fn(z union(A, B)) T {f(z)})
                    by thm equal_element_member(fn_range(fn(z union(A, B)) T {f(z)}), T, fn(z union(A, B)) T {f(z)}(pre), x) => x $in fn_range(fn(z union(A, B)) T {f(z)})
                    \set_image<S, T, f, union(A, B)> = fn_range(fn(z union(A, B)) T {f(z)})
                    by thm chap2::transport_membership(fn_range(fn(z union(A, B)) T {f(z)}), \set_image<S, T, f, union(A, B)>, x) => x $in \set_image<S, T, f, union(A, B)>
                case x $in \set_image<S, T, f, B>:
                    \set_image<S, T, f, B> = fn_range(fn(z B) T {f(z)})
                    by thm chap2::transport_membership(\set_image<S, T, f, B>, fn_range(fn(z B) T {f(z)}), x) => x $in fn_range(fn(z B) T {f(z)})
                    have by fn_preimage: pre from x $in fn_range(fn(z B) T {f(z)})
                    fn(z B) T {f(z)}(pre) = f(pre)
                    f(pre) = x
                    pre $in union(A, B)
                    fn(z union(A, B)) T {f(z)}(pre) = f(pre) = x
                    fn(z union(A, B)) T {f(z)}(pre) $in fn_range(fn(z union(A, B)) T {f(z)})
                    by thm equal_element_member(fn_range(fn(z union(A, B)) T {f(z)}), T, fn(z union(A, B)) T {f(z)}(pre), x) => x $in fn_range(fn(z union(A, B)) T {f(z)})
                    \set_image<S, T, f, union(A, B)> = fn_range(fn(z union(A, B)) T {f(z)})
                    by thm chap2::transport_membership(fn_range(fn(z union(A, B)) T {f(z)}), \set_image<S, T, f, union(A, B)>, x) => x $in \set_image<S, T, f, union(A, B)>
        by def:
            ? union(\set_image<S, T, f, A>, \set_image<S, T, f, B>) $subset \set_image<S, T, f, union(A, B)>
    by extension:
        ? \set_image<S, T, f, union(A, B)> = union(\set_image<S, T, f, A>, \set_image<S, T, f, B>)

# Every set lies in the preimage of its image.
thm subset_preimage_image:
    ? forall S, T set, f fn(x S) T, A power_set(S):
        A $subset preimage_set(f, \set_image<S, T, f, A>)
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    claim:
        ? forall x A:
            x $in preimage_set(f, \set_image<S, T, f, A>)
        A $subset S
        x $in S
        fn(z A) T {f(z)}(x) = f(x)
        fn(z A) T {f(z)}(x) $in fn_range(fn(z A) T {f(z)})
        \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
        by thm equal_element_member(fn_range(fn(z A) T {f(z)}), T, fn(z A) T {f(z)}(x), f(x)) => f(x) $in fn_range(fn(z A) T {f(z)})
        by thm chap2::transport_membership(fn_range(fn(z A) T {f(z)}), \set_image<S, T, f, A>, f(x)) => f(x) $in \set_image<S, T, f, A>
        x $in preimage_set(f, \set_image<S, T, f, A>)
    by def:
        ? A $subset preimage_set(f, \set_image<S, T, f, A>)

# Image/preimage inclusion is the standard set-map adjunction.
thm image_subset_iff_subset_preimage:
    ? forall S, T set, f fn(x S) T, A power_set(S), B power_set(T):
        $image_preimage_adjunction(S, T, f, A, B)
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    claim:
        ? not \set_image<S, T, f, A> $subset B or A $subset preimage_set(f, B)
        \set_image<S, T, f, A> $subset B or not \set_image<S, T, f, A> $subset B
        by cases:
            ? not \set_image<S, T, f, A> $subset B or A $subset preimage_set(f, B)
            case not \set_image<S, T, f, A> $subset B:
                not \set_image<S, T, f, A> $subset B or A $subset preimage_set(f, B)
            case \set_image<S, T, f, A> $subset B:
                claim:
                    ? forall x A:
                        x $in preimage_set(f, B)
                    A $subset S
                    x $in S
                    fn(z A) T {f(z)}(x) = f(x)
                    fn(z A) T {f(z)}(x) $in fn_range(fn(z A) T {f(z)})
                    \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
                    by thm equal_element_member(fn_range(fn(z A) T {f(z)}), T, fn(z A) T {f(z)}(x), f(x)) => f(x) $in fn_range(fn(z A) T {f(z)})
                    by thm chap2::transport_membership(fn_range(fn(z A) T {f(z)}), \set_image<S, T, f, A>, f(x)) => f(x) $in \set_image<S, T, f, A>
                    f(x) $in B
                    x $in preimage_set(f, B)
                A $subset preimage_set(f, B)
                not \set_image<S, T, f, A> $subset B or A $subset preimage_set(f, B)
    claim:
        ? not A $subset preimage_set(f, B) or \set_image<S, T, f, A> $subset B
        A $subset preimage_set(f, B) or not A $subset preimage_set(f, B)
        by cases:
            ? not A $subset preimage_set(f, B) or \set_image<S, T, f, A> $subset B
            case not A $subset preimage_set(f, B):
                not A $subset preimage_set(f, B) or \set_image<S, T, f, A> $subset B
            case A $subset preimage_set(f, B):
                claim:
                    ? forall y \set_image<S, T, f, A>:
                        y $in B
                    \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
                    by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), y) => y $in fn_range(fn(z A) T {f(z)})
                    have by fn_preimage: pre from y $in fn_range(fn(z A) T {f(z)})
                    fn(z A) T {f(z)}(pre) = f(pre)
                    f(pre) = y
                    pre $in preimage_set(f, B)
                    f(pre) $in B
                    y $in B
                \set_image<S, T, f, A> $subset B
                not A $subset preimage_set(f, B) or \set_image<S, T, f, A> $subset B

# An injective map recovers a set after image then preimage.
thm preimage_image_subset_of_injective:
    ? forall S, T set, f fn(x S) T, A power_set(S):
        $injective(S, T, f)
        =>:
            preimage_set(f, \set_image<S, T, f, A>) $subset A
    claim:
        ? forall x preimage_set(f, \set_image<S, T, f, A>):
            x $in A
        f(x) $in \set_image<S, T, f, A>
        \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), f(x)) => f(x) $in fn_range(fn(z A) T {f(z)})
        have by fn_preimage: pre from f(x) $in fn_range(fn(z A) T {f(z)})
        fn(z A) T {f(z)}(pre) = f(pre)
        A $subset S
        pre $in S
        f(pre) = f(x)
        f(x) = f(pre)
        x = pre
        x $in A
    by def:
        ? preimage_set(f, \set_image<S, T, f, A>) $subset A

# The image of a preimage is always contained in the target set.
thm image_preimage_subset:
    ? forall S, T set, f fn(x S) T, B power_set(T):
        \set_image<S, T, f, preimage_set(f, B)> $subset B
    preimage_set(f, B) $in power_set(S)
    preimage_set(f, B) $subset S
    claim:
        ? forall x \set_image<S, T, f, preimage_set(f, B)>:
            x $in B
        \set_image<S, T, f, preimage_set(f, B)> = fn_range(fn(z preimage_set(f, B)) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, preimage_set(f, B)>, fn_range(fn(z preimage_set(f, B)) T {f(z)}), x) => x $in fn_range(fn(z preimage_set(f, B)) T {f(z)})
        have by fn_preimage: pre from x $in fn_range(fn(z preimage_set(f, B)) T {f(z)})
        fn(z preimage_set(f, B)) T {f(z)}(pre) = f(pre)
        f(pre) = x
        f(pre) $in B
        x $in B
    by def:
        ? \set_image<S, T, f, preimage_set(f, B)> $subset B

# Surjectivity gives the reverse image-of-preimage inclusion.
thm subset_image_preimage_of_surjective:
    ? forall S, T set, f fn(x S) T, B power_set(T):
        $surjective(S, T, f)
        =>:
            B $subset \set_image<S, T, f, preimage_set(f, B)>
    claim:
        ? forall y B:
            y $in \set_image<S, T, f, preimage_set(f, B)>
        B $subset T
        y $in T
        exist x S st {y = f(x)}
        obtain pre from exist x S st {y = f(x)}
        y = f(pre)
        f(pre) = y
        f(pre) $in B
        pre $in preimage_set(f, B)
        fn(z preimage_set(f, B)) T {f(z)}(pre) = f(pre) = y
        fn(z preimage_set(f, B)) T {f(z)}(pre) $in fn_range(fn(z preimage_set(f, B)) T {f(z)})
        y $in fn_range(fn(z preimage_set(f, B)) T {f(z)})
        \set_image<S, T, f, preimage_set(f, B)> = fn_range(fn(z preimage_set(f, B)) T {f(z)})
        y $in \set_image<S, T, f, preimage_set(f, B)>
    by def:
        ? B $subset \set_image<S, T, f, preimage_set(f, B)>

# Images are monotone.
thm set_image_mono:
    ? forall S, T set, f fn(x S) T, A, B power_set(S):
        A $subset B
        =>:
            \set_image<S, T, f, A> $subset \set_image<S, T, f, B>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    claim:
        ? forall x \set_image<S, T, f, A>:
            x $in \set_image<S, T, f, B>
        \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), x) => x $in fn_range(fn(z A) T {f(z)})
        have by fn_preimage: pre from x $in fn_range(fn(z A) T {f(z)})
        fn(z A) T {f(z)}(pre) = f(pre)
        f(pre) = x
        pre $in B
        fn(z B) T {f(z)}(pre) = f(pre) = x
        fn(z B) T {f(z)}(pre) $in fn_range(fn(z B) T {f(z)})
        by thm equal_element_member(fn_range(fn(z B) T {f(z)}), T, fn(z B) T {f(z)}(pre), x) => x $in fn_range(fn(z B) T {f(z)})
        \set_image<S, T, f, B> = fn_range(fn(z B) T {f(z)})
        by thm chap2::transport_membership(fn_range(fn(z B) T {f(z)}), \set_image<S, T, f, B>, x) => x $in \set_image<S, T, f, B>
    by def:
        ? \set_image<S, T, f, A> $subset \set_image<S, T, f, B>

# Preimages are monotone.
thm set_preimage_mono:
    ? forall S, T set, f fn(x S) T, U, V power_set(T):
        U $subset V
        =>:
            preimage_set(f, U) $subset preimage_set(f, V)
    claim:
        ? forall x preimage_set(f, U):
            x $in preimage_set(f, V)
        f(x) $in U
        f(x) $in V
        x $in preimage_set(f, V)
    by def:
        ? preimage_set(f, U) $subset preimage_set(f, V)

# Preimages preserve binary unions.
thm set_preimage_union:
    ? forall S, T set, f fn(x S) T, U, V power_set(T):
        preimage_set(f, union(U, V)) = union(preimage_set(f, U), preimage_set(f, V))
    claim:
        ? preimage_set(f, union(U, V)) $subset union(preimage_set(f, U), preimage_set(f, V))
        claim:
            ? forall x preimage_set(f, union(U, V)):
                x $in union(preimage_set(f, U), preimage_set(f, V))
            f(x) $in union(U, V)
            f(x) $in U or f(x) $in V
            by cases:
                ? x $in union(preimage_set(f, U), preimage_set(f, V))
                case f(x) $in U:
                    x $in preimage_set(f, U)
                    x $in union(preimage_set(f, U), preimage_set(f, V))
                case f(x) $in V:
                    x $in preimage_set(f, V)
                    x $in union(preimage_set(f, U), preimage_set(f, V))
        by def:
            ? preimage_set(f, union(U, V)) $subset union(preimage_set(f, U), preimage_set(f, V))
    claim:
        ? union(preimage_set(f, U), preimage_set(f, V)) $subset preimage_set(f, union(U, V))
        claim:
            ? forall x union(preimage_set(f, U), preimage_set(f, V)):
                x $in preimage_set(f, union(U, V))
            x $in preimage_set(f, U) or x $in preimage_set(f, V)
            by cases:
                ? x $in preimage_set(f, union(U, V))
                case x $in preimage_set(f, U):
                    f(x) $in U
                    f(x) $in union(U, V)
                    x $in preimage_set(f, union(U, V))
                case x $in preimage_set(f, V):
                    f(x) $in V
                    f(x) $in union(U, V)
                    x $in preimage_set(f, union(U, V))
        by def:
            ? union(preimage_set(f, U), preimage_set(f, V)) $subset preimage_set(f, union(U, V))
    by extension:
        ? preimage_set(f, union(U, V)) = union(preimage_set(f, U), preimage_set(f, V))

# Images of intersections lie in the intersection of the images.
thm image_intersection_subset:
    ? forall S, T set, f fn(x S) T, A, B power_set(S):
        \set_image<S, T, f, intersect(A, B)> $subset intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
    intersect(A, B) $subset S
    intersect(A, B) $in power_set(S)
    intersect(A, B) $subset A
    intersect(A, B) $subset B
    release thm set_image_mono(S, T, f, intersect(A, B), A)
    release thm set_image_mono(S, T, f, intersect(A, B), B)
    claim:
        ? forall y \set_image<S, T, f, intersect(A, B)>:
            y $in intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
        y $in \set_image<S, T, f, A>
        y $in \set_image<S, T, f, B>
        y $in intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
    by def \set_image<S, T, f, intersect(A, B)> $subset intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>)
# Injectivity gives the reverse intersection inclusion.
thm intersection_images_subset_image_intersection:
    ? forall S, T set, f fn(x S) T, A, B power_set(S):
        $injective(S, T, f)
        =>:
            intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>) $subset \set_image<S, T, f, intersect(A, B)>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    intersect(A, B) $subset S
    intersect(A, B) $in power_set(S)
    set_minus(A, B) $subset S
    set_minus(A, B) $in power_set(S)
    claim:
        ? forall y intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>):
            y $in \set_image<S, T, f, intersect(A, B)>
        y $in \set_image<S, T, f, A>
        y $in \set_image<S, T, f, B>
        \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), y) => y $in fn_range(fn(z A) T {f(z)})
        have by fn_preimage: preA from y $in fn_range(fn(z A) T {f(z)})
        fn(z A) T {f(z)}(preA) = f(preA)
        f(preA) = y
        \set_image<S, T, f, B> = fn_range(fn(z B) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, B>, fn_range(fn(z B) T {f(z)}), y) => y $in fn_range(fn(z B) T {f(z)})
        have by fn_preimage: preB from y $in fn_range(fn(z B) T {f(z)})
        fn(z B) T {f(z)}(preB) = f(preB)
        f(preB) = y
        f(preA) = y = f(preB)
        preA $in S
        preB $in S
        preA = preB
        preA $in B
        preA $in intersect(A, B)
        fn(z intersect(A, B)) T {f(z)}(preA) = f(preA) = y
        fn(z intersect(A, B)) T {f(z)}(preA) $in fn_range(fn(z intersect(A, B)) T {f(z)})
        by thm equal_element_member(fn_range(fn(z intersect(A, B)) T {f(z)}), T, fn(z intersect(A, B)) T {f(z)}(preA), y) => y $in fn_range(fn(z intersect(A, B)) T {f(z)})
        \set_image<S, T, f, intersect(A, B)> = fn_range(fn(z intersect(A, B)) T {f(z)})
        by thm chap2::transport_membership(fn_range(fn(z intersect(A, B)) T {f(z)}), \set_image<S, T, f, intersect(A, B)>, y) => y $in \set_image<S, T, f, intersect(A, B)>
    by def:
        ? intersect(\set_image<S, T, f, A>, \set_image<S, T, f, B>) $subset \set_image<S, T, f, intersect(A, B)>

# Removing the image of B can only leave images of points outside B.
claim:
    ? forall Carrier set, Left, Right power_set(Carrier):
        set_minus(Left, Right) $in power_set(Carrier)
    claim:
        ? forall point set_minus(Left, Right):
            point $in Carrier
        point $in Left
        Left $subset Carrier
        point $in Carrier
    by def set_minus(Left, Right) $subset Carrier
    set_minus(Left, Right) $in power_set(Carrier)

thm image_difference_subset:
    ? forall S, T set, f fn(x S) T, A, B power_set(S):
        set_minus(\set_image<S, T, f, A>, \set_image<S, T, f, B>) $subset \set_image<S, T, f, set_minus(A, B)>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    intersect(A, B) $subset S
    intersect(A, B) $in power_set(S)
    set_minus(A, B) $subset S
    set_minus(A, B) $in power_set(S)
    claim:
        ? forall y set_minus(\set_image<S, T, f, A>, \set_image<S, T, f, B>):
            y $in \set_image<S, T, f, set_minus(A, B)>
        y $in \set_image<S, T, f, A>
        not y $in \set_image<S, T, f, B>
        \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), y) => y $in fn_range(fn(z A) T {f(z)})
        have by fn_preimage: pre from y $in fn_range(fn(z A) T {f(z)})
        fn(z A) T {f(z)}(pre) = f(pre)
        f(pre) = y
        claim:
            ? not pre $in B
            by contra:
                ? not pre $in B
                fn(z B) T {f(z)}(pre) = f(pre) = y
                fn(z B) T {f(z)}(pre) $in fn_range(fn(z B) T {f(z)})
                by thm equal_element_member(fn_range(fn(z B) T {f(z)}), T, fn(z B) T {f(z)}(pre), y) => y $in fn_range(fn(z B) T {f(z)})
                \set_image<S, T, f, B> = fn_range(fn(z B) T {f(z)})
                by thm chap2::transport_membership(fn_range(fn(z B) T {f(z)}), \set_image<S, T, f, B>, y) => y $in \set_image<S, T, f, B>
                impossible not y $in \set_image<S, T, f, B>
        pre $in set_minus(A, B)
        fn(z set_minus(A, B)) T {f(z)}(pre) = f(pre) = y
        fn(z set_minus(A, B)) T {f(z)}(pre) $in fn_range(fn(z set_minus(A, B)) T {f(z)})
        by thm equal_element_member(fn_range(fn(z set_minus(A, B)) T {f(z)}), T, fn(z set_minus(A, B)) T {f(z)}(pre), y) => y $in fn_range(fn(z set_minus(A, B)) T {f(z)})
        \set_image<S, T, f, set_minus(A, B)> = fn_range(fn(z set_minus(A, B)) T {f(z)})
        by thm chap2::transport_membership(fn_range(fn(z set_minus(A, B)) T {f(z)}), \set_image<S, T, f, set_minus(A, B)>, y) => y $in \set_image<S, T, f, set_minus(A, B)>
    by def:
        ? set_minus(\set_image<S, T, f, A>, \set_image<S, T, f, B>) $subset \set_image<S, T, f, set_minus(A, B)>

# Preimages preserve set difference.
thm preimage_difference_subset:
    ? forall S, T set, f fn(x S) T, U, V power_set(T):
        set_minus(preimage_set(f, U), preimage_set(f, V)) $subset preimage_set(f, set_minus(U, V))
    claim:
        ? forall x set_minus(preimage_set(f, U), preimage_set(f, V)):
            x $in preimage_set(f, set_minus(U, V))
        x $in preimage_set(f, U)
        not x $in preimage_set(f, V)
        f(x) $in U
        claim:
            ? not f(x) $in V
            by contra:
                ? not f(x) $in V
                x $in preimage_set(f, V)
                impossible not x $in preimage_set(f, V)
        f(x) $in set_minus(U, V)
        x $in preimage_set(f, set_minus(U, V))
    by def:
        ? set_minus(preimage_set(f, U), preimage_set(f, V)) $subset preimage_set(f, set_minus(U, V))

# Intersecting an image with a target set can be pulled back to the source.
thm image_intersection_target:
    ? forall S, T set, f fn(x S) T, A power_set(S), V power_set(T):
        intersect(\set_image<S, T, f, A>, V) = \set_image<S, T, f, intersect(A, preimage_set(f, V))>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    claim:
        ? intersect(\set_image<S, T, f, A>, V) $subset \set_image<S, T, f, intersect(A, preimage_set(f, V))>
        claim:
            ? forall y intersect(\set_image<S, T, f, A>, V):
                y $in \set_image<S, T, f, intersect(A, preimage_set(f, V))>
            y $in \set_image<S, T, f, A>
            y $in V
            \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
            by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(z A) T {f(z)}), y) => y $in fn_range(fn(z A) T {f(z)})
            have by fn_preimage: pre from y $in fn_range(fn(z A) T {f(z)})
            fn(z A) T {f(z)}(pre) = f(pre)
            A $subset S
            pre $in S
            f(pre) = y
            f(pre) $in V
            pre $in preimage_set(f, V)
            pre $in intersect(A, preimage_set(f, V))
            fn(z intersect(A, preimage_set(f, V))) T {f(z)}(pre) = f(pre) = y
            fn(z intersect(A, preimage_set(f, V))) T {f(z)}(pre) $in fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)})
            by thm equal_element_member(fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)}), intersect(\set_image<S, T, f, A>, V), fn(z intersect(A, preimage_set(f, V))) T {f(z)}(pre), y) => y $in fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)})
            \set_image<S, T, f, intersect(A, preimage_set(f, V))> = fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)})
            by thm chap2::transport_membership(fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)}), \set_image<S, T, f, intersect(A, preimage_set(f, V))>, y) => y $in \set_image<S, T, f, intersect(A, preimage_set(f, V))>
        by def:
            ? intersect(\set_image<S, T, f, A>, V) $subset \set_image<S, T, f, intersect(A, preimage_set(f, V))>
    claim:
        ? \set_image<S, T, f, intersect(A, preimage_set(f, V))> $subset intersect(\set_image<S, T, f, A>, V)
        claim:
            ? forall y \set_image<S, T, f, intersect(A, preimage_set(f, V))>:
                y $in intersect(\set_image<S, T, f, A>, V)
            \set_image<S, T, f, intersect(A, preimage_set(f, V))> = fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)})
            by thm chap2::transport_membership(\set_image<S, T, f, intersect(A, preimage_set(f, V))>, fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)}), y) => y $in fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)})
            have by fn_preimage: pre from y $in fn_range(fn(z intersect(A, preimage_set(f, V))) T {f(z)})
            fn(z intersect(A, preimage_set(f, V))) T {f(z)}(pre) = f(pre)
            f(pre) = y
            pre $in A
            pre $in preimage_set(f, V)
            fn(z A) T {f(z)}(pre) = f(pre) = y
            fn(z A) T {f(z)}(pre) $in fn_range(fn(z A) T {f(z)})
            by thm equal_element_member(fn_range(fn(z A) T {f(z)}), \set_image<S, T, f, intersect(A, preimage_set(f, V))>, fn(z A) T {f(z)}(pre), y) => y $in fn_range(fn(z A) T {f(z)})
            \set_image<S, T, f, A> = fn_range(fn(z A) T {f(z)})
            by thm chap2::transport_membership(fn_range(fn(z A) T {f(z)}), \set_image<S, T, f, A>, y) => y $in \set_image<S, T, f, A>
            f(pre) $in V
            y $in V
            y $in intersect(\set_image<S, T, f, A>, V)
        by def:
            ? \set_image<S, T, f, intersect(A, preimage_set(f, V))> $subset intersect(\set_image<S, T, f, A>, V)
    by extension:
        ? intersect(\set_image<S, T, f, A>, V) = \set_image<S, T, f, intersect(A, preimage_set(f, V))>

thm image_source_intersection_preimage_subset:
    ? forall S, T set, f fn(x S) T, A power_set(S), U power_set(T):
        \set_image<S, T, f, intersect(A, preimage_set(f, U))> $subset intersect(\set_image<S, T, f, A>, U)
    release thm image_intersection_target(S, T, f, A, U)
    claim:
        ? forall y \set_image<S, T, f, intersect(A, preimage_set(f, U))>:
            y $in intersect(\set_image<S, T, f, A>, U)
        by thm chap2::transport_membership(\set_image<S, T, f, intersect(A, preimage_set(f, U))>, intersect(\set_image<S, T, f, A>, U), y) => y $in intersect(\set_image<S, T, f, A>, U)
    by def \set_image<S, T, f, intersect(A, preimage_set(f, U))> $subset intersect(\set_image<S, T, f, A>, U)

thm source_intersection_preimage_subset:
    ? forall S, T set, f fn(x S) T, A power_set(S), U power_set(T):
        intersect(A, preimage_set(f, U)) $subset preimage_set(f, intersect(\set_image<S, T, f, A>, U))
    preimage_set(f, U) $in power_set(S)
    intersect(A, preimage_set(f, U)) $subset S
    intersect(A, preimage_set(f, U)) $in power_set(S)
    \set_image<S, T, f, A> $in power_set(T)
    intersect(\set_image<S, T, f, A>, U) $subset T
    intersect(\set_image<S, T, f, A>, U) $in power_set(T)
    release thm image_source_intersection_preimage_subset(S, T, f, A, U)
    release thm image_subset_iff_subset_preimage(S, T, f, intersect(A, preimage_set(f, U)), intersect(\set_image<S, T, f, A>, U))
    not \set_image<S, T, f, intersect(A, preimage_set(f, U))> $subset intersect(\set_image<S, T, f, A>, U) or intersect(A, preimage_set(f, U)) $subset preimage_set(f, intersect(\set_image<S, T, f, A>, U))
    by cases:
        ? intersect(A, preimage_set(f, U)) $subset preimage_set(f, intersect(\set_image<S, T, f, A>, U))
        case not \set_image<S, T, f, intersect(A, preimage_set(f, U))> $subset intersect(\set_image<S, T, f, A>, U):
            impossible \set_image<S, T, f, intersect(A, preimage_set(f, U))> $subset intersect(\set_image<S, T, f, A>, U)
        case intersect(A, preimage_set(f, U)) $subset preimage_set(f, intersect(\set_image<S, T, f, A>, U)):
            intersect(A, preimage_set(f, U)) $subset preimage_set(f, intersect(\set_image<S, T, f, A>, U))

claim:
    ? forall Carrier set, Left, Right power_set(Carrier):
        union(Left, Right) $in power_set(Carrier)
    Left $subset Carrier
    Right $subset Carrier
    union(Left, Right) $subset Carrier
    union(Left, Right) $in power_set(Carrier)

claim:
    ? forall S, T set, f fn(x S) T, A power_set(S), U power_set(T):
        union(\set_image<S, T, f, A>, U) $in power_set(T)
    \set_image<S, T, f, A> $in power_set(T)
    \set_image<S, T, f, A> $subset T
    U $subset T
    union(\set_image<S, T, f, A>, U) $subset T
    union(\set_image<S, T, f, A>, U) $in power_set(T)

thm source_union_preimage_subset:
    ? forall S, T set, f fn(x S) T, A power_set(S), U power_set(T):
        union(A, preimage_set(f, U)) $subset preimage_set(f, union(\set_image<S, T, f, A>, U))
    \set_image<S, T, f, A> $in power_set(T)
    union(\set_image<S, T, f, A>, U) $in power_set(T)
    release thm subset_preimage_image(S, T, f, A)
    \set_image<S, T, f, A> $subset union(\set_image<S, T, f, A>, U)
    U $subset union(\set_image<S, T, f, A>, U)
    release thm set_preimage_mono(S, T, f, \set_image<S, T, f, A>, union(\set_image<S, T, f, A>, U))
    release thm set_preimage_mono(S, T, f, U, union(\set_image<S, T, f, A>, U))
    claim:
        ? forall x union(A, preimage_set(f, U)):
            x $in preimage_set(f, union(\set_image<S, T, f, A>, U))
        x $in A or x $in preimage_set(f, U)
        by cases:
            ? x $in preimage_set(f, union(\set_image<S, T, f, A>, U))
            case x $in A:
                x $in preimage_set(f, \set_image<S, T, f, A>)
                x $in preimage_set(f, union(\set_image<S, T, f, A>, U))
            case x $in preimage_set(f, U):
                x $in preimage_set(f, union(\set_image<S, T, f, A>, U))
    by def union(A, preimage_set(f, U)) $subset preimage_set(f, union(\set_image<S, T, f, A>, U))
# Total MIL indexed sets retain the specified ambient carrier for an empty index.
prop indexed_union_member(I, Carrier set, family fn(j I) power_set(Carrier), value Carrier):
    exist j I st {value $in family(j)}

prop indexed_intersection_member(I, Carrier set, family fn(j I) power_set(Carrier), value Carrier):
    forall j I:
        value $in family(j)

template<I, Carrier set, family fn(j I) power_set(Carrier)>:
    have total_index_union power_set(Carrier) = {elem Carrier: $indexed_union_member(I, Carrier, family, elem)}

template<I, Carrier set, family fn(j I) power_set(Carrier)>:
    have total_index_intersect power_set(Carrier) = {elem Carrier: $indexed_intersection_member(I, Carrier, family, elem)}

# Images commute with arbitrary indexed unions.
thm image_indexed_union:
    ? forall I, S, T set, f fn(x S) T, A fn(index I) power_set(S):
        \set_image<S, T, f, \total_index_union<I, S, A>> = \total_index_union<I, T, \indexed_images<I, S, T, f, A>>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    thm union_definition:
        ? forall J, Carrier set, family fn(j J) power_set(Carrier):
            \total_index_union<J, Carrier, family> = {elem Carrier: $indexed_union_member(J, Carrier, family, elem)}
    thm image_definition:
        ? forall Domain, Codomain set, map fn(x Domain) Codomain, Part power_set(Domain):
            \set_image<Domain, Codomain, map, Part> = fn_range(fn(x Part) Codomain {map(x)})
    claim:
        ? \set_image<S, T, f, \total_index_union<I, S, A>> $subset \total_index_union<I, T, \indexed_images<I, S, T, f, A>>
        claim:
            ? forall y \set_image<S, T, f, \total_index_union<I, S, A>>:
                y $in \total_index_union<I, T, \indexed_images<I, S, T, f, A>>
            by thm image_definition(S, T, f, \total_index_union<I, S, A>) => \set_image<S, T, f, \total_index_union<I, S, A>> = fn_range(fn(z \total_index_union<I, S, A>) T {f(z)})
            by thm chap2::transport_membership(\set_image<S, T, f, \total_index_union<I, S, A>>, fn_range(fn(z \total_index_union<I, S, A>) T {f(z)}), y) => y $in fn_range(fn(z \total_index_union<I, S, A>) T {f(z)})
            have by fn_preimage: pre from y $in fn_range(fn(z \total_index_union<I, S, A>) T {f(z)})
            fn(z \total_index_union<I, S, A>) T {f(z)}(pre) = f(pre)
            f(pre) = y
            \total_index_union<I, S, A> = {elem S: $indexed_union_member(I, S, A, elem)}
            by thm chap2::transport_membership(\total_index_union<I, S, A>, {elem S: $indexed_union_member(I, S, A, elem)}, pre) => pre $in {elem S: $indexed_union_member(I, S, A, elem)}
            $indexed_union_member(I, S, A, pre)
            by def $indexed_union_member(I, S, A, pre)
            obtain index from exist index I st {pre $in A(index)}
            A(index) $in power_set(S)
            A(index) $subset S
            pre $in S
            fn(z A(index)) T {f(z)}(pre) = f(pre) = y
            fn(z A(index)) T {f(z)}(pre) $in fn_range(fn(z A(index)) T {f(z)})
            by thm equal_element_member(fn_range(fn(z A(index)) T {f(z)}), T, fn(z A(index)) T {f(z)}(pre), y) => y $in fn_range(fn(z A(index)) T {f(z)})
            A(index) $in power_set(S)
            A(index) $subset S
            \set_image<S, T, f, A(index)> = fn_range(fn(z A(index)) T {f(z)})
            by thm chap2::transport_membership(fn_range(fn(z A(index)) T {f(z)}), \set_image<S, T, f, A(index)>, y) => y $in \set_image<S, T, f, A(index)>
            \indexed_images<I, S, T, f, A>(index) = \set_image<S, T, f, A(index)>
            by thm chap2::transport_membership(\set_image<S, T, f, A(index)>, \indexed_images<I, S, T, f, A>(index), y) => y $in \indexed_images<I, S, T, f, A>(index)
            y $in T
            witness $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, y) from index
            release thm set_builder_member(y, {elem T: $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, elem)})
            by thm union_definition(I, T, \indexed_images<I, S, T, f, A>) => \total_index_union<I, T, \indexed_images<I, S, T, f, A>> = {elem T: $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, elem)}
            by thm chap2::transport_membership({elem T: $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, elem)}, \total_index_union<I, T, \indexed_images<I, S, T, f, A>>, y) => y $in \total_index_union<I, T, \indexed_images<I, S, T, f, A>>
        by def:
            ? \set_image<S, T, f, \total_index_union<I, S, A>> $subset \total_index_union<I, T, \indexed_images<I, S, T, f, A>>
    claim:
        ? \total_index_union<I, T, \indexed_images<I, S, T, f, A>> $subset \set_image<S, T, f, \total_index_union<I, S, A>>
        claim:
            ? forall y \total_index_union<I, T, \indexed_images<I, S, T, f, A>>:
                y $in \set_image<S, T, f, \total_index_union<I, S, A>>
            by thm union_definition(I, T, \indexed_images<I, S, T, f, A>) => \total_index_union<I, T, \indexed_images<I, S, T, f, A>> = {elem T: $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, elem)}
            by thm chap2::transport_membership(\total_index_union<I, T, \indexed_images<I, S, T, f, A>>, {elem T: $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, elem)}, y) => y $in {elem T: $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, elem)}
            $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, y)
            by def $indexed_union_member(I, T, \indexed_images<I, S, T, f, A>, y)
            obtain index from exist index I st {y $in \indexed_images<I, S, T, f, A>(index)}
            \indexed_images<I, S, T, f, A>(index) = \set_image<S, T, f, A(index)>
            by thm chap2::transport_membership(\indexed_images<I, S, T, f, A>(index), \set_image<S, T, f, A(index)>, y) => y $in \set_image<S, T, f, A(index)>
            A(index) $in power_set(S)
            A(index) $subset S
            \set_image<S, T, f, A(index)> = fn_range(fn(z A(index)) T {f(z)})
            by thm chap2::transport_membership(\set_image<S, T, f, A(index)>, fn_range(fn(z A(index)) T {f(z)}), y) => y $in fn_range(fn(z A(index)) T {f(z)})
            have by fn_preimage: pre from y $in fn_range(fn(z A(index)) T {f(z)})
            fn(z A(index)) T {f(z)}(pre) = f(pre)
            f(pre) = y
            A(index) $in power_set(S)
            A(index) $subset S
            pre $in S
            witness $indexed_union_member(I, S, A, pre) from index
            release thm set_builder_member(pre, {elem S: $indexed_union_member(I, S, A, elem)})
            \total_index_union<I, S, A> = {elem S: $indexed_union_member(I, S, A, elem)}
            by thm chap2::transport_membership({elem S: $indexed_union_member(I, S, A, elem)}, \total_index_union<I, S, A>, pre) => pre $in \total_index_union<I, S, A>
            fn(z \total_index_union<I, S, A>) T {f(z)}(pre) = f(pre) = y
            fn(z \total_index_union<I, S, A>) T {f(z)}(pre) $in fn_range(fn(z \total_index_union<I, S, A>) T {f(z)})
            by thm equal_element_member(fn_range(fn(z \total_index_union<I, S, A>) T {f(z)}), T, fn(z \total_index_union<I, S, A>) T {f(z)}(pre), y) => y $in fn_range(fn(z \total_index_union<I, S, A>) T {f(z)})
            by thm image_definition(S, T, f, \total_index_union<I, S, A>) => \set_image<S, T, f, \total_index_union<I, S, A>> = fn_range(fn(z \total_index_union<I, S, A>) T {f(z)})
            by thm chap2::transport_membership(fn_range(fn(z \total_index_union<I, S, A>) T {f(z)}), \set_image<S, T, f, \total_index_union<I, S, A>>, y) => y $in \set_image<S, T, f, \total_index_union<I, S, A>>
        by def:
            ? \total_index_union<I, T, \indexed_images<I, S, T, f, A>> $subset \set_image<S, T, f, \total_index_union<I, S, A>>
    by extension:
        ? \set_image<S, T, f, \total_index_union<I, S, A>> = \total_index_union<I, T, \indexed_images<I, S, T, f, A>>

# Images of arbitrary intersections lie in every component image.
thm image_indexed_intersection_subset:
    ? forall I, S, T set, f fn(x S) T, A fn(index I) power_set(S):
        \set_image<S, T, f, \total_index_intersect<I, S, A>> $subset \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>
    thm image_definition:
        ? forall Domain, Codomain set, map fn(x Domain) Codomain, Part power_set(Domain):
            \set_image<Domain, Codomain, map, Part> = fn_range(fn(x Part) Codomain {map(x)})
    thm intersection_definition:
        ? forall J, Carrier set, family fn(j J) power_set(Carrier):
            \total_index_intersect<J, Carrier, family> = {elem Carrier: $indexed_intersection_member(J, Carrier, family, elem)}
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    \total_index_intersect<I, S, A> $in power_set(S)
    \total_index_intersect<I, S, A> $subset S
    claim:
        ? forall y \set_image<S, T, f, \total_index_intersect<I, S, A>>:
            y $in \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>
        by thm image_definition(S, T, f, \total_index_intersect<I, S, A>) => \set_image<S, T, f, \total_index_intersect<I, S, A>> = fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, \total_index_intersect<I, S, A>>, fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)}), y) => y $in fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)})
        have by fn_preimage: pre from y $in fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)})
        fn(z \total_index_intersect<I, S, A>) T {f(z)}(pre) = f(pre)
        f(pre) = y
        pre $in \total_index_intersect<I, S, A>
        pre $in S
        \total_index_intersect<I, S, A> = {elem S: $indexed_intersection_member(I, S, A, elem)}
        by thm chap2::transport_membership(\total_index_intersect<I, S, A>, {elem S: $indexed_intersection_member(I, S, A, elem)}, pre) => pre $in {elem S: $indexed_intersection_member(I, S, A, elem)}
        $indexed_intersection_member(I, S, A, pre)
        by def $indexed_intersection_member(I, S, A, pre)
        claim:
            ? forall index I:
                y $in \indexed_images<I, S, T, f, A>(index)
            A(index) $in power_set(S)
            A(index) $subset S
            pre $in A(index)
            fn(z A(index)) T {f(z)}(pre) = f(pre) = y
            fn(z A(index)) T {f(z)}(pre) $in fn_range(fn(z A(index)) T {f(z)})
            by thm equal_element_member(fn_range(fn(z A(index)) T {f(z)}), T, fn(z A(index)) T {f(z)}(pre), y) => y $in fn_range(fn(z A(index)) T {f(z)})
            \set_image<S, T, f, A(index)> = fn_range(fn(z A(index)) T {f(z)})
            by thm chap2::transport_membership(fn_range(fn(z A(index)) T {f(z)}), \set_image<S, T, f, A(index)>, y) => y $in \set_image<S, T, f, A(index)>
            \indexed_images<I, S, T, f, A>(index) = \set_image<S, T, f, A(index)>
            by thm chap2::transport_membership(\set_image<S, T, f, A(index)>, \indexed_images<I, S, T, f, A>(index), y) => y $in \indexed_images<I, S, T, f, A>(index)
        y $in T
        by def $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, y)
        release thm set_builder_member(y, {elem T: $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, elem)})
        by thm intersection_definition(I, T, \indexed_images<I, S, T, f, A>) => \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>> = {elem T: $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, elem)}
        by thm chap2::transport_membership({elem T: $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, elem)}, \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>, y) => y $in \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>
    by def:
        ? \set_image<S, T, f, \total_index_intersect<I, S, A>> $subset \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>

# For a nonempty index carrier, injectivity gives the reverse intersection
# inclusion.
thm indexed_intersection_images_subset:
    ? forall I nonempty_set, S, T set, f fn(x S) T, A fn(index I) power_set(S):
        $injective(S, T, f)
        =>:
            \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>> $subset \set_image<S, T, f, \total_index_intersect<I, S, A>>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, value Other:
            element = value
            =>:
                value $in Carrier
    thm image_definition:
        ? forall Domain, Codomain set, map fn(x Domain) Codomain, Part power_set(Domain):
            \set_image<Domain, Codomain, map, Part> = fn_range(fn(x Part) Codomain {map(x)})
    thm intersection_definition:
        ? forall J, Carrier set, family fn(j J) power_set(Carrier):
            \total_index_intersect<J, Carrier, family> = {elem Carrier: $indexed_intersection_member(J, Carrier, family, elem)}
    \total_index_intersect<I, S, A> $in power_set(S)
    \total_index_intersect<I, S, A> $subset S
    claim:
        ? forall y \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>:
            y $in \set_image<S, T, f, \total_index_intersect<I, S, A>>
        y $in T
        by thm intersection_definition(I, T, \indexed_images<I, S, T, f, A>) => \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>> = {elem T: $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, elem)}
        by thm chap2::transport_membership(\total_index_intersect<I, T, \indexed_images<I, S, T, f, A>>, {elem T: $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, elem)}, y) => y $in {elem T: $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, elem)}
        $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, y)
        by def $indexed_intersection_member(I, T, \indexed_images<I, S, T, f, A>, y)
        have base I
        y $in \indexed_images<I, S, T, f, A>(base)
        \indexed_images<I, S, T, f, A>(base) = \set_image<S, T, f, A(base)>
        by thm chap2::transport_membership(\indexed_images<I, S, T, f, A>(base), \set_image<S, T, f, A(base)>, y) => y $in \set_image<S, T, f, A(base)>
        A(base) $in power_set(S)
        A(base) $subset S
        \set_image<S, T, f, A(base)> = fn_range(fn(z A(base)) T {f(z)})
        by thm chap2::transport_membership(\set_image<S, T, f, A(base)>, fn_range(fn(z A(base)) T {f(z)}), y) => y $in fn_range(fn(z A(base)) T {f(z)})
        have by fn_preimage: common from y $in fn_range(fn(z A(base)) T {f(z)})
        fn(z A(base)) T {f(z)}(common) = f(common)
        f(common) = y
        A(base) $in power_set(S)
        A(base) $subset S
        common $in S
        claim:
            ? forall index I:
                common $in A(index)
            y $in \indexed_images<I, S, T, f, A>(index)
            \indexed_images<I, S, T, f, A>(index) = \set_image<S, T, f, A(index)>
            by thm chap2::transport_membership(\indexed_images<I, S, T, f, A>(index), \set_image<S, T, f, A(index)>, y) => y $in \set_image<S, T, f, A(index)>
            A(index) $in power_set(S)
            A(index) $subset S
            \set_image<S, T, f, A(index)> = fn_range(fn(z A(index)) T {f(z)})
            by thm chap2::transport_membership(\set_image<S, T, f, A(index)>, fn_range(fn(z A(index)) T {f(z)}), y) => y $in fn_range(fn(z A(index)) T {f(z)})
            have by fn_preimage: pre from y $in fn_range(fn(z A(index)) T {f(z)})
            fn(z A(index)) T {f(z)}(pre) = f(pre)
            f(pre) = y
            A(index) $in power_set(S)
            A(index) $subset S
            pre $in S
            f(common) = y = f(pre)
            common = pre
            by thm equal_element_member(A(index), S, pre, common) => common $in A(index)
        by def $indexed_intersection_member(I, S, A, common)
        release thm set_builder_member(common, {elem S: $indexed_intersection_member(I, S, A, elem)})
        \total_index_intersect<I, S, A> = {elem S: $indexed_intersection_member(I, S, A, elem)}
        by thm chap2::transport_membership({elem S: $indexed_intersection_member(I, S, A, elem)}, \total_index_intersect<I, S, A>, common) => common $in \total_index_intersect<I, S, A>
        fn(z \total_index_intersect<I, S, A>) T {f(z)}(common) = f(common) = y
        fn(z \total_index_intersect<I, S, A>) T {f(z)}(common) $in fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)})
        by thm equal_element_member(fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)}), T, fn(z \total_index_intersect<I, S, A>) T {f(z)}(common), y) => y $in fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)})
        by thm image_definition(S, T, f, \total_index_intersect<I, S, A>) => \set_image<S, T, f, \total_index_intersect<I, S, A>> = fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)})
        by thm chap2::transport_membership(fn_range(fn(z \total_index_intersect<I, S, A>) T {f(z)}), \set_image<S, T, f, \total_index_intersect<I, S, A>>, y) => y $in \set_image<S, T, f, \total_index_intersect<I, S, A>>
    by def:
        ? \total_index_intersect<I, T, \indexed_images<I, S, T, f, A>> $subset \set_image<S, T, f, \total_index_intersect<I, S, A>>

# Preimages commute with arbitrary indexed unions and intersections.
thm preimage_indexed_union:
    ? forall I, S, T set, f fn(x S) T, B fn(index I) power_set(T):
        preimage_set(f, \total_index_union<I, T, B>) = \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
    thm union_definition:
        ? forall J, Carrier set, family fn(j J) power_set(Carrier):
            \total_index_union<J, Carrier, family> = {elem Carrier: $indexed_union_member(J, Carrier, family, elem)}
    claim:
        ? preimage_set(f, \total_index_union<I, T, B>) $subset \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
        claim:
            ? forall x preimage_set(f, \total_index_union<I, T, B>):
                x $in \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
            f(x) $in \total_index_union<I, T, B>
            \total_index_union<I, T, B> = {elem T: $indexed_union_member(I, T, B, elem)}
            by thm chap2::transport_membership(\total_index_union<I, T, B>, {elem T: $indexed_union_member(I, T, B, elem)}, f(x)) => f(x) $in {elem T: $indexed_union_member(I, T, B, elem)}
            $indexed_union_member(I, T, B, f(x))
            by def:
                ? $indexed_union_member(I, T, B, f(x))
            obtain idx from exist idx I st {f(x) $in B(idx)}
            x $in preimage_set(f, B(idx))
            fn(k I) power_set(S) {preimage_set(f, B(k))}(idx) = preimage_set(f, B(idx))
            x $in fn(k I) power_set(S) {preimage_set(f, B(k))}(idx)
            x $in fn(index I) power_set(S) {preimage_set(f, B(index))}(idx)
            x $in S
            witness exist k I st {x $in fn(index I) power_set(S) {preimage_set(f, B(index))}(k)} from idx
            by def:
                ? $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, x)
            release thm set_builder_member(x, {elem S: $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)})
            by thm union_definition(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}) => \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> = {elem S: $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}
            by thm chap2::transport_membership({elem S: $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}, \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>, x) => x $in \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
        by def:
            ? preimage_set(f, \total_index_union<I, T, B>) $subset \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
    claim:
        ? \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> $subset preimage_set(f, \total_index_union<I, T, B>)
        claim:
            ? forall x \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>:
                x $in preimage_set(f, \total_index_union<I, T, B>)
            by thm union_definition(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}) => \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> = {elem S: $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}
            by thm chap2::transport_membership(\total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>, {elem S: $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}, x) => x $in {elem S: $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}
            $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, x)
            by def:
                ? $indexed_union_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, x)
            obtain idx from exist idx I st {x $in fn(index I) power_set(S) {preimage_set(f, B(index))}(idx)}
            fn(index I) power_set(S) {preimage_set(f, B(index))}(idx) = preimage_set(f, B(idx))
            by thm chap2::transport_membership(fn(index I) power_set(S) {preimage_set(f, B(index))}(idx), preimage_set(f, B(idx)), x) => x $in preimage_set(f, B(idx))
            f(x) $in B(idx)
            witness exist k I st {f(x) $in B(k)} from idx
            by def:
                ? $indexed_union_member(I, T, B, f(x))
            release thm set_builder_member(f(x), {elem T: $indexed_union_member(I, T, B, elem)})
            \total_index_union<I, T, B> = {elem T: $indexed_union_member(I, T, B, elem)}
            by thm chap2::transport_membership({elem T: $indexed_union_member(I, T, B, elem)}, \total_index_union<I, T, B>, f(x)) => f(x) $in \total_index_union<I, T, B>
            x $in preimage_set(f, \total_index_union<I, T, B>)
        by def:
            ? \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> $subset preimage_set(f, \total_index_union<I, T, B>)
    by extension:
        ? preimage_set(f, \total_index_union<I, T, B>) = \total_index_union<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>


thm preimage_indexed_intersection:
    ? forall I, S, T set, f fn(x S) T, B fn(index I) power_set(T):
        preimage_set(f, \total_index_intersect<I, T, B>) = \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
    thm intersection_definition:
        ? forall J, Carrier set, family fn(j J) power_set(Carrier):
            \total_index_intersect<J, Carrier, family> = {elem Carrier: $indexed_intersection_member(J, Carrier, family, elem)}
    claim:
        ? preimage_set(f, \total_index_intersect<I, T, B>) $subset \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
        claim:
            ? forall x preimage_set(f, \total_index_intersect<I, T, B>):
                x $in \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
            f(x) $in \total_index_intersect<I, T, B>
            \total_index_intersect<I, T, B> = {elem T: $indexed_intersection_member(I, T, B, elem)}
            by thm chap2::transport_membership(\total_index_intersect<I, T, B>, {elem T: $indexed_intersection_member(I, T, B, elem)}, f(x)) => f(x) $in {elem T: $indexed_intersection_member(I, T, B, elem)}
            $indexed_intersection_member(I, T, B, f(x))
            by def:
                ? $indexed_intersection_member(I, T, B, f(x))
            x $in S
            claim:
                ? forall idx I:
                    x $in preimage_set(f, B(idx))
                f(x) $in B(idx)
                x $in preimage_set(f, B(idx))
            claim:
                ? forall idx I:
                    x $in fn(index I) power_set(S) {preimage_set(f, B(index))}(idx)
                x $in preimage_set(f, B(idx))
                fn(index I) power_set(S) {preimage_set(f, B(index))}(idx) = preimage_set(f, B(idx))
                by thm chap2::transport_membership(preimage_set(f, B(idx)), fn(index I) power_set(S) {preimage_set(f, B(index))}(idx), x) => x $in fn(index I) power_set(S) {preimage_set(f, B(index))}(idx)
            by def:
                ? $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, x)
            release thm set_builder_member(x, {elem S: $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)})
            by thm intersection_definition(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}) => \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> = {elem S: $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}
            by thm chap2::transport_membership({elem S: $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}, \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>, x) => x $in \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
        by def:
            ? preimage_set(f, \total_index_intersect<I, T, B>) $subset \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>
    claim:
        ? \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> $subset preimage_set(f, \total_index_intersect<I, T, B>)
        claim:
            ? forall x \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>:
                x $in preimage_set(f, \total_index_intersect<I, T, B>)
            by thm intersection_definition(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}) => \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> = {elem S: $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}
            by thm chap2::transport_membership(\total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>, {elem S: $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}, x) => x $in {elem S: $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, elem)}
            $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, x)
            by def:
                ? $indexed_intersection_member(I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}, x)
            x $in S
            f(x) $in T
            claim:
                ? forall idx I:
                    f(x) $in B(idx)
                x $in fn(index I) power_set(S) {preimage_set(f, B(index))}(idx)
                fn(index I) power_set(S) {preimage_set(f, B(index))}(idx) = preimage_set(f, B(idx))
                by thm chap2::transport_membership(fn(index I) power_set(S) {preimage_set(f, B(index))}(idx), preimage_set(f, B(idx)), x) => x $in preimage_set(f, B(idx))
                f(x) $in B(idx)
            by def:
                ? $indexed_intersection_member(I, T, B, f(x))
            release thm set_builder_member(f(x), {elem T: $indexed_intersection_member(I, T, B, elem)})
            \total_index_intersect<I, T, B> = {elem T: $indexed_intersection_member(I, T, B, elem)}
            by thm chap2::transport_membership({elem T: $indexed_intersection_member(I, T, B, elem)}, \total_index_intersect<I, T, B>, f(x)) => f(x) $in \total_index_intersect<I, T, B>
            x $in preimage_set(f, \total_index_intersect<I, T, B>)
        by def:
            ? \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}> $subset preimage_set(f, \total_index_intersect<I, T, B>)
    by extension:
        ? preimage_set(f, \total_index_intersect<I, T, B>) = \total_index_intersect<I, S, fn(index I) power_set(S) {preimage_set(f, B(index))}>

# The source's `InjOn` display is exactly this definition.
thm injective_on_characterization:
    ? forall S, T set, f fn(x S) T, A power_set(S):
        $injective_on(S, T, f, A)
        =>:
            $injective_on(S, T, f, A)

# The elementary real-function examples use narrow domain carriers rather than
# repeating positivity/nonnegativity premises at every application.
have nonnegative_reals power_set(R) = {x R: x >= 0}

thm real_log_injective:
    ? forall marker {0}:
        $injective(R+, R, fn(x R+) R {ln(x)})
    thm named_log_injective:
        ? forall g fn(x R+) R:
            g = fn(x R+) R {ln(x)}
            =>:
                $injective(R+, R, g)
        claim:
            ? forall x1, x2 R+:
                g(x1) = g(x2)
                =>:
                    x1 = x2
            g(x1) = ln(x1)
            g(x2) = ln(x2)
            ln(x1) = ln(x2)
            x1 = exp(ln(x1)) = exp(ln(x2)) = x2
        by def $injective(R+, R, g)
    by thm named_log_injective(fn(x R+) R {ln(x)}) => $injective(R+, R, fn(x R+) R {ln(x)})

thm real_exp_surjective_to_positive_reals:
    ? forall marker {0}:
        $surjective(R, R+, fn(x R) R+ {exp(x)})
    claim:
        ? forall y R+:
            exist x R st {y = fn(t R) R+ {exp(t)}(x)}
        witness exist x R st {y = fn(t R) R+ {exp(t)}(x)} from ln(y):
            exp(ln(y)) = y
    by def $surjective(R, R+, fn(x R) R+ {exp(x)})

claim:
    ? forall value nonnegative_reals:
        sqrt(value) $in nonnegative_reals
    value $in R
    value >= 0
    sqrt(value) $in R
    0 <= value
    0 <= sqrt(value)
    sqrt(value) >= 0
    release thm set_builder_member(sqrt(value), {x R: x >= 0})
    nonnegative_reals = {x R: x >= 0}
    by thm chap2::transport_membership({x R: x >= 0}, nonnegative_reals, sqrt(value)) => sqrt(value) $in nonnegative_reals

have fn nonnegative_sqrt(value nonnegative_reals) nonnegative_reals = sqrt(value)

thm real_sqrt_injective:
    ? forall marker {0}:
        $injective(nonnegative_reals, nonnegative_reals, fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)})
    thm named_sqrt_injective:
        ? forall g fn(x nonnegative_reals) nonnegative_reals:
            g = fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)}
            =>:
                $injective(nonnegative_reals, nonnegative_reals, g)
        claim:
            ? forall left, right nonnegative_reals:
                g(left) = g(right)
                =>:
                    left = right
            g(left) = nonnegative_sqrt(left)
            nonnegative_sqrt(left) = sqrt(left)
            g(left) = sqrt(left)
            g(right) = nonnegative_sqrt(right)
            nonnegative_sqrt(right) = sqrt(right)
            g(right) = sqrt(right)
            sqrt(left) = sqrt(right)
            left $in R
            right $in R
            0 <= left
            0 <= right
            sqrt(left)^2 = left
            sqrt(right)^2 = right
            left = sqrt(left)^2 = sqrt(right)^2 = right
        by def $injective(nonnegative_reals, nonnegative_reals, g)
    by thm named_sqrt_injective(fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)}) => $injective(nonnegative_reals, nonnegative_reals, fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)})

claim:
    ? forall value R:
        value^2 $in nonnegative_reals
    0 <= value^2
    value^2 >= 0
    release thm set_builder_member(value^2, {x R: x >= 0})
    nonnegative_reals = {x R: x >= 0}
    by thm chap2::transport_membership({x R: x >= 0}, nonnegative_reals, value^2) => value^2 $in nonnegative_reals

have fn nonnegative_square(value R) nonnegative_reals = value^2

thm square_injective_on_nonnegative_reals:
    ? forall marker {0}:
        $injective(nonnegative_reals, nonnegative_reals, fn(x nonnegative_reals) nonnegative_reals {nonnegative_square(x)})
    thm named_square_injective:
        ? forall g fn(x nonnegative_reals) nonnegative_reals:
            g = fn(x nonnegative_reals) nonnegative_reals {nonnegative_square(x)}
            =>:
                $injective(nonnegative_reals, nonnegative_reals, g)
        claim:
            ? forall left, right nonnegative_reals:
                g(left) = g(right)
                =>:
                    left = right
            left $in R
            right $in R
            0 <= left
            0 <= right
            g(left) = nonnegative_square(left) = left^2
            g(right) = nonnegative_square(right) = right^2
            left^2 = right^2
            sqrt(left^2) = left
            sqrt(right^2) = right
            left = sqrt(left^2) = sqrt(right^2) = right
        by def $injective(nonnegative_reals, nonnegative_reals, g)
    by thm named_square_injective(fn(x nonnegative_reals) nonnegative_reals {nonnegative_square(x)}) => $injective(nonnegative_reals, nonnegative_reals, fn(x nonnegative_reals) nonnegative_reals {nonnegative_square(x)})

thm real_sqrt_surjective:
    ? forall marker {0}:
        $surjective(nonnegative_reals, nonnegative_reals, fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)})
    thm named_sqrt_surjective:
        ? forall g fn(x nonnegative_reals) nonnegative_reals:
            g = fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)}
            =>:
                $surjective(nonnegative_reals, nonnegative_reals, g)
        claim:
            ? forall value nonnegative_reals:
                exist source nonnegative_reals st {value = g(source)}
            value $in R
            0 <= value
            have square nonnegative_reals = nonnegative_square(value)
            square = nonnegative_square(value) = value^2
            0 <= square
            sqrt(value^2) = value
            sqrt(square) = sqrt(value^2) = value
            nonnegative_sqrt(square) = sqrt(square) = value
            g(square) = nonnegative_sqrt(square) = value
            witness exist source nonnegative_reals st {value = g(source)} from square
        by def $surjective(nonnegative_reals, nonnegative_reals, g)
    by thm named_sqrt_surjective(fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)}) => $surjective(nonnegative_reals, nonnegative_reals, fn(x nonnegative_reals) nonnegative_reals {nonnegative_sqrt(x)})

thm square_surjective_to_nonnegative_reals:
    ? forall marker {0}:
        $surjective(R, nonnegative_reals, fn(x R) nonnegative_reals {nonnegative_square(x)})
    thm named_square_surjective:
        ? forall g fn(x R) nonnegative_reals:
            g = fn(x R) nonnegative_reals {nonnegative_square(x)}
            =>:
                $surjective(R, nonnegative_reals, g)
        claim:
            ? forall value nonnegative_reals:
                exist source R st {value = g(source)}
            value $in R
            0 <= value
            sqrt(value)^2 = value
            nonnegative_square(sqrt(value)) = sqrt(value)^2 = value
            g(sqrt(value)) = nonnegative_square(sqrt(value)) = value
            witness exist source R st {value = g(source)} from sqrt(value)
        by def $surjective(R, nonnegative_reals, g)
    by thm named_square_surjective(fn(x R) nonnegative_reals {nonnegative_square(x)}) => $surjective(R, nonnegative_reals, fn(x R) nonnegative_reals {nonnegative_square(x)})
# Source theorem `Cantor`. No function from a set onto its power set can be
# surjective. The proof forms the diagonal set of inputs which do not belong to
# their own images, asks surjectivity for its preimage, and obtains the usual
# membership contradiction.
thm cantor:
    ? forall S set, f fn(x S) power_set(S):
        not $surjective(S, power_set(S), f)
    by contra:
        ? not $surjective(S, power_set(S), f)
        have diagonal_set power_set(S) = {x S: not x $in f(x)}
        obtain a from exist a S st {diagonal_set = f(a)}

        claim:
            ? a $in diagonal_set
            by contra:
                ? a $in diagonal_set
                not a $in diagonal_set
                not a $in f(a)
                release thm set_builder_member(a, {x S: not x $in f(x)})
                a $in {x S: not x $in f(x)}
                impossible not a $in diagonal_set

        impossible not a $in f(a)

# ---------------------------------------------------------------------------
# Section 4.3 — The Schröder–Bernstein construction
# ---------------------------------------------------------------------------

# The source recursively starts with the points outside the range of g, then
# alternates the restricted images of f and g.
thm _mil_natural_zero_or_positive:
    ? forall value N:
        value = 0 or value > 0
    by cases:
        ? value = 0 or value > 0
        case value = 0:
            value = 0 or value > 0
        case value != 0:
            claim:
                ? value > 0
                by contra:
                    ? value > 0
                    value <= 0
                    value >= 0
                    value = 0
                    impossible value != 0
            value = 0 or value > 0

thm _mil_natural_positive_predecessor:
    ? forall value N:
        value > 0
        =>:
            value - 1 >= 0
            value - 1 $in N
    value $in N+
    1 <= value
    1 - 1 <= value - 1
    0 <= value - 1
    value - 1 $in Z
    value - 1 $in N


claim:
    ? forall S set, T nonempty_set, g fn(y T) S:
        set_minus(S, \set_image<T, S, g, T>) $in power_set(S)
    set_minus(S, \set_image<T, S, g, T>) $subset S
    set_minus(S, \set_image<T, S, g, T>) $in power_set(S)

claim:
    ? forall S, T set, f fn(x S) T, A power_set(S):
        \set_image<S, T, f, A> $in power_set(T)
    A $subset S
    claim:
        ? forall value \set_image<S, T, f, A>:
            value $in T
        \set_image<S, T, f, A> = fn_range(fn(x A) T {f(x)})
        by thm chap2::transport_membership(\set_image<S, T, f, A>, fn_range(fn(x A) T {f(x)}), value) => value $in fn_range(fn(x A) T {f(x)})
        have by fn_preimage: pre from value $in fn_range(fn(x A) T {f(x)})
    by def \set_image<S, T, f, A> $subset T
    \set_image<S, T, f, A> $in power_set(T)

claim:
    ? forall S set, T nonempty_set, f fn(x S) T, g fn(y T) S, Part power_set(S):
        \set_image<T, S, g, \set_image<S, T, f, Part>> $in power_set(S)
    \set_image<S, T, f, Part> $in power_set(T)
    \set_image<S, T, f, Part> $subset T
    claim:
        ? forall value \set_image<T, S, g, \set_image<S, T, f, Part>>:
            value $in S
        \set_image<T, S, g, \set_image<S, T, f, Part>> = fn_range(fn(y \set_image<S, T, f, Part>) S {g(y)})
        by thm chap2::transport_membership(\set_image<T, S, g, \set_image<S, T, f, Part>>, fn_range(fn(y \set_image<S, T, f, Part>) S {g(y)}), value) => value $in fn_range(fn(y \set_image<S, T, f, Part>) S {g(y)})
        have by fn_preimage: pre from value $in fn_range(fn(y \set_image<S, T, f, Part>) S {g(y)})
    by def \set_image<T, S, g, \set_image<S, T, f, Part>> $subset S
    \set_image<T, S, g, \set_image<S, T, f, Part>> $in power_set(S)

template<S set, T nonempty_set, f fn(x S) T, g fn(y T) S>:
    have fn sb_step(Part power_set(S)) power_set(S) = \set_image<T, S, g, \set_image<S, T, f, Part>>

template<S set, T nonempty_set, f fn(x S) T, g fn(y T) S>:
    have fn sb_aux(n N) power_set(S) by induc n from 0:
        case n = 0: set_minus(S, \set_image<T, S, g, T>)
        case n > 0: \sb_step<S, T, f, g>(sb_aux(n - 1))

thm sb_aux_zero:
    ? forall S set, T nonempty_set, f fn(x S) T, g fn(y T) S:
        \sb_aux<S, T, f, g>(0) = set_minus(S, \set_image<T, S, g, T>)

thm sb_aux_successor:
    ? forall S set, T nonempty_set, f fn(x S) T, g fn(y T) S, n N:
        \sb_aux<S, T, f, g>(n + 1) = \set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n)>>
    n + 1 > 0
    (n + 1) - 1 = n
    \sb_aux<S, T, f, g>(n + 1) = \sb_step<S, T, f, g>(\sb_aux<S, T, f, g>((n + 1) - 1))
    \sb_aux<S, T, f, g>((n + 1) - 1) = \sb_aux<S, T, f, g>(n)
    \sb_step<S, T, f, g>(\sb_aux<S, T, f, g>(n)) = \set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n)>>

thm _mil_image_of_member:
    ? forall Domain, Codomain set, map fn(input Domain) Codomain, Part power_set(Domain), value Domain:
        value $in Part
        =>:
            map(value) $in \set_image<Domain, Codomain, map, Part>
    thm equal_element_member:
        ? forall Carrier, Other set, element Carrier, result Other:
            element = result
            =>:
                result $in Carrier
    Part $subset Domain
    fn(x Part) Codomain {map(x)}(value) = map(value)
    fn(x Part) Codomain {map(x)}(value) $in fn_range(fn(x Part) Codomain {map(x)})
    by thm equal_element_member(fn_range(fn(x Part) Codomain {map(x)}), Codomain, fn(x Part) Codomain {map(x)}(value), map(value)) => map(value) $in fn_range(fn(x Part) Codomain {map(x)})
    \set_image<Domain, Codomain, map, Part> = fn_range(fn(x Part) Codomain {map(x)})
    by thm chap2::transport_membership(fn_range(fn(x Part) Codomain {map(x)}), \set_image<Domain, Codomain, map, Part>, map(value)) => map(value) $in \set_image<Domain, Codomain, map, Part>

thm sb_next_mem:
    ? forall S set, T nonempty_set, f fn(x S) T, g fn(y T) S, n N, x S:
        x $in \sb_aux<S, T, f, g>(n)
        =>:
            g(f(x)) $in \sb_aux<S, T, f, g>(n + 1)
    \sb_aux<S, T, f, g>(n) $in power_set(S)
    release thm _mil_image_of_member(S, T, f, \sb_aux<S, T, f, g>(n), x)
    \set_image<S, T, f, \sb_aux<S, T, f, g>(n)> $in power_set(T)
    release thm _mil_image_of_member(T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n)>, f(x))
    release thm sb_aux_successor(S, T, f, g, n)
    by thm chap2::transport_membership(\set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n)>>, \sb_aux<S, T, f, g>(n + 1), g(f(x))) => g(f(x)) $in \sb_aux<S, T, f, g>(n + 1)
# The countable union of the recursive layers is represented extensionally by
# membership in some natural-number layer.
prop sb_set_member(S set, T nonempty_set, f fn(x S) T, g fn(y T) S, x S):
    exist n N st {x $in \sb_aux<S, T, f, g>(n)}

template<S set, T nonempty_set, f fn(x S) T, g fn(y T) S>:
    have sb_set power_set(S) = {x S: $sb_set_member(S, T, f, g, x)}

# On sb_set use f; elsewhere use the total selected inverse of g.
template<S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S>:
    have fn sb_fun(x S) T by cases:
        case x $in \sb_set<S, T, f, g>: f(x)
        case not x $in \sb_set<S, T, f, g>: \inverse<T, S, default, g>(x)

thm sb_fun_on_set:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S, x S:
        x $in \sb_set<S, T, f, g>
        =>:
            \sb_fun<S, T, default, f, g>(x) = f(x)

thm sb_fun_off_set:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S, x S:
        not x $in \sb_set<S, T, f, g>
        =>:
            \sb_fun<S, T, default, f, g>(x) = \inverse<T, S, default, g>(x)

thm sb_right_inv:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(input T) S, x S:
        not x $in \sb_set<S, T, f, g>
        =>:
            g(\inverse<T, S, default, g>(x)) = x
    release thm total_inverse_available(T, S, default, g)
    by cases:
        ? g(\inverse<T, S, default, g>(x)) = x
        case $has_preimage(T, S, g, x):
            release thm inverse_spec(T, S, default, g, x)
        case not $has_preimage(T, S, g, x):
            claim:
                ? not x $in \set_image<T, S, g, T>
                by contra:
                    ? not x $in \set_image<T, S, g, T>
                    \set_image<T, S, g, T> = fn_range(fn(q T) S {g(q)})
                    by thm chap2::transport_membership(\set_image<T, S, g, T>, fn_range(fn(q T) S {g(q)}), x) => x $in fn_range(fn(q T) S {g(q)})
                    have by fn_preimage: q from x $in fn_range(fn(q T) S {g(q)})
                    fn(z T) S {g(z)}(q) = g(q)
                    witness $has_preimage(T, S, g, x) from q
                    impossible not $has_preimage(T, S, g, x)
            x $in set_minus(S, \set_image<T, S, g, T>)
            release thm sb_aux_zero(S, T, f, g)
            \sb_aux<S, T, f, g>(0) = set_minus(S, \set_image<T, S, g, T>)
            x $in \sb_aux<S, T, f, g>(0)
            witness $sb_set_member(S, T, f, g, x) from 0
            release thm set_builder_member(x, {z S: $sb_set_member(S, T, f, g, z)})
            x $in {z S: $sb_set_member(S, T, f, g, z)}
            \sb_set<S, T, f, g> = {z S: $sb_set_member(S, T, f, g, z)}
            x $in \sb_set<S, T, f, g>
            impossible not x $in \sb_set<S, T, f, g>

thm sb_set_closed:
    ? forall S set, T nonempty_set, f fn(x S) T, g fn(y T) S, x S:
        x $in \sb_set<S, T, f, g>
        =>:
            g(f(x)) $in \sb_set<S, T, f, g>
    \sb_set<S, T, f, g> = {z S: $sb_set_member(S, T, f, g, z)}
    by thm chap2::transport_membership(\sb_set<S, T, f, g>, {z S: $sb_set_member(S, T, f, g, z)}, x) => x $in {z S: $sb_set_member(S, T, f, g, z)}
    by def:
        ? $sb_set_member(S, T, f, g, x)
    obtain n from $sb_set_member(S, T, f, g, x)
    release thm sb_next_mem(S, T, f, g, n, x)
    witness $sb_set_member(S, T, f, g, g(f(x))) from n + 1
    release thm set_builder_member(g(f(x)), {z S: $sb_set_member(S, T, f, g, z)})
    g(f(x)) $in {z S: $sb_set_member(S, T, f, g, z)}
    \sb_set<S, T, f, g> = {z S: $sb_set_member(S, T, f, g, z)}
    by thm chap2::transport_membership({z S: $sb_set_member(S, T, f, g, z)}, \sb_set<S, T, f, g>, g(f(x))) => g(f(x)) $in \sb_set<S, T, f, g>

thm _mil_sb_function_type:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S:
        \sb_fun<S, T, default, f, g> $in fn(x S) T

claim:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S, value S:
        \sb_fun<S, T, default, f, g>(value) $in T
    release thm _mil_sb_function_type(S, T, default, f, g)
    \sb_fun<S, T, default, f, g>(value) $in T

thm sb_injective:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S:
        $injective(S, T, f)
        =>:
            $injective(S, T, \sb_fun<S, T, default, f, g>)
    release thm total_inverse_available(T, S, default, g)
    claim:
        ? forall x1, x2 S:
            \sb_fun<S, T, default, f, g>(x1) = \sb_fun<S, T, default, f, g>(x2)
            =>:
                x1 = x2
        by cases:
            ? x1 = x2
            case x1 $in \sb_set<S, T, f, g>:
                by cases:
                    ? x1 = x2
                    case x2 $in \sb_set<S, T, f, g>:
                        release thm sb_fun_on_set(S, T, default, f, g, x1)
                        release thm sb_fun_on_set(S, T, default, f, g, x2)
                        f(x1) = f(x2)
                        x1 = x2
                    case not x2 $in \sb_set<S, T, f, g>:
                        release thm sb_fun_on_set(S, T, default, f, g, x1)
                        release thm sb_fun_off_set(S, T, default, f, g, x2)
                        f(x1) = \inverse<T, S, default, g>(x2)
                        release thm sb_right_inv(S, T, default, f, g, x2)
                        g(f(x1)) = g(\inverse<T, S, default, g>(x2)) = x2
                        release thm sb_set_closed(S, T, f, g, x1)
                        x2 $in \sb_set<S, T, f, g>
                        impossible not x2 $in \sb_set<S, T, f, g>
            case not x1 $in \sb_set<S, T, f, g>:
                by cases:
                    ? x1 = x2
                    case x2 $in \sb_set<S, T, f, g>:
                        release thm sb_fun_off_set(S, T, default, f, g, x1)
                        release thm sb_fun_on_set(S, T, default, f, g, x2)
                        \inverse<T, S, default, g>(x1) = f(x2)
                        release thm sb_right_inv(S, T, default, f, g, x1)
                        x1 = g(\inverse<T, S, default, g>(x1)) = g(f(x2))
                        release thm sb_set_closed(S, T, f, g, x2)
                        x1 $in \sb_set<S, T, f, g>
                        impossible not x1 $in \sb_set<S, T, f, g>
                    case not x2 $in \sb_set<S, T, f, g>:
                        release thm sb_fun_off_set(S, T, default, f, g, x1)
                        release thm sb_fun_off_set(S, T, default, f, g, x2)
                        \inverse<T, S, default, g>(x1) = \inverse<T, S, default, g>(x2)
                        g(\inverse<T, S, default, g>(x1)) = g(\inverse<T, S, default, g>(x2))
                        release thm sb_right_inv(S, T, default, f, g, x1)
                        release thm sb_right_inv(S, T, default, f, g, x2)
                        x1 = g(\inverse<T, S, default, g>(x1)) = g(\inverse<T, S, default, g>(x2)) = x2
    by def:
        ? $injective(S, T, \sb_fun<S, T, default, f, g>)

# If g is injective, every y in T has an sb_fun preimage. When g(y) lies in
# sb_set, its positive recursive layer supplies an earlier x with f(x)=y.
# Otherwise g(y) itself is a preimage through the inverse branch.
thm sb_surjective:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S:
        $injective(T, S, g)
        =>:
            $surjective(S, T, \sb_fun<S, T, default, f, g>)
    release thm total_inverse_available(T, S, default, g)
    claim:
        ? forall y T:
            g(y) $in \sb_set<S, T, f, g>
            =>:
                exist x S st {x $in \sb_set<S, T, f, g>, f(x) = y}
        \sb_set<S, T, f, g> = {z S: $sb_set_member(S, T, f, g, z)}
        by thm chap2::transport_membership(\sb_set<S, T, f, g>, {z S: $sb_set_member(S, T, f, g, z)}, g(y)) => g(y) $in {z S: $sb_set_member(S, T, f, g, z)}
        by def:
            ? $sb_set_member(S, T, f, g, g(y))
        obtain n from $sb_set_member(S, T, f, g, g(y))
        by cases:
            ? exist x S st {x $in \sb_set<S, T, f, g>, f(x) = y}
            case n = 0:
                release thm sb_aux_zero(S, T, f, g)
                \sb_aux<S, T, f, g>(n) = \sb_aux<S, T, f, g>(0) = set_minus(S, \set_image<T, S, g, T>)
                by thm chap2::transport_membership(\sb_aux<S, T, f, g>(n), set_minus(S, \set_image<T, S, g, T>), g(y)) => g(y) $in set_minus(S, \set_image<T, S, g, T>)
                not g(y) $in \set_image<T, S, g, T>
                release thm _mil_image_of_member(T, S, g, T, y)
                impossible not g(y) $in \set_image<T, S, g, T>
            case n > 0:
                n = (n - 1) + 1
                release thm _mil_natural_positive_predecessor(n)
                release thm sb_aux_successor(S, T, f, g, n - 1)
                \sb_aux<S, T, f, g>(n) = \set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>>
                by thm chap2::transport_membership(\sb_aux<S, T, f, g>(n), \set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>>, g(y)) => g(y) $in \set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>>
                \sb_aux<S, T, f, g>(n - 1) $in power_set(S)
                \sb_aux<S, T, f, g>(n - 1) $subset S
                \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)> $in power_set(T)
                \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)> $subset T
                \set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>> = fn_range(fn(z \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>) S {g(z)})
                by thm chap2::transport_membership(\set_image<T, S, g, \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>>, fn_range(fn(z \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>) S {g(z)}), g(y)) => g(y) $in fn_range(fn(z \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>) S {g(z)})
                have by fn_preimage: mid from g(y) $in fn_range(fn(z \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>) S {g(z)})
                fn(z \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>) S {g(z)}(mid) = g(mid)
                mid $in T
                y $in T
                g(y) = g(mid)
                y = mid
                \set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)> = fn_range(fn(z \sb_aux<S, T, f, g>(n - 1)) T {f(z)})
                by thm chap2::transport_membership(\set_image<S, T, f, \sb_aux<S, T, f, g>(n - 1)>, fn_range(fn(z \sb_aux<S, T, f, g>(n - 1)) T {f(z)}), mid) => mid $in fn_range(fn(z \sb_aux<S, T, f, g>(n - 1)) T {f(z)})
                have by fn_preimage: pre from mid $in fn_range(fn(z \sb_aux<S, T, f, g>(n - 1)) T {f(z)})
                fn(z \sb_aux<S, T, f, g>(n - 1)) T {f(z)}(pre) = f(pre)
                mid = f(pre)
                witness $sb_set_member(S, T, f, g, pre) from n - 1
                release thm set_builder_member(pre, {z S: $sb_set_member(S, T, f, g, z)})
                pre $in {z S: $sb_set_member(S, T, f, g, z)}
                \sb_set<S, T, f, g> = {z S: $sb_set_member(S, T, f, g, z)}
                by thm chap2::transport_membership({z S: $sb_set_member(S, T, f, g, z)}, \sb_set<S, T, f, g>, pre) => pre $in \sb_set<S, T, f, g>
                witness exist x S st {x $in \sb_set<S, T, f, g>, f(x) = y} from pre
    claim:
        ? forall y T:
            exist x S st {y = \sb_fun<S, T, default, f, g>(x)}
        by cases:
            ? exist x S st {y = \sb_fun<S, T, default, f, g>(x)}
            case g(y) $in \sb_set<S, T, f, g>:
                obtain pre from exist x S st {x $in \sb_set<S, T, f, g>, f(x) = y}
                release thm sb_fun_on_set(S, T, default, f, g, pre)
                witness exist x S st {y = \sb_fun<S, T, default, f, g>(x)} from pre
            case not g(y) $in \sb_set<S, T, f, g>:
                release thm inverse_left_of_injective(T, S, default, g)
                \inverse<T, S, default, g>(g(y)) = y
                release thm sb_fun_off_set(S, T, default, f, g, g(y))
                \sb_fun<S, T, default, f, g>(g(y)) = \inverse<T, S, default, g>(g(y)) = y
                witness exist x S st {y = \sb_fun<S, T, default, f, g>(x)} from g(y)
    by def:
        ? $surjective(S, T, \sb_fun<S, T, default, f, g>)

# The source theorem. The constructed piecewise function is injective by the
# f branch argument and surjective by the g branch argument.
thm schroeder_bernstein:
    ? forall S set, T nonempty_set, default T, f fn(x S) T, g fn(y T) S:
        $injective(S, T, f)
        $injective(T, S, g)
        =>:
            exist h fn(x S) T st {$bijective(S, T, h)}
    release thm sb_injective(S, T, default, f, g)
    release thm sb_surjective(S, T, default, f, g)
    by def:
        ? $bijective(S, T, \sb_fun<S, T, default, f, g>)
    witness exist h fn(x S) T st {$bijective(S, T, h)} from \sb_fun<S, T, default, f, g>
