# Chapter 9 subgroup layer built against the visible Chapter 2 interface.
#
# These source-order blocks were accepted transactionally and materialized
# from proof_journal.json. The final theorem keeps the mathematical closure
# spine while omitting membership and set-builder echoes supplied by the
# current verifier.

prop is_subgroup(G nonempty_set, group &group::Group<G>, H power_set(G)):
    group.one $in H
    forall x, y G:
        x $in H
        y $in H
        =>:
            group.mul(x, y) $in H
    forall x G:
        x $in H
        =>:
            group.inv(x) $in H

thm subgroup_mul_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), x, y G:
        $is_subgroup(G, group, H)
        x $in H
        y $in H
        =>:
            group.mul(x, y) $in H

thm subgroup_inv_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), x G:
        $is_subgroup(G, group, H)
        x $in H
        =>:
            group.inv(x) $in H

template<G set>:
    have fn subgroup_intersection(H, K power_set(G)) power_set(G) = {x G: x $in H and x $in K}

thm subgroup_intersection_closed:
    ? forall G nonempty_set, group &group::Group<G>, H, K power_set(G):
        $is_subgroup(G, group, H)
        $is_subgroup(G, group, K)
        =>:
            $is_subgroup(G, group, {x G: x $in H and x $in K})
    group.one $in {x G: x $in H and x $in K}
    claim:
        ? forall x, y {q G: q $in H and q $in K}:
            group.mul(x, y) $in {q G: q $in H and q $in K}
        group.mul(x, y) $in H
        group.mul(x, y) $in K
    claim:
        ? forall x {q G: q $in H and q $in K}:
            group.inv(x) $in {q G: q $in H and q $in K}
        group.inv(x) $in H
        group.inv(x) $in K
    by def:
        ? $is_subgroup(G, group, {x G: x $in H and x $in K})
