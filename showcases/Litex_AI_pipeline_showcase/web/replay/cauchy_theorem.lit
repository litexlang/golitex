# Cauchy's theorem: a prime divisor of |G| produces a subgroup of that order.

thm cauchy_prime_subgroup_exists:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
        =>:
            exist H power_set(G) st {$subgroup::is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p}
    release thm cauchy_fixed_points::cauchy_nontrivial_prime_power_element(G, group, p)
    obtain x from exist element G st {element != group.one, \cauchy_fixed_points::cauchy_group_power<G, group>(element, p) = group.one}
    release thm cauchy_power_hom::cauchy_power_range_is_prime_subgroup(G, group, p, x)
    have H power_set(G) = \subgroup_maps::group_range<\cyclic_group::cyclic_indices<p>, G, \cauchy_power_hom::cauchy_power_map<G, group, p, x>>
    witness exist subgroup_candidate power_set(G) st {$subgroup::is_subgroup(G, group, subgroup_candidate), $is_finite_set(subgroup_candidate), finite_set_size(subgroup_candidate) = p} from H:
        H = \subgroup_maps::group_range<\cyclic_group::cyclic_indices<p>, G, \cauchy_power_hom::cauchy_power_map<G, group, p, x>>
        $subgroup::is_subgroup(G, group, H)
        $is_finite_set(H)
        finite_set_size(H) = finite_set_size(\subgroup_maps::group_range<\cyclic_group::cyclic_indices<p>, G, \cauchy_power_hom::cauchy_power_map<G, group, p, x>>) = p

thm cauchy_prime_subgroup_exists_auto:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        =>:
            exist H power_set(G) st {$subgroup::is_subgroup(G, group, H), $is_finite_set(H), finite_set_size(H) = p}
    release thm cauchy_restriction::cauchy_product_one_tuple_count(G, group, p)
    $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
    release thm p_group_actions::action_fixed_points_are_finite(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>)
    $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
    release thm cauchy_prime_subgroup_exists(G, group, p)
