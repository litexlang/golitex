# Finite-cardinality consequences of the quotient-preimage coordinate bijection.

thm sylow_quotient_preimage_cardinality:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        $is_finite_set(G)
        $is_finite_set(H)
        $is_finite_set(K)
        =>:
            $is_finite_set(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K))
            finite_set_size(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) = finite_set_size(K) * finite_set_size(H)
    release thm quotient_preimage::sylow_quotient_preimage_finite(G, group, H, K)
    release thm quotient_preimage_bijection::sylow_preimage_coordinate_bijective(G, group, H, K)
    obtain coordinate_forward from exist result fn(x \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) cart(K, H) st {$bijective(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), result)}
    $bijective(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward)
    $is_finite_set(cart(K, H))
    finite_set_size(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) = finite_set_size(cart(K, H)) = finite_set_size(K) * finite_set_size(H)
