# Analysis: Sequences, Limits and Infinite Sums
# A sequence is a function on the positive natural numbers. Our first question
# is what it means for its values to approach a real number. Definitions,
# witnesses and proofs in these lectures are all contained in this file.

# 1. An error and a tail
# A tail begins at a finite index, but its estimate controls infinitely many terms.

prop is_tail_close_to(a seq(R), L R, epsilon R+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n) - L) < epsilon
prop has_eventual_closeness_to(a seq(R), L R, epsilon R+):
    exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
prop has_limit(a seq(R), L R):
    forall epsilon R+:
        $has_eventual_closeness_to(a, L, epsilon)
thm limit_extensional:
    ? forall a, b seq(R), L R:
        a = b
        $has_limit(a, L)
        =>:
            $has_limit(b, L)
    by def $has_limit(b, L)

have fn reciprocal(n N+) R = 1 / n

reciprocal(1) = 1
reciprocal(2) = 1 / 2
reciprocal(10) = 1 / 10

thm reciprocal_decreases:
    ? forall start, n N+:
        n >= start
        =>:
            1 / n <= 1 / start
    start * n > 0
    1 / n = start / (start * n) <= n / (start * n) = 1 / start

# For error 1/10, index 10 is too early for a strict estimate. Index 11 works.
claim:
    ? $is_tail_close_to(reciprocal, 0, 1 / 10, 11)
    claim:
        ? forall n N+:
            n >= 11
            =>:
                abs(reciprocal(n) - 0) < 1 / 10
        release thm reciprocal_decreases(11, n)
        reciprocal(n) - 0 = 1 / n
        0 < 1 / n
        abs(reciprocal(n) - 0) = abs(1 / n) = 1 / n <= 1 / 11 < 1 / 10
    by def $is_tail_close_to(reciprocal, 0, 1 / 10, 11)

# The Archimedean property supplies a finite cutoff for any positive error.
# This fact uses Litex's builtin real and natural number systems.
forall epsilon R+:
    exist n N+ st {1 / n < epsilon}

claim:
    ? $has_limit(reciprocal, 0)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(reciprocal, 0, epsilon)
        obtain start from exist start N+ st {1 / start < epsilon}
        witness $has_eventual_closeness_to(reciprocal, 0, epsilon) from start:
            claim:
                ? forall n N+:
                    n >= start
                    =>:
                        abs(reciprocal(n) - 0) < epsilon
                release thm reciprocal_decreases(start, n)
                reciprocal(n) - 0 = 1 / n
                0 < 1 / n
                abs(reciprocal(n) - 0) = abs(1 / n) = 1 / n <= 1 / start < epsilon
            by def $is_tail_close_to(reciprocal, 0, epsilon, start)
    by def $has_limit(reciprocal, 0)

# 2. One limiting value
# Cutoffs are seldom unique. A limiting value is unique: compare two tails
# with error one third of the distance between the proposed limits.

thm sequence_limit_unique:
    ? forall a seq(R), L1, L2 R:
        $has_limit(a, L1)
        $has_limit(a, L2)
        =>:
            L1 = L2
    by contra:
        ? L1 = L2
        L1 - L2 != 0
        abs(L1 - L2) != 0
        have distance R = abs(L1 - L2)
        distance != 0
        0 <= distance
        claim:
            ? distance > 0
            by contra:
                ? distance > 0
                distance <= 0
                0 <= distance <= 0
                distance = 0
                impossible distance != 0
        distance / 3 > 0
        distance / 3 $in R+
        $has_eventual_closeness_to(a, L1, distance / 3)
        $has_eventual_closeness_to(a, L2, distance / 3)
        obtain n1 from $has_eventual_closeness_to(a, L1, distance / 3)
        obtain n2 from $has_eventual_closeness_to(a, L2, distance / 3)
        have n0 N+ = n1 + n2
        n0 >= n1
        n0 >= n2
        abs(a(n0) - L1) < distance / 3
        abs(a(n0) - L2) < distance / 3
        L1 - a(n0) = -(a(n0) - L1)
        abs(L1 - a(n0)) = abs(-(a(n0) - L1)) = abs(a(n0) - L1)
        L1 - L2 = (L1 - a(n0)) + (a(n0) - L2)
        distance = abs((L1 - a(n0)) + (a(n0) - L2)) <= abs(L1 - a(n0)) + abs(a(n0) - L2)
        2 * distance < 3 * distance
        distance / 3 + distance / 3 = 2 * distance / 3 < 3 * distance / 3 = distance
        abs(L1 - a(n0)) + abs(a(n0) - L2) = abs(a(n0) - L1) + abs(a(n0) - L2) < distance / 3 + distance / 3 < distance
        distance <= abs(L1 - a(n0)) + abs(a(n0) - L2) < distance
        impossible distance = distance

claim:
    ? forall L R:
        $has_limit(reciprocal, L)
        =>:
            L = 0
    by thm sequence_limit_unique(reciprocal, L, 0) => L = 0

# 3. Constants and sums
# A constant sequence is already at its limit. For a sum, use a common tail
# and give each input half of the allowed error.

thm constant_sequence_has_limit:
    ? forall c R:
        $has_limit(fn(n N+) R {c}, c)
    have constant seq(R) = fn(n N+) R {c}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(constant, c, epsilon)
        witness $has_eventual_closeness_to(constant, c, epsilon) from 1:
            claim:
                ? forall n N+:
                    n >= 1
                    =>:
                        abs(constant(n) - c) < epsilon
                constant(n) = c
                constant(n) - c = c - c = 0
                abs(constant(n) - c) = abs(0) = 0 < epsilon
            by def $is_tail_close_to(constant, c, epsilon, 1)
    by def $has_limit(constant, c)
    constant = fn(n N+) R {c}
    by thm limit_extensional(constant, fn(n N+) R {c}, c) => $has_limit(fn(n N+) R {c}, c)

thm seq_add_converges_to:
    ? forall a, b seq(R), x, y R:
        $has_limit(a, x)
        $has_limit(b, y)
        =>:
            $has_limit(fn(i_index N+) R {a(i_index) + b(i_index)}, x + y)
    have sum_sequence seq(R) = fn(i_index N+) R {a(i_index) + b(i_index)}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(sum_sequence, x + y, epsilon)
        0 < epsilon
        0 = 0 / 2 < epsilon / 2
        epsilon / 2 $in R+
        $has_eventual_closeness_to(a, x, epsilon / 2)
        $has_eventual_closeness_to(b, y, epsilon / 2)
        obtain n1 from $has_eventual_closeness_to(a, x, epsilon / 2)
        obtain n2 from $has_eventual_closeness_to(b, y, epsilon / 2)
        have sum_tail_start N+ = n1 + n2
        sum_tail_start >= n1
        sum_tail_start >= n2
        witness $has_eventual_closeness_to(sum_sequence, x + y, epsilon) from sum_tail_start:
            claim:
                ? forall n N+:
                    n >= sum_tail_start
                    =>:
                        abs(sum_sequence(n) - (x + y)) < epsilon
                n1 <= sum_tail_start <= n
                n2 <= sum_tail_start <= n
                n >= n1
                n >= n2
                abs(a(n) - x) < epsilon / 2
                abs(b(n) - y) < epsilon / 2
                sum_sequence(n) = a(n) + b(n)
                sum_sequence(n) - (x + y) = (a(n) + b(n)) - (x + y)
                (a(n) + b(n)) - (x + y) = (a(n) - x) + (b(n) - y)
                sum_sequence(n) - (x + y) = (a(n) - x) + (b(n) - y)
                abs(a(n) - x) + abs(b(n) - y) < epsilon / 2 + epsilon / 2 = epsilon
                abs(sum_sequence(n) - (x + y)) = abs((a(n) - x) + (b(n) - y)) <= abs(a(n) - x) + abs(b(n) - y) < epsilon
            by def $is_tail_close_to(sum_sequence, x + y, epsilon, sum_tail_start)
    by def $has_limit(sum_sequence, x + y)
    by thm limit_extensional(sum_sequence, fn(i_index N+) R {a(i_index) + b(i_index)}, x + y) => $has_limit(fn(i_index N+) R {a(i_index) + b(i_index)}, x + y)

release thm constant_sequence_has_limit(3)
release thm seq_add_converges_to(reciprocal, fn(n N+) R {3}, 0, 3)

# 4. Geometric decay
# The estimate 2^n >= n+1 compares exponential growth with linear growth.
# Its reciprocal compares geometric decay with the sequence we already know.
thm powers_of_two_grow:
    ? forall n N:
        2^n >= n + 1
    by induc n from 0:
        ? 2^n >= n + 1
        ? from n = 0:
            2^0 = 1 = 0 + 1
        ? induc:
            2^(n + 1) = 2^n * 2 >= (n + 1) * 2 = (n + 1 + 1) + n >= n + 1 + 1

have fn half_power(n N+) R = (1 / 2)^n

# Reciprocal powers multiply to one; induction establishes the identity.
claim:
    ? forall n N:
        (1 / 2)^n * 2^n = 1
    by induc n from 0:
        ? (1 / 2)^n * 2^n = 1
        ? from n = 0:
            (1 / 2)^0 * 2^0 = 1 * 1 = 1
        ? induc:
            (1 / 2)^(n + 1) = (1 / 2)^n * (1 / 2)
            2^(n + 1) = 2^n * 2
            (1 / 2)^(n + 1) * 2^(n + 1) = ((1 / 2)^n * (1 / 2)) * 2^(n + 1) = ((1 / 2)^n * (1 / 2)) * (2^n * 2) = (1 / 2)^n * 2^n = 1

claim:
    ? forall n N+:
        0 <= half_power(n)
        half_power(n) <= 1 / n
    release thm powers_of_two_grow(n)
    2^n >= n + 1 > n > 0
    (1 / 2)^n * 2^n = 1
    half_power(n) = (1 / 2)^n
    half_power(n) = ((1 / 2)^n * 2^n) / (2^n) = 1 / (2^n)
    n * 2^n > 0
    1 / (2^n) = n / (n * 2^n) <= 2^n / (n * 2^n) = 1 / n
    0 < 1 / (2^n)

# A nonnegative sequence dominated by 1/n also converges to zero.
thm dominated_by_reciprocal_converges:
    ? forall a seq(R):
        forall n N+:
            0 <= a(n)
            a(n) <= 1 / n
        =>:
            $has_limit(a, 0)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(a, 0, epsilon)
        obtain start from exist start N+ st {1 / start < epsilon}
        witness $has_eventual_closeness_to(a, 0, epsilon) from start:
            claim:
                ? forall n N+:
                    n >= start
                    =>:
                        abs(a(n) - 0) < epsilon
                release thm reciprocal_decreases(start, n)
                0 <= a(n) <= 1 / n
                a(n) - 0 = a(n)
                abs(a(n) - 0) = abs(a(n)) = a(n) <= 1 / n <= 1 / start < epsilon
            by def $is_tail_close_to(a, 0, epsilon, start)
    by def $has_limit(a, 0)

release thm dominated_by_reciprocal_converges(half_power)

# Changing signs does not prevent convergence when the absolute values decay.
have fn alternating_half_power(n N+) R = (-1 / 2)^n

claim:
    ? forall n N:
        abs((-1 / 2)^n) = (1 / 2)^n
    by induc n from 0:
        ? abs((-1 / 2)^n) = (1 / 2)^n
        ? from n = 0:
            abs((-1 / 2)^0) = abs(1) = 1 = (1 / 2)^0
        ? induc:
            (-1 / 2)^(n + 1) = (-1 / 2)^n * (-1 / 2)
            (-1 / 2)^n $in R
            abs((-1 / 2)^(n + 1)) = abs((-1 / 2)^n * (-1 / 2)) = abs((-1 / 2)^n) * abs(-1 / 2) = (1 / 2)^n * (1 / 2) = (1 / 2)^(n + 1)

claim:
    ? $has_limit(alternating_half_power, 0)
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(alternating_half_power, 0, epsilon)
        obtain start from $has_eventual_closeness_to(half_power, 0, epsilon)
        witness $has_eventual_closeness_to(alternating_half_power, 0, epsilon) from start:
            claim:
                ? forall n N+:
                    n >= start
                    =>:
                        abs(alternating_half_power(n) - 0) < epsilon
                half_power(n) >= 0
                alternating_half_power(n) - 0 = (-1 / 2)^n
                half_power(n) - 0 = (1 / 2)^n
                abs(alternating_half_power(n) - 0) = abs((-1 / 2)^n) = (1 / 2)^n = half_power(n) = abs(half_power(n)) = abs(half_power(n) - 0) < epsilon
            by def $is_tail_close_to(alternating_half_power, 0, epsilon, start)
    by def $has_limit(alternating_half_power, 0)

# Boundedness alone is insufficient. The sequence -1,1,-1,1,... has no limit.
have fn alternating(n N+) R = (-1)^n

thm alternating_has_no_limit:
    ? forall L R:
        not $has_limit(alternating, L)
    by contra:
        ? not $has_limit(alternating, L)
        obtain start from $has_eventual_closeness_to(alternating, L, 1 / 2)
        2 * start $in N+
        2 * start + 1 $in N+
        2 * start >= start
        2 * start + 1 >= start
        alternating(2 * start) = (-1)^(2 * start) = ((-1)^2)^start = 1^start = 1
        alternating(2 * start + 1) = (-1)^(2 * start + 1) = (-1)^(2 * start) * (-1)^1 = -1
        abs(alternating(2 * start) - L) < 1 / 2
        abs(alternating(2 * start + 1) - L) < 1 / 2
        alternating(2 * start) - L = 1 - L
        alternating(2 * start + 1) - L = -1 - L
        abs(1 - L) = abs(alternating(2 * start) - L) < 1 / 2
        abs(-1 - L) = abs(alternating(2 * start + 1) - L) < 1 / 2
        1 - (-1) = (1 - L) + (L - (-1))
        abs(L - (-1)) = abs((-1) - L)
        2 = abs(1 - (-1)) <= abs(1 - L) + abs((-1) - L) < 1 / 2 + 1 / 2 = 1
        impossible 2 < 1

# 5. An infinite sum through finite partial sums
# The terms are 1,1/2,1/4,... . We define each partial sum by adding one term.
# There is no final infinite index: the sum will be the limit of these sums.
have fn geometric_partial_sum(n N) R by induc n from 0:
    case n = 0: 0
    case n >= 1: geometric_partial_sum(n - 1) + (1 / 2)^(n - 1)

geometric_partial_sum(0) = 0

geometric_partial_sum(1) = geometric_partial_sum(0) + (1 / 2)^0 = 0 + 1 = 1
geometric_partial_sum(2) = geometric_partial_sum(1) + (1 / 2)^1 = 1 + 1 / 2 = 3 / 2
geometric_partial_sum(3) = geometric_partial_sum(2) + (1 / 2)^2 = 3 / 2 + 1 / 4 = 7 / 4

thm geometric_partial_sum_formula:
    ? forall n N:
        geometric_partial_sum(n) = 2 - 2 * (1 / 2)^n
    by induc n from 0:
        ? geometric_partial_sum(n) = 2 - 2 * (1 / 2)^n
        ? from n = 0:
            geometric_partial_sum(0) = 0 = 2 - 2 * (1 / 2)^0
        ? induc:
            n + 1 >= 1
            n + 1 - 1 = n
            geometric_partial_sum(n + 1) = geometric_partial_sum(n + 1 - 1) + (1 / 2)^(n + 1 - 1) = geometric_partial_sum(n) + (1 / 2)^(n + 1 - 1) = geometric_partial_sum(n) + (1 / 2)^n
            (1 / 2)^(n + 1) = (1 / 2)^n * (1 / 2)
            geometric_partial_sum(n + 1) = 2 - 2 * (1 / 2)^n + (1 / 2)^n = 2 - 2 * ((1 / 2)^n * (1 / 2)) = 2 - 2 * (1 / 2)^(n + 1)

# The remainder is 2*(1/2)^n. Choose a tail on which it is smaller than epsilon.
claim:
    ? $has_limit(fn(n N+) R {geometric_partial_sum(n)}, 2)
    have sums seq(R) = fn(n N+) R {geometric_partial_sum(n)}
    claim:
        ? forall epsilon R+:
            $has_eventual_closeness_to(sums, 2, epsilon)
        epsilon / 2 $in R+
        obtain start from exist start N+ st {1 / start < epsilon / 2}
        witness $has_eventual_closeness_to(sums, 2, epsilon) from start:
            claim:
                ? forall n N+:
                    n >= start
                    =>:
                        abs(sums(n) - 2) < epsilon
                release thm geometric_partial_sum_formula(n)
                release thm reciprocal_decreases(start, n)
                sums(n) = geometric_partial_sum(n)
                half_power(n) = (1 / 2)^n
                sums(n) - 2 = geometric_partial_sum(n) - 2 = (2 - 2 * (1 / 2)^n) - 2 = -2 * (1 / 2)^n = -2 * half_power(n)
                0 <= half_power(n) <= 1 / n
                -2 * half_power(n) <= -2 * 0 = 0
                sums(n) - 2 <= -2 * half_power(n) <= 0
                abs(sums(n) - 2) = -(sums(n) - 2) = -(-2 * half_power(n)) = 2 * half_power(n) <= 2 * (1 / n) <= 2 * (1 / start) < 2 * (epsilon / 2) = epsilon
            by def $is_tail_close_to(sums, 2, epsilon, start)
    by def $has_limit(sums, 2)
    by thm limit_extensional(sums, fn(n N+) R {geometric_partial_sum(n)}, 2) => $has_limit(fn(n N+) R {geometric_partial_sum(n)}, 2)


