thm finite_cardinality_domain_20:
    ? forall S finite_set:
        finite_set_size(S) $in N
    finite_set_size(S) $in N


thm singleton_deletion_from_successor_size:
    ? forall n N, T finite_set, p T:
        finite_set_size(T) = n + 1
        =>:
            finite_set_size(set_minus(T, {p})) = n
    by extension:
        ? intersect(T, {p}) = {p}
        claim:
            ? forall z intersect(T, {p}):
                z $in {p}
            z $in {p}
        claim:
            ? forall z {p}:
                z $in intersect(T, {p})
            z = p
            z $in T
            z $in {p}
    $is_finite_set(intersect(T, {p}))
    $is_finite_set(set_minus(T, {p}))
    finite_set_size(intersect(T, {p})) = finite_set_size({p}) = 1
    finite_set_size(T) - finite_set_size(intersect(T, {p})) = finite_set_size(T) - 1
    finite_set_size(T) - 1 = (n + 1) - 1
    finite_set_size(set_minus(T, {p})) = finite_set_size(T) - finite_set_size(intersect(T, {p})) = finite_set_size(T) - 1 = (n + 1) - 1 = n



thm generic_ordered_distinct_pair_count:
    ? forall n N, S finite_set:
        finite_set_size(S) = n + 1
        =>:
            finite_set_sum(S, fn(q S) N {finite_set_size(set_minus(S, {q}))}) = (n + 1) * n
    claim:
        ? forall q S:
            finite_set_size(set_minus(S, {q})) = n
        by thm singleton_deletion_from_successor_size(n, S, q)
    claim:
        ? forall q S:
            $is_finite_set(set_minus(S, {q}))
            finite_set_size(set_minus(S, {q})) $in N
        $is_finite_set(set_minus(S, {q}))
        finite_set_size(set_minus(S, {q})) $in N
    release thm finite_set_sum_substitution(finite_set_sum(S, fn(q S) N {finite_set_size(set_minus(S, {q}))}), finite_set_sum(S, fn(q S) N {n}))
    finite_set_sum(S, fn(q S) N {finite_set_size(set_minus(S, {q}))}) = finite_set_sum(S, fn(q S) N {n})
    finite_set_sum(S, fn(q S) N {n}) = finite_set_size(S) * n
    finite_set_size(S) * n = (n + 1) * n
    finite_set_sum(S, fn(q S) N {finite_set_size(set_minus(S, {q}))}) = finite_set_sum(S, fn(q S) N {n}) = finite_set_size(S) * n = (n + 1) * n

claim:
    ? forall T finite_set, p T, q set_minus(T, {p}):
        $is_finite_set(set_minus(T, {p}))
        $is_finite_set(set_minus(set_minus(T, {p}), {q}))
    $is_finite_set(set_minus(T, {p}))
    $is_finite_set(set_minus(set_minus(T, {p}), {q}))

thm generic_ordered_distinct_triple_count:
    ? forall n N, T finite_set:
        finite_set_size(T) = n + 2
        =>:
            finite_set_sum(T, fn(p T) N {finite_set_sum(set_minus(T, {p}), fn(q set_minus(T, {p})) N {finite_set_size(set_minus(set_minus(T, {p}), {q}))})}) = (n + 2) * (n + 1) * n
    n + 1 $in N
    n + 2 = (n + 1) + 1
    claim:
        ? forall p T:
            $is_finite_set(set_minus(T, {p}))
            finite_set_size(set_minus(T, {p})) = n + 1
        $is_finite_set(set_minus(T, {p}))
        by thm singleton_deletion_from_successor_size(n + 1, T, p)
    claim:
        ? forall p T:
            finite_set_sum(set_minus(T, {p}), fn(q set_minus(T, {p})) N {finite_set_size(set_minus(set_minus(T, {p}), {q}))}) = (n + 1) * n
        by thm generic_ordered_distinct_pair_count(n, set_minus(T, {p}))
    release thm finite_set_sum_substitution(finite_set_sum(T, fn(p T) N {finite_set_sum(set_minus(T, {p}), fn(q set_minus(T, {p})) N {finite_set_size(set_minus(set_minus(T, {p}), {q}))})}), finite_set_sum(T, fn(p T) N {(n + 1) * n}))
    finite_set_sum(T, fn(p T) N {finite_set_sum(set_minus(T, {p}), fn(q set_minus(T, {p})) N {finite_set_size(set_minus(set_minus(T, {p}), {q}))})}) = finite_set_sum(T, fn(p T) N {(n + 1) * n})
    finite_set_sum(T, fn(p T) N {(n + 1) * n}) = finite_set_size(T) * ((n + 1) * n)
    finite_set_size(T) * ((n + 1) * n) = (n + 2) * ((n + 1) * n)
    (n + 2) * ((n + 1) * n) = (n + 2) * (n + 1) * n
    finite_set_sum(T, fn(p T) N {finite_set_sum(set_minus(T, {p}), fn(q set_minus(T, {p})) N {finite_set_size(set_minus(set_minus(T, {p}), {q}))})}) = finite_set_sum(T, fn(p T) N {(n + 1) * n}) = finite_set_size(T) * ((n + 1) * n) = (n + 2) * ((n + 1) * n) = (n + 2) * (n + 1) * n

thm one_three_certificate:
    ? forall a, b, c, ux, uy, vx, vy, wx, wy R:
        a > 0
        b > 0
        c > 0
        a*ux + b*vx + c*wx = 0
        a*uy + b*vy + c*wy = 0
        ux*vx + uy*vy > 0
        ux*wx + uy*wy > 0
        vx*wx + vy*wy > 0
        =>:
            0 = 1
    by contra:
        ? 0 = 1
        0 != 1
        0 < a
        0 < b
        0 < c
        0 < 2
        2 * a > 0
        2 * b > 0
        0 < 2 * a
        0 < 2 * b
        2*a*b > 0
        2*a*c > 0
        2*b*c > 0
        2*a*b*(ux*vx + uy*vy) > 0
        2*a*c*(ux*wx + uy*wy) > 0
        2*b*c*(vx*wx + vy*wy) > 0
        0 <= a^2
        0 <= b^2
        0 <= c^2
        0 <= ux^2
        0 <= uy^2
        0 <= vx^2
        0 <= vy^2
        0 <= wx^2
        0 <= wy^2
        0 <= ux^2 + uy^2
        0 <= vx^2 + vy^2
        0 <= wx^2 + wy^2
        a^2*(ux^2+uy^2) >= 0
        b^2*(vx^2+vy^2) >= 0
        c^2*(wx^2+wy^2) >= 0
        0 <= a^2*(ux^2+uy^2)
        0 <= b^2*(vx^2+vy^2)
        0 <= c^2*(wx^2+wy^2)
        0 <= a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2)
        0 <= a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2) + c^2*(wx^2+wy^2)
        0 < 2*a*b*(ux*vx+uy*vy)
        0 < 2*a*c*(ux*wx+uy*wy)
        0 < 2*b*c*(vx*wx+vy*wy)
        0 < a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2) + c^2*(wx^2+wy^2) + 2*a*b*(ux*vx+uy*vy)
        0 < a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2) + c^2*(wx^2+wy^2) + 2*a*b*(ux*vx+uy*vy) + 2*a*c*(ux*wx+uy*wy)
        a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2) + c^2*(wx^2+wy^2) + 2*a*b*(ux*vx+uy*vy) + 2*a*c*(ux*wx+uy*wy) + 2*b*c*(vx*wx+vy*wy) > 0
        (a*ux + b*vx + c*wx)^2 + (a*uy + b*vy + c*wy)^2 = 0
        (a*ux + b*vx + c*wx)^2 + (a*uy + b*vy + c*wy)^2 = a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2) + c^2*(wx^2+wy^2) + 2*a*b*(ux*vx+uy*vy) + 2*a*c*(ux*wx+uy*wy) + 2*b*c*(vx*wx+vy*wy)
        impossible a^2*(ux^2+uy^2) + b^2*(vx^2+vy^2) + c^2*(wx^2+wy^2) + 2*a*b*(ux*vx+uy*vy) + 2*a*c*(ux*wx+uy*wy) + 2*b*c*(vx*wx+vy*wy) > 0



thm two_two_affine_certificate:
    ? forall a, b, c, d, px, py, qx, qy, rx, ry, sx, sy R:
        a > 0
        b > 0
        c > 0
        d > 0
        a + b = c + d
        a*px + b*rx = c*qx + d*sx
        a*py + b*ry = c*qy + d*sy
        ((qx-px)*(sx-px) + (qy-py)*(sy-py)) > 0
        ((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) > 0
        ((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) > 0
        ((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) > 0
        =>:
            0 = 1
    by contra:
        ? 0 = 1
        0 != 1
        a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) > 0
        c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) > 0
        b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) > 0
        d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) > 0
        a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) + c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) > 0
        b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) + d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) > 0
        0 < a*((qx-px)*(sx-px) + (qy-py)*(sy-py))
        0 < c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy))
        0 < b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry))
        0 < d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy))
        0 < a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) + c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) + b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry))
        a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) + c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) + b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) + d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) > 0
        a*px + b*rx - c*qx - d*sx = (a*px + b*rx) - (c*qx + d*sx)
        (a*px + b*rx) - (c*qx + d*sx) = 0
        a*px + b*rx - c*qx - d*sx = 0
        a*py + b*ry - c*qy - d*sy = (a*py + b*ry) - (c*qy + d*sy)
        (a*py + b*ry) - (c*qy + d*sy) = 0
        a*py + b*ry - c*qy - d*sy = 0
        a + b - c - d = (a + b) - (c + d)
        (a + b) - (c + d) = 0
        a + b - c - d = 0
        (a*px + b*rx - c*qx - d*sx)*(px-qx+rx-sx) = 0
        (a*py + b*ry - c*qy - d*sy)*(py-qy+ry-sy) = 0
        (a+b-c-d)*(-px*rx-py*ry+qx*sx+qy*sy) = 0
        a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) + c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) + b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) + d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) = (a*px + b*rx - c*qx - d*sx)*(px-qx+rx-sx) + (a*py + b*ry - c*qy - d*sy)*(py-qy+ry-sy) + (a+b-c-d)*(-px*rx-py*ry+qx*sx+qy*sy)
        (a*px + b*rx - c*qx - d*sx)*(px-qx+rx-sx) + (a*py + b*ry - c*qy - d*sy)*(py-qy+ry-sy) = 0 + 0
        0 + 0 = 0
        (a*px + b*rx - c*qx - d*sx)*(px-qx+rx-sx) + (a*py + b*ry - c*qy - d*sy)*(py-qy+ry-sy) + (a+b-c-d)*(-px*rx-py*ry+qx*sx+qy*sy) = 0 + 0
        (a*px + b*rx - c*qx - d*sx)*(px-qx+rx-sx) + (a*py + b*ry - c*qy - d*sy)*(py-qy+ry-sy) + (a+b-c-d)*(-px*rx-py*ry+qx*sx+qy*sy) = 0
        a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) + c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) + b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) + d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) = 0
        impossible a*((qx-px)*(sx-px) + (qy-py)*(sy-py)) + c*((px-qx)*(rx-qx) + (py-qy)*(ry-qy)) + b*((qx-rx)*(sx-rx) + (qy-ry)*(sy-ry)) + d*((px-sx)*(rx-sx) + (py-sy)*(ry-sy)) > 0




thm affine_case_mmm:
    ? forall k1, k2, k3, k4, px, py, qx, qy, rx, ry, sx, sy R:
        k1 > 0
        k2 < 0
        k3 < 0
        k4 < 0
        k1+k2+k3+k4 = 0
        k1*px+k2*qx+k3*rx+k4*sx = 0
        k1*py+k2*qy+k3*ry+k4*sy = 0
        (qx-px)*(rx-px)+(qy-py)*(ry-py) > 0
        (qx-px)*(sx-px)+(qy-py)*(sy-py) > 0
        (rx-px)*(sx-px)+(ry-py)*(sy-py) > 0
        =>:
            0 = 1
    0 - k2 > 0 - 0
    0 - k2 = -k2
    0 - 0 = 0
    0 - k3 > 0 - 0
    0 - k3 = -k3
    0 - 0 = 0
    0 - k4 > 0 - 0
    0 - k4 = -k4
    0 - 0 = 0
    -k2 > 0
    -k3 > 0
    -k4 > 0
    (-k2)*(qx-px)+(-k3)*(rx-px)+(-k4)*(sx-px) = -(k1*px+k2*qx+k3*rx+k4*sx)+(k1+k2+k3+k4)*px
    -(k1*px+k2*qx+k3*rx+k4*sx)+(k1+k2+k3+k4)*px = 0
    (-k2)*(qx-px)+(-k3)*(rx-px)+(-k4)*(sx-px) = 0
    (-k2)*(qy-py)+(-k3)*(ry-py)+(-k4)*(sy-py) = -(k1*py+k2*qy+k3*ry+k4*sy)+(k1+k2+k3+k4)*py
    -(k1*py+k2*qy+k3*ry+k4*sy)+(k1+k2+k3+k4)*py = 0
    (-k2)*(qy-py)+(-k3)*(ry-py)+(-k4)*(sy-py) = 0
    by thm one_three_certificate(-k2, -k3, -k4, qx-px, qy-py, rx-px, ry-py, sx-px, sy-py)
    0 = 1




thm nonzero_nonpositive_negative:
    ? forall x R:
        x != 0
        x <= 0
        =>:
            x < 0
    by contra:
        ? x < 0
        x >= 0
        x = 0
        impossible x != 0
    x < 0




thm negative_negation_positive_20:
    ? forall x R:
        x < 0
        =>:
            -x > 0
    0 - x > 0 - 0
    0 - x = -x
    0 - 0 = 0
    -x > 0

thm positive_negation_negative_20:
    ? forall x R:
        x > 0
        =>:
            -x < 0
    0 - x < 0 - 0
    0 - x = -x
    0 - 0 = 0
    -x < 0

thm nonzero_negation_20:
    ? forall x R:
        x != 0
        =>:
            -x != 0
    by contra:
        ? -x != 0
        -x = 0
        (-x) + x = 0 + x
        (-x) + x = 0
        0 + x = x
        0 + x = 0
        x = 0
        impossible x != 0

thm affine_all_angles_impossible:
    ? forall k1, k2, k3, k4, px, py, qx, qy, rx, ry, sx, sy R:
        k1 > 0
        k2 != 0
        k3 != 0
        k4 != 0
        k1+k2+k3+k4 = 0
        k1*px+k2*qx+k3*rx+k4*sx = 0
        k1*py+k2*qy+k3*ry+k4*sy = 0
        (qx-px)*(rx-px)+(qy-py)*(ry-py) > 0
        (qx-px)*(sx-px)+(qy-py)*(sy-py) > 0
        (rx-px)*(sx-px)+(ry-py)*(sy-py) > 0
        (px-qx)*(rx-qx)+(py-qy)*(ry-qy) > 0
        (px-qx)*(sx-qx)+(py-qy)*(sy-qy) > 0
        (rx-qx)*(sx-qx)+(ry-qy)*(sy-qy) > 0
        (px-rx)*(qx-rx)+(py-ry)*(qy-ry) > 0
        (px-rx)*(sx-rx)+(py-ry)*(sy-ry) > 0
        (qx-rx)*(sx-rx)+(qy-ry)*(sy-ry) > 0
        (px-sx)*(qx-sx)+(py-sy)*(qy-sy) > 0
        (px-sx)*(rx-sx)+(py-sy)*(ry-sy) > 0
        (qx-sx)*(rx-sx)+(qy-sy)*(ry-sy) > 0
        =>:
            0 = 1
    by thm positive_negation_negative_20(k1)
    by cases:
        ? 0 = 1
        case k2 > 0:
            by thm positive_negation_negative_20(k2)
            by cases:
                ? 0 = 1
                case k3 > 0:
                    by thm positive_negation_negative_20(k3)
                    by cases:
                        ? 0 = 1
                        case k4 > 0:
                            by thm positive_negation_negative_20(k4)
                            0 < k1
                            0 < k2
                            0 < k3
                            0 < k4
                            0 < k1+k2
                            0 < k1+k2+k3
                            k1+k2+k3+k4 > 0
                            impossible k1+k2+k3+k4 = 0
                        case k4 <= 0:
                            by thm nonzero_nonpositive_negative(k4)
                            k4 < 0
                            by thm negative_negation_positive_20(k4)
                            (-k4)+(-k1)+(-k2)+(-k3) = -(k1+k2+k3+k4)
                            -(k1+k2+k3+k4) = 0
                            (-k4)*sx+(-k1)*px+(-k2)*qx+(-k3)*rx = -(k1*px+k2*qx+k3*rx+k4*sx)
                            -(k1*px+k2*qx+k3*rx+k4*sx) = 0
                            (-k4)*sy+(-k1)*py+(-k2)*qy+(-k3)*ry = -(k1*py+k2*qy+k3*ry+k4*sy)
                            -(k1*py+k2*qy+k3*ry+k4*sy) = 0
                            by thm affine_case_mmm(-k4, -k1, -k2, -k3, sx, sy, px, py, qx, qy, rx, ry)
                            0 = 1
                case k3 <= 0:
                    by thm nonzero_nonpositive_negative(k3)
                    k3 < 0
                    by thm negative_negation_positive_20(k3)
                    by cases:
                        ? 0 = 1
                        case k4 > 0:
                            by thm positive_negation_negative_20(k4)
                            (-k3)+(-k1)+(-k2)+(-k4) = -(k1+k2+k3+k4)
                            -(k1+k2+k3+k4) = 0
                            (-k3)*rx+(-k1)*px+(-k2)*qx+(-k4)*sx = -(k1*px+k2*qx+k3*rx+k4*sx)
                            -(k1*px+k2*qx+k3*rx+k4*sx) = 0
                            (-k3)*ry+(-k1)*py+(-k2)*qy+(-k4)*sy = -(k1*py+k2*qy+k3*ry+k4*sy)
                            -(k1*py+k2*qy+k3*ry+k4*sy) = 0
                            by thm affine_case_mmm(-k3, -k1, -k2, -k4, rx, ry, px, py, qx, qy, sx, sy)
                            0 = 1
                        case k4 <= 0:
                            by thm nonzero_nonpositive_negative(k4)
                            k4 < 0
                            by thm negative_negation_positive_20(k4)
                            (k1+k2)-((-k3)+(-k4)) = k1+k2+k3+k4
                            (k1+k2)-((-k3)+(-k4)) = 0
                            k1 + k2 = -k3 + -k4
                            (k1*px+k2*qx)-((-k3)*rx+(-k4)*sx) = k1*px+k2*qx+k3*rx+k4*sx
                            (k1*px+k2*qx)-((-k3)*rx+(-k4)*sx) = 0
                            k1*px + k2*qx = (-k3)*rx + (-k4)*sx
                            (k1*py+k2*qy)-((-k3)*ry+(-k4)*sy) = k1*py+k2*qy+k3*ry+k4*sy
                            (k1*py+k2*qy)-((-k3)*ry+(-k4)*sy) = 0
                            k1*py + k2*qy = (-k3)*ry + (-k4)*sy
                            by thm two_two_affine_certificate(k1, k2, -k3, -k4, px, py, rx, ry, qx, qy, sx, sy)
                            0 = 1
        case k2 <= 0:
            by thm nonzero_nonpositive_negative(k2)
            k2 < 0
            by thm negative_negation_positive_20(k2)
            by cases:
                ? 0 = 1
                case k3 > 0:
                    by thm positive_negation_negative_20(k3)
                    by cases:
                        ? 0 = 1
                        case k4 > 0:
                            by thm positive_negation_negative_20(k4)
                            (-k2)+(-k1)+(-k3)+(-k4) = -(k1+k2+k3+k4)
                            -(k1+k2+k3+k4) = 0
                            (-k2)*qx+(-k1)*px+(-k3)*rx+(-k4)*sx = -(k1*px+k2*qx+k3*rx+k4*sx)
                            -(k1*px+k2*qx+k3*rx+k4*sx) = 0
                            (-k2)*qy+(-k1)*py+(-k3)*ry+(-k4)*sy = -(k1*py+k2*qy+k3*ry+k4*sy)
                            -(k1*py+k2*qy+k3*ry+k4*sy) = 0
                            by thm affine_case_mmm(-k2, -k1, -k3, -k4, qx, qy, px, py, rx, ry, sx, sy)
                            0 = 1
                        case k4 <= 0:
                            by thm nonzero_nonpositive_negative(k4)
                            k4 < 0
                            by thm negative_negation_positive_20(k4)
                            (k1+k3)-((-k2)+(-k4)) = k1+k2+k3+k4
                            (k1+k3)-((-k2)+(-k4)) = 0
                            k1 + k3 = -k2 + -k4
                            (k1*px+k3*rx)-((-k2)*qx+(-k4)*sx) = k1*px+k2*qx+k3*rx+k4*sx
                            (k1*px+k3*rx)-((-k2)*qx+(-k4)*sx) = 0
                            k1*px + k3*rx = (-k2)*qx + (-k4)*sx
                            (k1*py+k3*ry)-((-k2)*qy+(-k4)*sy) = k1*py+k2*qy+k3*ry+k4*sy
                            (k1*py+k3*ry)-((-k2)*qy+(-k4)*sy) = 0
                            k1*py + k3*ry = (-k2)*qy + (-k4)*sy
                            by thm two_two_affine_certificate(k1, k3, -k2, -k4, px, py, qx, qy, rx, ry, sx, sy)
                            0 = 1
                case k3 <= 0:
                    by thm nonzero_nonpositive_negative(k3)
                    k3 < 0
                    by thm negative_negation_positive_20(k3)
                    by cases:
                        ? 0 = 1
                        case k4 > 0:
                            by thm positive_negation_negative_20(k4)
                            (k1+k4)-((-k2)+(-k3)) = k1+k2+k3+k4
                            (k1+k4)-((-k2)+(-k3)) = 0
                            k1 + k4 = -k2 + -k3
                            (k1*px+k4*sx)-((-k2)*qx+(-k3)*rx) = k1*px+k2*qx+k3*rx+k4*sx
                            (k1*px+k4*sx)-((-k2)*qx+(-k3)*rx) = 0
                            k1*px + k4*sx = (-k2)*qx + (-k3)*rx
                            (k1*py+k4*sy)-((-k2)*qy+(-k3)*ry) = k1*py+k2*qy+k3*ry+k4*sy
                            (k1*py+k4*sy)-((-k2)*qy+(-k3)*ry) = 0
                            k1*py + k4*sy = (-k2)*qy + (-k3)*ry
                            by thm two_two_affine_certificate(k1, k4, -k2, -k3, px, py, qx, qy, sx, sy, rx, ry)
                            0 = 1
                        case k4 <= 0:
                            by thm nonzero_nonpositive_negative(k4)
                            k4 < 0
                            by thm negative_negation_positive_20(k4)
                            by thm affine_case_mmm(k1, k2, k3, k4, px, py, qx, qy, rx, ry, sx, sy)
                            0 = 1

# Remove the arbitrary orientation of the affine dependence: if k1 is
# negative, negate all four coefficients before applying the sign lemma.


thm affine_all_nonzero_all_angles_impossible:
    ? forall k1, k2, k3, k4, px, py, qx, qy, rx, ry, sx, sy R:
        k1 != 0
        k2 != 0
        k3 != 0
        k4 != 0
        k1+k2+k3+k4 = 0
        k1*px+k2*qx+k3*rx+k4*sx = 0
        k1*py+k2*qy+k3*ry+k4*sy = 0
        (qx-px)*(rx-px)+(qy-py)*(ry-py) > 0
        (qx-px)*(sx-px)+(qy-py)*(sy-py) > 0
        (rx-px)*(sx-px)+(ry-py)*(sy-py) > 0
        (px-qx)*(rx-qx)+(py-qy)*(ry-qy) > 0
        (px-qx)*(sx-qx)+(py-qy)*(sy-qy) > 0
        (rx-qx)*(sx-qx)+(ry-qy)*(sy-qy) > 0
        (px-rx)*(qx-rx)+(py-ry)*(qy-ry) > 0
        (px-rx)*(sx-rx)+(py-ry)*(sy-ry) > 0
        (qx-rx)*(sx-rx)+(qy-ry)*(sy-ry) > 0
        (px-sx)*(qx-sx)+(py-sy)*(qy-sy) > 0
        (px-sx)*(rx-sx)+(py-sy)*(ry-sy) > 0
        (qx-sx)*(rx-sx)+(qy-sy)*(ry-sy) > 0
        =>:
            0 = 1
    by cases:
        ? 0 = 1
        case k1 > 0:
            by thm positive_negation_negative_20(k1)
            by thm affine_all_angles_impossible(k1, k2, k3, k4, px, py, qx, qy, rx, ry, sx, sy)
            0 = 1
        case k1 <= 0:
            by thm nonzero_nonpositive_negative(k1)
            k1 < 0
            by thm negative_negation_positive_20(k1)
            -k1 > 0
            by thm nonzero_negation_20(k2)
            -k2 != 0
            by thm nonzero_negation_20(k3)
            -k3 != 0
            by thm nonzero_negation_20(k4)
            -k4 != 0
            (-k1)+(-k2)+(-k3)+(-k4) = -(k1+k2+k3+k4)
            -(k1+k2+k3+k4) = 0
            (-k1)*px+(-k2)*qx+(-k3)*rx+(-k4)*sx = -(k1*px+k2*qx+k3*rx+k4*sx)
            -(k1*px+k2*qx+k3*rx+k4*sx) = 0
            (-k1)*py+(-k2)*qy+(-k3)*ry+(-k4)*sy = -(k1*py+k2*qy+k3*ry+k4*sy)
            -(k1*py+k2*qy+k3*ry+k4*sy) = 0
            by thm affine_all_angles_impossible(-k1, -k2, -k3, -k4, px, py, qx, qy, rx, ry, sx, sy)
            0 = 1

# Four planar points with no collinear triple admit a nondegenerate affine
# dependence. The coefficients are the three 2x2 cofactors and their sum.


thm four_point_determinant_all_angles_impossible:
    ? forall px, py, qx, qy, rx, ry, sx, sy R:
        (rx-px)*(sy-py)-(ry-py)*(sx-px) != 0
        (sx-px)*(qy-py)-(sy-py)*(qx-px) != 0
        (qx-px)*(ry-py)-(qy-py)*(rx-px) != 0
        (rx-qx)*(sy-qy)-(ry-qy)*(sx-qx) != 0
        (qx-px)*(rx-px)+(qy-py)*(ry-py) > 0
        (qx-px)*(sx-px)+(qy-py)*(sy-py) > 0
        (rx-px)*(sx-px)+(ry-py)*(sy-py) > 0
        (px-qx)*(rx-qx)+(py-qy)*(ry-qy) > 0
        (px-qx)*(sx-qx)+(py-qy)*(sy-qy) > 0
        (rx-qx)*(sx-qx)+(ry-qy)*(sy-qy) > 0
        (px-rx)*(qx-rx)+(py-ry)*(qy-ry) > 0
        (px-rx)*(sx-rx)+(py-ry)*(sy-ry) > 0
        (qx-rx)*(sx-rx)+(qy-ry)*(sy-ry) > 0
        (px-sx)*(qx-sx)+(py-sy)*(qy-sy) > 0
        (px-sx)*(rx-sx)+(py-sy)*(ry-sy) > 0
        (qx-sx)*(rx-sx)+(qy-sy)*(ry-sy) > 0
        =>:
            0 = 1
    have cofa R = (rx-px)*(sy-py)-(ry-py)*(sx-px)
    have cofb R = (sx-px)*(qy-py)-(sy-py)*(qx-px)
    have cofc R = (qx-px)*(ry-py)-(qy-py)*(rx-px)
    cofa != 0
    cofb != 0
    cofc != 0
    cofa+cofb+cofc = ((rx-px)*(sy-py)-(ry-py)*(sx-px))+((sx-px)*(qy-py)-(sy-py)*(qx-px))+((qx-px)*(ry-py)-(qy-py)*(rx-px))
    ((rx-px)*(sy-py)-(ry-py)*(sx-px))+((sx-px)*(qy-py)-(sy-py)*(qx-px))+((qx-px)*(ry-py)-(qy-py)*(rx-px)) = (rx-qx)*(sy-qy)-(ry-qy)*(sx-qx)
    cofa+cofb+cofc = (rx-qx)*(sy-qy)-(ry-qy)*(sx-qx)
    cofa+cofb+cofc != 0
    by thm nonzero_negation_20(cofa+cofb+cofc)
    -(cofa+cofb+cofc) != 0
    (-(cofa+cofb+cofc))+cofa+cofb+cofc = 0
    cofa*(qx-px)+cofb*(rx-px)+cofc*(sx-px) = ((rx-px)*(sy-py)-(ry-py)*(sx-px))*(qx-px)+((sx-px)*(qy-py)-(sy-py)*(qx-px))*(rx-px)+((qx-px)*(ry-py)-(qy-py)*(rx-px))*(sx-px)
    ((rx-px)*(sy-py)-(ry-py)*(sx-px))*(qx-px)+((sx-px)*(qy-py)-(sy-py)*(qx-px))*(rx-px)+((qx-px)*(ry-py)-(qy-py)*(rx-px))*(sx-px) = 0
    cofa*(qx-px)+cofb*(rx-px)+cofc*(sx-px) = 0
    cofa*(qy-py)+cofb*(ry-py)+cofc*(sy-py) = ((rx-px)*(sy-py)-(ry-py)*(sx-px))*(qy-py)+((sx-px)*(qy-py)-(sy-py)*(qx-px))*(ry-py)+((qx-px)*(ry-py)-(qy-py)*(rx-px))*(sy-py)
    ((rx-px)*(sy-py)-(ry-py)*(sx-px))*(qy-py)+((sx-px)*(qy-py)-(sy-py)*(qx-px))*(ry-py)+((qx-px)*(ry-py)-(qy-py)*(rx-px))*(sy-py) = 0
    cofa*(qy-py)+cofb*(ry-py)+cofc*(sy-py) = 0
    (-(cofa+cofb+cofc))*px+cofa*qx+cofb*rx+cofc*sx = cofa*(qx-px)+cofb*(rx-px)+cofc*(sx-px)
    (-(cofa+cofb+cofc))*px+cofa*qx+cofb*rx+cofc*sx = 0
    (-(cofa+cofb+cofc))*py+cofa*qy+cofb*ry+cofc*sy = cofa*(qy-py)+cofb*(ry-py)+cofc*(sy-py)
    (-(cofa+cofb+cofc))*py+cofa*qy+cofb*ry+cofc*sy = 0
    by thm affine_all_nonzero_all_angles_impossible(-(cofa+cofb+cofc), cofa, cofb, cofc, px, py, qx, qy, rx, ry, sx, sy)
    0 = 1




have fn vec(A, B cart(R, R)) cart(R, R) = (B(1) - A(1), B(2) - A(2))

# Dot product.

have fn dot(u, v cart(R, R)) R = u(1) * v(1) + u(2) * v(2)

# 2D determinant (signed parallelogram area / cross product z-component).

have fn det2(u, v cart(R, R)) R = u(1) * v(2) - u(2) * v(1)

# Squared Euclidean distance |ab|^2 (avoids square roots).

prop is_collinear(p, q, r cart(R, R)):
    det2(vec(p, q), vec(p, r)) = 0

# Segments ab and cd have equal length.

prop is_acute_triangle(p1 cart(R, R), p2 cart(R, R), p3 cart(R, R)):
    # Three points must be distinct
    not p1 = p2
    not p2 = p3
    not p1 = p3
    # Angle at p1 is acute
    dot(vec(p1, p2), vec(p1, p3)) > 0
    # Angle at p2 is acute
    dot(vec(p2, p1), vec(p2, p3)) > 0
    # Angle at p3 is acute
    dot(vec(p3, p1), vec(p3, p2)) > 0


prop fixed_indexed_subfamily(U, D set, S, T finite_set, F fn(K D) power_set(U)):
    S $subset U
    T $subset D
    forall K T:
        F(K) $subset S


prop fixed_unique_cover_of(U, D set, S, T finite_set, F fn(K D) power_set(U)):
    $fixed_indexed_subfamily(U, D, S, T, F)
    T $subset D
    forall x S:
        exist! K T st {x $in F(K)}


thm fixed_indexed_subfamily_intro:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U):
        S $subset U
        T $subset D
        forall K T:
            F(K) $subset S
        =>:
            $fixed_indexed_subfamily(U, D, S, T, F)
    S $subset U
    T $subset D
    forall K T:
        F(K) $subset S
    by def:
        ? $fixed_indexed_subfamily(U, D, S, T, F)


thm fixed_unique_cover_distinct_fibers_are_disjoint:
    ? forall U, D set, S, T finite_set, F fn(K D) power_set(U), K1, K2 T:
        T $subset D
        $fixed_unique_cover_of(U, D, S, T, F)
        K1 != K2
        =>:
            intersect(F(K1), F(K2)) = {}
    $fixed_indexed_subfamily(U, D, S, T, F)
    forall x S:
        exist! K0 T st {x $in F(K0)}
    by extension:
        ? intersect(F(K1), F(K2)) = {}
        claim:
            ? forall x intersect(F(K1), F(K2)):
                x $in {}
            by contra:
                ? x $in {}
                not x $in {}
                x $in F(K1)
                x $in F(K2)
                F(K1) $subset S
                x $in S
                exist! K0 T st {x $in F(K0)}
                obtain K0 from exist! K0 T st {x $in F(K0)}
                K0 = K1
                K0 = K2
                K1 = K2
                impossible K1 != K2
        claim:
            ? forall x {}:
                x $in intersect(F(K1), F(K2))
            by contra:
                ? x $in intersect(F(K1), F(K2))
                x $in {}
                impossible x $in {}

        by def:
            ? intersect(F(K1), F(K2)) $subset {}
        {} $subset intersect(F(K1), F(K2))

thm fixed_unique_cover_remove_inserted_index:
    ? forall U, D set, A, I finite_set, K D, F fn(L D) power_set(U):
        not K $in I
        $fixed_unique_cover_of(U, D, A, union({K}, I), F)
        =>:
            $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)
    $fixed_indexed_subfamily(U, D, A, union({K}, I), F)
    claim:
        ? $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
        set_minus(A, F(K)) $subset A
        A $subset U
        set_minus(A, F(K)) $subset U
        I $subset union({K}, I)
        union({K}, I) $subset D
        by def:
            ? I $subset D
        I $subset D
        claim:
            ? forall L I:
                F(L) $subset set_minus(A, F(K))
            L $in union({K}, I)
            F(L) $subset A
            L != K
            by thm fixed_unique_cover_distinct_fibers_are_disjoint(U, D, A, union({K}, I), F, L, K)
            intersect(F(L), F(K)) = {}
            claim:
                ? forall x F(L):
                    x $in set_minus(A, F(K))
                x $in A
                claim:
                    ? not x $in F(K)
                    by contra:
                        ? not x $in F(K)
                        x $in F(K)
                        x $in intersect(F(L), F(K))
                        x $in {}
                        impossible not x $in {}
            by def:
                ? F(L) $subset set_minus(A, F(K))
        by def:
            ? $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
    by def:
        ? $fixed_indexed_subfamily(U, D, set_minus(A, F(K)), I, F)
    claim:
        ? forall x set_minus(A, F(K)):
            exist! L I st {x $in F(L)}
        x $in A
        not x $in F(K)
        exist! L0 union({K}, I) st {x $in F(L0)}
        obtain L0 from exist! L0 union({K}, I) st {x $in F(L0)}
        claim:
            ? L0 $in I
            L0 $in {K} or L0 $in I
            by cases:
                ? L0 $in I
                case L0 $in {K}:
                    L0 = K
                    x $in F(L0)
                    F(L0) = F(K)
                    x $in F(K)
                    impossible not x $in F(K)
                case L0 $in I:
                    L0 $in I
        witness exist! L I st {x $in F(L)} from L0:
            x $in F(L0)
            forall L1, L2 I:
                x $in F(L1)
                x $in F(L2)
                =>:
                    L1 $in union({K}, I)
                    L2 $in union({K}, I)
                    exist! L3 union({K}, I) st {x $in F(L3)}
                    L1 = L2
    by def:
        ? $fixed_unique_cover_of(U, D, set_minus(A, F(K)), I, F)


thm finite_set_size_disjoint_union_fixed_cover:
    ? forall A, B finite_set:
        intersect(A, B) = {}
        =>:
            finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B)
    intersect(A, B) = {}
    finite_set_size(intersect(A, B)) = finite_set_size({}) = 0
    finite_set_size(union(A, B)) = finite_set_size(A) + finite_set_size(B) - finite_set_size(intersect(A, B)) = finite_set_size(A) + finite_set_size(B)



prop fixed_unique_cover_constant_size_holds(U, D set, T finite_set, n N):
    forall S finite_set, F fn(K D) power_set(U):
        $fixed_unique_cover_of(U, D, S, T, F)
        T $subset D
        forall K T:
            $is_finite_set(F(K))
        forall K T:
            $is_finite_set(F(K))
            =>:
                finite_set_size(F(K)) = n
        =>:
            finite_set_size(S) = finite_set_size(T) * n


thm finite_successor_decomposition_20:
    ? forall m N,T finite_set:
        finite_set_size(T) = m + 1
        =>:
            exist K T, I finite_set st {not K $in I, T = union({K},I), finite_set_size(I) = m}
    m + 1 > 0
    finite_set_size(T) > 0
    claim:
        ? exist K T st {K = K}
        by contra:
            ? exist K T st {K = K}
            claim:
                ? forall x T:
                    x $in {}
                x = x
                not x = x
                by contra:
                    ? x $in {}
                    impossible not x = x
            by extension:
                ? T = {}
                by def:
                    ? T $subset {}
                {} $subset T
            finite_set_size(T) = finite_set_size({})
            finite_set_size({}) = 0
            finite_set_size(T) = finite_set_size({}) = 0
            impossible finite_set_size(T) > 0
    obtain K from exist K T st {K = K}
    have I finite_set = set_minus(T,{K})
    K $in {K}
    by contra:
        ? not K $in I
        K $in I
        I = set_minus(T,{K})
        K $in set_minus(T,{K})
        not K $in {K}
        impossible K $in {K}
    by thm singleton_deletion_from_successor_size(m,T,K)
    finite_set_size(I) = finite_set_size(set_minus(T,{K}))
    finite_set_size(I) = finite_set_size(set_minus(T,{K})) = m
    finite_set_size(I) = m
    by extension:
        ? T = union({K},I)
        claim:
            ? forall x T:
                x $in union({K},I)
            x = K or x != K
            by cases:
                ? x $in union({K},I)
                case x = K:
                    x $in {K}
                    x $in union({K},I)
                case x != K:
                    not x $in {K}
                    x $in I
                    x $in union({K},I)
        claim:
            ? forall x union({K},I):
                x $in T
            x $in {K} or x $in I
            by cases:
                ? x $in T
                case x $in {K}:
                    K $in T
                    x = K
                    x $in T
                case x $in I:
                    I = set_minus(T,{K})
                    x $in set_minus(T,{K})
                    x $in T
        by def:
            ? T $subset union({K},I)
        by def:
            ? union({K},I) $subset T
    witness exist kk T, ii finite_set st {not kk $in ii, T = union({kk},ii), finite_set_size(ii) = m} from K,I

prop cardinality_product_20(A,T finite_set,n N):
    finite_set_size(A) = finite_set_size(T) * n

prop full_domain_indexed_family_20(U,D set,S,T finite_set,F fn(k D) power_set(U)):
    S $subset U
    T $subset D
    forall k D:
        k $in T
        =>:
            F(k) $subset S

prop full_domain_unique_cover_20(U,D set,S,T finite_set,F fn(k D) power_set(U)):
    $full_domain_indexed_family_20(U,D,S,T,F)
    T $subset D
    forall x S:
        exist! k D st {k $in T,x $in F(k)}

thm unique_cover_to_full_domain_20:
    ? forall U,D set,S,T finite_set,F fn(k D) power_set(U):
        $fixed_unique_cover_of(U,D,S,T,F)
        =>:
            $full_domain_unique_cover_20(U,D,S,T,F)
    $fixed_indexed_subfamily(U,D,S,T,F)
    S $subset U
    T $subset D
    claim:
        ? forall k D:
            k $in T
            =>:
                F(k) $subset S
        F(k) $subset S
    by def:
        ? $full_domain_indexed_family_20(U,D,S,T,F)
    claim:
        ? forall x S:
            exist! kk D st {kk $in T,x $in F(kk)}
        exist! k T st {x $in F(k)}
        obtain k from exist! k T st {x $in F(k)}
        k $in T
        k $in D
        x $in F(k)
        witness exist! kk D st {kk $in T,x $in F(kk)} from k:
            k $in T
            x $in F(k)
            claim:
                ? forall k1,k2 D:
                    k1 $in T
                    x $in F(k1)
                    k2 $in T
                    x $in F(k2)
                    =>:
                        k1=k2
                k1=k2
    by def:
        ? $full_domain_unique_cover_20(U,D,S,T,F)

thm full_domain_cover_to_unique_20:
    ? forall U,D set,S,T finite_set,F fn(k D) power_set(U):
        $full_domain_unique_cover_20(U,D,S,T,F)
        =>:
            $fixed_unique_cover_of(U,D,S,T,F)
    $full_domain_indexed_family_20(U,D,S,T,F)
    S $subset U
    T $subset D
    claim:
        ? forall k T:
            F(k) $subset S
        k $in D
        F(k) $subset S
    by def:
        ? $fixed_indexed_subfamily(U,D,S,T,F)
    claim:
        ? forall x S:
            exist! kk T st {x $in F(kk)}
        exist! k D st {k $in T,x $in F(k)}
        obtain k from exist! k D st {k $in T,x $in F(k)}
        k $in T
        x $in F(k)
        witness exist! kk T st {x $in F(kk)} from k:
            x $in F(k)
            claim:
                ? forall k1,k2 T:
                    x $in F(k1)
                    x $in F(k2)
                    =>:
                        k1=k2
                k1 $in D
                k2 $in D
                k1=k2
    by def:
        ? $fixed_unique_cover_of(U,D,S,T,F)

thm finite_set_size_over_fixed_unique_constant_cover:
    ? forall U,D set,T,A finite_set,n N,F fn(l D) power_set(U):
        $fixed_unique_cover_of(U,D,A,T,F)
        T $subset D
        forall z T:
            $is_finite_set(F(z))
        forall z T:
            $is_finite_set(F(z))
            =>:
                finite_set_size(F(z)) = n
        =>:
            finite_set_size(A) = finite_set_size(T) * n
    by thm unique_cover_to_full_domain_20(U,D,A,T,F)
    prop fixed_cover_inducts_20(mm N):
        forall J,B finite_set:
            finite_set_size(J) = mm
            J $subset T
            J $subset D
            $full_domain_unique_cover_20(U,D,B,J,F)
            =>:
                $cardinality_product_20(B,J,n)
    by induc m from 0:
        ? $fixed_cover_inducts_20(m)
        ? from m = 0:
            claim:
                ? forall J,B finite_set:
                    finite_set_size(J) = 0
                    J $subset T
                    J $subset D
                    $full_domain_unique_cover_20(U,D,B,J,F)
                    =>:
                        $cardinality_product_20(B,J,n)
                by thm full_domain_cover_to_unique_20(U,D,B,J,F)
                finite_set_size(J) = finite_set_size({})
                {} $subset J
                J = {}
                by extension:
                    ? B = {}
                    claim:
                        ? forall x B:
                            x $in {}
                        by contra:
                            ? x $in {}
                            exist! k J st {x $in F(k)}
                            obtain k from exist! k J st {x $in F(k)}
                            k $in J
                            J = {}
                            k $in {}
                            impossible k $in {}
                    by def:
                        ? B $subset {}
                    {} $subset B
                finite_set_size(B) = finite_set_size({})
                finite_set_size({}) = 0
                finite_set_size(J) = 0
                0 * n = 0
                finite_set_size(B) = finite_set_size({}) = 0 = 0 * n = finite_set_size(J) * n
                by def:
                    ? $cardinality_product_20(B,J,n)
            release thm fn_set_member(F,fn(l D) power_set(U))
            F $in fn(l D) power_set(U)
            by def:
                ? $fixed_cover_inducts_20(0)
        ? induc:
            m $in N
            $fixed_cover_inducts_20(m)
            claim:
                ? forall J,B finite_set:
                    finite_set_size(J) = m + 1
                    J $subset T
                    J $subset D
                    $full_domain_unique_cover_20(U,D,B,J,F)
                    =>:
                        $cardinality_product_20(B,J,n)
                by thm full_domain_cover_to_unique_20(U,D,B,J,F)
                by thm finite_successor_decomposition_20(m,J)
                obtain K,I from exist k J,ii finite_set st {not k $in ii,J = union({k},ii),finite_set_size(ii) = m}
                $is_finite_set(I)
                not K $in I
                J = union({K},I)
                finite_set_size(I) = m
                K $in J
                K $in D
                I $subset union({K},I)
                union({K},I) = J
                I $subset J
                I $subset D
                $fixed_unique_cover_of(U,D,B,union({K},I),F)
                by thm fixed_unique_cover_remove_inserted_index(U,D,B,I,K,F)
                have B0 finite_set = set_minus(B,F(K))
                $fixed_unique_cover_of(U,D,B0,I,F)
                I $subset T
                by thm unique_cover_to_full_domain_20(U,D,B0,I,F)
                $cardinality_product_20(B0,I,n)
                finite_set_size(B0) = finite_set_size(I) * n
                K $in T
                $is_finite_set(F(K))
                finite_set_size(F(K)) = n
                $fixed_indexed_subfamily(U,D,B,J,F)
                F(K) $subset B
                by extension:
                    ? B = union(F(K),B0)
                    claim:
                        ? forall x B:
                            x $in union(F(K),B0)
                        x $in F(K) or not x $in F(K)
                        by cases:
                            ? x $in union(F(K),B0)
                            case x $in F(K):
                                x $in union(F(K),B0)
                            case not x $in F(K):
                                x $in set_minus(B,F(K))
                                x $in B0
                                x $in union(F(K),B0)
                    claim:
                        ? forall x union(F(K),B0):
                            x $in B
                        x $in F(K) or x $in B0
                        by cases:
                            ? x $in B
                            case x $in F(K):
                                x $in B
                            case x $in B0:
                                B0 = set_minus(B,F(K))
                                x $in set_minus(B,F(K))
                                x $in B
                    by def:
                        ? B $subset union(F(K),B0)
                    by def:
                        ? union(F(K),B0) $subset B
                by extension:
                    ? intersect(F(K),B0) = {}
                    claim:
                        ? forall x intersect(F(K),B0):
                            x $in {}
                        x $in F(K)
                        x $in B0
                        B0 = set_minus(B,F(K))
                        x $in set_minus(B,F(K))
                        not x $in F(K)
                        by contra:
                            ? x $in {}
                            impossible not x $in F(K)
                    by def:
                        ? intersect(F(K),B0) $subset {}
                    {} $subset intersect(F(K),B0)
                by thm finite_set_size_disjoint_union_fixed_cover(F(K),B0)
                finite_set_size(B) = finite_set_size(union(F(K),B0))
                finite_set_size(B) = finite_set_size(union(F(K),B0)) = finite_set_size(F(K)) + finite_set_size(B0)
                finite_set_size(F(K)) + finite_set_size(B0) = n + finite_set_size(I) * n
                n + finite_set_size(I) * n = (finite_set_size(I) + 1) * n
                finite_set_size(I) = m
                finite_set_size(I) + 1 = m + 1
                finite_set_size(J) = m + 1
                (finite_set_size(I) + 1) * n = (m + 1) * n
                (m + 1) * n = finite_set_size(J) * n
                finite_set_size(B) = finite_set_size(F(K)) + finite_set_size(B0) = n + finite_set_size(I) * n = (finite_set_size(I) + 1) * n = (m + 1) * n = finite_set_size(J) * n
                by def:
                    ? $cardinality_product_20(B,J,n)
            release thm fn_set_member(F,fn(l D) power_set(U))
            F $in fn(l D) power_set(U)
            by def:
                ? $fixed_cover_inducts_20(m+1)
    finite_set_size(T) $in N
    finite_set_size(T) $in Z
    0 <= finite_set_size(T)
    $fixed_cover_inducts_20(finite_set_size(T))
    finite_set_size(T) = finite_set_size(T)
    T $subset T
    $cardinality_product_20(A,T,n)
    finite_set_size(A) = finite_set_size(T) * n

thm vector_projections_20:
    ? forall a,b cart(R,R):
        vec(a,b)(1) = b(1)-a(1)
        vec(a,b)(2) = b(2)-a(2)
    vec(a,b) = (b(1)-a(1),b(2)-a(2))
    vec(a,b)(1) = (b(1)-a(1),b(2)-a(2))(1) = b(1)-a(1)
    vec(a,b)(2) = (b(1)-a(1),b(2)-a(2))(2) = b(2)-a(2)

thm dot_coordinates_20:
    ? forall a,b,c,d cart(R,R):
        dot(vec(a,b),vec(c,d)) = (b(1)-a(1))*(d(1)-c(1))+(b(2)-a(2))*(d(2)-c(2))
    by thm vector_projections_20(a,b)
    by thm vector_projections_20(c,d)
    dot(vec(a,b),vec(c,d)) = vec(a,b)(1)*vec(c,d)(1)+vec(a,b)(2)*vec(c,d)(2) = (b(1)-a(1))*(d(1)-c(1))+(b(2)-a(2))*(d(2)-c(2))

thm determinant_coordinates_20:
    ? forall a,b,c cart(R,R):
        det2(vec(a,b),vec(a,c)) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1))
    vec(a,b) = (b(1)-a(1),b(2)-a(2))
    vec(a,c) = (c(1)-a(1),c(2)-a(2))
    vec(a,b)(1) = (b(1)-a(1),b(2)-a(2))(1) = b(1)-a(1)
    vec(a,b)(2) = (b(1)-a(1),b(2)-a(2))(2) = b(2)-a(2)
    vec(a,c)(1) = (c(1)-a(1),c(2)-a(2))(1) = c(1)-a(1)
    vec(a,c)(2) = (c(1)-a(1),c(2)-a(2))(2) = c(2)-a(2)
    det2(vec(a,b),vec(a,c)) = vec(a,b)(1)*vec(a,c)(2)-vec(a,b)(2)*vec(a,c)(1) = (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1))


algo acute_flag_20(p,q,r cart(R,R)) N by cases:
    case $is_acute_triangle(p,q,r): 1
    case not $is_acute_triangle(p,q,r): 0

thm acute_flag_zero_or_one_20:
    ? forall p,q,r cart(R,R):
        acute_flag_20(p,q,r) = 0 or acute_flag_20(p,q,r) = 1
    by cases:
        ? acute_flag_20(p,q,r) = 0 or acute_flag_20(p,q,r) = 1
        case $is_acute_triangle(p,q,r):
            acute_flag_20(p,q,r) = 1
        case not $is_acute_triangle(p,q,r):
            acute_flag_20(p,q,r) = 0

thm integer_above_seven_is_at_least_eight_20:
    ? forall t Z:
        t > 7
        =>:
            8 <= t
    7 $in Z
    t <= 7 or t >= 7 + 1
    by cases:
        ? 8 <= t
        case t <= 7:
            by contra:
                ? 8 <= t
                impossible t <= 7
        case t >= 7 + 1:
            7 + 1 = 8
            8 <= 7 + 1
            7 + 1 <= t
            8 <= t

thm five_quadruple_bounds_give_seven_20:
    ? forall f123,f124,f125,f134,f135,f145,f234,f235,f245,f345 N:
        f123 + f124 + f134 + f234 <= 3
        f123 + f125 + f135 + f235 <= 3
        f124 + f125 + f145 + f245 <= 3
        f134 + f135 + f145 + f345 <= 3
        f234 + f235 + f245 + f345 <= 3
        =>:
            f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345 <= 7
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) <= 3 + 3
    3 + 3 = 6
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) <= 6
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) <= 6 + 3
    6 + 3 = 9
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) <= 9
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) + (f134 + f135 + f145 + f345) <= 9 + 3
    9 + 3 = 12
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) + (f134 + f135 + f145 + f345) <= 12
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) + (f134 + f135 + f145 + f345) + (f234 + f235 + f245 + f345) <= 12 + 3
    12 + 3 = 15
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) + (f134 + f135 + f145 + f345) + (f234 + f235 + f245 + f345) <= 15
    (f123 + f124 + f134 + f234) + (f123 + f125 + f135 + f235) + (f124 + f125 + f145 + f245) + (f134 + f135 + f145 + f345) + (f234 + f235 + f245 + f345) = 2 * (f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345)
    2 * (f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345) <= 15
    f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345 $in N
    by contra:
        ? f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345 <= 7
        f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345 > 7
        f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345 $in Z
        by thm integer_above_seven_is_at_least_eight_20(f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345)
        8 <= f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345
        f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345 >= 8
        0 <= 2
        8 <= f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345
        2 * 8 <= 2 * (f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345)
        2 * 8 = 16
        16 <= 2 * (f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345)
        15 < 16
        15 < 2 * (f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345)
        impossible 2 * (f123 + f124 + f125 + f134 + f135 + f145 + f234 + f235 + f245 + f345) <= 15

thm noncollinear_determinant_nonzero_20:
    ? forall a,b,c cart(R,R):
        not $is_collinear(a,b,c)
        =>:
            (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) != 0
    by thm determinant_coordinates_20(a,b,c)
    by contra:
        ? (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) != 0
        (b(1)-a(1))*(c(2)-a(2))-(b(2)-a(2))*(c(1)-a(1)) = 0
        det2(vec(a,b),vec(a,c)) = 0
        by def:
            ? $is_collinear(a,b,c)
        impossible not $is_collinear(a,b,c)

thm acute_coordinate_angles_20:
    ? forall a,b,c cart(R,R):
        $is_acute_triangle(a,b,c)
        =>:
            (b(1)-a(1))*(c(1)-a(1))+(b(2)-a(2))*(c(2)-a(2)) > 0
            (a(1)-b(1))*(c(1)-b(1))+(a(2)-b(2))*(c(2)-b(2)) > 0
            (a(1)-c(1))*(b(1)-c(1))+(a(2)-c(2))*(b(2)-c(2)) > 0
    dot(vec(a,b),vec(a,c)) > 0
    dot(vec(b,a),vec(b,c)) > 0
    dot(vec(c,a),vec(c,b)) > 0
    by thm dot_coordinates_20(a,b,a,c)
    by thm dot_coordinates_20(b,a,b,c)
    by thm dot_coordinates_20(c,a,c,b)
    (b(1)-a(1))*(c(1)-a(1))+(b(2)-a(2))*(c(2)-a(2)) > 0
    (a(1)-b(1))*(c(1)-b(1))+(a(2)-b(2))*(c(2)-b(2)) > 0
    (a(1)-c(1))*(b(1)-c(1))+(a(2)-c(2))*(b(2)-c(2)) > 0

thm four_acute_triangles_impossible_20:
    ? forall p,q,r,s cart(R,R):
        not $is_collinear(p,r,s)
        not $is_collinear(p,s,q)
        not $is_collinear(p,q,r)
        not $is_collinear(q,r,s)
        $is_acute_triangle(p,q,r)
        $is_acute_triangle(p,q,s)
        $is_acute_triangle(p,r,s)
        $is_acute_triangle(q,r,s)
        =>:
            0 = 1
    by thm noncollinear_determinant_nonzero_20(p,r,s)
    by thm noncollinear_determinant_nonzero_20(p,s,q)
    by thm noncollinear_determinant_nonzero_20(p,q,r)
    by thm noncollinear_determinant_nonzero_20(q,r,s)
    by thm acute_coordinate_angles_20(p,q,r)
    by thm acute_coordinate_angles_20(p,q,s)
    by thm acute_coordinate_angles_20(p,r,s)
    by thm acute_coordinate_angles_20(q,r,s)
    by thm four_point_determinant_all_angles_impossible(p(1),p(2),q(1),q(2),r(1),r(2),s(1),s(2))
    0 = 1

thm acute_flag_bounds_20:
    ? forall p,q,r cart(R,R):
        0 <= acute_flag_20(p,q,r)
        acute_flag_20(p,q,r) <= 1
    by thm acute_flag_zero_or_one_20(p,q,r)
    by cases:
        ? 0 <= acute_flag_20(p,q,r)
        case acute_flag_20(p,q,r) = 0:
            0 <= acute_flag_20(p,q,r)
        case acute_flag_20(p,q,r) = 1:
            0 <= acute_flag_20(p,q,r)
    by cases:
        ? acute_flag_20(p,q,r) <= 1
        case acute_flag_20(p,q,r) = 0:
            acute_flag_20(p,q,r) <= 1
        case acute_flag_20(p,q,r) = 1:
            acute_flag_20(p,q,r) <= 1

thm four_unit_bounds_with_zero_20:
    ? forall a,b,c,d R:
        a <= 1
        b <= 1
        c <= 1
        d <= 1
        a = 0 or b = 0 or c = 0 or d = 0
        =>:
            a+b+c+d <= 3
    by cases:
        ? a+b+c+d <= 3
        case a = 0:
            a <= 0
            a+b <= 0+1
            0+1 = 1
            a+b <= 1
            a+b+c <= 1+1
            1+1 = 2
            a+b+c <= 2
            a+b+c+d <= 2+1
            2+1 = 3
            a+b+c+d <= 3
        case b = 0:
            b <= 0
            a+b <= 1+0
            1+0 = 1
            a+b <= 1
            a+b+c <= 1+1
            1+1 = 2
            a+b+c <= 2
            a+b+c+d <= 2+1
            2+1 = 3
            a+b+c+d <= 3
        case c = 0:
            c <= 0
            a+b <= 1+1
            1+1 = 2
            a+b <= 2
            a+b+c <= 2+0
            2+0 = 2
            a+b+c <= 2
            a+b+c+d <= 2+1
            2+1 = 3
            a+b+c+d <= 3
        case d = 0:
            d <= 0
            a+b <= 1+1
            1+1 = 2
            a+b <= 2
            a+b+c <= 2+1
            2+1 = 3
            a+b+c <= 3
            a+b+c+d <= 3+0
            3+0 = 3
            a+b+c+d <= 3

thm four_point_acute_flag_bound_20:
    ? forall p,q,r,s cart(R,R):
        not $is_collinear(p,r,s)
        not $is_collinear(p,s,q)
        not $is_collinear(p,q,r)
        not $is_collinear(q,r,s)
        =>:
            acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
    by thm acute_flag_bounds_20(p,q,r)
    by thm acute_flag_bounds_20(p,q,s)
    by thm acute_flag_bounds_20(p,r,s)
    by thm acute_flag_bounds_20(q,r,s)
    by cases:
        ? acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
        case not $is_acute_triangle(p,q,r):
            acute_flag_20(p,q,r)=0
            acute_flag_20(p,q,r)=0 or acute_flag_20(p,q,s)=0 or acute_flag_20(p,r,s)=0 or acute_flag_20(q,r,s)=0
            by thm four_unit_bounds_with_zero_20(acute_flag_20(p,q,r),acute_flag_20(p,q,s),acute_flag_20(p,r,s),acute_flag_20(q,r,s))
            acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
        case $is_acute_triangle(p,q,r):
            by cases:
                ? acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                case not $is_acute_triangle(p,q,s):
                    acute_flag_20(p,q,s)=0
                    acute_flag_20(p,q,r)=0 or acute_flag_20(p,q,s)=0 or acute_flag_20(p,r,s)=0 or acute_flag_20(q,r,s)=0
                    by thm four_unit_bounds_with_zero_20(acute_flag_20(p,q,r),acute_flag_20(p,q,s),acute_flag_20(p,r,s),acute_flag_20(q,r,s))
                    acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                case $is_acute_triangle(p,q,s):
                    by cases:
                        ? acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                        case not $is_acute_triangle(p,r,s):
                            acute_flag_20(p,r,s)=0
                            acute_flag_20(p,q,r)=0 or acute_flag_20(p,q,s)=0 or acute_flag_20(p,r,s)=0 or acute_flag_20(q,r,s)=0
                            by thm four_unit_bounds_with_zero_20(acute_flag_20(p,q,r),acute_flag_20(p,q,s),acute_flag_20(p,r,s),acute_flag_20(q,r,s))
                            acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                        case $is_acute_triangle(p,r,s):
                            by cases:
                                ? acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                                case not $is_acute_triangle(q,r,s):
                                    acute_flag_20(q,r,s)=0
                                    acute_flag_20(p,q,r)=0 or acute_flag_20(p,q,s)=0 or acute_flag_20(p,r,s)=0 or acute_flag_20(q,r,s)=0
                                    by thm four_unit_bounds_with_zero_20(acute_flag_20(p,q,r),acute_flag_20(p,q,s),acute_flag_20(p,r,s),acute_flag_20(q,r,s))
                                    acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                                case $is_acute_triangle(q,r,s):
                                    by thm four_acute_triangles_impossible_20(p,q,r,s)
                                    0 = 1
                                    by contra:
                                        ? acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,r,s)+acute_flag_20(q,r,s) <= 3
                                        impossible 0 = 1

thm five_point_acute_flag_bound_20:
    ? forall p,q,r,s,t cart(R,R):
        not $is_collinear(p,r,s)
        not $is_collinear(p,s,q)
        not $is_collinear(p,q,r)
        not $is_collinear(q,r,s)
        not $is_collinear(p,r,t)
        not $is_collinear(p,t,q)
        not $is_collinear(q,r,t)
        not $is_collinear(p,s,t)
        not $is_collinear(p,q,s)
        not $is_collinear(q,s,t)
        not $is_collinear(p,t,r)
        not $is_collinear(r,s,t)
        not $is_collinear(q,t,r)
        =>:
            acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,q,t)+acute_flag_20(p,r,s)+acute_flag_20(p,r,t)+acute_flag_20(p,s,t)+acute_flag_20(q,r,s)+acute_flag_20(q,r,t)+acute_flag_20(q,s,t)+acute_flag_20(r,s,t) <= 7
    by thm four_point_acute_flag_bound_20(p,q,r,s)
    by thm four_point_acute_flag_bound_20(p,q,r,t)
    by thm four_point_acute_flag_bound_20(p,q,s,t)
    by thm four_point_acute_flag_bound_20(p,r,s,t)
    by thm four_point_acute_flag_bound_20(q,r,s,t)
    by thm five_quadruple_bounds_give_seven_20(acute_flag_20(p,q,r),acute_flag_20(p,q,s),acute_flag_20(p,q,t),acute_flag_20(p,r,s),acute_flag_20(p,r,t),acute_flag_20(p,s,t),acute_flag_20(q,r,s),acute_flag_20(q,r,t),acute_flag_20(q,s,t),acute_flag_20(r,s,t))
    acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,q,t)+acute_flag_20(p,r,s)+acute_flag_20(p,r,t)+acute_flag_20(p,s,t)+acute_flag_20(q,r,s)+acute_flag_20(q,r,t)+acute_flag_20(q,s,t)+acute_flag_20(r,s,t) <= 7

thm addition_congruence_20:
    ? forall x, x2, y, y2 R:
        x = x2
        y = y2
        =>:
            x + y = x2 + y2
    x - x2 = 0
    y - y2 = 0
    (x + y) - (x2 + y2) = (x - x2) + (y - y2)
    (x - x2) + (y - y2) = 0
    (x + y) - (x2 + y2) = 0
    x + y = x2 + y2

# A vector collinear with a unit direction is its scalar projection times
# that direction.  This converts the determinant form of collinearity into
# explicit component coordinates without choosing a special axis.

thm membership_flag_counts_intersection_20:
    ? forall X,A finite_set,f fn(x X) N:
        forall x X:
            x $in A
            =>:
                f(x)=1
        forall x X:
            not x $in A
            =>:
                f(x)=0
        =>:
            finite_set_sum(X,f)=finite_set_size(intersect(X,A))
    have I finite_set = intersect(X,A)
    have J finite_set = set_minus(X,A)
    claim:
        ? forall x I:
            x $in X
            x $in A
        x $in intersect(X,A)
        x $in X
        x $in A
    claim:
        ? forall x J:
            x $in X
            not x $in A
        x $in set_minus(X,A)
        x $in X
        not x $in A
    by extension:
        ? X=union(I,J)
        claim:
            ? forall x X:
                x $in union(I,J)
            by cases:
                ? x $in union(I,J)
                case x $in A:
                    x $in I
                    x $in union(I,J)
                case not x $in A:
                    x $in J
                    x $in union(I,J)
        claim:
            ? forall x union(I,J):
                x $in X
            by cases:
                ? x $in X
                case x $in I:
                    x $in X
                case x $in J:
                    x $in X
    I $subset X
    J $subset X
    by extension:
        ? intersect(I,J)={}
        claim:
            ? forall x intersect(I,J):
                x $in {}
            x $in I
            x $in J
            x $in A
            not x $in A
            by contra:
                ? x $in {}
                impossible x $in A
        claim:
            ? forall x {}:
                x $in intersect(I,J)
            by contra:
                ? x $in intersect(I,J)
                impossible x $in {}
    claim:
        ? forall x I:
            f(x)=1
        x $in X
        x $in A
        f(x)=1
    claim:
        ? forall x J:
            f(x)=0
        x $in X
        not x $in A
        f(x)=0
    claim:
        ? forall x union(I,J):
            x $in X
        by cases:
            ? x $in X
            case x $in I:
                x $in X
            case x $in J:
                x $in X
    release thm finite_set_sum_substitution(finite_set_sum(X,f),finite_set_sum(union(I,J),f))
    finite_set_sum(X,f) = finite_set_sum(union(I,J),f)
    finite_set_sum(union(I,J),f) = finite_set_sum(I,fn(x I) N {f(x)}) + finite_set_sum(J,fn(x J) N {f(x)})
    finite_set_sum(X,f) = finite_set_sum(union(I,J),f) = finite_set_sum(I,fn(x I) N {f(x)}) + finite_set_sum(J,fn(x J) N {f(x)})
    release thm finite_set_sum_substitution(finite_set_sum(I,fn(x I) N {f(x)}),finite_set_sum(I,fn(x I) N {1}))
    finite_set_sum(I,fn(x I) N {f(x)})=finite_set_sum(I,fn(x I) N {1})
    finite_set_sum(I,fn(x I) N {1})=finite_set_size(I)*1=finite_set_size(I)
    finite_set_sum(I,fn(x I) N {1})=finite_set_size(I)
    finite_set_sum(I,fn(x I) N {f(x)})=finite_set_sum(I,fn(x I) N {1})=finite_set_size(I)
    release thm finite_set_sum_substitution(finite_set_sum(J,fn(x J) N {f(x)}),finite_set_sum(J,fn(x J) N {0}))
    finite_set_sum(J,fn(x J) N {f(x)})=finite_set_sum(J,fn(x J) N {0})
    finite_set_sum(J,fn(x J) N {0})=finite_set_size(J)*0=0
    finite_set_sum(J,fn(x J) N {0})=0
    finite_set_sum(J,fn(x J) N {f(x)})=finite_set_sum(J,fn(x J) N {0})=0
    by thm addition_congruence_20(finite_set_sum(I,fn(x I) N {f(x)}),finite_set_size(I),finite_set_sum(J,fn(x J) N {f(x)}),0)
    finite_set_sum(I,fn(x I) N {f(x)}) + finite_set_sum(J,fn(x J) N {f(x)}) = finite_set_size(I)+0=finite_set_size(I)
    finite_set_sum(X,f) = finite_set_size(I)=finite_set_size(intersect(X,A))

thm uniform_incidence_bound_20:
    ? forall T,U finite_set,f fn(z cart(T,U)) N,m,n N:
        forall t T:
            finite_set_sum(U,fn(u U) N {f((t,u))})=m
        forall u U:
            finite_set_sum(T,fn(t T) N {f((t,u))})<=n
        =>:
            finite_set_size(T)*m<=finite_set_size(U)*n
    claim:
        ? forall t T:
            finite_set_sum(U,fn(u U) N {f((t,u))})=m
        finite_set_sum(U,fn(u U) N {f((t,u))})=m
    release thm finite_set_sum_substitution(finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})}),finite_set_sum(T,fn(t T) N {m}))
    finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(T,fn(t T) N {m})
    finite_set_sum(T,fn(t T) N {m})=finite_set_size(T)*m
    finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(T,fn(t T) N {m})=finite_set_size(T)*m
    finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})
    claim:
        ? forall u U:
            finite_set_sum(T,fn(t T) N {f((t,u))})<=n
        finite_set_sum(T,fn(t T) N {f((t,u))})<=n
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})}),finite_set_sum(U,fn(u U) N {n}))
    finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})<=finite_set_sum(U,fn(u U) N {n})
    finite_set_sum(U,fn(u U) N {n})=finite_set_size(U)*n
    finite_set_size(T)*m=finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})<=finite_set_sum(U,fn(u U) N {n})=finite_set_size(U)*n

thm empty_from_zero_cardinality_20:
    ? forall T finite_set:
        finite_set_size(T)=0
        =>:
            T={}
    by extension:
        ? T={}
        claim:
            ? forall x T:
                x $in {}
            {x} $subset T
            finite_set_size({x})=1
            finite_set_size({x})<=finite_set_size(T)
            finite_set_size(T)=0
            1<=0
            by contra:
                ? x $in {}
                impossible 1<=0
        {} $subset T

thm three_element_set_enumeration_20:
    ? forall T finite_set:
        finite_set_size(T)=3
        =>:
            exist a,b,c T st {a!=b, a!=c, b!=c, T={a,b,c}}
    by thm finite_successor_decomposition_20(2,T)
    obtain a,I1 from exist K T, I finite_set st {not K $in I, T=union({K},I), finite_set_size(I)=2}
    claim:
        ? forall z I1:
            z $in T
        z $in union({a},I1)
        z $in T
    I1 $subset T
    by thm finite_successor_decomposition_20(1,I1)
    obtain b,I2 from exist K I1, I finite_set st {not K $in I, I1=union({K},I), finite_set_size(I)=1}
    claim:
        ? forall z I2:
            z $in I1
        z $in union({b},I2)
        z $in I1
    I2 $subset I1
    I2 $subset T
    b $in T
    by thm finite_successor_decomposition_20(0,I2)
    obtain c,I3 from exist K I2, I finite_set st {not K $in I, I2=union({K},I), finite_set_size(I)=0}
    claim:
        ? forall z I3:
            z $in I2
        z $in union({c},I3)
        z $in I2
    I3 $subset I2
    I3 $subset T
    c $in T
    by thm empty_from_zero_cardinality_20(I3)
    I3={}
    b $in I1
    by contra:
        ? a!=b
        a=b
        a $in I1
        impossible not a $in I1
    c $in I1
    by contra:
        ? a!=c
        a=c
        a $in I1
        impossible not a $in I1
    c $in I2
    by contra:
        ? b!=c
        b=c
        b $in I2
        impossible not b $in I2
    by extension:
        ? T={a,b,c}
        claim:
            ? forall z T:
                z $in {a,b,c}
            z $in union({a},I1)
            z $in {a} or z $in I1
            by cases:
                ? z $in {a,b,c}
                case z $in {a}:
                    z=a
                    z $in {a,b,c}
                case z $in I1:
                    z $in union({b},I2)
                    z $in {b} or z $in I2
                    by cases:
                        ? z $in {a,b,c}
                        case z $in {b}:
                            z=b
                            z $in {a,b,c}
                        case z $in I2:
                            z $in union({c},I3)
                            z $in {c} or z $in I3
                            by cases:
                                ? z $in {a,b,c}
                                case z $in {c}:
                                    z=c
                                    z $in {a,b,c}
                                case z $in I3:
                                    z $in {}
                                    by contra:
                                        ? z $in {a,b,c}
                                        impossible z $in {}
        claim:
            ? forall z {a,b,c}:
                z $in T
            by cases:
                ? z $in T
                case z=a:
                    a $in T
                    z $in T
                case z=b:
                    b $in T
                    z $in T
                case z=c:
                    c $in T
                    z $in T
    witness exist aa,bb,cc T st {aa!=bb, aa!=cc, bb!=cc, T={aa,bb,cc}} from a,b,c

thm five_element_set_enumeration_20:
    ? forall T finite_set:
        finite_set_size(T)=5
        =>:
            exist a,b,c,d,f T st {a!=b, a!=c, a!=d, a!=f, b!=c, b!=d, b!=f, c!=d, c!=f, d!=f, T={a,b,c,d,f}}
    by thm finite_successor_decomposition_20(4,T)
    obtain a,I1 from exist K T, I finite_set st {not K $in I, T=union({K},I), finite_set_size(I)=4}
    claim:
        ? forall z I1:
            z $in T
        z $in union({a},I1)
        z $in T
    I1 $subset T
    by thm finite_successor_decomposition_20(3,I1)
    obtain b,I2 from exist K I1, I finite_set st {not K $in I, I1=union({K},I), finite_set_size(I)=3}
    claim:
        ? forall z I2:
            z $in I1
        z $in union({b},I2)
        z $in I1
    I2 $subset I1
    I2 $subset T
    b $in T
    by thm finite_successor_decomposition_20(2,I2)
    obtain c,I3 from exist K I2, I finite_set st {not K $in I, I2=union({K},I), finite_set_size(I)=2}
    claim:
        ? forall z I3:
            z $in I2
        z $in union({c},I3)
        z $in I2
    I3 $subset I2
    I3 $subset T
    c $in T
    by thm finite_successor_decomposition_20(1,I3)
    obtain d,I4 from exist K I3, I finite_set st {not K $in I, I3=union({K},I), finite_set_size(I)=1}
    claim:
        ? forall z I4:
            z $in I3
        z $in union({d},I4)
        z $in I3
    I4 $subset I3
    I4 $subset T
    d $in T
    by thm finite_successor_decomposition_20(0,I4)
    obtain f,I5 from exist K I4, I finite_set st {not K $in I, I4=union({K},I), finite_set_size(I)=0}
    claim:
        ? forall z I5:
            z $in I4
        z $in union({f},I5)
        z $in I4
    I5 $subset I4
    I5 $subset T
    f $in T
    by thm empty_from_zero_cardinality_20(I5)
    I5={}
    b $in I1
    by contra:
        ? a!=b
        a=b
        a $in I1
        impossible not a $in I1
    c $in I1
    by contra:
        ? a!=c
        a=c
        a $in I1
        impossible not a $in I1
    d $in I2
    d $in I1
    by contra:
        ? a!=d
        a=d
        a $in I1
        impossible not a $in I1
    f $in I3
    f $in I2
    f $in I1
    by contra:
        ? a!=f
        a=f
        a $in I1
        impossible not a $in I1
    c $in I2
    by contra:
        ? b!=c
        b=c
        b $in I2
        impossible not b $in I2
    d $in I2
    by contra:
        ? b!=d
        b=d
        b $in I2
        impossible not b $in I2
    f $in I3
    f $in I2
    by contra:
        ? b!=f
        b=f
        b $in I2
        impossible not b $in I2
    d $in I3
    by contra:
        ? c!=d
        c=d
        c $in I3
        impossible not c $in I3
    f $in I3
    by contra:
        ? c!=f
        c=f
        c $in I3
        impossible not c $in I3
    f $in I4
    by contra:
        ? d!=f
        d=f
        d $in I4
        impossible not d $in I4
    by extension:
        ? T={a,b,c,d,f}
        claim:
            ? forall z T:
                z $in {a,b,c,d,f}
            z $in union({a},I1)
            z $in {a} or z $in I1
            by cases:
                ? z $in {a,b,c,d,f}
                case z $in {a}:
                    z=a
                    z $in {a,b,c,d,f}
                case z $in I1:
                    z $in union({b},I2)
                    z $in {b} or z $in I2
                    by cases:
                        ? z $in {a,b,c,d,f}
                        case z $in {b}:
                            z=b
                            z $in {a,b,c,d,f}
                        case z $in I2:
                            z $in union({c},I3)
                            z $in {c} or z $in I3
                            by cases:
                                ? z $in {a,b,c,d,f}
                                case z $in {c}:
                                    z=c
                                    z $in {a,b,c,d,f}
                                case z $in I3:
                                    z $in union({d},I4)
                                    z $in {d} or z $in I4
                                    by cases:
                                        ? z $in {a,b,c,d,f}
                                        case z $in {d}:
                                            z=d
                                            z $in {a,b,c,d,f}
                                        case z $in I4:
                                            z $in union({f},I5)
                                            z $in {f} or z $in I5
                                            by cases:
                                                ? z $in {a,b,c,d,f}
                                                case z $in {f}:
                                                    z=f
                                                    z $in {a,b,c,d,f}
                                                case z $in I5:
                                                    z $in {}
                                                    by contra:
                                                        ? z $in {a,b,c,d,f}
                                                        impossible z $in {}
        claim:
            ? forall z {a,b,c,d,f}:
                z $in T
            by cases:
                ? z $in T
                case z=a:
                    a $in T
                    z $in T
                case z=b:
                    b $in T
                    z $in T
                case z=c:
                    c $in T
                    z $in T
                case z=d:
                    d $in T
                    z $in T
                case z=f:
                    f $in T
                    z $in T
    witness exist aa,bb,cc,dd,ff T st {aa!=bb, aa!=cc, aa!=dd, aa!=ff, bb!=cc, bb!=dd, bb!=ff, cc!=dd, cc!=ff, dd!=ff, T={aa,bb,cc,dd,ff}} from a,b,c,d,f

thm dot_symmetric_20:
    ? forall u,v cart(R,R):
        dot(u,v)=dot(v,u)
    dot(u,v)=u(1)*v(1)+u(2)*v(2)
    dot(v,u)=v(1)*u(1)+v(2)*u(2)
    u(1)*v(1)+u(2)*v(2)=v(1)*u(1)+v(2)*u(2)
    dot(u,v)=dot(v,u)

thm acute_permutations_20:
    ? forall p,q,r cart(R,R):
        $is_acute_triangle(p,q,r)
        =>:
            $is_acute_triangle(p,r,q)
            $is_acute_triangle(q,p,r)
            $is_acute_triangle(q,r,p)
            $is_acute_triangle(r,p,q)
            $is_acute_triangle(r,q,p)
    by def $is_acute_triangle(p,q,r)
    by thm dot_symmetric_20(vec(p,q),vec(p,r))
    by thm dot_symmetric_20(vec(q,p),vec(q,r))
    by thm dot_symmetric_20(vec(r,p),vec(r,q))
    by def:
        ? $is_acute_triangle(p,r,q)
    by def:
        ? $is_acute_triangle(q,p,r)
    by def:
        ? $is_acute_triangle(q,r,p)
    by def:
        ? $is_acute_triangle(r,p,q)
    by def:
        ? $is_acute_triangle(r,q,p)

thm acute_in_three_set_implies_acute_20:
    ? forall p,q,r,u,v,w cart(R,R):
        p!=q
        p!=r
        q!=r
        u $in {p,q,r}
        v $in {p,q,r}
        w $in {p,q,r}
        $is_acute_triangle(u,v,w)
        =>:
            $is_acute_triangle(p,q,r)
    by def $is_acute_triangle(u,v,w)
    by thm acute_permutations_20(u,v,w)
    by cases:
        ? $is_acute_triangle(p,q,r)
        case u=p:
            by cases:
                ? $is_acute_triangle(p,q,r)
                case v=p:
                    u=v
                    by contra:
                        ? $is_acute_triangle(p,q,r)
                        impossible not u=v
                case v=q:
                    by cases:
                        ? $is_acute_triangle(p,q,r)
                        case w=p:
                            u=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not u=w
                        case w=q:
                            v=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not v=w
                        case w=r:
                            $is_acute_triangle(p,q,r)
                case v=r:
                    by cases:
                        ? $is_acute_triangle(p,q,r)
                        case w=p:
                            u=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not u=w
                        case w=q:
                            $is_acute_triangle(p,q,r)
                        case w=r:
                            v=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not v=w
        case u=q:
            by cases:
                ? $is_acute_triangle(p,q,r)
                case v=p:
                    by cases:
                        ? $is_acute_triangle(p,q,r)
                        case w=p:
                            v=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not v=w
                        case w=q:
                            u=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not u=w
                        case w=r:
                            $is_acute_triangle(p,q,r)
                case v=q:
                    u=v
                    by contra:
                        ? $is_acute_triangle(p,q,r)
                        impossible not u=v
                case v=r:
                    by cases:
                        ? $is_acute_triangle(p,q,r)
                        case w=p:
                            $is_acute_triangle(p,q,r)
                        case w=q:
                            u=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not u=w
                        case w=r:
                            v=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not v=w
        case u=r:
            by cases:
                ? $is_acute_triangle(p,q,r)
                case v=p:
                    by cases:
                        ? $is_acute_triangle(p,q,r)
                        case w=p:
                            v=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not v=w
                        case w=q:
                            $is_acute_triangle(p,q,r)
                        case w=r:
                            u=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not u=w
                case v=q:
                    by cases:
                        ? $is_acute_triangle(p,q,r)
                        case w=p:
                            $is_acute_triangle(p,q,r)
                        case w=q:
                            v=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not v=w
                        case w=r:
                            u=w
                            by contra:
                                ? $is_acute_triangle(p,q,r)
                                impossible not u=w
                case v=r:
                    u=v
                    by contra:
                        ? $is_acute_triangle(p,q,r)
                        impossible not u=v

thm three_list_sets_equal_from_members_20:
    ? forall U set,a,b,c,xx,yy,zz U:
        a!=b
        a!=c
        b!=c
        xx!=yy
        xx!=zz
        yy!=zz
        a $in {xx,yy,zz}
        b $in {xx,yy,zz}
        c $in {xx,yy,zz}
        xx $in {a,b,c}
        yy $in {a,b,c}
        zz $in {a,b,c}
        =>:
            {a,b,c}={xx,yy,zz}
    by extension:
        ? {a,b,c}={xx,yy,zz}
        claim:
            ? forall v {a,b,c}:
                v $in {xx,yy,zz}
            by cases:
                ? v $in {xx,yy,zz}
                case v=a:
                    a $in {xx,yy,zz}
                    v $in {xx,yy,zz}
                case v=b:
                    b $in {xx,yy,zz}
                    v $in {xx,yy,zz}
                case v=c:
                    c $in {xx,yy,zz}
                    v $in {xx,yy,zz}
        claim:
            ? forall v {xx,yy,zz}:
                v $in {a,b,c}
            by cases:
                ? v $in {a,b,c}
                case v=xx:
                    xx $in {a,b,c}
                    v $in {a,b,c}
                case v=yy:
                    yy $in {a,b,c}
                    v $in {a,b,c}
                case v=zz:
                    zz $in {a,b,c}
                    v $in {a,b,c}

thm three_subset_of_five_alternatives_20:
    ? forall p,q,r,s,t cart(R,R),T finite_set:
        p!=q
        p!=r
        p!=s
        p!=t
        q!=r
        q!=s
        q!=t
        r!=s
        r!=t
        s!=t
        T $subset {p,q,r,s,t}
        finite_set_size(T)=3
        =>:
            T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
    by thm three_element_set_enumeration_20(T)
    obtain a,b,c from exist a,b,c T st {a!=b,a!=c,b!=c,T={a,b,c}}
    a $in {p,q,r,s,t}
    b $in {p,q,r,s,t}
    c $in {p,q,r,s,t}
    by cases:
        ? T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
        case a=p:
            by cases:
                ? T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                case b=p:
                    a=b
                    by contra:
                        ? T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                        impossible a!=b
                case b=q:
                    by cases:
                        ? T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                        case c=p:
                            a=c
                            by contra:
                                ? T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                                impossible a!=c
                        case c=q:
                            b=c
                            by contra:
                                ? T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                                impossible b!=c
                        case c=r:
                            a $in {p,q,r}
                            b $in {p,q,r}
                            c $in {p,q,r}
                            p $in {a,b,c}
                            q $in {a,b,c}
                            r $in {a,b,c}
                            by thm three_list_sets_equal_from_members_20(cart(R,R),a,b,c,p,q,r)
                            {a,b,c}={p,q,r}
                            T={p,q,r}
                            T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                        case c=s:
                            a $in {p,q,s}
                            b $in {p,q,s}
                            c $in {p,q,s}
                            p $in {a,b,c}
                            q $in {a,b,c}
                            s $in {a,b,c}
                            by thm three_list_sets_equal_from_members_20(cart(R,R),a,b,c,p,q,s)
                            {a,b,c}={p,q,s}
                            T={p,q,s}
                            T={p,q,r} or T={p,q,s} or T={p,q,t} or T={p,r,s} or T={p,r,t} or T={p,s,t} or T={q,r,s} or T={q,r,t} or T={q,s,t} or T={r,s,t}
                        case c=t:
                            a $in {p,q,t}
                            b $in {p,q,t}
                            c $in {p,q,t}
                            p $in {a,b,c}
                            q $in {a,b,c}
                            t $in {a,b,c}
                            by thm three_list_sets_equal_from_members_20(cart(R,R),a,b,c,p,q,t)
                            {a,b,c}={p,q,t}
                            T={p,q,t}
