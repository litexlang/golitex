    finite_set_sum(F,vertex_value)<=7
    finite_set_size(A)<=7

thm ordered_distinct_pair_cardinality_20:
    ? forall S,P finite_set,n N:
        finite_set_size(S)=n+1
        P $subset cart(S,S)
        forall z cart(S,S):
            z $in P
            =>:
                z(1)!=z(2)
        forall z cart(S,S):
            z(1)!=z(2)
            =>:
                z $in P
        =>:
            finite_set_size(P)=(n+1)*n
    algo pair_indicator(z cart(S,S)) N by cases:
        case z(1)!=z(2): 1
        case z(1)=z(2): 0
    claim:
        ? forall a S:
            finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})=n
        have B finite_set = set_minus(S,{a})
        algo row_indicator(b S) N by cases:
            case b!=a: 1
            case b=a: 0
        claim:
            ? forall b B:
                b $in S
            b $in set_minus(S,{a})
            b $in S
        B $subset S
        by extension:
            ? intersect(S,B)=B
            claim:
                ? forall b intersect(S,B):
                    b $in B
                b $in B
            claim:
                ? forall b B:
                    b $in intersect(S,B)
                b $in S
                b $in intersect(S,B)
        claim:
            ? forall b S:
                b $in B
                =>:
                    row_indicator(b)=1
            b $in set_minus(S,{a})
            not b $in {a}
            b!=a
            a!=b
            (a,b)(1)=a
            (a,b)(2)=b
            row_indicator(b)=1
        claim:
            ? forall b S:
                not b $in B
                =>:
                    row_indicator(b)=0
            by contra:
                ? b=a
                b!=a
                not b $in {a}
                b $in set_minus(S,{a})
                b $in B
                impossible not b $in B
            b=a
            (a,b)(1)=a
            (a,b)(2)=b
            row_indicator(b)=0
        by thm membership_flag_counts_intersection_20(S,B,row_indicator)
        finite_set_sum(S,row_indicator)=finite_set_size(intersect(S,B))
        finite_set_size(intersect(S,B))=finite_set_size(B)
        by thm singleton_deletion_from_successor_size(n,S,a)
        finite_set_size(B)=finite_set_size(set_minus(S,{a}))=n
        finite_set_sum(S,row_indicator)=finite_set_size(intersect(S,B))=finite_set_size(B)=n
        claim:
            ? forall b S:
                pair_indicator((a,b))=row_indicator(b)
            (a,b)(1)=a
            (a,b)(2)=b
            by cases:
                ? pair_indicator((a,b))=row_indicator(b)
                case b=a:
                    pair_indicator((a,b))=0
                    row_indicator(b)=0
                    pair_indicator((a,b))=row_indicator(b)
                case b!=a:
                    a!=b
                    pair_indicator((a,b))=1
                    row_indicator(b)=1
                    pair_indicator((a,b))=row_indicator(b)
        release thm finite_set_sum_substitution(finite_set_sum(S,fn(b S) N {pair_indicator((a,b))}),finite_set_sum(S,row_indicator))
        finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})=finite_set_sum(S,row_indicator)
        finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})=finite_set_sum(S,row_indicator)=n
    release thm finite_set_sum_substitution(finite_set_sum(S,fn(a S) N {finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})}),finite_set_sum(S,fn(a S) N {n}))
    finite_set_sum(S,fn(a S) N {finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})})=finite_set_sum(S,fn(a S) N {n})
    finite_set_sum(S,fn(a S) N {n})=finite_set_size(S)*n=(n+1)*n
    finite_set_sum(S,fn(a S) N {finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})})=finite_set_sum(S,fn(a S) N {n})=(n+1)*n
    finite_set_sum(S,fn(a S) N {finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})})=finite_set_sum(cart(S,S),pair_indicator)
    claim:
        ? forall z cart(S,S):
            z $in P
            =>:
                pair_indicator(z)=1
        z(1)!=z(2)
        pair_indicator(z)=1
    claim:
        ? forall z cart(S,S):
            not z $in P
            =>:
                pair_indicator(z)=0
        by contra:
            ? z(1)=z(2)
            z(1)!=z(2)
            z $in P
            impossible not z $in P
        z(1)=z(2)
        pair_indicator(z)=0
    by extension:
        ? intersect(cart(S,S),P)=P
        claim:
            ? forall z intersect(cart(S,S),P):
                z $in P
            z $in P
        claim:
            ? forall z P:
                z $in intersect(cart(S,S),P)
            z $in cart(S,S)
            z $in intersect(cart(S,S),P)
    by thm membership_flag_counts_intersection_20(cart(S,S),P,pair_indicator)
    finite_set_sum(cart(S,S),pair_indicator)=finite_set_size(intersect(cart(S,S),P))
    finite_set_size(intersect(cart(S,S),P))=finite_set_size(P)
    finite_set_sum(cart(S,S),pair_indicator)=finite_set_size(intersect(cart(S,S),P))=finite_set_size(P)
    finite_set_size(P)=finite_set_sum(cart(S,S),pair_indicator)=finite_set_sum(S,fn(a S) N {finite_set_sum(S,fn(b S) N {pair_indicator((a,b))})})=(n+1)*n

thm two_element_set_enumeration_20:
    ? forall T finite_set:
        finite_set_size(T)=2
        =>:
            exist a,b T st {a!=b, T={a,b}}
    by thm finite_successor_decomposition_20(1,T)
    obtain a,I1 from exist K T, I finite_set st {not K $in I, T=union({K},I), finite_set_size(I)=1}
    claim:
        ? forall z I1:
            z $in T
        z $in union({a},I1)
        z $in T
    I1 $subset T
    by thm finite_successor_decomposition_20(0,I1)
    obtain b,I2 from exist K I1, I finite_set st {not K $in I, I1=union({K},I), finite_set_size(I)=0}
    claim:
        ? forall z I2:
            z $in I1
        z $in union({b},I2)
        z $in I1
    I2 $subset I1
    I2 $subset T
    b $in T
    by thm empty_from_zero_cardinality_20(I2)
    I2={}
    b $in I1
    by contra:
        ? a!=b
        a=b
        a $in I1
        impossible not a $in I1
    by extension:
        ? T={a,b}
        claim:
            ? forall z T:
                z $in {a,b}
            z $in union({a},I1)
            z $in {a} or z $in I1
            by cases:
                ? z $in {a,b}
                case z $in {a}:
                    z=a
                    z $in {a,b}
                case z $in I1:
                    z $in union({b},I2)
                    z $in {b} or z $in I2
                    by cases:
                        ? z $in {a,b}
                        case z $in {b}:
                            z=b
                            z $in {a,b}
                        case z $in I2:
                            z $in {}
                            by contra:
                                ? z $in {a,b}
                                impossible z $in {}
        claim:
            ? forall z {a,b}:
                z $in T
            by cases:
                ? z $in T
                case z=a:
                    a $in T
                    z $in T
                case z=b:
                    b $in T
                    z $in T
    witness exist aa,bb T st {aa!=bb, T={aa,bb}} from a,b

thm swapped_ordered_pairs_distinct_20:
    ? forall S set,a,b S:
        a!=b
        =>:
            (a,b)!=(b,a)
    by contra:
        ? (a,b)!=(b,a)
        (a,b)=(b,a)
        (a,b)(1)=(b,a)(1)
        (a,b)(1)=a
        (b,a)(1)=b
        a=b
        impossible a!=b

thm two_vertex_ordered_pair_fibre_size_20:
    ? forall S,P,K,B finite_set:
        K $subset S
        finite_set_size(K)=2
        P $subset cart(S,S)
        forall z cart(S,S):
            z $in P
            =>:
                z(1)!=z(2)
        forall z cart(S,S):
            z(1)!=z(2)
            =>:
                z $in P
        B $subset P
        forall z cart(S,S):
            z $in P
            z $in B
            =>:
                z(1) $in K
                z(2) $in K
        forall z cart(S,S):
            z $in P
            z(1) $in K
            z(2) $in K
            =>:
                z $in B
        =>:
            finite_set_size(B)=2
    by thm two_element_set_enumeration_20(K)
    obtain a,b from exist a,b K st {a!=b,K={a,b}}
    a $in S
    b $in S
    (a,b) $in cart(S,S)
    (b,a) $in cart(S,S)
    (a,b)(1)=a
    (a,b)(2)=b
    (b,a)(1)=b
    (b,a)(2)=a
    (a,b)(1)!=(a,b)(2)
    (b,a)(1)!=(b,a)(2)
    (a,b) $in P
    (b,a) $in P
    (a,b)(1) $in K
    (a,b)(2) $in K
    (b,a)(1) $in K
    (b,a)(2) $in K
    (a,b) $in B
    (b,a) $in B
    by thm swapped_ordered_pairs_distinct_20(S,a,b)
    have L finite_set = {(a,b),(b,a)}
    by extension:
        ? B=L
        claim:
            ? forall z B:
                z $in L
            z $in P
            z $in cart(S,S)
            z(1)!=z(2)
            z(1) $in K
            z(2) $in K
            z(1) $in {a,b}
            z(2) $in {a,b}
            by cases:
                ? z $in L
                case z(1)=a:
                    by cases:
                        ? z $in L
                        case z(2)=a:
                            z(1)=z(2)
                            by contra:
                                ? z $in L
                                impossible z(1)!=z(2)
                        case z(2)=b:
                            release thm tuple_equal_from_coordinates(z,(a,b))
                            z=(a,b)
                            z $in L
                case z(1)=b:
                    by cases:
                        ? z $in L
                        case z(2)=a:
                            release thm tuple_equal_from_coordinates(z,(b,a))
                            z=(b,a)
                            z $in L
                        case z(2)=b:
                            z(1)=z(2)
                            by contra:
                                ? z $in L
                                impossible z(1)!=z(2)
        claim:
            ? forall z L:
                z $in B
            z $in {(a,b),(b,a)}
            by cases:
                ? z $in B
                case z=(a,b):
                    z $in B
                case z=(b,a):
                    z $in B
    finite_set_size(L)=finite_set_size({(a,b),(b,a)})=2
    finite_set_size(B)=finite_set_size(L)=2

thm unordered_two_subset_cardinality_20:
    ? forall S,Pairs finite_set,n N:
        finite_set_size(S)=n+1
        Pairs $subset power_set(S)
        forall K finite_set:
            K $in Pairs
            =>:
                finite_set_size(K)=2
        forall K finite_set:
            K $subset S
            finite_set_size(K)=2
            =>:
                K $in Pairs
        =>:
            2*finite_set_size(Pairs)=(n+1)*n
    thm membership_transport_20:
        ? forall source_carrier,target_carrier set,member source_carrier:
            source_carrier=target_carrier
            =>:
                member $in target_carrier
    have P set = {z cart(S,S): z(1)!=z(2)}
    P $subset cart(S,S)
    release thm subset_of_finite_set_is_finite(P,cart(S,S))
    $is_finite_set(P)
    claim:
        ? forall z cart(S,S):
            z $in P
            =>:
                z(1)!=z(2)
        z(1)!=z(2)
    claim:
        ? forall z cart(S,S):
            z(1)!=z(2)
            =>:
                z $in P
        z $in P
    by thm ordered_distinct_pair_cardinality_20(S,P,n)
    finite_set_size(P)=(n+1)*n
    have D finite_set = power_set(S)
    Pairs $subset D
    have fn family(k D) power_set(cart(S,S)) = {z cart(S,S): z $in P,z(1) $in k,z(2) $in k}
    claim:
        ? forall k D:
            k $in Pairs
            =>:
                family(k) $subset P
        family(k)={z cart(S,S): z $in P,z(1) $in k,z(2) $in k}
        claim:
            ? forall z family(k):
                z $in P
            z $in {zz cart(S,S): zz $in P,zz(1) $in k,zz(2) $in k}
            z $in P
        family(k) $subset P
    by def:
        ? $full_domain_indexed_family_20(cart(S,S),D,P,Pairs,family)
    claim:
        ? forall x P:
            exist! k D st {k $in Pairs,x $in family(k)}
        x $in cart(S,S)
        x(1) $in S
        x(2) $in S
        x(1)!=x(2)
        have K finite_set = {x(1),x(2)}
        claim:
            ? forall y K:
                y $in S
            y $in {x(1),x(2)}
            by cases:
                ? y $in S
                case y=x(1):
                    y $in S
                case y=x(2):
                    y $in S
        K $subset S
        K $in power_set(S)
        K $in D
        K={x(1),x(2)}
        finite_set_size({x(1),x(2)})=2
        finite_set_size(K)=finite_set_size({x(1),x(2)})=2
        K $in Pairs
        x(1) $in K
        x(2) $in K
        family(K)={z cart(S,S): z $in P,z(1) $in K,z(2) $in K}
        x $in {z cart(S,S): z $in P,z(1) $in K,z(2) $in K}
        x $in family(K)
        witness exist! kk D st {kk $in Pairs,x $in family(kk)} from K:
            K $in Pairs
            x $in family(K)
            claim:
                ? forall K1,K2 D:
                    K1 $in Pairs
                    K2 $in Pairs
                    x $in family(K1)
                    x $in family(K2)
                    =>:
                        K1=K2
                K1 $in power_set(S)
                K2 $in power_set(S)
                K1 $subset S
                K2 $subset S
                release thm subset_of_finite_set_is_finite(K1,S)
                release thm subset_of_finite_set_is_finite(K2,S)
                $is_finite_set(K1)
                $is_finite_set(K2)
                finite_set_size(K1)=2
                finite_set_size(K2)=2
                family(K1)={z cart(S,S): z $in P,z(1) $in K1,z(2) $in K1}
                family(K2)={z cart(S,S): z $in P,z(1) $in K2,z(2) $in K2}
                release thm membership_transport_20(family(K1),{z cart(S,S): z $in P,z(1) $in K1,z(2) $in K1},x)
                release thm membership_transport_20(family(K2),{z cart(S,S): z $in P,z(1) $in K2,z(2) $in K2},x)
                x(1) $in K1
                x(2) $in K1
                x(1) $in K2
                x(2) $in K2
                claim:
                    ? forall y K:
                        y $in K1
                    y $in {x(1),x(2)}
                    by cases:
                        ? y $in K1
                        case y=x(1):
                            y $in K1
                        case y=x(2):
                            y $in K1
                claim:
                    ? forall y K:
                        y $in K2
                    y $in {x(1),x(2)}
                    by cases:
                        ? y $in K2
                        case y=x(1):
                            y $in K2
                        case y=x(2):
                            y $in K2
                K $subset K1
                K $subset K2
                finite_set_size(K)=finite_set_size(K1)
                finite_set_size(K)=finite_set_size(K2)
                K=K1
                K=K2
                K1=K=K2
    by def:
        ? $full_domain_unique_cover_20(cart(S,S),D,P,Pairs,family)
    by thm full_domain_cover_to_unique_20(cart(S,S),D,P,Pairs,family)
    claim:
        ? forall k Pairs:
            $is_finite_set(family(k))
        k $in D
        family(k) $subset P
        release thm subset_of_finite_set_is_finite(family(k),P)
        $is_finite_set(family(k))
    claim:
        ? forall k Pairs:
            $is_finite_set(family(k))
            =>:
                finite_set_size(family(k))=2
        k $in D
        k $in power_set(S)
        k $subset S
        release thm subset_of_finite_set_is_finite(k,S)
        $is_finite_set(k)
        finite_set_size(k)=2
        have B finite_set = family(k)
        family(k) $subset P
        B $subset P
        family(k)={z cart(S,S): z $in P,z(1) $in k,z(2) $in k}
        claim:
            ? forall z cart(S,S):
                z $in P
                z $in B
                =>:
                    z(1) $in k
                    z(2) $in k
            z $in family(k)
            z $in {zz cart(S,S): zz $in P,zz(1) $in k,zz(2) $in k}
            z(1) $in k
            z(2) $in k
        claim:
            ? forall z cart(S,S):
                z $in P
                z(1) $in k
                z(2) $in k
                =>:
                    z $in B
            z $in {zz cart(S,S): zz $in P,zz(1) $in k,zz(2) $in k}
            z $in family(k)
            z $in B
        by thm two_vertex_ordered_pair_fibre_size_20(S,P,k,B)
        finite_set_size(B)=2
        finite_set_size(family(k))=finite_set_size(B)=2
    by thm finite_set_size_over_fixed_unique_constant_cover(cart(S,S),D,Pairs,P,2,family)
    finite_set_size(P)=finite_set_size(Pairs)*2
    2*finite_set_size(Pairs)=finite_set_size(Pairs)*2=finite_set_size(P)=(n+1)*n

thm finite_subset_difference_cardinality_20:
    ? forall A,B finite_set:
        B $subset A
        =>:
            finite_set_size(set_minus(A,B))=finite_set_size(A)-finite_set_size(B)
    intersect(A,B)=B
    finite_set_size(intersect(A,B))=finite_set_size(B)
    finite_set_size(set_minus(A,B))=finite_set_size(A)-finite_set_size(intersect(A,B))
    finite_set_size(set_minus(A,B))=finite_set_size(A)-finite_set_size(B)

thm three_plus_two_extension_20:
    ? forall S,T,K finite_set:
        T $subset S
        K $subset set_minus(S,T)
        finite_set_size(T)=3
        finite_set_size(K)=2
        =>:
            union(T,K) $subset S
            finite_set_size(union(T,K))=5
            set_minus(union(T,K),T)=K
    set_minus(S,T) $subset S
    K $subset S
    claim:
        ? forall x intersect(T,K):
            x $in {}
        by contra:
            ? x $in {}
            x $in T
            x $in K
            x $in set_minus(S,T)
            not x $in T
            impossible x $in T
    by extension:
        ? intersect(T,K)={}
        claim:
            ? forall x {}:
                x $in intersect(T,K)
            by contra:
                ? x $in intersect(T,K)
                impossible not x $in {}
    finite_set_size({})=0
    finite_set_size(intersect(T,K))=finite_set_size({})=0
    finite_set_size(union(T,K))=finite_set_size(T)+finite_set_size(K)-finite_set_size(intersect(T,K))
    finite_set_size(union(T,K))=3+2-0=5
    union(T,K) $subset S
    by extension:
        ? set_minus(union(T,K),T)=K
        claim:
            ? forall x set_minus(union(T,K),T):
                x $in K
            x $in union(T,K)
            not x $in T
            by cases:
                ? x $in K
                case x $in T:
                    by contra:
                        ? x $in K
                        impossible not x $in T
                case x $in K:
                    x $in K
        claim:
            ? forall x K:
                x $in set_minus(union(T,K),T)
            x $in union(T,K)
            x $in set_minus(S,T)
            not x $in T
            x $in set_minus(union(T,K),T)

thm five_extension_remainder_20:
    ? forall S,T,U finite_set:
        T $subset U
        U $subset S
        finite_set_size(T)=3
        finite_set_size(U)=5
        =>:
            set_minus(U,T) $subset set_minus(S,T)
            finite_set_size(set_minus(U,T))=2
            union(T,set_minus(U,T))=U
    by thm finite_subset_difference_cardinality_20(U,T)
    finite_set_size(set_minus(U,T))=finite_set_size(U)-finite_set_size(T)=5-3=2
    claim:
        ? forall x set_minus(U,T):
            x $in set_minus(S,T)
        x $in U
        x $in S
        not x $in T
        x $in set_minus(S,T)
    set_minus(U,T) $subset set_minus(S,T)
    by extension:
        ? union(T,set_minus(U,T))=U
        claim:
            ? forall x union(T,set_minus(U,T)):
                x $in U
            by cases:
                ? x $in U
                case x $in T:
                    x $in U
                case x $in set_minus(U,T):
                    x $in U
        claim:
            ? forall x U:
                x $in union(T,set_minus(U,T))
            by cases:
                ? x $in union(T,set_minus(U,T))
                case x $in T:
                    x $in union(T,set_minus(U,T))
                case not x $in T:
                    x $in set_minus(U,T)
                    x $in union(T,set_minus(U,T))

thm multiplication_congruence_20:
    ? forall x, x2, y, y2 R:
        x = x2
        y = y2
        =>:
            x * y = x2 * y2
    x - x2 = 0
    y - y2 = 0
    x * y - x2 * y2 = (x - x2) * y + x2 * (y - y2)
    (x - x2) * y + x2 * (y - y2) = 0
    x * y - x2 * y2 = 0
    x * y = x2 * y2


thm half_of_9312_20:
    ? forall x R:
        2*x=9312
        =>:
            x=4656
    by thm multiplication_congruence_20(2*x,9312,1/2,1/2)
    (2*x)*(1/2)=9312*(1/2)
    (2*x)*(1/2)=x
    9312*(1/2)=4656
    x=(2*x)*(1/2)=9312*(1/2)=4656

thm three_vertex_five_extension_cardinality_20:
