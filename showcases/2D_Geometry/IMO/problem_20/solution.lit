thm uniform_incidence_equality_20:
    ? forall T,U finite_set,f fn(z cart(T,U)) N,m,n N:
        forall t T:
            finite_set_sum(U,fn(u U) N {f((t,u))})=m
        forall u U:
            finite_set_sum(T,fn(t T) N {f((t,u))})=n
        =>:
            finite_set_size(T)*m=finite_set_size(U)*n
    claim:
        ? forall t T:
            finite_set_sum(U,fn(u U) N {f((t,u))})=m
        finite_set_sum(U,fn(u U) N {f((t,u))})=m
    release thm finite_set_sum_substitution(finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})}),finite_set_sum(T,fn(t T) N {m}))
    finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(T,fn(t T) N {m})
    finite_set_sum(T,fn(t T) N {m})=finite_set_size(T)*m
    finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(T,fn(t T) N {m})=finite_set_size(T)*m
    finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})
    claim:
        ? forall u U:
            finite_set_sum(T,fn(t T) N {f((t,u))})=n
        finite_set_sum(T,fn(t T) N {f((t,u))})=n
    release thm finite_set_sum_substitution(finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})}),finite_set_sum(U,fn(u U) N {n}))
    finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {n})
    finite_set_sum(U,fn(u U) N {n})=finite_set_size(U)*n
    finite_set_size(T)*m=finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})
    finite_set_size(T)*m=finite_set_sum(T,fn(t T) N {finite_set_sum(U,fn(u U) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {finite_set_sum(T,fn(t T) N {f((t,u))})})=finite_set_sum(U,fn(u U) N {n})=finite_set_size(U)*n

thm matrix_row_membership_sum_20:
    ? forall X,Y,E finite_set,f fn(z cart(X,Y)) N,x X:
        E $subset Y
        forall y Y:
            y $in E
            =>:
                f((x,y))=1
        forall y Y:
            not y $in E
            =>:
                f((x,y))=0
        =>:
            finite_set_sum(Y,fn(y Y) N {f((x,y))})=finite_set_size(E)
    algo member_flag(y Y) N by cases:
        case y $in E: 1
        case not y $in E: 0
    claim:
        ? forall y Y:
            y $in E
            =>:
                member_flag(y)=1
        member_flag(y)=1
    claim:
        ? forall y Y:
            not y $in E
            =>:
                member_flag(y)=0
        member_flag(y)=0
    by thm membership_flag_counts_intersection_20(Y,E,member_flag)
    intersect(Y,E)=E
    finite_set_size(intersect(Y,E))=finite_set_size(E)
    finite_set_sum(Y,member_flag)=finite_set_size(intersect(Y,E))=finite_set_size(E)
    claim:
        ? forall y Y:
            f((x,y))=member_flag(y)
        by cases:
            ? f((x,y))=member_flag(y)
            case y $in E:
                f((x,y))=1
                member_flag(y)=1
                f((x,y))=member_flag(y)
            case not y $in E:
                f((x,y))=0
                member_flag(y)=0
                f((x,y))=member_flag(y)
    release thm finite_set_sum_substitution(finite_set_sum(Y,fn(y Y) N {f((x,y))}),finite_set_sum(Y,member_flag))
    finite_set_sum(Y,fn(y Y) N {f((x,y))})=finite_set_sum(Y,member_flag)=finite_set_size(E)

thm matrix_column_membership_sum_20:
    ? forall X,Y,E finite_set,f fn(z cart(X,Y)) N,y Y:
        E $subset X
        forall x X:
            x $in E
            =>:
                f((x,y))=1
        forall x X:
            not x $in E
            =>:
                f((x,y))=0
        =>:
            finite_set_sum(X,fn(x X) N {f((x,y))})=finite_set_size(E)
    algo member_flag(x X) N by cases:
        case x $in E: 1
        case not x $in E: 0
    claim:
        ? forall x X:
            x $in E
            =>:
                member_flag(x)=1
        member_flag(x)=1
    claim:
        ? forall x X:
            not x $in E
            =>:
                member_flag(x)=0
        member_flag(x)=0
    by thm membership_flag_counts_intersection_20(X,E,member_flag)
    intersect(X,E)=E
    finite_set_size(intersect(X,E))=finite_set_size(E)
    finite_set_sum(X,member_flag)=finite_set_size(intersect(X,E))=finite_set_size(E)
    claim:
        ? forall x X:
            f((x,y))=member_flag(x)
        by cases:
            ? f((x,y))=member_flag(x)
            case x $in E:
                f((x,y))=1
                member_flag(x)=1
                f((x,y))=member_flag(x)
            case not x $in E:
                f((x,y))=0
                member_flag(x)=0
                f((x,y))=member_flag(x)
    release thm finite_set_sum_substitution(finite_set_sum(X,fn(x X) N {f((x,y))}),finite_set_sum(X,member_flag))
    finite_set_sum(X,fn(x X) N {f((x,y))})=finite_set_sum(X,member_flag)=finite_set_size(E)

thm triangle_five_incidence_totals_20:
    ? forall S,A,F5 finite_set:
        S $subset cart(R,R)
        finite_set_size(S)=100
        A $subset power_set(S)
        forall T finite_set:
            T $in A
            =>:
                finite_set_size(T)=3
        forall T finite_set:
            T $subset S
            finite_set_size(T)=3
            =>:
                T $in A
        F5 $subset power_set(S)
        forall U finite_set:
            U $in F5
            =>:
                finite_set_size(U)=5
        forall U finite_set:
            U $subset S
            finite_set_size(U)=5
            =>:
                U $in F5
        =>:
            finite_set_size(A)*4656=finite_set_size(F5)*10
    claim:
        ? forall z cart(A,F5):
            $is_set(z(1))
            $is_set(z(2))
        z(1) $in A
        z(2) $in F5
        z(1) $in power_set(S)
        z(2) $in power_set(S)
        $is_set(z(1))
        $is_set(z(2))
    algo incidence(z cart(A,F5)) N by cases:
        case z(1) $subset z(2): 1
        case not z(1) $subset z(2): 0
    claim:
        ? forall t A:
            finite_set_sum(F5,fn(u F5) N {incidence((t,u))})=4656
        t $in power_set(S)
        t $subset S
        release thm subset_of_finite_set_is_finite(t,S)
        $is_finite_set(t)
        finite_set_size(t)=3
        have E5 set = {u F5: t $subset u}
        E5 $subset F5
        release thm subset_of_finite_set_is_finite(E5,F5)
        $is_finite_set(E5)
        E5 $subset power_set(S)
        claim:
            ? forall u finite_set:
                u $in E5
                =>:
                    t $subset u
                    finite_set_size(u)=5
            u $in {uu F5: t $subset uu}
            u $in F5
            t $subset u
            finite_set_size(u)=5
        claim:
            ? forall u finite_set:
                u $subset S
                t $subset u
                finite_set_size(u)=5
                =>:
                    u $in E5
            u $in F5
            u $in {uu F5: t $subset uu}
            u $in E5
        by thm three_vertex_five_extension_cardinality_20(S,t,E5)
        finite_set_size(E5)=4656
        claim:
            ? forall u F5:
                u $in E5
                =>:
                    incidence((t,u))=1
            u $in {uu F5: t $subset uu}
            t $subset u
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=1
        claim:
            ? forall u F5:
                not u $in E5
                =>:
                    incidence((t,u))=0
            by contra:
                ? not t $subset u
                t $subset u
                u $in {uu F5: t $subset uu}
                u $in E5
                impossible not u $in E5
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=0
        by thm matrix_row_membership_sum_20(A,F5,E5,incidence,t)
        finite_set_sum(F5,fn(u F5) N {incidence((t,u))})=finite_set_size(E5)=4656
    claim:
        ? forall u F5:
            finite_set_sum(A,fn(t A) N {incidence((t,u))})=10
        u $in power_set(S)
        u $subset S
        release thm subset_of_finite_set_is_finite(u,S)
        $is_finite_set(u)
        u $subset cart(R,R)
        finite_set_size(u)=5
        have E3 set = {t A: t $subset u}
        E3 $subset A
        release thm subset_of_finite_set_is_finite(E3,A)
        $is_finite_set(E3)
        claim:
            ? forall t E3:
                t $in power_set(u)
            t $in {tt A: tt $subset u}
            t $subset u
            t $in power_set(u)
        E3 $subset power_set(u)
        claim:
            ? forall t finite_set:
                t $in E3
                =>:
                    finite_set_size(t)=3
            t $in {tt A: tt $subset u}
            t $in A
            finite_set_size(t)=3
        claim:
            ? forall t finite_set:
                t $subset u
                finite_set_size(t)=3
                =>:
                    t $in E3
            t $subset S
            t $in A
            t $in {tt A: tt $subset u}
            t $in E3
        by thm five_point_triangle_family_cardinality_20(u,E3)
        finite_set_size(E3)=10
        claim:
            ? forall t A:
                t $in E3
                =>:
                    incidence((t,u))=1
            t $in {tt A: tt $subset u}
            t $subset u
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=1
        claim:
            ? forall t A:
                not t $in E3
                =>:
                    incidence((t,u))=0
            by contra:
                ? not t $subset u
                t $subset u
                t $in {tt A: tt $subset u}
                t $in E3
                impossible not t $in E3
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=0
        by thm matrix_column_membership_sum_20(A,F5,E3,incidence,u)
        finite_set_sum(A,fn(t A) N {incidence((t,u))})=finite_set_size(E3)=10
    by thm uniform_incidence_equality_20(A,F5,incidence,4656,10)
    finite_set_size(A)*4656=finite_set_size(F5)*10

thm acute_triangle_five_incidence_bound_20:
    ? forall S,A,F5 finite_set:
        S $subset cart(R,R)
        finite_set_size(S)=100
        forall p,q,r S:
            p!=q
            p!=r
            q!=r
            =>:
                not $is_collinear(p,q,r)
        A $subset power_set(S)
        forall T finite_set:
            T $in A
            =>:
                finite_set_size(T)=3
                exist a,b,c cart(R,R) st {a $in T,b $in T,c $in T,$is_acute_triangle(a,b,c)}
        F5 $subset power_set(S)
        forall U finite_set:
            U $in F5
            =>:
                finite_set_size(U)=5
        forall U finite_set:
            U $subset S
            finite_set_size(U)=5
            =>:
                U $in F5
        =>:
            finite_set_size(A)*4656<=finite_set_size(F5)*7
    claim:
        ? forall z cart(A,F5):
            $is_set(z(1))
            $is_set(z(2))
        z(1) $in A
        z(2) $in F5
        z(1) $in power_set(S)
        z(2) $in power_set(S)
        $is_set(z(1))
        $is_set(z(2))
    algo incidence(z cart(A,F5)) N by cases:
        case z(1) $subset z(2): 1
        case not z(1) $subset z(2): 0
    claim:
        ? forall t A:
            finite_set_sum(F5,fn(u F5) N {incidence((t,u))})=4656
        t $in power_set(S)
        t $subset S
        release thm subset_of_finite_set_is_finite(t,S)
        $is_finite_set(t)
        finite_set_size(t)=3
        have E5 set = {u F5: t $subset u}
        E5 $subset F5
        release thm subset_of_finite_set_is_finite(E5,F5)
        $is_finite_set(E5)
        E5 $subset power_set(S)
        claim:
            ? forall u finite_set:
                u $in E5
                =>:
                    t $subset u
                    finite_set_size(u)=5
            u $in {uu F5: t $subset uu}
            u $in F5
            t $subset u
            finite_set_size(u)=5
        claim:
            ? forall u finite_set:
                u $subset S
                t $subset u
                finite_set_size(u)=5
                =>:
                    u $in E5
            u $in F5
            u $in {uu F5: t $subset uu}
            u $in E5
        by thm three_vertex_five_extension_cardinality_20(S,t,E5)
        finite_set_size(E5)=4656
        claim:
            ? forall u F5:
                u $in E5
                =>:
                    incidence((t,u))=1
            u $in {uu F5: t $subset uu}
            t $subset u
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=1
        claim:
            ? forall u F5:
                not u $in E5
                =>:
                    incidence((t,u))=0
            by contra:
                ? not t $subset u
                t $subset u
                u $in {uu F5: t $subset uu}
                u $in E5
                impossible not u $in E5
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=0
        by thm matrix_row_membership_sum_20(A,F5,E5,incidence,t)
        finite_set_sum(F5,fn(u F5) N {incidence((t,u))})=finite_set_size(E5)=4656
    claim:
        ? forall u F5:
            finite_set_sum(A,fn(t A) N {incidence((t,u))})<=7
        u $in power_set(S)
        u $subset S
        release thm subset_of_finite_set_is_finite(u,S)
        $is_finite_set(u)
        u $subset cart(R,R)
        finite_set_size(u)=5
        have E3 set = {t A: t $subset u}
        E3 $subset A
        release thm subset_of_finite_set_is_finite(E3,A)
        $is_finite_set(E3)
        claim:
            ? forall t E3:
                t $in power_set(u)
            t $in {tt A: tt $subset u}
            t $subset u
            t $in power_set(u)
        E3 $subset power_set(u)
        claim:
            ? forall t finite_set:
                t $in E3
                =>:
                    finite_set_size(t)=3
                    exist a,b,c cart(R,R) st {a $in t,b $in t,c $in t,$is_acute_triangle(a,b,c)}
            t $in {tt A: tt $subset u}
            t $in A
            finite_set_size(t)=3
            exist a,b,c cart(R,R) st {a $in t,b $in t,c $in t,$is_acute_triangle(a,b,c)}
        by thm five_element_set_enumeration_20(u)
        obtain p5,q5,r5,s5,t5 from exist a,b,c,d,f u st {a!=b,a!=c,a!=d,a!=f,b!=c,b!=d,b!=f,c!=d,c!=f,d!=f,u={a,b,c,d,f}}
        p5 $in cart(R,R)
        q5 $in cart(R,R)
        r5 $in cart(R,R)
        s5 $in cart(R,R)
        t5 $in cart(R,R)
        E3 $subset power_set({p5,q5,r5,s5,t5})
        claim:
            ? forall a,b,c cart(R,R):
                a $in {p5,q5,r5,s5,t5}
                b $in {p5,q5,r5,s5,t5}
                c $in {p5,q5,r5,s5,t5}
                a!=b
                a!=c
                b!=c
                =>:
                    not $is_collinear(a,b,c)
            a $in u
            b $in u
            c $in u
            a $in S
            b $in S
            c $in S
            not $is_collinear(a,b,c)
        by thm acute_five_set_family_bound_20(p5,q5,r5,s5,t5,E3)
        finite_set_size(E3)<=7
        claim:
            ? forall t A:
                t $in E3
                =>:
                    incidence((t,u))=1
            t $in {tt A: tt $subset u}
            t $subset u
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=1
        claim:
            ? forall t A:
                not t $in E3
                =>:
                    incidence((t,u))=0
            by contra:
                ? not t $subset u
                t $subset u
                t $in {tt A: tt $subset u}
                t $in E3
                impossible not t $in E3
            (t,u)(1)=t
            (t,u)(2)=u
            incidence((t,u))=0
        by thm matrix_column_membership_sum_20(A,F5,E3,incidence,u)
        finite_set_sum(A,fn(t A) N {incidence((t,u))})=finite_set_size(E3)<=7
    by thm uniform_incidence_bound_20(A,F5,incidence,4656,7)
    finite_set_size(A)*4656<=finite_set_size(F5)*7

thm cancel_positive_factor_le_20:
    ? forall x,y,k R:
        k>0
        x*k<=y*k
        =>:
            x<=y
    0<k
    by contra:
        ? x<=y
        x>y
        x*k>y*k
        impossible x*k<=y*k

thm incidence_seventy_percent_conclusion_20:
    ? forall A,B,F finite_set:
        finite_set_size(A)*4656<=finite_set_size(F)*7
        finite_set_size(B)*4656=finite_set_size(F)*10
        =>:
            10*finite_set_size(A)<=7*finite_set_size(B)
    finite_set_size(A)*4656*10<=finite_set_size(F)*7*10
    finite_set_size(F)*7*10=(finite_set_size(F)*10)*7
    by thm multiplication_congruence_20(finite_set_size(B)*4656,finite_set_size(F)*10,7,7)
    (finite_set_size(B)*4656)*7=(finite_set_size(F)*10)*7
    finite_set_size(F)*7*10=(finite_set_size(B)*4656)*7
    finite_set_size(A)*4656*10<=(finite_set_size(B)*4656)*7
    (10*finite_set_size(A))*4656=finite_set_size(A)*4656*10
    (7*finite_set_size(B))*4656=(finite_set_size(B)*4656)*7
    (10*finite_set_size(A))*4656<=(7*finite_set_size(B))*4656
    by thm cancel_positive_factor_le_20(10*finite_set_size(A),7*finite_set_size(B),4656)
    10*finite_set_size(A)<=7*finite_set_size(B)

thm problem_20:
    ? forall S,all_triangles,acute_triangles finite_set:
        S $subset cart(R,R)
        finite_set_size(S)=100
        forall p,q,r S:
            p!=q
            p!=r
            q!=r
            =>:
                not $is_collinear(p,q,r)
        all_triangles $subset power_set(S)
        acute_triangles $subset all_triangles
        forall T finite_set:
            T $in all_triangles
            =>:
                T $in power_set(S)
                finite_set_size(T)=3
        forall T finite_set:
            T $in power_set(S)
            finite_set_size(T)=3
            =>:
                T $in all_triangles
        forall T finite_set:
            T $in acute_triangles
            =>:
                T $in all_triangles
                exist p,q,r cart(R,R) st {p $in T,q $in T,r $in T,$is_acute_triangle(p,q,r)}
        forall T finite_set:
            T $in all_triangles
            exist p,q,r cart(R,R) st {p $in T,q $in T,r $in T,$is_acute_triangle(p,q,r)}
            =>:
                T $in acute_triangles
        =>:
            10*finite_set_size(acute_triangles)<=7*finite_set_size(all_triangles)
    have D finite_set = power_set(S)
    claim:
        ? forall U D:
            $is_finite_set(U)
        U $in power_set(S)
        U $subset S
        release thm subset_of_finite_set_is_finite(U,S)
        $is_finite_set(U)
    have F5 set = {U D: finite_set_size(U)=5}
    F5 $subset D
    release thm subset_of_finite_set_is_finite(F5,D)
    $is_finite_set(F5)
    F5 $subset power_set(S)
    claim:
        ? forall U finite_set:
            U $in F5
            =>:
                finite_set_size(U)=5
        U $in {UU D: finite_set_size(UU)=5}
        finite_set_size(U)=5
    claim:
        ? forall U finite_set:
            U $subset S
            finite_set_size(U)=5
            =>:
                U $in F5
        U $in power_set(S)
        U $in D
        U $in {UU D: finite_set_size(UU)=5}
        U $in F5
    claim:
        ? forall T finite_set:
            T $subset S
            finite_set_size(T)=3
            =>:
                T $in all_triangles
        T $in power_set(S)
        T $in all_triangles
    by thm triangle_five_incidence_totals_20(S,all_triangles,F5)
    finite_set_size(all_triangles)*4656=finite_set_size(F5)*10
    acute_triangles $subset power_set(S)
    claim:
        ? forall T finite_set:
            T $in acute_triangles
            =>:
                finite_set_size(T)=3
                exist p,q,r cart(R,R) st {p $in T,q $in T,r $in T,$is_acute_triangle(p,q,r)}
        T $in all_triangles
        finite_set_size(T)=3
        exist p,q,r cart(R,R) st {p $in T,q $in T,r $in T,$is_acute_triangle(p,q,r)}
    by thm acute_triangle_five_incidence_bound_20(S,acute_triangles,F5)
    finite_set_size(acute_triangles)*4656<=finite_set_size(F5)*7
    by thm incidence_seventy_percent_conclusion_20(acute_triangles,all_triangles,F5)
    10*finite_set_size(acute_triangles)<=7*finite_set_size(all_triangles)
