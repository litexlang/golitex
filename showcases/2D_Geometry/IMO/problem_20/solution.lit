thm sets_distinct_from_member_20:
    ? forall A,B set,x A:
        not x $in B
        =>:
            A!=B
    by contra:
        ? A!=B
        A=B
        x $in B
        impossible not x $in B

thm ten_three_sets_distinct_20:
    ? forall p,q,r,s,t cart(R,R):
        p!=q
        p!=r
        p!=s
        p!=t
        q!=r
        q!=s
        q!=t
        r!=s
        r!=t
        s!=t
        =>:
            {p,q,r}!={p,q,s}
            {p,q,r}!={p,q,t}
            {p,q,r}!={p,r,s}
            {p,q,r}!={p,r,t}
            {p,q,r}!={p,s,t}
            {p,q,r}!={q,r,s}
            {p,q,r}!={q,r,t}
            {p,q,r}!={q,s,t}
            {p,q,r}!={r,s,t}
            {p,q,s}!={p,q,t}
            {p,q,s}!={p,r,s}
            {p,q,s}!={p,r,t}
            {p,q,s}!={p,s,t}
            {p,q,s}!={q,r,s}
            {p,q,s}!={q,r,t}
            {p,q,s}!={q,s,t}
            {p,q,s}!={r,s,t}
            {p,q,t}!={p,r,s}
            {p,q,t}!={p,r,t}
            {p,q,t}!={p,s,t}
            {p,q,t}!={q,r,s}
            {p,q,t}!={q,r,t}
            {p,q,t}!={q,s,t}
            {p,q,t}!={r,s,t}
            {p,r,s}!={p,r,t}
            {p,r,s}!={p,s,t}
            {p,r,s}!={q,r,s}
            {p,r,s}!={q,r,t}
            {p,r,s}!={q,s,t}
            {p,r,s}!={r,s,t}
            {p,r,t}!={p,s,t}
            {p,r,t}!={q,r,s}
            {p,r,t}!={q,r,t}
            {p,r,t}!={q,s,t}
            {p,r,t}!={r,s,t}
            {p,s,t}!={q,r,s}
            {p,s,t}!={q,r,t}
            {p,s,t}!={q,s,t}
            {p,s,t}!={r,s,t}
            {q,r,s}!={q,r,t}
            {q,r,s}!={q,s,t}
            {q,r,s}!={r,s,t}
            {q,r,t}!={q,s,t}
            {q,r,t}!={r,s,t}
            {q,s,t}!={r,s,t}
    r $in {p,q,r}
    not r $in {p,q,s}
    by thm sets_distinct_from_member_20({p,q,r},{p,q,s},r)
    {p,q,r}!={p,q,s}
    r $in {p,q,r}
    not r $in {p,q,t}
    by thm sets_distinct_from_member_20({p,q,r},{p,q,t},r)
    {p,q,r}!={p,q,t}
    q $in {p,q,r}
    not q $in {p,r,s}
    by thm sets_distinct_from_member_20({p,q,r},{p,r,s},q)
    {p,q,r}!={p,r,s}
    q $in {p,q,r}
    not q $in {p,r,t}
    by thm sets_distinct_from_member_20({p,q,r},{p,r,t},q)
    {p,q,r}!={p,r,t}
    q $in {p,q,r}
    not q $in {p,s,t}
    by thm sets_distinct_from_member_20({p,q,r},{p,s,t},q)
    {p,q,r}!={p,s,t}
    p $in {p,q,r}
    not p $in {q,r,s}
    by thm sets_distinct_from_member_20({p,q,r},{q,r,s},p)
    {p,q,r}!={q,r,s}
    p $in {p,q,r}
    not p $in {q,r,t}
    by thm sets_distinct_from_member_20({p,q,r},{q,r,t},p)
    {p,q,r}!={q,r,t}
    p $in {p,q,r}
    not p $in {q,s,t}
    by thm sets_distinct_from_member_20({p,q,r},{q,s,t},p)
    {p,q,r}!={q,s,t}
    p $in {p,q,r}
    not p $in {r,s,t}
    by thm sets_distinct_from_member_20({p,q,r},{r,s,t},p)
    {p,q,r}!={r,s,t}
    s $in {p,q,s}
    not s $in {p,q,t}
    by thm sets_distinct_from_member_20({p,q,s},{p,q,t},s)
    {p,q,s}!={p,q,t}
    q $in {p,q,s}
    not q $in {p,r,s}
    by thm sets_distinct_from_member_20({p,q,s},{p,r,s},q)
    {p,q,s}!={p,r,s}
    q $in {p,q,s}
    not q $in {p,r,t}
    by thm sets_distinct_from_member_20({p,q,s},{p,r,t},q)
    {p,q,s}!={p,r,t}
    q $in {p,q,s}
    not q $in {p,s,t}
    by thm sets_distinct_from_member_20({p,q,s},{p,s,t},q)
    {p,q,s}!={p,s,t}
    p $in {p,q,s}
    not p $in {q,r,s}
    by thm sets_distinct_from_member_20({p,q,s},{q,r,s},p)
    {p,q,s}!={q,r,s}
    p $in {p,q,s}
    not p $in {q,r,t}
    by thm sets_distinct_from_member_20({p,q,s},{q,r,t},p)
    {p,q,s}!={q,r,t}
    p $in {p,q,s}
    not p $in {q,s,t}
    by thm sets_distinct_from_member_20({p,q,s},{q,s,t},p)
    {p,q,s}!={q,s,t}
    p $in {p,q,s}
    not p $in {r,s,t}
    by thm sets_distinct_from_member_20({p,q,s},{r,s,t},p)
    {p,q,s}!={r,s,t}
    q $in {p,q,t}
    not q $in {p,r,s}
    by thm sets_distinct_from_member_20({p,q,t},{p,r,s},q)
    {p,q,t}!={p,r,s}
    q $in {p,q,t}
    not q $in {p,r,t}
    by thm sets_distinct_from_member_20({p,q,t},{p,r,t},q)
    {p,q,t}!={p,r,t}
    q $in {p,q,t}
    not q $in {p,s,t}
    by thm sets_distinct_from_member_20({p,q,t},{p,s,t},q)
    {p,q,t}!={p,s,t}
    p $in {p,q,t}
    not p $in {q,r,s}
    by thm sets_distinct_from_member_20({p,q,t},{q,r,s},p)
    {p,q,t}!={q,r,s}
    p $in {p,q,t}
    not p $in {q,r,t}
    by thm sets_distinct_from_member_20({p,q,t},{q,r,t},p)
    {p,q,t}!={q,r,t}
    p $in {p,q,t}
    not p $in {q,s,t}
    by thm sets_distinct_from_member_20({p,q,t},{q,s,t},p)
    {p,q,t}!={q,s,t}
    p $in {p,q,t}
    not p $in {r,s,t}
    by thm sets_distinct_from_member_20({p,q,t},{r,s,t},p)
    {p,q,t}!={r,s,t}
    s $in {p,r,s}
    not s $in {p,r,t}
    by thm sets_distinct_from_member_20({p,r,s},{p,r,t},s)
    {p,r,s}!={p,r,t}
    r $in {p,r,s}
    not r $in {p,s,t}
    by thm sets_distinct_from_member_20({p,r,s},{p,s,t},r)
    {p,r,s}!={p,s,t}
    p $in {p,r,s}
    not p $in {q,r,s}
    by thm sets_distinct_from_member_20({p,r,s},{q,r,s},p)
    {p,r,s}!={q,r,s}
    p $in {p,r,s}
    not p $in {q,r,t}
    by thm sets_distinct_from_member_20({p,r,s},{q,r,t},p)
    {p,r,s}!={q,r,t}
    p $in {p,r,s}
    not p $in {q,s,t}
    by thm sets_distinct_from_member_20({p,r,s},{q,s,t},p)
    {p,r,s}!={q,s,t}
    p $in {p,r,s}
    not p $in {r,s,t}
    by thm sets_distinct_from_member_20({p,r,s},{r,s,t},p)
    {p,r,s}!={r,s,t}
    r $in {p,r,t}
    not r $in {p,s,t}
    by thm sets_distinct_from_member_20({p,r,t},{p,s,t},r)
    {p,r,t}!={p,s,t}
    p $in {p,r,t}
    not p $in {q,r,s}
    by thm sets_distinct_from_member_20({p,r,t},{q,r,s},p)
    {p,r,t}!={q,r,s}
    p $in {p,r,t}
    not p $in {q,r,t}
    by thm sets_distinct_from_member_20({p,r,t},{q,r,t},p)
    {p,r,t}!={q,r,t}
    p $in {p,r,t}
    not p $in {q,s,t}
    by thm sets_distinct_from_member_20({p,r,t},{q,s,t},p)
    {p,r,t}!={q,s,t}
    p $in {p,r,t}
    not p $in {r,s,t}
    by thm sets_distinct_from_member_20({p,r,t},{r,s,t},p)
    {p,r,t}!={r,s,t}
    p $in {p,s,t}
    not p $in {q,r,s}
    by thm sets_distinct_from_member_20({p,s,t},{q,r,s},p)
    {p,s,t}!={q,r,s}
    p $in {p,s,t}
    not p $in {q,r,t}
    by thm sets_distinct_from_member_20({p,s,t},{q,r,t},p)
    {p,s,t}!={q,r,t}
    p $in {p,s,t}
    not p $in {q,s,t}
    by thm sets_distinct_from_member_20({p,s,t},{q,s,t},p)
    {p,s,t}!={q,s,t}
    p $in {p,s,t}
    not p $in {r,s,t}
    by thm sets_distinct_from_member_20({p,s,t},{r,s,t},p)
    {p,s,t}!={r,s,t}
    s $in {q,r,s}
    not s $in {q,r,t}
    by thm sets_distinct_from_member_20({q,r,s},{q,r,t},s)
    {q,r,s}!={q,r,t}
    r $in {q,r,s}
    not r $in {q,s,t}
    by thm sets_distinct_from_member_20({q,r,s},{q,s,t},r)
    {q,r,s}!={q,s,t}
    q $in {q,r,s}
    not q $in {r,s,t}
    by thm sets_distinct_from_member_20({q,r,s},{r,s,t},q)
    {q,r,s}!={r,s,t}
    r $in {q,r,t}
    not r $in {q,s,t}
    by thm sets_distinct_from_member_20({q,r,t},{q,s,t},r)
    {q,r,t}!={q,s,t}
    q $in {q,r,t}
    not q $in {r,s,t}
    by thm sets_distinct_from_member_20({q,r,t},{r,s,t},q)
    {q,r,t}!={r,s,t}
    q $in {q,s,t}
    not q $in {r,s,t}
    by thm sets_distinct_from_member_20({q,s,t},{r,s,t},q)
    {q,s,t}!={r,s,t}

thm acute_five_set_family_bound_20:
    ? forall p,q,r,s,t cart(R,R),A finite_set:
        p!=q
        p!=r
        p!=s
        p!=t
        q!=r
        q!=s
        q!=t
        r!=s
        r!=t
        s!=t
        A $subset power_set({p,q,r,s,t})
        forall T finite_set:
            T $in A
            =>:
                finite_set_size(T)=3
                exist u,v,w cart(R,R) st {u $in T,v $in T,w $in T,$is_acute_triangle(u,v,w)}
        forall u,v,w cart(R,R):
            u $in {p,q,r,s,t}
            v $in {p,q,r,s,t}
            w $in {p,q,r,s,t}
            u!=v
            u!=w
            v!=w
            =>:
                not $is_collinear(u,v,w)
        =>:
            finite_set_size(A)<=7
    by thm ten_three_sets_distinct_20(p,q,r,s,t)
    have F finite_set = {{p,q,r},{p,q,s},{p,q,t},{p,r,s},{p,r,t},{p,s,t},{q,r,s},{q,r,t},{q,s,t},{r,s,t}}
    claim:
        ? forall T A:
            T $in F
        T $in power_set({p,q,r,s,t})
        T $subset {p,q,r,s,t}
        release thm subset_of_finite_set_is_finite(T,{p,q,r,s,t})
        $is_finite_set(T)
        finite_set_size(T)=3
        by thm three_subset_of_five_alternatives_20(p,q,r,s,t,T)
        by cases:
            ? T $in F
            case T={p,q,r}:
                {p,q,r} $in F
                T $in F
            case T={p,q,s}:
                {p,q,s} $in F
                T $in F
            case T={p,q,t}:
                {p,q,t} $in F
                T $in F
            case T={p,r,s}:
                {p,r,s} $in F
                T $in F
            case T={p,r,t}:
                {p,r,t} $in F
                T $in F
            case T={p,s,t}:
                {p,s,t} $in F
                T $in F
            case T={q,r,s}:
                {q,r,s} $in F
                T $in F
            case T={q,r,t}:
                {q,r,t} $in F
                T $in F
            case T={q,s,t}:
                {q,s,t} $in F
                T $in F
            case T={r,s,t}:
                {r,s,t} $in F
                T $in F
    A $subset F
    by extension:
        ? intersect(F,A)=A
        claim:
            ? forall T intersect(F,A):
                T $in A
            T $in A
        claim:
            ? forall T A:
                T $in intersect(F,A)
            T $in F
            T $in intersect(F,A)
    algo membership(x F) N by cases:
        case x $in A: 1
        case not x $in A: 0
    claim:
        ? forall x F:
            x={p,q,r} or x={p,q,s} or x={p,q,t} or x={p,r,s} or x={p,r,t} or x={p,s,t} or x={q,r,s} or x={q,r,t} or x={q,s,t} or x={r,s,t}
        x $in {{p,q,r},{p,q,s},{p,q,t},{p,r,s},{p,r,t},{p,s,t},{q,r,s},{q,r,t},{q,s,t},{r,s,t}}
        x={p,q,r} or x={p,q,s} or x={p,q,t} or x={p,r,s} or x={p,r,t} or x={p,s,t} or x={q,r,s} or x={q,r,t} or x={q,s,t} or x={r,s,t}
    algo vertex_value(x F) N by cases:
        case x={p,q,r}: acute_flag_20(p,q,r)
        case x={p,q,s}: acute_flag_20(p,q,s)
        case x={p,q,t}: acute_flag_20(p,q,t)
        case x={p,r,s}: acute_flag_20(p,r,s)
        case x={p,r,t}: acute_flag_20(p,r,t)
        case x={p,s,t}: acute_flag_20(p,s,t)
        case x={q,r,s}: acute_flag_20(q,r,s)
        case x={q,r,t}: acute_flag_20(q,r,t)
        case x={q,s,t}: acute_flag_20(q,s,t)
        case x={r,s,t}: acute_flag_20(r,s,t)
    claim:
        ? forall x F:
            x $in A
            =>:
                membership(x)=1
        membership(x)=1
    claim:
        ? forall x F:
            not x $in A
            =>:
                membership(x)=0
        membership(x)=0
    by thm membership_flag_counts_intersection_20(F,A,membership)
    finite_set_sum(F,membership)=finite_set_size(intersect(F,A))
    finite_set_size(intersect(F,A))=finite_set_size(A)
    finite_set_sum(F,membership)=finite_set_size(intersect(F,A))=finite_set_size(A)
    by thm acute_flag_bounds_20(p,q,r)
    by thm acute_flag_bounds_20(p,q,s)
    by thm acute_flag_bounds_20(p,q,t)
    by thm acute_flag_bounds_20(p,r,s)
    by thm acute_flag_bounds_20(p,r,t)
    by thm acute_flag_bounds_20(p,s,t)
    by thm acute_flag_bounds_20(q,r,s)
    by thm acute_flag_bounds_20(q,r,t)
    by thm acute_flag_bounds_20(q,s,t)
    by thm acute_flag_bounds_20(r,s,t)
    claim:
        ? forall x F:
            membership(x)<=vertex_value(x)
        by cases:
            ? membership(x)<=vertex_value(x)
            case x={p,q,r}:
                vertex_value(x)=acute_flag_20(p,q,r)
                by cases:
                    ? membership(x)<=vertex_value(x)
                    case x $in A:
                        $is_finite_set(x)
                        obtain u,v,w from exist u,v,w cart(R,R) st {u $in x,v $in x,w $in x,$is_acute_triangle(u,v,w)}
                        u $in {p,q,r}
                        v $in {p,q,r}
                        w $in {p,q,r}
                        by thm acute_in_three_set_implies_acute_20(p,q,r,u,v,w)
                        acute_flag_20(p,q,r)=1
                        membership(x)=1
                        vertex_value(x)=1
                        membership(x)<=vertex_value(x)
                    case not x $in A:
                        membership(x)=0
                        0<=acute_flag_20(p,q,r)
                        membership(x)<=vertex_value(x)
            case x={p,q,s}:
                vertex_value(x)=acute_flag_20(p,q,s)
                by cases:
                    ? membership(x)<=vertex_value(x)
                    case x $in A:
                        $is_finite_set(x)
                        obtain u,v,w from exist u,v,w cart(R,R) st {u $in x,v $in x,w $in x,$is_acute_triangle(u,v,w)}
                        u $in {p,q,s}
                        v $in {p,q,s}
                        w $in {p,q,s}
                        by thm acute_in_three_set_implies_acute_20(p,q,s,u,v,w)
                        acute_flag_20(p,q,s)=1
                        membership(x)=1
                        vertex_value(x)=1
                        membership(x)<=vertex_value(x)
                    case not x $in A:
                        membership(x)=0
                        0<=acute_flag_20(p,q,s)
                        membership(x)<=vertex_value(x)
            case x={p,q,t}:
                vertex_value(x)=acute_flag_20(p,q,t)
                by cases:
                    ? membership(x)<=vertex_value(x)
                    case x $in A:
                        $is_finite_set(x)
                        obtain u,v,w from exist u,v,w cart(R,R) st {u $in x,v $in x,w $in x,$is_acute_triangle(u,v,w)}
                        u $in {p,q,t}
                        v $in {p,q,t}
                        w $in {p,q,t}
                        by thm acute_in_three_set_implies_acute_20(p,q,t,u,v,w)
                        acute_flag_20(p,q,t)=1
                        membership(x)=1
                        vertex_value(x)=1
                        membership(x)<=vertex_value(x)
                    case not x $in A:
                        membership(x)=0
                        0<=acute_flag_20(p,q,t)
                        membership(x)<=vertex_value(x)
            case x={p,r,s}:
                vertex_value(x)=acute_flag_20(p,r,s)
                by cases:
                    ? membership(x)<=vertex_value(x)
                    case x $in A:
                        $is_finite_set(x)
                        obtain u,v,w from exist u,v,w cart(R,R) st {u $in x,v $in x,w $in x,$is_acute_triangle(u,v,w)}
                        u $in {p,r,s}
                        v $in {p,r,s}
                        w $in {p,r,s}
                        by thm acute_in_three_set_implies_acute_20(p,r,s,u,v,w)
                        acute_flag_20(p,r,s)=1
                        membership(x)=1
                        vertex_value(x)=1
                        membership(x)<=vertex_value(x)
                    case not x $in A:
                        membership(x)=0
                        0<=acute_flag_20(p,r,s)
                        membership(x)<=vertex_value(x)
            case x={p,r,t}:
                vertex_value(x)=acute_flag_20(p,r,t)
                by cases:
                    ? membership(x)<=vertex_value(x)
                    case x $in A:
                        $is_finite_set(x)
                        obtain u,v,w from exist u,v,w cart(R,R) st {u $in x,v $in x,w $in x,$is_acute_triangle(u,v,w)}
                        u $in {p,r,t}
                        v $in {p,r,t}
                        w $in {p,r,t}
                        by thm acute_in_three_set_implies_acute_20(p,r,t,u,v,w)
                        acute_flag_20(p,r,t)=1
                        membership(x)=1
                        vertex_value(x)=1
                        membership(x)<=vertex_value(x)
                    case not x $in A:
                        membership(x)=0
                        0<=acute_flag_20(p,r,t)
                        membership(x)<=vertex_value(x)
            case x={p,s,t}:
                vertex_value(x)=acute_flag_20(p,s,t)
                by cases:
                    ? membership(x)<=vertex_value(x)
                    case x $in A:
                        $is_finite_set(x)
                        obtain u,v,w from exist u,v,w cart(R,R) st {u $in x,v $in x,w $in x,$is_acute_triangle(u,v,w)}
                        u $in {p,s,t}
                        v $in {p,s,t}
                        w $in {p,s,t}
