    have Pairs set = {k D: $is_finite_set(k),finite_set_size(k)=2}
    Pairs $subset D
    release thm subset_of_finite_set_is_finite(Pairs,D)
    $is_finite_set(Pairs)
    Pairs $subset power_set(W)
    claim:
        ? forall k finite_set:
            k $in Pairs
            =>:
                finite_set_size(k)=2
        k $in {kk D: $is_finite_set(kk),finite_set_size(kk)=2}
        finite_set_size(k)=2
    claim:
        ? forall k finite_set:
            k $subset W
            finite_set_size(k)=2
            =>:
                k $in Pairs
        k $in power_set(W)
        k $in D
        k $in {kk D: $is_finite_set(kk),finite_set_size(kk)=2}
        k $in Pairs
    97=96+1
    finite_set_size(W)=96+1
    by thm unordered_two_subset_cardinality_20(W,Pairs,96)
    2*finite_set_size(Pairs)=97*96=9312
    by thm half_of_9312_20(finite_set_size(Pairs))
    finite_set_size(Pairs)=4656
    claim:
        ? forall k Pairs:
            union(T,k) $in E5
        k $in D
        k $in power_set(W)
        k $subset W
        release thm subset_of_finite_set_is_finite(k,W)
        $is_finite_set(k)
        finite_set_size(k)=2
        k $subset set_minus(S,T)
        by thm three_plus_two_extension_20(S,T,k)
        union(T,k) $subset S
        finite_set_size(union(T,k))=5
        T $subset union(T,k)
        union(T,k) $in E5
    have fn extend(k Pairs) E5 = union(T,k)
    claim:
        ? forall k1,k2 Pairs:
            extend(k1)=extend(k2)
            =>:
                k1=k2
        k1 $in D
        k2 $in D
        k1 $in power_set(W)
        k2 $in power_set(W)
        k1 $subset W
        k2 $subset W
        release thm subset_of_finite_set_is_finite(k1,W)
        release thm subset_of_finite_set_is_finite(k2,W)
        $is_finite_set(k1)
        $is_finite_set(k2)
        finite_set_size(k1)=2
        finite_set_size(k2)=2
        k1 $subset set_minus(S,T)
        k2 $subset set_minus(S,T)
        by thm three_plus_two_extension_20(S,T,k1)
        by thm three_plus_two_extension_20(S,T,k2)
        set_minus(union(T,k1),T)=k1
        set_minus(union(T,k2),T)=k2
        extend(k1)=union(T,k1)
        extend(k2)=union(T,k2)
        union(T,k1)=union(T,k2)
        set_minus(union(T,k1),T)=set_minus(union(T,k2),T)
        k1=set_minus(union(T,k1),T)=set_minus(union(T,k2),T)=k2
    by def:
        ? $injective(Pairs,E5,extend)
    claim:
        ? forall U E5:
            exist k Pairs st {U=extend(k)}
        U $in power_set(S)
        U $subset S
        release thm subset_of_finite_set_is_finite(U,S)
        $is_finite_set(U)
        T $subset U
        finite_set_size(U)=5
        by thm five_extension_remainder_20(S,T,U)
        have K finite_set = set_minus(U,T)
        K $subset set_minus(S,T)
        K $subset W
        finite_set_size(K)=finite_set_size(set_minus(U,T))=2
        K $in Pairs
        extend(K)=union(T,K)
        union(T,K)=union(T,set_minus(U,T))=U
        witness exist k Pairs st {U=extend(k)} from K:
            extend(K)=U
    by def:
        ? $surjective(Pairs,E5,extend)
    by def:
        ? $bijective(Pairs,E5,extend)
    finite_set_size(E5)=finite_set_size(Pairs)=4656

