    vertex_value({q,s,t})=acute_flag_20(q,s,t)
    vertex_value({r,s,t})=acute_flag_20(r,s,t)
    finite_set_sum(F,vertex_value)=finite_set_sum({{p,q,r},{p,q,s},{p,q,t},{p,r,s},{p,r,t},{p,s,t},{q,r,s},{q,r,t},{q,s,t},{r,s,t}},vertex_value)
    finite_set_sum({{p,q,r},{p,q,s},{p,q,t},{p,r,s},{p,r,t},{p,s,t},{q,r,s},{q,r,t},{q,s,t},{r,s,t}},vertex_value)=vertex_value({p,q,r})+vertex_value({p,q,s})+vertex_value({p,q,t})+vertex_value({p,r,s})+vertex_value({p,r,t})+vertex_value({p,s,t})+vertex_value({q,r,s})+vertex_value({q,r,t})+vertex_value({q,s,t})+vertex_value({r,s,t})
    vertex_value({p,q,r})+vertex_value({p,q,s})+vertex_value({p,q,t})+vertex_value({p,r,s})+vertex_value({p,r,t})+vertex_value({p,s,t})+vertex_value({q,r,s})+vertex_value({q,r,t})+vertex_value({q,s,t})+vertex_value({r,s,t})=acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,q,t)+acute_flag_20(p,r,s)+acute_flag_20(p,r,t)+acute_flag_20(p,s,t)+acute_flag_20(q,r,s)+acute_flag_20(q,r,t)+acute_flag_20(q,s,t)+acute_flag_20(r,s,t)
    finite_set_sum(F,vertex_value)=vertex_value({p,q,r})+vertex_value({p,q,s})+vertex_value({p,q,t})+vertex_value({p,r,s})+vertex_value({p,r,t})+vertex_value({p,s,t})+vertex_value({q,r,s})+vertex_value({q,r,t})+vertex_value({q,s,t})+vertex_value({r,s,t})=acute_flag_20(p,q,r)+acute_flag_20(p,q,s)+acute_flag_20(p,q,t)+acute_flag_20(p,r,s)+acute_flag_20(p,r,t)+acute_flag_20(p,s,t)+acute_flag_20(q,r,s)+acute_flag_20(q,r,t)+acute_flag_20(q,s,t)+acute_flag_20(r,s,t)
    not $is_collinear(p,r,s)
    not $is_collinear(p,s,q)
    not $is_collinear(p,q,r)
    not $is_collinear(q,r,s)
    not $is_collinear(p,r,t)
