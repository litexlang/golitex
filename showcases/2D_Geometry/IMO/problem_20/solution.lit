                        membership(x)=0
                        0<=acute_flag_20(r,s,t)
                        membership(x)<=vertex_value(x)
    release thm finite_set_sum_le_from_pointwise(finite_set_sum(F,membership),finite_set_sum(F,vertex_value))
    finite_set_sum(F,membership)<=finite_set_sum(F,vertex_value)
    vertex_value({p,q,r})=acute_flag_20(p,q,r)
    vertex_value({p,q,s})=acute_flag_20(p,q,s)
