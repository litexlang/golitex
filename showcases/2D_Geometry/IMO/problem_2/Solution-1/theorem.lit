# Custom Theorems for Problem 2
# imo_official_1960_eng_6

# Algebraic identity used for the minimum ratio.
thm ratio_identity:
    ? forall r, base_r, height, v1, v2, x R:
        r > 0
        base_r = x * r
        height * (base_r^2 - r^2) = 2 * base_r^2 * r
        3 * v1 = base_r^2 * height
        v2 = 2 * r^3
        =>:
            3 * v1 * (x^2 - 1) = x^4 * v2
    base_r^2 = (x*r)^2 = x^2*r^2
    base_r^2-r^2 = x^2*r^2-r^2 = r^2*(x^2-1)
    height*(r^2*(x^2-1)) = height*(base_r^2-r^2) = 2*base_r^2*r = 2*(x^2*r^2)*r = 2*x^2*r^3
    3*v1*(x^2-1) = base_r^2*height*(x^2-1) = (x^2*r^2)*height*(x^2-1) = x^2*(height*(r^2*(x^2-1))) = x^2*(2*x^2*r^3) = x^4*(2*r^3) = x^4*v2

thm minimum_ratio_bound:
    ? forall r, v1, v2, x R:
        r > 0
        x > 1
        v2 = 2 * r^3
        3 * v1 * (x^2 - 1) = x^4 * v2
        =>:
            3 * v1 >= 4 * v2
    x - 1 > 0
    x + 1 > 0
    (x - 1) * (x + 1) > 0
    (x - 1) * (x + 1) = x^2 - 1
    x^2 - 1 > 0
    r * r > 0
    r^2 = r * r
    r^2 > 0
    r^2 * r > 0
    r^3 = r^2 * r
    r^3 > 0
    2 * r^3 > 0
    v2 > 0
    v2 >= 0
    (x^2 - 2)^2 >= 0
    v2 * (x^2 - 2)^2 >= 0
    (3*v1-4*v2)*(x^2-1) = 3*v1*(x^2-1)-4*v2*(x^2-1) = x^4*v2-4*v2*(x^2-1) = v2*(x^4-4*(x^2-1)) = v2*(x^2-2)^2
    (3 * v1 - 4 * v2) * (x^2 - 1) >= 0
    3*v1-4*v2 = ((3*v1-4*v2)*(x^2-1))/(x^2-1) = (v2*(x^2-2)^2)/(x^2-1)
    (v2*(x^2-2)^2)/(x^2-1) >= 0
    3*v1-4*v2 >= 0

    3*v1 = (3*v1-4*v2) + 4*v2
    (3*v1-4*v2) + 4*v2 >= 0 + 4*v2
    0 + 4*v2 = 4*v2

thm equality_ratio:
    ? forall v1, v2, x R:
        x^2 = 2
        3*v1*(x^2-1) = x^4*v2
        =>:
            3*v1 = 4*v2
    x^2-1 = 2-1 = 1
    x^4 = x^2*x^2 = 2*2 = 4
    3*v1 = 3*v1*1 = 3*v1*(x^2-1) = x^4*v2 = 4*v2

thm equality_apex_cosine:
    ? forall r, base_r, height, cos_theta, x R:
        r > 0
        base_r = x * r
        x^2 = 2
        height * (base_r^2 - r^2) = 2 * base_r^2 * r
        cos_theta * (height^2 + base_r^2) = height^2 - base_r^2
        =>:
            9 * cos_theta = 7
    r*r > 0
    r^2 = r*r
    r^2 > 0
    r^2 != 0
    base_r^2 = (x*r)^2 = x^2*r^2 = 2*r^2
    base_r^2-r^2 = 2*r^2-r^2 = r^2
    height*r^2 = height*(base_r^2-r^2) = 2*base_r^2*r = 2*(2*r^2)*r = 4*r^3
    height = (height*r^2)/r^2 = (4*r^3)/r^2 = 4*r
    height^2 = (4*r)^2 = 16*r^2
    height^2+base_r^2 = 16*r^2+base_r^2 = 16*r^2+2*r^2 = 18*r^2
    height^2-base_r^2 = 16*r^2-base_r^2 = 16*r^2-2*r^2 = 14*r^2
    (18*cos_theta)*r^2 = cos_theta*(18*r^2) = cos_theta*(height^2+base_r^2) = height^2-base_r^2 = 14*r^2
    18*cos_theta = ((18*cos_theta)*r^2)/r^2 = (14*r^2)/r^2 = 14
    9*cos_theta = (18*cos_theta)/2 = 14/2 = 7
