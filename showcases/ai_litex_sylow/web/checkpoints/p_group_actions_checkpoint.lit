# Finite p-group action checkpoint through prime-power factor divisibility.


thm prime_divides_nontrivial_factor_of_prime_power:
    ? forall p N+, n N, left, right N+:
        $prime(p)
        left * right = p^n
        left > 1
        =>:
            $group::divides(p, left)
    prop _prime_power_factor_counterexample(exponent N):
        exist a, b N+ st {$prime(p), a * b = p^exponent, a > 1, not $group::divides(p, a)}
    prop _no_prime_power_factor_counterexample(exponent N):
        not $_prime_power_factor_counterexample(exponent)
    claim:
        ? forall exponent N:
            $_no_prime_power_factor_counterexample(exponent)
        by induc exponent from 0:
            ? $_no_prime_power_factor_counterexample(exponent)
            ? from exponent = 0:
                claim:
                    ? not $_prime_power_factor_counterexample(exponent)
                    by contra:
                        ? not $_prime_power_factor_counterexample(exponent)
                        exist source_a, source_b N+ st {$prime(p), source_a * source_b = p^exponent, source_a > 1, not $group::divides(p, source_a)}
                        obtain a, b from exist source_a, source_b N+ st {$prime(p), source_a * source_b = p^exponent, source_a > 1, not $group::divides(p, source_a)}
                        exponent = 0
                        p^exponent = p^0 = 1
                        a >= 1
                        b >= 1
                        a * b >= a * 1 = a > 1
                        a * b = p^exponent = 1
                        0 < 0
                        impossible 0 < 0
                by def $_no_prime_power_factor_counterexample(exponent)
                $_no_prime_power_factor_counterexample(exponent)
            ? induc:
                $_no_prime_power_factor_counterexample(exponent)
                not $_prime_power_factor_counterexample(exponent)
                claim:
                    ? not $_prime_power_factor_counterexample(exponent + 1)
                    by contra:
                        ? not $_prime_power_factor_counterexample(exponent + 1)
                        exist source_a, source_b N+ st {$prime(p), source_a * source_b = p^(exponent + 1), source_a > 1, not $group::divides(p, source_a)}
                        obtain a, b from exist source_a, source_b N+ st {$prime(p), source_a * source_b = p^(exponent + 1), source_a > 1, not $group::divides(p, source_a)}
                        p^(exponent + 1) = p^exponent * p = p * p^exponent
                        witness $group::divides(p, a * b) from p^exponent:
                            a * b = p^(exponent + 1) = p * p^exponent
                        release thm prime_arithmetic::prime_divides_product(p, a, b)
                        by cases:
                            ? 0 < 0
                            case $group::divides(p, a):
                                impossible not $group::divides(p, a)
                            case $group::divides(p, b):
                                obtain quotient from $group::divides(p, b)
                                b = p * quotient
                                by cases:
                                    ? 0 < 0
                                    case quotient > 0:
                                        quotient $in N+
                                        a * b = a * (p * quotient) = p * (a * quotient)
                                        p^(exponent + 1) = p * p^exponent
                                        p * (a * quotient) = a * b = p^(exponent + 1) = p * p^exponent
                                        p != 0
                                        release thm prime_arithmetic::integer_left_multiplication_cancellation(p, a * quotient, p^exponent)
                                        a * quotient = p^exponent
                                        witness exist old_left, old_right N+ st {$prime(p), old_left * old_right = p^exponent, old_left > 1, not $group::divides(p, old_left)} from a, quotient:
                                            $prime(p)
                                            a * quotient = p^exponent
                                            a > 1
                                            not $group::divides(p, a)
                                        by def $_prime_power_factor_counterexample(exponent)
                                        $_prime_power_factor_counterexample(exponent)
                                        impossible not $_prime_power_factor_counterexample(exponent)
                                    case quotient = 0:
                                        b = p * quotient = p * 0 = 0
                                        impossible b > 0
                                    case quotient < 0:
                                        p > 0
                                        p * quotient < 0
                                        b = p * quotient < 0
                                        impossible b > 0
                        0 < 0
                        impossible 0 < 0
                by def $_no_prime_power_factor_counterexample(exponent + 1)
                $_no_prime_power_factor_counterexample(exponent + 1)
    $_no_prime_power_factor_counterexample(n)
    not $_prime_power_factor_counterexample(n)
    by contra:
        ? $group::divides(p, left)
        not $group::divides(p, left)
        witness exist counter_left, counter_right N+ st {$prime(p), counter_left * counter_right = p^n, counter_left > 1, not $group::divides(p, counter_left)} from left, right:
            $prime(p)
            left * right = p^n
            left > 1
            not $group::divides(p, left)
        by def $_prime_power_factor_counterexample(n)
        $_prime_power_factor_counterexample(n)
        impossible not $_prime_power_factor_counterexample(n)
