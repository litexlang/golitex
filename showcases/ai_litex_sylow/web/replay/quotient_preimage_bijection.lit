# Restrict the quotient-coset coordinate bijection to a subgroup K of the
# normalizer quotient.  This file constructs the two typed maps and proves
# bijectivity; cardinality arithmetic is deliberately deferred.

thm sylow_preimage_projection_pair_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set, x G:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        x $in \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)
        =>:
            (\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)) $in cart(K, H)
    release thm quotient_preimage::sylow_preimage_forward_pair_mem(G, group, H, K, x)
    (\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)) $in cart(K, H)
    \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in K
    \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in H
    \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) = \cosets::left_coset<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H, x) = \cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
    \cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in K
    release thm cart_member_from_coordinates((\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)), cart(K, H))

thm sylow_preimage_subgroup_backward_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K, pair set:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        pair $in cart(K, H)
        =>:
            \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) $in \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)
    release thm quotient_preimage::sylow_preimage_backward_mem(G, group, H, K, pair)
    group.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) $in \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)
    release thm quotient_preimage::subgroup_group_mul_is_ambient(G, group, \normalizer::subgroup_normalizer<G, group>(H), \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) = group.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) $in \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)

template<G nonempty_set, group &group::Group<G>, H power_set(G): $subgroup::is_subgroup(G, group, H), $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H)), $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)>:
    have fn sylow_preimage_coordinate_forward(K power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>), x \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) cart(K, H) = (\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x))

template<G nonempty_set, group &group::Group<G>, H power_set(G): $subgroup::is_subgroup(G, group, H), $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H)), $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)>:
    have fn sylow_preimage_coordinate_backward(K power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>), pair cart(K, H)) \quotient_preimage::sylow_quotient_preimage<G, group, H>(K) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])

thm sylow_preimage_coordinate_bijective:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        =>:
            exist coordinate_forward fn(x \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) cart(K, H) st {$bijective(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward)}
    have fn coordinate_forward(x \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) cart(K, H) = \sylow_preimage_coordinate_forward<G, group, H>(K, x)
    have fn coordinate_backward(pair cart(K, H)) \quotient_preimage::sylow_quotient_preimage<G, group, H>(K) = \sylow_preimage_coordinate_backward<G, group, H>(K, pair)
    claim:
        ? $function_inverse::is_left_inverse(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward, coordinate_backward)
        claim:
            ? forall x \quotient_preimage::sylow_quotient_preimage<G, group, H>(K):
                coordinate_backward(coordinate_forward(x)) = x
            coordinate_forward(x) = \sylow_preimage_coordinate_forward<G, group, H>(K, x)
            \sylow_preimage_coordinate_forward<G, group, H>(K, x) = (\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x))
            coordinate_forward(x) = (\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x))
            coordinate_forward(x)[1] = \cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
            coordinate_forward(x)[2] = \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
            coordinate_backward(coordinate_forward(x)) = \sylow_preimage_coordinate_backward<G, group, H>(K, coordinate_forward(x))
            \sylow_preimage_coordinate_backward<G, group, H>(K, coordinate_forward(x)) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(coordinate_forward(x)[1]), coordinate_forward(x)[2])
            coordinate_backward(coordinate_forward(x)) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x))
            release thm quotient_preimage_coordinates::quotient_reconstruction_element(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, x)
            coordinate_backward(coordinate_forward(x)) = x
        by def $function_inverse::is_left_inverse(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward, coordinate_backward)
    release thm function_inverse::injective_of_left_inverse(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward, coordinate_backward)
    claim:
        ? $function_inverse::is_right_inverse(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward, coordinate_backward)
        claim:
            ? forall pair cart(K, H):
                coordinate_forward(coordinate_backward(pair)) = pair
            pair[1] $in K
            pair[2] $in H
            K $subset \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>
            pair[1] $in \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>
            \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H> = \cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H)
            pair[1] $in \cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H)
            coordinate_backward(pair) = \sylow_preimage_coordinate_backward<G, group, H>(K, pair)
            \sylow_preimage_coordinate_backward<G, group, H>(K, pair) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
            coordinate_backward(pair) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
            coordinate_forward(coordinate_backward(pair)) = \sylow_preimage_coordinate_forward<G, group, H>(K, coordinate_backward(pair))
            \sylow_preimage_coordinate_forward<G, group, H>(K, coordinate_backward(pair)) = (\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(coordinate_backward(pair)), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(coordinate_backward(pair)))
            coordinate_forward(coordinate_backward(pair)) = (\cosets::left_coset_projection<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])))
            release thm quotient_preimage_coordinates::quotient_reconstruction_pair(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, pair[1], pair[2])
            coordinate_forward(coordinate_backward(pair)) = (pair[1], pair[2])
            release thm tuple_equal_from_coordinates(pair, (pair[1], pair[2]))
            pair = (pair[1], pair[2])
            coordinate_forward(coordinate_backward(pair)) = pair
        by def $function_inverse::is_right_inverse(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward, coordinate_backward)
    release thm function_inverse::surjective_of_right_inverse(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward, coordinate_backward)
    by def $bijective(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward)
    witness exist result fn(x \quotient_preimage::sylow_quotient_preimage<G, group, H>(K)) cart(K, H) st {$bijective(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), result)} from coordinate_forward:
        $bijective(\quotient_preimage::sylow_quotient_preimage<G, group, H>(K), cart(K, H), coordinate_forward)
