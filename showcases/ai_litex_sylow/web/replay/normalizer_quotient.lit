# The normalizer quotient N_G(H)/H converts fixed-coset divisibility into a
# finite quotient group where Cauchy's theorem produces a subgroup of order p.

thm quotient_group_mk_is_group_hom:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G):
        $normal_subgroup::is_normal_subgroup(G, group, H)
        =>:
            $group_homomorphism::is_group_hom(G, \quotient_groups::quotient_group_nonempty<G, group, H>, group, \quotient_groups::quotient_group<G, group, H>, \quotient_groups::quotient_group_mk<G, group, H>)
    \quotient_groups::quotient_group<G, group, H>.one = \quotient_groups::quotient_group_one<G, group, H> = \quotient_groups::quotient_group_mk<G, group, H>(group.one)
    \quotient_groups::quotient_group_mk<G, group, H>(group.one) = \quotient_groups::quotient_group<G, group, H>.one
    claim:
        ? forall x, y G:
            \quotient_groups::quotient_group_mk<G, group, H>(group.mul(x, y)) = \quotient_groups::quotient_group<G, group, H>.mul(\quotient_groups::quotient_group_mk<G, group, H>(x), \quotient_groups::quotient_group_mk<G, group, H>(y))
        \quotient_groups::quotient_group<G, group, H>.mul = \quotient_groups::quotient_group_mul<G, group, H>
        \quotient_groups::quotient_group<G, group, H>.mul(\quotient_groups::quotient_group_mk<G, group, H>(x), \quotient_groups::quotient_group_mk<G, group, H>(y)) = \quotient_groups::quotient_group_mul<G, group, H>(\quotient_groups::quotient_group_mk<G, group, H>(x), \quotient_groups::quotient_group_mk<G, group, H>(y))
        release thm quotient_groups::quotient_group_mul_mk(G, group, H, x, y)
        \quotient_groups::quotient_group_mul<G, group, H>(\quotient_groups::quotient_group_mk<G, group, H>(x), \quotient_groups::quotient_group_mk<G, group, H>(y)) = \quotient_groups::quotient_group_mk<G, group, H>(group.mul(x, y))
    by def:
        ? $group_homomorphism::is_monoid_hom(G, \quotient_groups::quotient_group_nonempty<G, group, H>, group.mul, group.one, \quotient_groups::quotient_group<G, group, H>.mul, \quotient_groups::quotient_group<G, group, H>.one, \quotient_groups::quotient_group_mk<G, group, H>)
    by def:
        ? $group_homomorphism::is_group_hom(G, \quotient_groups::quotient_group_nonempty<G, group, H>, group, \quotient_groups::quotient_group<G, group, H>, \quotient_groups::quotient_group_mk<G, group, H>)

thm normalizer_quotient_cardinality_eq_fixed_cosets:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G):
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        $is_finite_set(G)
        $is_finite_set(H)
        =>:
            $is_finite_set(\sylow_coset_action::sylow_fixed_cosets<G, group, H>)
            $is_finite_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
            finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>)
    release thm normalizer::subgroup_normalizer_closed(G, group, H)
    release thm normalizer::subgroup_normalizer_finite(G, group, H)
    release thm normalizer::subgroup_normal_in_normalizer(G, group, H)
    \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)> = \normalizer::subgroup_normalizer<G, group>(H)
    $is_finite_set(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>)
    release thm sylow_coset_action::finite_group_coset_cardinality_product(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
    $is_finite_set(\cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H))
    \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H> = \cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H)
    $is_finite_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
    finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H))
    finite_set_size(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>) = finite_set_size(\cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H)) * finite_set_size(H) = finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) * finite_set_size(H)
    release thm sylow_coset_action::normalizer_cardinality_via_fixed_cosets(G, group, H)
    finite_set_size(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>) = finite_set_size(\normalizer::subgroup_normalizer<G, group>(H)) = finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>) * finite_set_size(H)
    group.one $in H
    witness $is_nonempty_set(H) from group.one
    finite_set_size(H) >= 1
    finite_set_size(H) != 0
    finite_set_size(H) * finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) * finite_set_size(H) = finite_set_size(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>) = finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>) * finite_set_size(H) = finite_set_size(H) * finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>)
    release thm prime_arithmetic::integer_left_multiplication_cancellation(finite_set_size(H), finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>), finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>))
    finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>)
thm normalizer_quotient_order_divisible_by_prime:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), p N+, k N:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $prime(p)
        finite_set_size(H) = p^k
        $group::divides(p^(k + 1), finite_set_size(G))
        =>:
            $is_finite_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
            $group::divides(p, finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>))
    release thm normalizer_quotient_cardinality_eq_fixed_cosets(G, group, H)
    release thm sylow_coset_action::finite_group_coset_cardinality_product(G, group, H)
    release thm sylow_coset_action::sylow_fixed_coset_count_divisible(G, group, H, p, k)
    finite_set_size(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) = finite_set_size(\sylow_coset_action::sylow_fixed_cosets<G, group, H>)

thm normalizer_quotient_has_prime_subgroup:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), p N+, k N:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        $is_finite_set(G)
        $is_finite_set(H)
        $prime(p)
        finite_set_size(H) = p^k
        $group::divides(p^(k + 1), finite_set_size(G))
        =>:
            exist K power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>) st {$subgroup::is_subgroup(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, \quotient_groups::quotient_group<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, K), $is_finite_set(K), finite_set_size(K) = p}
    release thm normalizer::subgroup_normalizer_closed(G, group, H)
    release thm normalizer::subgroup_normal_in_normalizer(G, group, H)
    release thm normalizer_quotient_cardinality_eq_fixed_cosets(G, group, H)
    release thm normalizer_quotient_order_divisible_by_prime(G, group, H, p, k)
    release thm cauchy_theorem::cauchy_prime_subgroup_exists_auto(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, \quotient_groups::quotient_group<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, p)
