# Cyclic rotation of product-one tuples for Cauchy's theorem.

template<p N+, G set>:
    have fn cauchy_raw_rotate(shift \cyclic_group::cyclic_indices<p>, candidate fn(index \cyclic_group::cyclic_indices<p>) G) fn(output_index \cyclic_group::cyclic_indices<p>) G = fn(index \cyclic_group::cyclic_indices<p>) G {candidate(\cyclic_group::cyclic_add<p>(index, shift))}

thm cauchy_raw_rotate_apply:
    ? forall p N+, G set, shift \cyclic_group::cyclic_indices<p>, candidate fn(index \cyclic_group::cyclic_indices<p>) G, index \cyclic_group::cyclic_indices<p>:
        \cauchy_raw_rotate<p, G>(shift, candidate)(index) = candidate(\cyclic_group::cyclic_add<p>(index, shift))
    \cauchy_raw_rotate<p, G>(shift, candidate) = fn(current_index \cyclic_group::cyclic_indices<p>) G {candidate(\cyclic_group::cyclic_add<p>(current_index, shift))}
    \cauchy_raw_rotate<p, G>(shift, candidate)(index) = candidate(\cyclic_group::cyclic_add<p>(index, shift))

thm cauchy_raw_rotate_identity:
    ? forall p N+, G set, candidate fn(index \cyclic_group::cyclic_indices<p>) G:
        \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate) = candidate
    claim:
        ? forall index \cyclic_group::cyclic_indices<p>:
            \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate)(index) = candidate(index)
        release thm cauchy_raw_rotate_apply(p, G, \cyclic_group::cyclic_zero<p>, candidate, index)
        release thm cyclic_group::cyclic_prime_group_laws(p)
        release thm group::mul_one(\cyclic_group::cyclic_indices<p>, \cyclic_group::cyclic_add<p>, \cyclic_group::cyclic_zero<p>, \cyclic_group::cyclic_neg<p>, index)
        \cyclic_group::cyclic_add<p>(index, \cyclic_group::cyclic_zero<p>) = index
        \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate)(index) = candidate(\cyclic_group::cyclic_add<p>(index, \cyclic_group::cyclic_zero<p>)) = candidate(index)
    by def:
        ? $fn_eq(\cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate), candidate)

thm cauchy_raw_rotate_compose:
    ? forall p N+, G set, left, right \cyclic_group::cyclic_indices<p>, candidate fn(index \cyclic_group::cyclic_indices<p>) G:
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate)
    claim:
        ? forall index \cyclic_group::cyclic_indices<p>:
            \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate))(index) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate)(index)
        release thm cauchy_raw_rotate_apply(p, G, left, \cauchy_raw_rotate<p, G>(right, candidate), index)
        release thm cauchy_raw_rotate_apply(p, G, right, candidate, \cyclic_group::cyclic_add<p>(index, left))
        release thm cauchy_raw_rotate_apply(p, G, \cyclic_group::cyclic_add<p>(left, right), candidate, index)
        release thm cyclic_group::cyclic_prime_group_laws(p)
        by def:
            ? $group::group_laws(\cyclic_group::cyclic_indices<p>, \cyclic_group::cyclic_add<p>, \cyclic_group::cyclic_zero<p>, \cyclic_group::cyclic_neg<p>)
        \cyclic_group::cyclic_add<p>(\cyclic_group::cyclic_add<p>(index, left), right) = \cyclic_group::cyclic_add<p>(index, \cyclic_group::cyclic_add<p>(left, right))
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate))(index) = \cauchy_raw_rotate<p, G>(right, candidate)(\cyclic_group::cyclic_add<p>(index, left)) = candidate(\cyclic_group::cyclic_add<p>(\cyclic_group::cyclic_add<p>(index, left), right)) = candidate(\cyclic_group::cyclic_add<p>(index, \cyclic_group::cyclic_add<p>(left, right))) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate)(index)
    by def:
        ? $fn_eq(\cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)), \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate))

thm cauchy_raw_rotation_is_group_action:
    ? forall p N+, G set:
        $group_actions::is_group_action(\cyclic_group::cyclic_indices<p>, fn(index \cyclic_group::cyclic_indices<p>) G, \cyclic_group::cyclic_prime_group<p>, \cauchy_raw_rotate<p, G>)
    claim:
        ? forall candidate fn(index \cyclic_group::cyclic_indices<p>) G:
            \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_prime_group<p>.one, candidate) = candidate
        \cyclic_group::cyclic_prime_group<p>.one = \cyclic_group::cyclic_zero<p>
        release thm cauchy_raw_rotate_identity(p, G, candidate)
        \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_prime_group<p>.one, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate) = candidate
    claim:
        ? forall left, right \cyclic_group::cyclic_indices<p>, candidate fn(index \cyclic_group::cyclic_indices<p>) G:
            \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate)
        \cyclic_group::cyclic_prime_group<p>.mul = \cyclic_group::cyclic_add<p>
        \cyclic_group::cyclic_prime_group<p>.mul(left, right) = \cyclic_group::cyclic_add<p>(left, right)
        release thm cauchy_raw_rotate_compose(p, G, left, right, candidate)
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate)
    by def:
        ? $group_actions::is_group_action(\cyclic_group::cyclic_indices<p>, fn(index \cyclic_group::cyclic_indices<p>) G, \cyclic_group::cyclic_prime_group<p>, \cauchy_raw_rotate<p, G>)

template<G nonempty_set, group &group::Group<G>, p N+>:
    have fn cauchy_tuple_tail_product(candidate fn(index \cyclic_group::cyclic_indices<p>) G, n N: n < p) G by induc n from 0:
        case n = 0: group.one
        case n > 0: group.mul(cauchy_tuple_tail_product(candidate, n - 1), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n))

thm cauchy_tuple_tail_product_zero:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G:
        \cauchy_tuple_tail_product<G, group, p>(candidate, 0) = group.one
    \cauchy_tuple_tail_product<G, group, p>(candidate, 0) = group.one

thm cauchy_tuple_tail_product_succ:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G, n N:
        n < p
        n + 1 < p
        =>:
            \cauchy_tuple_tail_product<G, group, p>(candidate, n + 1) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, n), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n + 1))
    n + 1 > 0
    (n + 1) - 1 = n
    \cauchy_tuple_tail_product<G, group, p>(candidate, n + 1) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, (n + 1) - 1), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n + 1)) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, n), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n + 1))

thm cauchy_prefix_splits_first_and_tail:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G, n N:
        n < p
        =>:
            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, n + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, n))
    prop split_at(k N):
        forall:
            k < p
            =>:
                \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k))
    claim:
        ? forall k N:
            $split_at(k)
        by induc k from 0:
            ? $split_at(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 < p
                        =>:
                            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, 0 + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, 0))
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_zero(G, group, p, candidate)
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_succ(G, group, p, candidate, 0)
                    release thm cauchy_tuple_tail_product_zero(G, group, p, candidate)
                    release thm group::group_mul_one(G, group, \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0))
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, 0 + 1) = group.mul(\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, 0), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)) = group.mul(group.one, \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)
                    group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, 0)) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), group.one) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)
                by def:
                    ? $split_at(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 < p
                        =>:
                            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, (k + 1) + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1))
                    k < k + 1 < p
                    by def:
                        ? $split_at(k)
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k))
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_succ(G, group, p, candidate, k + 1)
                    release thm cauchy_tuple_tail_product_succ(G, group, p, candidate, k)
                    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, k + 1))}, \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1), group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k)))
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, (k + 1) + 1) = group.mul(\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, k + 1), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, k + 1)) = group.mul(group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k)), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, k + 1)) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, k), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, k + 1))) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1))
                by def:
                    ? $split_at(k + 1)
    $split_at(n)
    n < p
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, n + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, n))

prop is_cyclic_one_value(value Z):
    value = 1

thm cyclic_one_value_exists_unique:
    ? forall p N+:
        $prime(p)
        =>:
            exist! value \cyclic_group::cyclic_indices<p> st {$is_cyclic_one_value(value)}
    p > 1
    0 <= 1 <= p - 1
    1 $in closed_range(0, p - 1) = \cyclic_group::cyclic_indices<p>
    have one_value \cyclic_group::cyclic_indices<p> = 1
    witness exist! value \cyclic_group::cyclic_indices<p> st {$is_cyclic_one_value(value)} from one_value:
        by def:
            ? $is_cyclic_one_value(one_value)
        claim:
            ? forall left, right \cyclic_group::cyclic_indices<p>:
                $is_cyclic_one_value(left)
                $is_cyclic_one_value(right)
                =>:
                    left = right
            by def $is_cyclic_one_value(left)
            by def $is_cyclic_one_value(right)
            left = 1 = right

template<p N+: $prime(p)>:
    have fn cyclic_one_selector by exist!:
        ? forall dummy {0}:
            exist! value \cyclic_group::cyclic_indices<p> st {$is_cyclic_one_value(value)}
        release thm cyclic_one_value_exists_unique(p)

template<p N+: $prime(p)>:
    have cyclic_one \cyclic_group::cyclic_indices<p> = \cyclic_one_selector<p>(0)

thm cyclic_one_apply:
    ? forall p N+:
        $prime(p)
        =>:
            \cyclic_one<p> = 1
    \cyclic_one<p> = \cyclic_one_selector<p>(0)
    $is_cyclic_one_value(\cyclic_one_selector<p>(0))
    by def:
        ? $is_cyclic_one_value(\cyclic_one_selector<p>(0))

thm cauchy_one_rotate_entry_before_last:
    ? forall p N+, G set, candidate fn(index \cyclic_group::cyclic_indices<p>) G, n N:
        $prime(p)
        n < p
        n + 1 < p
        =>:
            \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n + 1)
    p > 1
    n + 1 <= p - 1
    n + 1 < p
    n + 1 $in closed_range(0, p - 1) = \cyclic_group::cyclic_indices<p>
    have next_index \cyclic_group::cyclic_indices<p> = n + 1
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n)
    obtain rotated_index from exist rotated_index \cyclic_group::cyclic_indices<p> st {rotated_index = n, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_index)}
    release thm cauchy_raw_rotate_apply(p, G, \cyclic_one<p>, candidate, rotated_index)
    release thm cyclic_one_apply(p)
    release thm cyclic_group::cyclic_add_apply(p, rotated_index, \cyclic_one<p>)
    rotated_index = n
    \cyclic_one<p> = 1
    \cyclic_group::cyclic_add<p>(rotated_index, \cyclic_one<p>) = (rotated_index + \cyclic_one<p>) % p = (n + 1) % p
    release thm cyclic_group::cyclic_index_mod_self(p, next_index)
    next_index = n + 1
    next_index % p = next_index
    (n + 1) % p = next_index % p = next_index
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, candidate, n + 1)
    obtain source_index from exist source_index \cyclic_group::cyclic_indices<p> st {source_index = n + 1, \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n + 1) = candidate(source_index)}
    source_index = n + 1 = next_index = \cyclic_group::cyclic_add<p>(rotated_index, \cyclic_one<p>)
    candidate(\cyclic_group::cyclic_add<p>(rotated_index, \cyclic_one<p>)) = candidate(source_index)
    \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_index) = candidate(\cyclic_group::cyclic_add<p>(rotated_index, \cyclic_one<p>)) = candidate(source_index) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, n + 1)

thm cauchy_one_rotate_entry_last:
    ? forall p N+, G set, candidate fn(index \cyclic_group::cyclic_indices<p>) G:
        $prime(p)
        =>:
            \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), p - 1) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)
    p > 1
    p - 1 >= 0
    have last_natural N = p - 1
    last_natural = p - 1
    p - 1 < p
    last_natural = p - 1 < p
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)
    obtain rotated_last from exist rotated_last \cyclic_group::cyclic_indices<p> st {rotated_last = last_natural, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last)}
    release thm cauchy_raw_rotate_apply(p, G, \cyclic_one<p>, candidate, rotated_last)
    release thm cyclic_one_apply(p)
    release thm cyclic_group::cyclic_add_apply(p, rotated_last, \cyclic_one<p>)
    rotated_last = last_natural = p - 1
    \cyclic_one<p> = 1
    p % p = (p * 1) % p = 0
    \cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>) = (rotated_last + \cyclic_one<p>) % p = ((p - 1) + 1) % p = p % p = 0
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, candidate, 0)
    obtain zero_index from exist zero_index \cyclic_group::cyclic_indices<p> st {zero_index = 0, \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0) = candidate(zero_index)}
    zero_index = 0 = \cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>)
    candidate(\cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index)
    \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), p - 1) = \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last) = candidate(\cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)

thm cauchy_one_rotate_prefix_is_tail:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G, n N:
        $prime(p)
        n < p
        =>:
            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_tuple_tail_product<G, group, p>(candidate, n)
    prop rotated_prefix_is_tail(k N):
        forall:
            k < p
            =>:
                \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k) = \cauchy_tuple_tail_product<G, group, p>(candidate, k)
    claim:
        ? forall k N:
            $rotated_prefix_is_tail(k)
        by induc k from 0:
            ? $rotated_prefix_is_tail(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 < p
                        =>:
                            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), 0) = \cauchy_tuple_tail_product<G, group, p>(candidate, 0)
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_zero(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate))
                    release thm cauchy_tuple_tail_product_zero(G, group, p, candidate)
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), 0) = group.one = \cauchy_tuple_tail_product<G, group, p>(candidate, 0)
                by def:
                    ? $rotated_prefix_is_tail(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 < p
                        =>:
                            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k + 1) = \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1)
                    k < k + 1 < p
                    by def:
                        ? $rotated_prefix_is_tail(k)
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k) = \cauchy_tuple_tail_product<G, group, p>(candidate, k)
                    release thm cauchy_one_rotate_entry_before_last(p, G, candidate, k)
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k)
                    release thm cauchy_tuple_tail_product_succ(G, group, p, candidate, k)
                    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k))}, \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k), \cauchy_tuple_tail_product<G, group, p>(candidate, k))
                    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, k), t)}, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, k + 1))
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k + 1) = group.mul(\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k), \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), k)) = group.mul(\cauchy_tuple_tail_product<G, group, p>(candidate, k), \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, k + 1)) = \cauchy_tuple_tail_product<G, group, p>(candidate, k + 1)
                by def:
                    ? $rotated_prefix_is_tail(k + 1)
    $rotated_prefix_is_tail(n)
    n < p
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_tuple_tail_product<G, group, p>(candidate, n)

thm cauchy_one_rotate_entry_at_last_natural:
    ? forall p N+, G set, candidate fn(index \cyclic_group::cyclic_indices<p>) G, n N:
        $prime(p)
        n = p - 1
        n < p
        =>:
            \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n)
    obtain rotated_last from exist rotated_last \cyclic_group::cyclic_indices<p> st {rotated_last = n, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last)}
    release thm cauchy_raw_rotate_apply(p, G, \cyclic_one<p>, candidate, rotated_last)
    release thm cyclic_one_apply(p)
    release thm cyclic_group::cyclic_add_apply(p, rotated_last, \cyclic_one<p>)
    rotated_last = n = p - 1
    \cyclic_one<p> = 1
    p % p = (p * 1) % p = 0
    \cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>) = (rotated_last + \cyclic_one<p>) % p = ((p - 1) + 1) % p = p % p = 0
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, candidate, 0)
    obtain zero_index from exist zero_index \cyclic_group::cyclic_indices<p> st {zero_index = 0, \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0) = candidate(zero_index)}
    zero_index = 0 = \cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>)
    candidate(\cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index)
    \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), n) = \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate)(rotated_last) = candidate(\cyclic_group::cyclic_add<p>(rotated_last, \cyclic_one<p>)) = candidate(zero_index) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)

thm cauchy_one_rotate_preserves_product_one:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G:
        $prime(p)
        $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
        =>:
            $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate))
    p > 1
    by def:
        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
    p - 1 >= 0
    have last_natural N = p - 1
    last_natural = p - 1
    p - 1 < p
    last_natural = p - 1 < p
    have first G = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)
    have tail G = \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural)
    first = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0)
    tail = \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural)
    release thm cauchy_prefix_splits_first_and_tail(G, group, p, candidate, last_natural)
    last_natural + 1 = (p - 1) + 1 = p
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, p) = \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, last_natural + 1) = group.mul(\cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0), \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural)) = group.mul(first, tail)
    group.mul(first, tail) = group.one
    release thm group::mul_inv_cancel(G, group.mul, group.one, group.inv, first)
    group.mul(first, group.inv(first)) = group.one
    group.mul(first, tail) = group.mul(first, group.inv(first))
    release thm group::_group_left_cancel(G, group.mul, group.one, group.inv, first, tail, group.inv(first))
    tail = group.inv(first)
    release thm cauchy_one_rotate_prefix_is_tail(G, group, p, candidate, last_natural)
    release thm cauchy_one_rotate_entry_at_last_natural(p, G, candidate, last_natural)
    release thm cauchy_tuples::cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_tuple_tail_product<G, group, p>(candidate, last_natural) = tail
    \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural) = \cauchy_tuples::cyclic_tuple_entry<p, G>(candidate, 0) = first
    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural))}, \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural), tail)
    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(tail, t)}, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural), first)
    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, first)}, tail, group.inv(first))
    group.mul(group.inv(first), first) = group.one
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), p) = \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural + 1) = group.mul(\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural), \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)) = group.mul(tail, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate), last_natural)) = group.mul(tail, first) = group.mul(group.inv(first), first) = group.one
    by def:
        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, candidate))

thm cauchy_natural_rotate_preserves_product_one:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G, shift \cyclic_group::cyclic_indices<p>, n N:
        $prime(p)
        $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
        shift = n
        n < p
        =>:
            $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))
    prop rotation_preserved_at(k N):
        forall current \cyclic_group::cyclic_indices<p>:
            current = k
            k < p
            =>:
                $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
    claim:
        ? forall k N:
            $rotation_preserved_at(k)
        by induc k from 0:
            ? $rotation_preserved_at(k)
            ? from k = 0:
                claim:
                    ? forall current \cyclic_group::cyclic_indices<p>:
                        current = 0
                        0 < p
                        =>:
                            $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                    release thm cyclic_group::cyclic_zero_apply(p)
                    current = 0 = \cyclic_group::cyclic_zero<p>
                    release thm cauchy_raw_rotate_identity(p, G, candidate)
                    \cauchy_raw_rotate<p, G>(current, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate) = candidate
                    by def:
                        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
                    release thm cosets::object_substitution(fn(index \cyclic_group::cyclic_indices<p>) G, G, fn(rotated_candidate fn(index \cyclic_group::cyclic_indices<p>) G) G {\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(rotated_candidate, p)}, candidate, \cauchy_raw_rotate<p, G>(current, candidate))
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(current, candidate), p) = \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(candidate, p) = group.one
                    by def:
                        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                by def:
                    ? $rotation_preserved_at(0)
            ? induc:
                claim:
                    ? forall current \cyclic_group::cyclic_indices<p>:
                        current = k + 1
                        k + 1 < p
                        =>:
                            $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                    k < k + 1 < p
                    k <= p - 1
                    k $in closed_range(0, p - 1) = \cyclic_group::cyclic_indices<p>
                    have previous \cyclic_group::cyclic_indices<p> = k
                    by def:
                        ? $rotation_preserved_at(k)
                    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(previous, candidate))
                    release thm cauchy_one_rotate_preserves_product_one(G, group, p, \cauchy_raw_rotate<p, G>(previous, candidate))
                    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)))
                    release thm cyclic_one_apply(p)
                    release thm cyclic_group::cyclic_add_apply(p, \cyclic_one<p>, previous)
                    release thm cyclic_group::cyclic_index_mod_self(p, current)
                    previous = k
                    current = k + 1
                    \cyclic_one<p> = 1
                    \cyclic_group::cyclic_add<p>(\cyclic_one<p>, previous) = (\cyclic_one<p> + previous) % p = (1 + k) % p = (k + 1) % p = current % p = current
                    release thm cauchy_raw_rotate_compose(p, G, \cyclic_one<p>, previous, candidate)
                    \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(\cyclic_one<p>, previous), candidate)
                    \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(\cyclic_one<p>, previous), candidate) = \cauchy_raw_rotate<p, G>(current, candidate)
                    \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)) = \cauchy_raw_rotate<p, G>(current, candidate)
                    by def:
                        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)))
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)), p) = group.one
                    release thm cosets::object_substitution(fn(index \cyclic_group::cyclic_indices<p>) G, G, fn(rotated_candidate fn(index \cyclic_group::cyclic_indices<p>) G) G {\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(rotated_candidate, p)}, \cauchy_raw_rotate<p, G>(\cyclic_one<p>, \cauchy_raw_rotate<p, G>(previous, candidate)), \cauchy_raw_rotate<p, G>(current, candidate))
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_raw_rotate<p, G>(current, candidate), p) = group.one
                    by def:
                        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(current, candidate))
                by def:
                    ? $rotation_preserved_at(k + 1)
    $rotation_preserved_at(n)
    by def $rotation_preserved_at(n)
    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))

thm cauchy_raw_rotate_preserves_product_one:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate fn(index \cyclic_group::cyclic_indices<p>) G, shift \cyclic_group::cyclic_indices<p>:
        $prime(p)
        $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
        =>:
            $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))
    \cyclic_group::cyclic_indices<p> = closed_range(0, p - 1)
    0 <= shift <= p - 1
    abs(shift) = shift
    have natural_shift N = abs(shift)
    natural_shift = shift
    p - 1 < p
    natural_shift = shift <= p - 1 < p
    release thm cauchy_natural_rotate_preserves_product_one(G, group, p, candidate, shift, natural_shift)

prop is_cauchy_rotation_value(G nonempty_set, group &group::Group<G>, p N+, shift \cyclic_group::cyclic_indices<p>, candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, result \cauchy_tuples::cauchy_product_one_tuples<G, group, p>):
    result = \cauchy_raw_rotate<p, G>(shift, candidate)

thm cauchy_rotation_value_exists_unique:
    ? forall G nonempty_set, group &group::Group<G>, p N+, shift \cyclic_group::cyclic_indices<p>, candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
        $prime(p)
        =>:
            exist! result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> st {$is_cauchy_rotation_value(G, group, p, shift, candidate, result)}
    \cauchy_tuples::cauchy_product_one_tuples<G, group, p> = {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)}
    candidate $in \cauchy_tuples::cauchy_product_one_tuples<G, group, p>
    release thm set_builder_member(candidate, {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
    release thm cauchy_raw_rotate_preserves_product_one(G, group, p, candidate, shift)
    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_raw_rotate<p, G>(shift, candidate))
    release thm set_builder_member(\cauchy_raw_rotate<p, G>(shift, candidate), {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    \cauchy_raw_rotate<p, G>(shift, candidate) $in \cauchy_tuples::cauchy_product_one_tuples<G, group, p>
    have rotated \cauchy_tuples::cauchy_product_one_tuples<G, group, p> = \cauchy_raw_rotate<p, G>(shift, candidate)
    witness exist! result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> st {$is_cauchy_rotation_value(G, group, p, shift, candidate, result)} from rotated:
        by def:
            ? $is_cauchy_rotation_value(G, group, p, shift, candidate, rotated)
        claim:
            ? forall left, right \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
                $is_cauchy_rotation_value(G, group, p, shift, candidate, left)
                $is_cauchy_rotation_value(G, group, p, shift, candidate, right)
                =>:
                    left = right
            by def $is_cauchy_rotation_value(G, group, p, shift, candidate, left)
            by def $is_cauchy_rotation_value(G, group, p, shift, candidate, right)
            left = \cauchy_raw_rotate<p, G>(shift, candidate) = right

template<G nonempty_set, group &group::Group<G>, p N+: $prime(p)>:
    have fn cauchy_rotate by exist!:
        ? forall shift \cyclic_group::cyclic_indices<p>, candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
            exist! result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> st {$is_cauchy_rotation_value(G, group, p, shift, candidate, result)}
        release thm cauchy_rotation_value_exists_unique(G, group, p, shift, candidate)

thm cauchy_rotate_relation:
    ? forall G nonempty_set, group &group::Group<G>, p N+, shift \cyclic_group::cyclic_indices<p>, candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
        $prime(p)
        =>:
            \cauchy_rotate<G, group, p>(shift, candidate) = \cauchy_raw_rotate<p, G>(shift, candidate)
    $is_cauchy_rotation_value(G, group, p, shift, candidate, \cauchy_rotate<G, group, p>(shift, candidate))
    by def $is_cauchy_rotation_value(G, group, p, shift, candidate, \cauchy_rotate<G, group, p>(shift, candidate))

thm cauchy_rotation_is_group_action:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $prime(p)
        =>:
            $group_actions::is_group_action(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cyclic_group::cyclic_prime_group<p>, \cauchy_rotate<G, group, p>)
    claim:
        ? forall candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
            \cauchy_rotate<G, group, p>(\cyclic_group::cyclic_prime_group<p>.one, candidate) = candidate
        \cyclic_group::cyclic_prime_group<p>.one = \cyclic_group::cyclic_zero<p>
        release thm cauchy_rotate_relation(G, group, p, \cyclic_group::cyclic_prime_group<p>.one, candidate)
        release thm cauchy_raw_rotate_identity(p, G, candidate)
        \cauchy_rotate<G, group, p>(\cyclic_group::cyclic_prime_group<p>.one, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_prime_group<p>.one, candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_zero<p>, candidate) = candidate
    claim:
        ? forall left, right \cyclic_group::cyclic_indices<p>, candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
            \cauchy_rotate<G, group, p>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_rotate<G, group, p>(\cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate)
        release thm cauchy_rotate_relation(G, group, p, right, candidate)
        \cauchy_rotate<G, group, p>(right, candidate) = \cauchy_raw_rotate<p, G>(right, candidate)
        release thm cauchy_rotate_relation(G, group, p, left, \cauchy_rotate<G, group, p>(right, candidate))
        \cauchy_rotate<G, group, p>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_rotate<G, group, p>(right, candidate))
        \cauchy_raw_rotate<p, G>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate))
        release thm cauchy_raw_rotate_compose(p, G, left, right, candidate)
        \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate)
        \cyclic_group::cyclic_prime_group<p>.mul = \cyclic_group::cyclic_add<p>
        \cyclic_group::cyclic_prime_group<p>.mul(left, right) = \cyclic_group::cyclic_add<p>(left, right)
        release thm cauchy_rotate_relation(G, group, p, \cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate)
        \cauchy_rotate<G, group, p>(\cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate)
        \cauchy_rotate<G, group, p>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_rotate<G, group, p>(right, candidate)) = \cauchy_raw_rotate<p, G>(left, \cauchy_raw_rotate<p, G>(right, candidate)) = \cauchy_raw_rotate<p, G>(\cyclic_group::cyclic_add<p>(left, right), candidate) = \cauchy_rotate<G, group, p>(\cyclic_group::cyclic_prime_group<p>.mul(left, right), candidate)
    by def:
        ? $group_actions::is_group_action(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cyclic_group::cyclic_prime_group<p>, \cauchy_rotate<G, group, p>)
