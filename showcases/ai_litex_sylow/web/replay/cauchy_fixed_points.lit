# Constant tuples and fixed points in the cyclic action for Cauchy's theorem.

template<G nonempty_set, group &group::Group<G>>:
    have fn cauchy_group_power(x G, n N) G by induc n from 0:
        case n = 0: group.one
        case n > 0: group.mul(cauchy_group_power(x, n - 1), x)

thm cauchy_group_power_zero:
    ? forall G nonempty_set, group &group::Group<G>, x G:
        \cauchy_group_power<G, group>(x, 0) = group.one
    \cauchy_group_power<G, group>(x, 0) = group.one

thm cauchy_group_power_succ:
    ? forall G nonempty_set, group &group::Group<G>, x G, n N:
        \cauchy_group_power<G, group>(x, n + 1) = group.mul(\cauchy_group_power<G, group>(x, n), x)
    n + 1 > 0
    (n + 1) - 1 = n
    \cauchy_group_power<G, group>(x, n + 1) = group.mul(\cauchy_group_power<G, group>(x, (n + 1) - 1), x) = group.mul(\cauchy_group_power<G, group>(x, n), x)

template<p N+, G set>:
    have fn cauchy_constant_tuple(x G) fn(output_index \cyclic_group::cyclic_indices<p>) G = fn(current_index \cyclic_group::cyclic_indices<p>) G {x}

thm cauchy_constant_tuple_apply:
    ? forall p N+, G set, x G, index \cyclic_group::cyclic_indices<p>:
        \cauchy_constant_tuple<p, G>(x)(index) = x
    \cauchy_constant_tuple<p, G>(x) = fn(current \cyclic_group::cyclic_indices<p>) G {x}
    \cauchy_constant_tuple<p, G>(x)(index) = x

thm cauchy_constant_tuple_entry:
    ? forall p N+, G set, x G, n N:
        n < p
        =>:
            \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), n) = x
    release thm cauchy_tuples::cyclic_tuple_entry_apply(p, G, \cauchy_constant_tuple<p, G>(x), n)
    obtain selected_index from exist selected_index \cyclic_group::cyclic_indices<p> st {selected_index = n, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_constant_tuple<p, G>(x)(selected_index)}
    release thm cauchy_constant_tuple_apply(p, G, x, selected_index)
    \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_constant_tuple<p, G>(x)(selected_index) = x

thm cauchy_constant_prefix_is_power:
    ? forall G nonempty_set, group &group::Group<G>, p N+, x G, n N:
        n <= p
        =>:
            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_group_power<G, group>(x, n)
    prop constant_prefix_matches(k N):
        forall:
            k <= p
            =>:
                \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k) = \cauchy_group_power<G, group>(x, k)
    claim:
        ? forall k N:
            $constant_prefix_matches(k)
        by induc k from 0:
            ? $constant_prefix_matches(k)
            ? from k = 0:
                claim:
                    ? forall:
                        0 <= p
                        =>:
                            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), 0) = \cauchy_group_power<G, group>(x, 0)
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_zero(G, group, p, \cauchy_constant_tuple<p, G>(x))
                    release thm cauchy_group_power_zero(G, group, x)
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), 0) = group.one = \cauchy_group_power<G, group>(x, 0)
                by def:
                    ? $constant_prefix_matches(0)
            ? induc:
                claim:
                    ? forall:
                        k + 1 <= p
                        =>:
                            \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k + 1) = \cauchy_group_power<G, group>(x, k + 1)
                    k < k + 1 <= p
                    k <= p
                    by def:
                        ? $constant_prefix_matches(k)
                    release thm cauchy_tuples::cyclic_tuple_prefix_product_succ(G, group, p, \cauchy_constant_tuple<p, G>(x), k)
                    release thm cauchy_constant_tuple_entry(p, G, x, k)
                    release thm cauchy_group_power_succ(G, group, x, k)
                    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k))}, \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k), \cauchy_group_power<G, group>(x, k))
                    release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(\cauchy_group_power<G, group>(x, k), t)}, \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k), x)
                    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k + 1) = group.mul(\cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), k), \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k)) = group.mul(\cauchy_group_power<G, group>(x, k), \cauchy_tuples::cyclic_tuple_entry<p, G>(\cauchy_constant_tuple<p, G>(x), k)) = group.mul(\cauchy_group_power<G, group>(x, k), x) = \cauchy_group_power<G, group>(x, k + 1)
                by def:
                    ? $constant_prefix_matches(k + 1)
    $constant_prefix_matches(n)
    n <= p
    \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), n) = \cauchy_group_power<G, group>(x, n)

thm cauchy_constant_tuple_product_one_from_power:
    ? forall G nonempty_set, group &group::Group<G>, p N+, x G:
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
    release thm cauchy_constant_prefix_is_power(G, group, p, x, p)
    by def:
        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))

thm cauchy_constant_tuple_power_from_product_one:
    ? forall G nonempty_set, group &group::Group<G>, p N+, x G:
        $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
        =>:
            \cauchy_group_power<G, group>(x, p) = group.one
    by def:
        ? $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
    release thm cauchy_constant_prefix_is_power(G, group, p, x, p)
    \cauchy_group_power<G, group>(x, p) = \cauchy_tuples::cyclic_tuple_prefix_product<G, group, p>(\cauchy_constant_tuple<p, G>(x), p) = group.one

thm cauchy_fixed_tuple_is_constant:
    ? forall G nonempty_set, group &group::Group<G>, p N+, candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, index \cyclic_group::cyclic_indices<p>:
        $prime(p)
        $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, candidate)
        =>:
            candidate(index) = candidate(\cyclic_group::cyclic_zero<p>)
    by def:
        ? $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, candidate)
    \cauchy_rotation::cauchy_rotate<G, group, p>(index, candidate) = candidate
    release thm cauchy_rotation::cauchy_rotate_relation(G, group, p, index, candidate)
    \cauchy_rotation::cauchy_raw_rotate<p, G>(index, candidate) = \cauchy_rotation::cauchy_rotate<G, group, p>(index, candidate) = candidate
    release thm finite_function_spaces::equal_functions_equal_at(\cyclic_group::cyclic_indices<p>, G, \cauchy_rotation::cauchy_raw_rotate<p, G>(index, candidate), candidate, \cyclic_group::cyclic_zero<p>)
    release thm cauchy_rotation::cauchy_raw_rotate_apply(p, G, index, candidate, \cyclic_group::cyclic_zero<p>)
    release thm cyclic_group::cyclic_prime_group_laws(p)
    by def:
        ? $group::group_laws(\cyclic_group::cyclic_indices<p>, \cyclic_group::cyclic_add<p>, \cyclic_group::cyclic_zero<p>, \cyclic_group::cyclic_neg<p>)
    \cyclic_group::cyclic_add<p>(\cyclic_group::cyclic_zero<p>, index) = index
    \cauchy_rotation::cauchy_raw_rotate<p, G>(index, candidate)(\cyclic_group::cyclic_zero<p>) = candidate(\cyclic_group::cyclic_add<p>(\cyclic_group::cyclic_zero<p>, index)) = candidate(index)
    \cauchy_rotation::cauchy_raw_rotate<p, G>(index, candidate)(\cyclic_group::cyclic_zero<p>) = candidate(\cyclic_group::cyclic_zero<p>)
    candidate(index) = \cauchy_rotation::cauchy_raw_rotate<p, G>(index, candidate)(\cyclic_group::cyclic_zero<p>) = candidate(\cyclic_group::cyclic_zero<p>)

thm cauchy_group_power_one:
    ? forall G nonempty_set, group &group::Group<G>, n N:
        \cauchy_group_power<G, group>(group.one, n) = group.one
    by induc n from 0:
        ? \cauchy_group_power<G, group>(group.one, n) = group.one
        ? from n = 0:
            release thm cauchy_group_power_zero(G, group, group.one)
        ? induc:
            release thm cauchy_group_power_succ(G, group, group.one, n)
            \cauchy_group_power<G, group>(group.one, n + 1) = group.mul(\cauchy_group_power<G, group>(group.one, n), group.one) = group.mul(group.one, group.one) = group.one

prop is_cauchy_constant_product_value(G nonempty_set, group &group::Group<G>, p N+, x G, result \cauchy_tuples::cauchy_product_one_tuples<G, group, p>):
    result = \cauchy_constant_tuple<p, G>(x)

thm cauchy_constant_product_value_exists_unique:
    ? forall G nonempty_set, group &group::Group<G>, p N+, x G:
        $prime(p)
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            exist! result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> st {$is_cauchy_constant_product_value(G, group, p, x, result)}
    release thm cauchy_constant_tuple_product_one_from_power(G, group, p, x)
    release thm set_builder_member(\cauchy_constant_tuple<p, G>(x), {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    \cauchy_constant_tuple<p, G>(x) $in \cauchy_tuples::cauchy_product_one_tuples<G, group, p>
    have constant_result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> = \cauchy_constant_tuple<p, G>(x)
    witness exist! result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> st {$is_cauchy_constant_product_value(G, group, p, x, result)} from constant_result:
        by def:
            ? $is_cauchy_constant_product_value(G, group, p, x, constant_result)
        claim:
            ? forall left, right \cauchy_tuples::cauchy_product_one_tuples<G, group, p>:
                $is_cauchy_constant_product_value(G, group, p, x, left)
                $is_cauchy_constant_product_value(G, group, p, x, right)
                =>:
                    left = right
            by def $is_cauchy_constant_product_value(G, group, p, x, left)
            by def $is_cauchy_constant_product_value(G, group, p, x, right)
            left = \cauchy_constant_tuple<p, G>(x) = right

template<G nonempty_set, group &group::Group<G>, p N+, x G: $prime(p), \cauchy_group_power<G, group>(x, p) = group.one>:
    have fn cauchy_constant_product_tuple by exist!:
        ? forall dummy {0}:
            exist! result \cauchy_tuples::cauchy_product_one_tuples<G, group, p> st {$is_cauchy_constant_product_value(G, group, p, x, result)}
        release thm cauchy_constant_product_value_exists_unique(G, group, p, x)

thm cauchy_constant_product_tuple_relation:
    ? forall G nonempty_set, group &group::Group<G>, p N+, x G:
        $prime(p)
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            \cauchy_constant_product_tuple<G, group, p, x>(0) = \cauchy_constant_tuple<p, G>(x)
    $is_cauchy_constant_product_value(G, group, p, x, \cauchy_constant_product_tuple<G, group, p, x>(0))
    by def $is_cauchy_constant_product_value(G, group, p, x, \cauchy_constant_product_tuple<G, group, p, x>(0))

thm cauchy_raw_rotate_constant:
    ? forall p N+, G set, x G, shift \cyclic_group::cyclic_indices<p>:
        \cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x)) = \cauchy_constant_tuple<p, G>(x)
    claim:
        ? forall index \cyclic_group::cyclic_indices<p>:
            \cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x))(index) = \cauchy_constant_tuple<p, G>(x)(index)
        release thm cauchy_rotation::cauchy_raw_rotate_apply(p, G, shift, \cauchy_constant_tuple<p, G>(x), index)
        release thm cauchy_constant_tuple_apply(p, G, x, \cyclic_group::cyclic_add<p>(index, shift))
        release thm cauchy_constant_tuple_apply(p, G, x, index)
        \cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x))(index) = \cauchy_constant_tuple<p, G>(x)(\cyclic_group::cyclic_add<p>(index, shift)) = x = \cauchy_constant_tuple<p, G>(x)(index)
    by def:
        ? $fn_eq(\cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x)), \cauchy_constant_tuple<p, G>(x))

thm cauchy_constant_product_tuple_is_fixed:
    ? forall G nonempty_set, group &group::Group<G>, p N+, x G:
        $prime(p)
        \cauchy_group_power<G, group>(x, p) = group.one
        =>:
            $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, \cauchy_constant_product_tuple<G, group, p, x>(0))
    claim:
        ? forall shift \cyclic_group::cyclic_indices<p>:
            \cauchy_rotation::cauchy_rotate<G, group, p>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_constant_product_tuple<G, group, p, x>(0)
        release thm cauchy_constant_product_tuple_relation(G, group, p, x)
        release thm cauchy_rotation::cauchy_rotate_relation(G, group, p, shift, \cauchy_constant_product_tuple<G, group, p, x>(0))
        \cauchy_rotation::cauchy_rotate<G, group, p>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x))
        release thm cauchy_raw_rotate_constant(p, G, x, shift)
        \cauchy_rotation::cauchy_raw_rotate<p, G>(shift, \cauchy_constant_tuple<p, G>(x)) = \cauchy_constant_tuple<p, G>(x) = \cauchy_constant_product_tuple<G, group, p, x>(0)
        \cauchy_rotation::cauchy_rotate<G, group, p>(shift, \cauchy_constant_product_tuple<G, group, p, x>(0)) = \cauchy_constant_product_tuple<G, group, p, x>(0)
    by def:
        ? $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, \cauchy_constant_product_tuple<G, group, p, x>(0))

thm divisor_divides_positive_power:
    ? forall divisor N+, base N, exponent N+:
        $group::divides(divisor, base)
        =>:
            $group::divides(divisor, base^exponent)
    obtain quotient from $group::divides(divisor, base)
    exponent >= 1
    exponent - 1 >= 0
    have previous_exponent N = exponent - 1
    previous_exponent = exponent - 1
    previous_exponent + 1 = (exponent - 1) + 1 = exponent
    base^exponent = base^(previous_exponent + 1) = base^previous_exponent * base = base^previous_exponent * (divisor * quotient) = divisor * (base^previous_exponent * quotient)
    witness $group::divides(divisor, base^exponent) from base^previous_exponent * quotient

thm cauchy_product_one_tuple_count_divisible:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
        =>:
            $group::divides(p, finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>))
    p > 1
    p - 1 >= 1
    have positive_exponent N+ = p - 1
    release thm divisor_divides_positive_power(p, finite_set_size(G), positive_exponent)
    release thm cauchy_restriction::cauchy_product_one_tuple_count(G, group, p)
    finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) = finite_set_size(G)^(p - 1) = finite_set_size(G)^positive_exponent
    $group::divides(p, finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>))

thm cauchy_fixed_point_count_divisible:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
        =>:
            $group::divides(p, finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>))
    release thm cauchy_restriction::cauchy_product_one_tuple_count(G, group, p)
    release thm cauchy_rotation::cauchy_rotation_is_group_action(G, group, p)
    release thm cyclic_group::cyclic_indices_are_finite(p)
    release thm cyclic_group::cyclic_indices_have_prime_size(p)
    finite_set_size(\cyclic_group::cyclic_indices<p>) = p = p^1
    release thm p_group_actions::action_fixed_points_are_finite(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>)
    $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
    release thm p_group_actions::finite_p_group_fixed_point_congruence(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cyclic_group::cyclic_prime_group<p>, \cauchy_rotation::cauchy_rotate<G, group, p>, p, 1)
    $group::divides(p, finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) - finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>))
    release thm cauchy_product_one_tuple_count_divisible(G, group, p)
    obtain total_quotient from $group::divides(p, finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>))
    obtain defect_quotient from $group::divides(p, finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) - finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>))
    claim:
        ? \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> $subset \cauchy_tuples::cauchy_product_one_tuples<G, group, p>
        claim:
            ? forall fixed_candidate \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>:
                fixed_candidate $in \cauchy_tuples::cauchy_product_one_tuples<G, group, p>
        by def:
            ? \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> $subset \cauchy_tuples::cauchy_product_one_tuples<G, group, p>
    finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) <= finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
    finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) - finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) + finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) = finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
    finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) = p * total_quotient
    finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) - finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) = p * defect_quotient
    finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) = finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) - (finite_set_size(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>) - finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)) = p * total_quotient - p * defect_quotient = p * (total_quotient - defect_quotient)
    witness $group::divides(p, finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)) from total_quotient - defect_quotient


thm cauchy_fixed_point_count_at_least_prime:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
        =>:
            finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) >= p
    release thm cauchy_fixed_point_count_divisible(G, group, p)
    release thm cauchy_group_power_one(G, group, p)
    release thm cauchy_constant_product_tuple_is_fixed(G, group, p, group.one)
    \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> = {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)}
    release thm set_builder_member(\cauchy_constant_product_tuple<G, group, p, group.one>(0), {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)})
    \cauchy_constant_product_tuple<G, group, p, group.one>(0) $in \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>
    witness $is_nonempty_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) from \cauchy_constant_product_tuple<G, group, p, group.one>(0)
    finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) >= 1
    release thm prime_arithmetic::_positive_divisor_le_abs(p, finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>))
    abs(finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)) = finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
    p <= finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)

thm finite_set_intersect_member_singleton:
    ? forall S set, distinguished S:
        intersect(S, {distinguished}) = {distinguished}
    by extension:
        ? intersect(S, {distinguished}) = {distinguished}
        claim:
            ? forall candidate intersect(S, {distinguished}):
                candidate $in {distinguished}
            candidate $in {distinguished}
        claim:
            ? forall candidate {distinguished}:
                candidate $in intersect(S, {distinguished})
            candidate = distinguished
            distinguished $in S
            candidate $in S
            candidate $in {distinguished}

thm finite_set_member_has_distinct_member:
    ? forall S nonempty_set, distinguished S:
        $is_finite_set(S)
        finite_set_size(S) >= 2
        =>:
            exist other S st {other != distinguished}
    release thm finite_set_intersect_member_singleton(S, distinguished)
    $is_finite_set({distinguished})
    $is_finite_set(intersect(S, {distinguished}))
    finite_set_size({distinguished}) = 1
    finite_set_size(intersect(S, {distinguished})) = finite_set_size({distinguished}) = 1
    $is_finite_set(set_minus(S, {distinguished}))
    finite_set_size(set_minus(S, {distinguished})) = finite_set_size(S) - finite_set_size(intersect(S, {distinguished}))
    finite_set_size(set_minus(S, {distinguished})) = finite_set_size(S) - finite_set_size(intersect(S, {distinguished})) = finite_set_size(S) - 1 >= 1
    $is_nonempty_set(set_minus(S, {distinguished}))
    have other set_minus(S, {distinguished})
    witness exist result S st {result != distinguished} from other:
        other $in S
        not other $in {distinguished}
        claim:
            ? other != distinguished
            by contra:
                ? other != distinguished
                other = distinguished
                other $in {distinguished}
                impossible not other $in {distinguished}

thm cauchy_fixed_point_has_nonidentity:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
        =>:
            exist candidate \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> st {candidate != \cauchy_constant_tuple<p, G>(group.one)}
    release thm cauchy_fixed_point_count_at_least_prime(G, group, p)
    p >= 2
    finite_set_size(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>) >= p >= 2
    release thm cauchy_group_power_one(G, group, p)
    release thm cauchy_constant_product_tuple_relation(G, group, p, group.one)
    release thm cauchy_constant_product_tuple_is_fixed(G, group, p, group.one)
    \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> = {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)}
    release thm set_builder_member(\cauchy_constant_product_tuple<G, group, p, group.one>(0), {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)})
    \cauchy_constant_product_tuple<G, group, p, group.one>(0) $in \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>
    have fixed_identity \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> = \cauchy_constant_product_tuple<G, group, p, group.one>(0)
    release thm finite_set_member_has_distinct_member(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>, fixed_identity)
    obtain candidate from exist other \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> st {other != fixed_identity}
    witness exist result \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> st {result != \cauchy_constant_tuple<p, G>(group.one)} from candidate:
        claim:
            ? candidate != \cauchy_constant_tuple<p, G>(group.one)
            by contra:
                ? candidate != \cauchy_constant_tuple<p, G>(group.one)
                candidate = \cauchy_constant_tuple<p, G>(group.one) = \cauchy_constant_product_tuple<G, group, p, group.one>(0) = fixed_identity
                impossible candidate != fixed_identity

thm cauchy_nontrivial_prime_power_element:
    ? forall G nonempty_set, group &group::Group<G>, p N+:
        $is_finite_set(G)
        $prime(p)
        $group::divides(p, finite_set_size(G))
        $is_finite_set(\cauchy_tuples::cauchy_product_one_tuples<G, group, p>)
        $is_finite_set(\p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>>)
        =>:
            exist x G st {x != group.one, \cauchy_group_power<G, group>(x, p) = group.one}
    release thm cauchy_fixed_point_has_nonidentity(G, group, p)
    obtain candidate from exist fixed_candidate \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> st {fixed_candidate != \cauchy_constant_tuple<p, G>(group.one)}
    \p_group_actions::action_fixed_points<\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>> = {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)}
    candidate $in {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)}
    release thm set_builder_member(candidate, {fixed_candidate \cauchy_tuples::cauchy_product_one_tuples<G, group, p>: $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, fixed_candidate)})
    $p_group_actions::action_fixed_point(\cyclic_group::cyclic_indices<p>, \cauchy_tuples::cauchy_product_one_tuples<G, group, p>, \cauchy_rotation::cauchy_rotate<G, group, p>, candidate)
    have x G = candidate(\cyclic_group::cyclic_zero<p>)
    claim:
        ? candidate = \cauchy_constant_tuple<p, G>(x)
        claim:
            ? forall index \cyclic_group::cyclic_indices<p>:
                candidate(index) = \cauchy_constant_tuple<p, G>(x)(index)
            release thm cauchy_fixed_tuple_is_constant(G, group, p, candidate, index)
            release thm cauchy_constant_tuple_apply(p, G, x, index)
            candidate(index) = candidate(\cyclic_group::cyclic_zero<p>) = x = \cauchy_constant_tuple<p, G>(x)(index)
        by def:
            ? $fn_eq(candidate, \cauchy_constant_tuple<p, G>(x))
    \cauchy_tuples::cauchy_product_one_tuples<G, group, p> = {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)}
    candidate $in {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)}
    release thm set_builder_member(candidate, {tuple_candidate fn(index \cyclic_group::cyclic_indices<p>) G: $cauchy_tuples::cauchy_tuple_product_one(G, group, p, tuple_candidate)})
    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, candidate)
    $cauchy_tuples::cauchy_tuple_product_one(G, group, p, \cauchy_constant_tuple<p, G>(x))
    release thm cauchy_constant_tuple_power_from_product_one(G, group, p, x)
    claim:
        ? x != group.one
        by contra:
            ? x != group.one
            x = group.one
            candidate = \cauchy_constant_tuple<p, G>(x) = \cauchy_constant_tuple<p, G>(group.one)
            impossible candidate != \cauchy_constant_tuple<p, G>(group.one)
    witness exist result G st {result != group.one, \cauchy_group_power<G, group>(result, p) = group.one} from x:
        x != group.one
        \cauchy_group_power<G, group>(x, p) = group.one
