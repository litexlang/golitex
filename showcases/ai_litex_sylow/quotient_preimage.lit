# Pull a subgroup of N_G(H)/H back to an ambient subgroup of G, then compute
# the pulled-back subgroup's order through explicit quotient-coset coordinates.

template<G nonempty_set, group &group::Group<G>, H power_set(G): $subgroup::is_subgroup(G, group, H), $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H)), $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)>:
    have fn normalizer_quotient_projection(x G) \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H> by cases:
        case x $in \normalizer::subgroup_normalizer<G, group>(H): \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
        case not x $in \normalizer::subgroup_normalizer<G, group>(H): \quotient_groups::quotient_group<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>.one

template<G nonempty_set, group &group::Group<G>, H power_set(G): $subgroup::is_subgroup(G, group, H), $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H)), $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)>:
    have fn sylow_quotient_preimage(K power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)) power_set(G) = {x G: x $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(x) $in K}

thm quotient_subgroup_one_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set:
        $normal_subgroup::is_normal_subgroup(G, group, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<G, group, H>)
        $subgroup::is_subgroup(\quotient_groups::quotient_group_nonempty<G, group, H>, \quotient_groups::quotient_group<G, group, H>, K)
        =>:
            \quotient_groups::quotient_group_one<G, group, H> $in K
    \quotient_groups::quotient_group<G, group, H> = (\quotient_groups::quotient_group_mul<G, group, H>, \quotient_groups::quotient_group_one<G, group, H>, \quotient_groups::quotient_group_inv<G, group, H>)
    \quotient_groups::quotient_group_one<G, group, H> $in K

thm quotient_subgroup_mul_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set, q, r power_set(G):
        $normal_subgroup::is_normal_subgroup(G, group, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<G, group, H>)
        $subgroup::is_subgroup(\quotient_groups::quotient_group_nonempty<G, group, H>, \quotient_groups::quotient_group<G, group, H>, K)
        q $in K
        r $in K
        =>:
            \quotient_groups::quotient_group_mul<G, group, H>(q, r) $in K
    release thm subgroup::subgroup_mul_mem(\quotient_groups::quotient_group_nonempty<G, group, H>, \quotient_groups::quotient_group<G, group, H>, K, q, r)
    \quotient_groups::quotient_group<G, group, H>.mul(q, r) $in K
    \quotient_groups::quotient_group<G, group, H> = (\quotient_groups::quotient_group_mul<G, group, H>, \quotient_groups::quotient_group_one<G, group, H>, \quotient_groups::quotient_group_inv<G, group, H>)
    \quotient_groups::quotient_group<G, group, H>.mul = \quotient_groups::quotient_group_mul<G, group, H>
    \quotient_groups::quotient_group_mul<G, group, H>(q, r) $in K

thm quotient_subgroup_inv_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set, q power_set(G):
        $normal_subgroup::is_normal_subgroup(G, group, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<G, group, H>)
        $subgroup::is_subgroup(\quotient_groups::quotient_group_nonempty<G, group, H>, \quotient_groups::quotient_group<G, group, H>, K)
        q $in K
        =>:
            \quotient_groups::quotient_group_inv<G, group, H>(q) $in K
    release thm subgroup::subgroup_inv_mem(\quotient_groups::quotient_group_nonempty<G, group, H>, \quotient_groups::quotient_group<G, group, H>, K, q)
    \quotient_groups::quotient_group<G, group, H>.inv(q) $in K
    \quotient_groups::quotient_group<G, group, H> = (\quotient_groups::quotient_group_mul<G, group, H>, \quotient_groups::quotient_group_one<G, group, H>, \quotient_groups::quotient_group_inv<G, group, H>)
    \quotient_groups::quotient_group<G, group, H>.inv = \quotient_groups::quotient_group_inv<G, group, H>
    \quotient_groups::quotient_group_inv<G, group, H>(q) $in K

thm subgroup_quotient_one_is_ambient:
    ? forall G nonempty_set, group &group::Group<G>, B, H power_set(G):
        $subgroup::is_subgroup(G, group, B)
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H)
        =>:
            \quotient_groups::quotient_group_one<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H> = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(group.one)
    \subgroup_structure::subgroup_group<G, group, B> = (\subgroup_structure::subgroup_mul<G, group, B>, \subgroup_structure::subgroup_one<G, group, B>, \subgroup_structure::subgroup_inv<G, group, B>)
    \subgroup_structure::subgroup_group<G, group, B>.one = \subgroup_structure::subgroup_one<G, group, B> = group.one
    \quotient_groups::quotient_group_one<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H> = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\subgroup_structure::subgroup_group<G, group, B>.one)
    release thm cosets::object_substitution(\subgroup_structure::subgroup_carrier<G, group, B>, \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>, \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>, \subgroup_structure::subgroup_group<G, group, B>.one, group.one)
    \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\subgroup_structure::subgroup_group<G, group, B>.one) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(group.one)

thm subgroup_quotient_mul_is_ambient:
    ? forall G nonempty_set, group &group::Group<G>, B, H power_set(G), x, y G:
        $subgroup::is_subgroup(G, group, B)
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H)
        x $in B
        y $in B
        \subgroup_structure::subgroup_carrier<G, group, B> = B
        group.mul(x, y) $in \subgroup_structure::subgroup_carrier<G, group, B>
        =>:
            \quotient_groups::quotient_group_mul<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(x), \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(y)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(group.mul(x, y))
    \subgroup_structure::subgroup_carrier<G, group, B> = B
    \subgroup_structure::subgroup_group<G, group, B> = (\subgroup_structure::subgroup_mul<G, group, B>, \subgroup_structure::subgroup_one<G, group, B>, \subgroup_structure::subgroup_inv<G, group, B>)
    \subgroup_structure::subgroup_group<G, group, B>.mul = \subgroup_structure::subgroup_mul<G, group, B>
    \subgroup_structure::subgroup_group<G, group, B>.mul(x, y) = \subgroup_structure::subgroup_mul<G, group, B>(x, y) = group.mul(x, y)
    release thm quotient_groups::quotient_group_mul_mk(\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H, x, y)
    release thm cosets::object_substitution(\subgroup_structure::subgroup_carrier<G, group, B>, \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>, \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>, \subgroup_structure::subgroup_group<G, group, B>.mul(x, y), group.mul(x, y))
    \quotient_groups::quotient_group_mul<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(x), \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(y)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\subgroup_structure::subgroup_group<G, group, B>.mul(x, y)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(group.mul(x, y))

thm subgroup_quotient_inv_is_ambient:
    ? forall G nonempty_set, group &group::Group<G>, B, H power_set(G), x G:
        $subgroup::is_subgroup(G, group, B)
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H)
        x $in B
        \subgroup_structure::subgroup_carrier<G, group, B> = B
        group.inv(x) $in \subgroup_structure::subgroup_carrier<G, group, B>
        =>:
            \quotient_groups::quotient_group_inv<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(x)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(group.inv(x))
    \subgroup_structure::subgroup_carrier<G, group, B> = B
    \subgroup_structure::subgroup_group<G, group, B> = (\subgroup_structure::subgroup_mul<G, group, B>, \subgroup_structure::subgroup_one<G, group, B>, \subgroup_structure::subgroup_inv<G, group, B>)
    \subgroup_structure::subgroup_group<G, group, B>.inv = \subgroup_structure::subgroup_inv<G, group, B>
    \subgroup_structure::subgroup_group<G, group, B>.inv(x) = \subgroup_structure::subgroup_inv<G, group, B>(x) = group.inv(x)
    release thm quotient_groups::quotient_group_inv_mk(\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H, x)
    release thm cosets::object_substitution(\subgroup_structure::subgroup_carrier<G, group, B>, \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>, \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>, \subgroup_structure::subgroup_group<G, group, B>.inv(x), group.inv(x))
    \quotient_groups::quotient_group_inv<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(x)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(\subgroup_structure::subgroup_group<G, group, B>.inv(x)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, B>, \subgroup_structure::subgroup_group<G, group, B>, H>(group.inv(x))

thm subgroup_group_mul_is_ambient:
    ? forall G nonempty_set, group &group::Group<G>, B power_set(G), x, y G:
        $subgroup::is_subgroup(G, group, B)
        x $in B
        y $in B
        =>:
            \subgroup_structure::subgroup_group<G, group, B>.mul(x, y) = group.mul(x, y)
    \subgroup_structure::subgroup_group<G, group, B> = (\subgroup_structure::subgroup_mul<G, group, B>, \subgroup_structure::subgroup_one<G, group, B>, \subgroup_structure::subgroup_inv<G, group, B>)
    \subgroup_structure::subgroup_group<G, group, B>.mul = \subgroup_structure::subgroup_mul<G, group, B>
    \subgroup_structure::subgroup_group<G, group, B>.mul(x, y) = \subgroup_structure::subgroup_mul<G, group, B>(x, y) = group.mul(x, y)

thm sylow_quotient_preimage_closed:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        $subgroup::is_subgroup(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, \quotient_groups::quotient_group<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, K)
        =>:
            $subgroup::is_subgroup(G, group, \sylow_quotient_preimage<G, group, H>(K))
    release thm normalizer::subgroup_normalizer_closed(G, group, H)
    release thm quotient_subgroup_one_mem(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, K)
    release thm subgroup_quotient_one_is_ambient(G, group, \normalizer::subgroup_normalizer<G, group>(H), H)
    group.one $in \normalizer::subgroup_normalizer<G, group>(H)
    \quotient_groups::quotient_group_one<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H> $in K
    \quotient_groups::quotient_group_one<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H> = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.one)
    \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.one) $in K
    \normalizer_quotient_projection<G, group, H>(group.one) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.one)
    group.one $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(group.one) $in K
    release thm set_builder_member(group.one, {x G: x $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(x) $in K})
    group.one $in \sylow_quotient_preimage<G, group, H>(K)
    claim:
        ? forall x, y G:
            x $in \sylow_quotient_preimage<G, group, H>(K)
            y $in \sylow_quotient_preimage<G, group, H>(K)
            =>:
                group.mul(x, y) $in \sylow_quotient_preimage<G, group, H>(K)
        release thm set_builder_member(x, {candidate G: candidate $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        release thm set_builder_member(y, {candidate G: candidate $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        x $in \normalizer::subgroup_normalizer<G, group>(H)
        y $in \normalizer::subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(x) $in K
        \normalizer_quotient_projection<G, group, H>(y) $in K
        \normalizer_quotient_projection<G, group, H>(x) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
        \normalizer_quotient_projection<G, group, H>(y) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(y)
        \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in K
        \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(y) $in K
        release thm quotient_subgroup_mul_mem(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, K, \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(y))
        release thm subgroup::subgroup_mul_mem(G, group, \normalizer::subgroup_normalizer<G, group>(H), x, y)
        group.mul(x, y) $in \normalizer::subgroup_normalizer<G, group>(H)
        \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)> = \normalizer::subgroup_normalizer<G, group>(H)
        group.mul(x, y) $in \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>
        release thm subgroup_quotient_mul_is_ambient(G, group, \normalizer::subgroup_normalizer<G, group>(H), H, x, y)
        \quotient_groups::quotient_group_mul<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(y)) $in K
        \quotient_groups::quotient_group_mul<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(y)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.mul(x, y))
        \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.mul(x, y)) $in K
        group.mul(x, y) $in \normalizer::subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(group.mul(x, y)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.mul(x, y))
        \normalizer_quotient_projection<G, group, H>(group.mul(x, y)) $in K
        group.mul(x, y) $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(group.mul(x, y)) $in K
        release thm set_builder_member(group.mul(x, y), {candidate G: candidate $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        group.mul(x, y) $in \sylow_quotient_preimage<G, group, H>(K)
    claim:
        ? forall x G:
            x $in \sylow_quotient_preimage<G, group, H>(K)
            =>:
                group.inv(x) $in \sylow_quotient_preimage<G, group, H>(K)
        release thm set_builder_member(x, {candidate G: candidate $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        x $in \normalizer::subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(x) $in K
        \normalizer_quotient_projection<G, group, H>(x) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
        \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in K
        release thm quotient_subgroup_inv_mem(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, K, \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x))
        release thm subgroup::subgroup_inv_mem(G, group, \normalizer::subgroup_normalizer<G, group>(H), x)
        group.inv(x) $in \normalizer::subgroup_normalizer<G, group>(H)
        \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)> = \normalizer::subgroup_normalizer<G, group>(H)
        group.inv(x) $in \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>
        release thm subgroup_quotient_inv_is_ambient(G, group, \normalizer::subgroup_normalizer<G, group>(H), H, x)
        \quotient_groups::quotient_group_inv<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)) $in K
        \quotient_groups::quotient_group_inv<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.inv(x))
        \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.inv(x)) $in K
        group.inv(x) $in \normalizer::subgroup_normalizer<G, group>(H)
        \normalizer_quotient_projection<G, group, H>(group.inv(x)) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(group.inv(x))
        \normalizer_quotient_projection<G, group, H>(group.inv(x)) $in K
        group.inv(x) $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(group.inv(x)) $in K
        release thm set_builder_member(group.inv(x), {candidate G: candidate $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
        group.inv(x) $in \sylow_quotient_preimage<G, group, H>(K)
    by def:
        ? $subgroup::is_subgroup(G, group, \sylow_quotient_preimage<G, group, H>(K))

thm sylow_quotient_preimage_finite:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        $is_finite_set(G)
        =>:
            $is_finite_set(\sylow_quotient_preimage<G, group, H>(K))
    \sylow_quotient_preimage<G, group, H>(K) $subset G
    release thm subset_of_finite_set_is_finite(\sylow_quotient_preimage<G, group, H>(K), G)

thm sylow_preimage_forward_pair_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K set, x G:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        x $in \sylow_quotient_preimage<G, group, H>(K)
        =>:
            (\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)) $in cart(K, H)
    release thm set_builder_member(x, {candidate G: candidate $in \normalizer::subgroup_normalizer<G, group>(H) and \normalizer_quotient_projection<G, group, H>(candidate) $in K})
    x $in \normalizer::subgroup_normalizer<G, group>(H)
    \normalizer_quotient_projection<G, group, H>(x) $in K
    \normalizer_quotient_projection<G, group, H>(x) = \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)
    \quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in K
    release thm cosets::left_coset_coordinate_mem(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, x)
    \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x) $in H
    release thm cart_member_from_coordinates((\quotient_groups::quotient_group_mk<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x), \cosets::left_coset_coordinate<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(x)), cart(K, H))

thm sylow_preimage_backward_mem:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), K, pair set:
        $subgroup::is_subgroup(G, group, H)
        $subgroup::is_subgroup(G, group, \normalizer::subgroup_normalizer<G, group>(H))
        $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H)
        K $in power_set(\quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>)
        pair $in cart(K, H)
        =>:
            group.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2]) $in \sylow_quotient_preimage<G, group, H>(K)
    pair[1] $in K
    pair[2] $in H
    K $subset \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>
    pair[1] $in \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>
    \quotient_groups::quotient_group_nonempty<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H> = \cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H)
    pair[1] $in \cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H)
    release thm cart_member_from_coordinates((pair[1], pair[2]), cart(\cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H), H))
    have broad_pair cart(\cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H), H) = (pair[1], pair[2])
    have x \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)> = \cosets::left_coset_backward<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair)
    x = \cosets::left_coset_backward<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair)
    broad_pair[1] = pair[1]
    broad_pair[2] = pair[2]
    \cosets::left_coset_backward<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]), broad_pair[2])
    release thm cosets::object_substitution(\cosets::quotient_group_carrier<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H), \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>, broad_pair[1], pair[1])
    \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]) = \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1])
    release thm cosets::object_substitution(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, fn(t \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>) \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)> {\subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(t, broad_pair[2])}, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]), \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]))
    \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(broad_pair[1]), broad_pair[2]) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), broad_pair[2])
    release thm cosets::object_substitution(H, \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, fn(t H) \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)> {\subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), t)}, broad_pair[2], pair[2])
    \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), broad_pair[2]) = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    x = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    release thm subgroup_group_mul_is_ambient(G, group, \normalizer::subgroup_normalizer<G, group>(H), \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    x = group.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    release thm cosets::left_coset_center_mem(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]))
    \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]) $in \cosets::left_coset<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]))
    witness $cosets::left_coset_member(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), x) from pair[2]:
        x = \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>.mul(\cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), pair[2])
    release thm set_builder_member(x, {candidate \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>: $cosets::left_coset_member(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), candidate)})
    \cosets::left_coset<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>>(H, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1])) = {candidate \subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>: $cosets::left_coset_member(\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H, \cosets::left_coset_representative<\subgroup_structure::subgroup_carrier<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \normalizer::subgroup_normalizer<G, group>(H)>, H>(pair[1]), candidate)}
