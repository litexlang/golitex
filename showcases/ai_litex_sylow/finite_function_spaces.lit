# MIL Chapter 9 finite function-space counting layer used by Cauchy's theorem.
#
# It constructs the explicit one-point extension bijection and proves
# the cardinality formula |(A -> B)| = |B|^|A| by finite-set induction.
thm empty_function_space_singleton:
    ? forall B nonempty_set, b B:
        fn(input {}) B = {fn(input {}) B {b}}
    claim:
        ? forall f fn(input {}) B:
            f = fn(input {}) B {b}
        claim:
            ? forall empty_input {}:
                f(empty_input) = fn(input {}) B {b}(empty_input)
            by contra:
                ? f(empty_input) = fn(input {}) B {b}(empty_input)
                impossible empty_input $in {}
        by def:
            ? $fn_eq(f, fn(input {}) B {b})
    by extension:
        ? fn(input {}) B = {fn(input {}) B {b}}
        claim:
            ? forall f fn(input {}) B:
                f $in {fn(input {}) B {b}}
            f = fn(input {}) B {b}
        claim:
            ? forall f {fn(input {}) B {b}}:
                f $in fn(input {}) B

prop is_new_point_extension_value(A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S), output B):
    input = z
    output = pair[2]

prop is_old_point_extension_value(A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S), output B):
    input != z
    exist old_input S st {old_input = input, output = pair[1](old_input)}

prop is_point_extension_value(A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S), output B):
    $is_new_point_extension_value(A, z, S, B, pair, input, output) or $is_old_point_extension_value(A, z, S, B, pair, input, output)

thm point_extension_value_exists_unique:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S):
        not z $in S
        =>:
            exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)}
    by cases:
        ? exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)}
        case input = z:
            witness exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)} from pair[2]:
                by def:
                    ? $is_new_point_extension_value(A, z, S, B, pair, input, pair[2])
                claim:
                    ? forall left, right B:
                        $is_point_extension_value(A, z, S, B, pair, input, left)
                        $is_point_extension_value(A, z, S, B, pair, input, right)
                        =>:
                            left = right
                    claim:
                        ? left = pair[2]
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, left)
                        by cases:
                            ? left = pair[2]
                            case $is_new_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, left)
                            case $is_old_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, left)
                                impossible input = z
                    claim:
                        ? right = pair[2]
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, right)
                        by cases:
                            ? right = pair[2]
                            case $is_new_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, right)
                            case $is_old_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, right)
                                impossible input = z
                    left = pair[2] = right
        case input != z:
            claim:
                ? input $in S
                input $in {z} or input $in S
                by cases:
                    ? input $in S
                    case input $in {z}:
                        input = z
                        impossible input != z
                    case input $in S:
                        input $in S
            have old_input S = input
            witness exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)} from pair[1](old_input):
                claim:
                    ? $is_old_point_extension_value(A, z, S, B, pair, input, pair[1](old_input))
                    witness exist old_witness S st {old_witness = input, pair[1](old_input) = pair[1](old_witness)} from old_input
                by def:
                    ? $is_point_extension_value(A, z, S, B, pair, input, pair[1](old_input))
                claim:
                    ? forall left, right B:
                        $is_point_extension_value(A, z, S, B, pair, input, left)
                        $is_point_extension_value(A, z, S, B, pair, input, right)
                        =>:
                            left = right
                    claim:
                        ? left = pair[1](old_input)
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, left)
                        by cases:
                            ? left = pair[1](old_input)
                            case $is_new_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, left)
                                impossible input != z
                            case $is_old_point_extension_value(A, z, S, B, pair, input, left):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, left)
                                obtain left_input from exist left_input S st {left_input = input, left = pair[1](left_input)}
                                left_input = input = old_input
                                left = pair[1](left_input) = pair[1](old_input)
                    claim:
                        ? right = pair[1](old_input)
                        by def:
                            ? $is_point_extension_value(A, z, S, B, pair, input, right)
                        by cases:
                            ? right = pair[1](old_input)
                            case $is_new_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_new_point_extension_value(A, z, S, B, pair, input, right)
                                impossible input != z
                            case $is_old_point_extension_value(A, z, S, B, pair, input, right):
                                by def $is_old_point_extension_value(A, z, S, B, pair, input, right)
                                obtain right_input from exist right_input S st {right_input = input, right = pair[1](right_input)}
                                right_input = input = old_input
                                right = pair[1](right_input) = pair[1](old_input)
                    left = pair[1](old_input) = right


template<A set, z A, S power_set(A), B nonempty_set: not z $in S>:
    have fn point_extension_value_selected by exist!:
        ? forall pair cart(fn(x S) B, B), input union({z}, S):
            exist! output B st {$is_point_extension_value(A, z, S, B, pair, input, output)}
        release thm point_extension_value_exists_unique(A, z, S, B, pair, input)

template<A set, z A, S power_set(A), B nonempty_set: not z $in S>:
    have fn point_extend(pair cart(fn(x S) B, B)) fn(output union({z}, S)) B = fn(input union({z}, S)) B {\point_extension_value_selected<A, z, S, B>(pair, input)}

thm point_extend_value_relation:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input union({z}, S):
        not z $in S
        =>:
            $is_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
    $is_point_extension_value(A, z, S, B, pair, input, \point_extension_value_selected<A, z, S, B>(pair, input))
    \point_extend<A, z, S, B>(pair) = fn(current union({z}, S)) B {\point_extension_value_selected<A, z, S, B>(pair, current)}
    \point_extend<A, z, S, B>(pair)(input) = \point_extension_value_selected<A, z, S, B>(pair, input)
    \point_extension_value_selected<A, z, S, B>(pair, input) = \point_extend<A, z, S, B>(pair)(input)
    $is_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))


thm point_extend_at_new:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B):
        not z $in S
        =>:
            \point_extend<A, z, S, B>(pair)(z) = pair[2]
    release thm point_extend_value_relation(A, z, S, B, pair, z)
    by def:
        ? $is_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z))
    by cases:
        ? \point_extend<A, z, S, B>(pair)(z) = pair[2]
        case $is_new_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z)):
            by def $is_new_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z))
        case $is_old_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z)):
            by def $is_old_point_extension_value(A, z, S, B, pair, z, \point_extend<A, z, S, B>(pair)(z))
            impossible z = z


thm point_extend_at_old:
    ? forall A set, z A, S power_set(A), B nonempty_set, pair cart(fn(x S) B, B), input S:
        not z $in S
        =>:
            \point_extend<A, z, S, B>(pair)(input) = pair[1](input)
    input $in union({z}, S)
    release thm point_extend_value_relation(A, z, S, B, pair, input)
    by def:
        ? $is_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
    by cases:
        ? \point_extend<A, z, S, B>(pair)(input) = pair[1](input)
        case $is_new_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input)):
            by def $is_new_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
            impossible not z $in S
        case $is_old_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input)):
            by def $is_old_point_extension_value(A, z, S, B, pair, input, \point_extend<A, z, S, B>(pair)(input))
            obtain old_input from exist old_input S st {old_input = input, \point_extend<A, z, S, B>(pair)(input) = pair[1](old_input)}
            old_input = input
            \point_extend<A, z, S, B>(pair)(input) = pair[1](old_input) = pair[1](input)


thm equal_functions_equal_at:
    ? forall A, B set, f, g fn(x A) B, input A:
        f = g
        =>:
            f(input) = g(input)
    have fn evaluate(h fn(x A) B) B = h(input)
    evaluate(f) = evaluate(g)
    f(input) = evaluate(f) = evaluate(g) = g(input)


thm function_equal_on_equal_inputs:
    ? forall A, B set, f fn(x A) B, left, right A:
        left = right
        =>:
            f(left) = f(right)
    f(left) = f(right)


thm point_extend_injective:
    ? forall A set, z A, S power_set(A), B nonempty_set:
        not z $in S
        =>:
            $injective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)
    claim:
        ? forall left, right cart(fn(x S) B, B):
            \point_extend<A, z, S, B>(left) = \point_extend<A, z, S, B>(right)
            =>:
                left = right
        have left_function fn(x S) B = left[1]
        have right_function fn(x S) B = right[1]
        have left_value B = left[2]
        have right_value B = right[2]
        release thm equal_functions_equal_at(union({z}, S), B, \point_extend<A, z, S, B>(left), \point_extend<A, z, S, B>(right), z)
        release thm point_extend_at_new(A, z, S, B, left)
        release thm point_extend_at_new(A, z, S, B, right)
        left_value = left[2] = \point_extend<A, z, S, B>(left)(z) = \point_extend<A, z, S, B>(right)(z) = right[2] = right_value
        claim:
            ? forall input S:
                left_function(input) = right_function(input)
            release thm equal_functions_equal_at(union({z}, S), B, \point_extend<A, z, S, B>(left), \point_extend<A, z, S, B>(right), input)
            release thm point_extend_at_old(A, z, S, B, left, input)
            release thm point_extend_at_old(A, z, S, B, right, input)
            left_function(input) = left[1](input) = \point_extend<A, z, S, B>(left)(input) = \point_extend<A, z, S, B>(right)(input) = right[1](input) = right_function(input)
        by def:
            ? $fn_eq(left_function, right_function)
        left_function = right_function
        left[1] = left_function = right_function = right[1]
        left[2] = left_value = right_value = right[2]
        tuple_dim(left) = 2
        tuple_dim(right) = 2
        claim:
            ? forall coordinate closed_range(1, 2):
                left[coordinate] = right[coordinate]
            by closed_range as cases: coordinate $in 1...2
            by cases:
                ? left[coordinate] = right[coordinate]
                case coordinate = 1:
                    left[coordinate] = left[1] = right[1] = right[coordinate]
                case coordinate = 2:
                    left[coordinate] = left[2] = right[2] = right[coordinate]
        release thm tuple_equal_from_coordinates(left, right)
    by def:
        ? $injective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)


thm point_extend_surjective:
    ? forall A set, z A, S power_set(A), B nonempty_set:
        not z $in S
        =>:
            $surjective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)
    claim:
        ? forall target fn(output union({z}, S)) B:
            exist source cart(fn(x S) B, B) st {target = \point_extend<A, z, S, B>(source)}
        have fn restricted(input S) B = target(input)
        have source_pair cart(fn(x S) B, B) = (restricted, target(z))
        claim:
            ? forall input union({z}, S):
                target(input) = \point_extend<A, z, S, B>(source_pair)(input)
            by cases:
                ? target(input) = \point_extend<A, z, S, B>(source_pair)(input)
                case input = z:
                    release thm function_equal_on_equal_inputs(union({z}, S), B, target, input, z)
                    release thm point_extend_at_new(A, z, S, B, source_pair)
                    source_pair[2] = target(z)
                    target(input) = target(z) = source_pair[2] = \point_extend<A, z, S, B>(source_pair)(z)
                    release thm function_equal_on_equal_inputs(union({z}, S), B, \point_extend<A, z, S, B>(source_pair), z, input)
                    target(input) = \point_extend<A, z, S, B>(source_pair)(input)
                case input != z:
                    claim:
                        ? input $in S
                        input $in {z} or input $in S
                        by cases:
                            ? input $in S
                            case input $in {z}:
                                input = z
                                impossible input != z
                            case input $in S:
                                input $in S
                    have old_input S = input
                    release thm point_extend_at_old(A, z, S, B, source_pair, old_input)
                    source_pair[1] = restricted
                    source_pair[1](old_input) = restricted(old_input) = target(old_input)
                    release thm function_equal_on_equal_inputs(union({z}, S), B, target, old_input, input)
                    target(input) = target(old_input) = source_pair[1](old_input) = \point_extend<A, z, S, B>(source_pair)(old_input)
                    release thm function_equal_on_equal_inputs(union({z}, S), B, \point_extend<A, z, S, B>(source_pair), old_input, input)
                    target(input) = \point_extend<A, z, S, B>(source_pair)(input)
        by def:
            ? $fn_eq(target, \point_extend<A, z, S, B>(source_pair))
        target = \point_extend<A, z, S, B>(source_pair)
        witness exist source cart(fn(x S) B, B) st {target = \point_extend<A, z, S, B>(source)} from source_pair
    by def:
        ? $surjective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)


thm point_extend_range_eq:
    ? forall A set, z A, S power_set(A), B nonempty_set:
        not z $in S
        =>:
            fn_range(\point_extend<A, z, S, B>) = fn(output union({z}, S)) B
    release thm point_extend_surjective(A, z, S, B)
    by def:
        ? $surjective(cart(fn(x S) B, B), fn(output union({z}, S)) B, \point_extend<A, z, S, B>)
    by extension:
        ? fn_range(\point_extend<A, z, S, B>) = fn(output union({z}, S)) B
        claim:
            ? forall target fn_range(\point_extend<A, z, S, B>):
                target $in fn(output union({z}, S)) B
            have by preimage source from target $in fn_range(\point_extend<A, z, S, B>)
            \point_extend<A, z, S, B>(source) $in fn(output union({z}, S)) B
            target = \point_extend<A, z, S, B>(source)
            target $in fn(output union({z}, S)) B
        claim:
            ? forall target fn(output union({z}, S)) B:
                target $in fn_range(\point_extend<A, z, S, B>)
            obtain source from exist source cart(fn(x S) B, B) st {target = \point_extend<A, z, S, B>(source)}
            \point_extend<A, z, S, B>(source) $in fn_range(\point_extend<A, z, S, B>)
            target = \point_extend<A, z, S, B>(source)
            target $in fn_range(\point_extend<A, z, S, B>)


prop finite_function_space_count_property(P, B finite_set):
    $is_finite_set(fn(x P) B)
    finite_set_size(fn(x P) B) = finite_set_size(B)^finite_set_size(P)

thm singleton_intersection_empty:
    ? forall A set, z A, S power_set(A):
        not z $in S
        =>:
            intersect({z}, S) = {}
    by extension:
        ? intersect({z}, S) = {}
        claim:
            ? forall input intersect({z}, S):
                input $in {}
            input $in {z}
            input = z
            input $in S
            z $in S
            by contra:
                ? input $in {}
                impossible not z $in S
        claim:
            ? forall empty_input {}:
                empty_input $in intersect({z}, S)
            by contra:
                ? empty_input $in intersect({z}, S)
                impossible empty_input $in {}


thm finite_function_space_count_insert_step:
    ? forall A, B finite_set, default B, z A, S finite_set:
        S $subset A
        not z $in S
        $finite_function_space_count_property(S, B)
        =>:
            $finite_function_space_count_property(union({z}, S), B)
    witness $is_nonempty_set(B) from default
    by def:
        ? $finite_function_space_count_property(S, B)
    $is_finite_set(fn(x S) B)
    finite_set_size(fn(x S) B) = finite_set_size(B)^finite_set_size(S)
    have source_functions finite_set = fn(x S) B
    have source_pairs finite_set = cart(source_functions, B)
    source_functions = fn(x S) B
    source_pairs = cart(source_functions, B) = cart(fn(x S) B, B)
    $is_finite_set(cart(fn(x S) B, B))
    finite_set_size(cart(source_functions, B)) = finite_set_size(source_functions) * finite_set_size(B)
    finite_set_size(source_pairs) = finite_set_size(cart(source_functions, B)) = finite_set_size(source_functions) * finite_set_size(B)
    finite_set_size(source_functions) = finite_set_size(fn(x S) B) = finite_set_size(B)^finite_set_size(S)
    finite_set_size(cart(fn(x S) B, B)) = finite_set_size(source_pairs) = finite_set_size(source_functions) * finite_set_size(B) = finite_set_size(B)^finite_set_size(S) * finite_set_size(B)
    release thm point_extend_injective(A, z, S, B)
    release thm point_extend_range_eq(A, z, S, B)
    $is_finite_set(fn_range(\point_extend<A, z, S, B>))
    finite_set_size(fn_range(\point_extend<A, z, S, B>)) = finite_set_size(cart(fn(x S) B, B))
    fn_range(\point_extend<A, z, S, B>) = fn(output union({z}, S)) B
    $is_finite_set(fn(output union({z}, S)) B)
    finite_set_size(fn(output union({z}, S)) B) = finite_set_size(fn_range(\point_extend<A, z, S, B>))
    release thm singleton_intersection_empty(A, z, S)
    finite_set_size(intersect({z}, S)) = finite_set_size({}) = 0
    finite_set_size({z}) = 1
    finite_set_size(union({z}, S)) = finite_set_size({z}) + finite_set_size(S) - finite_set_size(intersect({z}, S)) = 1 + finite_set_size(S) - 0 = finite_set_size(S) + 1
    finite_set_size(B)^(finite_set_size(S) + 1) = finite_set_size(B)^finite_set_size(S) * finite_set_size(B)
    finite_set_size(fn(output union({z}, S)) B) = finite_set_size(fn_range(\point_extend<A, z, S, B>)) = finite_set_size(cart(fn(x S) B, B)) = finite_set_size(B)^finite_set_size(S) * finite_set_size(B) = finite_set_size(B)^(finite_set_size(S) + 1) = finite_set_size(B)^finite_set_size(union({z}, S))
    by def:
        ? $finite_function_space_count_property(union({z}, S), B)


thm finite_function_space_count_empty:
    ? forall B finite_set, default B:
        $finite_function_space_count_property({}, B)
    witness $is_nonempty_set(B) from default
    release thm empty_function_space_singleton(B, default)
    have empty_functions finite_set = {fn(input {}) B {default}}
    fn(input {}) B = {fn(input {}) B {default}} = empty_functions
    $is_finite_set(fn(input {}) B)
    finite_set_size(empty_functions) = finite_set_size({fn(input {}) B {default}}) = 1
    finite_set_size(fn(input {}) B) = finite_set_size(empty_functions) = 1
    finite_set_size({}) = 0
    finite_set_size(B)^finite_set_size({}) = finite_set_size(B)^0 = 1
    finite_set_size(fn(input {}) B) = finite_set_size(B)^finite_set_size({})
    by def:
        ? $finite_function_space_count_property({}, B)


thm finite_function_space_count:
    ? forall A, B finite_set, default B:
        $finite_function_space_count_property(A, B)
    witness $is_nonempty_set(B) from default
    by induc P in A:
        ? $finite_function_space_count_property(P, B)
        ? from P = {}:
            release thm finite_function_space_count_empty(B, default)
            $finite_function_space_count_property({}, B)
            $finite_function_space_count_property(P, B)
        ? induc z, S:
            release thm finite_function_space_count_insert_step(A, B, default, z, S)


# Arithmetic foundation for orbit sizes in finite p-group actions.
