# Concrete cyclic group of prime order used by the Cauchy counting action.

template<p N+>:
    have cyclic_indices nonempty_set = closed_range(0, p - 1)

prop is_cyclic_add_value(p N+, a, b, value Z):
    value = (a + b) % p

template<p N+>:
    have fn cyclic_add by exist!:
        ? forall a, b \cyclic_indices<p>:
            exist! value \cyclic_indices<p> st {$is_cyclic_add_value(p, a, b, value)}
        (a + b) % p >= 0
        abs((a + b) % p) = (a + b) % p
        have remainder N = abs((a + b) % p)
        remainder = (a + b) % p
        (a + b) % p < p
        remainder < p
        remainder <= p - 1
        remainder $in closed_range(0, p - 1) = \cyclic_indices<p>
        witness exist value \cyclic_indices<p> st {$is_cyclic_add_value(p, a, b, value)} from remainder:
            by def:
                ? $is_cyclic_add_value(p, a, b, remainder)
        claim:
            ? forall value1, value2 \cyclic_indices<p>:
                $is_cyclic_add_value(p, a, b, value1)
                $is_cyclic_add_value(p, a, b, value2)
                =>:
                    value1 = value2
            by def $is_cyclic_add_value(p, a, b, value1)
            by def $is_cyclic_add_value(p, a, b, value2)

prop is_cyclic_zero_value(value Z):
    value = 0

template<p N+>:
    have fn cyclic_zero_selector by exist!:
        ? forall dummy {0}:
            exist! value \cyclic_indices<p> st {$is_cyclic_zero_value(value)}
        p >= 1
        0 <= p - 1
        0 $in closed_range(0, p - 1) = \cyclic_indices<p>
        witness exist value \cyclic_indices<p> st {$is_cyclic_zero_value(value)} from 0:
            by def:
                ? $is_cyclic_zero_value(0)
        claim:
            ? forall value1, value2 \cyclic_indices<p>:
                $is_cyclic_zero_value(value1)
                $is_cyclic_zero_value(value2)
                =>:
                    value1 = value2
            by def $is_cyclic_zero_value(value1)
            by def $is_cyclic_zero_value(value2)

template<p N+>:
    have cyclic_zero \cyclic_indices<p> = \cyclic_zero_selector<p>(0)

prop is_cyclic_neg_value(p N+, a, value Z):
    value = (-a) % p

template<p N+>:
    have fn cyclic_neg by exist!:
        ? forall a \cyclic_indices<p>:
            exist! value \cyclic_indices<p> st {$is_cyclic_neg_value(p, a, value)}
        (-a) % p >= 0
        abs((-a) % p) = (-a) % p
        have remainder N = abs((-a) % p)
        remainder = (-a) % p
        (-a) % p < p
        remainder < p
        remainder <= p - 1
        remainder $in closed_range(0, p - 1) = \cyclic_indices<p>
        witness exist value \cyclic_indices<p> st {$is_cyclic_neg_value(p, a, value)} from remainder:
            by def:
                ? $is_cyclic_neg_value(p, a, remainder)
        claim:
            ? forall value1, value2 \cyclic_indices<p>:
                $is_cyclic_neg_value(p, a, value1)
                $is_cyclic_neg_value(p, a, value2)
                =>:
                    value1 = value2
            by def $is_cyclic_neg_value(p, a, value1)
            by def $is_cyclic_neg_value(p, a, value2)

thm cyclic_add_apply:
    ? forall p N+, a, b \cyclic_indices<p>:
        \cyclic_add<p>(a, b) = (a + b) % p
    $is_cyclic_add_value(p, a, b, \cyclic_add<p>(a, b))
    by def:
        ? $is_cyclic_add_value(p, a, b, \cyclic_add<p>(a, b))

thm cyclic_zero_apply:
    ? forall p N+:
        \cyclic_zero<p> = 0
    \cyclic_zero<p> = \cyclic_zero_selector<p>(0)
    $is_cyclic_zero_value(\cyclic_zero_selector<p>(0))
    by def:
        ? $is_cyclic_zero_value(\cyclic_zero_selector<p>(0))

thm cyclic_neg_apply:
    ? forall p N+, a \cyclic_indices<p>:
        \cyclic_neg<p>(a) = (-a) % p
    $is_cyclic_neg_value(p, a, \cyclic_neg<p>(a))
    by def:
        ? $is_cyclic_neg_value(p, a, \cyclic_neg<p>(a))

thm cyclic_index_mod_self:
    ? forall p N+, a \cyclic_indices<p>:
        a % p = a
    \cyclic_indices<p> = closed_range(0, p - 1)
    0 <= a <= p - 1
    abs(a) = a
    have natural_a N = abs(a)
    natural_a = a
    p - 1 < p
    a < p
    a = p * 0 + a
    a % p = a

thm cyclic_prime_group_laws:
    ? forall p N+:
        $group::group_laws(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)
    claim:
        ? forall a, b, c \cyclic_indices<p>:
            \cyclic_add<p>(\cyclic_add<p>(a, b), c) = \cyclic_add<p>(a, \cyclic_add<p>(b, c))
        release thm cyclic_index_mod_self(p, a)
        release thm cyclic_index_mod_self(p, b)
        release thm cyclic_index_mod_self(p, c)
        release thm cyclic_add_apply(p, a, b)
        release thm cyclic_add_apply(p, \cyclic_add<p>(a, b), c)
        release thm cyclic_add_apply(p, b, c)
        release thm cyclic_add_apply(p, a, \cyclic_add<p>(b, c))
        \cyclic_add<p>(\cyclic_add<p>(a, b), c) = (\cyclic_add<p>(a, b) + c) % p
        release thm cosets::object_substitution(Z, Z, fn(t Z) Z {(t + c) % p}, \cyclic_add<p>(a, b), (a + b) % p)
        (\cyclic_add<p>(a, b) + c) % p = (((a + b) % p) + c) % p
        \cyclic_add<p>(\cyclic_add<p>(a, b), c) = (((a + b) % p) + c) % p = ((((a + b) % p) + (c % p)) % p) = ((a + b) + c) % p
        \cyclic_add<p>(a, \cyclic_add<p>(b, c)) = (a + \cyclic_add<p>(b, c)) % p
        release thm cosets::object_substitution(Z, Z, fn(t Z) Z {(a + t) % p}, \cyclic_add<p>(b, c), (b + c) % p)
        (a + \cyclic_add<p>(b, c)) % p = (a + ((b + c) % p)) % p
        \cyclic_add<p>(a, \cyclic_add<p>(b, c)) = (a + ((b + c) % p)) % p = (((a % p) + ((b + c) % p)) % p) = (a + (b + c)) % p
        (a + b) + c = a + (b + c)
        ((a + b) + c) % p = (a + (b + c)) % p
        \cyclic_add<p>(\cyclic_add<p>(a, b), c) = ((a + b) + c) % p = (a + (b + c)) % p = \cyclic_add<p>(a, \cyclic_add<p>(b, c))
    claim:
        ? forall a \cyclic_indices<p>:
            \cyclic_add<p>(\cyclic_zero<p>, a) = a
        release thm cyclic_index_mod_self(p, a)
        release thm cyclic_zero_apply(p)
        release thm cyclic_add_apply(p, \cyclic_zero<p>, a)
        \cyclic_add<p>(\cyclic_zero<p>, a) = (\cyclic_zero<p> + a) % p
        release thm cosets::object_substitution(Z, Z, fn(t Z) Z {(t + a) % p}, \cyclic_zero<p>, 0)
        (\cyclic_zero<p> + a) % p = (0 + a) % p
        \cyclic_add<p>(\cyclic_zero<p>, a) = (0 + a) % p = a % p = a
    claim:
        ? forall a \cyclic_indices<p>:
            \cyclic_add<p>(\cyclic_neg<p>(a), a) = \cyclic_zero<p>
        release thm cyclic_index_mod_self(p, a)
        release thm cyclic_neg_apply(p, a)
        release thm cyclic_zero_apply(p)
        release thm cyclic_add_apply(p, \cyclic_neg<p>(a), a)
        \cyclic_add<p>(\cyclic_neg<p>(a), a) = (\cyclic_neg<p>(a) + a) % p
        release thm cosets::object_substitution(Z, Z, fn(t Z) Z {(t + a) % p}, \cyclic_neg<p>(a), (-a) % p)
        (\cyclic_neg<p>(a) + a) % p = (((-a) % p) + a) % p
        \cyclic_add<p>(\cyclic_neg<p>(a), a) = (((-a) % p) + a) % p = ((((-a) % p) + (a % p)) % p) = ((-a) + a) % p = 0 % p = 0 = \cyclic_zero<p>
    by def:
        ? $group::group_laws(\cyclic_indices<p>, \cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)

thm cyclic_prime_group_member:
    ? forall p N+:
        (\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>) $in &group::Group<\cyclic_indices<p>>
    release thm cyclic_prime_group_laws(p)
    release thm cart_member_from_coordinates((\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>), cart(fn(a, b \cyclic_indices<p>) \cyclic_indices<p>, \cyclic_indices<p>, fn(a \cyclic_indices<p>) \cyclic_indices<p>))
    release thm struct_member((\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>), &group::Group<\cyclic_indices<p>>)

template<p N+>:
    have cyclic_prime_group &group::Group<\cyclic_indices<p>> = (\cyclic_add<p>, \cyclic_zero<p>, \cyclic_neg<p>)

thm cyclic_indices_are_finite:
    ? forall p N+:
        $is_finite_set(\cyclic_indices<p>)
    \cyclic_indices<p> = closed_range(0, p - 1)
    $is_finite_set(closed_range(0, p - 1))
    $is_finite_set(\cyclic_indices<p>)

thm cyclic_indices_have_prime_size:
    ? forall p N+:
        $is_finite_set(\cyclic_indices<p>)
        =>:
            finite_set_size(\cyclic_indices<p>) = p
    \cyclic_indices<p> = closed_range(0, p - 1)
    p - 1 >= 0
    abs(p - 1) = p - 1
    have last_index N = abs(p - 1)
    last_index = p - 1
    release thm cosets::object_substitution(Z, Z, fn(t Z) Z {t + 1}, last_index, p - 1)
    last_index + 1 = (p - 1) + 1 = p
    finite_set_size(closed_range(0, last_index)) = last_index - 0 + 1 = last_index + 1 = p
    release thm cosets::object_substitution(Z, power_set(Z), fn(t Z) power_set(Z) {closed_range(0, t)}, p - 1, last_index)
    closed_range(0, p - 1) = closed_range(0, last_index)
    finite_set_size(\cyclic_indices<p>) = finite_set_size(closed_range(0, p - 1)) = finite_set_size(closed_range(0, last_index)) = p
