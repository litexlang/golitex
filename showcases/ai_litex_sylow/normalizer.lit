# Normalizers of finite subgroups and the two-sided conjugation interface.

prop normalizes_subgroup(G nonempty_set, group &group::Group<G>, H power_set(G), g G):
    forall h G:
        h $in H
        =>:
            group.mul(group.mul(g, h), group.inv(g)) $in H
    forall h G:
        h $in H
        =>:
            group.mul(group.mul(group.inv(g), h), g) $in H

template<G nonempty_set, group &group::Group<G>>:
    have fn subgroup_normalizer(H power_set(G)) power_set(G) = {g G: $normalizes_subgroup(G, group, H, g)}

thm subgroup_member_normalizer:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), g G:
        $subgroup::is_subgroup(G, group, H)
        g $in H
        =>:
            g $in \subgroup_normalizer<G, group>(H)
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(g, h), group.inv(g)) $in H
        group.mul(g, h) $in H
        group.inv(g) $in H
        group.mul(group.mul(g, h), group.inv(g)) $in H
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(group.inv(g), h), g) $in H
        group.inv(g) $in H
        group.mul(group.inv(g), h) $in H
        group.mul(group.mul(group.inv(g), h), g) $in H
    by def:
        ? $normalizes_subgroup(G, group, H, g)
    release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
    g $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)

thm subgroup_subset_normalizer:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G):
        $subgroup::is_subgroup(G, group, H)
        =>:
            H $subset \subgroup_normalizer<G, group>(H)
    claim:
        ? forall h H:
            h $in \subgroup_normalizer<G, group>(H)
        release thm subgroup_member_normalizer(G, group, H, h)

thm subgroup_normalizer_closed:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G):
        $subgroup::is_subgroup(G, group, H)
        =>:
            $subgroup::is_subgroup(G, group, \subgroup_normalizer<G, group>(H))
    release thm subgroup_member_normalizer(G, group, H, group.one)
    group.one $in \subgroup_normalizer<G, group>(H)
    claim:
        ? forall a, b G:
            a $in \subgroup_normalizer<G, group>(H)
            b $in \subgroup_normalizer<G, group>(H)
            =>:
                group.mul(a, b) $in \subgroup_normalizer<G, group>(H)
        release thm set_builder_member(a, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        release thm set_builder_member(b, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        by def:
            ? $normalizes_subgroup(G, group, H, a)
        by def:
            ? $normalizes_subgroup(G, group, H, b)
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.mul(a, b), h), group.inv(group.mul(a, b))) $in H
            group.mul(group.mul(b, h), group.inv(b)) $in H
            group.mul(group.mul(a, group.mul(group.mul(b, h), group.inv(b))), group.inv(a)) $in H
            release thm group::mul_inv_rev(G, group.mul, group.one, group.inv, a, b)
            group.inv(group.mul(a, b)) = group.mul(group.inv(b), group.inv(a))
            group.mul(group.mul(group.mul(a, b), h), group.inv(group.mul(a, b))) = group.mul(group.mul(group.mul(a, b), h), group.mul(group.inv(b), group.inv(a)))
            group.mul(group.mul(a, b), h) = group.mul(a, group.mul(b, h))
            release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, group.mul(group.inv(b), group.inv(a)))}, group.mul(group.mul(a, b), h), group.mul(a, group.mul(b, h)))
            group.mul(group.mul(group.mul(a, b), h), group.mul(group.inv(b), group.inv(a))) = group.mul(group.mul(a, group.mul(b, h)), group.mul(group.inv(b), group.inv(a)))
            group.mul(group.mul(a, group.mul(b, h)), group.mul(group.inv(b), group.inv(a))) = group.mul(a, group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a))))
            group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a))) = group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a))
            release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(a, t)}, group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a))), group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a)))
            group.mul(a, group.mul(group.mul(b, h), group.mul(group.inv(b), group.inv(a)))) = group.mul(a, group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a)))
            group.mul(a, group.mul(group.mul(group.mul(b, h), group.inv(b)), group.inv(a))) = group.mul(group.mul(a, group.mul(group.mul(b, h), group.inv(b))), group.inv(a))
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.inv(group.mul(a, b)), h), group.mul(a, b)) $in H
            group.mul(group.mul(group.inv(a), h), a) $in H
            group.mul(group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), a)), b) $in H
            release thm group::mul_inv_rev(G, group.mul, group.one, group.inv, a, b)
            group.inv(group.mul(a, b)) = group.mul(group.inv(b), group.inv(a))
            group.mul(group.mul(group.inv(group.mul(a, b)), h), group.mul(a, b)) = group.mul(group.mul(group.mul(group.inv(b), group.inv(a)), h), group.mul(a, b))
            group.mul(group.mul(group.inv(b), group.inv(a)), h) = group.mul(group.inv(b), group.mul(group.inv(a), h))
            release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, group.mul(a, b))}, group.mul(group.mul(group.inv(b), group.inv(a)), h), group.mul(group.inv(b), group.mul(group.inv(a), h)))
            group.mul(group.mul(group.mul(group.inv(b), group.inv(a)), h), group.mul(a, b)) = group.mul(group.mul(group.inv(b), group.mul(group.inv(a), h)), group.mul(a, b))
            group.mul(group.mul(group.inv(b), group.mul(group.inv(a), h)), group.mul(a, b)) = group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), group.mul(a, b)))
            group.mul(group.mul(group.inv(a), h), group.mul(a, b)) = group.mul(group.mul(group.mul(group.inv(a), h), a), b)
            release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(group.inv(b), t)}, group.mul(group.mul(group.inv(a), h), group.mul(a, b)), group.mul(group.mul(group.mul(group.inv(a), h), a), b))
            group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), group.mul(a, b))) = group.mul(group.inv(b), group.mul(group.mul(group.mul(group.inv(a), h), a), b))
            group.mul(group.inv(b), group.mul(group.mul(group.mul(group.inv(a), h), a), b)) = group.mul(group.mul(group.inv(b), group.mul(group.mul(group.inv(a), h), a)), b)
        by def:
            ? $normalizes_subgroup(G, group, H, group.mul(a, b))
        release thm set_builder_member(group.mul(a, b), {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        group.mul(a, b) $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)
    claim:
        ? forall g G:
            g $in \subgroup_normalizer<G, group>(H)
            =>:
                group.inv(g) $in \subgroup_normalizer<G, group>(H)
        release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        by def:
            ? $normalizes_subgroup(G, group, H, g)
        release thm quotient_groups::group_inv_inv(G, group, g)
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.inv(g), h), group.inv(group.inv(g))) $in H
            group.mul(group.mul(group.inv(g), h), g) $in H
            group.inv(group.inv(g)) = g
            group.mul(group.mul(group.inv(g), h), group.inv(group.inv(g))) = group.mul(group.mul(group.inv(g), h), g)
            group.mul(group.mul(group.inv(g), h), group.inv(group.inv(g))) $in H
        claim:
            ? forall h G:
                h $in H
                =>:
                    group.mul(group.mul(group.inv(group.inv(g)), h), group.inv(g)) $in H
            group.mul(group.mul(g, h), group.inv(g)) $in H
            group.inv(group.inv(g)) = g
            group.mul(group.mul(group.inv(group.inv(g)), h), group.inv(g)) = group.mul(group.mul(g, h), group.inv(g))
            group.mul(group.mul(group.inv(group.inv(g)), h), group.inv(g)) $in H
        by def:
            ? $normalizes_subgroup(G, group, H, group.inv(g))
        release thm set_builder_member(group.inv(g), {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        group.inv(g) $in {candidate G: $normalizes_subgroup(G, group, H, candidate)} = \subgroup_normalizer<G, group>(H)
    by def:
        ? $subgroup::is_subgroup(G, group, \subgroup_normalizer<G, group>(H))

thm subgroup_normalizer_finite:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G):
        $is_finite_set(G)
        =>:
            $is_finite_set(\subgroup_normalizer<G, group>(H))
    \subgroup_normalizer<G, group>(H) $subset G
    release thm subset_of_finite_set_is_finite(\subgroup_normalizer<G, group>(H), G)

thm subgroup_normal_in_normalizer:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G):
        $subgroup::is_subgroup(G, group, H)
        =>:
            $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
    release thm subgroup_normalizer_closed(G, group, H)
    release thm subgroup_subset_normalizer(G, group, H)
    release thm subgroup_structure::nested_subgroup_closed(G, group, H, \subgroup_normalizer<G, group>(H))
    $subgroup::is_subgroup(\subgroup_structure::subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)
    claim:
        ? forall g, h \subgroup_structure::subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>:
            h $in H
            =>:
                \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(g, h), \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.inv(g)) $in H
        g $in \subgroup_normalizer<G, group>(H)
        release thm set_builder_member(g, {candidate G: $normalizes_subgroup(G, group, H, candidate)})
        by def:
            ? $normalizes_subgroup(G, group, H, g)
        \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul = \subgroup_structure::subgroup_mul<G, group, \subgroup_normalizer<G, group>(H)>
        \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.inv = \subgroup_structure::subgroup_inv<G, group, \subgroup_normalizer<G, group>(H)>
        \subgroup_structure::subgroup_mul<G, group, \subgroup_normalizer<G, group>(H)>(g, h) = group.mul(g, h)
        \subgroup_structure::subgroup_inv<G, group, \subgroup_normalizer<G, group>(H)>(g) = group.inv(g)
        \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(\subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.mul(g, h), \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>.inv(g)) = group.mul(group.mul(g, h), group.inv(g))
        group.mul(group.mul(g, h), group.inv(g)) $in H
    by def:
        ? $normal_subgroup::is_normal_subgroup(\subgroup_structure::subgroup_carrier<G, group, \subgroup_normalizer<G, group>(H)>, \subgroup_structure::subgroup_group<G, group, \subgroup_normalizer<G, group>(H)>, H)

prop conjugates_back_into_subgroup(G nonempty_set, group &group::Group<G>, H power_set(G), g G):
    forall h G:
        h $in H
        =>:
            group.mul(group.mul(group.inv(g), h), g) $in H

template<G nonempty_set, group &group::Group<G>, H power_set(G), g G: $subgroup::is_subgroup(G, group, H), $conjugates_back_into_subgroup(G, group, H, g)>:
    have fn subgroup_conjugate_back(h H) H = group.mul(group.mul(group.inv(g), h), g)

thm group_right_cancel_explicit:
    ? forall G nonempty_set, group &group::Group<G>, a, b, c G:
        group.mul(a, c) = group.mul(b, c)
        =>:
            a = b
    release thm group::mul_inv_cancel(G, group.mul, group.one, group.inv, c)
    group.mul(c, group.inv(c)) = group.one
    release thm group::mul_one(G, group.mul, group.one, group.inv, a)
    release thm group::mul_one(G, group.mul, group.one, group.inv, b)
    group.mul(group.mul(a, c), group.inv(c)) = group.mul(group.mul(b, c), group.inv(c))
    group.mul(group.mul(a, c), group.inv(c)) = group.mul(a, group.mul(c, group.inv(c))) = group.mul(a, group.one) = a
    group.mul(group.mul(b, c), group.inv(c)) = group.mul(b, group.mul(c, group.inv(c))) = group.mul(b, group.one) = b
    a = b

thm finite_subset_contains_ambient_member:
    ? forall A, B set, x B:
        $is_finite_set(A)
        $is_finite_set(B)
        A $subset B
        finite_set_size(A) = finite_set_size(B)
        =>:
            x $in A
    claim:
        ? intersect(B, A) = A
        by extension:
            ? intersect(B, A) = A
            claim:
                ? forall intersection_x intersect(B, A):
                    intersection_x $in A
                intersection_x $in A
            claim:
                ? forall ambient_x A:
                    ambient_x $in intersect(B, A)
                ambient_x $in B
                ambient_x $in A
    $is_finite_set(set_minus(B, A))
    finite_set_size(set_minus(B, A)) = finite_set_size(B) - finite_set_size(intersect(B, A)) = finite_set_size(B) - finite_set_size(A) = 0
    by contra:
        ? x $in A
        not x $in A
        x $in B
        x $in set_minus(B, A)
        witness $is_nonempty_set(set_minus(B, A)) from x
        finite_set_size(set_minus(B, A)) >= 1
        impossible finite_set_size(set_minus(B, A)) = 0

thm subgroup_conjugate_back_injective:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), g G:
        $subgroup::is_subgroup(G, group, H)
        $conjugates_back_into_subgroup(G, group, H, g)
        =>:
            $injective(H, H, \subgroup_conjugate_back<G, group, H, g>)
    claim:
        ? forall x, y H:
            \subgroup_conjugate_back<G, group, H, g>(x) = \subgroup_conjugate_back<G, group, H, g>(y)
            =>:
                x = y
        \subgroup_conjugate_back<G, group, H, g>(x) = group.mul(group.mul(group.inv(g), x), g)
        \subgroup_conjugate_back<G, group, H, g>(y) = group.mul(group.mul(group.inv(g), y), g)
        group.mul(group.mul(group.inv(g), x), g) = group.mul(group.mul(group.inv(g), y), g)
        release thm group_right_cancel_explicit(G, group, group.mul(group.inv(g), x), group.mul(group.inv(g), y), g)
        group.mul(group.inv(g), x) = group.mul(group.inv(g), y)
        release thm group::_group_left_cancel(G, group.mul, group.one, group.inv, group.inv(g), x, y)
        x = y
    by def:
        ? $injective(H, H, \subgroup_conjugate_back<G, group, H, g>)

thm finite_one_sided_normalizer_promotes:
    ? forall G nonempty_set, group &group::Group<G>, H power_set(G), g G:
        $subgroup::is_subgroup(G, group, H)
        $is_finite_set(H)
        $conjugates_back_into_subgroup(G, group, H, g)
        =>:
            $normalizes_subgroup(G, group, H, g)
    release thm subgroup_conjugate_back_injective(G, group, H, g)
    $is_finite_set(fn_range(\subgroup_conjugate_back<G, group, H, g>))
    release thm cauchy_restriction::finite_injection_range_cardinality(H, H, \subgroup_conjugate_back<G, group, H, g>)
    finite_set_size(fn_range(\subgroup_conjugate_back<G, group, H, g>)) = finite_set_size(H)
    fn_range(\subgroup_conjugate_back<G, group, H, g>) $subset H
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(g, h), group.inv(g)) $in H
        release thm finite_subset_contains_ambient_member(fn_range(\subgroup_conjugate_back<G, group, H, g>), H, h)
        h $in fn_range(\subgroup_conjugate_back<G, group, H, g>)
        have by preimage k from h $in fn_range(\subgroup_conjugate_back<G, group, H, g>)
        k $in H
        \subgroup_conjugate_back<G, group, H, g>(k) = h
        \subgroup_conjugate_back<G, group, H, g>(k) = group.mul(group.mul(group.inv(g), k), g)
        h = group.mul(group.mul(group.inv(g), k), g)
        release thm group::mul_inv_cancel(G, group.mul, group.one, group.inv, g)
        group.mul(g, group.inv(g)) = group.one
        group.mul(g, h) = group.mul(g, group.mul(group.mul(group.inv(g), k), g))
        group.mul(g, group.mul(group.mul(group.inv(g), k), g)) = group.mul(group.mul(g, group.mul(group.inv(g), k)), g)
        group.mul(g, group.mul(group.inv(g), k)) = group.mul(group.mul(g, group.inv(g)), k)
        group.mul(group.mul(g, group.inv(g)), k) = group.mul(group.one, k) = k
        group.mul(g, group.mul(group.inv(g), k)) = k
        release thm cosets::object_substitution(G, G, fn(t G) G {group.mul(t, g)}, group.mul(g, group.mul(group.inv(g), k)), k)
        group.mul(group.mul(g, group.mul(group.inv(g), k)), g) = group.mul(k, g)
        group.mul(g, h) = group.mul(group.mul(g, group.mul(group.inv(g), k)), g) = group.mul(k, g)
        group.mul(group.mul(g, h), group.inv(g)) = group.mul(group.mul(k, g), group.inv(g))
        group.mul(group.mul(k, g), group.inv(g)) = group.mul(k, group.mul(g, group.inv(g)))
        release thm group::mul_one(G, group.mul, group.one, group.inv, k)
        group.mul(k, group.mul(g, group.inv(g))) = group.mul(k, group.one) = k
        group.mul(group.mul(g, h), group.inv(g)) = k
        group.mul(group.mul(g, h), group.inv(g)) $in H
    claim:
        ? forall h G:
            h $in H
            =>:
                group.mul(group.mul(group.inv(g), h), g) $in H
        by def:
            ? $conjugates_back_into_subgroup(G, group, H, g)
    by def:
        ? $normalizes_subgroup(G, group, H, g)
