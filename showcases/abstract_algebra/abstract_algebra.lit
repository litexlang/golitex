# Abstract Algebra: From Integer Addition to Kernels
# These lectures follow one question: what remains true when ordinary
# arithmetic is replaced by an operation satisfying a few structural laws?
# Chapter 1. Groups and subgroups
# 1.1 Integer addition supplies our first example.
have fn integer_add(x, y Z) Z = x + y

have fn integer_neg(x Z) Z = -x

integer_add(3, -3) = 0

integer_add(integer_add(2, 3), 4) = integer_add(2, integer_add(3, 4))

# A group has an associative operation, an identity and inverses.
# We use multiplicative names even when the concrete operation is addition.
# Commutativity is deliberately not a group axiom.
struct Group<A nonempty_set>:
    mul fn(x, y A) A
    one A
    inv fn(x A) A
    <=>:
        forall x, y, z A:
            mul(mul(x, y), z) = mul(x, mul(y, z))
        forall x A:
            mul(one, x) = x
            mul(x, one) = x
            mul(inv(x), x) = one
            mul(x, inv(x)) = one

forall x, y, z Z:
    integer_add(integer_add(x, y), z) = integer_add(x, integer_add(y, z))

forall x Z:
    integer_add(0, x) = x
    integer_add(x, 0) = x
    integer_add(integer_neg(x), x) = 0
    integer_add(x, integer_neg(x)) = 0

release thm struct_member((integer_add, 0, integer_neg), &Group<Z>)

have integers &Group<Z> = (integer_add, 0, integer_neg)

prop is_abelian(A nonempty_set, G &Group<A>):
    forall x, y A:
        G.mul(x, y) = G.mul(y, x)

integers.mul = integer_add

integers.one = 0

integers.inv = integer_neg

claim:
    ? $is_abelian(Z, integers)
    claim:
        ? forall x, y Z:
            integers.mul(x, y) = integers.mul(y, x)
        integers.mul(x, y) = integer_add(x, y) = x + y = y + x = integer_add(y, x) = integers.mul(y, x)
    by def $is_abelian(Z, integers)

# 1.2 What the axioms force
# If identity_candidate acts as a left identity, apply its law to the designated identity.
thm identity_unique:
    ? forall A nonempty_set, G &Group<A>, identity_candidate A:
        forall x A:
            G.mul(identity_candidate, x) = x
        =>:
            identity_candidate = G.one
    identity_candidate = G.mul(identity_candidate, G.one) = G.one

# A left inverse must equal the designated inverse. Associativity lets
# us insert a * a^{-1} and regroup without changing the order of factors.
thm inverse_unique:
    ? forall A nonempty_set, G &Group<A>, a, b A:
        G.mul(b, a) = G.one
        =>:
            b = G.inv(a)
    G.mul(a, G.inv(a)) = G.one
    b = G.mul(b, G.one) = G.mul(b, G.mul(a, G.inv(a))) = G.mul(G.mul(b, a), G.inv(a)) = G.mul(G.one, G.inv(a)) = G.inv(a)

thm left_cancel:
    ? forall A nonempty_set, G &Group<A>, a, b, c A:
        G.mul(a, b) = G.mul(a, c)
        =>:
            b = c
    G.mul(G.inv(a), a) = G.one
    b = G.mul(G.one, b) = G.mul(G.mul(G.inv(a), a), b) = G.mul(G.inv(a), G.mul(a, b)) = G.mul(G.inv(a), G.mul(a, c)) = G.mul(G.mul(G.inv(a), a), c) = G.mul(G.one, c) = c

thm right_cancel:
    ? forall A nonempty_set, G &Group<A>, a, b, c A:
        G.mul(b, a) = G.mul(c, a)
        =>:
            b = c
    G.mul(a, G.inv(a)) = G.one
    b = G.mul(b, G.one) = G.mul(b, G.mul(a, G.inv(a))) = G.mul(G.mul(b, a), G.inv(a)) = G.mul(G.mul(c, a), G.inv(a)) = G.mul(c, G.mul(a, G.inv(a))) = G.mul(c, G.one) = c

# Cancellation turns a candidate solution into a unique solution.
thm left_equation_unique:
    ? forall A nonempty_set, G &Group<A>, a, b A:
        exist! x A st {G.mul(a, x) = b}
    G.mul(a, G.inv(a)) = G.one
    G.mul(a, G.mul(G.inv(a), b)) = G.mul(G.mul(a, G.inv(a)), b) = G.mul(G.one, b) = b
    claim:
        ? forall x, y A:
            G.mul(a, x) = b
            G.mul(a, y) = b
            =>:
                x = y
        by thm left_cancel(A, G, a, x, y) => x = y
    witness exist! x A st {G.mul(a, x) = b} from G.mul(G.inv(a), b)

# 1.3 Subgroups retain the ambient operation.
prop is_subgroup(A nonempty_set, G &Group<A>, S power_set(A)):
    G.one $in S
    forall x, y S:
        G.mul(x, y) $in S
    forall x S:
        G.inv(x) $in S

# Multiples of an integer form a subset, including when that integer is zero.
# The witness relation describes membership; multiples(m) is the set itself.
prop is_multiple(m, x Z):
    exist k Z st {x = m * k}

have fn multiples(m Z) power_set(Z) = {x Z: $is_multiple(m, x)}

claim:
    ? 6 $in multiples(3)
    witness $is_multiple(3, 6) from 2
    by thm set_builder_member(6, {x Z: $is_multiple(3, x)}) => 6 $in {x Z: $is_multiple(3, x)}

thm multiples_are_subgroup:
    ? forall m Z:
        $is_subgroup(Z, integers, multiples(m))
    multiples(m) = {x Z: $is_multiple(m, x)}
    multiples(m) $subset Z
    witness $is_multiple(m, 0) from 0
    release thm set_builder_member(0, {x Z: $is_multiple(m, x)})
    claim:
        ? forall x, y multiples(m):
            integers.mul(x, y) $in multiples(m)
        obtain k from $is_multiple(m, x)
        obtain l from $is_multiple(m, y)
        integers.mul(x, y) = integer_add(x, y) = x + y = m * k + m * l = m * (k + l)
        witness $is_multiple(m, integers.mul(x, y)) from k + l
        release thm set_builder_member(integers.mul(x, y), {z Z: $is_multiple(m, z)})
    claim:
        ? forall x multiples(m):
            integers.inv(x) $in multiples(m)
        obtain k from $is_multiple(m, x)
        integers.inv(x) = integer_neg(x) = -x = -(m * k) = m * (-k)
        witness $is_multiple(m, integers.inv(x)) from -k
        release thm set_builder_member(integers.inv(x), {z Z: $is_multiple(m, z)})
    by def $is_subgroup(Z, integers, multiples(m))

# Nonnegative integers contain zero and are closed under addition, but
# they do not contain the additive inverse of 1.
N $subset Z

claim:
    ? not $is_subgroup(Z, integers, N)
    by contra:
        ? not $is_subgroup(Z, integers, N)
        integers.inv(1) = integer_neg(1) = -1
        impossible -1 $in N

# Intersections preserve the three subgroup conditions.
thm subgroup_intersection:
    ? forall A nonempty_set, G &Group<A>, S, T power_set(A):
        $is_subgroup(A, G, S)
        $is_subgroup(A, G, T)
        =>:
            $is_subgroup(A, G, intersect(S, T))
    claim:
        ? forall x, y intersect(S, T):
            G.mul(x, y) $in intersect(S, T)
        G.mul(x, y) $in S
        G.mul(x, y) $in T
    claim:
        ? forall x intersect(S, T):
            G.inv(x) $in intersect(S, T)
        G.inv(x) $in S
        G.inv(x) $in T
    by def $is_subgroup(A, G, intersect(S, T))

# Chapter 2. Maps that preserve structure
# 2.1 A homomorphism preserves the group operation. Nothing else is assumed.
prop is_homomorphism(A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B):
    forall x, y A:
        f(G.mul(x, y)) = H.mul(f(x), f(y))

# Since f(1) = f(1)f(1), cancellation forces f(1) to be the identity.
thm homomorphism_identity:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        =>:
            f(G.one) = H.one
    G.mul(G.one, G.one) = G.one
    H.mul(f(G.one), f(G.one)) = f(G.mul(G.one, G.one)) = f(G.one) = H.mul(f(G.one), H.one)
    by thm left_cancel(B, H, f(G.one), f(G.one), H.one) => f(G.one) = H.one

# The image of an inverse is an inverse of the image. Uniqueness identifies it.
thm homomorphism_inverse:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B, x A:
        $is_homomorphism(A, G, B, H, f)
        =>:
            f(G.inv(x)) = H.inv(f(x))
    by thm homomorphism_identity(A, G, B, H, f) => f(G.one) = H.one
    G.mul(G.inv(x), x) = G.one
    H.mul(f(G.inv(x)), f(x)) = f(G.mul(G.inv(x), x)) = f(G.one) = H.one
    by thm inverse_unique(B, H, f(x), f(G.inv(x))) => f(G.inv(x)) = H.inv(f(x))

# Integer multiplication by two preserves addition.
have fn double(x Z) Z = 2 * x

claim:
    ? $is_homomorphism(Z, integers, Z, integers, double)
    claim:
        ? forall x, y Z:
            double(integers.mul(x, y)) = integers.mul(double(x), double(y))
        integers.mul(x, y) = integer_add(x, y) = x + y
        double(integers.mul(x, y)) = 2 * integers.mul(x, y) = 2 * (x + y)
        double(x) = 2 * x
        double(y) = 2 * y
        integers.mul(double(x), double(y)) = integer_add(double(x), double(y)) = double(x) + double(y) = 2 * x + 2 * y = 2 * (x + y)
    by def $is_homomorphism(Z, integers, Z, integers, double)

# Translation by one fails: it sends the identity to 1 rather than 0.
have fn shift(x Z) Z = x + 1

claim:
    ? not $is_homomorphism(Z, integers, Z, integers, shift)
    by contra:
        ? not $is_homomorphism(Z, integers, Z, integers, shift)
        by thm homomorphism_identity(Z, integers, Z, integers, shift) => shift(integers.one) = integers.one
        shift(integers.one) = shift(0) = 1
        impossible 1 = 0

# 2.2 The kernel collects elements sent to the target identity.
template<A nonempty_set, B nonempty_set, H &Group<B>, f fn(x A) B>:
    have kernel power_set(A) = {x A: f(x) = H.one}

prop is_normal_subgroup(A nonempty_set, G &Group<A>, S power_set(A)):
    $is_subgroup(A, G, S)
    forall a A, s S:
        G.mul(G.mul(a, s), G.inv(a)) $in S

# In an abelian group conjugation leaves each element unchanged.
thm abelian_subgroups_are_normal:
    ? forall A nonempty_set, G &Group<A>, S power_set(A):
        $is_abelian(A, G)
        $is_subgroup(A, G, S)
        =>:
            $is_normal_subgroup(A, G, S)
    claim:
        ? forall a A, s S:
            G.mul(G.mul(a, s), G.inv(a)) $in S
        G.mul(a, G.inv(a)) = G.one
        G.mul(a, s) = G.mul(s, a)
        G.mul(G.mul(a, s), G.inv(a)) = G.mul(G.mul(s, a), G.inv(a)) = G.mul(s, G.mul(a, G.inv(a))) = G.mul(s, G.one) = s
    by def $is_normal_subgroup(A, G, S)

# Kernels are normal even when the ambient group is not abelian.
# First use preservation of identity and inverses to prove subgroup closure.
thm kernel_is_normal:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        =>:
            $is_normal_subgroup(A, G, \kernel<A, B, H, f>)
    \kernel<A, B, H, f> = {x A: f(x) = H.one}
    \kernel<A, B, H, f> $subset A
    by thm homomorphism_identity(A, G, B, H, f) => f(G.one) = H.one
    release thm set_builder_member(G.one, {x A: f(x) = H.one})
    claim:
        ? forall x, y \kernel<A, B, H, f>:
            G.mul(x, y) $in \kernel<A, B, H, f>
        f(G.mul(x, y)) = H.mul(f(x), f(y)) = H.mul(H.one, H.one) = H.one
        release thm set_builder_member(G.mul(x, y), {z A: f(z) = H.one})
    claim:
        ? forall x \kernel<A, B, H, f>:
            G.inv(x) $in \kernel<A, B, H, f>
        by thm inverse_unique(B, H, H.one, H.one) => H.one = H.inv(H.one)
        by thm homomorphism_inverse(A, G, B, H, f, x) => f(G.inv(x)) = H.inv(f(x))
        f(G.inv(x)) = H.inv(f(x)) = H.inv(H.one) = H.one
        release thm set_builder_member(G.inv(x), {z A: f(z) = H.one})
    by def $is_subgroup(A, G, \kernel<A, B, H, f>)
    claim:
        ? forall a A, s \kernel<A, B, H, f>:
            G.mul(G.mul(a, s), G.inv(a)) $in \kernel<A, B, H, f>
        f(G.mul(a, s)) = H.mul(f(a), f(s)) = H.mul(f(a), H.one) = f(a)
        f(G.mul(a, s)) = f(a)
        by thm homomorphism_inverse(A, G, B, H, f, a) => f(G.inv(a)) = H.inv(f(a))
        f(G.mul(G.mul(a, s), G.inv(a))) = H.mul(f(G.mul(a, s)), f(G.inv(a))) = H.mul(f(a), f(G.inv(a))) = H.mul(f(a), H.inv(f(a))) = H.one
        release thm set_builder_member(G.mul(G.mul(a, s), G.inv(a)), {z A: f(z) = H.one})
    by def $is_normal_subgroup(A, G, \kernel<A, B, H, f>)

# 2.3 A trivial kernel is exactly the obstruction-free case for injectivity.
# If f(x)=f(y), then y^{-1}x lies in the kernel. A trivial kernel makes
# y^{-1}x=1, and cancellation gives x=y.
prop has_trivial_kernel(A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B):
    forall x A:
        f(x) = H.one
        =>:
            x = G.one

thm trivial_kernel_implies_injective:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        $has_trivial_kernel(A, G, B, H, f)
        =>:
            $injective(A, B, f)
    claim:
        ? forall x, y A:
            f(x) = f(y)
            =>:
                x = y
        by thm homomorphism_inverse(A, G, B, H, f, y) => f(G.inv(y)) = H.inv(f(y))
        f(G.mul(G.inv(y), x)) = H.mul(f(G.inv(y)), f(x)) = H.mul(H.inv(f(y)), f(x)) = H.mul(H.inv(f(y)), f(y)) = H.one
        G.mul(G.inv(y), x) = G.one
        G.mul(G.inv(y), y) = G.one
        by thm left_cancel(A, G, G.inv(y), x, y) => x = y
    by def $injective(A, B, f)

thm injective_implies_trivial_kernel:
    ? forall A nonempty_set, G &Group<A>, B nonempty_set, H &Group<B>, f fn(x A) B:
        $is_homomorphism(A, G, B, H, f)
        $injective(A, B, f)
        =>:
            $has_trivial_kernel(A, G, B, H, f)
    by thm homomorphism_identity(A, G, B, H, f) => f(G.one) = H.one
    by def $has_trivial_kernel(A, G, B, H, f)

# The doubling map loses no information.
claim:
    ? $has_trivial_kernel(Z, integers, Z, integers, double)
    claim:
        ? forall x Z:
            double(x) = integers.one
            =>:
                x = integers.one
        2 * x = double(x) = integers.one = 0
        x = 0 / 2 = 0
    by def $has_trivial_kernel(Z, integers, Z, integers, double)

by thm trivial_kernel_implies_injective(Z, integers, Z, integers, double) => $injective(Z, Z, double)

by extension:
    ? \kernel<Z, Z, integers, double> = {0}
    \kernel<Z, Z, integers, double> = {z Z: double(z) = integers.one}
    claim:
        ? forall x \kernel<Z, Z, integers, double>:
            x $in {0}
        x $in Z
        double(x) = integers.one
        x = integers.one = 0
    claim:
        ? forall x {0}:
            x $in \kernel<Z, Z, integers, double>
        x = 0
        double(x) = double(0) = 0 = integers.one
        release thm set_builder_member(x, {z Z: double(z) = integers.one})

# By contrast, the zero homomorphism forgets every integer.
have fn zero_map(x Z) Z = 0

claim:
    ? $is_homomorphism(Z, integers, Z, integers, zero_map)
    claim:
        ? forall x, y Z:
            zero_map(integers.mul(x, y)) = integers.mul(zero_map(x), zero_map(y))
        zero_map(x) = 0
        zero_map(y) = 0
        integers.mul(zero_map(x), zero_map(y)) = integer_add(0, 0) = 0
    by def $is_homomorphism(Z, integers, Z, integers, zero_map)

by extension:
    ? \kernel<Z, Z, integers, zero_map> = Z
    \kernel<Z, Z, integers, zero_map> = {x Z: zero_map(x) = integers.one}
    claim:
        ? forall x Z:
            x $in \kernel<Z, Z, integers, zero_map>
        zero_map(x) = 0 = integers.one
        release thm set_builder_member(x, {z Z: zero_map(z) = integers.one})

claim:
    ? not $injective(Z, Z, zero_map)
    by contra:
        ? not $injective(Z, Z, zero_map)
        zero_map(0) = zero_map(1)
        impossible 0 = 1

# Both kernels are normal subgroups, despite their different sizes.
by thm kernel_is_normal(Z, integers, Z, integers, double) => $is_normal_subgroup(Z, integers, \kernel<Z, Z, integers, double>)

by thm kernel_is_normal(Z, integers, Z, integers, zero_map) => $is_normal_subgroup(Z, integers, \kernel<Z, Z, integers, zero_map>)
