# Draft: excluded with its required main module until both verify again.
# Linear algebra through struct-backed settings.
#
# The `main` export owns the mathematical structures, propositions,
# constructions, proofs, and concrete values. This export demonstrates the
# complementary role of `setting`: it names recurring contexts of those
# declaration-typed values without flattening their fields or repeating laws.

setting FieldSetting(K nonempty_set, field &main::Field<K>)

setting VectorSpaceSetting([FieldSetting(K, field)], V nonempty_set, space &main::VectorSpace<K, field, V>)

setting VectorSpacesSetting([FieldSetting(K, field)], V, W nonempty_set, source &main::VectorSpace<K, field, V>, target &main::VectorSpace<K, field, W>)

setting LinearMapSetting([VectorSpacesSetting], T fn(v V) W):
    $main::is_linear_map(K, field, V, W, source, target, T)

# A one-space Setting exposes the declaration-owned fields of `space` and the
# declaration-owned scalar operations of `field`.
thm setting_scalar_times_zero_vector:
    ? forall [VectorSpaceSetting], a K:
        space.smul(a, space.zero) = space.zero
    by thm main::scalar_times_zero_vector(K, field, V, space, a) => space.smul(a, space.zero) = space.zero

# Tracer: the Setting supplies one shared field, two struct-backed spaces, and
# the linearity assumption. No raw add_V/smul_V binders are reintroduced.
thm setting_linear_map_sends_zero_to_zero:
    ? forall [LinearMapSetting]:
        T(source.zero) = target.zero
    by thm main::linear_map_sends_zero_to_zero(K, field, V, W, source, target, T) => T(source.zero) = target.zero

thm setting_linear_map_kernel_is_subspace:
    ? forall [LinearMapSetting]:
        $main::is_subspace(K, field, V, source, \main::linear_kernel<V, W, target.zero, T>)
    by thm main::linear_map_kernel_is_subspace(K, field, V, W, source, target, T) => $main::is_subspace(K, field, V, source, \main::linear_kernel<V, W, target.zero, T>)

# The concrete values constructed in `main` instantiate the same Setting
# facade; no second real field, plane, or projection proof is constructed.
thm real_projection_uses_setting:
    ? forall:
        main::projection_x_axis(main::real_plane.zero) = main::real_plane.zero
        $main::is_subspace(R, main::real_field, cart(R, R), main::real_plane, \main::linear_kernel<cart(R, R), cart(R, R), main::real_plane.zero, main::projection_x_axis>)
    by thm main::projection_x_axis_is_linear() => $main::is_linear_map(R, main::real_field, cart(R, R), cart(R, R), main::real_plane, main::real_plane, main::projection_x_axis)
    by thm setting_linear_map_sends_zero_to_zero(R, main::real_field, cart(R, R), cart(R, R), main::real_plane, main::real_plane, main::projection_x_axis) => main::projection_x_axis(main::real_plane.zero) = main::real_plane.zero
    by thm setting_linear_map_kernel_is_subspace(R, main::real_field, cart(R, R), cart(R, R), main::real_plane, main::real_plane, main::projection_x_axis) => $main::is_subspace(R, main::real_field, cart(R, R), main::real_plane, \main::linear_kernel<cart(R, R), cart(R, R), main::real_plane.zero, main::projection_x_axis>)
