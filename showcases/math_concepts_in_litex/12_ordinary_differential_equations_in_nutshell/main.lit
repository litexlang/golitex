# Ordinary differential equations in Litex, setting-first.
#
# Included: epsilon-delta derivatives, the equation y' = 2x, its quadratic
# solution family, uniqueness of derivative values, and a derivative selector.
#
# Main line: derivative interface -> ODE solution interface -> y' = 2x.

prop derivative_delta_controlled(f fn(x R) R, x0, slope R, epsilon, delta R+):
    forall x R:
        x != x0
        abs(x - x0) < delta
        =>:
            abs((f(x) - f(x0)) / (x - x0) - slope) < epsilon

prop has_derivative_at(f fn(x R) R, x0, slope R):
    forall epsilon R+:
        exist delta R+ st {$derivative_delta_controlled(f, x0, slope, epsilon, delta)}

have fn ode_rhs(x, y R) R = 2 * x
have fn quadratic_solution(c, x R) R = x^2 + c
have fn ode_solution(x R) R = x^2 + 1

prop solves_ode_at(f fn(t R) R, rhs fn(t, y R) R, x R):
    exist slope R st {$has_derivative_at(f, x, slope), slope = rhs(x, f(x))}

# Evaluating the quadratic family at zero identifies its integration constant.
thm quadratic_initial_value_selects_parameter:
    ? forall c, y0 R:
        quadratic_solution(c, 0) = y0
        =>:
            c = y0
    quadratic_solution(c, 0) = 0^2 + c = c

# Factor the quadratic difference quotient and choose delta = epsilon to prove
# that x^2 + 1 has derivative 2*x0.
thm ode_solution_has_derivative:
    ? forall x0 R:
        $has_derivative_at(ode_solution, x0, 2 * x0)
    claim:
        ? forall epsilon R+:
            exist delta R+ st {$derivative_delta_controlled(ode_solution, x0, 2 * x0, epsilon, delta)}
        witness exist delta R+ st {$derivative_delta_controlled(ode_solution, x0, 2 * x0, epsilon, delta)} from epsilon:
            claim:
                ? forall x R:
                    x != x0
                    abs(x - x0) < epsilon
                    =>:
                        abs((ode_solution(x) - ode_solution(x0)) / (x - x0) - 2 * x0) < epsilon
                x - x0 != 0
                ode_solution(x) = x^2 + 1
                ode_solution(x0) = x0^2 + 1
                ode_solution(x) - ode_solution(x0) = (x^2 + 1) - (x0^2 + 1) = x^2 - x0^2 = (x - x0) * (x + x0)
                (ode_solution(x) - ode_solution(x0)) / (x - x0) = x + x0
                (ode_solution(x) - ode_solution(x0)) / (x - x0) - 2 * x0 = x - x0
                abs((ode_solution(x) - ode_solution(x0)) / (x - x0) - 2 * x0) = abs(x - x0) < epsilon
            by def $derivative_delta_controlled(ode_solution, x0, 2 * x0, epsilon, delta)
    by def $has_derivative_at(ode_solution, x0, 2 * x0)

# Use the derivative witness 2*x to show the chosen quadratic solves y' = 2x.
thm ode_solution_solves_equation:
    ? forall x R:
        $solves_ode_at(ode_solution, ode_rhs, x)
    witness $solves_ode_at(ode_solution, ode_rhs, x) from 2 * x:
        by thm ode_solution_has_derivative(x) => $has_derivative_at(ode_solution, x, 2 * x)
        ode_rhs(x, ode_solution(x)) = 2 * x

ode_solution(0) = 1
quadratic_solution(1, 0) = 1

# `has_derivative_at` remains the epsilon-delta relation used in proofs.
# Differentiability supplies existence; uniqueness then exposes its value.
prop is_differentiable_at(f fn(x R) R, x0 R):
    exist slope R st {$has_derivative_at(f, x0, slope)}

# Two derivative candidates are forced together by evaluating both estimates
# at one carefully chosen nearby point.
thm derivative_value_unique:
    ? forall f fn(t R) R, x0, slope1, slope2 R:
        $has_derivative_at(f, x0, slope1)
        $has_derivative_at(f, x0, slope2)
        =>:
            slope1 = slope2
    by contra:
        ? slope1 = slope2
        slope1 != slope2
        slope1 - slope2 != 0
        abs(slope1 - slope2) > 0
        have epsilon R+ = abs(slope1 - slope2) / 3
        obtain delta1 from exist delta1 R+ st {$derivative_delta_controlled(f, x0, slope1, epsilon, delta1)}
        obtain delta2 from exist delta2 R+ st {$derivative_delta_controlled(f, x0, slope2, epsilon, delta2)}
        have radius R+ = finite_set_min(union({delta1}, {delta2}))
        have sample R = x0 + radius / 2
        sample = x0 + radius / 2 > x0
        sample != x0
        sample - x0 = radius / 2
        sample - x0 > 0
        abs(sample - x0) = sample - x0 = radius / 2
        abs(sample - x0) = radius / 2 < radius <= delta1
        abs(sample - x0) = radius / 2 < radius <= delta2
        have difference_quotient R = (f(sample) - f(x0)) / (sample - x0)
        abs((f(sample) - f(x0)) / (sample - x0) - slope1) < epsilon
        abs(difference_quotient - slope1) = abs((f(sample) - f(x0)) / (sample - x0) - slope1) < epsilon
        abs((f(sample) - f(x0)) / (sample - x0) - slope2) < epsilon
        abs(difference_quotient - slope2) = abs((f(sample) - f(x0)) / (sample - x0) - slope2) < epsilon
        abs(slope1 - difference_quotient) = abs(difference_quotient - slope1)
        slope1 - slope2 = (slope1 - difference_quotient) + (difference_quotient - slope2)
        abs(slope1 - slope2) = abs((slope1 - difference_quotient) + (difference_quotient - slope2)) <= abs(slope1 - difference_quotient) + abs(difference_quotient - slope2)
        abs(slope1 - difference_quotient) + abs(difference_quotient - slope2) < epsilon + epsilon = 2 * epsilon
        2 / 3 < 1
        (2 / 3) * abs(slope1 - slope2) < 1 * abs(slope1 - slope2)
        2 * epsilon = 2 * (abs(slope1 - slope2) / 3)
        2 * (abs(slope1 - slope2) / 3) = 2 * abs(slope1 - slope2) / 3 = (2 / 3) * abs(slope1 - slope2)
        1 * abs(slope1 - slope2) = abs(slope1 - slope2)
        2 * epsilon < abs(slope1 - slope2)
        abs(slope1 - slope2) <= abs(slope1 - difference_quotient) + abs(difference_quotient - slope2) < 2 * epsilon < abs(slope1 - slope2)
        impossible abs(slope1 - slope2) < abs(slope1 - slope2)

# Existence from differentiability and the uniqueness theorem define a callable
# derivative value on differentiable function-point pairs.
claim:
    ? forall f fn(t R) R, x0 R:
        $is_differentiable_at(f, x0)
        =>:
            exist! slope R st {$has_derivative_at(f, x0, slope)}
    obtain chosen_slope from $is_differentiable_at(f, x0)
    claim:
        ? forall slope1, slope2 R:
            $has_derivative_at(f, x0, slope1)
            $has_derivative_at(f, x0, slope2)
            =>:
                slope1 = slope2
        release thm derivative_value_unique(f, x0, slope1, slope2)
    exist! slope R st {$has_derivative_at(f, x0, slope)}

have fn derivative_at by exist!:
    ? forall f fn(t R) R, x0 R:
        $is_differentiable_at(f, x0)
        =>:
            exist! slope R st {$has_derivative_at(f, x0, slope)}

# Bridge the relational derivative predicate to the uniquely selected value.
thm has_derivative_at_to_derivative_value:
    ? forall f fn(t R) R, x0, slope R:
        $has_derivative_at(f, x0, slope)
        =>:
            $is_differentiable_at(f, x0)
            derivative_at(f, x0) = slope
    witness $is_differentiable_at(f, x0) from slope:
        $has_derivative_at(f, x0, slope)
    slope = derivative_at(f, x0)
    derivative_at(f, x0) = slope

prop solves_ode_at_by_derivative(f fn(t R) R, rhs fn(t, y R) R, x R):
    $is_differentiable_at(f, x)
    derivative_at(f, x) = rhs(x, f(x))

thm ode_solution_derivative_value:
    ? forall x R:
        $is_differentiable_at(ode_solution, x)
        derivative_at(ode_solution, x) = 2 * x
    by thm ode_solution_has_derivative(x) => $has_derivative_at(ode_solution, x, 2 * x)
    release thm has_derivative_at_to_derivative_value(ode_solution, x, 2 * x)

# Restate the ODE using the callable derivative interface rather than an
# existential slope witness.
thm ode_solution_solves_equation_by_derivative:
    ? forall x R:
        $solves_ode_at_by_derivative(ode_solution, ode_rhs, x)
    release thm ode_solution_derivative_value(x)
    ode_rhs(x, ode_solution(x)) = 2 * x
    derivative_at(ode_solution, x) = ode_rhs(x, ode_solution(x))
    by def $solves_ode_at_by_derivative(ode_solution, ode_rhs, x)
