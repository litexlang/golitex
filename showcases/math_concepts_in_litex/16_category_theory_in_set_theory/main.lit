# Small categories, functors, and natural transformations, setting-first.
#
# Obj is a set-sized collection of opaque category objects. Mor bounds the
# arrow encodings, while Hom(source, target) is the precise set of arrows with
# those endpoints. Dependent function carriers enforce identity, composition,
# functor-arrow, and component typing.

# A candidate ambient arrow is a morphism source -> target exactly when it
# belongs to Hom(source, target).
prop is_morphism(Obj, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), source, target Obj, f Mor):
    f $in Hom(source, target)

# compose(source, middle, target, f, g) means g after f. An endomorphism is an
# identity morphism when composing it with every arrow on either side changes
# nothing.
prop is_identity_morphism(Obj, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), object Obj, identity_arrow Hom(object, object)):
    forall target Obj, f Hom(object, target):
        compose(object, object, target, identity_arrow, f) = f
    forall source Obj, g Hom(source, object):
        compose(source, object, object, g, identity_arrow) = g

# A candidate h is the composite of f and g when it equals the selected
# composition value.
prop is_composite(Obj, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), source, middle, target Obj, f Hom(source, middle), g Hom(middle, target), h Hom(source, target)):
    h = compose(source, middle, target, f, g)

# Naming an associativity instance gives later diagram proofs an exact fact
# shape instead of asking the verifier to search through a large raw equality.
prop composition_is_associative_at(Obj, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), source, first_middle, second_middle, target Obj, first_arrow Hom(source, first_middle), middle_arrow Hom(first_middle, second_middle), last_arrow Hom(second_middle, target)):
    compose(source, second_middle, target, compose(source, first_middle, second_middle, first_arrow, middle_arrow), last_arrow) = compose(source, first_middle, target, first_arrow, compose(first_middle, second_middle, target, middle_arrow, last_arrow))

# A category setting is the reusable theorem context. Closure is already
# encoded by the dependent carriers of identity and compose.
struct Category<Obj set, Mor set>:
    Hom fn(hom_source, hom_target Obj) power_set(Mor)
    identity fn(identity_object Obj) Hom(identity_object, identity_object)
    compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target)
    <=>:
        forall object Obj:
            $is_identity_morphism(Obj, Mor, Hom, compose, object, identity(object))
        forall source, middle, target, far_target Obj, f Hom(source, middle), g Hom(middle, target), h Hom(target, far_target):
            $composition_is_associative_at(Obj, Mor, Hom, compose, source, middle, target, far_target, f, g, h)

prop is_category(Obj set, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), identity fn(identity_object Obj) Hom(identity_object, identity_object), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target)):
    forall object Obj:
        $is_identity_morphism(Obj, Mor, Hom, compose, object, identity(object))
    forall source, middle, target, far_target Obj, f Hom(source, middle), g Hom(middle, target), h Hom(target, far_target):
        $composition_is_associative_at(Obj, Mor, Hom, compose, source, middle, target, far_target, f, g, h)


thm category_identity_is_identity_morphism:
    ? forall Obj set, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), identity fn(identity_object Obj) Hom(identity_object, identity_object), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), chosen_object Obj:
        $is_identity_morphism(Obj, Mor, Hom, compose, chosen_object, identity(chosen_object))

thm category_composition_is_associative:
    ? forall Obj set, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), identity fn(identity_object Obj) Hom(identity_object, identity_object), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), source_object, first_middle_object, second_middle_object, target_object Obj, first_arrow Hom(source_object, first_middle_object), middle_arrow Hom(first_middle_object, second_middle_object), last_arrow Hom(second_middle_object, target_object):
        $composition_is_associative_at(Obj, Mor, Hom, compose, source_object, first_middle_object, second_middle_object, target_object, first_arrow, middle_arrow, last_arrow)

thm category_composition_is_a_morphism:
    ? forall Obj set, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), identity fn(identity_object Obj) Hom(identity_object, identity_object), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), source_object, middle_object, target_object Obj, first_arrow Hom(source_object, middle_object), second_arrow Hom(middle_object, target_object):
        $is_morphism(Obj, Mor, Hom, source_object, target_object, compose(source_object, middle_object, target_object, first_arrow, second_arrow))
    compose(source_object, middle_object, target_object, first_arrow, second_arrow) $in Hom(source_object, target_object)
    Hom(source_object, target_object) $subset Mor
    by def $is_morphism(Obj, Mor, Hom, source_object, target_object, compose(source_object, middle_object, target_object, first_arrow, second_arrow))

thm selected_composite_is_composite:
    ? forall Obj set, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), identity fn(identity_object Obj) Hom(identity_object, identity_object), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target), source_object, middle_object, target_object Obj, first_arrow Hom(source_object, middle_object), second_arrow Hom(middle_object, target_object):
        $is_composite(Obj, Mor, Hom, compose, source_object, middle_object, target_object, first_arrow, second_arrow, compose(source_object, middle_object, target_object, first_arrow, second_arrow))
    by def $is_composite(Obj, Mor, Hom, compose, source_object, middle_object, target_object, first_arrow, second_arrow, compose(source_object, middle_object, target_object, first_arrow, second_arrow))

# Functor laws as a flat proposition (by-def ABI).
prop is_functor(CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target))):
    forall mapped_object CObj:
        F_arrow(mapped_object, mapped_object, Cidentity(mapped_object)) = Didentity(F_object(mapped_object))
    forall mapped_source, mapped_middle, mapped_target CObj, first_arrow CHom(mapped_source, mapped_middle), second_arrow CHom(mapped_middle, mapped_target):
        F_arrow(mapped_source, mapped_target, Ccompose(mapped_source, mapped_middle, mapped_target, first_arrow, second_arrow)) = Dcompose(F_object(mapped_source), F_object(mapped_middle), F_object(mapped_target), F_arrow(mapped_source, mapped_middle, first_arrow), F_arrow(mapped_middle, mapped_target, second_arrow))

# This constructor theorem has two consumers: identity and composite functors.
# It centralizes the definition fold so each construction shows only its maps
# and its two preservation arguments.
thm functor_from_preservation_laws:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), object_map fn(functor_object CObj) DObj, arrow_map fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(object_map(functor_source), object_map(functor_target)):
        forall preserved_object CObj:
            arrow_map(preserved_object, preserved_object, Cidentity(preserved_object)) = Didentity(object_map(preserved_object))
        forall preserved_source, preserved_middle, preserved_target CObj, first_arrow CHom(preserved_source, preserved_middle), second_arrow CHom(preserved_middle, preserved_target):
            arrow_map(preserved_source, preserved_target, Ccompose(preserved_source, preserved_middle, preserved_target, first_arrow, second_arrow)) = Dcompose(object_map(preserved_source), object_map(preserved_middle), object_map(preserved_target), arrow_map(preserved_source, preserved_middle, first_arrow), arrow_map(preserved_middle, preserved_target, second_arrow))
        =>:
            $is_functor(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, object_map, arrow_map)
    by def $is_functor(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, object_map, arrow_map)

# The new transparent let syntax keeps the two callable identity maps local.
thm identity_functor_exists:
    ? forall Obj set, Mor set, Hom fn(hom_source, hom_target Obj) power_set(Mor), identity fn(identity_object Obj) Hom(identity_object, identity_object), compose fn(comp_source, comp_middle, comp_target Obj, comp_first Hom(comp_source, comp_middle), comp_second Hom(comp_middle, comp_target)) Hom(comp_source, comp_target):
        exist identity_object_map fn(chosen_object Obj) Obj, identity_arrow_map fn(chosen_source, chosen_target Obj, chosen_arrow Hom(chosen_source, chosen_target)) Hom(identity_object_map(chosen_source), identity_object_map(chosen_target)) st {$is_functor(Obj, Mor, Hom, identity, compose, Obj, Mor, Hom, identity, compose, identity_object_map, identity_arrow_map)}
    let identity_on_objects = fn(chosen_object Obj) Obj {chosen_object}
    let identity_on_arrows = fn(chosen_source, chosen_target Obj, chosen_arrow Hom(chosen_source, chosen_target)) Hom(identity_on_objects(chosen_source), identity_on_objects(chosen_target)) {chosen_arrow}
    witness exist identity_object_map fn(chosen_object Obj) Obj, identity_arrow_map fn(chosen_source, chosen_target Obj, chosen_arrow Hom(chosen_source, chosen_target)) Hom(identity_object_map(chosen_source), identity_object_map(chosen_target)) st {$is_functor(Obj, Mor, Hom, identity, compose, Obj, Mor, Hom, identity, compose, identity_object_map, identity_arrow_map)} from identity_on_objects, identity_on_arrows:
        claim:
            ? forall chosen_object Obj:
                identity_on_arrows(chosen_object, chosen_object, identity(chosen_object)) = identity(identity_on_objects(chosen_object))
            identity_on_arrows(chosen_object, chosen_object, identity(chosen_object)) = identity(chosen_object) = identity(identity_on_objects(chosen_object))
        claim:
            ? forall chosen_source, chosen_middle, chosen_target Obj, first_arrow Hom(chosen_source, chosen_middle), second_arrow Hom(chosen_middle, chosen_target):
                identity_on_arrows(chosen_source, chosen_target, compose(chosen_source, chosen_middle, chosen_target, first_arrow, second_arrow)) = compose(identity_on_objects(chosen_source), identity_on_objects(chosen_middle), identity_on_objects(chosen_target), identity_on_arrows(chosen_source, chosen_middle, first_arrow), identity_on_arrows(chosen_middle, chosen_target, second_arrow))
            identity_on_arrows(chosen_source, chosen_target, compose(chosen_source, chosen_middle, chosen_target, first_arrow, second_arrow)) = compose(chosen_source, chosen_middle, chosen_target, first_arrow, second_arrow)
            compose(identity_on_objects(chosen_source), identity_on_objects(chosen_middle), identity_on_objects(chosen_target), identity_on_arrows(chosen_source, chosen_middle, first_arrow), identity_on_arrows(chosen_middle, chosen_target, second_arrow)) = compose(chosen_source, chosen_middle, chosen_target, first_arrow, second_arrow)
        release thm functor_from_preservation_laws(Obj, Mor, Hom, identity, compose, Obj, Mor, Hom, identity, compose, identity_on_objects, identity_on_arrows)

# Composite of functors F: C -> D and G: D -> E.
thm composite_functor_preserves_identity:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), EObj set, EMor set, EHom fn(hom_source, hom_target EObj) power_set(EMor), Eidentity fn(identity_object EObj) EHom(identity_object, identity_object), Ecompose fn(comp_source, comp_middle, comp_target EObj, comp_first EHom(comp_source, comp_middle), comp_second EHom(comp_middle, comp_target)) EHom(comp_source, comp_target), G_object fn(g_object DObj) EObj, G_arrow fn(g_source, g_target DObj, g_arrow DHom(g_source, g_target)) EHom(G_object(g_source), G_object(g_target)), chosen_object CObj:
        G_arrow(F_object(chosen_object), F_object(chosen_object), F_arrow(chosen_object, chosen_object, Cidentity(chosen_object))) = Eidentity(G_object(F_object(chosen_object)))
    F_arrow(chosen_object, chosen_object, Cidentity(chosen_object)) = Didentity(F_object(chosen_object))
    G_arrow(F_object(chosen_object), F_object(chosen_object), F_arrow(chosen_object, chosen_object, Cidentity(chosen_object))) = G_arrow(F_object(chosen_object), F_object(chosen_object), Didentity(F_object(chosen_object))) = Eidentity(G_object(F_object(chosen_object)))

thm composite_functor_preserves_composition:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), EObj set, EMor set, EHom fn(hom_source, hom_target EObj) power_set(EMor), Eidentity fn(identity_object EObj) EHom(identity_object, identity_object), Ecompose fn(comp_source, comp_middle, comp_target EObj, comp_first EHom(comp_source, comp_middle), comp_second EHom(comp_middle, comp_target)) EHom(comp_source, comp_target), G_object fn(g_object DObj) EObj, G_arrow fn(g_source, g_target DObj, g_arrow DHom(g_source, g_target)) EHom(G_object(g_source), G_object(g_target)), chosen_source, chosen_middle, chosen_target CObj, source_arrow CHom(chosen_source, chosen_middle), target_arrow CHom(chosen_middle, chosen_target):
        G_arrow(F_object(chosen_source), F_object(chosen_target), F_arrow(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow))) = Ecompose(G_object(F_object(chosen_source)), G_object(F_object(chosen_middle)), G_object(F_object(chosen_target)), G_arrow(F_object(chosen_source), F_object(chosen_middle), F_arrow(chosen_source, chosen_middle, source_arrow)), G_arrow(F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_middle, chosen_target, target_arrow)))
    F_arrow(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow)) = Dcompose(F_object(chosen_source), F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_source, chosen_middle, source_arrow), F_arrow(chosen_middle, chosen_target, target_arrow))
    G_arrow(F_object(chosen_source), F_object(chosen_target), Dcompose(F_object(chosen_source), F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_source, chosen_middle, source_arrow), F_arrow(chosen_middle, chosen_target, target_arrow))) = Ecompose(G_object(F_object(chosen_source)), G_object(F_object(chosen_middle)), G_object(F_object(chosen_target)), G_arrow(F_object(chosen_source), F_object(chosen_middle), F_arrow(chosen_source, chosen_middle, source_arrow)), G_arrow(F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_middle, chosen_target, target_arrow)))
    G_arrow(F_object(chosen_source), F_object(chosen_target), F_arrow(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow))) = G_arrow(F_object(chosen_source), F_object(chosen_target), Dcompose(F_object(chosen_source), F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_source, chosen_middle, source_arrow), F_arrow(chosen_middle, chosen_target, target_arrow))) = Ecompose(G_object(F_object(chosen_source)), G_object(F_object(chosen_middle)), G_object(F_object(chosen_target)), G_arrow(F_object(chosen_source), F_object(chosen_middle), F_arrow(chosen_source, chosen_middle, source_arrow)), G_arrow(F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_middle, chosen_target, target_arrow)))

# Primary tracer: local names expose the mathematical composite maps without
# publishing proof-only adapters.
thm composition_of_functors_exists:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), EObj set, EMor set, EHom fn(hom_source, hom_target EObj) power_set(EMor), Eidentity fn(identity_object EObj) EHom(identity_object, identity_object), Ecompose fn(comp_source, comp_middle, comp_target EObj, comp_first EHom(comp_source, comp_middle), comp_second EHom(comp_middle, comp_target)) EHom(comp_source, comp_target), G_object fn(g_object DObj) EObj, G_arrow fn(g_source, g_target DObj, g_arrow DHom(g_source, g_target)) EHom(G_object(g_source), G_object(g_target)):
        exist composite_object_map fn(chosen_object CObj) EObj, composite_arrow_map fn(chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target)) EHom(composite_object_map(chosen_source), composite_object_map(chosen_target)) st {$is_functor(CObj, CMor, CHom, Cidentity, Ccompose, EObj, EMor, EHom, Eidentity, Ecompose, composite_object_map, composite_arrow_map)}
    let composite_on_objects = fn(chosen_object CObj) EObj {G_object(F_object(chosen_object))}
    let composite_on_arrows = fn(chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target)) EHom(composite_on_objects(chosen_source), composite_on_objects(chosen_target)) {G_arrow(F_object(chosen_source), F_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow))}
    witness exist composite_object_map fn(chosen_object CObj) EObj, composite_arrow_map fn(chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target)) EHom(composite_object_map(chosen_source), composite_object_map(chosen_target)) st {$is_functor(CObj, CMor, CHom, Cidentity, Ccompose, EObj, EMor, EHom, Eidentity, Ecompose, composite_object_map, composite_arrow_map)} from composite_on_objects, composite_on_arrows:
        claim:
            ? forall chosen_object CObj:
                composite_on_arrows(chosen_object, chosen_object, Cidentity(chosen_object)) = Eidentity(composite_on_objects(chosen_object))
            by thm composite_functor_preserves_identity(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, EObj, EMor, EHom, Eidentity, Ecompose, G_object, G_arrow, chosen_object) => G_arrow(F_object(chosen_object), F_object(chosen_object), F_arrow(chosen_object, chosen_object, Cidentity(chosen_object))) = Eidentity(G_object(F_object(chosen_object)))
            composite_on_arrows(chosen_object, chosen_object, Cidentity(chosen_object)) = G_arrow(F_object(chosen_object), F_object(chosen_object), F_arrow(chosen_object, chosen_object, Cidentity(chosen_object))) = Eidentity(G_object(F_object(chosen_object))) = Eidentity(composite_on_objects(chosen_object))
        claim:
            ? forall chosen_source, chosen_middle, chosen_target CObj, source_arrow CHom(chosen_source, chosen_middle), target_arrow CHom(chosen_middle, chosen_target):
                composite_on_arrows(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow)) = Ecompose(composite_on_objects(chosen_source), composite_on_objects(chosen_middle), composite_on_objects(chosen_target), composite_on_arrows(chosen_source, chosen_middle, source_arrow), composite_on_arrows(chosen_middle, chosen_target, target_arrow))
            by thm composite_functor_preserves_composition(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, EObj, EMor, EHom, Eidentity, Ecompose, G_object, G_arrow, chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow) => G_arrow(F_object(chosen_source), F_object(chosen_target), F_arrow(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow))) = Ecompose(G_object(F_object(chosen_source)), G_object(F_object(chosen_middle)), G_object(F_object(chosen_target)), G_arrow(F_object(chosen_source), F_object(chosen_middle), F_arrow(chosen_source, chosen_middle, source_arrow)), G_arrow(F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_middle, chosen_target, target_arrow)))
            composite_on_arrows(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow)) = G_arrow(F_object(chosen_source), F_object(chosen_target), F_arrow(chosen_source, chosen_target, Ccompose(chosen_source, chosen_middle, chosen_target, source_arrow, target_arrow))) = Ecompose(G_object(F_object(chosen_source)), G_object(F_object(chosen_middle)), G_object(F_object(chosen_target)), G_arrow(F_object(chosen_source), F_object(chosen_middle), F_arrow(chosen_source, chosen_middle, source_arrow)), G_arrow(F_object(chosen_middle), F_object(chosen_target), F_arrow(chosen_middle, chosen_target, target_arrow))) = Ecompose(composite_on_objects(chosen_source), composite_on_objects(chosen_middle), composite_on_objects(chosen_target), composite_on_arrows(chosen_source, chosen_middle, source_arrow), composite_on_arrows(chosen_middle, chosen_target, target_arrow))
        release thm functor_from_preservation_laws(CObj, CMor, CHom, Cidentity, Ccompose, EObj, EMor, EHom, Eidentity, Ecompose, composite_on_objects, composite_on_arrows)

# Naturality is named at one arrow so diagram calculations can select the
# exact square they need before unfolding it to an equality.
prop naturality_square_commutes(CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(f_object CObj) DObj, F_arrow fn(f_source, f_target CObj, f_arrow CHom(f_source, f_target)) DHom(F_object(f_source), F_object(f_target)), G_object fn(g_object CObj) DObj, G_arrow fn(g_source, g_target CObj, g_arrow CHom(g_source, g_target)) DHom(G_object(g_source), G_object(g_target)), component fn(natural_object CObj) DHom(F_object(natural_object), G_object(natural_object)), natural_source, natural_target CObj, natural_arrow CHom(natural_source, natural_target)):
    Dcompose(F_object(natural_source), F_object(natural_target), G_object(natural_target), F_arrow(natural_source, natural_target, natural_arrow), component(natural_target)) = Dcompose(F_object(natural_source), G_object(natural_source), G_object(natural_target), component(natural_source), G_arrow(natural_source, natural_target, natural_arrow))

prop is_natural_transformation(CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), G_object fn(g_object CObj) DObj, G_arrow fn(g_source, g_target CObj, g_arrow CHom(g_source, g_target)) DHom(G_object(g_source), G_object(g_target)), component fn(natural_object CObj) DHom(F_object(natural_object), G_object(natural_object))):
    forall natural_source, natural_target CObj, natural_arrow CHom(natural_source, natural_target):
        $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, component, natural_source, natural_target, natural_arrow)

thm natural_transformation_from_naturality:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), G_object fn(g_object CObj) DObj, G_arrow fn(g_source, g_target CObj, g_arrow CHom(g_source, g_target)) DHom(G_object(g_source), G_object(g_target)), component fn(natural_object CObj) DHom(F_object(natural_object), G_object(natural_object)):
        forall natural_source, natural_target CObj, natural_arrow CHom(natural_source, natural_target):
            $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, component, natural_source, natural_target, natural_arrow)
        =>:
            $is_natural_transformation(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, component)
    by def $is_natural_transformation(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, component)

thm identity_component_is_natural:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target):
        $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, F_object, F_arrow, fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}, chosen_source, chosen_target, chosen_arrow)
    release thm category_identity_is_identity_morphism(DObj, DMor, DHom, Didentity, Dcompose, F_object(chosen_target))
    release thm category_identity_is_identity_morphism(DObj, DMor, DHom, Didentity, Dcompose, F_object(chosen_source))
    Dcompose(F_object(chosen_source), F_object(chosen_target), F_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), Didentity(F_object(chosen_target))) = F_arrow(chosen_source, chosen_target, chosen_arrow) = Dcompose(F_object(chosen_source), F_object(chosen_source), F_object(chosen_target), Didentity(F_object(chosen_source)), F_arrow(chosen_source, chosen_target, chosen_arrow))
    fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}(chosen_target) = Didentity(F_object(chosen_target))
    fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}(chosen_source) = Didentity(F_object(chosen_source))
    Dcompose(F_object(chosen_source), F_object(chosen_target), F_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}(chosen_target)) = Dcompose(F_object(chosen_source), F_object(chosen_target), F_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), Didentity(F_object(chosen_target))) = Dcompose(F_object(chosen_source), F_object(chosen_source), F_object(chosen_target), Didentity(F_object(chosen_source)), F_arrow(chosen_source, chosen_target, chosen_arrow)) = Dcompose(F_object(chosen_source), F_object(chosen_source), F_object(chosen_target), fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}(chosen_source), F_arrow(chosen_source, chosen_target, chosen_arrow))
    by def $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, F_object, F_arrow, fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}, chosen_source, chosen_target, chosen_arrow)

thm identity_natural_transformation_exists:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)):
        exist identity_component fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) st {$is_natural_transformation(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, F_object, F_arrow, identity_component)}
    let identity_on_components = fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) {Didentity(F_object(chosen_object))}
    witness exist identity_component fn(chosen_object CObj) DHom(F_object(chosen_object), F_object(chosen_object)) st {$is_natural_transformation(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, F_object, F_arrow, identity_component)} from identity_on_components:
        claim:
            ? forall chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target):
                $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, F_object, F_arrow, identity_on_components, chosen_source, chosen_target, chosen_arrow)
            release thm identity_component_is_natural(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, chosen_source, chosen_target, chosen_arrow)
        release thm natural_transformation_from_naturality(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, F_object, F_arrow, identity_on_components)

# Vertical composition of natural transformations.
# The local names are not proof-only wrappers: they expose the six object
# images, three arrow images, and four components in the familiar diagram.
thm vertical_composite_component_is_natural:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), G_object fn(g_object CObj) DObj, G_arrow fn(g_source, g_target CObj, g_arrow CHom(g_source, g_target)) DHom(G_object(g_source), G_object(g_target)), alpha fn(natural_object CObj) DHom(F_object(natural_object), G_object(natural_object)), H_object fn(h_object CObj) DObj, H_arrow fn(h_source, h_target CObj, h_arrow CHom(h_source, h_target)) DHom(H_object(h_source), H_object(h_target)), beta fn(component_object CObj) DHom(G_object(component_object), H_object(component_object)), chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target):
        Dcompose(F_object(chosen_source), F_object(chosen_target), H_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), Dcompose(F_object(chosen_target), G_object(chosen_target), H_object(chosen_target), alpha(chosen_target), beta(chosen_target))) = Dcompose(F_object(chosen_source), H_object(chosen_source), H_object(chosen_target), Dcompose(F_object(chosen_source), G_object(chosen_source), H_object(chosen_source), alpha(chosen_source), beta(chosen_source)), H_arrow(chosen_source, chosen_target, chosen_arrow))
    let f_source = F_object(chosen_source)
    let f_target = F_object(chosen_target)
    let g_source = G_object(chosen_source)
    let g_target = G_object(chosen_target)
    let h_source = H_object(chosen_source)
    let h_target = H_object(chosen_target)
    let f_image = F_arrow(chosen_source, chosen_target, chosen_arrow)
    let g_image = G_arrow(chosen_source, chosen_target, chosen_arrow)
    let h_image = H_arrow(chosen_source, chosen_target, chosen_arrow)
    let alpha_source = alpha(chosen_source)
    let alpha_target = alpha(chosen_target)
    let beta_source = beta(chosen_source)
    let beta_target = beta(chosen_target)
    $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, alpha, chosen_source, chosen_target, chosen_arrow)
    by def $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, alpha, chosen_source, chosen_target, chosen_arrow)
    $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, G_object, G_arrow, H_object, H_arrow, beta, chosen_source, chosen_target, chosen_arrow)
    by def $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, G_object, G_arrow, H_object, H_arrow, beta, chosen_source, chosen_target, chosen_arrow)
    by thm category_composition_is_associative(DObj, DMor, DHom, Didentity, Dcompose, f_source, f_target, g_target, h_target, f_image, alpha_target, beta_target) => $composition_is_associative_at(DObj, DMor, DHom, Dcompose, f_source, f_target, g_target, h_target, f_image, alpha_target, beta_target)
    by def $composition_is_associative_at(DObj, DMor, DHom, Dcompose, f_source, f_target, g_target, h_target, f_image, alpha_target, beta_target)
    by thm category_composition_is_associative(DObj, DMor, DHom, Didentity, Dcompose, f_source, g_source, g_target, h_target, alpha_source, g_image, beta_target) => $composition_is_associative_at(DObj, DMor, DHom, Dcompose, f_source, g_source, g_target, h_target, alpha_source, g_image, beta_target)
    by def $composition_is_associative_at(DObj, DMor, DHom, Dcompose, f_source, g_source, g_target, h_target, alpha_source, g_image, beta_target)
    by thm category_composition_is_associative(DObj, DMor, DHom, Didentity, Dcompose, f_source, g_source, h_source, h_target, alpha_source, beta_source, h_image) => $composition_is_associative_at(DObj, DMor, DHom, Dcompose, f_source, g_source, h_source, h_target, alpha_source, beta_source, h_image)
    by def $composition_is_associative_at(DObj, DMor, DHom, Dcompose, f_source, g_source, h_source, h_target, alpha_source, beta_source, h_image)
    Dcompose(f_source, f_target, h_target, f_image, Dcompose(f_target, g_target, h_target, alpha_target, beta_target)) = Dcompose(f_source, g_target, h_target, Dcompose(f_source, f_target, g_target, f_image, alpha_target), beta_target)
    Dcompose(f_source, g_target, h_target, Dcompose(f_source, f_target, g_target, f_image, alpha_target), beta_target) = Dcompose(f_source, g_target, h_target, Dcompose(f_source, g_source, g_target, alpha_source, g_image), beta_target)
    Dcompose(f_source, g_target, h_target, Dcompose(f_source, g_source, g_target, alpha_source, g_image), beta_target) = Dcompose(f_source, g_source, h_target, alpha_source, Dcompose(g_source, g_target, h_target, g_image, beta_target))
    Dcompose(f_source, g_source, h_target, alpha_source, Dcompose(g_source, g_target, h_target, g_image, beta_target)) = Dcompose(f_source, g_source, h_target, alpha_source, Dcompose(g_source, h_source, h_target, beta_source, h_image))
    Dcompose(f_source, g_source, h_target, alpha_source, Dcompose(g_source, h_source, h_target, beta_source, h_image)) = Dcompose(f_source, h_source, h_target, Dcompose(f_source, g_source, h_source, alpha_source, beta_source), h_image)
    Dcompose(F_object(chosen_source), F_object(chosen_target), H_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), Dcompose(F_object(chosen_target), G_object(chosen_target), H_object(chosen_target), alpha(chosen_target), beta(chosen_target))) = Dcompose(f_source, f_target, h_target, f_image, Dcompose(f_target, g_target, h_target, alpha_target, beta_target))
    Dcompose(f_source, f_target, h_target, f_image, Dcompose(f_target, g_target, h_target, alpha_target, beta_target)) = Dcompose(f_source, h_source, h_target, Dcompose(f_source, g_source, h_source, alpha_source, beta_source), h_image)
    Dcompose(f_source, h_source, h_target, Dcompose(f_source, g_source, h_source, alpha_source, beta_source), h_image) = Dcompose(F_object(chosen_source), H_object(chosen_source), H_object(chosen_target), Dcompose(F_object(chosen_source), G_object(chosen_source), H_object(chosen_source), alpha(chosen_source), beta(chosen_source)), H_arrow(chosen_source, chosen_target, chosen_arrow))

thm vertical_composition_of_natural_transformations_exists:
    ? forall CObj set, CMor set, CHom fn(hom_source, hom_target CObj) power_set(CMor), Cidentity fn(identity_object CObj) CHom(identity_object, identity_object), Ccompose fn(comp_source, comp_middle, comp_target CObj, comp_first CHom(comp_source, comp_middle), comp_second CHom(comp_middle, comp_target)) CHom(comp_source, comp_target), DObj set, DMor set, DHom fn(hom_source, hom_target DObj) power_set(DMor), Didentity fn(identity_object DObj) DHom(identity_object, identity_object), Dcompose fn(comp_source, comp_middle, comp_target DObj, comp_first DHom(comp_source, comp_middle), comp_second DHom(comp_middle, comp_target)) DHom(comp_source, comp_target), F_object fn(functor_object CObj) DObj, F_arrow fn(functor_source, functor_target CObj, functor_arrow CHom(functor_source, functor_target)) DHom(F_object(functor_source), F_object(functor_target)), G_object fn(g_object CObj) DObj, G_arrow fn(g_source, g_target CObj, g_arrow CHom(g_source, g_target)) DHom(G_object(g_source), G_object(g_target)), alpha fn(natural_object CObj) DHom(F_object(natural_object), G_object(natural_object)), H_object fn(h_object CObj) DObj, H_arrow fn(h_source, h_target CObj, h_arrow CHom(h_source, h_target)) DHom(H_object(h_source), H_object(h_target)), beta fn(component_object CObj) DHom(G_object(component_object), H_object(component_object)):
        exist vertical_component fn(chosen_object CObj) DHom(F_object(chosen_object), H_object(chosen_object)) st {$is_natural_transformation(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, H_object, H_arrow, vertical_component)}
    let vertical_components = fn(chosen_object CObj) DHom(F_object(chosen_object), H_object(chosen_object)) {Dcompose(F_object(chosen_object), G_object(chosen_object), H_object(chosen_object), alpha(chosen_object), beta(chosen_object))}
    witness exist vertical_component fn(chosen_object CObj) DHom(F_object(chosen_object), H_object(chosen_object)) st {$is_natural_transformation(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, H_object, H_arrow, vertical_component)} from vertical_components:
        claim:
            ? forall chosen_source, chosen_target CObj, chosen_arrow CHom(chosen_source, chosen_target):
                $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, H_object, H_arrow, vertical_components, chosen_source, chosen_target, chosen_arrow)
            vertical_components(chosen_target) = Dcompose(F_object(chosen_target), G_object(chosen_target), H_object(chosen_target), alpha(chosen_target), beta(chosen_target))
            vertical_components(chosen_source) = Dcompose(F_object(chosen_source), G_object(chosen_source), H_object(chosen_source), alpha(chosen_source), beta(chosen_source))
            by thm vertical_composite_component_is_natural(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, G_object, G_arrow, alpha, H_object, H_arrow, beta, chosen_source, chosen_target, chosen_arrow) => Dcompose(F_object(chosen_source), F_object(chosen_target), H_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), Dcompose(F_object(chosen_target), G_object(chosen_target), H_object(chosen_target), alpha(chosen_target), beta(chosen_target))) = Dcompose(F_object(chosen_source), H_object(chosen_source), H_object(chosen_target), Dcompose(F_object(chosen_source), G_object(chosen_source), H_object(chosen_source), alpha(chosen_source), beta(chosen_source)), H_arrow(chosen_source, chosen_target, chosen_arrow))
            Dcompose(F_object(chosen_source), F_object(chosen_target), H_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), vertical_components(chosen_target)) = Dcompose(F_object(chosen_source), F_object(chosen_target), H_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), Dcompose(F_object(chosen_target), G_object(chosen_target), H_object(chosen_target), alpha(chosen_target), beta(chosen_target)))
            Dcompose(F_object(chosen_source), H_object(chosen_source), H_object(chosen_target), Dcompose(F_object(chosen_source), G_object(chosen_source), H_object(chosen_source), alpha(chosen_source), beta(chosen_source)), H_arrow(chosen_source, chosen_target, chosen_arrow)) = Dcompose(F_object(chosen_source), H_object(chosen_source), H_object(chosen_target), vertical_components(chosen_source), H_arrow(chosen_source, chosen_target, chosen_arrow))
            Dcompose(F_object(chosen_source), F_object(chosen_target), H_object(chosen_target), F_arrow(chosen_source, chosen_target, chosen_arrow), vertical_components(chosen_target)) = Dcompose(F_object(chosen_source), H_object(chosen_source), H_object(chosen_target), vertical_components(chosen_source), H_arrow(chosen_source, chosen_target, chosen_arrow))
            by def $naturality_square_commutes(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, H_object, H_arrow, vertical_components, chosen_source, chosen_target, chosen_arrow)
        release thm natural_transformation_from_naturality(CObj, CMor, CHom, Cidentity, Ccompose, DObj, DMor, DHom, Didentity, Dcompose, F_object, F_arrow, H_object, H_arrow, vertical_components)

# Concrete example 1: the terminal category has one object and one arrow. Every
# hom-set is the singleton {0}; identity and composition must therefore return
# its unique member.
have terminal_objects finite_set = {0}
have terminal_morphisms finite_set = {0}
have fn terminal_hom(source, target terminal_objects) power_set(terminal_morphisms) = {0}
forall source, target terminal_objects:
    terminal_hom(source, target) = {0}
    0 $in {0}
    0 $in terminal_hom(source, target)
have fn terminal_identity(object terminal_objects) terminal_hom(object, object) = 0
have fn terminal_compose(source, middle, target terminal_objects, f terminal_hom(source, middle), g terminal_hom(middle, target)) terminal_hom(source, target) = 0

thm terminal_data_forms_a_category:
    ? forall:
        $is_category(terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose)
    claim:
        ? forall object terminal_objects:
            $is_identity_morphism(terminal_objects, terminal_morphisms, terminal_hom, terminal_compose, object, terminal_identity(object))
        claim:
            ? forall target terminal_objects, f terminal_hom(object, target):
                terminal_compose(object, object, target, terminal_identity(object), f) = f
            terminal_hom(object, target) = {0}
            f $in {0}
            f = 0
            terminal_compose(object, object, target, terminal_identity(object), f) = 0 = f
        claim:
            ? forall source terminal_objects, g terminal_hom(source, object):
                terminal_compose(source, object, object, g, terminal_identity(object)) = g
            terminal_hom(source, object) = {0}
            g $in {0}
            g = 0
            terminal_compose(source, object, object, g, terminal_identity(object)) = 0 = g
        by def $is_identity_morphism(terminal_objects, terminal_morphisms, terminal_hom, terminal_compose, object, terminal_identity(object))
    claim:
        ? forall source, middle, target, far_target terminal_objects, f terminal_hom(source, middle), g terminal_hom(middle, target), h terminal_hom(target, far_target):
            $composition_is_associative_at(terminal_objects, terminal_morphisms, terminal_hom, terminal_compose, source, middle, target, far_target, f, g, h)
        terminal_compose(source, target, far_target, terminal_compose(source, middle, target, f, g), h) = 0 = terminal_compose(source, middle, far_target, f, terminal_compose(middle, target, far_target, g, h))
        by def $composition_is_associative_at(terminal_objects, terminal_morphisms, terminal_hom, terminal_compose, source, middle, target, far_target, f, g, h)
    by def $is_category(terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose)

# Concrete consumer: the generic identity-functor construction specializes to
# the terminal category without rebuilding its maps or laws.
thm terminal_identity_functor_exists:
    ? forall:
        exist identity_object_map fn(chosen_object terminal_objects) terminal_objects, identity_arrow_map fn(chosen_source, chosen_target terminal_objects, chosen_arrow terminal_hom(chosen_source, chosen_target)) terminal_hom(identity_object_map(chosen_source), identity_object_map(chosen_target)) st {$is_functor(terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose, terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose, identity_object_map, identity_arrow_map)}
    by thm terminal_data_forms_a_category() => $is_category(terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose)
    by def $is_category(terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose)
    release thm identity_functor_exists(terminal_objects, terminal_morphisms, terminal_hom, terminal_identity, terminal_compose)

# Concrete example 2: the chaotic category on two objects. Its objects are 0
# and 1, and the unique arrow source -> target is encoded by (source, target).
# Hence every ordered pair of objects has exactly one arrow between it.
have two_object_objects finite_set = {0, 1}
have fn two_object_hom(source, target two_object_objects) power_set(cart(two_object_objects, two_object_objects)) = {(source, target)}
forall source, target two_object_objects:
    two_object_hom(source, target) = {(source, target)}
    (source, target) $in {(source, target)}
    (source, target) $in two_object_hom(source, target)
have fn two_object_identity(object two_object_objects) two_object_hom(object, object) = (object, object)
have fn two_object_compose(source, middle, target two_object_objects, f two_object_hom(source, middle), g two_object_hom(middle, target)) two_object_hom(source, target) = (source, target)

thm two_object_chaotic_data_forms_a_category:
    ? forall:
        $is_category(two_object_objects, cart(two_object_objects, two_object_objects), two_object_hom, two_object_identity, two_object_compose)
    claim:
        ? forall object two_object_objects:
            $is_identity_morphism(two_object_objects, cart(two_object_objects, two_object_objects), two_object_hom, two_object_compose, object, two_object_identity(object))
        claim:
            ? forall target two_object_objects, f two_object_hom(object, target):
                two_object_compose(object, object, target, two_object_identity(object), f) = f
            two_object_hom(object, target) = {(object, target)}
            f $in {(object, target)}
            f = (object, target)
            two_object_compose(object, object, target, two_object_identity(object), f) = (object, target) = f
        claim:
            ? forall source two_object_objects, g two_object_hom(source, object):
                two_object_compose(source, object, object, g, two_object_identity(object)) = g
            two_object_hom(source, object) = {(source, object)}
            g $in {(source, object)}
            g = (source, object)
            two_object_compose(source, object, object, g, two_object_identity(object)) = (source, object) = g
        by def $is_identity_morphism(two_object_objects, cart(two_object_objects, two_object_objects), two_object_hom, two_object_compose, object, two_object_identity(object))
    claim:
        ? forall source, middle, target, far_target two_object_objects, f two_object_hom(source, middle), g two_object_hom(middle, target), h two_object_hom(target, far_target):
            $composition_is_associative_at(two_object_objects, cart(two_object_objects, two_object_objects), two_object_hom, two_object_compose, source, middle, target, far_target, f, g, h)
        two_object_compose(source, target, far_target, two_object_compose(source, middle, target, f, g), h) = (source, far_target) = two_object_compose(source, middle, far_target, f, two_object_compose(middle, target, far_target, g, h))
        by def $composition_is_associative_at(two_object_objects, cart(two_object_objects, two_object_objects), two_object_hom, two_object_compose, source, middle, target, far_target, f, g, h)
    by def $is_category(two_object_objects, cart(two_object_objects, two_object_objects), two_object_hom, two_object_identity, two_object_compose)
