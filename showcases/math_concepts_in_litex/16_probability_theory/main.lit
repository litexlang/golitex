# Probability theory from the Kolmogorov axioms, setting-first.
#
# Included: countable unions and real series, generated and Borel sigma
# algebras, probability spaces, countable and finite additivity, conditional
# probability, measurable maps, pushforward measures, and distributions.
#
# Main line:
#
#   generated sigma-algebra + real series
#       -> Borel(R)
#       -> real-valued probability space and explicit measure constructions
#       -> countable additivity, conditional probability, and independence
#       -> measurable random variables and pushforward probability measures.

# Countable unions use the first-class indexed-family operator. Its explicit
# ambient set also fixes the empty-family intersection convention elsewhere.

# A real series sum is a relation on a candidate value, not a total selector.
have fn partial_sum(a seq(R), k N) R by induc k from 0:
    case k = 0: 0
    case k >= 1: partial_sum(a, k - 1) + a(k)

prop is_tail_close_to(a seq(R), L R, epsilon R+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n) - L) < epsilon

prop has_sequence_limit(a seq(R), L R):
    forall epsilon R+:
        exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}

prop has_series_sum(a seq(R), L R):
    $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L)

# The whole-space and binary-intersection laws are conservative projections of
# the usual empty/complement/countable-union sigma-algebra axioms. Keeping them
# visible gives later exact-carrier probability applications a direct event
# membership fact.
setting SigmaAlgebraSetting(Omega set, events power_set(power_set(Omega))):
    {} $in events
    Omega $in events
    forall event events:
        set_minus(Omega, event) $in events
    forall left_event, right_event events:
        intersect(left_event, right_event) $in events
    forall family fn(n N+) events:
        index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events

prop is_sigma_algebra([SigmaAlgebraSetting])

# The sigma algebra generated by a family is the intersection of all sigma
# algebras on the same carrier that contain that family. This is a genuine
# construction: later code can use the resulting event family directly.
prop is_sigma_algebra_containing(X set, generators, candidate_events power_set(power_set(X))):
    $is_sigma_algebra(X, candidate_events)
    generators $subset candidate_events

prop belongs_to_every_sigma_algebra_containing(X set, generators power_set(power_set(X)), event power_set(X)):
    forall candidate_events power_set(power_set(X)):
        $is_sigma_algebra_containing(X, generators, candidate_events)
        =>:
            event $in candidate_events

template<X set>:
    have fn generated_sigma_algebra(generators power_set(power_set(X))) power_set(power_set(X)) = {event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, event)}

thm generators_are_in_generated_sigma_algebra:
    ? forall X set, generators power_set(power_set(X)):
        generators $subset \generated_sigma_algebra<X>(generators)
    claim:
        ? forall event generators:
            event $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    event $in candidate_events
            by def $is_sigma_algebra_containing(X, generators, candidate_events)
        by def $belongs_to_every_sigma_algebra_containing(X, generators, event)
        by thm set_builder_member(event, {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}) => event $in {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
        event $in \generated_sigma_algebra<X>(generators)
    by def:
        ? generators $subset \generated_sigma_algebra<X>(generators)

thm belongs_to_every_sigma_algebra_containing_implies_generated_membership:
    ? forall X set, generators power_set(power_set(X)), event power_set(X):
        $belongs_to_every_sigma_algebra_containing(X, generators, event)
        =>:
            event $in \generated_sigma_algebra<X>(generators)
    by thm set_builder_member(event, {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}) => event $in {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
    event $in \generated_sigma_algebra<X>(generators)

thm generated_membership_implies_belongs_to_every_sigma_algebra_containing:
    ? forall X set, generators power_set(power_set(X)), event \generated_sigma_algebra<X>(generators):
        $belongs_to_every_sigma_algebra_containing(X, generators, event)
    \generated_sigma_algebra<X>(generators) = {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
    event $in {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
    $belongs_to_every_sigma_algebra_containing(X, generators, event)

thm generated_sigma_algebra_is_sigma_algebra:
    ? forall X set, generators power_set(power_set(X)):
        $is_sigma_algebra(X, \generated_sigma_algebra<X>(generators))
    claim:
        ? {} $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    {} $in candidate_events
            {} $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, {})
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, {}) => {} $in \generated_sigma_algebra<X>(generators)
    claim:
        ? X $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    X $in candidate_events
            X $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, X)
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, X) => X $in \generated_sigma_algebra<X>(generators)
    claim:
        ? forall event \generated_sigma_algebra<X>(generators):
            set_minus(X, event) $in \generated_sigma_algebra<X>(generators)
        by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, event) => $belongs_to_every_sigma_algebra_containing(X, generators, event)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    set_minus(X, event) $in candidate_events
            event $in candidate_events
            set_minus(X, event) $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, set_minus(X, event))
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, set_minus(X, event)) => set_minus(X, event) $in \generated_sigma_algebra<X>(generators)
    claim:
        ? forall left_event, right_event \generated_sigma_algebra<X>(generators):
            intersect(left_event, right_event) $in \generated_sigma_algebra<X>(generators)
        by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, left_event) => $belongs_to_every_sigma_algebra_containing(X, generators, left_event)
        by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, right_event) => $belongs_to_every_sigma_algebra_containing(X, generators, right_event)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    intersect(left_event, right_event) $in candidate_events
            left_event $in candidate_events
            right_event $in candidate_events
            intersect(left_event, right_event) $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, intersect(left_event, right_event))
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, intersect(left_event, right_event)) => intersect(left_event, right_event) $in \generated_sigma_algebra<X>(generators)
    claim:
        ? forall family fn(n N+) \generated_sigma_algebra<X>(generators):
            index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in candidate_events
            claim:
                ? forall n N+:
                    family(n) $in candidate_events
                by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, family(n)) => $belongs_to_every_sigma_algebra_containing(X, generators, family(n))
                family(n) $in candidate_events
            have fn candidate_family(n N+) candidate_events = family(n)
            forall n N+:
                candidate_family(n) = family(n)
            index_union(N+, X, fn(n N+) power_set(X) {candidate_family(n)}) $in candidate_events
            index_union(N+, X, fn(n N+) power_set(X) {candidate_family(n)}) = index_union(N+, X, fn(n N+) power_set(X) {family(n)})
            index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, index_union(N+, X, fn(n N+) power_set(X) {family(n)}))
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, index_union(N+, X, fn(n N+) power_set(X) {family(n)})) => index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in \generated_sigma_algebra<X>(generators)
    by def $is_sigma_algebra(X, \generated_sigma_algebra<X>(generators))

# The standard Borel sigma algebra on R is generated by all bounded open
# intervals. Bounded open intervals suffice to generate the usual Borel
# sigma algebra, and keep the generator presentation first-order and usable.
prop is_real_open_interval(interval power_set(R)):
    exist left, right R st {left < right, interval = {x R: left < x < right}}

have real_open_intervals power_set(power_set(R)) = {interval power_set(R): $is_real_open_interval(interval)}

have borel_sigma_algebra_on_R power_set(power_set(R)) = \generated_sigma_algebra<R>(real_open_intervals)

by thm generated_sigma_algebra_is_sigma_algebra(R, real_open_intervals) => $is_sigma_algebra(R, \generated_sigma_algebra<R>(real_open_intervals))
borel_sigma_algebra_on_R = \generated_sigma_algebra<R>(real_open_intervals)
$is_sigma_algebra(R, borel_sigma_algebra_on_R)

thm real_open_interval_is_borel:
    ? forall left, right R:
        left < right
        =>:
            {x R: left < x < right} $in borel_sigma_algebra_on_R
    claim:
        ? $is_real_open_interval({x R: left < x < right})
        witness exist interval_left, interval_right R st {interval_left < interval_right, {x R: left < x < right} = {x R: interval_left < x < interval_right}} from left, right:
            left < right
            {x R: left < x < right} = {x R: left < x < right}
    claim:
        ? {x R: left < x < right} $in real_open_intervals
        by thm set_builder_member({x R: left < x < right}, {interval power_set(R): $is_real_open_interval(interval)}) => {x R: left < x < right} $in {interval power_set(R): $is_real_open_interval(interval)}
        real_open_intervals = {interval power_set(R): $is_real_open_interval(interval)}
        {x R: left < x < right} $in real_open_intervals
    by thm generators_are_in_generated_sigma_algebra(R, real_open_intervals) => real_open_intervals $subset \generated_sigma_algebra<R>(real_open_intervals)
    {x R: left < x < right} $in \generated_sigma_algebra<R>(real_open_intervals)
    borel_sigma_algebra_on_R = \generated_sigma_algebra<R>(real_open_intervals)
    {x R: left < x < right} $in borel_sigma_algebra_on_R

# Event families now use the same checked indexed-set algebra as ordinary
# sets. These are direct builtin identities and bounds, not auxiliary theorems.
# The concrete finite sample space keeps this section executable on its own.
have fn finite_event_family(event_index {1, 2}) power_set({1, 2, 3}) by cases:
    case event_index = 1: {1, 2}
    case event_index = 2: {2, 3}

finite_event_family(1) $subset index_union({1, 2}, {1, 2, 3}, finite_event_family)
index_intersect({1, 2}, {1, 2, 3}, finite_event_family) $subset finite_event_family(2)

# Complementing a union/intersection of events is pointwise De Morgan. The
# explicit sample-space ambient also handles an empty event family correctly.
set_minus({1, 2, 3}, index_union({1, 2}, {1, 2, 3}, finite_event_family)) = index_intersect({1, 2}, {1, 2, 3}, fn(event_index {1, 2}) power_set({1, 2, 3}) {set_minus({1, 2, 3}, finite_event_family(event_index))})
set_minus({1, 2, 3}, index_intersect({1, 2}, {1, 2, 3}, finite_event_family)) = index_union({1, 2}, {1, 2, 3}, fn(event_index {1, 2}) power_set({1, 2, 3}) {set_minus({1, 2, 3}, finite_event_family(event_index))})

prop pairwise_disjoint_event_sequence(Omega set, events power_set(power_set(Omega)), family fn(n N+) events):
    forall idx, j N+:
        idx != j
        =>:
            intersect(family(idx), family(j)) = {}

# Kolmogorov probability is real-valued: total mass one makes infinity
# unnecessary. Empty-event zero is retained as its standard derived projection.
setting ProbabilitySpaceSetting([SigmaAlgebraSetting], probability fn(event events) R):
    probability({}) = 0
    probability(Omega) = 1
    forall event events:
        probability(event) >= 0
    forall family fn(n N+) events:
        $pairwise_disjoint_event_sequence(Omega, events, family)
        =>:
            $has_series_sum(fn(n N+) R {probability(family(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))

prop is_probability_space([ProbabilitySpaceSetting])

# Tracer theorem: the third Kolmogorov axiom is directly consumable, with the
# right side carrying ordinary real-series convergence semantics.
thm kolmogorov_countable_additivity:
    ? forall [ProbabilitySpaceSetting], event_sequence fn(n N+) events:
        $pairwise_disjoint_event_sequence(Omega, events, event_sequence)
        =>:
            $has_series_sum(fn(n N+) R {probability(event_sequence(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)})))

# Event-level probability calculus.
template<Omega set, events power_set(power_set(Omega)), probability fn(event events) R>:
    have fn conditional_probability(A, B events: intersect(A, B) $in events, probability(B) > 0) R = probability(intersect(A, B)) / probability(B)

prop are_independent(Omega set, events power_set(power_set(Omega)), probability fn(event events) R, A, B events):
    intersect(A, B) $in events
    probability(intersect(A, B)) = probability(A) * probability(B)

thm event_intersection_is_event:
    ? forall [SigmaAlgebraSetting], A, B events:
        intersect(A, B) $in events

# Independence replaces the intersection probability in the conditional
# quotient and cancels the positive evidence probability.
thm independent_event_conditional_probability:
    ? forall [ProbabilitySpaceSetting], A, B events:
        $are_independent(Omega, events, probability, A, B)
        probability(B) > 0
        =>:
            \conditional_probability<Omega, events, probability>(A, B) = probability(A)
    by def $are_independent(Omega, events, probability, A, B)
    \conditional_probability<Omega, events, probability>(A, B) = probability(intersect(A, B)) / probability(B)
    probability(B) != 0
    probability(intersect(A, B)) / probability(B) = (probability(A) * probability(B)) / probability(B) = probability(A)

# Measurable maps and random variables remain distinct from their pushforward
# distributions. Generic maps still receive an explicit target sigma algebra;
# callers may choose the constructed borel_sigma_algebra_on_R when Target = R.
prop is_measurable_map(Source, Target set, source_events power_set(power_set(Source)), target_events power_set(power_set(Target)), f fn(x Source) Target):
    forall target_event target_events:
        {x Source: f(x) $in target_event} $in source_events

prop is_random_variable(Omega set, events power_set(power_set(Omega)), real_events power_set(power_set(R)), X fn(omega Omega) R):
    $is_measurable_map(Omega, R, events, real_events, X)

prop is_distribution_of(Omega set, events power_set(power_set(Omega)), probability fn(event events) R, Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target, distribution fn(target_event target_events) R):
    forall target_event target_events:
        {omega Omega: X(omega) $in target_event} $in events
        distribution(target_event) = probability({omega Omega: X(omega) $in target_event})

# A measurable map constructs its own pushforward probability function. The
# measurability evidence in the template domain makes every preimage an exact
# source event, so evaluation never relies on an unchecked carrier coercion.
template<Omega set, events power_set(power_set(Omega)), probability fn(event events) R, Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target: $is_measurable_map(Omega, Target, events, target_events, X)>:
    have fn pushforward_probability(target_event target_events) R = probability({omega Omega: X(omega) $in target_event})

thm pushforward_probability_is_distribution:
    ? forall [ProbabilitySpaceSetting], Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target:
        $is_measurable_map(Omega, Target, events, target_events, X)
        =>:
            $is_distribution_of(Omega, events, probability, Target, target_events, X, \pushforward_probability<Omega, events, probability, Target, target_events, X>)
    let pushforward = \pushforward_probability<Omega, events, probability, Target, target_events, X>
    claim:
        ? forall target_event target_events:
            {omega Omega: X(omega) $in target_event} $in events
            pushforward(target_event) = probability({omega Omega: X(omega) $in target_event})
        {omega Omega: X(omega) $in target_event} $in events
        pushforward(target_event) = probability({omega Omega: X(omega) $in target_event})
    by def $is_distribution_of(Omega, events, probability, Target, target_events, X, pushforward)
    $is_distribution_of(Omega, events, probability, Target, target_events, X, \pushforward_probability<Omega, events, probability, Target, target_events, X>)

# Preimages preserve the set operations needed by a probability measure.
thm preimage_of_empty_is_empty:
    ? forall Source, Target set, f fn(x Source) Target:
        {x Source: f(x) $in {}} = {}
    by extension:
        ? {x Source: f(x) $in {}} = {}
        claim:
            ? forall point {x Source: f(x) $in {}}:
                point $in {}
            by contra:
                ? point $in {}
                not point $in {}
                f(point) $in {}
                impossible f(point) $in {}
        claim:
            ? forall point {}:
                point $in {x Source: f(x) $in {}}
            by contra:
                ? point $in {x Source: f(x) $in {}}
                not point $in {x Source: f(x) $in {}}
                impossible point $in {}

thm preimage_of_universe_is_source:
    ? forall Source, Target set, f fn(x Source) Target:
        {x Source: f(x) $in Target} = Source
    by extension:
        ? {x Source: f(x) $in Target} = Source
        claim:
            ? forall point {x Source: f(x) $in Target}:
                point $in Source
            point $in Source
        claim:
            ? forall point Source:
                point $in {x Source: f(x) $in Target}
            f(point) $in Target
            by thm set_builder_member(point, {x Source: f(x) $in Target}) => point $in {x Source: f(x) $in Target}

thm preimage_of_index_union:
    ? forall Source, Target set, f fn(x Source) Target, family fn(n N+) power_set(Target):
        {x Source: f(x) $in index_union(N+, Target, family)} = index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
    by extension:
        ? {x Source: f(x) $in index_union(N+, Target, family)} = index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
        claim:
            ? forall point {x Source: f(x) $in index_union(N+, Target, family)}:
                point $in index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
            f(point) $in index_union(N+, Target, family)
            obtain idx from exist idx N+ st {f(point) $in family(idx)}
            by thm set_builder_member(point, {x Source: f(x) $in family(idx)}) => point $in {x Source: f(x) $in family(idx)}
            witness exist candidate_index N+ st {point $in {x Source: f(x) $in family(candidate_index)}} from idx
            point $in index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
        claim:
            ? forall point index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}}):
                point $in {x Source: f(x) $in index_union(N+, Target, family)}
            obtain idx from exist idx N+ st {point $in {x Source: f(x) $in family(idx)}}
            f(point) $in family(idx)
            witness exist candidate_index N+ st {f(point) $in family(candidate_index)} from idx
            f(point) $in index_union(N+, Target, family)
            by thm set_builder_member(point, {x Source: f(x) $in index_union(N+, Target, family)}) => point $in {x Source: f(x) $in index_union(N+, Target, family)}

# The exact-carrier preimage sequence packages measurability once and is then
# reusable by both disjointness and countable-additivity arguments.
template<Source set, Target set, source_events power_set(power_set(Source)), target_events power_set(power_set(Target)), f fn(x Source) Target, family fn(n N+) target_events: $is_measurable_map(Source, Target, source_events, target_events, f)>:
    have fn measurable_preimage_sequence(n N+) source_events = {x Source: f(x) $in family(n)}

thm measurable_preimage_sequence_is_pairwise_disjoint:
    ? forall Source, Target set, source_events power_set(power_set(Source)), target_events power_set(power_set(Target)), f fn(x Source) Target, family fn(n N+) target_events:
        $is_measurable_map(Source, Target, source_events, target_events, f)
        $pairwise_disjoint_event_sequence(Target, target_events, family)
        =>:
            $pairwise_disjoint_event_sequence(Source, source_events, \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>)
    let preimages = \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(preimages(idx), preimages(j)) = {}
        intersect(family(idx), family(j)) = {}
        preimages(idx) = {x Source: f(x) $in family(idx)}
        preimages(j) = {x Source: f(x) $in family(j)}
        by extension:
            ? intersect(preimages(idx), preimages(j)) = {}
            claim:
                ? forall point intersect(preimages(idx), preimages(j)):
                    point $in {}
                by contra:
                    ? point $in {}
                    not point $in {}
                    point $in {x Source: f(x) $in family(idx)}
                    point $in {x Source: f(x) $in family(j)}
                    f(point) $in family(idx)
                    f(point) $in family(j)
                    f(point) $in intersect(family(idx), family(j))
                    f(point) $in {}
                    impossible f(point) $in {}
            claim:
                ? forall point {}:
                    point $in intersect(preimages(idx), preimages(j))
                by contra:
                    ? point $in intersect(preimages(idx), preimages(j))
                    not point $in intersect(preimages(idx), preimages(j))
                    impossible point $in {}
    by def $pairwise_disjoint_event_sequence(Source, source_events, preimages)
    $pairwise_disjoint_event_sequence(Source, source_events, \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>)

thm pushforward_probability_is_probability_space:
    ? forall [ProbabilitySpaceSetting], Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target:
        $is_sigma_algebra(Target, target_events)
        $is_measurable_map(Omega, Target, events, target_events, X)
        =>:
            $is_probability_space(Target, target_events, \pushforward_probability<Omega, events, probability, Target, target_events, X>)
    let pushforward = \pushforward_probability<Omega, events, probability, Target, target_events, X>
    by thm preimage_of_empty_is_empty(Omega, Target, X) => {omega Omega: X(omega) $in {}} = {}
    pushforward({}) = probability({omega Omega: X(omega) $in {}}) = probability({}) = 0
    by thm preimage_of_universe_is_source(Omega, Target, X) => {omega Omega: X(omega) $in Target} = Omega
    pushforward(Target) = probability({omega Omega: X(omega) $in Target}) = probability(Omega) = 1
    claim:
        ? forall target_event target_events:
            pushforward(target_event) >= 0
        {omega Omega: X(omega) $in target_event} $in events
        pushforward(target_event) = probability({omega Omega: X(omega) $in target_event})
        probability({omega Omega: X(omega) $in target_event}) >= 0
    claim:
        ? forall family fn(n N+) target_events:
            $pairwise_disjoint_event_sequence(Target, target_events, family)
            =>:
                $has_series_sum(fn(n N+) R {pushforward(family(n))}, pushforward(index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})))
        let preimages = \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>
        have source_union events = index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})
        by thm measurable_preimage_sequence_is_pairwise_disjoint(Omega, Target, events, target_events, X, family) => $pairwise_disjoint_event_sequence(Omega, events, preimages)
        by thm kolmogorov_countable_additivity(Omega, events, probability, preimages) => $has_series_sum(fn(n N+) R {probability(preimages(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})))
        source_union = index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})
        $has_series_sum(fn(n N+) R {probability(preimages(n))}, probability(source_union))
        claim:
            ? forall n N+:
                probability(preimages(n)) = pushforward(family(n))
            preimages(n) = {omega Omega: X(omega) $in family(n)}
            pushforward(family(n)) = probability({omega Omega: X(omega) $in family(n)})
        by def $fn_eq(fn(n N+) R {probability(preimages(n))}, fn(n N+) R {pushforward(family(n))})
        fn(n N+) R {probability(preimages(n))} = fn(n N+) R {pushforward(family(n))}
        claim:
            ? {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})} = source_union
            by extension:
                ? {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})} = source_union
                claim:
                    ? forall point {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}:
                        point $in source_union
                    X(point) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})
                    obtain idx from exist idx N+ st {X(point) $in family(idx)}
                    preimages(idx) = {omega Omega: X(omega) $in family(idx)}
                    by thm set_builder_member(point, {omega Omega: X(omega) $in family(idx)}) => point $in {omega Omega: X(omega) $in family(idx)}
                    point $in preimages(idx)
                    witness exist candidate_index N+ st {point $in preimages(candidate_index)} from idx
                    point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})
                    source_union = index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})
                    point $in source_union
                claim:
                    ? forall point source_union:
                        point $in {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}
                    source_union = index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})
                    point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {preimages(n)})
                    obtain idx from exist idx N+ st {point $in preimages(idx)}
                    preimages(idx) = {omega Omega: X(omega) $in family(idx)}
                    point $in {omega Omega: X(omega) $in family(idx)}
                    X(point) $in family(idx)
                    witness exist candidate_index N+ st {X(point) $in family(candidate_index)} from idx
                    X(point) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})
                    by thm set_builder_member(point, {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}) => point $in {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}
        pushforward(index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})) = probability({omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}) = probability(source_union)
        $has_series_sum(fn(n N+) R {pushforward(family(n))}, pushforward(index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})))
    by def $is_probability_space(Target, target_events, pushforward)
    $is_probability_space(Target, target_events, \pushforward_probability<Omega, events, probability, Target, target_events, X>)

# A distribution package already contains every preimage-event obligation, so
# it immediately exposes the underlying measurable map.
thm distribution_of_has_measurable_map:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn(event events) R, Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target, distribution fn(target_event target_events) R:
        $is_distribution_of(Omega, events, probability, Target, target_events, X, distribution)
        =>:
            $is_measurable_map(Omega, Target, events, target_events, X)
    by def $is_distribution_of(Omega, events, probability, Target, target_events, X, distribution)
    by def $is_measurable_map(Omega, Target, events, target_events, X)

# Derived probability calculus starts from two reusable analytic facts:
# sequence limits are unique, and a finite two-term prefix has its expected
# real-series sum.
thm sequence_limit_unique:
    ? forall a seq(R), L1, L2 R:
        $has_sequence_limit(a, L1)
        $has_sequence_limit(a, L2)
        =>:
            L1 = L2
    by contra:
        ? L1 = L2
        L1 - L2 != 0
        abs(L1 - L2) > 0
        abs(L1 - L2) / 3 > 0
        abs(L1 - L2) / 3 $in R+
        obtain n1 from exist n1 N+ st {$is_tail_close_to(a, L1, abs(L1 - L2) / 3, n1)}
        obtain n2 from exist n2 N+ st {$is_tail_close_to(a, L2, abs(L1 - L2) / 3, n2)}
        have n0 N+ = finite_set_max(union({n1}, {n2}))
        n0 >= n1
        n0 >= n2
        abs(a(n0) - L1) < abs(L1 - L2) / 3
        abs(a(n0) - L2) < abs(L1 - L2) / 3
        abs(L1 - a(n0)) = abs(a(n0) - L1)
        L1 - L2 = (L1 - a(n0)) + (a(n0) - L2)
        abs(L1 - L2) = abs((L1 - a(n0)) + (a(n0) - L2)) <= abs(L1 - a(n0)) + abs(a(n0) - L2)
        abs(L1 - L2) / 3 + abs(L1 - L2) / 3 = 2 * abs(L1 - L2) / 3 < 3 * abs(L1 - L2) / 3 = abs(L1 - L2)
        abs(L1 - a(n0)) + abs(a(n0) - L2) = abs(a(n0) - L1) + abs(a(n0) - L2) < abs(L1 - L2) / 3 + abs(L1 - L2) / 3 < abs(L1 - L2)
        abs(L1 - L2) <= abs(L1 - a(n0)) + abs(a(n0) - L2) < abs(L1 - L2)
        impossible abs(L1 - L2) = abs(L1 - L2)

thm series_sum_unique:
    ? forall a seq(R), L1, L2 R:
        $has_series_sum(a, L1)
        $has_series_sum(a, L2)
        =>:
            L1 = L2
    by thm sequence_limit_unique(fn(k N+) R {partial_sum(a, k)}, L1, L2) => L1 = L2

have fn one_term_sequence(x R, n N+) R by cases:
    case n = 1: x
    case n > 1: 0

have fn two_term_sequence(x, y R, n N+) R by cases:
    case n = 1: x
    case n > 1: one_term_sequence(y, n - 1)

thm real_add_zero:
    ? forall value R:
        value + 0 = value

# The padded two-term sequence has partial sums x+y from index two onward, so
# its series converges by an explicit eventually-constant tail proof.
thm two_term_series_has_sum:
    ? forall x, y R:
        $has_series_sum(fn(n N+) R {two_term_sequence(x, y, n)}, x + y)
    claim:
        ? forall k N+:
            partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) = x + y
        by induc k from 1:
            ? partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) = x + y
            ? from k = 1:
                two_term_sequence(x, y, 1) = x
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 0) = 0
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 0) + fn(n N+) R {two_term_sequence(x, y, n)}(1) = 0 + x = x
                two_term_sequence(x, y, 2) = one_term_sequence(y, 1) = y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 2) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 1) + fn(n N+) R {two_term_sequence(x, y, n)}(2) = x + y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 1 + 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 2) = x + y
            ? induc:
                k + 1 > 1
                one_term_sequence(y, k + 1) = 0
                two_term_sequence(x, y, k + 2) = one_term_sequence(y, k + 1) = 0
                (k + 2) - 1 = k + 1
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 2) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 2) - 1) + fn(n N+) R {two_term_sequence(x, y, n)}(k + 2)
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 2) - 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1)
                fn(n N+) R {two_term_sequence(x, y, n)}(k + 2) = two_term_sequence(x, y, k + 2) = 0
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 2) - 1) + fn(n N+) R {two_term_sequence(x, y, n)}(k + 2) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) + 0
                by thm real_add_zero(partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1)) => partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) + 0 = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1)
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) + 0 = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) = x + y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 2) = x + y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 1) + 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 2) = x + y
    claim:
        ? $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y)
        claim:
            ? forall epsilon R+:
                exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y, epsilon, n0)}
            witness exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y, epsilon, n0)} from 2:
                claim:
                    ? forall n N+:
                        n >= 2
                        =>:
                            abs(fn(k N+) R {partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, k)}(n) - (x + y)) < epsilon
                    n > 1
                    n - 1 $in N+
                    have predecessor N+ = n - 1
                    predecessor = n - 1
                    predecessor + 1 = (n - 1) + 1 = n
                    partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, predecessor + 1) = x + y
                    fn(k N+) R {partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, k)}(n) = partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, n) = x + y
                    abs(fn(k N+) R {partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, k)}(n) - (x + y)) = abs(0) = 0 < epsilon
                by def $is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y, epsilon, 2)
        by def $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y)
    by def $has_series_sum(fn(n N+) R {two_term_sequence(x, y, n)}, x + y)

# Pad two events by empty events so the countable Kolmogorov axiom can be
# specialized to a binary union.
template<Omega set, events power_set(power_set(Omega))>:
    have fn two_event_sequence(A, B events, n N+: {} $in events) events by cases:
        case n = 1: A
        case n = 2: B
        case n > 2: {}

# Every event is a subset of the sample space by the exact carrier of `events`.
thm event_is_subset_of_sample_space:
    ? forall Omega set, events power_set(power_set(Omega)), A events:
        A $subset Omega
    events $subset power_set(Omega)
    A $in power_set(Omega)
    by def:
        ? A $subset Omega

# Extensionality shows that the padded sequence contains exactly A, B, and then
# empty events, so its countable union is A union B.
thm two_event_sequence_countable_union:
    ? forall [SigmaAlgebraSetting(union_Omega, union_events)], A, B union_events:
        index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)}) = union(A, B)
    let two_events = \two_event_sequence<union_Omega, union_events>
    by extension:
        ? index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)}) = union(A, B)
        claim:
            ? forall point index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)}):
                point $in union(A, B)
            obtain idx from exist idx N+ st {point $in two_events(A, B, idx)}
            idx = 1 or idx > 1
            by cases:
                ? point $in union(A, B)
                case idx = 1:
                    two_events(A, B, idx) = A
                    point $in A
                    point $in union(A, B)
                case idx > 1:
                    idx - 1 $in N+
                    idx - 1 = 1 or idx - 1 > 1
                    by cases:
                        ? point $in union(A, B)
                        case idx - 1 = 1:
                            idx = (idx - 1) + 1 = 1 + 1 = 2
                            two_events(A, B, idx) = B
                            point $in B
                            point $in union(A, B)
                        case idx - 1 > 1:
                            (idx - 1) + 1 > 1 + 1
                            idx = (idx - 1) + 1
                            1 + 1 = 2
                            idx > 2
                            two_events(A, B, idx) = {}
                            point $in {}
                            impossible point $in {}
        claim:
            ? forall point union(A, B):
                point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)})
            point $in A or point $in B
            by cases:
                ? point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)})
                case point $in A:
                    by thm event_is_subset_of_sample_space(union_Omega, union_events, A) => A $subset union_Omega
                    point $in union_Omega
                    two_events(A, B, 1) = A
                    point $in two_events(A, B, 1)
                    witness exist idx N+ st {point $in two_events(A, B, idx)} from 1
                    point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)})
                case point $in B:
                    by thm event_is_subset_of_sample_space(union_Omega, union_events, B) => B $subset union_Omega
                    point $in union_Omega
                    two_events(A, B, 2) = B
                    point $in two_events(A, B, 2)
                    witness exist idx N+ st {point $in two_events(A, B, idx)} from 2
                    point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)})
    index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)}) = index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {two_events(A, B, n)}) = union(A, B)

# If A and B are disjoint, a finite index case split proves the padded event
# sequence pairwise disjoint, including all empty tail terms.
thm two_event_sequence_pairwise_disjoint:
    ? forall [SigmaAlgebraSetting(disjoint_Omega, disjoint_events)], A, B disjoint_events:
        intersect(A, B) = {}
        =>:
            $pairwise_disjoint_event_sequence(disjoint_Omega, disjoint_events, fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)})
    let two_events = \two_event_sequence<disjoint_Omega, disjoint_events>
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
        idx = 1 or idx > 1
        j = 1 or j > 1
        by cases:
            ? intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
            case idx = 1:
                by cases:
                    ? intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
                    case j = 1:
                        idx = j
                        impossible idx != j
                    case j > 1:
                        j - 1 $in N+
                        j - 1 = 1 or j - 1 > 1
                        by cases:
                            ? intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
                            case j - 1 = 1:
                                j = (j - 1) + 1 = 1 + 1 = 2
                                two_events(A, B, idx) = A
                                two_events(A, B, j) = B
                                intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = intersect(A, B) = {}
                            case j - 1 > 1:
                                (j - 1) + 1 > 1 + 1
                                j = (j - 1) + 1
                                1 + 1 = 2
                                j > 2
                                two_events(A, B, idx) = A
                                two_events(A, B, j) = {}
                                intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = intersect(A, {}) = {}
            case idx > 1:
                idx - 1 $in N+
                idx - 1 = 1 or idx - 1 > 1
                by cases:
                    ? intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
                    case idx - 1 = 1:
                        idx = (idx - 1) + 1 = 1 + 1 = 2
                        two_events(A, B, idx) = B
                        by cases:
                            ? intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
                            case j = 1:
                                two_events(A, B, j) = A
                                intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = intersect(B, A) = intersect(A, B) = {}
                            case j > 1:
                                j - 1 $in N+
                                j - 1 = 1 or j - 1 > 1
                                by cases:
                                    ? intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
                                    case j - 1 = 1:
                                        idx = (idx - 1) + 1 = 1 + 1 = 2
                                        j = (j - 1) + 1 = 1 + 1 = 2
                                        idx = j
                                        impossible idx != j
                                    case j - 1 > 1:
                                        (j - 1) + 1 > 1 + 1
                                        j = (j - 1) + 1
                                        1 + 1 = 2
                                        j > 2
                                        two_events(A, B, j) = {}
                                        intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = intersect(B, {}) = {}
                    case idx - 1 > 1:
                        (idx - 1) + 1 > 1 + 1
                        idx = (idx - 1) + 1
                        1 + 1 = 2
                        idx > 2
                        two_events(A, B, idx) = {}
                        intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = intersect({}, fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
    by def $pairwise_disjoint_event_sequence(disjoint_Omega, disjoint_events, fn(n N+) disjoint_events {two_events(A, B, n)})
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
        fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx) = two_events(A, B, idx)
        fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j) = two_events(A, B, j)
        intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = intersect(fn(n N+) disjoint_events {two_events(A, B, n)}(idx), fn(n N+) disjoint_events {two_events(A, B, n)}(j)) = {}
    by def $pairwise_disjoint_event_sequence(disjoint_Omega, disjoint_events, fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)})

# Evaluate probability term by term: the first two values are P(A), P(B), and
# every later empty-event value is zero.
thm probability_of_two_event_sequence:
    ? forall [ProbabilitySpaceSetting(sequence_Omega, sequence_events, sequence_probability)], A, B sequence_events, n N+:
        sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
    let two_events = \two_event_sequence<sequence_Omega, sequence_events>
    n = 1 or n > 1
    by cases:
        ? sequence_probability(two_events(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
        case n = 1:
            two_events(A, B, n) = A
            two_term_sequence(sequence_probability(A), sequence_probability(B), n) = sequence_probability(A)
            sequence_probability(two_events(A, B, n)) = sequence_probability(A) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
        case n > 1:
            n - 1 $in N+
            n - 1 = 1 or n - 1 > 1
            by cases:
                ? sequence_probability(two_events(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
                case n - 1 = 1:
                    n = (n - 1) + 1 = 1 + 1 = 2
                    two_events(A, B, n) = B
                    one_term_sequence(sequence_probability(B), n - 1) = sequence_probability(B)
                    two_term_sequence(sequence_probability(A), sequence_probability(B), n) = one_term_sequence(sequence_probability(B), n - 1) = sequence_probability(B)
                    sequence_probability(two_events(A, B, n)) = sequence_probability(B) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
                case n - 1 > 1:
                    (n - 1) + 1 > 1 + 1
                    n = (n - 1) + 1
                    1 + 1 = 2
                    n > 2
                    two_events(A, B, n) = {}
                    sequence_probability(two_events(A, B, n)) = sequence_probability({}) = 0
                    one_term_sequence(sequence_probability(B), n - 1) = 0
                    two_term_sequence(sequence_probability(A), sequence_probability(B), n) = one_term_sequence(sequence_probability(B), n - 1) = 0
                    sequence_probability(two_events(A, B, n)) = 0 = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
    sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = sequence_probability(two_events(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)

# Induction transports pointwise equality through every finite partial sum.
thm pointwise_equal_sequences_have_equal_partial_sums:
    ? forall a, b seq(R), k N:
        forall n N+:
            a(n) = b(n)
        =>:
            partial_sum(a, k) = partial_sum(b, k)
    by induc k from 0:
        ? partial_sum(a, k) = partial_sum(b, k)
        ? from k = 0:
            partial_sum(a, 0) = 0
            partial_sum(b, 0) = 0
        ? induc:
            k + 1 $in N+
            a(k + 1) = b(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(b, k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k) + a(k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k + 1) = partial_sum(b, k + 1)

# Equal partial sums let one sequence reuse the other sequence's epsilon-tail
# witness for the same series sum.
thm pointwise_equal_sequences_preserve_series_sum:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $has_series_sum(b, L)
        =>:
            $has_series_sum(a, L)
    claim:
        ? $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L)
        claim:
            ? forall epsilon R+:
                exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, n0)}
            obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(b, k)}, L, epsilon, n0)}
            witness exist candidate_index N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, candidate_index)} from n0:
                claim:
                    ? forall tail_index N+:
                        tail_index >= n0
                        =>:
                            abs(fn(k N+) R {partial_sum(a, k)}(tail_index) - L) < epsilon
                    by thm pointwise_equal_sequences_have_equal_partial_sums(a, b, tail_index) => partial_sum(a, tail_index) = partial_sum(b, tail_index)
                    fn(k N+) R {partial_sum(a, k)}(tail_index) = partial_sum(a, tail_index)
                    fn(k N+) R {partial_sum(b, k)}(tail_index) = partial_sum(b, tail_index)
                    abs(fn(k N+) R {partial_sum(a, k)}(tail_index) - L) = abs(fn(k N+) R {partial_sum(b, k)}(tail_index) - L) < epsilon
                by def $is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, n0)
        by def $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L)
    by def $has_series_sum(a, L)

# Combine termwise probability evaluation with the two-term series theorem.
thm two_event_probability_series_has_sum:
    ? forall [ProbabilitySpaceSetting(series_Omega, series_events, series_probability)], A, B series_events:
        $has_series_sum(fn(n N+) R {series_probability(\two_event_sequence<series_Omega, series_events>(A, B, n))}, series_probability(A) + series_probability(B))
    let two_events = \two_event_sequence<series_Omega, series_events>
    have probability_terms seq(R) = fn(n N+) R {series_probability(two_events(A, B, n))}
    claim:
        ? forall term_index N+:
            probability_terms(term_index) = two_term_sequence(series_probability(A), series_probability(B), term_index)
        probability_terms(term_index) = series_probability(two_events(A, B, term_index))
        term_index = 1 or term_index > 1
        by cases:
            ? probability_terms(term_index) = two_term_sequence(series_probability(A), series_probability(B), term_index)
            case term_index = 1:
                two_events(A, B, term_index) = A
                two_term_sequence(series_probability(A), series_probability(B), term_index) = series_probability(A)
                probability_terms(term_index) = series_probability(two_events(A, B, term_index)) = series_probability(A) = two_term_sequence(series_probability(A), series_probability(B), term_index)
            case term_index > 1:
                term_index - 1 $in N+
                term_index - 1 = 1 or term_index - 1 > 1
                by cases:
                    ? probability_terms(term_index) = two_term_sequence(series_probability(A), series_probability(B), term_index)
                    case term_index - 1 = 1:
                        term_index = (term_index - 1) + 1 = 1 + 1 = 2
                        two_events(A, B, term_index) = B
                        one_term_sequence(series_probability(B), term_index - 1) = series_probability(B)
                        two_term_sequence(series_probability(A), series_probability(B), term_index) = one_term_sequence(series_probability(B), term_index - 1) = series_probability(B)
                        probability_terms(term_index) = series_probability(two_events(A, B, term_index)) = series_probability(B) = two_term_sequence(series_probability(A), series_probability(B), term_index)
                    case term_index - 1 > 1:
                        (term_index - 1) + 1 > 1 + 1
                        term_index = (term_index - 1) + 1
                        1 + 1 = 2
                        term_index > 2
                        two_events(A, B, term_index) = {}
                        series_probability(two_events(A, B, term_index)) = series_probability({}) = 0
                        one_term_sequence(series_probability(B), term_index - 1) = 0
                        two_term_sequence(series_probability(A), series_probability(B), term_index) = one_term_sequence(series_probability(B), term_index - 1) = 0
                        probability_terms(term_index) = series_probability(two_events(A, B, term_index)) = 0 = two_term_sequence(series_probability(A), series_probability(B), term_index)
    by thm two_term_series_has_sum(series_probability(A), series_probability(B)) => $has_series_sum(fn(n N+) R {two_term_sequence(series_probability(A), series_probability(B), n)}, series_probability(A) + series_probability(B))
    by thm pointwise_equal_sequences_preserve_series_sum(probability_terms, fn(n N+) R {two_term_sequence(series_probability(A), series_probability(B), n)}, series_probability(A) + series_probability(B)) => $has_series_sum(probability_terms, series_probability(A) + series_probability(B))
    probability_terms = fn(n N+) R {series_probability(two_events(A, B, n))}
    $has_series_sum(fn(n N+) R {series_probability(\two_event_sequence<series_Omega, series_events>(A, B, n))}, series_probability(A) + series_probability(B))

thm event_countable_union_is_event:
    ? forall [SigmaAlgebraSetting], event_sequence fn(n N+) events:
        index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)}) $in events

# Main tracer: binary finite additivity is derived from countable additivity;
# it is not added as a fourth probability axiom.
thm probability_of_disjoint_union:
    ? forall [ProbabilitySpaceSetting(union_probability_Omega, union_probability_events, union_probability)], A, B union_probability_events:
        intersect(A, B) = {}
        =>:
            union(A, B) $in union_probability_events
            union_probability(union(A, B)) = union_probability(A) + union_probability(B)
    let two_events = \two_event_sequence<union_probability_Omega, union_probability_events>
    let event_union = index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {two_events(A, B, n)})
    let probability_terms = fn(n N+) R {union_probability(two_events(A, B, n))}
    by thm two_event_sequence_countable_union(union_probability_Omega, union_probability_events, A, B) => event_union = union(A, B)
    by thm event_countable_union_is_event(union_probability_Omega, union_probability_events, fn(n N+) union_probability_events {two_events(A, B, n)}) => index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {two_events(A, B, n)}) $in union_probability_events
    union(A, B) $in union_probability_events
    by thm two_event_sequence_pairwise_disjoint(union_probability_Omega, union_probability_events, A, B) => $pairwise_disjoint_event_sequence(union_probability_Omega, union_probability_events, fn(n N+) union_probability_events {two_events(A, B, n)})
    release thm kolmogorov_countable_additivity(union_probability_Omega, union_probability_events, union_probability, fn(n N+) union_probability_events {two_events(A, B, n)})
    by thm two_event_probability_series_has_sum(union_probability_Omega, union_probability_events, union_probability, A, B) => $has_series_sum(fn(n N+) R {union_probability(two_events(A, B, n))}, union_probability(A) + union_probability(B))
    by thm series_sum_unique(probability_terms, union_probability(event_union), union_probability(A) + union_probability(B)) => union_probability(event_union) = union_probability(A) + union_probability(B)
    union_probability(union(A, B)) = union_probability(event_union) = union_probability(A) + union_probability(B)

# Complement partitions and relative complements support the ordinary event
# probability calculus.
# A subset and its complement inside Omega have no common element.
thm subset_intersect_complement_is_empty:
    ? forall Omega set, A power_set(Omega):
        intersect(A, set_minus(Omega, A)) = {}

# Every point of Omega lies either in A or in its relative complement.
thm subset_union_complement_is_universe:
    ? forall Omega set, A power_set(Omega):
        union(A, set_minus(Omega, A)) = Omega
    A $subset Omega
    union(A, set_minus(Omega, A)) = union(A, Omega)
    union(A, Omega) = Omega
    union(A, set_minus(Omega, A)) = Omega

# Apply finite additivity to the partition Omega = A union (Omega minus A).
thm probability_of_event_complement:
    ? forall [ProbabilitySpaceSetting], A events:
        probability(set_minus(Omega, A)) = 1 - probability(A)
    by thm event_is_subset_of_sample_space(Omega, events, A) => A $subset Omega
    A $in power_set(Omega)
    set_minus(Omega, A) $in events
    by thm subset_intersect_complement_is_empty(Omega, A) => intersect(A, set_minus(Omega, A)) = {}
    by thm subset_union_complement_is_universe(Omega, A) => union(A, set_minus(Omega, A)) = Omega
    by thm probability_of_disjoint_union(Omega, events, probability, A, set_minus(Omega, A)) => probability(union(A, set_minus(Omega, A))) = probability(A) + probability(set_minus(Omega, A))
    probability(Omega) = probability(union(A, set_minus(Omega, A))) = probability(A) + probability(set_minus(Omega, A))
    1 = probability(Omega) = probability(A) + probability(set_minus(Omega, A))
    probability(set_minus(Omega, A)) = 1 - probability(A)

# Rewrite A minus B as A intersected with the complement of B in Omega.
thm relative_complement_as_intersection:
    ? forall Omega set, A, B power_set(Omega):
        set_minus(A, B) = intersect(A, set_minus(Omega, B))
    by extension:
        ? set_minus(A, B) = intersect(A, set_minus(Omega, B))
        claim:
            ? forall point set_minus(A, B):
                point $in intersect(A, set_minus(Omega, B))
            point $in A
            not point $in B
            A $subset Omega
            point $in Omega
            point $in set_minus(Omega, B)
            point $in intersect(A, set_minus(Omega, B))
        claim:
            ? forall point intersect(A, set_minus(Omega, B)):
                point $in set_minus(A, B)
            point $in A
            point $in set_minus(Omega, B)
            not point $in B
            point $in set_minus(A, B)

# Sigma-algebra closure under complements and intersections makes A minus B
# an event.
thm event_difference_is_event:
    ? forall [SigmaAlgebraSetting], A, B events:
        set_minus(A, B) $in events
    by thm event_is_subset_of_sample_space(Omega, events, A) => A $subset Omega
    by thm event_is_subset_of_sample_space(Omega, events, B) => B $subset Omega
    A $in power_set(Omega)
    B $in power_set(Omega)
    set_minus(Omega, B) $in events
    intersect(A, set_minus(Omega, B)) $in events
    by thm relative_complement_as_intersection(Omega, A, B) => set_minus(A, B) = intersect(A, set_minus(Omega, B))
    set_minus(A, B) $in events

# When B is contained in A, the disjoint partition A = B union (A minus B)
# gives the subtraction formula for probabilities.
thm probability_of_difference_under_subset:
    ? forall [ProbabilitySpaceSetting], A, B events:
        B $subset A
        =>:
            set_minus(A, B) $in events
            probability(set_minus(A, B)) = probability(A) - probability(B)
    by thm event_difference_is_event(Omega, events, A, B) => set_minus(A, B) $in events
    B $in power_set(A)
    by thm subset_intersect_complement_is_empty(A, B) => intersect(B, set_minus(A, B)) = {}
    by thm subset_union_complement_is_universe(A, B) => union(B, set_minus(A, B)) = A
    by thm probability_of_disjoint_union(Omega, events, probability, B, set_minus(A, B)) => probability(union(B, set_minus(A, B))) = probability(B) + probability(set_minus(A, B))
    probability(A) = probability(union(B, set_minus(A, B))) = probability(B) + probability(set_minus(A, B))
    probability(set_minus(A, B)) = probability(A) - probability(B)

# Nonnegativity of P(B minus A) yields monotonicity under A subset B.
thm probability_mono:
    ? forall [ProbabilitySpaceSetting], A, B events:
        A $subset B
        =>:
            probability(A) <= probability(B)
    release thm probability_of_difference_under_subset(Omega, events, probability, B, A)
    set_minus(B, A) $in events
    probability(set_minus(B, A)) = probability(B) - probability(A)
    probability(set_minus(B, A)) >= 0
    probability(B) - probability(A) >= 0
    probability(A) <= probability(B)

# A is disjoint from the portion of B lying outside A.
thm set_intersect_relative_complement_is_empty:
    ? forall A, B set:
        intersect(A, set_minus(B, A)) = {}

# Decompose A union B into the disjoint pieces A and B minus A.
thm union_with_relative_complement:
    ? forall A, B set:
        union(A, set_minus(B, A)) = union(A, B)

# Removing A intersect B from B is the same as removing all of A from B.
thm remove_intersection_equals_remove_set:
    ? forall A, B set:
        set_minus(B, intersect(A, B)) = set_minus(B, A)

# Use the disjoint decomposition A union (B minus A), then express the second
# term as P(B)-P(A intersect B).
thm probability_inclusion_exclusion:
    ? forall [ProbabilitySpaceSetting], A, B events:
        union(A, B) $in events
        probability(union(A, B)) = probability(A) + probability(B) - probability(intersect(A, B))
    by thm event_difference_is_event(Omega, events, B, A) => set_minus(B, A) $in events
    by thm set_intersect_relative_complement_is_empty(A, B) => intersect(A, set_minus(B, A)) = {}
    by thm union_with_relative_complement(A, B) => union(A, set_minus(B, A)) = union(A, B)
    release thm probability_of_disjoint_union(Omega, events, probability, A, set_minus(B, A))
    union(A, set_minus(B, A)) $in events
    probability(union(A, set_minus(B, A))) = probability(A) + probability(set_minus(B, A))
    union(A, B) $in events
    intersect(A, B) $in events
    intersect(A, B) $subset B
    release thm probability_of_difference_under_subset(Omega, events, probability, B, intersect(A, B))
    probability(set_minus(B, intersect(A, B))) = probability(B) - probability(intersect(A, B))
    by thm remove_intersection_equals_remove_set(A, B) => set_minus(B, intersect(A, B)) = set_minus(B, A)
    probability(set_minus(B, A)) = probability(set_minus(B, intersect(A, B))) = probability(B) - probability(intersect(A, B))
    probability(union(A, B)) = probability(union(A, set_minus(B, A))) = probability(A) + probability(set_minus(B, A)) = probability(A) + (probability(B) - probability(intersect(A, B))) = probability(A) + probability(B) - probability(intersect(A, B))

# Drop the nonnegative intersection term from inclusion-exclusion.
thm probability_union_bound:
    ? forall [ProbabilitySpaceSetting], A, B events:
        union(A, B) $in events
        probability(union(A, B)) <= probability(A) + probability(B)
    release thm probability_inclusion_exclusion(Omega, events, probability, A, B)
    union(A, B) $in events
    probability(union(A, B)) = probability(A) + probability(B) - probability(intersect(A, B))
    intersect(A, B) $in events
    probability(intersect(A, B)) >= 0
    probability(A) + probability(B) - probability(intersect(A, B)) <= probability(A) + probability(B)
    probability(union(A, B)) <= probability(A) + probability(B)

thm probability_between_zero_and_one:
    ? forall [ProbabilitySpaceSetting], A events:
        0 <= probability(A)
        probability(A) <= 1
    probability(A) >= 0
    by thm event_is_subset_of_sample_space(Omega, events, A) => A $subset Omega
    by thm probability_mono(Omega, events, probability, A, Omega) => probability(A) <= probability(Omega)
    probability(A) <= probability(Omega) = 1

# Countable event limits, continuity, null events, Borel--Cantelli, and
# concrete probability-measure constructions. This layer stays entirely on
# events and real series: it does not assume an integral or extended reals.
template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn complement_event_sequence(family fn (family_index N+) events, n N+) events = set_minus(Omega, family(n))

thm relative_complement_involution:
    ? forall Omega set, A power_set(Omega):
        set_minus(Omega, set_minus(Omega, A)) = A

thm complement_of_index_union:
    ? forall index_set, Omega set, family fn (index index_set) power_set(Omega):
        set_minus(Omega, index_union(index_set, Omega, family)) = index_intersect(index_set, Omega, fn (index index_set) power_set(Omega) {set_minus(Omega, family(index))})

thm event_countable_intersection_is_event:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        =>:
            index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}) $in events
    by thm event_countable_union_is_event(Omega, events, fn (n N+) events {set_minus(Omega, event_sequence(n))}) => index_union(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, event_sequence(n))}) $in events
    have complement_union events = set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, event_sequence(n))}))
    have double_complement_intersection power_set(Omega) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, set_minus(Omega, event_sequence(n)))})
    have source_intersection power_set(Omega) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    by thm complement_of_index_union(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, event_sequence(n))}) => set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, event_sequence(n))})) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, set_minus(Omega, event_sequence(n)))})
    complement_union = double_complement_intersection
    claim:
        ? forall n N+:
            set_minus(Omega, set_minus(Omega, event_sequence(n))) = event_sequence(n)
        by thm event_is_subset_of_sample_space(Omega, events, event_sequence(n)) => event_sequence(n) $subset Omega
        event_sequence(n) $in power_set(Omega)
        by thm relative_complement_involution(Omega, event_sequence(n)) => set_minus(Omega, set_minus(Omega, event_sequence(n))) = event_sequence(n)
    index_intersect(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, set_minus(Omega, event_sequence(n)))}) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    double_complement_intersection = source_intersection
    complement_union = source_intersection
    source_intersection $in events
    source_intersection = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}) $in events

template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn event_tail_union_after by exist!:
        ? forall event_sequence fn (sequence_index N+) events, skipped N:
            exist! tail events st {tail = index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})}
        by thm event_countable_union_is_event(Omega, events, fn (offset N+) events {event_sequence(skipped + offset)}) => index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}) $in events
        witness exist! tail events st {tail = index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})} from index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}):
            claim:
                ? forall tail1, tail2 events:
                    tail1 = index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})
                    tail2 = index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})
                    =>:
                        tail1 = tail2
                tail1 = index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}) = tail2

template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn event_tail_intersection_after by exist!:
        ? forall event_sequence fn (sequence_index N+) events, skipped N:
            exist! tail events st {tail = index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})}
        by thm event_countable_intersection_is_event(Omega, events, fn (offset N+) events {event_sequence(skipped + offset)}) => index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}) $in events
        witness exist! tail events st {tail = index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})} from index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}):
            claim:
                ? forall tail1, tail2 events:
                    tail1 = index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})
                    tail2 = index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})
                    =>:
                        tail1 = tail2
                tail1 = index_intersect(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}) = tail2

template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn event_limsup by exist!:
        ? forall event_sequence fn (sequence_index N+) events:
            exist! limsup_event events st {limsup_event = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)})}
        by thm event_countable_intersection_is_event(Omega, events, fn (n N+) events {\event_tail_union_after<Omega, events>(event_sequence, n - 1)}) => index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)}) $in events
        witness exist! limsup_event events st {limsup_event = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)})} from index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)}):
            claim:
                ? forall candidate1, candidate2 events:
                    candidate1 = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)})
                    candidate2 = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)})
                    =>:
                        candidate1 = candidate2
                candidate1 = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_union_after<Omega, events>(event_sequence, n - 1)}) = candidate2

template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn event_liminf by exist!:
        ? forall event_sequence fn (sequence_index N+) events:
            exist! liminf_event events st {liminf_event = index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)})}
        by thm event_countable_union_is_event(Omega, events, fn (n N+) events {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)}) => index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)}) $in events
        witness exist! liminf_event events st {liminf_event = index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)})} from index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)}):
            claim:
                ? forall candidate1, candidate2 events:
                    candidate1 = index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)})
                    candidate2 = index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)})
                    =>:
                        candidate1 = candidate2
                candidate1 = index_union(N+, Omega, fn (n N+) power_set(Omega) {\event_tail_intersection_after<Omega, events>(event_sequence, n - 1)}) = candidate2

prop is_increasing_event_sequence(Omega set, events power_set(power_set(Omega)), event_sequence fn (sequence_index N+) events):
    forall n N+:
        event_sequence(n) $subset event_sequence(n + 1)

prop is_decreasing_event_sequence(Omega set, events power_set(power_set(Omega)), event_sequence fn (sequence_index N+) events):
    forall n N+:
        event_sequence(n + 1) $subset event_sequence(n)

thm pointwise_equal_sequences_preserve_limit:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $has_sequence_limit(b, L)
        =>:
            $has_sequence_limit(a, L)
    by def $has_sequence_limit(b, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(b, L, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(a, L, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(b, L, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (a(tail_index) - L) < epsilon
                a(tail_index) = b(tail_index)
                abs (a(tail_index) - L) = abs (b(tail_index) - L) < epsilon
            by def $is_tail_close_to(a, L, epsilon, n0)
    by def $has_sequence_limit(a, L)

prop is_probability_disjointification_of(Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence, increments fn (sequence_index N+) events):
    $pairwise_disjoint_event_sequence(Omega, events, increments)
    index_union(N+, Omega, fn (n N+) power_set(Omega) {increments(n)}) = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    forall k N+:
        partial_sum(fn (n N+) R {probability(increments(n))}, k) = probability(event_sequence(k))

thm equal_values_preserve_sequence_limit:
    ? forall a seq(R), L1, L2 R:
        L1 = L2
        $has_sequence_limit(a, L1)
        =>:
            $has_sequence_limit(a, L2)
    by def $has_sequence_limit(a, L1)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(a, L2, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L1, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(a, L2, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(a, L1, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (a(tail_index) - L2) < epsilon
                abs (a(tail_index) - L2) = abs (a(tail_index) - L1) < epsilon
            by def $is_tail_close_to(a, L2, epsilon, n0)
    by def $has_sequence_limit(a, L2)

template<Omega set, events power_set(power_set(Omega))>:
    have fn raw_increasing_event_increment(event_sequence fn (sequence_index N+) events, n N+) power_set(union(event_sequence(1), event_sequence(n))) by cases :
        case n = 1: event_sequence(1)
        case n > 1: set_minus(event_sequence(n), event_sequence(n - 1))
thm raw_increasing_event_increment_is_event:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (sequence_index N+) events, n N+:
        $is_sigma_algebra(Omega, events)
        =>:
            \raw_increasing_event_increment<Omega, events>(event_sequence, n) $in events
    let raw_increment = \raw_increasing_event_increment<Omega, events>
    n = 1 or n > 1
    by cases:
        ? raw_increment(event_sequence, n) $in events
        case n = 1:
            raw_increment(event_sequence, n) = event_sequence(1)
            event_sequence(1) $in events
        case n > 1:
            raw_increment(event_sequence, n) = set_minus(event_sequence(n), event_sequence(n - 1))
            by thm event_difference_is_event(Omega, events, event_sequence(n), event_sequence(n - 1)) => set_minus(event_sequence(n), event_sequence(n - 1)) $in events
template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn increasing_event_increment by exist!:
        ? forall event_sequence fn (sequence_index N+) events, n N+:
            exist! increment events st {increment = \raw_increasing_event_increment<Omega, events>(event_sequence, n)}
        by thm raw_increasing_event_increment_is_event(Omega, events, event_sequence, n) => \raw_increasing_event_increment<Omega, events>(event_sequence, n) $in events
        witness exist! increment events st {increment = \raw_increasing_event_increment<Omega, events>(event_sequence, n)} from \raw_increasing_event_increment<Omega, events>(event_sequence, n):
            \raw_increasing_event_increment<Omega, events>(event_sequence, n) = \raw_increasing_event_increment<Omega, events>(event_sequence, n)
            claim:
                ? forall increment1, increment2 events:
                    increment1 = \raw_increasing_event_increment<Omega, events>(event_sequence, n)
                    increment2 = \raw_increasing_event_increment<Omega, events>(event_sequence, n)
                    =>:
                        increment1 = increment2
                increment1 = \raw_increasing_event_increment<Omega, events>(event_sequence, n) = increment2

thm subset_transitive:
    ? forall left_set, middle_set, right_set set:
        left_set $subset middle_set
        middle_set $subset right_set
        =>:
            left_set $subset right_set
thm increasing_event_sequence_shift_mono:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events, start N+, offset N:
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            event_sequence(start) $subset event_sequence(start + offset)
    by def $is_increasing_event_sequence(Omega, events, event_sequence)
    by induc offset from 0:
        ? event_sequence(start) $subset event_sequence(start + offset)
        ? from offset = 0:
            start + 0 = start
            event_sequence(start) $subset event_sequence(start)
        ? induc:
            start + offset $in N+
            event_sequence(start + offset) $subset event_sequence(start + offset + 1)
            by thm subset_transitive(event_sequence(start), event_sequence(start + offset), event_sequence(start + offset + 1)) => event_sequence(start) $subset event_sequence(start + offset + 1)
            start + (offset + 1) = start + offset + 1
            event_sequence(start) $subset event_sequence(start + (offset + 1))

thm increasing_event_increment_is_subset:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (sequence_index N+) events, n N+:
        $is_sigma_algebra(Omega, events)
        =>:
            \increasing_event_increment<Omega, events>(event_sequence, n) $subset event_sequence(n)
    let increment = \increasing_event_increment<Omega, events>
    let raw_increment = \raw_increasing_event_increment<Omega, events>
    increment(event_sequence, n) = raw_increment(event_sequence, n)
    n = 1 or n > 1
    by cases:
        ? increment(event_sequence, n) $subset event_sequence(n)
        case n = 1:
            raw_increment(event_sequence, n) = event_sequence(1)
            event_sequence(1) = event_sequence(n)
            increment(event_sequence, n) = event_sequence(n)
            event_sequence(n) $subset event_sequence(n)
        case n > 1:
            raw_increment(event_sequence, n) = set_minus(event_sequence(n), event_sequence(n - 1))
            set_minus(event_sequence(n), event_sequence(n - 1)) $subset event_sequence(n)
            \increasing_event_increment<Omega, events>(event_sequence, n) $subset event_sequence(n)
thm increasing_event_increment_partitions_next:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (sequence_index N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            union(event_sequence(k), \increasing_event_increment<Omega, events>(event_sequence, k + 1)) = event_sequence(k + 1)
    let increment = \increasing_event_increment<Omega, events>
    by def $is_increasing_event_sequence(Omega, events, event_sequence)
    event_sequence(k) $subset event_sequence(k + 1)
    increment(event_sequence, k + 1) = \raw_increasing_event_increment<Omega, events>(event_sequence, k + 1)
    k + 1 > 1
    \raw_increasing_event_increment<Omega, events>(event_sequence, k + 1) = set_minus(event_sequence(k + 1), event_sequence((k + 1) - 1))
    (k + 1) - 1 = k
    increment(event_sequence, k + 1) = set_minus(event_sequence(k + 1), event_sequence(k))
    union(event_sequence(k), increment(event_sequence, k + 1)) = union(event_sequence(k), set_minus(event_sequence(k + 1), event_sequence(k)))
    union(event_sequence(k), set_minus(event_sequence(k + 1), event_sequence(k))) = union(event_sequence(k), event_sequence(k + 1))
    union(event_sequence(k), event_sequence(k + 1)) = event_sequence(k + 1)
    union(event_sequence(k), \increasing_event_increment<Omega, events>(event_sequence, k + 1)) = union(event_sequence(k), increment(event_sequence, k + 1)) = event_sequence(k + 1)

thm increasing_event_sequence_mono:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events, earlier, later N+:
        $is_increasing_event_sequence(Omega, events, event_sequence)
        earlier <= later
        =>:
            event_sequence(earlier) $subset event_sequence(later)
    later - earlier $in N
    earlier + (later - earlier) = later
    by thm increasing_event_sequence_shift_mono(Omega, events, event_sequence, earlier, later - earlier) => event_sequence(earlier) $subset event_sequence(earlier + (later - earlier))
    event_sequence(earlier) $subset event_sequence(later)

thm earlier_increasing_event_increment_disjoint_from_later:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events, earlier, later N+:
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        earlier < later
        =>:
            intersect(\increasing_event_increment<Omega, events>(event_sequence, earlier), \increasing_event_increment<Omega, events>(event_sequence, later)) = {}
    let increment = \increasing_event_increment<Omega, events>
    earlier >= 1
    later > earlier
    later > 1
    later - 1 $in N+
    earlier <= later - 1
    by thm increasing_event_increment_is_subset(Omega, events, event_sequence, earlier) => increment(event_sequence, earlier) $subset event_sequence(earlier)
    by thm increasing_event_sequence_mono(Omega, events, event_sequence, earlier, later - 1) => event_sequence(earlier) $subset event_sequence(later - 1)
    increment(event_sequence, earlier) $subset event_sequence(later - 1)
    increment(event_sequence, later) = \raw_increasing_event_increment<Omega, events>(event_sequence, later)
    \raw_increasing_event_increment<Omega, events>(event_sequence, later) = set_minus(event_sequence(later), event_sequence(later - 1))
    increment(event_sequence, later) = set_minus(event_sequence(later), event_sequence(later - 1))
    intersect(increment(event_sequence, earlier), set_minus(event_sequence(later), event_sequence(later - 1))) = {}
    intersect(\increasing_event_increment<Omega, events>(event_sequence, earlier), \increasing_event_increment<Omega, events>(event_sequence, later)) = intersect(increment(event_sequence, earlier), increment(event_sequence, later)) = intersect(increment(event_sequence, earlier), set_minus(event_sequence(later), event_sequence(later - 1))) = {}

thm equal_event_pairs_preserve_empty_intersection:
    ? forall left_event, right_event, source_left_event, source_right_event set:
        left_event = source_left_event
        right_event = source_right_event
        intersect(source_left_event, source_right_event) = {}
        =>:
            intersect(left_event, right_event) = {}
    by extension:
        ? intersect(left_event, right_event) = {}
        claim:
            ? forall point intersect(left_event, right_event):
                point $in {}
            point $in left_event
            point $in source_left_event
            point $in right_event
            point $in source_right_event
            point $in intersect(source_left_event, source_right_event)
            point $in {}
        claim:
            ? forall point {}:
                point $in intersect(left_event, right_event)
            by contra:
                ? point $in intersect(left_event, right_event)
                not point $in intersect(left_event, right_event)
                impossible point $in {}
thm increasing_event_increments_pairwise_disjoint:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events:
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            $pairwise_disjoint_event_sequence(Omega, events, fn (n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)})
    let increment = \increasing_event_increment<Omega, events>
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j)) = {}
        idx < j or idx >= j
        fn (n N+) events {increment(event_sequence, n)}(idx) = increment(event_sequence, idx)
        fn (n N+) events {increment(event_sequence, n)}(j) = increment(event_sequence, j)
        by cases:
            ? intersect(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j)) = {}
            case idx < j:
                by thm earlier_increasing_event_increment_disjoint_from_later(Omega, events, event_sequence, idx, j) => intersect(increment(event_sequence, idx), increment(event_sequence, j)) = {}
                by thm equal_event_pairs_preserve_empty_intersection(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j), increment(event_sequence, idx), increment(event_sequence, j)) => intersect(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j)) = {}
            case idx >= j:
                idx = j or idx > j
                by cases:
                    ? intersect(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j)) = {}
                    case idx = j:
                        impossible idx != j
                    case idx > j:
                        by thm earlier_increasing_event_increment_disjoint_from_later(Omega, events, event_sequence, j, idx) => intersect(increment(event_sequence, j), increment(event_sequence, idx)) = {}
                        intersect(increment(event_sequence, idx), increment(event_sequence, j)) = intersect(increment(event_sequence, j), increment(event_sequence, idx)) = {}
                        by thm equal_event_pairs_preserve_empty_intersection(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j), increment(event_sequence, idx), increment(event_sequence, j)) => intersect(fn (n N+) events {increment(event_sequence, n)}(idx), fn (n N+) events {increment(event_sequence, n)}(j)) = {}
    by def $pairwise_disjoint_event_sequence(Omega, events, fn (n N+) events {increment(event_sequence, n)})
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)}(idx), fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)}(j)) = {}
        fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)}(idx) = increment(event_sequence, idx)
        fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)}(j) = increment(event_sequence, j)
        intersect(fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)}(idx), fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)}(j)) = intersect(fn(n N+) events {increment(event_sequence, n)}(idx), fn(n N+) events {increment(event_sequence, n)}(j)) = {}
    by def $pairwise_disjoint_event_sequence(Omega, events, fn(n N+) events {\increasing_event_increment<Omega, events>(event_sequence, n)})

thm increasing_event_increment_union_covers_each_stage:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            event_sequence(k) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {\increasing_event_increment<Omega, events>(event_sequence, n)})
    let increment = \increasing_event_increment<Omega, events>
    by induc k from 1:
        ? event_sequence(k) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
        ? from k = 1:
            increment(event_sequence, 1) = \raw_increasing_event_increment<Omega, events>(event_sequence, 1)
            \raw_increasing_event_increment<Omega, events>(event_sequence, 1) = event_sequence(1)
            claim:
                ? forall point event_sequence(1):
                    point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
                point $in increment(event_sequence, 1)
                witness exist candidate_index N+ st {point $in increment(event_sequence, candidate_index)} from 1
                point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
            by def event_sequence(1) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
        ? induc:
            by thm increasing_event_increment_partitions_next(Omega, events, event_sequence, k) => union(event_sequence(k), increment(event_sequence, k + 1)) = event_sequence(k + 1)
            claim:
                ? forall point event_sequence(k + 1):
                    point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
                point $in union(event_sequence(k), increment(event_sequence, k + 1))
                point $in event_sequence(k) or point $in increment(event_sequence, k + 1)
                by cases:
                    ? point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
                    case point $in event_sequence(k):
                        point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
                    case point $in increment(event_sequence, k + 1):
                        witness exist candidate_index N+ st {point $in increment(event_sequence, candidate_index)} from k + 1
                        point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
            by def event_sequence(k + 1) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
    index_union(N+, Omega, fn(n N+) power_set(Omega) {increment(event_sequence, n)}) = index_union(N+, Omega, fn(n N+) power_set(Omega) {\increasing_event_increment<Omega, events>(event_sequence, n)})
    event_sequence(k) $subset index_union(N+, Omega, fn(n N+) power_set(Omega) {increment(event_sequence, n)})
    event_sequence(k) $subset index_union(N+, Omega, fn(n N+) power_set(Omega) {\increasing_event_increment<Omega, events>(event_sequence, n)})

thm increasing_event_increment_union_equals_source_union:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events:
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            index_union(N+, Omega, fn (n N+) power_set(Omega) {\increasing_event_increment<Omega, events>(event_sequence, n)}) = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    let increment = \increasing_event_increment<Omega, events>
    by extension:
        ? index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)}) = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
        claim:
            ? forall point index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)}):
                point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
            obtain index from exist index N+ st {point $in increment(event_sequence, index)}
            by thm increasing_event_increment_is_subset(Omega, events, event_sequence, index) => increment(event_sequence, index) $subset event_sequence(index)
            point $in event_sequence(index)
            witness exist candidate_index N+ st {point $in event_sequence(candidate_index)} from index
            point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
        claim:
            ? forall point index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}):
                point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
            obtain index from exist index N+ st {point $in event_sequence(index)}
            by thm increasing_event_increment_union_covers_each_stage(Omega, events, event_sequence, index) => event_sequence(index) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
            point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {increment(event_sequence, n)})
    index_union(N+, Omega, fn(n N+) power_set(Omega) {\increasing_event_increment<Omega, events>(event_sequence, n)}) = index_union(N+, Omega, fn(n N+) power_set(Omega) {increment(event_sequence, n)}) = index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)})

thm previous_event_disjoint_from_next_increment:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            intersect(event_sequence(k), \increasing_event_increment<Omega, events>(event_sequence, k + 1)) = {}
    let increment = \increasing_event_increment<Omega, events>
    by def $is_increasing_event_sequence(Omega, events, event_sequence)
    event_sequence(k) $subset event_sequence(k + 1)
    by thm subset_intersect_complement_is_empty(event_sequence(k + 1), event_sequence(k)) => intersect(event_sequence(k), set_minus(event_sequence(k + 1), event_sequence(k))) = {}
    increment(event_sequence, k + 1) = \raw_increasing_event_increment<Omega, events>(event_sequence, k + 1)
    k + 1 > 1
    \raw_increasing_event_increment<Omega, events>(event_sequence, k + 1) = set_minus(event_sequence(k + 1), event_sequence((k + 1) - 1))
    (k + 1) - 1 = k
    increment(event_sequence, k + 1) = set_minus(event_sequence(k + 1), event_sequence(k))
    by thm equal_event_pairs_preserve_empty_intersection(event_sequence(k), \increasing_event_increment<Omega, events>(event_sequence, k + 1), event_sequence(k), set_minus(event_sequence(k + 1), event_sequence(k))) => intersect(event_sequence(k), \increasing_event_increment<Omega, events>(event_sequence, k + 1)) = {}

thm equal_arguments_have_equal_function_values:
    ? forall Domain, Codomain set, f fn (x Domain) Codomain, x, y Domain:
        x = y
        =>:
            f(x) = f(y)

thm equal_binary_arguments_have_equal_function_values:
    ? forall Domain, Codomain set, f fn (x, y Domain) Codomain, x1, x2, y1, y2 Domain:
        x1 = x2
        y1 = y2
        =>:
            f(x1, y1) = f(x2, y2)

thm equalities_compose:
    ? forall Domain set, x, y, z Domain:
        x = y
        y = z
        =>:
            x = z

thm probability_of_next_increasing_stage:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (index N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            probability(event_sequence(k + 1)) = probability(event_sequence(k)) + probability(\increasing_event_increment<Omega, events>(event_sequence, k + 1))
    let increment = \increasing_event_increment<Omega, events>
    by thm previous_event_disjoint_from_next_increment(Omega, events, event_sequence, k) => intersect(event_sequence(k), increment(event_sequence, k + 1)) = {}
    release thm probability_of_disjoint_union(Omega, events, probability, event_sequence(k), increment(event_sequence, k + 1))
    union(event_sequence(k), increment(event_sequence, k + 1)) $in events
    probability(union(event_sequence(k), increment(event_sequence, k + 1))) = probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))
    by thm increasing_event_increment_partitions_next(Omega, events, event_sequence, k) => union(event_sequence(k), increment(event_sequence, k + 1)) = event_sequence(k + 1)
    by thm equal_arguments_have_equal_function_values(events, R, probability, union(event_sequence(k), increment(event_sequence, k + 1)), event_sequence(k + 1)) => probability(union(event_sequence(k), increment(event_sequence, k + 1))) = probability(event_sequence(k + 1))
    by thm equalities_compose(R, probability(event_sequence(k + 1)), probability(union(event_sequence(k), increment(event_sequence, k + 1))), probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))) => probability(event_sequence(k + 1)) = probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))
    probability(event_sequence(k + 1)) = probability(event_sequence(k)) + probability(increment(event_sequence, k + 1)) = probability(event_sequence(k)) + probability(\increasing_event_increment<Omega, events>(event_sequence, k + 1))

thm increasing_event_increment_probability_partial_sum:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (index N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            partial_sum(fn (n N+) R {probability(\increasing_event_increment<Omega, events>(event_sequence, n))}, k) = probability(event_sequence(k))
    let increment = \increasing_event_increment<Omega, events>
    have increment_probabilities seq(R) = fn (n N+) R {probability(increment(event_sequence, n))}
    by induc k from 1:
        ? partial_sum(increment_probabilities, k) = probability(event_sequence(k))
        ? from k = 1:
            partial_sum(increment_probabilities, 1) = partial_sum(increment_probabilities, 0) + increment_probabilities(1)
            partial_sum(increment_probabilities, 0) = 0
            increment_probabilities(1) = probability(increment(event_sequence, 1))
            by thm equal_binary_arguments_have_equal_function_values(R, R, fn (x, y R) R {x + y}, partial_sum(increment_probabilities, 0), 0, increment_probabilities(1), probability(increment(event_sequence, 1))) => partial_sum(increment_probabilities, 0) + increment_probabilities(1) = 0 + probability(increment(event_sequence, 1))
            by thm equalities_compose(R, partial_sum(increment_probabilities, 1), partial_sum(increment_probabilities, 0) + increment_probabilities(1), 0 + probability(increment(event_sequence, 1))) => partial_sum(increment_probabilities, 1) = 0 + probability(increment(event_sequence, 1))
            0 + probability(increment(event_sequence, 1)) = probability(increment(event_sequence, 1))
            by thm equalities_compose(R, partial_sum(increment_probabilities, 1), 0 + probability(increment(event_sequence, 1)), probability(increment(event_sequence, 1))) => partial_sum(increment_probabilities, 1) = probability(increment(event_sequence, 1))
            increment(event_sequence, 1) = \raw_increasing_event_increment<Omega, events>(event_sequence, 1)
            \raw_increasing_event_increment<Omega, events>(event_sequence, 1) = event_sequence(1)
            increment(event_sequence, 1) = event_sequence(1)
            by thm equal_arguments_have_equal_function_values(events, R, probability, increment(event_sequence, 1), event_sequence(1)) => probability(increment(event_sequence, 1)) = probability(event_sequence(1))
            by thm equalities_compose(R, partial_sum(increment_probabilities, 1), probability(increment(event_sequence, 1)), probability(event_sequence(1))) => partial_sum(increment_probabilities, 1) = probability(event_sequence(1))
        ? induc:
            partial_sum(increment_probabilities, k + 1) = partial_sum(increment_probabilities, (k + 1) - 1) + increment_probabilities(k + 1)
            (k + 1) - 1 = k
            by thm equal_arguments_have_equal_function_values(N, R, fn (m N) R {partial_sum(increment_probabilities, m)}, (k + 1) - 1, k) => partial_sum(increment_probabilities, (k + 1) - 1) = partial_sum(increment_probabilities, k)
            by thm equalities_compose(R, partial_sum(increment_probabilities, (k + 1) - 1), partial_sum(increment_probabilities, k), probability(event_sequence(k))) => partial_sum(increment_probabilities, (k + 1) - 1) = probability(event_sequence(k))
            increment_probabilities(k + 1) = probability(increment(event_sequence, k + 1))
            by thm equal_binary_arguments_have_equal_function_values(R, R, fn (x, y R) R {x + y}, partial_sum(increment_probabilities, (k + 1) - 1), probability(event_sequence(k)), increment_probabilities(k + 1), probability(increment(event_sequence, k + 1))) => partial_sum(increment_probabilities, (k + 1) - 1) + increment_probabilities(k + 1) = probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))
            by thm equalities_compose(R, partial_sum(increment_probabilities, k + 1), partial_sum(increment_probabilities, (k + 1) - 1) + increment_probabilities(k + 1), probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))) => partial_sum(increment_probabilities, k + 1) = probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))
            by thm probability_of_next_increasing_stage(Omega, events, probability, event_sequence, k) => probability(event_sequence(k + 1)) = probability(event_sequence(k)) + probability(increment(event_sequence, k + 1))
            probability(event_sequence(k)) + probability(increment(event_sequence, k + 1)) = probability(event_sequence(k + 1))
            by thm equalities_compose(R, partial_sum(increment_probabilities, k + 1), probability(event_sequence(k)) + probability(increment(event_sequence, k + 1)), probability(event_sequence(k + 1))) => partial_sum(increment_probabilities, k + 1) = probability(event_sequence(k + 1))
    claim:
        ? forall n N+:
            fn (index N+) R {probability(\increasing_event_increment<Omega, events>(event_sequence, index))}(n) = increment_probabilities(n)
        fn (index N+) R {probability(\increasing_event_increment<Omega, events>(event_sequence, index))}(n) = probability(\increasing_event_increment<Omega, events>(event_sequence, n))
        increment_probabilities(n) = probability(increment(event_sequence, n))
        probability(\increasing_event_increment<Omega, events>(event_sequence, n)) = probability(increment(event_sequence, n))
    by thm pointwise_equal_sequences_have_equal_partial_sums(fn (n N+) R {probability(\increasing_event_increment<Omega, events>(event_sequence, n))}, increment_probabilities, k) => partial_sum(fn (n N+) R {probability(\increasing_event_increment<Omega, events>(event_sequence, n))}, k) = partial_sum(increment_probabilities, k)
    partial_sum(fn (n N+) R {probability(\increasing_event_increment<Omega, events>(event_sequence, n))}, k) = partial_sum(increment_probabilities, k) = probability(event_sequence(k))

thm pointwise_equal_families_have_equal_index_union:
    ? forall index_set, Omega set, left_family, right_family fn (index index_set) power_set(Omega):
        forall index index_set:
            left_family(index) = right_family(index)
        =>:
            index_union(index_set, Omega, left_family) = index_union(index_set, Omega, right_family)

thm increasing_event_sequence_has_probability_disjointification:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (index N+) events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_sigma_algebra(Omega, events)
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            exist increments fn (increment_index N+) events st {$is_probability_disjointification_of(Omega, events, probability, event_sequence, increments)}
    let increment = \increasing_event_increment<Omega, events>
    witness exist increments fn (increment_index N+) events st {$is_probability_disjointification_of(Omega, events, probability, event_sequence, increments)} from fn (n N+) events {increment(event_sequence, n)}:
        by thm increasing_event_increments_pairwise_disjoint(Omega, events, event_sequence) => $pairwise_disjoint_event_sequence(Omega, events, fn (n N+) events {increment(event_sequence, n)})
        claim:
            ? forall union_index N+:
                fn (n N+) events {increment(event_sequence, n)}(union_index) = increment(event_sequence, union_index)
            fn (n N+) events {increment(event_sequence, n)}(union_index) = increment(event_sequence, union_index)
        by thm pointwise_equal_families_have_equal_index_union(N+, Omega, fn (union_index N+) power_set(Omega) {fn (n N+) events {increment(event_sequence, n)}(union_index)}, fn (union_index N+) power_set(Omega) {increment(event_sequence, union_index)}) => index_union(N+, Omega, fn (union_index N+) power_set(Omega) {fn (n N+) events {increment(event_sequence, n)}(union_index)}) = index_union(N+, Omega, fn (union_index N+) power_set(Omega) {increment(event_sequence, union_index)})
        by thm increasing_event_increment_union_equals_source_union(Omega, events, event_sequence) => index_union(N+, Omega, fn (source_index N+) power_set(Omega) {increment(event_sequence, source_index)}) = index_union(N+, Omega, fn (source_index N+) power_set(Omega) {event_sequence(source_index)})
        by thm equalities_compose(power_set(Omega), index_union(N+, Omega, fn (union_index N+) power_set(Omega) {fn (n N+) events {increment(event_sequence, n)}(union_index)}), index_union(N+, Omega, fn (union_index N+) power_set(Omega) {increment(event_sequence, union_index)}), index_union(N+, Omega, fn (union_index N+) power_set(Omega) {event_sequence(union_index)})) => index_union(N+, Omega, fn (union_index N+) power_set(Omega) {fn (n N+) events {increment(event_sequence, n)}(union_index)}) = index_union(N+, Omega, fn (union_index N+) power_set(Omega) {event_sequence(union_index)})
        claim:
            ? forall term_index N+:
                probability(fn (n N+) events {increment(event_sequence, n)}(term_index)) = probability(increment(event_sequence, term_index))
            fn (n N+) events {increment(event_sequence, n)}(term_index) = increment(event_sequence, term_index)
            by thm equal_arguments_have_equal_function_values(events, R, probability, fn (n N+) events {increment(event_sequence, n)}(term_index), increment(event_sequence, term_index)) => probability(fn (n N+) events {increment(event_sequence, n)}(term_index)) = probability(increment(event_sequence, term_index))
        claim:
            ? forall k N+:
                partial_sum(fn (wrapper_term N+) R {probability(fn (n N+) events {increment(event_sequence, n)}(wrapper_term))}, k) = probability(event_sequence(k))
            by thm pointwise_equal_sequences_have_equal_partial_sums(fn (wrapper_term N+) R {probability(fn (n N+) events {increment(event_sequence, n)}(wrapper_term))}, fn (canonical_term N+) R {probability(increment(event_sequence, canonical_term))}, k) => partial_sum(fn (wrapper_term N+) R {probability(fn (n N+) events {increment(event_sequence, n)}(wrapper_term))}, k) = partial_sum(fn (canonical_term N+) R {probability(increment(event_sequence, canonical_term))}, k)
            by thm increasing_event_increment_probability_partial_sum(Omega, events, probability, event_sequence, k) => partial_sum(fn (canonical_term N+) R {probability(increment(event_sequence, canonical_term))}, k) = probability(event_sequence(k))
            by thm equalities_compose(R, partial_sum(fn (wrapper_term N+) R {probability(fn (n N+) events {increment(event_sequence, n)}(wrapper_term))}, k), partial_sum(fn (canonical_term N+) R {probability(increment(event_sequence, canonical_term))}, k), probability(event_sequence(k))) => partial_sum(fn (wrapper_term N+) R {probability(fn (n N+) events {increment(event_sequence, n)}(wrapper_term))}, k) = probability(event_sequence(k))
        by def $is_probability_disjointification_of(Omega, events, probability, event_sequence, fn (n N+) events {increment(event_sequence, n)})

thm probability_continuous_from_below:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_increasing_event_sequence(Omega, events, event_sequence)
        =>:
            $has_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})))
    claim:
        ? $is_sigma_algebra(Omega, events)
        by def $is_sigma_algebra(Omega, events)
    release thm increasing_event_sequence_has_probability_disjointification(Omega, events, probability, event_sequence)
    obtain increments from exist increments fn (increment_index N+) events st {$is_probability_disjointification_of(Omega, events, probability, event_sequence, increments)}
    by def $is_probability_disjointification_of(Omega, events, probability, event_sequence, increments)
    have increment_union events = index_union(N+, Omega, fn (n N+) power_set(Omega) {increments(n)})
    have source_union events = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    increment_union = source_union
    release thm kolmogorov_countable_additivity(Omega, events, probability, increments)
    $has_series_sum(fn (n N+) R {probability(increments(n))}, probability(increment_union))
    by def $has_series_sum(fn (n N+) R {probability(increments(n))}, probability(increment_union))
    by thm pointwise_equal_sequences_preserve_limit(fn (k N+) R {probability(event_sequence(k))}, fn (k N+) R {partial_sum(fn (n N+) R {probability(increments(n))}, k)}, probability(increment_union)) => $has_sequence_limit(fn (k N+) R {probability(event_sequence(k))}, probability(increment_union))
    by thm equal_arguments_have_equal_function_values(events, R, probability, increment_union, source_union) => probability(increment_union) = probability(source_union)
    by thm equal_values_preserve_sequence_limit(fn (k N+) R {probability(event_sequence(k))}, probability(increment_union), probability(source_union)) => $has_sequence_limit(fn (k N+) R {probability(event_sequence(k))}, probability(source_union))
    source_union = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    by thm equal_arguments_have_equal_function_values(events, R, probability, source_union, index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) => probability(source_union) = probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))
    by thm equal_values_preserve_sequence_limit(fn (k N+) R {probability(event_sequence(k))}, probability(source_union), probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))) => $has_sequence_limit(fn (k N+) R {probability(event_sequence(k))}, probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})))

thm one_minus_sequence_preserves_limit:
    ? forall a seq(R), L R:
        $has_sequence_limit(a, L)
        =>:
            $has_sequence_limit(fn (n N+) R {1 - a(n)}, 1 - L)
    by def $has_sequence_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(fn (n N+) R {1 - a(n)}, 1 - L, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(fn (n N+) R {1 - a(n)}, 1 - L, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(a, L, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (fn (n N+) R {1 - a(n)}(tail_index) - (1 - L)) < epsilon
                fn (n N+) R {1 - a(n)}(tail_index) = 1 - a(tail_index)
                (1 - a(tail_index)) - (1 - L) = L - a(tail_index)
                abs (L - a(tail_index)) = abs (a(tail_index) - L)
                abs (a(tail_index) - L) < epsilon
                abs (fn (n N+) R {1 - a(n)}(tail_index) - (1 - L)) < epsilon
            by def $is_tail_close_to(fn (n N+) R {1 - a(n)}, 1 - L, epsilon, n0)
    by def $has_sequence_limit(fn (n N+) R {1 - a(n)}, 1 - L)

thm complements_of_decreasing_events_are_increasing:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (index N+) events:
        $is_sigma_algebra(Omega, events)
        $is_decreasing_event_sequence(Omega, events, event_sequence)
        =>:
            $is_increasing_event_sequence(Omega, events, fn (n N+) events {\complement_event_sequence<Omega, events>(event_sequence, n)})
    by def $is_decreasing_event_sequence(Omega, events, event_sequence)
    claim:
        ? forall n N+:
            fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n) $subset fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n + 1)
        fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n) = \complement_event_sequence<Omega, events>(event_sequence, n)
        fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n + 1) = \complement_event_sequence<Omega, events>(event_sequence, n + 1)
        \complement_event_sequence<Omega, events>(event_sequence, n) = set_minus(Omega, event_sequence(n))
        \complement_event_sequence<Omega, events>(event_sequence, n + 1) = set_minus(Omega, event_sequence(n + 1))
        claim:
            ? forall point fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n):
                point $in fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n + 1)
            point $in \complement_event_sequence<Omega, events>(event_sequence, n)
            point $in set_minus(Omega, event_sequence(n))
            point $in Omega
            not point $in event_sequence(n)
            claim:
                ? not point $in event_sequence(n + 1)
                by contra:
                    ? not point $in event_sequence(n + 1)
                    point $in event_sequence(n + 1)
                    event_sequence(n + 1) $subset event_sequence(n)
                    point $in event_sequence(n)
                    impossible point $in event_sequence(n)
            point $in set_minus(Omega, event_sequence(n + 1))
            point $in \complement_event_sequence<Omega, events>(event_sequence, n + 1)
            point $in fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n + 1)
        by def fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n) $subset fn (index N+) events {\complement_event_sequence<Omega, events>(event_sequence, index)}(n + 1)
    by def $is_increasing_event_sequence(Omega, events, fn (n N+) events {\complement_event_sequence<Omega, events>(event_sequence, n)})

thm complement_union_of_event_sequence_is_intersection:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        =>:
            set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)})) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    have complement_union power_set(Omega) = set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)}))
    have double_complement_intersection power_set(Omega) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, \complement_event_sequence<Omega, events>(event_sequence, n))})
    have source_intersection power_set(Omega) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    by thm complement_of_index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)}) => set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)})) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, \complement_event_sequence<Omega, events>(event_sequence, n))})
    complement_union = double_complement_intersection
    claim:
        ? forall n N+:
            set_minus(Omega, \complement_event_sequence<Omega, events>(event_sequence, n)) = event_sequence(n)
        \complement_event_sequence<Omega, events>(event_sequence, n) = set_minus(Omega, event_sequence(n))
        by thm event_is_subset_of_sample_space(Omega, events, event_sequence(n)) => event_sequence(n) $subset Omega
        event_sequence(n) $in power_set(Omega)
        by thm relative_complement_involution(Omega, event_sequence(n)) => set_minus(Omega, set_minus(Omega, event_sequence(n))) = event_sequence(n)
        set_minus(Omega, \complement_event_sequence<Omega, events>(event_sequence, n)) = set_minus(Omega, set_minus(Omega, event_sequence(n))) = event_sequence(n)
    index_intersect(N+, Omega, fn (n N+) power_set(Omega) {set_minus(Omega, \complement_event_sequence<Omega, events>(event_sequence, n))}) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    double_complement_intersection = source_intersection
    complement_union = source_intersection
    complement_union = set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)}))
    set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)})) = complement_union
    source_intersection = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {\complement_event_sequence<Omega, events>(event_sequence, n)})) = complement_union = source_intersection = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})

thm one_minus_one_minus:
    ? forall x R:
        1 - (1 - x) = x

thm probability_continuous_from_above:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        index_intersect(N+, Omega, fn (intersection_index N+) power_set(Omega) {event_sequence(intersection_index)}) $in events
        $is_decreasing_event_sequence(Omega, events, event_sequence)
        =>:
            $has_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})))
    let complement_events = \complement_event_sequence<Omega, events>
    claim:
        ? $is_sigma_algebra(Omega, events)
        by def $is_sigma_algebra(Omega, events)
    by thm event_countable_union_is_event(Omega, events, fn (n N+) events {complement_events(event_sequence, n)}) => index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)}) $in events
    by thm event_countable_intersection_is_event(Omega, events, event_sequence) => index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}) $in events
    have complement_union events = index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})
    have source_intersection events = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    by thm complements_of_decreasing_events_are_increasing(Omega, events, event_sequence) => $is_increasing_event_sequence(Omega, events, fn (n N+) events {complement_events(event_sequence, n)})
    by thm probability_continuous_from_below(Omega, events, probability, fn (n N+) events {complement_events(event_sequence, n)}) => $has_sequence_limit(fn (n N+) R {probability(complement_events(event_sequence, n))}, probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})))
    by thm equal_arguments_have_equal_function_values(events, R, probability, index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)}), complement_union) => probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})) = probability(complement_union)
    by thm equal_values_preserve_sequence_limit(fn (n N+) R {probability(complement_events(event_sequence, n))}, probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})), probability(complement_union)) => $has_sequence_limit(fn (n N+) R {probability(complement_events(event_sequence, n))}, probability(complement_union))
    claim:
        ? forall n N+:
            probability(complement_events(event_sequence, n)) = 1 - probability(event_sequence(n))
        complement_events(event_sequence, n) = set_minus(Omega, event_sequence(n))
        by thm probability_of_event_complement(Omega, events, probability, event_sequence(n)) => probability(set_minus(Omega, event_sequence(n))) = 1 - probability(event_sequence(n))
        probability(complement_events(event_sequence, n)) = probability(set_minus(Omega, event_sequence(n))) = 1 - probability(event_sequence(n))
    by thm one_minus_sequence_preserves_limit(fn (n N+) R {probability(complement_events(event_sequence, n))}, probability(complement_union)) => $has_sequence_limit(fn (n N+) R {1 - probability(complement_events(event_sequence, n))}, 1 - probability(complement_union))
    claim:
        ? forall n N+:
            probability(event_sequence(n)) = 1 - probability(complement_events(event_sequence, n))
        probability(complement_events(event_sequence, n)) = 1 - probability(event_sequence(n))
        by thm equal_arguments_have_equal_function_values(R, R, fn (x R) R {1 - x}, probability(complement_events(event_sequence, n)), 1 - probability(event_sequence(n))) => fn (x R) R {1 - x}(probability(complement_events(event_sequence, n))) = fn (x R) R {1 - x}(1 - probability(event_sequence(n)))
        1 - probability(complement_events(event_sequence, n)) = 1 - (1 - probability(event_sequence(n)))
        by thm one_minus_one_minus(probability(event_sequence(n))) => 1 - (1 - probability(event_sequence(n))) = probability(event_sequence(n))
        1 - probability(complement_events(event_sequence, n)) = 1 - (1 - probability(event_sequence(n))) = probability(event_sequence(n))
        probability(event_sequence(n)) = 1 - probability(complement_events(event_sequence, n))
    by thm pointwise_equal_sequences_preserve_limit(fn (n N+) R {probability(event_sequence(n))}, fn (n N+) R {1 - probability(complement_events(event_sequence, n))}, 1 - probability(complement_union)) => $has_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, 1 - probability(complement_union))
    by thm complement_union_of_event_sequence_is_intersection(Omega, events, event_sequence) => set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    by thm equal_arguments_have_equal_function_values(power_set(Omega), power_set(Omega), fn (event power_set(Omega)) power_set(Omega) {set_minus(Omega, event)}, complement_union, index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})) => fn (event power_set(Omega)) power_set(Omega) {set_minus(Omega, event)}(complement_union) = fn (event power_set(Omega)) power_set(Omega) {set_minus(Omega, event)}(index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)}))
    set_minus(Omega, complement_union) = set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)}))
    index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}) = source_intersection
    set_minus(Omega, complement_union) = set_minus(Omega, index_union(N+, Omega, fn (n N+) power_set(Omega) {complement_events(event_sequence, n)})) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}) = source_intersection
    by thm probability_of_event_complement(Omega, events, probability, complement_union) => probability(set_minus(Omega, complement_union)) = 1 - probability(complement_union)
    by thm equal_arguments_have_equal_function_values(events, R, probability, set_minus(Omega, complement_union), source_intersection) => probability(set_minus(Omega, complement_union)) = probability(source_intersection)
    1 - probability(complement_union) = probability(set_minus(Omega, complement_union)) = probability(source_intersection)
    by thm equal_values_preserve_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, 1 - probability(complement_union), probability(source_intersection)) => $has_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, probability(source_intersection))
    source_intersection = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    claim:
        ? probability(source_intersection) = probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))
        by thm event_countable_intersection_is_event(Omega, events, event_sequence) => index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}) $in events
        by thm equal_arguments_have_equal_function_values(events, R, probability, source_intersection, index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) => probability(source_intersection) = probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))
    by thm equal_values_preserve_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, probability(source_intersection), probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))) => $has_sequence_limit(fn (n N+) R {probability(event_sequence(n))}, probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})))

thm event_union_is_event:
    ? forall Omega set, events power_set(power_set(Omega)), A, B events:
        $is_sigma_algebra(Omega, events)
        =>:
            union(A, B) $in events
    let two_events = \two_event_sequence<Omega, events>
    by thm event_countable_union_is_event(Omega, events, fn (n N+) events {two_events(A, B, n)}) => index_union(N+, Omega, fn (n N+) power_set(Omega) {two_events(A, B, n)}) $in events
    by thm two_event_sequence_countable_union(Omega, events, A, B) => index_union(N+, Omega, fn (n N+) power_set(Omega) {two_events(A, B, n)}) = union(A, B)
    union(A, B) $in events

template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn exact_event_union by exist!:
        ? forall A, B events:
            exist! result events st {result = union(A, B)}
        by thm event_union_is_event(Omega, events, A, B) => union(A, B) $in events
        witness exist! result events st {result = union(A, B)} from union(A, B):
            union(A, B) = union(A, B)
            claim:
                ? forall result1, result2 events:
                    result1 = union(A, B)
                    result2 = union(A, B)
                    =>:
                        result1 = result2
                result1 = union(A, B) = result2

template<Omega set, events power_set(power_set(Omega)): $is_sigma_algebra(Omega, events)>:
    have fn event_prefix_union(event_sequence fn (n N+) events, k N+) events by induc k from 1:
        case k = 1: event_sequence(1)
        case k > 1: \exact_event_union<Omega, events>(event_prefix_union(event_sequence, k - 1), event_sequence(k))

thm event_prefix_union_successor:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        =>:
            \event_prefix_union<Omega, events>(event_sequence, k + 1) = union(\event_prefix_union<Omega, events>(event_sequence, k), event_sequence(k + 1))
    let prefix_union = \event_prefix_union<Omega, events>
    k + 1 > 1
    (k + 1) - 1 = k
    prefix_union(event_sequence, k + 1) = \exact_event_union<Omega, events>(prefix_union(event_sequence, (k + 1) - 1), event_sequence(k + 1))
    prefix_union(event_sequence, (k + 1) - 1) = prefix_union(event_sequence, k)
    \exact_event_union<Omega, events>(prefix_union(event_sequence, k), event_sequence(k + 1)) = union(prefix_union(event_sequence, k), event_sequence(k + 1))
    \event_prefix_union<Omega, events>(event_sequence, k + 1) = prefix_union(event_sequence, k + 1) = union(prefix_union(event_sequence, k), event_sequence(k + 1)) = union(\event_prefix_union<Omega, events>(event_sequence, k), event_sequence(k + 1))

thm event_prefix_union_sequence_is_increasing:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        =>:
            $is_increasing_event_sequence(Omega, events, fn (k N+) events {\event_prefix_union<Omega, events>(event_sequence, k)})
    let prefix_union = \event_prefix_union<Omega, events>
    claim:
        ? forall k N+:
            fn (index N+) events {prefix_union(event_sequence, index)}(k) $subset fn (index N+) events {prefix_union(event_sequence, index)}(k + 1)
        fn (index N+) events {prefix_union(event_sequence, index)}(k) = prefix_union(event_sequence, k)
        fn (index N+) events {prefix_union(event_sequence, index)}(k + 1) = prefix_union(event_sequence, k + 1)
        by thm event_prefix_union_successor(Omega, events, event_sequence, k) => prefix_union(event_sequence, k + 1) = union(prefix_union(event_sequence, k), event_sequence(k + 1))
        claim:
            ? forall point prefix_union(event_sequence, k):
                point $in prefix_union(event_sequence, k + 1)
            point $in union(prefix_union(event_sequence, k), event_sequence(k + 1))
            point $in prefix_union(event_sequence, k + 1)
        by def prefix_union(event_sequence, k) $subset prefix_union(event_sequence, k + 1)
        fn (index N+) events {prefix_union(event_sequence, index)}(k) $subset fn (index N+) events {prefix_union(event_sequence, index)}(k + 1)
    by def $is_increasing_event_sequence(Omega, events, fn (k N+) events {prefix_union(event_sequence, k)})
    claim:
        ? forall k N+:
            fn(index N+) events {\event_prefix_union<Omega, events>(event_sequence, index)}(k) $subset fn(index N+) events {\event_prefix_union<Omega, events>(event_sequence, index)}(k + 1)
        fn(index N+) events {\event_prefix_union<Omega, events>(event_sequence, index)}(k) = fn(index N+) events {prefix_union(event_sequence, index)}(k) $subset fn(index N+) events {prefix_union(event_sequence, index)}(k + 1) = fn(index N+) events {\event_prefix_union<Omega, events>(event_sequence, index)}(k + 1)
    by def $is_increasing_event_sequence(Omega, events, fn(k N+) events {\event_prefix_union<Omega, events>(event_sequence, k)})

thm event_prefix_union_subset_source_union:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        =>:
            \event_prefix_union<Omega, events>(event_sequence, k) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    let prefix_union = \event_prefix_union<Omega, events>
    by induc k from 1:
        ? prefix_union(event_sequence, k) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
        ? from k = 1:
            prefix_union(event_sequence, 1) = event_sequence(1)
            claim:
                ? forall point prefix_union(event_sequence, 1):
                    point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
                point $in event_sequence(1)
                by thm event_is_subset_of_sample_space(Omega, events, event_sequence(1)) => event_sequence(1) $subset Omega
                point $in Omega
                witness exist index N+ st {point $in event_sequence(index)} from 1:
                    point $in event_sequence(1)
                point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
            by def prefix_union(event_sequence, 1) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
        ? induc:
            by thm event_prefix_union_successor(Omega, events, event_sequence, k) => prefix_union(event_sequence, k + 1) = union(prefix_union(event_sequence, k), event_sequence(k + 1))
            claim:
                ? forall point prefix_union(event_sequence, k + 1):
                    point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
                point $in union(prefix_union(event_sequence, k), event_sequence(k + 1))
                point $in prefix_union(event_sequence, k) or point $in event_sequence(k + 1)
                by cases:
                    ? point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
                    case point $in prefix_union(event_sequence, k):
                        point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
                    case point $in event_sequence(k + 1):
                        by thm event_is_subset_of_sample_space(Omega, events, event_sequence(k + 1)) => event_sequence(k + 1) $subset Omega
                        point $in Omega
                        witness exist index N+ st {point $in event_sequence(index)} from k + 1:
                            point $in event_sequence(k + 1)
                        point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
            by def prefix_union(event_sequence, k + 1) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    prefix_union(event_sequence, k) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    \event_prefix_union<Omega, events>(event_sequence, k) = prefix_union(event_sequence, k)
    \event_prefix_union<Omega, events>(event_sequence, k) $subset index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)})

thm source_event_subset_same_prefix_union:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        =>:
            event_sequence(k) $subset \event_prefix_union<Omega, events>(event_sequence, k)
    let prefix_union = \event_prefix_union<Omega, events>
    k = 1 or k > 1
    by cases:
        ? event_sequence(k) $subset prefix_union(event_sequence, k)
        case k = 1:
            prefix_union(event_sequence, k) = event_sequence(1) = event_sequence(k)
            claim:
                ? forall point event_sequence(k):
                    point $in prefix_union(event_sequence, k)
                point $in event_sequence(k)
                point $in prefix_union(event_sequence, k)
            by def event_sequence(k) $subset prefix_union(event_sequence, k)
        case k > 1:
            k - 1 $in N+
            k - 1 + 1 = k
            by thm event_prefix_union_successor(Omega, events, event_sequence, k - 1) => prefix_union(event_sequence, k - 1 + 1) = union(prefix_union(event_sequence, k - 1), event_sequence(k - 1 + 1))
            prefix_union(event_sequence, k) = union(prefix_union(event_sequence, k - 1), event_sequence(k))
            claim:
                ? forall point event_sequence(k):
                    point $in prefix_union(event_sequence, k)
                point $in union(prefix_union(event_sequence, k - 1), event_sequence(k))
                point $in prefix_union(event_sequence, k)
            by def event_sequence(k) $subset prefix_union(event_sequence, k)
    \event_prefix_union<Omega, events>(event_sequence, k) = prefix_union(event_sequence, k)
    event_sequence(k) $subset \event_prefix_union<Omega, events>(event_sequence, k)

thm event_prefix_union_countable_union_equals_source_union:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        =>:
            index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {\event_prefix_union<Omega, events>(event_sequence, prefix_index)}) = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    let prefix_union = \event_prefix_union<Omega, events>
    by extension:
        ? index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)}) = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
        claim:
            ? forall point index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)}):
                point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
            obtain k from exist k N+ st {point $in prefix_union(event_sequence, k)}
            by thm event_prefix_union_subset_source_union(Omega, events, event_sequence, k) => prefix_union(event_sequence, k) $subset index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
            point $in index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
        claim:
            ? forall point index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}):
                point $in index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)})
            obtain k from exist k N+ st {point $in event_sequence(k)}
            by thm source_event_subset_same_prefix_union(Omega, events, event_sequence, k) => event_sequence(k) $subset prefix_union(event_sequence, k)
            point $in prefix_union(event_sequence, k)
            witness exist index N+ st {point $in prefix_union(event_sequence, index)} from k:
                point $in prefix_union(event_sequence, k)
            point $in index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)})
    index_union(N+, Omega, fn(prefix_index N+) power_set(Omega) {\event_prefix_union<Omega, events>(event_sequence, prefix_index)}) = index_union(N+, Omega, fn(prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)}) = index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)})

thm partial_sum_successor:
    ? forall a seq(R), k N:
        partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
    k + 1 >= 1
    (k + 1) - 1 = k
    partial_sum(a, k + 1) = partial_sum(a, (k + 1) - 1) + a(k + 1)
    partial_sum(a, (k + 1) - 1) = partial_sum(a, k)
    partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)

thm partial_sum_one:
    ? forall a seq(R):
        partial_sum(a, 1) = a(1)
    by thm partial_sum_successor(a, 0) => partial_sum(a, 1) = partial_sum(a, 0) + a(1)
    partial_sum(a, 0) = 0
    by thm equal_binary_arguments_have_equal_function_values(R, R, fn (x, y R) R {x + y}, partial_sum(a, 0), 0, a(1), a(1)) => partial_sum(a, 0) + a(1) = 0 + a(1)
    0 + a(1) = a(1)
    partial_sum(a, 1) = partial_sum(a, 0) + a(1) = 0 + a(1) = a(1)

thm probability_event_prefix_union_le_partial_sum:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events, k N+:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_sigma_algebra(Omega, events)
        =>:
            probability(\event_prefix_union<Omega, events>(event_sequence, k)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)
    let prefix_union = \event_prefix_union<Omega, events>
    by induc k from 1:
        ? probability(prefix_union(event_sequence, k)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)
        ? from k = 1:
            prefix_union(event_sequence, 1) = event_sequence(1)
            probability(prefix_union(event_sequence, 1)) = probability(event_sequence(1))
            by thm partial_sum_one(fn (n N+) R {probability(event_sequence(n))}) => partial_sum(fn (n N+) R {probability(event_sequence(n))}, 1) = fn (n N+) R {probability(event_sequence(n))}(1)
            fn (n N+) R {probability(event_sequence(n))}(1) = probability(event_sequence(1))
            partial_sum(fn (n N+) R {probability(event_sequence(n))}, 1) = fn (n N+) R {probability(event_sequence(n))}(1) = probability(event_sequence(1))
            probability(prefix_union(event_sequence, 1)) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, 1)
            probability(prefix_union(event_sequence, 1)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, 1)
        ? induc:
            by thm event_prefix_union_successor(Omega, events, event_sequence, k) => prefix_union(event_sequence, k + 1) = union(prefix_union(event_sequence, k), event_sequence(k + 1))
            by thm probability_union_bound(Omega, events, probability, prefix_union(event_sequence, k), event_sequence(k + 1)) => probability(union(prefix_union(event_sequence, k), event_sequence(k + 1))) <= probability(prefix_union(event_sequence, k)) + probability(event_sequence(k + 1))
            probability(prefix_union(event_sequence, k + 1)) = probability(union(prefix_union(event_sequence, k), event_sequence(k + 1)))
            probability(prefix_union(event_sequence, k + 1)) <= probability(prefix_union(event_sequence, k)) + probability(event_sequence(k + 1))
            probability(prefix_union(event_sequence, k)) + probability(event_sequence(k + 1)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + probability(event_sequence(k + 1))
            by thm partial_sum_successor(fn (n N+) R {probability(event_sequence(n))}, k) => partial_sum(fn (n N+) R {probability(event_sequence(n))}, k + 1) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + fn (n N+) R {probability(event_sequence(n))}(k + 1)
            fn (n N+) R {probability(event_sequence(n))}(k + 1) = probability(event_sequence(k + 1))
            by thm equal_binary_arguments_have_equal_function_values(R, R, fn (x, y R) R {x + y}, partial_sum(fn (n N+) R {probability(event_sequence(n))}, k), partial_sum(fn (n N+) R {probability(event_sequence(n))}, k), fn (n N+) R {probability(event_sequence(n))}(k + 1), probability(event_sequence(k + 1))) => partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + fn (n N+) R {probability(event_sequence(n))}(k + 1) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + probability(event_sequence(k + 1))
            partial_sum(fn (n N+) R {probability(event_sequence(n))}, k + 1) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + fn (n N+) R {probability(event_sequence(n))}(k + 1) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + probability(event_sequence(k + 1))
            partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + probability(event_sequence(k + 1)) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, k + 1)
            probability(\event_prefix_union<Omega, events>(event_sequence, k + 1)) <= probability(\event_prefix_union<Omega, events>(event_sequence, k)) + probability(event_sequence(k + 1)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k) + probability(event_sequence(k + 1)) = partial_sum(fn (n N+) R {probability(event_sequence(n))}, k + 1)
    \event_prefix_union<Omega, events>(event_sequence, k) = prefix_union(event_sequence, k)
    probability(\event_prefix_union<Omega, events>(event_sequence, k)) = probability(prefix_union(event_sequence, k)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)

thm add_left_preserves_strict_order:
    ? forall x, y, z R:
        x < y
        =>:
            z + x < z + y

thm two_thirds_gap_stays_below_upper:
    ? forall A, B R:
        B < A
        =>:
            B + (A - B) / 3 + (A - B) / 3 < A
    A - B > 0
    2 < 3
    2 * (A - B) < 3 * (A - B)
    3 > 0
    2 * (A - B) / 3 < 3 * (A - B) / 3
    (A - B) / 3 + (A - B) / 3 = 2 * (A - B) / 3
    3 * (A - B) / 3 = A - B
    (A - B) / 3 + (A - B) / 3 = 2 * (A - B) / 3 < 3 * (A - B) / 3 = A - B
    by thm add_left_preserves_strict_order((A - B) / 3 + (A - B) / 3, A - B, B) => B + ((A - B) / 3 + (A - B) / 3) < B + (A - B)
    B + (A - B) / 3 + (A - B) / 3 = B + ((A - B) / 3 + (A - B) / 3)
    B + (A - B) = A
    B + (A - B) / 3 + (A - B) / 3 = B + ((A - B) / 3 + (A - B) / 3) < B + (A - B) = A

thm add_left_preserves_order:
    ? forall x, y, z R:
        x <= y
        =>:
            z + x <= z + y

thm two_equal_thirds_gap_stays_below_upper:
    ? forall A, B, epsilon R:
        B < A
        epsilon = (A - B) / 3
        =>:
            B + epsilon + epsilon < A
    by thm two_thirds_gap_stays_below_upper(A, B) => B + (A - B) / 3 + (A - B) / 3 < A
    by thm equal_binary_arguments_have_equal_function_values(R, R, fn (x, y R) R {x + y}, epsilon, (A - B) / 3, epsilon, (A - B) / 3) => epsilon + epsilon = (A - B) / 3 + (A - B) / 3
    by thm equal_binary_arguments_have_equal_function_values(R, R, fn (x, y R) R {x + y}, B, B, epsilon + epsilon, (A - B) / 3 + (A - B) / 3) => B + (epsilon + epsilon) = B + ((A - B) / 3 + (A - B) / 3)
    B + epsilon + epsilon = B + (epsilon + epsilon)
    B + ((A - B) / 3 + (A - B) / 3) = B + (A - B) / 3 + (A - B) / 3
    B + epsilon + epsilon = B + (epsilon + epsilon) = B + ((A - B) / 3 + (A - B) / 3) = B + (A - B) / 3 + (A - B) / 3 < A

thm pointwise_le_sequences_preserve_limit_order:
    ? forall a, b seq(R), A, B R:
        forall n N+:
            a(n) <= b(n)
        $has_sequence_limit(a, A)
        $has_sequence_limit(b, B)
        =>:
            A <= B
    by contra:
        ? A <= B
        not A <= B
        B < A
        A - B > 0
        3 > 0
        (A - B) / 3 > 0
        have epsilon R+ = (A - B) / 3
        by def $has_sequence_limit(a, A)
        obtain na from exist na N+ st {$is_tail_close_to(a, A, epsilon, na)}
        by def $has_sequence_limit(b, B)
        obtain nb from exist nb N+ st {$is_tail_close_to(b, B, epsilon, nb)}
        have common_index N+ = na + nb
        common_index = na + nb >= na
        common_index = na + nb >= nb
        by def $is_tail_close_to(a, A, epsilon, na)
        abs (a(common_index) - A) < epsilon
        by def $is_tail_close_to(b, B, epsilon, nb)
        abs (b(common_index) - B) < epsilon
        -abs (a(common_index) - A) <= a(common_index) - A
        -epsilon < -abs (a(common_index) - A) <= a(common_index) - A
        A - epsilon = -1 * epsilon + A < a(common_index) - A + A = a(common_index)
        b(common_index) - B <= abs (b(common_index) - B) < epsilon
        b(common_index) = b(common_index) - B + B < epsilon + B = B + epsilon
        a(common_index) <= b(common_index)
        by thm add_left_preserves_strict_order(A - epsilon, a(common_index), epsilon) => epsilon + (A - epsilon) < epsilon + a(common_index)
        epsilon + (A - epsilon) = A
        epsilon + a(common_index) = a(common_index) + epsilon
        A = epsilon + (A - epsilon) < epsilon + a(common_index) = a(common_index) + epsilon
        by thm add_left_preserves_order(a(common_index), b(common_index), epsilon) => epsilon + a(common_index) <= epsilon + b(common_index)
        a(common_index) + epsilon = epsilon + a(common_index) <= epsilon + b(common_index) = b(common_index) + epsilon
        by thm add_left_preserves_strict_order(b(common_index), B + epsilon, epsilon) => epsilon + b(common_index) < epsilon + (B + epsilon)
        epsilon + b(common_index) = b(common_index) + epsilon
        epsilon + (B + epsilon) = B + epsilon + epsilon
        b(common_index) + epsilon = epsilon + b(common_index) < epsilon + (B + epsilon) = B + epsilon + epsilon
        by thm two_equal_thirds_gap_stays_below_upper(A, B, epsilon) => B + epsilon + epsilon < A
        A < a(common_index) + epsilon <= b(common_index) + epsilon < B + epsilon + epsilon < A
        impossible A < A

thm probability_countable_subadditivity:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events, total R:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $has_series_sum(fn (n N+) R {probability(event_sequence(n))}, total)
        =>:
            probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) <= total
    let prefix_union = \event_prefix_union<Omega, events>
    claim:
        ? $is_sigma_algebra(Omega, events)
        by def $is_sigma_algebra(Omega, events)
    by thm event_prefix_union_sequence_is_increasing(Omega, events, event_sequence) => $is_increasing_event_sequence(Omega, events, fn (prefix_index N+) events {prefix_union(event_sequence, prefix_index)})
    by thm event_countable_union_is_event(Omega, events, fn (prefix_index N+) events {prefix_union(event_sequence, prefix_index)}) => index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)}) $in events
    by thm probability_continuous_from_below(Omega, events, probability, fn (prefix_index N+) events {prefix_union(event_sequence, prefix_index)}) => $has_sequence_limit(fn (prefix_index N+) R {probability(prefix_union(event_sequence, prefix_index))}, probability(index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)})))
    by def $has_series_sum(fn (n N+) R {probability(event_sequence(n))}, total)
    claim:
        ? forall k N+:
            probability(prefix_union(event_sequence, k)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)
        by thm probability_event_prefix_union_le_partial_sum(Omega, events, probability, event_sequence, k) => probability(prefix_union(event_sequence, k)) <= partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)
    by thm pointwise_le_sequences_preserve_limit_order(fn (prefix_index N+) R {probability(prefix_union(event_sequence, prefix_index))}, fn (k N+) R {partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)}, probability(index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)})), total) => probability(index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)})) <= total
    by thm event_prefix_union_countable_union_equals_source_union(Omega, events, event_sequence) => index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)}) = index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})
    by thm equal_arguments_have_equal_function_values(events, R, probability, index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)}), index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) => probability(index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {prefix_union(event_sequence, prefix_index)})) = probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))
    probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) = probability(index_union(N+, Omega, fn (prefix_index N+) power_set(Omega) {\event_prefix_union<Omega, events>(event_sequence, prefix_index)})) <= total

prop is_null_event(Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event events):
    probability(event) = 0
prop is_almost_sure_event(Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event events):
    probability(event) = 1

thm subset_of_null_event_is_null:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, A, B events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        A $subset B
        $is_null_event(Omega, events, probability, B)
        =>:
            $is_null_event(Omega, events, probability, A)
    by def $is_null_event(Omega, events, probability, B)
    by thm probability_mono(Omega, events, probability, A, B) => probability(A) <= probability(B)
    probability(B) = 0
    probability(A) <= 0
    probability(A) >= 0
    probability(A) = 0
    by def $is_null_event(Omega, events, probability, A)

thm pointwise_zero_series_has_sum:
    ? forall zero_terms seq(R):
        forall n N+:
            zero_terms(n) = 0
        =>:
            $has_series_sum(zero_terms, 0)
    claim:
        ? forall k N:
            partial_sum(zero_terms, k) = 0
        by induc k from 0:
            ? partial_sum(zero_terms, k) = 0
            ? from k = 0:
                partial_sum(zero_terms, 0) = 0
            ? induc:
                partial_sum(zero_terms, k + 1) = partial_sum(zero_terms, k) + zero_terms(k + 1)
                partial_sum(zero_terms, k) = 0
                zero_terms(k + 1) = 0
                partial_sum(zero_terms, k + 1) = 0
    claim:
        ? $has_sequence_limit(fn (k N+) R {partial_sum(zero_terms, k)}, 0)
        claim:
            ? forall epsilon R+:
                exist n0 N+ st {$is_tail_close_to(fn (k N+) R {partial_sum(zero_terms, k)}, 0, epsilon, n0)}
            witness exist candidate_index N+ st {$is_tail_close_to(fn (k N+) R {partial_sum(zero_terms, k)}, 0, epsilon, candidate_index)} from 1:
                claim:
                    ? forall tail_index N+:
                        tail_index >= 1
                        =>:
                            abs (fn (k N+) R {partial_sum(zero_terms, k)}(tail_index) - 0) < epsilon
                    partial_sum(zero_terms, tail_index) = 0
                    fn (k N+) R {partial_sum(zero_terms, k)}(tail_index) = 0
                    abs (fn (k N+) R {partial_sum(zero_terms, k)}(tail_index) - 0) = abs (0) = 0 < epsilon
                by def $is_tail_close_to(fn (k N+) R {partial_sum(zero_terms, k)}, 0, epsilon, 1)
        by def $has_sequence_limit(fn (k N+) R {partial_sum(zero_terms, k)}, 0)
    by def $has_series_sum(zero_terms, 0)

thm countable_union_of_null_events_is_null:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        forall n N+:
            $is_null_event(Omega, events, probability, event_sequence(n))
        =>:
            $is_null_event(Omega, events, probability, index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))
    claim:
        ? forall n N+:
            probability(event_sequence(n)) = 0
        $is_null_event(Omega, events, probability, event_sequence(n))
        by def $is_null_event(Omega, events, probability, event_sequence(n))
    by thm pointwise_zero_series_has_sum(fn (n N+) R {probability(event_sequence(n))}) => $has_series_sum(fn (n N+) R {probability(event_sequence(n))}, 0)
    by thm probability_countable_subadditivity(Omega, events, probability, event_sequence, 0) => probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) <= 0
    probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) >= 0
    probability(index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)})) = 0
    by def $is_null_event(Omega, events, probability, index_union(N+, Omega, fn (n N+) power_set(Omega) {event_sequence(n)}))

thm almost_sure_event_has_null_complement:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, A events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_almost_sure_event(Omega, events, probability, A)
        =>:
            $is_null_event(Omega, events, probability, set_minus(Omega, A))
    by def $is_almost_sure_event(Omega, events, probability, A)
    by thm probability_of_event_complement(Omega, events, probability, A) => probability(set_minus(Omega, A)) = 1 - probability(A)
    probability(A) = 1
    probability(set_minus(Omega, A)) = 1 - 1 = 0
    by def $is_null_event(Omega, events, probability, set_minus(Omega, A))
thm null_complement_implies_almost_sure:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, A events:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_null_event(Omega, events, probability, set_minus(Omega, A))
        =>:
            $is_almost_sure_event(Omega, events, probability, A)
    by def $is_null_event(Omega, events, probability, set_minus(Omega, A))
    by thm probability_of_event_complement(Omega, events, probability, A) => probability(set_minus(Omega, A)) = 1 - probability(A)
    probability(set_minus(Omega, A)) = 0
    0 = 1 - probability(A)
    probability(A) = 1
    by def $is_almost_sure_event(Omega, events, probability, A)

have fn real_sequence_tail_after(a seq(R), skipped N, offset N+) R = a(skipped + offset)

thm partial_sum_of_real_sequence_tail_after:
    ? forall a seq(R), skipped N, k N+:
        partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) = partial_sum(a, skipped + k) - partial_sum(a, skipped)
    by induc k from 1:
        ? partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) = partial_sum(a, skipped + k) - partial_sum(a, skipped)
        ? from k = 1:
            by thm partial_sum_one(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}) => partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, 1) = fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}(1)
            fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}(1) = real_sequence_tail_after(a, skipped, 1) = a(skipped + 1)
            by thm partial_sum_successor(a, skipped) => partial_sum(a, skipped + 1) = partial_sum(a, skipped) + a(skipped + 1)
            partial_sum(a, skipped + 1) - partial_sum(a, skipped) = (partial_sum(a, skipped) + a(skipped + 1)) - partial_sum(a, skipped) = a(skipped + 1)
            partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, 1) = a(skipped + 1) = partial_sum(a, skipped + 1) - partial_sum(a, skipped)
        ? induc:
            by thm partial_sum_successor(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) => partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k + 1) = partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) + fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}(k + 1)
            fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}(k + 1) = real_sequence_tail_after(a, skipped, k + 1) = a(skipped + (k + 1))
            skipped + (k + 1) = skipped + k + 1
            a(skipped + (k + 1)) = a(skipped + k + 1)
            by thm partial_sum_successor(a, skipped + k) => partial_sum(a, skipped + k + 1) = partial_sum(a, skipped + k) + a(skipped + k + 1)
            partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k + 1) = partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) + fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}(k + 1)
            partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) + fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}(k + 1) = partial_sum(a, skipped + k) - partial_sum(a, skipped) + a(skipped + k + 1)
            partial_sum(a, skipped + k) - partial_sum(a, skipped) + a(skipped + k + 1) = (partial_sum(a, skipped + k) + a(skipped + k + 1)) - partial_sum(a, skipped)
            (partial_sum(a, skipped + k) + a(skipped + k + 1)) - partial_sum(a, skipped) = partial_sum(a, skipped + k + 1) - partial_sum(a, skipped)
            partial_sum(a, skipped + k + 1) - partial_sum(a, skipped) = partial_sum(a, skipped + (k + 1)) - partial_sum(a, skipped)
            partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k + 1) = partial_sum(a, skipped + (k + 1)) - partial_sum(a, skipped)

thm finite_shift_preserves_sequence_limit:
    ? forall a seq(R), L R, skipped N:
        $has_sequence_limit(a, L)
        =>:
            $has_sequence_limit(fn (k N+) R {a(skipped + k)}, L)
    by def $has_sequence_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(fn (k N+) R {a(skipped + k)}, L, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(fn (k N+) R {a(skipped + k)}, L, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(a, L, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (fn (k N+) R {a(skipped + k)}(tail_index) - L) < epsilon
                skipped + tail_index >= tail_index >= n0
                abs (a(skipped + tail_index) - L) < epsilon
                fn (k N+) R {a(skipped + k)}(tail_index) = a(skipped + tail_index)
                abs (fn (k N+) R {a(skipped + k)}(tail_index) - L) < epsilon
            by def $is_tail_close_to(fn (k N+) R {a(skipped + k)}, L, epsilon, n0)
    by def $has_sequence_limit(fn (k N+) R {a(skipped + k)}, L)

thm subtract_constant_preserves_sequence_limit:
    ? forall a seq(R), L, c R:
        $has_sequence_limit(a, L)
        =>:
            $has_sequence_limit(fn (n N+) R {a(n) - c}, L - c)
    by def $has_sequence_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(fn (n N+) R {a(n) - c}, L - c, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(fn (n N+) R {a(n) - c}, L - c, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(a, L, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (fn (n N+) R {a(n) - c}(tail_index) - (L - c)) < epsilon
                fn (n N+) R {a(n) - c}(tail_index) = a(tail_index) - c
                (a(tail_index) - c) - (L - c) = a(tail_index) - L
                abs (a(tail_index) - L) < epsilon
                abs (fn (n N+) R {a(n) - c}(tail_index) - (L - c)) = abs (a(tail_index) - L) < epsilon
            by def $is_tail_close_to(fn (n N+) R {a(n) - c}, L - c, epsilon, n0)
    by def $has_sequence_limit(fn (n N+) R {a(n) - c}, L - c)

thm real_series_tail_after_has_sum:
    ? forall a seq(R), total R, skipped N:
        $has_series_sum(a, total)
        =>:
            $has_series_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, total - partial_sum(a, skipped))
    by def $has_series_sum(a, total)
    by thm finite_shift_preserves_sequence_limit(fn (k N+) R {partial_sum(a, k)}, total, skipped) => $has_sequence_limit(fn (k N+) R {partial_sum(a, skipped + k)}, total)
    by thm subtract_constant_preserves_sequence_limit(fn (k N+) R {partial_sum(a, skipped + k)}, total, partial_sum(a, skipped)) => $has_sequence_limit(fn (k N+) R {partial_sum(a, skipped + k) - partial_sum(a, skipped)}, total - partial_sum(a, skipped))
    claim:
        ? forall k N+:
            partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) = partial_sum(a, skipped + k) - partial_sum(a, skipped)
        by thm partial_sum_of_real_sequence_tail_after(a, skipped, k) => partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k) = partial_sum(a, skipped + k) - partial_sum(a, skipped)
    by thm pointwise_equal_sequences_preserve_limit(fn (k N+) R {partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k)}, fn (k N+) R {partial_sum(a, skipped + k) - partial_sum(a, skipped)}, total - partial_sum(a, skipped)) => $has_sequence_limit(fn (k N+) R {partial_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, k)}, total - partial_sum(a, skipped))
    by def $has_series_sum(fn (offset N+) R {real_sequence_tail_after(a, skipped, offset)}, total - partial_sum(a, skipped))

thm probability_event_tail_union_after_le_series_remainder:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events, total R, skipped N:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $is_sigma_algebra(Omega, events)
        $has_series_sum(fn (n N+) R {probability(event_sequence(n))}, total)
        =>:
            probability(\event_tail_union_after<Omega, events>(event_sequence, skipped)) <= total - partial_sum(fn (n N+) R {probability(event_sequence(n))}, skipped)
    let tail_union = \event_tail_union_after<Omega, events>
    release thm real_series_tail_after_has_sum(fn (n N+) R {probability(event_sequence(n))}, total, skipped)
    claim:
        ? forall offset N+:
            probability(event_sequence(skipped + offset)) = real_sequence_tail_after(fn (n N+) R {probability(event_sequence(n))}, skipped, offset)
        real_sequence_tail_after(fn (n N+) R {probability(event_sequence(n))}, skipped, offset) = fn (n N+) R {probability(event_sequence(n))}(skipped + offset) = probability(event_sequence(skipped + offset))
        probability(event_sequence(skipped + offset)) = real_sequence_tail_after(fn (n N+) R {probability(event_sequence(n))}, skipped, offset)
    by thm pointwise_equal_sequences_preserve_series_sum(fn (offset N+) R {probability(event_sequence(skipped + offset))}, fn (offset N+) R {real_sequence_tail_after(fn (n N+) R {probability(event_sequence(n))}, skipped, offset)}, total - partial_sum(fn (n N+) R {probability(event_sequence(n))}, skipped)) => $has_series_sum(fn (offset N+) R {probability(event_sequence(skipped + offset))}, total - partial_sum(fn (n N+) R {probability(event_sequence(n))}, skipped))
    by thm event_countable_union_is_event(Omega, events, fn (offset N+) events {event_sequence(skipped + offset)}) => index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}) $in events
    by thm probability_countable_subadditivity(Omega, events, probability, fn (offset N+) events {event_sequence(skipped + offset)}, total - partial_sum(fn (n N+) R {probability(event_sequence(n))}, skipped)) => probability(index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})) <= total - partial_sum(fn (n N+) R {probability(event_sequence(n))}, skipped)
    tail_union(event_sequence, skipped) = index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})
    by thm equal_arguments_have_equal_function_values(events, R, probability, tail_union(event_sequence, skipped), index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})) => probability(tail_union(event_sequence, skipped)) = probability(index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)}))
    probability(\event_tail_union_after<Omega, events>(event_sequence, skipped)) = probability(index_union(N+, Omega, fn (offset N+) power_set(Omega) {event_sequence(skipped + offset)})) <= total - partial_sum(fn (n N+) R {probability(event_sequence(n))}, skipped)

thm one_step_delay_preserves_N_indexed_sequence_limit:
    ? forall p fn (k N) R, L R:
        $has_sequence_limit(fn (n N+) R {p(n)}, L)
        =>:
            $has_sequence_limit(fn (n N+) R {p(n - 1)}, L)
    by def $has_sequence_limit(fn (n N+) R {p(n)}, L)
    claim:
        ? forall epsilon R+:
            exist delayed_start N+ st {$is_tail_close_to(fn (n N+) R {p(n - 1)}, L, epsilon, delayed_start)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(fn (n N+) R {p(n)}, L, epsilon, n0)}
        have delayed_start N+ = n0 + 1
        witness exist candidate_index N+ st {$is_tail_close_to(fn (n N+) R {p(n - 1)}, L, epsilon, candidate_index)} from delayed_start:
            by def $is_tail_close_to(fn (n N+) R {p(n)}, L, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= delayed_start
                    =>:
                        abs (fn (n N+) R {p(n - 1)}(tail_index) - L) < epsilon
                delayed_start = n0 + 1
                tail_index >= n0 + 1
                n0 >= 1
                tail_index >= n0 + 1 >= 1 + 1 = 2 > 1
                tail_index - 1 $in N+
                tail_index - 1 >= n0
                abs (fn (n N+) R {p(n)}(tail_index - 1) - L) < epsilon
                fn (n N+) R {p(n)}(tail_index - 1) = p(tail_index - 1)
                fn (n N+) R {p(n - 1)}(tail_index) = p(tail_index - 1)
                abs (fn (n N+) R {p(n - 1)}(tail_index) - L) = abs (fn (n N+) R {p(n)}(tail_index - 1) - L) < epsilon
            by def $is_tail_close_to(fn (n N+) R {p(n - 1)}, L, epsilon, delayed_start)
    by def $has_sequence_limit(fn (n N+) R {p(n - 1)}, L)

thm constant_minus_convergent_sequence_converges_to_zero:
    ? forall a seq(R), L R:
        $has_sequence_limit(a, L)
        =>:
            $has_sequence_limit(fn (n N+) R {L - a(n)}, 0)
    by def $has_sequence_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(fn (n N+) R {L - a(n)}, 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(fn (n N+) R {L - a(n)}, 0, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(a, L, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (fn (n N+) R {L - a(n)}(tail_index) - 0) < epsilon
                fn (n N+) R {L - a(n)}(tail_index) = L - a(tail_index)
                (L - a(tail_index)) - 0 = L - a(tail_index)
                abs (L - a(tail_index)) = abs (a(tail_index) - L) < epsilon
                abs (fn (n N+) R {L - a(n)}(tail_index) - 0) = abs (a(tail_index) - L) < epsilon
            by def $is_tail_close_to(fn (n N+) R {L - a(n)}, 0, epsilon, n0)
    by def $has_sequence_limit(fn (n N+) R {L - a(n)}, 0)

thm nonnegative_sequence_below_zero_limit_converges_to_zero:
    ? forall lower, upper seq(R):
        forall n N+:
            lower(n) >= 0
        forall n N+:
            lower(n) <= upper(n)
        $has_sequence_limit(upper, 0)
        =>:
            $has_sequence_limit(lower, 0)
    by def $has_sequence_limit(upper, 0)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(lower, 0, epsilon, n0)}
        obtain n0 from exist n0 N+ st {$is_tail_close_to(upper, 0, epsilon, n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(lower, 0, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(upper, 0, epsilon, n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs (lower(tail_index) - 0) < epsilon
                lower(tail_index) >= 0
                lower(tail_index) <= upper(tail_index)
                upper(tail_index) >= 0
                abs (lower(tail_index)) = lower(tail_index)
                abs (upper(tail_index)) = upper(tail_index)
                abs (upper(tail_index) - 0) < epsilon
                abs (lower(tail_index) - 0) = abs (lower(tail_index)) = lower(tail_index) <= upper(tail_index) = abs (upper(tail_index)) = abs (upper(tail_index) - 0) < epsilon
            by def $is_tail_close_to(lower, 0, epsilon, n0)
    by def $has_sequence_limit(lower, 0)

thm event_tail_union_sequence_is_decreasing:
    ? forall Omega set, events power_set(power_set(Omega)), event_sequence fn (sequence_index N+) events:
        $is_sigma_algebra(Omega, events)
        =>:
            $is_decreasing_event_sequence(Omega, events, fn (n N+) events {\event_tail_union_after<Omega, events>(event_sequence, n - 1)})
    let tail_union = \event_tail_union_after<Omega, events>
    claim:
        ? forall n N+:
            fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n + 1) $subset fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n)
        fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n + 1) = tail_union(event_sequence, (n + 1) - 1)
        (n + 1) - 1 = n
        fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n + 1) = tail_union(event_sequence, n)
        fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n) = tail_union(event_sequence, n - 1)
        claim:
            ? forall point tail_union(event_sequence, n):
                point $in tail_union(event_sequence, n - 1)
            tail_union(event_sequence, n) = index_union(N+, Omega, fn (offset_index N+) power_set(Omega) {event_sequence(n + offset_index)})
            point $in index_union(N+, Omega, fn (offset_index N+) power_set(Omega) {event_sequence(n + offset_index)})
            obtain offset from exist offset N+ st {point $in event_sequence(n + offset)}
            by thm event_is_subset_of_sample_space(Omega, events, tail_union(event_sequence, n)) => tail_union(event_sequence, n) $subset Omega
            point $in Omega
            have earlier_offset N+ = offset + 1
            n - 1 + earlier_offset = n - 1 + (offset + 1) = n + offset
            point $in event_sequence(n - 1 + earlier_offset)
            witness exist candidate_offset N+ st {point $in event_sequence(n - 1 + candidate_offset)} from earlier_offset:
                point $in event_sequence(n - 1 + earlier_offset)
            point $in index_union(N+, Omega, fn (offset_index N+) power_set(Omega) {event_sequence(n - 1 + offset_index)})
            tail_union(event_sequence, n - 1) = index_union(N+, Omega, fn (offset_index N+) power_set(Omega) {event_sequence(n - 1 + offset_index)})
            point $in tail_union(event_sequence, n - 1)
        by def tail_union(event_sequence, n) $subset tail_union(event_sequence, n - 1)
        fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n + 1) $subset fn (tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n)
    by def $is_decreasing_event_sequence(Omega, events, fn (n N+) events {tail_union(event_sequence, n - 1)})
    claim:
        ? forall n N+:
            fn(tail_index N+) events {\event_tail_union_after<Omega, events>(event_sequence, tail_index - 1)}(n + 1) $subset fn(tail_index N+) events {\event_tail_union_after<Omega, events>(event_sequence, tail_index - 1)}(n)
        fn(tail_index N+) events {\event_tail_union_after<Omega, events>(event_sequence, tail_index - 1)}(n + 1) = fn(tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n + 1) $subset fn(tail_index N+) events {tail_union(event_sequence, tail_index - 1)}(n) = fn(tail_index N+) events {\event_tail_union_after<Omega, events>(event_sequence, tail_index - 1)}(n)
    by def $is_decreasing_event_sequence(Omega, events, fn(n N+) events {\event_tail_union_after<Omega, events>(event_sequence, n - 1)})

thm first_borel_cantelli:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn (event events) R, event_sequence fn (n N+) events, total R:
        $is_sigma_algebra(Omega, events)
        probability({}) = 0
        probability(Omega) = 1
        forall event events:
            probability(event) >= 0
        forall family fn (family_index N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn (family_index N+) R {probability(family(family_index))}, probability(index_union(N+, Omega, fn (family_index N+) power_set(Omega) {family(family_index)})))
        $has_series_sum(fn (n N+) R {probability(event_sequence(n))}, total)
        =>:
            $is_null_event(Omega, events, probability, \event_limsup<Omega, events>(event_sequence))
    let tail_union = \event_tail_union_after<Omega, events>
    claim:
        ? $is_sigma_algebra(Omega, events)
        by def $is_sigma_algebra(Omega, events)
    by def $has_series_sum(fn (n N+) R {probability(event_sequence(n))}, total)
    by thm one_step_delay_preserves_N_indexed_sequence_limit(fn (k N) R {partial_sum(fn (n N+) R {probability(event_sequence(n))}, k)}, total) => $has_sequence_limit(fn (n N+) R {partial_sum(fn (term_index N+) R {probability(event_sequence(term_index))}, n - 1)}, total)
    by thm constant_minus_convergent_sequence_converges_to_zero(fn (n N+) R {partial_sum(fn (term_index N+) R {probability(event_sequence(term_index))}, n - 1)}, total) => $has_sequence_limit(fn (n N+) R {total - partial_sum(fn (term_index N+) R {probability(event_sequence(term_index))}, n - 1)}, 0)
    claim:
        ? forall n N+:
            probability(tail_union(event_sequence, n - 1)) >= 0
        tail_union(event_sequence, n - 1) $in events
        probability(tail_union(event_sequence, n - 1)) >= 0
    claim:
        ? forall n N+:
            probability(tail_union(event_sequence, n - 1)) <= total - partial_sum(fn (term_index N+) R {probability(event_sequence(term_index))}, n - 1)
        by thm probability_event_tail_union_after_le_series_remainder(Omega, events, probability, event_sequence, total, n - 1) => probability(tail_union(event_sequence, n - 1)) <= total - partial_sum(fn (term_index N+) R {probability(event_sequence(term_index))}, n - 1)
    by thm nonnegative_sequence_below_zero_limit_converges_to_zero(fn (n N+) R {probability(tail_union(event_sequence, n - 1))}, fn (n N+) R {total - partial_sum(fn (term_index N+) R {probability(event_sequence(term_index))}, n - 1)}) => $has_sequence_limit(fn (n N+) R {probability(tail_union(event_sequence, n - 1))}, 0)
    by thm event_tail_union_sequence_is_decreasing(Omega, events, event_sequence) => $is_decreasing_event_sequence(Omega, events, fn (n N+) events {tail_union(event_sequence, n - 1)})
    by thm event_countable_intersection_is_event(Omega, events, fn (n N+) events {tail_union(event_sequence, n - 1)}) => index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)}) $in events
    by thm probability_continuous_from_above(Omega, events, probability, fn (n N+) events {tail_union(event_sequence, n - 1)}) => $has_sequence_limit(fn (n N+) R {probability(tail_union(event_sequence, n - 1))}, probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)})))
    by thm sequence_limit_unique(fn (n N+) R {probability(tail_union(event_sequence, n - 1))}, 0, probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)}))) => 0 = probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)}))
    probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)})) = 0
    \event_limsup<Omega, events>(event_sequence) = index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)})
    by thm equal_arguments_have_equal_function_values(events, R, probability, \event_limsup<Omega, events>(event_sequence), index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)})) => probability(\event_limsup<Omega, events>(event_sequence)) = probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)}))
    probability(\event_limsup<Omega, events>(event_sequence)) = probability(index_intersect(N+, Omega, fn (n N+) power_set(Omega) {tail_union(event_sequence, n - 1)})) = 0
    by def $is_null_event(Omega, events, probability, \event_limsup<Omega, events>(event_sequence))

template<Omega set, events power_set(power_set(Omega)), point Omega>:
    have fn dirac_probability(event events) R by cases :
        case point $in event: 1
        case not point $in event: 0

have fn single_one_sequence(hit N+, n N+) R by cases :
    case n = hit: 1
    case n != hit: 0

prop single_one_prefix_zero(hit N+, k N):
    k >= hit or partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0

thm single_one_prefix_zero_by_induction:
    ? forall hit N+, k N:
        $single_one_prefix_zero(hit, k)
    by induc k from 0:
        ? $single_one_prefix_zero(hit, k)

        ? from k = 0:
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, 0) = 0
            by def:
                ? $single_one_prefix_zero(hit, 0)
            $single_one_prefix_zero(hit, 0)
            $single_one_prefix_zero(hit, k)

        ? induc:
            $single_one_prefix_zero(hit, k)
            k + 1 >= hit or k + 1 < hit
            by cases:
                ? $single_one_prefix_zero(hit, k + 1)
                case k + 1 >= hit:
                    by def:
                        ? $single_one_prefix_zero(hit, k + 1)
                    $single_one_prefix_zero(hit, k + 1)
                case k + 1 < hit:
                    k >= hit or partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0
                    by cases:
                        ? $single_one_prefix_zero(hit, k + 1)
                        case k >= hit:
                            k + 1 >= hit
                            impossible k + 1 < hit
                        case partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0:
                            k + 1 != hit
                            single_one_sequence(hit, k + 1) = 0
                            by thm partial_sum_successor(fn(n N+) R {single_one_sequence(hit, n)}, k) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) + single_one_sequence(hit, k + 1)
                            by thm equal_binary_arguments_have_equal_function_values(R, R, fn(x, y R) R {x + y}, partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k), 0, single_one_sequence(hit, k + 1), 0) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) + single_one_sequence(hit, k + 1) = 0 + 0
                            0 + 0 = 0
                            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) + single_one_sequence(hit, k + 1) = 0 + 0 = 0
                            by def:
                                ? $single_one_prefix_zero(hit, k + 1)
                            $single_one_prefix_zero(hit, k + 1)

thm single_one_partial_sum_before_hit:
    ? forall hit N+, k N:
        k < hit
        =>:
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0
    by thm single_one_prefix_zero_by_induction(hit, k) => $single_one_prefix_zero(hit, k)
    by def $single_one_prefix_zero(hit, k)
    k >= hit or partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0
    by cases:
        ? partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0
        case k >= hit:
            impossible k < hit
        case partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0:
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 0

thm single_one_partial_sum_at_hit:
    ? forall hit N+:
        partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit) = 1
    hit - 1 < hit
    by thm single_one_partial_sum_before_hit(hit, hit - 1) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) = 0
    single_one_sequence(hit, hit) = 1
    by thm partial_sum_successor(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, (hit - 1) + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) + single_one_sequence(hit, (hit - 1) + 1)
    (hit - 1) + 1 = hit
    by thm equal_arguments_have_equal_function_values(N, R, fn(index N) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, index)}, (hit - 1) + 1, hit) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, (hit - 1) + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit)
    by thm equal_arguments_have_equal_function_values(N+, R, fn(index N+) R {single_one_sequence(hit, index)}, (hit - 1) + 1, hit) => single_one_sequence(hit, (hit - 1) + 1) = single_one_sequence(hit, hit)
    partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, (hit - 1) + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) + single_one_sequence(hit, (hit - 1) + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) + single_one_sequence(hit, hit)
    by thm equal_binary_arguments_have_equal_function_values(R, R, fn(x, y R) R {x + y}, partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1), 0, single_one_sequence(hit, hit), 1) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) + single_one_sequence(hit, hit) = 0 + 1
    0 + 1 = 1
    partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit - 1) + single_one_sequence(hit, hit) = 0 + 1 = 1

thm single_one_partial_sum_from_hit_offset:
    ? forall hit N+, offset N:
        partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) = 1
    by induc offset from 0:
        ? partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) = 1

        ? from offset = 0:
            by thm equal_binary_arguments_have_equal_function_values(R, R, fn(x, y R) R {x + y}, hit, hit, offset, 0) => hit + offset = hit + 0
            hit + 0 = hit
            hit + offset = hit + 0 = hit
            by thm equal_arguments_have_equal_function_values(N, R, fn(index N) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, index)}, hit + offset, hit) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit)
            by thm single_one_partial_sum_at_hit(hit) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit) = 1
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit) = 1

        ? induc:
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) = 1
            hit + offset >= hit
            (hit + offset) + 1 > hit
            (hit + offset) + 1 != hit
            single_one_sequence(hit, (hit + offset) + 1) = 0
            by thm partial_sum_successor(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, (hit + offset) + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) + single_one_sequence(hit, (hit + offset) + 1)
            hit + (offset + 1) = (hit + offset) + 1
            by thm equal_arguments_have_equal_function_values(N, R, fn(index N) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, index)}, hit + (offset + 1), (hit + offset) + 1) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + (offset + 1)) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, (hit + offset) + 1)
            by thm equal_binary_arguments_have_equal_function_values(R, R, fn(x, y R) R {x + y}, partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset), 1, single_one_sequence(hit, (hit + offset) + 1), 0) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) + single_one_sequence(hit, (hit + offset) + 1) = 1 + 0
            1 + 0 = 1
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + (offset + 1)) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, (hit + offset) + 1) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + offset) + single_one_sequence(hit, (hit + offset) + 1) = 1 + 0 = 1

thm single_one_partial_sum_at_or_after_hit:
    ? forall hit N+, k N:
        k >= hit
        =>:
            partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = 1
    k - hit $in N
    hit + (k - hit) = k
    by thm single_one_partial_sum_from_hit_offset(hit, k - hit) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + (k - hit)) = 1
    by thm equal_arguments_have_equal_function_values(N, R, fn(index N) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, index)}, hit + (k - hit), k) => partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + (k - hit)) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k)
    partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k) = partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, hit + (k - hit)) = 1

thm single_one_sequence_has_series_sum_one:
    ? forall hit N+:
        $has_series_sum(fn(n N+) R {single_one_sequence(hit, n)}, 1)
    claim:
        ? $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k)}, 1)
        claim:
            ? forall epsilon R+:
                exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k)}, 1, epsilon, n0)}
            witness exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k)}, 1, epsilon, n0)} from hit:
                claim:
                    ? forall n N+:
                        n >= hit
                        =>:
                            abs(fn(k N+) R {partial_sum(fn(term_index N+) R {single_one_sequence(hit, term_index)}, k)}(n) - 1) < epsilon
                    by thm single_one_partial_sum_at_or_after_hit(hit, n) => partial_sum(fn(term_index N+) R {single_one_sequence(hit, term_index)}, n) = 1
                    fn(k N+) R {partial_sum(fn(term_index N+) R {single_one_sequence(hit, term_index)}, k)}(n) = partial_sum(fn(term_index N+) R {single_one_sequence(hit, term_index)}, n) = 1
                    abs(fn(k N+) R {partial_sum(fn(term_index N+) R {single_one_sequence(hit, term_index)}, k)}(n) - 1) = abs(0) = 0 < epsilon
                by def $is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k)}, 1, epsilon, hit)
        by def $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {single_one_sequence(hit, n)}, k)}, 1)
    by def $has_series_sum(fn(n N+) R {single_one_sequence(hit, n)}, 1)

thm equal_values_preserve_series_sum:
    ? forall a seq(R), L1, L2 R:
        L1 = L2
        $has_series_sum(a, L1)
        =>:
            $has_series_sum(a, L2)
    by def $has_series_sum(a, L1)
    by thm equal_values_preserve_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L1, L2) => $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L2)
    by def $has_series_sum(a, L2)

thm dirac_probability_countable_additivity:
    ? forall Omega set, events power_set(power_set(Omega)), point Omega, family fn(n N+) events:
        index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events
        $pairwise_disjoint_event_sequence(Omega, events, family)
        =>:
            $has_series_sum(fn(n N+) R {\dirac_probability<Omega, events, point>(family(n))}, \dirac_probability<Omega, events, point>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
    let point_mass = \dirac_probability<Omega, events, point>
    point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) or not point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})
    by cases:
        ? $has_series_sum(fn(n N+) R {point_mass(family(n))}, point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        case not point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}):
            claim:
                ? forall n N+:
                    not point $in family(n)
                by contra:
                    ? not point $in family(n)
                    point $in family(n)
                    witness exist candidate_index N+ st {point $in family(candidate_index)} from n
                    point $in index_union(N+, Omega, fn(index N+) power_set(Omega) {family(index)})
                    impossible not point $in index_union(N+, Omega, fn(index N+) power_set(Omega) {family(index)})
            claim:
                ? forall n N+:
                    point_mass(family(n)) = 0
                not point $in family(n)
                point_mass(family(n)) = 0
            by thm pointwise_zero_series_has_sum(fn(n N+) R {point_mass(family(n))}) => $has_series_sum(fn(n N+) R {point_mass(family(n))}, 0)
            point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = 0
            0 = point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
            by thm equal_values_preserve_series_sum(fn(n N+) R {point_mass(family(n))}, 0, point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))) => $has_series_sum(fn(n N+) R {point_mass(family(n))}, point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        case point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}):
            obtain hit from exist hit N+ st {point $in family(hit)}
            claim:
                ? forall n N+:
                    point_mass(family(n)) = single_one_sequence(hit, n)
                n = hit or n != hit
                by cases:
                    ? point_mass(family(n)) = single_one_sequence(hit, n)
                    case n = hit:
                        by thm equal_arguments_have_equal_function_values(N+, events, family, n, hit) => family(n) = family(hit)
                        point $in family(n)
                        point_mass(family(n)) = 1
                        single_one_sequence(hit, n) = 1
                        point_mass(family(n)) = 1 = single_one_sequence(hit, n)
                    case n != hit:
                        by def $pairwise_disjoint_event_sequence(Omega, events, family)
                        intersect(family(hit), family(n)) = {}
                        claim:
                            ? not point $in family(n)
                            by contra:
                                ? not point $in family(n)
                                point $in family(n)
                                point $in intersect(family(hit), family(n))
                                point $in {}
                                impossible point $in {}
                        point_mass(family(n)) = 0
                        single_one_sequence(hit, n) = 0
                        point_mass(family(n)) = 0 = single_one_sequence(hit, n)
            by thm single_one_sequence_has_series_sum_one(hit) => $has_series_sum(fn(n N+) R {single_one_sequence(hit, n)}, 1)
            by thm pointwise_equal_sequences_preserve_series_sum(fn(n N+) R {point_mass(family(n))}, fn(n N+) R {single_one_sequence(hit, n)}, 1) => $has_series_sum(fn(n N+) R {point_mass(family(n))}, 1)
            point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = 1
            1 = point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
            by thm equal_values_preserve_series_sum(fn(n N+) R {\dirac_probability<Omega, events, point>(family(n))}, 1, \dirac_probability<Omega, events, point>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))) => $has_series_sum(fn(n N+) R {\dirac_probability<Omega, events, point>(family(n))}, \dirac_probability<Omega, events, point>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))

thm dirac_probability_is_probability_space:
    ? forall Omega set, events power_set(power_set(Omega)), point Omega:
        {} $in events
        Omega $in events
        forall event events:
            set_minus(Omega, event) $in events
        forall left_event, right_event events:
            intersect(left_event, right_event) $in events
        forall family fn(n N+) events:
            index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events
        =>:
            $is_probability_space(Omega, events, \dirac_probability<Omega, events, point>)
    let point_mass = \dirac_probability<Omega, events, point>
    not point $in {}
    point_mass({}) = 0
    point $in Omega
    point_mass(Omega) = 1
    claim:
        ? forall event events:
            point_mass(event) >= 0
        point $in event or not point $in event
        by cases:
            ? point_mass(event) >= 0
            case point $in event:
                point_mass(event) = 1
                1 >= 0
            case not point $in event:
                point_mass(event) = 0
                0 >= 0
    claim:
        ? forall family fn(n N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn(n N+) R {point_mass(family(n))}, point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events
        by thm dirac_probability_countable_additivity(Omega, events, point, family) => $has_series_sum(fn(n N+) R {point_mass(family(n))}, point_mass(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
    by def $is_probability_space(Omega, events, point_mass)
    $is_probability_space(Omega, events, \dirac_probability<Omega, events, point>)

prop is_conditioning_data(Omega set, events power_set(power_set(Omega)), probability fn (event events) R, evidence events):
    $is_probability_space(Omega, events, probability)
    probability(evidence) > 0
template<Omega set, events power_set(power_set(Omega)), probability fn (event events) R, evidence events: $is_conditioning_data(Omega, events, probability, evidence)>:
    have fn conditioned_probability_measure(event events) R = probability(intersect(event, evidence)) / probability(evidence)

template<Omega set, events power_set(power_set(Omega)), probability fn(event events) R, evidence events, family fn(n N+) events: $is_probability_space(Omega, events, probability)>:
    have fn evidence_intersection_sequence(n N+) events = intersect(family(n), evidence)

thm evidence_intersection_sequence_is_pairwise_disjoint:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn(event events) R, evidence events, family fn(n N+) events:
        $is_probability_space(Omega, events, probability)
        $pairwise_disjoint_event_sequence(Omega, events, family)
        =>:
            $pairwise_disjoint_event_sequence(Omega, events, \evidence_intersection_sequence<Omega, events, probability, evidence, family>)
    let evidence_intersections = \evidence_intersection_sequence<Omega, events, probability, evidence, family>
    by def $pairwise_disjoint_event_sequence(Omega, events, family)
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(evidence_intersections(idx), evidence_intersections(j)) = {}
        intersect(family(idx), family(j)) = {}
        evidence_intersections(idx) = intersect(family(idx), evidence)
        evidence_intersections(j) = intersect(family(j), evidence)
        by extension:
            ? intersect(evidence_intersections(idx), evidence_intersections(j)) = {}
            claim:
                ? forall point intersect(evidence_intersections(idx), evidence_intersections(j)):
                    point $in {}
                point $in evidence_intersections(idx)
                point $in evidence_intersections(j)
                point $in intersect(family(idx), evidence)
                point $in intersect(family(j), evidence)
                point $in family(idx)
                point $in family(j)
                point $in intersect(family(idx), family(j))
                point $in {}
            claim:
                ? forall point {}:
                    point $in intersect(evidence_intersections(idx), evidence_intersections(j))
                by contra:
                    ? point $in intersect(evidence_intersections(idx), evidence_intersections(j))
                    not point $in intersect(evidence_intersections(idx), evidence_intersections(j))
                    impossible point $in {}
    by def $pairwise_disjoint_event_sequence(Omega, events, evidence_intersections)
    $pairwise_disjoint_event_sequence(Omega, events, \evidence_intersection_sequence<Omega, events, probability, evidence, family>)

thm index_union_evidence_intersections:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn(event events) R, evidence events, family fn(n N+) events:
        $is_probability_space(Omega, events, probability)
        =>:
            index_union(N+, Omega, fn(n N+) power_set(Omega) {\evidence_intersection_sequence<Omega, events, probability, evidence, family>(n)}) = intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)
    let eis = \evidence_intersection_sequence<Omega, events, probability, evidence, family>
    by extension:
        ? index_union(N+, Omega, fn(n N+) power_set(Omega) {\evidence_intersection_sequence<Omega, events, probability, evidence, family>(n)}) = intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)
        claim:
            ? forall point index_union(N+, Omega, fn(n N+) power_set(Omega) {\evidence_intersection_sequence<Omega, events, probability, evidence, family>(n)}):
                point $in intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)
            obtain idx from exist idx N+ st {point $in \evidence_intersection_sequence<Omega, events, probability, evidence, family>(idx)}
            eis(idx) = intersect(family(idx), evidence)
            point $in intersect(family(idx), evidence)
            point $in family(idx)
            point $in evidence
            witness exist candidate_index N+ st {point $in family(candidate_index)} from idx
            point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})
            point $in intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)
        claim:
            ? forall point intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence):
                point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {\evidence_intersection_sequence<Omega, events, probability, evidence, family>(n)})
            point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})
            point $in evidence
            obtain idx from exist idx N+ st {point $in family(idx)}
            point $in intersect(family(idx), evidence)
            eis(idx) = intersect(family(idx), evidence)
            point $in \evidence_intersection_sequence<Omega, events, probability, evidence, family>(idx)
            witness exist candidate_index N+ st {point $in \evidence_intersection_sequence<Omega, events, probability, evidence, family>(candidate_index)} from idx
            point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {\evidence_intersection_sequence<Omega, events, probability, evidence, family>(n)})

thm partial_sum_scalar_multiple:
    ? forall a seq(R), c R, k N:
        partial_sum(fn(n N+) R {c * a(n)}, k) = c * partial_sum(a, k)
    by induc k from 0:
        ? partial_sum(fn(n N+) R {c * a(n)}, k) = c * partial_sum(a, k)

        ? from k = 0:
            partial_sum(fn(n N+) R {c * a(n)}, 0) = 0
            partial_sum(a, 0) = 0
            c * 0 = 0
            c * partial_sum(a, 0) = c * 0 = 0
            partial_sum(fn(n N+) R {c * a(n)}, 0) = 0 = c * partial_sum(a, 0)
            partial_sum(fn(n N+) R {c * a(n)}, k) = c * partial_sum(a, k)

        ? induc:
            partial_sum(fn(n N+) R {c * a(n)}, k) = c * partial_sum(a, k)
            by thm partial_sum_successor(fn(n N+) R {c * a(n)}, k) => partial_sum(fn(n N+) R {c * a(n)}, k + 1) = partial_sum(fn(n N+) R {c * a(n)}, k) + c * a(k + 1)
            by thm partial_sum_successor(a, k) => partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            c * (partial_sum(a, k) + a(k + 1)) = c * partial_sum(a, k) + c * a(k + 1)
            c * partial_sum(a, k + 1) = c * (partial_sum(a, k) + a(k + 1)) = c * partial_sum(a, k) + c * a(k + 1)
            partial_sum(fn(n N+) R {c * a(n)}, k + 1) = partial_sum(fn(n N+) R {c * a(n)}, k) + c * a(k + 1) = c * partial_sum(a, k) + c * a(k + 1) = c * partial_sum(a, k + 1)

thm scalar_multiple_preserves_sequence_limit:
    ? forall c R, a seq(R), L R:
        $has_sequence_limit(a, L)
        =>:
            $has_sequence_limit(fn(n N+) R {c * a(n)}, c * L)
    by def $has_sequence_limit(a, L)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(fn(n N+) R {c * a(n)}, c * L, epsilon, n0)}
        abs(c) + 1 > 0
        epsilon / (abs(c) + 1) $in R+
        obtain n0 from exist n0 N+ st {$is_tail_close_to(a, L, epsilon / (abs(c) + 1), n0)}
        witness exist candidate_index N+ st {$is_tail_close_to(fn(n N+) R {c * a(n)}, c * L, epsilon, candidate_index)} from n0:
            by def $is_tail_close_to(a, L, epsilon / (abs(c) + 1), n0)
            claim:
                ? forall tail_index N+:
                    tail_index >= n0
                    =>:
                        abs(fn(n N+) R {c * a(n)}(tail_index) - c * L) < epsilon
                abs(a(tail_index) - L) < epsilon / (abs(c) + 1)
                abs(c) >= 0
                abs(c) < abs(c) + 1
                fn(n N+) R {c * a(n)}(tail_index) = c * a(tail_index)
                abs(c) * abs(a(tail_index) - L) <= abs(c) * (epsilon / (abs(c) + 1)) < (abs(c) + 1) * (epsilon / (abs(c) + 1)) = epsilon
                abs(fn(n N+) R {c * a(n)}(tail_index) - c * L) = abs(c * (a(tail_index) - L)) = abs(c) * abs(a(tail_index) - L) < epsilon
            by def $is_tail_close_to(fn(n N+) R {c * a(n)}, c * L, epsilon, n0)
    by def $has_sequence_limit(fn(n N+) R {c * a(n)}, c * L)

thm scalar_multiple_preserves_series_sum:
    ? forall c R, a seq(R), L R:
        $has_series_sum(a, L)
        =>:
            $has_series_sum(fn(n N+) R {c * a(n)}, c * L)
    by def $has_series_sum(a, L)
    by thm scalar_multiple_preserves_sequence_limit(c, fn(k N+) R {partial_sum(a, k)}, L) => $has_sequence_limit(fn(k N+) R {c * partial_sum(a, k)}, c * L)
    claim:
        ? forall k N+:
            partial_sum(fn(n N+) R {c * a(n)}, k) = c * partial_sum(a, k)
        by thm partial_sum_scalar_multiple(a, c, k) => partial_sum(fn(n N+) R {c * a(n)}, k) = c * partial_sum(a, k)
    by thm pointwise_equal_sequences_preserve_limit(fn(k N+) R {partial_sum(fn(n N+) R {c * a(n)}, k)}, fn(k N+) R {c * partial_sum(a, k)}, c * L) => $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {c * a(n)}, k)}, c * L)
    by def $has_series_sum(fn(n N+) R {c * a(n)}, c * L)

thm reciprocal_left_mul_equals_division:
    ? forall x, denominator R:
        denominator != 0
        =>:
            (1 / denominator) * x = x / denominator

thm conditioned_probability_countable_additivity:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn(event events) R, evidence events, family fn(n N+) events:
        $is_conditioning_data(Omega, events, probability, evidence)
        $pairwise_disjoint_event_sequence(Omega, events, family)
        =>:
            $has_series_sum(fn(n N+) R {\conditioned_probability_measure<Omega, events, probability, evidence>(family(n))}, \conditioned_probability_measure<Omega, events, probability, evidence>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
    let conditioned_probability = \conditioned_probability_measure<Omega, events, probability, evidence>
    let eis = \evidence_intersection_sequence<Omega, events, probability, evidence, family>
    by def $is_conditioning_data(Omega, events, probability, evidence)
    $is_probability_space(Omega, events, probability)
    probability(evidence) > 0
    by def $is_probability_space(Omega, events, probability)
    by thm evidence_intersection_sequence_is_pairwise_disjoint(Omega, events, probability, evidence, family) => $pairwise_disjoint_event_sequence(Omega, events, eis)
    by thm kolmogorov_countable_additivity(Omega, events, probability, eis) => $has_series_sum(fn(n N+) R {probability(eis(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {eis(n)})))
    by thm index_union_evidence_intersections(Omega, events, probability, evidence, family) => index_union(N+, Omega, fn(n N+) power_set(Omega) {eis(n)}) = intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)
    index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events
    intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence) $in events
    by thm equal_arguments_have_equal_function_values(events, R, probability, index_union(N+, Omega, fn(n N+) power_set(Omega) {eis(n)}), intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)) => probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {eis(n)})) = probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence))
    by thm equal_values_preserve_series_sum(fn(n N+) R {probability(eis(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {eis(n)})), probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence))) => $has_series_sum(fn(n N+) R {probability(eis(n))}, probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)))
    by thm scalar_multiple_preserves_series_sum(1 / probability(evidence), fn(n N+) R {probability(eis(n))}, probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence))) => $has_series_sum(fn(n N+) R {(1 / probability(evidence)) * probability(eis(n))}, (1 / probability(evidence)) * probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)))
    claim:
        ? forall n N+:
            conditioned_probability(family(n)) = (1 / probability(evidence)) * probability(eis(n))
        eis(n) = intersect(family(n), evidence)
        conditioned_probability(family(n)) = probability(intersect(family(n), evidence)) / probability(evidence)
        (1 / probability(evidence)) * probability(eis(n)) = (1 / probability(evidence)) * probability(intersect(family(n), evidence)) = probability(intersect(family(n), evidence)) / probability(evidence)
        conditioned_probability(family(n)) = probability(intersect(family(n), evidence)) / probability(evidence) = (1 / probability(evidence)) * probability(eis(n))
    by thm pointwise_equal_sequences_preserve_series_sum(fn(n N+) R {conditioned_probability(family(n))}, fn(n N+) R {(1 / probability(evidence)) * probability(eis(n))}, (1 / probability(evidence)) * probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence))) => $has_series_sum(fn(n N+) R {conditioned_probability(family(n))}, (1 / probability(evidence)) * probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)))
    conditioned_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)) / probability(evidence)
    probability(evidence) != 0
    by thm reciprocal_left_mul_equals_division(probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)), probability(evidence)) => (1 / probability(evidence)) * probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)) = probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)) / probability(evidence)
    (1 / probability(evidence)) * probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)) = probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)) / probability(evidence) = conditioned_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
    by thm equal_values_preserve_series_sum(fn(n N+) R {conditioned_probability(family(n))}, (1 / probability(evidence)) * probability(intersect(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}), evidence)), conditioned_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))) => $has_series_sum(fn(n N+) R {conditioned_probability(family(n))}, conditioned_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))

thm conditioned_probability_is_probability_space:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn(event events) R, evidence events:
        $is_conditioning_data(Omega, events, probability, evidence)
        =>:
            $is_probability_space(Omega, events, \conditioned_probability_measure<Omega, events, probability, evidence>)
    let conditioned_probability = \conditioned_probability_measure<Omega, events, probability, evidence>
    by def $is_conditioning_data(Omega, events, probability, evidence)
    $is_probability_space(Omega, events, probability)
    probability(evidence) > 0
    by thm event_is_subset_of_sample_space(Omega, events, evidence) => evidence $subset Omega
    intersect({}, evidence) = {}
    conditioned_probability({}) = probability(intersect({}, evidence)) / probability(evidence) = probability({}) / probability(evidence) = 0
    intersect(Omega, evidence) = evidence
    conditioned_probability(Omega) = probability(intersect(Omega, evidence)) / probability(evidence) = probability(evidence) / probability(evidence) = 1
    claim:
        ? forall event events:
            \conditioned_probability_measure<Omega, events, probability, evidence>(event) >= 0
        intersect(event, evidence) $in events
        probability(intersect(event, evidence)) >= 0
        probability(evidence) > 0
        conditioned_probability(event) = probability(intersect(event, evidence)) / probability(evidence)
        probability(intersect(event, evidence)) / probability(evidence) >= 0
    claim:
        ? forall family fn(n N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn(n N+) R {\conditioned_probability_measure<Omega, events, probability, evidence>(family(n))}, \conditioned_probability_measure<Omega, events, probability, evidence>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        by thm conditioned_probability_countable_additivity(Omega, events, probability, evidence, family) => $has_series_sum(fn(n N+) R {conditioned_probability(family(n))}, conditioned_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
    by def $is_probability_space(Omega, events, \conditioned_probability_measure<Omega, events, probability, evidence>)

prop is_finite_atomic_probability_data(Omega set, events power_set(power_set(Omega)), atom_indices finite_set, atom fn (atom_index atom_indices) Omega, weight fn (atom_index atom_indices) R):
    $is_sigma_algebra(Omega, events)
    forall atom_index atom_indices:
        weight(atom_index) >= 0
    finite_set_sum(atom_indices, weight) = 1
template<Omega set, events power_set(power_set(Omega)), atom_indices finite_set, atom fn (atom_index atom_indices) Omega, weight fn (atom_index atom_indices) R: $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)>:
    have fn finite_atomic_term(atom_index atom_indices, event events) R by cases :
        case atom(atom_index) $in event: weight(atom_index)
        case not atom(atom_index) $in event: 0
template<Omega set, events power_set(power_set(Omega)), atom_indices finite_set, atom fn (atom_index atom_indices) Omega, weight fn (atom_index atom_indices) R: $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)>:
    have fn finite_atomic_probability(event events) R = finite_set_sum(atom_indices, fn (atom_index atom_indices) R {\finite_atomic_term<Omega, events, atom_indices, atom, weight>(atom_index, event)})

thm partial_sum_pointwise_add:
    ? forall a, b seq(R), k N:
        partial_sum(fn(n N+) R {a(n) + b(n)}, k) = partial_sum(a, k) + partial_sum(b, k)
    by induc k from 0:
        ? partial_sum(fn(n N+) R {a(n) + b(n)}, k) = partial_sum(a, k) + partial_sum(b, k)

        ? from k = 0:
            partial_sum(fn(n N+) R {a(n) + b(n)}, 0) = 0
            partial_sum(a, 0) = 0
            partial_sum(b, 0) = 0
            partial_sum(a, 0) + partial_sum(b, 0) = 0
            partial_sum(fn(n N+) R {a(n) + b(n)}, k) = partial_sum(a, k) + partial_sum(b, k)

        ? induc:
            partial_sum(fn(n N+) R {a(n) + b(n)}, k) = partial_sum(a, k) + partial_sum(b, k)
            by thm partial_sum_successor(fn(n N+) R {a(n) + b(n)}, k) => partial_sum(fn(n N+) R {a(n) + b(n)}, k + 1) = partial_sum(fn(n N+) R {a(n) + b(n)}, k) + (a(k + 1) + b(k + 1))
            by thm partial_sum_successor(a, k) => partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            by thm partial_sum_successor(b, k) => partial_sum(b, k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k) + partial_sum(b, k) + (a(k + 1) + b(k + 1)) = (partial_sum(a, k) + a(k + 1)) + (partial_sum(b, k) + b(k + 1))
            partial_sum(fn(n N+) R {a(n) + b(n)}, k + 1) = partial_sum(fn(n N+) R {a(n) + b(n)}, k) + (a(k + 1) + b(k + 1)) = (partial_sum(a, k) + partial_sum(b, k)) + (a(k + 1) + b(k + 1)) = (partial_sum(a, k) + a(k + 1)) + (partial_sum(b, k) + b(k + 1)) = partial_sum(a, k + 1) + partial_sum(b, k + 1)

thm pointwise_add_preserves_sequence_limit:
    ? forall a, b seq(R), A, B R:
        $has_sequence_limit(a, A)
        $has_sequence_limit(b, B)
        =>:
            $has_sequence_limit(fn(n N+) R {a(n) + b(n)}, A + B)
    by def $has_sequence_limit(a, A)
    by def $has_sequence_limit(b, B)
    claim:
        ? forall epsilon R+:
            exist n0 N+ st {$is_tail_close_to(fn(n N+) R {a(n) + b(n)}, A + B, epsilon, n0)}
        epsilon / 2 $in R+
        obtain n1 from exist n1 N+ st {$is_tail_close_to(a, A, epsilon / 2, n1)}
        obtain n2 from exist n2 N+ st {$is_tail_close_to(b, B, epsilon / 2, n2)}
        have tail_start N+ = finite_set_max(union({n1}, {n2}))
        tail_start >= n1
        tail_start >= n2
        witness exist candidate_index N+ st {$is_tail_close_to(fn(n N+) R {a(n) + b(n)}, A + B, epsilon, candidate_index)} from tail_start:
            by def $is_tail_close_to(a, A, epsilon / 2, n1)
            by def $is_tail_close_to(b, B, epsilon / 2, n2)
            claim:
                ? forall n N+:
                    n >= tail_start
                    =>:
                        abs(fn(k N+) R {a(k) + b(k)}(n) - (A + B)) < epsilon
                n >= n1
                n >= n2
                abs(a(n) - A) < epsilon / 2
                abs(b(n) - B) < epsilon / 2
                fn(k N+) R {a(k) + b(k)}(n) = a(n) + b(n)
                a(n) + b(n) - (A + B) = (a(n) - A) + (b(n) - B)
                abs((a(n) - A) + (b(n) - B)) <= abs(a(n) - A) + abs(b(n) - B)
                abs(a(n) - A) + abs(b(n) - B) < epsilon / 2 + epsilon / 2 = epsilon
                abs(fn(k N+) R {a(k) + b(k)}(n) - (A + B)) = abs((a(n) - A) + (b(n) - B)) <= abs(a(n) - A) + abs(b(n) - B) < epsilon
            by def $is_tail_close_to(fn(n N+) R {a(n) + b(n)}, A + B, epsilon, tail_start)
    by def $has_sequence_limit(fn(n N+) R {a(n) + b(n)}, A + B)

thm pointwise_add_preserves_series_sum:
    ? forall a, b seq(R), A, B R:
        $has_series_sum(a, A)
        $has_series_sum(b, B)
        =>:
            $has_series_sum(fn(n N+) R {a(n) + b(n)}, A + B)
    by def $has_series_sum(a, A)
    by def $has_series_sum(b, B)
    by thm pointwise_add_preserves_sequence_limit(fn(k N+) R {partial_sum(a, k)}, fn(k N+) R {partial_sum(b, k)}, A, B) => $has_sequence_limit(fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}, A + B)
    claim:
        ? forall k N+:
            partial_sum(fn(n N+) R {a(n) + b(n)}, k) = partial_sum(a, k) + partial_sum(b, k)
        by thm partial_sum_pointwise_add(a, b, k) => partial_sum(fn(n N+) R {a(n) + b(n)}, k) = partial_sum(a, k) + partial_sum(b, k)
    by thm pointwise_equal_sequences_preserve_limit(fn(k N+) R {partial_sum(fn(n N+) R {a(n) + b(n)}, k)}, fn(k N+) R {partial_sum(a, k) + partial_sum(b, k)}, A + B) => $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {a(n) + b(n)}, k)}, A + B)
    by def $has_series_sum(fn(n N+) R {a(n) + b(n)}, A + B)

thm constant_zero_sequence_has_series_sum_zero:
    ? forall anchor N+:
        $has_series_sum(fn(n N+) R {0}, 0)
    by thm single_one_sequence_has_series_sum_one(anchor) => $has_series_sum(fn(n N+) R {single_one_sequence(anchor, n)}, 1)
    by thm scalar_multiple_preserves_series_sum(0, fn(n N+) R {single_one_sequence(anchor, n)}, 1) => $has_series_sum(fn(n N+) R {0 * single_one_sequence(anchor, n)}, 0 * 1)
    claim:
        ? forall n N+:
            0 * single_one_sequence(anchor, n) = 0
        0 * single_one_sequence(anchor, n) = 0
    by thm pointwise_equal_sequences_preserve_series_sum(fn(n N+) R {0}, fn(n N+) R {0 * single_one_sequence(anchor, n)}, 0) => $has_series_sum(fn(n N+) R {0}, 0)

prop finite_sum_of_series_holds(S finite_set):
    forall terms fn(term_index S) seq(R), values fn(value_index S) R:
        forall component_index S:
            $has_series_sum(terms(component_index), values(component_index))
        =>:
            $has_series_sum(fn(n N+) R {finite_set_sum(S, fn(component_index S) R {terms(component_index)(n)})}, finite_set_sum(S, values))

thm finite_sum_of_series:
    ? forall S finite_set:
        $finite_sum_of_series_holds(S)
    by induc P:
        ? $finite_sum_of_series_holds(P)

        ? from P = {}:
            claim:
                ? forall terms fn(term_index {}) seq(R), values fn(value_index {}) R:
                    forall component_index {}:
                        $has_series_sum(terms(component_index), values(component_index))
                    =>:
                        $has_series_sum(fn(n N+) R {finite_set_sum({}, fn(component_index {}) R {terms(component_index)(n)})}, finite_set_sum({}, values))
                by thm constant_zero_sequence_has_series_sum_zero(1) => $has_series_sum(fn(n N+) R {0}, 0)
                claim:
                    ? forall n N+:
                        fn(k N+) R {0}(n) = fn(k N+) R {finite_set_sum({}, fn(component_index {}) R {terms(component_index)(k)})}(n)
                    finite_set_sum({}, fn(component_index {}) R {terms(component_index)(n)}) = 0
                by thm pointwise_equal_sequences_preserve_series_sum(fn(n N+) R {finite_set_sum({}, fn(component_index {}) R {terms(component_index)(n)})}, fn(n N+) R {0}, 0) => $has_series_sum(fn(n N+) R {finite_set_sum({}, fn(component_index {}) R {terms(component_index)(n)})}, 0)
                finite_set_sum({}, values) = 0
                by thm equal_values_preserve_series_sum(fn(n N+) R {finite_set_sum({}, fn(component_index {}) R {terms(component_index)(n)})}, 0, finite_set_sum({}, values)) => $has_series_sum(fn(n N+) R {finite_set_sum({}, fn(component_index {}) R {terms(component_index)(n)})}, finite_set_sum({}, values))
            by def $finite_sum_of_series_holds({})

        ? induc K, I:
            $finite_sum_of_series_holds(I)
            claim:
                ? forall terms fn(term_index union({K}, I)) seq(R), values fn(value_index union({K}, I)) R:
                    forall component_index union({K}, I):
                        $has_series_sum(terms(component_index), values(component_index))
                    =>:
                        $has_series_sum(fn(n N+) R {finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})}, finite_set_sum(union({K}, I), values))
                not K $in I
                have fn terms_on_I(component_index I) seq(R) = terms(component_index)
                have fn values_on_I(component_index I) R = values(component_index)
                claim:
                    ? forall component_index I:
                        $has_series_sum(terms_on_I(component_index), values_on_I(component_index))
                    component_index $in union({K}, I)
                    terms_on_I(component_index) = terms(component_index)
                    values_on_I(component_index) = values(component_index)
                    $has_series_sum(terms(component_index), values(component_index))
                by def $finite_sum_of_series_holds(I)
                $has_series_sum(fn(n N+) R {finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)})}, finite_set_sum(I, values_on_I))
                $has_series_sum(terms(K), values(K))
                by thm pointwise_add_preserves_series_sum(terms(K), fn(n N+) R {finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)})}, values(K), finite_set_sum(I, values_on_I)) => $has_series_sum(fn(n N+) R {terms(K)(n) + finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)})}, values(K) + finite_set_sum(I, values_on_I))
                claim:
                    ? intersect({K}, I) = {}
                    by extension:
                        ? intersect({K}, I) = {}
                        claim:
                            ? forall component_index intersect({K}, I):
                                component_index $in {}
                            component_index = K
                            component_index $in I
                            K $in I
                            by contra:
                                ? component_index $in {}
                                impossible not K $in I
                        claim:
                            ? forall component_index {}:
                                component_index $in intersect({K}, I)
                            by contra:
                                ? component_index $in intersect({K}, I)
                                impossible component_index $in {}
                claim:
                    ? forall n N+:
                        terms(K)(n) + finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)}) = finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})
                    finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)}) = finite_set_sum({K}, fn(component_index {K}) R {terms(component_index)(n)}) + finite_set_sum(I, fn(component_index I) R {terms(component_index)(n)})
                    finite_set_sum({K}, fn(component_index {K}) R {terms(component_index)(n)}) = terms(K)(n)
                    forall component_index I:
                        terms_on_I(component_index) = terms(component_index)
                    finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)}) = finite_set_sum(I, fn(component_index I) R {terms(component_index)(n)})
                    terms(K)(n) + finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)}) = terms(K)(n) + finite_set_sum(I, fn(component_index I) R {terms(component_index)(n)}) = finite_set_sum({K}, fn(component_index {K}) R {terms(component_index)(n)}) + finite_set_sum(I, fn(component_index I) R {terms(component_index)(n)}) = finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})
                by thm pointwise_equal_sequences_preserve_series_sum(fn(n N+) R {finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})}, fn(n N+) R {terms(K)(n) + finite_set_sum(I, fn(component_index I) R {terms_on_I(component_index)(n)})}, values(K) + finite_set_sum(I, values_on_I)) => $has_series_sum(fn(n N+) R {finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})}, values(K) + finite_set_sum(I, values_on_I))
                finite_set_sum(union({K}, I), values) = finite_set_sum({K}, fn(component_index {K}) R {values(component_index)}) + finite_set_sum(I, fn(component_index I) R {values(component_index)})
                finite_set_sum({K}, fn(component_index {K}) R {values(component_index)}) = values(K)
                forall component_index I:
                    values_on_I(component_index) = values(component_index)
                finite_set_sum(I, values_on_I) = finite_set_sum(I, fn(component_index I) R {values(component_index)})
                values(K) + finite_set_sum(I, values_on_I) = values(K) + finite_set_sum(I, fn(component_index I) R {values(component_index)}) = finite_set_sum({K}, fn(component_index {K}) R {values(component_index)}) + finite_set_sum(I, fn(component_index I) R {values(component_index)}) = finite_set_sum(union({K}, I), values)
                by thm equal_values_preserve_series_sum(fn(n N+) R {finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})}, values(K) + finite_set_sum(I, values_on_I), finite_set_sum(union({K}, I), values)) => $has_series_sum(fn(n N+) R {finite_set_sum(union({K}, I), fn(component_index union({K}, I)) R {terms(component_index)(n)})}, finite_set_sum(union({K}, I), values))
            by def $finite_sum_of_series_holds(union({K}, I))

thm finite_atomic_term_as_weighted_dirac:
    ? forall Omega set, events power_set(power_set(Omega)), atom_indices finite_set, atom fn(atom_index atom_indices) Omega, weight fn(weight_index atom_indices) R, atom_index atom_indices, event events:
        $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)
        =>:
            \finite_atomic_term<Omega, events, atom_indices, atom, weight>(atom_index, event) = weight(atom_index) * \dirac_probability<Omega, events, atom(atom_index)>(event)
    let atomic_term = \finite_atomic_term<Omega, events, atom_indices, atom, weight>
    atom(atom_index) $in event or not atom(atom_index) $in event
    by cases:
        ? atomic_term(atom_index, event) = weight(atom_index) * \dirac_probability<Omega, events, atom(atom_index)>(event)
        case atom(atom_index) $in event:
            atomic_term(atom_index, event) = weight(atom_index)
            \dirac_probability<Omega, events, atom(atom_index)>(event) = 1
            weight(atom_index) * 1 = weight(atom_index)
            atomic_term(atom_index, event) = weight(atom_index) = weight(atom_index) * 1 = weight(atom_index) * \dirac_probability<Omega, events, atom(atom_index)>(event)
        case not atom(atom_index) $in event:
            atomic_term(atom_index, event) = 0
            \dirac_probability<Omega, events, atom(atom_index)>(event) = 0
            weight(atom_index) * 0 = 0
            \finite_atomic_term<Omega, events, atom_indices, atom, weight>(atom_index, event) = 0 = weight(atom_index) * 0 = weight(atom_index) * \dirac_probability<Omega, events, atom(atom_index)>(event)

thm finite_atomic_probability_countable_additivity:
    ? forall Omega set, events power_set(power_set(Omega)), atom_indices finite_set, atom fn(atom_index atom_indices) Omega, weight fn(weight_index atom_indices) R, family fn(n N+) events:
        $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)
        $pairwise_disjoint_event_sequence(Omega, events, family)
        =>:
            $has_series_sum(fn(n N+) R {\finite_atomic_probability<Omega, events, atom_indices, atom, weight>(family(n))}, \finite_atomic_probability<Omega, events, atom_indices, atom, weight>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
    let atomic_probability = \finite_atomic_probability<Omega, events, atom_indices, atom, weight>
    let atomic_term = \finite_atomic_term<Omega, events, atom_indices, atom, weight>
    by def $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)
    $is_sigma_algebra(Omega, events)
    index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events
    have fn weighted_atom_series(component atom_indices) seq(R) = fn(n N+) R {weight(component) * \dirac_probability<Omega, events, atom(component)>(family(n))}
    have fn weighted_atom_value(component atom_indices) R = weight(component) * \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
    claim:
        ? forall component atom_indices:
            $has_series_sum(weighted_atom_series(component), weighted_atom_value(component))
        by thm dirac_probability_countable_additivity(Omega, events, atom(component), family) => $has_series_sum(fn(n N+) R {\dirac_probability<Omega, events, atom(component)>(family(n))}, \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        by thm scalar_multiple_preserves_series_sum(weight(component), fn(n N+) R {\dirac_probability<Omega, events, atom(component)>(family(n))}, \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))) => $has_series_sum(fn(n N+) R {weight(component) * \dirac_probability<Omega, events, atom(component)>(family(n))}, weight(component) * \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        weighted_atom_series(component) = fn(n N+) R {weight(component) * \dirac_probability<Omega, events, atom(component)>(family(n))}
        weighted_atom_value(component) = weight(component) * \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
        $has_series_sum(weighted_atom_series(component), weighted_atom_value(component))
    by thm finite_sum_of_series(atom_indices) => $finite_sum_of_series_holds(atom_indices)
    by def $finite_sum_of_series_holds(atom_indices)
    $has_series_sum(fn(n N+) R {finite_set_sum(atom_indices, fn(component atom_indices) R {weighted_atom_series(component)(n)})}, finite_set_sum(atom_indices, weighted_atom_value))
    claim:
        ? forall n N+:
            finite_set_sum(atom_indices, fn(component atom_indices) R {weighted_atom_series(component)(n)}) = atomic_probability(family(n))
        claim:
            ? forall component atom_indices:
                atomic_term(component, family(n)) = weighted_atom_series(component)(n)
            by thm finite_atomic_term_as_weighted_dirac(Omega, events, atom_indices, atom, weight, component, family(n)) => atomic_term(component, family(n)) = weight(component) * \dirac_probability<Omega, events, atom(component)>(family(n))
            weighted_atom_series(component)(n) = weight(component) * \dirac_probability<Omega, events, atom(component)>(family(n))
            atomic_term(component, family(n)) = weighted_atom_series(component)(n)
        finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, family(n))}) = finite_set_sum(atom_indices, fn(component atom_indices) R {weighted_atom_series(component)(n)})
        atomic_probability(family(n)) = finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, family(n))})
        finite_set_sum(atom_indices, fn(component atom_indices) R {weighted_atom_series(component)(n)}) = finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, family(n))}) = atomic_probability(family(n))
    by thm pointwise_equal_sequences_preserve_series_sum(fn(n N+) R {atomic_probability(family(n))}, fn(n N+) R {finite_set_sum(atom_indices, fn(component atom_indices) R {weighted_atom_series(component)(n)})}, finite_set_sum(atom_indices, weighted_atom_value)) => $has_series_sum(fn(n N+) R {atomic_probability(family(n))}, finite_set_sum(atom_indices, weighted_atom_value))
    claim:
        ? forall component atom_indices:
            atomic_term(component, index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = weighted_atom_value(component)
        by thm finite_atomic_term_as_weighted_dirac(Omega, events, atom_indices, atom, weight, component, index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) => atomic_term(component, index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = weight(component) * \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
        weighted_atom_value(component) = weight(component) * \dirac_probability<Omega, events, atom(component)>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
        atomic_term(component, index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = weighted_atom_value(component)
    finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))}) = finite_set_sum(atom_indices, weighted_atom_value)
    atomic_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})) = finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))})
    finite_set_sum(atom_indices, weighted_atom_value) = atomic_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))
    by thm equal_values_preserve_series_sum(fn(n N+) R {\finite_atomic_probability<Omega, events, atom_indices, atom, weight>(family(n))}, finite_set_sum(atom_indices, weighted_atom_value), \finite_atomic_probability<Omega, events, atom_indices, atom, weight>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}))) => $has_series_sum(fn(n N+) R {\finite_atomic_probability<Omega, events, atom_indices, atom, weight>(family(n))}, \finite_atomic_probability<Omega, events, atom_indices, atom, weight>(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))

thm finite_atomic_probability_is_probability_space:
    ? forall Omega set, events power_set(power_set(Omega)), atom_indices finite_set, atom fn(atom_index atom_indices) Omega, weight fn(weight_index atom_indices) R:
        $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)
        =>:
            $is_probability_space(Omega, events, \finite_atomic_probability<Omega, events, atom_indices, atom, weight>)
    let atomic_probability = \finite_atomic_probability<Omega, events, atom_indices, atom, weight>
    let atomic_term = \finite_atomic_term<Omega, events, atom_indices, atom, weight>
    by def $is_finite_atomic_probability_data(Omega, events, atom_indices, atom, weight)
    claim:
        ? atomic_probability({}) = 0
        claim:
            ? forall component atom_indices:
                atomic_term(component, {}) = 0
            not atom(component) $in {}
            atomic_term(component, {}) = 0
        finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, {})}) = finite_set_sum(atom_indices, fn(component atom_indices) R {0})
        finite_set_sum(atom_indices, fn(component atom_indices) R {0}) = 0
        atomic_probability({}) = finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, {})}) = 0
    claim:
        ? atomic_probability(Omega) = 1
        claim:
            ? forall component atom_indices:
                atomic_term(component, Omega) = weight(component)
            atom(component) $in Omega
            atomic_term(component, Omega) = weight(component)
        finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, Omega)}) = finite_set_sum(atom_indices, weight)
        finite_set_sum(atom_indices, weight) = 1
        atomic_probability(Omega) = finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, Omega)}) = 1
    claim:
        ? forall event events:
            atomic_probability(event) >= 0
        claim:
            ? forall component atom_indices:
                atomic_term(component, event) >= 0
            atom(component) $in event or not atom(component) $in event
            by cases:
                ? atomic_term(component, event) >= 0
                case atom(component) $in event:
                    atomic_term(component, event) = weight(component)
                    weight(component) >= 0
                case not atom(component) $in event:
                    atomic_term(component, event) = 0
                    0 >= 0
        release thm finite_set_sum_le_from_pointwise(finite_set_sum(atom_indices, fn(component atom_indices) R {0}), finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, event)}))
        finite_set_sum(atom_indices, fn(component atom_indices) R {0}) = 0
        finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, event)}) >= 0
        atomic_probability(event) = finite_set_sum(atom_indices, fn(component atom_indices) R {atomic_term(component, event)})
    claim:
        ? forall family fn(n N+) events:
            $pairwise_disjoint_event_sequence(Omega, events, family)
            =>:
                $has_series_sum(fn(n N+) R {atomic_probability(family(n))}, atomic_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
        by thm finite_atomic_probability_countable_additivity(Omega, events, atom_indices, atom, weight, family) => $has_series_sum(fn(n N+) R {atomic_probability(family(n))}, atomic_probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))
    by def $is_probability_space(Omega, events, atomic_probability)
    $is_probability_space(Omega, events, \finite_atomic_probability<Omega, events, atom_indices, atom, weight>)
