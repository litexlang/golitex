# Probability theory from the Kolmogorov axioms, setting-first.
#
# Included: countable unions and real series, generated and Borel sigma
# algebras, probability spaces, countable and finite additivity, conditional
# probability, measurable maps, pushforward measures, and distributions.
#
# Main line:
#
#   sigma-algebra + real series
#       -> real-valued probability space
#       -> countable additivity
#       -> conditional probability and independence
#       -> measurable random variables and pushforward probability measures.

# Countable unions use the first-class indexed-family operator. Its explicit
# ambient set also fixes the empty-family intersection convention elsewhere.

# A real series sum is a relation on a candidate value, not a total selector.
have fn partial_sum(a seq(R), k N) R by induc k from 0:
    case k = 0: 0
    case k >= 1: partial_sum(a, k - 1) + a(k)

prop is_tail_close_to(a seq(R), L R, epsilon R+, n0 N+):
    forall n N+:
        n >= n0
        =>:
            abs(a(n) - L) < epsilon

prop has_sequence_limit(a seq(R), L R):
    forall epsilon R+:
        exist n0 N+ st {$is_tail_close_to(a, L, epsilon, n0)}

prop has_series_sum(a seq(R), L R):
    $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L)

# The whole-space and binary-intersection laws are conservative projections of
# the usual empty/complement/countable-union sigma-algebra axioms. Keeping them
# visible gives later exact-carrier probability applications a direct event
# membership fact.
setting SigmaAlgebraSetting(Omega set, events power_set(power_set(Omega))):
    {} $in events
    Omega $in events
    forall event events:
        set_minus(Omega, event) $in events
    forall left_event, right_event events:
        intersect(left_event, right_event) $in events
    forall family fn(n N+) events:
        index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)}) $in events

prop is_sigma_algebra([SigmaAlgebraSetting])

# The sigma algebra generated by a family is the intersection of all sigma
# algebras on the same carrier that contain that family. This is a genuine
# construction: later code can use the resulting event family directly.
prop is_sigma_algebra_containing(X set, generators, candidate_events power_set(power_set(X))):
    $is_sigma_algebra(X, candidate_events)
    generators $subset candidate_events

prop belongs_to_every_sigma_algebra_containing(X set, generators power_set(power_set(X)), event power_set(X)):
    forall candidate_events power_set(power_set(X)):
        $is_sigma_algebra_containing(X, generators, candidate_events)
        =>:
            event $in candidate_events

template<X set>:
    have fn generated_sigma_algebra(generators power_set(power_set(X))) power_set(power_set(X)) = {event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, event)}

thm generators_are_in_generated_sigma_algebra:
    ? forall X set, generators power_set(power_set(X)):
        generators $subset \generated_sigma_algebra<X>(generators)
    claim:
        ? forall event generators:
            event $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    event $in candidate_events
            by def $is_sigma_algebra_containing(X, generators, candidate_events)
        by def $belongs_to_every_sigma_algebra_containing(X, generators, event)
        by thm set_builder_member(event, {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}) => event $in {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
        event $in \generated_sigma_algebra<X>(generators)
    by def:
        ? generators $subset \generated_sigma_algebra<X>(generators)

thm belongs_to_every_sigma_algebra_containing_implies_generated_membership:
    ? forall X set, generators power_set(power_set(X)), event power_set(X):
        $belongs_to_every_sigma_algebra_containing(X, generators, event)
        =>:
            event $in \generated_sigma_algebra<X>(generators)
    by thm set_builder_member(event, {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}) => event $in {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
    event $in \generated_sigma_algebra<X>(generators)

thm generated_membership_implies_belongs_to_every_sigma_algebra_containing:
    ? forall X set, generators power_set(power_set(X)), event \generated_sigma_algebra<X>(generators):
        $belongs_to_every_sigma_algebra_containing(X, generators, event)
    \generated_sigma_algebra<X>(generators) = {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
    event $in {candidate_event power_set(X): $belongs_to_every_sigma_algebra_containing(X, generators, candidate_event)}
    $belongs_to_every_sigma_algebra_containing(X, generators, event)

thm generated_sigma_algebra_is_sigma_algebra:
    ? forall X set, generators power_set(power_set(X)):
        $is_sigma_algebra(X, \generated_sigma_algebra<X>(generators))
    claim:
        ? {} $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    {} $in candidate_events
            {} $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, {})
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, {}) => {} $in \generated_sigma_algebra<X>(generators)
    claim:
        ? X $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    X $in candidate_events
            X $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, X)
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, X) => X $in \generated_sigma_algebra<X>(generators)
    claim:
        ? forall event \generated_sigma_algebra<X>(generators):
            set_minus(X, event) $in \generated_sigma_algebra<X>(generators)
        by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, event) => $belongs_to_every_sigma_algebra_containing(X, generators, event)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    set_minus(X, event) $in candidate_events
            event $in candidate_events
            set_minus(X, event) $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, set_minus(X, event))
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, set_minus(X, event)) => set_minus(X, event) $in \generated_sigma_algebra<X>(generators)
    claim:
        ? forall left_event, right_event \generated_sigma_algebra<X>(generators):
            intersect(left_event, right_event) $in \generated_sigma_algebra<X>(generators)
        by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, left_event) => $belongs_to_every_sigma_algebra_containing(X, generators, left_event)
        by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, right_event) => $belongs_to_every_sigma_algebra_containing(X, generators, right_event)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    intersect(left_event, right_event) $in candidate_events
            left_event $in candidate_events
            right_event $in candidate_events
            intersect(left_event, right_event) $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, intersect(left_event, right_event))
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, intersect(left_event, right_event)) => intersect(left_event, right_event) $in \generated_sigma_algebra<X>(generators)
    claim:
        ? forall family fn(n N+) \generated_sigma_algebra<X>(generators):
            index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in \generated_sigma_algebra<X>(generators)
        claim:
            ? forall candidate_events power_set(power_set(X)):
                $is_sigma_algebra_containing(X, generators, candidate_events)
                =>:
                    index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in candidate_events
            claim:
                ? forall n N+:
                    family(n) $in candidate_events
                by thm generated_membership_implies_belongs_to_every_sigma_algebra_containing(X, generators, family(n)) => $belongs_to_every_sigma_algebra_containing(X, generators, family(n))
                family(n) $in candidate_events
            have fn candidate_family(n N+) candidate_events = family(n)
            forall n N+:
                candidate_family(n) = family(n)
            index_union(N+, X, fn(n N+) power_set(X) {candidate_family(n)}) $in candidate_events
            index_union(N+, X, fn(n N+) power_set(X) {candidate_family(n)}) = index_union(N+, X, fn(n N+) power_set(X) {family(n)})
            index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in candidate_events
        by def $belongs_to_every_sigma_algebra_containing(X, generators, index_union(N+, X, fn(n N+) power_set(X) {family(n)}))
        by thm belongs_to_every_sigma_algebra_containing_implies_generated_membership(X, generators, index_union(N+, X, fn(n N+) power_set(X) {family(n)})) => index_union(N+, X, fn(n N+) power_set(X) {family(n)}) $in \generated_sigma_algebra<X>(generators)
    by def $is_sigma_algebra(X, \generated_sigma_algebra<X>(generators))

# The standard Borel sigma algebra on R is generated by all bounded open
# intervals. Bounded open intervals suffice to generate the usual Borel
# sigma algebra, and keep the generator presentation first-order and usable.
prop is_real_open_interval(interval power_set(R)):
    exist left, right R st {left < right, interval = {x R: left < x < right}}

have real_open_intervals power_set(power_set(R)) = {interval power_set(R): $is_real_open_interval(interval)}

have borel_sigma_algebra_on_R power_set(power_set(R)) = \generated_sigma_algebra<R>(real_open_intervals)

by thm generated_sigma_algebra_is_sigma_algebra(R, real_open_intervals) => $is_sigma_algebra(R, \generated_sigma_algebra<R>(real_open_intervals))
borel_sigma_algebra_on_R = \generated_sigma_algebra<R>(real_open_intervals)
$is_sigma_algebra(R, borel_sigma_algebra_on_R)

thm real_open_interval_is_borel:
    ? forall left, right R:
        left < right
        =>:
            {x R: left < x < right} $in borel_sigma_algebra_on_R
    claim:
        ? $is_real_open_interval({x R: left < x < right})
        witness exist interval_left, interval_right R st {interval_left < interval_right, {x R: left < x < right} = {x R: interval_left < x < interval_right}} from left, right:
            left < right
            {x R: left < x < right} = {x R: left < x < right}
    claim:
        ? {x R: left < x < right} $in real_open_intervals
        by thm set_builder_member({x R: left < x < right}, {interval power_set(R): $is_real_open_interval(interval)}) => {x R: left < x < right} $in {interval power_set(R): $is_real_open_interval(interval)}
        real_open_intervals = {interval power_set(R): $is_real_open_interval(interval)}
        {x R: left < x < right} $in real_open_intervals
    by thm generators_are_in_generated_sigma_algebra(R, real_open_intervals) => real_open_intervals $subset \generated_sigma_algebra<R>(real_open_intervals)
    {x R: left < x < right} $in \generated_sigma_algebra<R>(real_open_intervals)
    borel_sigma_algebra_on_R = \generated_sigma_algebra<R>(real_open_intervals)
    {x R: left < x < right} $in borel_sigma_algebra_on_R

# Event families now use the same checked indexed-set algebra as ordinary
# sets. These are direct builtin identities and bounds, not auxiliary theorems.
# The concrete finite sample space keeps this section executable on its own.
have fn finite_event_family(event_index {1, 2}) power_set({1, 2, 3}) by cases:
    case event_index = 1: {1, 2}
    case event_index = 2: {2, 3}

finite_event_family(1) $subset index_union({1, 2}, {1, 2, 3}, finite_event_family)
index_intersect({1, 2}, {1, 2, 3}, finite_event_family) $subset finite_event_family(2)

# Complementing a union/intersection of events is pointwise De Morgan. The
# explicit sample-space ambient also handles an empty event family correctly.
set_minus({1, 2, 3}, index_union({1, 2}, {1, 2, 3}, finite_event_family)) = index_intersect({1, 2}, {1, 2, 3}, fn(event_index {1, 2}) power_set({1, 2, 3}) {set_minus({1, 2, 3}, finite_event_family(event_index))})
set_minus({1, 2, 3}, index_intersect({1, 2}, {1, 2, 3}, finite_event_family)) = index_union({1, 2}, {1, 2, 3}, fn(event_index {1, 2}) power_set({1, 2, 3}) {set_minus({1, 2, 3}, finite_event_family(event_index))})

prop pairwise_disjoint_event_sequence(Omega set, events power_set(power_set(Omega)), family fn(n N+) events):
    forall idx, j N+:
        idx != j
        =>:
            intersect(family(idx), family(j)) = {}

# Kolmogorov probability is real-valued: total mass one makes infinity
# unnecessary. Empty-event zero is retained as its standard derived projection.
setting ProbabilitySpaceSetting([SigmaAlgebraSetting], probability fn(event events) R):
    probability({}) = 0
    probability(Omega) = 1
    forall event events:
        probability(event) >= 0
    forall family fn(n N+) events:
        $pairwise_disjoint_event_sequence(Omega, events, family)
        =>:
            $has_series_sum(fn(n N+) R {probability(family(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {family(n)})))

prop is_probability_space([ProbabilitySpaceSetting])

# Tracer theorem: the third Kolmogorov axiom is directly consumable, with the
# right side carrying ordinary real-series convergence semantics.
thm kolmogorov_countable_additivity:
    ? forall [ProbabilitySpaceSetting], event_sequence fn(n N+) events:
        $pairwise_disjoint_event_sequence(Omega, events, event_sequence)
        =>:
            $has_series_sum(fn(n N+) R {probability(event_sequence(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)})))

# Event-level probability calculus.
template<Omega set, events power_set(power_set(Omega)), probability fn(event events) R>:
    have fn conditional_probability(A, B events: intersect(A, B) $in events, probability(B) > 0) R = probability(intersect(A, B)) / probability(B)

prop are_independent(Omega set, events power_set(power_set(Omega)), probability fn(event events) R, A, B events):
    intersect(A, B) $in events
    probability(intersect(A, B)) = probability(A) * probability(B)

thm event_intersection_is_event:
    ? forall [SigmaAlgebraSetting], A, B events:
        intersect(A, B) $in events

# Independence replaces the intersection probability in the conditional
# quotient and cancels the positive evidence probability.
thm independent_event_conditional_probability:
    ? forall [ProbabilitySpaceSetting], A, B events:
        $are_independent(Omega, events, probability, A, B)
        probability(B) > 0
        =>:
            \conditional_probability<Omega, events, probability>(A, B) = probability(A)
    by def $are_independent(Omega, events, probability, A, B)
    \conditional_probability<Omega, events, probability>(A, B) = probability(intersect(A, B)) / probability(B)
    probability(B) != 0
    probability(intersect(A, B)) / probability(B) = (probability(A) * probability(B)) / probability(B) = probability(A)

# Measurable maps and random variables remain distinct from their pushforward
# distributions. Generic maps still receive an explicit target sigma algebra;
# callers may choose the constructed borel_sigma_algebra_on_R when Target = R.
prop is_measurable_map(Source, Target set, source_events power_set(power_set(Source)), target_events power_set(power_set(Target)), f fn(x Source) Target):
    forall target_event target_events:
        {x Source: f(x) $in target_event} $in source_events

prop is_random_variable(Omega set, events power_set(power_set(Omega)), real_events power_set(power_set(R)), X fn(omega Omega) R):
    $is_measurable_map(Omega, R, events, real_events, X)

prop is_distribution_of(Omega set, events power_set(power_set(Omega)), probability fn(event events) R, Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target, distribution fn(target_event target_events) R):
    forall target_event target_events:
        {omega Omega: X(omega) $in target_event} $in events
        distribution(target_event) = probability({omega Omega: X(omega) $in target_event})

# A measurable map constructs its own pushforward probability function. The
# measurability evidence in the template domain makes every preimage an exact
# source event, so evaluation never relies on an unchecked carrier coercion.
template<Omega set, events power_set(power_set(Omega)), probability fn(event events) R, Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target: $is_measurable_map(Omega, Target, events, target_events, X)>:
    have fn pushforward_probability(target_event target_events) R = probability({omega Omega: X(omega) $in target_event})

thm pushforward_probability_is_distribution:
    ? forall [ProbabilitySpaceSetting], Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target:
        $is_measurable_map(Omega, Target, events, target_events, X)
        =>:
            $is_distribution_of(Omega, events, probability, Target, target_events, X, \pushforward_probability<Omega, events, probability, Target, target_events, X>)
    claim:
        ? forall target_event target_events:
            {omega Omega: X(omega) $in target_event} $in events
            \pushforward_probability<Omega, events, probability, Target, target_events, X>(target_event) = probability({omega Omega: X(omega) $in target_event})
        {omega Omega: X(omega) $in target_event} $in events
        \pushforward_probability<Omega, events, probability, Target, target_events, X>(target_event) = probability({omega Omega: X(omega) $in target_event})
    by def $is_distribution_of(Omega, events, probability, Target, target_events, X, \pushforward_probability<Omega, events, probability, Target, target_events, X>)

# Preimages preserve the set operations needed by a probability measure.
thm preimage_of_empty_is_empty:
    ? forall Source, Target set, f fn(x Source) Target:
        {x Source: f(x) $in {}} = {}
    by extension:
        ? {x Source: f(x) $in {}} = {}
        claim:
            ? forall point {x Source: f(x) $in {}}:
                point $in {}
            by contra:
                ? point $in {}
                not point $in {}
                f(point) $in {}
                impossible f(point) $in {}
        claim:
            ? forall point {}:
                point $in {x Source: f(x) $in {}}
            by contra:
                ? point $in {x Source: f(x) $in {}}
                not point $in {x Source: f(x) $in {}}
                impossible point $in {}

thm preimage_of_universe_is_source:
    ? forall Source, Target set, f fn(x Source) Target:
        {x Source: f(x) $in Target} = Source
    by extension:
        ? {x Source: f(x) $in Target} = Source
        claim:
            ? forall point {x Source: f(x) $in Target}:
                point $in Source
            point $in Source
        claim:
            ? forall point Source:
                point $in {x Source: f(x) $in Target}
            f(point) $in Target
            by thm set_builder_member(point, {x Source: f(x) $in Target}) => point $in {x Source: f(x) $in Target}

thm preimage_of_index_union:
    ? forall Source, Target set, f fn(x Source) Target, family fn(n N+) power_set(Target):
        {x Source: f(x) $in index_union(N+, Target, family)} = index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
    by extension:
        ? {x Source: f(x) $in index_union(N+, Target, family)} = index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
        claim:
            ? forall point {x Source: f(x) $in index_union(N+, Target, family)}:
                point $in index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
            f(point) $in index_union(N+, Target, family)
            obtain idx from exist idx N+ st {f(point) $in family(idx)}
            by thm set_builder_member(point, {x Source: f(x) $in family(idx)}) => point $in {x Source: f(x) $in family(idx)}
            witness exist candidate_index N+ st {point $in {x Source: f(x) $in family(candidate_index)}} from idx
            point $in index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}})
        claim:
            ? forall point index_union(N+, Source, fn(n N+) power_set(Source) {{x Source: f(x) $in family(n)}}):
                point $in {x Source: f(x) $in index_union(N+, Target, family)}
            obtain idx from exist idx N+ st {point $in {x Source: f(x) $in family(idx)}}
            f(point) $in family(idx)
            witness exist candidate_index N+ st {f(point) $in family(candidate_index)} from idx
            f(point) $in index_union(N+, Target, family)
            by thm set_builder_member(point, {x Source: f(x) $in index_union(N+, Target, family)}) => point $in {x Source: f(x) $in index_union(N+, Target, family)}

# The exact-carrier preimage sequence packages measurability once and is then
# reusable by both disjointness and countable-additivity arguments.
template<Source set, Target set, source_events power_set(power_set(Source)), target_events power_set(power_set(Target)), f fn(x Source) Target, family fn(n N+) target_events: $is_measurable_map(Source, Target, source_events, target_events, f)>:
    have fn measurable_preimage_sequence(n N+) source_events = {x Source: f(x) $in family(n)}

thm measurable_preimage_sequence_is_pairwise_disjoint:
    ? forall Source, Target set, source_events power_set(power_set(Source)), target_events power_set(power_set(Target)), f fn(x Source) Target, family fn(n N+) target_events:
        $is_measurable_map(Source, Target, source_events, target_events, f)
        $pairwise_disjoint_event_sequence(Target, target_events, family)
        =>:
            $pairwise_disjoint_event_sequence(Source, source_events, \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>)
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(\measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx), \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j)) = {}
        intersect(family(idx), family(j)) = {}
        \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx) = {x Source: f(x) $in family(idx)}
        \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j) = {x Source: f(x) $in family(j)}
        by extension:
            ? intersect(\measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx), \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j)) = {}
            claim:
                ? forall point intersect(\measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx), \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j)):
                    point $in {}
                by contra:
                    ? point $in {}
                    not point $in {}
                    point $in {x Source: f(x) $in family(idx)}
                    point $in {x Source: f(x) $in family(j)}
                    f(point) $in family(idx)
                    f(point) $in family(j)
                    f(point) $in intersect(family(idx), family(j))
                    f(point) $in {}
                    impossible f(point) $in {}
            claim:
                ? forall point {}:
                    point $in intersect(\measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx), \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j))
                by contra:
                    ? point $in intersect(\measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx), \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j))
                    not point $in intersect(\measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(idx), \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>(j))
                    impossible point $in {}
    by def $pairwise_disjoint_event_sequence(Source, source_events, \measurable_preimage_sequence<Source, Target, source_events, target_events, f, family>)

thm pushforward_probability_is_probability_space:
    ? forall [ProbabilitySpaceSetting], Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target:
        $is_sigma_algebra(Target, target_events)
        $is_measurable_map(Omega, Target, events, target_events, X)
        =>:
            $is_probability_space(Target, target_events, \pushforward_probability<Omega, events, probability, Target, target_events, X>)
    by thm preimage_of_empty_is_empty(Omega, Target, X) => {omega Omega: X(omega) $in {}} = {}
    \pushforward_probability<Omega, events, probability, Target, target_events, X>({}) = probability({omega Omega: X(omega) $in {}}) = probability({}) = 0
    by thm preimage_of_universe_is_source(Omega, Target, X) => {omega Omega: X(omega) $in Target} = Omega
    \pushforward_probability<Omega, events, probability, Target, target_events, X>(Target) = probability({omega Omega: X(omega) $in Target}) = probability(Omega) = 1
    claim:
        ? forall target_event target_events:
            \pushforward_probability<Omega, events, probability, Target, target_events, X>(target_event) >= 0
        {omega Omega: X(omega) $in target_event} $in events
        \pushforward_probability<Omega, events, probability, Target, target_events, X>(target_event) = probability({omega Omega: X(omega) $in target_event})
        probability({omega Omega: X(omega) $in target_event}) >= 0
    claim:
        ? forall family fn(n N+) target_events:
            $pairwise_disjoint_event_sequence(Target, target_events, family)
            =>:
                $has_series_sum(fn(n N+) R {\pushforward_probability<Omega, events, probability, Target, target_events, X>(family(n))}, \pushforward_probability<Omega, events, probability, Target, target_events, X>(index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})))
        have source_union events = index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})
        by thm measurable_preimage_sequence_is_pairwise_disjoint(Omega, Target, events, target_events, X, family) => $pairwise_disjoint_event_sequence(Omega, events, \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>)
        by thm kolmogorov_countable_additivity(Omega, events, probability, \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>) => $has_series_sum(fn(n N+) R {probability(\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n))}, probability(index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})))
        source_union = index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})
        $has_series_sum(fn(n N+) R {probability(\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n))}, probability(source_union))
        claim:
            ? forall n N+:
                probability(\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)) = \pushforward_probability<Omega, events, probability, Target, target_events, X>(family(n))
            \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n) = {omega Omega: X(omega) $in family(n)}
            \pushforward_probability<Omega, events, probability, Target, target_events, X>(family(n)) = probability({omega Omega: X(omega) $in family(n)})
        by def $fn_eq(fn(n N+) R {probability(\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n))}, fn(n N+) R {\pushforward_probability<Omega, events, probability, Target, target_events, X>(family(n))})
        fn(n N+) R {probability(\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n))} = fn(n N+) R {\pushforward_probability<Omega, events, probability, Target, target_events, X>(family(n))}
        claim:
            ? {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})} = source_union
            by extension:
                ? {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})} = source_union
                claim:
                    ? forall point {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}:
                        point $in source_union
                    X(point) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})
                    obtain idx from exist idx N+ st {X(point) $in family(idx)}
                    \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(idx) = {omega Omega: X(omega) $in family(idx)}
                    by thm set_builder_member(point, {omega Omega: X(omega) $in family(idx)}) => point $in {omega Omega: X(omega) $in family(idx)}
                    point $in \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(idx)
                    witness exist candidate_index N+ st {point $in \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(candidate_index)} from idx
                    point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})
                    source_union = index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})
                    point $in source_union
                claim:
                    ? forall point source_union:
                        point $in {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}
                    source_union = index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})
                    point $in index_union(N+, Omega, fn(n N+) power_set(Omega) {\measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(n)})
                    obtain idx from exist idx N+ st {point $in \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(idx)}
                    \measurable_preimage_sequence<Omega, Target, events, target_events, X, family>(idx) = {omega Omega: X(omega) $in family(idx)}
                    point $in {omega Omega: X(omega) $in family(idx)}
                    X(point) $in family(idx)
                    witness exist candidate_index N+ st {X(point) $in family(candidate_index)} from idx
                    X(point) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})
                    by thm set_builder_member(point, {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}) => point $in {omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}
        \pushforward_probability<Omega, events, probability, Target, target_events, X>(index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})) = probability({omega Omega: X(omega) $in index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})}) = probability(source_union)
        $has_series_sum(fn(n N+) R {\pushforward_probability<Omega, events, probability, Target, target_events, X>(family(n))}, \pushforward_probability<Omega, events, probability, Target, target_events, X>(index_union(N+, Target, fn(n N+) power_set(Target) {family(n)})))
    by def $is_probability_space(Target, target_events, \pushforward_probability<Omega, events, probability, Target, target_events, X>)

# A distribution package already contains every preimage-event obligation, so
# it immediately exposes the underlying measurable map.
thm distribution_of_has_measurable_map:
    ? forall Omega set, events power_set(power_set(Omega)), probability fn(event events) R, Target set, target_events power_set(power_set(Target)), X fn(omega Omega) Target, distribution fn(target_event target_events) R:
        $is_distribution_of(Omega, events, probability, Target, target_events, X, distribution)
        =>:
            $is_measurable_map(Omega, Target, events, target_events, X)
    by def $is_distribution_of(Omega, events, probability, Target, target_events, X, distribution)
    by def $is_measurable_map(Omega, Target, events, target_events, X)

# Derived probability calculus starts from two reusable analytic facts:
# sequence limits are unique, and a finite two-term prefix has its expected
# real-series sum.
thm sequence_limit_unique:
    ? forall a seq(R), L1, L2 R:
        $has_sequence_limit(a, L1)
        $has_sequence_limit(a, L2)
        =>:
            L1 = L2
    by contra:
        ? L1 = L2
        L1 - L2 != 0
        abs(L1 - L2) > 0
        abs(L1 - L2) / 3 > 0
        abs(L1 - L2) / 3 $in R+
        obtain n1 from exist n1 N+ st {$is_tail_close_to(a, L1, abs(L1 - L2) / 3, n1)}
        obtain n2 from exist n2 N+ st {$is_tail_close_to(a, L2, abs(L1 - L2) / 3, n2)}
        have n0 N+ = finite_set_max(union({n1}, {n2}))
        n0 >= n1
        n0 >= n2
        abs(a(n0) - L1) < abs(L1 - L2) / 3
        abs(a(n0) - L2) < abs(L1 - L2) / 3
        abs(L1 - a(n0)) = abs(a(n0) - L1)
        L1 - L2 = (L1 - a(n0)) + (a(n0) - L2)
        abs(L1 - L2) = abs((L1 - a(n0)) + (a(n0) - L2)) <= abs(L1 - a(n0)) + abs(a(n0) - L2)
        abs(L1 - L2) / 3 + abs(L1 - L2) / 3 = 2 * abs(L1 - L2) / 3 < 3 * abs(L1 - L2) / 3 = abs(L1 - L2)
        abs(L1 - a(n0)) + abs(a(n0) - L2) = abs(a(n0) - L1) + abs(a(n0) - L2) < abs(L1 - L2) / 3 + abs(L1 - L2) / 3 < abs(L1 - L2)
        abs(L1 - L2) <= abs(L1 - a(n0)) + abs(a(n0) - L2) < abs(L1 - L2)
        impossible abs(L1 - L2) = abs(L1 - L2)

thm series_sum_unique:
    ? forall a seq(R), L1, L2 R:
        $has_series_sum(a, L1)
        $has_series_sum(a, L2)
        =>:
            L1 = L2
    by thm sequence_limit_unique(fn(k N+) R {partial_sum(a, k)}, L1, L2) => L1 = L2

have fn one_term_sequence(x R, n N+) R by cases:
    case n = 1: x
    case n > 1: 0

have fn two_term_sequence(x, y R, n N+) R by cases:
    case n = 1: x
    case n > 1: one_term_sequence(y, n - 1)

thm real_add_zero:
    ? forall value R:
        value + 0 = value

# The padded two-term sequence has partial sums x+y from index two onward, so
# its series converges by an explicit eventually-constant tail proof.
thm two_term_series_has_sum:
    ? forall x, y R:
        $has_series_sum(fn(n N+) R {two_term_sequence(x, y, n)}, x + y)
    claim:
        ? forall k N+:
            partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) = x + y
        by induc k from 1:
            ? partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) = x + y
            ? from k = 1:
                two_term_sequence(x, y, 1) = x
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 0) = 0
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 0) + fn(n N+) R {two_term_sequence(x, y, n)}(1) = 0 + x = x
                two_term_sequence(x, y, 2) = one_term_sequence(y, 1) = y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 2) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 1) + fn(n N+) R {two_term_sequence(x, y, n)}(2) = x + y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 1 + 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, 2) = x + y
            ? induc:
                k + 1 > 1
                one_term_sequence(y, k + 1) = 0
                two_term_sequence(x, y, k + 2) = one_term_sequence(y, k + 1) = 0
                (k + 2) - 1 = k + 1
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 2) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 2) - 1) + fn(n N+) R {two_term_sequence(x, y, n)}(k + 2)
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 2) - 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1)
                fn(n N+) R {two_term_sequence(x, y, n)}(k + 2) = two_term_sequence(x, y, k + 2) = 0
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 2) - 1) + fn(n N+) R {two_term_sequence(x, y, n)}(k + 2) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) + 0
                by thm real_add_zero(partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1)) => partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) + 0 = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1)
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) + 0 = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 1) = x + y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 2) = x + y
                partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, (k + 1) + 1) = partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k + 2) = x + y
    claim:
        ? $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y)
        claim:
            ? forall epsilon R+:
                exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y, epsilon, n0)}
            witness exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y, epsilon, n0)} from 2:
                claim:
                    ? forall n N+:
                        n >= 2
                        =>:
                            abs(fn(k N+) R {partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, k)}(n) - (x + y)) < epsilon
                    n > 1
                    n - 1 $in N+
                    have predecessor N+ = n - 1
                    predecessor = n - 1
                    predecessor + 1 = (n - 1) + 1 = n
                    partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, predecessor + 1) = x + y
                    fn(k N+) R {partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, k)}(n) = partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, n) = x + y
                    abs(fn(k N+) R {partial_sum(fn(term_index N+) R {two_term_sequence(x, y, term_index)}, k)}(n) - (x + y)) = abs(0) = 0 < epsilon
                by def $is_tail_close_to(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y, epsilon, 2)
        by def $has_sequence_limit(fn(k N+) R {partial_sum(fn(n N+) R {two_term_sequence(x, y, n)}, k)}, x + y)
    by def $has_series_sum(fn(n N+) R {two_term_sequence(x, y, n)}, x + y)

# Pad two events by empty events so the countable Kolmogorov axiom can be
# specialized to a binary union.
template<Omega set, events power_set(power_set(Omega))>:
    have fn two_event_sequence(A, B events, n N+: {} $in events) events by cases:
        case n = 1: A
        case n = 2: B
        case n > 2: {}

# Every event is a subset of the sample space by the exact carrier of `events`.
thm event_is_subset_of_sample_space:
    ? forall Omega set, events power_set(power_set(Omega)), A events:
        A $subset Omega
    events $subset power_set(Omega)
    A $in power_set(Omega)
    by def:
        ? A $subset Omega

# Extensionality shows that the padded sequence contains exactly A, B, and then
# empty events, so its countable union is A union B.
thm two_event_sequence_countable_union:
    ? forall [SigmaAlgebraSetting(union_Omega, union_events)], A, B union_events:
        index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)}) = union(A, B)
    by extension:
        ? index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)}) = union(A, B)
        claim:
            ? forall point index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)}):
                point $in union(A, B)
            obtain idx from exist idx N+ st {point $in \two_event_sequence<union_Omega, union_events>(A, B, idx)}
            idx = 1 or idx > 1
            by cases:
                ? point $in union(A, B)
                case idx = 1:
                    \two_event_sequence<union_Omega, union_events>(A, B, idx) = A
                    point $in A
                    point $in union(A, B)
                case idx > 1:
                    idx - 1 $in N+
                    idx - 1 = 1 or idx - 1 > 1
                    by cases:
                        ? point $in union(A, B)
                        case idx - 1 = 1:
                            idx = (idx - 1) + 1 = 1 + 1 = 2
                            \two_event_sequence<union_Omega, union_events>(A, B, idx) = B
                            point $in B
                            point $in union(A, B)
                        case idx - 1 > 1:
                            (idx - 1) + 1 > 1 + 1
                            idx = (idx - 1) + 1
                            1 + 1 = 2
                            idx > 2
                            \two_event_sequence<union_Omega, union_events>(A, B, idx) = {}
                            point $in {}
                            impossible point $in {}
        claim:
            ? forall point union(A, B):
                point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)})
            point $in A or point $in B
            by cases:
                ? point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)})
                case point $in A:
                    by thm event_is_subset_of_sample_space(union_Omega, union_events, A) => A $subset union_Omega
                    point $in union_Omega
                    \two_event_sequence<union_Omega, union_events>(A, B, 1) = A
                    point $in \two_event_sequence<union_Omega, union_events>(A, B, 1)
                    witness exist idx N+ st {point $in \two_event_sequence<union_Omega, union_events>(A, B, idx)} from 1
                    point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)})
                case point $in B:
                    by thm event_is_subset_of_sample_space(union_Omega, union_events, B) => B $subset union_Omega
                    point $in union_Omega
                    \two_event_sequence<union_Omega, union_events>(A, B, 2) = B
                    point $in \two_event_sequence<union_Omega, union_events>(A, B, 2)
                    witness exist idx N+ st {point $in \two_event_sequence<union_Omega, union_events>(A, B, idx)} from 2
                    point $in index_union(N+, union_Omega, fn(n N+) power_set(union_Omega) {\two_event_sequence<union_Omega, union_events>(A, B, n)})

# If A and B are disjoint, a finite index case split proves the padded event
# sequence pairwise disjoint, including all empty tail terms.
thm two_event_sequence_pairwise_disjoint:
    ? forall [SigmaAlgebraSetting(disjoint_Omega, disjoint_events)], A, B disjoint_events:
        intersect(A, B) = {}
        =>:
            $pairwise_disjoint_event_sequence(disjoint_Omega, disjoint_events, fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)})
    claim:
        ? forall idx, j N+:
            idx != j
            =>:
                intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
        idx = 1 or idx > 1
        j = 1 or j > 1
        by cases:
            ? intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
            case idx = 1:
                by cases:
                    ? intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
                    case j = 1:
                        idx = j
                        impossible idx != j
                    case j > 1:
                        j - 1 $in N+
                        j - 1 = 1 or j - 1 > 1
                        by cases:
                            ? intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
                            case j - 1 = 1:
                                j = (j - 1) + 1 = 1 + 1 = 2
                                \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, idx) = A
                                \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, j) = B
                                intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = intersect(A, B) = {}
                            case j - 1 > 1:
                                (j - 1) + 1 > 1 + 1
                                j = (j - 1) + 1
                                1 + 1 = 2
                                j > 2
                                \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, idx) = A
                                \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, j) = {}
                                intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = intersect(A, {}) = {}
            case idx > 1:
                idx - 1 $in N+
                idx - 1 = 1 or idx - 1 > 1
                by cases:
                    ? intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
                    case idx - 1 = 1:
                        idx = (idx - 1) + 1 = 1 + 1 = 2
                        \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, idx) = B
                        by cases:
                            ? intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
                            case j = 1:
                                \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, j) = A
                                intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = intersect(B, A) = intersect(A, B) = {}
                            case j > 1:
                                j - 1 $in N+
                                j - 1 = 1 or j - 1 > 1
                                by cases:
                                    ? intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
                                    case j - 1 = 1:
                                        idx = (idx - 1) + 1 = 1 + 1 = 2
                                        j = (j - 1) + 1 = 1 + 1 = 2
                                        idx = j
                                        impossible idx != j
                                    case j - 1 > 1:
                                        (j - 1) + 1 > 1 + 1
                                        j = (j - 1) + 1
                                        1 + 1 = 2
                                        j > 2
                                        \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, j) = {}
                                        intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = intersect(B, {}) = {}
                    case idx - 1 > 1:
                        (idx - 1) + 1 > 1 + 1
                        idx = (idx - 1) + 1
                        1 + 1 = 2
                        idx > 2
                        \two_event_sequence<disjoint_Omega, disjoint_events>(A, B, idx) = {}
                        intersect(fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(idx), fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = intersect({}, fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)}(j)) = {}
    by def $pairwise_disjoint_event_sequence(disjoint_Omega, disjoint_events, fn(n N+) disjoint_events {\two_event_sequence<disjoint_Omega, disjoint_events>(A, B, n)})

# Evaluate probability term by term: the first two values are P(A), P(B), and
# every later empty-event value is zero.
thm probability_of_two_event_sequence:
    ? forall [ProbabilitySpaceSetting(sequence_Omega, sequence_events, sequence_probability)], A, B sequence_events, n N+:
        sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
    n = 1 or n > 1
    by cases:
        ? sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
        case n = 1:
            \two_event_sequence<sequence_Omega, sequence_events>(A, B, n) = A
            two_term_sequence(sequence_probability(A), sequence_probability(B), n) = sequence_probability(A)
            sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = sequence_probability(A) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
        case n > 1:
            n - 1 $in N+
            n - 1 = 1 or n - 1 > 1
            by cases:
                ? sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
                case n - 1 = 1:
                    n = (n - 1) + 1 = 1 + 1 = 2
                    \two_event_sequence<sequence_Omega, sequence_events>(A, B, n) = B
                    one_term_sequence(sequence_probability(B), n - 1) = sequence_probability(B)
                    two_term_sequence(sequence_probability(A), sequence_probability(B), n) = one_term_sequence(sequence_probability(B), n - 1) = sequence_probability(B)
                    sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = sequence_probability(B) = two_term_sequence(sequence_probability(A), sequence_probability(B), n)
                case n - 1 > 1:
                    (n - 1) + 1 > 1 + 1
                    n = (n - 1) + 1
                    1 + 1 = 2
                    n > 2
                    \two_event_sequence<sequence_Omega, sequence_events>(A, B, n) = {}
                    sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = sequence_probability({}) = 0
                    one_term_sequence(sequence_probability(B), n - 1) = 0
                    two_term_sequence(sequence_probability(A), sequence_probability(B), n) = one_term_sequence(sequence_probability(B), n - 1) = 0
                    sequence_probability(\two_event_sequence<sequence_Omega, sequence_events>(A, B, n)) = 0 = two_term_sequence(sequence_probability(A), sequence_probability(B), n)

# Induction transports pointwise equality through every finite partial sum.
thm pointwise_equal_sequences_have_equal_partial_sums:
    ? forall a, b seq(R), k N:
        forall n N+:
            a(n) = b(n)
        =>:
            partial_sum(a, k) = partial_sum(b, k)
    by induc k from 0:
        ? partial_sum(a, k) = partial_sum(b, k)
        ? from k = 0:
            partial_sum(a, 0) = 0
            partial_sum(b, 0) = 0
        ? induc:
            k + 1 $in N+
            a(k + 1) = b(k + 1)
            partial_sum(a, k + 1) = partial_sum(a, k) + a(k + 1)
            partial_sum(b, k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k) + a(k + 1) = partial_sum(b, k) + b(k + 1)
            partial_sum(a, k + 1) = partial_sum(b, k + 1)

# Equal partial sums let one sequence reuse the other sequence's epsilon-tail
# witness for the same series sum.
thm pointwise_equal_sequences_preserve_series_sum:
    ? forall a, b seq(R), L R:
        forall n N+:
            a(n) = b(n)
        $has_series_sum(b, L)
        =>:
            $has_series_sum(a, L)
    claim:
        ? $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L)
        claim:
            ? forall epsilon R+:
                exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, n0)}
            obtain n0 from exist n0 N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(b, k)}, L, epsilon, n0)}
            witness exist candidate_index N+ st {$is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, candidate_index)} from n0:
                claim:
                    ? forall tail_index N+:
                        tail_index >= n0
                        =>:
                            abs(fn(k N+) R {partial_sum(a, k)}(tail_index) - L) < epsilon
                    by thm pointwise_equal_sequences_have_equal_partial_sums(a, b, tail_index) => partial_sum(a, tail_index) = partial_sum(b, tail_index)
                    fn(k N+) R {partial_sum(a, k)}(tail_index) = partial_sum(a, tail_index)
                    fn(k N+) R {partial_sum(b, k)}(tail_index) = partial_sum(b, tail_index)
                    abs(fn(k N+) R {partial_sum(a, k)}(tail_index) - L) = abs(fn(k N+) R {partial_sum(b, k)}(tail_index) - L) < epsilon
                by def $is_tail_close_to(fn(k N+) R {partial_sum(a, k)}, L, epsilon, n0)
        by def $has_sequence_limit(fn(k N+) R {partial_sum(a, k)}, L)
    by def $has_series_sum(a, L)

# Combine termwise probability evaluation with the two-term series theorem.
thm two_event_probability_series_has_sum:
    ? forall [ProbabilitySpaceSetting(series_Omega, series_events, series_probability)], A, B series_events:
        $has_series_sum(fn(n N+) R {series_probability(\two_event_sequence<series_Omega, series_events>(A, B, n))}, series_probability(A) + series_probability(B))
    have probability_terms seq(R) = fn(n N+) R {series_probability(\two_event_sequence<series_Omega, series_events>(A, B, n))}
    claim:
        ? forall term_index N+:
            probability_terms(term_index) = two_term_sequence(series_probability(A), series_probability(B), term_index)
        probability_terms(term_index) = series_probability(\two_event_sequence<series_Omega, series_events>(A, B, term_index))
        term_index = 1 or term_index > 1
        by cases:
            ? probability_terms(term_index) = two_term_sequence(series_probability(A), series_probability(B), term_index)
            case term_index = 1:
                \two_event_sequence<series_Omega, series_events>(A, B, term_index) = A
                two_term_sequence(series_probability(A), series_probability(B), term_index) = series_probability(A)
                probability_terms(term_index) = series_probability(\two_event_sequence<series_Omega, series_events>(A, B, term_index)) = series_probability(A) = two_term_sequence(series_probability(A), series_probability(B), term_index)
            case term_index > 1:
                term_index - 1 $in N+
                term_index - 1 = 1 or term_index - 1 > 1
                by cases:
                    ? probability_terms(term_index) = two_term_sequence(series_probability(A), series_probability(B), term_index)
                    case term_index - 1 = 1:
                        term_index = (term_index - 1) + 1 = 1 + 1 = 2
                        \two_event_sequence<series_Omega, series_events>(A, B, term_index) = B
                        one_term_sequence(series_probability(B), term_index - 1) = series_probability(B)
                        two_term_sequence(series_probability(A), series_probability(B), term_index) = one_term_sequence(series_probability(B), term_index - 1) = series_probability(B)
                        probability_terms(term_index) = series_probability(\two_event_sequence<series_Omega, series_events>(A, B, term_index)) = series_probability(B) = two_term_sequence(series_probability(A), series_probability(B), term_index)
                    case term_index - 1 > 1:
                        (term_index - 1) + 1 > 1 + 1
                        term_index = (term_index - 1) + 1
                        1 + 1 = 2
                        term_index > 2
                        \two_event_sequence<series_Omega, series_events>(A, B, term_index) = {}
                        series_probability(\two_event_sequence<series_Omega, series_events>(A, B, term_index)) = series_probability({}) = 0
                        one_term_sequence(series_probability(B), term_index - 1) = 0
                        two_term_sequence(series_probability(A), series_probability(B), term_index) = one_term_sequence(series_probability(B), term_index - 1) = 0
                        probability_terms(term_index) = series_probability(\two_event_sequence<series_Omega, series_events>(A, B, term_index)) = 0 = two_term_sequence(series_probability(A), series_probability(B), term_index)
    by thm two_term_series_has_sum(series_probability(A), series_probability(B)) => $has_series_sum(fn(n N+) R {two_term_sequence(series_probability(A), series_probability(B), n)}, series_probability(A) + series_probability(B))
    by thm pointwise_equal_sequences_preserve_series_sum(probability_terms, fn(n N+) R {two_term_sequence(series_probability(A), series_probability(B), n)}, series_probability(A) + series_probability(B)) => $has_series_sum(probability_terms, series_probability(A) + series_probability(B))
    probability_terms = fn(n N+) R {series_probability(\two_event_sequence<series_Omega, series_events>(A, B, n))}
    $has_series_sum(fn(n N+) R {series_probability(\two_event_sequence<series_Omega, series_events>(A, B, n))}, series_probability(A) + series_probability(B))

thm event_countable_union_is_event:
    ? forall [SigmaAlgebraSetting], event_sequence fn(n N+) events:
        index_union(N+, Omega, fn(n N+) power_set(Omega) {event_sequence(n)}) $in events

# Main tracer: binary finite additivity is derived from countable additivity;
# it is not added as a fourth probability axiom.
thm probability_of_disjoint_union:
    ? forall [ProbabilitySpaceSetting(union_probability_Omega, union_probability_events, union_probability)], A, B union_probability_events:
        intersect(A, B) = {}
        =>:
            union(A, B) $in union_probability_events
            union_probability(union(A, B)) = union_probability(A) + union_probability(B)
    by thm two_event_sequence_countable_union(union_probability_Omega, union_probability_events, A, B) => index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)}) = union(A, B)
    by thm event_countable_union_is_event(union_probability_Omega, union_probability_events, fn(n N+) union_probability_events {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)}) => index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)}) $in union_probability_events
    union(A, B) $in union_probability_events
    by thm two_event_sequence_pairwise_disjoint(union_probability_Omega, union_probability_events, A, B) => $pairwise_disjoint_event_sequence(union_probability_Omega, union_probability_events, fn(n N+) union_probability_events {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)})
    by thm kolmogorov_countable_additivity(union_probability_Omega, union_probability_events, union_probability, fn(n N+) union_probability_events {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)})
    by thm two_event_probability_series_has_sum(union_probability_Omega, union_probability_events, union_probability, A, B) => $has_series_sum(fn(n N+) R {union_probability(\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n))}, union_probability(A) + union_probability(B))
    by thm series_sum_unique(fn(n N+) R {union_probability(\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n))}, union_probability(index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)})), union_probability(A) + union_probability(B)) => union_probability(index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)})) = union_probability(A) + union_probability(B)
    union_probability(union(A, B)) = union_probability(index_union(N+, union_probability_Omega, fn(n N+) power_set(union_probability_Omega) {\two_event_sequence<union_probability_Omega, union_probability_events>(A, B, n)})) = union_probability(A) + union_probability(B)

# Complement partitions and relative complements support the ordinary event
# probability calculus.
# A subset and its complement inside Omega have no common element.
thm subset_intersect_complement_is_empty:
    ? forall Omega set, A power_set(Omega):
        intersect(A, set_minus(Omega, A)) = {}
    by extension:
        ? intersect(A, set_minus(Omega, A)) = {}
        claim:
            ? forall point intersect(A, set_minus(Omega, A)):
                point $in {}
            by contra:
                ? point $in {}
                not point $in {}
                point $in A
                point $in set_minus(Omega, A)
                not point $in A
                impossible not point $in A
        claim:
            ? forall point {}:
                point $in intersect(A, set_minus(Omega, A))
            by contra:
                ? point $in intersect(A, set_minus(Omega, A))
                not point $in intersect(A, set_minus(Omega, A))
                impossible point $in {}

# Every point of Omega lies either in A or in its relative complement.
thm subset_union_complement_is_universe:
    ? forall Omega set, A power_set(Omega):
        union(A, set_minus(Omega, A)) = Omega
    by extension:
        ? union(A, set_minus(Omega, A)) = Omega
        claim:
            ? forall point union(A, set_minus(Omega, A)):
                point $in Omega
            point $in A or point $in set_minus(Omega, A)
            by cases:
                ? point $in Omega
                case point $in A:
                    A $subset Omega
                    point $in Omega
                case point $in set_minus(Omega, A):
                    point $in Omega
        claim:
            ? forall point Omega:
                point $in union(A, set_minus(Omega, A))
            point $in A or not point $in A
            by cases:
                ? point $in union(A, set_minus(Omega, A))
                case point $in A:
                    point $in union(A, set_minus(Omega, A))
                case not point $in A:
                    point $in set_minus(Omega, A)
                    point $in union(A, set_minus(Omega, A))

# Apply finite additivity to the partition Omega = A union (Omega minus A).
thm probability_of_event_complement:
    ? forall [ProbabilitySpaceSetting], A events:
        probability(set_minus(Omega, A)) = 1 - probability(A)
    by thm event_is_subset_of_sample_space(Omega, events, A) => A $subset Omega
    A $in power_set(Omega)
    set_minus(Omega, A) $in events
    by thm subset_intersect_complement_is_empty(Omega, A) => intersect(A, set_minus(Omega, A)) = {}
    by thm subset_union_complement_is_universe(Omega, A) => union(A, set_minus(Omega, A)) = Omega
    by thm probability_of_disjoint_union(Omega, events, probability, A, set_minus(Omega, A)) => probability(union(A, set_minus(Omega, A))) = probability(A) + probability(set_minus(Omega, A))
    probability(Omega) = probability(union(A, set_minus(Omega, A))) = probability(A) + probability(set_minus(Omega, A))
    1 = probability(Omega) = probability(A) + probability(set_minus(Omega, A))
    probability(set_minus(Omega, A)) = 1 - probability(A)

# Rewrite A minus B as A intersected with the complement of B in Omega.
thm relative_complement_as_intersection:
    ? forall Omega set, A, B power_set(Omega):
        set_minus(A, B) = intersect(A, set_minus(Omega, B))
    by extension:
        ? set_minus(A, B) = intersect(A, set_minus(Omega, B))
        claim:
            ? forall point set_minus(A, B):
                point $in intersect(A, set_minus(Omega, B))
            point $in A
            not point $in B
            A $subset Omega
            point $in Omega
            point $in set_minus(Omega, B)
            point $in intersect(A, set_minus(Omega, B))
        claim:
            ? forall point intersect(A, set_minus(Omega, B)):
                point $in set_minus(A, B)
            point $in A
            point $in set_minus(Omega, B)
            not point $in B
            point $in set_minus(A, B)

# Sigma-algebra closure under complements and intersections makes A minus B
# an event.
thm event_difference_is_event:
    ? forall [SigmaAlgebraSetting], A, B events:
        set_minus(A, B) $in events
    by thm event_is_subset_of_sample_space(Omega, events, A) => A $subset Omega
    by thm event_is_subset_of_sample_space(Omega, events, B) => B $subset Omega
    A $in power_set(Omega)
    B $in power_set(Omega)
    set_minus(Omega, B) $in events
    intersect(A, set_minus(Omega, B)) $in events
    by thm relative_complement_as_intersection(Omega, A, B) => set_minus(A, B) = intersect(A, set_minus(Omega, B))
    set_minus(A, B) $in events

# When B is contained in A, the disjoint partition A = B union (A minus B)
# gives the subtraction formula for probabilities.
thm probability_of_difference_under_subset:
    ? forall [ProbabilitySpaceSetting], A, B events:
        B $subset A
        =>:
            set_minus(A, B) $in events
            probability(set_minus(A, B)) = probability(A) - probability(B)
    by thm event_difference_is_event(Omega, events, A, B) => set_minus(A, B) $in events
    B $in power_set(A)
    by thm subset_intersect_complement_is_empty(A, B) => intersect(B, set_minus(A, B)) = {}
    by thm subset_union_complement_is_universe(A, B) => union(B, set_minus(A, B)) = A
    by thm probability_of_disjoint_union(Omega, events, probability, B, set_minus(A, B)) => probability(union(B, set_minus(A, B))) = probability(B) + probability(set_minus(A, B))
    probability(A) = probability(union(B, set_minus(A, B))) = probability(B) + probability(set_minus(A, B))
    probability(set_minus(A, B)) = probability(A) - probability(B)

# Nonnegativity of P(B minus A) yields monotonicity under A subset B.
thm probability_mono:
    ? forall [ProbabilitySpaceSetting], A, B events:
        A $subset B
        =>:
            probability(A) <= probability(B)
    by thm probability_of_difference_under_subset(Omega, events, probability, B, A)
    set_minus(B, A) $in events
    probability(set_minus(B, A)) = probability(B) - probability(A)
    probability(set_minus(B, A)) >= 0
    probability(B) - probability(A) >= 0
    probability(A) <= probability(B)

# A is disjoint from the portion of B lying outside A.
thm set_intersect_relative_complement_is_empty:
    ? forall A, B set:
        intersect(A, set_minus(B, A)) = {}
    by extension:
        ? intersect(A, set_minus(B, A)) = {}
        claim:
            ? forall point intersect(A, set_minus(B, A)):
                point $in {}
            by contra:
                ? point $in {}
                not point $in {}
                point $in A
                point $in set_minus(B, A)
                not point $in A
                impossible not point $in A
        claim:
            ? forall point {}:
                point $in intersect(A, set_minus(B, A))
            by contra:
                ? point $in intersect(A, set_minus(B, A))
                not point $in intersect(A, set_minus(B, A))
                impossible point $in {}

# Decompose A union B into the disjoint pieces A and B minus A.
thm union_with_relative_complement:
    ? forall A, B set:
        union(A, set_minus(B, A)) = union(A, B)
    by extension:
        ? union(A, set_minus(B, A)) = union(A, B)
        claim:
            ? forall point union(A, set_minus(B, A)):
                point $in union(A, B)
            point $in A or point $in set_minus(B, A)
            by cases:
                ? point $in union(A, B)
                case point $in A:
                    point $in union(A, B)
                case point $in set_minus(B, A):
                    point $in B
                    point $in union(A, B)
        claim:
            ? forall point union(A, B):
                point $in union(A, set_minus(B, A))
            point $in A or point $in B
            by cases:
                ? point $in union(A, set_minus(B, A))
                case point $in A:
                    point $in union(A, set_minus(B, A))
                case point $in B:
                    point $in A or not point $in A
                    by cases:
                        ? point $in union(A, set_minus(B, A))
                        case point $in A:
                            point $in union(A, set_minus(B, A))
                        case not point $in A:
                            point $in set_minus(B, A)
                            point $in union(A, set_minus(B, A))

# Removing A intersect B from B is the same as removing all of A from B.
thm remove_intersection_equals_remove_set:
    ? forall A, B set:
        set_minus(B, intersect(A, B)) = set_minus(B, A)
    by extension:
        ? set_minus(B, intersect(A, B)) = set_minus(B, A)
        claim:
            ? forall point set_minus(B, intersect(A, B)):
                point $in set_minus(B, A)
            point $in B
            not point $in intersect(A, B)
            claim:
                ? not point $in A
                by contra:
                    ? not point $in A
                    point $in A
                    point $in intersect(A, B)
                    impossible not point $in intersect(A, B)
            point $in set_minus(B, A)
        claim:
            ? forall point set_minus(B, A):
                point $in set_minus(B, intersect(A, B))
            point $in B
            not point $in A
            claim:
                ? not point $in intersect(A, B)
                by contra:
                    ? not point $in intersect(A, B)
                    point $in intersect(A, B)
                    point $in A
                    impossible not point $in A
            point $in set_minus(B, intersect(A, B))

# Use the disjoint decomposition A union (B minus A), then express the second
# term as P(B)-P(A intersect B).
thm probability_inclusion_exclusion:
    ? forall [ProbabilitySpaceSetting], A, B events:
        union(A, B) $in events
        probability(union(A, B)) = probability(A) + probability(B) - probability(intersect(A, B))
    by thm event_difference_is_event(Omega, events, B, A) => set_minus(B, A) $in events
    by thm set_intersect_relative_complement_is_empty(A, B) => intersect(A, set_minus(B, A)) = {}
    by thm union_with_relative_complement(A, B) => union(A, set_minus(B, A)) = union(A, B)
    by thm probability_of_disjoint_union(Omega, events, probability, A, set_minus(B, A))
    union(A, set_minus(B, A)) $in events
    probability(union(A, set_minus(B, A))) = probability(A) + probability(set_minus(B, A))
    union(A, B) $in events
    intersect(A, B) $in events
    intersect(A, B) $subset B
    by thm probability_of_difference_under_subset(Omega, events, probability, B, intersect(A, B))
    probability(set_minus(B, intersect(A, B))) = probability(B) - probability(intersect(A, B))
    by thm remove_intersection_equals_remove_set(A, B) => set_minus(B, intersect(A, B)) = set_minus(B, A)
    probability(set_minus(B, A)) = probability(set_minus(B, intersect(A, B))) = probability(B) - probability(intersect(A, B))
    probability(union(A, B)) = probability(union(A, set_minus(B, A))) = probability(A) + probability(set_minus(B, A)) = probability(A) + (probability(B) - probability(intersect(A, B))) = probability(A) + probability(B) - probability(intersect(A, B))

# Drop the nonnegative intersection term from inclusion-exclusion.
thm probability_union_bound:
    ? forall [ProbabilitySpaceSetting], A, B events:
        union(A, B) $in events
        probability(union(A, B)) <= probability(A) + probability(B)
    by thm probability_inclusion_exclusion(Omega, events, probability, A, B)
    union(A, B) $in events
    probability(union(A, B)) = probability(A) + probability(B) - probability(intersect(A, B))
    intersect(A, B) $in events
    probability(intersect(A, B)) >= 0
    probability(A) + probability(B) - probability(intersect(A, B)) <= probability(A) + probability(B)
    probability(union(A, B)) <= probability(A) + probability(B)

thm probability_between_zero_and_one:
    ? forall [ProbabilitySpaceSetting], A events:
        0 <= probability(A)
        probability(A) <= 1
    probability(A) >= 0
    by thm event_is_subset_of_sample_space(Omega, events, A) => A $subset Omega
    by thm probability_mono(Omega, events, probability, A, Omega) => probability(A) <= probability(Omega)
    probability(A) <= probability(Omega) = 1
