# Probability and statistics in Litex, setting-first.
#
# Included: two-point probability vectors, expectation and variance, a
# three-point least-squares center, linearity of expectation, a fair-coin
# calculation, conditional probability, and Bayes.
#
# Main line: finite distributions -> expectation and variance -> least squares
# -> Bayes' rule.

prop is_probability_vector2(p finite_seq(R, 2)):
    p(1) >= 0
    p(2) >= 0
    p(1) + p(2) = 1

have fn expectation2(values, probs finite_seq(R, 2)) R = values(1) * probs(1) + values(2) * probs(2)
have fn variance2(values, probs finite_seq(R, 2)) R = (values(1) - expectation2(values, probs))^2 * probs(1) + (values(2) - expectation2(values, probs))^2 * probs(2)

# For three real observations, a least-squares center is a point whose
# squared-error sum is no larger than the sum at any real candidate.
prop is_least_squares_center(center, a, b, c R):
    forall candidate R:
        (a - center)^2 + (b - center)^2 + (c - center)^2 <= (a - candidate)^2 + (b - candidate)^2 + (c - candidate)^2

have fn mean3(a, b, c R) R = (a + b + c) / 3

# The key identity leaves the nonnegative remainder visible:
# SSE(candidate) = SSE(mean) + 3 * (candidate - mean)^2.
thm three_point_sse_decomposition:
    ? forall a, b, c, candidate R:
        (a - (a + b + c) / 3)^2 + (b - (a + b + c) / 3)^2 + (c - (a + b + c) / 3)^2 + 3 * (candidate - (a + b + c) / 3)^2 = (a - candidate)^2 + (b - candidate)^2 + (c - candidate)^2

thm mean_formula_is_least_squares_center:
    ? forall a, b, c R:
        $is_least_squares_center((a + b + c) / 3, a, b, c)
    claim:
        ? forall candidate R:
            (a - (a + b + c) / 3)^2 + (b - (a + b + c) / 3)^2 + (c - (a + b + c) / 3)^2 <= (a - candidate)^2 + (b - candidate)^2 + (c - candidate)^2
        0 <= (candidate - (a + b + c) / 3)^2
        0 <= 3 * (candidate - (a + b + c) / 3)^2
        by thm three_point_sse_decomposition(a, b, c, candidate) => (a - (a + b + c) / 3)^2 + (b - (a + b + c) / 3)^2 + (c - (a + b + c) / 3)^2 + 3 * (candidate - (a + b + c) / 3)^2 = (a - candidate)^2 + (b - candidate)^2 + (c - candidate)^2
        (a - (a + b + c) / 3)^2 + (b - (a + b + c) / 3)^2 + (c - (a + b + c) / 3)^2 = (a - (a + b + c) / 3)^2 + (b - (a + b + c) / 3)^2 + (c - (a + b + c) / 3)^2 + 0 <= (a - (a + b + c) / 3)^2 + (b - (a + b + c) / 3)^2 + (c - (a + b + c) / 3)^2 + 3 * (candidate - (a + b + c) / 3)^2 = (a - candidate)^2 + (b - candidate)^2 + (c - candidate)^2
    by def $is_least_squares_center((a + b + c) / 3, a, b, c)

thm mean3_is_least_squares_center:
    ? forall a, b, c R:
        $is_least_squares_center(mean3(a, b, c), a, b, c)
    mean3(a, b, c) = (a + b + c) / 3
    by thm mean_formula_is_least_squares_center(a, b, c) => $is_least_squares_center((a + b + c) / 3, a, b, c)

# Tracer example: for 1, 2, 5 the mean is 8/3.  The candidate 2 has a
# larger squared-error sum, and the difference is exactly 3*(2 - 8/3)^2.
mean3(1, 2, 5) = 8 / 3
by thm mean3_is_least_squares_center(1, 2, 5) => $is_least_squares_center(mean3(1, 2, 5), 1, 2, 5)
by def $is_least_squares_center(mean3(1, 2, 5), 1, 2, 5)
(1 - mean3(1, 2, 5))^2 + (2 - mean3(1, 2, 5))^2 + (5 - mean3(1, 2, 5))^2 = 26 / 3
(1 - 2)^2 + (2 - 2)^2 + (5 - 2)^2 = 10
3 * (2 - mean3(1, 2, 5))^2 = 4 / 3
26 / 3 + 4 / 3 = 10
26 / 3 <= 10

have fn affine_combine2(X, Y finite_seq(R, 2), a, b R) finite_seq(R, 2) = fn(k N+: k <= 2) R {a * X(k) + b * Y(k)}

# Expanding the two coordinates proves linearity of expectation directly.
thm expectation2_affine:
    ? forall X, Y finite_seq(R, 2), probs finite_seq(R, 2), a, b R:
        expectation2(affine_combine2(X, Y, a, b), probs) = a * expectation2(X, probs) + b * expectation2(Y, probs)
    affine_combine2(X, Y, a, b)(1) = a * X(1) + b * Y(1)
    affine_combine2(X, Y, a, b)(2) = a * X(2) + b * Y(2)
    expectation2(X, probs) = X(1) * probs(1) + X(2) * probs(2)
    expectation2(Y, probs) = Y(1) * probs(1) + Y(2) * probs(2)
    expectation2(affine_combine2(X, Y, a, b), probs) = (a * X(1) + b * Y(1)) * probs(1) + (a * X(2) + b * Y(2)) * probs(2)
    expectation2(affine_combine2(X, Y, a, b), probs) = a * (X(1) * probs(1) + X(2) * probs(2)) + b * (Y(1) * probs(1) + Y(2) * probs(2))
    a * expectation2(X, probs) + b * expectation2(Y, probs) = a * (X(1) * probs(1) + X(2) * probs(2)) + b * (Y(1) * probs(1) + Y(2) * probs(2))

# Former `[0, 1]` / `[1/2, 1/2]` list literals removed; define as finite_seq via fn cases.
have fn fair_coin_values(k N+: k <= 2) R by cases:
    case k = 1: 0
    case k = 2: 1
have fn fair_coin_probs(k N+: k <= 2) R by cases:
    case k = 1: 1 / 2
    case k = 2: 1 / 2

$is_probability_vector2(fair_coin_probs)
expectation2(fair_coin_values, fair_coin_probs) = 1 / 2
variance2(fair_coin_values, fair_coin_probs) = 1 / 4

have fn conditional_probability(joint, evidence R: evidence > 0) R = joint / evidence
have fn bayes_posterior(prior, likelihood, evidence R: evidence > 0) R = likelihood * prior / evidence

# Bayes' rule here is the substitution joint = likelihood * prior into the
# definition of conditional probability.
thm bayes_rule:
    ? forall prior, likelihood, evidence, joint R:
        evidence > 0
        joint = likelihood * prior
        =>:
            conditional_probability(joint, evidence) = bayes_posterior(prior, likelihood, evidence)
    conditional_probability(joint, evidence) = joint / evidence
    bayes_posterior(prior, likelihood, evidence) = likelihood * prior / evidence
    joint / evidence = likelihood * prior / evidence

1 / 4 = (3 / 4) * (1 / 3)
by thm bayes_rule(1 / 3, 3 / 4, 1 / 2, 1 / 4) => conditional_probability(1 / 4, 1 / 2) = bayes_posterior(1 / 3, 3 / 4, 1 / 2)
conditional_probability(1 / 4, 1 / 2) = 1 / 2
bayes_posterior(1 / 3, 3 / 4, 1 / 2) = 1 / 2
