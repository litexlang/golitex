# Numerical analysis in Litex, setting-first.
#
# Main line: residual -> Newton update -> exact scaled-error identity for sqrt(2).

have fn square_root_two_residual(x R) R = x^2 - 2
have fn newton_sqrt_two(x R: x != 0) R = (x + 2 / x) / 2

newton_sqrt_two(1) = 3 / 2
newton_sqrt_two(3 / 2) = 17 / 12

thm newton_sqrt_two_scaled_error_identity:
    ? forall x R:
        x != 0
        =>:
            4 * x^2 * (newton_sqrt_two(x)^2 - 2) = (x^2 - 2)^2
    x != 0
    newton_sqrt_two(x) = (x + 2 / x) / 2
    4 * x^2 * (((x + 2 / x) / 2)^2 - 2) = (x^2 - 2)^2
    4 * x^2 * (newton_sqrt_two(x)^2 - 2) = 4 * x^2 * (((x + 2 / x) / 2)^2 - 2) = (x^2 - 2)^2

square_root_two_residual(1) = -1
square_root_two_residual(3 / 2) = 1 / 4
