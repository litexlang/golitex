# Problem 296: 等边三角形的高与中点距离
#
# 原题：在等边三角形 ABC 中，AD 是 BC 边上的高，E 是 AC 的中点。
#       求证：DE = BD。
#
# 自然语言条件 ↔ forall 前提：
# - △ABC 是等边三角形       ↔ $geo::is_equilateral(a, b, c)
# - D 在边 BC 上             ↔ $geo::is_on_segment(d, b, c)
# - AD ⟂ BC（AD 是高）       ↔ $geo::is_perpendicular(a, d, b, c)
# - E 是 AC 的中点           ↔ $geo::is_midpoint(e, a, c)
#
# 原题结论 ↔ => 结论：
# - DE = BD                  ↔ $geo::are_segments_congruent(d, e, b, d)

thm problem_296_equilateral_altitude_midpoint_distance:
    ? forall pa, pb, pc, pd, pe cart(R, R):
        # △ABC 是等边三角形。
        $geo::is_equilateral(pa, pb, pc)
        # D 在线段 BC 上。
        $geo::is_on_segment(pd, pb, pc)
        # AD ⟂ BC，即 AD 是 BC 边上的高。
        $geo::is_perpendicular(pa, pd, pb, pc)
        # E 是 AC 的中点。
        $geo::is_midpoint(pe, pa, pc)
        =>:
            # DE = BD。
            $geo::are_segments_congruent(pd, pe, pb, pd)

    # 展开原题几何条件。
    by def $geo::is_equilateral(pa, pb, pc)
    by def $geo::are_segments_congruent(pa, pb, pb, pc)
    by def $geo::are_segments_congruent(pa, pb, pa, pc)
    by def $geo::is_on_segment(pd, pb, pc)
    exist s R st {0 <= s, s <= 1, pd = (pb[1] + s * (pc[1] - pb[1]), pb[2] + s * (pc[2] - pb[2]))}
    obtain s from exist s0 R st {0 <= s0, s0 <= 1, pd = (pb[1] + s0 * (pc[1] - pb[1]), pb[2] + s0 * (pc[2] - pb[2]))}
    pd[1] = pb[1] + s * (pc[1] - pb[1])
    pd[2] = pb[2] + s * (pc[2] - pb[2])

    by def $geo::is_perpendicular(pa, pd, pb, pc)
    by def $geo::is_midpoint(pe, pa, pc)
    pe[1] = (pa[1] + pc[1]) / 2
    pe[2] = (pa[2] + pc[2]) / 2

    # AD ⟂ BC，且 DB、DC 都沿 BC，所以 ∠ADB、∠ADC 都是直角。
    geo::vec(pa, pd) = (pd[1] - pa[1], pd[2] - pa[2])
    geo::vec(pb, pc) = (pc[1] - pb[1], pc[2] - pb[2])
    geo::dot(geo::vec(pa, pd), geo::vec(pb, pc)) = 0

    geo::vec(pd, pa) = (pa[1] - pd[1], pa[2] - pd[2])
    geo::vec(pd, pb) = (pb[1] - pd[1], pb[2] - pd[2])
    pb[1] - pd[1] = -s * (pc[1] - pb[1])
    pb[2] - pd[2] = -s * (pc[2] - pb[2])
    release thm geo::dot_coordinate_formula(geo::vec(pd, pa), geo::vec(pd, pb))
    geo::dot(geo::vec(pd, pa), geo::vec(pd, pb)) = (pa[1] - pd[1]) * (pb[1] - pd[1]) + (pa[2] - pd[2]) * (pb[2] - pd[2])
    (pa[1] - pd[1]) * (pb[1] - pd[1]) + (pa[2] - pd[2]) * (pb[2] - pd[2]) = s * ((pd[1] - pa[1]) * (pc[1] - pb[1]) + (pd[2] - pa[2]) * (pc[2] - pb[2]))
    release thm geo::dot_coordinate_formula(geo::vec(pa, pd), geo::vec(pb, pc))
    geo::dot(geo::vec(pa, pd), geo::vec(pb, pc)) = (pd[1] - pa[1]) * (pc[1] - pb[1]) + (pd[2] - pa[2]) * (pc[2] - pb[2])
    (pd[1] - pa[1]) * (pc[1] - pb[1]) + (pd[2] - pa[2]) * (pc[2] - pb[2]) = 0
    s * ((pd[1] - pa[1]) * (pc[1] - pb[1]) + (pd[2] - pa[2]) * (pc[2] - pb[2])) = s * 0
    s * 0 = 0
    (pa[1] - pd[1]) * (pb[1] - pd[1]) + (pa[2] - pd[2]) * (pb[2] - pd[2]) = 0
    geo::dot(geo::vec(pd, pa), geo::vec(pd, pb)) = 0

    geo::vec(pd, pc) = (pc[1] - pd[1], pc[2] - pd[2])
    pc[1] - pd[1] = (1 - s) * (pc[1] - pb[1])
    pc[2] - pd[2] = (1 - s) * (pc[2] - pb[2])
    release thm geo::dot_coordinate_formula(geo::vec(pd, pa), geo::vec(pd, pc))
    geo::dot(geo::vec(pd, pa), geo::vec(pd, pc)) = (pa[1] - pd[1]) * (pc[1] - pd[1]) + (pa[2] - pd[2]) * (pc[2] - pd[2])
    (pa[1] - pd[1]) * (pc[1] - pd[1]) + (pa[2] - pd[2]) * (pc[2] - pd[2]) = (1 - s) * ((pa[1] - pd[1]) * (pc[1] - pb[1]) + (pa[2] - pd[2]) * (pc[2] - pb[2]))
    (pa[1] - pd[1]) * (pc[1] - pb[1]) + (pa[2] - pd[2]) * (pc[2] - pb[2]) = -((pd[1] - pa[1]) * (pc[1] - pb[1]) + (pd[2] - pa[2]) * (pc[2] - pb[2]))
    -((pd[1] - pa[1]) * (pc[1] - pb[1]) + (pd[2] - pa[2]) * (pc[2] - pb[2])) = -0
    -0 = 0
    (pa[1] - pd[1]) * (pc[1] - pb[1]) + (pa[2] - pd[2]) * (pc[2] - pb[2]) = 0
    (1 - s) * ((pa[1] - pd[1]) * (pc[1] - pb[1]) + (pa[2] - pd[2]) * (pc[2] - pb[2])) = (1 - s) * 0
    (1 - s) * 0 = 0
    (pa[1] - pd[1]) * (pc[1] - pd[1]) + (pa[2] - pd[2]) * (pc[2] - pd[2]) = 0
    geo::dot(geo::vec(pd, pa), geo::vec(pd, pc)) = 0

    # 两次勾股，结合等边条件 AB²=AC²，得到 DB²=DC²。
    release thm geo::pythagorean_theorem(pa, pd, pb)
    release thm geo::pythagorean_theorem(pa, pd, pc)
    geo::distance_sq(pa, pb) = geo::distance_sq(pa, pd) + geo::distance_sq(pd, pb)
    geo::distance_sq(pa, pc) = geo::distance_sq(pa, pd) + geo::distance_sq(pd, pc)
    geo::distance_sq(pa, pb) = geo::distance_sq(pa, pc)
    geo::distance_sq(pd, pb) = geo::distance_sq(pa, pb) - geo::distance_sq(pa, pd)
    geo::distance_sq(pa, pb) - geo::distance_sq(pa, pd) = geo::distance_sq(pa, pc) - geo::distance_sq(pa, pd)
    geo::distance_sq(pa, pc) - geo::distance_sq(pa, pd) = geo::distance_sq(pd, pc)
    geo::distance_sq(pd, pb) = geo::distance_sq(pa, pb) - geo::distance_sq(pa, pd) = geo::distance_sq(pa, pc) - geo::distance_sq(pa, pd) = geo::distance_sq(pd, pc)
    release thm geo::distance_sq_symmetric(pd, pb)
    geo::distance_sq(pb, pd) = geo::distance_sq(pd, pc)

    # D 的线段参数给出 B,D,C 共线；共线且到两端等距，所以 D 是 BC 中点。
    geo::vec(pb, pd) = (pd[1] - pb[1], pd[2] - pb[2])
    pd[1] - pb[1] = s * (pc[1] - pb[1])
    pd[2] - pb[2] = s * (pc[2] - pb[2])
    release thm geo::det_coordinate_formula(geo::vec(pb, pd), geo::vec(pb, pc))
    geo::det(geo::vec(pb, pd), geo::vec(pb, pc)) = (pd[1] - pb[1]) * (pc[2] - pb[2]) - (pd[2] - pb[2]) * (pc[1] - pb[1])
    (pd[1] - pb[1]) * (pc[2] - pb[2]) - (pd[2] - pb[2]) * (pc[1] - pb[1]) = s * (pc[1] - pb[1]) * (pc[2] - pb[2]) - s * (pc[2] - pb[2]) * (pc[1] - pb[1])
    s * (pc[1] - pb[1]) * (pc[2] - pb[2]) - s * (pc[2] - pb[2]) * (pc[1] - pb[1]) = 0
    geo::det(geo::vec(pb, pd), geo::vec(pb, pc)) = 0
    by def $geo::is_collinear(pb, pd, pc)
    release thm geo::collinear_equidistant_implies_midpoint(pb, pc, pd)
    pd[1] = (pb[1] + pc[1]) / 2
    pd[2] = (pb[2] + pc[2]) / 2

    # D、E 分别为 BC、AC 中点，故 DE²=AB²/4；等边又给 AB²=BC²，而 BD²=BC²/4。
    release thm geo::distance_sq_coordinate_formula(pd, pe)
    release thm geo::distance_sq_coordinate_formula(pa, pb)
    geo::distance_sq(pd, pe) = (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2
    pe[1] - pd[1] = (pa[1] + pc[1]) / 2 - pd[1]
    (pa[1] + pc[1]) / 2 - pd[1] = (pa[1] + pc[1]) / 2 - (pb[1] + pc[1]) / 2
    (pa[1] + pc[1]) / 2 - (pb[1] + pc[1]) / 2 = (pa[1] - pb[1]) / 2
    pe[1] - pd[1] = (pa[1] - pb[1]) / 2
    pe[2] - pd[2] = (pa[2] + pc[2]) / 2 - pd[2]
    (pa[2] + pc[2]) / 2 - pd[2] = (pa[2] + pc[2]) / 2 - (pb[2] + pc[2]) / 2
    (pa[2] + pc[2]) / 2 - (pb[2] + pc[2]) / 2 = (pa[2] - pb[2]) / 2
    pe[2] - pd[2] = (pa[2] - pb[2]) / 2
    (pe[1] - pd[1])^2 = ((pa[1] - pb[1]) / 2)^2
    (pe[2] - pd[2])^2 = ((pa[2] - pb[2]) / 2)^2
    (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2 = ((pa[1] - pb[1]) / 2)^2 + ((pa[2] - pb[2]) / 2)^2
    ((pa[1] - pb[1]) / 2)^2 = (pa[1] - pb[1])^2 / 4
    ((pa[2] - pb[2]) / 2)^2 = (pa[2] - pb[2])^2 / 4
    ((pa[1] - pb[1]) / 2)^2 + ((pa[2] - pb[2]) / 2)^2 = ((pa[1] - pb[1])^2 + (pa[2] - pb[2])^2) / 4
    (pa[1] - pb[1])^2 = (pb[1] - pa[1])^2
    (pa[2] - pb[2])^2 = (pb[2] - pa[2])^2
    (pa[1] - pb[1])^2 + (pa[2] - pb[2])^2 = (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2
    release thm geo::distance_sq_coordinate_formula(pa, pb)
    geo::distance_sq(pa, pb) = (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2
    (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = geo::distance_sq(pa, pb)
    ((pa[1] - pb[1])^2 + (pa[2] - pb[2])^2) / 4 = ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2) / 4
    ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2) / 4 = geo::distance_sq(pa, pb) / 4
    ((pa[1] - pb[1]) / 2)^2 + ((pa[2] - pb[2]) / 2)^2 = geo::distance_sq(pa, pb) / 4
    geo::distance_sq(pd, pe) = geo::distance_sq(pa, pb) / 4

    release thm geo::distance_sq_coordinate_formula(pb, pd)
    release thm geo::distance_sq_coordinate_formula(pb, pc)
    geo::distance_sq(pb, pd) = (pd[1] - pb[1])^2 + (pd[2] - pb[2])^2
    pd[1] - pb[1] = (pb[1] + pc[1]) / 2 - pb[1]
    (pb[1] + pc[1]) / 2 - pb[1] = (pc[1] - pb[1]) / 2
    pd[1] - pb[1] = (pc[1] - pb[1]) / 2
    pd[2] - pb[2] = (pb[2] + pc[2]) / 2 - pb[2]
    (pb[2] + pc[2]) / 2 - pb[2] = (pc[2] - pb[2]) / 2
    pd[2] - pb[2] = (pc[2] - pb[2]) / 2
    (pd[1] - pb[1])^2 = ((pc[1] - pb[1]) / 2)^2
    (pd[2] - pb[2])^2 = ((pc[2] - pb[2]) / 2)^2
    (pd[1] - pb[1])^2 + (pd[2] - pb[2])^2 = ((pc[1] - pb[1]) / 2)^2 + ((pc[2] - pb[2]) / 2)^2
    ((pc[1] - pb[1]) / 2)^2 = (pc[1] - pb[1])^2 / 4
    ((pc[2] - pb[2]) / 2)^2 = (pc[2] - pb[2])^2 / 4
    ((pc[1] - pb[1]) / 2)^2 + ((pc[2] - pb[2]) / 2)^2 = ((pc[1] - pb[1])^2 + (pc[2] - pb[2])^2) / 4
    geo::distance_sq(pb, pc) = (pc[1] - pb[1])^2 + (pc[2] - pb[2])^2
    (pc[1] - pb[1])^2 + (pc[2] - pb[2])^2 = geo::distance_sq(pb, pc)
    ((pc[1] - pb[1])^2 + (pc[2] - pb[2])^2) / 4 = geo::distance_sq(pb, pc) / 4
    geo::distance_sq(pb, pd) = geo::distance_sq(pb, pc) / 4

    geo::distance_sq(pa, pb) = geo::distance_sq(pb, pc)
    geo::distance_sq(pa, pb) / 4 = geo::distance_sq(pb, pc) / 4
    geo::distance_sq(pb, pc) / 4 = geo::distance_sq(pb, pd)
    geo::distance_sq(pd, pe) = geo::distance_sq(pb, pc) / 4
    geo::distance_sq(pd, pe) = geo::distance_sq(pb, pd)

    by def $geo::are_segments_congruent(pd, pe, pb, pd)
