# Problem 228 / zhongkao_24
# ================================================================
# 原题（完整自然语言）
# 如图1，已知正方形ABCD和等腰Rt△BEF，EF=BE，∠BEF=90°，F是线段BC上一点，
# 取DF中点G，连接EG、CG。
# (1) 证明：EG=CG，EG⊥CG；
# (2) 如图2，将图1中的等腰Rt△BEF绕点B顺时针旋转α°（0<α<90°），
#     求证：EG=CG且EG⊥CG。
#
# 自然语言条件 ↔ forall前提与=>结论：
# - “正方形ABCD” ↔ 坐标归一化 pa=(0,a), pb=(0,0), pc=(a,0), pd=(a,a)，且a>0。
# - “等腰Rt△BEF，EF=BE，∠BEF=90°”
#   ↔ 对pf=(x,y)，取pe=((x-y)/2,(x+y)/2)；这是以pe为直角顶点、BE=EF的内侧90°分支。
# - “G为DF中点” ↔ pg=((a+x)/2,(a+y)/2)。
# - 图1“F在线段BC上” ↔ pf=(t,0)，0<t<a。
# - 图2“绕B顺时针旋转α，0<α<90°”
#   ↔ pf=(t*co,-t*si)，co^2+si^2=1，0<co<1，0<si<1，0<t<a；
#      pe使用同一刚性旋转后的坐标。
# - “EG=CG” ↔ $geo::are_segments_congruent(pe,pg,pc,pg)。
# - “EG⊥CG” ↔ $geo::is_perpendicular(pe,pg,pc,pg)。

# A nonzero second-coordinate difference makes two points distinct.
thm problem_228_points_distinct_from_second_difference:
    ? forall p, q cart(R, R):
        q[2] - p[2] != 0
        =>:
            p != q
    by contra:
        ? p != q
        p = q
        p[2] = q[2]
        q[2] - p[2] = 0
        impossible q[2] - p[2] != 0

# Unified coordinate certificate behind both figures.
thm problem_228_coordinate_core:
    ? forall a, x, y R, pc, pe, pg cart(R, R):
        a > 0
        x < a
        a + y > 0
        pc[1] = a
        pc[2] = 0
        pe[1] = (x - y) / 2
        pe[2] = (x + y) / 2
        pg[1] = (a + x) / 2
        pg[2] = (a + y) / 2
        =>:
            $geo::are_segments_congruent(pe, pg, pc, pg)
            $geo::is_perpendicular(pe, pg, pc, pg)

    release thm geo::distance_sq_coordinate_formula(pe, pg)
    release thm geo::distance_sq_coordinate_formula(pc, pg)
    geo::distance_sq(pe, pg) = (pg[1] - pe[1])^2 + (pg[2] - pe[2])^2
    geo::distance_sq(pc, pg) = (pg[1] - pc[1])^2 + (pg[2] - pc[2])^2
    release thm geo::subtract_equalities(pg[1], (a + x) / 2, pe[1], (x - y) / 2)
    pg[1] - pe[1] = (a + x) / 2 - (x - y) / 2
    (a + x) / 2 - (x - y) / 2 = (a + y) / 2
    pg[1] - pe[1] = (a + y) / 2
    release thm geo::subtract_equalities(pg[2], (a + y) / 2, pe[2], (x + y) / 2)
    pg[2] - pe[2] = (a + y) / 2 - (x + y) / 2
    (a + y) / 2 - (x + y) / 2 = (a - x) / 2
    pg[2] - pe[2] = (a - x) / 2
    release thm geo::subtract_equalities(pg[1], (a + x) / 2, pc[1], a)
    pg[1] - pc[1] = (a + x) / 2 - a
    (a + x) / 2 - a = (x - a) / 2
    pg[1] - pc[1] = (x - a) / 2
    release thm geo::subtract_equalities(pg[2], (a + y) / 2, pc[2], 0)
    pg[2] - pc[2] = (a + y) / 2 - 0
    (a + y) / 2 - 0 = (a + y) / 2
    pg[2] - pc[2] = (a + y) / 2
    (pg[1] - pe[1])^2 + (pg[2] - pe[2])^2 = ((a + y) / 2)^2 + ((a - x) / 2)^2
    (pg[1] - pc[1])^2 + (pg[2] - pc[2])^2 = ((x - a) / 2)^2 + ((a + y) / 2)^2
    ((a + y) / 2)^2 + ((a - x) / 2)^2 = ((x - a) / 2)^2 + ((a + y) / 2)^2
    geo::distance_sq(pe, pg) = geo::distance_sq(pc, pg)
    release thm geo::segments_congruent_from_distance_sq(pe, pg, pc, pg)

    release thm geo::vec_coordinate_formula(pe, pg)
    release thm geo::vec_coordinate_formula(pc, pg)
    release thm geo::dot_coordinate_formula(geo::vec(pe, pg), geo::vec(pc, pg))
    geo::dot(geo::vec(pe, pg), geo::vec(pc, pg)) = (pg[1] - pe[1]) * (pg[1] - pc[1]) + (pg[2] - pe[2]) * (pg[2] - pc[2])
    (pg[1] - pe[1]) * (pg[1] - pc[1]) + (pg[2] - pe[2]) * (pg[2] - pc[2]) = ((a + y) / 2) * ((x - a) / 2) + ((a - x) / 2) * ((a + y) / 2)
    ((a + y) / 2) * ((x - a) / 2) + ((a - x) / 2) * ((a + y) / 2) = 0
    geo::dot(geo::vec(pe, pg), geo::vec(pc, pg)) = 0

    a - x > 0
    (a - x) / 2 > 0
    pg[2] - pe[2] > 0
    pg[2] - pe[2] != 0
    release thm problem_228_points_distinct_from_second_difference(pe, pg)
    a + y > 0
    (a + y) / 2 > 0
    pg[2] - pc[2] > 0
    pg[2] - pc[2] != 0
    release thm problem_228_points_distinct_from_second_difference(pc, pg)
    release thm geo::perpendicular_from_dot_zero(pe, pg, pc, pg)

# Figure 1: F lies on BC and E is the inward isosceles-right vertex.
thm problem_228_figure1:
    ? forall a, t R, pa, pb, pc, pd, pe, pf, pg cart(R, R):
        a > 0
        0 < t
        t < a
        pa[1] = 0
        pa[2] = a
        pb[1] = 0
        pb[2] = 0
        pc[1] = a
        pc[2] = 0
        pd[1] = a
        pd[2] = a
        pf[1] = t
        pf[2] = 0
        pe[1] = t / 2
        pe[2] = t / 2
        pg[1] = (a + t) / 2
        pg[2] = a / 2
        =>:
            $geo::are_segments_congruent(pe, pg, pc, pg)
            $geo::is_perpendicular(pe, pg, pc, pg)

    pe[1] = (t - 0) / 2
    pe[2] = (t + 0) / 2
    pg[1] = (a + t) / 2
    pg[2] = (a + 0) / 2
    a + 0 > 0
    release thm problem_228_coordinate_core(a, t, 0, pc, pe, pg)

# Positive factor below one gives a strict product bound.
thm problem_228_product_less_self:
    ? forall t, u R:
        t > 0
        u < 1
        =>:
            t * u < t
    u - 1 < 0
    t * (u - 1) < 0
    t * u - t = t * (u - 1)
    t * u - t < 0
    t * u < t

# Figure 2: clockwise rotation of BEF through an acute angle.
thm problem_228_figure2:
    ? forall a, t, co, si R, pa, pb, pc, pd, pe, pf, pg cart(R, R):
        a > 0
        0 < t
        t < a
        0 < co
        co < 1
        0 < si
        si < 1
        co^2 + si^2 = 1
        pa[1] = 0
        pa[2] = a
        pb[1] = 0
        pb[2] = 0
        pc[1] = a
        pc[2] = 0
        pd[1] = a
        pd[2] = a
        pf[1] = t * co
        pf[2] = -t * si
        pe[1] = t * (co + si) / 2
        pe[2] = t * (co - si) / 2
        pg[1] = (a + t * co) / 2
        pg[2] = (a - t * si) / 2
        =>:
            $geo::are_segments_congruent(pe, pg, pc, pg)
            $geo::is_perpendicular(pe, pg, pc, pg)

    t * co < t
    t * co < a
    t * si < t
    t * si < a
    a - t * si > 0
    a - t * si = a + (-t * si)
    a + (-t * si) > 0
    pe[1] = (t * co - (-t * si)) / 2
    pe[2] = (t * co + (-t * si)) / 2
    pg[1] = (a + t * co) / 2
    pg[2] = (a + (-t * si)) / 2
    release thm problem_228_coordinate_core(a, t * co, -t * si, pc, pe, pg)
