# Problem 210：60°/120°旋转—中点垂直模型
#
# 【原题自然语言全文】
# 在 △ABC 中，如图③，∠BAC=60°，∠CDE=120°，AB=AC，DC=DE，
# 连接 BE，P 为 BE 的中点。求证：AP⊥DP。
#
# 【自然语言对象 ↔ Litex 变量】
# A ↔ a，B ↔ b，C ↔ c，D ↔ d，E ↔ q，P ↔ p。
# 注：源码用 q 表示原题中的点 E，避免把 E 当作 Litex 名称使用时产生歧义。
#
# 【题设条件 ↔ forall 前提：逐项语义对照】
# 1. 原题“AB=AC 且 ∠BAC=60°”，连同“如图③”给出的转向，形式化为
#      AC = R_(逆时针60°)(AB)，
#    即 forall 中关于 c[1]-a[1]、c[2]-a[2] 的两条坐标旋转式。
#    这两式同时表达长度 AB=AC、夹角 60°以及图③所选的有向分支。
# 2. 原题“DC=DE 且 ∠CDE=120°”，连同“如图③”给出的转向，形式化为
#      DE = R_(逆时针120°)(DC)，
#    即 forall 中关于 q[1]-d[1]、q[2]-d[2] 的两条坐标旋转式。
#    这两式同时表达长度 DC=DE、夹角 120°以及图③所选的有向分支。
# 3. 原题“P 为 BE 的中点”形式化为
#      2*p[1] = b[1] + q[1]，2*p[2] = b[2] + q[2]。
# 4. forall 中的 a != d 对应 A≠D。原题文字没有单独写出这一条件；这里把它作为
#    图③中 A、D 为不同点的非退化信息显式加入，以满足共享 KB 的严格垂直谓词
#    （AP、DP 都必须是非退化线段）。这是形式化相对原题文字的【附加前提】，必须披露。
#
# 【原题结论 ↔ forall 的 => 结论】
# 原题“AP⊥DP” ↔ $geo::is_perpendicular(a, p, d, p)。
# 该谓词表示直线 AP 与 DP 垂直，并要求 A≠P、D≠P；证明中会由 A≠D推出这两项。
#
# 【语义边界审计】
# - “如图③”携带文字题面未完全写出的方向信息。若只写无向的 60°/120°，会产生
#   镜像分支；本文件明确选择图③对应的两次逆时针旋转，避免证明错误分支。
# - 原文“△ABC”通常约定 A、B、C 不共线且互异；forall 未显式加入该非退化约束，
#   因为本结论在上述旋转方程成立的更宽情形仍可证明。这是【放宽题设】，未简化结论。
# - 因此，本形式化不是对文字表面的机械逐字转写：它显式补入 A≠D、显式解析图示方向，
#   同时省略未被证明使用的 △ABC 非退化约束；这些差异均已在此公开列明。
#
# 本文件复用已完成无 trust 全量验证的共享 KB 坐标几何接口。

thm distance_sq_coordinate_formula:
    ? forall a, b cart(R, R):
        geo::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    geo::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    geo::vec(a, b)[1] = b[1] - a[1]
    geo::vec(a, b)[2] = b[2] - a[2]
    geo::distance_sq(a, b) = geo::dot(geo::vec(a, b), geo::vec(a, b))
    geo::dot(geo::vec(a, b), geo::vec(a, b)) = geo::vec(a, b)[1] * geo::vec(a, b)[1] + geo::vec(a, b)[2] * geo::vec(a, b)[2] = (b[1] - a[1])^2 + (b[2] - a[2])^2

thm distance_sq_positive_of_ne:
    ? forall a, b cart(R, R):
        a != b
        =>:
            0 < geo::distance_sq(a, b)
    by contra:
        ? 0 < geo::distance_sq(a, b)
        geo::distance_sq(a, b) <= 0
        by thm distance_sq_coordinate_formula(a, b)
        0 <= (b[1] - a[1])^2
        0 <= (b[2] - a[2])^2
        0 <= (b[1] - a[1])^2 + (b[2] - a[2])^2
        0 <= geo::distance_sq(a, b)
        geo::distance_sq(a, b) = 0
        (b[1] - a[1])^2 + (b[2] - a[2])^2 = 0
        (b[1] - a[1])^2 <= (b[1] - a[1])^2 + (b[2] - a[2])^2
        (b[1] - a[1])^2 <= 0
        (b[1] - a[1])^2 = 0
        (b[2] - a[2])^2 <= (b[1] - a[1])^2 + (b[2] - a[2])^2
        (b[2] - a[2])^2 <= 0
        (b[2] - a[2])^2 = 0
        b[1] - a[1] = 0
        b[2] - a[2] = 0
        a[1] = b[1]
        a[2] = b[2]
        a = (a[1], a[2])
        b = (b[1], b[2])
        (a[1], a[2]) = (b[1], b[2])
        a = (a[1], a[2]) = (b[1], b[2]) = b
        a = b
        impossible a != b

thm problem_210_midpoint_rotation_perpendicular:
    ? forall a, b, c, d, q, p cart(R, R):
        # 【附加非退化前提】A≠D；原题文字未明写，来源与必要性见文件开头语义审计。
        a != d,
        # 【原题条件】AB=AC、∠BAC=60°，按图③定向为 AC=逆时针R60°(AB)：x 分量。
        c[1] - a[1] = (b[1] - a[1]) / 2 - sqrt(3) * (b[2] - a[2]) / 2,
        # 【原题条件】AB=AC、∠BAC=60°，按图③定向为 AC=逆时针R60°(AB)：y 分量。
        c[2] - a[2] = sqrt(3) * (b[1] - a[1]) / 2 + (b[2] - a[2]) / 2,
        # 【原题条件】DC=DE、∠CDE=120°，按图③定向为 DE=逆时针R120°(DC)：x 分量；q=E。
        q[1] - d[1] = -(c[1] - d[1]) / 2 - sqrt(3) * (c[2] - d[2]) / 2,
        # 【原题条件】DC=DE、∠CDE=120°，按图③定向为 DE=逆时针R120°(DC)：y 分量；q=E。
        q[2] - d[2] = sqrt(3) * (c[1] - d[1]) / 2 - (c[2] - d[2]) / 2,
        # 【原题条件】P 是 BE 的中点：x 坐标；q=E。
        2 * p[1] = b[1] + q[1],
        # 【原题条件】P 是 BE 的中点：y 坐标；q=E。
        2 * p[2] = b[2] + q[2]
        =>:
            # 【原题结论】AP⊥DP；不是点积为零这一弱化陈述，而是共享 KB 的严格垂直谓词。
            $geo::is_perpendicular(a, p, d, p)

    sqrt(3)^2 = 3

    c[1] = (c[1] - a[1]) + a[1] = ((b[1] - a[1]) / 2 - sqrt(3) * (b[2] - a[2]) / 2) + a[1] = a[1] + (b[1] - a[1]) / 2 - sqrt(3) * (b[2] - a[2]) / 2
    c[2] = (c[2] - a[2]) + a[2] = (sqrt(3) * (b[1] - a[1]) / 2 + (b[2] - a[2]) / 2) + a[2] = a[2] + sqrt(3) * (b[1] - a[1]) / 2 + (b[2] - a[2]) / 2
    q[1] = (q[1] - d[1]) + d[1] = (-(c[1] - d[1]) / 2 - sqrt(3) * (c[2] - d[2]) / 2) + d[1] = d[1] - (c[1] - d[1]) / 2 - sqrt(3) * (c[2] - d[2]) / 2
    q[2] = (q[2] - d[2]) + d[2] = (sqrt(3) * (c[1] - d[1]) / 2 - (c[2] - d[2]) / 2) + d[2] = d[2] + sqrt(3) * (c[1] - d[1]) / 2 - (c[2] - d[2]) / 2

    q[1] = d[1] - (c[1] - d[1]) / 2 - sqrt(3) * (c[2] - d[2]) / 2 = d[1] - ((a[1] + (b[1] - a[1]) / 2 - sqrt(3) * (b[2] - a[2]) / 2) - d[1]) / 2 - sqrt(3) * ((a[2] + sqrt(3) * (b[1] - a[1]) / 2 + (b[2] - a[2]) / 2) - d[2]) / 2 = -(a[1]) / 4 - b[1] / 4 + 3 * d[1] / 2 + sqrt(3)^2 * (a[1] / 4 - b[1] / 4) + sqrt(3) * (-(a[2]) / 2 + d[2] / 2)
    q[2] = d[2] + sqrt(3) * (c[1] - d[1]) / 2 - (c[2] - d[2]) / 2 = d[2] + sqrt(3) * ((a[1] + (b[1] - a[1]) / 2 - sqrt(3) * (b[2] - a[2]) / 2) - d[1]) / 2 - ((a[2] + sqrt(3) * (b[1] - a[1]) / 2 + (b[2] - a[2]) / 2) - d[2]) / 2 = -(a[2]) / 4 - b[2] / 4 + 3 * d[2] / 2 + sqrt(3)^2 * (a[2] / 4 - b[2] / 4) + sqrt(3) * (a[1] / 2 - d[1] / 2)
    q[1] = -(a[1]) / 4 - b[1] / 4 + 3 * d[1] / 2 + sqrt(3)^2 * (a[1] / 4 - b[1] / 4) + sqrt(3) * (-(a[2]) / 2 + d[2] / 2) = -(a[1]) / 4 - b[1] / 4 + 3 * d[1] / 2 + 3 * (a[1] / 4 - b[1] / 4) + sqrt(3) * (-(a[2]) / 2 + d[2] / 2) = a[1] / 2 - b[1] + 3 * d[1] / 2 + sqrt(3) * (-(a[2]) / 2 + d[2] / 2)
    q[2] = -(a[2]) / 4 - b[2] / 4 + 3 * d[2] / 2 + sqrt(3)^2 * (a[2] / 4 - b[2] / 4) + sqrt(3) * (a[1] / 2 - d[1] / 2) = -(a[2]) / 4 - b[2] / 4 + 3 * d[2] / 2 + 3 * (a[2] / 4 - b[2] / 4) + sqrt(3) * (a[1] / 2 - d[1] / 2) = a[2] / 2 - b[2] + 3 * d[2] / 2 + sqrt(3) * (a[1] / 2 - d[1] / 2)

    p[1] = (b[1] + q[1]) / 2
    p[2] = (b[2] + q[2]) / 2
    p[1] - a[1] = (b[1] + q[1]) / 2 - a[1] = (b[1] + (a[1] / 2 - b[1] + 3 * d[1] / 2 + sqrt(3) * (-(a[2]) / 2 + d[2] / 2))) / 2 - a[1] = 3 * (d[1] - a[1]) / 4 + sqrt(3) * (d[2] - a[2]) / 4
    p[2] - a[2] = (b[2] + q[2]) / 2 - a[2] = (b[2] + (a[2] / 2 - b[2] + 3 * d[2] / 2 + sqrt(3) * (a[1] / 2 - d[1] / 2))) / 2 - a[2] = -(sqrt(3)) * (d[1] - a[1]) / 4 + 3 * (d[2] - a[2]) / 4
    p[1] - d[1] = (b[1] + q[1]) / 2 - d[1] = (b[1] + (a[1] / 2 - b[1] + 3 * d[1] / 2 + sqrt(3) * (-(a[2]) / 2 + d[2] / 2))) / 2 - d[1] = -(d[1] - a[1]) / 4 + sqrt(3) * (d[2] - a[2]) / 4
    p[2] - d[2] = (b[2] + q[2]) / 2 - d[2] = (b[2] + (a[2] / 2 - b[2] + 3 * d[2] / 2 + sqrt(3) * (a[1] / 2 - d[1] / 2))) / 2 - d[2] = -(sqrt(3)) * (d[1] - a[1]) / 4 - (d[2] - a[2]) / 4

    by thm distance_sq_coordinate_formula(a, d)
    by thm distance_sq_coordinate_formula(a, p)
    by thm distance_sq_coordinate_formula(d, p)
    geo::distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2 = (3 * (d[1] - a[1]) / 4 + sqrt(3) * (d[2] - a[2]) / 4)^2 + (-(sqrt(3)) * (d[1] - a[1]) / 4 + 3 * (d[2] - a[2]) / 4)^2 = ((9 + sqrt(3)^2) * (d[1] - a[1])^2 + (sqrt(3)^2 + 9) * (d[2] - a[2])^2) / 16 = (12 * (d[1] - a[1])^2 + 12 * (d[2] - a[2])^2) / 16 = 3 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) / 4 = 3 * geo::distance_sq(a, d) / 4
    geo::distance_sq(d, p) = (p[1] - d[1])^2 + (p[2] - d[2])^2 = (-(d[1] - a[1]) / 4 + sqrt(3) * (d[2] - a[2]) / 4)^2 + (-(sqrt(3)) * (d[1] - a[1]) / 4 - (d[2] - a[2]) / 4)^2 = ((1 + sqrt(3)^2) * (d[1] - a[1])^2 + (sqrt(3)^2 + 1) * (d[2] - a[2])^2) / 16 = (4 * (d[1] - a[1])^2 + 4 * (d[2] - a[2])^2) / 16 = ((d[1] - a[1])^2 + (d[2] - a[2])^2) / 4 = geo::distance_sq(a, d) / 4
    by thm distance_sq_positive_of_ne(a, d)
    0 < 3
    0 < 4
    0 < 3 * geo::distance_sq(a, d)
    0 < 3 * geo::distance_sq(a, d) / 4
    0 < geo::distance_sq(a, d) / 4
    0 < geo::distance_sq(a, p)
    0 < geo::distance_sq(d, p)

    by contra:
        ? a != p
        a = p
        geo::distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2 = (a[1] - a[1])^2 + (a[2] - a[2])^2 = 0
        impossible 0 < geo::distance_sq(a, p)

    by contra:
        ? d != p
        d = p
        geo::distance_sq(d, p) = (p[1] - d[1])^2 + (p[2] - d[2])^2 = (d[1] - d[1])^2 + (d[2] - d[2])^2 = 0
        impossible 0 < geo::distance_sq(d, p)

    geo::vec(a, p) = (p[1] - a[1], p[2] - a[2])
    geo::vec(d, p) = (p[1] - d[1], p[2] - d[2])
    geo::vec(a, p)[1] = p[1] - a[1]
    geo::vec(a, p)[2] = p[2] - a[2]
    geo::vec(d, p)[1] = p[1] - d[1]
    geo::vec(d, p)[2] = p[2] - d[2]
    geo::dot(geo::vec(a, p), geo::vec(d, p)) = geo::vec(a, p)[1] * geo::vec(d, p)[1] + geo::vec(a, p)[2] * geo::vec(d, p)[2] = (p[1] - a[1]) * (p[1] - d[1]) + (p[2] - a[2]) * (p[2] - d[2]) = (3 * (d[1] - a[1]) / 4 + sqrt(3) * (d[2] - a[2]) / 4) * (-(d[1] - a[1]) / 4 + sqrt(3) * (d[2] - a[2]) / 4) + (-(sqrt(3)) * (d[1] - a[1]) / 4 + 3 * (d[2] - a[2]) / 4) * (-(sqrt(3)) * (d[1] - a[1]) / 4 - (d[2] - a[2]) / 4) = ((sqrt(3)^2 - 3) * (d[1] - a[1])^2 + (sqrt(3)^2 - 3) * (d[2] - a[2])^2) / 16 = 0
    $geo::is_perpendicular(a, p, d, p)
