# Problem 220 (zhongkao_16): 平行线、折叠与倍长中线模型
#
# 原题自然语言：如图，点 P 是∠MON内部一点，过 P 分别作 PA∥ON 交 OM 于 A，
# PB∥OM 交 ON 于 B（PA≥PB）。在线段 OB 上取 C，连接 AC，将△AOC沿 AC 翻折得△ADC；
# 延长 AD 交 PB 于 E，延长 CD 交 PB 于 F。
# (1) 当四边形 AOBP 是正方形时，求证 DF=PF。
# (2) 当 C 为 OB 中点时，求证 AE=AO+BE。
#
# 本文件形式化范围：只证明两问所需的坐标/参数代数核心；图形坐标关系、折叠等距关系
# 和交点参数作为定理前提明确给出，未宣称已由完整几何谓词自动导出。
#
# 自然语言条件 ↔ forall 前提与结论：
# - (1) 正方形模型 O=(0,0), A=(a,0), B=(0,a), P=(a,a), C=(0,t)
#   ↔ a>0, t>0, t<a；a+t!=0 与 a^2+t^2!=0 是分母和非退化条件。
# - (1) 折叠点 D 与交点 F 的归一化坐标
#   ↔ => 中两个显式坐标点；其 distance_sq 相等 ↔ DF=PF。
# - (2) C 为 OB 中点 ↔ 使用 C=B/2；AO=AD、CO=CD 的折叠等距关系
#   ↔ 前两条 distance_sq 相等式。
# - (2) E 在交点参数化中满足 E=B+rA=A+lambda(D-A)，且射线次序
#   ↔ 两条坐标等式、r>=0、lambda>=1；lambda=r+1 ↔ AE=AO+BE（结合
#   AD=AO、BE=r·AO 的参数化）。

# Part (1): with O=(0,0), A=(a,0), B=(0,a), P=(a,a), C=(0,t),
# reflection gives D below and CD meets y=a at F below.
thm problem_220_part1_coordinate_core:
    ? forall a, t R:
        # 正方形边长 a>0；C=(0,t) 严格位于 OB 内部。
        a > 0
        t > 0
        t < a
        # 坐标公式所需的非零分母（均由上述正性条件推出）。
        a + t != 0
        a^2 + t^2 != 0
        =>:
            # D、F、P 的坐标证书下，DF²=PF²，即原题 DF=PF 的平方距离形式。
            geo::distance_sq((2 * a * t^2 / (a^2 + t^2), 2 * a^2 * t / (a^2 + t^2)), (2 * a * t / (a + t), a)) = geo::distance_sq((a, a), (2 * a * t / (a + t), a))
    a + t > 0
    a + t != 0
    a^2 > 0
    t^2 > 0
    a^2 + t^2 > 0
    a^2 + t^2 != 0
    by thm geo::distance_sq_coordinate_formula((2 * a * t^2 / (a^2 + t^2), 2 * a^2 * t / (a^2 + t^2)), (2 * a * t / (a + t), a))
    by thm geo::distance_sq_coordinate_formula((a, a), (2 * a * t / (a + t), a))
    (2 * a * t / (a + t) - 2 * a * t^2 / (a^2 + t^2))^2 + (a - 2 * a^2 * t / (a^2 + t^2))^2 = (2 * a * t / (a + t) - a)^2 + (a - a)^2

# Part (2): O is the origin, A=(a1,a2), B=(b1,b2), C=B/2.
# The two squared-distance hypotheses are exactly AO=AD and CO=CD from folding.
# E=B+r*A=A+lambda*(D-A), where r>=0 and lambda>=1 encode the ray orders.
thm problem_220_part2_parameter_core:
    ? forall a1, a2, b1, b2, d1, d2, r, lambda R:
        # 折叠保持距离：AD=AO。
        geo::distance_sq((a1, a2), (d1, d2)) = geo::distance_sq((0, 0), (a1, a2))
        # C=B/2 且折叠保持距离：CD=CO。
        geo::distance_sq((b1 / 2, b2 / 2), (d1, d2)) = geo::distance_sq((0, 0), (b1 / 2, b2 / 2))
        # 同一点 E 的两种参数化：E=B+rA=A+lambda(D-A)。
        b1 + r * a1 = a1 + lambda * (d1 - a1)
        b2 + r * a2 = a2 + lambda * (d2 - a2)
        # D 非退化，且 E 位于相应射线上。
        (d1, d2) != (0, 0)
        r >= 0
        lambda >= 1
        =>:
            # AE=lambda·AO、BE=r·AO，故 lambda=r+1 对应 AE=AO+BE。
            lambda = r + 1
    by thm geo::distance_sq_coordinate_formula((a1, a2), (d1, d2))
    by thm geo::distance_sq_coordinate_formula((0, 0), (a1, a2))
    by thm geo::distance_sq_coordinate_formula((b1 / 2, b2 / 2), (d1, d2))
    by thm geo::distance_sq_coordinate_formula((0, 0), (b1 / 2, b2 / 2))

    (d1 - a1)^2 + (d2 - a2)^2 = a1^2 + a2^2
    (d1 - b1 / 2)^2 + (d2 - b2 / 2)^2 = (b1 / 2)^2 + (b2 / 2)^2
    (d1 - a1)^2 + (d2 - a2)^2 = d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2) + a1^2 + a2^2
    a1^2 + a2^2 = d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2) + a1^2 + a2^2
    by thm geo::subtract_equalities(a1^2 + a2^2, d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2) + a1^2 + a2^2, a1^2 + a2^2, a1^2 + a2^2)
    (a1^2 + a2^2) - (a1^2 + a2^2) = (d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2) + a1^2 + a2^2) - (a1^2 + a2^2)
    (a1^2 + a2^2) - (a1^2 + a2^2) = 0
    (d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2) + a1^2 + a2^2) - (a1^2 + a2^2) = d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2)
    0 = d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2)
    d1^2 + d2^2 - 2 * (a1 * d1 + a2 * d2) = 0
    d1^2 + d2^2 = 2 * (a1 * d1 + a2 * d2)
    (d1 - b1 / 2)^2 + (d2 - b2 / 2)^2 = d1^2 + d2^2 - (b1 * d1 + b2 * d2) + (b1 / 2)^2 + (b2 / 2)^2
    (b1 / 2)^2 + (b2 / 2)^2 = d1^2 + d2^2 - (b1 * d1 + b2 * d2) + (b1 / 2)^2 + (b2 / 2)^2
    by thm geo::subtract_equalities((b1 / 2)^2 + (b2 / 2)^2, d1^2 + d2^2 - (b1 * d1 + b2 * d2) + (b1 / 2)^2 + (b2 / 2)^2, (b1 / 2)^2 + (b2 / 2)^2, (b1 / 2)^2 + (b2 / 2)^2)
    ((b1 / 2)^2 + (b2 / 2)^2) - ((b1 / 2)^2 + (b2 / 2)^2) = (d1^2 + d2^2 - (b1 * d1 + b2 * d2) + (b1 / 2)^2 + (b2 / 2)^2) - ((b1 / 2)^2 + (b2 / 2)^2)
    ((b1 / 2)^2 + (b2 / 2)^2) - ((b1 / 2)^2 + (b2 / 2)^2) = 0
    (d1^2 + d2^2 - (b1 * d1 + b2 * d2) + (b1 / 2)^2 + (b2 / 2)^2) - ((b1 / 2)^2 + (b2 / 2)^2) = d1^2 + d2^2 - (b1 * d1 + b2 * d2)
    0 = d1^2 + d2^2 - (b1 * d1 + b2 * d2)
    d1^2 + d2^2 - (b1 * d1 + b2 * d2) = 0
    d1^2 + d2^2 = b1 * d1 + b2 * d2

    a1 + lambda * (d1 - a1) = lambda * d1 + (1 - lambda) * a1
    b1 + r * a1 = lambda * d1 + (1 - lambda) * a1
    by thm geo::subtract_equalities(b1 + r * a1, lambda * d1 + (1 - lambda) * a1, (1 - lambda) * a1, (1 - lambda) * a1)
    (b1 + r * a1) - (1 - lambda) * a1 = (lambda * d1 + (1 - lambda) * a1) - (1 - lambda) * a1
    (b1 + r * a1) - (1 - lambda) * a1 = b1 + (r + lambda - 1) * a1
    (lambda * d1 + (1 - lambda) * a1) - (1 - lambda) * a1 = lambda * d1
    lambda * d1 = b1 + (r + lambda - 1) * a1

    a2 + lambda * (d2 - a2) = lambda * d2 + (1 - lambda) * a2
    b2 + r * a2 = lambda * d2 + (1 - lambda) * a2
    by thm geo::subtract_equalities(b2 + r * a2, lambda * d2 + (1 - lambda) * a2, (1 - lambda) * a2, (1 - lambda) * a2)
    (b2 + r * a2) - (1 - lambda) * a2 = (lambda * d2 + (1 - lambda) * a2) - (1 - lambda) * a2
    (b2 + r * a2) - (1 - lambda) * a2 = b2 + (r + lambda - 1) * a2
    (lambda * d2 + (1 - lambda) * a2) - (1 - lambda) * a2 = lambda * d2
    lambda * d2 = b2 + (r + lambda - 1) * a2
    by thm geo::multiply_both_sides(lambda * d1, b1 + (r + lambda - 1) * a1, d1)
    (lambda * d1) * d1 = (b1 + (r + lambda - 1) * a1) * d1
    (lambda * d1) * d1 = lambda * d1^2
    (b1 + (r + lambda - 1) * a1) * d1 = b1 * d1 + (r + lambda - 1) * (a1 * d1)
    lambda * d1^2 = b1 * d1 + (r + lambda - 1) * (a1 * d1)
    by thm geo::multiply_both_sides(lambda * d2, b2 + (r + lambda - 1) * a2, d2)
    (lambda * d2) * d2 = (b2 + (r + lambda - 1) * a2) * d2
    (lambda * d2) * d2 = lambda * d2^2
    (b2 + (r + lambda - 1) * a2) * d2 = b2 * d2 + (r + lambda - 1) * (a2 * d2)
    lambda * d2^2 = b2 * d2 + (r + lambda - 1) * (a2 * d2)
    by thm geo::add_equalities(lambda * d1^2, b1 * d1 + (r + lambda - 1) * (a1 * d1), lambda * d2^2, b2 * d2 + (r + lambda - 1) * (a2 * d2))
    lambda * d1^2 + lambda * d2^2 = (b1 * d1 + (r + lambda - 1) * (a1 * d1)) + (b2 * d2 + (r + lambda - 1) * (a2 * d2))
    lambda * (d1^2 + d2^2) = lambda * d1^2 + lambda * d2^2
    (b1 * d1 + (r + lambda - 1) * (a1 * d1)) + (b2 * d2 + (r + lambda - 1) * (a2 * d2)) = (b1 * d1 + b2 * d2) + ((r + lambda - 1) * (a1 * d1) + (r + lambda - 1) * (a2 * d2))
    (r + lambda - 1) * (a1 * d1) + (r + lambda - 1) * (a2 * d2) = (r + lambda - 1) * (a1 * d1 + a2 * d2)
    lambda * (d1^2 + d2^2) = (b1 * d1 + b2 * d2) + (r + lambda - 1) * (a1 * d1 + a2 * d2)
    by thm geo::multiply_both_sides(lambda * (d1^2 + d2^2), (b1 * d1 + b2 * d2) + (r + lambda - 1) * (a1 * d1 + a2 * d2), 2)
    (lambda * (d1^2 + d2^2)) * 2 = ((b1 * d1 + b2 * d2) + (r + lambda - 1) * (a1 * d1 + a2 * d2)) * 2
    (lambda * (d1^2 + d2^2)) * 2 = 2 * lambda * (d1^2 + d2^2)
    ((b1 * d1 + b2 * d2) + (r + lambda - 1) * (a1 * d1 + a2 * d2)) * 2 = 2 * (b1 * d1 + b2 * d2) + 2 * (r + lambda - 1) * (a1 * d1 + a2 * d2)
    2 * lambda * (d1^2 + d2^2) = 2 * (b1 * d1 + b2 * d2) + 2 * (r + lambda - 1) * (a1 * d1 + a2 * d2)

    b1 * d1 + b2 * d2 = d1^2 + d2^2
    by thm geo::multiply_both_sides(b1 * d1 + b2 * d2, d1^2 + d2^2, 2)
    (b1 * d1 + b2 * d2) * 2 = (d1^2 + d2^2) * 2
    (b1 * d1 + b2 * d2) * 2 = 2 * (b1 * d1 + b2 * d2)
    (d1^2 + d2^2) * 2 = 2 * (d1^2 + d2^2)
    2 * (b1 * d1 + b2 * d2) = 2 * (d1^2 + d2^2)

    2 * (a1 * d1 + a2 * d2) = d1^2 + d2^2
    by thm geo::multiply_both_sides(2 * (a1 * d1 + a2 * d2), d1^2 + d2^2, r + lambda - 1)
    (2 * (a1 * d1 + a2 * d2)) * (r + lambda - 1) = (d1^2 + d2^2) * (r + lambda - 1)
    (2 * (a1 * d1 + a2 * d2)) * (r + lambda - 1) = 2 * (r + lambda - 1) * (a1 * d1 + a2 * d2)
    (d1^2 + d2^2) * (r + lambda - 1) = (r + lambda - 1) * (d1^2 + d2^2)
    2 * (r + lambda - 1) * (a1 * d1 + a2 * d2) = (r + lambda - 1) * (d1^2 + d2^2)

    by thm geo::add_equalities(2 * (b1 * d1 + b2 * d2), 2 * (d1^2 + d2^2), 2 * (r + lambda - 1) * (a1 * d1 + a2 * d2), (r + lambda - 1) * (d1^2 + d2^2))
    2 * (b1 * d1 + b2 * d2) + 2 * (r + lambda - 1) * (a1 * d1 + a2 * d2) = 2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)
    2 * lambda * (d1^2 + d2^2) = 2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)

    by thm geo::subtract_equalities(2 * lambda * (d1^2 + d2^2), 2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2), 2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2), 2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2))
    (2 * lambda * (d1^2 + d2^2)) - (2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)) = (2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)) - (2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2))
    (2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)) - (2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)) = 0
    (2 * lambda * (d1^2 + d2^2)) - (2 * (d1^2 + d2^2) + (r + lambda - 1) * (d1^2 + d2^2)) = (lambda - r - 1) * (d1^2 + d2^2)
    (lambda - r - 1) * (d1^2 + d2^2) = 0

    (0, 0) != (d1, d2)
    by thm geo::point_difference_norm_pos((0, 0), (d1, d2))
    (d1 - 0)^2 + (d2 - 0)^2 > 0
    (d1 - 0)^2 + (d2 - 0)^2 = d1^2 + d2^2
    d1^2 + d2^2 > 0
    d1^2 + d2^2 != 0
    by thm geo::rearrange_sum(lambda, r, 1)
    lambda = r + 1
