# Problem 934 / zhongkao_747 - 等腰三角形判定
#
# 【原题】
# 选择情况一证明：已知：在△ABC中，AD平分∠BAC，D是BC的中点，
# AD⊥BC，证明：AB=AC。
#
# 【自然语言对象 ↔ Litex 变量】
# A ↔ a，B ↔ b，C ↔ c，D ↔ d。
#
# 【题面 ↔ 形式命题逐项对应】
# 1. “在△ABC中” ↔ $geo::is_triangle(a, b, c)。
# 2. “AD平分∠BAC” ↔ $geo::is_angle_bisector(b, a, c, d)。
# 3. “D是BC的中点” ↔ $geo::is_midpoint(d, b, c)。
# 4. “AD⊥BC” ↔ $geo::is_perpendicular(a, d, b, c)。
# 5. “AB=AC” ↔ $geo::are_segments_congruent(a, b, a, c)。

thm problem_934_angle_bisector_midpoint_perpendicular:
    ? forall a, b, c, d cart(R, R):
        # “在△ABC中”。
        $geo::is_triangle(a, b, c),
        # “AD平分∠BAC”。
        $geo::is_angle_bisector(b, a, c, d),
        # “D是BC的中点”。
        $geo::is_midpoint(d, b, c),
        # “AD⊥BC”。
        $geo::is_perpendicular(a, d, b, c)
        =>:
            # “证明：AB=AC”。
            $geo::are_segments_congruent(a, b, a, c)

    # AD⊥BC 的语义定义包含线段 BC 的非退化条件 B != C。
    by def $geo::is_perpendicular(a, d, b, c)

    # D 为 BC 中点且 AD⊥BC，所以 A 在 BC 的垂直平分线上。
    by thm geo::perpendicular_bisector_equidistant(b, c, d, a)
    geo::distance_sq(a, b) = geo::distance_sq(a, c)

    # 将距离平方相等封装回题目要求的线段全等谓词 AB=AC。
    by def $geo::are_segments_congruent(a, b, a, c)
