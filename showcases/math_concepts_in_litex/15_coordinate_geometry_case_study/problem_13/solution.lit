# Wrapper probe for the complete IMO 1967/1 coordinate theorem.

have fn tri_weight(a, c, s, u, v R) R = u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c

have fn dist_A(a, c, s, u, v R) R = (u * a + v * c)^2 + (v * s)^2
have fn dist_B(a, c, s, u, v R) R = ((u - 1) * a + v * c)^2 + (v * s)^2
have fn dist_D(a, c, s, u, v R) R = (u * a + (v - 1) * c)^2 + ((v - 1) * s)^2

thm condition_implies_radius_bound:
    ? forall a, c, s R:
        s > 0
        c > 0
        a > c
        c^2 + s^2 = 1
        a <= c + sqrt(3) * s
        =>:
            a^2 + 1 - 2 * a * c <= 4 * s^2
    3 > 0
    sqrt(3) > 0
    sqrt(3)^2 = 3
    a - c > 0
    0 <= (c + sqrt(3) * s) - a
    (c + sqrt(3) * s) - a = sqrt(3) * s - (a - c)
    0 <= sqrt(3) * s - (a - c)
    a - c <= sqrt(3) * s
    sqrt(3) * s > 0
    0 <= sqrt(3) * s - (a - c)
    0 < sqrt(3) * s
    0 < (a - c) + sqrt(3) * s
    0 <= (a - c) + sqrt(3) * s
    0 <= (sqrt(3) * s - (a - c)) * ((a - c) + sqrt(3) * s)
    (sqrt(3) * s - (a - c)) * ((a - c) + sqrt(3) * s) = (sqrt(3) * s)^2 - (a - c)^2
    0 <= (sqrt(3) * s)^2 - (a - c)^2
    (a - c)^2 <= (sqrt(3) * s)^2
    (sqrt(3) * s)^2 = sqrt(3)^2 * s^2
    sqrt(3)^2 * s^2 = 3 * s^2
    (sqrt(3) * s)^2 = 3 * s^2
    (a - c)^2 <= 3 * s^2
    (a - c)^2 = a^2 - 2 * a * c + c^2
    a^2 - 2 * a * c + c^2 <= 3 * s^2
    0 <= 3 * s^2 - (a^2 - 2 * a * c + c^2)
    (3 * s^2 + s^2) - ((a^2 - 2 * a * c + c^2) + s^2) = 3 * s^2 - (a^2 - 2 * a * c + c^2)
    0 <= (3 * s^2 + s^2) - ((a^2 - 2 * a * c + c^2) + s^2)
    (a^2 - 2 * a * c + c^2) + s^2 <= 3 * s^2 + s^2
    3 * s^2 + s^2 = 4 * s^2
    (a^2 - 2 * a * c + c^2) + s^2 <= 4 * s^2
    (a^2 - 2 * a * c + c^2) + s^2 = a^2 - 2 * a * c + c^2 + s^2
    a^2 - 2 * a * c + c^2 + s^2 = a^2 - 2 * a * c + (c^2 + s^2)
    a^2 - 2 * a * c + (c^2 + s^2) = a^2 - 2 * a * c + 1
    a^2 - 2 * a * c + 1 = a^2 + 1 - 2 * a * c
    a^2 - 2 * a * c + c^2 + s^2 = a^2 + 1 - 2 * a * c
    a^2 + 1 - 2 * a * c <= 4 * s^2

thm triangle_weight_identity:
    ? forall a, c, s, u, v R:
        c^2 + s^2 = 1
        =>:
            (1 - u - v) * dist_A(a, c, s, u, v) + u * dist_B(a, c, s, u, v) + v * dist_D(a, c, s, u, v) = tri_weight(a, c, s, u, v)
    dist_A(a, c, s, u, v) = (u * a + v * c)^2 + (v * s)^2
    dist_B(a, c, s, u, v) = ((u - 1) * a + v * c)^2 + (v * s)^2
    dist_D(a, c, s, u, v) = (u * a + (v - 1) * c)^2 + ((v - 1) * s)^2
    tri_weight(a, c, s, u, v) = u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c
    (1 - u - v) * dist_A(a, c, s, u, v) + u * dist_B(a, c, s, u, v) + v * dist_D(a, c, s, u, v) = (1 - u - v) * ((u * a + v * c)^2 + (v * s)^2) + u * (((u - 1) * a + v * c)^2 + (v * s)^2) + v * ((u * a + (v - 1) * c)^2 + ((v - 1) * s)^2)
    (1 - u - v) * ((u * a + v * c)^2 + (v * s)^2) + u * (((u - 1) * a + v * c)^2 + (v * s)^2) + v * ((u * a + (v - 1) * c)^2 + ((v - 1) * s)^2) = u * (1 - u) * a^2 + v * (1 - v) * (c^2 + s^2) - 2 * u * v * a * c
    u * (1 - u) * a^2 + v * (1 - v) * (c^2 + s^2) - 2 * u * v * a * c = u * (1 - u) * a^2 + v * (1 - v) * 1 - 2 * u * v * a * c
    u * (1 - u) * a^2 + v * (1 - v) * 1 - 2 * u * v * a * c = u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c
    (1 - u - v) * dist_A(a, c, s, u, v) + u * dist_B(a, c, s, u, v) + v * dist_D(a, c, s, u, v) = tri_weight(a, c, s, u, v)

thm triangle_weight_upper_bound:
    ? forall a, c, s, u, v R:
        s > 0
        c^2 + s^2 = 1
        a^2 + 1 - 2 * a * c <= 4 * s^2
        =>:
            tri_weight(a, c, s, u, v) <= 1
    s^2 > 0
    tri_weight(a, c, s, u, v) = u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c
    a^2 + 1 - 2 * a * c - 4 * s^2 * tri_weight(a, c, s, u, v) = a^2 + 1 - 2 * a * c - 4 * s^2 * (u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c)
    (a^2 + 1 - 2 * a * c - 4 * s^2 * (u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c)) - ((2 * s * (u * a + v * c) - a * s)^2 + (2 * v * s^2 - (1 - a * c))^2) = -(a^2 + 4 * s^2 * v^2) * (c^2 + s^2 - 1)
    c^2 + s^2 - 1 = 0
    -(a^2 + 4 * s^2 * v^2) * (c^2 + s^2 - 1) = 0
    (a^2 + 1 - 2 * a * c - 4 * s^2 * (u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c)) - ((2 * s * (u * a + v * c) - a * s)^2 + (2 * v * s^2 - (1 - a * c))^2) = 0
    a^2 + 1 - 2 * a * c - 4 * s^2 * (u * (1 - u) * a^2 + v * (1 - v) - 2 * u * v * a * c) = (2 * s * (u * a + v * c) - a * s)^2 + (2 * v * s^2 - (1 - a * c))^2
    a^2 + 1 - 2 * a * c - 4 * s^2 * tri_weight(a, c, s, u, v) = (2 * s * (u * a + v * c) - a * s)^2 + (2 * v * s^2 - (1 - a * c))^2
    (2 * s * (u * a + v * c) - a * s)^2 >= 0
    (2 * v * s^2 - (1 - a * c))^2 >= 0
    (2 * s * (u * a + v * c) - a * s)^2 + (2 * v * s^2 - (1 - a * c))^2 >= 0
    a^2 + 1 - 2 * a * c - 4 * s^2 * tri_weight(a, c, s, u, v) >= 0
    4 * s^2 * tri_weight(a, c, s, u, v) <= a^2 + 1 - 2 * a * c
    4 * s^2 * tri_weight(a, c, s, u, v) <= 4 * s^2
    4 * s^2 > 0
    4 * s^2 != 0
    (4 * s^2 * tri_weight(a, c, s, u, v)) / (4 * s^2) <= (4 * s^2) / (4 * s^2)
    (4 * s^2 * tri_weight(a, c, s, u, v)) / (4 * s^2) = tri_weight(a, c, s, u, v)
    (4 * s^2) / (4 * s^2) = 1
    tri_weight(a, c, s, u, v) <= 1

thm weighted_three_strict:
    ? forall w0, w1, w2, x0, x1, x2 R:
        w0 >= 0
        w1 >= 0
        w2 >= 0
        w0 + w1 + w2 = 1
        x0 > 1
        x1 > 1
        x2 > 1
        =>:
            w0 * x0 + w1 * x1 + w2 * x2 > 1
    w0 * x0 >= w0 * 1
    w1 * x1 >= w1 * 1
    w2 * x2 >= w2 * 1
    by cases:
        ? w0 * x0 + w1 * x1 + w2 * x2 > 1
        case w0 > 0:
            w0 * x0 > w0 * 1
            w0 * x0 + w1 * x1 + w2 * x2 > w0 * 1 + w1 * 1 + w2 * 1
            w0 * 1 + w1 * 1 + w2 * 1 = 1
            w0 * x0 + w1 * x1 + w2 * x2 > 1
        case w0 <= 0:
            w0 = 0
            by cases:
                ? w0 * x0 + w1 * x1 + w2 * x2 > 1
                case w1 > 0:
                    w1 * x1 > w1 * 1
                    w0 * x0 + w1 * x1 + w2 * x2 > w0 * 1 + w1 * 1 + w2 * 1
                    w0 * 1 + w1 * 1 + w2 * 1 = 1
                    w0 * x0 + w1 * x1 + w2 * x2 > 1
                case w1 <= 0:
                    w1 = 0
                    w0 + w1 = 0
                    (w0 + w1 + w2) - w2 = w0 + w1
                    (w0 + w1 + w2) - w2 = 0
                    w0 + w1 + w2 = w2
                    w2 = 1
                    w2 > 0
                    w2 * x2 > w2 * 1
                    w0 * x0 + w1 * x1 + w2 * x2 > w0 * 1 + w1 * 1 + w2 * 1
                    w0 * 1 + w1 * 1 + w2 * 1 = 1
                    w0 * x0 + w1 * x1 + w2 * x2 > 1

thm triangle_covered_by_three_unit_disks:
    ? forall a, c, s, u, v R:
        s > 0
        c^2 + s^2 = 1
        a^2 + 1 - 2 * a * c <= 4 * s^2
        u >= 0
        v >= 0
        u + v <= 1
        =>:
            dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
    release thm triangle_weight_identity(a, c, s, u, v)
    release thm triangle_weight_upper_bound(a, c, s, u, v)
    1 - (u + v) >= 0
    1 - (u + v) = 1 - u - v
    1 - u - v >= 0
    by cases:
        ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
        case dist_A(a, c, s, u, v) <= 1:
            dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
        case dist_A(a, c, s, u, v) > 1:
            by cases:
                ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                case dist_B(a, c, s, u, v) <= 1:
                    dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                case dist_B(a, c, s, u, v) > 1:
                    by cases:
                        ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                        case dist_D(a, c, s, u, v) <= 1:
                            dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                        case dist_D(a, c, s, u, v) > 1:
                            (1 - u - v) + u + v = 1
                            release thm weighted_three_strict(1 - u - v, u, v, dist_A(a, c, s, u, v), dist_B(a, c, s, u, v), dist_D(a, c, s, u, v))
                            tri_weight(a, c, s, u, v) > 1
                            impossible tri_weight(a, c, s, u, v) <= 1


have fn dist_C(a, c, s, u, v R) R = ((u - 1) * a + (v - 1) * c)^2 + ((v - 1) * s)^2

thm map_reflected_A_to_C:
    ? forall a, c, s, u, v R:
        dist_A(a, c, s, 1 - u, 1 - v) <= 1
        =>:
            dist_C(a, c, s, u, v) <= 1
    dist_C(a, c, s, u, v) = ((u - 1) * a + (v - 1) * c)^2 + ((v - 1) * s)^2
    dist_A(a, c, s, 1 - u, 1 - v) = ((1 - u) * a + (1 - v) * c)^2 + ((1 - v) * s)^2
    ((u - 1) * a + (v - 1) * c)^2 = ((1 - u) * a + (1 - v) * c)^2
    ((v - 1) * s)^2 = ((1 - v) * s)^2
    by contra:
        ? dist_C(a, c, s, u, v) <= 1
        dist_C(a, c, s, u, v) > 1
        dist_A(a, c, s, 1 - u, 1 - v) = ((u - 1) * a + (v - 1) * c)^2 + ((v - 1) * s)^2
        dist_C(a, c, s, u, v) = ((u - 1) * a + (v - 1) * c)^2 + ((v - 1) * s)^2
        dist_A(a, c, s, 1 - u, 1 - v) = dist_C(a, c, s, u, v)
        dist_A(a, c, s, 1 - u, 1 - v) > 1
        impossible dist_A(a, c, s, 1 - u, 1 - v) <= 1
    dist_C(a, c, s, u, v) <= 1

thm map_reflected_B_to_D:
    ? forall a, c, s, u, v R:
        dist_B(a, c, s, 1 - u, 1 - v) <= 1
        =>:
            dist_D(a, c, s, u, v) <= 1
    dist_D(a, c, s, u, v) = (u * a + (v - 1) * c)^2 + ((v - 1) * s)^2
    dist_B(a, c, s, 1 - u, 1 - v) = (((1 - u) - 1) * a + (1 - v) * c)^2 + ((1 - v) * s)^2
    (u * a + (v - 1) * c)^2 = (((1 - u) - 1) * a + (1 - v) * c)^2
    ((v - 1) * s)^2 = ((1 - v) * s)^2
    by contra:
        ? dist_D(a, c, s, u, v) <= 1
        dist_D(a, c, s, u, v) > 1
        dist_B(a, c, s, 1 - u, 1 - v) = (u * a + (v - 1) * c)^2 + ((v - 1) * s)^2
        dist_D(a, c, s, u, v) = (u * a + (v - 1) * c)^2 + ((v - 1) * s)^2
        dist_B(a, c, s, 1 - u, 1 - v) = dist_D(a, c, s, u, v)
        dist_B(a, c, s, 1 - u, 1 - v) > 1
        impossible dist_B(a, c, s, 1 - u, 1 - v) <= 1
    dist_D(a, c, s, u, v) <= 1

thm map_reflected_D_to_B:
    ? forall a, c, s, u, v R:
        dist_D(a, c, s, 1 - u, 1 - v) <= 1
        =>:
            dist_B(a, c, s, u, v) <= 1
    dist_B(a, c, s, u, v) = ((u - 1) * a + v * c)^2 + (v * s)^2
    dist_D(a, c, s, 1 - u, 1 - v) = ((1 - u) * a + ((1 - v) - 1) * c)^2 + (((1 - v) - 1) * s)^2
    ((u - 1) * a + v * c)^2 = ((1 - u) * a + ((1 - v) - 1) * c)^2
    (v * s)^2 = (((1 - v) - 1) * s)^2
    by contra:
        ? dist_B(a, c, s, u, v) <= 1
        dist_B(a, c, s, u, v) > 1
        dist_D(a, c, s, 1 - u, 1 - v) = ((u - 1) * a + v * c)^2 + (v * s)^2
        dist_B(a, c, s, u, v) = ((u - 1) * a + v * c)^2 + (v * s)^2
        dist_D(a, c, s, 1 - u, 1 - v) = dist_B(a, c, s, u, v)
        dist_D(a, c, s, 1 - u, 1 - v) > 1
        impossible dist_D(a, c, s, 1 - u, 1 - v) <= 1
    dist_B(a, c, s, u, v) <= 1

thm parallelogram_covered_by_four_unit_disks:
    ? forall a, c, s, u, v R:
        s > 0
        c^2 + s^2 = 1
        a^2 + 1 - 2 * a * c <= 4 * s^2
        u >= 0
        u <= 1
        v >= 0
        v <= 1
        =>:
            dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
    by cases:
        ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
        case u + v <= 1:
            release thm triangle_weight_identity(a, c, s, u, v)
            release thm triangle_weight_upper_bound(a, c, s, u, v)
            1 - (u + v) >= 0
            1 - (u + v) = 1 - u - v
            1 - u - v >= 0
            by cases:
                ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                case dist_A(a, c, s, u, v) <= 1:
                    dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                case dist_A(a, c, s, u, v) > 1:
                    by cases:
                        ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                        case dist_B(a, c, s, u, v) <= 1:
                            dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                        case dist_B(a, c, s, u, v) > 1:
                            by cases:
                                ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                                case dist_D(a, c, s, u, v) <= 1:
                                    dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                                case dist_D(a, c, s, u, v) > 1:
                                    (1 - u - v) + u + v = 1
                                    release thm weighted_three_strict(1 - u - v, u, v, dist_A(a, c, s, u, v), dist_B(a, c, s, u, v), dist_D(a, c, s, u, v))
                                    tri_weight(a, c, s, u, v) > 1
                                    impossible tri_weight(a, c, s, u, v) <= 1
        case u + v > 1:
            1 - u >= 0
            1 - v >= 0
            u + v - 1 > 0
            u + v - 1 >= 0
            1 - (u + v - 1) <= 1
            1 - (u + v - 1) = 1 - u + (1 - v)
            1 - u + (1 - v) <= 1
            release thm triangle_covered_by_three_unit_disks(a, c, s, 1 - u, 1 - v)
            by cases:
                ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                case dist_A(a, c, s, 1 - u, 1 - v) <= 1:
                    release thm map_reflected_A_to_C(a, c, s, u, v)
                    dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                case dist_A(a, c, s, 1 - u, 1 - v) > 1:
                    by cases:
                        ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                        case dist_B(a, c, s, 1 - u, 1 - v) <= 1:
                            release thm map_reflected_B_to_D(a, c, s, u, v)
                            dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                        case dist_B(a, c, s, 1 - u, 1 - v) > 1:
                            by cases:
                                ? dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                                case dist_D(a, c, s, 1 - u, 1 - v) <= 1:
                                    release thm map_reflected_D_to_B(a, c, s, u, v)
                                    dist_A(a, c, s, u, v) <= 1 or dist_B(a, c, s, u, v) <= 1 or dist_C(a, c, s, u, v) <= 1 or dist_D(a, c, s, u, v) <= 1
                                case dist_D(a, c, s, 1 - u, 1 - v) > 1:
                                    (1 - (1 - u) - (1 - v)) + (1 - u) + (1 - v) = 1
                                    release thm triangle_weight_identity(a, c, s, 1 - u, 1 - v)
                                    release thm triangle_weight_upper_bound(a, c, s, 1 - u, 1 - v)
                                    u + v - 1 > 0
                                    1 - (1 - u) - (1 - v) = u + v - 1
                                    1 - (1 - u) - (1 - v) > 0
                                    1 - (1 - u) - (1 - v) >= 0
                                    1 - u >= 0
                                    1 - v >= 0
                                    release thm weighted_three_strict(1 - (1 - u) - (1 - v), 1 - u, 1 - v, dist_A(a, c, s, 1 - u, 1 - v), dist_B(a, c, s, 1 - u, 1 - v), dist_D(a, c, s, 1 - u, 1 - v))
                                    tri_weight(a, c, s, 1 - u, 1 - v) > 1
                                    impossible tri_weight(a, c, s, 1 - u, 1 - v) <= 1

thm circumcenter_equations_give_outside_point:
    ? forall a, c, s, u, v R:
        s > 0
        c > 0
        a > c
        a * c < 1
        c^2 + s^2 = 1
        a > c + sqrt(3) * s
        2 * a * s^2 * u = a - c
        2 * s^2 * v = 1 - a * c
        =>:
            u >= 0
            u <= 1
            v >= 0
            v <= 1
            dist_A(a, c, s, u, v) > 1
            dist_B(a, c, s, u, v) > 1
            dist_C(a, c, s, u, v) > 1
            dist_D(a, c, s, u, v) > 1
    a > 0
    s^2 > 0
    2 * a * s^2 > 0
    2 * s^2 > 0
    a - c > 0
    1 - a * c > 0
    2 * a * s^2 * u > 0
    by contra:
        ? u > 0
