        s^2 * ((u * a + v * c)^2 + (v * s)^2) < s^2 * ((u * a + v * c)^2 + (v * s)^2) - 2 * (a + c) * s^2 * (u * a + v * c) + (a + c)^2 * s^2 - 2 * v * s^4 + s^4
