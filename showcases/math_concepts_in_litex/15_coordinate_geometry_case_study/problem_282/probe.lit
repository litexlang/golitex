thm same_nonnegative_square:
    ? forall x, y R:
        0 <= x
        0 <= y
        x^2 = y^2
        =>:
            x = y
    x^2 - y^2 = 0
    by thm geo::difference_of_squares(x, y)
    (x + y) * (x - y) = 0
    x = y or not x = y
    by cases:
        ? x = y
        case x = y:
            x = y
        case not x = y:
            x - y != 0
            (x - y) * (x + y) = 0
            by thm geo::zero_factor_law(x - y, x + y)
            x + y = 0
            x <= x + y = 0
            x = 0
            y <= x + y = 0
            y = 0
            x = y

thm affine_scalar_core:
    ? forall ux, uy, vx, vy, q R:
        ux * vx + uy * vy = 0
        ux^2 + uy^2 = vx^2 + vy^2
        =>:
            (q * ux - vx)^2 + (q * uy - vy)^2 = (-ux - q * vx)^2 + (-uy - q * vy)^2
            (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = 0
    (q * ux - vx)^2 + (q * uy - vy)^2 = q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2)
    (-ux - q * vx)^2 + (-uy - q * vy)^2 = (ux^2 + uy^2) + 2 * q * (ux * vx + uy * vy) + q^2 * (vx^2 + vy^2)
    (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = -q * (ux^2 + uy^2) + (1 - q^2) * (ux * vx + uy * vy) + q * (vx^2 + vy^2)
    q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2) = q^2 * (ux^2 + uy^2) + (vx^2 + vy^2)
    (ux^2 + uy^2) + 2 * q * (ux * vx + uy * vy) + q^2 * (vx^2 + vy^2) = (ux^2 + uy^2) + q^2 * (vx^2 + vy^2)
    -q * (ux^2 + uy^2) + (1 - q^2) * (ux * vx + uy * vy) + q * (vx^2 + vy^2) = -q * (ux^2 + uy^2) + q * (vx^2 + vy^2)
    by thm geo::multiply_both_sides(ux^2 + uy^2, vx^2 + vy^2, q^2)
    q^2 * (ux^2 + uy^2) = q^2 * (vx^2 + vy^2)
    by thm geo::add_equalities(q^2 * (ux^2 + uy^2), q^2 * (vx^2 + vy^2), vx^2 + vy^2, vx^2 + vy^2)
    q^2 * (ux^2 + uy^2) + (vx^2 + vy^2) = q^2 * (vx^2 + vy^2) + (vx^2 + vy^2)
    by thm geo::multiply_both_sides(ux * vx + uy * vy, 0, 2 * q)
    2 * q * (ux * vx + uy * vy) = 2 * q * 0
    2 * q * 0 = 0
    2 * q * (ux * vx + uy * vy) = 0
    by thm geo::subtract_equalities(q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2), q^2 * (ux^2 + uy^2) + (vx^2 + vy^2), 0, 0)
    q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2) - 0 = q^2 * (ux^2 + uy^2) + (vx^2 + vy^2) - 0
    q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2) = q^2 * (ux^2 + uy^2) + (vx^2 + vy^2)
    by thm geo::add_equalities(ux^2 + uy^2, vx^2 + vy^2, q^2 * (vx^2 + vy^2), q^2 * (vx^2 + vy^2))
    (ux^2 + uy^2) + q^2 * (vx^2 + vy^2) = (vx^2 + vy^2) + q^2 * (vx^2 + vy^2)
    by thm geo::multiply_both_sides(ux^2 + uy^2, vx^2 + vy^2, q)
    q * (ux^2 + uy^2) = q * (vx^2 + vy^2)
    by thm geo::subtract_equalities(-q * (ux^2 + uy^2) + q * (vx^2 + vy^2), -q * (ux^2 + uy^2) + q * (vx^2 + vy^2), (1 - q^2) * (ux * vx + uy * vy), 0)
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) = -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) + (1 - q^2) * (ux * vx + uy * vy) - (1 - q^2) * (ux * vx + uy * vy)
    (1 - q^2) * (ux * vx + uy * vy) = (1 - q^2) * 0
    (1 - q^2) * 0 = 0
    (1 - q^2) * (ux * vx + uy * vy) = 0
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) + (1 - q^2) * (ux * vx + uy * vy) = -q * (ux^2 + uy^2) + q * (vx^2 + vy^2)
    q^2 * (vx^2 + vy^2) + (vx^2 + vy^2) = (vx^2 + vy^2) + q^2 * (vx^2 + vy^2)
    (vx^2 + vy^2) + q^2 * (vx^2 + vy^2) = (ux^2 + uy^2) + q^2 * (vx^2 + vy^2)
    q^2 * (ux^2 + uy^2) + (vx^2 + vy^2) = (ux^2 + uy^2) + q^2 * (vx^2 + vy^2)
    (q * ux - vx)^2 + (q * uy - vy)^2 = (-ux - q * vx)^2 + (-uy - q * vy)^2
    q * (vx^2 + vy^2) = q * (ux^2 + uy^2)
    by thm geo::subtract_equalities(q * (vx^2 + vy^2), q * (ux^2 + uy^2), q * (ux^2 + uy^2), q * (ux^2 + uy^2))
    q * (vx^2 + vy^2) - q * (ux^2 + uy^2) = q * (ux^2 + uy^2) - q * (ux^2 + uy^2)
    q * (ux^2 + uy^2) - q * (ux^2 + uy^2) = 0
    q * (vx^2 + vy^2) - q * (ux^2 + uy^2) = 0
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) = q * (vx^2 + vy^2) - q * (ux^2 + uy^2)
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) = 0
    (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = 0


thm affine_right_core:
    ? forall pa, pb, pc, pd, pe, pf cart(R, R), t R:
        pd[1] = (pb[1] + pc[1]) / 2
        pd[2] = (pb[2] + pc[2]) / 2
        pe[1] = pa[1] + t * (pb[1] - pa[1])
        pe[2] = pa[2] + t * (pb[2] - pa[2])
        pf[1] = pa[1] + (1 - t) * (pc[1] - pa[1])
        pf[2] = pa[2] + (1 - t) * (pc[2] - pa[2])
        (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2]) = 0
        (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2
        =>:
            geo::distance_sq(pd, pe) = geo::distance_sq(pd, pf)
            geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = 0

    have ux R = pb[1] - pa[1]
    have uy R = pb[2] - pa[2]
    have vx R = pc[1] - pa[1]
    have vy R = pc[2] - pa[2]
    have q R = 2 * t - 1

    ux * vx + uy * vy = (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2]) = 0
    ux^2 + uy^2 = (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2 = vx^2 + vy^2
    by thm affine_scalar_core(ux, uy, vx, vy, q)
    (q * ux - vx)^2 + (q * uy - vy)^2 = (-ux - q * vx)^2 + (-uy - q * vy)^2
    (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = 0

    pe[1] - pd[1] = pa[1] + t * (pb[1] - pa[1]) - pd[1]
    pa[1] + t * (pb[1] - pa[1]) - pd[1] = pa[1] + t * (pb[1] - pa[1]) - (pb[1] + pc[1]) / 2
    pa[1] + t * (pb[1] - pa[1]) - (pb[1] + pc[1]) / 2 = ((2 * t - 1) * (pb[1] - pa[1]) - (pc[1] - pa[1])) / 2
    ((2 * t - 1) * (pb[1] - pa[1]) - (pc[1] - pa[1])) / 2 = (q * ux - vx) / 2
    pe[1] - pd[1] = (q * ux - vx) / 2

    pe[2] - pd[2] = pa[2] + t * (pb[2] - pa[2]) - pd[2]
    pa[2] + t * (pb[2] - pa[2]) - pd[2] = pa[2] + t * (pb[2] - pa[2]) - (pb[2] + pc[2]) / 2
    pa[2] + t * (pb[2] - pa[2]) - (pb[2] + pc[2]) / 2 = ((2 * t - 1) * (pb[2] - pa[2]) - (pc[2] - pa[2])) / 2
    ((2 * t - 1) * (pb[2] - pa[2]) - (pc[2] - pa[2])) / 2 = (q * uy - vy) / 2
    pe[2] - pd[2] = (q * uy - vy) / 2

    pf[1] - pd[1] = pa[1] + (1 - t) * (pc[1] - pa[1]) - pd[1]
    pa[1] + (1 - t) * (pc[1] - pa[1]) - pd[1] = pa[1] + (1 - t) * (pc[1] - pa[1]) - (pb[1] + pc[1]) / 2
    pa[1] + (1 - t) * (pc[1] - pa[1]) - (pb[1] + pc[1]) / 2 = (-(pb[1] - pa[1]) - (2 * t - 1) * (pc[1] - pa[1])) / 2
    (-(pb[1] - pa[1]) - (2 * t - 1) * (pc[1] - pa[1])) / 2 = (-ux - q * vx) / 2
    pf[1] - pd[1] = (-ux - q * vx) / 2

    pf[2] - pd[2] = pa[2] + (1 - t) * (pc[2] - pa[2]) - pd[2]
    pa[2] + (1 - t) * (pc[2] - pa[2]) - pd[2] = pa[2] + (1 - t) * (pc[2] - pa[2]) - (pb[2] + pc[2]) / 2
    pa[2] + (1 - t) * (pc[2] - pa[2]) - (pb[2] + pc[2]) / 2 = (-(pb[2] - pa[2]) - (2 * t - 1) * (pc[2] - pa[2])) / 2
    (-(pb[2] - pa[2]) - (2 * t - 1) * (pc[2] - pa[2])) / 2 = (-uy - q * vy) / 2
    pf[2] - pd[2] = (-uy - q * vy) / 2

    by thm geo::distance_sq_coordinate_formula(pd, pe)
    by thm geo::distance_sq_coordinate_formula(pd, pf)
    by thm geo::perpendicular_dot_expand(pd, pe, pd, pf)
    geo::distance_sq(pd, pe) = (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2
    geo::distance_sq(pd, pf) = (pf[1] - pd[1])^2 + (pf[2] - pd[2])^2
    geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = (pe[1] - pd[1]) * (pf[1] - pd[1]) + (pe[2] - pd[2]) * (pf[2] - pd[2])

    (pe[1] - pd[1])^2 = ((q * ux - vx) / 2)^2
    ((q * ux - vx) / 2)^2 = (q * ux - vx)^2 / 4
    (pe[1] - pd[1])^2 = (q * ux - vx)^2 / 4
    (pe[2] - pd[2])^2 = ((q * uy - vy) / 2)^2
    ((q * uy - vy) / 2)^2 = (q * uy - vy)^2 / 4
    (pe[2] - pd[2])^2 = (q * uy - vy)^2 / 4
    (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2 = (q * ux - vx)^2 / 4 + (q * uy - vy)^2 / 4
    (q * ux - vx)^2 / 4 + (q * uy - vy)^2 / 4 = ((q * ux - vx)^2 + (q * uy - vy)^2) / 4
    (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2 = ((q * ux - vx)^2 + (q * uy - vy)^2) / 4

    (pf[1] - pd[1])^2 = ((-ux - q * vx) / 2)^2
    ((-ux - q * vx) / 2)^2 = (-ux - q * vx)^2 / 4
    (pf[1] - pd[1])^2 = (-ux - q * vx)^2 / 4
    (pf[2] - pd[2])^2 = ((-uy - q * vy) / 2)^2
    ((-uy - q * vy) / 2)^2 = (-uy - q * vy)^2 / 4
    (pf[2] - pd[2])^2 = (-uy - q * vy)^2 / 4
    (pf[1] - pd[1])^2 + (pf[2] - pd[2])^2 = (-ux - q * vx)^2 / 4 + (-uy - q * vy)^2 / 4
    (-ux - q * vx)^2 / 4 + (-uy - q * vy)^2 / 4 = ((-ux - q * vx)^2 + (-uy - q * vy)^2) / 4
    (pf[1] - pd[1])^2 + (pf[2] - pd[2])^2 = ((-ux - q * vx)^2 + (-uy - q * vy)^2) / 4

    ((q * ux - vx)^2 + (q * uy - vy)^2) / 4 = ((-ux - q * vx)^2 + (-uy - q * vy)^2) / 4
    geo::distance_sq(pd, pe) = geo::distance_sq(pd, pf)

    (pe[1] - pd[1]) * (pf[1] - pd[1]) = ((q * ux - vx) / 2) * ((-ux - q * vx) / 2)
    ((q * ux - vx) / 2) * ((-ux - q * vx) / 2) = ((q * ux - vx) * (-ux - q * vx)) / 4
    (pe[1] - pd[1]) * (pf[1] - pd[1]) = ((q * ux - vx) * (-ux - q * vx)) / 4
    (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * uy - vy) / 2) * ((-uy - q * vy) / 2)
    ((q * uy - vy) / 2) * ((-uy - q * vy) / 2) = ((q * uy - vy) * (-uy - q * vy)) / 4
    (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * uy - vy) * (-uy - q * vy)) / 4
    (pe[1] - pd[1]) * (pf[1] - pd[1]) + (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * ux - vx) * (-ux - q * vx)) / 4 + ((q * uy - vy) * (-uy - q * vy)) / 4
    ((q * ux - vx) * (-ux - q * vx)) / 4 + ((q * uy - vy) * (-uy - q * vy)) / 4 = ((q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy)) / 4
    (pe[1] - pd[1]) * (pf[1] - pd[1]) + (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy)) / 4
    ((q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy)) / 4 = 0
    geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = 0
