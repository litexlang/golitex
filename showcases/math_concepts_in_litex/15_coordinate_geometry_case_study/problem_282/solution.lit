thm same_nonnegative_square:
    ? forall x, y R:
        0 <= x,
        0 <= y,
        x^2 = y^2
        =>:
            x = y
    x^2 - y^2 = 0
    by thm geo::difference_of_squares(x, y)
    (x + y) * (x - y) = 0
    x = y or not x = y
    by cases:
        ? x = y
        case x = y:
            x = y
        case not x = y:
            x - y != 0
            (x - y) * (x + y) = 0
            by thm geo::zero_factor_law(x - y, x + y)
            x + y = 0
            x <= x + y = 0
            x = 0
            y <= x + y = 0
            y = 0
            x = y

thm affine_scalar_core:
    ? forall ux, uy, vx, vy, q R:
        ux * vx + uy * vy = 0,
        ux^2 + uy^2 = vx^2 + vy^2
        =>:
            (q * ux - vx)^2 + (q * uy - vy)^2 = (-ux - q * vx)^2 + (-uy - q * vy)^2,
            (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = 0
    (q * ux - vx)^2 + (q * uy - vy)^2 = q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2)
    (-ux - q * vx)^2 + (-uy - q * vy)^2 = (ux^2 + uy^2) + 2 * q * (ux * vx + uy * vy) + q^2 * (vx^2 + vy^2)
    (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = -q * (ux^2 + uy^2) + (1 - q^2) * (ux * vx + uy * vy) + q * (vx^2 + vy^2)
    q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2) = q^2 * (ux^2 + uy^2) + (vx^2 + vy^2)
    (ux^2 + uy^2) + 2 * q * (ux * vx + uy * vy) + q^2 * (vx^2 + vy^2) = (ux^2 + uy^2) + q^2 * (vx^2 + vy^2)
    -q * (ux^2 + uy^2) + (1 - q^2) * (ux * vx + uy * vy) + q * (vx^2 + vy^2) = -q * (ux^2 + uy^2) + q * (vx^2 + vy^2)
    by thm geo::multiply_both_sides(ux^2 + uy^2, vx^2 + vy^2, q^2)
    q^2 * (ux^2 + uy^2) = q^2 * (vx^2 + vy^2)
    by thm geo::add_equalities(q^2 * (ux^2 + uy^2), q^2 * (vx^2 + vy^2), vx^2 + vy^2, vx^2 + vy^2)
    q^2 * (ux^2 + uy^2) + (vx^2 + vy^2) = q^2 * (vx^2 + vy^2) + (vx^2 + vy^2)
    by thm geo::multiply_both_sides(ux * vx + uy * vy, 0, 2 * q)
    2 * q * (ux * vx + uy * vy) = 2 * q * 0
    2 * q * 0 = 0
    2 * q * (ux * vx + uy * vy) = 0
    by thm geo::subtract_equalities(q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2), q^2 * (ux^2 + uy^2) + (vx^2 + vy^2), 0, 0)
    q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2) - 0 = q^2 * (ux^2 + uy^2) + (vx^2 + vy^2) - 0
    q^2 * (ux^2 + uy^2) - 2 * q * (ux * vx + uy * vy) + (vx^2 + vy^2) = q^2 * (ux^2 + uy^2) + (vx^2 + vy^2)
    by thm geo::add_equalities(ux^2 + uy^2, vx^2 + vy^2, q^2 * (vx^2 + vy^2), q^2 * (vx^2 + vy^2))
    (ux^2 + uy^2) + q^2 * (vx^2 + vy^2) = (vx^2 + vy^2) + q^2 * (vx^2 + vy^2)
    by thm geo::multiply_both_sides(ux^2 + uy^2, vx^2 + vy^2, q)
    q * (ux^2 + uy^2) = q * (vx^2 + vy^2)
    by thm geo::subtract_equalities(-q * (ux^2 + uy^2) + q * (vx^2 + vy^2), -q * (ux^2 + uy^2) + q * (vx^2 + vy^2), (1 - q^2) * (ux * vx + uy * vy), 0)
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) = -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) + (1 - q^2) * (ux * vx + uy * vy) - (1 - q^2) * (ux * vx + uy * vy)
    (1 - q^2) * (ux * vx + uy * vy) = (1 - q^2) * 0
    (1 - q^2) * 0 = 0
    (1 - q^2) * (ux * vx + uy * vy) = 0
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) + (1 - q^2) * (ux * vx + uy * vy) = -q * (ux^2 + uy^2) + q * (vx^2 + vy^2)
    q^2 * (vx^2 + vy^2) + (vx^2 + vy^2) = (vx^2 + vy^2) + q^2 * (vx^2 + vy^2)
    (vx^2 + vy^2) + q^2 * (vx^2 + vy^2) = (ux^2 + uy^2) + q^2 * (vx^2 + vy^2)
    q^2 * (ux^2 + uy^2) + (vx^2 + vy^2) = (ux^2 + uy^2) + q^2 * (vx^2 + vy^2)
    (q * ux - vx)^2 + (q * uy - vy)^2 = (-ux - q * vx)^2 + (-uy - q * vy)^2
    q * (vx^2 + vy^2) = q * (ux^2 + uy^2)
    by thm geo::subtract_equalities(q * (vx^2 + vy^2), q * (ux^2 + uy^2), q * (ux^2 + uy^2), q * (ux^2 + uy^2))
    q * (vx^2 + vy^2) - q * (ux^2 + uy^2) = q * (ux^2 + uy^2) - q * (ux^2 + uy^2)
    q * (ux^2 + uy^2) - q * (ux^2 + uy^2) = 0
    q * (vx^2 + vy^2) - q * (ux^2 + uy^2) = 0
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) = q * (vx^2 + vy^2) - q * (ux^2 + uy^2)
    -q * (ux^2 + uy^2) + q * (vx^2 + vy^2) = 0
    (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = 0


thm affine_right_core:
    ? forall pa, pb, pc, pd, pe, pf cart(R, R), t R:
        pd[1] = (pb[1] + pc[1]) / 2,
        pd[2] = (pb[2] + pc[2]) / 2,
        pe[1] = pa[1] + t * (pb[1] - pa[1]),
        pe[2] = pa[2] + t * (pb[2] - pa[2]),
        pf[1] = pa[1] + (1 - t) * (pc[1] - pa[1]),
        pf[2] = pa[2] + (1 - t) * (pc[2] - pa[2]),
        (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2]) = 0,
        (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2
        =>:
            geo::distance_sq(pd, pe) = geo::distance_sq(pd, pf),
            geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = 0

    have ux R = pb[1] - pa[1]
    have uy R = pb[2] - pa[2]
    have vx R = pc[1] - pa[1]
    have vy R = pc[2] - pa[2]
    have q R = 2 * t - 1

    ux * vx + uy * vy = (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2]) = 0
    ux^2 + uy^2 = (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2 = vx^2 + vy^2
    by thm affine_scalar_core(ux, uy, vx, vy, q)
    (q * ux - vx)^2 + (q * uy - vy)^2 = (-ux - q * vx)^2 + (-uy - q * vy)^2
    (q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy) = 0

    pe[1] - pd[1] = pa[1] + t * (pb[1] - pa[1]) - pd[1]
    pa[1] + t * (pb[1] - pa[1]) - pd[1] = pa[1] + t * (pb[1] - pa[1]) - (pb[1] + pc[1]) / 2
    pa[1] + t * (pb[1] - pa[1]) - (pb[1] + pc[1]) / 2 = ((2 * t - 1) * (pb[1] - pa[1]) - (pc[1] - pa[1])) / 2
    ((2 * t - 1) * (pb[1] - pa[1]) - (pc[1] - pa[1])) / 2 = (q * ux - vx) / 2
    pe[1] - pd[1] = (q * ux - vx) / 2

    pe[2] - pd[2] = pa[2] + t * (pb[2] - pa[2]) - pd[2]
    pa[2] + t * (pb[2] - pa[2]) - pd[2] = pa[2] + t * (pb[2] - pa[2]) - (pb[2] + pc[2]) / 2
    pa[2] + t * (pb[2] - pa[2]) - (pb[2] + pc[2]) / 2 = ((2 * t - 1) * (pb[2] - pa[2]) - (pc[2] - pa[2])) / 2
    ((2 * t - 1) * (pb[2] - pa[2]) - (pc[2] - pa[2])) / 2 = (q * uy - vy) / 2
    pe[2] - pd[2] = (q * uy - vy) / 2

    pf[1] - pd[1] = pa[1] + (1 - t) * (pc[1] - pa[1]) - pd[1]
    pa[1] + (1 - t) * (pc[1] - pa[1]) - pd[1] = pa[1] + (1 - t) * (pc[1] - pa[1]) - (pb[1] + pc[1]) / 2
    pa[1] + (1 - t) * (pc[1] - pa[1]) - (pb[1] + pc[1]) / 2 = (-(pb[1] - pa[1]) - (2 * t - 1) * (pc[1] - pa[1])) / 2
    (-(pb[1] - pa[1]) - (2 * t - 1) * (pc[1] - pa[1])) / 2 = (-ux - q * vx) / 2
    pf[1] - pd[1] = (-ux - q * vx) / 2

    pf[2] - pd[2] = pa[2] + (1 - t) * (pc[2] - pa[2]) - pd[2]
    pa[2] + (1 - t) * (pc[2] - pa[2]) - pd[2] = pa[2] + (1 - t) * (pc[2] - pa[2]) - (pb[2] + pc[2]) / 2
    pa[2] + (1 - t) * (pc[2] - pa[2]) - (pb[2] + pc[2]) / 2 = (-(pb[2] - pa[2]) - (2 * t - 1) * (pc[2] - pa[2])) / 2
    (-(pb[2] - pa[2]) - (2 * t - 1) * (pc[2] - pa[2])) / 2 = (-uy - q * vy) / 2
    pf[2] - pd[2] = (-uy - q * vy) / 2

    by thm geo::distance_sq_coordinate_formula(pd, pe)
    by thm geo::distance_sq_coordinate_formula(pd, pf)
    by thm geo::perpendicular_dot_expand(pd, pe, pd, pf)
    geo::distance_sq(pd, pe) = (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2
    geo::distance_sq(pd, pf) = (pf[1] - pd[1])^2 + (pf[2] - pd[2])^2
    geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = (pe[1] - pd[1]) * (pf[1] - pd[1]) + (pe[2] - pd[2]) * (pf[2] - pd[2])

    (pe[1] - pd[1])^2 = ((q * ux - vx) / 2)^2
    ((q * ux - vx) / 2)^2 = (q * ux - vx)^2 / 4
    (pe[1] - pd[1])^2 = (q * ux - vx)^2 / 4
    (pe[2] - pd[2])^2 = ((q * uy - vy) / 2)^2
    ((q * uy - vy) / 2)^2 = (q * uy - vy)^2 / 4
    (pe[2] - pd[2])^2 = (q * uy - vy)^2 / 4
    (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2 = (q * ux - vx)^2 / 4 + (q * uy - vy)^2 / 4
    (q * ux - vx)^2 / 4 + (q * uy - vy)^2 / 4 = ((q * ux - vx)^2 + (q * uy - vy)^2) / 4
    (pe[1] - pd[1])^2 + (pe[2] - pd[2])^2 = ((q * ux - vx)^2 + (q * uy - vy)^2) / 4

    (pf[1] - pd[1])^2 = ((-ux - q * vx) / 2)^2
    ((-ux - q * vx) / 2)^2 = (-ux - q * vx)^2 / 4
    (pf[1] - pd[1])^2 = (-ux - q * vx)^2 / 4
    (pf[2] - pd[2])^2 = ((-uy - q * vy) / 2)^2
    ((-uy - q * vy) / 2)^2 = (-uy - q * vy)^2 / 4
    (pf[2] - pd[2])^2 = (-uy - q * vy)^2 / 4
    (pf[1] - pd[1])^2 + (pf[2] - pd[2])^2 = (-ux - q * vx)^2 / 4 + (-uy - q * vy)^2 / 4
    (-ux - q * vx)^2 / 4 + (-uy - q * vy)^2 / 4 = ((-ux - q * vx)^2 + (-uy - q * vy)^2) / 4
    (pf[1] - pd[1])^2 + (pf[2] - pd[2])^2 = ((-ux - q * vx)^2 + (-uy - q * vy)^2) / 4

    ((q * ux - vx)^2 + (q * uy - vy)^2) / 4 = ((-ux - q * vx)^2 + (-uy - q * vy)^2) / 4
    geo::distance_sq(pd, pe) = geo::distance_sq(pd, pf)

    (pe[1] - pd[1]) * (pf[1] - pd[1]) = ((q * ux - vx) / 2) * ((-ux - q * vx) / 2)
    ((q * ux - vx) / 2) * ((-ux - q * vx) / 2) = ((q * ux - vx) * (-ux - q * vx)) / 4
    (pe[1] - pd[1]) * (pf[1] - pd[1]) = ((q * ux - vx) * (-ux - q * vx)) / 4
    (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * uy - vy) / 2) * ((-uy - q * vy) / 2)
    ((q * uy - vy) / 2) * ((-uy - q * vy) / 2) = ((q * uy - vy) * (-uy - q * vy)) / 4
    (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * uy - vy) * (-uy - q * vy)) / 4
    (pe[1] - pd[1]) * (pf[1] - pd[1]) + (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * ux - vx) * (-ux - q * vx)) / 4 + ((q * uy - vy) * (-uy - q * vy)) / 4
    ((q * ux - vx) * (-ux - q * vx)) / 4 + ((q * uy - vy) * (-uy - q * vy)) / 4 = ((q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy)) / 4
    (pe[1] - pd[1]) * (pf[1] - pd[1]) + (pe[2] - pd[2]) * (pf[2] - pd[2]) = ((q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy)) / 4
    ((q * ux - vx) * (-ux - q * vx) + (q * uy - vy) * (-uy - q * vy)) / 4 = 0
    geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = 0


# (1) E and F lie on the two segments, and BE=AF.
thm problem_282_part1:
    ? forall pa, pb, pc, pd, pe, pf cart(R, R):
        # △ABC has the stated right angle.
        $geo::is_right_angle(pb, pa, pc),
        # △ABC has the stated equal legs.
        $geo::are_segments_congruent(pa, pb, pa, pc),
        # D is the midpoint of BC.
        $geo::is_midpoint(pd, pb, pc),
        # E and F are respectively on AB and AC.
        $geo::is_on_segment(pe, pa, pb),
        $geo::is_on_segment(pf, pa, pc),
        # The condition BE=AF.
        $geo::are_segments_congruent(pb, pe, pa, pf)
        =>:
            # The conclusion: DEF is isosceles right.
            $geo::are_segments_congruent(pd, pe, pd, pf),
            $geo::is_right_angle(pe, pd, pf)

    by def $geo::is_right_angle(pb, pa, pc)
    by def $geo::are_segments_congruent(pa, pb, pa, pc)
    by def $geo::is_midpoint(pd, pb, pc)
    by def $geo::is_on_segment(pe, pa, pb)
    by def $geo::is_on_segment(pf, pa, pc)
    by def $geo::are_segments_congruent(pb, pe, pa, pf)

    obtain t from exist t0 R st {0 <= t0, t0 <= 1, pe = (pa[1] + t0 * (pb[1] - pa[1]), pa[2] + t0 * (pb[2] - pa[2]))}
    obtain s from exist s0 R st {0 <= s0, s0 <= 1, pf = (pa[1] + s0 * (pc[1] - pa[1]), pa[2] + s0 * (pc[2] - pa[2]))}

    pb[1] - pe[1] = (1 - t) * (pb[1] - pa[1])
    pb[2] - pe[2] = (1 - t) * (pb[2] - pa[2])
    pf[1] - pa[1] = s * (pc[1] - pa[1])
    pf[2] - pa[2] = s * (pc[2] - pa[2])
    by thm geo::distance_sq_coordinate_formula(pb, pe)
    by thm geo::distance_sq_coordinate_formula(pa, pf)
    geo::distance_sq(pb, pe) = (pb[1] - pe[1])^2 + (pb[2] - pe[2])^2
    geo::distance_sq(pa, pf) = (pf[1] - pa[1])^2 + (pf[2] - pa[2])^2
    (pb[1] - pe[1])^2 = ((1 - t) * (pb[1] - pa[1]))^2
    ((1 - t) * (pb[1] - pa[1]))^2 = (1 - t)^2 * (pb[1] - pa[1])^2
    (pb[1] - pe[1])^2 = (1 - t)^2 * (pb[1] - pa[1])^2
    (pb[2] - pe[2])^2 = ((1 - t) * (pb[2] - pa[2]))^2
    ((1 - t) * (pb[2] - pa[2]))^2 = (1 - t)^2 * (pb[2] - pa[2])^2
    (pb[2] - pe[2])^2 = (1 - t)^2 * (pb[2] - pa[2])^2
    (pb[1] - pe[1])^2 + (pb[2] - pe[2])^2 = (1 - t)^2 * (pb[1] - pa[1])^2 + (pb[2] - pe[2])^2
    (1 - t)^2 * (pb[1] - pa[1])^2 + (pb[2] - pe[2])^2 = (1 - t)^2 * (pb[1] - pa[1])^2 + (1 - t)^2 * (pb[2] - pa[2])^2
    (pb[1] - pe[1])^2 + (pb[2] - pe[2])^2 = (1 - t)^2 * (pb[1] - pa[1])^2 + (1 - t)^2 * (pb[2] - pa[2])^2
    geo::distance_sq(pb, pe) = (1 - t)^2 * (pb[1] - pa[1])^2 + (1 - t)^2 * (pb[2] - pa[2])^2
    (1 - t)^2 * (pb[1] - pa[1])^2 + (1 - t)^2 * (pb[2] - pa[2])^2 = (1 - t)^2 * ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2)
    geo::distance_sq(pb, pe) = (1 - t)^2 * ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2)

    (pf[1] - pa[1])^2 = (s * (pc[1] - pa[1]))^2
    (s * (pc[1] - pa[1]))^2 = s^2 * (pc[1] - pa[1])^2
    (pf[1] - pa[1])^2 = s^2 * (pc[1] - pa[1])^2
    (pf[2] - pa[2])^2 = (s * (pc[2] - pa[2]))^2
    (s * (pc[2] - pa[2]))^2 = s^2 * (pc[2] - pa[2])^2
    (pf[2] - pa[2])^2 = s^2 * (pc[2] - pa[2])^2
    (pf[1] - pa[1])^2 + (pf[2] - pa[2])^2 = s^2 * (pc[1] - pa[1])^2 + (pf[2] - pa[2])^2
    s^2 * (pc[1] - pa[1])^2 + (pf[2] - pa[2])^2 = s^2 * (pc[1] - pa[1])^2 + s^2 * (pc[2] - pa[2])^2
    (pf[1] - pa[1])^2 + (pf[2] - pa[2])^2 = s^2 * (pc[1] - pa[1])^2 + s^2 * (pc[2] - pa[2])^2
    geo::distance_sq(pa, pf) = s^2 * (pc[1] - pa[1])^2 + s^2 * (pc[2] - pa[2])^2
    s^2 * (pc[1] - pa[1])^2 + s^2 * (pc[2] - pa[2])^2 = s^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2)
    geo::distance_sq(pa, pf) = s^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2)

    by thm geo::distance_sq_coordinate_formula(pa, pb)
    by thm geo::distance_sq_coordinate_formula(pa, pc)
    geo::distance_sq(pa, pb) = (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2
    geo::distance_sq(pa, pc) = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2
    (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2
    by thm geo::multiply_both_sides((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2, (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2, s^2)
    s^2 * ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2) = ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2) * s^2 = ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2) * s^2 = s^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2)
    geo::distance_sq(pa, pf) = s^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2) = s^2 * ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2)
    (1 - t)^2 * ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2) = s^2 * ((pb[1] - pa[1])^2 + (pb[2] - pa[2])^2)

    by thm geo::distance_sq_positive_of_ne(pa, pb)
    0 < geo::distance_sq(pa, pb)
    0 < (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2
    by thm geo::cancel_positive_right_factor((1 - t)^2, s^2, (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2)
    (1 - t)^2 = s^2
    0 <= 1 - t
    by thm same_nonnegative_square(1 - t, s)
    1 - t = s

    pf[1] = pa[1] + (1 - t) * (pc[1] - pa[1])
    pf[2] = pa[2] + (1 - t) * (pc[2] - pa[2])
    by thm geo::perpendicular_dot_expand(pa, pb, pa, pc)
    geo::dot(geo::vec(pa, pb), geo::vec(pa, pc)) = (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2])
    (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2]) = 0

    by thm affine_right_core(pa, pb, pc, pd, pe, pf, t)
    geo::distance_sq(pd, pe) = geo::distance_sq(pd, pf)
    geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = 0


# (2) E lies on the extension of AB beyond B, and F lies on the extension of CA beyond A.
thm problem_282_part2:
    ? forall pa, pb, pc, pd, pe, pf cart(R, R):
        # △ABC has the stated right angle.
        $geo::is_right_angle(pb, pa, pc),
        # △ABC has the stated equal legs.
        $geo::are_segments_congruent(pa, pb, pa, pc),
        # D is the midpoint of BC.
        $geo::is_midpoint(pd, pb, pc),
        # E lies on the extension of AB beyond B.
        $geo::is_on_extension(pe, pa, pb),
        # F lies on the extension of CA beyond A.
        $geo::is_on_extension(pf, pc, pa),
        # The condition BE=AF.
        $geo::are_segments_congruent(pb, pe, pa, pf)
        =>:
            # The conclusion: DEF is isosceles right.
            $geo::are_segments_congruent(pd, pe, pd, pf),
            $geo::is_right_angle(pe, pd, pf)

    by def $geo::is_right_angle(pb, pa, pc)
    by def $geo::are_segments_congruent(pa, pb, pa, pc)
    by def $geo::is_midpoint(pd, pb, pc)
    by def $geo::is_on_extension(pe, pa, pb)
    by def $geo::is_on_extension(pf, pc, pa)
    by def $geo::are_segments_congruent(pb, pe, pa, pf)

    obtain t from exist t0 R st {t0 > 1, pe = (pa[1] + t0 * (pb[1] - pa[1]), pa[2] + t0 * (pb[2] - pa[2]))}
    obtain r from exist r0 R st {r0 > 1, pf = (pc[1] + r0 * (pa[1] - pc[1]), pc[2] + r0 * (pa[2] - pc[2]))}

    by thm geo::affine_distance_from_parameter(pa, pb, pe, t)
    geo::distance_sq(pe, pb) = (1 - t)^2 * geo::distance_sq(pa, pb)
    by thm geo::distance_sq_symmetric(pe, pb)
    geo::distance_sq(pb, pe) = (1 - t)^2 * geo::distance_sq(pa, pb)

    pf[1] - pa[1] = (1 - r) * (pc[1] - pa[1])
    pf[2] - pa[2] = (1 - r) * (pc[2] - pa[2])
    by thm geo::distance_sq_coordinate_formula(pa, pf)
    geo::distance_sq(pa, pf) = (pf[1] - pa[1])^2 + (pf[2] - pa[2])^2
    (pf[1] - pa[1])^2 = ((1 - r) * (pc[1] - pa[1]))^2
    ((1 - r) * (pc[1] - pa[1]))^2 = (1 - r)^2 * (pc[1] - pa[1])^2
    (pf[1] - pa[1])^2 = (1 - r)^2 * (pc[1] - pa[1])^2
    (pf[2] - pa[2])^2 = ((1 - r) * (pc[2] - pa[2]))^2
    ((1 - r) * (pc[2] - pa[2]))^2 = (1 - r)^2 * (pc[2] - pa[2])^2
    (pf[2] - pa[2])^2 = (1 - r)^2 * (pc[2] - pa[2])^2
    (pf[1] - pa[1])^2 + (pf[2] - pa[2])^2 = (1 - r)^2 * (pc[1] - pa[1])^2 + (pf[2] - pa[2])^2
    (1 - r)^2 * (pc[1] - pa[1])^2 + (pf[2] - pa[2])^2 = (1 - r)^2 * (pc[1] - pa[1])^2 + (1 - r)^2 * (pc[2] - pa[2])^2
    (pf[1] - pa[1])^2 + (pf[2] - pa[2])^2 = (1 - r)^2 * (pc[1] - pa[1])^2 + (1 - r)^2 * (pc[2] - pa[2])^2
    geo::distance_sq(pa, pf) = (1 - r)^2 * (pc[1] - pa[1])^2 + (1 - r)^2 * (pc[2] - pa[2])^2
    (1 - r)^2 * (pc[1] - pa[1])^2 + (1 - r)^2 * (pc[2] - pa[2])^2 = (1 - r)^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2)
    geo::distance_sq(pa, pf) = (1 - r)^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2)
    by thm geo::distance_sq_coordinate_formula(pa, pc)
    geo::distance_sq(pa, pc) = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2
    (1 - r)^2 * geo::distance_sq(pa, pc) = (1 - r)^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2)
    geo::distance_sq(pa, pf) = (1 - r)^2 * ((pc[1] - pa[1])^2 + (pc[2] - pa[2])^2) = (1 - r)^2 * geo::distance_sq(pa, pc)

    geo::distance_sq(pa, pb) = geo::distance_sq(pa, pc)
    (1 - t)^2 * geo::distance_sq(pa, pb) = (1 - r)^2 * geo::distance_sq(pa, pc)
    by thm geo::multiply_both_sides(geo::distance_sq(pa, pb), geo::distance_sq(pa, pc), (1 - r)^2)
    (1 - r)^2 * geo::distance_sq(pa, pb) = geo::distance_sq(pa, pb) * (1 - r)^2 = geo::distance_sq(pa, pc) * (1 - r)^2 = (1 - r)^2 * geo::distance_sq(pa, pc)
    (1 - t)^2 * geo::distance_sq(pa, pb) = (1 - r)^2 * geo::distance_sq(pa, pc) = (1 - r)^2 * geo::distance_sq(pa, pb)

    by thm geo::distance_sq_positive_of_ne(pa, pb)
    geo::distance_sq(pa, pb) > 0
    by thm geo::cancel_positive_right_factor((1 - t)^2, (1 - r)^2, geo::distance_sq(pa, pb))
    (1 - t)^2 = (1 - r)^2
    t - 1 = -(1 - t)
    r - 1 = -(1 - r)
    (t - 1)^2 = (-(1 - t))^2 = (1 - t)^2
    (r - 1)^2 = (-(1 - r))^2 = (1 - r)^2
    (t - 1)^2 = (1 - t)^2 = (1 - r)^2 = (r - 1)^2
    0 <= t - 1
    0 <= r - 1
    by thm same_nonnegative_square(t - 1, r - 1)
    t - 1 = r - 1
    t = (t - 1) + 1 = (r - 1) + 1 = r
    r = t
    by thm geo::subtract_equalities(1, 1, r, t)
    1 - r = 1 - t
    by thm geo::multiply_both_sides(1 - r, 1 - t, pc[1] - pa[1])
    (1 - r) * (pc[1] - pa[1]) = (1 - t) * (pc[1] - pa[1])
    by thm geo::multiply_both_sides(1 - r, 1 - t, pc[2] - pa[2])
    (1 - r) * (pc[2] - pa[2]) = (1 - t) * (pc[2] - pa[2])

    pf[1] = (pf[1] - pa[1]) + pa[1] = (1 - r) * (pc[1] - pa[1]) + pa[1] = (1 - t) * (pc[1] - pa[1]) + pa[1] = pa[1] + (1 - t) * (pc[1] - pa[1])
    pf[2] = (pf[2] - pa[2]) + pa[2] = (1 - r) * (pc[2] - pa[2]) + pa[2] = (1 - t) * (pc[2] - pa[2]) + pa[2] = pa[2] + (1 - t) * (pc[2] - pa[2])
    by thm geo::perpendicular_dot_expand(pa, pb, pa, pc)
    (pb[1] - pa[1]) * (pc[1] - pa[1]) + (pb[2] - pa[2]) * (pc[2] - pa[2]) = 0
    by thm geo::distance_sq_coordinate_formula(pa, pb)
    by thm geo::distance_sq_coordinate_formula(pa, pc)
    (pb[1] - pa[1])^2 + (pb[2] - pa[2])^2 = (pc[1] - pa[1])^2 + (pc[2] - pa[2])^2

    by thm affine_right_core(pa, pb, pc, pd, pe, pf, t)
    geo::distance_sq(pd, pe) = geo::distance_sq(pd, pf)
    geo::dot(geo::vec(pd, pe), geo::vec(pd, pf)) = 0
