# NL ORIGINAL PROBLEM — IMO 1970 Problem 5
# Let ABCD be a tetrahedron such that angle BDC is a right angle.
# Suppose that the foot H of the perpendicular from D to the plane ABC is the orthocenter of triangle ABC.
# Prove that (AB + BC + CA)^2 <= 6 * (AD^2 + BD^2 + CD^2).
# Determine when equality holds.
# Equality holds exactly when AD = BD = CD.
#
# Formalization note: all five points have arbitrary real Cartesian coordinates;
# no coordinate normalization is assumed. Variables x,y,z represent AB,BC,CA,
# and variables u,v,w represent AD,BD,CD, respectively.

# Coordinate-sum elimination used by the 3D orthocenter bridge.
thm orthocenter_dot3_bridge:
    ? forall a1, a2, a3, b1, b2, b3, c1, c2, c3 R:
        a1 * (c1 - b1) + a2 * (c2 - b2) + a3 * (c3 - b3) = 0
        b1 * (a1 - c1) + b2 * (a2 - c2) + b3 * (a3 - c3) = 0
        =>:
            a1 * b1 + a2 * b2 + a3 * b3 = b1 * c1 + b2 * c2 + b3 * c3
            a1 * c1 + a2 * c2 + a3 * c3 = b1 * c1 + b2 * c2 + b3 * c3
    a1 * (c1 - b1) + a2 * (c2 - b2) + a3 * (c3 - b3) = 0
    b1 * (a1 - c1) + b2 * (a2 - c2) + b3 * (a3 - c3) = 0
    a1 * c1 + a2 * c2 + a3 * c3 - (a1 * b1 + a2 * b2 + a3 * b3) = 0
    a1 * b1 + a2 * b2 + a3 * b3 - (b1 * c1 + b2 * c2 + b3 * c3) = 0
    a1 * c1 + a2 * c2 + a3 * c3 = a1 * b1 + a2 * b2 + a3 * b3
    a1 * b1 + a2 * b2 + a3 * b3 = b1 * c1 + b2 * c2 + b3 * c3
    a1 * c1 + a2 * c2 + a3 * c3 = b1 * c1 + b2 * c2 + b3 * c3

# Translate a right angle through a common origin when both translated rays are normal to the origin vector.
thm translated_right_angle_bridge:
    ? forall b1, b2, b3, c1, c2, c3, n1, n2, n3 R:
        n1 * b1 + n2 * b2 + n3 * b3 = 0
        n1 * c1 + n2 * c2 + n3 * c3 = 0
        (b1 - n1) * (c1 - n1) + (b2 - n2) * (c2 - n2) + (b3 - n3) * (c3 - n3) = 0
        =>:
            b1 * c1 + b2 * c2 + b3 * c3 + n1^2 + n2^2 + n3^2 = 0
    n1 * b1 + n2 * b2 + n3 * b3 = 0
    n1 * c1 + n2 * c2 + n3 * c3 = 0
    (b1 - n1) * (c1 - n1) + (b2 - n2) * (c2 - n2) + (b3 - n3) * (c3 - n3) = 0
    (b1 - n1) * (c1 - n1) + (b2 - n2) * (c2 - n2) + (b3 - n3) * (c3 - n3) = b1 * c1 + b2 * c2 + b3 * c3 - (n1 * b1 + n2 * b2 + n3 * b3) - (n1 * c1 + n2 * c2 + n3 * c3) + n1^2 + n2^2 + n3^2
    b1 * c1 + b2 * c2 + b3 * c3 - (n1 * b1 + n2 * b2 + n3 * b3) - (n1 * c1 + n2 * c2 + n3 * c3) + n1^2 + n2^2 + n3^2 = b1 * c1 + b2 * c2 + b3 * c3 + n1^2 + n2^2 + n3^2
    b1 * c1 + b2 * c2 + b3 * c3 + n1^2 + n2^2 + n3^2 = 0

# Recover a translated right angle from the corresponding common-origin dot-product identity.
thm translate_pair_back_bridge:
    ? forall a1, a2, a3, b1, b2, b3, n1, n2, n3 R:
        n1 * a1 + n2 * a2 + n3 * a3 = 0
        n1 * b1 + n2 * b2 + n3 * b3 = 0
        a1 * b1 + a2 * b2 + a3 * b3 + n1^2 + n2^2 + n3^2 = 0
        =>:
            (a1 - n1) * (b1 - n1) + (a2 - n2) * (b2 - n2) + (a3 - n3) * (b3 - n3) = 0
    n1 * a1 + n2 * a2 + n3 * a3 = 0
    n1 * b1 + n2 * b2 + n3 * b3 = 0
    a1 * b1 + a2 * b2 + a3 * b3 + n1^2 + n2^2 + n3^2 = 0
    (a1 - n1) * (b1 - n1) + (a2 - n2) * (b2 - n2) + (a3 - n3) * (b3 - n3) = a1 * b1 + a2 * b2 + a3 * b3 - (n1 * a1 + n2 * a2 + n3 * a3) - (n1 * b1 + n2 * b2 + n3 * b3) + n1^2 + n2^2 + n3^2
    a1 * b1 + a2 * b2 + a3 * b3 - (n1 * a1 + n2 * a2 + n3 * a3) - (n1 * b1 + n2 * b2 + n3 * b3) + n1^2 + n2^2 + n3^2 = a1 * b1 + a2 * b2 + a3 * b3 + n1^2 + n2^2 + n3^2
    a1 * b1 + a2 * b2 + a3 * b3 - (n1 * a1 + n2 * a2 + n3 * a3) - (n1 * b1 + n2 * b2 + n3 * b3) + n1^2 + n2^2 + n3^2 = 0
    (a1 - n1) * (b1 - n1) + (a2 - n2) * (b2 - n2) + (a3 - n3) * (b3 - n3) = 0

have fn dot_segments3(px, py, pz, qx, qy, qz, rx, ry, rz, sx, sy, sz R) R = (qx - px) * (sx - rx) + (qy - py) * (sy - ry) + (qz - pz) * (sz - rz)

have fn distance_sq3(px, py, pz, qx, qy, qz R) R = (qx - px)^2 + (qy - py)^2 + (qz - pz)^2

thm add_left_context_bridge:
    ? forall a, b, c R:
        a = b
        =>:
            c + a = c + b
    c + a = c + b

thm add_right_context_bridge:
    ? forall a, b, c R:
        a = b
        =>:
            a + c = b + c
    a + c = b + c

thm right_angle_distance_sq3_bridge:
    ? forall ax, ay, az, bx, b_y, bz, dx, dy, dz R:
        (ax - dx) * (bx - dx) + (ay - dy) * (b_y - dy) + (az - dz) * (bz - dz) = 0
        =>:
            distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
    distance_sq3(ax, ay, az, bx, b_y, bz) = (bx - ax)^2 + (b_y - ay)^2 + (bz - az)^2
    distance_sq3(ax, ay, az, dx, dy, dz) = (dx - ax)^2 + (dy - ay)^2 + (dz - az)^2
    distance_sq3(bx, b_y, bz, dx, dy, dz) = (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2
    (bx - ax)^2 + (b_y - ay)^2 + (bz - az)^2 = (dx - ax)^2 + (dy - ay)^2 + (dz - az)^2 + (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2 - 2 * ((ax - dx) * (bx - dx) + (ay - dy) * (b_y - dy) + (az - dz) * (bz - dz))
    (dx - ax)^2 + (dy - ay)^2 + (dz - az)^2 + (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2 - 2 * ((ax - dx) * (bx - dx) + (ay - dy) * (b_y - dy) + (az - dz) * (bz - dz)) = (dx - ax)^2 + (dy - ay)^2 + (dz - az)^2 + (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2
    (bx - ax)^2 + (b_y - ay)^2 + (bz - az)^2 = (dx - ax)^2 + (dy - ay)^2 + (dz - az)^2 + (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2
    distance_sq3(ax, ay, az, bx, b_y, bz) = (dx - ax)^2 + (dy - ay)^2 + (dz - az)^2 + (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2
    distance_sq3(ax, ay, az, bx, b_y, bz) = ((dx - ax)^2 + (dy - ay)^2 + (dz - az)^2) + ((dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2)
    release thm add_right_context_bridge((dx - ax)^2 + (dy - ay)^2 + (dz - az)^2, distance_sq3(ax, ay, az, dx, dy, dz), (dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2)
    ((dx - ax)^2 + (dy - ay)^2 + (dz - az)^2) + ((dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2) = distance_sq3(ax, ay, az, dx, dy, dz) + ((dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2)
    distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + ((dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2)
    release thm add_left_context_bridge((dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2, distance_sq3(bx, b_y, bz, dx, dy, dz), distance_sq3(ax, ay, az, dx, dy, dz))
    distance_sq3(ax, ay, az, dx, dy, dz) + ((dx - bx)^2 + (dy - b_y)^2 + (dz - bz)^2) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
    distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)

# Six times the oriented volume of PQRS.
have fn volume6(px, py, pz, qx, qy, qz, rx, ry, rz, sx, sy, sz R) R = (qx - px) * ((ry - py) * (sz - pz) - (rz - pz) * (sy - py)) - (qy - py) * ((rx - px) * (sz - pz) - (rz - pz) * (sx - px)) + (qz - pz) * ((rx - px) * (sy - py) - (ry - py) * (sx - px))

# NL contract: A,B,C,D form a nondegenerate tetrahedron.
prop tetrahedron3(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz R):
    volume6(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz) != 0

# NL contract: H lies in plane ABC and DH is perpendicular to that plane.
prop foot_d_on_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz R):
    volume6(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz) = 0
    (dx - hx) * (ax - hx) + (dy - hy) * (ay - hy) + (dz - hz) * (az - hz) = 0
    (dx - hx) * (bx - hx) + (dy - hy) * (b_y - hy) + (dz - hz) * (bz - hz) = 0
    (dx - hx) * (cx - hx) + (dy - hy) * (cy - hy) + (dz - hz) * (cz - hz) = 0

# NL contract: H is the intersection of the three altitudes of triangle ABC.
prop orthocenter_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz R):
    (ax - hx) * (cx - bx) + (ay - hy) * (cy - b_y) + (az - hz) * (cz - bz) = 0
    (bx - hx) * (ax - cx) + (b_y - hy) * (ay - cy) + (bz - hz) * (az - cz) = 0
    (cx - hx) * (bx - ax) + (cy - hy) * (b_y - ay) + (cz - hz) * (bz - az) = 0

# NL contract: angle BDC is a right angle.
prop right_bdc(bx, b_y, bz, cx, cy, cz, dx, dy, dz R):
    (bx - dx) * (cx - dx) + (b_y - dy) * (cy - dy) + (bz - dz) * (cz - dz) = 0

thm imo19_geometry_bridge_probe:
    ? forall ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz R:
        $tetrahedron3(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        $foot_d_on_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
        $orthocenter_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz)
        $right_bdc(bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        =>:
            (ax - dx) * (bx - dx) + (ay - dy) * (b_y - dy) + (az - dz) * (bz - dz) = 0
            (bx - dx) * (cx - dx) + (b_y - dy) * (cy - dy) + (bz - dz) * (cz - dz) = 0
            (cx - dx) * (ax - dx) + (cy - dy) * (ay - dy) + (cz - dz) * (az - dz) = 0
            distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
            distance_sq3(bx, b_y, bz, cx, cy, cz) = distance_sq3(bx, b_y, bz, dx, dy, dz) + distance_sq3(cx, cy, cz, dx, dy, dz)
            distance_sq3(cx, cy, cz, ax, ay, az) = distance_sq3(cx, cy, cz, dx, dy, dz) + distance_sq3(ax, ay, az, dx, dy, dz)
    by def $foot_d_on_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
    by def $orthocenter_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz)
    by def $right_bdc(bx, b_y, bz, cx, cy, cz, dx, dy, dz)

    # Rewrite the two altitude equations and apply the local vector bridge.
    (ax - hx) * ((cx - hx) - (bx - hx)) + (ay - hy) * ((cy - hy) - (b_y - hy)) + (az - hz) * ((cz - hz) - (bz - hz)) = 0
    (bx - hx) * ((ax - hx) - (cx - hx)) + (b_y - hy) * ((ay - hy) - (cy - hy)) + (bz - hz) * ((az - hz) - (cz - hz)) = 0
    release thm orthocenter_dot3_bridge(ax - hx, ay - hy, az - hz, bx - hx, b_y - hy, bz - hz, cx - hx, cy - hy, cz - hz)
    (ax - hx) * (bx - hx) + (ay - hy) * (b_y - hy) + (az - hz) * (bz - hz) = (bx - hx) * (cx - hx) + (b_y - hy) * (cy - hy) + (bz - hz) * (cz - hz)
    (ax - hx) * (cx - hx) + (ay - hy) * (cy - hy) + (az - hz) * (cz - hz) = (bx - hx) * (cx - hx) + (b_y - hy) * (cy - hy) + (bz - hz) * (cz - hz)

    # DH is normal to the base plane, so its dot product with HA, HB, HC is zero.
    (dx - hx) * (ax - hx) + (dy - hy) * (ay - hy) + (dz - hz) * (az - hz) = 0
    (dx - hx) * (bx - hx) + (dy - hy) * (b_y - hy) + (dz - hz) * (bz - hz) = 0
    (dx - hx) * (cx - hx) + (dy - hy) * (cy - hy) + (dz - hz) * (cz - hz) = 0

    # Normalize the given right angle to H-relative coordinates, then extract the common dot product.
    ((bx - hx) - (dx - hx)) * ((cx - hx) - (dx - hx)) + ((b_y - hy) - (dy - hy)) * ((cy - hy) - (dy - hy)) + ((bz - hz) - (dz - hz)) * ((cz - hz) - (dz - hz)) = (bx - dx) * (cx - dx) + (b_y - dy) * (cy - dy) + (bz - dz) * (cz - dz)
    ((bx - hx) - (dx - hx)) * ((cx - hx) - (dx - hx)) + ((b_y - hy) - (dy - hy)) * ((cy - hy) - (dy - hy)) + ((bz - hz) - (dz - hz)) * ((cz - hz) - (dz - hz)) = 0
    release thm translated_right_angle_bridge(bx - hx, b_y - hy, bz - hz, cx - hx, cy - hy, cz - hz, dx - hx, dy - hy, dz - hz)
    (bx - hx) * (cx - hx) + (b_y - hy) * (cy - hy) + (bz - hz) * (cz - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2 = 0

    # The orthocenter equalities transfer that common value to AB and CA.
    (ax - hx) * (bx - hx) + (ay - hy) * (b_y - hy) + (az - hz) * (bz - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2 = (bx - hx) * (cx - hx) + (b_y - hy) * (cy - hy) + (bz - hz) * (cz - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2
    (ax - hx) * (bx - hx) + (ay - hy) * (b_y - hy) + (az - hz) * (bz - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2 = 0
    (cx - hx) * (ax - hx) + (cy - hy) * (ay - hy) + (cz - hz) * (az - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2 = (bx - hx) * (cx - hx) + (b_y - hy) * (cy - hy) + (bz - hz) * (cz - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2
    (cx - hx) * (ax - hx) + (cy - hy) * (ay - hy) + (cz - hz) * (az - hz) + (dx - hx)^2 + (dy - hy)^2 + (dz - hz)^2 = 0

    # Translate AB and CA back from H to D.
    release thm translate_pair_back_bridge(ax - hx, ay - hy, az - hz, bx - hx, b_y - hy, bz - hz, dx - hx, dy - hy, dz - hz)
    ((ax - hx) - (dx - hx)) * ((bx - hx) - (dx - hx)) + ((ay - hy) - (dy - hy)) * ((b_y - hy) - (dy - hy)) + ((az - hz) - (dz - hz)) * ((bz - hz) - (dz - hz)) = 0
    (ax - dx) * (bx - dx) + (ay - dy) * (b_y - dy) + (az - dz) * (bz - dz) = ((ax - hx) - (dx - hx)) * ((bx - hx) - (dx - hx)) + ((ay - hy) - (dy - hy)) * ((b_y - hy) - (dy - hy)) + ((az - hz) - (dz - hz)) * ((bz - hz) - (dz - hz))
    (ax - dx) * (bx - dx) + (ay - dy) * (b_y - dy) + (az - dz) * (bz - dz) = 0
    (bx - dx) * (cx - dx) + (b_y - dy) * (cy - dy) + (bz - dz) * (cz - dz) = 0
    release thm translate_pair_back_bridge(cx - hx, cy - hy, cz - hz, ax - hx, ay - hy, az - hz, dx - hx, dy - hy, dz - hz)
    ((cx - hx) - (dx - hx)) * ((ax - hx) - (dx - hx)) + ((cy - hy) - (dy - hy)) * ((ay - hy) - (dy - hy)) + ((cz - hz) - (dz - hz)) * ((az - hz) - (dz - hz)) = 0
    (cx - dx) * (ax - dx) + (cy - dy) * (ay - dy) + (cz - dz) * (az - dz) = ((cx - hx) - (dx - hx)) * ((ax - hx) - (dx - hx)) + ((cy - hy) - (dy - hy)) * ((ay - hy) - (dy - hy)) + ((cz - hz) - (dz - hz)) * ((az - hz) - (dz - hz))
    (cx - dx) * (ax - dx) + (cy - dy) * (ay - dy) + (cz - dz) * (az - dz) = 0

    # Each zero coordinate dot product is exactly the corresponding Pythagorean identity.
    release thm right_angle_distance_sq3_bridge(ax, ay, az, bx, b_y, bz, dx, dy, dz)
    distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
    release thm right_angle_distance_sq3_bridge(bx, b_y, bz, cx, cy, cz, dx, dy, dz)
    distance_sq3(bx, b_y, bz, cx, cy, cz) = distance_sq3(bx, b_y, bz, dx, dy, dz) + distance_sq3(cx, cy, cz, dx, dy, dz)
    release thm right_angle_distance_sq3_bridge(cx, cy, cz, ax, ay, az, dx, dy, dz)
    distance_sq3(cx, cy, cz, ax, ay, az) = distance_sq3(cx, cy, cz, dx, dy, dz) + distance_sq3(ax, ay, az, dx, dy, dz)

# Scalar metric layer.
thm add_comm_bridge:
    ? forall a, b R:
        a + b = b + a
    a + b = b + a

thm mul_left_context_bridge:
    ? forall a, b, c R:
        a = b
        =>:
            c * a = c * b
    c * a = c * b

thm add_right_cancel_bridge:
    ? forall a, b, c R:
        a + c = b + c
        =>:
            a = b
    release thm add_right_context_bridge(a + c, b + c, -c)
    a + c + (-c) = b + c + (-c)
    a + c + (-c) = a
    b + c + (-c) = b
    a = b

thm combine_three_equalities:
    ? forall a, b, c, p, q, r R:
        a = p
        b = q
        c = r
        =>:
            a + b + c = p + q + r
    release thm add_right_context_bridge(a, p, b)
    a + b = p + b
    release thm add_left_context_bridge(b, q, p)
    p + b = p + q
    a + b = p + q
    release thm add_right_context_bridge(a + b, p + q, c)
    a + b + c = p + q + c
    release thm add_left_context_bridge(c, r, p + q)
    p + q + c = p + q + r
    a + b + c = p + q + r

thm pythagorean_three_sum:
    ? forall x, y, z, u, v, w R:
        x^2 = u^2 + v^2
        y^2 = v^2 + w^2
        z^2 = w^2 + u^2
        =>:
            x^2 + y^2 + z^2 = 2 * (u^2 + v^2 + w^2)
    release thm combine_three_equalities(x^2, y^2, z^2, u^2 + v^2, v^2 + w^2, w^2 + u^2)
    x^2 + y^2 + z^2 = (u^2 + v^2) + (v^2 + w^2) + (w^2 + u^2)
    (u^2 + v^2) + (v^2 + w^2) + (w^2 + u^2) = 2 * (u^2 + v^2 + w^2)
    x^2 + y^2 + z^2 = 2 * (u^2 + v^2 + w^2)

thm pythagorean_three_sum_scaled:
    ? forall x, y, z, u, v, w R:
        x^2 = u^2 + v^2
        y^2 = v^2 + w^2
        z^2 = w^2 + u^2
        =>:
            3 * (x^2 + y^2 + z^2) = 6 * (u^2 + v^2 + w^2)
    release thm pythagorean_three_sum(x, y, z, u, v, w)
    x^2 + y^2 + z^2 = 2 * (u^2 + v^2 + w^2)
    release thm mul_left_context_bridge(x^2 + y^2 + z^2, 2 * (u^2 + v^2 + w^2), 3)
    3 * (x^2 + y^2 + z^2) = 3 * (2 * (u^2 + v^2 + w^2))
    3 * (2 * (u^2 + v^2 + w^2)) = 6 * (u^2 + v^2 + w^2)
    3 * (x^2 + y^2 + z^2) = 6 * (u^2 + v^2 + w^2)

thm cauchy_three:
    ? forall x, y, z R:
        (x + y + z)^2 <= 3 * (x^2 + y^2 + z^2)
    (x - y)^2 >= 0
    (y - z)^2 >= 0
    (z - x)^2 >= 0
    (x - y)^2 + (y - z)^2 + (z - x)^2 >= 0
    2 * (x^2 + y^2 + z^2) - 2 * (x*y + y*z + z*x) = (x - y)^2 + (y - z)^2 + (z - x)^2
    2 * (x^2 + y^2 + z^2) - 2 * (x*y + y*z + z*x) >= 0
    3 * (x^2 + y^2 + z^2) - (x + y + z)^2 = 2 * (x^2 + y^2 + z^2) - 2 * (x*y + y*z + z*x)
    3 * (x^2 + y^2 + z^2) - (x + y + z)^2 >= 0
    (x + y + z)^2 <= 3 * (x^2 + y^2 + z^2)

thm equality_three_only_if:
    ? forall x, y, z R:
        (x + y + z)^2 = 3 * (x^2 + y^2 + z^2)
        =>:
            x = y
            y = z
    (x - y)^2 >= 0
    (y - z)^2 >= 0
    (z - x)^2 >= 0
    3 * (x^2 + y^2 + z^2) - (x + y + z)^2 = (x - y)^2 + (y - z)^2 + (z - x)^2
    3 * (x^2 + y^2 + z^2) - (x + y + z)^2 = 0
    (x - y)^2 + (y - z)^2 + (z - x)^2 = 0
    (x - y)^2 <= (x - y)^2 + (y - z)^2 + (z - x)^2 = 0
    (x - y)^2 = 0
    (x - y) * (x - y) = 0
    x - y = 0
    x = y
    (y - z)^2 <= (x - y)^2 + (y - z)^2 + (z - x)^2 = 0
    (y - z)^2 = 0
    (y - z) * (y - z) = 0
    y - z = 0
    y = z

thm equality_three_if:
    ? forall x, y, z R:
        x = y
        y = z
        =>:
            (x + y + z)^2 = 3 * (x^2 + y^2 + z^2)
    x - y = 0
    y - z = 0
    z - x = 0
    (x - y)^2 = 0
    (y - z)^2 = 0
    (z - x)^2 = 0
    (x - y)^2 + (y - z)^2 + (z - x)^2 = 0
    3 * (x^2 + y^2 + z^2) - (x + y + z)^2 = (x - y)^2 + (y - z)^2 + (z - x)^2
    3 * (x^2 + y^2 + z^2) - (x + y + z)^2 = 0
    (x + y + z)^2 = 3 * (x^2 + y^2 + z^2)

thm nonnegative_equal_of_equal_squares:
    ? forall x, y R:
        x >= 0
        y >= 0
        x^2 = y^2
        =>:
            x = y
    y = 0 or not y = 0
    by cases:
        ? x = y
        case y = 0:
            y^2 = 0
            x^2 = 0
            x = 0
            x = y
        case not y = 0:
            by contra:
                ? y > 0
                y <= 0
                y >= 0
                y = 0
                impossible y != 0
            y > 0
            x^2 - y^2 = 0
            (x - y) * (x + y) = 0
            x + y > 0
            x + y != 0
            x - y = 0
            x = y

# Here x,y,z are AB,BC,CA and u,v,w are AD,BD,CD.
thm imo19_metric_inequality:
    ? forall x, y, z, u, v, w R:
        x^2 = u^2 + v^2
        y^2 = v^2 + w^2
        z^2 = w^2 + u^2
        =>:
            (x + y + z)^2 <= 6 * (u^2 + v^2 + w^2)
    release thm cauchy_three(x, y, z)
    (x + y + z)^2 <= 3 * (x^2 + y^2 + z^2)
    release thm pythagorean_three_sum_scaled(x, y, z, u, v, w)
    3 * (x^2 + y^2 + z^2) = 6 * (u^2 + v^2 + w^2)
    (x + y + z)^2 <= 6 * (u^2 + v^2 + w^2)

thm imo19_metric_equality_only_if:
    ? forall x, y, z, u, v, w R:
        x >= 0
        y >= 0
        z >= 0
        u >= 0
        v >= 0
        w >= 0
        x^2 = u^2 + v^2
        y^2 = v^2 + w^2
        z^2 = w^2 + u^2
        (x + y + z)^2 = 6 * (u^2 + v^2 + w^2)
        =>:
            u = v
            v = w
    release thm pythagorean_three_sum_scaled(x, y, z, u, v, w)
    3 * (x^2 + y^2 + z^2) = 6 * (u^2 + v^2 + w^2)
    (x + y + z)^2 = 3 * (x^2 + y^2 + z^2)
    release thm equality_three_only_if(x, y, z)
    x = y
    y = z
    x^2 = y^2
    y^2 = z^2
    u^2 + v^2 = v^2 + w^2
    release thm add_comm_bridge(v^2, w^2)
    v^2 + w^2 = w^2 + v^2
    u^2 + v^2 = w^2 + v^2
    release thm add_right_cancel_bridge(u^2, w^2, v^2)
    u^2 = w^2

    v^2 + w^2 = w^2 + u^2
    release thm add_comm_bridge(w^2, u^2)
    w^2 + u^2 = u^2 + w^2
    v^2 + w^2 = u^2 + w^2
    release thm add_right_cancel_bridge(v^2, u^2, w^2)
    v^2 = u^2
    release thm nonnegative_equal_of_equal_squares(u, w)
    u = w
    release thm nonnegative_equal_of_equal_squares(v, u)
    v = u
    u = v
    v = w

thm imo19_metric_equality_if:
    ? forall x, y, z, u, v, w R:
        x >= 0
        y >= 0
        z >= 0
        u >= 0
        v >= 0
        w >= 0
        x^2 = u^2 + v^2
        y^2 = v^2 + w^2
        z^2 = w^2 + u^2
        u = v
        v = w
        =>:
            (x + y + z)^2 = 6 * (u^2 + v^2 + w^2)
    u^2 = v^2
    v^2 = w^2
    w^2 = u^2

    release thm add_right_context_bridge(u^2, v^2, v^2)
    u^2 + v^2 = v^2 + v^2
    release thm add_left_context_bridge(v^2, w^2, v^2)
    v^2 + v^2 = v^2 + w^2
    u^2 + v^2 = v^2 + w^2
    x^2 = y^2

    release thm add_right_context_bridge(v^2, w^2, w^2)
    v^2 + w^2 = w^2 + w^2
    release thm add_left_context_bridge(w^2, u^2, w^2)
    w^2 + w^2 = w^2 + u^2
    v^2 + w^2 = w^2 + u^2
    y^2 = z^2
    release thm nonnegative_equal_of_equal_squares(x, y)
    x = y
    release thm nonnegative_equal_of_equal_squares(y, z)
    y = z
    release thm equality_three_if(x, y, z)
    (x + y + z)^2 = 3 * (x^2 + y^2 + z^2)
    release thm pythagorean_three_sum_scaled(x, y, z, u, v, w)
    3 * (x^2 + y^2 + z^2) = 6 * (u^2 + v^2 + w^2)
    (x + y + z)^2 = 6 * (u^2 + v^2 + w^2)


# Substitute nonnegative edge-length witnesses into a squared-distance Pythagorean identity.
thm distance_identity_to_length_identity:
    ? forall x, u, v, X, U, V R:
        x^2 = X
        u^2 = U
        v^2 = V
        X = U + V
        =>:
            x^2 = u^2 + v^2
    release thm add_right_context_bridge(u^2, U, v^2)
    u^2 + v^2 = U + v^2
    release thm add_left_context_bridge(v^2, V, U)
    U + v^2 = U + V
    u^2 + v^2 = U + V
    U + V = u^2 + v^2
    x^2 = u^2 + v^2

# IMO 1970 Problem 5: inequality in arbitrary Cartesian coordinates.
# x,y,z witness AB,BC,CA; u,v,w witness AD,BD,CD.
# NL: Let ABCD be a tetrahedron.
# Formal predicate: nonzero oriented volume asserts that A,B,C,D form a tetrahedron.
# NL: Suppose that the foot H of the perpendicular from D to plane ABC is the orthocenter of triangle ABC.
# Formal predicates: foot_d_on_abc and orthocenter_abc encode this sentence.
# NL: Suppose that angle BDC is a right angle.
# Formal predicate: right_bdc encodes this sentence.
# Formal length witnesses: x=AB, y=BC, z=CA, u=AD, v=BD, w=CD;
# the six nonnegativity clauses select the nonnegative Euclidean lengths.
# Formal length-square definitions: x^2=AB^2, y^2=BC^2, z^2=CA^2,
# u^2=AD^2, v^2=BD^2, w^2=CD^2.
# NL conclusion: Prove that (AB+BC+CA)^2 <= 6(AD^2+BD^2+CD^2).
# Formal conclusion: (x+y+z)^2 <= 6(u^2+v^2+w^2).
thm imo_1970_5_inequality:
    # NL subject: ABCD is an arbitrary tetrahedron in Cartesian coordinates.
    ? forall ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz, x, y, z, u, v, w R:
        # NL: ABCD is a tetrahedron.
        $tetrahedron3(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        # NL: H is the foot of the perpendicular from D to plane ABC.
        $foot_d_on_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
        # NL: H is the orthocenter of triangle ABC.
        $orthocenter_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz)
        # NL: angle BDC is a right angle.
        $right_bdc(bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        # Formal encoding: x=AB and x is a nonnegative length.
        x >= 0
        # Formal encoding: y=BC and y is a nonnegative length.
        y >= 0
        # Formal encoding: z=CA and z is a nonnegative length.
        z >= 0
        # Formal encoding: u=AD and u is a nonnegative length.
        u >= 0
        # Formal encoding: v=BD and v is a nonnegative length.
        v >= 0
        # Formal encoding: w=CD and w is a nonnegative length.
        w >= 0
        # Formal encoding: x^2=AB^2.
        x^2 = distance_sq3(ax, ay, az, bx, b_y, bz)
        # Formal encoding: y^2=BC^2.
        y^2 = distance_sq3(bx, b_y, bz, cx, cy, cz)
        # Formal encoding: z^2=CA^2.
        z^2 = distance_sq3(cx, cy, cz, ax, ay, az)
        # Formal encoding: u^2=AD^2.
        u^2 = distance_sq3(ax, ay, az, dx, dy, dz)
        # Formal encoding: v^2=BD^2.
        v^2 = distance_sq3(bx, b_y, bz, dx, dy, dz)
        # Formal encoding: w^2=CD^2.
        w^2 = distance_sq3(cx, cy, cz, dx, dy, dz)
        =>:
            # NL conclusion: (AB+BC+CA)^2 <= 6(AD^2+BD^2+CD^2).
            (x + y + z)^2 <= 6 * (u^2 + v^2 + w^2)
    release thm imo19_geometry_bridge_probe(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
    distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
    distance_sq3(bx, b_y, bz, cx, cy, cz) = distance_sq3(bx, b_y, bz, dx, dy, dz) + distance_sq3(cx, cy, cz, dx, dy, dz)
    distance_sq3(cx, cy, cz, ax, ay, az) = distance_sq3(cx, cy, cz, dx, dy, dz) + distance_sq3(ax, ay, az, dx, dy, dz)

    release thm distance_identity_to_length_identity(x, u, v, distance_sq3(ax, ay, az, bx, b_y, bz), distance_sq3(ax, ay, az, dx, dy, dz), distance_sq3(bx, b_y, bz, dx, dy, dz))
    x^2 = u^2 + v^2
    release thm distance_identity_to_length_identity(y, v, w, distance_sq3(bx, b_y, bz, cx, cy, cz), distance_sq3(bx, b_y, bz, dx, dy, dz), distance_sq3(cx, cy, cz, dx, dy, dz))
    y^2 = v^2 + w^2
    release thm distance_identity_to_length_identity(z, w, u, distance_sq3(cx, cy, cz, ax, ay, az), distance_sq3(cx, cy, cz, dx, dy, dz), distance_sq3(ax, ay, az, dx, dy, dz))
    z^2 = w^2 + u^2

    release thm imo19_metric_inequality(x, y, z, u, v, w)
    (x + y + z)^2 <= 6 * (u^2 + v^2 + w^2)


# NL equality direction: if equality holds in the stated inequality, then AD=BD=CD.
# The geometric hypotheses and length witnesses below are the same as in the inequality theorem.
thm imo_1970_5_equality_only_if:
    # NL subject: ABCD is an arbitrary tetrahedron in Cartesian coordinates.
    ? forall ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz, x, y, z, u, v, w R:
        # NL: ABCD is a tetrahedron.
        $tetrahedron3(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        # NL: H is the foot of the perpendicular from D to plane ABC.
        $foot_d_on_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
        # NL: H is the orthocenter of triangle ABC.
        $orthocenter_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz)
        # NL: angle BDC is a right angle.
        $right_bdc(bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        # Formal encoding: x=AB and x is a nonnegative length.
        x >= 0
        # Formal encoding: y=BC and y is a nonnegative length.
        y >= 0
        # Formal encoding: z=CA and z is a nonnegative length.
        z >= 0
        # Formal encoding: u=AD and u is a nonnegative length.
        u >= 0
        # Formal encoding: v=BD and v is a nonnegative length.
        v >= 0
        # Formal encoding: w=CD and w is a nonnegative length.
        w >= 0
        # Formal encoding: x^2=AB^2.
        x^2 = distance_sq3(ax, ay, az, bx, b_y, bz)
        # Formal encoding: y^2=BC^2.
        y^2 = distance_sq3(bx, b_y, bz, cx, cy, cz)
        # Formal encoding: z^2=CA^2.
        z^2 = distance_sq3(cx, cy, cz, ax, ay, az)
        # Formal encoding: u^2=AD^2.
        u^2 = distance_sq3(ax, ay, az, dx, dy, dz)
        # Formal encoding: v^2=BD^2.
        v^2 = distance_sq3(bx, b_y, bz, dx, dy, dz)
        # Formal encoding: w^2=CD^2.
        w^2 = distance_sq3(cx, cy, cz, dx, dy, dz)
        # NL equality hypothesis: (AB+BC+CA)^2 = 6(AD^2+BD^2+CD^2).
        (x + y + z)^2 = 6 * (u^2 + v^2 + w^2)
        =>:
            # NL conclusion, first equality: AD=BD.
            u = v
            # NL conclusion, second equality: BD=CD; together these say AD=BD=CD.
            v = w
    release thm imo19_geometry_bridge_probe(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
    distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
    distance_sq3(bx, b_y, bz, cx, cy, cz) = distance_sq3(bx, b_y, bz, dx, dy, dz) + distance_sq3(cx, cy, cz, dx, dy, dz)
    distance_sq3(cx, cy, cz, ax, ay, az) = distance_sq3(cx, cy, cz, dx, dy, dz) + distance_sq3(ax, ay, az, dx, dy, dz)

    release thm distance_identity_to_length_identity(x, u, v, distance_sq3(ax, ay, az, bx, b_y, bz), distance_sq3(ax, ay, az, dx, dy, dz), distance_sq3(bx, b_y, bz, dx, dy, dz))
    x^2 = u^2 + v^2
    release thm distance_identity_to_length_identity(y, v, w, distance_sq3(bx, b_y, bz, cx, cy, cz), distance_sq3(bx, b_y, bz, dx, dy, dz), distance_sq3(cx, cy, cz, dx, dy, dz))
    y^2 = v^2 + w^2
    release thm distance_identity_to_length_identity(z, w, u, distance_sq3(cx, cy, cz, ax, ay, az), distance_sq3(cx, cy, cz, dx, dy, dz), distance_sq3(ax, ay, az, dx, dy, dz))
    z^2 = w^2 + u^2

    release thm imo19_metric_equality_only_if(x, y, z, u, v, w)
    u = v
    v = w

# NL equality direction: if AD=BD=CD, then equality holds in the stated inequality.
# The geometric hypotheses and length witnesses below are the same as in the inequality theorem.
thm imo_1970_5_equality_if:
    # NL subject: ABCD is an arbitrary tetrahedron in Cartesian coordinates.
    ? forall ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz, x, y, z, u, v, w R:
        # NL: ABCD is a tetrahedron.
        $tetrahedron3(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        # NL: H is the foot of the perpendicular from D to plane ABC.
        $foot_d_on_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
        # NL: H is the orthocenter of triangle ABC.
        $orthocenter_abc(ax, ay, az, bx, b_y, bz, cx, cy, cz, hx, hy, hz)
        # NL: angle BDC is a right angle.
        $right_bdc(bx, b_y, bz, cx, cy, cz, dx, dy, dz)
        # Formal encoding: x=AB and x is a nonnegative length.
        x >= 0
        # Formal encoding: y=BC and y is a nonnegative length.
        y >= 0
        # Formal encoding: z=CA and z is a nonnegative length.
        z >= 0
        # Formal encoding: u=AD and u is a nonnegative length.
        u >= 0
        # Formal encoding: v=BD and v is a nonnegative length.
        v >= 0
        # Formal encoding: w=CD and w is a nonnegative length.
        w >= 0
        # Formal encoding: x^2=AB^2.
        x^2 = distance_sq3(ax, ay, az, bx, b_y, bz)
        # Formal encoding: y^2=BC^2.
        y^2 = distance_sq3(bx, b_y, bz, cx, cy, cz)
        # Formal encoding: z^2=CA^2.
        z^2 = distance_sq3(cx, cy, cz, ax, ay, az)
        # Formal encoding: u^2=AD^2.
        u^2 = distance_sq3(ax, ay, az, dx, dy, dz)
        # Formal encoding: v^2=BD^2.
        v^2 = distance_sq3(bx, b_y, bz, dx, dy, dz)
        # Formal encoding: w^2=CD^2.
        w^2 = distance_sq3(cx, cy, cz, dx, dy, dz)
        # NL equality condition, first equality: AD=BD.
        u = v
        # NL equality condition, second equality: BD=CD; together these say AD=BD=CD.
        v = w
        =>:
            # NL conclusion: equality holds, so (AB+BC+CA)^2 = 6(AD^2+BD^2+CD^2).
            (x + y + z)^2 = 6 * (u^2 + v^2 + w^2)
    release thm imo19_geometry_bridge_probe(ax, ay, az, bx, b_y, bz, cx, cy, cz, dx, dy, dz, hx, hy, hz)
    distance_sq3(ax, ay, az, bx, b_y, bz) = distance_sq3(ax, ay, az, dx, dy, dz) + distance_sq3(bx, b_y, bz, dx, dy, dz)
    distance_sq3(bx, b_y, bz, cx, cy, cz) = distance_sq3(bx, b_y, bz, dx, dy, dz) + distance_sq3(cx, cy, cz, dx, dy, dz)
    distance_sq3(cx, cy, cz, ax, ay, az) = distance_sq3(cx, cy, cz, dx, dy, dz) + distance_sq3(ax, ay, az, dx, dy, dz)

    release thm distance_identity_to_length_identity(x, u, v, distance_sq3(ax, ay, az, bx, b_y, bz), distance_sq3(ax, ay, az, dx, dy, dz), distance_sq3(bx, b_y, bz, dx, dy, dz))
    x^2 = u^2 + v^2
    release thm distance_identity_to_length_identity(y, v, w, distance_sq3(bx, b_y, bz, cx, cy, cz), distance_sq3(bx, b_y, bz, dx, dy, dz), distance_sq3(cx, cy, cz, dx, dy, dz))
    y^2 = v^2 + w^2
    release thm distance_identity_to_length_identity(z, w, u, distance_sq3(cx, cy, cz, ax, ay, az), distance_sq3(cx, cy, cz, dx, dy, dz), distance_sq3(ax, ay, az, dx, dy, dz))
    z^2 = w^2 + u^2

    release thm imo19_metric_equality_if(x, y, z, u, v, w)
    (x + y + z)^2 = 6 * (u^2 + v^2 + w^2)
