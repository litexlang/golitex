# Problem 1141 / zhongkao_967
# Figure-complete, trust-free version.  The literal dataset text omits BE=CE
# and does not encode the directed orientation of the parallel sides; see
# formalization.md for the semantic contract.

thm problem_1141_angle_equality:
    ? forall a, b, c, d, m cart(R, R):
        geo::vec(a, b) = geo::vec(c, d)
        $geo::is_midpoint(m, b, c)
        a != b
        a != m
        d != c
        d != m
        =>:
            $geo::are_angles_congruent(b, a, m, c, d, m)

    # Expand the directed side equality and the midpoint coordinates.
    release thm geo::vec_coordinate_formula(a, b)
    release thm geo::vec_coordinate_formula(c, d)
    geo::vec(a, b)[1] = geo::vec(c, d)[1]
    geo::vec(a, b)[2] = geo::vec(c, d)[2]
    geo::vec(a, b)[1] = b[1] - a[1]
    geo::vec(a, b)[2] = b[2] - a[2]
    geo::vec(c, d)[1] = d[1] - c[1]
    geo::vec(c, d)[2] = d[2] - c[2]
    b[1] - a[1] = d[1] - c[1]
    b[2] - a[2] = d[2] - c[2]

    by def $geo::is_midpoint(m, b, c)
    m[1] = (b[1] + c[1]) / 2
    m[2] = (b[2] + c[2]) / 2
    m[1] - b[1] = (c[1] - b[1]) / 2
    m[2] - b[2] = (c[2] - b[2]) / 2
    m[1] - c[1] = (b[1] - c[1]) / 2
    m[2] - c[2] = (b[2] - c[2]) / 2

    # First pair of SAS sides: AB = DC.
    release thm geo::distance_sq_coordinate_formula(a, b)
    release thm geo::distance_sq_coordinate_formula(d, c)
    geo::distance_sq(a, b) = (a[1] - b[1])^2 + (a[2] - b[2])^2
    geo::distance_sq(d, c) = (d[1] - c[1])^2 + (d[2] - c[2])^2
    a[1] - b[1] = -(b[1] - a[1])
    a[2] - b[2] = -(b[2] - a[2])
    (a[1] - b[1])^2 = (b[1] - a[1])^2
    (a[2] - b[2])^2 = (b[2] - a[2])^2
    (b[1] - a[1])^2 = (d[1] - c[1])^2
    (b[2] - a[2])^2 = (d[2] - c[2])^2
    (a[1] - b[1])^2 = (d[1] - c[1])^2
    (a[2] - b[2])^2 = (d[2] - c[2])^2
    (a[1] - b[1])^2 + (a[2] - b[2])^2 = (d[1] - c[1])^2 + (d[2] - c[2])^2
    geo::distance_sq(a, b) = (a[1] - b[1])^2 + (a[2] - b[2])^2 = (d[1] - c[1])^2 + (d[2] - c[2])^2 = geo::distance_sq(d, c)
    geo::distance_sq(a, b) = geo::distance_sq(d, c)
    release thm geo::distance_sq_symmetric(a, b)
    release thm geo::distance_sq_symmetric(d, c)
    geo::distance_sq(b, a) = geo::distance_sq(a, b) = geo::distance_sq(d, c) = geo::distance_sq(c, d)
    geo::distance_sq(b, a) = geo::distance_sq(c, d)

    # The midpoint of BC is also the midpoint of AD.
    release thm geo::add_equalities(b[1] - a[1], d[1] - c[1], a[1] + c[1], a[1] + c[1])
    (b[1] - a[1]) + (a[1] + c[1]) = (d[1] - c[1]) + (a[1] + c[1])
    (b[1] - a[1]) + (a[1] + c[1]) = b[1] + c[1]
    (d[1] - c[1]) + (a[1] + c[1]) = a[1] + d[1]
    b[1] + c[1] = a[1] + d[1]
    (b[1] + c[1]) / 2 = (a[1] + d[1]) / 2
    m[1] = (a[1] + d[1]) / 2

    release thm geo::add_equalities(b[2] - a[2], d[2] - c[2], a[2] + c[2], a[2] + c[2])
    (b[2] - a[2]) + (a[2] + c[2]) = (d[2] - c[2]) + (a[2] + c[2])
    (b[2] - a[2]) + (a[2] + c[2]) = b[2] + c[2]
    (d[2] - c[2]) + (a[2] + c[2]) = a[2] + d[2]
    b[2] + c[2] = a[2] + d[2]
    (b[2] + c[2]) / 2 = (a[2] + d[2]) / 2
    m[2] = (a[2] + d[2]) / 2

    release thm tuple_equal_from_coordinates(m, (m[1], m[2]))
    (m[1], m[2]) = ((a[1] + d[1]) / 2, (a[2] + d[2]) / 2)
    m = (m[1], m[2]) = ((a[1] + d[1]) / 2, (a[2] + d[2]) / 2)
    by def $geo::is_midpoint(m, a, d)
    release thm geo::midpoint_equidistant(a, d, m)
    geo::distance_sq(a, m) = geo::distance_sq(d, m)

    # The original midpoint gives BM = CM.
    release thm geo::midpoint_equidistant(b, c, m)
    geo::distance_sq(b, m) = geo::distance_sq(c, m)

    # SSS for triangles BAM and CDM gives the target included-angle dot product.
    release thm geo::sss_dot_equal(b, a, m, c, d, m)
    geo::dot(geo::vec(a, b), geo::vec(a, m)) = geo::dot(geo::vec(d, c), geo::vec(d, m))

    # Convert the SAS metric conclusions to the library's undirected-angle predicate.
    geo::angle_cos_num(b, a, m) = geo::dot(geo::vec(a, b), geo::vec(a, m))
    geo::angle_cos_num(c, d, m) = geo::dot(geo::vec(d, c), geo::vec(d, m))
    geo::angle_cos_num(b, a, m) = geo::angle_cos_num(c, d, m)

    geo::angle_cos_den(b, a, m) = geo::distance_sq(a, b) * geo::distance_sq(a, m)
    geo::angle_cos_den(c, d, m) = geo::distance_sq(d, c) * geo::distance_sq(d, m)
    release thm geo::product_of_equal_factors(geo::distance_sq(a, b), geo::distance_sq(d, c), geo::distance_sq(a, m), geo::distance_sq(d, m))
    geo::distance_sq(a, b) * geo::distance_sq(a, m) = geo::distance_sq(d, c) * geo::distance_sq(d, m)
    geo::angle_cos_den(b, a, m) = geo::angle_cos_den(c, d, m)

    geo::angle_cos_num(b, a, m)^2 * geo::angle_cos_den(c, d, m) = geo::angle_cos_num(c, d, m)^2 * geo::angle_cos_den(b, a, m)
    geo::angle_cos_num(c, d, m) = geo::angle_cos_num(b, a, m)
    release thm geo::multiply_both_sides(geo::angle_cos_num(c, d, m), geo::angle_cos_num(b, a, m), geo::angle_cos_num(b, a, m))
    geo::angle_cos_num(c, d, m) * geo::angle_cos_num(b, a, m) = geo::angle_cos_num(b, a, m) * geo::angle_cos_num(b, a, m)
    geo::angle_cos_num(b, a, m) * geo::angle_cos_num(c, d, m) = geo::angle_cos_num(c, d, m) * geo::angle_cos_num(b, a, m) = geo::angle_cos_num(b, a, m) * geo::angle_cos_num(b, a, m) = geo::angle_cos_num(b, a, m)^2
    geo::angle_cos_num(b, a, m)^2 >= 0
    geo::angle_cos_num(b, a, m) * geo::angle_cos_num(c, d, m) >= 0
    by def $geo::are_angles_congruent(b, a, m, c, d, m)
