# Problem 233 / zhongkao_29 — semantic geometry translation
#
# 原题：四边形 ABCD 中，AB=AD，∠BAD=120°，∠ABC=∠ADC=90°；
# E、F 分别在线段 BC、CD 上，且 ∠EAF=60°。证明 EF=BE+DF。
#
# 原题层只使用公共 KB 已有的几何谓词：线段等长、角相等、直角、在线段上。
# 120°、60° 分别通过与固定参考角全等来表达。
# `problem_233_coordinate_certificate` 仅供坐标证明核心使用，不是原题题设。

prop problem_233_configuration(a, b, c, d, ep, f cart(R, R)):
    $geo::are_segments_congruent(a, b, a, d)
    $geo::are_angles_congruent(b, a, d, (1, 0), (0, 0), (-1 / 2, sqrt(3) / 2))
    $geo::is_right_angle(a, b, c)
    $geo::is_right_angle(a, d, c)
    $geo::is_on_segment(ep, b, c)
    $geo::is_on_segment(f, c, d)
    $geo::are_angles_congruent(ep, a, f, (1, 0), (0, 0), (1 / 2, sqrt(3) / 2))

# 技术性坐标证书：仅供已验证的坐标代数核心使用。
prop problem_233_coordinate_certificate(s, x, y R, a, b, c, d, ep, f cart(R, R)):
    s > 0
    0 <= x
    x <= sqrt(3) * s
    0 <= y
    y <= sqrt(3) * s
    a = (0, 0)
    b = (s, 0)
    d = (-s / 2, sqrt(3) * s / 2)
    c = (s, sqrt(3) * s)
    ep = (s, x)
    f = (-s / 2 + sqrt(3) * y / 2, sqrt(3) * s / 2 + y / 2)
    geo::det(geo::vec(a, ep), geo::vec(a, f)) = sqrt(3) * geo::dot(geo::vec(a, ep), geo::vec(a, f))
    geo::dot(geo::vec(a, ep), geo::vec(a, f)) > 0
    geo::det(geo::vec(a, ep), geo::vec(a, f)) > 0

prop problem_233_length_sum(b, d, ep, f cart(R, R)):
    geo::distance_sq(ep, f) >= 0
    geo::distance_sq(b, ep) >= 0
    geo::distance_sq(d, f) >= 0
    sqrt(geo::distance_sq(ep, f)) = sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f))
