# Problem 1150 / zhongkao_976
# Universal coordinate proof with the figure-implied order E in DB and F in BD.

thm nonnegative_equal_of_equal_squares:
    ? forall x, y R:
        x >= 0
        y >= 0
        x^2 = y^2
        =>:
            x = y
    y = 0 or not y = 0
    by cases:
        ? x = y
        case y = 0:
            y^2 = 0
            x^2 = 0
            x = 0
            x = y
        case not y = 0:
            by contra:
                ? y > 0
                y <= 0
                y >= 0
                y = 0
                impossible y != 0
            y > 0
            x^2 - y^2 = 0
            (x - y) * (x + y) = 0
            x + y > 0
            x + y != 0
            x - y = 0
            x = y

thm parallelogram_coordinate_closure:
    ? forall a, b, c, d cart(R, R):
        $geo::is_parallelogram(a, b, c, d)
        $geo::is_triangle(a, b, d)
        =>:
            d[1] = a[1] + c[1] - b[1]
            d[2] = a[2] + c[2] - b[2]

    by def $geo::is_parallelogram(a, b, c, d)
    by def $geo::is_parallel(a, b, d, c)
    by def $geo::is_parallel(a, d, b, c)
    by def $geo::is_triangle(a, b, d)
    by thm geo::triangle_det_nonzero(a, b, d)

    by thm geo::collinear_det_expand(a, b, (a[1] + c[1] - d[1], a[2] + c[2] - d[2]))
    by thm geo::collinear_det_expand(a, d, (a[1] + c[1] - b[1], a[2] + c[2] - b[2]))
    by thm geo::collinear_det_expand(d, c, b)
    by thm geo::collinear_det_expand(b, c, d)

    geo::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    geo::vec(a, d) = (d[1] - a[1], d[2] - a[2])
    geo::vec(d, c) = (c[1] - d[1], c[2] - d[2])
    geo::vec(b, c) = (c[1] - b[1], c[2] - b[2])
    geo::det(geo::vec(a, b), geo::vec(d, c)) = (b[1] - a[1]) * (c[2] - d[2]) - (b[2] - a[2]) * (c[1] - d[1])
    geo::det(geo::vec(a, d), geo::vec(b, c)) = (d[1] - a[1]) * (c[2] - b[2]) - (d[2] - a[2]) * (c[1] - b[1])

    (b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1]) = 0
    (d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1]) = 0

    geo::det(geo::vec(a, b), geo::vec(a, d)) = (b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])

    (d[1] - a[1]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (b[1] - a[1]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[1] - a[1]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[1] - a[1]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[1] - a[1]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[1] - a[1]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = (a[1] + c[1] - b[1] - d[1]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1]))
    (a[1] + c[1] - b[1] - d[1]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])) = (a[1] + c[1] - b[1] - d[1]) * geo::det(geo::vec(a, b), geo::vec(a, d))
    (a[1] + c[1] - b[1] - d[1]) * geo::det(geo::vec(a, b), geo::vec(a, d)) = 0
    a[1] + c[1] - b[1] - d[1] = 0
    d[1] = a[1] + c[1] - b[1]

    (d[2] - a[2]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (b[2] - a[2]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[2] - a[2]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[2] - a[2]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[2] - a[2]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[2] - a[2]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = (a[2] + c[2] - b[2] - d[2]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1]))
    (a[2] + c[2] - b[2] - d[2]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])) = (a[2] + c[2] - b[2] - d[2]) * geo::det(geo::vec(a, b), geo::vec(a, d))
    (a[2] + c[2] - b[2] - d[2]) * geo::det(geo::vec(a, b), geo::vec(a, d)) = 0
    a[2] + c[2] - b[2] - d[2] = 0
    d[2] = a[2] + c[2] - b[2]

thm problem_1150_AE_eq_CF:
    ? forall a, b, c, d, ep, f cart(R, R):
        $geo::is_parallelogram(a, b, c, d)
        $geo::is_triangle(a, b, d)
        $geo::is_on_segment(ep, d, b)
        $geo::is_on_segment(f, b, d)
        $geo::are_segments_congruent(d, ep, b, f)
        =>:
            $geo::are_segments_congruent(a, ep, c, f)

    by def $geo::is_on_segment(ep, d, b)
    obtain t from exist t0 R st {0 <= t0, t0 <= 1, ep = (d[1] + t0 * (b[1] - d[1]), d[2] + t0 * (b[2] - d[2]))}
    by def $geo::is_on_segment(f, b, d)
    obtain s from exist s0 R st {0 <= s0, s0 <= 1, f = (b[1] + s0 * (d[1] - b[1]), b[2] + s0 * (d[2] - b[2]))}

    ep[1] = d[1] + t * (b[1] - d[1])
    ep[2] = d[2] + t * (b[2] - d[2])
    f[1] = b[1] + s * (d[1] - b[1])
    f[2] = b[2] + s * (d[2] - b[2])

    by thm geo::affine_distance_from_parameter(d, b, ep, t)
    by thm geo::affine_distance_from_parameter(b, d, f, s)
    by thm geo::distance_sq_symmetric(d, ep)
    by thm geo::distance_sq_symmetric(b, f)
    by def $geo::are_segments_congruent(d, ep, b, f)
    geo::distance_sq(d, ep) = geo::distance_sq(ep, d) = t^2 * geo::distance_sq(d, b)
    geo::distance_sq(b, f) = geo::distance_sq(f, b) = s^2 * geo::distance_sq(b, d)
    geo::distance_sq(d, ep) = geo::distance_sq(b, f)
    t^2 * geo::distance_sq(d, b) = geo::distance_sq(d, ep) = geo::distance_sq(b, f) = s^2 * geo::distance_sq(b, d)
    by thm geo::distance_sq_symmetric(d, b)
    s^2 * geo::distance_sq(b, d) = s^2 * geo::distance_sq(d, b)
    t^2 * geo::distance_sq(d, b) = s^2 * geo::distance_sq(d, b)

    by def $geo::is_triangle(a, b, d)
    by thm geo::triangle_det_nonzero(a, b, d)
    b != d
    by thm geo::distance_sq_positive_of_ne(d, b)
    geo::distance_sq(d, b) > 0
    by thm geo::cancel_positive_right_factor(t^2, s^2, geo::distance_sq(d, b))
    t^2 = s^2
    by thm nonnegative_equal_of_equal_squares(t, s)
    t = s

    by thm parallelogram_coordinate_closure(a, b, c, d)
    d[1] = a[1] + c[1] - b[1]
    d[2] = a[2] + c[2] - b[2]

    ep[1] + f[1] = d[1] + t * (b[1] - d[1]) + b[1] + s * (d[1] - b[1])
    d[1] + t * (b[1] - d[1]) + b[1] + s * (d[1] - b[1]) = d[1] + t * (b[1] - d[1]) + b[1] + t * (d[1] - b[1])
    d[1] + t * (b[1] - d[1]) + b[1] + t * (d[1] - b[1]) = b[1] + d[1]
    b[1] + d[1] = b[1] + (a[1] + c[1] - b[1])
    b[1] + (a[1] + c[1] - b[1]) = a[1] + c[1]
    ep[2] + f[2] = d[2] + t * (b[2] - d[2]) + b[2] + s * (d[2] - b[2])
    d[2] + t * (b[2] - d[2]) + b[2] + s * (d[2] - b[2]) = d[2] + t * (b[2] - d[2]) + b[2] + t * (d[2] - b[2])
    d[2] + t * (b[2] - d[2]) + b[2] + t * (d[2] - b[2]) = b[2] + d[2]
    b[2] + d[2] = b[2] + (a[2] + c[2] - b[2])
    b[2] + (a[2] + c[2] - b[2]) = a[2] + c[2]
    ep[1] + f[1] = a[1] + c[1]
    ep[1] + f[1] - f[1] = a[1] + c[1] - f[1]
    ep[1] = a[1] + c[1] - f[1]
    ep[1] - a[1] = (a[1] + c[1] - f[1]) - a[1]
    (a[1] + c[1] - f[1]) - a[1] = c[1] - f[1]
    ep[2] + f[2] = a[2] + c[2]
    ep[2] + f[2] - f[2] = a[2] + c[2] - f[2]
    ep[2] = a[2] + c[2] - f[2]
    ep[2] - a[2] = (a[2] + c[2] - f[2]) - a[2]
    (a[2] + c[2] - f[2]) - a[2] = c[2] - f[2]

    by thm geo::distance_sq_coordinate_formula(a, ep)
    by thm geo::distance_sq_coordinate_formula(c, f)
    geo::distance_sq(a, ep) = (ep[1] - a[1])^2 + (ep[2] - a[2])^2
    geo::distance_sq(c, f) = (f[1] - c[1])^2 + (f[2] - c[2])^2
    (ep[1] - a[1])^2 = (c[1] - f[1])^2 = (f[1] - c[1])^2
    (ep[2] - a[2])^2 = (c[2] - f[2])^2 = (f[2] - c[2])^2
    geo::distance_sq(a, ep) = (ep[1] - a[1])^2 + (ep[2] - a[2])^2
    (ep[1] - a[1])^2 + (ep[2] - a[2])^2 = (f[1] - c[1])^2 + (ep[2] - a[2])^2
    (f[1] - c[1])^2 + (ep[2] - a[2])^2 = (f[1] - c[1])^2 + (f[2] - c[2])^2
    (f[1] - c[1])^2 + (f[2] - c[2])^2 = geo::distance_sq(c, f)
    geo::distance_sq(a, ep) = geo::distance_sq(c, f)
    by def $geo::are_segments_congruent(a, ep, c, f)
