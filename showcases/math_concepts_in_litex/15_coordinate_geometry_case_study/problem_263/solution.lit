    ((b[2] - a[2]) + s * (d[2] - a[2])) - (((1 + t) / 2) * (b[2] - a[2]) + (t / 2) * (d[2] - a[2])) = ((1 - t) / 2) * (b[2] - a[2]) + (s - t / 2) * (d[2] - a[2])
    m[2] - f[2] = ((1 - t) / 2) * (b[2] - a[2]) + (s - t / 2) * (d[2] - a[2])
    s * (1 + t) = t
    s * (1 + t) = s + s * t
    s + s * t = t
    release thm geo::subtract_equalities(s + s * t, t, s * t, s * t)
    (s + s * t) - s * t = t - s * t
    (s + s * t) - s * t = s
    s = t - s * t
    release thm geo::subtract_equalities(s, t - s * t, t, t)
    s - t = (t - s * t) - t
    (t - s * t) - t = -s * t
    s - t = -s * t
    release thm geo::add_equalities(s, s, s - t, -s * t)
    s + (s - t) = s + (-s * t)
    s + (s - t) = 2 * s - t
    s + (-s * t) = s - s * t
    2 * s - t = s - s * t
    release thm geo::multiply_both_sides(2 * s - t, s - s * t, 1 / 2)
    (2 * s - t) * (1 / 2) = (s - s * t) * (1 / 2)
    (2 * s - t) * (1 / 2) = s - t / 2
    (s - s * t) * (1 / 2) = ((1 - t) / 2) * s
    s - t / 2 = ((1 - t) / 2) * s
    release thm geo::multiply_both_sides(m[1] - a[1], (b[1] - a[1]) + s * (d[1] - a[1]), (1 - t) / 2)
    (m[1] - a[1]) * ((1 - t) / 2) = ((b[1] - a[1]) + s * (d[1] - a[1])) * ((1 - t) / 2)
    ((1 - t) / 2) * (m[1] - a[1]) = (m[1] - a[1]) * ((1 - t) / 2)
    ((b[1] - a[1]) + s * (d[1] - a[1])) * ((1 - t) / 2) = ((1 - t) / 2) * (b[1] - a[1]) + (((1 - t) / 2) * s) * (d[1] - a[1])
    ((1 - t) / 2) * (m[1] - a[1]) = ((1 - t) / 2) * (b[1] - a[1]) + (((1 - t) / 2) * s) * (d[1] - a[1])
    release thm geo::multiply_both_sides(m[2] - a[2], (b[2] - a[2]) + s * (d[2] - a[2]), (1 - t) / 2)
    (m[2] - a[2]) * ((1 - t) / 2) = ((b[2] - a[2]) + s * (d[2] - a[2])) * ((1 - t) / 2)
    ((1 - t) / 2) * (m[2] - a[2]) = (m[2] - a[2]) * ((1 - t) / 2)
    ((b[2] - a[2]) + s * (d[2] - a[2])) * ((1 - t) / 2) = ((1 - t) / 2) * (b[2] - a[2]) + (((1 - t) / 2) * s) * (d[2] - a[2])
    ((1 - t) / 2) * (m[2] - a[2]) = ((1 - t) / 2) * (b[2] - a[2]) + (((1 - t) / 2) * s) * (d[2] - a[2])
    release thm geo::multiply_both_sides(s - t / 2, ((1 - t) / 2) * s, d[1] - a[1])
    (s - t / 2) * (d[1] - a[1]) = (((1 - t) / 2) * s) * (d[1] - a[1])
    release thm geo::add_equalities(((1 - t) / 2) * (b[1] - a[1]), ((1 - t) / 2) * (b[1] - a[1]), (s - t / 2) * (d[1] - a[1]), (((1 - t) / 2) * s) * (d[1] - a[1]))
    ((1 - t) / 2) * (b[1] - a[1]) + (s - t / 2) * (d[1] - a[1]) = ((1 - t) / 2) * (b[1] - a[1]) + (((1 - t) / 2) * s) * (d[1] - a[1])
    m[1] - f[1] = ((1 - t) / 2) * (b[1] - a[1]) + (((1 - t) / 2) * s) * (d[1] - a[1])
    ((1 - t) / 2) * (b[1] - a[1]) + (((1 - t) / 2) * s) * (d[1] - a[1]) = ((1 - t) / 2) * (m[1] - a[1])
    m[1] - f[1] = ((1 - t) / 2) * (m[1] - a[1])
    release thm geo::multiply_both_sides(s - t / 2, ((1 - t) / 2) * s, d[2] - a[2])
    (s - t / 2) * (d[2] - a[2]) = (((1 - t) / 2) * s) * (d[2] - a[2])
    release thm geo::add_equalities(((1 - t) / 2) * (b[2] - a[2]), ((1 - t) / 2) * (b[2] - a[2]), (s - t / 2) * (d[2] - a[2]), (((1 - t) / 2) * s) * (d[2] - a[2]))
    ((1 - t) / 2) * (b[2] - a[2]) + (s - t / 2) * (d[2] - a[2]) = ((1 - t) / 2) * (b[2] - a[2]) + (((1 - t) / 2) * s) * (d[2] - a[2])
    m[2] - f[2] = ((1 - t) / 2) * (b[2] - a[2]) + (((1 - t) / 2) * s) * (d[2] - a[2])
    ((1 - t) / 2) * (b[2] - a[2]) + (((1 - t) / 2) * s) * (d[2] - a[2]) = ((1 - t) / 2) * (m[2] - a[2])
    m[2] - f[2] = ((1 - t) / 2) * (m[2] - a[2])

    release thm geo::distance_sq_coordinate_formula(a, m)
    release thm geo::distance_sq_coordinate_formula(a, p)
    geo::distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
    geo::distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2
    release thm geo::square_of_equal(m[1] - a[1], (b[1] - a[1]) + s * (d[1] - a[1]))
    (m[1] - a[1])^2 = ((b[1] - a[1]) + s * (d[1] - a[1]))^2
    release thm geo::square_of_equal(m[2] - a[2], (b[2] - a[2]) + s * (d[2] - a[2]))
    (m[2] - a[2])^2 = ((b[2] - a[2]) + s * (d[2] - a[2]))^2
    release thm geo::add_equalities((m[1] - a[1])^2, ((b[1] - a[1]) + s * (d[1] - a[1]))^2, (m[2] - a[2])^2, ((b[2] - a[2]) + s * (d[2] - a[2]))^2)
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = ((b[1] - a[1]) + s * (d[1] - a[1]))^2 + ((b[2] - a[2]) + s * (d[2] - a[2]))^2
    ((b[1] - a[1]) + s * (d[1] - a[1]))^2 + ((b[2] - a[2]) + s * (d[2] - a[2]))^2 = ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * s * ((b[1] - a[1]) * (d[1] - a[1]) + (b[2] - a[2]) * (d[2] - a[2]))
    ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * s * ((b[1] - a[1]) * (d[1] - a[1]) + (b[2] - a[2]) * (d[2] - a[2])) = ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * s * 0
    ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * s * 0 = ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2)
    ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    ((b[1] - a[1])^2 + (b[2] - a[2])^2) + s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = (1 + s^2) * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    (1 + s^2) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = (1 + s^2) * geo::distance_sq(a, b)
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = (1 + s^2) * geo::distance_sq(a, b)
    1 - q = -s
    release thm geo::square_of_equal(1 - q, -s)
    (1 - q)^2 = (-s)^2
    (-s)^2 = s^2
    (1 - q)^2 = s^2
    release thm geo::square_of_equal(p[1] - a[1], (1 - q) * (b[1] - a[1]) + (d[1] - a[1]))
    (p[1] - a[1])^2 = ((1 - q) * (b[1] - a[1]) + (d[1] - a[1]))^2
    release thm geo::square_of_equal(p[2] - a[2], (1 - q) * (b[2] - a[2]) + (d[2] - a[2]))
    (p[2] - a[2])^2 = ((1 - q) * (b[2] - a[2]) + (d[2] - a[2]))^2
    release thm geo::add_equalities((p[1] - a[1])^2, ((1 - q) * (b[1] - a[1]) + (d[1] - a[1]))^2, (p[2] - a[2])^2, ((1 - q) * (b[2] - a[2]) + (d[2] - a[2]))^2)
    (p[1] - a[1])^2 + (p[2] - a[2])^2 = ((1 - q) * (b[1] - a[1]) + (d[1] - a[1]))^2 + ((1 - q) * (b[2] - a[2]) + (d[2] - a[2]))^2
    ((1 - q) * (b[1] - a[1]) + (d[1] - a[1]))^2 + ((1 - q) * (b[2] - a[2]) + (d[2] - a[2]))^2 = (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * (1 - q) * ((b[1] - a[1]) * (d[1] - a[1]) + (b[2] - a[2]) * (d[2] - a[2]))
    (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * (1 - q) * ((b[1] - a[1]) * (d[1] - a[1]) + (b[2] - a[2]) * (d[2] - a[2])) = (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * (1 - q) * 0
    (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((d[1] - a[1])^2 + (d[2] - a[2])^2) + 2 * (1 - q) * 0 = (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((d[1] - a[1])^2 + (d[2] - a[2])^2)
    (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((d[1] - a[1])^2 + (d[2] - a[2])^2) = (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    release thm geo::multiply_both_sides((1 - q)^2, s^2, (b[1] - a[1])^2 + (b[2] - a[2])^2)
    (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    release thm geo::add_equalities((1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2), s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2), (b[1] - a[1])^2 + (b[2] - a[2])^2, (b[1] - a[1])^2 + (b[2] - a[2])^2)
    (1 - q)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((b[1] - a[1])^2 + (b[2] - a[2])^2) = s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + ((b[1] - a[1])^2 + (b[2] - a[2])^2) = (1 + s^2) * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    (1 + s^2) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = (1 + s^2) * geo::distance_sq(a, b)
    (p[1] - a[1])^2 + (p[2] - a[2])^2 = (1 + s^2) * geo::distance_sq(a, b)
    geo::distance_sq(a, m) = geo::distance_sq(a, p)

thm problem_263:
    ? forall a, b, c, d, ep, f, m, p cart(R, R):
        $geo::is_square(a, b, c, d)
        $geo::is_on_segment(ep, a, c)
        $geo::are_segments_congruent(a, ep, b, c)
        $geo::is_foot(f, a, b, ep)
        $geo::is_on_extension(m, a, f)
        $geo::is_on_line(m, b, c)
        $geo::is_perpendicular(a, p, a, m)
        $geo::is_on_extension(p, c, d)
        =>:
            sqrt(geo::distance_sq(a, p)) - 2 * sqrt(geo::distance_sq(f, m)) = sqrt(geo::distance_sq(b, ep))

    # 展开正方形定义，取得平行四边形、直角和邻边等长条件。
    by def $geo::is_square(a, b, c, d)
    by def $geo::is_rectangle(a, b, c, d)
    by def $geo::is_parallelogram(a, b, c, d)
    by def $geo::is_foot(f, a, b, ep)
    by def $geo::is_on_segment(ep, a, c)
    by def $geo::is_on_extension(m, a, f)
    by def $geo::is_on_line(m, b, c)
    by def $geo::is_on_extension(p, c, d)

    # 第一块：由 E 在线段 AC 上及 AE=BC，取得正参数 t，并证明 2t²=1。
    obtain t from exist t0 R st {0 <= t0, t0 <= 1, ep = (a[1] + t0 * (c[1] - a[1]), a[2] + t0 * (c[2] - a[2]))}
    ep[1] = a[1] + t * (c[1] - a[1])
    ep[2] = a[2] + t * (c[2] - a[2])
    release thm geo::affine_distance_from_parameter(a, c, ep, t)
    release thm geo::distance_sq_symmetric(ep, a)
    geo::distance_sq(a, ep) = geo::distance_sq(ep, a) = t^2 * geo::distance_sq(a, c)

    by def $geo::are_segments_congruent(a, ep, b, c)
    by def $geo::are_segments_congruent(a, b, b, c)
    geo::distance_sq(a, ep) = geo::distance_sq(b, c)
    geo::distance_sq(a, b) = geo::distance_sq(b, c)
    geo::distance_sq(a, ep) = geo::distance_sq(a, b)

    release thm geo::square_diagonal_length(a, b, c, d, geo::distance_sq(a, b))
    geo::distance_sq(a, c) = 2 * geo::distance_sq(a, b)
    t^2 * geo::distance_sq(a, c) = t^2 * (2 * geo::distance_sq(a, b))
    geo::distance_sq(a, b) = t^2 * (2 * geo::distance_sq(a, b))

    by def $geo::is_parallel(a, b, d, c)
    a != b
    release thm geo::distance_sq_positive_of_ne(a, b)
    geo::distance_sq(a, b) > 0
    geo::distance_sq(a, b) != 0
    release thm geo::subtract_equalities(geo::distance_sq(a, b), t^2 * (2 * geo::distance_sq(a, b)), geo::distance_sq(a, b), geo::distance_sq(a, b))
    geo::distance_sq(a, b) - geo::distance_sq(a, b) = t^2 * (2 * geo::distance_sq(a, b)) - geo::distance_sq(a, b)
    0 = t^2 * (2 * geo::distance_sq(a, b)) - geo::distance_sq(a, b)
    geo::distance_sq(a, b) * (2 * t^2 - 1) = t^2 * (2 * geo::distance_sq(a, b)) - geo::distance_sq(a, b) = 0
    release thm geo::zero_factor_law(geo::distance_sq(a, b), 2 * t^2 - 1)
    2 * t^2 - 1 = 0
    2 * t^2 = 1
    t^2 > 0
    by contra:
        ? t != 0
        t = 0
        t^2 = 0
        2 * t^2 = 0
        impossible 2 * t^2 = 1
    t != 0
    by contra:
        ? t > 0
        t <= 0
        t >= 0
        t = 0
        impossible t != 0
    t > 0

    # 垂足 F 在线段 BE 所在直线上，且 AF⊥BE；等腰垂足引理给出 F 为 BE 中点。
    release thm geo::on_line_implies_affine_parameter(b, ep, f)
    obtain r from exist r0 R st {f[1] = (1 - r0) * b[1] + r0 * ep[1], f[2] = (1 - r0) * b[2] + r0 * ep[2]}
    by def $geo::is_perpendicular(a, f, b, ep)
    geo::dot(geo::vec(a, f), geo::vec(b, ep)) = 0
    release thm problem_263_isosceles_foot_midpoint_coordinates(a, b, ep, f, r)
    f[1] = (b[1] + ep[1]) / 2
    f[2] = (b[2] + ep[2]) / 2

    # M lies on the extension of AF and on line BC; P lies on the extension of CD.
    obtain u from exist u0 R st {u0 > 1
    m = (a[1] + u0 * (f[1] - a[1]), a[2] + u0 * (f[2] - a[2]))}
    m[1] = a[1] + u * (f[1] - a[1])
    m[2] = a[2] + u * (f[2] - a[2])
    release thm geo::on_line_implies_affine_parameter(b, c, m)
    obtain s from exist s0 R st {m[1] = (1 - s0) * b[1] + s0 * c[1], m[2] = (1 - s0) * b[2] + s0 * c[2]}
    obtain q from exist q0 R st {q0 > 1
    p = (c[1] + q0 * (d[1] - c[1]), c[2] + q0 * (d[2] - c[2]))}
    p[1] = c[1] + q * (d[1] - c[1])
    p[2] = c[2] + q * (d[2] - c[2])

    # Since AM is a scalar multiple of AF and AF is perpendicular to BE, AM is perpendicular to BE.
    release thm geo::vec_coordinate_formula(a, m)
    release thm geo::vec_coordinate_formula(a, f)
    release thm geo::vec_coordinate_formula(b, ep)
    release thm geo::dot_coordinate_formula(geo::vec(a, m), geo::vec(b, ep))
    release thm geo::dot_coordinate_formula(geo::vec(a, f), geo::vec(b, ep))
    geo::dot(geo::vec(a, m), geo::vec(b, ep)) = (m[1] - a[1]) * (ep[1] - b[1]) + (m[2] - a[2]) * (ep[2] - b[2])
    (m[1] - a[1]) * (ep[1] - b[1]) + (m[2] - a[2]) * (ep[2] - b[2]) = (u * (f[1] - a[1])) * (ep[1] - b[1]) + (u * (f[2] - a[2])) * (ep[2] - b[2])
    (u * (f[1] - a[1])) * (ep[1] - b[1]) + (u * (f[2] - a[2])) * (ep[2] - b[2]) = u * ((f[1] - a[1]) * (ep[1] - b[1]) + (f[2] - a[2]) * (ep[2] - b[2]))
    (f[1] - a[1]) * (ep[1] - b[1]) + (f[2] - a[2]) * (ep[2] - b[2]) = geo::dot(geo::vec(a, f), geo::vec(b, ep)) = 0
    u * ((f[1] - a[1]) * (ep[1] - b[1]) + (f[2] - a[2]) * (ep[2] - b[2])) = u * 0 = 0
    geo::dot(geo::vec(a, m), geo::vec(b, ep)) = 0

    # Expand AP perpendicular AM, and recover the standard square coordinate frame.
    by def $geo::is_perpendicular(a, p, a, m)
    geo::dot(geo::vec(a, p), geo::vec(a, m)) = 0
    by def $geo::is_parallel(a, d, b, c)
    by def $geo::is_right_angle(d, a, b)
    release thm geo::square_orthogonal_parallel_quadrilateral_coordinates(a, b, c, d)
    d[1] = a[1] + c[1] - b[1]
    d[2] = a[2] + c[2] - b[2]

    # Opposite sides of the parallelogram are equal; together with AB=BC this gives AB=AD.
    release thm geo::parallelogram_sides(a, b, c, d)
    geo::distance_sq(a, d) = geo::distance_sq(b, c)
    geo::distance_sq(a, b) = geo::distance_sq(a, d)

    # The local coordinate bridge now gives exactly the two vector ratios and AM=AP.
    release thm problem_263_square_intersection_coordinate_bridge(a, b, c, d, ep, f, m, p, t, s, q)
    ep[1] - b[1] = t * (p[1] - a[1])
    ep[2] - b[2] = t * (p[2] - a[2])
    m[1] - f[1] = ((1 - t) / 2) * (m[1] - a[1])
    m[2] - f[2] = ((1 - t) / 2) * (m[2] - a[2])
    geo::distance_sq(a, m) = geo::distance_sq(a, p)

    release thm problem_263_metric_from_coordinate_relations(a, b, ep, f, m, p, t)
    geo::distance_sq(b, ep) = t^2 * geo::distance_sq(a, p)
    geo::distance_sq(f, m) = ((1 - t) / 2)^2 * geo::distance_sq(a, p)

    release thm geo::distance_sq_nonnegative(a, p)
    release thm geo::distance_sq_nonnegative(f, m)
    release thm geo::distance_sq_nonnegative(b, ep)
    release thm problem_263_length_finish_from_squares(t, geo::distance_sq(a, p), geo::distance_sq(f, m), geo::distance_sq(b, ep))
    sqrt(geo::distance_sq(a, p)) - 2 * sqrt(geo::distance_sq(f, m)) = sqrt(geo::distance_sq(b, ep))
