# Problem 465 / zhongkao_264 — 第(2)问正式证明
#
# NL 原题：
# 如图，四边形ABCD内接于⊙O，AD、BC的延长线相交于E，AC、BD相交于F。
# G是AB上一点，GD交AC于H，且AB=AC，BG=DG。
# 证明：AH²=HF·HC。
#
# 最终入口逐句使用公共geo谓词表达原题条件；以下坐标与标量helper
# 仅用于内部证明，不替代原题的几何契约。
#
# Uniqueness of coefficients in a nondegenerate 2D basis.

thm basis_coefficient_unique:
    ? forall u, v, p cart(R, R), a, b, c, d R:
        geo::det(u, v) != 0
        p = (a * u[1] + b * v[1], a * u[2] + b * v[2])
        p = (c * u[1] + d * v[1], c * u[2] + d * v[2])
        =>:
            a = c
            b = d
    p[1] = a * u[1] + b * v[1]
    p[1] = c * u[1] + d * v[1]
    a * u[1] + b * v[1] = c * u[1] + d * v[1]
    p[2] = a * u[2] + b * v[2]
    p[2] = c * u[2] + d * v[2]
    a * u[2] + b * v[2] = c * u[2] + d * v[2]

    # Eliminate the v coefficient.
    release thm geo::multiply_both_sides(a * u[1] + b * v[1], c * u[1] + d * v[1], v[2])
    (a * u[1] + b * v[1]) * v[2] = (c * u[1] + d * v[1]) * v[2]
    release thm geo::multiply_both_sides(a * u[2] + b * v[2], c * u[2] + d * v[2], v[1])
    (a * u[2] + b * v[2]) * v[1] = (c * u[2] + d * v[2]) * v[1]
    release thm geo::subtract_equalities((a * u[1] + b * v[1]) * v[2], (c * u[1] + d * v[1]) * v[2], (a * u[2] + b * v[2]) * v[1], (c * u[2] + d * v[2]) * v[1])
    (a * u[1] + b * v[1]) * v[2] - (a * u[2] + b * v[2]) * v[1] = (c * u[1] + d * v[1]) * v[2] - (c * u[2] + d * v[2]) * v[1]
    (a * u[1] + b * v[1]) * v[2] - (a * u[2] + b * v[2]) * v[1] = a * (u[1] * v[2] - u[2] * v[1])
    (c * u[1] + d * v[1]) * v[2] - (c * u[2] + d * v[2]) * v[1] = c * (u[1] * v[2] - u[2] * v[1])
    a * (u[1] * v[2] - u[2] * v[1]) = c * (u[1] * v[2] - u[2] * v[1])
    release thm geo::det_coordinate_formula(u, v)
    geo::det(u, v) = u[1] * v[2] - u[2] * v[1]
    u[1] * v[2] - u[2] * v[1] != 0
    release thm geo::divide_both_sides(a, c, u[1] * v[2] - u[2] * v[1])
    a = c

    # Eliminate the u coefficient.
    release thm geo::multiply_both_sides(a * u[2] + b * v[2], c * u[2] + d * v[2], u[1])
    (a * u[2] + b * v[2]) * u[1] = (c * u[2] + d * v[2]) * u[1]
    release thm geo::multiply_both_sides(a * u[1] + b * v[1], c * u[1] + d * v[1], u[2])
    (a * u[1] + b * v[1]) * u[2] = (c * u[1] + d * v[1]) * u[2]
    release thm geo::subtract_equalities((a * u[2] + b * v[2]) * u[1], (c * u[2] + d * v[2]) * u[1], (a * u[1] + b * v[1]) * u[2], (c * u[1] + d * v[1]) * u[2])
    (a * u[2] + b * v[2]) * u[1] - (a * u[1] + b * v[1]) * u[2] = (c * u[2] + d * v[2]) * u[1] - (c * u[1] + d * v[1]) * u[2]
    (a * u[2] + b * v[2]) * u[1] - (a * u[1] + b * v[1]) * u[2] = b * (u[1] * v[2] - u[2] * v[1])
    (c * u[2] + d * v[2]) * u[1] - (c * u[1] + d * v[1]) * u[2] = d * (u[1] * v[2] - u[2] * v[1])
    b * (u[1] * v[2] - u[2] * v[1]) = d * (u[1] * v[2] - u[2] * v[1])
    release thm geo::det_coordinate_formula(u, v)
    geo::det(u, v) = u[1] * v[2] - u[2] * v[1]
    u[1] * v[2] - u[2] * v[1] != 0
    release thm geo::divide_both_sides(b, d, u[1] * v[2] - u[2] * v[1])
    b = d

# Scalar-coordinate form avoids constructing a synthetic tuple.
thm basis_coefficient_unique_coordinates:
    ? forall u, v cart(R, R), p1, p2, a, b, c, d R:
        geo::det(u, v) != 0
        p1 = a * u[1] + b * v[1]
        p2 = a * u[2] + b * v[2]
        p1 = c * u[1] + d * v[1]
        p2 = c * u[2] + d * v[2]
        =>:
            a = c
            b = d
    a * u[1] + b * v[1] = c * u[1] + d * v[1]
    a * u[2] + b * v[2] = c * u[2] + d * v[2]

    release thm geo::multiply_both_sides(a * u[1] + b * v[1], c * u[1] + d * v[1], v[2])
    (a * u[1] + b * v[1]) * v[2] = (c * u[1] + d * v[1]) * v[2]
    release thm geo::multiply_both_sides(a * u[2] + b * v[2], c * u[2] + d * v[2], v[1])
    (a * u[2] + b * v[2]) * v[1] = (c * u[2] + d * v[2]) * v[1]
    release thm geo::subtract_equalities((a * u[1] + b * v[1]) * v[2], (c * u[1] + d * v[1]) * v[2], (a * u[2] + b * v[2]) * v[1], (c * u[2] + d * v[2]) * v[1])
    (a * u[1] + b * v[1]) * v[2] - (a * u[2] + b * v[2]) * v[1] = (c * u[1] + d * v[1]) * v[2] - (c * u[2] + d * v[2]) * v[1]
    (a * u[1] + b * v[1]) * v[2] - (a * u[2] + b * v[2]) * v[1] = a * (u[1] * v[2] - u[2] * v[1])
    (c * u[1] + d * v[1]) * v[2] - (c * u[2] + d * v[2]) * v[1] = c * (u[1] * v[2] - u[2] * v[1])
    a * (u[1] * v[2] - u[2] * v[1]) = c * (u[1] * v[2] - u[2] * v[1])
    release thm geo::det_coordinate_formula(u, v)
    geo::det(u, v) = u[1] * v[2] - u[2] * v[1]
    u[1] * v[2] - u[2] * v[1] != 0
    release thm geo::divide_both_sides(a, c, u[1] * v[2] - u[2] * v[1])
    a = c

    release thm geo::multiply_both_sides(a * u[2] + b * v[2], c * u[2] + d * v[2], u[1])
    (a * u[2] + b * v[2]) * u[1] = (c * u[2] + d * v[2]) * u[1]
    release thm geo::multiply_both_sides(a * u[1] + b * v[1], c * u[1] + d * v[1], u[2])
    (a * u[1] + b * v[1]) * u[2] = (c * u[1] + d * v[1]) * u[2]
    release thm geo::subtract_equalities((a * u[2] + b * v[2]) * u[1], (c * u[2] + d * v[2]) * u[1], (a * u[1] + b * v[1]) * u[2], (c * u[1] + d * v[1]) * u[2])
    (a * u[2] + b * v[2]) * u[1] - (a * u[1] + b * v[1]) * u[2] = (c * u[2] + d * v[2]) * u[1] - (c * u[1] + d * v[1]) * u[2]
    (a * u[2] + b * v[2]) * u[1] - (a * u[1] + b * v[1]) * u[2] = b * (u[1] * v[2] - u[2] * v[1])
    (c * u[2] + d * v[2]) * u[1] - (c * u[1] + d * v[1]) * u[2] = d * (u[1] * v[2] - u[2] * v[1])
    b * (u[1] * v[2] - u[2] * v[1]) = d * (u[1] * v[2] - u[2] * v[1])
    release thm geo::det_coordinate_formula(u, v)
    geo::det(u, v) = u[1] * v[2] - u[2] * v[1]
    u[1] * v[2] - u[2] * v[1] != 0
    release thm geo::divide_both_sides(b, d, u[1] * v[2] - u[2] * v[1])
    b = d

# Problem 465 Part 2: coefficient equations at E and F.
thm part2_coefficient_bus_probe:
    ? forall a, b, c, d, ee, f, g, h cart(R, R), t, q, z, x, y, r, s R:
        geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
        g = (a[1] + t * (b[1] - a[1]), a[2] + t * (b[2] - a[2]))
        h[1] = (1 - q) * g[1] + q * d[1]
        h[2] = (1 - q) * g[2] + q * d[2]
        h[1] = (1 - z) * a[1] + z * c[1]
        h[2] = (1 - z) * a[2] + z * c[2]
        ee = (a[1] + r * (d[1] - a[1]), a[2] + r * (d[2] - a[2]))
        ee = (b[1] + s * (c[1] - b[1]), b[2] + s * (c[2] - b[2]))
        f[1] = (1 - x) * a[1] + x * c[1]
        f[2] = (1 - x) * a[2] + x * c[2]
        f[1] = (1 - y) * b[1] + y * d[1]
        f[2] = (1 - y) * b[2] + y * d[2]
        =>:
            q * (d[1] - a[1]) = z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])
            q * (d[2] - a[2]) = z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])
            r * (q - 1) * t = q * (1 - s)
            r * z = q * s
            q * (1 - y) + y * (q - 1) * t = 0
            q * x = y * z

    release thm geo::vec_coordinate_formula(a, b)
    release thm geo::vec_coordinate_formula(a, c)

    h[1] - g[1] = q * (d[1] - g[1])
    h[2] - g[2] = q * (d[2] - g[2])
    h[1] - a[1] = z * (c[1] - a[1])
    h[2] - a[2] = z * (c[2] - a[2])
    g[1] - a[1] = t * (b[1] - a[1])
    g[2] - a[2] = t * (b[2] - a[2])
    h[1] - g[1] = (h[1] - a[1]) - (g[1] - a[1])
    h[2] - g[2] = (h[2] - a[2]) - (g[2] - a[2])
    release thm geo::subtract_equalities(h[1] - a[1], z * (c[1] - a[1]), g[1] - a[1], t * (b[1] - a[1]))
    release thm geo::subtract_equalities(h[2] - a[2], z * (c[2] - a[2]), g[2] - a[2], t * (b[2] - a[2]))
    (h[1] - a[1]) - (g[1] - a[1]) = z * (c[1] - a[1]) - t * (b[1] - a[1])
    (h[2] - a[2]) - (g[2] - a[2]) = z * (c[2] - a[2]) - t * (b[2] - a[2])
    h[1] - g[1] = (h[1] - a[1]) - (g[1] - a[1]) = z * (c[1] - a[1]) - t * (b[1] - a[1])
    h[2] - g[2] = z * (c[2] - a[2]) - t * (b[2] - a[2])
    q * (d[1] - g[1]) = h[1] - g[1] = z * (c[1] - a[1]) - t * (b[1] - a[1])
    q * (d[2] - g[2]) = h[2] - g[2] = z * (c[2] - a[2]) - t * (b[2] - a[2])
    g[1] - a[1] = t * (b[1] - a[1])
    g[2] - a[2] = t * (b[2] - a[2])
    release thm geo::multiply_both_sides(g[1] - a[1], t * (b[1] - a[1]), q)
    release thm geo::multiply_both_sides(g[2] - a[2], t * (b[2] - a[2]), q)
    q * (g[1] - a[1]) = q * t * (b[1] - a[1])
    q * (g[2] - a[2]) = q * t * (b[2] - a[2])
    release thm geo::add_equalities(q * (d[1] - g[1]), z * (c[1] - a[1]) - t * (b[1] - a[1]), q * (g[1] - a[1]), q * t * (b[1] - a[1]))
    release thm geo::add_equalities(q * (d[2] - g[2]), z * (c[2] - a[2]) - t * (b[2] - a[2]), q * (g[2] - a[2]), q * t * (b[2] - a[2]))
    q * (d[1] - g[1]) + q * (g[1] - a[1]) = (z * (c[1] - a[1]) - t * (b[1] - a[1])) + q * t * (b[1] - a[1])
    q * (d[2] - g[2]) + q * (g[2] - a[2]) = (z * (c[2] - a[2]) - t * (b[2] - a[2])) + q * t * (b[2] - a[2])
    q * (d[1] - a[1]) = q * (d[1] - g[1]) + q * (g[1] - a[1])
    q * (d[2] - a[2]) = q * (d[2] - g[2]) + q * (g[2] - a[2])
    (z * (c[1] - a[1]) - t * (b[1] - a[1])) + q * t * (b[1] - a[1]) = z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])
    (z * (c[2] - a[2]) - t * (b[2] - a[2])) + q * t * (b[2] - a[2]) = z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])
    q * (d[1] - a[1]) = q * (d[1] - g[1]) + q * (g[1] - a[1]) = (z * (c[1] - a[1]) - t * (b[1] - a[1])) + q * t * (b[1] - a[1]) = z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])
    q * (d[2] - a[2]) = q * (d[2] - g[2]) + q * (g[2] - a[2]) = (z * (c[2] - a[2]) - t * (b[2] - a[2])) + q * t * (b[2] - a[2]) = z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])

    ee[1] = a[1] + r * (d[1] - a[1])
    ee[2] = a[2] + r * (d[2] - a[2])
    ee[1] - a[1] = r * (d[1] - a[1])
    ee[2] - a[2] = r * (d[2] - a[2])
    release thm geo::multiply_both_sides(ee[1] - a[1], r * (d[1] - a[1]), q)
    release thm geo::multiply_both_sides(ee[2] - a[2], r * (d[2] - a[2]), q)
    q * (ee[1] - a[1]) = q * (r * (d[1] - a[1]))
    q * (ee[2] - a[2]) = q * (r * (d[2] - a[2]))
    q * (r * (d[1] - a[1])) = r * (q * (d[1] - a[1]))
    q * (r * (d[2] - a[2])) = r * (q * (d[2] - a[2]))
    release thm geo::multiply_both_sides(q * (d[1] - a[1]), z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1]), r)
    release thm geo::multiply_both_sides(q * (d[2] - a[2]), z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2]), r)
    r * (q * (d[1] - a[1])) = r * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1]))
    r * (q * (d[2] - a[2])) = r * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2]))
    q * (ee[1] - a[1]) = r * (q * (d[1] - a[1]))
    q * (ee[2] - a[2]) = r * (q * (d[2] - a[2]))
    r * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])) = r * (q - 1) * t * geo::vec(a, b)[1] + r * z * geo::vec(a, c)[1]
    r * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])) = r * (q - 1) * t * geo::vec(a, b)[2] + r * z * geo::vec(a, c)[2]
    q * (ee[1] - a[1]) = r * (q - 1) * t * geo::vec(a, b)[1] + r * z * geo::vec(a, c)[1]
    q * (ee[2] - a[2]) = r * (q - 1) * t * geo::vec(a, b)[2] + r * z * geo::vec(a, c)[2]
    ee[1] - a[1] = (1 - s) * (b[1] - a[1]) + s * (c[1] - a[1])
    ee[2] - a[2] = (1 - s) * (b[2] - a[2]) + s * (c[2] - a[2])
    release thm geo::multiply_both_sides(ee[1] - a[1], (1 - s) * (b[1] - a[1]) + s * (c[1] - a[1]), q)
    release thm geo::multiply_both_sides(ee[2] - a[2], (1 - s) * (b[2] - a[2]) + s * (c[2] - a[2]), q)
    q * (ee[1] - a[1]) = q * ((1 - s) * (b[1] - a[1]) + s * (c[1] - a[1]))
    q * (ee[2] - a[2]) = q * ((1 - s) * (b[2] - a[2]) + s * (c[2] - a[2]))
    q * ((1 - s) * (b[1] - a[1]) + s * (c[1] - a[1])) = q * (1 - s) * geo::vec(a, b)[1] + q * s * geo::vec(a, c)[1]
    q * ((1 - s) * (b[2] - a[2]) + s * (c[2] - a[2])) = q * (1 - s) * geo::vec(a, b)[2] + q * s * geo::vec(a, c)[2]
    q * (ee[1] - a[1]) = q * (1 - s) * geo::vec(a, b)[1] + q * s * geo::vec(a, c)[1]
    q * (ee[2] - a[2]) = q * (1 - s) * geo::vec(a, b)[2] + q * s * geo::vec(a, c)[2]

    release thm basis_coefficient_unique_coordinates(geo::vec(a, b), geo::vec(a, c), q * (ee[1] - a[1]), q * (ee[2] - a[2]), r * (q - 1) * t, r * z, q * (1 - s), q * s)
    r * (q - 1) * t = q * (1 - s)
    r * z = q * s

    release thm geo::subtract_equalities(f[1], (1 - y) * b[1] + y * d[1], a[1], a[1])
    f[1] - a[1] = ((1 - y) * b[1] + y * d[1]) - a[1]
    ((1 - y) * b[1] + y * d[1]) - a[1] = (1 - y) * (b[1] - a[1]) + y * (d[1] - a[1])
    release thm geo::subtract_equalities(f[2], (1 - y) * b[2] + y * d[2], a[2], a[2])
    f[2] - a[2] = ((1 - y) * b[2] + y * d[2]) - a[2]
    ((1 - y) * b[2] + y * d[2]) - a[2] = (1 - y) * (b[2] - a[2]) + y * (d[2] - a[2])
    f[1] - a[1] = (1 - y) * (b[1] - a[1]) + y * (d[1] - a[1])
    f[2] - a[2] = (1 - y) * (b[2] - a[2]) + y * (d[2] - a[2])
    release thm geo::multiply_both_sides(f[1] - a[1], (1 - y) * (b[1] - a[1]) + y * (d[1] - a[1]), q)
    release thm geo::multiply_both_sides(f[2] - a[2], (1 - y) * (b[2] - a[2]) + y * (d[2] - a[2]), q)
    q * (f[1] - a[1]) = q * ((1 - y) * (b[1] - a[1]) + y * (d[1] - a[1]))
    q * (f[2] - a[2]) = q * ((1 - y) * (b[2] - a[2]) + y * (d[2] - a[2]))
    q * ((1 - y) * (b[1] - a[1]) + y * (d[1] - a[1])) = q * (1 - y) * geo::vec(a, b)[1] + y * (q * (d[1] - a[1]))
    q * ((1 - y) * (b[2] - a[2]) + y * (d[2] - a[2])) = q * (1 - y) * geo::vec(a, b)[2] + y * (q * (d[2] - a[2]))
    release thm geo::multiply_both_sides(q * (d[1] - a[1]), z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1]), y)
    release thm geo::multiply_both_sides(q * (d[2] - a[2]), z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2]), y)
    y * (q * (d[1] - a[1])) = y * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1]))
    y * (q * (d[2] - a[2])) = y * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2]))
    y * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])) = y * (q - 1) * t * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1]
    y * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])) = y * (q - 1) * t * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2]
    release thm geo::add_equalities(q * (1 - y) * geo::vec(a, b)[1], q * (1 - y) * geo::vec(a, b)[1], y * (q * (d[1] - a[1])), y * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])))
    q * (1 - y) * geo::vec(a, b)[1] + y * (q * (d[1] - a[1])) = q * (1 - y) * geo::vec(a, b)[1] + y * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1]))
    release thm geo::add_equalities(q * (1 - y) * geo::vec(a, b)[1], q * (1 - y) * geo::vec(a, b)[1], y * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])), y * (q - 1) * t * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1])
    q * (1 - y) * geo::vec(a, b)[1] + y * (z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])) = q * (1 - y) * geo::vec(a, b)[1] + (y * (q - 1) * t * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1])
    q * (1 - y) * geo::vec(a, b)[1] + (y * (q - 1) * t * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1]) = (q * (1 - y) + y * (q - 1) * t) * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1]
    q * (1 - y) * geo::vec(a, b)[1] + y * (q * (d[1] - a[1])) = (q * (1 - y) + y * (q - 1) * t) * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1]
    release thm geo::add_equalities(q * (1 - y) * geo::vec(a, b)[2], q * (1 - y) * geo::vec(a, b)[2], y * (q * (d[2] - a[2])), y * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])))
    q * (1 - y) * geo::vec(a, b)[2] + y * (q * (d[2] - a[2])) = q * (1 - y) * geo::vec(a, b)[2] + y * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2]))
    release thm geo::add_equalities(q * (1 - y) * geo::vec(a, b)[2], q * (1 - y) * geo::vec(a, b)[2], y * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])), y * (q - 1) * t * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2])
    q * (1 - y) * geo::vec(a, b)[2] + y * (z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])) = q * (1 - y) * geo::vec(a, b)[2] + (y * (q - 1) * t * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2])
    q * (1 - y) * geo::vec(a, b)[2] + (y * (q - 1) * t * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2]) = (q * (1 - y) + y * (q - 1) * t) * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2]
    q * (1 - y) * geo::vec(a, b)[2] + y * (q * (d[2] - a[2])) = (q * (1 - y) + y * (q - 1) * t) * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2]
    q * (f[1] - a[1]) = (q * (1 - y) + y * (q - 1) * t) * geo::vec(a, b)[1] + y * z * geo::vec(a, c)[1]
    q * (f[2] - a[2]) = (q * (1 - y) + y * (q - 1) * t) * geo::vec(a, b)[2] + y * z * geo::vec(a, c)[2]

    release thm geo::subtract_equalities(f[1], (1 - x) * a[1] + x * c[1], a[1], a[1])
    f[1] - a[1] = ((1 - x) * a[1] + x * c[1]) - a[1]
    ((1 - x) * a[1] + x * c[1]) - a[1] = x * (c[1] - a[1])
    release thm geo::subtract_equalities(f[2], (1 - x) * a[2] + x * c[2], a[2], a[2])
    f[2] - a[2] = ((1 - x) * a[2] + x * c[2]) - a[2]
    ((1 - x) * a[2] + x * c[2]) - a[2] = x * (c[2] - a[2])
    f[1] - a[1] = x * (c[1] - a[1])
    f[2] - a[2] = x * (c[2] - a[2])
    release thm geo::multiply_both_sides(f[1] - a[1], x * (c[1] - a[1]), q)
    release thm geo::multiply_both_sides(f[2] - a[2], x * (c[2] - a[2]), q)
    q * (f[1] - a[1]) = q * (x * (c[1] - a[1])) = 0 * geo::vec(a, b)[1] + q * x * geo::vec(a, c)[1]
    q * (f[2] - a[2]) = q * (x * (c[2] - a[2])) = 0 * geo::vec(a, b)[2] + q * x * geo::vec(a, c)[2]

    release thm basis_coefficient_unique_coordinates(geo::vec(a, b), geo::vec(a, c), q * (f[1] - a[1]), q * (f[2] - a[2]), q * (1 - y) + y * (q - 1) * t, y * z, 0, q * x)
    q * (1 - y) + y * (q - 1) * t = 0
    y * z = q * x
    q * x = y * z

# Local affine-parameter bridge copied from the verified geometry library source.
thm local_collinear_coordinates_imply_affine_parameter:
    ? forall a, b, p cart(R, R):
        a != b
        (p[1] - a[1]) * (b[2] - a[2]) - (p[2] - a[2]) * (b[1] - a[1]) = 0
        =>:
            exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}
    by cases:
        ? exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}
        case b[1] - a[1] != 0:
            witness exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]} from (p[1] - a[1]) / (b[1] - a[1]):
                ((p[1] - a[1]) / (b[1] - a[1])) * (b[1] - a[1]) = p[1] - a[1]
                p[1] = (1 - (p[1] - a[1]) / (b[1] - a[1])) * a[1] + ((p[1] - a[1]) / (b[1] - a[1])) * b[1]
                release thm geo::multiply_both_sides(((p[1] - a[1]) / (b[1] - a[1])) * (b[1] - a[1]), p[1] - a[1], b[2] - a[2])
                (((p[1] - a[1]) / (b[1] - a[1])) * (b[1] - a[1])) * (b[2] - a[2]) = (p[1] - a[1]) * (b[2] - a[2])
                (p[2] - a[2]) * (b[1] - a[1]) = (p[1] - a[1]) * (b[2] - a[2]) = (((p[1] - a[1]) / (b[1] - a[1])) * (b[1] - a[1])) * (b[2] - a[2]) = (((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2])) * (b[1] - a[1])
                release thm geo::divide_both_sides(p[2] - a[2], ((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2]), b[1] - a[1])
                p[2] - a[2] = ((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2])
                p[2] = (p[2] - a[2]) + a[2] = ((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2]) + a[2] = (1 - (p[1] - a[1]) / (b[1] - a[1])) * a[2] + ((p[1] - a[1]) / (b[1] - a[1])) * b[2]
        case b[1] - a[1] = 0:
            b[1] = a[1]
            by contra:
                ? b[2] - a[2] != 0
                b[2] - a[2] = 0
                b[2] = a[2]
                release thm tuple_equal_from_coordinates(a, (a[1], a[2]))
                release thm tuple_equal_from_coordinates(b, (b[1], b[2]))
                (a[1], a[2]) = (b[1], b[2])
                a = (a[1], a[2]) = (b[1], b[2]) = b
                impossible a != b
            witness exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]} from (p[2] - a[2]) / (b[2] - a[2]):
                (p[1] - a[1]) * (b[2] - a[2]) = (p[1] - a[1]) * (b[2] - a[2]) - (p[2] - a[2]) * (b[1] - a[1]) = 0 = 0 * (b[2] - a[2])
                release thm geo::divide_both_sides(p[1] - a[1], 0, b[2] - a[2])
                p[1] - a[1] = 0
                p[1] = a[1]
                p[1] = a[1] = (1 - (p[2] - a[2]) / (b[2] - a[2])) * a[1] + ((p[2] - a[2]) / (b[2] - a[2])) * a[1] = (1 - (p[2] - a[2]) / (b[2] - a[2])) * a[1] + ((p[2] - a[2]) / (b[2] - a[2])) * b[1]
                ((p[2] - a[2]) / (b[2] - a[2])) * (b[2] - a[2]) = p[2] - a[2]
                p[2] = (p[2] - a[2]) + a[2] = ((p[2] - a[2]) / (b[2] - a[2])) * (b[2] - a[2]) + a[2] = (1 - (p[2] - a[2]) / (b[2] - a[2])) * a[2] + ((p[2] - a[2]) / (b[2] - a[2])) * b[2]

thm local_on_line_implies_affine_parameter:
    ? forall a, b, p cart(R, R):
        $geo::is_on_line(p, a, b)
        =>:
            exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}
    by def $geo::is_on_line(p, a, b)
    a != b
    p $in geo::line_of(a, b)
    geo::det(geo::vec(a, p), geo::vec(a, b)) = 0
    release thm geo::collinear_det_expand(a, p, b)
    (p[1] - a[1]) * (b[2] - a[2]) - (p[2] - a[2]) * (b[1] - a[1]) = 0
    release thm local_collinear_coordinates_imply_affine_parameter(a, b, p)
    exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}

# Temporary probe: derive affine witnesses only from the original incidence predicates.

thm part2_affine_witness_probe:
    ? forall a, b, c, d, f, g, h cart(R, R):
        $geo::is_on_segment(g, a, b)
        $geo::is_on_line(h, g, d)
        $geo::is_on_line(h, a, c)
        $geo::is_on_line(f, a, c)
        $geo::is_on_line(f, b, d)
        =>:
            exist u, v, w, x, y R st {0 <= u, u <= 1, g = (a[1] + u * (b[1] - a[1]), a[2] + u * (b[2] - a[2])), h[1] = (1 - v) * g[1] + v * d[1], h[2] = (1 - v) * g[2] + v * d[2], h[1] = (1 - w) * a[1] + w * c[1], h[2] = (1 - w) * a[2] + w * c[2], f[1] = (1 - x) * a[1] + x * c[1], f[2] = (1 - x) * a[2] + x * c[2], f[1] = (1 - y) * b[1] + y * d[1], f[2] = (1 - y) * b[2] + y * d[2]}
    by def $geo::is_on_segment(g, a, b)
    obtain u_param from exist u0 R st {0 <= u0, u0 <= 1, g = (a[1] + u0 * (b[1] - a[1]), a[2] + u0 * (b[2] - a[2]))}

    release thm local_on_line_implies_affine_parameter(g, d, h)
    obtain v_param from exist v0 R st {h[1] = (1 - v0) * g[1] + v0 * d[1], h[2] = (1 - v0) * g[2] + v0 * d[2]}

    release thm local_on_line_implies_affine_parameter(a, c, h)
    obtain w_param from exist w0 R st {h[1] = (1 - w0) * a[1] + w0 * c[1], h[2] = (1 - w0) * a[2] + w0 * c[2]}

    release thm local_on_line_implies_affine_parameter(a, c, f)
    obtain x_param from exist x0 R st {f[1] = (1 - x0) * a[1] + x0 * c[1], f[2] = (1 - x0) * a[2] + x0 * c[2]}

    release thm local_on_line_implies_affine_parameter(b, d, f)
    obtain y_param from exist y0 R st {f[1] = (1 - y0) * b[1] + y0 * d[1], f[2] = (1 - y0) * b[2] + y0 * d[2]}

    witness exist u, v, w, x, y R st {0 <= u, u <= 1, g = (a[1] + u * (b[1] - a[1]), a[2] + u * (b[2] - a[2])), h[1] = (1 - v) * g[1] + v * d[1], h[2] = (1 - v) * g[2] + v * d[2], h[1] = (1 - w) * a[1] + w * c[1], h[2] = (1 - w) * a[2] + w * c[2], f[1] = (1 - x) * a[1] + x * c[1], f[2] = (1 - x) * a[2] + x * c[2], f[1] = (1 - y) * b[1] + y * d[1], f[2] = (1 - y) * b[2] + y * d[2]} from u_param, v_param, w_param, x_param, y_param

# Temporary probe: three distinct concyclic points are noncollinear.

# Scalar bridge stages for eliminating the affine circle parameter.
thm local_radius_b_linear:
    ? forall a1, a2, b1, b2, o1, o2 R:
        (a1 - o1)^2 + (a2 - o2)^2 = (b1 - o1)^2 + (b2 - o2)^2
        =>:
            2 * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + ((b1 - a1)^2 + (b2 - a2)^2) = 0
    release thm geo::subtract_equalities((a1 - o1)^2 + (a2 - o2)^2, (b1 - o1)^2 + (b2 - o2)^2, (a1 - o1)^2 + (a2 - o2)^2, (a1 - o1)^2 + (a2 - o2)^2)
    ((a1 - o1)^2 + (a2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = ((b1 - o1)^2 + (b2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2)
    ((a1 - o1)^2 + (a2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 0
    ((b1 - o1)^2 + (b2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 2 * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + ((b1 - a1)^2 + (b2 - a2)^2)
    2 * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + ((b1 - a1)^2 + (b2 - a2)^2) = ((b1 - o1)^2 + (b2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 0

thm local_radius_c_quadratic:
    ? forall a1, a2, b1, b2, c1, c2, o1, o2, s R:
        (a1 - o1)^2 + (a2 - o2)^2 = (c1 - o1)^2 + (c2 - o2)^2
        c1 = a1 + s * (b1 - a1)
        c2 = a2 + s * (b2 - a2)
        =>:
            2 * s * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + s^2 * ((b1 - a1)^2 + (b2 - a2)^2) = 0
    release thm geo::subtract_equalities((a1 - o1)^2 + (a2 - o2)^2, (c1 - o1)^2 + (c2 - o2)^2, (a1 - o1)^2 + (a2 - o2)^2, (a1 - o1)^2 + (a2 - o2)^2)
    ((a1 - o1)^2 + (a2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = ((c1 - o1)^2 + (c2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2)
    ((a1 - o1)^2 + (a2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 0
    ((c1 - o1)^2 + (c2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = (((a1 + s * (b1 - a1)) - o1)^2 + ((a2 + s * (b2 - a2)) - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2)
    (((a1 + s * (b1 - a1)) - o1)^2 + ((a2 + s * (b2 - a2)) - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 2 * s * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + s^2 * ((b1 - a1)^2 + (b2 - a2)^2)
    2 * s * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + s^2 * ((b1 - a1)^2 + (b2 - a2)^2) = ((c1 - o1)^2 + (c2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 0

thm local_circle_affine_eliminate:
    ? forall U, V, s R:
        2 * U + V = 0
        2 * s * U + s^2 * V = 0
        =>:
            s * (s - 1) * V = 0
    release thm geo::multiply_both_sides(2 * U + V, 0, s)
    s * (2 * U + V) = 0 * s
    2 * s * U + s * V = s * (2 * U + V) = 0 * s = 0
    release thm geo::subtract_equalities(2 * s * U + s^2 * V, 0, 2 * s * U + s * V, 0)
    (2 * s * U + s^2 * V) - (2 * s * U + s * V) = 0 - 0
    s * (s - 1) * V = (2 * s * U + s^2 * V) - (2 * s * U + s * V) = 0

thm local_swap_zero_product:
    ? forall x, y R:
        x * y = 0
        =>:
            y * x = 0
    y * x = x * y = 0

thm local_zero_factor:
    ? forall x, y R:
        x * y = 0
        y != 0
        =>:
            x = 0
    release thm local_swap_zero_product(x, y)
    y * x = 0
    release thm geo::zero_factor_law(y, x)
    x = 0

thm concyclic_three_distinct_nondegenerate_probe:
    ? forall a, b, c, d cart(R, R):
        $geo::are_concyclic(a, b, c, d)
        a != b
        a != c
        b != c
        =>:
            geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
    by contra:
        ? geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
        geo::det(geo::vec(a, b), geo::vec(a, c)) = 0
        release thm geo::det_antisymmetric(geo::vec(a, c), geo::vec(a, b))
        geo::det(geo::vec(a, c), geo::vec(a, b)) = -(geo::det(geo::vec(a, b), geo::vec(a, c))) = 0
        release thm geo::collinear_det_expand(a, c, b)
        (c[1] - a[1]) * (b[2] - a[2]) - (c[2] - a[2]) * (b[1] - a[1]) = 0
        release thm local_collinear_coordinates_imply_affine_parameter(a, b, c)
        exist s R st {c[1] = (1 - s) * a[1] + s * b[1], c[2] = (1 - s) * a[2] + s * b[2]}
        obtain s from exist s0 R st {c[1] = (1 - s0) * a[1] + s0 * b[1], c[2] = (1 - s0) * a[2] + s0 * b[2]}

        by def $geo::are_concyclic(a, b, c, d)
        exist o cart(R, R) st {geo::distance_sq(o, a) = geo::distance_sq(o, d), geo::distance_sq(o, b) = geo::distance_sq(o, d), geo::distance_sq(o, c) = geo::distance_sq(o, d)}
        obtain o from exist o0 cart(R, R) st {geo::distance_sq(o0, a) = geo::distance_sq(o0, d), geo::distance_sq(o0, b) = geo::distance_sq(o0, d), geo::distance_sq(o0, c) = geo::distance_sq(o0, d)}
        geo::distance_sq(o, a) = geo::distance_sq(o, d) = geo::distance_sq(o, b)
        geo::distance_sq(o, a) = geo::distance_sq(o, d) = geo::distance_sq(o, c)
        release thm geo::distance_sq_coordinate_formula(o, a)
        release thm geo::distance_sq_coordinate_formula(o, b)
        release thm geo::distance_sq_coordinate_formula(o, c)
        (a[1] - o[1])^2 + (a[2] - o[2])^2 = (b[1] - o[1])^2 + (b[2] - o[2])^2
        (a[1] - o[1])^2 + (a[2] - o[2])^2 = (c[1] - o[1])^2 + (c[2] - o[2])^2
        c[1] = a[1] + s * (b[1] - a[1])
        c[2] = a[2] + s * (b[2] - a[2])
        release thm local_radius_b_linear(a[1], a[2], b[1], b[2], o[1], o[2])
        2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])) + ((b[1] - a[1])^2 + (b[2] - a[2])^2) = 0
        release thm local_radius_c_quadratic(a[1], a[2], b[1], b[2], c[1], c[2], o[1], o[2], s)
        2 * s * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])) + s^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = 0
        release thm local_circle_affine_eliminate((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]), (b[1] - a[1])^2 + (b[2] - a[2])^2, s)
        s * (s - 1) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = 0
        release thm geo::point_difference_norm_pos(a, b)
        (b[1] - a[1])^2 + (b[2] - a[2])^2 > 0
        (b[1] - a[1])^2 + (b[2] - a[2])^2 != 0
        release thm local_zero_factor(s * (s - 1), (b[1] - a[1])^2 + (b[2] - a[2])^2)
        s * (s - 1) = 0
        by cases:
            ? geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
            case s = 0:
                release thm geo::multiply_both_sides(s, 0, b[1] - a[1])
                s * (b[1] - a[1]) = 0 * (b[1] - a[1]) = 0
                release thm geo::multiply_both_sides(s, 0, b[2] - a[2])
                s * (b[2] - a[2]) = 0 * (b[2] - a[2]) = 0
                c[1] = a[1] + s * (b[1] - a[1]) = a[1] + 0 = a[1]
                c[2] = a[2] + s * (b[2] - a[2]) = a[2] + 0 = a[2]
                c = (c[1], c[2]) = (a[1], a[2]) = a
                impossible a != c
            case s != 0:
                release thm geo::zero_factor_law(s, s - 1)
                s - 1 = 0
                s = 1
                release thm geo::multiply_both_sides(s, 1, b[1] - a[1])
                s * (b[1] - a[1]) = 1 * (b[1] - a[1]) = b[1] - a[1]
                release thm geo::multiply_both_sides(s, 1, b[2] - a[2])
                s * (b[2] - a[2]) = 1 * (b[2] - a[2]) = b[2] - a[2]
                c[1] = a[1] + s * (b[1] - a[1]) = a[1] + (b[1] - a[1]) = b[1]
                c[2] = a[2] + s * (b[2] - a[2]) = a[2] + (b[2] - a[2]) = b[2]
                c = (c[1], c[2]) = (b[1], b[2]) = b
                impossible b != c
        impossible geo::det(geo::vec(a, b), geo::vec(a, c)) = 0

thm local_scalar_basis_first_coefficient_zero:
    ? forall u1, u2, v1, v2, p1, p2, t, z R:
        u1 * v2 - u2 * v1 != 0
        p1 = t * u1
        p2 = t * u2
        p1 = z * v1
        p2 = z * v2
        =>:
            t = 0
    t * u1 = z * v1
    t * u2 = z * v2
    release thm geo::multiply_both_sides(t * u1, z * v1, v2)
    (t * u1) * v2 = (z * v1) * v2
    release thm geo::multiply_both_sides(t * u2, z * v2, v1)
    (t * u2) * v1 = (z * v2) * v1
    release thm geo::subtract_equalities((t * u1) * v2, (z * v1) * v2, (t * u2) * v1, (z * v2) * v1)
    (t * u1) * v2 - (t * u2) * v1 = (z * v1) * v2 - (z * v2) * v1
    (t * u1) * v2 - (t * u2) * v1 = t * (u1 * v2 - u2 * v1)
    (z * v1) * v2 - (z * v2) * v1 = 0
    t * (u1 * v2 - u2 * v1) = 0
    release thm local_zero_factor(t, u1 * v2 - u2 * v1)
    t = 0

thm local_point_basis_first_coefficient_zero:
    ? forall a, b, c, p cart(R, R), t, z R:
        geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
        p[1] - a[1] = t * (b[1] - a[1])
        p[2] - a[2] = t * (b[2] - a[2])
        p[1] - a[1] = z * (c[1] - a[1])
        p[2] - a[2] = z * (c[2] - a[2])
        =>:
            t = 0
    release thm geo::collinear_det_expand(a, b, c)
    geo::det(geo::vec(a, b), geo::vec(a, c)) = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
    (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1]) != 0
    release thm local_scalar_basis_first_coefficient_zero(b[1] - a[1], b[2] - a[2], c[1] - a[1], c[2] - a[2], p[1] - a[1], p[2] - a[2], t, z)
    t = 0

# Problem 465 Part 2: the intended non-endpoint condition G != A excludes q=0.
thm part2_q_nonzero_from_nonendpoint:
    ? forall a, b, c, d, g, h cart(R, R), t, q, z R:
        geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
        g = (a[1] + t * (b[1] - a[1]), a[2] + t * (b[2] - a[2]))
        h[1] = (1 - q) * g[1] + q * d[1]
        h[2] = (1 - q) * g[2] + q * d[2]
        h[1] = (1 - z) * a[1] + z * c[1]
        h[2] = (1 - z) * a[2] + z * c[2]
        g != a
        =>:
            q != 0
    by contra:
        ? q != 0
        q = 0
        h[1] = (1 - q) * g[1] + q * d[1] = (1 - 0) * g[1] + 0 * d[1] = g[1]
        h[2] = (1 - q) * g[2] + q * d[2] = (1 - 0) * g[2] + 0 * d[2] = g[2]

        h[1] - a[1] = g[1] - a[1] = (a[1] + t * (b[1] - a[1])) - a[1] = t * (b[1] - a[1])
        h[2] - a[2] = g[2] - a[2] = (a[2] + t * (b[2] - a[2])) - a[2] = t * (b[2] - a[2])
        h[1] - a[1] = ((1 - z) * a[1] + z * c[1]) - a[1] = z * (c[1] - a[1])
        h[2] - a[2] = ((1 - z) * a[2] + z * c[2]) - a[2] = z * (c[2] - a[2])
        release thm local_point_basis_first_coefficient_zero(a, b, c, h, t, z)
        t = 0
        g[1] = a[1]
        g[2] = a[2]
        g = (g[1], g[2]) = (a[1], a[2]) = a
        impossible g != a

# Minimal center-algebra bridge for Problem 465 part (2).

thm local_radius_linear:
    ? forall a1, a2, b1, b2, o1, o2 R:
        (a1 - o1)^2 + (a2 - o2)^2 = (b1 - o1)^2 + (b2 - o2)^2
        =>:
            2 * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + ((b1 - a1)^2 + (b2 - a2)^2) = 0
    release thm geo::subtract_equalities((a1 - o1)^2 + (a2 - o2)^2, (b1 - o1)^2 + (b2 - o2)^2, (a1 - o1)^2 + (a2 - o2)^2, (a1 - o1)^2 + (a2 - o2)^2)
    ((a1 - o1)^2 + (a2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = ((b1 - o1)^2 + (b2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2)
    ((a1 - o1)^2 + (a2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 0
    ((b1 - o1)^2 + (b2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 2 * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + ((b1 - a1)^2 + (b2 - a2)^2)
    2 * ((a1 - o1) * (b1 - a1) + (a2 - o2) * (b2 - a2)) + ((b1 - a1)^2 + (b2 - a2)^2) = ((b1 - o1)^2 + (b2 - o2)^2) - ((a1 - o1)^2 + (a2 - o2)^2) = 0

thm local_square_both_sides:
    ? forall u, v R:
        u = v
        =>:
            u^2 = v^2
    release thm geo::multiply_both_sides(u, v, u)
    release thm geo::multiply_both_sides(u, v, v)
    u^2 = u * u = v * u = u * v = v * v = v^2

thm local_regroup_two_quadratics:
    ? forall x1, x2, y1, y2, h, s R:
        =>:
            (h^2 * x1^2 - 2 * h * s * x1 * y1 + s^2 * y1^2) + (h^2 * x2^2 - 2 * h * s * x2 * y2 + s^2 * y2^2) = h^2 * (x1^2 + x2^2) - 2 * h * s * (y1 * x1 + y2 * x2) + s^2 * (y1^2 + y2^2)
    (h^2 * x1^2 - 2 * h * s * x1 * y1 + s^2 * y1^2) + (h^2 * x2^2 - 2 * h * s * x2 * y2 + s^2 * y2^2) = h^2 * (x1^2 + x2^2) - 2 * h * s * (y1 * x1 + y2 * x2) + s^2 * (y1^2 + y2^2)

thm local_zero_sum_to_negative:
    ? forall x, y R:
        x + y = 0
        =>:
            x = -y
    release thm geo::subtract_equalities(x + y, 0, y, y)
    (x + y) - y = 0 - y
    x = (x + y) - y = 0 - y = -y

thm local_scale_linear:
    ? forall u, v, w, q, h, s R:
        q * u = h * v - s * w
        =>:
            2 * q^2 * u = h * q * (2 * v) - q * s * (2 * w)
    release thm geo::multiply_both_sides(q * u, h * v - s * w, 2 * q)
    (q * u) * (2 * q) = (h * v - s * w) * (2 * q)
    2 * q^2 * u = (q * u) * (2 * q)
    (h * v - s * w) * (2 * q) = h * q * (2 * v) - q * s * (2 * w)
    2 * q^2 * u = (q * u) * (2 * q) = (h * v - s * w) * (2 * q) = h * q * (2 * v) - q * s * (2 * w)

thm local_weighted_coordinate_sum:
    ? forall r1, r2, u1, u2, v1, v2, w1, w2, q, h, s R:
        q * u1 = h * v1 - s * w1
        q * u2 = h * v2 - s * w2
        =>:
            q * (r1 * u1 + r2 * u2) = h * (r1 * v1 + r2 * v2) - s * (r1 * w1 + r2 * w2)
    release thm geo::multiply_both_sides(q * u1, h * v1 - s * w1, r1)
    (q * u1) * r1 = (h * v1 - s * w1) * r1
    release thm geo::multiply_both_sides(q * u2, h * v2 - s * w2, r2)
    (q * u2) * r2 = (h * v2 - s * w2) * r2
    release thm geo::add_equalities((q * u1) * r1, (h * v1 - s * w1) * r1, (q * u2) * r2, (h * v2 - s * w2) * r2)
    (q * u1) * r1 + (q * u2) * r2 = (h * v1 - s * w1) * r1 + (h * v2 - s * w2) * r2
    q * (r1 * u1 + r2 * u2) = (q * u1) * r1 + (q * u2) * r2
    (h * v1 - s * w1) * r1 + (h * v2 - s * w2) * r2 = h * (r1 * v1 + r2 * v2) - s * (r1 * w1 + r2 * w2)
    q * (r1 * u1 + r2 * u2) = (q * u1) * r1 + (q * u2) * r2 = (h * v1 - s * w1) * r1 + (h * v2 - s * w2) * r2 = h * (r1 * v1 + r2 * v2) - s * (r1 * w1 + r2 * w2)

thm cyclic_center_algebra_probe:
    ? forall a, b, c, d, o cart(R, R), t, q, h, L, K R:
        geo::distance_sq(o, a) = geo::distance_sq(o, b)
        geo::distance_sq(o, a) = geo::distance_sq(o, c)
        geo::distance_sq(o, a) = geo::distance_sq(o, d)
        q * (d[1] - a[1]) = h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1])
        q * (d[2] - a[2]) = h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2])
        L = (b[1] - a[1])^2 + (b[2] - a[2])^2
        L = (c[1] - a[1])^2 + (c[2] - a[2])^2
        K = (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])
        =>:
            L * (h^2 + (1 - q)^2 * t^2 - h * q + q * (1 - q) * t) - 2 * h * (1 - q) * t * K = 0

    release thm geo::distance_sq_coordinate_formula(o, a)
    release thm geo::distance_sq_coordinate_formula(o, b)
    release thm geo::distance_sq_coordinate_formula(o, c)
    release thm geo::distance_sq_coordinate_formula(o, d)

    (a[1] - o[1])^2 + (a[2] - o[2])^2 = (b[1] - o[1])^2 + (b[2] - o[2])^2
    (a[1] - o[1])^2 + (a[2] - o[2])^2 = (c[1] - o[1])^2 + (c[2] - o[2])^2
    (a[1] - o[1])^2 + (a[2] - o[2])^2 = (d[1] - o[1])^2 + (d[2] - o[2])^2

    release thm local_radius_linear(a[1], a[2], b[1], b[2], o[1], o[2])
    2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])) + ((b[1] - a[1])^2 + (b[2] - a[2])^2) = 0
    2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])) + L = 2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])) + ((b[1] - a[1])^2 + (b[2] - a[2])^2) = 0
    release thm local_radius_linear(a[1], a[2], c[1], c[2], o[1], o[2])
    2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])) + ((c[1] - a[1])^2 + (c[2] - a[2])^2) = 0
    2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])) + L = 2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])) + ((c[1] - a[1])^2 + (c[2] - a[2])^2) = 0
    release thm local_radius_linear(a[1], a[2], d[1], d[2], o[1], o[2])
    2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + ((d[1] - a[1])^2 + (d[2] - a[2])^2) = 0
    release thm geo::multiply_both_sides(2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + ((d[1] - a[1])^2 + (d[2] - a[2])^2), 0, q^2)
    q^2 * (2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + ((d[1] - a[1])^2 + (d[2] - a[2])^2)) = q^2 * 0
    q^2 * 0 = 0
    q^2 * (2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + ((d[1] - a[1])^2 + (d[2] - a[2])^2)) = 0
    2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = 0

    q * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) = h * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])) - (1 - q) * t * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))

    release thm local_square_both_sides(q * (d[1] - a[1]), h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))
    (q * (d[1] - a[1]))^2 = (h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))^2
    release thm local_square_both_sides(q * (d[2] - a[2]), h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))
    (q * (d[2] - a[2]))^2 = (h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))^2
    release thm geo::add_equalities((q * (d[1] - a[1]))^2, (h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))^2, (q * (d[2] - a[2]))^2, (h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))^2)
    (q * (d[1] - a[1]))^2 + (q * (d[2] - a[2]))^2 = (h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))^2
    q^2 * (d[1] - a[1])^2 = (q * (d[1] - a[1]))^2
    q^2 * (d[2] - a[2])^2 = (q * (d[2] - a[2]))^2
    q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = q^2 * (d[1] - a[1])^2 + q^2 * (d[2] - a[2])^2
    q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = (q * (d[1] - a[1]))^2 + (q * (d[2] - a[2]))^2
    q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = (h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))^2
    release thm local_regroup_two_quadratics(c[1] - a[1], c[2] - a[2], b[1] - a[1], b[2] - a[2], h, (1 - q) * t)
    (h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))^2 = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + ((1 - q) * t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = (h * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2]))^2 = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + ((1 - q) * t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    release thm geo::multiply_both_sides(L, (c[1] - a[1])^2 + (c[2] - a[2])^2, h^2)
    h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) = h^2 * L
    release thm geo::multiply_both_sides(K, (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2]), -2 * h * ((1 - q) * t))
    -2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = -2 * h * ((1 - q) * t) * K
    release thm geo::add_equalities(h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2), h^2 * L, -2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])), -2 * h * ((1 - q) * t) * K)
    h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = h^2 * L - 2 * h * ((1 - q) * t) * K
    release thm geo::multiply_both_sides(L, (b[1] - a[1])^2 + (b[2] - a[2])^2, ((1 - q) * t)^2)
    ((1 - q) * t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = ((1 - q) * t)^2 * L
    release thm geo::add_equalities(h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])), h^2 * L - 2 * h * ((1 - q) * t) * K, ((1 - q) * t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2), ((1 - q) * t)^2 * L)
    h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + ((1 - q) * t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = h^2 * L - 2 * h * ((1 - q) * t) * K + ((1 - q) * t)^2 * L
    q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * ((1 - q) * t) * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + ((1 - q) * t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = h^2 * L - 2 * h * ((1 - q) * t) * K + ((1 - q) * t)^2 * L
    q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = h^2 * L + (1 - q)^2 * t^2 * L - 2 * h * (1 - q) * t * K

    2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = 0
    release thm local_zero_sum_to_negative(2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])), L)
    2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])) = -L
    release thm local_zero_sum_to_negative(2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])), L)
    2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])) = -L
    release thm local_scale_linear((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2]), (a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]), (a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]), q, h, (1 - q) * t)
    2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) = h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) - q * ((1 - q) * t) * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])))
    h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) - q * ((1 - q) * t) * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))) = h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) - q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])))
    release thm geo::multiply_both_sides(2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2])), -L, h * q)
    (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) * (h * q) = (-L) * (h * q)
    h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) = (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) * (h * q) = (-L) * (h * q) = -h * q * L
    release thm geo::multiply_both_sides(2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])), -L, -q * (1 - q) * t)
    (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))) * (-q * (1 - q) * t) = (-L) * (-q * (1 - q) * t)
    -q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))) = (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))) * (-q * (1 - q) * t) = (-L) * (-q * (1 - q) * t) = q * (1 - q) * t * L
    release thm geo::add_equalities(h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))), -h * q * L, -q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))), q * (1 - q) * t * L)
    h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) + (-q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])))) = -h * q * L + q * (1 - q) * t * L
    h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) - q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))) = h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) + (-q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2])))) = -h * q * L + q * (1 - q) * t * L
    2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) = h * q * (2 * ((a[1] - o[1]) * (c[1] - a[1]) + (a[2] - o[2]) * (c[2] - a[2]))) - q * (1 - q) * t * (2 * ((a[1] - o[1]) * (b[1] - a[1]) + (a[2] - o[2]) * (b[2] - a[2]))) = -h * q * L + q * (1 - q) * t * L
    release thm geo::add_equalities(2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])), -h * q * L + q * (1 - q) * t * L, q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2), h^2 * L + (1 - q)^2 * t^2 * L - 2 * h * (1 - q) * t * K)
    2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = (-h * q * L + q * (1 - q) * t * L) + (h^2 * L + (1 - q)^2 * t^2 * L - 2 * h * (1 - q) * t * K)
    (-h * q * L + q * (1 - q) * t * L) + (h^2 * L + (1 - q)^2 * t^2 * L - 2 * h * (1 - q) * t * K) = 2 * q^2 * ((a[1] - o[1]) * (d[1] - a[1]) + (a[2] - o[2]) * (d[2] - a[2])) + q^2 * ((d[1] - a[1])^2 + (d[2] - a[2])^2) = 0
    L * (h^2 + (1 - q)^2 * t^2 - h * q + q * (1 - q) * t) - 2 * h * (1 - q) * t * K = 0

# Disposable Problem 465 Part 2 bridge: AB=AC and BG=DG imply the second scaled metric equation.

thm part2_equidistance_scaled_probe:
    ? forall a, b, c, d, g, p cart(R, R), t, q, h, L, K R:
        # G=A+t(B-A).
        g = (a[1] + t * (b[1] - a[1]), a[2] + t * (b[2] - a[2]))
        # P=(1-q)G+qD.
        p[1] = (1 - q) * g[1] + q * d[1]
        p[2] = (1 - q) * g[2] + q * d[2]
        # P=(1-h)A+hC.
        p[1] = (1 - h) * a[1] + h * c[1]
        p[2] = (1 - h) * a[2] + h * c[2]
        # L=|AB|^2 and K=AB dot AC.
        L = (b[1] - a[1])^2 + (b[2] - a[2])^2
        K = (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])
        # AB=AC.
        $geo::are_segments_congruent(a, b, a, c)
        # BG=DG.
        $geo::are_segments_congruent(b, g, d, g)
        =>:
            L * (h^2 + t^2 - q^2 * (1 - t)^2) - 2 * h * t * K = 0
    by def $geo::are_segments_congruent(a, b, a, c)
    by def $geo::are_segments_congruent(b, g, d, g)
    release thm geo::distance_sq_coordinate_formula(a, b)
    release thm geo::distance_sq_coordinate_formula(a, c)
    release thm geo::distance_sq_coordinate_formula(b, g)
    release thm geo::distance_sq_coordinate_formula(d, g)

    geo::distance_sq(a, b) = L
    geo::distance_sq(a, c) = L
    g[1] - b[1] = -(1 - t) * (b[1] - a[1])
    g[2] - b[2] = -(1 - t) * (b[2] - a[2])
    release thm geo::distance_sq_coordinate_formula(b, g)
    geo::distance_sq(b, g) = (g[1] - b[1])^2 + (g[2] - b[2])^2
    (g[1] - b[1])^2 = (-(1 - t) * (b[1] - a[1]))^2
    (-(1 - t) * (b[1] - a[1]))^2 = (1 - t)^2 * (b[1] - a[1])^2
    (g[1] - b[1])^2 = (1 - t)^2 * (b[1] - a[1])^2
    (g[2] - b[2])^2 = (-(1 - t) * (b[2] - a[2]))^2
    (-(1 - t) * (b[2] - a[2]))^2 = (1 - t)^2 * (b[2] - a[2])^2
    (g[2] - b[2])^2 = (1 - t)^2 * (b[2] - a[2])^2
    (g[1] - b[1])^2 + (g[2] - b[2])^2 = (1 - t)^2 * (b[1] - a[1])^2 + (g[2] - b[2])^2
    (1 - t)^2 * (b[1] - a[1])^2 + (g[2] - b[2])^2 = (1 - t)^2 * (b[1] - a[1])^2 + (1 - t)^2 * (b[2] - a[2])^2
    (g[1] - b[1])^2 + (g[2] - b[2])^2 = (1 - t)^2 * (b[1] - a[1])^2 + (1 - t)^2 * (b[2] - a[2])^2
    geo::distance_sq(b, g) = (1 - t)^2 * (b[1] - a[1])^2 + (1 - t)^2 * (b[2] - a[2])^2
    (1 - t)^2 * (b[1] - a[1])^2 + (1 - t)^2 * (b[2] - a[2])^2 = (1 - t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    geo::distance_sq(b, g) = (1 - t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    (b[1] - a[1])^2 + (b[2] - a[2])^2 = L
    release thm geo::multiply_both_sides((b[1] - a[1])^2 + (b[2] - a[2])^2, L, (1 - t)^2)
    (1 - t)^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = (1 - t)^2 * L
    geo::distance_sq(b, g) = (1 - t)^2 * L

    q * (d[1] - g[1]) = p[1] - g[1]
    q * (d[2] - g[2]) = p[2] - g[2]
    p[1] - a[1] = ((1 - h) * a[1] + h * c[1]) - a[1] = h * (c[1] - a[1])
    p[2] - a[2] = ((1 - h) * a[2] + h * c[2]) - a[2] = h * (c[2] - a[2])
    g[1] - a[1] = t * (b[1] - a[1])
    g[2] - a[2] = t * (b[2] - a[2])
    p[1] - g[1] = (p[1] - a[1]) - (g[1] - a[1])
    p[2] - g[2] = (p[2] - a[2]) - (g[2] - a[2])
    release thm geo::subtract_equalities(p[1] - a[1], h * (c[1] - a[1]), g[1] - a[1], t * (b[1] - a[1]))
    release thm geo::subtract_equalities(p[2] - a[2], h * (c[2] - a[2]), g[2] - a[2], t * (b[2] - a[2]))
    (p[1] - a[1]) - (g[1] - a[1]) = h * (c[1] - a[1]) - t * (b[1] - a[1])
    (p[2] - a[2]) - (g[2] - a[2]) = h * (c[2] - a[2]) - t * (b[2] - a[2])
    p[1] - g[1] = h * (c[1] - a[1]) - t * (b[1] - a[1])
    p[2] - g[2] = h * (c[2] - a[2]) - t * (b[2] - a[2])
    q * (d[1] - g[1]) = h * (c[1] - a[1]) - t * (b[1] - a[1])
    q * (d[2] - g[2]) = h * (c[2] - a[2]) - t * (b[2] - a[2])
    release thm geo::distance_sq_coordinate_formula(d, g)
    geo::distance_sq(d, g) = (g[1] - d[1])^2 + (g[2] - d[2])^2
    q * (g[1] - d[1]) = -(q * (d[1] - g[1]))
    -(q * (d[1] - g[1])) = -(h * (c[1] - a[1]) - t * (b[1] - a[1]))
    q * (g[1] - d[1]) = -(h * (c[1] - a[1]) - t * (b[1] - a[1]))
    (q * (g[1] - d[1]))^2 = (-(h * (c[1] - a[1]) - t * (b[1] - a[1])))^2
    (q * (g[1] - d[1]))^2 = q^2 * (g[1] - d[1])^2
    (-(h * (c[1] - a[1]) - t * (b[1] - a[1])))^2 = (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2
    q^2 * (g[1] - d[1])^2 = (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2
    q * (g[2] - d[2]) = -(q * (d[2] - g[2]))
    -(q * (d[2] - g[2])) = -(h * (c[2] - a[2]) - t * (b[2] - a[2]))
    q * (g[2] - d[2]) = -(h * (c[2] - a[2]) - t * (b[2] - a[2]))
    (q * (g[2] - d[2]))^2 = (-(h * (c[2] - a[2]) - t * (b[2] - a[2])))^2
    (q * (g[2] - d[2]))^2 = q^2 * (g[2] - d[2])^2
    (-(h * (c[2] - a[2]) - t * (b[2] - a[2])))^2 = (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2
    q^2 * (g[2] - d[2])^2 = (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2
    q^2 * geo::distance_sq(d, g) = q^2 * ((g[1] - d[1])^2 + (g[2] - d[2])^2)
    q^2 * ((g[1] - d[1])^2 + (g[2] - d[2])^2) = q^2 * (g[1] - d[1])^2 + q^2 * (g[2] - d[2])^2
    q^2 * geo::distance_sq(d, g) = q^2 * (g[1] - d[1])^2 + q^2 * (g[2] - d[2])^2
    q^2 * (g[1] - d[1])^2 + q^2 * (g[2] - d[2])^2 = (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2 + q^2 * (g[2] - d[2])^2
    (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2 + q^2 * (g[2] - d[2])^2 = (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2
    q^2 * geo::distance_sq(d, g) = (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2
    (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2 = h^2 * (c[1] - a[1])^2 - 2 * h * t * (c[1] - a[1]) * (b[1] - a[1]) + t^2 * (b[1] - a[1])^2
    (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2 = h^2 * (c[2] - a[2])^2 - 2 * h * t * (c[2] - a[2]) * (b[2] - a[2]) + t^2 * (b[2] - a[2])^2
    release thm geo::add_equalities((h * (c[1] - a[1]) - t * (b[1] - a[1]))^2, h^2 * (c[1] - a[1])^2 - 2 * h * t * (c[1] - a[1]) * (b[1] - a[1]) + t^2 * (b[1] - a[1])^2, (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2, h^2 * (c[2] - a[2])^2 - 2 * h * t * (c[2] - a[2]) * (b[2] - a[2]) + t^2 * (b[2] - a[2])^2)
    (h * (c[1] - a[1]) - t * (b[1] - a[1]))^2 + (h * (c[2] - a[2]) - t * (b[2] - a[2]))^2 = (h^2 * (c[1] - a[1])^2 - 2 * h * t * (c[1] - a[1]) * (b[1] - a[1]) + t^2 * (b[1] - a[1])^2) + (h^2 * (c[2] - a[2])^2 - 2 * h * t * (c[2] - a[2]) * (b[2] - a[2]) + t^2 * (b[2] - a[2])^2)
    q^2 * geo::distance_sq(d, g) = (h^2 * (c[1] - a[1])^2 - 2 * h * t * (c[1] - a[1]) * (b[1] - a[1]) + t^2 * (b[1] - a[1])^2) + (h^2 * (c[2] - a[2])^2 - 2 * h * t * (c[2] - a[2]) * (b[2] - a[2]) + t^2 * (b[2] - a[2])^2)
    release thm local_regroup_two_quadratics(c[1] - a[1], c[2] - a[2], b[1] - a[1], b[2] - a[2], h, t)
    (h^2 * (c[1] - a[1])^2 - 2 * h * t * (c[1] - a[1]) * (b[1] - a[1]) + t^2 * (b[1] - a[1])^2) + (h^2 * (c[2] - a[2])^2 - 2 * h * t * (c[2] - a[2]) * (b[2] - a[2]) + t^2 * (b[2] - a[2])^2) = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    q^2 * geo::distance_sq(d, g) = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    release thm geo::multiply_both_sides(L, (c[1] - a[1])^2 + (c[2] - a[2])^2, h^2)
    h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) = h^2 * L
    release thm geo::multiply_both_sides(K, (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2]), -2 * h * t)
    -2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = -2 * h * t * K
    release thm geo::add_equalities(h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2), h^2 * L, -2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])), -2 * h * t * K)
    h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = h^2 * L - 2 * h * t * K
    release thm geo::multiply_both_sides(L, (b[1] - a[1])^2 + (b[2] - a[2])^2, t^2)
    t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = t^2 * L
    release thm geo::add_equalities(h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])), h^2 * L - 2 * h * t * K, t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2), t^2 * L)
    h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - 2 * h * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) + t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = h^2 * L - 2 * h * t * K + t^2 * L
    q^2 * geo::distance_sq(d, g) = h^2 * L - 2 * h * t * K + t^2 * L
    geo::distance_sq(d, g) = (1 - t)^2 * L
    release thm geo::multiply_both_sides(geo::distance_sq(d, g), (1 - t)^2 * L, q^2)
    q^2 * geo::distance_sq(d, g) = q^2 * ((1 - t)^2 * L)
    q^2 * geo::distance_sq(d, g) = q^2 * (1 - t)^2 * L
    q^2 * (1 - t)^2 * L = h^2 * L - 2 * h * t * K + t^2 * L
    release thm geo::subtract_equalities(h^2 * L - 2 * h * t * K + t^2 * L, q^2 * (1 - t)^2 * L, q^2 * (1 - t)^2 * L, q^2 * (1 - t)^2 * L)
    (h^2 * L - 2 * h * t * K + t^2 * L) - q^2 * (1 - t)^2 * L = (q^2 * (1 - t)^2 * L) - q^2 * (1 - t)^2 * L
    (q^2 * (1 - t)^2 * L) - q^2 * (1 - t)^2 * L = 0
    (h^2 * L - 2 * h * t * K + t^2 * L) - q^2 * (1 - t)^2 * L = 0
    L * (h^2 + t^2 - q^2 * (1 - t)^2) - 2 * h * t * K = 0

# Temporary no-division scalar bridge for Problem 465 part (2).

thm part2_scaled_parameter_elimination_probe:
    ? forall h, q, t, L, K R:
        L != 0
        q != 0
        h + q * t - q - t != 0
        L * (h^2 + (1 - q)^2 * t^2 - h * q + q * (1 - q) * t) - 2 * h * (1 - q) * t * K = 0
        L * (h^2 + t^2 - q^2 * (1 - t)^2) - 2 * h * t * K = 0
        =>:
            h = q * t - q - t + 1

    (L * (h^2 + (1 - q)^2 * t^2 - h * q + q * (1 - q) * t) - 2 * h * (1 - q) * t * K) + (q - 1) * (L * (h^2 + t^2 - q^2 * (1 - t)^2) - 2 * h * t * K) = 0
    (L * (h^2 + (1 - q)^2 * t^2 - h * q + q * (1 - q) * t) - 2 * h * (1 - q) * t * K) + (q - 1) * (L * (h^2 + t^2 - q^2 * (1 - t)^2) - 2 * h * t * K) = -L * q * (h + q * t - q - t) * (-h + q * t - q - t + 1)
    -L * q * (h + q * t - q - t) * (-h + q * t - q - t + 1) = 0
    -L != 0
    -L * q != 0
    release thm geo::zero_factor_law(-L * q, (h + q * t - q - t) * (-h + q * t - q - t + 1))
    (h + q * t - q - t) * (-h + q * t - q - t + 1) = 0
    release thm geo::zero_factor_law(h + q * t - q - t, -h + q * t - q - t + 1)
    -h + q * t - q - t + 1 = 0
    (-h) + (q * t - q - t + 1) = 0
    release thm geo::zero_sum_rearrange(-h, q * t - q - t + 1)
    h = q * t - q - t + 1

# Local scalar helper for Problem 465, Part 2.
# It excludes the spurious factor left by the verified scaled elimination.
thm extension_parameters_exclude_spurious_factor:
    ? forall h, q, t, r, s R:
        q != 0
        r > 1
        r * (q - 1) * t = q * (1 - s)
        r * h = q * s
        =>:
            h + q * t - q - t != 0

    by contra:
        ? h + q * t - q - t != 0
        h + q * t - q - t = 0
        release thm geo::rearrange_sum(h + q * t, q, t)
        h + q * t = q + t
        release thm geo::multiply_both_sides(h + q * t, q + t, r)
        (h + q * t) * r = (q + t) * r
        release thm geo::subtract_equalities((h + q * t) * r, (q + t) * r, r * t, r * t)
        (h + q * t) * r - r * t = (q + t) * r - r * t
        (h + q * t) * r - r * t = r * h + r * (q - 1) * t
        (q + t) * r - r * t = r * q
        r * h + r * (q - 1) * t = r * q
        r * h + r * (q - 1) * t = q * s + q * (1 - s)
        q * s + q * (1 - s) = q
        r * q = q
        r * q - q = 0
        r * q - q = q * (r - 1)
        q * (r - 1) = 0
        release thm geo::zero_factor_law(q, r - 1)
        r - 1 = 0
        r = 1
        impossible r > 1

# Temporary scalar bridge for Problem 465, Part 2.
# It converts the F=AC∩BD coefficient equations into the final
# one-dimensional product identity, without division.

thm local_zero_factor_law:
    ? forall a, b R:
        a != 0
        a * b = 0
        =>:
            b = 0
    a * b = 0
    a != 0
    b = 0

thm part2_f_parameter_product_probe:
    ? forall h, q, t, x, y R:
        q != 0
        h = (q - 1) * (t - 1)
        q * (1 - y) + y * (q - 1) * t = 0
        q * x = y * h
        =>:
            h^4 = (x - h)^2 * (1 - h)^2
    (q - 1) * (t - 1) = q * t - q - t + 1
    h = q * t - q - t + 1
    q - (q - 1) * t = q - q * t + t = 1 - (q * t - q - t + 1) = 1 - h
    q * (1 - y) + y * (q - 1) * t = q - y * (q - (q - 1) * t)
    q - y * (q - (q - 1) * t) = 0
    q = y * (q - (q - 1) * t)
    release thm geo::multiply_both_sides(q - (q - 1) * t, 1 - h, y)
    (q - (q - 1) * t) * y = (1 - h) * y
    y * (q - (q - 1) * t) = y * (1 - h)
    q = y * (1 - h)
    by contra:
        ? y != 0
        y = 0
        q = y * (1 - h) = 0
        impossible q != 0
    q * x = (y * (1 - h)) * x = y * (1 - h) * x
    y * (1 - h) * x = y * h
    release thm geo::subtract_equalities(y * (1 - h) * x, y * h, y * h, y * h)
    y * (1 - h) * x - y * h = y * h - y * h = 0
    y * ((1 - h) * x - h) = y * (1 - h) * x - y * h = 0
    release thm local_zero_factor_law(y, (1 - h) * x - h)
    (1 - h) * x - h = 0
    (1 - h) * x = h
    (x - h) * (1 - h) = h^2
    ((x - h) * (1 - h))^2 = (h^2)^2
    ((x - h) * (1 - h))^2 = (x - h)^2 * (1 - h)^2
    (h^2)^2 = h^4
    (x - h)^2 * (1 - h)^2 = ((x - h) * (1 - h))^2 = (h^2)^2 = h^4
    h^4 = (x - h)^2 * (1 - h)^2

# Problem 465 Part 2: affine parameters imply the squared-distance product.

thm part2_affine_metric_bridge:
    ? forall a, c, f, p cart(R, R), h, x R:
        p[1] = (1 - h) * a[1] + h * c[1]
        p[2] = (1 - h) * a[2] + h * c[2]
        f[1] = (1 - x) * a[1] + x * c[1]
        f[2] = (1 - x) * a[2] + x * c[2]
        h^4 = (x - h)^2 * (1 - h)^2
        =>:
            geo::distance_sq(a, p)^2 = geo::distance_sq(p, f) * geo::distance_sq(p, c)
    release thm geo::distance_sq_coordinate_formula(a, p)
    release thm geo::distance_sq_coordinate_formula(p, f)
    release thm geo::distance_sq_coordinate_formula(p, c)
    p[1] - a[1] = h * (c[1] - a[1])
    p[2] - a[2] = h * (c[2] - a[2])
    release thm geo::subtract_equalities(f[1], (1 - x) * a[1] + x * c[1], p[1], (1 - h) * a[1] + h * c[1])
    f[1] - p[1] = ((1 - x) * a[1] + x * c[1]) - ((1 - h) * a[1] + h * c[1]) = (x - h) * (c[1] - a[1])
    release thm geo::subtract_equalities(f[2], (1 - x) * a[2] + x * c[2], p[2], (1 - h) * a[2] + h * c[2])
    f[2] - p[2] = ((1 - x) * a[2] + x * c[2]) - ((1 - h) * a[2] + h * c[2]) = (x - h) * (c[2] - a[2])
    c[1] = c[1]
    release thm geo::subtract_equalities(c[1], c[1], p[1], (1 - h) * a[1] + h * c[1])
    c[1] - p[1] = c[1] - ((1 - h) * a[1] + h * c[1]) = (1 - h) * (c[1] - a[1])
    c[2] = c[2]
    release thm geo::subtract_equalities(c[2], c[2], p[2], (1 - h) * a[2] + h * c[2])
    c[2] - p[2] = c[2] - ((1 - h) * a[2] + h * c[2]) = (1 - h) * (c[2] - a[2])
    release thm geo::square_of_equal(p[1] - a[1], h * (c[1] - a[1]))
    (p[1] - a[1])^2 = (h * (c[1] - a[1]))^2
    release thm geo::square_of_equal(p[2] - a[2], h * (c[2] - a[2]))
    (p[2] - a[2])^2 = (h * (c[2] - a[2]))^2
    release thm geo::add_equalities((p[1] - a[1])^2, (h * (c[1] - a[1]))^2, (p[2] - a[2])^2, (h * (c[2] - a[2]))^2)
    (p[1] - a[1])^2 + (p[2] - a[2])^2 = (h * (c[1] - a[1]))^2 + (h * (c[2] - a[2]))^2
    (h * (c[1] - a[1]))^2 + (h * (c[2] - a[2]))^2 = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)
    geo::distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2 = h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)

    release thm geo::square_of_equal(f[1] - p[1], (x - h) * (c[1] - a[1]))
    (f[1] - p[1])^2 = ((x - h) * (c[1] - a[1]))^2
    release thm geo::square_of_equal(f[2] - p[2], (x - h) * (c[2] - a[2]))
    (f[2] - p[2])^2 = ((x - h) * (c[2] - a[2]))^2
    release thm geo::add_equalities((f[1] - p[1])^2, ((x - h) * (c[1] - a[1]))^2, (f[2] - p[2])^2, ((x - h) * (c[2] - a[2]))^2)
    (f[1] - p[1])^2 + (f[2] - p[2])^2 = ((x - h) * (c[1] - a[1]))^2 + ((x - h) * (c[2] - a[2]))^2
    ((x - h) * (c[1] - a[1]))^2 + ((x - h) * (c[2] - a[2]))^2 = (x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)
    geo::distance_sq(p, f) = (f[1] - p[1])^2 + (f[2] - p[2])^2 = (x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)

    release thm geo::square_of_equal(c[1] - p[1], (1 - h) * (c[1] - a[1]))
    (c[1] - p[1])^2 = ((1 - h) * (c[1] - a[1]))^2
    release thm geo::square_of_equal(c[2] - p[2], (1 - h) * (c[2] - a[2]))
    (c[2] - p[2])^2 = ((1 - h) * (c[2] - a[2]))^2
    release thm geo::add_equalities((c[1] - p[1])^2, ((1 - h) * (c[1] - a[1]))^2, (c[2] - p[2])^2, ((1 - h) * (c[2] - a[2]))^2)
    (c[1] - p[1])^2 + (c[2] - p[2])^2 = ((1 - h) * (c[1] - a[1]))^2 + ((1 - h) * (c[2] - a[2]))^2
    ((1 - h) * (c[1] - a[1]))^2 + ((1 - h) * (c[2] - a[2]))^2 = (1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)
    geo::distance_sq(p, c) = (c[1] - p[1])^2 + (c[2] - p[2])^2 = (1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)
    release thm geo::square_of_equal(geo::distance_sq(a, p), h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2))
    geo::distance_sq(a, p)^2 = (h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2))^2
    (h^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2))^2 = h^4 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)^2
    geo::distance_sq(a, p)^2 = h^4 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)^2
    geo::distance_sq(p, f) * geo::distance_sq(p, c) = ((x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)) * geo::distance_sq(p, c)
    release thm geo::multiply_both_sides(geo::distance_sq(p, f), (x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2), geo::distance_sq(p, c))
    ((x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)) * geo::distance_sq(p, c) = ((x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)) * ((1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2))
    release thm geo::multiply_both_sides(geo::distance_sq(p, c), (1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2), (x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2))
    ((x - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)) * ((1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)) = (x - h)^2 * (1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)^2
    h^4 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)^2 = (x - h)^2 * (1 - h)^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)^2
    geo::distance_sq(a, p)^2 = geo::distance_sq(p, f) * geo::distance_sq(p, c)

# Problem 465, Part (2): prove AH^2 = HF * HC in squared-distance form.
thm problem_465_part2:
    ? forall a, b, c, d, e1, f, g, h cart(R, R):
        # 四边形ABCD内接于圆O。
        $geo::are_concyclic(a, b, c, d)
        # AD、BC的延长线相交于E。
        $geo::is_on_extension(e1, a, d)
        $geo::is_on_extension(e1, b, c)
        # AC、BD相交于F。
        $geo::is_on_line(f, a, c)
        $geo::is_on_line(f, b, d)
        # 按图，G是线段AB的内点，GD交AC于H。
        $geo::is_on_segment(g, a, b)
        g != a
        g != b
        $geo::is_on_line(h, g, d)
        $geo::is_on_line(h, a, c)
        # AB=AC，BG=DG。
        $geo::are_segments_congruent(a, b, a, c)
        $geo::are_segments_congruent(b, g, d, g)
        # 圆内接四边形的三个基准顶点互异。
        a != b
        a != c
        b != c
        =>:
            # 证明 AH^2=HF·HC；用平方距离消去根式。
            geo::distance_sq(a, h)^2 = geo::distance_sq(h, f) * geo::distance_sq(h, c)

    release thm part2_affine_witness_probe(a, b, c, d, f, g, h)
    obtain t, q, z, x, y from exist t0, q0, z0, x0, y0 R st {0 <= t0, t0 <= 1, g = (a[1] + t0 * (b[1] - a[1]), a[2] + t0 * (b[2] - a[2])), h[1] = (1 - q0) * g[1] + q0 * d[1], h[2] = (1 - q0) * g[2] + q0 * d[2], h[1] = (1 - z0) * a[1] + z0 * c[1], h[2] = (1 - z0) * a[2] + z0 * c[2], f[1] = (1 - x0) * a[1] + x0 * c[1], f[2] = (1 - x0) * a[2] + x0 * c[2], f[1] = (1 - y0) * b[1] + y0 * d[1], f[2] = (1 - y0) * b[2] + y0 * d[2]}

    release thm concyclic_three_distinct_nondegenerate_probe(a, b, c, d)
    geo::det(geo::vec(a, b), geo::vec(a, c)) != 0

    by def $geo::is_on_extension(e1, a, d)
    obtain r from exist r0 R st {r0 > 1
    e1 = (a[1] + r0 * (d[1] - a[1]), a[2] + r0 * (d[2] - a[2]))}
    by def $geo::is_on_extension(e1, b, c)
    obtain s from exist s0 R st {s0 > 1
    e1 = (b[1] + s0 * (c[1] - b[1]), b[2] + s0 * (c[2] - b[2]))}

    release thm part2_coefficient_bus_probe(a, b, c, d, e1, f, g, h, t, q, z, x, y, r, s)
    q * (d[1] - a[1]) = z * (c[1] - a[1]) + (q - 1) * t * (b[1] - a[1])
    q * (d[2] - a[2]) = z * (c[2] - a[2]) + (q - 1) * t * (b[2] - a[2])
    r * (q - 1) * t = q * (1 - s)
    r * z = q * s
    q * (1 - y) + y * (q - 1) * t = 0
    q * x = y * z

    release thm part2_q_nonzero_from_nonendpoint(a, b, c, d, g, h, t, q, z)
    q != 0

    by def $geo::are_concyclic(a, b, c, d)
    obtain o from exist o0 cart(R, R) st {geo::distance_sq(o0, a) = geo::distance_sq(o0, d), geo::distance_sq(o0, b) = geo::distance_sq(o0, d), geo::distance_sq(o0, c) = geo::distance_sq(o0, d)}
    geo::distance_sq(o, a) = geo::distance_sq(o, b)
    geo::distance_sq(o, a) = geo::distance_sq(o, c)
    geo::distance_sq(o, a) = geo::distance_sq(o, d)

    q * (d[1] - a[1]) = z * (c[1] - a[1]) - (1 - q) * t * (b[1] - a[1])
    q * (d[2] - a[2]) = z * (c[2] - a[2]) - (1 - q) * t * (b[2] - a[2])

    release thm geo::distance_sq_coordinate_formula(a, b)
    release thm geo::distance_sq_coordinate_formula(a, c)
    by def $geo::are_segments_congruent(a, b, a, c)
    (b[1] - a[1])^2 + (b[2] - a[2])^2 = (c[1] - a[1])^2 + (c[2] - a[2])^2

    release thm cyclic_center_algebra_probe(a, b, c, d, o, t, q, z, (b[1] - a[1])^2 + (b[2] - a[2])^2, (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2]))
    ( (b[1] - a[1])^2 + (b[2] - a[2])^2 ) * (z^2 + (1 - q)^2 * t^2 - z * q + q * (1 - q) * t) - 2 * z * (1 - q) * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = 0

    release thm part2_equidistance_scaled_probe(a, b, c, d, g, h, t, q, z, (b[1] - a[1])^2 + (b[2] - a[2])^2, (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2]))
    ( (b[1] - a[1])^2 + (b[2] - a[2])^2 ) * (z^2 + t^2 - q^2 * (1 - t)^2) - 2 * z * t * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = 0

    release thm extension_parameters_exclude_spurious_factor(z, q, t, r, s)
    z + q * t - q - t != 0
    release thm geo::point_difference_norm_pos(a, b)
    (b[1] - a[1])^2 + (b[2] - a[2])^2 != 0

    release thm part2_scaled_parameter_elimination_probe(z, q, t, (b[1] - a[1])^2 + (b[2] - a[2])^2, (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2]))
    z = q * t - q - t + 1
    z = (q - 1) * (t - 1)

    release thm part2_f_parameter_product_probe(z, q, t, x, y)
    z^4 = (x - z)^2 * (1 - z)^2

    release thm part2_affine_metric_bridge(a, c, f, h, z, x)
