# Problem 464 / zhongkao_263 — 正式证明
#
# NL 原题：
# 如图，四边形ABCD的顶点都在半圆O上，AB是半圆O的直径，连接OC，
# ∠DAB+2∠ABC=180°。(1)求证：OC∥AD。
#
# 正式入口只使用与原题逐句对应的几何谓词；以下坐标差与多项式等式
# 仅在证明内部用于调用已经独立验证的代数核心。

thm problem_464_part1:
    ? forall a, b, c, d, o cart(R, R), r R+:
        # 【原题条件1】四边形ABCD的顶点都在半圆O上。
        $geo::is_on_circle(a, o, r)
        $geo::is_on_circle(b, o, r)
        $geo::is_on_circle(c, o, r)
        $geo::is_on_circle(d, o, r)
        # 【原题条件2】AB是半圆O的直径。
        $geo::is_diameter_endpoints(a, b, o)
        # 【原题条件3】C、D在直径AB的同一侧。
        $translation::are_on_same_strict_side_of_line(a, b, c, d)
        # 【原题条件4】∠DAB + 2∠ABC = 180°。
        $translation::angle_plus_twice_angle_is_straight(d, a, b, a, b, c)
        =>:
            # 【原题结论】OC ∥ AD。
            $geo::is_parallel(o, c, a, d)

    # 展开原子几何谓词；坐标条件都由原题几何前提导出。
    by def $geo::is_on_circle(a, o, r)
    by def $geo::is_on_circle(b, o, r)
    by def $geo::is_on_circle(c, o, r)
    by def $geo::is_on_circle(d, o, r)
    release thm geo::distance_sq_symmetric(a, o)
    release thm geo::distance_sq_symmetric(b, o)
    release thm geo::distance_sq_symmetric(c, o)
    release thm geo::distance_sq_symmetric(d, o)
    geo::distance_sq(o, a) = r^2
    geo::distance_sq(o, b) = r^2
    geo::distance_sq(o, c) = r^2
    geo::distance_sq(o, d) = r^2
    by def $geo::is_diameter_endpoints(a, b, o)
    by def $geo::is_midpoint(o, a, b)
    o[1] = (a[1] + b[1]) / 2
    o[2] = (a[2] + b[2]) / 2
    a[1] + b[1] = 2 * o[1]
    a[2] + b[2] = 2 * o[2]
    d[1] - a[1] = (d[1] - o[1]) + (b[1] - o[1])
    d[2] - a[2] = (d[2] - o[2]) + (b[2] - o[2])
    b[1] - a[1] = 2 * (b[1] - o[1])
    b[2] - a[2] = 2 * (b[2] - o[2])
    a[1] - b[1] = -2 * (b[1] - o[1])
    a[2] - b[2] = -2 * (b[2] - o[2])
    c[1] - b[1] = (c[1] - o[1]) - (b[1] - o[1])
    c[2] - b[2] = (c[2] - o[2]) - (b[2] - o[2])

    # 半径条件转为 q=OB、c=OC、d=OD 的等模平方。
    release thm geo::distance_sq_coordinate_formula(o, a)
    release thm geo::distance_sq_coordinate_formula(o, b)
    release thm geo::distance_sq_coordinate_formula(o, c)
    release thm geo::distance_sq_coordinate_formula(o, d)
    (a[1] - o[1])^2 + (a[2] - o[2])^2 = (b[1] - o[1])^2 + (b[2] - o[2])^2
    (b[1] - o[1])^2 + (b[2] - o[2])^2 = (c[1] - o[1])^2 + (c[2] - o[2])^2
    (b[1] - o[1])^2 + (b[2] - o[2])^2 = (d[1] - o[1])^2 + (d[2] - o[2])^2

    # 正半径保证封闭代数核所需的非零模长。
    0 < r^2
    0 < (b[1] - o[1])^2 + (b[2] - o[2])^2
    (b[1] - o[1])^2 + (b[2] - o[2])^2 != 0

    # C、D位于直径AB同一严格侧，特别推出 det(OB,OC)≠0。
    release thm geo::vec_coordinate_formula(a, b)
    release thm geo::vec_coordinate_formula(a, c)
    release thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(a, c))
    geo::det(geo::vec(a, b), geo::vec(a, c)) = 2 * ((b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]))
    geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
    release thm scale_probe::problem_464_scale_nonzero_probe(geo::det(geo::vec(a, b), geo::vec(a, c)), (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]))
    (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]) != 0

    # 展开角和谓词，逐项得到代数核心所需的四个三角量。
    by def $translation::angle_plus_twice_angle_is_straight(d, a, b, a, b, c)
    release thm geo::vec_coordinate_formula(a, d)
    release thm geo::vec_coordinate_formula(b, a)
    release thm geo::vec_coordinate_formula(b, c)
    release thm geo::det_coordinate_formula(geo::vec(a, d), geo::vec(a, b))
    release thm geo::dot_coordinate_formula(geo::vec(a, d), geo::vec(a, b))
    release thm geo::dot_coordinate_formula(geo::vec(b, a), geo::vec(b, c))
    release thm geo::det_coordinate_formula(geo::vec(b, a), geo::vec(b, c))

    geo::det(geo::vec(a, d), geo::vec(a, b)) = 2 * (((d[1] - o[1]) + (b[1] - o[1])) * (b[2] - o[2]) - ((d[2] - o[2]) + (b[2] - o[2])) * (b[1] - o[1]))
    geo::dot(geo::vec(a, d), geo::vec(a, b)) = 2 * (((d[1] - o[1]) + (b[1] - o[1])) * (b[1] - o[1]) + ((d[2] - o[2]) + (b[2] - o[2])) * (b[2] - o[2]))
    geo::dot(geo::vec(b, a), geo::vec(b, c)) = 2 * ((b[1] - o[1])^2 + (b[2] - o[2])^2 - (b[1] - o[1]) * (c[1] - o[1]) - (b[2] - o[2]) * (c[2] - o[2]))
    geo::det(geo::vec(b, a), geo::vec(b, c)) = -2 * ((b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]))

    # 调用已独立验证的角和—代数封闭桥；巨大多项式不再暴露于正式证明。
    release thm bridge2_probe::problem_464_angle_bridge_probe(a, b, c, d, o, r)
    ((d[1] - o[1]) + (b[1] - o[1])) * (c[2] - o[2]) - ((d[2] - o[2]) + (b[2] - o[2])) * (c[1] - o[1]) = 0

    # 将代数结论折回公共几何平行谓词。
    by contra:
        ? o != c
        o = c
        c[1] - o[1] = 0
        c[2] - o[2] = 0
        (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]) = 0
        impossible (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]) != 0
    o != c
    a != d

    release thm geo::vec_coordinate_formula(o, c)
    release thm geo::vec_coordinate_formula(a, d)
    release thm geo::det_coordinate_formula(geo::vec(o, c), geo::vec(a, d))
    geo::det(geo::vec(o, c), geo::vec(a, d)) = (c[1] - o[1]) * (d[2] - a[2]) - (c[2] - o[2]) * (d[1] - a[1])
    release thm final_rewrite_probe::problem_464_final_det_rewrite(d[1] - a[1], d[2] - a[2], (d[1] - o[1]) + (b[1] - o[1]), (d[2] - o[2]) + (b[2] - o[2]), c[1] - o[1], c[2] - o[2])
    (c[1] - o[1]) * (d[2] - a[2]) - (c[2] - o[2]) * (d[1] - a[1]) = 0
    geo::det(geo::vec(o, c), geo::vec(a, d)) = 0
    by def $geo::is_parallel(o, c, a, d)
