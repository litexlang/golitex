# Explicit equality-congruence helpers for the encoded angle-sum identity.
thm problem_464_multiply_equalities:
    ? forall a, b, c, d R:
        a = b,
        c = d
        =>:
            a * c = b * d
    by thm geo::multiply_both_sides(a, b, c)
    a * c = b * c
    by thm geo::multiply_both_sides(c, d, b)
    c * b = d * b
    b * c = c * b
    d * b = b * d
    a * c = b * c = c * b = d * b = b * d

thm problem_464_angle_substitution_scalar:
    ? forall s1, c1, c2, s2, A, B, U, V R:
        s1 * (c2^2 - s2^2) + 2 * c1 * c2 * s2 = 0,
        s1 = 2 * A,
        c1 = 2 * B,
        c2 = 2 * U,
        s2 = -2 * V
        =>:
            (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (-2 * V) * (2 * U) = 0

    by thm problem_464_multiply_equalities(c2, 2 * U, c2, 2 * U)
    c2^2 = (2 * U)^2
    by thm problem_464_multiply_equalities(s2, -2 * V, s2, -2 * V)
    s2^2 = (-2 * V)^2
    by thm geo::subtract_equalities(c2^2, (2 * U)^2, s2^2, (-2 * V)^2)
    c2^2 - s2^2 = (2 * U)^2 - (-2 * V)^2

    by thm problem_464_multiply_equalities(s1, 2 * A, c2^2 - s2^2, (2 * U)^2 - (-2 * V)^2)
    s1 * (c2^2 - s2^2) = (2 * A) * ((2 * U)^2 - (-2 * V)^2)

    by thm problem_464_multiply_equalities(c1, 2 * B, c2, 2 * U)
    c1 * c2 = (2 * B) * (2 * U)
    by thm problem_464_multiply_equalities(c1 * c2, (2 * B) * (2 * U), s2, -2 * V)
    c1 * c2 * s2 = (2 * B) * (2 * U) * (-2 * V)
    by thm geo::multiply_both_sides(c1 * c2 * s2, (2 * B) * (2 * U) * (-2 * V), 2)
    c1 * c2 * s2 * 2 = (2 * B) * (2 * U) * (-2 * V) * 2
    2 * c1 * c2 * s2 = c1 * c2 * s2 * 2
    (2 * B) * (2 * U) * (-2 * V) * 2 = 2 * (2 * B) * (2 * U) * (-2 * V)
    2 * c1 * c2 * s2 = 2 * (2 * B) * (2 * U) * (-2 * V)

    by thm geo::add_equalities(s1 * (c2^2 - s2^2), (2 * A) * ((2 * U)^2 - (-2 * V)^2), 2 * c1 * c2 * s2, 2 * (2 * B) * (2 * U) * (-2 * V))
    s1 * (c2^2 - s2^2) + 2 * c1 * c2 * s2 = (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (2 * U) * (-2 * V)
    (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (2 * U) * (-2 * V) = s1 * (c2^2 - s2^2) + 2 * c1 * c2 * s2 = 0
    2 * (2 * B) * (2 * U) * (-2 * V) = 2 * (2 * B) * (-2 * V) * (2 * U)
    (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (2 * U) * (-2 * V) = (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (-2 * V) * (2 * U)
    (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (-2 * V) * (2 * U) = (2 * A) * ((2 * U)^2 - (-2 * V)^2) + 2 * (2 * B) * (2 * U) * (-2 * V) = 0
