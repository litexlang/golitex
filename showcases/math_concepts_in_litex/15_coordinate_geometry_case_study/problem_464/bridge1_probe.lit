# Problem 464 bridge probe 1: circle/side semantic data to the nonzero algebra premise.
thm problem_464_circle_side_nonzero_bridge_probe:
    ? forall a, b, c, d, o cart(R, R):
        $geo::is_diameter_endpoints(a, b, o)
        $translation::are_on_same_strict_side_of_line(a, b, c, d)
        =>:
            (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]) != 0

    by def $translation::are_on_same_strict_side_of_line(a, b, c, d)
    by def $geo::is_diameter_endpoints(a, b, o)
    by def $geo::is_midpoint(o, a, b)
    o[1] = (a[1] + b[1]) / 2
    o[2] = (a[2] + b[2]) / 2
    a[1] + b[1] = 2 * o[1]
    a[2] + b[2] = 2 * o[2]
    b[1] - a[1] = 2 * (b[1] - o[1])
    b[2] - a[2] = 2 * (b[2] - o[2])

    by thm geo::vec_coordinate_formula(a, b)
    by thm geo::vec_coordinate_formula(a, c)
    by thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(a, c))
    geo::det(geo::vec(a, b), geo::vec(a, c)) = 2 * ((b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]))
    geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
    by thm scale_probe::problem_464_scale_nonzero_probe(geo::det(geo::vec(a, b), geo::vec(a, c)), (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]))
    (b[1] - o[1]) * (c[2] - o[2]) - (b[2] - o[2]) * (c[1] - o[1]) != 0
