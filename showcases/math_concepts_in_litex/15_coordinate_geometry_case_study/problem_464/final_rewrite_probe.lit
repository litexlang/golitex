# Small final coordinate rewrite for Problem 464.
thm problem_464_final_det_rewrite:
    ? forall adx, ady, ux, uy, cx, cy R:
        adx = ux
        ady = uy
        ux * cy - uy * cx = 0
        =>:
            cx * ady - cy * adx = 0
    release thm geo::multiply_both_sides(ady, uy, cx)
    ady * cx = uy * cx
    cx * ady = ady * cx
    uy * cx = cx * uy
    cx * ady = cx * uy

    release thm geo::multiply_both_sides(adx, ux, cy)
    adx * cy = ux * cy
    cy * adx = adx * cy
    ux * cy = cy * ux
    cy * adx = cy * ux

    release thm geo::subtract_equalities(cx * ady, cx * uy, cy * adx, cy * ux)
    cx * ady - cy * adx = cx * uy - cy * ux
    cx * uy - cy * ux = -1 * (ux * cy - uy * cx)
    cx * ady - cy * adx = cx * uy - cy * ux = -1 * (ux * cy - uy * cx) = 0
