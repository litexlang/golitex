# Problem 464 / zhongkao_263 — semantic geometry translation
#
# 原题：如图，四边形ABCD的顶点都在半圆O上，AB是半圆O的直径，
# 连接OC，∠DAB+2∠ABC=180°。(1)求证：OC∥AD。
#
# 本模块只补充公共几何库尚缺的两个原子语义关系：
# - 两点严格位于一条有向直线的同侧；
# - 一个角加另一角的二倍为平角。
#
# 圆上、直径、平行均直接使用 geo 中已有谓词；不再定义任何
# problem_464_* 题号聚合谓词。

# C、D严格位于有向直线AB同侧。
prop are_on_same_strict_side_of_line(a, b, c, d cart(R, R)):
    geo::det(geo::vec(a, b), geo::vec(a, c)) * geo::det(geo::vec(a, b), geo::vec(a, d)) > 0

# ∠PQR + 2∠UVW = 180°。
# 以点积/行列式编码两个有向角；非退化射线是该角关系本身的一部分。
prop angle_plus_twice_angle_is_straight(p, q, r, u, v, w cart(R, R)):
    p != q
    r != q
    u != v
    w != v
    geo::det(geo::vec(q, p), geo::vec(q, r)) * (geo::dot(geo::vec(v, u), geo::vec(v, w))^2 - geo::det(geo::vec(v, u), geo::vec(v, w))^2) + 2 * geo::dot(geo::vec(q, p), geo::vec(q, r)) * geo::dot(geo::vec(v, u), geo::vec(v, w)) * geo::det(geo::vec(v, u), geo::vec(v, w)) = 0
