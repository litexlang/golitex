# Local verification probe for the scalar cancellation used in solution.lit.
thm problem_464_scale_nonzero_probe:
    ? forall detv, x R:
        detv = 2 * x,
        detv != 0
        =>:
            x != 0
    by contra:
        ? x != 0
        x = 0
        2 * x = 2 * 0 = 0
        detv = 2 * x = 0
        impossible detv != 0
    x != 0
