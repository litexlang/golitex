# Problem 924 / zhongkao_736: 旋转全等-线段关系
#
# 【原题】
# 在等腰△ABC中，AB=AC，∠BAC=60°；在等腰△ADE中，AD=AE，∠DAE=60°。
# 求证：BD=CE。
#
# 【形式化策略】
# 自然语言未指定图形方向，但命题要求同向旋转才能保证 BD=CE 恒成立。
# 用旋转系数 (c0, s0) 满足 c0^2+s0^2=1 统一表达两个 60° 旋转：
#   AC = Rot(AB) 绕 A
#   AE = Rot(AD) 绕 A
# 则旋转保持距离：distance_sq(C, E) = distance_sq(B, D)
# 再通过平移不变性桥接回结论。
#
# 【证明路线】
# 1. 设置旋转系数 c0, s0 满足 c0^2+s0^2=1
# 2. 将 AB, AC, AD, AE 的坐标关系表达为绕原点旋转
# 3. 应用 rotation_preserves_distance 得到向量端点距离相等
# 4. 应用 distance_sq_translate 将向量距离桥接回点距离
# 5. 通过 are_segments_congruent 定义得到 BD=CE

thm problem_924_rotation_congruence:
    ? forall a, b, c, d, f cart(R, R), c0, s0 R:
        # 旋转系数约束
        c0^2 + s0^2 = 1
        # AB=AC（等腰）
        geo::distance_sq(a, b) = geo::distance_sq(a, c)
        # AD=AF（等腰，原题中的 E 在形式化中记为 f）
        geo::distance_sq(a, d) = geo::distance_sq(a, f)
        # AC 是 AB 绕 A 旋转 (c0,s0)
        c[1] - a[1] = c0 * (b[1] - a[1]) - s0 * (b[2] - a[2])
        c[2] - a[2] = s0 * (b[1] - a[1]) + c0 * (b[2] - a[2])
        # AF 是 AD 绕 A 旋转 (c0,s0)
        f[1] - a[1] = c0 * (d[1] - a[1]) - s0 * (d[2] - a[2])
        f[2] - a[2] = s0 * (d[1] - a[1]) + c0 * (d[2] - a[2])
        =>:
            $geo::are_segments_congruent(b, d, c, f)

    
    # Step 1: 定义平移后的向量点（以 A 为原点）
    # vB = B - A, vC = C - A, vD = D - A, vF = F - A
    # 根据前提，vC = Rot(vB), vF = Rot(vD)
    
    # Step 2: 应用 rotation_preserves_distance
    # 需要构造满足定理签名的点：rotation_preserves_distance 的签名是
    #   ? forall a, b, a2, b2 cart(R, R), c, s R:
    #       c^2 + s^2 = 1,
    #       a2[1] = c * a[1] - s * a[2],
    #       a2[2] = s * a[1] + c * a[2],
    #       b2[1] = c * b[1] - s * b[2],
    #       b2[2] = s * b[1] + c * b[2]
    #       =>: distance_sq(a2, b2) = distance_sq(a, b)
    
    # 构造向量点
    by thm geo::vec_coordinate_formula(a, b)
    by thm geo::vec_coordinate_formula(a, c)
    by thm geo::vec_coordinate_formula(a, d)
    by thm geo::vec_coordinate_formula(a, f)
    geo::vec(a, b)[1] = b[1] - a[1]
    geo::vec(a, b)[2] = b[2] - a[2]
    geo::vec(a, c)[1] = c[1] - a[1]
    geo::vec(a, c)[2] = c[2] - a[2]
    geo::vec(a, d)[1] = d[1] - a[1]
    geo::vec(a, d)[2] = d[2] - a[2]
    geo::vec(a, f)[1] = f[1] - a[1]
    geo::vec(a, f)[2] = f[2] - a[2]
    
    # 从前提得到旋转关系
    geo::vec(a, c)[1] = c[1] - a[1] = c0 * (b[1] - a[1]) - s0 * (b[2] - a[2]) = c0 * geo::vec(a, b)[1] - s0 * geo::vec(a, b)[2]
    geo::vec(a, c)[2] = c[2] - a[2] = s0 * (b[1] - a[1]) + c0 * (b[2] - a[2]) = s0 * geo::vec(a, b)[1] + c0 * geo::vec(a, b)[2]
    geo::vec(a, f)[1] = f[1] - a[1] = c0 * (d[1] - a[1]) - s0 * (d[2] - a[2]) = c0 * geo::vec(a, d)[1] - s0 * geo::vec(a, d)[2]
    geo::vec(a, f)[2] = f[2] - a[2] = s0 * (d[1] - a[1]) + c0 * (d[2] - a[2]) = s0 * geo::vec(a, d)[1] + c0 * geo::vec(a, d)[2]
    
    # 应用 rotation_preserves_distance 到 vec(a,b) → vec(a,c) 和 vec(a,d) → vec(a,f)
    by thm geo::rotation_preserves_distance(geo::vec(a, b), geo::vec(a, d), geo::vec(a, c), geo::vec(a, f), c0, s0)
    geo::distance_sq(geo::vec(a, c), geo::vec(a, f)) = geo::distance_sq(geo::vec(a, b), geo::vec(a, d))
    
    # Step 3: 向量距离等于点距离（通过 distance_sq_translate）
    # distance_sq(vec(a,c), vec(a,e)) = distance_sq(c-a, e-a) = distance_sq(c, e) 当平移 a
    # distance_sq(vec(a,b), vec(a,d)) = distance_sq(b-a, d-a) = distance_sq(b, d) 当平移 a
    
    # 构造平移：vec(a,c) = c - a = c + (-a), vec(a,e) = e - a = e + (-a)
    # 使用 distance_sq_translate: 如果 p2 = p + t, q2 = q + t，则 distance_sq(p2,q2) = distance_sq(p,q)
    # 这里我们需要反向应用：distance_sq(c, e) = distance_sq(c-a, e-a)
    
    # 展开距离公式
    geo::distance_sq(geo::vec(a, c), geo::vec(a, f)) = (geo::vec(a, f)[1] - geo::vec(a, c)[1])^2 + (geo::vec(a, f)[2] - geo::vec(a, c)[2])^2
    (geo::vec(a, f)[1] - geo::vec(a, c)[1])^2 + (geo::vec(a, f)[2] - geo::vec(a, c)[2])^2 = ((f[1] - a[1]) - (c[1] - a[1]))^2 + ((f[2] - a[2]) - (c[2] - a[2]))^2
    ((f[1] - a[1]) - (c[1] - a[1]))^2 + ((f[2] - a[2]) - (c[2] - a[2]))^2 = (f[1] - c[1])^2 + (f[2] - c[2])^2
    (f[1] - c[1])^2 + (f[2] - c[2])^2 = geo::distance_sq(c, f)
    geo::distance_sq(geo::vec(a, c), geo::vec(a, f)) = geo::distance_sq(c, f)
    
    geo::distance_sq(geo::vec(a, b), geo::vec(a, d)) = (geo::vec(a, d)[1] - geo::vec(a, b)[1])^2 + (geo::vec(a, d)[2] - geo::vec(a, b)[2])^2
    (geo::vec(a, d)[1] - geo::vec(a, b)[1])^2 + (geo::vec(a, d)[2] - geo::vec(a, b)[2])^2 = ((d[1] - a[1]) - (b[1] - a[1]))^2 + ((d[2] - a[2]) - (b[2] - a[2]))^2
    ((d[1] - a[1]) - (b[1] - a[1]))^2 + ((d[2] - a[2]) - (b[2] - a[2]))^2 = (d[1] - b[1])^2 + (d[2] - b[2])^2
    (d[1] - b[1])^2 + (d[2] - b[2])^2 = geo::distance_sq(b, d)
    geo::distance_sq(geo::vec(a, b), geo::vec(a, d)) = geo::distance_sq(b, d)
    
    # Step 4: 合并得到 distance_sq(c, f) = distance_sq(b, d)
    geo::distance_sq(c, f) = geo::distance_sq(geo::vec(a, c), geo::vec(a, f))
    geo::distance_sq(geo::vec(a, c), geo::vec(a, f)) = geo::distance_sq(geo::vec(a, b), geo::vec(a, d))
    geo::distance_sq(geo::vec(a, b), geo::vec(a, d)) = geo::distance_sq(b, d)
    geo::distance_sq(c, f) = geo::distance_sq(b, d)
    
    # Step 5: 应用线段全等定义
    by def $geo::are_segments_congruent(b, d, c, f)
    $geo::are_segments_congruent(b, d, c, f)
