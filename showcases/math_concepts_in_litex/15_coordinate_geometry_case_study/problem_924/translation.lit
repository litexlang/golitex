#     (c[1] - a[1])^2 + (c[2] - a[2])^2 + (((a[1] + c[1] - b[1]) - b[1])^2 + ((a[2] + c[2] - b[2]) - b[2])^2) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - b[1])^2 + (c[2] - b[2])^2)
