#     2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - b[1])^2 + (c[2] - b[2])^2) = 2 * distance_sq(a, b) + 2 * distance_sq(b, c)
#     distance_sq(a, c) + distance_sq(b, d) = 2 * distance_sq(a, b) + 2 * distance_sq(b, c)

# Changing the base point of both vectors negates the determinant
thm det_change_base:
    ? forall p, q, r cart(R, R):
        det(vec(q, p), vec(q, r)) = -(det(vec(p, q), vec(p, r)))
    vec(p, q) = (q[1] - p[1], q[2] - p[2])
    vec(p, r) = (r[1] - p[1], r[2] - p[2])
    vec(q, p) = (p[1] - q[1], p[2] - q[2])
    vec(q, r) = (r[1] - q[1], r[2] - q[2])
    det(vec(q, p), vec(q, r)) = (p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1])
    det(vec(p, q), vec(p, r)) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    (p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1]) = -((q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1]))
    det(vec(q, p), vec(q, r)) = -((q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1]))
    -((q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])) = -(det(vec(p, q), vec(p, r)))
    det(vec(q, p), vec(q, r)) = -(det(vec(p, q), vec(p, r)))

# Changing the base point identity for dot products
thm dot_change_base:
    ? forall p, q, r cart(R, R):
        dot(vec(q, p), vec(q, r)) + dot(vec(p, q), vec(p, r)) = distance_sq(p, q)
    vec(q, p) = (p[1] - q[1], p[2] - q[2])
    vec(q, r) = (r[1] - q[1], r[2] - q[2])
    vec(p, q) = (q[1] - p[1], q[2] - p[2])
    vec(p, r) = (r[1] - p[1], r[2] - p[2])
    dot(vec(q, p), vec(q, r)) = (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])
    dot(vec(p, q), vec(p, r)) = (q[1] - p[1]) * (r[1] - p[1]) + (q[2] - p[2]) * (r[2] - p[2])
    distance_sq(p, q) = dot(vec(p, q), vec(p, q))
    vec(p, q)[1] = q[1] - p[1]
    vec(p, q)[2] = q[2] - p[2]
    dot(vec(p, q), vec(p, q)) = vec(p, q)[1] * vec(p, q)[1] + vec(p, q)[2] * vec(p, q)[2] = (q[1] - p[1])^2 + (q[2] - p[2])^2
    distance_sq(p, q) = (q[1] - p[1])^2 + (q[2] - p[2])^2
    (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]) + ((q[1] - p[1]) * (r[1] - p[1]) + (q[2] - p[2]) * (r[2] - p[2])) = (q[1] - p[1])^2 + (q[2] - p[2])^2
    dot(vec(q, p), vec(q, r)) + dot(vec(p, q), vec(p, r)) = ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])) + dot(vec(p, q), vec(p, r))
    ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])) + dot(vec(p, q), vec(p, r)) = (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]) + ((q[1] - p[1]) * (r[1] - p[1]) + (q[2] - p[2]) * (r[2] - p[2]))
    dot(vec(q, p), vec(q, r)) + dot(vec(p, q), vec(p, r)) = (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]) + ((q[1] - p[1]) * (r[1] - p[1]) + (q[2] - p[2]) * (r[2] - p[2]))
    dot(vec(q, p), vec(q, r)) + dot(vec(p, q), vec(p, r)) = (q[1] - p[1])^2 + (q[2] - p[2])^2
    (q[1] - p[1])^2 + (q[2] - p[2])^2 = distance_sq(p, q)
    dot(vec(q, p), vec(q, r)) + dot(vec(p, q), vec(p, r)) = distance_sq(p, q)

thm collinear_third:
    ? forall p, q, r cart(R, R):
        det(vec(p, q), vec(p, r)) = 0
        =>:
            det(vec(r, p), vec(r, q)) = 0
    vec(p, q) = (q[1] - p[1], q[2] - p[2])
    vec(p, r) = (r[1] - p[1], r[2] - p[2])
    vec(r, p) = (p[1] - r[1], p[2] - r[2])
    vec(r, q) = (q[1] - r[1], q[2] - r[2])
    det(vec(p, q), vec(p, r)) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    det(vec(r, p), vec(r, q)) = (p[1] - r[1]) * (q[2] - r[2]) - (p[2] - r[2]) * (q[1] - r[1])
    (p[1] - r[1]) * (q[2] - r[2]) - (p[2] - r[2]) * (q[1] - r[1]) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    det(vec(r, p), vec(r, q)) = 0

thm parallelogram_sides:
    ? forall a, b, c, d cart(R, R):
        d[1] = a[1] + c[1] - b[1]
        d[2] = a[2] + c[2] - b[2]
        =>:
            distance_sq(a, d) = distance_sq(b, c)
    distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    (d[1] - a[1])^2 + (d[2] - a[2])^2 = ((a[1] + c[1] - b[1]) - a[1])^2 + ((a[2] + c[2] - b[2]) - a[2])^2
    ((a[1] + c[1] - b[1]) - a[1])^2 + ((a[2] + c[2] - b[2]) - a[2])^2 = (c[1] - b[1])^2 + (c[2] - b[2])^2
    distance_sq(a, d) = distance_sq(b, c)

thm circumcenter_equidistant:
    ? forall a, b, c, o cart(R, R):
        distance_sq(o, a) = distance_sq(o, b)
        distance_sq(o, b) = distance_sq(o, c)
        =>:
            distance_sq(o, a) = distance_sq(o, c)
    distance_sq(o, a) = distance_sq(o, c)

thm thales_theorem:
    ? forall a, b, p cart(R, R):
        (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
        =>:
            dot(vec(p, a), vec(p, b)) = 0
    vec(p, a) = (a[1] - p[1], a[2] - p[2])
    vec(p, b) = (b[1] - p[1], b[2] - p[2])
    dot(vec(p, a), vec(p, b)) = (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2])
    (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2]) = (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2
    dot(vec(p, a), vec(p, b)) = 0

thm thales_converse:
    ? forall a, b, p cart(R, R):
        dot(vec(p, a), vec(p, b)) = 0
        =>:
            (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
    vec(p, a) = (a[1] - p[1], a[2] - p[2])
    vec(p, b) = (b[1] - p[1], b[2] - p[2])
    dot(vec(p, a), vec(p, b)) = (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2])
    (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2]) = (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2
    (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
# ═══════════════════════════════════════════════════════════════════════
# Layer 1: Derived theorems (cite Layer 0 theorems by forall instantiation)
# ═══════════════════════════════════════════════════════════════════════

# SAS Third Side: Given two sides and included angle equal, the third side is equal
thm sas_third_side:
    ? forall p, q, r, u, v, w cart(R, R):
        distance_sq(p, q) = distance_sq(u, v)
        distance_sq(q, r) = distance_sq(v, w)
        dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
        =>:
            distance_sq(p, r) = distance_sq(u, w)
    release thm cosine_law(p, q, r)
    release thm cosine_law(u, v, w)
    distance_sq(p, r) = distance_sq(p, q) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r))
    distance_sq(u, w) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(v, u), vec(v, w))
    distance_sq(p, q) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r)) = distance_sq(u, v) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r))
    distance_sq(u, v) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r)) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(q, p), vec(q, r))
    distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(q, p), vec(q, r)) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(v, u), vec(v, w))
    distance_sq(p, r) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(v, u), vec(v, w))
    distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(v, u), vec(v, w)) = distance_sq(u, w)
    distance_sq(p, r) = distance_sq(u, w)

# ═══════════════════════════════════════════════════════════════════════
# 完整的三角形全等定理（Complete Triangle Congruence Theorems）
# ═══════════════════════════════════════════════════════════════════════

# SAS全等（边角边）- 完整版
# 给定两边及其夹角相等，则两三角形全等（所有对应边和角相等）
thm sas_congruence:
    ? forall p, q, r, u, v, w cart(R, R):
        # SAS条件：两边及夹角
        distance_sq(p, q) = distance_sq(u, v)
        distance_sq(q, r) = distance_sq(v, w)
        dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
        =>:
            # 结论：所有对应边相等
            distance_sq(p, r) = distance_sq(u, w)
            distance_sq(p, q) = distance_sq(u, v)
            distance_sq(q, r) = distance_sq(v, w)
            # 所有对应角相等（用dot表示）
            dot(vec(p, q), vec(p, r)) = dot(vec(u, v), vec(u, w))
            dot(vec(r, p), vec(r, q)) = dot(vec(w, u), vec(w, v))
    # First: third side from sas_third_side
    release thm sas_third_side(p, q, r, u, v, w)
    # Second and third: given premises (already true)
    # Fourth: angle at p equals angle at u
    release thm dot_change_base(p, q, r)
    release thm dot_change_base(u, v, w)
    dot(vec(q, p), vec(q, r)) + dot(vec(p, q), vec(p, r)) = distance_sq(p, q)
    dot(vec(v, u), vec(v, w)) + dot(vec(u, v), vec(u, w)) = distance_sq(u, v)
    dot(vec(p, q), vec(p, r)) = distance_sq(p, q) - dot(vec(q, p), vec(q, r))
    dot(vec(u, v), vec(u, w)) = distance_sq(u, v) - dot(vec(v, u), vec(v, w))
    distance_sq(p, q) - dot(vec(q, p), vec(q, r)) = distance_sq(u, v) - dot(vec(q, p), vec(q, r))
    distance_sq(u, v) - dot(vec(q, p), vec(q, r)) = distance_sq(u, v) - dot(vec(v, u), vec(v, w))
    dot(vec(p, q), vec(p, r)) = distance_sq(u, v) - dot(vec(v, u), vec(v, w))
    distance_sq(u, v) - dot(vec(v, u), vec(v, w)) = dot(vec(u, v), vec(u, w))
    dot(vec(p, q), vec(p, r)) = dot(vec(u, v), vec(u, w))
    # Fifth: angle at r equals angle at w
    release thm dot_change_base(r, p, q)
    release thm dot_change_base(w, u, v)
    dot(vec(p, r), vec(p, q)) + dot(vec(r, p), vec(r, q)) = distance_sq(r, p)
    dot(vec(u, w), vec(u, v)) + dot(vec(w, u), vec(w, v)) = distance_sq(w, u)
    dot(vec(r, p), vec(r, q)) = distance_sq(r, p) - dot(vec(p, r), vec(p, q))
    dot(vec(w, u), vec(w, v)) = distance_sq(w, u) - dot(vec(u, w), vec(u, v))
    release thm distance_sq_symmetric(r, p)
    release thm distance_sq_symmetric(w, u)
    distance_sq(r, p) = distance_sq(p, r)
    distance_sq(w, u) = distance_sq(u, w)
    dot(vec(r, p), vec(r, q)) = distance_sq(p, r) - dot(vec(p, r), vec(p, q))
    dot(vec(w, u), vec(w, v)) = distance_sq(u, w) - dot(vec(u, w), vec(u, v))
    release thm dot_commutative(p, r, p, q)
    release thm dot_commutative(u, w, u, v)
    dot(vec(p, r), vec(p, q)) = dot(vec(p, q), vec(p, r))
    dot(vec(u, w), vec(u, v)) = dot(vec(u, v), vec(u, w))
    distance_sq(p, r) - dot(vec(p, r), vec(p, q)) = distance_sq(p, r) - dot(vec(p, q), vec(p, r))
    dot(vec(r, p), vec(r, q)) = distance_sq(p, r) - dot(vec(p, q), vec(p, r))
    distance_sq(u, w) - dot(vec(u, w), vec(u, v)) = distance_sq(u, w) - dot(vec(u, v), vec(u, w))
    dot(vec(w, u), vec(w, v)) = distance_sq(u, w) - dot(vec(u, v), vec(u, w))
    distance_sq(p, r) - dot(vec(p, q), vec(p, r)) = distance_sq(u, w) - dot(vec(p, q), vec(p, r))
    distance_sq(u, w) - dot(vec(p, q), vec(p, r)) = distance_sq(u, w) - dot(vec(u, v), vec(u, w))
    dot(vec(r, p), vec(r, q)) = distance_sq(u, w) - dot(vec(u, v), vec(u, w))
    distance_sq(u, w) - dot(vec(u, v), vec(u, w)) = dot(vec(w, u), vec(w, v))
    dot(vec(r, p), vec(r, q)) = dot(vec(w, u), vec(w, v))

# SSS全等（边边边）- 完整版
# 给定三边对应相等，则两三角形全等（所有对应角相等）
thm sss_congruence:
    ? forall p, q, r, u, v, w cart(R, R):
        # SSS条件：三边相等
        distance_sq(p, q) = distance_sq(u, v)
        distance_sq(q, r) = distance_sq(v, w)
        distance_sq(p, r) = distance_sq(u, w)
        =>:
            # 结论：所有对应角相等
            dot(vec(p, q), vec(p, r)) = dot(vec(u, v), vec(u, w))
            dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
            dot(vec(r, p), vec(r, q)) = dot(vec(w, u), vec(w, v))
    # Angle at q equals angle at v: use cosine law to express dot products
    release thm cosine_law(p, q, r)
    release thm cosine_law(u, v, w)
    distance_sq(p, r) = distance_sq(p, q) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r))
    distance_sq(u, w) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(v, u), vec(v, w))
    # Use SSS premises to show the RHS of both cosine laws are equal
    # Step 1: Replace distance_sq(p,q) with distance_sq(u,v) in first cosine law
    distance_sq(p, q) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r)) = distance_sq(u, v) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r))
    # Step 2: Replace distance_sq(q,r) with distance_sq(v,w)
    distance_sq(u, v) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r)) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(q, p), vec(q, r))
    # Now we have: distance_sq(p,r) = distance_sq(u,v) + distance_sq(v,w) - 2*dot(q,p,q,r)
    distance_sq(p, r) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(q, p), vec(q, r))
    # From premise distance_sq(p,r) = distance_sq(u,w) and the second cosine law:
    distance_sq(u, w) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(q, p), vec(q, r))
    # Combine with the second cosine law that states distance_sq(u,w) = distance_sq(u,v) + distance_sq(v,w) - 2*dot(v,u,v,w):
    distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(q, p), vec(q, r)) = distance_sq(u, v) + distance_sq(v, w) - 2 * dot(vec(v, u), vec(v, w))
    # Use axiom to cancel common (distance_sq(u,v) + distance_sq(v,w)) term
    release thm cancel_subtraction_in_sum(distance_sq(u, v), distance_sq(v, w), dot(vec(q, p), vec(q, r)), dot(vec(v, u), vec(v, w)))
    dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
    # Use dot_change_base to get the first conclusion
    release thm dot_change_base(p, q, r)
    release thm dot_change_base(u, v, w)
    dot(vec(q, p), vec(q, r)) = distance_sq(p, q) - dot(vec(p, q), vec(p, r))
    dot(vec(v, u), vec(v, w)) = distance_sq(u, v) - dot(vec(u, v), vec(u, w))
    distance_sq(p, q) - dot(vec(p, q), vec(p, r)) = dot(vec(q, p), vec(q, r))
    dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
    dot(vec(v, u), vec(v, w)) = distance_sq(u, v) - dot(vec(u, v), vec(u, w))
    distance_sq(p, q) - dot(vec(p, q), vec(p, r)) = distance_sq(u, v) - dot(vec(u, v), vec(u, w))
    release thm subtract_equalities(distance_sq(p, q), distance_sq(u, v), dot(vec(u, v), vec(u, w)), dot(vec(u, v), vec(u, w)))
    distance_sq(p, q) - dot(vec(u, v), vec(u, w)) = distance_sq(u, v) - dot(vec(u, v), vec(u, w))
    distance_sq(p, q) - dot(vec(p, q), vec(p, r)) = distance_sq(p, q) - dot(vec(u, v), vec(u, w))
    dot(vec(p, q), vec(p, r)) = distance_sq(p, q) - (distance_sq(p, q) - dot(vec(p, q), vec(p, r))) = distance_sq(p, q) - (distance_sq(p, q) - dot(vec(u, v), vec(u, w))) = dot(vec(u, v), vec(u, w))
    # Second conclusion already proven above
    # Third conclusion: angle at r equals angle at w
    # Use cosine law with middle vertex at r and w (same pattern as angle_at_q)
    release thm cosine_law(p, r, q)
    release thm cosine_law(u, w, v)
    distance_sq(p, q) = distance_sq(p, r) + distance_sq(r, q) - 2 * dot(vec(r, p), vec(r, q))
    distance_sq(u, v) = distance_sq(u, w) + distance_sq(w, v) - 2 * dot(vec(w, u), vec(w, v))
    # Step 1: Replace distance_sq(p,r) with distance_sq(u,w) in first cosine law
    distance_sq(p, r) + distance_sq(r, q) - 2 * dot(vec(r, p), vec(r, q)) = distance_sq(u, w) + distance_sq(r, q) - 2 * dot(vec(r, p), vec(r, q))
    # Step 2: Replace distance_sq(r,q) with distance_sq(w,v) using symmetry
    release thm distance_sq_symmetric(r, q)
    release thm distance_sq_symmetric(w, v)
    distance_sq(r, q) = distance_sq(q, r)
    distance_sq(w, v) = distance_sq(v, w)
    distance_sq(u, w) + distance_sq(r, q) - 2 * dot(vec(r, p), vec(r, q)) = distance_sq(u, w) + distance_sq(q, r) - 2 * dot(vec(r, p), vec(r, q))
    distance_sq(u, w) + distance_sq(q, r) - 2 * dot(vec(r, p), vec(r, q)) = distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(r, p), vec(r, q))
    # Now we have: distance_sq(p,q) = distance_sq(u,w) + distance_sq(v,w) - 2*dot(r,p,r,q)
    distance_sq(p, q) = distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(r, p), vec(r, q))
    distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(r, p), vec(r, q)) = distance_sq(p, q)
    distance_sq(p, q) = distance_sq(u, v)
    distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(r, p), vec(r, q)) = distance_sq(u, v)
    distance_sq(u, v) = distance_sq(u, w) + distance_sq(w, v) - 2 * dot(vec(w, u), vec(w, v))
    distance_sq(u, w) + distance_sq(w, v) - 2 * dot(vec(w, u), vec(w, v)) = distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(w, u), vec(w, v))
    distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(r, p), vec(r, q)) = distance_sq(u, w) + distance_sq(v, w) - 2 * dot(vec(w, u), vec(w, v))
    release thm cancel_subtraction_in_sum(distance_sq(u, w), distance_sq(v, w), dot(vec(r, p), vec(r, q)), dot(vec(w, u), vec(w, v)))
    dot(vec(r, p), vec(r, q)) = dot(vec(w, u), vec(w, v))


# ═══════════════════════════════════════════════════════════════════════
# ASA Congruence - Supporting Lemmas
# ═══════════════════════════════════════════════════════════════════════

# Lemma 1: Existence of point on segment with specific distance
# 在线段上存在一点，使其到线段端点的距离等于给定距离
# This is needed for the contradiction proof of ASA
# ═══════════════════════════════════════════════════════════════════════
# ASA Congruence - Direct algebraic proof
# Replaces the former construction/order axioms with verified coordinate
# and scalar elimination lemmas.
# ═══════════════════════════════════════════════════════════════════════

thm distance_sq_positive_of_ne:
    ? forall a, b cart(R, R):
        a != b
        =>:
            0 < distance_sq(a, b)
    by contra:
        ? 0 < distance_sq(a, b)
        distance_sq(a, b) <= 0
        release thm distance_sq_nonnegative(a, b)
        distance_sq(a, b) = 0
        release thm distance_sq_coordinate_formula(a, b)
        (b[1] - a[1])^2 + (b[2] - a[2])^2 = 0
        0 <= (b[1] - a[1])^2
        0 <= (b[2] - a[2])^2
        (b[1] - a[1])^2 <= (b[1] - a[1])^2 + (b[2] - a[2])^2 = 0
        (b[2] - a[2])^2 <= (b[1] - a[1])^2 + (b[2] - a[2])^2 = 0
        (b[1] - a[1])^2 = 0
        (b[2] - a[2])^2 = 0
        b[1] - a[1] = 0
        b[2] - a[2] = 0
        a[1] = b[1]
        a[2] = b[2]
        a = (a[1], a[2])
        b = (b[1], b[2])
        (a[1], a[2]) = (b[1], b[2])
        a = (a[1], a[2]) = (b[1], b[2]) = b
        a = b
        impossible a != b

# NOTE: This theorem requires real number order axioms (trichotomy: x<0 or x=0 or x>0)
# which are not currently axiomatized in this KB. Commented out until order axioms added.
# thm sum_of_positive_nonzero:
#     ? forall x, y R:
#         0 < x,
#         0 < y
#         =>:
#             x + y != 0
#     by contra:
#         ? x + y != 0
#         x + y = 0
#         y = -x
#         0 < y = -x
#         0 < -x
#         -x > 0
#         x < 0
#         impossible 0 < x


# Pure scalar core used by the direct ASA proof.

thm twice_dot_from_distances_direct:
    ? forall p, q, r cart(R, R):
        2 * dot(vec(q, p), vec(q, r)) = distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)
    release thm distance_sq_coordinate_formula(p, q)
    release thm distance_sq_coordinate_formula(q, r)
    release thm distance_sq_coordinate_formula(p, r)
    release thm perpendicular_dot_expand(q, p, q, r)
    dot(vec(q, p), vec(q, r)) = (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])
    distance_sq(p, q) = (q[1] - p[1])^2 + (q[2] - p[2])^2
    distance_sq(q, r) = (r[1] - q[1])^2 + (r[2] - q[2])^2
    distance_sq(p, r) = (r[1] - p[1])^2 + (r[2] - p[2])^2
    2 * dot(vec(q, p), vec(q, r)) = 2 * ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]))
    2 * ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])) = ((q[1] - p[1])^2 + (q[2] - p[2])^2) + ((r[1] - q[1])^2 + (r[2] - q[2])^2) - ((r[1] - p[1])^2 + (r[2] - p[2])^2)
    ((q[1] - p[1])^2 + (q[2] - p[2])^2) + ((r[1] - q[1])^2 + (r[2] - q[2])^2) - ((r[1] - p[1])^2 + (r[2] - p[2])^2) = distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)
    2 * dot(vec(q, p), vec(q, r)) = distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)

thm asa_scalar_core:
    ? forall a, b, c, A, B R:
        c > 0
        a >= 0
        b >= 0
        A >= 0
        B >= 0
        A * (c + b - a) = a * (c + B - A)
        B * (c + a - b) = b * (c + A - B)
        =>:
            A = a
            B = b

    # Add the two angle equations.
    release thm add_equalities(A * (c + b - a), a * (c + B - A), B * (c + a - b), b * (c + A - B))

    # Move the common right-hand side to zero.
    release thm subtract_equalities(A * (c + b - a) + B * (c + a - b), a * (c + B - A) + b * (c + A - B), a * (c + B - A) + b * (c + A - B), a * (c + B - A) + b * (c + A - B))
    A * (c + b - a) + B * (c + a - b) - (a * (c + B - A) + b * (c + A - B)) = c * (A + B - a - b)
    (a * (c + B - A) + b * (c + A - B)) - (a * (c + B - A) + b * (c + A - B)) = 0
    c * (A + B - a - b) = 0

    c != 0
    release thm zero_factor_law(c, A + B - a - b)
    A + B - a - b = 0
    release thm rearrange_sum(A + B, a, b)
    A + B = a + b

    # Isolate B using the sum equation.
    release thm subtract_equalities(A + B, a + b, A, A)
    A + B - A = a + b - A
    B = a + b - A

    # Substitute B in the first angle equation via explicit congruence steps.
    release thm add_equalities(c, c, B, a + b - A)
    c + B = c + (a + b - A)
    release thm subtract_equalities(c + B, c + (a + b - A), A, A)
    c + B - A = c + (a + b - A) - A
    release thm multiply_both_sides(c + B - A, c + (a + b - A) - A, a)
    a * (c + B - A) = (c + B - A) * a = (c + (a + b - A) - A) * a = a * (c + (a + b - A) - A)
    A * (c + b - a) = a * (c + (a + b - A) - A)
    release thm subtract_equalities(A * (c + b - a), a * (c + (a + b - A) - A), a * (c + (a + b - A) - A), a * (c + (a + b - A) - A))
    A * (c + b - a) - a * (c + (a + b - A) - A) = (c + a + b) * (A - a)
    a * (c + (a + b - A) - A) - a * (c + (a + b - A) - A) = 0
    (c + a + b) * (A - a) = 0

    c + a + b > 0
    c + a + b != 0
    release thm zero_factor_law(c + a + b, A - a)
    A - a = 0
    A = a

    # Finish B from the sum equality.
    B = a + b - A = a + b - a = b

thm asa_angle_equations_bridge:
    ? forall p, q, r, u, v, w cart(R, R):
        distance_sq(p, q) = distance_sq(u, v)
        dot(vec(p, q), vec(p, r)) * distance_sq(v, w) = dot(vec(u, v), vec(u, w)) * distance_sq(q, r)
        dot(vec(q, p), vec(q, r)) * distance_sq(w, u) = dot(vec(v, u), vec(v, w)) * distance_sq(r, p)
        =>:
            distance_sq(v, w) * (distance_sq(p, q) + distance_sq(p, r) - distance_sq(q, r)) = distance_sq(q, r) * (distance_sq(p, q) + distance_sq(u, w) - distance_sq(v, w))
            distance_sq(u, w) * (distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)) = distance_sq(p, r) * (distance_sq(p, q) + distance_sq(v, w) - distance_sq(u, w))

    release thm twice_dot_from_distances_direct(q, p, r)
    release thm twice_dot_from_distances_direct(v, u, w)
    release thm twice_dot_from_distances_direct(p, q, r)
    release thm twice_dot_from_distances_direct(u, v, w)
    release thm distance_sq_symmetric(p, q)
    release thm distance_sq_symmetric(u, v)
    release thm distance_sq_symmetric(p, r)
    release thm distance_sq_symmetric(u, w)

    distance_sq(q, p) = distance_sq(p, q)
    distance_sq(v, u) = distance_sq(u, v) = distance_sq(p, q)
    distance_sq(r, p) = distance_sq(p, r)
    distance_sq(w, u) = distance_sq(u, w)

    2 * dot(vec(p, q), vec(p, r)) = distance_sq(q, p) + distance_sq(p, r) - distance_sq(q, r) = distance_sq(p, q) + distance_sq(p, r) - distance_sq(q, r)
    2 * dot(vec(u, v), vec(u, w)) = distance_sq(v, u) + distance_sq(u, w) - distance_sq(v, w) = distance_sq(p, q) + distance_sq(u, w) - distance_sq(v, w)
    2 * dot(vec(q, p), vec(q, r)) = distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)
    2 * dot(vec(v, u), vec(v, w)) = distance_sq(u, v) + distance_sq(v, w) - distance_sq(u, w) = distance_sq(p, q) + distance_sq(v, w) - distance_sq(u, w)

    distance_sq(v, w) * (distance_sq(p, q) + distance_sq(p, r) - distance_sq(q, r)) = distance_sq(v, w) * (2 * dot(vec(p, q), vec(p, r))) = 2 * (dot(vec(p, q), vec(p, r)) * distance_sq(v, w)) = 2 * (dot(vec(u, v), vec(u, w)) * distance_sq(q, r)) = distance_sq(q, r) * (2 * dot(vec(u, v), vec(u, w))) = distance_sq(q, r) * (distance_sq(p, q) + distance_sq(u, w) - distance_sq(v, w))

    distance_sq(u, w) * (distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)) = distance_sq(w, u) * (2 * dot(vec(q, p), vec(q, r))) = 2 * (dot(vec(q, p), vec(q, r)) * distance_sq(w, u)) = 2 * (dot(vec(v, u), vec(v, w)) * distance_sq(r, p)) = distance_sq(r, p) * (2 * dot(vec(v, u), vec(v, w))) = distance_sq(p, r) * (distance_sq(p, q) + distance_sq(v, w) - distance_sq(u, w))


# ASA congruence by direct scalar elimination, with no geometric construction axioms.

thm asa_congruence:
    ? forall p, q, r, u, v, w cart(R, R):
        p != q
        q != r
        r != p
        u != v
        v != w
        w != u
        distance_sq(p, q) = distance_sq(u, v)
        dot(vec(p, q), vec(p, r)) * distance_sq(v, w) = dot(vec(u, v), vec(u, w)) * distance_sq(q, r)
        dot(vec(q, p), vec(q, r)) * distance_sq(w, u) = dot(vec(v, u), vec(v, w)) * distance_sq(r, p)
        =>:
            distance_sq(q, r) = distance_sq(v, w)
            distance_sq(p, r) = distance_sq(u, w)

    release thm asa_angle_equations_bridge(p, q, r, u, v, w)
    release thm distance_sq_positive_of_ne(p, q)
    release thm distance_sq_nonnegative(q, r)
    release thm distance_sq_nonnegative(p, r)
    release thm distance_sq_nonnegative(v, w)
    release thm distance_sq_nonnegative(u, w)

    release thm asa_scalar_core(distance_sq(q, r), distance_sq(p, r), distance_sq(p, q), distance_sq(v, w), distance_sq(u, w))

    distance_sq(v, w) = distance_sq(q, r)
    distance_sq(u, w) = distance_sq(p, r)
    distance_sq(q, r) = distance_sq(v, w)
    distance_sq(p, r) = distance_sq(u, w)

thm perpendicular_symmetric:
    ? forall a, b, c, d cart(R, R):
        dot(vec(a, b), vec(c, d)) = 0
        =>:
            dot(vec(c, d), vec(a, b)) = 0
    dot(vec(c, d), vec(a, b)) = dot(vec(a, b), vec(c, d))
    dot(vec(c, d), vec(a, b)) = 0

thm parallel_symmetric:
    ? forall a, b, c, d cart(R, R):
        det(vec(a, b), vec(c, d)) = 0
        =>:
            det(vec(c, d), vec(a, b)) = 0
    det(vec(c, d), vec(a, b)) = -(det(vec(a, b), vec(c, d)))
    det(vec(c, d), vec(a, b)) = 0

# SSS: the three squared side equalities determine the included dot product.
thm sss_dot_equal:
    ? forall p, q, r, u, v, w cart(R, R):
        distance_sq(p, q) = distance_sq(u, v)
        distance_sq(q, r) = distance_sq(v, w)
        distance_sq(p, r) = distance_sq(u, w)
        =>:
            dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
    release thm twice_dot_from_distances_direct(p, q, r)
    release thm twice_dot_from_distances_direct(u, v, w)
    2 * dot(vec(q, p), vec(q, r)) = distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)
    distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r) = distance_sq(u, v) + distance_sq(v, w) - distance_sq(u, w)
    distance_sq(u, v) + distance_sq(v, w) - distance_sq(u, w) = 2 * dot(vec(v, u), vec(v, w))
    2 * dot(vec(q, p), vec(q, r)) = 2 * dot(vec(v, u), vec(v, w))
    dot(vec(q, p), vec(q, r)) = (2 * dot(vec(q, p), vec(q, r))) / 2 = (2 * dot(vec(v, u), vec(v, w))) / 2 = dot(vec(v, u), vec(v, w))

thm isosceles_base_dot:
    ? forall a, b, c cart(R, R):
        distance_sq(a, b) = distance_sq(a, c)
        =>:
            dot(vec(b, a), vec(b, c)) = dot(vec(c, a), vec(c, b))
    dot(vec(b, a), vec(b, c)) = (distance_sq(a, b) + distance_sq(b, c) - distance_sq(a, c)) / 2
    dot(vec(c, a), vec(c, b)) = (distance_sq(a, c) + distance_sq(c, b) - distance_sq(a, b)) / 2
    distance_sq(b, c) = distance_sq(c, b)
    dot(vec(b, a), vec(b, c)) = dot(vec(c, a), vec(c, b))

# Converse of isosceles_base_dot: equal base angles imply equal sides
# NOTE: The general converse requires additional non-degeneracy constraints.
# This theorem was removed after counterexample verification showed the stated
# premises insufficient. Future formalization should add triangle inequality
# or explicit angle measure constraints.

thm pythagorean_theorem:
    ? forall a, b, c cart(R, R):
        dot(vec(b, a), vec(b, c)) = 0
        =>:
            distance_sq(a, c) = distance_sq(a, b) + distance_sq(b, c)
    distance_sq(a, c) = distance_sq(a, b) + distance_sq(b, c) - 2 * dot(vec(b, a), vec(b, c))
    distance_sq(a, b) + distance_sq(b, c) - 2 * dot(vec(b, a), vec(b, c)) = distance_sq(a, b) + distance_sq(b, c)
    distance_sq(a, c) = distance_sq(a, b) + distance_sq(b, c)

# ═══════════════════════════════════════════════════════════════════════
# Layer 2: Advanced coordinate theorems (pure polynomial identities)
# ═══════════════════════════════════════════════════════════════════════

# Stewart's theorem for an affine point on the segment from b to c.
thm stewart_theorem:
    ? forall a, b, c, d cart(R, R), t R:
        d[1] = (1 - t) * b[1] + t * c[1]
        d[2] = (1 - t) * b[2] + t * c[2]
        =>:
            distance_sq(a, d) = (1 - t) * distance_sq(a, b) + t * distance_sq(a, c) - t * (1 - t) * distance_sq(b, c)
    release thm distance_sq_coordinate_formula(a, d)
    release thm distance_sq_coordinate_formula(a, b)
    release thm distance_sq_coordinate_formula(a, c)
    release thm distance_sq_coordinate_formula(b, c)
    (d[1] - a[1])^2 + (d[2] - a[2])^2 = (((1 - t) * b[1] + t * c[1]) - a[1])^2 + (((1 - t) * b[2] + t * c[2]) - a[2])^2
    (((1 - t) * b[1] + t * c[1]) - a[1])^2 + (((1 - t) * b[2] + t * c[2]) - a[2])^2 = (1 - t) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + t * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - t * (1 - t) * ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2 = (((1 - t) * b[1] + t * c[1]) - a[1])^2 + (((1 - t) * b[2] + t * c[2]) - a[2])^2 = (1 - t) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + t * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - t * (1 - t) * ((c[1] - b[1])^2 + (c[2] - b[2])^2) = (1 - t) * distance_sq(a, b) + t * distance_sq(a, c) - t * (1 - t) * distance_sq(b, c)

# Coordinate-form version, retained for reference:
# thm centroid_distance_coordinate:
#     ? forall a, b, c, g cart(R, R):
#         g[1] = (a[1] + b[1] + c[1]) / 3,
#         g[2] = (a[2] + b[2] + c[2]) / 3
#         =>:
#             distance_sq(a, g) + distance_sq(b, g) + distance_sq(c, g) = (distance_sq(a, b) + distance_sq(b, c) + distance_sq(a, c)) / 3
#     distance_sq(a, g) = (g[1] - a[1])^2 + (g[2] - a[2])^2
#     distance_sq(b, g) = (g[1] - b[1])^2 + (g[2] - b[2])^2
#     distance_sq(c, g) = (g[1] - c[1])^2 + (g[2] - c[2])^2
#     distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
#     distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
#     distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
#     (g[1] - a[1])^2 + (g[2] - a[2])^2 + ((g[1] - b[1])^2 + (g[2] - b[2])^2) + ((g[1] - c[1])^2 + (g[2] - c[2])^2) = (((a[1] + b[1] + c[1]) / 3 - a[1])^2 + ((a[2] + b[2] + c[2]) / 3 - a[2])^2) + (((a[1] + b[1] + c[1]) / 3 - b[1])^2 + ((a[2] + b[2] + c[2]) / 3 - b[2])^2) + (((a[1] + b[1] + c[1]) / 3 - c[1])^2 + ((a[2] + b[2] + c[2]) / 3 - c[2])^2)
#     (((a[1] + b[1] + c[1]) / 3 - a[1])^2 + ((a[2] + b[2] + c[2]) / 3 - a[2])^2) + (((a[1] + b[1] + c[1]) / 3 - b[1])^2 + ((a[2] + b[2] + c[2]) / 3 - b[2])^2) + (((a[1] + b[1] + c[1]) / 3 - c[1])^2 + ((a[2] + b[2] + c[2]) / 3 - c[2])^2) = ((b[1] - a[1])^2 + (b[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) + ((c[1] - a[1])^2 + (c[2] - a[2])^2)) / 3
#     distance_sq(a, g) + distance_sq(b, g) + distance_sq(c, g) = (g[1] - a[1])^2 + (g[2] - a[2])^2 + ((g[1] - b[1])^2 + (g[2] - b[2])^2) + ((g[1] - c[1])^2 + (g[2] - c[2])^2)
#     (distance_sq(a, b) + distance_sq(b, c) + distance_sq(a, c)) / 3 = ((b[1] - a[1])^2 + (b[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) + ((c[1] - a[1])^2 + (c[2] - a[2])^2)) / 3
#     distance_sq(a, g) + distance_sq(b, g) + distance_sq(c, g) = (distance_sq(a, b) + distance_sq(b, c) + distance_sq(a, c)) / 3

# The sum of squared distances to the centroid equals one third of the
# sum of the squared side lengths.
thm centroid_distance:
    ? forall a, b, c, g cart(R, R):
        $is_centroid(g, a, b, c)
        =>:
            distance_sq(a, g) + distance_sq(b, g) + distance_sq(c, g) = (distance_sq(a, b) + distance_sq(b, c) + distance_sq(a, c)) / 3
    g[1] = (a[1] + b[1] + c[1]) / 3
    g[2] = (a[2] + b[2] + c[2]) / 3
    distance_sq(a, g) = (g[1] - a[1])^2 + (g[2] - a[2])^2
    distance_sq(b, g) = (g[1] - b[1])^2 + (g[2] - b[2])^2
    distance_sq(c, g) = (g[1] - c[1])^2 + (g[2] - c[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    (g[1] - a[1])^2 + (g[2] - a[2])^2 + ((g[1] - b[1])^2 + (g[2] - b[2])^2) + ((g[1] - c[1])^2 + (g[2] - c[2])^2) = (((a[1] + b[1] + c[1]) / 3 - a[1])^2 + ((a[2] + b[2] + c[2]) / 3 - a[2])^2) + (((a[1] + b[1] + c[1]) / 3 - b[1])^2 + ((a[2] + b[2] + c[2]) / 3 - b[2])^2) + (((a[1] + b[1] + c[1]) / 3 - c[1])^2 + ((a[2] + b[2] + c[2]) / 3 - c[2])^2)
    (((a[1] + b[1] + c[1]) / 3 - a[1])^2 + ((a[2] + b[2] + c[2]) / 3 - a[2])^2) + (((a[1] + b[1] + c[1]) / 3 - b[1])^2 + ((a[2] + b[2] + c[2]) / 3 - b[2])^2) + (((a[1] + b[1] + c[1]) / 3 - c[1])^2 + ((a[2] + b[2] + c[2]) / 3 - c[2])^2) = ((b[1] - a[1])^2 + (b[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) + ((c[1] - a[1])^2 + (c[2] - a[2])^2)) / 3
    distance_sq(a, g) + distance_sq(b, g) + distance_sq(c, g) = (g[1] - a[1])^2 + (g[2] - a[2])^2 + ((g[1] - b[1])^2 + (g[2] - b[2])^2) + ((g[1] - c[1])^2 + (g[2] - c[2])^2)
    (distance_sq(a, b) + distance_sq(b, c) + distance_sq(a, c)) / 3 = ((b[1] - a[1])^2 + (b[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) + ((c[1] - a[1])^2 + (c[2] - a[2])^2)) / 3
    distance_sq(a, g) + distance_sq(b, g) + distance_sq(c, g) = (distance_sq(a, b) + distance_sq(b, c) + distance_sq(a, c)) / 3

thm triangle_area_det:
    ? forall a, b, c cart(R, R):
        det(vec(a, b), vec(a, c)) = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    vec(a, c) = (c[1] - a[1], c[2] - a[2])
    det(vec(a, b), vec(a, c)) = vec(a, b)[1] * vec(a, c)[2] - vec(a, b)[2] * vec(a, c)[1] = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])

# Determinant is additive in its second argument.
thm det_bilinear_right:
    ? forall u, v, w cart(R, R):
        det(u, (v[1] + w[1], v[2] + w[2])) = det(u, v) + det(u, w)
    release thm det_coordinate_formula(u, (v[1] + w[1], v[2] + w[2]))
    release thm det_coordinate_formula(u, v)
    release thm det_coordinate_formula(u, w)
    u[1] * (v[2] + w[2]) - u[2] * (v[1] + w[1]) = (u[1] * v[2] - u[2] * v[1]) + (u[1] * w[2] - u[2] * w[1])
    det(u, (v[1] + w[1], v[2] + w[2])) = u[1] * (v[2] + w[2]) - u[2] * (v[1] + w[1]) = (u[1] * v[2] - u[2] * v[1]) + (u[1] * w[2] - u[2] * w[1]) = det(u, v) + det(u, w)

# Strict finite-center lemmas for the coordinate concyclicity criterion.
# The nonzero determinant gives a finite center through a, b, and d;
# the determinant criterion then forces c to have the same squared radius.

# Isolated division/cancellation probes for strict concyclicity.

thm div_mul_cancel_probe:
    ? forall a, b R:
        b != 0
        =>:
            (a / b) * b = a
    (a / b) * b = a

thm cramer_first_circle_equation:
    ? forall x1, y1, x2, y2, s1, s2, delta R:
        delta = x1 * y2 - y1 * x2
        delta != 0
        =>:
            2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x1 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y1) = s1
    2 * delta != 0
    release thm div_mul_cancel_probe(s1 * y2 - y1 * s2, 2 * delta)
    release thm div_mul_cancel_probe(x1 * s2 - s1 * x2, 2 * delta)
    (2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x1 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y1)) * delta = (((s1 * y2 - y1 * s2) / (2 * delta)) * (2 * delta)) * x1 + (((x1 * s2 - s1 * x2) / (2 * delta)) * (2 * delta)) * y1
    (((s1 * y2 - y1 * s2) / (2 * delta)) * (2 * delta)) * x1 + (((x1 * s2 - s1 * x2) / (2 * delta)) * (2 * delta)) * y1 = (s1 * y2 - y1 * s2) * x1 + (x1 * s2 - s1 * x2) * y1
    (s1 * y2 - y1 * s2) * x1 + (x1 * s2 - s1 * x2) * y1 = s1 * (x1 * y2 - y1 * x2)
    s1 * (x1 * y2 - y1 * x2) = s1 * delta
    2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x1 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y1) * delta = s1 * delta
    release thm divide_both_sides(2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x1 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y1), s1, delta)

thm cramer_second_circle_equation:
    ? forall x1, y1, x2, y2, s1, s2, delta R:
        delta = x1 * y2 - y1 * x2
        delta != 0
        =>:
            2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x2 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y2) = s2
    2 * delta != 0
    release thm div_mul_cancel_probe(s1 * y2 - y1 * s2, 2 * delta)
    release thm div_mul_cancel_probe(x1 * s2 - s1 * x2, 2 * delta)
    (2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x2 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y2)) * delta = (((s1 * y2 - y1 * s2) / (2 * delta)) * (2 * delta)) * x2 + (((x1 * s2 - s1 * x2) / (2 * delta)) * (2 * delta)) * y2
    (((s1 * y2 - y1 * s2) / (2 * delta)) * (2 * delta)) * x2 + (((x1 * s2 - s1 * x2) / (2 * delta)) * (2 * delta)) * y2 = (s1 * y2 - y1 * s2) * x2 + (x1 * s2 - s1 * x2) * y2
    (s1 * y2 - y1 * s2) * x2 + (x1 * s2 - s1 * x2) * y2 = s2 * (x1 * y2 - y1 * x2)
    s2 * (x1 * y2 - y1 * x2) = s2 * delta
    2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x2 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y2) * delta = s2 * delta
    release thm divide_both_sides(2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x2 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y2), s2, delta)

thm zero_sum_rearrange:
    ? forall a, b R:
        a + b = 0
        =>:
            -a = b
    -a = -a + 0 = -a + (a + b) = b

thm sub_add_cancel:
    ? forall a, b R:
        a - b + b = a
    a - b + b = a - (b - b) = a - 0 = a

thm eq_substitution_in_sum:
    ? forall a, b, c R:
        b = c
        =>:
            a - b + c = a
    a - b + c = a - b + b = a

thm cramer_third_circle_equation:
    ? forall x1, y1, x2, y2, x3, y3, s1, s2, s3, delta R:
        delta = x1 * y2 - y1 * x2
        delta != 0
        s1 * (x2 * y3 - y2 * x3) - s2 * (x1 * y3 - y1 * x3) + s3 * delta = 0
        =>:
            2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x3 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y3) = s3
    2 * delta != 0
    release thm div_mul_cancel_probe(s1 * y2 - y1 * s2, 2 * delta)
    release thm div_mul_cancel_probe(x1 * s2 - s1 * x2, 2 * delta)
    (2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x3 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y3)) * delta = (((s1 * y2 - y1 * s2) / (2 * delta)) * (2 * delta)) * x3 + (((x1 * s2 - s1 * x2) / (2 * delta)) * (2 * delta)) * y3
    (((s1 * y2 - y1 * s2) / (2 * delta)) * (2 * delta)) * x3 + (((x1 * s2 - s1 * x2) / (2 * delta)) * (2 * delta)) * y3 = (s1 * y2 - y1 * s2) * x3 + (x1 * s2 - s1 * x2) * y3
    (s1 * y2 - y1 * s2) * x3 + (x1 * s2 - s1 * x2) * y3 = -(s1 * (x2 * y3 - y2 * x3) - s2 * (x1 * y3 - y1 * x3))
    -(s1 * (x2 * y3 - y2 * x3) - s2 * (x1 * y3 - y1 * x3)) = s3 * delta
    2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x3 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y3) * delta = s3 * delta
    release thm divide_both_sides(2 * (((s1 * y2 - y1 * s2) / (2 * delta)) * x3 + ((x1 * s2 - s1 * x2) / (2 * delta)) * y3), s3, delta)

thm circle_equation_gives_equal_distance:
    ? forall ux, uy, x, y R:
        2 * (ux * x + uy * y) = x^2 + y^2
        =>:
            (ux - x)^2 + (uy - y)^2 = ux^2 + uy^2
    (ux - x)^2 + (uy - y)^2 = ux^2 + uy^2 - 2 * (ux * x + uy * y) + (x^2 + y^2) = ux^2 + uy^2

thm translated_difference_square:
    ? forall p, d, u, x R:
        x = p - d
        =>:
            (p - (d + u))^2 = (u - x)^2
    p - (d + u) = (p - d) - u = x - u
    (p - (d + u))^2 = (x - u)^2 = (u - x)^2

thm center_offset_square:
    ? forall d, u R:
        (d - (d + u))^2 = u^2
    d - (d + u) = -u
    (d - (d + u))^2 = (-u)^2 = u^2

thm common_center_implies_concyclic:
    ? forall a, b, c, d, o cart(R, R):
        distance_sq(o, a) = distance_sq(o, d)
        distance_sq(o, b) = distance_sq(o, d)
        distance_sq(o, c) = distance_sq(o, d)
        =>:
            $are_concyclic(a, b, c, d)
    witness $are_concyclic(a, b, c, d) from o:
        distance_sq(o, a) = distance_sq(o, d)
        distance_sq(o, b) = distance_sq(o, d)
        distance_sq(o, c) = distance_sq(o, d)

thm translated_circle_equation_gives_distance:
    ? forall d, p, o cart(R, R), ux, uy, x, y R:
        o = (d[1] + ux, d[2] + uy)
        x = p[1] - d[1]
        y = p[2] - d[2]
        2 * (ux * x + uy * y) = x^2 + y^2
        =>:
            distance_sq(o, p) = distance_sq(o, d)
    release thm circle_equation_gives_equal_distance(ux, uy, x, y)
    release thm translated_difference_square(p[1], d[1], ux, x)
    release thm translated_difference_square(p[2], d[2], uy, y)
    release thm center_offset_square(d[1], ux)
    release thm center_offset_square(d[2], uy)
    release thm distance_sq_coordinate_formula(o, p)
    release thm distance_sq_coordinate_formula(o, d)
    distance_sq(o, p) = (p[1] - o[1])^2 + (p[2] - o[2])^2
    (p[1] - o[1])^2 + (p[2] - o[2])^2 = (p[1] - (d[1] + ux))^2 + (p[2] - (d[2] + uy))^2
    (p[1] - (d[1] + ux))^2 + (p[2] - (d[2] + uy))^2 = (ux - x)^2 + (uy - y)^2
    (ux - x)^2 + (uy - y)^2 = ux^2 + uy^2
    ux^2 + uy^2 = (d[1] - (d[1] + ux))^2 + (d[2] - (d[2] + uy))^2
    (d[1] - (d[1] + ux))^2 + (d[2] - (d[2] + uy))^2 = (d[1] - o[1])^2 + (d[2] - o[2])^2
    (d[1] - o[1])^2 + (d[2] - o[2])^2 = distance_sq(o, d)

# Coordinate determinant criterion: D is the translation origin, and A,B
# are required to be non-collinear with D so the finite center is unique.
thm concyclic_det_criterion_implies_concyclic:
    ? forall a, b, c, d cart(R, R):
        (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]) != 0
        ((a[1] - d[1])^2 + (a[2] - d[2])^2) * ((b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])) - ((b[1] - d[1])^2 + (b[2] - d[2])^2) * ((a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])) + ((c[1] - d[1])^2 + (c[2] - d[2])^2) * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])) = 0
        =>:
            $are_concyclic(a, b, c, d)
    release thm cramer_first_circle_equation(a[1] - d[1], a[2] - d[2], b[1] - d[1], b[2] - d[2], (a[1] - d[1])^2 + (a[2] - d[2])^2, (b[1] - d[1])^2 + (b[2] - d[2])^2, (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))
    release thm cramer_second_circle_equation(a[1] - d[1], a[2] - d[2], b[1] - d[1], b[2] - d[2], (a[1] - d[1])^2 + (a[2] - d[2])^2, (b[1] - d[1])^2 + (b[2] - d[2])^2, (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))
    release thm cramer_third_circle_equation(a[1] - d[1], a[2] - d[2], b[1] - d[1], b[2] - d[2], c[1] - d[1], c[2] - d[2], (a[1] - d[1])^2 + (a[2] - d[2])^2, (b[1] - d[1])^2 + (b[2] - d[2])^2, (c[1] - d[1])^2 + (c[2] - d[2])^2, (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))
    release thm translated_circle_equation_gives_distance(d, a, (d[1] + ((((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])))), d[2] + (((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))))), (((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))), ((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))), a[1] - d[1], a[2] - d[2])
    release thm translated_circle_equation_gives_distance(d, b, (d[1] + ((((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])))), d[2] + (((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))))), (((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))), ((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))), b[1] - d[1], b[2] - d[2])
    release thm translated_circle_equation_gives_distance(d, c, (d[1] + ((((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])))), d[2] + (((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))))), (((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))), ((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))), c[1] - d[1], c[2] - d[2])
    release thm common_center_implies_concyclic(a, b, c, d, (d[1] + ((((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[2] - d[2]) - (a[2] - d[2]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2)) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])))), d[2] + (((a[1] - d[1]) * ((b[1] - d[1])^2 + (b[2] - d[2])^2) - ((a[1] - d[1])^2 + (a[2] - d[2])^2) * (b[1] - d[1])) / (2 * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))))))

thm concyclic_det_criterion:
    ? forall a, b, c, d cart(R, R):
        (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]) != 0
        ((a[1] - d[1])^2 + (a[2] - d[2])^2) * ((b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])) - ((b[1] - d[1])^2 + (b[2] - d[2])^2) * ((a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])) + ((c[1] - d[1])^2 + (c[2] - d[2])^2) * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])) = 0
        =>:
            distance_sq(a, d) * det(vec(d, b), vec(d, c)) - distance_sq(b, d) * det(vec(d, a), vec(d, c)) + distance_sq(c, d) * det(vec(d, a), vec(d, b)) = 0
    distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    distance_sq(b, d) = (d[1] - b[1])^2 + (d[2] - b[2])^2
    distance_sq(c, d) = (d[1] - c[1])^2 + (d[2] - c[2])^2
    (d[1] - a[1])^2 = (a[1] - d[1])^2
    (d[2] - a[2])^2 = (a[2] - d[2])^2
    (d[1] - b[1])^2 = (b[1] - d[1])^2
    (d[2] - b[2])^2 = (b[2] - d[2])^2
    (d[1] - c[1])^2 = (c[1] - d[1])^2
    (d[2] - c[2])^2 = (c[2] - d[2])^2
    vec(d, a) = (a[1] - d[1], a[2] - d[2])
    vec(d, b) = (b[1] - d[1], b[2] - d[2])
    vec(d, c) = (c[1] - d[1], c[2] - d[2])
    det(vec(d, a), vec(d, b)) = (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])
    det(vec(d, a), vec(d, c)) = (a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])
    det(vec(d, b), vec(d, c)) = (b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])
    distance_sq(a, d) * det(vec(d, b), vec(d, c)) - distance_sq(b, d) * det(vec(d, a), vec(d, c)) + distance_sq(c, d) * det(vec(d, a), vec(d, b)) = ((a[1] - d[1])^2 + (a[2] - d[2])^2) * ((b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])) - ((b[1] - d[1])^2 + (b[2] - d[2])^2) * ((a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])) + ((c[1] - d[1])^2 + (c[2] - d[2])^2) * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))
    distance_sq(a, d) * det(vec(d, b), vec(d, c)) - distance_sq(b, d) * det(vec(d, a), vec(d, c)) + distance_sq(c, d) * det(vec(d, a), vec(d, b)) = 0

# Dot product is additive in its second argument.
thm dot_bilinear_right:
    ? forall u, v, w cart(R, R):
        dot(u, (v[1] + w[1], v[2] + w[2])) = dot(u, v) + dot(u, w)
    release thm dot_coordinate_formula(u, (v[1] + w[1], v[2] + w[2]))
    release thm dot_coordinate_formula(u, v)
    release thm dot_coordinate_formula(u, w)
    u[1] * (v[1] + w[1]) + u[2] * (v[2] + w[2]) = (u[1] * v[1] + u[2] * v[2]) + (u[1] * w[1] + u[2] * w[2])
    dot(u, (v[1] + w[1], v[2] + w[2])) = u[1] * (v[1] + w[1]) + u[2] * (v[2] + w[2]) = (u[1] * v[1] + u[2] * v[2]) + (u[1] * w[1] + u[2] * w[2]) = dot(u, v) + dot(u, w)

# Dot product is homogeneous in its second argument.
thm dot_scale_right:
    ? forall u, v cart(R, R), k R:
        dot(u, (k * v[1], k * v[2])) = k * dot(u, v)
    release thm dot_coordinate_formula(u, (k * v[1], k * v[2]))
    release thm dot_coordinate_formula(u, v)
    u[1] * (k * v[1]) + u[2] * (k * v[2]) = k * (u[1] * v[1] + u[2] * v[2])
    dot(u, (k * v[1], k * v[2])) = u[1] * (k * v[1]) + u[2] * (k * v[2]) = k * (u[1] * v[1] + u[2] * v[2]) = k * dot(u, v)

# Scaling second vector scales determinant
thm det_scale_right:
    ? forall u, v cart(R, R), k R:
        det(u, (k * v[1], k * v[2])) = k * det(u, v)
    release thm det_coordinate_formula(u, (k * v[1], k * v[2]))
    release thm det_coordinate_formula(u, v)
    det(u, (k * v[1], k * v[2])) = u[1] * (k * v[2]) - u[2] * (k * v[1])
    det(u, v) = u[1] * v[2] - u[2] * v[1]
    u[1] * (k * v[2]) = k * (u[1] * v[2])
    u[2] * (k * v[1]) = k * (u[2] * v[1])
    u[1] * (k * v[2]) - u[2] * (k * v[1]) = k * (u[1] * v[2]) - k * (u[2] * v[1])
    k * (u[1] * v[2]) - k * (u[2] * v[1]) = k * (u[1] * v[2] - u[2] * v[1])
    u[1] * (k * v[2]) - u[2] * (k * v[1]) = k * (u[1] * v[2] - u[2] * v[1])
    release thm multiply_both_sides(det(u, v), u[1] * v[2] - u[2] * v[1], k)
    det(u, v) * k = (u[1] * v[2] - u[2] * v[1]) * k
    k * det(u, v) = det(u, v) * k
    (u[1] * v[2] - u[2] * v[1]) * k = k * (u[1] * v[2] - u[2] * v[1])
    k * det(u, v) = k * (u[1] * v[2] - u[2] * v[1])
    k * (u[1] * v[2] - u[2] * v[1]) = k * det(u, v)
    det(u, (k * v[1], k * v[2])) = k * det(u, v)

thm perpendicular_from_parallel:
    ? forall a, b, c, d cart(R, R):
        det(vec(a, b), vec(c, d)) = 0
        dot(vec(a, b), vec(a, b)) != 0
        =>:
            dot(vec(a, b), (vec(c, d)[2], -(vec(c, d)[1]))) = 0
    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    vec(c, d) = (d[1] - c[1], d[2] - c[2])
    dot(vec(a, b), (vec(c, d)[2], -(vec(c, d)[1]))) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    det(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    dot(vec(a, b), (vec(c, d)[2], -(vec(c, d)[1]))) = 0

thm median_length:
    ? forall a, b, c, m cart(R, R):
        m[1] = (b[1] + c[1]) / 2
        m[2] = (b[2] + c[2]) / 2
        =>:
            4 * distance_sq(a, m) = 2 * distance_sq(a, b) + 2 * distance_sq(a, c) - distance_sq(b, c)
    distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = ((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2
    4 * (((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    4 * distance_sq(a, m) = 2 * distance_sq(a, b) + 2 * distance_sq(a, c) - distance_sq(b, c)

thm reflection_distance:
    ? forall p, a, b cart(R, R):
        b[1] = 2 * a[1] - p[1]
        b[2] = 2 * a[2] - p[2]
        =>:
            distance_sq(a, p) = distance_sq(a, b)
    distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (b[1] - a[1])^2 + (b[2] - a[2])^2 = ((2 * a[1] - p[1]) - a[1])^2 + ((2 * a[2] - p[2]) - a[2])^2
    ((2 * a[1] - p[1]) - a[1])^2 + ((2 * a[2] - p[2]) - a[2])^2 = (p[1] - a[1])^2 + (p[2] - a[2])^2
    distance_sq(a, p) = distance_sq(a, b)

thm foot_perp_parametric:
    ? forall a, b, p, f cart(R, R), t R:
        f[1] = a[1] + t * (b[1] - a[1])
        f[2] = a[2] + t * (b[2] - a[2])
        (p[1] - a[1]) * (b[1] - a[1]) + (p[2] - a[2]) * (b[2] - a[2]) = t * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
        =>:
            dot(vec(p, f), vec(a, b)) = 0
    vec(p, f) = (f[1] - p[1], f[2] - p[2])
    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    dot(vec(p, f), vec(a, b)) = (f[1] - p[1]) * (b[1] - a[1]) + (f[2] - p[2]) * (b[2] - a[2])
    (f[1] - p[1]) * (b[1] - a[1]) + (f[2] - p[2]) * (b[2] - a[2]) = (a[1] + t * (b[1] - a[1]) - p[1]) * (b[1] - a[1]) + (a[2] + t * (b[2] - a[2]) - p[2]) * (b[2] - a[2])
    (a[1] + t * (b[1] - a[1]) - p[1]) * (b[1] - a[1]) + (a[2] + t * (b[2] - a[2]) - p[2]) * (b[2] - a[2]) = t * ((b[1] - a[1])^2 + (b[2] - a[2])^2) - ((p[1] - a[1]) * (b[1] - a[1]) + (p[2] - a[2]) * (b[2] - a[2]))
    t * ((b[1] - a[1])^2 + (b[2] - a[2])^2) - ((p[1] - a[1]) * (b[1] - a[1]) + (p[2] - a[2]) * (b[2] - a[2])) = 0
    dot(vec(p, f), vec(a, b)) = 0

# The distance from a to an affine point p=(1-t)a+t b scales by t^2.
thm affine_combination_distance_sq:
    ? forall a, b, p cart(R, R), t R:
        $is_affine_combination(p, a, b, t)
        =>:
            distance_sq(a, p) = t^2 * distance_sq(a, b)
    release thm distance_sq_coordinate_formula(a, p)
    release thm distance_sq_coordinate_formula(a, b)
    distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2
    (p[1] - a[1])^2 + (p[2] - a[2])^2 = ((1 - t) * a[1] + t * b[1] - a[1])^2 + ((1 - t) * a[2] + t * b[2] - a[2])^2
    ((1 - t) * a[1] + t * b[1] - a[1])^2 + ((1 - t) * a[2] + t * b[2] - a[2])^2 = t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    t^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = t^2 * distance_sq(a, b)
    distance_sq(a, p) = t^2 * distance_sq(a, b)

thm midpoint_segment_ratio:
    ? forall a, b, m, p cart(R, R), t R:
        $is_midpoint(m, a, b)
        $is_affine_combination(p, a, b, t)
        =>:
            distance_sq(a, p) = (2 * t)^2 * distance_sq(a, m)
    release thm affine_combination_distance_sq(a, b, p, t)
    release thm midpoint_half_distance(a, b, m)
    distance_sq(a, p) = t^2 * distance_sq(a, b)
    distance_sq(a, m) = distance_sq(a, b) / 4
    t^2 * distance_sq(a, b) = (2 * t)^2 * (distance_sq(a, b) / 4)
    (2 * t)^2 * (distance_sq(a, b) / 4) = (2 * t)^2 * distance_sq(a, m)
    distance_sq(a, p) = (2 * t)^2 * distance_sq(a, m)

thm inner_product_distance_identity:
    ? forall a, b, c, d cart(R, R):
        2 * dot(vec(a, b), vec(c, d)) = distance_sq(a, d) + distance_sq(b, c) - distance_sq(a, c) - distance_sq(b, d)
    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    vec(c, d) = (d[1] - c[1], d[2] - c[2])
    dot(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    distance_sq(b, d) = (d[1] - b[1])^2 + (d[2] - b[2])^2
    2 * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = (d[1] - a[1])^2 + (d[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) - ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((d[1] - b[1])^2 + (d[2] - b[2])^2)
    2 * dot(vec(a, b), vec(c, d)) = 2 * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    distance_sq(a, d) + distance_sq(b, c) - distance_sq(a, c) - distance_sq(b, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) - ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((d[1] - b[1])^2 + (d[2] - b[2])^2)
    2 * dot(vec(a, b), vec(c, d)) = distance_sq(a, d) + distance_sq(b, c) - distance_sq(a, c) - distance_sq(b, d)

# Squared distances scale by k^2 under coordinate-wise similarity
thm similar_triangles_ratio:
    ? forall p, q, r, u, v, w cart(R, R), k R:
        u[1] - v[1] = k * (p[1] - q[1])
        u[2] - v[2] = k * (p[2] - q[2])
        w[1] - v[1] = k * (r[1] - q[1])
        w[2] - v[2] = k * (r[2] - q[2])
        =>:
            distance_sq(u, w) = k^2 * distance_sq(p, r)
    release thm distance_sq_coordinate_formula(u, w)
    release thm distance_sq_coordinate_formula(p, r)
    w[1] - u[1] = (w[1] - v[1]) - (u[1] - v[1])
    (w[1] - v[1]) - (u[1] - v[1]) = k * (r[1] - q[1]) - k * (p[1] - q[1])
    k * (r[1] - q[1]) - k * (p[1] - q[1]) = k * (r[1] - p[1])
    w[1] - u[1] = k * (r[1] - p[1])
    w[2] - u[2] = (w[2] - v[2]) - (u[2] - v[2])
    (w[2] - v[2]) - (u[2] - v[2]) = k * (r[2] - q[2]) - k * (p[2] - q[2])
    k * (r[2] - q[2]) - k * (p[2] - q[2]) = k * (r[2] - p[2])
    w[2] - u[2] = k * (r[2] - p[2])
    (w[1] - u[1])^2 = (k * (r[1] - p[1]))^2 = k^2 * (r[1] - p[1])^2
    (w[2] - u[2])^2 = (k * (r[2] - p[2]))^2 = k^2 * (r[2] - p[2])^2
    (w[1] - u[1])^2 + (w[2] - u[2])^2 = k^2 * (r[1] - p[1])^2 + k^2 * (r[2] - p[2])^2
    k^2 * (r[1] - p[1])^2 + k^2 * (r[2] - p[2])^2 = k^2 * ((r[1] - p[1])^2 + (r[2] - p[2])^2)
    distance_sq(u, w) = (w[1] - u[1])^2 + (w[2] - u[2])^2 = k^2 * ((r[1] - p[1])^2 + (r[2] - p[2])^2) = k^2 * distance_sq(p, r)

# TODO: similar_triangles_dot 验证失败（代数推导问题），临时改为 axiom
# Dot products scale by k^2 under coordinate-wise similarity
thm similar_triangles_dot:
    ? forall p, q, r, u, v, w cart(R, R), k R:
        u[1] - v[1] = k * (p[1] - q[1])
        u[2] - v[2] = k * (p[2] - q[2])
        w[1] - v[1] = k * (r[1] - q[1])
        w[2] - v[2] = k * (r[2] - q[2])
        =>:
            dot(vec(v, u), vec(v, w)) = k^2 * dot(vec(q, p), vec(q, r))
    release thm vec_coordinate_formula(v, u)
    release thm vec_coordinate_formula(v, w)
    release thm vec_coordinate_formula(q, p)
    release thm vec_coordinate_formula(q, r)
    release thm dot_coordinate_formula(vec(v, u), vec(v, w))
    release thm dot_coordinate_formula(vec(q, p), vec(q, r))
    (u[1] - v[1]) * (w[1] - v[1]) = (k * (p[1] - q[1])) * (k * (r[1] - q[1]))
    (k * (p[1] - q[1])) * (k * (r[1] - q[1])) = k^2 * ((p[1] - q[1]) * (r[1] - q[1]))
    (u[1] - v[1]) * (w[1] - v[1]) = k^2 * ((p[1] - q[1]) * (r[1] - q[1]))
    (u[2] - v[2]) * (w[2] - v[2]) = (k * (p[2] - q[2])) * (k * (r[2] - q[2]))
    (k * (p[2] - q[2])) * (k * (r[2] - q[2])) = k^2 * ((p[2] - q[2]) * (r[2] - q[2]))
    (u[2] - v[2]) * (w[2] - v[2]) = k^2 * ((p[2] - q[2]) * (r[2] - q[2]))
    (u[1] - v[1]) * (w[1] - v[1]) + (u[2] - v[2]) * (w[2] - v[2]) = k^2 * ((p[1] - q[1]) * (r[1] - q[1])) + k^2 * ((p[2] - q[2]) * (r[2] - q[2]))
    k^2 * ((p[1] - q[1]) * (r[1] - q[1])) + k^2 * ((p[2] - q[2]) * (r[2] - q[2])) = k^2 * ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]))
    dot(vec(v, u), vec(v, w)) = (u[1] - v[1]) * (w[1] - v[1]) + (u[2] - v[2]) * (w[2] - v[2])
    (u[1] - v[1]) * (w[1] - v[1]) + (u[2] - v[2]) * (w[2] - v[2]) = k^2 * ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]))
    dot(vec(q, p), vec(q, r)) = (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])
    k^2 * ((p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2])) = k^2 * dot(vec(q, p), vec(q, r))
    dot(vec(v, u), vec(v, w)) = k^2 * dot(vec(q, p), vec(q, r))

# Determinants scale by k^2 under coordinate-wise similarity
thm similar_triangles_det:
    ? forall p, q, r, u, v, w cart(R, R), k R:
        u[1] - v[1] = k * (p[1] - q[1])
        u[2] - v[2] = k * (p[2] - q[2])
        w[1] - v[1] = k * (r[1] - q[1])
        w[2] - v[2] = k * (r[2] - q[2])
        =>:
            det(vec(v, u), vec(v, w)) = k^2 * det(vec(q, p), vec(q, r))
    release thm vec_coordinate_formula(v, u)
    release thm vec_coordinate_formula(v, w)
    release thm vec_coordinate_formula(q, p)
    release thm vec_coordinate_formula(q, r)
    release thm det_coordinate_formula(vec(v, u), vec(v, w))
    release thm det_coordinate_formula(vec(q, p), vec(q, r))
    (u[1] - v[1]) * (w[2] - v[2]) = (k * (p[1] - q[1])) * (k * (r[2] - q[2]))
    (k * (p[1] - q[1])) * (k * (r[2] - q[2])) = k^2 * ((p[1] - q[1]) * (r[2] - q[2]))
    (u[1] - v[1]) * (w[2] - v[2]) = k^2 * ((p[1] - q[1]) * (r[2] - q[2]))
    (u[2] - v[2]) * (w[1] - v[1]) = (k * (p[2] - q[2])) * (k * (r[1] - q[1]))
    (k * (p[2] - q[2])) * (k * (r[1] - q[1])) = k^2 * ((p[2] - q[2]) * (r[1] - q[1]))
    (u[2] - v[2]) * (w[1] - v[1]) = k^2 * ((p[2] - q[2]) * (r[1] - q[1]))
    (u[1] - v[1]) * (w[2] - v[2]) - (u[2] - v[2]) * (w[1] - v[1]) = k^2 * ((p[1] - q[1]) * (r[2] - q[2])) - k^2 * ((p[2] - q[2]) * (r[1] - q[1]))
    k^2 * ((p[1] - q[1]) * (r[2] - q[2])) - k^2 * ((p[2] - q[2]) * (r[1] - q[1])) = k^2 * ((p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1]))
    det(vec(v, u), vec(v, w)) = (u[1] - v[1]) * (w[2] - v[2]) - (u[2] - v[2]) * (w[1] - v[1])
    det(vec(q, p), vec(q, r)) = (p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1])
    k^2 * ((p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1])) = k^2 * det(vec(q, p), vec(q, r))
    det(vec(v, u), vec(v, w)) = k^2 * det(vec(q, p), vec(q, r))


thm angle_equality_cross_ratio:
    ? forall p, q, r, u, v, w cart(R, R):
        dot(vec(q, p), vec(q, r)) * det(vec(v, u), vec(v, w)) = det(vec(q, p), vec(q, r)) * dot(vec(v, u), vec(v, w))
        =>:
            dot(vec(q, p), vec(q, r)) * det(vec(v, u), vec(v, w)) - det(vec(q, p), vec(q, r)) * dot(vec(v, u), vec(v, w)) = 0
    dot(vec(q, p), vec(q, r)) * det(vec(v, u), vec(v, w)) - det(vec(q, p), vec(q, r)) * dot(vec(v, u), vec(v, w)) = 0

thm dot_squared_plus_det_squared:
    ? forall u, v cart(R, R):
        dot(u, v)^2 + det(u, v)^2 = dot(u, u) * dot(v, v)
    dot(u, v) = u[1] * v[1] + u[2] * v[2]
    det(u, v) = u[1] * v[2] - u[2] * v[1]
    dot(u, u) = u[1] * u[1] + u[2] * u[2]
    dot(v, v) = v[1] * v[1] + v[2] * v[2]
    (u[1] * v[1] + u[2] * v[2])^2 + (u[1] * v[2] - u[2] * v[1])^2 = (u[1] * u[1] + u[2] * u[2]) * (v[1] * v[1] + v[2] * v[2])
    dot(u, v)^2 + det(u, v)^2 = (u[1] * v[1] + u[2] * v[2])^2 + (u[1] * v[2] - u[2] * v[1])^2
    dot(u, u) * dot(v, v) = (u[1] * u[1] + u[2] * u[2]) * (v[1] * v[1] + v[2] * v[2])
    dot(u, v)^2 + det(u, v)^2 = dot(u, u) * dot(v, v)

thm rotation_preserves_distance:
    ? forall a, b, a2, b2 cart(R, R), c, s R:
        c^2 + s^2 = 1
        a2[1] = c * a[1] - s * a[2]
        a2[2] = s * a[1] + c * a[2]
        b2[1] = c * b[1] - s * b[2]
        b2[2] = s * b[1] + c * b[2]
        =>:
            distance_sq(a2, b2) = distance_sq(a, b)
    distance_sq(a2, b2) = (b2[1] - a2[1])^2 + (b2[2] - a2[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (b2[1] - a2[1])^2 + (b2[2] - a2[2])^2 = ((c * b[1] - s * b[2]) - (c * a[1] - s * a[2]))^2 + ((s * b[1] + c * b[2]) - (s * a[1] + c * a[2]))^2
    ((c * b[1] - s * b[2]) - (c * a[1] - s * a[2]))^2 + ((s * b[1] + c * b[2]) - (s * a[1] + c * a[2]))^2 = (c^2 + s^2) * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    (c^2 + s^2) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    distance_sq(a2, b2) = distance_sq(a, b)

