#     m[2] = (a[2] + b[2]) / 2

# Reversing the first vector negates the dot product
thm dot_neg_left:
    ? forall a, b, c, d cart(R, R):
        dot(vec(b, a), vec(c, d)) = -(dot(vec(a, b), vec(c, d)))
    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    vec(b, a) = (a[1] - b[1], a[2] - b[2])
    vec(c, d) = (d[1] - c[1], d[2] - c[2])
    dot(vec(b, a), vec(c, d)) = (a[1] - b[1]) * (d[1] - c[1]) + (a[2] - b[2]) * (d[2] - c[2])
    dot(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    (a[1] - b[1]) * (d[1] - c[1]) + (a[2] - b[2]) * (d[2] - c[2]) = -((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    dot(vec(b, a), vec(c, d)) = -((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    -((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = -(dot(vec(a, b), vec(c, d)))
    dot(vec(b, a), vec(c, d)) = -(dot(vec(a, b), vec(c, d)))

# Reversing the first vector negates the determinant
thm det_neg_left:
    ? forall a, b, c, d cart(R, R):
        det(vec(b, a), vec(c, d)) = -(det(vec(a, b), vec(c, d)))
    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    vec(b, a) = (a[1] - b[1], a[2] - b[2])
    vec(c, d) = (d[1] - c[1], d[2] - c[2])
    det(vec(b, a), vec(c, d)) = (a[1] - b[1]) * (d[2] - c[2]) - (a[2] - b[2]) * (d[1] - c[1])
    det(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    (a[1] - b[1]) * (d[2] - c[2]) - (a[2] - b[2]) * (d[1] - c[1]) = -((b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]))
    det(vec(b, a), vec(c, d)) = -((b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]))
    -((b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])) = -(det(vec(a, b), vec(c, d)))
    det(vec(b, a), vec(c, d)) = -(det(vec(a, b), vec(c, d)))

thm apollonius_theorem:
    ? forall a, b, c, m cart(R, R):
        m[1] = (b[1] + c[1]) / 2
        m[2] = (b[2] + c[2]) / 2
        =>:
            4 * distance_sq(a, m) = 2 * distance_sq(a, b) + 2 * distance_sq(a, c) - distance_sq(b, c)
    distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = ((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2
    4 * (((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    4 * distance_sq(a, m) = 4 * (((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2)
    2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((c[1] - b[1])^2 + (c[2] - b[2])^2) = 2 * distance_sq(a, b) + 2 * distance_sq(a, c) - distance_sq(b, c)
    4 * distance_sq(a, m) = 2 * distance_sq(a, b) + 2 * distance_sq(a, c) - distance_sq(b, c)

thm distance_sq_translate:
    ? forall a, b, t, a2, b2 cart(R, R):
        a2[1] = a[1] + t[1]
        a2[2] = a[2] + t[2]
        b2[1] = b[1] + t[1]
        b2[2] = b[2] + t[2]
        =>:
            distance_sq(a2, b2) = distance_sq(a, b)
    distance_sq(a2, b2) = (b2[1] - a2[1])^2 + (b2[2] - a2[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (b2[1] - a2[1])^2 + (b2[2] - a2[2])^2 = ((b[1] + t[1]) - (a[1] + t[1]))^2 + ((b[2] + t[2]) - (a[2] + t[2]))^2
    ((b[1] + t[1]) - (a[1] + t[1]))^2 + ((b[2] + t[2]) - (a[2] + t[2]))^2 = (b[1] - a[1])^2 + (b[2] - a[2])^2
    distance_sq(a2, b2) = distance_sq(a, b)

# Parallelogram law in coordinates
thm parallelogram_diagonals:
    ? forall a, b, c, d cart(R, R):
        d[1] = a[1] + c[1] - b[1]
        d[2] = a[2] + c[2] - b[2]
        =>:
            distance_sq(a, c) + distance_sq(b, d) = 2 * distance_sq(a, b) + 2 * distance_sq(b, c)
    distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    distance_sq(b, d) = (d[1] - b[1])^2 + (d[2] - b[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    distance_sq(b, d) = (d[1] - b[1])^2 + (d[2] - b[2])^2 = ((a[1] + c[1] - b[1]) - b[1])^2 + ((a[2] + c[2] - b[2]) - b[2])^2
    distance_sq(a, c) + distance_sq(b, d) = distance_sq(a, c) + (((a[1] + c[1] - b[1]) - b[1])^2 + ((a[2] + c[2] - b[2]) - b[2])^2)
    distance_sq(a, c) + (((a[1] + c[1] - b[1]) - b[1])^2 + ((a[2] + c[2] - b[2]) - b[2])^2) = ((c[1] - a[1])^2 + (c[2] - a[2])^2) + (((a[1] + c[1] - b[1]) - b[1])^2 + ((a[2] + c[2] - b[2]) - b[2])^2)
    ((c[1] - a[1])^2 + (c[2] - a[2])^2) + (((a[1] + c[1] - b[1]) - b[1])^2 + ((a[2] + c[2] - b[2]) - b[2])^2) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    2 * distance_sq(a, b) + 2 * distance_sq(b, c) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * distance_sq(b, c)
    2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * distance_sq(b, c) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    distance_sq(a, c) + distance_sq(b, d) = 2 * distance_sq(a, b) + 2 * distance_sq(b, c)

