# Problem 551 local geometry-to-scalar bridge.
# This helper is not the NL translation boundary; it only converts atomic
# geometric certificates and affine parameters into the verified scalar core.

# Explicit equality transport helpers used by the affine coordinate bridge.
thm problem_551_add_equalities:
    ? forall aa, bb, cc, dd R:
        aa = bb
        cc = dd
        =>:
            aa + cc = bb + dd
    aa + cc = bb + cc = bb + dd

thm problem_551_subtract_equalities:
    ? forall aa, bb, cc, dd R:
        aa = bb
        cc = dd
        =>:
            aa - cc = bb - dd
    aa - cc = bb - cc = bb - dd

thm problem_551_scale_left:
    ? forall xx, yy, kk R:
        xx = yy
        =>:
            kk * xx = kk * yy
    kk * xx = kk * yy

thm problem_551_multiply_equalities:
    ? forall aa, bb, cc, dd R:
        aa = bb
        cc = dd
        =>:
            aa * cc = bb * dd
    aa * cc = bb * cc = bb * dd

# Explicitly transport coordinate aliases through a squared distance sum.
thm problem_551_distance_from_aliases:
    ? forall dd, xx, yy, aa, bb R:
        dd = xx^2 + yy^2
        xx = aa
        yy = bb
        =>:
            dd = aa^2 + bb^2

    release thm problem_551_multiply_equalities(xx, aa, xx, aa)
    xx * xx = aa * aa
    xx^2 = aa^2
    release thm problem_551_multiply_equalities(yy, bb, yy, bb)
    yy * yy = bb * bb
    yy^2 = bb^2
    release thm problem_551_add_equalities(xx^2, aa^2, yy^2, bb^2)
    xx^2 + yy^2 = aa^2 + bb^2
    dd = xx^2 + yy^2 = aa^2 + bb^2

# Explicit affine difference helper for endpoint coordinates.
thm problem_551_affine_endpoint_difference:
    ? forall aa, cc, dd, ee, pp, qq, tt R:
        pp = cc - aa
        qq = dd - aa
        ee = cc + tt * (dd - cc)
        =>:
            ee - dd = (tt - 1) * (qq - pp)

    dd - cc = (dd - aa) - (cc - aa)
    release thm problem_551_subtract_equalities(dd - aa, qq, cc - aa, pp)
    (dd - aa) - (cc - aa) = qq - pp
    dd - cc = qq - pp
    ee - dd = (tt - 1) * (dd - cc)
    release thm problem_551_scale_left(dd - cc, qq - pp, tt - 1)
    (tt - 1) * (dd - cc) = (tt - 1) * (qq - pp)
    ee - dd = (tt - 1) * (qq - pp)

# Explicit affine substitution helper. Litex does not rewrite aliases inside
# compound expressions, so the coordinate expansion is proved through this theorem.
thm problem_551_affine_ray_endpoint_coordinate:
    ? forall aa, bb, dd, ff, oo, uu, qq, vv R:
        uu = aa - oo
        bb - oo = -uu
        qq = dd - aa
        ff = aa + vv * (dd - aa)
        =>:
            ff - bb = 2 * uu + vv * qq

    aa - bb = (aa - oo) - (bb - oo)
    release thm problem_551_subtract_equalities(aa - oo, uu, bb - oo, -uu)
    (aa - oo) - (bb - oo) = uu - (-uu)
    uu - (-uu) = 2 * uu
    aa - bb = 2 * uu
    ff - bb = (aa - bb) + vv * (dd - aa)
    release thm problem_551_scale_left(dd - aa, qq, vv)
    vv * (dd - aa) = vv * qq
    release thm problem_551_add_equalities(aa - bb, 2 * uu, vv * (dd - aa), vv * qq)
    (aa - bb) + vv * (dd - aa) = 2 * uu + vv * qq
    ff - bb = 2 * uu + vv * qq

thm problem_551_affine_endpoint_coordinate:
    ? forall aa, bb, cc, dd, ee, oo, uu, pp, qq, tt R:
        uu = aa - oo
        bb - oo = -uu
        pp = cc - aa
        qq = dd - aa
        ee = cc + tt * (dd - cc)
        =>:
            ee - bb = 2 * uu + tt * qq + (1 - tt) * pp

    aa - bb = (aa - oo) - (bb - oo)
    release thm problem_551_subtract_equalities(aa - oo, uu, bb - oo, -uu)
    (aa - oo) - (bb - oo) = uu - (-uu)
    uu - (-uu) = 2 * uu
    aa - bb = 2 * uu
    cc - bb = (cc - aa) + (aa - bb)
    release thm problem_551_add_equalities(cc - aa, pp, aa - bb, 2 * uu)
    (cc - aa) + (aa - bb) = pp + 2 * uu
    cc - bb = pp + 2 * uu
    dd - cc = (dd - aa) - (cc - aa)
    release thm problem_551_subtract_equalities(dd - aa, qq, cc - aa, pp)
    (dd - aa) - (cc - aa) = qq - pp
    dd - cc = qq - pp
    ee - bb = (cc - bb) + tt * (dd - cc)
    release thm problem_551_scale_left(dd - cc, qq - pp, tt)
    tt * (dd - cc) = tt * (qq - pp)
    release thm problem_551_add_equalities(cc - bb, pp + 2 * uu, tt * (dd - cc), tt * (qq - pp))
    (cc - bb) + tt * (dd - cc) = (pp + 2 * uu) + tt * (qq - pp)
    ee - bb = (pp + 2 * uu) + tt * (qq - pp)
    (pp + 2 * uu) + tt * (qq - pp) = 2 * uu + tt * qq + (1 - tt) * pp
    ee - bb = 2 * uu + tt * qq + (1 - tt) * pp

# Explicitly subtract two endpoint coordinates expressed from the same base point.
thm problem_551_affine_endpoint_gap:
    ? forall bb, ee, ff, uu, pp, qq, tt, vv R:
        ee - bb = 2 * uu + tt * qq + (1 - tt) * pp
        ff - bb = 2 * uu + vv * qq
        =>:
            ff - ee = (vv - tt) * qq + (tt - 1) * pp

    ff - ee = (ff - bb) - (ee - bb)
    release thm problem_551_subtract_equalities(ff - bb, 2 * uu + vv * qq, ee - bb, 2 * uu + tt * qq + (1 - tt) * pp)
    (ff - bb) - (ee - bb) = (2 * uu + vv * qq) - (2 * uu + tt * qq + (1 - tt) * pp)
    (2 * uu + vv * qq) - (2 * uu + tt * qq + (1 - tt) * pp) = (vv - tt) * qq + (tt - 1) * pp
    ff - ee = (vv - tt) * qq + (tt - 1) * pp

# Eliminate zero summands from an explicitly expanded affine dot product.
thm problem_551_component_elimination:
    ? forall aa, bb, cc R:
        aa + bb + cc = 0
        bb = 0
        cc = 0
        =>:
            aa = 0

    aa + bb + cc = aa + 0 + 0
    aa + 0 + 0 = aa
    aa = 0

# Eliminate a known-zero right summand.
thm problem_551_sum_zero_left:
    ? forall aa, bb R:
        aa + bb = 0
        bb = 0
        =>:
            aa = 0

    aa + bb = aa + 0 = aa
    aa = 0

# Transport zero across an equality whose left side is known to vanish.
thm problem_551_zero_from_equal:
    ? forall aa, bb R:
        aa = bb
        aa = 0
        =>:
            bb = 0

    bb = aa = 0

# Explicit coordinate-alias transport into a two-dimensional dot product.
thm problem_551_dot_from_coordinate_aliases:
    ? forall ux, uy, ex, ey, rx, ry R:
        ex = rx
        ey = ry
        =>:
            ux * ex + uy * ey = ux * rx + uy * ry

    release thm problem_551_scale_left(ex, rx, ux)
    ux * ex = ux * rx
    release thm problem_551_scale_left(ey, ry, uy)
    uy * ey = uy * ry
    release thm problem_551_add_equalities(ux * ex, ux * rx, uy * ey, uy * ry)
    ux * ex + uy * ey = ux * rx + uy * ry

# Expand the dot product of OA with an affine point on CD.
thm problem_551_affine_dot_expansion:
    ? forall ux, uy, px, py, qx, qy, ex, ey, t R:
        ex = 2 * ux + t * qx + (1 - t) * px
        ey = 2 * uy + t * qy + (1 - t) * py
        =>:
            ux * ex + uy * ey = 2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) + (1 - t) * (ux * px + uy * py)

    release thm problem_551_dot_from_coordinate_aliases(ux, uy, ex, ey, 2 * ux + t * qx + (1 - t) * px, 2 * uy + t * qy + (1 - t) * py)
    ux * ex + uy * ey = ux * (2 * ux + t * qx + (1 - t) * px) + uy * (2 * uy + t * qy + (1 - t) * py)
    ux * (2 * ux + t * qx + (1 - t) * px) + uy * (2 * uy + t * qy + (1 - t) * py) = 2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) + (1 - t) * (ux * px + uy * py)
    ux * ex + uy * ey = 2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) + (1 - t) * (ux * px + uy * py)

# Expand the dot product of OA with a point on ray AD.
thm problem_551_ray_dot_expansion:
    ? forall ux, uy, qx, qy, fx, fy, v R:
        fx = 2 * ux + v * qx
        fy = 2 * uy + v * qy
        =>:
            ux * fx + uy * fy = 2 * (ux^2 + uy^2) + v * (ux * qx + uy * qy)

    release thm problem_551_dot_from_coordinate_aliases(ux, uy, fx, fy, 2 * ux + v * qx, 2 * uy + v * qy)
    ux * fx + uy * fy = ux * (2 * ux + v * qx) + uy * (2 * uy + v * qy)
    ux * (2 * ux + v * qx) + uy * (2 * uy + v * qy) = 2 * (ux^2 + uy^2) + v * (ux * qx + uy * qy)
    ux * fx + uy * fy = 2 * (ux^2 + uy^2) + v * (ux * qx + uy * qy)

# Small algebra helper: convert a zero dot product against OB = -OA
# into the corresponding zero dot product against OA.
thm problem_551_negated_dot_from_aliases:
    ? forall ux, uy, bdx, bdy, x, y R:
        bdx = -ux
        bdy = -uy
        bdx * x + bdy * y = 0
        =>:
            ux * x + uy * y = 0

    bdx * x + bdy * y = (-ux) * x + (-uy) * y
    (-ux) * x + (-uy) * y = -(ux * x + uy * y)
    -(ux * x + uy * y) = 0
    ux * x + uy * y = 0

thm problem_551_geometry_bridge:
    ? forall a, b, c, d, ep, f, m, n, o cart(R, R), r R+, s, t, k, v, w R:
        $geo::is_midpoint(o, a, b)
        $geo::is_perpendicular(o, a, a, m)
        $geo::is_perpendicular(o, b, b, n)
        $geo::is_on_circle(a, o, r)
        $geo::is_on_circle(d, o, r)
        $geo::are_segments_congruent(c, d, c, a)
        c[1] = (1 - s) * a[1] + s * m[1]
        c[2] = (1 - s) * a[2] + s * m[2]
        ep = (c[1] + t * (d[1] - c[1]), c[2] + t * (d[2] - c[2]))
        ep[1] = (1 - k) * b[1] + k * n[1]
        ep[2] = (1 - k) * b[2] + k * n[2]
        f = (a[1] + v * (d[1] - a[1]), a[2] + v * (d[2] - a[2]))
        f[1] = (1 - w) * b[1] + w * n[1]
        f[2] = (1 - w) * b[2] + w * n[2]
        =>:
            geo::dot(geo::vec(o, d), geo::vec(d, ep)) = 0
            geo::distance_sq(b, ep) = geo::distance_sq(ep, f)

    by def $geo::is_midpoint(o, a, b)
    by def $geo::is_perpendicular(o, a, a, m)
    by def $geo::is_perpendicular(o, b, b, n)
    by def $geo::is_on_circle(a, o, r)
    by def $geo::is_on_circle(d, o, r)
    by def $geo::are_segments_congruent(c, d, c, a)

    have ux R = a[1] - o[1]
    have uy R = a[2] - o[2]
    have px R = c[1] - a[1]
    have py R = c[2] - a[2]
    have qx R = d[1] - a[1]
    have qy R = d[2] - a[2]

    # Diameter midpoint: OB = -OA.
    o[1] = (a[1] + b[1]) / 2
    o[2] = (a[2] + b[2]) / 2
    b[1] - o[1] = -(a[1] - o[1]) = -ux
    b[2] - o[2] = -(a[2] - o[2]) = -uy

    # The radius OA is nonzero.
    o != a
    release thm geo::distance_sq_positive_of_ne(o, a)
    geo::distance_sq(o, a) > 0
    release thm geo::distance_sq_coordinate_formula(o, a)
    geo::distance_sq(o, a) = (a[1] - o[1])^2 + (a[2] - o[2])^2
    (a[1] - o[1])^2 + (a[2] - o[2])^2 = ux^2 + uy^2
    ux^2 + uy^2 > 0

    # C lies on tangent AM, hence OA is orthogonal to AC.
    release thm geo::dot_coordinate_formula(geo::vec(o, a), geo::vec(a, m))
    geo::dot(geo::vec(o, a), geo::vec(a, m)) = (a[1] - o[1]) * (m[1] - a[1]) + (a[2] - o[2]) * (m[2] - a[2])
    (a[1] - o[1]) * (m[1] - a[1]) + (a[2] - o[2]) * (m[2] - a[2]) = 0
    c[1] - a[1] = s * (m[1] - a[1])
    c[2] - a[2] = s * (m[2] - a[2])
    px = s * (m[1] - a[1])
    py = s * (m[2] - a[2])
    ux * px + uy * py = ux * (s * (m[1] - a[1])) + uy * (s * (m[2] - a[2]))
    ux * (s * (m[1] - a[1])) + uy * (s * (m[2] - a[2])) = s * (ux * (m[1] - a[1]) + uy * (m[2] - a[2]))
    s * (ux * (m[1] - a[1]) + uy * (m[2] - a[2])) = s * ((a[1] - o[1]) * (m[1] - a[1]) + (a[2] - o[2]) * (m[2] - a[2]))
    s * ((a[1] - o[1]) * (m[1] - a[1]) + (a[2] - o[2]) * (m[2] - a[2])) = 0
    ux * px + uy * py = 0

    # D and A lie on the same circle: |OD|^2 = |OA|^2.
    release thm geo::distance_sq_symmetric(a, o)
    release thm geo::distance_sq_symmetric(d, o)
    geo::distance_sq(o, a) = r^2
    geo::distance_sq(o, d) = r^2
    release thm geo::distance_sq_coordinate_formula(o, d)
    geo::distance_sq(o, d) = (d[1] - o[1])^2 + (d[2] - o[2])^2
    d[1] - o[1] = (a[1] - o[1]) + (d[1] - a[1]) = ux + qx
    d[2] - o[2] = (a[2] - o[2]) + (d[2] - a[2]) = uy + qy
    geo::distance_sq(o, d) = ((a[1] - o[1]) + (d[1] - a[1]))^2 + ((a[2] - o[2]) + (d[2] - a[2]))^2
    ((a[1] - o[1]) + (d[1] - a[1]))^2 + ((a[2] - o[2]) + (d[2] - a[2]))^2 = (ux + qx)^2 + ((a[2] - o[2]) + (d[2] - a[2]))^2
    (ux + qx)^2 + ((a[2] - o[2]) + (d[2] - a[2]))^2 = (ux + qx)^2 + (uy + qy)^2
    geo::distance_sq(o, d) = (ux + qx)^2 + (uy + qy)^2
    geo::distance_sq(o, a) = ux^2 + uy^2
    (ux + qx)^2 + (uy + qy)^2 = ux^2 + uy^2
    (ux + qx)^2 + (uy + qy)^2 = ux^2 + 2 * ux * qx + qx^2 + uy^2 + 2 * uy * qy + qy^2
    ux^2 + 2 * ux * qx + qx^2 + uy^2 + 2 * uy * qy + qy^2 = (ux + qx)^2 + (uy + qy)^2 = ux^2 + uy^2
    (ux^2 + 2 * ux * qx + qx^2 + uy^2 + 2 * uy * qy + qy^2) - (ux^2 + uy^2) = 0
    2 * (ux * qx + uy * qy) + (qx^2 + qy^2) = (ux^2 + 2 * ux * qx + qx^2 + uy^2 + 2 * uy * qy + qy^2) - (ux^2 + uy^2) = 0

    # CD = CA.
    release thm geo::distance_sq_coordinate_formula(c, d)
    release thm geo::distance_sq_coordinate_formula(c, a)
    geo::distance_sq(c, d) = (d[1] - c[1])^2 + (d[2] - c[2])^2
    geo::distance_sq(c, a) = (a[1] - c[1])^2 + (a[2] - c[2])^2
    d[1] - c[1] = (d[1] - a[1]) - (c[1] - a[1]) = qx - px
    d[2] - c[2] = (d[2] - a[2]) - (c[2] - a[2]) = qy - py
    a[1] - c[1] = -(c[1] - a[1])
    -(c[1] - a[1]) = -px
    a[1] - c[1] = -px
    a[2] - c[2] = -(c[2] - a[2])
    -(c[2] - a[2]) = -py
    a[2] - c[2] = -py
    (d[1] - c[1])^2 + (d[2] - c[2])^2 = (qx - px)^2 + (qy - py)^2
    geo::distance_sq(c, d) = (d[1] - c[1])^2 + (d[2] - c[2])^2 = (qx - px)^2 + (qy - py)^2
    (a[1] - c[1])^2 + (a[2] - c[2])^2 = (-px)^2 + (-py)^2 = px^2 + py^2
    geo::distance_sq(c, a) = (a[1] - c[1])^2 + (a[2] - c[2])^2 = px^2 + py^2
    (qx - px)^2 + (qy - py)^2 = geo::distance_sq(c, d) = geo::distance_sq(c, a) = px^2 + py^2
    (qx - px)^2 + (qy - py)^2 = qx^2 - 2 * qx * px + px^2 + qy^2 - 2 * qy * py + py^2
    (qx^2 - 2 * qx * px + px^2 + qy^2 - 2 * qy * py + py^2) - (px^2 + py^2) = 0
    (qx^2 + qy^2) - 2 * (qx * px + qy * py) = (qx^2 - 2 * qx * px + px^2 + qy^2 - 2 * qy * py + py^2) - (px^2 + py^2) = 0

    # E and F lie on tangent BN, so OB is orthogonal to BE and BF.
    release thm geo::dot_coordinate_formula(geo::vec(o, b), geo::vec(b, n))
    geo::dot(geo::vec(o, b), geo::vec(b, n)) = (b[1] - o[1]) * (n[1] - b[1]) + (b[2] - o[2]) * (n[2] - b[2])
    (b[1] - o[1]) * (n[1] - b[1]) + (b[2] - o[2]) * (n[2] - b[2]) = 0
    ep[1] - b[1] = k * (n[1] - b[1])
    ep[2] - b[2] = k * (n[2] - b[2])
    f[1] - b[1] = w * (n[1] - b[1])
    f[2] - b[2] = w * (n[2] - b[2])
    (b[1] - o[1]) * (ep[1] - b[1]) + (b[2] - o[2]) * (ep[2] - b[2]) = (b[1] - o[1]) * (k * (n[1] - b[1])) + (b[2] - o[2]) * (k * (n[2] - b[2]))
    (b[1] - o[1]) * (k * (n[1] - b[1])) + (b[2] - o[2]) * (k * (n[2] - b[2])) = k * ((b[1] - o[1]) * (n[1] - b[1]) + (b[2] - o[2]) * (n[2] - b[2]))
    k * ((b[1] - o[1]) * (n[1] - b[1]) + (b[2] - o[2]) * (n[2] - b[2])) = 0
    (b[1] - o[1]) * (ep[1] - b[1]) + (b[2] - o[2]) * (ep[2] - b[2]) = 0
    (b[1] - o[1]) * (f[1] - b[1]) + (b[2] - o[2]) * (f[2] - b[2]) = (b[1] - o[1]) * (w * (n[1] - b[1])) + (b[2] - o[2]) * (w * (n[2] - b[2]))
    (b[1] - o[1]) * (w * (n[1] - b[1])) + (b[2] - o[2]) * (w * (n[2] - b[2])) = w * ((b[1] - o[1]) * (n[1] - b[1]) + (b[2] - o[2]) * (n[2] - b[2]))
    w * ((b[1] - o[1]) * (n[1] - b[1]) + (b[2] - o[2]) * (n[2] - b[2])) = 0
    (b[1] - o[1]) * (f[1] - b[1]) + (b[2] - o[2]) * (f[2] - b[2]) = 0
    release thm problem_551_negated_dot_from_aliases(ux, uy, b[1] - o[1], b[2] - o[2], ep[1] - b[1], ep[2] - b[2])
    ux * (ep[1] - b[1]) + uy * (ep[2] - b[2]) = 0
    release thm problem_551_negated_dot_from_aliases(ux, uy, b[1] - o[1], b[2] - o[2], f[1] - b[1], f[2] - b[2])
    ux * (f[1] - b[1]) + uy * (f[2] - b[2]) = 0

    # Express BE and BF in the OA, AC, AD basis through verified alias transport.
    release thm problem_551_affine_endpoint_coordinate(a[1], b[1], c[1], d[1], ep[1], o[1], ux, px, qx, t)
    ep[1] - b[1] = 2 * ux + t * qx + (1 - t) * px
    release thm problem_551_affine_endpoint_coordinate(a[2], b[2], c[2], d[2], ep[2], o[2], uy, py, qy, t)
    ep[2] - b[2] = 2 * uy + t * qy + (1 - t) * py
    release thm problem_551_affine_ray_endpoint_coordinate(a[1], b[1], d[1], f[1], o[1], ux, qx, v)
    f[1] - b[1] = 2 * ux + v * qx
    release thm problem_551_affine_ray_endpoint_coordinate(a[2], b[2], d[2], f[2], o[2], uy, qy, v)
    f[2] - b[2] = 2 * uy + v * qy
    release thm problem_551_affine_dot_expansion(ux, uy, px, py, qx, qy, ep[1] - b[1], ep[2] - b[2], t)
    ux * (ep[1] - b[1]) + uy * (ep[2] - b[2]) = 2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) + (1 - t) * (ux * px + uy * py)
    release thm problem_551_ray_dot_expansion(ux, uy, qx, qy, f[1] - b[1], f[2] - b[2], v)
    ux * (f[1] - b[1]) + uy * (f[2] - b[2]) = 2 * (ux^2 + uy^2) + v * (ux * qx + uy * qy)
    release thm problem_551_scale_left(ux * px + uy * py, 0, 1 - t)
    (1 - t) * (ux * px + uy * py) = (1 - t) * 0 = 0
    release thm problem_551_zero_from_equal(ux * (ep[1] - b[1]) + uy * (ep[2] - b[2]), 2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) + (1 - t) * (ux * px + uy * py))
    2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) + (1 - t) * (ux * px + uy * py) = 0
    release thm problem_551_sum_zero_left(2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy), (1 - t) * (ux * px + uy * py))
    2 * (ux^2 + uy^2) + t * (ux * qx + uy * qy) = 0
    release thm problem_551_zero_from_equal(ux * (f[1] - b[1]) + uy * (f[2] - b[2]), 2 * (ux^2 + uy^2) + v * (ux * qx + uy * qy))
    2 * (ux^2 + uy^2) + v * (ux * qx + uy * qy) = 0

    release thm scalar_core::problem_551_scalar_core(ux, uy, px, py, qx, qy, t, v)
    (ux + qx) * (qx - px) + (uy + qy) * (qy - py) = 0
    (2 * ux + t * qx + (1 - t) * px)^2 + (2 * uy + t * qy + (1 - t) * py)^2 = ((v - t) * qx + (t - 1) * px)^2 + ((v - t) * qy + (t - 1) * py)^2

    # Convert the first scalar conclusion to OD perpendicular DE.
    release thm geo::dot_coordinate_formula(geo::vec(o, d), geo::vec(d, ep))
    geo::dot(geo::vec(o, d), geo::vec(d, ep)) = (d[1] - o[1]) * (ep[1] - d[1]) + (d[2] - o[2]) * (ep[2] - d[2])
    release thm problem_551_affine_endpoint_difference(a[1], c[1], d[1], ep[1], px, qx, t)
    ep[1] - d[1] = (t - 1) * (qx - px)
    release thm problem_551_affine_endpoint_difference(a[2], c[2], d[2], ep[2], py, qy, t)
    ep[2] - d[2] = (t - 1) * (qy - py)
    release thm problem_551_multiply_equalities(d[1] - o[1], ux + qx, ep[1] - d[1], (t - 1) * (qx - px))
    (d[1] - o[1]) * (ep[1] - d[1]) = (ux + qx) * ((t - 1) * (qx - px))
    release thm problem_551_multiply_equalities(d[2] - o[2], uy + qy, ep[2] - d[2], (t - 1) * (qy - py))
    (d[2] - o[2]) * (ep[2] - d[2]) = (uy + qy) * ((t - 1) * (qy - py))
    release thm problem_551_add_equalities((d[1] - o[1]) * (ep[1] - d[1]), (ux + qx) * ((t - 1) * (qx - px)), (d[2] - o[2]) * (ep[2] - d[2]), (uy + qy) * ((t - 1) * (qy - py)))
    (d[1] - o[1]) * (ep[1] - d[1]) + (d[2] - o[2]) * (ep[2] - d[2]) = (ux + qx) * ((t - 1) * (qx - px)) + (uy + qy) * ((t - 1) * (qy - py))
    (ux + qx) * ((t - 1) * (qx - px)) + (uy + qy) * ((t - 1) * (qy - py)) = (t - 1) * ((ux + qx) * (qx - px) + (uy + qy) * (qy - py))
    release thm problem_551_scale_left((ux + qx) * (qx - px) + (uy + qy) * (qy - py), 0, t - 1)
    (t - 1) * ((ux + qx) * (qx - px) + (uy + qy) * (qy - py)) = (t - 1) * 0 = 0
    (d[1] - o[1]) * (ep[1] - d[1]) + (d[2] - o[2]) * (ep[2] - d[2]) = 0
    geo::dot(geo::vec(o, d), geo::vec(d, ep)) = 0

    # Convert the second scalar conclusion to BE = EF in squared distance.
    release thm geo::distance_sq_coordinate_formula(b, ep)
    release thm geo::distance_sq_coordinate_formula(ep, f)
    geo::distance_sq(b, ep) = (ep[1] - b[1])^2 + (ep[2] - b[2])^2
    release thm problem_551_affine_endpoint_gap(b[1], ep[1], f[1], ux, px, qx, t, v)
    f[1] - ep[1] = (v - t) * qx + (t - 1) * px
    release thm problem_551_affine_endpoint_gap(b[2], ep[2], f[2], uy, py, qy, t, v)
    f[2] - ep[2] = (v - t) * qy + (t - 1) * py
    geo::distance_sq(ep, f) = (f[1] - ep[1])^2 + (f[2] - ep[2])^2
    release thm problem_551_distance_from_aliases(geo::distance_sq(b, ep), ep[1] - b[1], ep[2] - b[2], 2 * ux + t * qx + (1 - t) * px, 2 * uy + t * qy + (1 - t) * py)
    geo::distance_sq(b, ep) = (2 * ux + t * qx + (1 - t) * px)^2 + (2 * uy + t * qy + (1 - t) * py)^2
    release thm problem_551_distance_from_aliases(geo::distance_sq(ep, f), f[1] - ep[1], f[2] - ep[2], (v - t) * qx + (t - 1) * px, (v - t) * qy + (t - 1) * py)
    geo::distance_sq(ep, f) = ((v - t) * qx + (t - 1) * px)^2 + ((v - t) * qy + (t - 1) * py)^2
    geo::distance_sq(b, ep) = geo::distance_sq(ep, f)
