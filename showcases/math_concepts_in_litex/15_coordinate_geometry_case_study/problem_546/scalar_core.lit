# Experimental scalar metric core for problem 546.
thm problem_546_scalar_metric_core:
    ? forall u1, u2, v1, v2, t, s, q R:
        u1 * v1 + u2 * v2 = 0,
        (-(u1 + v1)) * ((t - 1) * u1 - v1) + (-(u2 + v2)) * ((t - 1) * u2 - v2) = 0,
        u1^2 + u2^2 = s,
        (u1 + v1)^2 + (u2 + v2)^2 = 4 * q
        =>:
            (u1 + v1)^2 + (u2 + v2)^2 = t * s,
            ((t - 1) * u1 - v1)^2 + ((t - 1) * u2 - v2)^2 = t * (t - 1) * s,
            ((t - 1) * u1)^2 + ((t - 1) * u2)^2 = (t - 1)^2 * s,
            (v1 / 2)^2 + (v2 / 2)^2 = q - s / 4

    (-(u1 + v1)) * ((t - 1) * u1 - v1) + (-(u2 + v2)) * ((t - 1) * u2 - v2) = -(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2) + (v1^2 + v2^2)
    by thm geo::multiply_both_sides(u1^2 + u2^2, s, -(t - 1))
    (u1^2 + u2^2) * (-(t - 1)) = s * (-(t - 1))
    -(t - 1) * (u1^2 + u2^2) = -(t - 1) * s
    by thm geo::multiply_both_sides(u1 * v1 + u2 * v2, 0, 2 - t)
    (u1 * v1 + u2 * v2) * (2 - t) = 0 * (2 - t)
    (2 - t) * (u1 * v1 + u2 * v2) = 0
    -(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2) = -(t - 1) * s + 0
    by thm geo::add_equalities(-(t - 1) * (u1^2 + u2^2), -(t - 1) * s, (2 - t) * (u1 * v1 + u2 * v2), 0)
    -(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2) = -(t - 1) * s + 0
    by thm geo::add_equalities(-(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2), -(t - 1) * s + 0, v1^2 + v2^2, v1^2 + v2^2)
    (-(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2)) + (v1^2 + v2^2) = (-(t - 1) * s + 0) + (v1^2 + v2^2)
    -(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2) + (v1^2 + v2^2) = -(t - 1) * s + v1^2 + v2^2
    -(t - 1) * s + v1^2 + v2^2 = -(t - 1) * (u1^2 + u2^2) + (2 - t) * (u1 * v1 + u2 * v2) + (v1^2 + v2^2) = (-(u1 + v1)) * ((t - 1) * u1 - v1) + (-(u2 + v2)) * ((t - 1) * u2 - v2) = 0
    v1^2 + v2^2 + (-(t - 1) * s) = -(t - 1) * s + v1^2 + v2^2 = 0
    (t - 1) * s + (-(t - 1) * s) = 0
    v1^2 + v2^2 + (-(t - 1) * s) = (t - 1) * s + (-(t - 1) * s)
    by thm geo::addition_cancel(v1^2 + v2^2, (t - 1) * s, -(t - 1) * s)
    v1^2 + v2^2 = (t - 1) * s

    (u1 + v1)^2 + (u2 + v2)^2 = (u1^2 + u2^2) + 2 * (u1 * v1 + u2 * v2) + (v1^2 + v2^2)
    by thm geo::multiply_both_sides(u1 * v1 + u2 * v2, 0, 2)
    (u1 * v1 + u2 * v2) * 2 = 0 * 2
    2 * (u1 * v1 + u2 * v2) = 0
    by thm geo::add_equalities(u1^2 + u2^2, s, 2 * (u1 * v1 + u2 * v2), 0)
    (u1^2 + u2^2) + 2 * (u1 * v1 + u2 * v2) = s + 0
    by thm geo::add_equalities((u1^2 + u2^2) + 2 * (u1 * v1 + u2 * v2), s + 0, v1^2 + v2^2, (t - 1) * s)
    ((u1^2 + u2^2) + 2 * (u1 * v1 + u2 * v2)) + (v1^2 + v2^2) = (s + 0) + (t - 1) * s
    (u1^2 + u2^2) + 2 * (u1 * v1 + u2 * v2) + (v1^2 + v2^2) = s + (t - 1) * s
    s + (t - 1) * s = t * s
    (u1 + v1)^2 + (u2 + v2)^2 = t * s

    ((t - 1) * u1 - v1)^2 + ((t - 1) * u2 - v2)^2 = (t - 1)^2 * (u1^2 + u2^2) + (-2 * (t - 1) * (u1 * v1 + u2 * v2)) + (v1^2 + v2^2)
    by thm geo::multiply_both_sides(u1^2 + u2^2, s, (t - 1)^2)
    (u1^2 + u2^2) * (t - 1)^2 = s * (t - 1)^2
    (t - 1)^2 * (u1^2 + u2^2) = (t - 1)^2 * s
    by thm geo::multiply_both_sides(u1 * v1 + u2 * v2, 0, -2 * (t - 1))
    (u1 * v1 + u2 * v2) * (-2 * (t - 1)) = 0 * (-2 * (t - 1))
    -2 * (t - 1) * (u1 * v1 + u2 * v2) = 0
    by thm geo::add_equalities((t - 1)^2 * (u1^2 + u2^2), (t - 1)^2 * s, -2 * (t - 1) * (u1 * v1 + u2 * v2), 0)
    (t - 1)^2 * (u1^2 + u2^2) + (-2 * (t - 1) * (u1 * v1 + u2 * v2)) = (t - 1)^2 * s + 0
    by thm geo::add_equalities((t - 1)^2 * (u1^2 + u2^2) + (-2 * (t - 1) * (u1 * v1 + u2 * v2)), (t - 1)^2 * s + 0, v1^2 + v2^2, (t - 1) * s)
    ((t - 1)^2 * (u1^2 + u2^2) + (-2 * (t - 1) * (u1 * v1 + u2 * v2))) + (v1^2 + v2^2) = ((t - 1)^2 * s + 0) + (t - 1) * s
    (t - 1)^2 * (u1^2 + u2^2) + (-2 * (t - 1) * (u1 * v1 + u2 * v2)) + (v1^2 + v2^2) = (t - 1)^2 * s + (t - 1) * s
    (t - 1)^2 * s + (t - 1) * s = t * (t - 1) * s
    ((t - 1) * u1 - v1)^2 + ((t - 1) * u2 - v2)^2 = t * (t - 1) * s

    ((t - 1) * u1)^2 + ((t - 1) * u2)^2 = (t - 1)^2 * (u1^2 + u2^2)
    (t - 1)^2 * (u1^2 + u2^2) = (t - 1)^2 * s
    ((t - 1) * u1)^2 + ((t - 1) * u2)^2 = (t - 1)^2 * s

    (u1 + v1)^2 + (u2 + v2)^2 = t * s = 4 * q
    t * s = 4 * q
    (t - 1) * s = t * s - s = 4 * q - s
    (v1 / 2)^2 + (v2 / 2)^2 = (v1^2 + v2^2) / 4
    (v1^2 + v2^2) / 4 = ((t - 1) * s) / 4
    ((t - 1) * s) / 4 = (4 * q - s) / 4 = q - s / 4
    (v1 / 2)^2 + (v2 / 2)^2 = q - s / 4
