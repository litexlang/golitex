# Problem 225 / zhongkao_21
# ================================================================
# 原题（完整自然语言）
# （1）如图1．在Rt△ACB中，∠ACB＝90°，AC＝8，BC＝6，点D、E分别在边CA，CB上且CD＝3，CE＝4，连接AE，BD，F为AE的中点，连接CF交BD于点G，证明：CG⊥BD。
# （提示：延长CF到点M，使FM＝CF，连接AM。）
# （2）将△DCE绕点C逆时针旋转至图2所示位置时，（1）中的结论是否仍然成立？若成立，请给出证明；若不成立，请说明理由。
# （3）将△DCE绕点C逆时针在平面内旋转，在旋转过程中，当B，D，E三点在同一条直线上时，CF的长为______。
#
# 本文件完成范围：用坐标证明第（2）问的旋转不变量，并证明第（3）问
# 在 B、D、E 共线时的 CF 长度析取；第（1）问的原图构造提示保留在
# translation.lit 的逐句翻译中，未在本文件另行声称已形式化。
#
# 逐句语义对照（坐标证明桥）
# - “Rt△ACB，∠ACB＝90°，AC＝8，BC＝6”
#     ↔ 归一化 C=(0,0), A=(8,0), B=(0,6)。
# - “CD＝3，CE＝4，绕点C逆时针旋转”
#     ↔ 同一旋转参数 (co,si)，D=(3*co,3*si)，E=(-4*si,4*co)，且 co^2+si^2=1。
# - “F为AE的中点”
#     ↔ F=(4-2*si,2*co)。
# - “CG⊥BD”
#     ↔ $geo::is_perpendicular((0,0), F, (0,6), D)，其中 G 是 CF 与 BD 的交点。
# - “B，D，E三点在同一直线上”
#     ↔ 3*co+4*si=2；该等式是共线条件在上述坐标归一化下的展开。
# - “CF的长”
#     ↔ sqrt(geo::distance_sq((0,0), F))。
#
# The geometric vocabulary and coordinate certificate are declared in translation.lit.
# The following theorems are the checked coordinate proof layer.

thm nonnegative_equal_of_equal_squares:
    ? forall x, y R:
        x >= 0,
        y > 0,
        x^2 = y^2
        =>:
            x = y
    x^2 - y^2 = 0
    (x - y) * (x + y) = 0
    x + y > 0
    x + y != 0
    x - y = 0
    x = y

thm problem_225_rotation_perpendicular_core:
    ? forall c, s R:
        c^2 + s^2 = 1,
        (0, 0) != (4 - 2 * s, 2 * c),
        (0, 6) != (3 * c, 3 * s)
        =>:
            $geo::is_perpendicular((0, 0), (4 - 2 * s, 2 * c), (0, 6), (3 * c, 3 * s))
    by def $geo::is_perpendicular((0, 0), (4 - 2 * s, 2 * c), (0, 6), (3 * c, 3 * s))
    by thm geo::vec_coordinate_formula((0, 0), (4 - 2 * s, 2 * c))
    by thm geo::vec_coordinate_formula((0, 6), (3 * c, 3 * s))
    by thm geo::dot_coordinate_formula(geo::vec((0, 0), (4 - 2 * s, 2 * c)), geo::vec((0, 6), (3 * c, 3 * s)))
    geo::dot(geo::vec((0, 0), (4 - 2 * s, 2 * c)), geo::vec((0, 6), (3 * c, 3 * s))) = (4 - 2 * s) * (3 * c) + (2 * c) * (3 * s - 6) = 0

# Exact first counterclockwise collinear position.
thm problem_225_first_collinear_length_core:
    ? forall c, s R, f cart(R, R):
        c = (6 - 4 * sqrt(21)) / 25,
        s = (8 + 3 * sqrt(21)) / 25,
        f = (4 - 2 * s, 2 * c)
        =>:
            c^2 + s^2 = 1,
            3 * c + 4 * s = 2,
            s > 0,
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5
    sqrt(21)^2 = 21
    sqrt(21) > 0
    by thm geo::square_of_equal(c, (6 - 4 * sqrt(21)) / 25)
    by thm geo::square_of_equal(s, (8 + 3 * sqrt(21)) / 25)
    c^2 = ((6 - 4 * sqrt(21)) / 25)^2
    s^2 = ((8 + 3 * sqrt(21)) / 25)^2
    by thm geo::add_equalities(c^2, ((6 - 4 * sqrt(21)) / 25)^2, s^2, ((8 + 3 * sqrt(21)) / 25)^2)
    c^2 + s^2 = ((6 - 4 * sqrt(21)) / 25)^2 + ((8 + 3 * sqrt(21)) / 25)^2
    ((6 - 4 * sqrt(21)) / 25)^2 + ((8 + 3 * sqrt(21)) / 25)^2 = ((6 - 4 * sqrt(21))^2 + (8 + 3 * sqrt(21))^2) / 625
    ((6 - 4 * sqrt(21))^2 + (8 + 3 * sqrt(21))^2) / 625 = (36 - 48 * sqrt(21) + 16 * sqrt(21)^2 + 64 + 48 * sqrt(21) + 9 * sqrt(21)^2) / 625
    (36 - 48 * sqrt(21) + 16 * sqrt(21)^2 + 64 + 48 * sqrt(21) + 9 * sqrt(21)^2) / 625 = (100 + 25 * sqrt(21)^2) / 625
    (100 + 25 * sqrt(21)^2) / 625 = (100 + 25 * 21) / 625
    (100 + 25 * 21) / 625 = 1
    ((6 - 4 * sqrt(21)) / 25)^2 + ((8 + 3 * sqrt(21)) / 25)^2 = 1
    c^2 + s^2 = 1
    by thm geo::multiply_both_sides(c, (6 - 4 * sqrt(21)) / 25, 3)
    by thm geo::multiply_both_sides(s, (8 + 3 * sqrt(21)) / 25, 4)
    3 * c = 3 * ((6 - 4 * sqrt(21)) / 25)
    4 * s = 4 * ((8 + 3 * sqrt(21)) / 25)
    by thm geo::add_equalities(3 * c, 3 * ((6 - 4 * sqrt(21)) / 25), 4 * s, 4 * ((8 + 3 * sqrt(21)) / 25))
    3 * c + 4 * s = 3 * ((6 - 4 * sqrt(21)) / 25) + 4 * ((8 + 3 * sqrt(21)) / 25)
    3 * ((6 - 4 * sqrt(21)) / 25) + 4 * ((8 + 3 * sqrt(21)) / 25) = (18 - 12 * sqrt(21) + 32 + 12 * sqrt(21)) / 25
    (18 - 12 * sqrt(21) + 32 + 12 * sqrt(21)) / 25 = 50 / 25
    50 / 25 = 2
    3 * c + 4 * s = 2
    8 + 3 * sqrt(21) > 0
    (8 + 3 * sqrt(21)) / 25 > 0
    s > 0
    by thm geo::distance_sq_coordinate_formula((0, 0), f)
    geo::distance_sq((0, 0), f) = (f[1] - 0)^2 + (f[2] - 0)^2
    f[1] = 4 - 2 * s
    f[2] = 2 * c
    f[1] - 0 = 4 - 2 * s
    f[2] - 0 = 2 * c
    by thm geo::square_of_equal(f[1] - 0, 4 - 2 * s)
    by thm geo::square_of_equal(f[2] - 0, 2 * c)
    (f[1] - 0)^2 = (4 - 2 * s)^2
    (f[2] - 0)^2 = (2 * c)^2
    by thm geo::add_equalities((f[1] - 0)^2, (4 - 2 * s)^2, (f[2] - 0)^2, (2 * c)^2)
    (f[1] - 0)^2 + (f[2] - 0)^2 = (4 - 2 * s)^2 + (2 * c)^2
    geo::distance_sq((0, 0), f) = (4 - 2 * s)^2 + (2 * c)^2
    s^2 + c^2 = c^2 + s^2 = 1
    by thm geo::multiply_both_sides(s^2 + c^2, 1, 4)
    (s^2 + c^2) * 4 = 4
    4 * (s^2 + c^2) = 4
    (4 - 2 * s)^2 + (2 * c)^2 = 16 - 16 * s + 4 * (s^2 + c^2)
    by thm geo::add_equalities(16 - 16 * s, 16 - 16 * s, 4 * (s^2 + c^2), 4)
    16 - 16 * s + 4 * (s^2 + c^2) = 16 - 16 * s + 4
    16 - 16 * s + 4 = 20 - 16 * s
    (4 - 2 * s)^2 + (2 * c)^2 = 20 - 16 * s
    by thm geo::multiply_both_sides(s, (8 + 3 * sqrt(21)) / 25, -16)
    -16 * s = -16 * ((8 + 3 * sqrt(21)) / 25)
    by thm geo::add_equalities(20, 20, -16 * s, -16 * ((8 + 3 * sqrt(21)) / 25))
    20 - 16 * s = 20 - 16 * ((8 + 3 * sqrt(21)) / 25)
    20 - 16 * ((8 + 3 * sqrt(21)) / 25) = (500 - 128 - 48 * sqrt(21)) / 25
    (500 - 128 - 48 * sqrt(21)) / 25 = (372 - 48 * sqrt(21)) / 25
    ((4 * sqrt(21) - 6) / 5)^2 = (4 * sqrt(21) - 6)^2 / 25
    (4 * sqrt(21) - 6)^2 / 25 = (16 * sqrt(21)^2 - 48 * sqrt(21) + 36) / 25
    (16 * sqrt(21)^2 - 48 * sqrt(21) + 36) / 25 = (372 - 48 * sqrt(21)) / 25
    (4 - 2 * s)^2 + (2 * c)^2 = ((4 * sqrt(21) - 6) / 5)^2
    geo::distance_sq((0, 0), f) = ((4 * sqrt(21) - 6) / 5)^2
    sqrt(16) < sqrt(21)
    sqrt(16) = 4
    sqrt(21) > 4
    4 * sqrt(21) > 4 * 4
    4 * 4 = 16
    4 * sqrt(21) > 16
    4 * sqrt(21) - 6 > 16 - 6
    16 - 6 = 10
    4 * sqrt(21) - 6 > 10
    10 > 0
    (4 * sqrt(21) - 6) / 5 > 0
    sqrt(geo::distance_sq((0, 0), f)) >= 0
    sqrt(geo::distance_sq((0, 0), f))^2 = geo::distance_sq((0, 0), f)
    sqrt(geo::distance_sq((0, 0), f))^2 = ((4 * sqrt(21) - 6) / 5)^2
    by thm nonnegative_equal_of_equal_squares(sqrt(geo::distance_sq((0, 0), f)), (4 * sqrt(21) - 6) / 5)
    sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5

# Exact second counterclockwise collinear position in a full turn.
thm problem_225_second_collinear_length_core:
    ? forall c, s R, f cart(R, R):
        c = (6 + 4 * sqrt(21)) / 25,
        s = (8 - 3 * sqrt(21)) / 25,
        f = (4 - 2 * s, 2 * c)
        =>:
            c^2 + s^2 = 1,
            3 * c + 4 * s = 2,
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
    sqrt(21)^2 = 21
    sqrt(21) > 0
    by thm geo::square_of_equal(c, (6 + 4 * sqrt(21)) / 25)
    by thm geo::square_of_equal(s, (8 - 3 * sqrt(21)) / 25)
    c^2 = ((6 + 4 * sqrt(21)) / 25)^2
    s^2 = ((8 - 3 * sqrt(21)) / 25)^2
    by thm geo::add_equalities(c^2, ((6 + 4 * sqrt(21)) / 25)^2, s^2, ((8 - 3 * sqrt(21)) / 25)^2)
    c^2 + s^2 = ((6 + 4 * sqrt(21)) / 25)^2 + ((8 - 3 * sqrt(21)) / 25)^2
    ((6 + 4 * sqrt(21)) / 25)^2 + ((8 - 3 * sqrt(21)) / 25)^2 = ((6 + 4 * sqrt(21))^2 + (8 - 3 * sqrt(21))^2) / 625
    ((6 + 4 * sqrt(21))^2 + (8 - 3 * sqrt(21))^2) / 625 = (36 + 48 * sqrt(21) + 16 * sqrt(21)^2 + 64 - 48 * sqrt(21) + 9 * sqrt(21)^2) / 625
    (36 + 48 * sqrt(21) + 16 * sqrt(21)^2 + 64 - 48 * sqrt(21) + 9 * sqrt(21)^2) / 625 = (100 + 25 * sqrt(21)^2) / 625
    (100 + 25 * sqrt(21)^2) / 625 = (100 + 25 * 21) / 625
    (100 + 25 * 21) / 625 = 1
    ((6 + 4 * sqrt(21)) / 25)^2 + ((8 - 3 * sqrt(21)) / 25)^2 = 1
    c^2 + s^2 = 1
    by thm geo::multiply_both_sides(c, (6 + 4 * sqrt(21)) / 25, 3)
    by thm geo::multiply_both_sides(s, (8 - 3 * sqrt(21)) / 25, 4)
    3 * c = 3 * ((6 + 4 * sqrt(21)) / 25)
    4 * s = 4 * ((8 - 3 * sqrt(21)) / 25)
    by thm geo::add_equalities(3 * c, 3 * ((6 + 4 * sqrt(21)) / 25), 4 * s, 4 * ((8 - 3 * sqrt(21)) / 25))
    3 * c + 4 * s = 3 * ((6 + 4 * sqrt(21)) / 25) + 4 * ((8 - 3 * sqrt(21)) / 25)
    3 * ((6 + 4 * sqrt(21)) / 25) + 4 * ((8 - 3 * sqrt(21)) / 25) = (18 + 12 * sqrt(21) + 32 - 12 * sqrt(21)) / 25
    (18 + 12 * sqrt(21) + 32 - 12 * sqrt(21)) / 25 = 50 / 25
    50 / 25 = 2
    3 * c + 4 * s = 2
    by thm geo::distance_sq_coordinate_formula((0, 0), f)
    f[1] = 4 - 2 * s
    f[2] = 2 * c
    f[1] - 0 = 4 - 2 * s
    f[2] - 0 = 2 * c
    by thm geo::square_of_equal(f[1] - 0, 4 - 2 * s)
    (f[1] - 0)^2 = (4 - 2 * s)^2
    by thm geo::square_of_equal(f[2] - 0, 2 * c)
    (f[2] - 0)^2 = (2 * c)^2
    by thm geo::add_equalities((f[1] - 0)^2, (4 - 2 * s)^2, (f[2] - 0)^2, (2 * c)^2)
    (f[1] - 0)^2 + (f[2] - 0)^2 = (4 - 2 * s)^2 + (2 * c)^2
    geo::distance_sq((0, 0), f) = (4 - 2 * s)^2 + (2 * c)^2
    s^2 + c^2 = c^2 + s^2 = 1
    by thm geo::multiply_both_sides(s^2 + c^2, 1, 4)
    (s^2 + c^2) * 4 = 4
    4 * (s^2 + c^2) = 4
    (4 - 2 * s)^2 + (2 * c)^2 = 16 - 16 * s + 4 * (s^2 + c^2)
    by thm geo::add_equalities(16 - 16 * s, 16 - 16 * s, 4 * (s^2 + c^2), 4)
    16 - 16 * s + 4 * (s^2 + c^2) = 16 - 16 * s + 4
    16 - 16 * s + 4 = 20 - 16 * s
    (4 - 2 * s)^2 + (2 * c)^2 = 20 - 16 * s
    by thm geo::multiply_both_sides(s, (8 - 3 * sqrt(21)) / 25, -16)
    -16 * s = -16 * ((8 - 3 * sqrt(21)) / 25)
    by thm geo::add_equalities(20, 20, -16 * s, -16 * ((8 - 3 * sqrt(21)) / 25))
    20 - 16 * s = 20 - 16 * ((8 - 3 * sqrt(21)) / 25)
    20 - 16 * ((8 - 3 * sqrt(21)) / 25) = (500 - 128 + 48 * sqrt(21)) / 25
    (500 - 128 + 48 * sqrt(21)) / 25 = (372 + 48 * sqrt(21)) / 25
    ((4 * sqrt(21) + 6) / 5)^2 = (4 * sqrt(21) + 6)^2 / 25
    (4 * sqrt(21) + 6)^2 / 25 = (16 * sqrt(21)^2 + 48 * sqrt(21) + 36) / 25
    (16 * sqrt(21)^2 + 48 * sqrt(21) + 36) / 25 = (372 + 48 * sqrt(21)) / 25
    (4 - 2 * s)^2 + (2 * c)^2 = ((4 * sqrt(21) + 6) / 5)^2
    geo::distance_sq((0, 0), f) = ((4 * sqrt(21) + 6) / 5)^2
    4 * sqrt(21) > 0
    4 * sqrt(21) + 6 > 6
    6 > 0
    4 * sqrt(21) + 6 > 0
    (4 * sqrt(21) + 6) / 5 > 0
    sqrt(geo::distance_sq((0, 0), f)) >= 0
    sqrt(geo::distance_sq((0, 0), f))^2 = geo::distance_sq((0, 0), f)
    sqrt(geo::distance_sq((0, 0), f))^2 = ((4 * sqrt(21) + 6) / 5)^2
    by thm nonnegative_equal_of_equal_squares(sqrt(geo::distance_sq((0, 0), f)), (4 * sqrt(21) + 6) / 5)
    sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5

# Completeness of the two collinear rotation parameters.
thm problem_225_collinear_parameter_cases:
    ? forall c, s R:
        c^2 + s^2 = 1,
        3 * c + 4 * s = 2
        =>:
            s = (8 + 3 * sqrt(21)) / 25 or s = (8 - 3 * sqrt(21)) / 25
    sqrt(21)^2 = 21
    3 * c = 2 - 4 * s
    by thm geo::square_of_equal(3 * c, 2 - 4 * s)
    (3 * c)^2 = (2 - 4 * s)^2
    c^2 = 1 - s^2
    9 * c^2 = 9 * (1 - s^2)
    (3 * c)^2 = 9 * c^2
    (2 - 4 * s)^2 = 4 - 16 * s + 16 * s^2
    9 * (1 - s^2) = 9 - 9 * s^2
    (3 * c)^2 = 9 - 9 * s^2
    (2 - 4 * s)^2 = 9 - 9 * s^2
    4 - 16 * s + 16 * s^2 = 9 - 9 * s^2
    by thm geo::subtract_equalities(4 - 16 * s + 16 * s^2, 9 - 9 * s^2, 9 - 9 * s^2, 9 - 9 * s^2)
    (4 - 16 * s + 16 * s^2) - (9 - 9 * s^2) = 0
    (4 - 16 * s + 16 * s^2) - (9 - 9 * s^2) = 25 * s^2 - 16 * s - 5
    25 * s^2 - 16 * s - 5 = 0
    by thm geo::multiply_both_sides(25 * s^2 - 16 * s - 5, 0, 25)
    (25 * s^2 - 16 * s - 5) * 25 = 0 * 25
    (25 * s^2 - 16 * s - 5) * 25 = 625 * s^2 - 400 * s - 125
    0 * 25 = 0
    625 * s^2 - 400 * s - 125 = 0
    (25 * s - 8)^2 = 625 * s^2 - 400 * s + 64
    (3 * sqrt(21))^2 = 9 * sqrt(21)^2
    (3 * sqrt(21))^2 = 189
    (25 * s - 8)^2 - (3 * sqrt(21))^2 = 625 * s^2 - 400 * s - 125
    (25 * s - 8)^2 - (3 * sqrt(21))^2 = 0
    by thm geo::difference_of_squares(25 * s - 8, 3 * sqrt(21))
    (25 * s - 8)^2 - (3 * sqrt(21))^2 = ((25 * s - 8) + 3 * sqrt(21)) * ((25 * s - 8) - 3 * sqrt(21))
    ((25 * s - 8) + 3 * sqrt(21)) * ((25 * s - 8) - 3 * sqrt(21)) = 0
    ((25 * s - 8) - 3 * sqrt(21)) * ((25 * s - 8) + 3 * sqrt(21)) = 0
    (25 * s - (8 + 3 * sqrt(21))) * (25 * s - (8 - 3 * sqrt(21))) = 0
    s = (8 + 3 * sqrt(21)) / 25 or not s = (8 + 3 * sqrt(21)) / 25
    by cases:
        ? s = (8 + 3 * sqrt(21)) / 25 or s = (8 - 3 * sqrt(21)) / 25
        case s = (8 + 3 * sqrt(21)) / 25:
            s = (8 + 3 * sqrt(21)) / 25 or s = (8 - 3 * sqrt(21)) / 25
        case not s = (8 + 3 * sqrt(21)) / 25:
            by contra:
                ? 25 * s - (8 + 3 * sqrt(21)) != 0
                25 * s - (8 + 3 * sqrt(21)) = 0
                25 * s = 8 + 3 * sqrt(21)
                s * 25 = ((8 + 3 * sqrt(21)) / 25) * 25
                25 != 0
                by thm geo::divide_both_sides(s, (8 + 3 * sqrt(21)) / 25, 25)
                s = (8 + 3 * sqrt(21)) / 25
                impossible not s = (8 + 3 * sqrt(21)) / 25
            by thm geo::zero_factor_law(25 * s - (8 + 3 * sqrt(21)), 25 * s - (8 - 3 * sqrt(21)))
            25 * s - (8 - 3 * sqrt(21)) = 0
            s = (8 - 3 * sqrt(21)) / 25
            s = (8 + 3 * sqrt(21)) / 25 or s = (8 - 3 * sqrt(21)) / 25


# Therefore every collinear position gives exactly one of the two possible CF lengths.
thm problem_225_collinear_length_cases:
    ? forall c, s R, f cart(R, R):
        c^2 + s^2 = 1,
        3 * c + 4 * s = 2,
        f = (4 - 2 * s, 2 * c)
        =>:
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5 or sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
    by thm problem_225_collinear_parameter_cases(c, s)
    s = (8 + 3 * sqrt(21)) / 25 or s = (8 - 3 * sqrt(21)) / 25
    by cases:
        ? sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5 or sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
        case s = (8 + 3 * sqrt(21)) / 25:
            3 * c = 2 - 4 * s
            2 - 4 * s = 2 - 4 * ((8 + 3 * sqrt(21)) / 25)
            2 - 4 * ((8 + 3 * sqrt(21)) / 25) = 3 * ((6 - 4 * sqrt(21)) / 25)
            c * 3 = 3 * c = 3 * ((6 - 4 * sqrt(21)) / 25) = ((6 - 4 * sqrt(21)) / 25) * 3
            3 != 0
            by thm geo::divide_both_sides(c, (6 - 4 * sqrt(21)) / 25, 3)
            c = (6 - 4 * sqrt(21)) / 25
            by thm problem_225_first_collinear_length_core(c, s, f)
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5 or sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
        case s = (8 - 3 * sqrt(21)) / 25:
            3 * c = 2 - 4 * s
            2 - 4 * s = 2 - 4 * ((8 - 3 * sqrt(21)) / 25)
            2 - 4 * ((8 - 3 * sqrt(21)) / 25) = 3 * ((6 + 4 * sqrt(21)) / 25)
            c * 3 = 3 * c = 3 * ((6 + 4 * sqrt(21)) / 25) = ((6 + 4 * sqrt(21)) / 25) * 3
            3 != 0
            by thm geo::divide_both_sides(c, (6 + 4 * sqrt(21)) / 25, 3)
            c = (6 + 4 * sqrt(21)) / 25
            by thm problem_225_second_collinear_length_core(c, s, f)
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
            sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5 or sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5



# Geometry-first wrappers: connect the translation predicates to the checked cores.
thm problem_225_rotation_perpendicular_from_translation:
    ? forall co, si R, d, ep, f cart(R, R):
        $translation::problem_225_rotation_certificate(co, si, d, ep, f)
        =>:
            $translation::problem_225_perpendicular_target(co, si, d, ep, f)

    by def $translation::problem_225_rotation_certificate(co, si, d, ep, f)
    by thm problem_225_rotation_perpendicular_core(co, si)
    $geo::is_perpendicular((0, 0), f, (0, 6), d)
    by def $translation::problem_225_perpendicular_target(co, si, d, ep, f)
    $translation::problem_225_rotation_certificate(co, si, d, ep, f)
    $geo::is_perpendicular((0, 0), f, (0, 6), d)

thm problem_225_collinear_answer_from_translation:
    ? forall co, si R, d, ep, f cart(R, R):
        $translation::problem_225_collinear_rotation_case(co, si, d, ep, f)
        =>:
            $translation::problem_225_cf_length_answer(f)

    by def $translation::problem_225_collinear_rotation_case(co, si, d, ep, f)
    by def $translation::problem_225_rotation_certificate(co, si, d, ep, f)
    by thm problem_225_collinear_length_cases(co, si, f)
    sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5 or sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
    by thm geo::distance_sq_nonnegative((0, 0), f)
    0 <= geo::distance_sq((0, 0), f)
    by def $translation::problem_225_cf_length_answer(f)
    sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) - 6) / 5 or sqrt(geo::distance_sq((0, 0), f)) = (4 * sqrt(21) + 6) / 5
