# Private scalar-coordinate parameter kernel for Problem 513.

thm problem_513_parameter_kernel:
    ? forall a, b, c, t, S, x1, x2, y1, y2, q1, q2, z1, z2, V1, V2 R:
        a > 0
        b > 0
        c > 0
        t > 0
        S = a + b + c
        c^2 = x1^2 + x2^2
        b^2 = y1^2 + y2^2
        a^2 = (y1 - x1)^2 + (y2 - x2)^2
        x1^2 + x2^2 = 2 * (q1 * x1 + q2 * x2)
        y1^2 + y2^2 = 2 * (q1 * y1 + q2 * y2)
        V1 = b * x1 + c * y1
        V2 = b * x2 + c * y2
        S * z1 = t * V1
        S * z2 = t * V2
        z1^2 + z2^2 = 2 * (q1 * z1 + q2 * z2)
        =>:
            t * (b + c - a) = b + c
    a + b > 0
    a + b + c > 0
    S > 0
    V1^2 + V2^2 = (b * x1 + c * y1)^2 + (b * x2 + c * y2)^2
    (b * x1 + c * y1)^2 + (b * x2 + c * y2)^2 = b^2 * (x1^2 + x2^2) + c^2 * (y1^2 + y2^2) + 2 * b * c * (x1 * y1 + x2 * y2)
    a^2 = (y1 - x1)^2 + (y2 - x2)^2 = (y1^2 + y2^2) + (x1^2 + x2^2) - 2 * (x1 * y1 + x2 * y2)
    a^2 = (y1^2 + y2^2) + (x1^2 + x2^2) - 2 * (x1 * y1 + x2 * y2) = b^2 + (x1^2 + x2^2) - 2 * (x1 * y1 + x2 * y2) = b^2 + c^2 - 2 * (x1 * y1 + x2 * y2)
    a^2 + 2 * (x1 * y1 + x2 * y2) = (b^2 + c^2 - 2 * (x1 * y1 + x2 * y2)) + 2 * (x1 * y1 + x2 * y2)
    (b^2 + c^2 - 2 * (x1 * y1 + x2 * y2)) + 2 * (x1 * y1 + x2 * y2) = b^2 + c^2
    a^2 + 2 * (x1 * y1 + x2 * y2) = b^2 + c^2
    2 * (x1 * y1 + x2 * y2) = b^2 + c^2 - a^2
    b^2 * (x1^2 + x2^2) + c^2 * (y1^2 + y2^2) + 2 * b * c * (x1 * y1 + x2 * y2) = b^2 * c^2 + c^2 * (y1^2 + y2^2) + 2 * b * c * (x1 * y1 + x2 * y2)
    b^2 * c^2 + c^2 * (y1^2 + y2^2) + 2 * b * c * (x1 * y1 + x2 * y2) = b^2 * c^2 + c^2 * b^2 + 2 * b * c * (x1 * y1 + x2 * y2)
    2 * b * c * (x1 * y1 + x2 * y2) = b * c * (2 * (x1 * y1 + x2 * y2))
    b * c * (2 * (x1 * y1 + x2 * y2)) = b * c * (b^2 + c^2 - a^2)
    b^2 * c^2 + c^2 * b^2 + 2 * b * c * (x1 * y1 + x2 * y2) = b^2 * c^2 + c^2 * b^2 + b * c * (b^2 + c^2 - a^2)
    b^2 * c^2 + c^2 * b^2 + b * c * (b^2 + c^2 - a^2) = b * c * (b^2 + 2 * b * c + c^2 - a^2)
    b * c * (b^2 + 2 * b * c + c^2 - a^2) = b * c * ((b + c)^2 - a^2)
    (b + c)^2 - a^2 = (b + c - a) * (b + c + a)
    b * c * ((b + c)^2 - a^2) = b * c * ((b + c - a) * (b + c + a))
    b + c + a = a + b + c
    a + b + c = S
    b + c + a = S
    (b + c - a) * (b + c + a) = (b + c - a) * S
    b * c * ((b + c - a) * (b + c + a)) = b * c * ((b + c - a) * S)
    b * c * ((b + c - a) * S) = b * c * (b + c - a) * S
    q1 * V1 + q2 * V2 = q1 * (b * x1 + c * y1) + q2 * (b * x2 + c * y2)
    q1 * (b * x1 + c * y1) + q2 * (b * x2 + c * y2) = b * (q1 * x1 + q2 * x2) + c * (q1 * y1 + q2 * y2)
    2 * (q1 * V1 + q2 * V2) = 2 * (b * (q1 * x1 + q2 * x2) + c * (q1 * y1 + q2 * y2))
    2 * (b * (q1 * x1 + q2 * x2) + c * (q1 * y1 + q2 * y2)) = b * (2 * (q1 * x1 + q2 * x2)) + c * (2 * (q1 * y1 + q2 * y2))
    2 * (q1 * x1 + q2 * x2) = x1^2 + x2^2
    2 * (q1 * y1 + q2 * y2) = y1^2 + y2^2
    b * (2 * (q1 * x1 + q2 * x2)) = b * (x1^2 + x2^2)
    c * (2 * (q1 * y1 + q2 * y2)) = c * (y1^2 + y2^2)
    b * (2 * (q1 * x1 + q2 * x2)) + c * (2 * (q1 * y1 + q2 * y2)) = b * (x1^2 + x2^2) + c * (y1^2 + y2^2)
    b * (x1^2 + x2^2) = b * c^2
    c * (y1^2 + y2^2) = c * b^2
    b * (x1^2 + x2^2) + c * (y1^2 + y2^2) = b * c^2 + c * b^2
    b * c^2 + c * b^2 = b * c * (b + c)
    2 * (q1 * V1 + q2 * V2) = b * c * (b + c)
    S^2 * z1^2 = (S * z1)^2
    (S * z1)^2 = (t * V1)^2
    (t * V1)^2 = t^2 * V1^2
    S^2 * z1^2 = t^2 * V1^2
    S^2 * z2^2 = (S * z2)^2
    (S * z2)^2 = (t * V2)^2
    (t * V2)^2 = t^2 * V2^2
    S^2 * z2^2 = t^2 * V2^2
    S^2 * z1^2 + S^2 * z2^2 = t^2 * V1^2 + t^2 * V2^2
    S^2 * (z1^2 + z2^2) = S^2 * z1^2 + S^2 * z2^2
    t^2 * V1^2 + t^2 * V2^2 = t^2 * (V1^2 + V2^2)
    S^2 * (z1^2 + z2^2) = t^2 * (V1^2 + V2^2)
    S^2 * (z1^2 + z2^2) = S^2 * (2 * (q1 * z1 + q2 * z2))
    S^2 * (2 * (q1 * z1 + q2 * z2)) = 2 * S * (q1 * (S * z1) + q2 * (S * z2))
    q1 * (S * z1) + q2 * (S * z2) = q1 * (t * V1) + q2 * (t * V2)
    q1 * (t * V1) + q2 * (t * V2) = t * (q1 * V1 + q2 * V2)
    2 * S * (q1 * (S * z1) + q2 * (S * z2)) = 2 * S * (q1 * (t * V1) + q2 * (t * V2))
    2 * S * (q1 * (t * V1) + q2 * (t * V2)) = 2 * S * (t * (q1 * V1 + q2 * V2))
    2 * S * (t * (q1 * V1 + q2 * V2)) = 2 * t * S * (q1 * V1 + q2 * V2)
    S^2 * (z1^2 + z2^2) = 2 * t * S * (q1 * V1 + q2 * V2)
    t^2 * (V1^2 + V2^2) = S^2 * (z1^2 + z2^2)
    S^2 * (z1^2 + z2^2) = 2 * t * S * (q1 * V1 + q2 * V2)
    t^2 * (V1^2 + V2^2) = 2 * t * S * (q1 * V1 + q2 * V2)
    t^2 * (V1^2 + V2^2) = t^2 * (b * c * (b + c - a) * S)
    2 * t * S * (q1 * V1 + q2 * V2) = t * S * (2 * (q1 * V1 + q2 * V2))
    t * S * (2 * (q1 * V1 + q2 * V2)) = t * S * (b * c * (b + c))
    2 * t * S * (q1 * V1 + q2 * V2) = t * S * (b * c * (b + c))
    t^2 * (b * c * (b + c - a) * S) = t * t * b * c * (b + c - a) * S
    t * t * b * c * (b + c - a) * S = (t * (b + c - a)) * (t * S * b * c)
    t * S * (b * c * (b + c)) = (b + c) * (t * S * b * c)
    (t * (b + c - a)) * (t * S * b * c) = (b + c) * (t * S * b * c)
    t * S * b * c > 0
    release thm geo::cancel_positive_right_factor(t * (b + c - a), b + c, t * S * b * c)
