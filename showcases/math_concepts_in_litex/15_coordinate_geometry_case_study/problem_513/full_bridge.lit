# Private coordinate-to-distance recovery kernel for Problem 513.

thm problem_513_distance_recovery_kernel:
    ? forall a, b, c, t, S, x1, x2, u1, u2, z1, z2, V1, V2 R:
        S > 0,
        S = a + b + c,
        t * (b + c - a) = b + c,
        x1^2 + x2^2 = c^2,
        V1^2 + V2^2 = b * c * (b + c - a) * S,
        2 * (V1 * x1 + V2 * x2) = c * (b + c - a) * S,
        S * u1 = V1,
        S * u2 = V2,
        S * z1 = t * V1,
        S * z2 = t * V2
        =>:
            (z1 - x1)^2 + (z2 - x2)^2 = (z1 - u1)^2 + (z2 - u2)^2

    S * (z1 - x1) = S * z1 - S * x1 = t * V1 - S * x1
    S * (z2 - x2) = S * z2 - S * x2 = t * V2 - S * x2
    S * (z1 - u1) = S * z1 - S * u1 = t * V1 - V1 = (t - 1) * V1
    S * (z2 - u2) = S * z2 - S * u2 = t * V2 - V2 = (t - 1) * V2

    S^2 * ((z1 - x1)^2 + (z2 - x2)^2) = (S * (z1 - x1))^2 + (S * (z2 - x2))^2
    (S * (z1 - x1))^2 + (S * (z2 - x2))^2 = (t * V1 - S * x1)^2 + (t * V2 - S * x2)^2
    (t * V1 - S * x1)^2 + (t * V2 - S * x2)^2 = t^2 * (V1^2 + V2^2) - t * S * (2 * (V1 * x1 + V2 * x2)) + S^2 * (x1^2 + x2^2)
    t^2 * (V1^2 + V2^2) - t * S * (2 * (V1 * x1 + V2 * x2)) + S^2 * (x1^2 + x2^2) = t^2 * (b * c * (b + c - a) * S) - t * S * (c * (b + c - a) * S) + S^2 * c^2
    S^2 * ((z1 - x1)^2 + (z2 - x2)^2) = t^2 * (b * c * (b + c - a) * S) - t * S * (c * (b + c - a) * S) + S^2 * c^2

    S^2 * ((z1 - u1)^2 + (z2 - u2)^2) = (S * (z1 - u1))^2 + (S * (z2 - u2))^2
    (S * (z1 - u1))^2 + (S * (z2 - u2))^2 = ((t - 1) * V1)^2 + ((t - 1) * V2)^2
    ((t - 1) * V1)^2 + ((t - 1) * V2)^2 = (t - 1)^2 * (V1^2 + V2^2)
    (t - 1)^2 * (V1^2 + V2^2) = (t - 1)^2 * (b * c * (b + c - a) * S)
    S^2 * ((z1 - u1)^2 + (z2 - u2)^2) = (t - 1)^2 * (b * c * (b + c - a) * S)

    (t^2 * (b * c * (b + c - a) * (a + b + c)) - t * (a + b + c) * (c * (b + c - a) * (a + b + c)) + (a + b + c)^2 * c^2) - (t - 1)^2 * (b * c * (b + c - a) * (a + b + c)) = c * (a - b + c) * (a + b + c) * (b + c - t * (b + c - a))
    b + c - t * (b + c - a) = 0
    c * (a - b + c) * (a + b + c) * (b + c - t * (b + c - a)) = c * (a - b + c) * (a + b + c) * 0 = 0
    by thm pure_kernel::problem_513_pure_polynomial_kernel(a, b, c, t)
    t^2 * (b * c * (b + c - a) * (a + b + c)) - t * (a + b + c) * (c * (b + c - a) * (a + b + c)) + (a + b + c)^2 * c^2 = (t - 1)^2 * (b * c * (b + c - a) * (a + b + c))
    t^2 * (b * c * (b + c - a) * S) = t^2 * (b * c * (b + c - a) * (a + b + c))
    t * S * (c * (b + c - a) * S) = t * (a + b + c) * (c * (b + c - a) * (a + b + c))
    S^2 * c^2 = (a + b + c)^2 * c^2
    (t - 1)^2 * (b * c * (b + c - a) * S) = (t - 1)^2 * (b * c * (b + c - a) * (a + b + c))
    t^2 * (b * c * (b + c - a) * S) - t * S * (c * (b + c - a) * S) + S^2 * c^2 = t^2 * (b * c * (b + c - a) * (a + b + c)) - t * (a + b + c) * (c * (b + c - a) * (a + b + c)) + (a + b + c)^2 * c^2 = (t - 1)^2 * (b * c * (b + c - a) * (a + b + c)) = (t - 1)^2 * (b * c * (b + c - a) * S)

    S^2 * ((z1 - x1)^2 + (z2 - x2)^2) = S^2 * ((z1 - u1)^2 + (z2 - u2)^2)
    ((z1 - x1)^2 + (z2 - x2)^2) * S^2 = S^2 * ((z1 - x1)^2 + (z2 - x2)^2)
    S^2 * ((z1 - u1)^2 + (z2 - u2)^2) = ((z1 - u1)^2 + (z2 - u2)^2) * S^2
    ((z1 - x1)^2 + (z2 - x2)^2) * S^2 = S^2 * ((z1 - x1)^2 + (z2 - x2)^2) = S^2 * ((z1 - u1)^2 + (z2 - u2)^2) = ((z1 - u1)^2 + (z2 - u2)^2) * S^2
    S^2 > 0
    by thm geo::cancel_positive_right_factor((z1 - x1)^2 + (z2 - x2)^2, (z1 - u1)^2 + (z2 - u2)^2, S^2)
