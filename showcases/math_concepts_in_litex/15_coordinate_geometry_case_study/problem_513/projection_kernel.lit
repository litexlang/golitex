# Private weighted-vector projection kernel for Problem 513.

thm problem_513_vector_projection_kernel:
    ? forall a, b, c, S, x1, x2, y1, y2, V1, V2 R:
        S = a + b + c,
        c^2 = x1^2 + x2^2,
        b^2 = y1^2 + y2^2,
        a^2 = (y1 - x1)^2 + (y2 - x2)^2,
        V1 = b * x1 + c * y1,
        V2 = b * x2 + c * y2
        =>:
            2 * (V1 * x1 + V2 * x2) = c * (b + c - a) * S
    a^2 = (y1 - x1)^2 + (y2 - x2)^2 = (y1^2 + y2^2) + (x1^2 + x2^2) - 2 * (x1 * y1 + x2 * y2)
    a^2 = (y1^2 + y2^2) + (x1^2 + x2^2) - 2 * (x1 * y1 + x2 * y2) = b^2 + (x1^2 + x2^2) - 2 * (x1 * y1 + x2 * y2) = b^2 + c^2 - 2 * (x1 * y1 + x2 * y2)
    a^2 + 2 * (x1 * y1 + x2 * y2) = (b^2 + c^2 - 2 * (x1 * y1 + x2 * y2)) + 2 * (x1 * y1 + x2 * y2)
    (b^2 + c^2 - 2 * (x1 * y1 + x2 * y2)) + 2 * (x1 * y1 + x2 * y2) = b^2 + c^2
    a^2 + 2 * (x1 * y1 + x2 * y2) = b^2 + c^2
    2 * (x1 * y1 + x2 * y2) = b^2 + c^2 - a^2

    V1 * x1 + V2 * x2 = (b * x1 + c * y1) * x1 + (b * x2 + c * y2) * x2
    (b * x1 + c * y1) * x1 + (b * x2 + c * y2) * x2 = b * (x1^2 + x2^2) + c * (x1 * y1 + x2 * y2)
    2 * (V1 * x1 + V2 * x2) = 2 * (b * (x1^2 + x2^2) + c * (x1 * y1 + x2 * y2))
    2 * (b * (x1^2 + x2^2) + c * (x1 * y1 + x2 * y2)) = 2 * b * (x1^2 + x2^2) + c * (2 * (x1 * y1 + x2 * y2))
    2 * b * (x1^2 + x2^2) = 2 * b * c^2
    c * (2 * (x1 * y1 + x2 * y2)) = c * (b^2 + c^2 - a^2)
    2 * b * (x1^2 + x2^2) + c * (2 * (x1 * y1 + x2 * y2)) = 2 * b * c^2 + c * (b^2 + c^2 - a^2)
    2 * b * c^2 + c * (b^2 + c^2 - a^2) = c * (b^2 + 2 * b * c + c^2 - a^2)
    c * (b^2 + 2 * b * c + c^2 - a^2) = c * ((b + c)^2 - a^2)
    (b + c)^2 - a^2 = (b + c - a) * (b + c + a)
    c * ((b + c)^2 - a^2) = c * ((b + c - a) * (b + c + a))
    b + c + a = a + b + c
    a + b + c = S
    b + c + a = S
    (b + c - a) * (b + c + a) = (b + c - a) * S
    c * ((b + c - a) * (b + c + a)) = c * ((b + c - a) * S)
    c * ((b + c - a) * S) = c * (b + c - a) * S
