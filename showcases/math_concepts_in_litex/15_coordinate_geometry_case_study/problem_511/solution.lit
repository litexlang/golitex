# Problem 511 / zhongkao_313
#
# 原题：如图1所示，在四边形ABCD中，AD∥BC，点E在边AB上，且
#       AE=1/3 AB，点F在边CD上，且DF=1/3 CD，联结EF，求证：EF∥BC。
#
# 逐句 NL → Litex：
# - “在四边形ABCD中，AD∥BC” ↔ $geo::is_trapezoid(a,b,c,d)。
# - “点E在边AB上，且AE=1/3 AB” ↔ $geo::is_affine_combination(ep,a,b,1/3)。
# - “点F在边CD上，且DF=1/3 CD” ↔ $geo::is_affine_combination(f,d,c,1/3)。
# - “求证EF∥BC” ↔ $geo::is_parallel(ep,f,b,c)。

# A small scalar normalization lemma keeps affine-coordinate rewriting
# separate from the geometric theorem.
thm one_third_affine_difference:
    ? forall aa, bb, cc, dd, zz R:
        zz = ((1 - 1 / 3) * dd + (1 / 3) * cc) - ((1 - 1 / 3) * aa + (1 / 3) * bb)
        =>:
            zz = (2 / 3) * (dd - aa) + (1 / 3) * (cc - bb)
    zz = ((1 - 1 / 3) * dd + (1 / 3) * cc) - ((1 - 1 / 3) * aa + (1 / 3) * bb)
    zz = (2 / 3) * (dd - aa) + (1 / 3) * (cc - bb)

thm problem_511:
    ? forall a, b, c, d, ep, f cart(R, R):
        $geo::is_trapezoid(a, b, c, d)
        $geo::is_affine_combination(ep, a, b, 1 / 3)
        $geo::is_affine_combination(f, d, c, 1 / 3)
        =>:
            $geo::is_parallel(ep, f, b, c)
    # Expand exactly the three public geometric assumptions.
    by def $geo::is_trapezoid(a, b, c, d)
    by def $geo::is_parallel(a, d, b, c)
    by def $geo::is_affine_combination(ep, a, b, 1 / 3)
    by def $geo::is_affine_combination(f, d, c, 1 / 3)

    # The two trisection points have the expected affine coordinates.
    ep[1] = (2 / 3) * a[1] + (1 / 3) * b[1]
    ep[2] = (2 / 3) * a[2] + (1 / 3) * b[2]
    f[1] = (2 / 3) * d[1] + (1 / 3) * c[1]
    f[2] = (2 / 3) * d[2] + (1 / 3) * c[2]
    f[1] - ep[1] = ((1 - 1 / 3) * d[1] + (1 / 3) * c[1]) - ((1 - 1 / 3) * a[1] + (1 / 3) * b[1])
    by thm one_third_affine_difference(a[1], b[1], c[1], d[1], f[1] - ep[1])
    f[1] - ep[1] = (2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])
    f[2] - ep[2] = ((1 - 1 / 3) * d[2] + (1 / 3) * c[2]) - ((1 - 1 / 3) * a[2] + (1 / 3) * b[2])
    by thm one_third_affine_difference(a[2], b[2], c[2], d[2], f[2] - ep[2])
    f[2] - ep[2] = (2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])

    # EF is a positive affine combination of the codirected parallel sides.
    geo::det(geo::vec(a, d), geo::vec(b, c)) = 0
    geo::vec(ep, f) = (f[1] - ep[1], f[2] - ep[2])
    geo::vec(a, d) = (d[1] - a[1], d[2] - a[2])
    geo::vec(b, c) = (c[1] - b[1], c[2] - b[2])
    geo::det(geo::vec(ep, f), geo::vec(b, c)) = (f[1] - ep[1]) * (c[2] - b[2]) - (f[2] - ep[2]) * (c[1] - b[1])
    geo::det(geo::vec(ep, f), geo::vec(b, c)) = ((2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])) * (c[2] - b[2]) - ((2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])) * (c[1] - b[1])
    ((2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])) * (c[2] - b[2]) - ((2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])) * (c[1] - b[1]) = (2 / 3) * ((d[1] - a[1]) * (c[2] - b[2]) - (d[2] - a[2]) * (c[1] - b[1]))
    by thm geo::det_coordinate_formula(geo::vec(a, d), geo::vec(b, c))
    geo::det(geo::vec(a, d), geo::vec(b, c)) = (d[1] - a[1]) * (c[2] - b[2]) - (d[2] - a[2]) * (c[1] - b[1])
    geo::det(geo::vec(ep, f), geo::vec(b, c)) = ((2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])) * (c[2] - b[2]) - ((2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])) * (c[1] - b[1]) = (2 / 3) * ((d[1] - a[1]) * (c[2] - b[2]) - (d[2] - a[2]) * (c[1] - b[1])) = (2 / 3) * geo::det(geo::vec(a, d), geo::vec(b, c))
    geo::det(geo::vec(ep, f), geo::vec(b, c)) = 0

    # Positivity proves that EF is not the zero segment.
    b != c
    by thm geo::distance_sq_positive_of_ne(b, c)
    by thm geo::vec_dot_self_is_distance(b, c)
    geo::dot(geo::vec(b, c), geo::vec(b, c)) > 0
    by thm geo::dot_coordinate_formula(geo::vec(ep, f), geo::vec(b, c))
    geo::dot(geo::vec(ep, f), geo::vec(b, c)) = (f[1] - ep[1]) * (c[1] - b[1]) + (f[2] - ep[2]) * (c[2] - b[2])
    geo::dot(geo::vec(ep, f), geo::vec(b, c)) = ((2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])) * (c[1] - b[1]) + ((2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])) * (c[2] - b[2])
    ((2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])) * (c[1] - b[1]) + ((2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])) * (c[2] - b[2]) = (2 / 3) * ((d[1] - a[1]) * (c[1] - b[1]) + (d[2] - a[2]) * (c[2] - b[2])) + (1 / 3) * ((c[1] - b[1]) * (c[1] - b[1]) + (c[2] - b[2]) * (c[2] - b[2]))
    by thm geo::dot_coordinate_formula(geo::vec(a, d), geo::vec(b, c))
    geo::dot(geo::vec(a, d), geo::vec(b, c)) = (d[1] - a[1]) * (c[1] - b[1]) + (d[2] - a[2]) * (c[2] - b[2])
    by thm geo::dot_coordinate_formula(geo::vec(b, c), geo::vec(b, c))
    geo::dot(geo::vec(b, c), geo::vec(b, c)) = (c[1] - b[1]) * (c[1] - b[1]) + (c[2] - b[2]) * (c[2] - b[2])
    geo::dot(geo::vec(ep, f), geo::vec(b, c)) = ((2 / 3) * (d[1] - a[1]) + (1 / 3) * (c[1] - b[1])) * (c[1] - b[1]) + ((2 / 3) * (d[2] - a[2]) + (1 / 3) * (c[2] - b[2])) * (c[2] - b[2]) = (2 / 3) * ((d[1] - a[1]) * (c[1] - b[1]) + (d[2] - a[2]) * (c[2] - b[2])) + (1 / 3) * ((c[1] - b[1]) * (c[1] - b[1]) + (c[2] - b[2]) * (c[2] - b[2])) = (2 / 3) * geo::dot(geo::vec(a, d), geo::vec(b, c)) + (1 / 3) * geo::dot(geo::vec(b, c), geo::vec(b, c))
    2 / 3 > 0
    1 / 3 > 0
    (2 / 3) * geo::dot(geo::vec(a, d), geo::vec(b, c)) > 0
    (1 / 3) * geo::dot(geo::vec(b, c), geo::vec(b, c)) > 0
    (2 / 3) * geo::dot(geo::vec(a, d), geo::vec(b, c)) + (1 / 3) * geo::dot(geo::vec(b, c), geo::vec(b, c)) > 0
    geo::dot(geo::vec(ep, f), geo::vec(b, c)) = (2 / 3) * geo::dot(geo::vec(a, d), geo::vec(b, c)) + (1 / 3) * geo::dot(geo::vec(b, c), geo::vec(b, c)) > 0
    by contra:
        ? ep != f
        ep = f
        f[1] = ep[1]
        f[2] = ep[2]
        f[1] - ep[1] = 0
        f[2] - ep[2] = 0
        geo::dot(geo::vec(ep, f), geo::vec(b, c)) = (f[1] - ep[1]) * (c[1] - b[1]) + (f[2] - ep[2]) * (c[2] - b[2]) = 0
        impossible geo::dot(geo::vec(ep, f), geo::vec(b, c)) > 0
    ep != f
    by def $geo::is_parallel(ep, f, b, c)
