# Problem 512 / zhongkao_314
#
# 原题：如图，⊙O是△ABC的外接圆，AB为直径，点D是△ABC的内心，
#       连接AD并延长交⊙O于点E，过点E作⊙O的切线交AB的延长线于点F。
#       (1)求证：BC∥EF。
#
# 逐句 NL → Litex：
# - “△ABC是三角形” ↔ $geo::is_triangle(a,b,c)。
# - “⊙O是△ABC的外接圆”中的“A在⊙O上” ↔ $geo::is_on_circle(a,o,r)。
# - “⊙O是△ABC的外接圆”中的“B在⊙O上” ↔ $geo::is_on_circle(b,o,r)。
# - “⊙O是△ABC的外接圆”中的“C在⊙O上” ↔ $geo::is_on_circle(c,o,r)。
# - “AB为直径” ↔ $geo::is_diameter_endpoints(a,b,o)。
# - “点D是△ABC的内心” ↔ $geo::is_incenter(d,a,b,c)。
# - “连接AD并延长交⊙O于点E”中的“E在AD延长线上” ↔ $geo::is_on_extension(e,a,d)。
# - “连接AD并延长交⊙O于点E”中的“E在⊙O上” ↔ $geo::is_on_circle(e,o,r)。
# - “过点E作⊙O的切线EF” ↔ $geo::is_tangent_at(e,f,o,r)。
# - “切线交AB的延长线于点F” ↔ $geo::is_on_extension(f,a,b)。
# - “求证BC∥EF” ↔ $geo::is_parallel(b,c,e,f)。

# Once the coordinate reduction has produced the two factorizations below,
# this scalar lemma removes the nonzero geometric factors.
thm problem_512_factor_finish:
    ? forall q, h, z, target R:
        q > 0
        h > 0
        z > 0
        q * h * z * (2 * h + z) * (q * z - 1) = 0
        2 * target = (z - 2 * h) * (z + 2 * h) * (q * z - 1)
        =>:
            target = 0
    q != 0
    h != 0
    z != 0
    2 * h + z > 0
    2 * h + z != 0
    q * (h * z * (2 * h + z) * (q * z - 1)) = 0
    release thm geo::zero_factor_law(q, h * z * (2 * h + z) * (q * z - 1))
    h * z * (2 * h + z) * (q * z - 1) = 0
    h * (z * (2 * h + z) * (q * z - 1)) = 0
    release thm geo::zero_factor_law(h, z * (2 * h + z) * (q * z - 1))
    z * (2 * h + z) * (q * z - 1) = 0
    release thm geo::zero_factor_law(z, (2 * h + z) * (q * z - 1))
    (2 * h + z) * (q * z - 1) = 0
    release thm geo::zero_factor_law(2 * h + z, q * z - 1)
    q * z - 1 = 0
    (z - 2 * h) * (z + 2 * h) * (q * z - 1) = 0
    2 * target = 0
    target = 0

# Convert the circle and side-length equations into the scalar factorization
# consumed by problem_512_factor_finish.  All coordinates used here are
# differences from O, so this lemma makes no geometric assumptions.
thm problem_512_coordinate_bridge:
    ? forall ux, uy, vx, vy, ex, ey, q, h, z R:
        q > 0
        h > 0
        z > 0
        ux^2 + uy^2 = h^2
        vx^2 + vy^2 = h^2
        z^2 = (ux + vx)^2 + (uy + vy)^2
        ex = q * (z + h) * ux + q * h * vx - ux
        ey = q * (z + h) * uy + q * h * vy - uy
        ex^2 + ey^2 = h^2
        =>:
            ex * (vx - ux) + ey * (vy - uy) = 0

    have alpha R = q * (z + h) - 1
    have beta R = q * h

    ex = (q * (z + h) - 1) * ux + q * h * vx = alpha * ux + beta * vx
    ey = (q * (z + h) - 1) * uy + q * h * vy = alpha * uy + beta * vy

    z^2 = (ux^2 + uy^2) + (vx^2 + vy^2) + 2 * (ux * vx + uy * vy)
    release thm geo::add_equalities(ux^2 + uy^2, h^2, vx^2 + vy^2, h^2)
    release thm geo::add_equalities((ux^2 + uy^2) + (vx^2 + vy^2), h^2 + h^2, 2 * (ux * vx + uy * vy), 2 * (ux * vx + uy * vy))
    z^2 = h^2 + h^2 + 2 * (ux * vx + uy * vy)
    2 * (ux * vx + uy * vy) = z^2 - 2 * h^2

    release thm geo::multiply_both_sides(ex, alpha * ux + beta * vx, ex)
    release thm geo::multiply_both_sides(ex, alpha * ux + beta * vx, alpha * ux + beta * vx)
    ex^2 = (alpha * ux + beta * vx)^2

    release thm geo::multiply_both_sides(ey, alpha * uy + beta * vy, ey)
    release thm geo::multiply_both_sides(ey, alpha * uy + beta * vy, alpha * uy + beta * vy)
    ey^2 = (alpha * uy + beta * vy)^2

    release thm geo::add_equalities(ex^2, (alpha * ux + beta * vx)^2, ey^2, (alpha * uy + beta * vy)^2)
    (alpha * ux + beta * vx)^2 + (alpha * uy + beta * vy)^2 = alpha^2 * (ux^2 + uy^2) + beta^2 * (vx^2 + vy^2) + alpha * beta * (2 * (ux * vx + uy * vy))
    ex^2 + ey^2 = alpha^2 * (ux^2 + uy^2) + beta^2 * (vx^2 + vy^2) + alpha * beta * (2 * (ux * vx + uy * vy))
    release thm geo::subtract_equalities(ex^2 + ey^2, alpha^2 * (ux^2 + uy^2) + beta^2 * (vx^2 + vy^2) + alpha * beta * (2 * (ux * vx + uy * vy)), h^2, h^2)
    alpha^2 * (ux^2 + uy^2) + beta^2 * (vx^2 + vy^2) + alpha * beta * (2 * (ux * vx + uy * vy)) - h^2 = alpha^2 * h^2 + beta^2 * h^2 + alpha * beta * (z^2 - 2 * h^2) - h^2
    release thm geo::multiply_both_sides(alpha, q * (z + h) - 1, alpha)
    release thm geo::multiply_both_sides(alpha, q * (z + h) - 1, q * (z + h) - 1)
    alpha^2 = (q * (z + h) - 1)^2
    release thm geo::multiply_both_sides(alpha^2, (q * (z + h) - 1)^2, h^2)

    release thm geo::multiply_both_sides(beta, q * h, beta)
    release thm geo::multiply_both_sides(beta, q * h, q * h)
    beta^2 = (q * h)^2
    release thm geo::multiply_both_sides(beta^2, (q * h)^2, h^2)

    release thm geo::multiply_both_sides(alpha, q * (z + h) - 1, beta)
    release thm geo::multiply_both_sides(beta, q * h, q * (z + h) - 1)
    alpha * beta = (q * (z + h) - 1) * (q * h)
    release thm geo::multiply_both_sides(alpha * beta, (q * (z + h) - 1) * (q * h), z^2 - 2 * h^2)

    release thm geo::add_equalities(alpha^2 * h^2, (q * (z + h) - 1)^2 * h^2, beta^2 * h^2, (q * h)^2 * h^2)
    release thm geo::add_equalities(alpha^2 * h^2 + beta^2 * h^2, (q * (z + h) - 1)^2 * h^2 + (q * h)^2 * h^2, alpha * beta * (z^2 - 2 * h^2), (q * (z + h) - 1) * (q * h) * (z^2 - 2 * h^2))
    release thm geo::subtract_equalities(alpha^2 * h^2 + beta^2 * h^2 + alpha * beta * (z^2 - 2 * h^2), (q * (z + h) - 1)^2 * h^2 + (q * h)^2 * h^2 + (q * (z + h) - 1) * (q * h) * (z^2 - 2 * h^2), h^2, h^2)
    (q * (z + h) - 1)^2 * h^2 + (q * h)^2 * h^2 + (q * (z + h) - 1) * (q * h) * (z^2 - 2 * h^2) - h^2 = q * h * z * (2 * h + z) * (q * z - 1)
    ex^2 + ey^2 - h^2 = q * h * z * (2 * h + z) * (q * z - 1)
    ex^2 + ey^2 - h^2 = 0
    q * h * z * (2 * h + z) * (q * z - 1) = 0

    have du R = ux * (vx - ux) + uy * (vy - uy)
    have dv R = vx * (vx - ux) + vy * (vy - uy)

    release thm geo::multiply_both_sides(ux^2 + uy^2, h^2, 2)
    release thm geo::subtract_equalities(2 * (ux * vx + uy * vy), z^2 - 2 * h^2, 2 * (ux^2 + uy^2), 2 * h^2)
    release thm geo::multiply_both_sides(du, ux * (vx - ux) + uy * (vy - uy), 2)
    2 * du = 2 * (ux * (vx - ux) + uy * (vy - uy))
    2 * (ux * (vx - ux) + uy * (vy - uy)) = 2 * (ux * vx + uy * vy) - 2 * (ux^2 + uy^2)
    2 * (ux * vx + uy * vy) - 2 * (ux^2 + uy^2) = (z^2 - 2 * h^2) - 2 * h^2
    (z^2 - 2 * h^2) - 2 * h^2 = z^2 - 4 * h^2
    2 * du = z^2 - 4 * h^2

    release thm geo::multiply_both_sides(vx^2 + vy^2, h^2, 2)
    release thm geo::subtract_equalities(2 * (vx^2 + vy^2), 2 * h^2, 2 * (ux * vx + uy * vy), z^2 - 2 * h^2)
    release thm geo::multiply_both_sides(dv, vx * (vx - ux) + vy * (vy - uy), 2)
    2 * dv = 2 * (vx * (vx - ux) + vy * (vy - uy))
    2 * (vx * (vx - ux) + vy * (vy - uy)) = 2 * (vx^2 + vy^2) - 2 * (ux * vx + uy * vy)
    2 * (vx^2 + vy^2) - 2 * (ux * vx + uy * vy) = 2 * h^2 - (z^2 - 2 * h^2)
    2 * h^2 - (z^2 - 2 * h^2) = 4 * h^2 - z^2
    2 * dv = 4 * h^2 - z^2

    release thm geo::multiply_both_sides(ex, alpha * ux + beta * vx, vx - ux)
    release thm geo::multiply_both_sides(ey, alpha * uy + beta * vy, vy - uy)
    release thm geo::add_equalities(ex * (vx - ux), (alpha * ux + beta * vx) * (vx - ux), ey * (vy - uy), (alpha * uy + beta * vy) * (vy - uy))
    ex * (vx - ux) + ey * (vy - uy) = (alpha * ux + beta * vx) * (vx - ux) + (alpha * uy + beta * vy) * (vy - uy)
    (alpha * ux + beta * vx) * (vx - ux) + (alpha * uy + beta * vy) * (vy - uy) = alpha * (ux * (vx - ux) + uy * (vy - uy)) + beta * (vx * (vx - ux) + vy * (vy - uy))
    release thm geo::multiply_both_sides(du, ux * (vx - ux) + uy * (vy - uy), alpha)
    release thm geo::multiply_both_sides(dv, vx * (vx - ux) + vy * (vy - uy), beta)
    release thm geo::add_equalities(alpha * (ux * (vx - ux) + uy * (vy - uy)), alpha * du, beta * (vx * (vx - ux) + vy * (vy - uy)), beta * dv)
    alpha * (ux * (vx - ux) + uy * (vy - uy)) + beta * (vx * (vx - ux) + vy * (vy - uy)) = alpha * du + beta * dv
    ex * (vx - ux) + ey * (vy - uy) = alpha * du + beta * dv
    release thm geo::multiply_both_sides(ex * (vx - ux) + ey * (vy - uy), alpha * du + beta * dv, 2)
    2 * (ex * (vx - ux) + ey * (vy - uy)) = 2 * (alpha * du + beta * dv)

    release thm geo::multiply_both_sides(2 * du, z^2 - 4 * h^2, alpha)
    release thm geo::multiply_both_sides(2 * dv, 4 * h^2 - z^2, beta)
    release thm geo::add_equalities(alpha * (2 * du), alpha * (z^2 - 4 * h^2), beta * (2 * dv), beta * (4 * h^2 - z^2))
    2 * (alpha * du + beta * dv) = alpha * (2 * du) + beta * (2 * dv)
    alpha * (2 * du) + beta * (2 * dv) = alpha * (z^2 - 4 * h^2) + beta * (4 * h^2 - z^2)
    2 * (ex * (vx - ux) + ey * (vy - uy)) = alpha * (z^2 - 4 * h^2) + beta * (4 * h^2 - z^2)

    release thm geo::multiply_both_sides(alpha, q * (z + h) - 1, z^2 - 4 * h^2)
    release thm geo::multiply_both_sides(beta, q * h, 4 * h^2 - z^2)
    release thm geo::add_equalities(alpha * (z^2 - 4 * h^2), (q * (z + h) - 1) * (z^2 - 4 * h^2), beta * (4 * h^2 - z^2), (q * h) * (4 * h^2 - z^2))
    (q * (z + h) - 1) * (z^2 - 4 * h^2) + (q * h) * (4 * h^2 - z^2) = (z - 2 * h) * (z + 2 * h) * (q * z - 1)
    2 * (ex * (vx - ux) + ey * (vy - uy)) = (z - 2 * h) * (z + 2 * h) * (q * z - 1)
    release thm problem_512_factor_finish(q, h, z, ex * (vx - ux) + ey * (vy - uy))

# Two direction vectors perpendicular to the same nonzero vector are parallel.
thm problem_512_common_normal_core:
    ? forall nx, ny, x1, x2, y1, y2 R:
        nx^2 + ny^2 > 0
        nx * x1 + ny * x2 = 0
        nx * y1 + ny * y2 = 0
        =>:
            x1 * y2 - x2 * y1 = 0

    (nx^2 + ny^2) * (x1 * y2 - x2 * y1) = (nx * x1 + ny * x2) * (nx * y2 - ny * y1) - (nx * y1 + ny * y2) * (nx * x2 - ny * x1) = 0
    nx^2 + ny^2 != 0
    release thm geo::zero_factor_law(nx^2 + ny^2, x1 * y2 - x2 * y1)

# Public theorem matching every clause of the original problem.
thm problem_512:
    ? forall a, b, c, d, ep, f, o cart(R, R), r R+:
        # 【NL条件1】△ABC是三角形。
        $geo::is_triangle(a, b, c)
        # 【NL条件2】⊙O是△ABC的外接圆：A在⊙O上。
        $geo::is_on_circle(a, o, r)
        # 【NL条件3】⊙O是△ABC的外接圆：B在⊙O上。
        $geo::is_on_circle(b, o, r)
        # 【NL条件4】⊙O是△ABC的外接圆：C在⊙O上。
        $geo::is_on_circle(c, o, r)
        # 【NL条件5】AB为⊙O的直径。
        $geo::is_diameter_endpoints(a, b, o)
        # 【NL条件6】D是△ABC的内心。
        $geo::is_incenter(d, a, b, c)
        # 【NL条件7】AD延长后交⊙O于E：E在AD延长线上。
        $geo::is_on_extension(ep, a, d)
        # 【NL条件8】AD延长后交⊙O于E：E在⊙O上。
        $geo::is_on_circle(ep, o, r)
        # 【NL条件9】过E的直线EF是⊙O在E处的切线。
        $geo::is_tangent_at(ep, f, o, r)
        # 【NL条件10】切线EF交AB的延长线于F。
        $geo::is_on_extension(f, a, b)
        =>:
            # 【NL结论】BC∥EF。
            $geo::is_parallel(b, c, ep, f)

    # Extract exactly the public geometric certificates used below.
    by def $geo::is_triangle(a, b, c)
    by def $geo::is_on_circle(a, o, r)
    by def $geo::is_on_circle(b, o, r)
    by def $geo::is_on_circle(c, o, r)
    by def $geo::is_diameter_endpoints(a, b, o)
    by def $geo::is_midpoint(o, a, b)
    by def $geo::is_incenter(d, a, b, c)
    obtain ab, bc, ca from exist ab, bc, ca R+ st {ab^2 = geo::distance_sq(a, b), bc^2 = geo::distance_sq(b, c), ca^2 = geo::distance_sq(c, a), d[1] * (ab + bc + ca) = bc * a[1] + ca * b[1] + ab * c[1], d[2] * (ab + bc + ca) = bc * a[2] + ca * b[2] + ab * c[2]}
    by def $geo::is_on_extension(ep, a, d)
    obtain t from exist t0 R st {t0 > 1
    ep = (a[1] + t0 * (d[1] - a[1]), a[2] + t0 * (d[2] - a[2]))}
    by def $geo::is_on_circle(ep, o, r)
    by def $geo::is_tangent_at(ep, f, o, r)
    by def $geo::is_perpendicular(o, ep, ep, f)

    have S R = ab + bc + ca
    have h R = ab / 2
    have z R = ca
    have q R = 2 * t / S
    have ux R = b[1] - o[1]
    have uy R = b[2] - o[2]
    have vx R = c[1] - o[1]
    have vy R = c[2] - o[2]
    have ex R = ep[1] - o[1]
    have ey R = ep[2] - o[2]

    # Positivity of the scalar parameters.
    S = ab + bc + ca > 0
    h = ab / 2 > 0
    z = ca > 0
    t > 1
    t > 0
    2 * t > 0
    q = 2 * t / S > 0

    # The diameter midpoint puts A and B at opposite O-relative vectors.
    o[1] = (a[1] + b[1]) / 2
    o[2] = (a[2] + b[2]) / 2
    a[1] - o[1] = -(b[1] - o[1]) = -ux
    a[2] - o[2] = -(b[2] - o[2]) = -uy
    b[1] - a[1] = (b[1] - o[1]) - (a[1] - o[1]) = ux - (-ux) = 2 * ux
    b[2] - a[2] = (b[2] - o[2]) - (a[2] - o[2]) = uy - (-uy) = 2 * uy
    c[1] - a[1] = (c[1] - o[1]) - (a[1] - o[1]) = vx - (-ux) = vx + ux
    c[2] - a[2] = (c[2] - o[2]) - (a[2] - o[2]) = vy - (-uy) = vy + uy

    # All four circle radii have squared length h^2.
    release thm geo::distance_sq_coordinate_formula(a, o)
    release thm geo::distance_sq_coordinate_formula(b, o)
    release thm geo::distance_sq_coordinate_formula(c, o)
    release thm geo::distance_sq_coordinate_formula(ep, o)
    release thm geo::midpoint_half_distance(a, b, o)
    release thm geo::multiply_both_sides(h, ab / 2, h)
    release thm geo::multiply_both_sides(h, ab / 2, ab / 2)
    h^2 = (ab / 2)^2
    (ab / 2)^2 = ab^2 / 4
    geo::distance_sq(a, o) = geo::distance_sq(a, b) / 4 = ab^2 / 4 = h^2
    geo::distance_sq(a, o) = r^2
    geo::distance_sq(b, o) = r^2 = geo::distance_sq(a, o) = h^2
    geo::distance_sq(c, o) = r^2 = geo::distance_sq(a, o) = h^2
    geo::distance_sq(ep, o) = r^2 = geo::distance_sq(a, o) = h^2
    o[1] - b[1] = -(b[1] - o[1]) = -ux
    o[2] - b[2] = -(b[2] - o[2]) = -uy
    (o[1] - b[1])^2 = (-ux)^2 = ux^2
    (o[2] - b[2])^2 = (-uy)^2 = uy^2
    geo::distance_sq(b, o) = (o[1] - b[1])^2 + (o[2] - b[2])^2 = ux^2 + uy^2

    o[1] - c[1] = -(c[1] - o[1]) = -vx
    o[2] - c[2] = -(c[2] - o[2]) = -vy
    (o[1] - c[1])^2 = (-vx)^2 = vx^2
    (o[2] - c[2])^2 = (-vy)^2 = vy^2
    geo::distance_sq(c, o) = (o[1] - c[1])^2 + (o[2] - c[2])^2 = vx^2 + vy^2

    o[1] - ep[1] = -(ep[1] - o[1]) = -ex
    o[2] - ep[2] = -(ep[2] - o[2]) = -ey
    (o[1] - ep[1])^2 = (-ex)^2 = ex^2
    (o[2] - ep[2])^2 = (-ey)^2 = ey^2
    geo::distance_sq(ep, o) = (o[1] - ep[1])^2 + (o[2] - ep[2])^2 = ex^2 + ey^2
    ux^2 + uy^2 = h^2
    vx^2 + vy^2 = h^2
    ex^2 + ey^2 = h^2

    # The side CA is the sum of the two O-relative vectors u and v.
    release thm geo::distance_sq_coordinate_formula(c, a)
    geo::distance_sq(c, a) = (a[1] - c[1])^2 + (a[2] - c[2])^2
    a[1] - c[1] = -(c[1] - a[1]) = -(vx + ux)
    a[2] - c[2] = -(c[2] - a[2]) = -(vy + uy)
    (a[1] - c[1])^2 = (-(vx + ux))^2 = (ux + vx)^2
    (a[2] - c[2])^2 = (-(vy + uy))^2 = (uy + vy)^2
    (a[1] - c[1])^2 + (a[2] - c[2])^2 = (ux + vx)^2 + (uy + vy)^2
    z^2 = ca^2 = geo::distance_sq(c, a) = (ux + vx)^2 + (uy + vy)^2

    # Rewrite the incenter barycentric coordinates relative to A.
    d[1] * S = d[1] * (ab + bc + ca) = bc * a[1] + ca * b[1] + ab * c[1]
    a[1] * S = a[1] * (ab + bc + ca)
    release thm geo::subtract_equalities(d[1] * S, bc * a[1] + ca * b[1] + ab * c[1], a[1] * S, a[1] * (ab + bc + ca))
    (d[1] * S) - (a[1] * S) = S * (d[1] - a[1])
    (bc * a[1] + ca * b[1] + ab * c[1]) - a[1] * (ab + bc + ca) = ca * (b[1] - a[1]) + ab * (c[1] - a[1])
    S * (d[1] - a[1]) = (d[1] * S) - (a[1] * S) = (bc * a[1] + ca * b[1] + ab * c[1]) - a[1] * (ab + bc + ca) = ca * (b[1] - a[1]) + ab * (c[1] - a[1])
    release thm geo::multiply_both_sides(h, ab / 2, 2)
    ab = 2 * h
    release thm geo::multiply_both_sides(ab, 2 * h, vx + ux)
    release thm geo::add_equalities(ca * (2 * ux), ca * (2 * ux), ab * (vx + ux), (2 * h) * (vx + ux))
    ca * (b[1] - a[1]) + ab * (c[1] - a[1]) = ca * (2 * ux) + ab * (vx + ux) = ca * (2 * ux) + (2 * h) * (vx + ux) = 2 * ((ca + h) * ux + h * vx)
    ca = z
    release thm geo::multiply_both_sides(ca, z, ux)
    release thm geo::add_equalities(ca * ux, z * ux, h * ux + h * vx, h * ux + h * vx)
    (ca + h) * ux + h * vx = ca * ux + (h * ux + h * vx) = z * ux + (h * ux + h * vx) = (z + h) * ux + h * vx
    release thm geo::multiply_both_sides((ca + h) * ux + h * vx, (z + h) * ux + h * vx, 2)
    S * (d[1] - a[1]) = 2 * ((ca + h) * ux + h * vx) = 2 * ((z + h) * ux + h * vx)

    d[2] * S = d[2] * (ab + bc + ca) = bc * a[2] + ca * b[2] + ab * c[2]
    a[2] * S = a[2] * (ab + bc + ca)
    release thm geo::subtract_equalities(d[2] * S, bc * a[2] + ca * b[2] + ab * c[2], a[2] * S, a[2] * (ab + bc + ca))
    (d[2] * S) - (a[2] * S) = S * (d[2] - a[2])
    (bc * a[2] + ca * b[2] + ab * c[2]) - a[2] * (ab + bc + ca) = ca * (b[2] - a[2]) + ab * (c[2] - a[2])
    S * (d[2] - a[2]) = (d[2] * S) - (a[2] * S) = (bc * a[2] + ca * b[2] + ab * c[2]) - a[2] * (ab + bc + ca) = ca * (b[2] - a[2]) + ab * (c[2] - a[2])
    release thm geo::multiply_both_sides(ab, 2 * h, vy + uy)
    release thm geo::add_equalities(ca * (2 * uy), ca * (2 * uy), ab * (vy + uy), (2 * h) * (vy + uy))
    ca * (b[2] - a[2]) + ab * (c[2] - a[2]) = ca * (2 * uy) + ab * (vy + uy) = ca * (2 * uy) + (2 * h) * (vy + uy) = 2 * ((ca + h) * uy + h * vy)
    release thm geo::multiply_both_sides(ca, z, uy)
    release thm geo::add_equalities(ca * uy, z * uy, h * uy + h * vy, h * uy + h * vy)
    (ca + h) * uy + h * vy = ca * uy + (h * uy + h * vy) = z * uy + (h * uy + h * vy) = (z + h) * uy + h * vy
    release thm geo::multiply_both_sides((ca + h) * uy + h * vy, (z + h) * uy + h * vy, 2)
    S * (d[2] - a[2]) = 2 * ((ca + h) * uy + h * vy) = 2 * ((z + h) * uy + h * vy)

    # E=A+t(D-A), and q=2t/S, so E has the bridge coordinates.
    ep[1] = a[1] + t * (d[1] - a[1])
    ep[2] = a[2] + t * (d[2] - a[2])
    ex = ep[1] - o[1] = (a[1] - o[1]) + t * (d[1] - a[1]) = -ux + t * (d[1] - a[1])
    ey = ep[2] - o[2] = (a[2] - o[2]) + t * (d[2] - a[2]) = -uy + t * (d[2] - a[2])
    S != 0
    q * S = (2 * t / S) * S = 2 * t

    release thm geo::multiply_both_sides(S * (d[1] - a[1]), 2 * ((z + h) * ux + h * vx), t)
    release thm geo::multiply_both_sides(q * S, 2 * t, (z + h) * ux + h * vx)
    (t * (d[1] - a[1])) * S = (S * (d[1] - a[1])) * t = (2 * ((z + h) * ux + h * vx)) * t = (2 * t) * ((z + h) * ux + h * vx) = (q * S) * ((z + h) * ux + h * vx) = (q * ((z + h) * ux + h * vx)) * S
    release thm geo::divide_both_sides(t * (d[1] - a[1]), q * ((z + h) * ux + h * vx), S)
    t * (d[1] - a[1]) = q * ((z + h) * ux + h * vx)

    release thm geo::multiply_both_sides(S * (d[2] - a[2]), 2 * ((z + h) * uy + h * vy), t)
    release thm geo::multiply_both_sides(q * S, 2 * t, (z + h) * uy + h * vy)
    (t * (d[2] - a[2])) * S = (S * (d[2] - a[2])) * t = (2 * ((z + h) * uy + h * vy)) * t = (2 * t) * ((z + h) * uy + h * vy) = (q * S) * ((z + h) * uy + h * vy) = (q * ((z + h) * uy + h * vy)) * S
    release thm geo::divide_both_sides(t * (d[2] - a[2]), q * ((z + h) * uy + h * vy), S)
    t * (d[2] - a[2]) = q * ((z + h) * uy + h * vy)
    release thm geo::add_equalities(-ux, -ux, t * (d[1] - a[1]), q * ((z + h) * ux + h * vx))
    -ux + t * (d[1] - a[1]) = -ux + q * ((z + h) * ux + h * vx) = q * (z + h) * ux + q * h * vx - ux
    ex = -ux + t * (d[1] - a[1]) = q * (z + h) * ux + q * h * vx - ux

    release thm geo::add_equalities(-uy, -uy, t * (d[2] - a[2]), q * ((z + h) * uy + h * vy))
    -uy + t * (d[2] - a[2]) = -uy + q * ((z + h) * uy + h * vy) = q * (z + h) * uy + q * h * vy - uy
    ey = -uy + t * (d[2] - a[2]) = q * (z + h) * uy + q * h * vy - uy

    # The coordinate bridge proves OE perpendicular to BC.
    release thm problem_512_coordinate_bridge(ux, uy, vx, vy, ex, ey, q, h, z)
    ex * (vx - ux) + ey * (vy - uy) = 0

    # Tangency proves OE perpendicular to EF.
    geo::vec(o, ep) = (ep[1] - o[1], ep[2] - o[2]) = (ex, ey)
    geo::vec(ep, f) = (f[1] - ep[1], f[2] - ep[2])
    release thm geo::perpendicular_dot_expand(o, ep, ep, f)
    (ep[1] - o[1]) * (f[1] - ep[1]) + (ep[2] - o[2]) * (f[2] - ep[2]) = 0
    ep[1] - o[1] = ex
    ep[2] - o[2] = ey
    release thm geo::add_equalities((ep[1] - o[1]) * (f[1] - ep[1]), ex * (f[1] - ep[1]), (ep[2] - o[2]) * (f[2] - ep[2]), ey * (f[2] - ep[2]))
    (ep[1] - o[1]) * (f[1] - ep[1]) + (ep[2] - o[2]) * (f[2] - ep[2]) = ex * (f[1] - ep[1]) + ey * (f[2] - ep[2]) = 0
    ex^2 + ey^2 = h^2 > 0

    # Therefore BC and EF have zero determinant.
    release thm problem_512_common_normal_core(ex, ey, vx - ux, vy - uy, f[1] - ep[1], f[2] - ep[2])
    (vx - ux) * (f[2] - ep[2]) - (vy - uy) * (f[1] - ep[1]) = 0
    release thm geo::vec_coordinate_formula(b, c)
    geo::vec(b, c)[1] = c[1] - b[1] = (c[1] - o[1]) - (b[1] - o[1]) = vx - ux
    geo::vec(b, c)[2] = c[2] - b[2] = (c[2] - o[2]) - (b[2] - o[2]) = vy - uy
    geo::vec(b, c) = (vx - ux, vy - uy)
    geo::det(geo::vec(b, c), geo::vec(ep, f)) = (vx - ux) * (f[2] - ep[2]) - (vy - uy) * (f[1] - ep[1]) = 0

    # Nondegeneracy comes from the triangle and tangent predicates.
    release thm geo::triangle_det_nonzero(a, b, c)
    geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
    by contra:
        ? b != c
        b = c
        b[1] = c[1]
        b[2] = c[2]
        release thm geo::vec_coordinate_formula(a, b)
        release thm geo::vec_coordinate_formula(a, c)
        release thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(a, c))
        geo::det(geo::vec(a, b), geo::vec(a, c)) = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1]) = (c[1] - a[1]) * (c[2] - a[2]) - (c[2] - a[2]) * (c[1] - a[1]) = 0
        impossible geo::det(geo::vec(a, b), geo::vec(a, c)) != 0
    b != c
    ep != f
    by def $geo::is_parallel(b, c, ep, f)
