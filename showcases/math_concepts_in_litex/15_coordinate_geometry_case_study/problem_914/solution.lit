# Problem 914 / zhongkao_725 - 等边三角形中的倍长关系
#
# 【NL原题】
# 已知△CDE为等边三角形，过点C作CG⊥DE于点G，四边形BCEF为菱形。
# 求证：DF=2DE。
#
# 【题面完整性说明】
# 原题文字遗漏了题图中的位置条件：F在DE以E为端点的延长线上。
# 若不补充该条件，D、E、F不必共线，结论不成立。主定理将其显式列为
# “题图隐含前提”。长度命题采用等价的平方距离形式 DF^2=4DE^2。

# 若F在DE以E为端点的延长线上，且EF=DE，则DF^2=4DE^2。
thm problem_914_equal_extension_double:
    ? forall d, ep, f cart(R, R):
        $geo::is_on_extension(f, d, ep),
        $geo::are_segments_congruent(ep, f, d, ep)
        =>:
            geo::distance_sq(d, f) = 4 * geo::distance_sq(d, ep)
    by def $geo::is_on_extension(f, d, ep)
    obtain t from exist t0 R st {t0 > 1, f = (d[1] + t0 * (ep[1] - d[1]), d[2] + t0 * (ep[2] - d[2]))}
    t > 1
    f[1] = d[1] + t * (ep[1] - d[1])
    f[2] = d[2] + t * (ep[2] - d[2])

    by def $geo::are_segments_congruent(ep, f, d, ep)
    by thm geo::distance_sq_coordinate_formula(ep, f)
    by thm geo::distance_sq_coordinate_formula(d, ep)
    geo::distance_sq(ep, f) = (f[1] - ep[1])^2 + (f[2] - ep[2])^2
    (f[1] - ep[1])^2 + (f[2] - ep[2])^2 = (t - 1)^2 * ((ep[1] - d[1])^2 + (ep[2] - d[2])^2)
    geo::distance_sq(d, ep) = (ep[1] - d[1])^2 + (ep[2] - d[2])^2
    (t - 1)^2 * geo::distance_sq(d, ep) = (t - 1)^2 * ((ep[1] - d[1])^2 + (ep[2] - d[2])^2) = (f[1] - ep[1])^2 + (f[2] - ep[2])^2 = geo::distance_sq(ep, f) = geo::distance_sq(d, ep)
    d != ep
    geo::distance_sq(d, ep) > 0
    geo::distance_sq(d, ep) != 0
    geo::distance_sq(d, ep) * ((t - 1)^2 - 1) = (t - 1)^2 * geo::distance_sq(d, ep) - geo::distance_sq(d, ep) = geo::distance_sq(d, ep) - geo::distance_sq(d, ep) = 0
    by thm geo::zero_factor_law(geo::distance_sq(d, ep), (t - 1)^2 - 1)
    (t - 1)^2 - 1 = 0
    (t - 1)^2 = 1
    by thm geo::difference_of_squares(t - 1, 1)
    (t - 1)^2 - 1 = ((t - 1) - 1) * ((t - 1) + 1) = (t - 2) * t
    (t - 2) * t = 0
    t - 1 > 0
    t > 1
    t != 0
    by contra:
        ? t - 2 = 0
        t - 2 != 0
        by thm geo::zero_factor_law(t - 2, t)
        t = 0
        impossible t > 1
    t = 2

    by thm geo::distance_sq_coordinate_formula(d, f)
    geo::distance_sq(d, f) = (f[1] - d[1])^2 + (f[2] - d[2])^2
    
    by thm geo::distance_sq_coordinate_formula(d, ep)
    geo::distance_sq(d, ep) = (ep[1] - d[1])^2 + (ep[2] - d[2])^2
    
    f[1] - d[1] = t * (ep[1] - d[1])
    f[2] - d[2] = t * (ep[2] - d[2])
    (f[1] - d[1])^2 = (t * (ep[1] - d[1]))^2 = t^2 * (ep[1] - d[1])^2
    (f[2] - d[2])^2 = (t * (ep[2] - d[2]))^2 = t^2 * (ep[2] - d[2])^2
    (f[1] - d[1])^2 + (f[2] - d[2])^2 = t^2 * (ep[1] - d[1])^2 + t^2 * (ep[2] - d[2])^2 = t^2 * ((ep[1] - d[1])^2 + (ep[2] - d[2])^2)
    
    geo::distance_sq(d, f) = t^2 * ((ep[1] - d[1])^2 + (ep[2] - d[2])^2) = t^2 * geo::distance_sq(d, ep)
    t^2 = 4
    t^2 * geo::distance_sq(d, ep) = 4 * geo::distance_sq(d, ep)
    geo::distance_sq(d, f) = 4 * geo::distance_sq(d, ep)

# 主定理：逐项形式化原题条件及题图隐含的位置条件。
thm problem_914:
    ? forall b, c, d, ep, f, g cart(R, R):
        # 已知△CDE为等边三角形。
        $geo::is_equilateral(c, d, ep),
        # 过点C作CG垂直DE于点G，即G是C到直线DE的垂足。
        $geo::is_foot(g, c, d, ep),
        # 四边形BCEF为菱形。
        $geo::is_rhombus(b, c, ep, f),
        # 题图隐含前提：F在DE以E为端点的延长线上。
        $geo::is_on_extension(f, d, ep),
        # 平行四边形BCEF的第四顶点F满足向量关系：由BC∥FE和BF∥CE推出。
        f[1] = b[1] + ep[1] - c[1],
        f[2] = b[2] + ep[2] - c[2]
        =>:
            # 求证：DF=2DE；以等价的平方距离形式表达。
            geo::distance_sq(d, f) = 4 * geo::distance_sq(d, ep)
    # 等边三角形给出CE=DE。
    by def $geo::is_equilateral(c, d, ep)
    by thm geo::segments_congruent_symmetric_prop(c, d, d, ep)
    by thm geo::segments_congruent_transitive_prop(c, d, d, ep, c, ep)

    # 菱形定义给出BCEF是平行四边形且BC=CE。
    by def $geo::is_rhombus(b, c, ep, f)
    
    # 因此 BC=CE=DE。
    by thm geo::segments_congruent_transitive_prop(b, c, c, ep, d, ep)
    
    # 由平行四边形坐标关系和parallelogram_sides定理，得BF=CE。
    by thm geo::parallelogram_sides(b, c, ep, f)
    geo::distance_sq(b, f) = geo::distance_sq(c, ep)
    
    # 由BC=CE=DE和BF=CE，得EF=BC=DE（利用菱形四边等长）。
    # 菱形的定义保证BC=CE；平行四边形对边性质保证EF=BC和BF=CE。
    # 因此 EF=BC=CE=DE。
    by thm geo::segments_congruent_symmetric_prop(b, c, d, ep)
    by thm geo::distance_sq_symmetric(ep, f)
    by thm geo::distance_sq_symmetric(b, c)
    geo::distance_sq(ep, f) = geo::distance_sq(c, b)
    geo::distance_sq(ep, f) = geo::distance_sq(b, c)
    geo::distance_sq(ep, f) = geo::distance_sq(c, ep)
    geo::distance_sq(ep, f) = geo::distance_sq(d, ep)

    # 由延长线上的相邻等长关系得到DF=2DE。
    by thm problem_914_equal_extension_double(d, ep, f)
