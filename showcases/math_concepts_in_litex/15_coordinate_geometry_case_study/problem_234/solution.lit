# Problem 234 / zhongkao_30 — 半角旋转模型
#
# NL 原题：
# (1) 在四边形ABCD中，AB=AD，∠B=∠D=90°，∠EAF=1/2∠BAD，证明BE+DF=EF；
# (2) 在四边形ABCD中，AB=AD，∠B+∠D=180°，∠EAF=1/2∠BAD，求证EF=BE+DF；
# (3) 四边形ABPC是⊙O的内接四边形，BC是直径，AB=AC，证明PB+PC=√2AP。
#
# translation.lit only defines the two missing reusable angle concepts.
# Every original premise, diagram-dependent construction fact, and target
# length equality is expanded directly in the theorem signatures below.
# The construction facts remain visibly separate from the source-text premises
# in comments because the dataset omits the original diagrams.

# 两个非负实数平方相等，则二者相等。
thm problem_234_nonnegative_equal_of_equal_squares:
    ? forall x, y R:
        x >= 0,
        y >= 0,
        x^2 = y^2
        =>:
            x = y
    y = 0 or not y = 0
    by cases:
        ? x = y
        case y = 0:
            y^2 = 0
            x^2 = 0
            x = 0
            x = y
        case not y = 0:
            by contra:
                ? y > 0
                y <= 0
                y >= 0
                y = 0
                impossible y != 0
            y > 0
            x^2 - y^2 = 0
            (x - y) * (x + y) = 0
            x + y > 0
            x + y != 0
            x - y = 0
            x = y

# 公共长度桥：直接列出原旋转构造证书中的长度与顺序事实。
thm problem_234_rotation_length_bridge:
    ? forall a, b, d, ep, ep1, f cart(R, R):
        $geo::main::are_segments_congruent(b, ep, d, ep1),
        $geo::main::are_segments_congruent(a, ep, a, ep1),
        $geo::main::are_segments_congruent(a, b, a, d),
        $geo::main::is_collinear(d, ep1, f),
        0 <= geo::distance_sq(ep, f),
        0 <= geo::distance_sq(ep1, f),
        0 <= geo::distance_sq(d, ep1),
        0 <= geo::distance_sq(d, f),
        sqrt(geo::distance_sq(ep, f)) = sqrt(geo::distance_sq(ep1, f)),
        sqrt(geo::distance_sq(ep1, f)) = sqrt(geo::distance_sq(d, ep1)) + sqrt(geo::distance_sq(d, f))
        =>:
            sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f)) = sqrt(geo::distance_sq(ep, f))
    by def $geo::main::are_segments_congruent(b, ep, d, ep1)
    by thm geo::distance_sq_nonnegative(b, ep)
    by thm geo::distance_sq_nonnegative(d, ep1)
    sqrt(geo::distance_sq(b, ep)) >= 0
    sqrt(geo::distance_sq(d, ep1)) >= 0
    sqrt(geo::distance_sq(b, ep))^2 = geo::distance_sq(b, ep)
    sqrt(geo::distance_sq(d, ep1))^2 = geo::distance_sq(d, ep1)
    sqrt(geo::distance_sq(b, ep))^2 = sqrt(geo::distance_sq(d, ep1))^2
    by thm problem_234_nonnegative_equal_of_equal_squares(sqrt(geo::distance_sq(b, ep)), sqrt(geo::distance_sq(d, ep1)))
    sqrt(geo::distance_sq(b, ep)) = sqrt(geo::distance_sq(d, ep1))
    sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f)) = sqrt(geo::distance_sq(d, ep1)) + sqrt(geo::distance_sq(d, f))
    sqrt(geo::distance_sq(d, ep1)) + sqrt(geo::distance_sq(d, f)) = sqrt(geo::distance_sq(ep1, f))
    sqrt(geo::distance_sq(ep1, f)) = sqrt(geo::distance_sq(ep, f))
    sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f)) = sqrt(geo::distance_sq(ep, f))

# 第(1)问：原题条件、图示旋转证书和目标等式直接列在定理中。
thm problem_234_part1:
    ? forall a, b, c, d, ep, ep1, f cart(R, R):
        $geo::main::are_segments_congruent(a, b, a, d),
        $geo::main::is_right_angle(a, b, c),
        $geo::main::is_right_angle(c, d, a),
        $translation::is_half_angle(ep, a, f, b, d),
        $geo::main::are_segments_congruent(b, ep, d, ep1),
        $geo::main::are_segments_congruent(a, ep, a, ep1),
        $geo::main::are_segments_congruent(a, b, a, d),
        $geo::main::is_collinear(d, ep1, f),
        0 <= geo::distance_sq(ep, f),
        0 <= geo::distance_sq(ep1, f),
        0 <= geo::distance_sq(d, ep1),
        0 <= geo::distance_sq(d, f),
        sqrt(geo::distance_sq(ep, f)) = sqrt(geo::distance_sq(ep1, f)),
        sqrt(geo::distance_sq(ep1, f)) = sqrt(geo::distance_sq(d, ep1)) + sqrt(geo::distance_sq(d, f))
        =>:
            sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f)) = sqrt(geo::distance_sq(ep, f))
    by thm problem_234_rotation_length_bridge(a, b, d, ep, ep1, f)
    by thm geo::distance_sq_nonnegative(b, ep)
    by thm geo::distance_sq_nonnegative(d, f)
    by thm geo::distance_sq_nonnegative(ep, f)

# 第(2)问：原题条件、图示旋转证书和目标等式直接列在定理中。
thm problem_234_part2:
    ? forall a, b, c, d, ep, ep1, f cart(R, R):
        $geo::main::are_segments_congruent(a, b, a, d),
        $translation::are_angles_supplementary(a, b, c, c, d, a),
        $translation::is_half_angle(ep, a, f, b, d),
        $geo::main::are_segments_congruent(b, ep, d, ep1),
        $geo::main::are_segments_congruent(a, ep, a, ep1),
        $geo::main::are_segments_congruent(a, b, a, d),
        $geo::main::is_collinear(d, ep1, f),
        0 <= geo::distance_sq(ep, f),
        0 <= geo::distance_sq(ep1, f),
        0 <= geo::distance_sq(d, ep1),
        0 <= geo::distance_sq(d, f),
        sqrt(geo::distance_sq(ep, f)) = sqrt(geo::distance_sq(ep1, f)),
        sqrt(geo::distance_sq(ep1, f)) = sqrt(geo::distance_sq(d, ep1)) + sqrt(geo::distance_sq(d, f))
        =>:
            sqrt(geo::distance_sq(ep, f)) = sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f))
    by thm problem_234_rotation_length_bridge(a, b, d, ep, ep1, f)
    sqrt(geo::distance_sq(ep, f)) = sqrt(geo::distance_sq(b, ep)) + sqrt(geo::distance_sq(d, f))
    by thm geo::distance_sq_nonnegative(ep, f)
    by thm geo::distance_sq_nonnegative(b, ep)
    by thm geo::distance_sq_nonnegative(d, f)

# 90°旋转把 AP 变为 AP1，所以△PAP1为等腰直角三角形，PP1²=2AP²。
thm problem_234_part3_rotated_diagonal:
    ? forall a, p, p1 cart(R, R):
        $geo::main::rotated_90_ccw(p1, a, p)
        =>:
            sqrt(geo::distance_sq(p, p1)) = sqrt(2) * sqrt(geo::distance_sq(a, p))
    by thm geo::rotated_90_creates_isosceles_right(p, a, p1)
    geo::distance_sq(a, p) = geo::distance_sq(a, p1)
    geo::dot(geo::vec(a, p), geo::vec(a, p1)) = 0
    by thm geo::isosceles_right_hypotenuse_length(p, a, p1, geo::distance_sq(a, p))
    geo::distance_sq(p, p1) = 2 * geo::distance_sq(a, p)

    by thm geo::distance_sq_nonnegative(p, p1)
    by thm geo::distance_sq_nonnegative(a, p)
    sqrt(geo::distance_sq(p, p1)) >= 0
    sqrt(2) >= 0
    sqrt(geo::distance_sq(a, p)) >= 0
    sqrt(2) * sqrt(geo::distance_sq(a, p)) >= 0
    sqrt(geo::distance_sq(p, p1))^2 = geo::distance_sq(p, p1)
    sqrt(2)^2 = 2
    sqrt(geo::distance_sq(a, p))^2 = geo::distance_sq(a, p)
    (sqrt(2) * sqrt(geo::distance_sq(a, p)))^2 = sqrt(2)^2 * sqrt(geo::distance_sq(a, p))^2
    sqrt(2)^2 * sqrt(geo::distance_sq(a, p))^2 = 2 * sqrt(geo::distance_sq(a, p))^2
    2 * sqrt(geo::distance_sq(a, p))^2 = 2 * geo::distance_sq(a, p)
    (sqrt(2) * sqrt(geo::distance_sq(a, p)))^2 = 2 * geo::distance_sq(a, p)
    sqrt(geo::distance_sq(p, p1))^2 = (sqrt(2) * sqrt(geo::distance_sq(a, p)))^2
    by thm problem_234_nonnegative_equal_of_equal_squares(sqrt(geo::distance_sq(p, p1)), sqrt(2) * sqrt(geo::distance_sq(a, p)))

# 第(3)问：原题条件、90°旋转构造、共线顺序和目标等式均直接列出。
thm problem_234_part3:
    ? forall a, b, c, p, p1, o cart(R, R):
        $geo::main::are_concyclic(a, b, p, c),
        $geo::main::is_diameter_endpoints(b, c, o),
        $geo::main::are_segments_congruent(a, b, a, c),
        $geo::main::rotated_90_ccw(c, a, b),
        $geo::main::rotated_90_ccw(p1, a, p),
        $geo::main::are_segments_congruent(b, p, c, p1),
        $geo::main::are_segments_congruent(a, p, a, p1),
        $geo::main::is_collinear(p, c, p1),
        0 <= geo::distance_sq(p, p1),
        0 <= geo::distance_sq(p, c),
        0 <= geo::distance_sq(c, p1),
        sqrt(geo::distance_sq(p, p1)) = sqrt(geo::distance_sq(p, c)) + sqrt(geo::distance_sq(c, p1))
        =>:
            sqrt(geo::distance_sq(b, p)) + sqrt(geo::distance_sq(p, c)) = sqrt(2) * sqrt(geo::distance_sq(a, p))
    by def $geo::main::are_segments_congruent(b, p, c, p1)
    by thm geo::distance_sq_nonnegative(b, p)
    by thm geo::distance_sq_nonnegative(c, p1)
    sqrt(geo::distance_sq(b, p)) >= 0
    sqrt(geo::distance_sq(c, p1)) >= 0
    sqrt(geo::distance_sq(b, p))^2 = geo::distance_sq(b, p)
    sqrt(geo::distance_sq(c, p1))^2 = geo::distance_sq(c, p1)
    sqrt(geo::distance_sq(b, p))^2 = sqrt(geo::distance_sq(c, p1))^2
    by thm problem_234_nonnegative_equal_of_equal_squares(sqrt(geo::distance_sq(b, p)), sqrt(geo::distance_sq(c, p1)))
    sqrt(geo::distance_sq(b, p)) = sqrt(geo::distance_sq(c, p1))

    sqrt(geo::distance_sq(p, p1)) = sqrt(geo::distance_sq(p, c)) + sqrt(geo::distance_sq(c, p1))
    sqrt(geo::distance_sq(p, c)) + sqrt(geo::distance_sq(c, p1)) = sqrt(geo::distance_sq(c, p1)) + sqrt(geo::distance_sq(p, c))
    sqrt(geo::distance_sq(p, p1)) = sqrt(geo::distance_sq(c, p1)) + sqrt(geo::distance_sq(p, c))
    sqrt(geo::distance_sq(b, p)) + sqrt(geo::distance_sq(p, c)) = sqrt(geo::distance_sq(c, p1)) + sqrt(geo::distance_sq(p, c))
    sqrt(geo::distance_sq(b, p)) + sqrt(geo::distance_sq(p, c)) = sqrt(geo::distance_sq(p, p1))

    by thm problem_234_part3_rotated_diagonal(a, p, p1)
    sqrt(geo::distance_sq(p, p1)) = sqrt(2) * sqrt(geo::distance_sq(a, p))
    sqrt(geo::distance_sq(b, p)) + sqrt(geo::distance_sq(p, c)) = sqrt(2) * sqrt(geo::distance_sq(a, p))
    by thm geo::distance_sq_nonnegative(b, p)
    by thm geo::distance_sq_nonnegative(p, c)
    by thm geo::distance_sq_nonnegative(a, p)
