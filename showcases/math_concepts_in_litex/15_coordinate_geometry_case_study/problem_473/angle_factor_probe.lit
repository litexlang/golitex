# Problem 473: algebraic bridge from the squared-cosine equality.
thm problem_473_angle_factor:
    ? forall u, v, w, t R:
        u > 0,
        ((u + v)^2 * (u + 2 * t * v + t^2 * w)) * u = ((u + t * v)^2 * (u + 2 * v + w)) * u
        =>:
            (t - 1) * (u * w - v^2) * (u * t + u + 2 * v * t) = 0
    by thm geo::cancel_positive_right_factor((u + v)^2 * (u + 2 * t * v + t^2 * w), (u + t * v)^2 * (u + 2 * v + w), u)
    (u + v)^2 * (u + 2 * t * v + t^2 * w) = (u + t * v)^2 * (u + 2 * v + w)
    by thm geo::subtract_equalities((u + v)^2 * (u + 2 * t * v + t^2 * w), (u + t * v)^2 * (u + 2 * v + w), (u + t * v)^2 * (u + 2 * v + w), (u + t * v)^2 * (u + 2 * v + w))
    (u + v)^2 * (u + 2 * t * v + t^2 * w) - (u + t * v)^2 * (u + 2 * v + w) = 0
    (u + v)^2 * (u + 2 * t * v + t^2 * w) - (u + t * v)^2 * (u + 2 * v + w) = (t - 1) * (u * w - v^2) * (u * t + u + 2 * v * t)
    (t - 1) * (u * w - v^2) * (u * t + u + 2 * v * t) = 0
