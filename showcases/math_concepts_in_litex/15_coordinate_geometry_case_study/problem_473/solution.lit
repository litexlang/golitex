# Problem 473 / zhongkao_272 — 正式证明
#
# NL 原题：
# 如图，C是线段AB的中点，∠DAC=∠ECB，CD∥BE。
# (1) 求证：△DAC≌△ECB；
# (2) 若AB=16，求DE的长。
#
# “如图”还给出D、E位于直线AB的同一侧；该方向信息由
# are_on_same_strict_side_of_line 原子谓词表达。正式入口只使用与原题
# 逐句对应的几何/度量原子；坐标差与多项式等式仅出现在内部证明中。

# 已独立验证的几何核心：由中点、等角、平行及图示方向推出全等，
# 并同时得到第二问需要的 DE²=CB²。
thm problem_473_congruence_bridge:
    ? forall a, b, c, d, ep cart(R, R):
        $geo::is_midpoint(c, a, b)
        $geo::are_angles_congruent(d, a, c, ep, c, b)
        $geo::is_parallel(c, d, b, ep)
        $translation::are_on_same_strict_side_of_line(a, b, d, ep)
        =>:
            $geo::are_triangles_congruent(d, a, c, ep, c, b)
            geo::distance_sq(d, ep) = geo::distance_sq(c, b)

    # Midpoint coordinates: CA and CB have the same directed vector x.
    by def $geo::is_midpoint(c, a, b)
    c[1] = (a[1] + b[1]) / 2
    c[2] = (a[2] + b[2]) / 2
    c[1] - a[1] = b[1] - c[1]
    c[2] - a[2] = b[2] - c[2]
    b[1] - a[1] = 2 * (b[1] - c[1])
    b[2] - a[2] = 2 * (b[2] - c[2])

    # Parallelism and the diagram orientation give BE = t CD for t > 0.
    by def $geo::is_parallel(c, d, b, ep)
    by def $translation::are_on_same_strict_side_of_line(a, b, d, ep)
    by thm geo::vec_coordinate_formula(a, b)
    by thm geo::vec_coordinate_formula(a, d)
    by thm geo::vec_coordinate_formula(a, ep)
    by thm geo::vec_coordinate_formula(c, d)
    by thm geo::vec_coordinate_formula(b, ep)
    by thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(a, d))
    by thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(a, ep))
    by thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(c, d))
    by thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(b, ep))
    geo::det(geo::vec(a, b), geo::vec(a, d)) = (b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])
    geo::det(geo::vec(a, b), geo::vec(a, ep)) = (b[1] - a[1]) * (ep[2] - a[2]) - (b[2] - a[2]) * (ep[1] - a[1])
    geo::det(geo::vec(a, b), geo::vec(c, d)) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    geo::det(geo::vec(a, b), geo::vec(b, ep)) = (b[1] - a[1]) * (ep[2] - b[2]) - (b[2] - a[2]) * (ep[1] - b[1])
    d[1] - a[1] = (b[1] - c[1]) + (d[1] - c[1])
    d[2] - a[2] = (b[2] - c[2]) + (d[2] - c[2])
    ep[1] - a[1] = 2 * (b[1] - c[1]) + (ep[1] - b[1])
    ep[2] - a[2] = 2 * (b[2] - c[2]) + (ep[2] - b[2])
    by thm det_shift_probe::problem_473_det_shift(b[1] - c[1], b[2] - c[2], d[1] - c[1], d[2] - c[2], 1)
    by thm det_shift_probe::problem_473_det_shift(b[1] - c[1], b[2] - c[2], ep[1] - b[1], ep[2] - b[2], 2)
    (b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1]) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    (b[1] - a[1]) * (ep[2] - a[2]) - (b[2] - a[2]) * (ep[1] - a[1]) = (b[1] - a[1]) * (ep[2] - b[2]) - (b[2] - a[2]) * (ep[1] - b[1])
    geo::det(geo::vec(a, b), geo::vec(a, d)) = geo::det(geo::vec(a, b), geo::vec(c, d))
    geo::det(geo::vec(a, b), geo::vec(a, ep)) = geo::det(geo::vec(a, b), geo::vec(b, ep))
    geo::det(geo::vec(a, b), geo::vec(c, d)) * geo::det(geo::vec(a, b), geo::vec(b, ep)) > 0
    by thm ratio_probe::problem_473_positive_parallel_ratio(geo::vec(a, b), geo::vec(c, d), geo::vec(b, ep))
    obtain t from exist t0 R st {t0 > 0
    geo::vec(b, ep)[1] = t0 * geo::vec(c, d)[1]
    geo::vec(b, ep)[2] = t0 * geo::vec(c, d)[2]}
    geo::vec(b, ep)[1] = t * geo::vec(c, d)[1]
    geo::vec(b, ep)[2] = t * geo::vec(c, d)[2]
    geo::vec(b, ep)[1] = ep[1] - b[1]
    geo::vec(b, ep)[2] = ep[2] - b[2]
    geo::vec(c, d)[1] = d[1] - c[1]
    geo::vec(c, d)[2] = d[2] - c[2]
    ep[1] - b[1] = geo::vec(b, ep)[1] = t * geo::vec(c, d)[1] = t * (d[1] - c[1])
    ep[2] - b[2] = geo::vec(b, ep)[2] = t * geo::vec(c, d)[2] = t * (d[2] - c[2])

    # Scalar abbreviations are expanded explicitly below:
    # u=|CB|^2, v=CB dot CD, w=|CD|^2.
    by def $geo::are_angles_congruent(d, a, c, ep, c, b)
    by thm geo::distance_sq_coordinate_formula(a, d)
    by thm geo::distance_sq_coordinate_formula(a, c)
    by thm geo::distance_sq_coordinate_formula(c, ep)
    by thm geo::distance_sq_coordinate_formula(c, b)
    by thm geo::vec_coordinate_formula(a, d)
    by thm geo::vec_coordinate_formula(a, c)
    by thm geo::vec_coordinate_formula(c, ep)
    by thm geo::vec_coordinate_formula(c, b)
    by thm geo::dot_coordinate_formula(geo::vec(a, d), geo::vec(a, c))
    by thm geo::dot_coordinate_formula(geo::vec(c, ep), geo::vec(c, b))

    d[1] - a[1] = (b[1] - c[1]) + (d[1] - c[1])
    d[2] - a[2] = (b[2] - c[2]) + (d[2] - c[2])
    ep[1] - c[1] = (b[1] - c[1]) + (ep[1] - b[1]) = (b[1] - c[1]) + t * (d[1] - c[1])
    ep[2] - c[2] = (b[2] - c[2]) + (ep[2] - b[2]) = (b[2] - c[2]) + t * (d[2] - c[2])

    # The strict-side atom also proves the two basis vectors are independent.
    by thm ratio_probe::problem_473_det_second_scaled(geo::vec(a, b), geo::vec(c, d), geo::vec(b, ep), t)
    by thm geo::multiply_both_sides(geo::det(geo::vec(a, b), geo::vec(b, ep)), geo::det(geo::vec(a, b), geo::vec(c, d)) * t, geo::det(geo::vec(a, b), geo::vec(c, d)))
    geo::det(geo::vec(a, b), geo::vec(b, ep)) * geo::det(geo::vec(a, b), geo::vec(c, d)) = (geo::det(geo::vec(a, b), geo::vec(c, d)) * t) * geo::det(geo::vec(a, b), geo::vec(c, d))
    geo::det(geo::vec(a, b), geo::vec(c, d)) * geo::det(geo::vec(a, b), geo::vec(b, ep)) = geo::det(geo::vec(a, b), geo::vec(b, ep)) * geo::det(geo::vec(a, b), geo::vec(c, d))
    (geo::det(geo::vec(a, b), geo::vec(c, d)) * t) * geo::det(geo::vec(a, b), geo::vec(c, d)) = t * geo::det(geo::vec(a, b), geo::vec(c, d))^2
    geo::det(geo::vec(a, b), geo::vec(c, d)) * geo::det(geo::vec(a, b), geo::vec(b, ep)) = geo::det(geo::vec(a, b), geo::vec(b, ep)) * geo::det(geo::vec(a, b), geo::vec(c, d)) = (geo::det(geo::vec(a, b), geo::vec(c, d)) * t) * geo::det(geo::vec(a, b), geo::vec(c, d)) = t * geo::det(geo::vec(a, b), geo::vec(c, d))^2
    t * geo::det(geo::vec(a, b), geo::vec(c, d))^2 > 0
    geo::det(geo::vec(a, b), geo::vec(c, d))^2 > 0
    by thm geo::det_coordinate_formula(geo::vec(a, b), geo::vec(c, d))
    ((b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]))^2 > 0
    (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]) = 2 * ((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1]))
    by thm geo::square_of_equal((b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]), 2 * ((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1])))
    ((b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]))^2 = (2 * ((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1])))^2
    (2 * ((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1])))^2 > 0
    by thm scalar_core_probe::problem_473_double_square_positive((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1]))
    ((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1]))^2 > 0

    by thm geo::dot_squared_plus_det_squared((b[1] - c[1], b[2] - c[2]), (d[1] - c[1], d[2] - c[2]))
    ((b[1] - c[1])^2 + (b[2] - c[2])^2) * ((d[1] - c[1])^2 + (d[2] - c[2])^2) - ((b[1] - c[1]) * (d[1] - c[1]) + (b[2] - c[2]) * (d[2] - c[2]))^2 = ((b[1] - c[1]) * (d[2] - c[2]) - (b[2] - c[2]) * (d[1] - c[1]))^2
    ((b[1] - c[1])^2 + (b[2] - c[2])^2) * ((d[1] - c[1])^2 + (d[2] - c[2])^2) - ((b[1] - c[1]) * (d[1] - c[1]) + (b[2] - c[2]) * (d[2] - c[2]))^2 > 0
    (b[1] - c[1])^2 + (b[2] - c[2])^2 > 0

    # Rewrite the atomic angle premise into the compact vector interface.
    by thm geo::dot_coordinate_formula((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2]))
    by thm geo::dot_coordinate_formula((d[1] - c[1], d[2] - c[2]), (d[1] - c[1], d[2] - c[2]))
    by thm geo::dot_coordinate_formula((b[1] - c[1], b[2] - c[2]), (d[1] - c[1], d[2] - c[2]))
    geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2])) = (b[1] - c[1])^2 + (b[2] - c[2])^2
    geo::dot((d[1] - c[1], d[2] - c[2]), (d[1] - c[1], d[2] - c[2])) = (d[1] - c[1])^2 + (d[2] - c[2])^2
    geo::dot((b[1] - c[1], b[2] - c[2]), (d[1] - c[1], d[2] - c[2])) = (b[1] - c[1]) * (d[1] - c[1]) + (b[2] - c[2]) * (d[2] - c[2])
    geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2])) > 0
    geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2])) * geo::dot((d[1] - c[1], d[2] - c[2]), (d[1] - c[1], d[2] - c[2])) - geo::dot((b[1] - c[1], b[2] - c[2]), (d[1] - c[1], d[2] - c[2]))^2 > 0

    geo::vec(a, d) = (d[1] - a[1], d[2] - a[2]) = ((b[1] - c[1]) + (d[1] - c[1]), (b[2] - c[2]) + (d[2] - c[2]))
    geo::vec(a, c) = (c[1] - a[1], c[2] - a[2]) = (b[1] - c[1], b[2] - c[2])
    geo::vec(c, ep) = (ep[1] - c[1], ep[2] - c[2]) = ((b[1] - c[1]) + t * (d[1] - c[1]), (b[2] - c[2]) + t * (d[2] - c[2]))
    geo::vec(c, b) = (b[1] - c[1], b[2] - c[2])

    geo::angle_cos_num(d, a, c) = geo::dot(geo::vec(a, d), geo::vec(a, c)) = geo::dot(((b[1] - c[1]) + (d[1] - c[1]), (b[2] - c[2]) + (d[2] - c[2])), (b[1] - c[1], b[2] - c[2]))
    geo::angle_cos_num(ep, c, b) = geo::dot(geo::vec(c, ep), geo::vec(c, b)) = geo::dot(((b[1] - c[1]) + t * (d[1] - c[1]), (b[2] - c[2]) + t * (d[2] - c[2])), (b[1] - c[1], b[2] - c[2]))

    geo::distance_sq(a, d) = geo::dot(geo::vec(a, d), geo::vec(a, d)) = geo::dot(((b[1] - c[1]) + (d[1] - c[1]), (b[2] - c[2]) + (d[2] - c[2])), ((b[1] - c[1]) + (d[1] - c[1]), (b[2] - c[2]) + (d[2] - c[2])))
    geo::distance_sq(a, c) = geo::dot(geo::vec(a, c), geo::vec(a, c)) = geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2]))
    geo::distance_sq(c, ep) = geo::dot(geo::vec(c, ep), geo::vec(c, ep)) = geo::dot(((b[1] - c[1]) + t * (d[1] - c[1]), (b[2] - c[2]) + t * (d[2] - c[2])), ((b[1] - c[1]) + t * (d[1] - c[1]), (b[2] - c[2]) + t * (d[2] - c[2])))
    geo::distance_sq(c, b) = geo::dot(geo::vec(c, b), geo::vec(c, b)) = geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2]))

    geo::angle_cos_den(d, a, c) = geo::distance_sq(a, d) * geo::distance_sq(a, c) = geo::dot(((b[1] - c[1]) + (d[1] - c[1]), (b[2] - c[2]) + (d[2] - c[2])), ((b[1] - c[1]) + (d[1] - c[1]), (b[2] - c[2]) + (d[2] - c[2]))) * geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2]))
    geo::angle_cos_den(ep, c, b) = geo::distance_sq(c, ep) * geo::distance_sq(c, b) = geo::dot(((b[1] - c[1]) + t * (d[1] - c[1]), (b[2] - c[2]) + t * (d[2] - c[2])), ((b[1] - c[1]) + t * (d[1] - c[1]), (b[2] - c[2]) + t * (d[2] - c[2]))) * geo::dot((b[1] - c[1], b[2] - c[2]), (b[1] - c[1], b[2] - c[2]))

    by thm point_angle_unique_probe::problem_473_point_angle_scale_unique(a, b, c, d, ep, (b[1] - c[1], b[2] - c[2]), (d[1] - c[1], d[2] - c[2]), t)
    t = 1

    # t=1 gives all three corresponding squared side lengths.
    ep[1] - b[1] = t * (d[1] - c[1]) = 1 * (d[1] - c[1]) = d[1] - c[1]
    ep[2] - b[2] = t * (d[2] - c[2]) = 1 * (d[2] - c[2]) = d[2] - c[2]
    ep[1] - c[1] = (b[1] - c[1]) + t * (d[1] - c[1]) = (b[1] - c[1]) + (d[1] - c[1]) = d[1] - a[1]
    ep[2] - c[2] = (b[2] - c[2]) + t * (d[2] - c[2]) = (b[2] - c[2]) + (d[2] - c[2]) = d[2] - a[2]
    by thm geo::distance_sq_coordinate_formula(d, a)
    by thm geo::distance_sq_coordinate_formula(ep, c)
    by thm geo::distance_sq_coordinate_formula(a, c)
    by thm geo::distance_sq_coordinate_formula(c, b)
    by thm geo::distance_sq_coordinate_formula(c, d)
    by thm geo::distance_sq_coordinate_formula(b, ep)
    geo::distance_sq(d, a) = (a[1] - d[1])^2 + (a[2] - d[2])^2 = (d[1] - a[1])^2 + (d[2] - a[2])^2 = (ep[1] - c[1])^2 + (ep[2] - c[2])^2 = (c[1] - ep[1])^2 + (c[2] - ep[2])^2 = geo::distance_sq(ep, c)
    geo::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2 = (b[1] - c[1])^2 + (b[2] - c[2])^2 = geo::distance_sq(c, b)
    geo::distance_sq(c, d) = (d[1] - c[1])^2 + (d[2] - c[2])^2 = (ep[1] - b[1])^2 + (ep[2] - b[2])^2 = geo::distance_sq(b, ep)
    by def $geo::are_triangles_congruent(d, a, c, ep, c, b)
    ep[1] - d[1] = (ep[1] - b[1]) + (b[1] - c[1]) - (d[1] - c[1]) = (d[1] - c[1]) + (b[1] - c[1]) - (d[1] - c[1]) = b[1] - c[1]
    ep[2] - d[2] = (ep[2] - b[2]) + (b[2] - c[2]) - (d[2] - c[2]) = (d[2] - c[2]) + (b[2] - c[2]) - (d[2] - c[2]) = b[2] - c[2]
    by thm geo::distance_sq_coordinate_formula(d, ep)
    geo::distance_sq(d, ep) = (ep[1] - d[1])^2 + (ep[2] - d[2])^2 = (b[1] - c[1])^2 + (b[2] - c[2])^2 = geo::distance_sq(c, b)


# 第一问正式入口。
thm problem_473_part1:
    ? forall a, b, c, d, ep cart(R, R):
        # 【原题条件1】C是线段AB的中点。
        $geo::is_midpoint(c, a, b)
        # 【原题条件2】∠DAC=∠ECB。
        $geo::are_angles_congruent(d, a, c, ep, c, b)
        # 【原题条件3】CD∥BE。
        $geo::is_parallel(c, d, b, ep)
        # 【“如图”方向条件】D、E位于直线AB的同一侧。
        $translation::are_on_same_strict_side_of_line(a, b, d, ep)
        =>:
            # 【第一问结论】△DAC≌△ECB。
            $geo::are_triangles_congruent(d, a, c, ep, c, b)
    by thm problem_473_congruence_bridge(a, b, c, d, ep)

# 第二问正式入口。
thm problem_473_part2:
    ? forall a, b, c, d, ep cart(R, R):
        # 【原题条件1】C是线段AB的中点。
        $geo::is_midpoint(c, a, b)
        # 【原题条件2】∠DAC=∠ECB。
        $geo::are_angles_congruent(d, a, c, ep, c, b)
        # 【原题条件3】CD∥BE。
        $geo::is_parallel(c, d, b, ep)
        # 【“如图”方向条件】D、E位于直线AB的同一侧。
        $translation::are_on_same_strict_side_of_line(a, b, d, ep)
        # 【第二问已知】AB=16。
        sqrt(geo::distance_sq(a, b)) = 16
        =>:
            # 【第二问结论】DE=8。
            sqrt(geo::distance_sq(d, ep)) = 8

    by thm problem_473_congruence_bridge(a, b, c, d, ep)
    geo::distance_sq(d, ep) = geo::distance_sq(c, b)

    # 由第一问全等以及中点性质，得到CB²=AC²=AB²/4。
    by def $geo::are_triangles_congruent(d, a, c, ep, c, b)
    geo::distance_sq(a, c) = geo::distance_sq(c, b)
    by thm geo::midpoint_half_distance(a, b, c)
    geo::distance_sq(a, c) = geo::distance_sq(a, b) / 4
    geo::distance_sq(c, b) = geo::distance_sq(a, c) = geo::distance_sq(a, b) / 4

    # AB=16给出AB²=256，因而DE²=64。
    by thm geo::distance_sq_nonnegative(a, b)
    sqrt(geo::distance_sq(a, b))^2 = geo::distance_sq(a, b)
    sqrt(geo::distance_sq(a, b))^2 = 16^2 = 256
    geo::distance_sq(a, b) = 256
    geo::distance_sq(d, ep) = geo::distance_sq(c, b) = geo::distance_sq(a, b) / 4 = 256 / 4 = 64

    # 距离非负，所以由DE²=64唯一确定DE=8。
    by thm geo::distance_sq_nonnegative(d, ep)
    sqrt(geo::distance_sq(d, ep)) >= 0
    sqrt(geo::distance_sq(d, ep))^2 = geo::distance_sq(d, ep) = 64 = 8^2
    sqrt(geo::distance_sq(d, ep)) = 8
