# Problem 880: 等腰三角形全等证明（SAS方法）
# 题目：△ABC是等腰三角形，AB=AC，点D在AC上，E在AB上，BE=CD，求证：BD=CE

# 证明思路：
# 1. AB=AC, BE=CD => AE=AD (等腰三角形性质+减法)
# 2. 角BAD = 角CAE (共同角BAC)
# 3. AB=AC, AE=AD, 夹角相等 => 三角形BAD ≌ 三角形CAE (SAS)
# 4. 因此 BD=CE

# 非负实数的平方相等，则两数相等。
thm problem_880_same_nonnegative_square:
    ? forall x, y R:
        0 <= x,
        0 <= y,
        x^2 = y^2
        =>:
            x = y
    x^2 - y^2 = 0
    by thm geo::difference_of_squares(x, y)
    (x + y) * (x - y) = 0
    x = y or not x = y
    by cases:
        ? x = y
        case x = y:
            x = y
        case not x = y:
            x - y != 0
            (x - y) * (x + y) = 0
            by thm geo::zero_factor_law(x - y, x + y)
            x + y = 0
            x <= x + y = 0
            x = 0
            y <= x + y = 0
            y = 0
            x = y

thm problem_880_nondegenerate:
    ? forall a, b, c, d, pe cart(R, R):
        # 等腰三角形：AB = AC
        geo::distance_sq(a, b) = geo::distance_sq(a, c),
        # E在线段AB上
        $geo::is_on_segment(pe, a, b),
        # D在线段AC上
        $geo::is_on_segment(d, a, c),
        # BE = CD
        geo::distance_sq(b, pe) = geo::distance_sq(c, d),
        # 非退化分支
        a != b
        =>:
            # 结论：BD = CE
            geo::distance_sq(b, d) = geo::distance_sq(c, pe)

    # Step 1: 展开 is_on_segment 定义获取参数表示
    by def $geo::is_on_segment(pe, a, b)
    obtain t_e from exist t0 R st {0 <= t0, t0 <= 1, pe = (a[1] + t0 * (b[1] - a[1]), a[2] + t0 * (b[2] - a[2]))}
    pe[1] = a[1] + t_e * (b[1] - a[1])
    pe[2] = a[2] + t_e * (b[2] - a[2])
    0 <= t_e
    t_e <= 1
    
    by def $geo::is_on_segment(d, a, c)
    obtain t_d from exist t0 R st {0 <= t0, t0 <= 1, d = (a[1] + t0 * (c[1] - a[1]), a[2] + t0 * (c[2] - a[2]))}
    d[1] = a[1] + t_d * (c[1] - a[1])
    d[2] = a[2] + t_d * (c[2] - a[2])
    0 <= t_d
    t_d <= 1
    
    # Step 2: 计算AE和AD
    # AE² = |pe - a|²
    by thm geo::distance_sq_coordinate_formula(a, pe)
    geo::distance_sq(a, pe) = (pe[1] - a[1])^2 + (pe[2] - a[2])^2
    (pe[1] - a[1])^2 + (pe[2] - a[2])^2 = (t_e * (b[1] - a[1]))^2 + (t_e * (b[2] - a[2]))^2
    (t_e * (b[1] - a[1]))^2 + (t_e * (b[2] - a[2]))^2 = t_e^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    by thm geo::distance_sq_coordinate_formula(a, b)
    geo::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    t_e^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = t_e^2 * geo::distance_sq(a, b)
    geo::distance_sq(a, pe) = t_e^2 * geo::distance_sq(a, b)
    
    # AD² = |d - a|²
    by thm geo::distance_sq_coordinate_formula(a, d)
    geo::distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    (d[1] - a[1])^2 + (d[2] - a[2])^2 = (t_d * (c[1] - a[1]))^2 + (t_d * (c[2] - a[2]))^2
    (t_d * (c[1] - a[1]))^2 + (t_d * (c[2] - a[2]))^2 = t_d^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2)
    by thm geo::distance_sq_coordinate_formula(a, c)
    geo::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    t_d^2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) = t_d^2 * geo::distance_sq(a, c)
    geo::distance_sq(a, d) = t_d^2 * geo::distance_sq(a, c)
    
    # Step 3: 利用AB=AC得到AE²=AD²的关系
    # 由于AB²=AC²，所以 AE² = t_e²·AB² 和 AD² = t_d²·AC² = t_d²·AB²
    t_e^2 * geo::distance_sq(a, b) = t_e^2 * geo::distance_sq(a, c)
    t_d^2 * geo::distance_sq(a, c) = t_d^2 * geo::distance_sq(a, b)
    
    # Step 4: 计算BE和CD
    # BE² = |b - pe|²
    by thm geo::distance_sq_coordinate_formula(b, pe)
    geo::distance_sq(b, pe) = (pe[1] - b[1])^2 + (pe[2] - b[2])^2
    pe[1] - b[1] = a[1] + t_e * (b[1] - a[1]) - b[1]
    a[1] + t_e * (b[1] - a[1]) - b[1] = a[1] - b[1] + t_e * (b[1] - a[1])
    a[1] - b[1] + t_e * (b[1] - a[1]) = (1 - t_e) * (a[1] - b[1])
    pe[1] - b[1] = (1 - t_e) * (a[1] - b[1])
    
    pe[2] - b[2] = a[2] + t_e * (b[2] - a[2]) - b[2]
    a[2] + t_e * (b[2] - a[2]) - b[2] = a[2] - b[2] + t_e * (b[2] - a[2])
    a[2] - b[2] + t_e * (b[2] - a[2]) = (1 - t_e) * (a[2] - b[2])
    pe[2] - b[2] = (1 - t_e) * (a[2] - b[2])
    
    (pe[1] - b[1])^2 + (pe[2] - b[2])^2 = ((1 - t_e) * (a[1] - b[1]))^2 + ((1 - t_e) * (a[2] - b[2]))^2
    ((1 - t_e) * (a[1] - b[1]))^2 + ((1 - t_e) * (a[2] - b[2]))^2 = (1 - t_e)^2 * ((a[1] - b[1])^2 + (a[2] - b[2])^2)
    (1 - t_e)^2 * ((a[1] - b[1])^2 + (a[2] - b[2])^2) = (1 - t_e)^2 * geo::distance_sq(a, b)
    geo::distance_sq(b, pe) = (1 - t_e)^2 * geo::distance_sq(a, b)
    
    # CD² = |c - d|²
    by thm geo::distance_sq_coordinate_formula(c, d)
    geo::distance_sq(c, d) = (d[1] - c[1])^2 + (d[2] - c[2])^2
    d[1] - c[1] = a[1] + t_d * (c[1] - a[1]) - c[1]
    a[1] + t_d * (c[1] - a[1]) - c[1] = a[1] - c[1] + t_d * (c[1] - a[1])
    a[1] - c[1] + t_d * (c[1] - a[1]) = (1 - t_d) * (a[1] - c[1])
    d[1] - c[1] = (1 - t_d) * (a[1] - c[1])
    
    d[2] - c[2] = a[2] + t_d * (c[2] - a[2]) - c[2]
    a[2] + t_d * (c[2] - a[2]) - c[2] = a[2] - c[2] + t_d * (c[2] - a[2])
    a[2] - c[2] + t_d * (c[2] - a[2]) = (1 - t_d) * (a[2] - c[2])
    d[2] - c[2] = (1 - t_d) * (a[2] - c[2])
    
    (d[1] - c[1])^2 + (d[2] - c[2])^2 = ((1 - t_d) * (a[1] - c[1]))^2 + ((1 - t_d) * (a[2] - c[2]))^2
    ((1 - t_d) * (a[1] - c[1]))^2 + ((1 - t_d) * (a[2] - c[2]))^2 = (1 - t_d)^2 * ((a[1] - c[1])^2 + (a[2] - c[2])^2)
    (1 - t_d)^2 * ((a[1] - c[1])^2 + (a[2] - c[2])^2) = (1 - t_d)^2 * geo::distance_sq(a, c)
    geo::distance_sq(c, d) = (1 - t_d)^2 * geo::distance_sq(a, c)
    
    # Step 5: 从BE²=CD²和AB²=AC²推出t_e=t_d
    # BE² = (1-t_e)²·AB², CD² = (1-t_d)²·AC² = (1-t_d)²·AB²
    # 因此 (1-t_e)²·AB² = (1-t_d)²·AB²
    (1 - t_e)^2 * geo::distance_sq(a, b) = geo::distance_sq(b, pe)
    (1 - t_d)^2 * geo::distance_sq(a, c) = geo::distance_sq(c, d)
    (1 - t_d)^2 * geo::distance_sq(a, c) = (1 - t_d)^2 * geo::distance_sq(a, b)
    geo::distance_sq(c, d) = (1 - t_d)^2 * geo::distance_sq(a, b)
    geo::distance_sq(b, pe) = (1 - t_d)^2 * geo::distance_sq(a, b)
    (1 - t_e)^2 * geo::distance_sq(a, b) = (1 - t_d)^2 * geo::distance_sq(a, b)
    
    # 从(1-t_e)²·|AB|² = (1-t_d)²·|AB|²推出(1-t_e)² = (1-t_d)²
    by thm geo::distance_sq_positive_of_ne(a, b)
    0 < geo::distance_sq(a, b)
    geo::distance_sq(a, b) != 0
    by thm geo::divide_both_sides((1 - t_e)^2, (1 - t_d)^2, geo::distance_sq(a, b))
    (1 - t_e)^2 = (1 - t_d)^2
    
    # 从(1-t_e)² = (1-t_d)²和0≤t_e,t_d≤1推出1-t_e = 1-t_d（因为两者都非负）
    # 因此t_e = t_d
    0 <= 1 - t_e
    0 <= 1 - t_d
    by thm problem_880_same_nonnegative_square(1 - t_e, 1 - t_d)
    1 - t_e = 1 - t_d
    t_e = t_e - (1 - t_e) + (1 - t_e) = t_e - 1 + 1 = t_e
    t_d = t_d - (1 - t_d) + (1 - t_d) = t_d - 1 + 1 = t_d
    t_e = 1 - (1 - t_e) = 1 - (1 - t_d) = t_d
    t_e = t_d
    
    # Step 6: 利用t_e=t_d证明AE=AD
    # 重新计算AE²，现在用t_d表示
    by thm geo::distance_sq_coordinate_formula(a, pe)
    geo::distance_sq(a, pe) = (pe[1] - a[1])^2 + (pe[2] - a[2])^2
    (pe[1] - a[1])^2 + (pe[2] - a[2])^2 = (t_e * (b[1] - a[1]))^2 + (t_e * (b[2] - a[2]))^2
    (t_e * (b[1] - a[1]))^2 + (t_e * (b[2] - a[2]))^2 = t_e^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
    t_e^2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) = t_e^2 * geo::distance_sq(a, b)
    geo::distance_sq(a, pe) = t_e^2 * geo::distance_sq(a, b)
    t_e^2 * geo::distance_sq(a, b) = t_d^2 * geo::distance_sq(a, b)
    geo::distance_sq(a, pe) = t_d^2 * geo::distance_sq(a, b)
    t_d^2 * geo::distance_sq(a, b) = t_d^2 * geo::distance_sq(a, c)
    t_d^2 * geo::distance_sq(a, c) = geo::distance_sq(a, d)
    geo::distance_sq(a, pe) = geo::distance_sq(a, d)
    
    # Step 7: 使用SAS全等定理
    # 三角形BAD和CAE满足：
    # - AB = AC (给定)
    # - AD = AE (刚证明)
    # - 角BAD = 角CAE (共同角)
    # 需要证明角相等和应用SAS
    
    # 角BAD的余弦值
    # dot(vec(a,b), vec(a,d)) = (b-a)·(d-a)
    geo::dot(geo::vec(a, b), geo::vec(a, d)) = (b[1] - a[1]) * (d[1] - a[1]) + (b[2] - a[2]) * (d[2] - a[2])
    (b[1] - a[1]) * (d[1] - a[1]) + (b[2] - a[2]) * (d[2] - a[2]) = (b[1] - a[1]) * (t_d * (c[1] - a[1])) + (b[2] - a[2]) * (t_d * (c[2] - a[2]))
    (b[1] - a[1]) * (t_d * (c[1] - a[1])) + (b[2] - a[2]) * (t_d * (c[2] - a[2])) = t_d * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2]))
    geo::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    geo::vec(a, c) = (c[1] - a[1], c[2] - a[2])
    geo::dot(geo::vec(a, b), geo::vec(a, c)) = (b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])
    t_d * ((b[1] - a[1]) * (c[1] - a[1]) + (b[2] - a[2]) * (c[2] - a[2])) = t_d * geo::dot(geo::vec(a, b), geo::vec(a, c))
    geo::dot(geo::vec(a, b), geo::vec(a, d)) = t_d * geo::dot(geo::vec(a, b), geo::vec(a, c))
    
    # 角CAE的余弦值
    # dot(vec(a,c), vec(a,pe)) = (c-a)·(pe-a)
    geo::dot(geo::vec(a, c), geo::vec(a, pe)) = (c[1] - a[1]) * (pe[1] - a[1]) + (c[2] - a[2]) * (pe[2] - a[2])
    (c[1] - a[1]) * (pe[1] - a[1]) + (c[2] - a[2]) * (pe[2] - a[2]) = (c[1] - a[1]) * (t_e * (b[1] - a[1])) + (c[2] - a[2]) * (t_e * (b[2] - a[2]))
    (c[1] - a[1]) * (t_e * (b[1] - a[1])) + (c[2] - a[2]) * (t_e * (b[2] - a[2])) = t_e * ((c[1] - a[1]) * (b[1] - a[1]) + (c[2] - a[2]) * (b[2] - a[2]))
    geo::vec(a, c) = (c[1] - a[1], c[2] - a[2])
    geo::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    geo::dot(geo::vec(a, c), geo::vec(a, b)) = (c[1] - a[1]) * (b[1] - a[1]) + (c[2] - a[2]) * (b[2] - a[2])
    t_e * ((c[1] - a[1]) * (b[1] - a[1]) + (c[2] - a[2]) * (b[2] - a[2])) = t_e * geo::dot(geo::vec(a, c), geo::vec(a, b))
    geo::dot(geo::vec(a, c), geo::vec(a, pe)) = t_e * geo::dot(geo::vec(a, c), geo::vec(a, b))
    
    # 由t_e=t_d和点积交换律，得到角相等的条件
    t_e * geo::dot(geo::vec(a, c), geo::vec(a, b)) = t_d * geo::dot(geo::vec(a, c), geo::vec(a, b))
    by thm geo::dot_symmetric(geo::vec(a, b), geo::vec(a, c))
    geo::dot(geo::vec(a, b), geo::vec(a, c)) = geo::dot(geo::vec(a, c), geo::vec(a, b))
    t_d * geo::dot(geo::vec(a, c), geo::vec(a, b)) = t_d * geo::dot(geo::vec(a, b), geo::vec(a, c))
    geo::dot(geo::vec(a, c), geo::vec(a, pe)) = t_d * geo::dot(geo::vec(a, b), geo::vec(a, c))
    t_d * geo::dot(geo::vec(a, b), geo::vec(a, c)) = geo::dot(geo::vec(a, b), geo::vec(a, d))
    geo::dot(geo::vec(a, c), geo::vec(a, pe)) = geo::dot(geo::vec(a, b), geo::vec(a, d))
    
    # 现在应用SAS定理：两边和夹角相等
    # SAS定理签名: sas_third_side(p, q, r, u, v, w)
    # 要求: distance_sq(p,q)=distance_sq(u,v), distance_sq(q,r)=distance_sq(v,w), dot(vec(q,p),vec(q,r))=dot(vec(v,u),vec(v,w))
    # 结论: distance_sq(p,r)=distance_sq(u,w)
    #
    # 三角形BAD: 中心A, 边AB、AD, 第三边BD
    # 三角形CAE: 中心A, 边AC、AE, 第三边CE
    # 参数映射: p=b, q=a, r=d, u=c, v=a, w=pe
    # 前提1: distance_sq(b,a) = distance_sq(c,a) ✓ (AB=AC)
    # 前提2: distance_sq(a,d) = distance_sq(a,pe) ✓ (AD=AE)
    # 前提3: dot(vec(a,b), vec(a,d)) = dot(vec(a,c), vec(a,pe)) ✓ (角BAD=角CAE)
    # 结论: distance_sq(b,d) = distance_sq(c,pe) (BD=CE)
    by thm geo::distance_sq_symmetric(a, b)
    geo::distance_sq(a, b) = geo::distance_sq(b, a)
    by thm geo::distance_sq_symmetric(a, c)
    geo::distance_sq(a, c) = geo::distance_sq(c, a)
    geo::distance_sq(b, a) = geo::distance_sq(a, b) = geo::distance_sq(a, c) = geo::distance_sq(c, a)
    geo::distance_sq(a, d) = geo::distance_sq(a, pe)
    geo::dot(geo::vec(a, b), geo::vec(a, d)) = geo::dot(geo::vec(a, c), geo::vec(a, pe))
    
    by thm geo::sas_third_side(b, a, d, c, a, pe)
    geo::distance_sq(b, d) = geo::distance_sq(c, pe)


# 原题公开定理：使用语义谓词，忠实反映原题自然语言结构。
# 翻译时不做推理展开，让谓词定义自动展开。
thm problem_880:
    ? forall a, b, c, d, pe cart(R, R):
        # 原题："△ABC是等腰三角形"（顶点A，两腰AB、AC）
        $geo::is_isosceles(a, b, c),
        # 原题："点E在腰AB上"
        $geo::is_on_segment(pe, a, b),
        # 原题："点D在腰AC上"
        $geo::is_on_segment(d, a, c),
        # 原题："BE = CD"
        $geo::are_segments_congruent(b, pe, c, d)
        =>:
            # 原题要求证明："BD = CE"
            $geo::are_segments_congruent(b, d, c, pe)

    # 展开等腰三角形谓词：is_triangle + are_segments_congruent(AB, AC)
    by def $geo::is_isosceles(a, b, c)
    $geo::is_triangle(a, b, c)
    $geo::are_segments_congruent(a, b, a, c)
    
    # 展开线段全等谓词：AB = AC
    by def $geo::are_segments_congruent(a, b, a, c)
    geo::distance_sq(a, b) = geo::distance_sq(a, c)
    
    # 展开线段全等谓词：BE = CD
    by def $geo::are_segments_congruent(b, pe, c, d)
    geo::distance_sq(b, pe) = geo::distance_sq(c, d)
    
    # is_on_segment(pe, a, b) 的定义保证 a != b（无需退化处理）
    by def $geo::is_on_segment(pe, a, b)
    a != b
    
    # 调用已验证的非退化引理
    by thm problem_880_nondegenerate(a, b, c, d, pe)
    geo::distance_sq(b, d) = geo::distance_sq(c, pe)
    
    # 反向包装为线段全等谓词：BD = CE
    by def $geo::are_segments_congruent(b, d, c, pe)
    $geo::are_segments_congruent(b, d, c, pe)
