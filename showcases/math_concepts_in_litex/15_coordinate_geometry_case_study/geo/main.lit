# thm orthocenter_third_altitude:
#     ? forall a, b, c, h cart(R, R):
#         (h[1] - a[1]) * (c[1] - b[1]) + (h[2] - a[2]) * (c[2] - b[2]) = 0
#         (h[1] - b[1]) * (c[1] - a[1]) + (h[2] - b[2]) * (c[2] - a[2]) = 0
#         =>:
#             (h[1] - c[1]) * (b[1] - a[1]) + (h[2] - c[2]) * (b[2] - a[2]) = 0
#     (h[1] - c[1]) * (b[1] - a[1]) + (h[2] - c[2]) * (b[2] - a[2]) = 0

# Predicate form: equal radii from a common center imply equal radii for the remaining pair.
thm circumcenter_equidistant_triple:
    ? forall a, b, c, o cart(R, R):
        $are_segments_congruent(o, a, o, b)
        $are_segments_congruent(o, a, o, c)
        =>:
            $are_segments_congruent(o, b, o, c)
    by def $are_segments_congruent(o, a, o, b)
    by def $are_segments_congruent(o, a, o, c)
    by def $are_segments_congruent(o, b, o, c)
    by thm segments_congruent_symmetric(o, a, o, b)
    by thm segments_congruent_transitive(o, b, o, a, o, c)

# Equal opposite directed sides imply that the diagonals have the same midpoint.
# The public conclusion uses the existing midpoint predicate; coordinates remain
# only as the internal algebraic bridge from the directed-side hypotheses.
thm parallelogram_midpoint_diagonals:
    ? forall a, b, c, d cart(R, R):
        (b[1] - a[1]) - (c[1] - d[1]) = 0,
        (b[2] - a[2]) - (c[2] - d[2]) = 0
        =>:
            exist m cart(R, R) st {$is_midpoint(m, a, c), $is_midpoint(m, b, d)}
    b[1] - a[1] = c[1] - d[1]
    by thm add_equalities(b[1] - a[1], c[1] - d[1], a[1] + d[1], a[1] + d[1])
    (b[1] - a[1]) + (a[1] + d[1]) = b[1] + d[1]
    (c[1] - d[1]) + (a[1] + d[1]) = a[1] + c[1]
    a[1] + c[1] = (c[1] - d[1]) + (a[1] + d[1]) = (b[1] - a[1]) + (a[1] + d[1]) = b[1] + d[1]
    (a[1] + c[1]) / 2 = (b[1] + d[1]) / 2
    (a[1] + c[1]) / 2 - (b[1] + d[1]) / 2 = 0
    b[2] - a[2] = c[2] - d[2]
    by thm add_equalities(b[2] - a[2], c[2] - d[2], a[2] + d[2], a[2] + d[2])
    (b[2] - a[2]) + (a[2] + d[2]) = b[2] + d[2]
    (c[2] - d[2]) + (a[2] + d[2]) = a[2] + c[2]
    a[2] + c[2] = (c[2] - d[2]) + (a[2] + d[2]) = (b[2] - a[2]) + (a[2] + d[2]) = b[2] + d[2]
    (a[2] + c[2]) / 2 = (b[2] + d[2]) / 2
    witness exist m cart(R, R) st {$is_midpoint(m, a, c), $is_midpoint(m, b, d)} from ((a[1] + c[1]) / 2, (a[2] + c[2]) / 2):
        m = ((a[1] + c[1]) / 2, (a[2] + c[2]) / 2)
        m[1] = (a[1] + c[1]) / 2 = (b[1] + d[1]) / 2
        m[2] = (a[2] + c[2]) / 2 = (b[2] + d[2]) / 2
        by thm tuple_equal_from_coordinates(m, (m[1], m[2]))
        (m[1], m[2]) = ((b[1] + d[1]) / 2, (b[2] + d[2]) / 2)
        m = (m[1], m[2]) = ((b[1] + d[1]) / 2, (b[2] + d[2]) / 2)
        $is_midpoint(m, a, c)
        $is_midpoint(m, b, d)

# reflection: if B = 2M - A (reflection of A over M), then |MA| = |MB|
thm reflection_equidistant:
    ? forall a, m cart(R, R):
        =>:
            (m[1] - a[1])^2 + (m[2] - a[2])^2 = (m[1] - (2*m[1] - a[1]))^2 + (m[2] - (2*m[2] - a[2]))^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = (m[1] - (2*m[1] - a[1]))^2 + (m[2] - (2*m[2] - a[2]))^2

# Predicate form: three points equidistant from a common center imply the fourth pair is equidistant.
thm concyclic_fourth_point:
    ? forall a, b, c, d, o cart(R, R):
        $are_segments_congruent(o, a, o, b)
        $are_segments_congruent(o, a, o, c)
        $are_segments_congruent(o, a, o, d)
        =>:
            $are_segments_congruent(o, c, o, d)
    by def $are_segments_congruent(o, a, o, b)
    by def $are_segments_congruent(o, a, o, c)
    by def $are_segments_congruent(o, a, o, d)
    by def $are_segments_congruent(o, c, o, d)
    by thm segments_congruent_symmetric(o, a, o, c)
    by thm segments_congruent_transitive(o, c, o, a, o, d)


thm perp_dot_zero_coordinate:
    ? forall a, b, c, d cart(R, R):
        $is_perpendicular(a, b, c, d)
        =>:
            (b[1] - a[1]) * (d[1] - c[1]) = -(b[2] - a[2]) * (d[2] - c[2])
    by def $is_perpendicular(a, b, c, d)
    by thm vec_coordinate_formula(a, b)
    by thm vec_coordinate_formula(c, d)
    by thm dot_coordinate_formula(vec(a, b), vec(c, d))
    dot(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]) = 0
    (b[2] - a[2]) * (d[2] - c[2]) + (b[1] - a[1]) * (d[1] - c[1]) = 0
    by thm zero_sum_rearrange((b[2] - a[2]) * (d[2] - c[2]), (b[1] - a[1]) * (d[1] - c[1]))
    -((b[2] - a[2]) * (d[2] - c[2])) = (b[1] - a[1]) * (d[1] - c[1])
    (b[1] - a[1]) * (d[1] - c[1]) = -(b[2] - a[2]) * (d[2] - c[2])

# Pythagorean: right angle at P => |PA|^2 + |PB|^2 = |AB|^2
thm perpendicular_implies_distance_sum:
    ? forall a, b, p cart(R, R):
        (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2]) = 0
        =>:
            (p[1] - a[1])^2 + (p[2] - a[2])^2 + (p[1] - b[1])^2 + (p[2] - b[2])^2 = (b[1] - a[1])^2 + (b[2] - a[2])^2
    vec(p, a) = (a[1] - p[1], a[2] - p[2])
    vec(p, b) = (b[1] - p[1], b[2] - p[2])
    dot(vec(p, a), vec(p, b)) = (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2])
    dot(vec(p, a), vec(p, b)) = 0
    by thm pythagorean_theorem(a, p, b)
    distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2
    distance_sq(p, b) = (b[1] - p[1])^2 + (b[2] - p[2])^2
    distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (b[1] - p[1])^2 + (b[2] - p[2])^2 = (p[1] - b[1])^2 + (p[2] - b[2])^2
    distance_sq(a, p) + distance_sq(p, b) = (p[1] - a[1])^2 + (p[2] - a[2])^2 + distance_sq(p, b)
    (p[1] - a[1])^2 + (p[2] - a[2])^2 + distance_sq(p, b) = (p[1] - a[1])^2 + (p[2] - a[2])^2 + (b[1] - p[1])^2 + (b[2] - p[2])^2
    distance_sq(a, p) + distance_sq(p, b) = (p[1] - a[1])^2 + (p[2] - a[2])^2 + (b[1] - p[1])^2 + (b[2] - p[2])^2
    (p[1] - a[1])^2 + (p[2] - a[2])^2 + (b[1] - p[1])^2 + (b[2] - p[2])^2 = (p[1] - a[1])^2 + (p[2] - a[2])^2 + (p[1] - b[1])^2 + (p[2] - b[2])^2
    distance_sq(a, p) + distance_sq(p, b) = (p[1] - a[1])^2 + (p[2] - a[2])^2 + (p[1] - b[1])^2 + (p[2] - b[2])^2
    distance_sq(a, b) = distance_sq(a, p) + distance_sq(p, b)
    (p[1] - a[1])^2 + (p[2] - a[2])^2 + (p[1] - b[1])^2 + (p[2] - b[2])^2 = (b[1] - a[1])^2 + (b[2] - a[2])^2

# Wu's circle quartic consequence, using the unit-circle predicate.
thm wu_circle_quartic:
    ? forall p cart(R, R):
        $is_on_circle(p, (0, 0), 1)
        =>:
            p[1]^4 + 2 * p[1]^2 * p[2]^2 + p[2]^4 - 1 = 0
    by def $is_on_circle(p, (0, 0), 1)
    by thm distance_sq_coordinate_formula(p, (0, 0))
    distance_sq(p, (0, 0)) = (0 - p[1])^2 + (0 - p[2])^2
    (0 - p[1])^2 + (0 - p[2])^2 = p[1]^2 + p[2]^2
    p[1]^2 + p[2]^2 = 1
    by thm multiply_both_sides(p[1]^2 + p[2]^2, 1, p[1]^2 + p[2]^2)
    (p[1]^2 + p[2]^2) * (p[1]^2 + p[2]^2) = 1 * (p[1]^2 + p[2]^2)
    1 * (p[1]^2 + p[2]^2) = 1
    (p[1]^2 + p[2]^2) * (p[1]^2 + p[2]^2) = 1
    (p[1]^2 + p[2]^2) * (p[1]^2 + p[2]^2) = p[1]^4 + 2 * p[1]^2 * p[2]^2 + p[2]^4
    p[1]^4 + 2 * p[1]^2 * p[2]^2 + p[2]^4 = 1
    p[1]^4 + 2 * p[1]^2 * p[2]^2 + p[2]^4 - 1 = 0
# ═══════════════════════════════════════════════════════════════════════
# SECTION 4: PREDICATE THEOREMS (from predicate_laws.lit)
# ═══════════════════════════════════════════════════════════════════════
# 高层谓词定理：中点性质、勾股定理谓词版、对称性定理等


# ═══════════════════════════════════════════════════════════════════════
# SECTION 4: PREDICATE LAWS (from predicate_laws.lit)
# ═══════════════════════════════════════════════════════════════════════
# 谓词桥接定理：连接高层谓词和坐标定理

# Predicate-level theorems bridging high-level props to analytic_laws.
# 前提和结论都用谓词表达，证明内部展开谓词并调用坐标定理。

# ═══════════════════════════════════════════════════════════════════════
# Midpoint
# ═══════════════════════════════════════════════════════════════════════

# M是AB中点 → MA = MB
thm midpoint_equidistant_prop:
    ? forall a, b, m cart(R, R):
        $is_midpoint(m, a, b)
        =>:
            $are_segments_congruent(m, a, m, b)
    m[1] = (a[1] + b[1]) / 2
    m[2] = (a[2] + b[2]) / 2
    by thm midpoint_equidistant(a, b, m)
    by thm distance_sq_symmetric(a, m)
    by thm distance_sq_symmetric(b, m)
    distance_sq(m, a) = distance_sq(a, m) = distance_sq(b, m) = distance_sq(m, b)

# M是AB中点 → A,M,B共线
thm midpoint_collinear_prop:
    ? forall a, b, m cart(R, R):
        $is_midpoint(m, a, b)
        =>:
            $is_collinear(a, m, b)
    m[1] = (a[1] + b[1]) / 2
    m[2] = (a[2] + b[2]) / 2
    by thm collinear_midpoint(a, b, m)

# ═══════════════════════════════════════════════════════════════════════
# Pythagorean / Right angle
# ═══════════════════════════════════════════════════════════════════════

# 角B直角 → AC² = AB² + BC²
thm pythagorean_prop:
    ? forall a, b, c cart(R, R):
        $is_right_angle(a, b, c)
        =>:
            distance_sq(a, c) = distance_sq(a, b) + distance_sq(b, c)
    by thm pythagorean_theorem(a, b, c)

# ═══════════════════════════════════════════════════════════════════════
# Collinearity
# ═══════════════════════════════════════════════════════════════════════

# 共线对称：P,Q,R共线 → Q,P,R共线
thm collinear_symmetric_prop:
    ? forall p, q, r cart(R, R):
        $is_collinear(p, q, r)
        =>:
            $is_collinear(q, p, r)
    by thm collinear_symmetric(p, q, r)

# ═══════════════════════════════════════════════════════════════════════
# Perpendicular / Right angle
# ═══════════════════════════════════════════════════════════════════════

# 垂直对称：AB⊥CD → CD⊥AB
thm perpendicular_symmetric_prop:
    ? forall a, b, c, d cart(R, R):
        $is_perpendicular(a, b, c, d)
        =>:
            $is_perpendicular(c, d, a, b)
    by thm perpendicular_symmetric(a, b, c, d)

# ═══════════════════════════════════════════════════════════════════════
# Parallel
# ═══════════════════════════════════════════════════════════════════════

# 平行对称：AB∥CD → CD∥AB
thm parallel_symmetric_prop:
    ? forall a, b, c, d cart(R, R):
        $is_parallel(a, b, c, d)
        =>:
            $is_parallel(c, d, a, b)
    by thm parallel_symmetric(a, b, c, d)

# ═══════════════════════════════════════════════════════════════════════
# Segment congruence
# ═══════════════════════════════════════════════════════════════════════

# 线段全等对称
thm segments_congruent_symmetric_prop:
    ? forall a, b, c, d cart(R, R):
        $are_segments_congruent(a, b, c, d)
        =>:
            $are_segments_congruent(c, d, a, b)
    by thm segments_congruent_symmetric(a, b, c, d)

# 线段全等传递
thm segments_congruent_transitive_prop:
    ? forall a, b, c, d, p, q cart(R, R):
        $are_segments_congruent(a, b, c, d),
        $are_segments_congruent(c, d, p, q)
        =>:
            $are_segments_congruent(a, b, p, q)
    by thm segments_congruent_transitive(a, b, c, d, p, q)

# 线段全等自反
thm segments_congruent_reflexive_prop:
    ? forall a, b cart(R, R):
        =>:
            $are_segments_congruent(a, b, a, b)
    by thm segments_congruent_reflexive(a, b)

# Bridge theorem: distance_sq equality → segments congruent
thm segments_congruent_from_distance_sq:
    ? forall a, b, c, d cart(R, R):
        distance_sq(a, b) = distance_sq(c, d)
        =>:
            $are_segments_congruent(a, b, c, d)
    distance_sq(a, b) = distance_sq(c, d)

# distance_sq 对称：|AB|=|BA|
thm distance_sq_symmetric_prop:
    ? forall a, b cart(R, R):
        =>:
            $are_segments_congruent(a, b, b, a)
    by thm distance_sq_symmetric(a, b)

# ═══════════════════════════════════════════════════════════════════════
# Isosceles triangle
# ═══════════════════════════════════════════════════════════════════════

# 等腰三角形底角dot相等：AB=AC → dot(BA,BC) = dot(CA,CB)
thm isosceles_base_dot_prop:
    ? forall a, b, c cart(R, R):
        $are_segments_congruent(a, b, a, c)
        =>:
            dot(vec(b, a), vec(b, c)) = dot(vec(c, a), vec(c, b))
    by thm isosceles_base_dot(a, b, c)

# ═══════════════════════════════════════════════════════════════════════
# SSS (三边相等 → dot相等，即角相等的坐标表达)
# ═══════════════════════════════════════════════════════════════════════

# SSS: PQ=UV, QR=VW, PR=UW → dot(QP,QR) = dot(VU,VW)
thm sss_dot_equal_prop:
    ? forall p, q, r, u, v, w cart(R, R):
        $are_segments_congruent(p, q, u, v),
        $are_segments_congruent(q, r, v, w),
        $are_segments_congruent(p, r, u, w)
        =>:
            dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
    by thm sss_dot_equal(p, q, r, u, v, w)

# ═══════════════════════════════════════════════════════════════════════
# SAS (两边+夹角 → 第三边)
# ═══════════════════════════════════════════════════════════════════════

# SAS: PQ=UV, QR=VW, dot(QP,QR)=dot(VU,VW) → PR=UW
thm sas_third_side_prop:
    ? forall p, q, r, u, v, w cart(R, R):
        $are_segments_congruent(p, q, u, v),
        $are_segments_congruent(q, r, v, w),
        dot(vec(q, p), vec(q, r)) = dot(vec(v, u), vec(v, w))
        =>:
            $are_segments_congruent(p, r, u, w)
    by thm sas_third_side(p, q, r, u, v, w)

# ═══════════════════════════════════════════════════════════════════════
# Cosine law / dot-distance 关系
# ═══════════════════════════════════════════════════════════════════════

# 余弦定理：PR² = PQ² + QR² - 2·dot(QP,QR)
thm cosine_law_prop:
    ? forall p, q, r cart(R, R):
        distance_sq(p, r) = distance_sq(p, q) + distance_sq(q, r) - 2 * dot(vec(q, p), vec(q, r))
    by thm cosine_law(p, q, r)

# dot用距离表达：dot(QP,QR) = (PQ²+QR²-PR²)/2
thm dot_from_cosine_law_prop:
    ? forall p, q, r cart(R, R):
        dot(vec(q, p), vec(q, r)) = (distance_sq(p, q) + distance_sq(q, r) - distance_sq(p, r)) / 2
    by thm dot_from_cosine_law(p, q, r)

# ═══════════════════════════════════════════════════════════════════════
# Median (中线长)
# ═══════════════════════════════════════════════════════════════════════

# M是BC中点 → 4AM² = 2AB² + 2AC² - BC²
thm median_length_prop:
    ? forall a, b, c, m cart(R, R):
        $is_midpoint(m, b, c)
        =>:
            4 * distance_sq(a, m) = 2 * distance_sq(a, b) + 2 * distance_sq(a, c) - distance_sq(b, c)
    m[1] = (b[1] + c[1]) / 2
    m[2] = (b[2] + c[2]) / 2
    by thm median_length(a, b, c, m)

# ═══════════════════════════════════════════════════════════════════════
# Collinear (more)
# ═══════════════════════════════════════════════════════════════════════

# 共线第三形式：P,Q,R共线 → R,P,Q共线
thm collinear_third_prop:
    ? forall p, q, r cart(R, R):
        $is_collinear(p, q, r)
        =>:
            $is_collinear(r, p, q)
    by thm collinear_third(p, q, r)

# ═══════════════════════════════════════════════════════════════════════
# Thales (直径上圆周角=90°)
# ═══════════════════════════════════════════════════════════════════════

thm thales_theorem_prop:
    ? forall a, b, p, o cart(R, R):
        $is_midpoint(o, a, b),
        $are_segments_congruent(o, p, o, a),
        a != p,
        b != p
        =>:
            $is_right_angle(a, p, b)
    by def $is_midpoint(o, a, b)
    by def $are_segments_congruent(o, p, o, a)
    by thm distance_sq_coordinate_formula(o, p)
    by thm distance_sq_coordinate_formula(o, a)
    distance_sq(o, p) = distance_sq(o, a)
    (p[1] - o[1])^2 + (p[2] - o[2])^2 = (a[1] - o[1])^2 + (a[2] - o[2])^2
    ((p[1] - o[1])^2 + (p[2] - o[2])^2) - ((a[1] - o[1])^2 + (a[2] - o[2])^2) = ((a[1] - o[1])^2 + (a[2] - o[2])^2) - ((a[1] - o[1])^2 + (a[2] - o[2])^2)
    ((a[1] - o[1])^2 + (a[2] - o[2])^2) - ((a[1] - o[1])^2 + (a[2] - o[2])^2) = 0
    ((p[1] - o[1])^2 + (p[2] - o[2])^2) - ((a[1] - o[1])^2 + (a[2] - o[2])^2) = 0
    (p[1] - o[1])^2 + (p[2] - o[2])^2 = (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2
    (a[1] - o[1])^2 + (a[2] - o[2])^2 = (a[1] - (a[1] + b[1]) / 2)^2 + (a[2] - (a[2] + b[2]) / 2)^2
    by thm subtract_equalities((p[1] - o[1])^2 + (p[2] - o[2])^2, (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2, (a[1] - o[1])^2 + (a[2] - o[2])^2, (a[1] - (a[1] + b[1]) / 2)^2 + (a[2] - (a[2] + b[2]) / 2)^2)
    ((p[1] - o[1])^2 + (p[2] - o[2])^2) - ((a[1] - o[1])^2 + (a[2] - o[2])^2) = ((p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2) - ((a[1] - (a[1] + b[1]) / 2)^2 + (a[2] - (a[2] + b[2]) / 2)^2)
    ((p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2) - ((a[1] - (a[1] + b[1]) / 2)^2 + (a[2] - (a[2] + b[2]) / 2)^2) = 0
    (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
    by thm thales_theorem(a, b, p)
    by def $is_right_angle(a, p, b)

thm double_midpoint_equal_sides:
    ? forall a, b, c, d, f cart(R, R):
        $is_midpoint(d, b, c),
        $is_midpoint(d, a, f)
        =>:
            distance_sq(a, c) = distance_sq(b, f)
    by def $is_midpoint(d, b, c)
    by def $is_midpoint(d, a, f)
    d[1] = (b[1] + c[1]) / 2
    d[2] = (b[2] + c[2]) / 2
    d[1] = (a[1] + f[1]) / 2
    d[2] = (a[2] + f[2]) / 2
    (b[1] + c[1]) / 2 = (a[1] + f[1]) / 2
    by thm multiply_both_sides((b[1] + c[1]) / 2, (a[1] + f[1]) / 2, 2)
    ((b[1] + c[1]) / 2) * 2 = b[1] + c[1]
    ((a[1] + f[1]) / 2) * 2 = a[1] + f[1]
    b[1] + c[1] = ((b[1] + c[1]) / 2) * 2 = ((a[1] + f[1]) / 2) * 2 = a[1] + f[1]
    f[1] = (a[1] + f[1]) - a[1] = (b[1] + c[1]) - a[1]
    (b[2] + c[2]) / 2 = (a[2] + f[2]) / 2
    by thm multiply_both_sides((b[2] + c[2]) / 2, (a[2] + f[2]) / 2, 2)
    ((b[2] + c[2]) / 2) * 2 = b[2] + c[2]
    ((a[2] + f[2]) / 2) * 2 = a[2] + f[2]
    b[2] + c[2] = ((b[2] + c[2]) / 2) * 2 = ((a[2] + f[2]) / 2) * 2 = a[2] + f[2]
    f[2] = (a[2] + f[2]) - a[2] = (b[2] + c[2]) - a[2]
    by thm parallelogram_sides(b, a, c, f)
    distance_sq(b, f) = distance_sq(a, c)
    distance_sq(a, c) = distance_sq(b, f)


# Bridge theorem: midpoint predicate → coordinate formula
thm midpoint_coordinate_formula:
    ? forall m, a, b cart(R, R):
        $is_midpoint(m, a, b)
        =>:
            m = ((a[1] + b[1]) / 2, (a[2] + b[2]) / 2)
    m = ((a[1] + b[1]) / 2, (a[2] + b[2]) / 2)

# ═══════════════════════════════════════════════════════════════════════
# Circle
# ═══════════════════════════════════════════════════════════════════════

# 点在圆上 → distance_sq(p, o) = r^2
thm on_circle_distance_prop:
    ? forall p, o cart(R, R), r R+:
        $is_on_circle(p, o, r)
        =>:
            distance_sq(p, o) = r^2

# ═══════════════════════════════════════════════════════════════════════
# Rotation 90°
# ═══════════════════════════════════════════════════════════════════════

# 顺时针旋转90°保持到中心的距离不变
thm rotation_90_cw_distance_prop:
    ? forall p, q, c cart(R, R):
        $rotated_90_cw(q, c, p)
        =>:
            distance_sq(c, q) = distance_sq(c, p)
    q[1] - c[1] = c[2] - p[2]
    q[2] - c[2] = p[1] - c[1]
    by thm distance_sq_coordinate_formula(c, q)
    by thm distance_sq_coordinate_formula(c, p)
    (q[1] - c[1])^2 + (q[2] - c[2])^2 = (c[2] - p[2])^2 + (p[1] - c[1])^2
    (c[2] - p[2])^2 + (p[1] - c[1])^2 = (p[1] - c[1])^2 + (p[2] - c[2])^2
    (p[1] - c[1])^2 + (p[2] - c[2])^2 = (p[1] - c[1])^2 + (c[2] - p[2])^2
    distance_sq(c, q) = (q[1] - c[1])^2 + (q[2] - c[2])^2 = (p[1] - c[1])^2 + (p[2] - c[2])^2 = distance_sq(c, p)

# 顺时针旋转90°产生垂直：dot(vec(c,p), vec(c,q)) = 0
thm rotation_90_cw_perpendicular_prop:
    ? forall p, q, c cart(R, R):
        $rotated_90_cw(q, c, p)
        =>:
            dot(vec(c, p), vec(c, q)) = 0
    q[1] - c[1] = c[2] - p[2]
    q[2] - c[2] = p[1] - c[1]
    vec(c, p) = (p[1] - c[1], p[2] - c[2])
    vec(c, q) = (q[1] - c[1], q[2] - c[2])
    (p[1] - c[1]) * (q[1] - c[1]) + (p[2] - c[2]) * (q[2] - c[2]) = (p[1] - c[1]) * (c[2] - p[2]) + (p[2] - c[2]) * (p[1] - c[1])
    (p[1] - c[1]) * (c[2] - p[2]) + (p[2] - c[2]) * (p[1] - c[1]) = 0
    dot(vec(c, p), vec(c, q)) = (p[1] - c[1]) * (q[1] - c[1]) + (p[2] - c[2]) * (q[2] - c[2]) = 0



# ═══════════════════════════════════════════════════════════════════════
# SECTION 5: CONGRUENCE THEOREMS (新增)
# ═══════════════════════════════════════════════════════════════════════
# 三角形全等判定定理：SSS, SAS, ASA, AAS, HL

# ───────────────────────────────────────────────────────────────────────
# 5.1 Vertical Angles Theorem（对顶角定理）
# ───────────────────────────────────────────────────────────────────────

# Scalar normalization for opposite-ray angle cosines.
thm vertical_angles_square_core:
    ? forall t, s, x, y, z R:
        =>:
            (t * s * x)^2 * ((1 - t)^2 * y * (1 - s)^2 * z) = ((1 - t) * (1 - s) * x)^2 * (t^2 * y * s^2 * z)
    (t * s * x)^2 * ((1 - t)^2 * y * (1 - s)^2 * z) = ((1 - t) * (1 - s) * x)^2 * (t^2 * y * s^2 * z)

thm vertical_angles_sign_core:
    ? forall t, s, x R:
        0 <= t,
        t <= 1,
        0 <= s,
        s <= 1
        =>:
            (t * s * x) * ((1 - t) * (1 - s) * x) >= 0
    t * s >= 0
    1 - t >= 0
    1 - s >= 0
    (1 - t) * (1 - s) >= 0
    t * s * (1 - t) * (1 - s) >= 0
    x^2 >= 0
    t * s * (1 - t) * (1 - s) * x^2 >= 0
    (t * s * x) * ((1 - t) * (1 - s) * x) = t * s * (1 - t) * (1 - s) * x^2 >= 0

thm dot_two_scale:
    ? forall u, v cart(R, R), k, l R:
        dot((k * u[1], k * u[2]), (l * v[1], l * v[2])) = k * l * dot(u, v)
    by thm dot_coordinate_formula((k * u[1], k * u[2]), (l * v[1], l * v[2]))
    by thm dot_coordinate_formula(u, v)
    (k * u[1]) * (l * v[1]) + (k * u[2]) * (l * v[2]) = k * l * (u[1] * v[1] + u[2] * v[2])
    dot((k * u[1], k * u[2]), (l * v[1], l * v[2])) = (k * u[1]) * (l * v[1]) + (k * u[2]) * (l * v[2]) = k * l * (u[1] * v[1] + u[2] * v[2]) = k * l * dot(u, v)

thm affine_dot_backward:
    ? forall a, b, c, d, o cart(R, R), t, s R:
        o[1] = a[1] + t * (b[1] - a[1]),
        o[2] = a[2] + t * (b[2] - a[2]),
        o[1] = c[1] + s * (d[1] - c[1]),
        o[2] = c[2] + s * (d[2] - c[2])
        =>:
            dot(vec(o, a), vec(o, c)) = t * s * dot(vec(a, b), vec(c, d))
    by thm vec_coordinate_formula(o, a)
    by thm vec_coordinate_formula(o, c)
    by thm vec_coordinate_formula(a, b)
    by thm vec_coordinate_formula(c, d)
    by thm dot_coordinate_formula(vec(o, a), vec(o, c))
    by thm dot_coordinate_formula(vec(a, b), vec(c, d))
    a[1] - o[1] = a[1] - (a[1] + t * (b[1] - a[1]))
    a[1] - (a[1] + t * (b[1] - a[1])) = -t * (b[1] - a[1])
    a[1] - o[1] = -t * (b[1] - a[1])
    a[2] - o[2] = a[2] - (a[2] + t * (b[2] - a[2]))
    a[2] - (a[2] + t * (b[2] - a[2])) = -t * (b[2] - a[2])
    a[2] - o[2] = -t * (b[2] - a[2])
    c[1] - o[1] = c[1] - (c[1] + s * (d[1] - c[1]))
    c[1] - (c[1] + s * (d[1] - c[1])) = -s * (d[1] - c[1])
    c[1] - o[1] = -s * (d[1] - c[1])
    c[2] - o[2] = c[2] - (c[2] + s * (d[2] - c[2]))
    c[2] - (c[2] + s * (d[2] - c[2])) = -s * (d[2] - c[2])
    c[2] - o[2] = -s * (d[2] - c[2])
    (a[1] - o[1]) * (c[1] - o[1]) + (a[2] - o[2]) * (c[2] - o[2]) = (-t * (b[1] - a[1])) * (-s * (d[1] - c[1])) + (-t * (b[2] - a[2])) * (-s * (d[2] - c[2]))
    (-t * (b[1] - a[1])) * (-s * (d[1] - c[1])) + (-t * (b[2] - a[2])) * (-s * (d[2] - c[2])) = t * s * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    dot(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    t * s * dot(vec(a, b), vec(c, d)) = t * s * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    t * s * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = t * s * dot(vec(a, b), vec(c, d))
    dot(vec(o, a), vec(o, c)) = (a[1] - o[1]) * (c[1] - o[1]) + (a[2] - o[2]) * (c[2] - o[2]) = t * s * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = t * s * dot(vec(a, b), vec(c, d))

thm affine_dot_forward:
    ? forall a, b, c, d, o cart(R, R), t, s R:
        o[1] = a[1] + t * (b[1] - a[1]),
        o[2] = a[2] + t * (b[2] - a[2]),
        o[1] = c[1] + s * (d[1] - c[1]),
        o[2] = c[2] + s * (d[2] - c[2])
        =>:
            dot(vec(o, b), vec(o, d)) = (1 - t) * (1 - s) * dot(vec(a, b), vec(c, d))
    by thm vec_coordinate_formula(o, b)
    by thm vec_coordinate_formula(o, d)
    by thm vec_coordinate_formula(a, b)
    by thm vec_coordinate_formula(c, d)
    by thm dot_coordinate_formula(vec(o, b), vec(o, d))
    by thm dot_coordinate_formula(vec(a, b), vec(c, d))
    b[1] - o[1] = b[1] - (a[1] + t * (b[1] - a[1]))
    b[1] - (a[1] + t * (b[1] - a[1])) = (1 - t) * (b[1] - a[1])
    b[1] - o[1] = (1 - t) * (b[1] - a[1])
    b[2] - o[2] = b[2] - (a[2] + t * (b[2] - a[2]))
    b[2] - (a[2] + t * (b[2] - a[2])) = (1 - t) * (b[2] - a[2])
    b[2] - o[2] = (1 - t) * (b[2] - a[2])
    d[1] - o[1] = d[1] - (c[1] + s * (d[1] - c[1]))
    d[1] - (c[1] + s * (d[1] - c[1])) = (1 - s) * (d[1] - c[1])
    d[1] - o[1] = (1 - s) * (d[1] - c[1])
    d[2] - o[2] = d[2] - (c[2] + s * (d[2] - c[2]))
    d[2] - (c[2] + s * (d[2] - c[2])) = (1 - s) * (d[2] - c[2])
    d[2] - o[2] = (1 - s) * (d[2] - c[2])
    (b[1] - o[1]) * (d[1] - o[1]) + (b[2] - o[2]) * (d[2] - o[2]) = ((1 - t) * (b[1] - a[1])) * ((1 - s) * (d[1] - c[1])) + ((1 - t) * (b[2] - a[2])) * ((1 - s) * (d[2] - c[2]))
    ((1 - t) * (b[1] - a[1])) * ((1 - s) * (d[1] - c[1])) + ((1 - t) * (b[2] - a[2])) * ((1 - s) * (d[2] - c[2])) = (1 - t) * (1 - s) * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    dot(vec(a, b), vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    (1 - t) * (1 - s) * dot(vec(a, b), vec(c, d)) = (1 - t) * (1 - s) * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    (1 - t) * (1 - s) * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = (1 - t) * (1 - s) * dot(vec(a, b), vec(c, d))
    dot(vec(o, b), vec(o, d)) = (b[1] - o[1]) * (d[1] - o[1]) + (b[2] - o[2]) * (d[2] - o[2]) = (1 - t) * (1 - s) * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = (1 - t) * (1 - s) * dot(vec(a, b), vec(c, d))

thm affine_distance_from_parameter:
    ? forall a, b, o cart(R, R), t R:
        o[1] = a[1] + t * (b[1] - a[1]),
        o[2] = a[2] + t * (b[2] - a[2])
        =>:
            distance_sq(o, a) = t^2 * distance_sq(a, b)
            distance_sq(o, b) = (1 - t)^2 * distance_sq(a, b)
    a[1] + t * (b[1] - a[1]) = (1 - t) * a[1] + t * b[1]
    o[1] = (1 - t) * a[1] + t * b[1]
    a[2] + t * (b[2] - a[2]) = (1 - t) * a[2] + t * b[2]
    o[2] = (1 - t) * a[2] + t * b[2]
    by def $is_affine_combination(o, a, b, t)
    a[1] + t * (b[1] - a[1]) = (1 - (1 - t)) * b[1] + (1 - t) * a[1]
    o[1] = (1 - (1 - t)) * b[1] + (1 - t) * a[1]
    a[2] + t * (b[2] - a[2]) = (1 - (1 - t)) * b[2] + (1 - t) * a[2]
    o[2] = (1 - (1 - t)) * b[2] + (1 - t) * a[2]
    by def $is_affine_combination(o, b, a, 1 - t)
    by thm affine_combination_distance_sq(a, b, o, t)
    by thm affine_combination_distance_sq(b, a, o, 1 - t)
    by thm distance_sq_symmetric(o, a)
    by thm distance_sq_symmetric(o, b)
    by thm distance_sq_symmetric(a, b)
    distance_sq(o, a) = distance_sq(a, o)
    distance_sq(a, o) = t^2 * distance_sq(a, b)
    distance_sq(o, a) = t^2 * distance_sq(a, b)
    distance_sq(o, b) = distance_sq(b, o)
    distance_sq(b, o) = (1 - t)^2 * distance_sq(b, a)
    distance_sq(b, a) = distance_sq(a, b)
    (1 - t)^2 * distance_sq(b, a) = (1 - t)^2 * distance_sq(a, b)
    distance_sq(o, b) = (1 - t)^2 * distance_sq(a, b)

thm vertical_angles_equal:
    ? forall a, b, c, d, o cart(R, R):
        $is_on_segment(o, a, b),
        a != o,
        b != o,
        $is_on_segment(o, c, d),
        c != o,
        d != o
        =>:
            $are_angles_congruent(a, o, c, b, o, d)

    by def $is_on_segment(o, a, b)
    obtain t from exist t0 R st {0 <= t0, t0 <= 1, o = (a[1] + t0 * (b[1] - a[1]), a[2] + t0 * (b[2] - a[2]))}
    by def $is_on_segment(o, c, d)
    obtain s from exist s0 R st {0 <= s0, s0 <= 1, o = (c[1] + s0 * (d[1] - c[1]), c[2] + s0 * (d[2] - c[2]))}

    o[1] = a[1] + t * (b[1] - a[1])
    o[2] = a[2] + t * (b[2] - a[2])
    o[1] = c[1] + s * (d[1] - c[1])
    o[2] = c[2] + s * (d[2] - c[2])

    by thm vec_coordinate_formula(o, a)
    by thm vec_coordinate_formula(o, b)
    by thm vec_coordinate_formula(o, c)
    by thm vec_coordinate_formula(o, d)
    by thm vec_coordinate_formula(a, b)
    by thm vec_coordinate_formula(c, d)
    by thm dot_coordinate_formula(vec(o, a), vec(o, c))
    by thm dot_coordinate_formula(vec(o, b), vec(o, d))
    by thm dot_coordinate_formula(vec(a, b), vec(c, d))

    dot(vec(o, a), vec(o, c)) = t * s * dot(vec(a, b), vec(c, d))
    dot(vec(o, b), vec(o, d)) = (1 - t) * (1 - s) * dot(vec(a, b), vec(c, d))

    by thm affine_distance_from_parameter(a, b, o, t)
    by thm affine_distance_from_parameter(c, d, o, s)

    distance_sq(o, a) = t^2 * distance_sq(a, b)
    distance_sq(o, b) = (1 - t)^2 * distance_sq(a, b)
    distance_sq(o, c) = s^2 * distance_sq(c, d)
    distance_sq(o, d) = (1 - s)^2 * distance_sq(c, d)

    angle_cos_num(a, o, c) = t * s * dot(vec(a, b), vec(c, d))
    angle_cos_num(b, o, d) = (1 - t) * (1 - s) * dot(vec(a, b), vec(c, d))
    angle_cos_den(a, o, c) = t^2 * distance_sq(a, b) * (s^2 * distance_sq(c, d))
    angle_cos_den(b, o, d) = (1 - t)^2 * distance_sq(a, b) * ((1 - s)^2 * distance_sq(c, d))

    angle_cos_num(a, o, c)^2 * angle_cos_den(b, o, d) = (t * s * dot(vec(a, b), vec(c, d)))^2 * angle_cos_den(b, o, d)
    (t * s * dot(vec(a, b), vec(c, d)))^2 * angle_cos_den(b, o, d) = (t * s * dot(vec(a, b), vec(c, d)))^2 * ((1 - t)^2 * distance_sq(a, b) * ((1 - s)^2 * distance_sq(c, d)))
    (t * s * dot(vec(a, b), vec(c, d)))^2 * ((1 - t)^2 * distance_sq(a, b) * ((1 - s)^2 * distance_sq(c, d))) = ((1 - t) * (1 - s) * dot(vec(a, b), vec(c, d)))^2 * (t^2 * distance_sq(a, b) * (s^2 * distance_sq(c, d)))
    ((1 - t) * (1 - s) * dot(vec(a, b), vec(c, d)))^2 * (t^2 * distance_sq(a, b) * (s^2 * distance_sq(c, d))) = angle_cos_num(b, o, d)^2 * (t^2 * distance_sq(a, b) * (s^2 * distance_sq(c, d)))
    angle_cos_num(b, o, d)^2 * (t^2 * distance_sq(a, b) * (s^2 * distance_sq(c, d))) = angle_cos_num(b, o, d)^2 * angle_cos_den(a, o, c)
    by thm vertical_angles_square_core(t, s, dot(vec(a, b), vec(c, d)), distance_sq(a, b), distance_sq(c, d))
    angle_cos_num(a, o, c)^2 * angle_cos_den(b, o, d) = angle_cos_num(b, o, d)^2 * angle_cos_den(a, o, c)

    by thm vertical_angles_sign_core(t, s, dot(vec(a, b), vec(c, d)))
    angle_cos_num(a, o, c) * angle_cos_num(b, o, d) >= 0

    by def $are_angles_congruent(a, o, c, b, o, d)


# ───────────────────────────────────────────────────────────────────────
# 5.2 AAS Triangle Congruence Theorem（AAS 全等定理）
# ───────────────────────────────────────────────────────────────────────

# TODO: triangle_congruence_AAS 验证失败（证明不完整，需要正弦定理），临时改为 axiom
axiom triangle_congruence_AAS:
    ? forall a, b, c, d, e1, f cart(R, R):
        # 三角形的非退化条件
        a != b,
        b != c,
        c != a,
        d != e1,
        e1 != f,
        f != d,
        # AAS 条件
        # ∠A = ∠D
        angle_cos_num(b, a, c) * angle_cos_den(e1, d, f) = angle_cos_num(e1, d, f) * angle_cos_den(b, a, c),
        # ∠B = ∠E
        angle_cos_num(a, b, c) * angle_cos_den(d, e1, f) = angle_cos_num(d, e1, f) * angle_cos_den(a, b, c),
        # BC = EF
        distance_sq(b, c) = distance_sq(e1, f)
        =>:
            # 结论：三角形全等（所有对应边相等）
            distance_sq(a, b) = distance_sq(d, e1),
            distance_sq(a, c) = distance_sq(d, f)

