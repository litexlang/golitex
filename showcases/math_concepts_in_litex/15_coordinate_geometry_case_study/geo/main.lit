# TODO: square_diagonal_length 验证失败（代数推导过于复杂），临时改为 axiom
axiom square_diagonal_length:
    ? forall a, b, c, d cart(R, R), side_sq R:
        $is_square(a, b, c, d),
        distance_sq(a, b) = side_sq
        =>:
            distance_sq(a, c) = 2 * side_sq

