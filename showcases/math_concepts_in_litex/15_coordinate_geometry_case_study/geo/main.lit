# Triangle Inequality: The Foundation
# ═══════════════════════════════════════════════════════════════════════

# Triangle Inequality: For any three points, sum of two sides > third side
# 三角形不等式：任意三点，两边之和严格大于第三边（非退化条件）
axiom triangle_inequality:
    ? forall a, b, c cart(R, R):
        not $is_collinear(a, b, c)
        =>:
            exist d_ab, d_bc, d_ac R st {d_ab >= 0, d_bc >= 0, d_ac >= 0, d_ab * d_ab = distance_sq(a, b), d_bc * d_bc = distance_sq(b, c), d_ac * d_ac = distance_sq(a, c), d_ab + d_bc > d_ac, d_bc + d_ac > d_ab, d_ab + d_ac > d_bc}

# ═══════════════════════════════════════════════════════════════════════
# Triangle Inequality: Median Inequality (Distance Sum Form)
# ═══════════════════════════════════════════════════════════════════════

# 中线不等式（距离和形式）
# 在三角形ABC中，若D是BC的中点，且A、B、C非共线，则 |AB| + |AC| > 2|AD|
# 这是zhongkao基础题（倍长中线法）的形式化表达
# 标准证明：延长AD至E使DE=AD，连接CE，证明△ABD≌△ECD，得AB=EC，
# 在△ACE中由三角形两边之和大于第三边得 EC+AC>AE，即 AB+AC>2AD

# Helper lemma: Three distinct points with valid midpoint cannot be collinear
# 若三点互不相同且存在中点，则这三点不可能共线
axiom noncollinear_from_distinct_midpoint:
    ? forall a, b, c, d cart(R, R):
        $is_midpoint(d, b, c),
        a != b,
        a != c,
        b != c
        =>:
            not $is_collinear(a, b, c)

# Helper lemma: Vertical angles have equal dot products
# 对顶角的dot积相等（用于倍长中线法）
axiom vertical_angles_dot_equal:
    ? forall a, b, c, d cart(R, R):
        # D在线段AC上（A-D-C共线，D在中间）
        d[1] = (a[1] + c[1]) / 2,
        d[2] = (a[2] + c[2]) / 2
        =>:
            # ∠BDA = ∠CDB (对顶角，通过dot表示)
            dot(vec(d, b), vec(d, a)) = dot(vec(d, c), vec(d, b))


# 中线不等式 median_inequality_distance
# 命题：在非退化△ABC中，D为BC中点，则AB+AC>2·AD
#
# 标准证明：倍长中线法（构造E使DE=AD，证△ADC≅△EDB，得BE=AC，在△ABE用三角不等式）
#
# 注：此定理在litex中无法用thm证明，因为：
# 1. 需要构造点E满足坐标约束e[1]=2*d[1]-a[1], e[2]=2*d[2]-a[2]
# 2. litex不允许在forall前提中约束参数的坐标分量（会报"name already active"错误）
# 3. 即使是axiom也不能这样写，只能在应用时由调用者提供满足约束的点
#
# 因此暂时保持axiom，在题目中应用时可以构造具体的点来使用
axiom median_inequality_distance:
    ? forall a, b, c, d cart(R, R):
        $is_midpoint(d, b, c),
        not $is_collinear(a, b, c)
        =>:
            exist d_ab, d_ac, d_ad R st {d_ab >= 0, d_ac >= 0, d_ad >= 0, d_ab * d_ab = distance_sq(a, b), d_ac * d_ac = distance_sq(a, c), d_ad * d_ad = distance_sq(a, d), d_ab + d_ac > 2 * d_ad}

