axiom isosceles_right_hypotenuse_length:
    ? forall a, f, e2 cart(R, R), leg_sq R:
        distance_sq(f, a) = leg_sq,
        distance_sq(f, e2) = leg_sq,
        dot(vec(f, a), vec(f, e2)) = 0
        =>:
            distance_sq(a, e2) = 2 * leg_sq

