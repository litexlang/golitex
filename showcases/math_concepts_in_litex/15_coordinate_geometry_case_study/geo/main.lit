# END OF UNIFIED EUCLIDEAN GEOMETRY LIBRARY
# ═══════════════════════════════════════════════════════════════════════

# ============================================================================
# Perpendicular Bisector Theorem
# ============================================================================

axiom perpendicular_bisector_equidistant:
    ? forall A, B, O, P cart(R, R):
        A != B,
        $is_midpoint(O, A, B),
        $is_perpendicular(P, O, A, B)
        =>:
            distance_sq(P, A) = distance_sq(P, B)
# Test exist point construction in KB environment
# Add to end of theorems.lit temporarily to test

# Can we claim existence of a point G on line AB with distance GB = target?
# This is needed for ASA proof by contradiction

axiom test_point_on_line_with_distance:
    ? forall a, b cart(R, R), target_dist R:
        a != b,
        target_dist > 0
        =>:
            exist g cart(R, R) st {det(vec(a, g), vec(a, b)) = 0, distance_sq(g, b) = target_dist^2}

# If this axiom is accepted, we can use it to construct G in ASA proof
# Next step: try to witness this with a concrete construction like:
#   g = b + t * vec(b, a)  where t is chosen to satisfy distance condition

# ============================================================================
# Coordinate geometry helper theorems
# ============================================================================

# Shared reusable lemmas for affine parameters, right-triangle feet, and midpoint orthogonality.

thm dot_sub_right_coordinate:
    ? forall u, v cart(R, R):
        dot(u, (v[1] - u[1], v[2] - u[2])) = dot(u, v) - dot(u, u)
    by thm dot_coordinate_formula(u, (v[1] - u[1], v[2] - u[2]))
    by thm dot_coordinate_formula(u, v)
    by thm dot_coordinate_formula(u, u)
    dot(u, (v[1] - u[1], v[2] - u[2])) = u[1] * (v[1] - u[1]) + u[2] * (v[2] - u[2]) = (u[1] * v[1] + u[2] * v[2]) - (u[1] * u[1] + u[2] * u[2]) = dot(u, v) - dot(u, u)

# A nondegenerate collinear point has an affine parameter.
thm collinear_coordinates_imply_affine_parameter:
    ? forall a, b, p cart(R, R):
        a != b,
        (p[1] - a[1]) * (b[2] - a[2]) - (p[2] - a[2]) * (b[1] - a[1]) = 0
        =>:
            exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}
    by cases:
        ? exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}
        case b[1] - a[1] != 0:
            witness exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]} from (p[1] - a[1]) / (b[1] - a[1]):
                ((p[1] - a[1]) / (b[1] - a[1])) * (b[1] - a[1]) = p[1] - a[1]
                p[1] = (1 - (p[1] - a[1]) / (b[1] - a[1])) * a[1] + ((p[1] - a[1]) / (b[1] - a[1])) * b[1]
                (p[2] - a[2]) * (b[1] - a[1]) = (((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2])) * (b[1] - a[1])
                by thm divide_both_sides(p[2] - a[2], ((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2]), b[1] - a[1])
                p[2] - a[2] = ((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2])
                p[2] = (p[2] - a[2]) + a[2] = ((p[1] - a[1]) / (b[1] - a[1])) * (b[2] - a[2]) + a[2] = (1 - (p[1] - a[1]) / (b[1] - a[1])) * a[2] + ((p[1] - a[1]) / (b[1] - a[1])) * b[2]
        case b[1] - a[1] = 0:
            b[1] = a[1]
            by contra:
                ? b[2] - a[2] != 0
                b[2] - a[2] = 0
                b[2] = a[2]
                by thm tuple_equal_from_coordinates(a, (a[1], a[2]))
                by thm tuple_equal_from_coordinates(b, (b[1], b[2]))
                (a[1], a[2]) = (b[1], b[2])
                a = (a[1], a[2]) = (b[1], b[2]) = b
                impossible a != b
            witness exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]} from (p[2] - a[2]) / (b[2] - a[2]):
                (p[1] - a[1]) * (b[2] - a[2]) = (p[1] - a[1]) * (b[2] - a[2]) - (p[2] - a[2]) * (b[1] - a[1]) = 0 = 0 * (b[2] - a[2])
                by thm divide_both_sides(p[1] - a[1], 0, b[2] - a[2])
                p[1] - a[1] = 0
                p[1] = a[1]
                p[1] = a[1] = (1 - (p[2] - a[2]) / (b[2] - a[2])) * a[1] + ((p[2] - a[2]) / (b[2] - a[2])) * a[1] = (1 - (p[2] - a[2]) / (b[2] - a[2])) * a[1] + ((p[2] - a[2]) / (b[2] - a[2])) * b[1]
                ((p[2] - a[2]) / (b[2] - a[2])) * (b[2] - a[2]) = p[2] - a[2]
                p[2] = (p[2] - a[2]) + a[2] = ((p[2] - a[2]) / (b[2] - a[2])) * (b[2] - a[2]) + a[2] = (1 - (p[2] - a[2]) / (b[2] - a[2])) * a[2] + ((p[2] - a[2]) / (b[2] - a[2])) * b[2]

# Public interface: unfold line membership, then invoke the coordinate bridge.
thm on_line_implies_affine_parameter:
    ? forall a, b, p cart(R, R):
        $is_on_line(p, a, b)
        =>:
            exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}
    a != b
    p $in line_of(a, b)
    det(vec(a, p), vec(a, b)) = 0
    by thm collinear_det_expand(a, p, b)
    (p[1] - a[1]) * (b[2] - a[2]) - (p[2] - a[2]) * (b[1] - a[1]) = 0
    by thm collinear_coordinates_imply_affine_parameter(a, b, p)
    exist t R st {p[1] = (1 - t) * a[1] + t * b[1], p[2] = (1 - t) * a[2] + t * b[2]}

# Reusable nondegeneracy facts for right triangles.
# ACB is a right angle and E is the foot from C to AB; prove C != E.
thm right_angle_vertex_distinct_from_foot_on_opposite_line:
    ? forall a, b, c, foot cart(R, R):
        $is_right_angle(a, c, b),
        $is_foot(foot, c, a, b)
        =>:
            c != foot
    by contra:
        ? c != foot
        c = foot
        a != c
        b != c
        a != b
        $is_on_line(foot, a, b)
        foot $in line_of(a, b)
        det(vec(a, foot), vec(a, b)) = 0
        det(vec(a, c), vec(a, b)) = det(vec(a, foot), vec(a, b)) = 0
        by thm det_antisymmetric(vec(a, b), vec(a, c))
        det(vec(a, b), vec(a, c)) = -(det(vec(a, c), vec(a, b)))
        det(vec(a, b), vec(a, c)) = 0
        by thm det_change_base(a, c, b)
        det(vec(c, a), vec(c, b)) = 0

        dot(vec(c, a), vec(c, b)) = 0
        vec(c, a) = (a[1] - c[1], a[2] - c[2])
        vec(c, b) = (b[1] - c[1], b[2] - c[2])
        dot(vec(c, a), vec(c, b)) = (a[1] - c[1]) * (b[1] - c[1]) + (a[2] - c[2]) * (b[2] - c[2])
        det(vec(c, a), vec(c, b)) = (a[1] - c[1]) * (b[2] - c[2]) - (a[2] - c[2]) * (b[1] - c[1])
        c != a
        by thm point_difference_norm_pos(c, a)
        (a[1] - c[1])^2 + (a[2] - c[2])^2 > 0
        by thm dot_det_eliminate(a[1] - c[1], a[2] - c[2], b[1] - c[1], b[2] - c[2])
        b[1] - c[1] = 0
        b[2] - c[2] = 0
        b[1] = c[1]
        b[2] = c[2]
        by thm tuple_equal_from_coordinates(b, (b[1], b[2]))
        by thm tuple_equal_from_coordinates(c, (c[1], c[2]))
        (b[1], b[2]) = (c[1], c[2])
        b = (b[1], b[2]) = (c[1], c[2]) = c
        impossible b != c

# A point on the hypotenuse line cannot equal the right-angle vertex.
thm right_angle_vertex_not_on_opposite_line:
    ? forall a, b, c, p cart(R, R):
        $is_right_angle(a, c, b),
        $is_on_line(p, a, b)
        =>:
            c != p
    by contra:
        ? c != p
        c = p
        a != c
        b != c
        a != b
        p $in line_of(a, b)
        det(vec(a, p), vec(a, b)) = 0
        det(vec(a, c), vec(a, b)) = det(vec(a, p), vec(a, b)) = 0
        by thm det_antisymmetric(vec(a, b), vec(a, c))
        det(vec(a, b), vec(a, c)) = -(det(vec(a, c), vec(a, b)))
        det(vec(a, b), vec(a, c)) = 0
        by thm det_change_base(a, c, b)
        det(vec(c, a), vec(c, b)) = 0
        dot(vec(c, a), vec(c, b)) = 0
        vec(c, a) = (a[1] - c[1], a[2] - c[2])
        vec(c, b) = (b[1] - c[1], b[2] - c[2])
        dot(vec(c, a), vec(c, b)) = (a[1] - c[1]) * (b[1] - c[1]) + (a[2] - c[2]) * (b[2] - c[2])
        det(vec(c, a), vec(c, b)) = (a[1] - c[1]) * (b[2] - c[2]) - (a[2] - c[2]) * (b[1] - c[1])
        c != a
        by thm point_difference_norm_pos(c, a)
        (a[1] - c[1])^2 + (a[2] - c[2])^2 > 0
        by thm dot_det_eliminate(a[1] - c[1], a[2] - c[2], b[1] - c[1], b[2] - c[2])
        b[1] - c[1] = 0
        b[2] - c[2] = 0
        b[1] = c[1]
        b[2] = c[2]
        by thm tuple_equal_from_coordinates(b, (b[1], b[2]))
        by thm tuple_equal_from_coordinates(c, (c[1], c[2]))
        (b[1], b[2]) = (c[1], c[2])
        b = (b[1], b[2]) = (c[1], c[2]) = c
        impossible b != c

# In a nondegenerate right triangle, these two midpoint constructions
# cannot coincide.  Notice that no assumption about D lying on BC is needed.
thm right_triangle_foot_midpoints_distinct:
    ? forall a, b, c, d, f, m, n cart(R, R):
        $is_right_angle(a, c, b),
        $is_foot(f, d, a, b),
        $is_midpoint(m, a, d),
        $is_midpoint(n, c, f)
        =>:
            m != n
    by contra:
        ? m != n
        m = n
        m = ((a[1] + d[1]) / 2, (a[2] + d[2]) / 2)
        n = ((c[1] + f[1]) / 2, (c[2] + f[2]) / 2)
        m[1] = n[1]
        m[2] = n[2]
        m[1] = (a[1] + d[1]) / 2
        m[2] = (a[2] + d[2]) / 2
        n[1] = (c[1] + f[1]) / 2
        n[2] = (c[2] + f[2]) / 2
        (a[1] + d[1]) / 2 = (c[1] + f[1]) / 2
        (a[2] + d[2]) / 2 = (c[2] + f[2]) / 2
        2 * ((a[1] + d[1]) / 2) = 2 * ((c[1] + f[1]) / 2)
        2 * ((a[2] + d[2]) / 2) = 2 * ((c[2] + f[2]) / 2)
        2 * ((a[1] + d[1]) / 2) = a[1] + d[1]
        2 * ((c[1] + f[1]) / 2) = c[1] + f[1]
        2 * ((a[2] + d[2]) / 2) = a[2] + d[2]
        2 * ((c[2] + f[2]) / 2) = c[2] + f[2]
        a[1] + d[1] = 2 * ((a[1] + d[1]) / 2) = 2 * ((c[1] + f[1]) / 2) = c[1] + f[1]
        a[2] + d[2] = 2 * ((a[2] + d[2]) / 2) = 2 * ((c[2] + f[2]) / 2) = c[2] + f[2]
        (a[1] + d[1]) - c[1] - d[1] = (c[1] + f[1]) - c[1] - d[1]
        (a[2] + d[2]) - c[2] - d[2] = (c[2] + f[2]) - c[2] - d[2]
        (a[1] + d[1]) - c[1] - d[1] = a[1] - c[1]
        (c[1] + f[1]) - c[1] - d[1] = f[1] - d[1]
        (a[2] + d[2]) - c[2] - d[2] = a[2] - c[2]
        (c[2] + f[2]) - c[2] - d[2] = f[2] - d[2]
        a[1] - c[1] = (a[1] + d[1]) - c[1] - d[1] = (c[1] + f[1]) - c[1] - d[1] = f[1] - d[1]
        a[2] - c[2] = (a[2] + d[2]) - c[2] - d[2] = (c[2] + f[2]) - c[2] - d[2] = f[2] - d[2]
        f[1] - d[1] = a[1] - c[1]
        f[2] - d[2] = a[2] - c[2]
        a != c
        b != c
        a != b
        d != f
        dot(vec(c, a), vec(c, b)) = 0
        dot(vec(d, f), vec(a, b)) = 0
        vec(c, a) = (a[1] - c[1], a[2] - c[2])
        vec(c, b) = (b[1] - c[1], b[2] - c[2])
        vec(d, f) = (f[1] - d[1], f[2] - d[2])
        vec(a, b) = (b[1] - a[1], b[2] - a[2])
        (f[1] - d[1], f[2] - d[2]) = (a[1] - c[1], a[2] - c[2])
        vec(d, f) = (f[1] - d[1], f[2] - d[2]) = (a[1] - c[1], a[2] - c[2]) = vec(c, a)
        by thm dot_coordinate_formula(vec(d, f), vec(a, b))
        dot(vec(d, f), vec(a, b)) = (f[1] - d[1]) * (b[1] - a[1]) + (f[2] - d[2]) * (b[2] - a[2])
        (f[1] - d[1]) * (b[1] - a[1]) + (f[2] - d[2]) * (b[2] - a[2]) = 0
        (a[1] - c[1]) * (b[1] - a[1]) + (a[2] - c[2]) * (b[2] - a[2]) = (f[1] - d[1]) * (b[1] - a[1]) + (f[2] - d[2]) * (b[2] - a[2]) = 0
        by thm dot_coordinate_formula(vec(c, a), vec(a, b))
        dot(vec(c, a), vec(a, b)) = (a[1] - c[1]) * (b[1] - a[1]) + (a[2] - c[2]) * (b[2] - a[2])
        dot(vec(c, a), vec(a, b)) = 0
        by thm dot_coordinate_formula(vec(c, a), vec(c, b))
        dot(vec(c, a), vec(c, b)) = (a[1] - c[1]) * (b[1] - c[1]) + (a[2] - c[2]) * (b[2] - c[2])
        (a[1] - c[1]) * (b[1] - c[1]) + (a[2] - c[2]) * (b[2] - c[2]) = 0
        (b[1] - a[1]) = (b[1] - c[1]) - (a[1] - c[1])
        (b[2] - a[2]) = (b[2] - c[2]) - (a[2] - c[2])
        (a[1] - c[1]) * (b[1] - a[1]) + (a[2] - c[2]) * (b[2] - a[2]) = ((a[1] - c[1]) * (b[1] - c[1]) + (a[2] - c[2]) * (b[2] - c[2])) - ((a[1] - c[1])^2 + (a[2] - c[2])^2)
        ((a[1] - c[1]) * (b[1] - c[1]) + (a[2] - c[2]) * (b[2] - c[2])) - ((a[1] - c[1])^2 + (a[2] - c[2])^2) = 0 - ((a[1] - c[1])^2 + (a[2] - c[2])^2)
        0 - ((a[1] - c[1])^2 + (a[2] - c[2])^2) = 0
        ((a[1] - c[1])^2 + (a[2] - c[2])^2) - ((a[1] - c[1])^2 + (a[2] - c[2])^2) = 0
        0 - ((a[1] - c[1])^2 + (a[2] - c[2])^2) = ((a[1] - c[1])^2 + (a[2] - c[2])^2) - ((a[1] - c[1])^2 + (a[2] - c[2])^2)
        by thm subtraction_cancel(0, (a[1] - c[1])^2 + (a[2] - c[2])^2, (a[1] - c[1])^2 + (a[2] - c[2])^2)
        0 = (a[1] - c[1])^2 + (a[2] - c[2])^2
        (a[1] - c[1])^2 + (a[2] - c[2])^2 = 0
        by thm point_difference_norm_pos(c, a)
        (a[1] - c[1])^2 + (a[2] - c[2])^2 > 0
        impossible (a[1] - c[1])^2 + (a[2] - c[2])^2 = 0

# Reusable strict vector-algebra core for orthogonal midpoint constructions.

thm dot_scale_left:
    ? forall u, v cart(R, R), k R:
        dot((k * u[1], k * u[2]), v) = k * dot(u, v)
    by thm dot_symmetric((k * u[1], k * u[2]), v)
    by thm dot_scale_right(v, u, k)
    by thm dot_symmetric(v, u)
    dot((k * u[1], k * u[2]), v) = dot(v, (k * u[1], k * u[2])) = k * dot(v, u) = k * dot(u, v)

thm dot_linear_left:
    ? forall u, v, w cart(R, R), a, b R:
        dot((a * u[1] + b * v[1], a * u[2] + b * v[2]), w) = a * dot(u, w) + b * dot(v, w)
    by thm dot_add_left((a * u[1], a * u[2]), (b * v[1], b * v[2]), w)
    by thm dot_scale_left(u, w, a)
    by thm dot_scale_left(v, w, b)
    dot((a * u[1] + b * v[1], a * u[2] + b * v[2]), w) = dot((a * u[1], a * u[2]), w) + dot((b * v[1], b * v[2]), w) = a * dot(u, w) + b * dot(v, w)

thm dot_linear_right:
    ? forall u, v, w cart(R, R), a, b R:
        dot(w, (a * u[1] + b * v[1], a * u[2] + b * v[2])) = a * dot(w, u) + b * dot(w, v)
    by thm dot_bilinear_right(w, (a * u[1], a * u[2]), (b * v[1], b * v[2]))
    by thm dot_scale_right(w, u, a)
    by thm dot_scale_right(w, v, b)
    dot(w, (a * u[1] + b * v[1], a * u[2] + b * v[2])) = dot(w, (a * u[1], a * u[2])) + dot(w, (b * v[1], b * v[2])) = a * dot(w, u) + b * dot(w, v)

thm orthogonal_midpoint_scalar_finish:
    ? forall uu, vv, s, t R:
        -(1 - t) * uu + (t - s) * vv = 0
        =>:
            (-t / 2) * (1 - t) * uu + ((t - s) / 2) * t * vv = 0
    (t / 2) * (-(1 - t) * uu + (t - s) * vv) = 0
    (t / 2) * (-(1 - t) * uu + (t - s) * vv) = (-t / 2) * (1 - t) * uu + ((t - s) / 2) * t * vv
    (-t / 2) * (1 - t) * uu + ((t - s) / 2) * t * vv = 0

thm orthogonal_midpoint_vector_core:
    ? forall u, v cart(R, R), s, t R:
        dot(u, v) = 0,
        dot(((1 - t) * u[1] + (t - s) * v[1], (1 - t) * u[2] + (t - s) * v[2]), (v[1] - u[1], v[2] - u[2])) = 0
        =>:
            dot(((-t / 2) * u[1] + ((t - s) / 2) * v[1], (-t / 2) * u[2] + ((t - s) / 2) * v[2]), ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = 0

    by thm dot_symmetric(u, v)
    dot(v, u) = 0

    by thm dot_linear_left(u, v, (v[1] - u[1], v[2] - u[2]), 1 - t, t - s)
    by thm dot_linear_right(v, u, u, 1, -1)
    by thm dot_linear_right(v, u, v, 1, -1)
    by thm dot_coordinate_formula(u, (v[1] - u[1], v[2] - u[2]))
    by thm dot_coordinate_formula(u, v)
    by thm dot_coordinate_formula(u, u)
    dot(u, (v[1] - u[1], v[2] - u[2])) = u[1] * (v[1] - u[1]) + u[2] * (v[2] - u[2]) = (u[1] * v[1] + u[2] * v[2]) - (u[1] * u[1] + u[2] * u[2]) = dot(u, v) - dot(u, u)
    by thm dot_coordinate_formula(v, (v[1] - u[1], v[2] - u[2]))
    by thm dot_coordinate_formula(v, v)
    by thm dot_coordinate_formula(v, u)
    dot(v, (v[1] - u[1], v[2] - u[2])) = v[1] * (v[1] - u[1]) + v[2] * (v[2] - u[2]) = (v[1] * v[1] + v[2] * v[2]) - (v[1] * u[1] + v[2] * u[2]) = dot(v, v) - dot(v, u)
    dot(u, (v[1] - u[1], v[2] - u[2])) = dot(u, v) - dot(u, u) = 0 - dot(u, u)
    0 - dot(u, u) = -dot(u, u)
    dot(u, (v[1] - u[1], v[2] - u[2])) = -dot(u, u)
    dot(v, (v[1] - u[1], v[2] - u[2])) = dot(v, v) - dot(v, u) = dot(v, v) - 0
    dot(v, v) - 0 = dot(v, v)
    dot(v, (v[1] - u[1], v[2] - u[2])) = dot(v, v)
    0 = dot(((1 - t) * u[1] + (t - s) * v[1], (1 - t) * u[2] + (t - s) * v[2]), (v[1] - u[1], v[2] - u[2]))
    dot(((1 - t) * u[1] + (t - s) * v[1], (1 - t) * u[2] + (t - s) * v[2]), (v[1] - u[1], v[2] - u[2])) = (1 - t) * dot(u, (v[1] - u[1], v[2] - u[2])) + (t - s) * dot(v, (v[1] - u[1], v[2] - u[2]))
    (1 - t) * dot(u, (v[1] - u[1], v[2] - u[2])) + (t - s) * dot(v, (v[1] - u[1], v[2] - u[2])) = (1 - t) * (-dot(u, u)) + (t - s) * dot(v, v)
    (1 - t) * (-dot(u, u)) + (t - s) * dot(v, v) = -(1 - t) * dot(u, u) + (t - s) * dot(v, v)
    -(1 - t) * dot(u, u) + (t - s) * dot(v, v) = 0

    by thm orthogonal_midpoint_scalar_finish(dot(u, u), dot(v, v), s, t)
    (-t / 2) * (1 - t) * dot(u, u) + ((t - s) / 2) * t * dot(v, v) = 0

    by thm dot_linear_left(u, v, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2]), -t / 2, (t - s) / 2)
    by thm dot_linear_right(u, v, u, 1 - t, t)
    by thm dot_linear_right(u, v, v, 1 - t, t)
    dot(u, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = (1 - t) * dot(u, u) + t * dot(u, v)
    (1 - t) * dot(u, u) + t * dot(u, v) = (1 - t) * dot(u, u) + t * 0
    (1 - t) * dot(u, u) + t * 0 = (1 - t) * dot(u, u)
    dot(u, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = (1 - t) * dot(u, u)
    dot(v, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = (1 - t) * dot(v, u) + t * dot(v, v)
    (1 - t) * dot(v, u) + t * dot(v, v) = (1 - t) * 0 + t * dot(v, v)
    (1 - t) * 0 + t * dot(v, v) = t * dot(v, v)
    dot(v, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = t * dot(v, v)
    dot(((-t / 2) * u[1] + ((t - s) / 2) * v[1], (-t / 2) * u[2] + ((t - s) / 2) * v[2]), ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = (-t / 2) * dot(u, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) + ((t - s) / 2) * dot(v, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2]))
    (-t / 2) * dot(u, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) + ((t - s) / 2) * dot(v, ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = (-t / 2) * ((1 - t) * dot(u, u)) + ((t - s) / 2) * (t * dot(v, v))
    (-t / 2) * ((1 - t) * dot(u, u)) + ((t - s) / 2) * (t * dot(v, v)) = (-t / 2) * (1 - t) * dot(u, u) + ((t - s) / 2) * t * dot(v, v)
    dot(((-t / 2) * u[1] + ((t - s) / 2) * v[1], (-t / 2) * u[2] + ((t - s) / 2) * v[2]), ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = (-t / 2) * (1 - t) * dot(u, u) + ((t - s) / 2) * t * dot(v, v)
    dot(((-t / 2) * u[1] + ((t - s) / 2) * v[1], (-t / 2) * u[2] + ((t - s) / 2) * v[2]), ((1 - t) * u[1] + t * v[1], (1 - t) * u[2] + t * v[2])) = 0


# ═══════════════════════════════════════════════════════════════════════
# COORDINATE GEOMETRY - Parallelogram & Orthogonality
# ═══════════════════════════════════════════════════════════════════════
# Added from Problem 207 (2026-09-01)
# General-purpose coordinate formula for quadrilaterals with parallel
# opposite sides and orthogonal adjacent sides.

# When opposite sides are parallel to two orthogonal directions, the fourth
# vertex coordinate is forced to be the standard parallelogram formula d = a + c - b.
thm orthogonal_parallel_quadrilateral_coordinates:
    ? forall a, b, c, d cart(R, R):
        a != b,
        a != d,
        det(vec(a, b), vec(d, c)) = 0,
        det(vec(a, d), vec(b, c)) = 0,
        dot(vec(a, d), vec(a, b)) = 0
        =>:
            d[1] = a[1] + c[1] - b[1],
            d[2] = a[2] + c[2] - b[2]

    by thm perpendicular_dot_expand(a, d, a, b)
    by thm collinear_det_expand(a, b, (a[1] + c[1] - d[1], a[2] + c[2] - d[2]))
    by thm collinear_det_expand(a, d, (a[1] + c[1] - b[1], a[2] + c[2] - b[2]))
    by thm collinear_det_expand(d, c, b)
    by thm collinear_det_expand(b, c, d)

    vec(a, b) = (b[1] - a[1], b[2] - a[2])
    vec(a, d) = (d[1] - a[1], d[2] - a[2])
    vec(d, c) = (c[1] - d[1], c[2] - d[2])
    vec(b, c) = (c[1] - b[1], c[2] - b[2])
    det(vec(a, b), vec(d, c)) = (b[1] - a[1]) * (c[2] - d[2]) - (b[2] - a[2]) * (c[1] - d[1])
    det(vec(a, d), vec(b, c)) = (d[1] - a[1]) * (c[2] - b[2]) - (d[2] - a[2]) * (c[1] - b[1])
    dot(vec(a, d), vec(a, b)) = (d[1] - a[1]) * (b[1] - a[1]) + (d[2] - a[2]) * (b[2] - a[2])

    (b[1] - a[1]) * ((a[2] + c[2] - b[2] - d[2])) - (b[2] - a[2]) * ((a[1] + c[1] - b[1] - d[1])) = 0
    (d[1] - a[1]) * ((a[2] + c[2] - b[2] - d[2])) - (d[2] - a[2]) * ((a[1] + c[1] - b[1] - d[1])) = 0

    by thm dot_symmetric(vec(a, d), vec(a, b))
    dot(vec(a, b), vec(a, d)) = 0
    by thm dot_squared_plus_det_squared(vec(a, b), vec(a, d))
    by thm distance_sq_positive_of_ne(a, b)
    by thm distance_sq_positive_of_ne(a, d)
    by thm vec_dot_self_is_distance(a, b)
    by thm vec_dot_self_is_distance(a, d)
    dot(vec(a, b), vec(a, b)) > 0
    dot(vec(a, d), vec(a, d)) > 0
    dot(vec(a, b), vec(a, b)) * dot(vec(a, d), vec(a, d)) > 0
    dot(vec(a, b), vec(a, d))^2 + det(vec(a, b), vec(a, d))^2 = dot(vec(a, b), vec(a, b)) * dot(vec(a, d), vec(a, d))
    dot(vec(a, b), vec(a, d))^2 = 0
    dot(vec(a, b), vec(a, d))^2 + det(vec(a, b), vec(a, d))^2 = det(vec(a, b), vec(a, d))^2
    det(vec(a, b), vec(a, d))^2 = dot(vec(a, b), vec(a, b)) * dot(vec(a, d), vec(a, d))
    det(vec(a, b), vec(a, d))^2 > 0
    by contra:
        ? det(vec(a, b), vec(a, d)) != 0
        det(vec(a, b), vec(a, d)) = 0
        det(vec(a, b), vec(a, d))^2 = 0
        impossible det(vec(a, b), vec(a, d))^2 > 0
    det(vec(a, b), vec(a, d)) = (b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])

    # Eliminate the second residual coordinate from the two parallel equations.
    (d[1] - a[1]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (b[1] - a[1]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[1] - a[1]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[1] - a[1]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[1] - a[1]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[1] - a[1]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = (a[1] + c[1] - b[1] - d[1]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1]))
    (a[1] + c[1] - b[1] - d[1]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])) = (a[1] + c[1] - b[1] - d[1]) * det(vec(a, b), vec(a, d))
    (a[1] + c[1] - b[1] - d[1]) * det(vec(a, b), vec(a, d)) = 0
    a[1] + c[1] - b[1] - d[1] = 0
    d[1] = a[1] + c[1] - b[1]

    # Eliminate the first residual coordinate from the same equations.
    (d[2] - a[2]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (b[2] - a[2]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[2] - a[2]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[2] - a[2]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = 0
    (d[2] - a[2]) * ((b[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (b[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) - (b[2] - a[2]) * ((d[1] - a[1]) * (a[2] + c[2] - b[2] - d[2]) - (d[2] - a[2]) * (a[1] + c[1] - b[1] - d[1])) = (a[2] + c[2] - b[2] - d[2]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1]))
    (a[2] + c[2] - b[2] - d[2]) * ((b[1] - a[1]) * (d[2] - a[2]) - (b[2] - a[2]) * (d[1] - a[1])) = (a[2] + c[2] - b[2] - d[2]) * det(vec(a, b), vec(a, d))
    (a[2] + c[2] - b[2] - d[2]) * det(vec(a, b), vec(a, d)) = 0
    a[2] + c[2] - b[2] - d[2] = 0
    d[2] = a[2] + c[2] - b[2]


# ═══════════════════════════════════════════════════════════════════════
# ORTHOGONAL PROJECTION - Midpoint Preservation
# ═══════════════════════════════════════════════════════════════════════
# Added from Problem 218 (2026-09-02).
# Orthogonal projection onto one nondegenerate line is affine and hence
# preserves the midpoint of two points.

thm common_line_feet_preserve_midpoint:
    ? forall a0, a1, b, c, p, m, n, g cart(R, R):
        a0 != a1,
        $is_midpoint(p, b, c),
        $is_foot(m, b, a0, a1),
        $is_foot(n, c, a0, a1),
        $is_foot(g, p, a0, a1)
        =>:
            $is_midpoint(g, m, n)

    by def $is_midpoint(p, b, c)
    by def $is_foot(m, b, a0, a1)
    by def $is_foot(n, c, a0, a1)
    by def $is_foot(g, p, a0, a1)
    by def $is_on_line(m, a0, a1)
    by def $is_on_line(n, a0, a1)
    by def $is_on_line(g, a0, a1)
    by def $is_perpendicular(b, m, a0, a1)
    by def $is_perpendicular(c, n, a0, a1)
    by def $is_perpendicular(p, g, a0, a1)

    m $in line_of(a0, a1)
    n $in line_of(a0, a1)
    g $in line_of(a0, a1)
    det(vec(a0, m), vec(a0, a1)) = 0
    det(vec(a0, n), vec(a0, a1)) = 0
    det(vec(a0, g), vec(a0, a1)) = 0

    dot(vec(b, m), vec(a0, a1)) = 0
    dot(vec(c, n), vec(a0, a1)) = 0
    dot(vec(p, g), vec(a0, a1)) = 0

    p = ((b[1] + c[1]) / 2, (b[2] + c[2]) / 2)
    p[1] = (b[1] + c[1]) / 2
    p[2] = (b[2] + c[2]) / 2

    by thm vec_coordinate_formula(a0, a1)
    vec(a0, a1) = (a1[1] - a0[1], a1[2] - a0[2])

    by thm det_coordinate_formula(vec(a0, m), vec(a0, a1))
    by thm vec_coordinate_formula(a0, m)
    by thm vec_coordinate_formula(a0, a1)
    det(vec(a0, m), vec(a0, a1)) = (m[1] - a0[1]) * (a1[2] - a0[2]) - (m[2] - a0[2]) * (a1[1] - a0[1])
    by thm det_coordinate_formula(vec(a0, n), vec(a0, a1))
    by thm vec_coordinate_formula(a0, n)
    det(vec(a0, n), vec(a0, a1)) = (n[1] - a0[1]) * (a1[2] - a0[2]) - (n[2] - a0[2]) * (a1[1] - a0[1])
    by thm det_coordinate_formula(vec(a0, g), vec(a0, a1))
    by thm vec_coordinate_formula(a0, g)
    det(vec(a0, g), vec(a0, a1)) = (g[1] - a0[1]) * (a1[2] - a0[2]) - (g[2] - a0[2]) * (a1[1] - a0[1])
    (m[1] - a0[1]) * (a1[2] - a0[2]) - (m[2] - a0[2]) * (a1[1] - a0[1]) = 0
    (n[1] - a0[1]) * (a1[2] - a0[2]) - (n[2] - a0[2]) * (a1[1] - a0[1]) = 0
    (g[1] - a0[1]) * (a1[2] - a0[2]) - (g[2] - a0[2]) * (a1[1] - a0[1]) = 0
    (-1 / 2) * ((m[1] - a0[1]) * (a1[2] - a0[2]) - (m[2] - a0[2]) * (a1[1] - a0[1])) = 0
    (-1 / 2) * ((n[1] - a0[1]) * (a1[2] - a0[2]) - (n[2] - a0[2]) * (a1[1] - a0[1])) = 0
    (g[1] - a0[1]) * (a1[2] - a0[2]) - (g[2] - a0[2]) * (a1[1] - a0[1]) = 0
    (-1 / 2) * ((m[1] - a0[1]) * (a1[2] - a0[2]) - (m[2] - a0[2]) * (a1[1] - a0[1])) + (-1 / 2) * ((n[1] - a0[1]) * (a1[2] - a0[2]) - (n[2] - a0[2]) * (a1[1] - a0[1])) + ((g[1] - a0[1]) * (a1[2] - a0[2]) - (g[2] - a0[2]) * (a1[1] - a0[1])) = 0
    (a1[1] - a0[1]) * ((m[2] + n[2]) / 2 - g[2]) - (a1[2] - a0[2]) * ((m[1] + n[1]) / 2 - g[1]) = (-1 / 2) * ((m[1] - a0[1]) * (a1[2] - a0[2]) - (m[2] - a0[2]) * (a1[1] - a0[1])) + (-1 / 2) * ((n[1] - a0[1]) * (a1[2] - a0[2]) - (n[2] - a0[2]) * (a1[1] - a0[1])) + ((g[1] - a0[1]) * (a1[2] - a0[2]) - (g[2] - a0[2]) * (a1[1] - a0[1])) = 0

    by thm dot_coordinate_formula(vec(b, m), vec(a0, a1))
    by thm vec_coordinate_formula(b, m)
    dot(vec(b, m), vec(a0, a1)) = (m[1] - b[1]) * (a1[1] - a0[1]) + (m[2] - b[2]) * (a1[2] - a0[2])
    by thm dot_coordinate_formula(vec(c, n), vec(a0, a1))
    by thm vec_coordinate_formula(c, n)
    dot(vec(c, n), vec(a0, a1)) = (n[1] - c[1]) * (a1[1] - a0[1]) + (n[2] - c[2]) * (a1[2] - a0[2])
    by thm dot_coordinate_formula(vec(p, g), vec(a0, a1))
    by thm vec_coordinate_formula(p, g)
    dot(vec(p, g), vec(a0, a1)) = (g[1] - p[1]) * (a1[1] - a0[1]) + (g[2] - p[2]) * (a1[2] - a0[2])
    (m[1] - b[1]) * (a1[1] - a0[1]) + (m[2] - b[2]) * (a1[2] - a0[2]) = 0
    (n[1] - c[1]) * (a1[1] - a0[1]) + (n[2] - c[2]) * (a1[2] - a0[2]) = 0
    (g[1] - p[1]) * (a1[1] - a0[1]) + (g[2] - p[2]) * (a1[2] - a0[2]) = 0
    (1 / 2) * ((m[1] - b[1]) * (a1[1] - a0[1]) + (m[2] - b[2]) * (a1[2] - a0[2])) = 0
    (1 / 2) * ((n[1] - c[1]) * (a1[1] - a0[1]) + (n[2] - c[2]) * (a1[2] - a0[2])) = 0
    (-1) * ((g[1] - p[1]) * (a1[1] - a0[1]) + (g[2] - p[2]) * (a1[2] - a0[2])) = 0
    (1 / 2) * ((m[1] - b[1]) * (a1[1] - a0[1]) + (m[2] - b[2]) * (a1[2] - a0[2])) + (1 / 2) * ((n[1] - c[1]) * (a1[1] - a0[1]) + (n[2] - c[2]) * (a1[2] - a0[2])) + (-1) * ((g[1] - p[1]) * (a1[1] - a0[1]) + (g[2] - p[2]) * (a1[2] - a0[2])) = 0
    (m[1] + n[1]) / 2 - g[1] = (1 / 2) * (m[1] - b[1]) + (1 / 2) * (n[1] - c[1]) - (g[1] - p[1])
    (m[2] + n[2]) / 2 - g[2] = (1 / 2) * (m[2] - b[2]) + (1 / 2) * (n[2] - c[2]) - (g[2] - p[2])
    (a1[1] - a0[1]) * ((m[1] + n[1]) / 2 - g[1]) = (a1[1] - a0[1]) * ((1 / 2) * (m[1] - b[1]) + (1 / 2) * (n[1] - c[1]) - (g[1] - p[1]))
    (a1[2] - a0[2]) * ((m[2] + n[2]) / 2 - g[2]) = (a1[2] - a0[2]) * ((1 / 2) * (m[2] - b[2]) + (1 / 2) * (n[2] - c[2]) - (g[2] - p[2]))
    (a1[1] - a0[1]) * ((m[1] + n[1]) / 2 - g[1]) + (a1[2] - a0[2]) * ((m[2] + n[2]) / 2 - g[2]) = (a1[1] - a0[1]) * ((1 / 2) * (m[1] - b[1]) + (1 / 2) * (n[1] - c[1]) - (g[1] - p[1])) + (a1[2] - a0[2]) * ((1 / 2) * (m[2] - b[2]) + (1 / 2) * (n[2] - c[2]) - (g[2] - p[2]))
    (a1[1] - a0[1]) * ((1 / 2) * (m[1] - b[1]) + (1 / 2) * (n[1] - c[1]) - (g[1] - p[1])) + (a1[2] - a0[2]) * ((1 / 2) * (m[2] - b[2]) + (1 / 2) * (n[2] - c[2]) - (g[2] - p[2])) = (1 / 2) * ((m[1] - b[1]) * (a1[1] - a0[1]) + (m[2] - b[2]) * (a1[2] - a0[2])) + (1 / 2) * ((n[1] - c[1]) * (a1[1] - a0[1]) + (n[2] - c[2]) * (a1[2] - a0[2])) + (-1) * ((g[1] - p[1]) * (a1[1] - a0[1]) + (g[2] - p[2]) * (a1[2] - a0[2]))
    (a1[1] - a0[1]) * ((m[1] + n[1]) / 2 - g[1]) + (a1[2] - a0[2]) * ((m[2] + n[2]) / 2 - g[2]) = (1 / 2) * ((m[1] - b[1]) * (a1[1] - a0[1]) + (m[2] - b[2]) * (a1[2] - a0[2])) + (1 / 2) * ((n[1] - c[1]) * (a1[1] - a0[1]) + (n[2] - c[2]) * (a1[2] - a0[2])) + (-1) * ((g[1] - p[1]) * (a1[1] - a0[1]) + (g[2] - p[2]) * (a1[2] - a0[2])) = 0

    by thm point_difference_norm_pos(a0, a1)
    (a1[1] - a0[1])^2 + (a1[2] - a0[2])^2 > 0
    by thm dot_det_eliminate(a1[1] - a0[1], a1[2] - a0[2], (m[1] + n[1]) / 2 - g[1], (m[2] + n[2]) / 2 - g[2])
    (m[1] + n[1]) / 2 - g[1] = 0
    (m[2] + n[2]) / 2 - g[2] = 0
    g[1] = (m[1] + n[1]) / 2
    g[2] = (m[2] + n[2]) / 2

    by thm tuple_equal_from_coordinates(g, (g[1], g[2]))
    g = (g[1], g[2]) = ((m[1] + n[1]) / 2, (m[2] + n[2]) / 2)
    by def $is_midpoint(g, m, n)

