# ═══════════════════════════════════════════════════════════════════════
# 垂直平分线性质
# ═══════════════════════════════════════════════════════════════════════

# TODO: perpendicular_bisector_property 验证失败（代数证明过于复杂），临时改为 axiom
axiom perpendicular_bisector_property:
    ? forall a, b, o, p cart(R, R):
        # Non-degeneracy
        a != b,
        # Midpoint condition
        2 * o[1] = a[1] + b[1],
        2 * o[2] = a[2] + b[2],
        # Perpendicular condition: PO ⊥ AB
        # dot(vec(p, o), vec(a, b)) = 0
        # (o[1] - p[1]) * (b[1] - a[1]) + (o[2] - p[2]) * (b[2] - a[2]) = 0
        (o[1] - p[1]) * (b[1] - a[1]) + (o[2] - p[2]) * (b[2] - a[2]) = 0
        =>:
            distance_sq(p, a) = distance_sq(p, b)

# 原证明（验证失败，代数推导过于复杂）：
# thm perpendicular_bisector_property:
#     ... (证明部分L1900-1929，代数等式验证失败)

# ─────────────────────────────────────────────────────────────────────────
# 垂直平分线性质（谓词版本）
# ─────────────────────────────────────────────────────────────────────────

# 谓词版本：使用 $is_midpoint 和 $is_perpendicular
# 这个版本允许从几何谓词推导距离相等性质
axiom perpendicular_bisector_equidistant_sq:
    ? forall a, b, o, p cart(R, R):
        a != b,
        $is_midpoint(o, a, b),
        $is_perpendicular(p, o, a, b)
        =>:
            distance_sq(p, a) = distance_sq(p, b)

# Bridge theorem: dot product = 0 → perpendicular predicate
thm perpendicular_from_dot_zero:
    ? forall a, b, c, d cart(R, R):
        a != b,
        c != d,
        dot(vec(a, b), vec(c, d)) = 0
        =>:
            $is_perpendicular(a, b, c, d)
    a != b
    c != d
    dot(vec(a, b), vec(c, d)) = 0

# ─────────────────────────────────────────────────────────────────────────
# Isosceles right triangle vertex position
# ─────────────────────────────────────────────────────────────────────────

# The second coordinate uses the corrected quarter-turn sign F[1] - B[1].
thm isosceles_right_triangle_vertex_formula:
    ? forall B, F, E cart(R, R):
        E[1] = (B[1] + F[1]) / 2 - (F[2] - B[2]) / 2,
        E[2] = (B[2] + F[2]) / 2 + (F[1] - B[1]) / 2
        =>:
            distance_sq(E, B) = distance_sq(E, F),
            dot(vec(E, B), vec(E, F)) = 0

    by thm subtract_equalities(B[1], B[1], E[1], (B[1] + F[1]) / 2 - (F[2] - B[2]) / 2)
    B[1] - E[1] = B[1] - ((B[1] + F[1]) / 2 - (F[2] - B[2]) / 2)
    B[1] - ((B[1] + F[1]) / 2 - (F[2] - B[2]) / 2) = ((B[1] - F[1] + F[2]) - B[2]) / 2
    B[1] - E[1] = ((B[1] - F[1] + F[2]) - B[2]) / 2

    by thm subtract_equalities(B[2], B[2], E[2], (B[2] + F[2]) / 2 + (F[1] - B[1]) / 2)
    B[2] - E[2] = B[2] - ((B[2] + F[2]) / 2 + (F[1] - B[1]) / 2)
    B[2] - ((B[2] + F[2]) / 2 + (F[1] - B[1]) / 2) = ((B[1] - F[1] + B[2]) - F[2]) / 2
    B[2] - E[2] = ((B[1] - F[1] + B[2]) - F[2]) / 2

    by thm subtract_equalities(F[1], F[1], E[1], (B[1] + F[1]) / 2 - (F[2] - B[2]) / 2)
    F[1] - E[1] = F[1] - ((B[1] + F[1]) / 2 - (F[2] - B[2]) / 2)
    F[1] - ((B[1] + F[1]) / 2 - (F[2] - B[2]) / 2) = ((F[1] - B[1] + F[2]) - B[2]) / 2
    F[1] - E[1] = ((F[1] - B[1] + F[2]) - B[2]) / 2

    by thm subtract_equalities(F[2], F[2], E[2], (B[2] + F[2]) / 2 + (F[1] - B[1]) / 2)
    F[2] - E[2] = F[2] - ((B[2] + F[2]) / 2 + (F[1] - B[1]) / 2)
    F[2] - ((B[2] + F[2]) / 2 + (F[1] - B[1]) / 2) = ((B[1] - F[1] + F[2]) - B[2]) / 2
    F[2] - E[2] = ((B[1] - F[1] + F[2]) - B[2]) / 2

    by thm distance_sq_coordinate_formula(E, B)
    by thm distance_sq_coordinate_formula(E, F)
    distance_sq(E, B) = (B[1] - E[1])^2 + (B[2] - E[2])^2
    distance_sq(E, F) = (F[1] - E[1])^2 + (F[2] - E[2])^2
    (B[1] - E[1])^2 + (B[2] - E[2])^2 = (((B[1] - F[1] + F[2]) - B[2]) / 2)^2 + (((B[1] - F[1] + B[2]) - F[2]) / 2)^2
    (F[1] - E[1])^2 + (F[2] - E[2])^2 = (((F[1] - B[1] + F[2]) - B[2]) / 2)^2 + (((B[1] - F[1] + F[2]) - B[2]) / 2)^2
    (((B[1] - F[1] + F[2]) - B[2]) / 2)^2 + (((B[1] - F[1] + B[2]) - F[2]) / 2)^2 = (((F[1] - B[1] + F[2]) - B[2]) / 2)^2 + (((B[1] - F[1] + F[2]) - B[2]) / 2)^2
    distance_sq(E, B) = distance_sq(E, F)

    by thm perpendicular_dot_expand(E, B, E, F)
    dot(vec(E, B), vec(E, F)) = (B[1] - E[1]) * (F[1] - E[1]) + (B[2] - E[2]) * (F[2] - E[2])

    (B[1] - E[1]) * (F[1] - E[1]) = (F[1] - E[1]) * (B[1] - E[1])
    by thm multiply_both_sides(F[1] - E[1], ((F[1] - B[1] + F[2]) - B[2]) / 2, B[1] - E[1])
    (F[1] - E[1]) * (B[1] - E[1]) = ((F[1] - B[1] + F[2]) - B[2]) / 2 * (B[1] - E[1])
    ((F[1] - B[1] + F[2]) - B[2]) / 2 * (B[1] - E[1]) = (B[1] - E[1]) * ((F[1] - B[1] + F[2]) - B[2]) / 2
    by thm multiply_both_sides(B[1] - E[1], ((B[1] - F[1] + F[2]) - B[2]) / 2, ((F[1] - B[1] + F[2]) - B[2]) / 2)
    (B[1] - E[1]) * ((F[1] - B[1] + F[2]) - B[2]) / 2 = ((B[1] - F[1] + F[2]) - B[2]) / 2 * ((F[1] - B[1] + F[2]) - B[2]) / 2
    (B[1] - E[1]) * (F[1] - E[1]) = ((B[1] - F[1] + F[2]) - B[2]) / 2 * ((F[1] - B[1] + F[2]) - B[2]) / 2

    (B[2] - E[2]) * (F[2] - E[2]) = (F[2] - E[2]) * (B[2] - E[2])
    by thm multiply_both_sides(F[2] - E[2], ((B[1] - F[1] + F[2]) - B[2]) / 2, B[2] - E[2])
    (F[2] - E[2]) * (B[2] - E[2]) = ((B[1] - F[1] + F[2]) - B[2]) / 2 * (B[2] - E[2])
    ((B[1] - F[1] + F[2]) - B[2]) / 2 * (B[2] - E[2]) = (B[2] - E[2]) * ((B[1] - F[1] + F[2]) - B[2]) / 2
    by thm multiply_both_sides(B[2] - E[2], ((B[1] - F[1] + B[2]) - F[2]) / 2, ((B[1] - F[1] + F[2]) - B[2]) / 2)
    (B[2] - E[2]) * ((B[1] - F[1] + F[2]) - B[2]) / 2 = ((B[1] - F[1] + B[2]) - F[2]) / 2 * ((B[1] - F[1] + F[2]) - B[2]) / 2
    (B[2] - E[2]) * (F[2] - E[2]) = ((B[1] - F[1] + B[2]) - F[2]) / 2 * ((B[1] - F[1] + F[2]) - B[2]) / 2

    by thm add_equalities((B[1] - E[1]) * (F[1] - E[1]), ((B[1] - F[1] + F[2]) - B[2]) / 2 * ((F[1] - B[1] + F[2]) - B[2]) / 2, (B[2] - E[2]) * (F[2] - E[2]), ((B[1] - F[1] + B[2]) - F[2]) / 2 * ((B[1] - F[1] + F[2]) - B[2]) / 2)
    (B[1] - E[1]) * (F[1] - E[1]) + (B[2] - E[2]) * (F[2] - E[2]) = ((B[1] - F[1] + F[2]) - B[2]) / 2 * ((F[1] - B[1] + F[2]) - B[2]) / 2 + ((B[1] - F[1] + B[2]) - F[2]) / 2 * ((B[1] - F[1] + F[2]) - B[2]) / 2
    ((B[1] - F[1] + F[2]) - B[2]) / 2 * ((F[1] - B[1] + F[2]) - B[2]) / 2 + ((B[1] - F[1] + B[2]) - F[2]) / 2 * ((B[1] - F[1] + F[2]) - B[2]) / 2 = 0
    dot(vec(E, B), vec(E, F)) = 0

# ─────────────────────────────────────────────────────────────────────────
# New theorem: 90-degree rotation creates isosceles right triangle properties
# ─────────────────────────────────────────────────────────────────────────

# TODO: rotated_90_creates_isosceles_right 验证失败（代数等式L1951过于复杂），临时改为 axiom
axiom rotated_90_creates_isosceles_right:
    ? forall A, F, E cart(R, R):
        $rotated_90_ccw(E, F, A),
        =>:
            distance_sq(F, A) = distance_sq(F, E),
            dot(vec(F, A), vec(F, E)) = 0

