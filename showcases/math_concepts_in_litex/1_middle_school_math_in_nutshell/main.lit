# Middle-school mathematics in a nutshell.
#
# The mainline moves from concrete arithmetic to equations, inequalities,
# functions and sequences, coordinate geometry, and finally probability and
# statistics. Each stop uses one classic example and native Litex objects.

# 1. Number sense: use the native gcd object directly.

gcd(84, 30) = 6

# 2. Equations: isolate a linear unknown, then split a factorized quadratic.

thm solve_linear_equation:
    ? forall a, b, c, x R:
        a != 0
        a * x + b = c
        =>:
            x = (c - b) / a
    a * x = c - b
    x = (a * x) / a = (c - b) / a

thm factored_quadratic_roots:
    ? forall r, s, x R:
        (x - r) * (x - s) = 0
        =>:
            x = r or x = s
    by cases:
        ? x = r or x = s
        case x - r = 0:
            x = r
        case x - s = 0:
            x = s

3 != 0
3 * 2 + (-6) = 0
by thm solve_linear_equation(3, -6, 0, 2) => 2 = (0 - (-6)) / 3
(3 - 2) * (3 - 3) = 0
3 = 3
3 = 2 or 3 = 3

# 3. Inequalities: AM-GM grows from the nonnegative square (x-y)^2.

have fn arithmetic_mean(x, y R) R = (x + y) / 2
have fn geometric_mean(x, y R: x >= 0, y >= 0) R = sqrt(x * y)

thm two_variable_am_gm:
    ? forall x, y R:
        x >= 0
        y >= 0
        =>:
            geometric_mean(x, y) <= arithmetic_mean(x, y)
    x * y >= 0
    sqrt(x * y)^2 = x * y
    (x + y)^2 - 4 * x * y = (x - y)^2
    0 <= (x - y)^2
    0 <= (x + y)^2 - 4 * x * y
    4 * x * y <= (x + y)^2
    x * y <= (x + y)^2 / 4
    ((x + y) / 2)^2 = (x + y)^2 / 4
    x * y <= ((x + y) / 2)^2
    0 <= sqrt(x * y)
    0 <= x + y
    0 < 2
    0 <= (x + y) / 2
    by contra:
        ? sqrt(x * y) <= (x + y) / 2
        sqrt(x * y) > (x + y) / 2
        sqrt(x * y)^2 > ((x + y) / 2)^2
        impossible x * y <= ((x + y) / 2)^2
    geometric_mean(x, y) = sqrt(x * y)
    arithmetic_mean(x, y) = (x + y) / 2

by thm two_variable_am_gm(9, 16) => geometric_mean(9, 16) <= arithmetic_mean(9, 16)
geometric_mean(9, 16) = sqrt(9 * 16) = 12
arithmetic_mean(9, 16) = (9 + 16) / 2 = 25 / 2

# 4. Functions and sequences: evaluate a line, then expose constant difference.

have fn linear_function(x R) R = 3 * x + 2
linear_function(4) = 3 * 4 + 2 = 14
linear_function(-1) = 3 * (-1) + 2 = -1

have fn arithmetic_term(first, difference R, n N+) R = first + (n - 1) * difference
arithmetic_term(2, 3, 1) = 2
arithmetic_term(2, 3, 4) = 11

forall first, difference R, n N+:
    arithmetic_term(first, difference, n + 1) = first + ((n + 1) - 1) * difference
    arithmetic_term(first, difference, n) = first + (n - 1) * difference
    arithmetic_term(first, difference, n + 1) - arithmetic_term(first, difference, n) = (first + ((n + 1) - 1) * difference) - (first + (n - 1) * difference) = difference

# 5. Coordinate geometry: the 3-4-5 triangle is a distance calculation.

have fn distance_sq(p, q cart(R, R)) R = (q[1] - p[1])^2 + (q[2] - p[2])^2
distance_sq((0, 0), (3, 4)) = (3 - 0)^2 + (4 - 0)^2 = 25
3^2 + 4^2 = 5^2

# 6. Probability and statistics: a fair die, then the data 2, 4, 6.

have fn uniform_probability(S power_set(R), A power_set(S): $is_finite_set(S), $is_finite_set(A), finite_set_size(S) > 0) R = finite_set_size(A) / finite_set_size(S)

finite_set_size({1, 2, 3, 4, 5, 6}) = 6
finite_set_size({2, 4, 6}) = 3
{2, 4, 6} $subset {1, 2, 3, 4, 5, 6}
uniform_probability({1, 2, 3, 4, 5, 6}, {2, 4, 6}) = 3 / 6 = 1 / 2

have fn mean3(a, b, c R) R = (a + b + c) / 3
have fn range3(minimum, maximum R) R = maximum - minimum
mean3(2, 4, 6) = (2 + 4 + 6) / 3 = 4
range3(2, 6) = 6 - 2 = 4
