# The first n positive odd integers sum to n^2.
#
# Both induction cases deliberately contain their calculations. There are no
# one-use sum/square-step wrappers and no explicit theorem invocation: Litex
# matches the checked function reductions, typed sum rules, exact
# induction hypothesis, and arithmetic facts automatically.
#
# ToLean translates only the declarations and proof in this file. The native
# Mathlib adapter in this showcase is authored separately by external AI and
# is not part of compiler output.

have fn kth_odd(k Z) Z = 2 * k - 1

thm odd_sum_integer:
    ? forall n Z:
        n >= 1
        =>:
            sum(1, n, kth_odd) $in Z
    sum(1, n, kth_odd) $in Z

thm square_integer:
    ? forall n Z:
        n^2 $in Z
    n^2 $in Z

thm sum_first_odds:
    ? forall n Z:
        n >= 1
        =>:
            sum(1, n, kth_odd) = n^2
    by induc n from 1:
        ? sum(1, n, kth_odd) = n^2

        ? from n = 1:
            kth_odd(1) = 2 * 1 - 1 = 1
            sum(1, 1, kth_odd) = kth_odd(1) = 2 * 1 - 1 = 1 = 1^2

        ? induc:
            kth_odd(n + 1) = 2 * (n + 1) - 1
            sum(1, n + 1, kth_odd) = sum(1, n, kth_odd) + kth_odd(n + 1) = n^2 + kth_odd(n + 1) = n^2 + (2 * (n + 1) - 1) = (n + 1)^2

thm sum_first_ten_odds:
    ? forall:
        sum(1, 10, kth_odd) = 100
    sum(1, 10, kth_odd) = 10^2 = 100
