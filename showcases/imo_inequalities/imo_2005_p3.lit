# IMO 2005 P3.

claim:
    ? forall x, y, z R+:
        x^5+y^2+z^2 > 0
        x^5+y^2+z^2 != 0
        x^2+y^2+z^2 > 0
        x^2+y^2+z^2 != 0
    x^5 > 0
    x^2 > 0
    y^2 >= 0
    z^2 >= 0
    x^5+y^2 >= x^5 > 0
    x^5+y^2+z^2 >= x^5+y^2 > 0
    x^2+y^2 >= x^2 > 0
    x^2+y^2+z^2 >= x^2+y^2 > 0

thm rational_term_bound:
    ? forall x, y, z R+:
        x*y*z >= 1
        =>:
            (x^5-x^2)/(x^5+y^2+z^2) >= (x^2-y*z)/(x^2+y^2+z^2)
    have s R = x^2+y^2+z^2
    have d R = x^5+y^2+z^2
    s = x^2+y^2+z^2 > 0
    d = x^5+y^2+z^2 > 0
    x*d > 0
    (x*d)*s > 0
    x*(x^5+y^2+z^2)*(x^2+y^2+z^2) = (x*d)*s > 0
    y^2+z^2 >= 0
    (x^3-1)^2*(y^2+z^2) >= 0
    ((x^3-1)^2*(y^2+z^2))/((x*d)*s) >= 0
    (x^5-x^2)/d-(x^2-1/x)/s = (x^5-x^2)/(x^5+y^2+z^2)-(x^2-1/x)/(x^2+y^2+z^2) = ((x^3-1)^2*(y^2+z^2))/(x*(x^5+y^2+z^2)*(x^2+y^2+z^2)) = ((x^3-1)^2*(y^2+z^2))/((x*d)*s) >= 0
    0 <= (x^5-x^2)/d-(x^2-1/x)/s
    (x^5-x^2)/d >= (x^2-1/x)/s
    y*z = (x*y*z)/x >= 1/x
    x^2-1/x >= x^2-y*z
    (x^2-1/x)/s >= (x^2-y*z)/s
    (x^5-x^2)/(x^5+y^2+z^2) = (x^5-x^2)/d >= (x^2-y*z)/s = (x^2-y*z)/(x^2+y^2+z^2)

thm square_gap_sum:
    ? forall x, y, z R:
        x^2+y^2+z^2-x*y-y*z-z*x >= 0
    (x-y)^2 >= 0
    (y-z)^2 >= 0
    (z-x)^2 >= 0
    (x-y)^2+(y-z)^2 >= 0
    (x-y)^2+(y-z)^2+(z-x)^2 >= 0
    ((x-y)^2+(y-z)^2+(z-x)^2)/2 >= 0
    x^2+y^2+z^2-x*y-y*z-z*x = ((x-y)^2+(y-z)^2+(z-x)^2)/2 >= 0

claim:
    ? forall x, y, z R+:
        x*y*z >= 1
        =>:
            (x^5-x^2)/(x^5+y^2+z^2)+(y^5-y^2)/(y^5+z^2+x^2)+(z^5-z^2)/(z^5+x^2+y^2) >= 0
    release thm rational_term_bound(x,y,z)
    y*z*x = x*y*z >= 1
    z*x*y = x*y*z >= 1
    release thm rational_term_bound(y,z,x)
    release thm rational_term_bound(z,x,y)
    release thm square_gap_sum(x,y,z)
    x^2+y^2+z^2 > 0
    y^2+z^2+x^2 = x^2+y^2+z^2 > 0
    z^2+x^2+y^2 = x^2+y^2+z^2 > 0
    (x^2+y^2+z^2-x*y-y*z-z*x)/(x^2+y^2+z^2) >= 0
    (x^5-x^2)/(x^5+y^2+z^2)+(y^5-y^2)/(y^5+z^2+x^2) >= (x^2-y*z)/(x^2+y^2+z^2)+(y^2-z*x)/(y^2+z^2+x^2)
    (x^5-x^2)/(x^5+y^2+z^2)+(y^5-y^2)/(y^5+z^2+x^2)+(z^5-z^2)/(z^5+x^2+y^2) >= (x^2-y*z)/(x^2+y^2+z^2)+(y^2-z*x)/(y^2+z^2+x^2)+(z^2-x*y)/(z^2+x^2+y^2) = (x^2+y^2+z^2-x*y-y*z-z*x)/(x^2+y^2+z^2) >= 0
