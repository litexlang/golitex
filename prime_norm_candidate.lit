try:
    thm gaussian_prime_norm_is_rational_prime:
        ? forall x, y Z:
            $section4::is_prime_Z(gaussian_norm(x, y))
            =>:
                $gaussian_prime(x, y)
        by def $section4::is_prime_Z(gaussian_norm(x, y))
        gaussian_norm(x, y) > 1
        claim:
            ? forall dx, dy Z:
                $gaussian_divides(dx, dy, x, y)
                =>:
                    $gaussian_unit(dx, dy) or $gaussian_associate(dx, dy, x, y)
            by thm gaussian_divisibility_implies_norm_divisibility(dx, dy, x, y)
            dx ^ 2 >= 0
            dy ^ 2 >= 0
            gaussian_norm(dx, dy) = dx ^ 2 + dy ^ 2 >= 0
            claim:
                ? gaussian_norm(dx, dy) > 0
                by contra:
                    ? gaussian_norm(dx, dy) > 0
                    gaussian_norm(dx, dy) <= 0
                    gaussian_norm(dx, dy) = 0
                    obtain k from exist k Z st {gaussian_norm(x, y) = gaussian_norm(dx, dy) * k}
                    gaussian_norm(x, y) = gaussian_norm(dx, dy) * k = 0
                    impossible gaussian_norm(x, y) > 1
            gaussian_norm(dx, dy) = 1 or gaussian_norm(dx, dy) = gaussian_norm(x, y)
            by cases:
                ? $gaussian_unit(dx, dy) or $gaussian_associate(dx, dy, x, y)
                case gaussian_norm(dx, dy) = 1:
                    by thm gaussian_norm_one_is_unit(dx, dy)
                case gaussian_norm(dx, dy) = gaussian_norm(x, y):
                    by thm gaussian_divisor_with_equal_positive_norm_is_associate(dx, dy, x, y)
        by def $gaussian_prime(x, y)
