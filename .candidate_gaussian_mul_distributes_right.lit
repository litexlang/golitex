thm gaussian_mul_distributes_over_addition_on_right:
    ? forall ax, ay, bx, b_y, qx, qy Z:
        gaussian_mul(gaussian_add(ax, ay, bx, b_y)[1], gaussian_add(ax, ay, bx, b_y)[2], qx, qy) = gaussian_add(gaussian_mul(ax, ay, qx, qy)[1], gaussian_mul(ax, ay, qx, qy)[2], gaussian_mul(bx, b_y, qx, qy)[1], gaussian_mul(bx, b_y, qx, qy)[2])
    gaussian_add(ax, ay, bx, b_y) = (ax + bx, ay + b_y)
    gaussian_mul(ax, ay, qx, qy) = (ax * qx - ay * qy, ax * qy + ay * qx)
    gaussian_mul(bx, b_y, qx, qy) = (bx * qx - b_y * qy, bx * qy + b_y * qx)
    gaussian_mul(gaussian_add(ax, ay, bx, b_y)[1], gaussian_add(ax, ay, bx, b_y)[2], qx, qy) = gaussian_mul(ax + bx, ay + b_y, qx, qy)
    gaussian_mul(ax + bx, ay + b_y, qx, qy) = ((ax + bx) * qx - (ay + b_y) * qy, (ax + bx) * qy + (ay + b_y) * qx)
    gaussian_add(gaussian_mul(ax, ay, qx, qy)[1], gaussian_mul(ax, ay, qx, qy)[2], gaussian_mul(bx, b_y, qx, qy)[1], gaussian_mul(bx, b_y, qx, qy)[2]) = gaussian_add(ax * qx - ay * qy, ax * qy + ay * qx, bx * qx - b_y * qy, bx * qy + b_y * qx)
    gaussian_add(ax * qx - ay * qy, ax * qy + ay * qx, bx * qx - b_y * qy, bx * qy + b_y * qx) = (ax * qx - ay * qy + (bx * qx - b_y * qy), ax * qy + ay * qx + (bx * qy + b_y * qx))
    ((ax + bx) * qx - (ay + b_y) * qy, (ax + bx) * qy + (ay + b_y) * qx) = (ax * qx - ay * qy + (bx * qx - b_y * qy), ax * qy + ay * qx + (bx * qy + b_y * qx))
    gaussian_mul(gaussian_add(ax, ay, bx, b_y)[1], gaussian_add(ax, ay, bx, b_y)[2], qx, qy) = gaussian_add(gaussian_mul(ax, ay, qx, qy)[1], gaussian_mul(ax, ay, qx, qy)[2], gaussian_mul(bx, b_y, qx, qy)[1], gaussian_mul(bx, b_y, qx, qy)[2])
